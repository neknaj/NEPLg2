//: # 06_generics_and_traits
//: [汎用/はんよう]関数・trait・高階関数のサンプル
//:
//: ### [目的/もくてき]
//: - `.T: Trait` による型[引数/ひきすう][境界/きょうかい]の書き方を示す。
//: - 高階関数の引数に渡すクロージャ `\x expr` と `\x:` の形式を示す。
//: - `Monoid` を使った[汎用/はんよう][畳/たた]み[込/こ]みパターンを示す。

#module
#indent 4

use core::list as *
use core::option as *
use core::cmp as *
use core::math as *


// ── trait 定義 ────────────────────────────────────────────────────────────

pub let Eq trait:
    let eq %fn Self fn Self bool \a \b:
        ...

pub let Ord trait:
    let lt %fn Self fn Self bool \a \b:
        ...
    // デフォルト実装: lt または eq であれば le
    let le %fn Self fn Self bool \a \b:
        or lt a b eq a b


//: ## Monoid
//: [単位元/たんいげん]と[二項[演算/えんざん]/にこうえんざん]を持つ能力 trait
//:
//: ### [目的/もくてき]
//: - `empty` が[単位元/たんいげん]、`combine` が結合的[二項[演算/えんざん]/にこうえんざん]を担当する。
//: - `mconcat` のような汎用関数を型に依存せず書ける。
//: - `i32` (加算)・`str` (連結)・`List` (連結) で異なる動作を同じ関数で[統一/とういつ]できる。

pub let Monoid trait:
    let empty %fn unit Self \unit:
        ...
    let combine %fn Self fn Self Self \a \b:
        ...


pub let i32 impl for Monoid:
    let empty %fn unit i32 \unit 0
    let combine %fn i32 fn i32 i32 \a \b add a b

pub let str impl for Monoid:
    let empty %fn unit str \unit ""
    let combine %fn str fn str str \a \b concat a b


//: ## mconcat
//: `Monoid` の `combine` で `List .T` を畳み込む
//:
//: ### [実装/じっそう]
//: - `empty unit` でアキュムレータを初期化し、`fold_left` で `combine` を順次適用する。
//: - `mconcat (list "a" "b" "c") = "abc"` / `mconcat (list 1 2 3) = 6`
//: - 型は呼び出し側の[期待型/きたいがた]から[推論/すいろん]される。[曖昧/あいまい]な場合は `%i32` 等の型注釈で解消する。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)（`combine` が O(1) の場合）

pub let mconcat .T: Monoid %fn List .T .T \xs:
    fold_left xs empty unit combine


// ── 高階関数 ──────────────────────────────────────────────────────────────

//: ## map
//: `List .T` の各[要素/ようそ]に関数を[適用/てきよう]して `List .U` を返す
//:
//: ### [注意/ちゅうい]
//: - `fn .T .U` は 1 引数関数型である。
//: - 2 引数関数型は `fn .A fn .B .C` のようにカリー化して書く。
//: - クロージャ `\x mul x 2` の型は呼び出し側の[期待型/きたいがた]から[推論/すいろん]される。

pub let map .T .U %fn List .T fn fn .T .U List .U \xs \f:
    match xs:
        List::Nil List::Nil
        List::Cons h t cons f h map t f

pub let filter .T %fn List .T fn fn .T bool List .T \xs \pred:
    match xs:
        List::Nil List::Nil
        List::Cons h t:
            if pred h
                cons h filter t pred
                filter t pred

pub let fold_left .T .A %fn List .T fn .A fn fn .A .T .A .A \xs \init \f:
    match xs:
        List::Nil init
        List::Cons h t fold_left t f init h f


//: ## sort_list
//: 挿入ソート（`Ord` [境界/きょうかい]付き型[引数/ひきすう]の例）
//:
//: ### [実装/じっそう]
//: - `insert_sorted` は内部[補助/ほじょ]関数（`let` でスコープ内に[閉/と]じる）。
//: - [実用/じつよう]では stdlib の `sort` を使うこと。この実装は O(n²) であり[大規模/だいきぼ]には不適。
//:
//: ### [計算量/けいさんりょう]
//: - 最悪 O(n²)、安定ソート

pub let sort_list .T: Ord %fn List .T List .T \xs:
    let insert_sorted %fn List .T fn .T List .T \sorted \v:
        match sorted:
            List::Nil cons v nil
            List::Cons h t:
                if le v h
                    cons v sorted
                    cons h insert_sorted t v
    fold_left xs nil insert_sorted


// 使用例（main からの呼び出し）
pub let sum_squares %fn List i32 i32 \ns:
    mconcat map ns \n mul n n
