//: # 03_errors
//: `Result` / `Option` によるエラーハンドリングのサンプル
//:
//: ### [目的/もくてき]
//: - NEPLg2.1 は例外も panic もない。失敗は `Result`・不在は `Option` で[表現/ひょうげん]する。
//: - `and_then` / `map` による[連鎖/れんさ]（モナド的[合成/ごうせい]）と `match` による[明示/めいじ]分岐の両[方法/ほうほう]を示す。
//: - エラー型を enum で[定義/ていぎ]し、`match` で[詳細/しょうさい]を[識別/しきべつ]するパターンを示す。

#module
#indent 4

use core::option as *
use core::result as *
use core::math as *
use core::cmp as *


pub let ParseError enum:
    EmptyInput
    InvalidChar %str
    Overflow

pub let MathError enum:
    DivisionByZero
    NegativeRoot


//: ## parse_digit
//: 1 文字の[数字/すうじ]文字列を `i32` に[変換/へんかん]する
//:
//: ### [注意/ちゅうい]
//: - 入力は 1 文字の文字列リテラルのみ対応。複数文字は `Option::None`。
//: - 教[示/じ]用の最小実装。実用では `core::parse::int` を使うこと。

pub let parse_digit %fn str -> Option i32 \ s :
    match s:
        "0": Option::Some 0
        "1": Option::Some 1
        "2": Option::Some 2
        "3": Option::Some 3
        "4": Option::Some 4
        "5": Option::Some 5
        "6": Option::Some 6
        "7": Option::Some 7
        "8": Option::Some 8
        "9": Option::Some 9
        _:   Option::None


pub let safe_div %fn i32 i32 -> Option i32 \ a b :
    if eq b 0: Option::None
    else: Option::Some div a b


//: ## parse_int
//: 文字列を `i32` に[変換/へんかん]し、失敗[理由/りゆう]を `ParseError` で返す
//:
//: ### [実装/じっそう]
//: - 空文字列は `EmptyInput`、[非数字/ひすうじ]は `InvalidChar`（[原文字/げんもじ]列付き）。
//: - `Option` を[内部/ないぶ]で使い、外[向/む]きの型は `Result` に[統一/とういつ]している。
//: - 利用者が失敗[理由/りゆう]を必要としない場合は `parse_digit` を直接使えばよい。

pub let parse_int %fn str -> Result i32 ParseError \ s :
    if eq s "":
        Result::Err ParseError::EmptyInput
    else:
        match parse_digit s:
            Option::Some n: Result::Ok n
            Option::None:   Result::Err ParseError::InvalidChar s


//: ## pipeline
//: `and_then` による `Result` の[連鎖/れんさ]
//:
//: ### [実装/じっそう]
//: - `and_then` は `Result::Ok` の場合だけ次の計算を[適用/てきよう]し、`Err` はそのまま[伝搬/でんぱん]する。
//: - 各[変換/へんかん]ステップが[独立/どくりつ]して `Result` を返す場合、`and_then` の[連鎖/れんさ]がフラットになる。
//: - 途中の `Err` 型が[統一/とういつ]されていない場合は `map_err` で変換が必要（このサンプルでは省略）。

pub let pipeline %fn str str -> Result i32 ParseError \ sa sb :
    parse_int sa
    |> and_then \ a :
        parse_int sb
        |> and_then \ b :
            match safe_div a b:
                Option::Some v: Result::Ok v
                Option::None:   Result::Err ParseError::InvalidChar "div by zero"


//: ## parse_and_double
//: `map` による[成功値/せいこうち]の[変換/へんかん]
//:
//: ### [実装/じっそう]
//: - `map` は `Ok` の[値/あたい]だけを[変換/へんかん]する。`Err` は[型/かた]ごとそのまま通す。
//: - 失敗しない[変換/へんかん]（`mul n 2`）を `and_then` でなく `map` に渡すのが正しいパターン。

pub let parse_and_double %fn str -> Result i32 ParseError \ s :
    s |> parse_int |> map \ n : mul n 2


pub let run_with_report %fn str -> str \ s :
    match parse_int s:
        Result::Ok n:
            concat "解析成功: " to_str n
        Result::Err ParseError::EmptyInput:
            "エラー: 入力が空"
        Result::Err ParseError::InvalidChar c:
            concat "エラー: 無効な文字 " c
        Result::Err ParseError::Overflow:
            "エラー: オーバーフロー"
