//: neplg2:test[stdio_ascii, normalize_newlines, strip_ansi]
//: stdin: "sample\n"
//: stdout: mlstr:
//:     ##: accepting input...
//:     ##: > input:
//:     ##: sample
//:
//: neplg2:test[stdio_utf8, normalize_newlines, strip_ansi]
//: stdin: "こんにちは\n"
//: stdout: mlstr:
//:     ##: accepting input...
//:     ##: > input:
//:     ##: こんにちは
//:
//: stdio: 1 行入力をそのまま表示する基本例
//:
//: [目的/もくてき]:
//: - `read_line` で 1 行を受け取り、そのまま表示する最小の入出力例を示します。
//: - ASCII 入力と UTF-8 入力の両方で doctest できる形を提供します。
//:
//: [実装/じっそう]:
//: - 開始メッセージを出したあと、`read_line` で 1 行読み込みます。
//: - 読み取った文字列を見出し付きでそのまま `println` します。
//:
//: [注意/ちゅうい]:
//: - `read_line` は末尾改行を含まない文字列を返します。
//: - 入力文字列は UTF-8 として扱われ、日本語などの非 ASCII 文字もそのまま表示します。
#entry main
#indent 4
#target std

#import "std/stdio" as *

//: main: 受け取った 1 行をそのまま表示する
//:
//: [目的/もくてき]:
//: - NEPLg2 のもっとも基本的な標準入力サンプルを示します。
fn main %impure fn unit unit \unit:
    println_color AnsiColor::Green "accepting input...";
    print "> ";
    let input %str read_line;
    println "input:";
    println input;
