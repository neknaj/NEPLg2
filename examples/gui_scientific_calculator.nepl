//: neplg2:test[gui_scientific_calculator, normalize_newlines]
//: [目的/もくてき]: 関数電卓 GUI app が NEPL 側の ActionId update で数値関数を適用できることを確認する
//: argv: ["--once"]
//:
//: gui_scientific_calculator: 整数関数を持つ GUI app model の例
//:
//: [目的/もくてき]:
//: - The Elm Architecture の `Model -> View` と `Model + Action -> Model` を小さい関数電卓で示します。
//: - square、integer sqrt、negate、double、half を backend から独立した純粋関数として実装します。
//:
//: [注意/ちゅうい]:
//: - 現段階の stdout fallback example なので、表示値は small integer に収めます。
#entry main
#indent 4
#target std

#import "alloc/gui/app" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "platforms/gui/web" as *
#import "std/env/cliarg" as *
#import "std/stdio" as *

struct ScientificCalculatorModel:
    value %i32

impl Clone for ScientificCalculatorModel:
    fn clone %fn &ScientificCalculatorModel ScientificCalculatorModel \model:
        *model

impl Copy for ScientificCalculatorModel:
    fn copy_mark %fn ScientificCalculatorModel ScientificCalculatorModel \model:
        model

fn sci_model_new %fn i32 ScientificCalculatorModel \value:
    ScientificCalculatorModel value

fn sci_model_value %fn &ScientificCalculatorModel i32 \model:
    *field::get_ref model "value"

fn sci_init %fn unit ScientificCalculatorModel \unit:
    sci_model_new 0

fn sci_action_digit %fn i32 ActionId \digit:
    if:
        eq digit 0
        then:
            action_id 10
        else:
            action_id digit

fn sci_action_square %fn unit ActionId \unit:
    action_id 20

fn sci_action_sqrt %fn unit ActionId \unit:
    action_id 21

fn sci_action_negate %fn unit ActionId \unit:
    action_id 22

fn sci_action_clear %fn unit ActionId \unit:
    action_id 23

fn sci_action_double %fn unit ActionId \unit:
    action_id 24

fn sci_action_half %fn unit ActionId \unit:
    action_id 25

fn sci_action_raw %fn ActionId i32 \action:
    action_id_value action

fn sci_action_is_digit %fn ActionId bool \action:
    let raw %i32 sci_action_raw action
    let is_zero %bool eq raw 10
    let is_positive_digit %bool and ge raw 1 le raw 9
    or is_zero is_positive_digit

fn sci_action_digit_value %fn ActionId i32 \action:
    let raw %i32 sci_action_raw action
    if:
        eq raw 10
        then:
            0
        else:
            raw

fn sci_clamp %fn i32 i32 \value:
    if:
        lt value -4096
        then:
            -4096
        else:
            if:
                gt value 4096
                then:
                    4096
                else:
                    value

fn sci_abs %fn i32 i32 \value:
    if:
        lt value 0
        then:
            sub 0 value
        else:
            value

fn sci_sqrt_loop %fn i32 fn i32 i32 \target\candidate:
    let square %i32 mul candidate candidate
    if:
        gt square target
        then:
            sub candidate 1
        else:
            let next %i32 add candidate 1
            sci_sqrt_loop target next

fn sci_integer_sqrt %fn i32 i32 \value:
    let positive %i32 sci_abs value
    sci_sqrt_loop positive 0

fn sci_append_digit %fn i32 fn i32 i32 \value\digit:
    let shifted %i32 mul value 10
    let next %i32 add shifted digit
    sci_clamp next

fn sci_update_action %fn ScientificCalculatorModel fn ActionId ScientificCalculatorModel \model\action:
    let value %i32 sci_model_value &model
    if:
        sci_action_is_digit action
        then:
            let digit %i32 sci_action_digit_value action
            let next_value %i32 sci_append_digit value digit
            sci_model_new next_value
        else:
            let raw %i32 sci_action_raw action
            if:
                eq raw 20
                then:
                    let squared %i32 mul value value
                    let next_value %i32 sci_clamp squared
                    sci_model_new next_value
                else:
                    if:
                        eq raw 21
                        then:
                            let next_value %i32 sci_integer_sqrt value
                            sci_model_new next_value
                        else:
                            if:
                                eq raw 22
                                then:
                                    let next_value %i32 sub 0 value
                                    sci_model_new next_value
                                else:
                                    if:
                                        eq raw 23
                                        then:
                                            sci_init
                                        else:
                                            if:
                                                eq raw 24
                                                then:
                                                    let doubled %i32 mul value 2
                                                    let next_value %i32 sci_clamp doubled
                                                    sci_model_new next_value
                                                else:
                                                    if:
                                                        eq raw 25
                                                        then:
                                                            let next_value %i32 div_s value 2
                                                            sci_model_new next_value
                                                        else:
                                                            model

fn sci_update_event %fn ScientificCalculatorModel fn GuiWebEvent ScientificCalculatorModel \model\web_event:
    match gui_web_event_action &web_event:
        Option::Some action:
            sci_update_action model action
        Option::None:
            model

fn sci_color_background %fn unit Rgba8888 \unit:
    let r %u8 cast 13
    let g %u8 cast 17
    let b %u8 cast 25
    let a %u8 cast 255
    rgba8888_new r g b a

fn sci_color_display %fn unit Rgba8888 \unit:
    let r %u8 cast 20
    let g %u8 cast 32
    let b %u8 cast 38
    let a %u8 cast 255
    rgba8888_new r g b a

fn sci_color_button %fn unit Rgba8888 \unit:
    let r %u8 cast 38
    let g %u8 cast 62
    let b %u8 cast 90
    let a %u8 cast 255
    rgba8888_new r g b a

fn sci_color_function %fn unit Rgba8888 \unit:
    let r %u8 cast 76
    let g %u8 cast 102
    let b %u8 cast 72
    let a %u8 cast 255
    rgba8888_new r g b a

fn sci_color_text %fn unit Rgba8888 \unit:
    let r %u8 cast 238
    let g %u8 cast 244
    let b %u8 cast 241
    let a %u8 cast 255
    rgba8888_new r g b a

fn sci_button_label %fn i32 str \index:
    if:
        eq index 0
        then:
            "7"
        else:
            if:
                eq index 1
                then:
                    "8"
                else:
                    if:
                        eq index 2
                        then:
                            "9"
                        else:
                            if:
                                eq index 3
                                then:
                                    "x2"
                                else:
                                    if:
                                        eq index 4
                                        then:
                                            "4"
                                        else:
                                            if:
                                                eq index 5
                                                then:
                                                    "5"
                                                else:
                                                    if:
                                                        eq index 6
                                                        then:
                                                            "6"
                                                        else:
                                                            if:
                                                                eq index 7
                                                                then:
                                                                    "sqrt"
                                                                else:
                                                                    if:
                                                                        eq index 8
                                                                        then:
                                                                            "1"
                                                                        else:
                                                                            if:
                                                                                eq index 9
                                                                                then:
                                                                                    "2"
                                                                                else:
                                                                                    if:
                                                                                        eq index 10
                                                                                        then:
                                                                                            "3"
                                                                                        else:
                                                                                            if:
                                                                                                eq index 11
                                                                                                then:
                                                                                                    "neg"
                                                                                                else:
                                                                                                    if:
                                                                                                        eq index 12
                                                                                                        then:
                                                                                                            "0"
                                                                                                        else:
                                                                                                            if:
                                                                                                                eq index 13
                                                                                                                then:
                                                                                                                    "C"
                                                                                                                else:
                                                                                                                    if:
                                                                                                                        eq index 14
                                                                                                                        then:
                                                                                                                            "dbl"
                                                                                                                        else:
                                                                                                                            "half"

fn sci_button_action %fn i32 ActionId \index:
    if:
        eq index 0
        then:
            sci_action_digit 7
        else:
            if:
                eq index 1
                then:
                    sci_action_digit 8
                else:
                    if:
                        eq index 2
                        then:
                            sci_action_digit 9
                        else:
                            if:
                                eq index 3
                                then:
                                    sci_action_square
                                else:
                                    if:
                                        eq index 4
                                        then:
                                            sci_action_digit 4
                                        else:
                                            if:
                                                eq index 5
                                                then:
                                                    sci_action_digit 5
                                                else:
                                                    if:
                                                        eq index 6
                                                        then:
                                                            sci_action_digit 6
                                                        else:
                                                            if:
                                                                eq index 7
                                                                then:
                                                                    sci_action_sqrt
                                                                else:
                                                                    if:
                                                                        eq index 8
                                                                        then:
                                                                            sci_action_digit 1
                                                                        else:
                                                                            if:
                                                                                eq index 9
                                                                                then:
                                                                                    sci_action_digit 2
                                                                                else:
                                                                                    if:
                                                                                        eq index 10
                                                                                        then:
                                                                                            sci_action_digit 3
                                                                                        else:
                                                                                            if:
                                                                                                eq index 11
                                                                                                then:
                                                                                                    sci_action_negate
                                                                                                else:
                                                                                                    if:
                                                                                                        eq index 12
                                                                                                        then:
                                                                                                            sci_action_digit 0
                                                                                                        else:
                                                                                                            if:
                                                                                                                eq index 13
                                                                                                                then:
                                                                                                                    sci_action_clear
                                                                                                                else:
                                                                                                                    if:
                                                                                                                        eq index 14
                                                                                                                        then:
                                                                                                                            sci_action_double
                                                                                                                        else:
                                                                                                                            sci_action_half

fn sci_button_is_function %fn i32 bool \index:
    let is_function_col %bool eq rem_s index 4 3
    let is_bottom_function %bool ge index 13
    or is_function_col is_bottom_function

fn sci_button_rect %fn i32 GuiRect \index:
    let col %i32 rem_s index 4
    let row %i32 div_s index 4
    let x_offset %i32 mul col 86
    let y_offset %i32 mul row 58
    let x %i32 add 20 x_offset
    let y %i32 add 102 y_offset
    gui_rect_new x y 76 46

fn sci_present_button %impure fn i32 Result unit GuiError \index:
    let rect %GuiRect sci_button_rect index
    let action %ActionId sci_button_action index
    let label %str sci_button_label index
    let color %Rgba8888:
        if:
            sci_button_is_function index
            then:
                sci_color_function
            else:
                sci_color_button
    match gui_web_stdout_fill_rect rect color:
        Result::Ok _:
            let x %i32 gui_rect_x &rect
            let y %i32 gui_rect_y &rect
            let text_x %i32 add x 38
            let text_y %i32 add y 13
            let origin %GuiPoint gui_point_new text_x text_y
            match gui_web_stdout_text_run origin 13 GuiWebTextAlign::Center sci_color_text label:
                Result::Ok _:
                    gui_web_stdout_action_rect rect action
                Result::Err error:
                    Result::Err error
        Result::Err error:
            Result::Err error

fn sci_present_buttons %impure fn i32 Result unit GuiError \index:
    if:
        ge index 16
        then:
            Result::Ok unit
        else:
            match sci_present_button index:
                Result::Ok _:
                    let next %i32 add index 1
                    sci_present_buttons next
                Result::Err error:
                    Result::Err error

fn sci_present_display %impure fn ScientificCalculatorModel Result unit GuiError \model:
    let display_rect %GuiRect gui_rect_new 20 22 324 58
    match gui_web_stdout_fill_rect display_rect sci_color_display:
        Result::Ok _:
            let origin %GuiPoint gui_point_new 322 38
            gui_web_stdout_text_i32 origin 28 GuiWebTextAlign::Right sci_color_text sci_model_value &model
        Result::Err error:
            Result::Err error

fn sci_present_frame %impure fn ScientificCalculatorModel Result unit GuiError \model:
    match gui_web_stdout_frame_begin 11 364 354 "NEPLg2 Scientific Calculator":
        Result::Ok _:
            let background %GuiRect gui_rect_new 0 0 364 354
            match gui_web_stdout_fill_rect background sci_color_background:
                Result::Ok _:
                    match sci_present_display model:
                        Result::Ok _:
                            match sci_present_buttons 0:
                                Result::Ok _:
                                    gui_web_stdout_frame_end
                                Result::Err error:
                                    Result::Err error
                        Result::Err error:
                            Result::Err error
                Result::Err error:
                    Result::Err error
        Result::Err error:
            Result::Err error

fn sci_has_once_flag_loop %impure fn i32 impure fn i32 bool \idx\count:
    if:
        ge idx count
        then:
            false
        else:
            match cliarg_get idx:
                Option::Some arg:
                    if:
                        str_eq arg "--once"
                        then:
                            true
                        else:
                            let next_idx %i32 add idx 1
                            sci_has_once_flag_loop next_idx count
                Option::None:
                    let next_idx %i32 add idx 1
                    sci_has_once_flag_loop next_idx count

fn sci_has_once_flag %impure fn unit bool \unit:
    let count %i32 cliarg_count
    sci_has_once_flag_loop 1 count

fn sci_print_status %impure fn ScientificCalculatorModel unit \model:
    print "scientific value = "
    let value %i32 sci_model_value &model
    println_i32 value

fn sci_run_once %impure fn ScientificCalculatorModel unit \model:
    let mut current %ScientificCalculatorModel model
    let action_9 %ActionId sci_action_digit 9
    set current sci_update_action current action_9
    let action_square %ActionId sci_action_square
    set current sci_update_action current action_square
    let action_sqrt %ActionId sci_action_sqrt
    set current sci_update_action current action_sqrt
    match sci_present_frame current:
        Result::Ok _:
            sci_print_status current
        Result::Err _:
            println "scientific gui protocol error"

fn sci_event_loop %impure fn ScientificCalculatorModel unit \initial_model:
    let mut model %ScientificCalculatorModel initial_model
    let mut running %bool true
    while running:
        do:
            match gui_web_wait_event_result 60000:
                Result::Ok event_result:
                    match event_result:
                        Option::Some web_event:
                            set model sci_update_event model web_event
                            match sci_present_frame model:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    println "scientific gui protocol error";
                                    set running false
                        Option::None:
                            unit
                Result::Err _:
                    println "scientific gui input unsupported";
                    set running false

fn main %impure fn unit unit \unit:
    let model0 %ScientificCalculatorModel sci_init
    if:
        sci_has_once_flag
        then:
            sci_run_once model0
        else:
            match sci_present_frame model0:
                Result::Ok _:
                    sci_event_loop model0
                Result::Err _:
                    println "scientific gui protocol error"
