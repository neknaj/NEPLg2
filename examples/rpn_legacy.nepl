//: neplg2:test[rpn_legacy_simple, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 互換 RPN REPL で基本加算が動くことを確認する
//: stdin: "1 2 +\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##: 
//:     ##: > ok: result = 3
//:     ##: > bye
//:
//: rpn_legacy: 互換用の簡潔な RPN REPL
//:
//: [目的/もくてき]:
//: - 以前の小さな RPN REPL example と同じ出力仕様を、現行 stdlib の public API だけで示します。
//: - `rpn.nepl` より表示を控えめにし、tokenize / stack / result 表示の最小構成を読みやすく保ちます。
//:
//: [実装/じっそう]:
//: - 入力行は space 区切りで走査し、token ごとに `str_slice_result` で取り出します。
//: - 計算スタックは `Stack<i32>` を使い、`push` / `pop_top` の更新後 owner を受け取り直します。
//: - 数値解析は `to_i32` に委譲し、文字列や stack の内部 layout は直接読みません。
//:
//: [注意/ちゅうい]:
//: - 対応演算子は `+` `-` `*` の 3 種です。
//: - EOF 相当の空行を受け取ると `bye` を表示して終了します。
#entry main
#indent 4
#target std

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "std/stdio" as *
#import "alloc/string/access" as string_access
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "alloc/string/integer/parse" as string_parse
#import "alloc/string/integer/format" as string_format
#import "alloc/string/concat" as string_concat
#import "alloc/collections/stack" as stk
#import "alloc/diag/error" as *

//: print_error: エラーメッセージを赤色で表示する
//:
//: [目的/もくてき]:
//: - REPL の利用者向けエラーを `error: <msg>` 形式で標準出力へ出します。
fn print_error <(str)*>()> (msg):
    let label_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Red;
    print_style label_style "error:";
    print " ";
    println_color AnsiColor::Red msg;

//: print_prompt: 入力待ちプロンプトを表示する
//:
//: [目的/もくてき]:
//: - 各入力行の先頭に `> ` を表示します。
fn print_prompt <()*>()> ():
    let prompt_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Green;
    print_style prompt_style "> ";

//: print_result: 計算結果を表示する
//:
//: [目的/もくてき]:
//: - `ok: result = <val>` 形式で 1 行の結果を出力します。
fn print_result <(i32)*>()> (val):
    let ok_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Green;
    let value_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Cyan;
    print_style ok_style "ok";
    print_color AnsiColor::Gray ": result = ";
    print_style_start value_style;
    print_i32 val;
    print_style_reset;
    print "\n";

//: push_or_report: stack への追加失敗を REPL のエラー表示に変換する
//:
//: [目的/もくてき]:
//: - 計算途中の `push` 失敗を panic にせず、利用者へ `out of memory` として表示します。
//: - `push` は Stack owner を消費して更新後 owner を返すため、成功時だけ次の owner を返します。
fn push_or_report <(Stack<i32>,i32)*>Result<Stack<i32>,str>> (stack, val):
    match stk::push<i32> stack val:
        Result::Ok next_stack:
            ok<Stack<i32>,str> next_stack
        Result::Err _:
            print_error "out of memory";
            err<Stack<i32>,str> "out of memory"

//: apply_op: stack 上の 2 値へ二項演算を適用する
//:
//: [目的/もくてき]:
//: - `+` `-` `*` を適用し、結果を同じ stack に積み直します。
//: - stack が不足する場合はエラーを表示し、stack をそのまま返します。
fn apply_op <(Stack<i32>,str)*>Result<Stack<i32>,str>> (stack, token):
    if:
        lt stk::len<i32> &stack 2
        then:
            print_error "stack underflow";
            ok<Stack<i32>,str> stack
        else:
            let popped_b <StackPop<i32>> stk::pop_top<i32> stack
            let b_opt <Option<i32>> stk::stack_pop_item<i32> &popped_b
            let stack_b <Stack<i32>> stk::stack_pop_stack<i32> popped_b
            match b_opt:
                Option::Some b:
                    let popped_a <StackPop<i32>> stk::pop_top<i32> stack_b
                    let a_opt <Option<i32>> stk::stack_pop_item<i32> &popped_a
                    let stack_a <Stack<i32>> stk::stack_pop_stack<i32> popped_a
                    match a_opt:
                        Option::Some a:
                            let res <i32>:
                                if:
                                    string_search::str_eq token "+"
                                    then add a b
                                    else:
                                        if:
                                            string_search::str_eq token "-"
                                            then sub a b
                                            else mul a b
                            push_or_report stack_a res
                        Option::None:
                            print_error "stack underflow";
                            ok<Stack<i32>,str> stack_a
                Option::None:
                    print_error "stack underflow";
                    ok<Stack<i32>,str> stack_b

//: process_token: 1 token を数値または演算子として処理する
//:
//: [目的/もくてき]:
//: - 数値 token は stack に積み、演算子 token は `apply_op` へ渡します。
//: - 空 token や解析不能 token は、REPL 全体を落とさず値として処理します。
fn process_token <(Stack<i32>,str)*>Result<Stack<i32>,str>> (stack, token):
    if:
        string_search::str_eq token ""
        then:
            ok<Stack<i32>,str> stack
        else:
            let is_op <bool> or or string_search::str_eq token "+" string_search::str_eq token "-" string_search::str_eq token "*";
            if:
                is_op
                then:
                    apply_op stack token
                else:
                    match string_parse::to_i32 token:
                        Result::Ok val:
                            push_or_report stack val
                        Result::Err _:
                            print_error "unknown token";
                            ok<Stack<i32>,str> stack

fn process_token_state <(Result<Stack<i32>,str>,str)*>Result<Stack<i32>,str>> (state, token):
    match state:
        Result::Ok stack:
            process_token stack token
        Result::Err msg:
            err<Stack<i32>,str> msg

fn token_error_state <(Result<Stack<i32>,str>,str)*>Result<Stack<i32>,str>> (state, msg):
    match state:
        Result::Ok stack:
            stk::free<i32> stack;
            err<Stack<i32>,str> msg
        Result::Err old_msg:
            err<Stack<i32>,str> old_msg

//: eval_line: 1 行の RPN 式を評価する
//:
//: [目的/もくてき]:
//: - スペース区切りの RPN 式を評価し、結果または stack 個数エラーを表示します。
//: - token 配列を作らず、処理中の `Stack<i32>` owner だけを明示的に受け渡します。
fn eval_line <(str)*>()> (line):
    let trimmed <str> string_slice::str_trim line;
    let n <i32> string_access::len trimmed;

    match stk::new<i32>:
        Result::Ok stack0:
            let mut stack_state <Result<Stack<i32>,str>> ok<Stack<i32>,str> stack0;
            let mut start <i32> 0;
            let mut i <i32> 0;
            while le i n:
                do:
                    let is_end <bool> eq i n
                    let is_sep <bool> if:
                        is_end
                        then:
                            true
                        else:
                            match string_access::byte_at trimmed i:
                                Option::Some b:
                                    eq b 32
                                Option::None:
                                    true
                    if:
                        is_sep
                        then:
                            match string_slice::str_slice_result trimmed start i:
                                Result::Ok tok:
                                    set stack_state process_token_state stack_state tok
                                Result::Err msg:
                                    set stack_state token_error_state stack_state msg
                            set start add i 1
                        else:
                            ()
                    set i add i 1;

            match stack_state:
                Result::Ok stack:
                    let sp <i32> stk::len<i32> &stack;
                    if:
                        eq sp 1
                        then:
                            let popped <StackPop<i32>> stk::pop_top<i32> stack
                            let val_opt <Option<i32>> stk::stack_pop_item<i32> &popped
                            let next_stack <Stack<i32>> stk::stack_pop_stack<i32> popped
                            match val_opt:
                                Option::Some val:
                                    print_result val
                                Option::None:
                                    ()
                            stk::free<i32> next_stack
                        else:
                            if:
                                eq sp 0
                                then:
                                    stk::free<i32> stack
                                else:
                                    print_error string_concat::concat3 "stack has " string_format::from_i32 sp " values";
                                    stk::free<i32> stack
                Result::Err msg:
                    string_access::len msg;
                    ()
        Result::Err _:
            print_error "out of memory";

//: main: RPN REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - 初期バナーを表示し、EOF 相当の空入力まで 1 行ずつ評価します。
fn main <()*>()> ():
    let title_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Cyan;
    println_style title_style "RPN REPL";
    println_color AnsiColor::Gray "enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.";
    println "";

    let mut running <bool> true;
    while running:
        do:
            print_prompt;
            let input <str> read_line;
            if:
                eq string_access::len input 0
                then:
                    let bye_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Yellow;
                    println_style bye_style "bye";
                    set running false;
                else:
                    eval_line input;
