//: neplg2:test[gui_paint, normalize_newlines]
//: [目的/もくてき]: Paint GUI app が pointer event と ActionId を NEPL 側の update で処理できることを確認する
//: argv: ["--once"]
//:
//: gui_paint: pointer input を使う小さな paint app example
//:
//: [目的/もくてき]:
//: - button action だけでなく、full `GuiWebEvent` の pointer position を model update に使います。
//: - model は `Option PaintCell` の bounded stroke storage、選択色、stroke count を field として保持します。
//: - host の raw `ActionId` は `PaintAction` へ decode し、application update は enum と `match` で扱います。
//: - capacity overflow や canvas 外 pointer は `PaintUpdateError` として返し、event loop 側で owner を回収します。
//:
//: [注意/ちゅうい]:
//: - 現在は stdout fallback の軽量 example なので、stroke storage は固定容量です。
//: - 任意長 stroke buffer は `alloc/gui` の collection-backed widget state が安定した後に拡張します。
#entry main
#indent 4
#target std

#import "alloc/gui/app" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "platforms/gui/web" as *
#import "std/env/cliarg" as *
#import "std/stdio" as *

//: PaintColor: palette で選択できる色
//:
//: [目的/もくてき]:
//: - 0 / 1 / 2 の raw code を model の意味として扱わず、選択色を enum で表します。
//: - Web stdout protocol へ出す直前だけ、palette index として i32 code へ変換します。
enum PaintColor:
    A
    B
    C

impl Clone for PaintColor:
    fn clone %fn &PaintColor PaintColor \color:
        *color

impl Copy for PaintColor:
    fn copy_mark %fn PaintColor PaintColor \color:
        color

//: PaintAction: paint tool の control action
//:
//: [目的/もくてき]:
//: - palette 選択と clear を enum として表し、raw `ActionId` 比較を update 本体から外します。
//: - `Select` は payload として `PaintColor` を持つため、色追加時の分岐漏れを見つけやすくします。
enum PaintAction:
    Select %PaintColor
    Clear
    Unknown

impl Clone for PaintAction:
    fn clone %fn &PaintAction PaintAction \action:
        *action

impl Copy for PaintAction:
    fn copy_mark %fn PaintAction PaintAction \action:
        action

//: PaintCell: canvas 上の 1 stroke point
//:
//: [目的/もくてき]:
//: - cell index と描画時点の色をまとめ、現在選択中の色とは独立して stroke を再描画します。
//: - 欠如は `Option PaintCell` で表し、数値 sentinel は使いません。
struct PaintCell:
    slot %i32
    color %PaintColor

impl Clone for PaintCell:
    fn clone %fn &PaintCell PaintCell \cell:
        *cell

impl Copy for PaintCell:
    fn copy_mark %fn PaintCell PaintCell \cell:
        cell

//: PaintUpdateErrorKind: paint model update の失敗理由
//:
//: [目的/もくてき]:
//: - capacity overflow と pointer outside canvas を enum として分け、呼び出し側が `match` で扱えるようにします。
enum PaintUpdateErrorKind:
    CapacityFull
    PointerOutsideCanvas

impl Clone for PaintUpdateErrorKind:
    fn clone %fn &PaintUpdateErrorKind PaintUpdateErrorKind \kind:
        *kind

impl Copy for PaintUpdateErrorKind:
    fn copy_mark %fn PaintUpdateErrorKind PaintUpdateErrorKind \kind:
        kind

struct PaintModel:
    slot0 %Option PaintCell
    slot1 %Option PaintCell
    slot2 %Option PaintCell
    color %PaintColor
    count %i32

struct PaintUpdateError:
    model %PaintModel
    kind %PaintUpdateErrorKind

impl Clone for PaintModel:
    fn clone %fn &PaintModel PaintModel \model:
        *model

impl Copy for PaintModel:
    fn copy_mark %fn PaintModel PaintModel \model:
        model

impl Clone for PaintUpdateError:
    fn clone %fn &PaintUpdateError PaintUpdateError \error:
        *error

impl Copy for PaintUpdateError:
    fn copy_mark %fn PaintUpdateError PaintUpdateError \error:
        error

fn paint_cell_new %fn i32 fn PaintColor PaintCell \slot\color:
    PaintCell slot color

fn paint_cell_slot %fn &PaintCell i32 \cell:
    *field::get_ref cell "slot"

fn paint_cell_color %fn &PaintCell PaintColor \cell:
    *field::get_ref cell "color"

fn paint_model_new %fn Option PaintCell fn Option PaintCell fn Option PaintCell fn PaintColor fn i32 PaintModel \slot0\slot1\slot2\color\count:
    PaintModel slot0 slot1 slot2 color count

fn paint_model_empty %fn void PaintModel \void:
    let empty0 %Option PaintCell none
    let empty1 %Option PaintCell none
    let empty2 %Option PaintCell none
    paint_model_new empty0 empty1 empty2 PaintColor::A 0

fn paint_update_error_new %fn PaintModel fn PaintUpdateErrorKind PaintUpdateError \model\kind:
    PaintUpdateError model kind

fn paint_update_error_model %fn &PaintUpdateError PaintModel \error:
    *field::get_ref error "model"

fn paint_update_error_kind %fn &PaintUpdateError PaintUpdateErrorKind \error:
    *field::get_ref error "kind"

fn paint_slot0 %fn &PaintModel Option PaintCell \model:
    *field::get_ref model "slot0"

fn paint_slot1 %fn &PaintModel Option PaintCell \model:
    *field::get_ref model "slot1"

fn paint_slot2 %fn &PaintModel Option PaintCell \model:
    *field::get_ref model "slot2"

fn paint_color %fn &PaintModel PaintColor \model:
    *field::get_ref model "color"

fn paint_color_index %fn PaintColor i32 \color:
    match color:
        PaintColor::A:
            0
        PaintColor::B:
            1
        PaintColor::C:
            2

fn paint_model_color_index %fn &PaintModel i32 \model:
    let color %PaintColor paint_color model
    paint_color_index color

fn paint_count %fn &PaintModel i32 \model:
    *field::get_ref model "count"

fn paint_capacity %fn void i32 \void:
    3

fn paint_canvas_x %fn void i32 \void:
    20

fn paint_canvas_y %fn void i32 \void:
    20

fn paint_cell_size %fn void i32 \void:
    32

fn paint_grid_width %fn void i32 \void:
    16

fn paint_grid_height %fn void i32 \void:
    12

fn paint_canvas_width %fn void i32 \void:
    mul paint_grid_width paint_cell_size

fn paint_canvas_height %fn void i32 \void:
    mul paint_grid_height paint_cell_size

fn paint_action_color_a %fn void ActionId \void:
    action_id 1

fn paint_action_color_b %fn void ActionId \void:
    action_id 2

fn paint_action_color_c %fn void ActionId \void:
    action_id 3

fn paint_action_clear %fn void ActionId \void:
    action_id 4

fn paint_action_raw %fn ActionId i32 \action:
    action_id_value action

fn paint_decode_action %fn ActionId PaintAction \action:
    let raw %i32 paint_action_raw action
    match raw:
        1:
            PaintAction::Select PaintColor::A
        2:
            PaintAction::Select PaintColor::B
        3:
            PaintAction::Select PaintColor::C
        4:
            PaintAction::Clear
        _:
            PaintAction::Unknown

fn paint_slot_from_cell %fn i32 fn i32 i32 \cell_x\cell_y:
    let row %i32 mul cell_y 16
    add row cell_x

fn paint_slot_x %fn i32 i32 \slot:
    rem_s slot 16

fn paint_slot_y %fn i32 i32 \slot:
    div_s slot 16

//: paint_set_cell_result: stroke point を model に追加する
//:
//: [契約/けいやく]:
//: - capacity に空きがある場合は、現在選択中の色を持つ `PaintCell` を `Option::Some` として格納します。
//: - capacity が尽きている場合は model owner を `PaintUpdateError` へ入れて返し、caller が回収できるようにします。
fn paint_set_cell_result %fn PaintModel fn i32 fn i32 Result PaintModel PaintUpdateError \model\cell_x\cell_y:
    let slot_value %i32 paint_slot_from_cell cell_x cell_y
    let color %PaintColor paint_color &model
    let cell %PaintCell paint_cell_new slot_value color
    let cell_opt %Option PaintCell some cell
    let slot0 %Option PaintCell paint_slot0 &model
    let slot1 %Option PaintCell paint_slot1 &model
    let slot2 %Option PaintCell paint_slot2 &model
    let count %i32 paint_count &model
    match count:
        0:
            Result::Ok paint_model_new cell_opt slot1 slot2 color 1
        1:
            Result::Ok paint_model_new slot0 cell_opt slot2 color 2
        2:
            Result::Ok paint_model_new slot0 slot1 cell_opt color 3
        _:
            Result::Err paint_update_error_new model PaintUpdateErrorKind::CapacityFull

fn paint_set_color %fn PaintModel fn PaintColor PaintModel \model\color:
    let slot0 %Option PaintCell paint_slot0 &model
    let slot1 %Option PaintCell paint_slot1 &model
    let slot2 %Option PaintCell paint_slot2 &model
    let count %i32 paint_count &model
    paint_model_new slot0 slot1 slot2 color count

fn paint_update_action_result %fn PaintModel fn ActionId Result PaintModel PaintUpdateError \model\action:
    let typed %PaintAction paint_decode_action action
    match typed:
        PaintAction::Select color:
            Result::Ok paint_set_color model color
        PaintAction::Clear:
            Result::Ok paint_model_empty
        PaintAction::Unknown:
            Result::Ok model

fn paint_point_to_cell_x %fn GuiPoint i32 \point_milli:
    let x_milli %i32 gui_point_x &point_milli
    let x %i32 div_s x_milli 1000
    let local_x %i32 sub x paint_canvas_x
    div_s local_x paint_cell_size

fn paint_point_to_cell_y %fn GuiPoint i32 \point_milli:
    let y_milli %i32 gui_point_y &point_milli
    let y %i32 div_s y_milli 1000
    let local_y %i32 sub y paint_canvas_y
    div_s local_y paint_cell_size

fn paint_cell_is_inside %fn i32 fn i32 bool \cell_x\cell_y:
    let inside_x_left %bool ge cell_x 0
    let inside_x_right %bool lt cell_x paint_grid_width
    let inside_y_top %bool ge cell_y 0
    let inside_y_bottom %bool lt cell_y paint_grid_height
    let inside_x %bool and inside_x_left inside_x_right
    let inside_y %bool and inside_y_top inside_y_bottom
    and inside_x inside_y

fn paint_pointer_button_is_primary %fn &PointerEvent bool \pointer:
    match pointer_event_button pointer:
        PointerButton::Primary:
            true
        _:
            false

fn paint_pointer_should_draw %fn &PointerEvent bool \pointer:
    match pointer_event_kind pointer:
        PointerEventKind::Down:
            paint_pointer_button_is_primary pointer
        PointerEventKind::Move:
            paint_pointer_button_is_primary pointer
        _:
            false

fn paint_update_pointer_result %fn PaintModel fn GuiWebEvent fn PointerEvent Result PaintModel PaintUpdateError \model\web_event\pointer:
    if:
        paint_pointer_should_draw &pointer
        then:
            let point_milli %GuiPoint gui_web_event_point_milli &web_event
            let cell_x %i32 paint_point_to_cell_x point_milli
            let cell_y %i32 paint_point_to_cell_y point_milli
            if:
                paint_cell_is_inside cell_x cell_y
                then:
                    paint_set_cell_result model cell_x cell_y
                else:
                    Result::Err paint_update_error_new model PaintUpdateErrorKind::PointerOutsideCanvas
        else:
            Result::Ok model

fn paint_update_event_result %fn PaintModel fn GuiWebEvent Result PaintModel PaintUpdateError \model\web_event:
    match gui_web_event_action &web_event:
        Option::Some action:
            paint_update_action_result model action
        Option::None:
            match gui_web_event_pointer &web_event:
                Option::Some pointer:
                    paint_update_pointer_result model web_event pointer
                Option::None:
                    Result::Ok model

fn paint_color_background %fn void Rgba8888 \void:
    let r %u8 cast 11
    let g %u8 cast 15
    let b %u8 cast 20
    let a %u8 cast 255
    rgba8888_new r g b a

fn paint_color_canvas %fn void Rgba8888 \void:
    let r %u8 cast 235
    let g %u8 cast 239
    let b %u8 cast 232
    let a %u8 cast 255
    rgba8888_new r g b a

fn paint_color_panel %fn void Rgba8888 \void:
    let r %u8 cast 22
    let g %u8 cast 31
    let b %u8 cast 39
    let a %u8 cast 255
    rgba8888_new r g b a

fn paint_color_text %fn void Rgba8888 \void:
    let r %u8 cast 238
    let g %u8 cast 244
    let b %u8 cast 241
    let a %u8 cast 255
    rgba8888_new r g b a

fn paint_color_value %fn PaintColor Rgba8888 \color:
    let a %u8 cast 255
    match color:
        PaintColor::A:
            let r %u8 cast 36
            let g %u8 cast 116
            let b %u8 cast 210
            rgba8888_new r g b a
        PaintColor::B:
            let r %u8 cast 58
            let g %u8 cast 166
            let b %u8 cast 96
            rgba8888_new r g b a
        PaintColor::C:
            let r %u8 cast 214
            let g %u8 cast 74
            let b %u8 cast 70
            rgba8888_new r g b a

fn paint_present_slot %impure fn Option PaintCell Result unit GuiError \slot:
    match slot:
        Option::Some cell:
            let slot_index %i32 paint_cell_slot &cell
            let cell_x %i32 paint_slot_x slot_index
            let cell_y %i32 paint_slot_y slot_index
            let x_offset %i32 mul cell_x paint_cell_size
            let y_offset %i32 mul cell_y paint_cell_size
            let x %i32 add paint_canvas_x x_offset
            let y %i32 add paint_canvas_y y_offset
            let draw_size %i32 sub paint_cell_size 4
            let rect %GuiRect gui_rect_new x y draw_size draw_size
            let color %Rgba8888 paint_color_value paint_cell_color &cell
            gui_web_stdout_fill_rect rect color
        Option::None:
            Result::Ok unit

fn paint_present_slots %impure fn PaintModel Result unit GuiError \model:
    match paint_present_slot paint_slot0 &model:
        Result::Ok _:
            match paint_present_slot paint_slot1 &model:
                Result::Ok _:
                    paint_present_slot paint_slot2 &model
                Result::Err error:
                    Result::Err error
        Result::Err error:
            Result::Err error

fn paint_palette_rect %fn i32 GuiRect \index:
    let x_offset %i32 mul index 58
    let x %i32 add 558 x_offset
    gui_rect_new x 58 44 36

fn paint_button_clear_rect %fn void GuiRect \void:
    gui_rect_new 558 120 160 36

fn paint_present_palette_button %impure fn i32 impure fn ActionId Result unit GuiError \color_code\action:
    let rect %GuiRect paint_palette_rect color_code
    let color_model %PaintColor:
        match color_code:
            0:
                PaintColor::A
            1:
                PaintColor::B
            _:
                PaintColor::C
    let color %Rgba8888 paint_color_value color_model
    match gui_web_stdout_fill_rect rect color:
        Result::Ok _:
            gui_web_stdout_action_rect rect action
        Result::Err error:
            Result::Err error

fn paint_present_controls %impure fn PaintModel Result unit GuiError \model:
    let panel_rect %GuiRect gui_rect_new 544 20 192 420
    match gui_web_stdout_fill_rect panel_rect paint_color_panel:
        Result::Ok _:
            match paint_present_palette_button 0 paint_action_color_a:
                Result::Ok _:
                    match paint_present_palette_button 1 paint_action_color_b:
                        Result::Ok _:
                            match paint_present_palette_button 2 paint_action_color_c:
                                Result::Ok _:
                                    let clear_rect %GuiRect paint_button_clear_rect
                                    let clear_config %GuiWebButtonConfig gui_web_button_config clear_rect paint_action_clear "Clear" paint_color_background paint_color_text 13 10
                                    gui_web_stdout_button clear_config
                                Result::Err error:
                                    Result::Err error
                        Result::Err error:
                            Result::Err error
                Result::Err error:
                    Result::Err error
        Result::Err error:
            Result::Err error

fn paint_present_frame %impure fn PaintModel Result unit GuiError \model:
    match gui_web_stdout_frame_begin 12 756 464 "NEPLg2 Paint":
        Result::Ok _:
            let background %GuiRect gui_rect_new 0 0 756 464
            match gui_web_stdout_fill_rect background paint_color_background:
                Result::Ok _:
                    let canvas_rect %GuiRect gui_rect_new paint_canvas_x paint_canvas_y paint_canvas_width paint_canvas_height
                    match gui_web_stdout_fill_rect canvas_rect paint_color_canvas:
                        Result::Ok _:
                            match paint_present_slots model:
                                Result::Ok _:
                                    match paint_present_controls model:
                                        Result::Ok _:
                                            gui_web_stdout_frame_end
                                        Result::Err error:
                                            Result::Err error
                                Result::Err error:
                                    Result::Err error
                        Result::Err error:
                            Result::Err error
                Result::Err error:
                    Result::Err error
        Result::Err error:
            Result::Err error

fn paint_has_once_flag_loop %impure fn i32 impure fn i32 bool \idx\count:
    if:
        ge idx count
        then:
            false
        else:
            match cliarg_get idx:
                Option::Some arg:
                    if:
                        str_eq arg "--once"
                        then:
                            true
                        else:
                            let next_idx %i32 add idx 1
                            paint_has_once_flag_loop next_idx count
                Option::None:
                    let next_idx %i32 add idx 1
                    paint_has_once_flag_loop next_idx count

fn paint_has_once_flag %impure fn void bool \void:
    let count %i32 cliarg_count
    paint_has_once_flag_loop 1 count

fn paint_print_status %impure fn PaintModel unit \model:
    print "paint strokes = "
    let count %i32 paint_count &model
    println_i32 count
    print "paint color = "
    let color %i32 paint_model_color_index &model
    println_i32 color

fn paint_run_once %impure fn PaintModel unit \model:
    match paint_set_cell_result model 2 3:
        Result::Ok model1:
            match paint_present_frame model1:
                Result::Ok _:
                    paint_print_status model1
                Result::Err _:
                    println "paint gui protocol error"
        Result::Err update_error:
            let recovered %PaintModel paint_update_error_model &update_error
            paint_print_status recovered

fn paint_event_loop %impure fn PaintModel unit \initial_model:
    let mut model %PaintModel initial_model
    let mut running %bool true
    while running:
        do:
            match gui_web_wait_event_result 60000:
                Result::Ok event_result:
                    match event_result:
                        Option::Some web_event:
                            match paint_update_event_result model web_event:
                                Result::Ok next_model:
                                    set model next_model
                                    match paint_present_frame model:
                                        Result::Ok _:
                                            unit
                                        Result::Err _:
                                            println "paint gui protocol error";
                                            set running false
                                Result::Err update_error:
                                    set model paint_update_error_model &update_error
                                    match paint_present_frame model:
                                        Result::Ok _:
                                            unit
                                        Result::Err _:
                                            println "paint gui protocol error";
                                            set running false
                        Option::None:
                            unit
                Result::Err _:
                    println "paint gui input unsupported";
                    set running false

fn main %impure fn void unit \void:
    let model0 %PaintModel paint_model_empty
    if:
        paint_has_once_flag
        then:
            paint_run_once model0
        else:
            match paint_present_frame model0:
                Result::Ok _:
                    paint_event_loop model0
                Result::Err _:
                    println "paint gui protocol error"
