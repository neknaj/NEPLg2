//: neplg2:test[gui_life, normalize_newlines]
//: [目的/もくてき]: Life pattern を NEPL 側の model / update / view から描画し、Web Playground host protocol へ frame を出力できることを確認する
//: argv: ["--once"]
//:
//: gui_life: Conway の Life pattern を HD surface 上に描画する GUI app model の例
//:
//: [目的/もくてき]:
//: - game state、update、描画を分け、backend なしでも状態遷移を追える形にします。
//: - `Next` と `Animate` は `ActionId` として view から発行し、update が model を更新します。
//: - cell size を変えることで 1280x640 の board surface を粗い表示から HD 相当の細かい表示へ切り替えます。
//:
//: [実装/じっそう]:
//: - 盤面は 1280x640 logical px に固定し、model の cell size から cell count を決めます。
//: - `step` から glider / blinker pattern の位置を計算し、live cell だけを command として出力します。
//: - 通常実行では full `GuiWebEvent` を待ち、Action event だけを update message として扱います。
//:
//: [注意/ちゅうい]:
//: - この example は描画・event loop・TEA 形の確認用であり、任意サイズ盤面の完全保存 model は後続の `alloc/gui` collection 安定化後に追加します。
//: - Web stdout protocol は `platforms/gui/web` の fallback transport であり、正式 host import ABI へ置き換える予定です。
#entry main
#indent 4
#target std

#import "alloc/gui/app" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "platforms/gui/web" as *
#import "std/env/cliarg" as *
#import "std/stdio" as *

struct LifeModel:
    step %i32
    animate %bool
    cell_size %i32

impl Clone for LifeModel:
    fn clone %fn &LifeModel LifeModel \model:
        *model

impl Copy for LifeModel:
    fn copy_mark %fn LifeModel LifeModel \model:
        model

fn life_model_new %fn i32 fn bool fn i32 LifeModel \step\animate\cell_size:
    LifeModel step animate cell_size

fn life_model_step %fn &LifeModel i32 \model:
    *field::get_ref model "step"

fn life_model_animate %fn &LifeModel bool \model:
    *field::get_ref model "animate"

fn life_model_cell_size %fn &LifeModel i32 \model:
    *field::get_ref model "cell_size"

fn life_board_width_px %fn unit i32 \unit:
    1280

fn life_board_height_px %fn unit i32 \unit:
    640

fn life_control_height %fn unit i32 \unit:
    88

fn life_frame_width %fn unit i32 \unit:
    life_board_width_px

fn life_frame_height %fn unit i32 \unit:
    add life_board_height_px life_control_height

fn life_default_cell_size %fn unit i32 \unit:
    32

fn life_hd_cell_size %fn unit i32 \unit:
    8

fn life_min_cell_size %fn unit i32 \unit:
    8

fn life_max_cell_size %fn unit i32 \unit:
    48

fn life_cell_draw_size %fn i32 i32 \cell_size:
    if:
        le cell_size 3
        then:
            cell_size
        else:
            sub cell_size 2

fn life_board_width %fn i32 i32 \cell_size:
    div_s life_board_width_px cell_size

fn life_board_height %fn i32 i32 \cell_size:
    div_s life_board_height_px cell_size

fn life_next_action %fn unit ActionId \unit:
    action_id 1

fn life_animate_action %fn unit ActionId \unit:
    action_id 2

fn life_resolution_down_action %fn unit ActionId \unit:
    action_id 3

fn life_resolution_up_action %fn unit ActionId \unit:
    action_id 4

fn life_hd_action %fn unit ActionId \unit:
    action_id 5

fn life_action_matches %fn ActionId fn ActionId bool \actual\expected:
    let actual_raw %i32 action_id_value actual
    let expected_raw %i32 action_id_value expected
    eq actual_raw expected_raw

fn life_wrap_positive %fn i32 fn i32 i32 \value\limit:
    let shifted %i32 add value limit
    rem_s shifted limit

fn life_glider_origin %fn i32 fn i32 fn i32 i32 \offset\shift\limit:
    let safe_limit %i32 sub limit 4
    if:
        le safe_limit 1
        then:
            offset
        else:
            let moved %i32 add offset shift
            life_wrap_positive moved safe_limit

fn life_phase %fn i32 i32 \step:
    rem_s step 4

fn life_shift %fn i32 i32 \step:
    div_s step 4

fn life_live_color %fn unit Rgba8888 \unit:
    let r %u8 cast 36
    let g %u8 cast 220
    let b %u8 cast 184
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_live_color_alt %fn unit Rgba8888 \unit:
    let r %u8 cast 146
    let g %u8 cast 222
    let b %u8 cast 92
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_color_background %fn unit Rgba8888 \unit:
    let r %u8 cast 9
    let g %u8 cast 14
    let b %u8 cast 18
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_color_grid %fn unit Rgba8888 \unit:
    let r %u8 cast 18
    let g %u8 cast 28
    let b %u8 cast 34
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_color_button %fn unit Rgba8888 \unit:
    let r %u8 cast 40
    let g %u8 cast 96
    let b %u8 cast 120
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_color_button_alt %fn unit Rgba8888 \unit:
    let r %u8 cast 76
    let g %u8 cast 104
    let b %u8 cast 70
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_color_text %fn unit Rgba8888 \unit:
    let r %u8 cast 235
    let g %u8 cast 242
    let b %u8 cast 238
    let a %u8 cast 255
    rgba8888_new r g b a

fn life_present_live_cell %impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \x\y\cell_size\color:
    let px %i32 mul x cell_size
    let py %i32 mul y cell_size
    let draw_size %i32 life_cell_draw_size cell_size
    let rect %GuiRect gui_rect_new px py draw_size draw_size
    gui_web_stdout_fill_rect rect color

fn life_present_glider_phase0 %impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \ox\oy\cell_size\color:
    let x1 %i32 add ox 1
    let x2 %i32 add ox 2
    let y1 %i32 add oy 1
    let y2 %i32 add oy 2
    match life_present_live_cell x1 oy cell_size color:
        Result::Ok _:
            match life_present_live_cell x2 y1 cell_size color:
                Result::Ok _:
                    match life_present_live_cell ox y2 cell_size color:
                        Result::Ok _:
                            match life_present_live_cell x1 y2 cell_size color:
                                Result::Ok _:
                                    life_present_live_cell x2 y2 cell_size color
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_glider_phase1 %impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \ox\oy\cell_size\color:
    let x1 %i32 add ox 1
    let x2 %i32 add ox 2
    let y1 %i32 add oy 1
    let y2 %i32 add oy 2
    let y3 %i32 add oy 3
    match life_present_live_cell ox y1 cell_size color:
        Result::Ok _:
            match life_present_live_cell x2 y1 cell_size color:
                Result::Ok _:
                    match life_present_live_cell x1 y2 cell_size color:
                        Result::Ok _:
                            match life_present_live_cell x2 y2 cell_size color:
                                Result::Ok _:
                                    life_present_live_cell x1 y3 cell_size color
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_glider_phase2 %impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \ox\oy\cell_size\color:
    let x1 %i32 add ox 1
    let x2 %i32 add ox 2
    let y1 %i32 add oy 1
    let y2 %i32 add oy 2
    let y3 %i32 add oy 3
    match life_present_live_cell x2 y1 cell_size color:
        Result::Ok _:
            match life_present_live_cell ox y2 cell_size color:
                Result::Ok _:
                    match life_present_live_cell x2 y2 cell_size color:
                        Result::Ok _:
                            match life_present_live_cell x1 y3 cell_size color:
                                Result::Ok _:
                                    life_present_live_cell x2 y3 cell_size color
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_glider_phase3 %impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \ox\oy\cell_size\color:
    let x1 %i32 add ox 1
    let x2 %i32 add ox 2
    let x3 %i32 add ox 3
    let y1 %i32 add oy 1
    let y2 %i32 add oy 2
    let y3 %i32 add oy 3
    match life_present_live_cell x1 y1 cell_size color:
        Result::Ok _:
            match life_present_live_cell x2 y2 cell_size color:
                Result::Ok _:
                    match life_present_live_cell x3 y2 cell_size color:
                        Result::Ok _:
                            match life_present_live_cell x1 y3 cell_size color:
                                Result::Ok _:
                                    life_present_live_cell x2 y3 cell_size color
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_glider %impure fn LifeModel impure fn i32 impure fn i32 impure fn i32 impure fn Rgba8888 Result unit GuiError \model\offset_x\offset_y\shift_bias\color:
    let step %i32 life_model_step &model
    let cell_size %i32 life_model_cell_size &model
    let board_width %i32 life_board_width cell_size
    let board_height %i32 life_board_height cell_size
    let base_shift %i32 life_shift step
    let shift %i32 add base_shift shift_bias
    let ox %i32 life_glider_origin offset_x shift board_width
    let oy %i32 life_glider_origin offset_y shift board_height
    let phase %i32 life_phase step
    if:
        eq phase 0
        then:
            life_present_glider_phase0 ox oy cell_size color
        else:
            if:
                eq phase 1
                then:
                    life_present_glider_phase1 ox oy cell_size color
                else:
                    if:
                        eq phase 2
                        then:
                            life_present_glider_phase2 ox oy cell_size color
                        else:
                            life_present_glider_phase3 ox oy cell_size color

fn life_present_blinker %impure fn LifeModel impure fn i32 impure fn i32 Result unit GuiError \model\ox\oy:
    let step %i32 life_model_step &model
    let phase %i32 rem_s step 2
    let cell_size %i32 life_model_cell_size &model
    let color %Rgba8888 life_live_color_alt
    if:
        eq phase 0
        then:
            let x1 %i32 add ox 1
            let x2 %i32 add ox 2
            match life_present_live_cell ox oy cell_size color:
                Result::Ok _:
                    match life_present_live_cell x1 oy cell_size color:
                        Result::Ok _:
                            life_present_live_cell x2 oy cell_size color
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        else:
            let y1 %i32 add oy 1
            let y2 %i32 add oy 2
            match life_present_live_cell ox oy cell_size color:
                Result::Ok _:
                    match life_present_live_cell ox y1 cell_size color:
                        Result::Ok _:
                            life_present_live_cell ox y2 cell_size color
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err

fn life_present_patterns %impure fn LifeModel Result unit GuiError \model:
    let color %Rgba8888 life_live_color
    match life_present_glider model 2 2 0 color:
        Result::Ok _:
            match life_present_glider model 16 8 5 color:
                Result::Ok _:
                    match life_present_glider model 28 3 11 color:
                        Result::Ok _:
                            life_present_blinker model 7 14
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_button_next_rect %fn unit GuiRect \unit:
    let y %i32 add life_board_height_px 16
    gui_rect_new 18 y 84 34

fn life_button_animate_rect %fn unit GuiRect \unit:
    let y %i32 add life_board_height_px 16
    gui_rect_new 114 y 112 34

fn life_button_minus_rect %fn unit GuiRect \unit:
    let y %i32 add life_board_height_px 16
    gui_rect_new 238 y 56 34

fn life_button_plus_rect %fn unit GuiRect \unit:
    let y %i32 add life_board_height_px 16
    gui_rect_new 306 y 56 34

fn life_button_hd_rect %fn unit GuiRect \unit:
    let y %i32 add life_board_height_px 16
    gui_rect_new 374 y 72 34

fn life_present_text %impure fn GuiPoint impure fn i32 impure fn str Result unit GuiError \origin\size\text:
    gui_web_stdout_text_run origin size GuiWebTextAlign::Center life_color_text text

fn life_present_button %impure fn GuiRect impure fn ActionId impure fn str impure fn Rgba8888 Result unit GuiError \rect\action\label\color:
    match gui_web_stdout_fill_rect rect color:
        Result::Ok _:
            let x %i32 gui_rect_x &rect
            let y %i32 gui_rect_y &rect
            let w %i32 gui_rect_width &rect
            let half_w %i32 div_s w 2
            let text_x %i32 add x half_w
            let text_y %i32 add y 10
            let origin %GuiPoint gui_point_new text_x text_y
            match life_present_text origin 12 label:
                Result::Ok _:
                    gui_web_stdout_action_rect rect action
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_status %impure fn LifeModel Result unit GuiError \model:
    let y %i32 add life_board_height_px 62
    let step_origin %GuiPoint gui_point_new 70 y
    match gui_web_stdout_text_i32 step_origin 14 GuiWebTextAlign::Center life_color_text life_model_step &model:
        Result::Ok _:
            let cell_origin %GuiPoint gui_point_new 170 y
            match gui_web_stdout_text_i32 cell_origin 14 GuiWebTextAlign::Center life_color_text life_model_cell_size &model:
                Result::Ok _:
                    let width_origin %GuiPoint gui_point_new 284 y
                    gui_web_stdout_text_i32 width_origin 14 GuiWebTextAlign::Center life_color_text life_board_width life_model_cell_size &model
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_controls %impure fn LifeModel Result unit GuiError \model:
    match life_present_button life_button_next_rect life_next_action "Next" life_color_button:
        Result::Ok _:
            match life_present_button life_button_animate_rect life_animate_action "Animate" life_color_button_alt:
                Result::Ok _:
                    match life_present_button life_button_minus_rect life_resolution_down_action "-" life_color_button:
                        Result::Ok _:
                            match life_present_button life_button_plus_rect life_resolution_up_action "+" life_color_button:
                                Result::Ok _:
                                    match life_present_button life_button_hd_rect life_hd_action "HD" life_color_button_alt:
                                        Result::Ok _:
                                            life_present_status model
                                        Result::Err err:
                                            Result::Err err
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_present_frame %impure fn LifeModel Result unit GuiError \model:
    match gui_web_stdout_frame_begin 2 life_frame_width life_frame_height "NEPLg2 Life":
        Result::Ok _:
            let board_rect %GuiRect gui_rect_new 0 0 life_board_width_px life_board_height_px
            match gui_web_stdout_fill_rect board_rect life_color_background:
                Result::Ok _:
                    let control_rect %GuiRect gui_rect_new 0 life_board_height_px life_board_width_px life_control_height
                    match gui_web_stdout_fill_rect control_rect life_color_grid:
                        Result::Ok _:
                            match life_present_patterns model:
                                Result::Ok _:
                                    match life_present_controls model:
                                        Result::Ok _:
                                            gui_web_stdout_frame_end
                                        Result::Err err:
                                            Result::Err err
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn life_next_step %fn i32 i32 \step:
    add step 1

fn life_smaller_cell_size %fn i32 i32 \cell_size:
    if:
        ge cell_size life_max_cell_size
        then:
            cell_size
        else:
            add cell_size 8

fn life_larger_cell_count_size %fn i32 i32 \cell_size:
    if:
        le cell_size life_min_cell_size
        then:
            cell_size
        else:
            sub cell_size 8

fn life_update_action %fn LifeModel fn ActionId LifeModel \model\action:
    let step %i32 life_model_step &model
    let animate %bool life_model_animate &model
    let cell_size %i32 life_model_cell_size &model
    if:
        life_action_matches action life_next_action
        then:
            let next_step %i32 life_next_step step
            life_model_new next_step animate cell_size
        else:
            if:
                life_action_matches action life_animate_action
                then:
                    let next_animate %bool not animate
                    life_model_new step next_animate cell_size
                else:
                    if:
                        life_action_matches action life_resolution_down_action
                        then:
                            let next_size %i32 life_smaller_cell_size cell_size
                            life_model_new step animate next_size
                        else:
                            if:
                                life_action_matches action life_resolution_up_action
                                then:
                                    let next_size %i32 life_larger_cell_count_size cell_size
                                    life_model_new step animate next_size
                                else:
                                    if:
                                        life_action_matches action life_hd_action
                                        then:
                                            life_model_new step animate life_hd_cell_size
                                        else:
                                            model

fn life_update_event %fn LifeModel fn GuiWebEvent LifeModel \model\web_event:
    match gui_web_event_action &web_event:
        Option::Some action:
            life_update_action model action
        Option::None:
            model

fn life_animation_tick %fn LifeModel LifeModel \model:
    let step %i32 life_model_step &model
    let animate %bool life_model_animate &model
    let cell_size %i32 life_model_cell_size &model
    let next_step %i32 life_next_step step
    life_model_new next_step animate cell_size

fn life_has_once_flag_loop %impure fn i32 impure fn i32 bool \idx\count:
    if:
        ge idx count
        then:
            false
        else:
            match cliarg_get idx:
                Option::Some arg:
                    if:
                        str_eq arg "--once"
                        then:
                            true
                        else:
                            let next_idx %i32 add idx 1
                            life_has_once_flag_loop next_idx count
                Option::None:
                    let next_idx %i32 add idx 1
                    life_has_once_flag_loop next_idx count

fn life_has_once_flag %impure fn unit bool \unit:
    let count %i32 cliarg_count
    life_has_once_flag_loop 1 count

fn life_live_count %fn unit i32 \unit:
    18

fn life_print_status %impure fn LifeModel unit \model:
    print "life live cells = "
    println_i32 life_live_count
    print "life step = "
    let step %i32 life_model_step &model
    println_i32 step
    print "life cell size = "
    let cell_size %i32 life_model_cell_size &model
    println_i32 cell_size
    print "life board width = "
    let board_width %i32 life_board_width cell_size
    println_i32 board_width

fn life_run_once %impure fn LifeModel unit \model:
    match life_present_frame model:
        Result::Ok _:
            life_print_status model
        Result::Err _:
            println "life gui protocol error"

fn life_event_loop %impure fn LifeModel unit \initial_model:
    let mut model %LifeModel initial_model
    let mut running %bool true
    while running:
        do:
            let animate %bool life_model_animate &model
            let timeout_ms %i32 if animate 250 60000
            match gui_web_wait_event_result timeout_ms:
                Result::Ok event_result:
                    match event_result:
                        Option::Some web_event:
                            let next_model %LifeModel life_update_event model web_event
                            match life_present_frame next_model:
                                Result::Ok _:
                                    set model next_model
                                Result::Err _:
                                    println "life gui protocol error";
                                    set running false
                        Option::None:
                            if:
                                animate
                                then:
                                    let next_model %LifeModel life_animation_tick model
                                    match life_present_frame next_model:
                                        Result::Ok _:
                                            set model next_model
                                        Result::Err _:
                                            println "life gui protocol error";
                                            set running false
                                else:
                                    unit
                Result::Err _:
                    println "life gui input unsupported";
                    set running false

fn main %impure fn unit unit \unit:
    let model0 %LifeModel life_model_new 0 false life_default_cell_size
    if:
        life_has_once_flag
        then:
            life_run_once model0
        else:
            match life_present_frame model0:
                Result::Ok _:
                    life_event_loop model0
                Result::Err _:
                    println "life gui protocol error"
