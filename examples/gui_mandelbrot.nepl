//: neplg2:test[gui_mandelbrot, normalize_newlines]
//: [目的/もくてき]: Mandelbrot preview を NEPL 側の model / update / view から row payload frame として出力できることを確認する
//: argv: ["--once"]
//:
//: neplg2:test[gui_mandelbrot_hd_contract, normalize_newlines]
//: [目的/もくてき]: HD mode が 1280x720 logical frame を row payload で表すことを確認する
//: argv: ["--test-hd-contract"]
//: stdout: "mandelbrot hd contract ok\n"
//:
//: neplg2:test[gui_mandelbrot_video_memory_contract, normalize_newlines]
//: [目的/もくてき]: formal Web video memory path の有限 surface contract を確認する
//: argv: ["--test-video-memory-contract"]
//: stdout: "mandelbrot video memory contract ok\n"
//:
//: neplg2:test[gui_mandelbrot_responsive_contract, normalize_newlines]
//: [目的/もくてき]: window resize event が drawable pixel size に合わせた Mandelbrot model を作ることを確認する
//: argv: ["--test-responsive-contract"]
//: stdout: "mandelbrot responsive contract ok\n"
//:
//: gui_mandelbrot: Mandelbrot 集合を HD surface 向けの GUI row payload stream として描画する例
//:
//: [目的/もくてき]:
//: - Canvas や DOM に依存せず、NEPL の model から `rgba-row` payload command stream を作ります。
//: - button は closure ではなく `ActionId` を持ち、update は action と model から次の model を返します。
//: - HD button は 1280x720 logical surface に 1 logical pixel per sample の row payload を描きます。
//: - resize event は drawable pixel size から model を作り直し、window 側で content を伸縮しない契約を固定します。
//: - `--video-memory-once` は stdout path へ戻らない formal Web video memory host import の有限検査用 path です。
//: - `--video-memory-loop` は formal Web video memory surface を開いたまま typed window event を待ち、resize で surface を作り直します。
//:
//: [実装/じっそう]:
//: - fixed point scale 100 の i32 計算で escape iteration を求めます。
//: - frame の論理 surface size と sample count を分け、HD でも 1 pixel ごとの `FillRect` command stream にはしません。
//: - 通常実行は Web input bridge の action event を待ち、action ごとに再描画します。
//: - 表示解像度と ActionId は enum へ decode し、model/update は raw number を直接分岐しません。
//:
//: [注意/ちゅうい]:
//: - `--once` は CI 向けに軽量 preview mode で有限実行します。
//: - interactive path は現 checkpoint では legacy stdout smoke transport を使います。
//: - `--video-memory-once` は独立した opt-in path であり、host import が失敗しても stdout transport へ fallback しません。
//: - `--video-memory-loop-test` の wait 回数上限は CI の停止条件であり、実際の scheduler policy ではありません。
#entry main
#indent 4
#target std

#import "alloc/gui/app" as *
#import "alloc/io" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "platforms/gui/web" as *
#import "std/env/cliarg" as *
#import "std/gui" as *
#import "std/stdio" as *

//: MandelbrotMode: 表示解像度 preset
//:
//: [目的/もくてき]:
//: - model の mode を raw i32 ではなく意味のある variant として保持します。
//: - status 表示用の数値は `mandelbrot_mode_debug_code` で明示的に変換します。
enum MandelbrotMode:
    Preview
    HD
    Detail
    Responsive

impl Clone for MandelbrotMode:
    fn clone %fn &MandelbrotMode MandelbrotMode \mode:
        *mode

impl Copy for MandelbrotMode:
    fn copy_mark %fn MandelbrotMode MandelbrotMode \mode:
        mode

//: MandelbrotAction: preset button から update へ渡す action
//:
//: [目的/もくてき]:
//: - host の `ActionId` と application model の preset 選択を分離します。
//: - 未知の action は `Unknown` として扱い、update 側では no-op にします。
enum MandelbrotAction:
    Preview
    HD
    Detail
    Unknown

impl Clone for MandelbrotAction:
    fn clone %fn &MandelbrotAction MandelbrotAction \action:
        *action

impl Copy for MandelbrotAction:
    fn copy_mark %fn MandelbrotAction MandelbrotAction \action:
        action

struct MandelbrotModel:
    sample_width %i32
    sample_height %i32
    cell_size %i32
    iteration_limit %i32
    mode %MandelbrotMode

impl Clone for MandelbrotModel:
    fn clone %fn &MandelbrotModel MandelbrotModel \model:
        *model

impl Copy for MandelbrotModel:
    fn copy_mark %fn MandelbrotModel MandelbrotModel \model:
        model

fn mandelbrot_model_new %fn i32 fn i32 fn i32 fn i32 fn MandelbrotMode MandelbrotModel \sample_width\sample_height\cell_size\iteration_limit\mode:
    MandelbrotModel sample_width sample_height cell_size iteration_limit mode

fn mandelbrot_model_sample_width %fn &MandelbrotModel i32 \model:
    *field::get_ref model "sample_width"

fn mandelbrot_model_sample_height %fn &MandelbrotModel i32 \model:
    *field::get_ref model "sample_height"

fn mandelbrot_model_cell_size %fn &MandelbrotModel i32 \model:
    *field::get_ref model "cell_size"

fn mandelbrot_model_iteration_limit %fn &MandelbrotModel i32 \model:
    *field::get_ref model "iteration_limit"

fn mandelbrot_model_mode %fn &MandelbrotModel MandelbrotMode \model:
    *field::get_ref model "mode"

fn mandelbrot_mode_debug_code %fn MandelbrotMode i32 \mode:
    match mode:
        MandelbrotMode::Preview:
            1
        MandelbrotMode::HD:
            2
        MandelbrotMode::Detail:
            3
        MandelbrotMode::Responsive:
            4

fn mandelbrot_model_preview %fn void MandelbrotModel \void:
    mandelbrot_model_new 48 27 8 24 MandelbrotMode::Preview

fn mandelbrot_model_hd %fn void MandelbrotModel \void:
    mandelbrot_model_new 1280 648 1 64 MandelbrotMode::HD

fn mandelbrot_model_detail %fn void MandelbrotModel \void:
    mandelbrot_model_new 1280 648 1 96 MandelbrotMode::Detail

fn mandelbrot_control_height %fn void i32 \void:
    72

fn mandelbrot_min_sample_extent %fn void i32 \void:
    2

fn mandelbrot_clamp_sample_extent %fn i32 i32 \value:
    if:
        lt value mandelbrot_min_sample_extent
        then:
            mandelbrot_min_sample_extent
        else:
            value

fn mandelbrot_responsive_sample_height %fn i32 i32 \surface_height:
    let content_height %i32 sub surface_height mandelbrot_control_height
    mandelbrot_clamp_sample_extent content_height

fn mandelbrot_model_for_surface %fn i32 fn i32 MandelbrotModel \surface_width\surface_height:
    let sample_width %i32 mandelbrot_clamp_sample_extent surface_width
    let sample_height %i32 mandelbrot_responsive_sample_height surface_height
    mandelbrot_model_new sample_width sample_height 1 64 MandelbrotMode::Responsive

fn mandelbrot_frame_width %fn &MandelbrotModel i32 \model:
    let sample_width %i32 mandelbrot_model_sample_width model
    let cell_size %i32 mandelbrot_model_cell_size model
    mul sample_width cell_size

fn mandelbrot_grid_height %fn &MandelbrotModel i32 \model:
    let sample_height %i32 mandelbrot_model_sample_height model
    let cell_size %i32 mandelbrot_model_cell_size model
    mul sample_height cell_size

fn mandelbrot_frame_height %fn &MandelbrotModel i32 \model:
    let grid_height %i32 mandelbrot_grid_height model
    add grid_height mandelbrot_control_height

fn mandelbrot_preview_action %fn void ActionId \void:
    action_id 1

fn mandelbrot_hd_action %fn void ActionId \void:
    action_id 2

fn mandelbrot_detail_action %fn void ActionId \void:
    action_id 3

fn mandelbrot_decode_action %fn ActionId MandelbrotAction \action:
    let raw %i32 action_id_value action
    match raw:
        1:
            MandelbrotAction::Preview
        2:
            MandelbrotAction::HD
        3:
            MandelbrotAction::Detail
        _:
            MandelbrotAction::Unknown

fn mandelbrot_cx %fn i32 fn i32 i32 \x\sample_width:
    let denom %i32 sub sample_width 1
    let numerator %i32 mul x 300
    let scaled %i32 div_s numerator denom
    add scaled -220

fn mandelbrot_cy %fn i32 fn i32 i32 \y\sample_height:
    let denom %i32 sub sample_height 1
    let numerator %i32 mul y 220
    let scaled %i32 div_s numerator denom
    add scaled -110

fn mandelbrot_escape_loop %fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 i32 \zx\zy\cx\cy\limit\iter:
    let zx2 %i32 mul zx zx
    let zy2 %i32 mul zy zy
    let mag2 %i32 add zx2 zy2
    let escaped %bool ge mag2 40000
    let hit_limit %bool ge iter limit
    let done %bool or escaped hit_limit
    if:
        done
        then:
            iter
        else:
            let zx2_scaled %i32 div_s zx2 100
            let zy2_scaled %i32 div_s zy2 100
            let real_delta %i32 sub zx2_scaled zy2_scaled
            let next_zx %i32 add real_delta cx
            let cross %i32 mul zx zy
            let cross_double %i32 mul cross 2
            let cross_scaled %i32 div_s cross_double 100
            let next_zy %i32 add cross_scaled cy
            let next_iter %i32 add iter 1
            mandelbrot_escape_loop next_zx next_zy cx cy limit next_iter

fn mandelbrot_cell_iter %fn i32 fn i32 fn MandelbrotModel i32 \x\y\model:
    let sample_width %i32 mandelbrot_model_sample_width &model
    let sample_height %i32 mandelbrot_model_sample_height &model
    let cx %i32 mandelbrot_cx x sample_width
    let cy %i32 mandelbrot_cy y sample_height
    let limit %i32 mandelbrot_model_iteration_limit &model
    mandelbrot_escape_loop 0 0 cx cy limit 0

fn mandelbrot_color %fn i32 fn i32 Rgba8888 \iter\limit:
    let full %u8 cast 255
    if:
        eq iter limit
        then:
            let r0 %u8 cast 3
            let g0 %u8 cast 7
            let b0 %u8 cast 12
            rgba8888_new r0 g0 b0 full
        else:
            let red_i32 %i32 add 24 mul iter 3
            let green_i32 %i32 add 52 mul iter 5
            let blue_i32 %i32 add 98 mul iter 4
            let red %u8 cast red_i32
            let green %u8 cast green_i32
            let blue %u8 cast blue_i32
            rgba8888_new red green blue full

fn mandelbrot_color_background %fn void Rgba8888 \void:
    let r %u8 cast 9
    let g %u8 cast 13
    let b %u8 cast 18
    let a %u8 cast 255
    rgba8888_new r g b a

fn mandelbrot_color_button %fn void Rgba8888 \void:
    let r %u8 cast 34
    let g %u8 cast 60
    let b %u8 cast 87
    let a %u8 cast 255
    rgba8888_new r g b a

fn mandelbrot_color_button_alt %fn void Rgba8888 \void:
    let r %u8 cast 72
    let g %u8 cast 103
    let b %u8 cast 129
    let a %u8 cast 255
    rgba8888_new r g b a

fn mandelbrot_color_text %fn void Rgba8888 \void:
    let r %u8 cast 234
    let g %u8 cast 242
    let b %u8 cast 249
    let a %u8 cast 255
    rgba8888_new r g b a

fn mandelbrot_video_memory_slot_count %fn void i32 \void:
    2

fn mandelbrot_video_memory_window_id %fn void i32 \void:
    1

fn mandelbrot_video_memory_model %fn void MandelbrotModel \void:
    mandelbrot_model_new 32 18 1 24 MandelbrotMode::Preview

fn mandelbrot_push_rgba_byte %fn ByteBuilder fn i32 Result ByteBuilder ByteBuilderError \builder\value:
    byte_builder_push_u8 builder value

fn mandelbrot_video_memory_push_pixel %fn ByteBuilder fn Rgba8888 Result ByteBuilder ByteBuilderError \builder\color:
    let red %i32 cast rgba8888_r &color
    let green %i32 cast rgba8888_g &color
    let blue %i32 cast rgba8888_b &color
    let alpha %i32 cast rgba8888_a &color
    match mandelbrot_push_rgba_byte builder red:
        Result::Ok b1:
            match mandelbrot_push_rgba_byte b1 green:
                Result::Ok b2:
                    match mandelbrot_push_rgba_byte b2 blue:
                        Result::Ok b3:
                            mandelbrot_push_rgba_byte b3 alpha
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn mandelbrot_video_memory_push_row_pixels %fn ByteBuilder fn i32 fn i32 fn MandelbrotModel Result ByteBuilder ByteBuilderError \builder\x\y\model:
    let sample_width %i32 mandelbrot_model_sample_width &model
    if:
        ge x sample_width
        then:
            Result::Ok builder
        else:
            let iter %i32 mandelbrot_cell_iter x y model
            let limit %i32 mandelbrot_model_iteration_limit &model
            let color %Rgba8888 mandelbrot_color iter limit
            match mandelbrot_video_memory_push_pixel builder color:
                Result::Ok next_builder:
                    let next_x %i32 add x 1
                    mandelbrot_video_memory_push_row_pixels next_builder next_x y model
                Result::Err err:
                    Result::Err err

fn mandelbrot_video_memory_builder_error %fn ByteBuilderError GuiError \error:
    byte_builder_error_free error
    GuiError::ResourceExhausted

fn mandelbrot_video_memory_build_row %fn i32 fn MandelbrotModel Result ByteBuf GuiError \y\model:
    match byte_builder_new:
        Result::Err _error:
            Result::Err GuiError::ResourceExhausted
        Result::Ok builder:
            match mandelbrot_video_memory_push_row_pixels builder 0 y model:
                Result::Err error:
                    Result::Err mandelbrot_video_memory_builder_error error
                Result::Ok filled:
                    match byte_builder_finish filled:
                        Result::Ok bytes:
                            Result::Ok bytes
                        Result::Err error:
                            Result::Err mandelbrot_video_memory_builder_error error

fn mandelbrot_video_memory_write_row_bytes %impure fn &GuiWebVideoMemorySurface impure fn FrameId impure fn i32 impure fn i32 impure fn ByteBuf Result unit GuiError \surface\frame\width\y\bytes:
    match io_bytebuf_ptr_ref &bytes:
        Option::Some ptr:
            let origin %GuiPoint gui_point_new 0 y
            let write_result %Result unit GuiError gui_web_video_memory_write_rgba8888_row surface frame origin width ptr
            io_bytebuf_free bytes
            write_result
        Option::None:
            io_bytebuf_free bytes
            Result::Err GuiError::ResourceExhausted

fn mandelbrot_video_memory_write_row %impure fn &GuiWebVideoMemorySurface impure fn FrameId impure fn i32 impure fn MandelbrotModel Result unit GuiError \surface\frame\y\model:
    let width %i32 mandelbrot_model_sample_width &model
    match mandelbrot_video_memory_build_row y model:
        Result::Ok bytes:
            mandelbrot_video_memory_write_row_bytes surface frame width y bytes
        Result::Err error:
            Result::Err error

fn mandelbrot_video_memory_write_rows %impure fn &GuiWebVideoMemorySurface impure fn FrameId impure fn i32 impure fn MandelbrotModel Result unit GuiError \surface\frame\y\model:
    let height %i32 mandelbrot_model_sample_height &model
    if:
        ge y height
        then:
            Result::Ok unit
        else:
            match mandelbrot_video_memory_write_row surface frame y model:
                Result::Ok _:
                    let next_y %i32 add y 1
                    mandelbrot_video_memory_write_rows surface frame next_y model
                Result::Err error:
                    Result::Err error

fn mandelbrot_video_memory_present_window %impure fn &GuiWebVideoMemorySurface Result unit GuiError \surface:
    match window_id mandelbrot_video_memory_window_id:
        Result::Err error:
            Result::Err error
        Result::Ok window:
            gui_web_video_memory_present_surface window "NEPLg2 Mandelbrot Video Memory" surface

fn mandelbrot_video_memory_discard_error %impure fn &GuiWebVideoMemorySurface impure fn FrameId impure fn GuiError Result unit GuiError \surface\frame\error:
    match gui_web_video_memory_discard_write_frame surface frame:
        Result::Ok _:
            Result::Err error
        Result::Err _discard_error:
            Result::Err error

fn mandelbrot_video_memory_publish_present %impure fn &GuiWebVideoMemorySurface impure fn FrameId Result unit GuiError \surface\frame:
    match gui_web_video_memory_publish_full surface frame:
        Result::Err error:
            mandelbrot_video_memory_discard_error surface frame error
        Result::Ok _:
            mandelbrot_video_memory_present_window surface

fn mandelbrot_video_memory_render_present_surface %impure fn &GuiWebVideoMemorySurface impure fn MandelbrotModel Result unit GuiError \surface\model:
    match gui_web_video_memory_acquire_write_frame surface:
        Result::Err error:
            Result::Err error
        Result::Ok frame:
            match mandelbrot_video_memory_write_rows surface frame 0 model:
                Result::Ok _:
                    mandelbrot_video_memory_publish_present surface frame
                Result::Err error:
                    mandelbrot_video_memory_discard_error surface frame error

fn mandelbrot_video_memory_close_with_result %impure fn &GuiWebVideoMemorySurface impure fn Result unit GuiError Result unit GuiError \surface\result:
    match gui_web_video_memory_close_surface surface:
        Result::Ok _:
            result
        Result::Err close_error:
            match result:
                Result::Ok _:
                    Result::Err close_error
                Result::Err original:
                    Result::Err original

fn mandelbrot_video_memory_discard_close_error %impure fn &GuiWebVideoMemorySurface impure fn FrameId impure fn GuiError Result unit GuiError \surface\frame\error:
    let failed %Result unit GuiError mandelbrot_video_memory_discard_error surface frame error
    mandelbrot_video_memory_close_with_result surface failed

fn mandelbrot_video_memory_publish_present_close %impure fn &GuiWebVideoMemorySurface impure fn FrameId Result unit GuiError \surface\frame:
    let present_result %Result unit GuiError mandelbrot_video_memory_publish_present surface frame
    mandelbrot_video_memory_close_with_result surface present_result

fn mandelbrot_video_memory_present_surface %impure fn &GuiWebVideoMemorySurface impure fn MandelbrotModel Result unit GuiError \surface\model:
    let render_result %Result unit GuiError mandelbrot_video_memory_render_present_surface surface model
    mandelbrot_video_memory_close_with_result surface render_result

fn mandelbrot_video_memory_open_rendered_surface %impure fn MandelbrotModel Result GuiWebVideoMemorySurface GuiError \model:
    let width %i32 mandelbrot_model_sample_width &model
    let height %i32 mandelbrot_model_sample_height &model
    match gui_web_video_memory_create_surface width height mandelbrot_video_memory_slot_count:
        Result::Ok surface:
            match mandelbrot_video_memory_render_present_surface &surface model:
                Result::Ok _:
                    Result::Ok surface
                Result::Err error:
                    let failed %Result unit GuiError Result::Err error
                    match mandelbrot_video_memory_close_with_result &surface failed:
                        Result::Ok _:
                            Result::Err error
                        Result::Err final_error:
                            Result::Err final_error
        Result::Err error:
            Result::Err error

fn mandelbrot_video_memory_present_model %impure fn MandelbrotModel Result unit GuiError \model:
    match mandelbrot_video_memory_open_rendered_surface model:
        Result::Ok surface:
            let ok %Result unit GuiError Result::Ok unit
            mandelbrot_video_memory_close_with_result &surface ok
        Result::Err error:
            Result::Err error

fn mandelbrot_video_memory_close_open_surface %impure fn GuiWebVideoMemorySurface Result unit GuiError \surface:
    let ok %Result unit GuiError Result::Ok unit
    mandelbrot_video_memory_close_with_result &surface ok

fn mandelbrot_video_memory_close_and_open_next %impure fn &GuiWebVideoMemorySurface impure fn MandelbrotModel Result GuiWebVideoMemorySurface GuiError \surface\next_model:
    match gui_web_video_memory_close_surface surface:
        Result::Ok _:
            mandelbrot_video_memory_open_rendered_surface next_model
        Result::Err error:
            Result::Err error

fn mandelbrot_video_memory_resize_once_event %impure fn GuiWebVideoMemorySurface impure fn MandelbrotModel impure fn GuiWebEvent Result unit GuiError \surface\model\web_event:
    match gui_web_event_window &web_event:
        Option::Some window:
            match window_event_kind &window:
                WindowEventKind::Resized:
                    let next_model %MandelbrotModel mandelbrot_update_window model window
                    match mandelbrot_video_memory_close_and_open_next &surface next_model:
                        Result::Ok next_surface:
                            mandelbrot_video_memory_close_open_surface next_surface
                        Result::Err error:
                            Result::Err error
                WindowEventKind::Focused:
                    mandelbrot_video_memory_close_open_surface surface
                WindowEventKind::Unfocused:
                    mandelbrot_video_memory_close_open_surface surface
                WindowEventKind::CloseRequested:
                    mandelbrot_video_memory_close_open_surface surface
        Option::None:
            mandelbrot_video_memory_close_open_surface surface

fn mandelbrot_video_memory_resize_once %impure fn MandelbrotModel Result unit GuiError \initial_model:
    match mandelbrot_video_memory_open_rendered_surface initial_model:
        Result::Err error:
            Result::Err error
        Result::Ok surface:
            match gui_web_wait_event_result 60000:
                Result::Err error:
                    let failed %Result unit GuiError Result::Err error
                    mandelbrot_video_memory_close_with_result &surface failed
                Result::Ok event_result:
                    match event_result:
                        Option::Some web_event:
                            mandelbrot_video_memory_resize_once_event surface initial_model web_event
                        Option::None:
                            mandelbrot_video_memory_close_open_surface surface

fn mandelbrot_video_memory_loop_wait_ms %fn void i32 \void:
    60000

fn mandelbrot_video_memory_loop_test_wait_count %fn void i32 \void:
    5

fn mandelbrot_video_memory_loop_interactive_wait_count %fn void i32 \void:
    1073741824

fn mandelbrot_video_memory_loop_finish_ok %impure fn &GuiWebVideoMemorySurface Result unit GuiError \surface:
    let ok %Result unit GuiError Result::Ok unit
    mandelbrot_video_memory_close_with_result surface ok

fn mandelbrot_video_memory_event_loop_with_limit %impure fn MandelbrotModel impure fn i32 Result unit GuiError \initial_model\max_wait_count:
    match mandelbrot_video_memory_open_rendered_surface initial_model:
        Result::Err error:
            Result::Err error
        Result::Ok initial_surface:
            let mut model %MandelbrotModel initial_model
            let mut surface %GuiWebVideoMemorySurface initial_surface
            let mut remaining %i32 max_wait_count
            let mut running %bool true
            let mut loop_result %Result unit GuiError Result::Ok unit
            while running:
                do:
                    if:
                        le remaining 0
                        then:
                            let close_result %Result unit GuiError mandelbrot_video_memory_loop_finish_ok &surface
                            set loop_result close_result;
                            set running false
                        else:
                            set remaining sub remaining 1;
                            match gui_web_wait_event_result mandelbrot_video_memory_loop_wait_ms:
                                Result::Err error:
                                    let failed %Result unit GuiError Result::Err error
                                    let close_result %Result unit GuiError mandelbrot_video_memory_close_with_result &surface failed
                                    set loop_result close_result;
                                    set running false
                                Result::Ok event_result:
                                    match event_result:
                                        Option::Some web_event:
                                            match gui_web_event_window &web_event:
                                                Option::Some window:
                                                    match window_event_kind &window:
                                                        WindowEventKind::Resized:
                                                            let next_model %MandelbrotModel mandelbrot_update_window model window
                                                            match mandelbrot_video_memory_close_and_open_next &surface next_model:
                                                                Result::Ok next_surface:
                                                                    set surface next_surface;
                                                                    set model next_model
                                                                Result::Err error:
                                                                    set loop_result Result::Err error;
                                                                    set running false
                                                        WindowEventKind::Focused:
                                                            unit
                                                        WindowEventKind::Unfocused:
                                                            unit
                                                        WindowEventKind::CloseRequested:
                                                            let close_result %Result unit GuiError mandelbrot_video_memory_loop_finish_ok &surface
                                                            set loop_result close_result;
                                                            set running false
                                                Option::None:
                                                    unit
                                        Option::None:
                                            unit
            loop_result

fn mandelbrot_video_memory_event_loop %impure fn MandelbrotModel Result unit GuiError \initial_model:
    mandelbrot_video_memory_event_loop_with_limit initial_model mandelbrot_video_memory_loop_interactive_wait_count

fn mandelbrot_video_memory_loop_test %impure fn MandelbrotModel Result unit GuiError \initial_model:
    mandelbrot_video_memory_event_loop_with_limit initial_model mandelbrot_video_memory_loop_test_wait_count

fn mandelbrot_present_row_pixel %impure fn i32 impure fn i32 impure fn MandelbrotModel Result unit GuiError \x\y\model:
    let iter %i32 mandelbrot_cell_iter x y model
    let limit %i32 mandelbrot_model_iteration_limit &model
    let color %Rgba8888 mandelbrot_color iter limit
    gui_web_stdout_rgba_row_pixel color

fn mandelbrot_present_row_pixels %impure fn i32 impure fn i32 impure fn MandelbrotModel Result unit GuiError \x\y\model:
    let sample_width %i32 mandelbrot_model_sample_width &model
    if:
        ge x sample_width
        then:
            gui_web_stdout_rgba_row_end
        else:
            match mandelbrot_present_row_pixel x y model:
                Result::Ok _:
                    let next_x %i32 add x 1
                    mandelbrot_present_row_pixels next_x y model
                Result::Err err:
                    Result::Err err

fn mandelbrot_present_row %impure fn i32 impure fn MandelbrotModel Result unit GuiError \y\model:
    let sample_width %i32 mandelbrot_model_sample_width &model
    let cell_size %i32 mandelbrot_model_cell_size &model
    let py %i32 mul y cell_size
    let origin %GuiPoint gui_point_new 0 py
    match gui_web_stdout_rgba_row_begin origin sample_width cell_size cell_size:
        Result::Ok _:
            mandelbrot_present_row_pixels 0 y model
        Result::Err err:
            Result::Err err

fn mandelbrot_present_rows %impure fn i32 impure fn MandelbrotModel Result unit GuiError \y\model:
    let sample_height %i32 mandelbrot_model_sample_height &model
    if:
        ge y sample_height
        then:
            Result::Ok unit
        else:
            match mandelbrot_present_row y model:
                Result::Ok _:
                    let next_y %i32 add y 1
                    mandelbrot_present_rows next_y model
                Result::Err err:
                    Result::Err err

fn mandelbrot_button_preview_rect %fn i32 GuiRect \grid_height:
    let y %i32 add grid_height 14
    gui_rect_new 14 y 104 32

fn mandelbrot_button_hd_rect %fn i32 GuiRect \grid_height:
