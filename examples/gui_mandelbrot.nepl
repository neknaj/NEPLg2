    match mandelbrot_video_memory_event_loop model:
        Result::Ok _:
            unit
        Result::Err _:
            println "mandelbrot video memory loop protocol error"

fn mandelbrot_run_video_memory_loop_test %impure fn MandelbrotModel unit \model:
    match mandelbrot_video_memory_loop_test model:
        Result::Ok _:
            unit
        Result::Err _:
            println "mandelbrot video memory loop test protocol error"

fn mandelbrot_event_loop %impure fn MandelbrotModel unit \initial_model:
    let mut model %MandelbrotModel initial_model
    let mut running %bool true
    while running:
        do:
            match gui_web_wait_event_result 60000:
                Result::Ok event_result:
                    match event_result:
                        Option::Some web_event:
                            let next_model %MandelbrotModel mandelbrot_update_event model web_event
                            match mandelbrot_present_frame next_model:
                                Result::Ok _:
                                    set model next_model
                                Result::Err _:
                                    println "mandelbrot gui protocol error";
                                    set running false
                        Option::None:
                            unit
                Result::Err _:
                    println "mandelbrot gui input unsupported";
                    set running false

fn main %impure fn void unit \void:
    let model0 %MandelbrotModel mandelbrot_model_preview
    let video_memory_model %MandelbrotModel mandelbrot_video_memory_model
    if:
        mandelbrot_has_hd_contract_flag
        then:
            mandelbrot_run_hd_contract_test
        else:
            if:
                mandelbrot_has_responsive_contract_flag
                then:
                    mandelbrot_run_responsive_contract_test
                else:
                    if:
                        mandelbrot_has_video_memory_contract_flag
                        then:
                            mandelbrot_run_video_memory_contract_test
                        else:
                            if:
                                mandelbrot_has_video_memory_loop_test_flag
                                then:
                                    mandelbrot_run_video_memory_loop_test video_memory_model
                                else:
                                    if:
                                        mandelbrot_has_video_memory_loop_flag
                                        then:
                                            mandelbrot_run_video_memory_loop video_memory_model
                                        else:
                                            if:
                                                mandelbrot_has_video_memory_resize_once_flag
                                                then:
                                                    mandelbrot_run_video_memory_resize_once video_memory_model
                                                else:
                                                    if:
                                                        mandelbrot_has_video_memory_once_flag
                                                        then:
                                                            mandelbrot_run_video_memory_once video_memory_model
                                                        else:
                                                            if:
                                                                mandelbrot_has_once_flag
                                                                then:
                                                                    mandelbrot_run_once model0
                                                                else:
                                                                    match mandelbrot_present_frame model0:
                                                                        Result::Ok _:
                                                                            mandelbrot_event_loop model0
                                                                        Result::Err _:
                                                                            println "mandelbrot gui protocol error"
