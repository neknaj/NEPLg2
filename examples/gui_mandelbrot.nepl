fn mandelbrot_has_video_memory_loop_flag %impure fn void bool \void:
    mandelbrot_has_flag "--video-memory-loop"

fn mandelbrot_has_video_memory_loop_test_flag %impure fn void bool \void:
    mandelbrot_has_flag "--video-memory-loop-test"

fn mandelbrot_has_hd_contract_flag %impure fn void bool \void:
    mandelbrot_has_flag "--test-hd-contract"

fn mandelbrot_has_video_memory_contract_flag %impure fn void bool \void:
    mandelbrot_has_flag "--test-video-memory-contract"

fn mandelbrot_has_responsive_contract_flag %impure fn void bool \void:
    mandelbrot_has_flag "--test-responsive-contract"

fn mandelbrot_hd_contract_ok %fn void bool \void:
    let model %MandelbrotModel mandelbrot_model_hd
    let width_ok %bool eq mandelbrot_frame_width &model 1280
    let height_ok %bool eq mandelbrot_frame_height &model 720
    let sample_width_ok %bool eq mandelbrot_model_sample_width &model 1280
    let sample_height_ok %bool eq mandelbrot_model_sample_height &model 648
    let cell_size_ok %bool eq mandelbrot_model_cell_size &model 1
    let row_command_count_ok %bool eq mandelbrot_command_count &model 658
    let size_ok %bool and width_ok height_ok
    let sample_ok %bool and sample_width_ok sample_height_ok
    let pixel_ok %bool and cell_size_ok row_command_count_ok
    let size_and_sample_ok %bool and size_ok sample_ok
    and size_and_sample_ok pixel_ok

fn mandelbrot_video_memory_contract_ok %fn void bool \void:
    let model %MandelbrotModel mandelbrot_video_memory_model
    let width_ok %bool eq mandelbrot_model_sample_width &model 32
    let height_ok %bool eq mandelbrot_model_sample_height &model 18
    let cell_size_ok %bool eq mandelbrot_model_cell_size &model 1
    let limit_ok %bool eq mandelbrot_model_iteration_limit &model 24
    let slot_ok %bool eq mandelbrot_video_memory_slot_count 2
    let size_ok %bool and width_ok height_ok
    let render_ok %bool and cell_size_ok limit_ok
    let shape_ok %bool and size_ok render_ok
    and shape_ok slot_ok

fn mandelbrot_responsive_model_contract_ok %fn void bool \void:
    let model %MandelbrotModel mandelbrot_model_for_surface 1920 1080
    let width_ok %bool eq mandelbrot_frame_width &model 1920
    let height_ok %bool eq mandelbrot_frame_height &model 1080
    let sample_width_ok %bool eq mandelbrot_model_sample_width &model 1920
    let sample_height_ok %bool eq mandelbrot_model_sample_height &model 1008
    let cell_size_ok %bool eq mandelbrot_model_cell_size &model 1
    let limit_ok %bool eq mandelbrot_model_iteration_limit &model 64
    let command_count_ok %bool eq mandelbrot_command_count &model 1018
    let mode %MandelbrotMode mandelbrot_model_mode &model
    let mode_ok %bool eq mandelbrot_mode_debug_code mode 4
    let size_ok %bool and width_ok height_ok
    let sample_ok %bool and sample_width_ok sample_height_ok
    let render_ok %bool and cell_size_ok limit_ok
    let command_and_mode_ok %bool and command_count_ok mode_ok
    let primary_ok %bool and size_ok sample_ok
    let secondary_ok %bool and render_ok command_and_mode_ok
    and primary_ok secondary_ok

fn mandelbrot_responsive_minimum_contract_ok %fn void bool \void:
    let model %MandelbrotModel mandelbrot_model_for_surface 1 1
    let sample_width_ok %bool eq mandelbrot_model_sample_width &model 2
    let sample_height_ok %bool eq mandelbrot_model_sample_height &model 2
    let frame_width_ok %bool eq mandelbrot_frame_width &model 2
    let frame_height_ok %bool eq mandelbrot_frame_height &model 74
    let sample_ok %bool and sample_width_ok sample_height_ok
    let frame_ok %bool and frame_width_ok frame_height_ok
    and sample_ok frame_ok

fn mandelbrot_responsive_event_contract_ok %fn void bool \void:
    match window_id_result 1:
        Result::Ok host_window:
            let point %GuiPoint gui_point_new 0 0
            let size %GuiSize gui_size_new 1920 1080
            let window %WindowEvent window_event_new WindowEventKind::Resized size
            let web_event %GuiWebEvent GuiWebEvent host_window point gui_event_window window
            let start %MandelbrotModel mandelbrot_model_preview
            let updated %MandelbrotModel mandelbrot_update_event start web_event
            let width_ok %bool eq mandelbrot_model_sample_width &updated 1920
            let height_ok %bool eq mandelbrot_model_sample_height &updated 1008
            let frame_ok %bool eq mandelbrot_frame_height &updated 1080
            let mode %MandelbrotMode mandelbrot_model_mode &updated
            let mode_ok %bool eq mandelbrot_mode_debug_code mode 4
            let sample_ok %bool and width_ok height_ok
            let output_ok %bool and frame_ok mode_ok
            and sample_ok output_ok
        Result::Err _:
            false

fn mandelbrot_responsive_contract_ok %fn void bool \void:
    let model_ok %bool mandelbrot_responsive_model_contract_ok
    let minimum_ok %bool mandelbrot_responsive_minimum_contract_ok
    let event_ok %bool mandelbrot_responsive_event_contract_ok
    let shape_ok %bool and model_ok minimum_ok
    and shape_ok event_ok

