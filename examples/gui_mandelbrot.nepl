    let config %GuiWebButtonConfig gui_web_button_config rect action label color mandelbrot_color_text 12 9
    gui_web_stdout_button config

fn mandelbrot_present_status %impure fn MandelbrotModel Result unit GuiError \model:
    let grid_height %i32 mandelbrot_grid_height &model
    let y %i32 add grid_height 54
    let origin_mode %GuiPoint gui_point_new 68 y
    let mode %MandelbrotMode mandelbrot_model_mode &model
    let mode_code %i32 mandelbrot_mode_debug_code mode
    match gui_web_stdout_text_i32 origin_mode 12 GuiWebTextAlign::Center mandelbrot_color_text mode_code:
        Result::Ok _:
            let origin_width %GuiPoint gui_point_new 156 y
            match gui_web_stdout_text_i32 origin_width 12 GuiWebTextAlign::Center mandelbrot_color_text mandelbrot_model_sample_width &model:
                Result::Ok _:
                    let origin_height %GuiPoint gui_point_new 230 y
                    gui_web_stdout_text_i32 origin_height 12 GuiWebTextAlign::Center mandelbrot_color_text mandelbrot_model_sample_height &model
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn mandelbrot_present_controls %impure fn MandelbrotModel Result unit GuiError \model:
    let grid_height %i32 mandelbrot_grid_height &model
    let preview_rect %GuiRect mandelbrot_button_preview_rect grid_height
    let hd_rect %GuiRect mandelbrot_button_hd_rect grid_height
    let detail_rect %GuiRect mandelbrot_button_detail_rect grid_height
    match mandelbrot_present_button preview_rect mandelbrot_preview_action "Preview" mandelbrot_color_button:
        Result::Ok _:
            match mandelbrot_present_button hd_rect mandelbrot_hd_action "HD" mandelbrot_color_button_alt:
                Result::Ok _:
                    match mandelbrot_present_button detail_rect mandelbrot_detail_action "Detail" mandelbrot_color_button:
                        Result::Ok _:
                            mandelbrot_present_status model
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn mandelbrot_present_frame %impure fn MandelbrotModel Result unit GuiError \model:
    let width %i32 mandelbrot_frame_width &model
    let height %i32 mandelbrot_frame_height &model
    match gui_web_stdout_frame_begin 1 width height "NEPLg2 Mandelbrot":
        Result::Ok _:
            let background %GuiRect gui_rect_new 0 0 width height
            match gui_web_stdout_fill_rect background mandelbrot_color_background:
                Result::Ok _:
                    match mandelbrot_present_rows 0 model:
                        Result::Ok _:
                            match mandelbrot_present_controls model:
                                Result::Ok _:
                                    gui_web_stdout_frame_end
                                Result::Err err:
                                    Result::Err err
                        Result::Err err:
                            Result::Err err
                Result::Err err:
                    Result::Err err
        Result::Err err:
            Result::Err err

fn mandelbrot_inside_cell %fn i32 fn i32 fn MandelbrotModel i32 \x\y\model:
    let iter %i32 mandelbrot_cell_iter x y model
    let limit %i32 mandelbrot_model_iteration_limit &model
    if:
        eq iter limit
        then:
            1
        else:
            0

fn mandelbrot_inside_row %fn i32 fn i32 fn MandelbrotModel i32 \x\y\model:
    let sample_width %i32 mandelbrot_model_sample_width &model
    if:
        ge x sample_width
        then:
            0
        else:
            let next_x %i32 add x 1
            let rest %i32 mandelbrot_inside_row next_x y model
            let here %i32 mandelbrot_inside_cell x y model
            add here rest

fn mandelbrot_inside_rows %fn i32 fn MandelbrotModel i32 \y\model:
    let sample_height %i32 mandelbrot_model_sample_height &model
    if:
        ge y sample_height
        then:
            0
        else:
            let next_y %i32 add y 1
            let rest %i32 mandelbrot_inside_rows next_y model
            let row %i32 mandelbrot_inside_row 0 y model
            add row rest

fn mandelbrot_command_count %fn &MandelbrotModel i32 \model:
    let sample_height %i32 mandelbrot_model_sample_height model
    add sample_height 10

fn mandelbrot_update_action %fn MandelbrotModel fn ActionId MandelbrotModel \model\action:
    let typed %MandelbrotAction mandelbrot_decode_action action
    match typed:
        MandelbrotAction::Preview:
            mandelbrot_model_preview
        MandelbrotAction::HD:
            mandelbrot_model_hd
        MandelbrotAction::Detail:
            mandelbrot_model_detail
        MandelbrotAction::Unknown:
            model

fn mandelbrot_update_window %fn MandelbrotModel fn WindowEvent MandelbrotModel \model\window:
    match window_event_kind &window:
        WindowEventKind::Resized:
            let size %GuiSize window_event_size &window
            let width %i32 gui_size_width &size
            let height %i32 gui_size_height &size
            mandelbrot_model_for_surface width height
        WindowEventKind::Focused:
            model
        WindowEventKind::Unfocused:
            model
        WindowEventKind::CloseRequested:
            model

fn mandelbrot_update_event %fn MandelbrotModel fn GuiWebEvent MandelbrotModel \model\web_event:
    match gui_web_event_action &web_event:
        Option::Some action:
            mandelbrot_update_action model action
        Option::None:
            match gui_web_event_window &web_event:
                Option::Some window:
                    mandelbrot_update_window model window
                Option::None:
                    model

fn mandelbrot_has_flag_loop %impure fn str impure fn i32 impure fn i32 bool \flag\idx\count:
    if:
        ge idx count
        then:
            false
        else:
            match cliarg_get idx:
                Option::Some arg:
                    if:
                        str_eq arg flag
                        then:
                            true
                        else:
                            let next_idx %i32 add idx 1
                            mandelbrot_has_flag_loop flag next_idx count
                Option::None:
                    let next_idx %i32 add idx 1
                    mandelbrot_has_flag_loop flag next_idx count

fn mandelbrot_has_flag %impure fn str bool \flag:
    let count %i32 cliarg_count
    mandelbrot_has_flag_loop flag 1 count

fn mandelbrot_has_once_flag %impure fn void bool \void:
    mandelbrot_has_flag "--once"

fn mandelbrot_has_video_memory_once_flag %impure fn void bool \void:
    mandelbrot_has_flag "--video-memory-once"

