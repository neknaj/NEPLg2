//: neplg2:test[rpn_repl_simple, normalize_newlines, strip_ansi]
//: [目的/もくてき]: REPL全体の統合テスト (1 2 +)
//: stdin: "1 2 +\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > 3
//:     ##: ok: result = 3
//:     ##: > bye
//:
//: neplg2:test[rpn_repl_negative, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 負の計算の統合テスト (2 7 -)
//: stdin: "2 7 -\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > -5
//:     ##: ok: result = -5
//:     ##: > bye

//: rpn: 逆ポーランド記法（RPN）電卓 TUI/REPL
//:
//: [目的/もくてき]:
//: - スペース区切りの逆ポーランド記法を対話的に評価する REPL を提供します。
//: - `Stack i32` / `str_slice_result` / `to_i32` などの stdlib を活用した実装例です。
//: - 各トークンごとの計算ステップがきれいに表示される TUI スタイルの UI レスポンスを行います。
//:
//: [実装/じっそう]:
//: - 入力を space 区切りで走査し、各 token を順に処理します。
//: - `Stack` は owner を返す `push` / `pop_top` で更新し、表示だけ `len` / `get` で借用します。
//: - 演算結果やエラーメッセージには ANSI カラーを使い、視認性を高く保ちます。
//:
//: [注意/ちゅうい]:
//: - 対応演算子は `+` `-` `*` の 3 種です。スタック不足時の保護付きです。
//: - 負の整数リテラルにも対応しています（`to_i32` が符号付き解析を行います）。
//:
//: [計算量/けいさんりょう]:
//: - 1 トークンあたり O(1)、全体で O(n)（n = トークン数）

#entry main
#indent 4
#target std

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "std/stdio/print" as *
#import "std/stdio/ansi" as *
#import "std/stdio/read/text" as *
#import "alloc/string/access" as string_access
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "alloc/string/integer/parse" as string_parse
#import "alloc/string/integer/format" as string_format
#import "alloc/string/concat" as string_concat
#import "alloc/collections/stack" as stk
#import "alloc/diag/error/types" as *

//: print_error: エラーメッセージを赤色太字で出力する
//:
//: [目的/もくてき]:
//: - `error: <msg>` 形式で標準出力に赤色で表示します。
fn print_error %impure fn str unit \msg:
    let label_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Red;
    print_style label_style "error:";
    print " ";
    println_color AnsiColor::Red msg;

//: print_prompt: REPL のプロンプトを表示する
//:
//: [目的/もくてき]:
//: - 入力行の先頭に `> ` を太字緑色で出力します。
fn print_prompt %impure fn unit unit \unit:
    let prompt_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Green;
    print_style prompt_style "> ";

//: print_result: 計算結果を色付きで出力する
//:
//: [目的/もくてき]:
//: - `ok: result = <val>` 形式で結果を表示します。
fn print_result %impure fn i32 unit \val:
    let ok_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Green;
    let value_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Cyan;
    print_style ok_style "ok";
    print_color AnsiColor::Gray ": result = ";
    print_style_start value_style;
    print_i32 val;
    print_style_reset;
    print "\n";

//: push_or_report: stack への追加失敗を REPL のエラー表示に変換する
//:
//: [目的/もくてき]:
//: - `push` の `Result` を明示的に扱い、allocation failure を panic にしません。
//: - `push` は Stack owner を消費して更新後 owner を返すため、成功時だけ次の owner を返します。
//: - 失敗時は `StackPushError` から owner を回収して閉じ、REPL 状態には失敗だけを残します。
fn push_or_report %impure fn Stack i32 impure fn i32 Result Stack i32 str \stack\val:
    match stk::push stack val:
        Result::Ok next_stack:
            ok next_stack
        Result::Err e:
            let returned %Stack i32 stk::stack_push_error_stack e
            stk::free returned;
            print_error "out of memory";
            err "out of memory"

//: print_stack_prefix: スタック内容を次の値の手前に表示する
//:
//: [目的/もくてき]:
//: - 演算結果の前に、現在のスタック要素を先頭から順に表示します。
//: - `Stack` の内部表現は読まず、`len` と `get` だけを使います。
fn print_stack_prefix %impure fn &Stack i32 unit \stack:
    let stk_len %i32 stk::len stack;
    let mut j %i32 0;
    while lt j stk_len:
        do:
            match stk::get stack j:
                Option::Some elem:
                    print_i32 elem;
                    print " ";
                Option::None:
                    unit;
            set j add j 1;

//: print_stack_line: スタック内容を 1 行として表示する
//:
//: [目的/もくてき]:
//: - 最終的に値が複数残ったとき、エラー前に現在のスタック全体を表示します。
fn print_stack_line %impure fn &Stack i32 unit \stack:
    let stk_len %i32 stk::len stack;
    let mut j %i32 0;
    while lt j stk_len:
        do:
            if:
                gt j 0
                then:
                    print " ";
                else:
                    unit;
            match stk::get stack j:
                Option::Some elem:
                    print_i32 elem;
                Option::None:
                    unit;
            set j add j 1;

    print "\n";

//: print_step_after: 途中計算の適用後状態を表示する
//:
//: [目的/もくてき]:
//: - `[stack] [res]` の形式で演算子適用後の状態を出力します。
fn print_step_after %impure fn &Stack i32 impure fn i32 unit \stack\res:
    print_stack_prefix stack;
    let step_style %AnsiTextStyle ansi_color_style AnsiColor::Green;
    print_style_start step_style;
    print_i32 res;
    print_style_reset;

    print "\n";

//: apply_op: スタックから 2 値を取り出して二項演算を適用する
//:
//: [目的/もくてき]:
//: - `+` `-` `*` のいずれかの演算を適用し、結果をスタックに積みます。
//: - `pop_top` で更新後 owner と取り出した値を同時に受け取り、owner flow を途切れさせません。
fn apply_op %impure fn Stack i32 impure fn str Result Stack i32 str \stack\token:
    if:
        lt stk::len &stack 2
        then:
            print_error "stack underflow";
            ok stack
        else:
            let popped_b %StackPop i32 stk::pop_top stack
            let b_opt %Option i32 stk::stack_pop_item &popped_b
            let stack_b %Stack i32 stk::stack_pop_stack popped_b
            match b_opt:
                Option::Some b:
                    let popped_a %StackPop i32 stk::pop_top stack_b
                    let a_opt %Option i32 stk::stack_pop_item &popped_a
                    let stack_a %Stack i32 stk::stack_pop_stack popped_a
                    match a_opt:
                        Option::Some a:
                            let res %i32:
                                if:
                                    string_search::str_eq token "+"
                                    then add a b
                                    else:
                                        if:
                                            string_search::str_eq token "-"
                                            then sub a b
                                            else:
                                                if:
                                                    string_search::str_eq token "*"
                                                    then mul a b
                                                    else:
                                                        print_error "unknown operator";
                                                        0
                            print_step_after &stack_a res;
                            push_or_report stack_a res
                        Option::None:
                            print_error "stack underflow";
                            ok stack_a
                Option::None:
                    print_error "stack underflow";
                    ok stack_b

//: process_token: 1 つのトークンを分類して処理する
//:
//: [目的/もくてき]:
//: - 演算子か数値かを判定しスタックに反映させ、トレースを表示します。
fn process_token %impure fn Stack i32 impure fn str Result Stack i32 str \stack\token:
    if:
        string_search::str_eq token ""
        then:
            ok stack
        else:
            let is_op %bool or or string_search::str_eq token "+" string_search::str_eq token "-" string_search::str_eq token "*";
            if:
                is_op
                then:
                    apply_op stack token
                else:
                    match string_parse::to_i32 token:
                        Result::Ok val:
                            push_or_report stack val
                        Result::Err _:
                            print_error "unknown token";
                            ok stack

fn process_token_state %impure fn Result Stack i32 str impure fn str Result Stack i32 str \state\token:
    match state:
        Result::Ok stack:
            process_token stack token
        Result::Err msg:
            err msg

fn token_error_state %impure fn Result Stack i32 str impure fn str Result Stack i32 str \state\msg:
    match state:
        Result::Ok stack:
            stk::free stack;
            err msg
        Result::Err old_msg:
            err old_msg

//: eval_line: 1 行の RPN 式を評価する
//:
//: [目的/もくてき]:
//: - スペース区切りの入力行をトークン化し、すべて適用して結果を出力します。
//:
//: [実装/じっそう]:
//: - `Stack` を new し、space 区切り token を `str_slice_result` で取り出して `process_token` を呼びます。
//: - 最終的なスタック長が 1 であれば結果を表示し、超過時はエラーを出力します。
//: - `Stack` は関数終了時に正しく `free` します。
fn eval_line %impure fn str unit \line:
    let trimmed %str string_slice::str_trim line;
    let n %i32 string_access::len trimmed;

    let stack_init %Result Stack i32 Diag stk::new;
    match stack_init:
        Result::Ok stack0:
            let mut stack_state %Result Stack i32 str ok stack0;
            let mut start %i32 0;
            let mut i %i32 0;
            while le i n:
                do:
                    let is_end %bool eq i n
                    let is_sep %bool if:
                        is_end
                        then:
                            true
                        else:
                            match string_access::byte_at trimmed i:
                                Option::Some b:
                                    eq b 32
                                Option::None:
                                    true
                    if:
                        is_sep
                        then:
                            match string_slice::str_slice_result trimmed start i:
                                Result::Ok tok:
                                    set stack_state process_token_state stack_state tok
                                Result::Err msg:
                                    set stack_state token_error_state stack_state msg
                            set start add i 1
                        else:
                            unit
                    set i add i 1;

            match stack_state:
                Result::Ok stack:
                    let sp %i32 stk::len &stack;
                    if:
                        eq sp 1
                        then:
                            let popped %StackPop i32 stk::pop_top stack
                            let val_opt %Option i32 stk::stack_pop_item &popped
                            let next_stack %Stack i32 stk::stack_pop_stack popped
                            match val_opt:
                                Option::Some val:
                                    print_result val
                                Option::None:
                                    unit
                            stk::free next_stack
                        else:
                            if:
                                eq sp 0
                                then:
                                    stk::free stack
                                else:
                                    print_stack_line &stack;
                                    print_error string_concat::concat3 "stack has " string_format::from_i32 sp " values";
                                    stk::free stack
                Result::Err msg:
                    string_access::len msg;
                    unit
        Result::Err _:
            print_error "out of memory";

//: main: RPN TUI REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - 初期バナーを表示後、対話式の無限ループを開始します。
fn main %impure fn unit unit \unit:
    let title_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Cyan;
    println_style title_style "RPN REPL";
    println_color AnsiColor::Gray "enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.";
    println "";

    let mut running %bool true;

    while running:
        do:
            print_prompt;
            let input %str read_line;
            let input_len %i32 string_access::len input;

            if:
                eq input_len 0
                then:
                    let bye_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Yellow;
                    println_style bye_style "bye";
                    set running false;
                else:
                    eval_line input;
