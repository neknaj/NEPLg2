//: neplg2:test[rpn_repl_simple, normalize_newlines, strip_ansi]
//: [目的/もくてき]: REPL全体の統合テスト (1 2 +)
//: stdin: "1 2 +\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > 3
//:     ##: ok: result = 3
//:     ##: > bye
//:
//: neplg2:test[rpn_repl_negative, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 負の計算の統合テスト (2 7 -)
//: stdin: "2 7 -\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > -5
//:     ##: ok: result = -5
//:     ##: > bye

//: neplg2:test[rpn_repl_stack_count_error, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 値が複数残ったときの error path が stack 要素数を直接表示することを確認する
//: stdin: "1 2\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > 1 2
//:     ##: error: stack has 2 values
//:     ##: > bye

//: neplg2:test[rpn_repl_ascii_whitespace, normalize_newlines, strip_ansi]
//: [目的/もくてき]: token scanner が tab / CR / 余分な空白を separator として扱うことを確認する
//: stdin: "\t 1\t2\r + \n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##:
//:     ##: > 3
//:     ##: ok: result = 3
//:     ##: > bye

//: rpn: 逆ポーランド記法（RPN）電卓 TUI/REPL
//:
//: [目的/もくてき]:
//: - ASCII 空白区切りの逆ポーランド記法を対話的に評価する REPL を提供します。
//: - `Stack i32` / range-based string scanner / `to_i32_range` などの stdlib を活用した実装例です。
//: - 各トークンごとの計算ステップがきれいに表示される TUI スタイルの UI レスポンスを行います。
//:
//: [実装/じっそう]:
//: - 入力を ASCII 空白区切りで走査し、各 token を元文字列の byte 範囲として順に処理します。
//: - `Stack` は owner を返す `push` / `pop_top` で更新し、表示だけ `len` / `get` で借用します。
//: - 演算結果やエラーメッセージには ANSI カラーを使い、視認性を高く保ちます。
//:
//: [注意/ちゅうい]:
//: - 対応演算子は `+` `-` `*` の 3 種です。スタック不足時の保護付きです。
//: - 負の整数リテラルにも対応しています（`to_i32_range` が符号付き解析を行います）。
//:
//: [計算量/けいさんりょう]:
//: - 1 トークンあたり O(1)、全体で O(n)（n = トークン数）

#entry main
#indent 4
#target std
#no_prelude

#import "core/math/i32" as *
#import "core/option" as *
#import "core/result" as *
#import "std/stdio/print" as *
#import "std/stdio/ansi/types" as *
#import "std/stdio/ansi/code" as *
#import "std/stdio/ansi/print" as *
#import "std/stdio/read/text" as *
#import "alloc/string/access" as string_access
#import "alloc/string/search/compare" as string_search
#import "alloc/string/integer/parse" as string_parse
#import "alloc/collections/stack/types" as *
#import "alloc/collections/stack/types" as stk
#import "alloc/collections/stack/api" as stk
#import "alloc/diag/error/types" as *

//: print_error: エラーメッセージを赤色太字で出力する
//:
//: [目的/もくてき]:
//: - `error: <msg>` 形式で標準出力に赤色で表示します。
fn print_error %impure fn str unit \msg:
    let label_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Red;
    print_style label_style "error:";
    print " ";
    println_color AnsiColor::Red msg;

//: print_stack_count_error: 残った stack 要素数を allocation なしでエラー表示する
//:
//: [目的/もくてき]:
//: - `stack has <n> values` を、整数文字列の確保や文字列連結なしで表示します。
//: - 正常な RPN 入力では通らない error path でも、formatting stdlib の大きい proof graph を
//:   この example へ引き込まないようにします。
fn print_stack_count_error %impure fn i32 unit \count:
    let label_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Red;
    let msg_style %AnsiTextStyle ansi_color_style AnsiColor::Red;
    print_style label_style "error:";
    print " ";
    print_style_start msg_style;
    print "stack has ";
    print_i32 count;
    print " values";
    print_style_reset;
    print "\n";

//: print_prompt: REPL のプロンプトを表示する
//:
//: [目的/もくてき]:
//: - 入力行の先頭に `> ` を太字緑色で出力します。
fn print_prompt %impure fn void unit \void:
    let prompt_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Green;
    print_style prompt_style "> ";

//: print_result: 計算結果を色付きで出力する
//:
//: [目的/もくてき]:
//: - `ok: result = <val>` 形式で結果を表示します。
fn print_result %impure fn i32 unit \val:
    let ok_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Green;
    let value_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Cyan;
    print_style ok_style "ok";
    print_color AnsiColor::Gray ": result = ";
    print_style_start value_style;
    print_i32 val;
    print_style_reset;
    print "\n";

//: push_or_report: stack への追加失敗を REPL のエラー表示に変換する
//:
//: [目的/もくてき]:
//: - `push` の `Result` を明示的に扱い、allocation failure を panic にしません。
//: - `push` は Stack owner を消費して更新後 owner を返すため、成功時だけ次の owner を返します。
//: - 失敗時は `StackPushError` から owner を回収して閉じ、REPL 状態には失敗だけを残します。
fn push_or_report %impure fn Stack i32 impure fn i32 Result Stack i32 str \stack\val:
    match stk::push stack val:
        Result::Ok next_stack:
            ok next_stack
        Result::Err e:
            let returned %Stack i32 stk::stack_push_error_stack e
            stk::free returned;
            print_error "out of memory";
            err "out of memory"

//: print_stack_prefix: スタック内容を次の値の手前に表示する
//:
//: [目的/もくてき]:
//: - 演算結果の前に、現在のスタック要素を先頭から順に表示します。
//: - `Stack` の内部表現は読まず、`len` と `get` だけを使います。
fn print_stack_prefix %impure fn &Stack i32 unit \stack:
    let stk_len %i32 stk::len stack;
    let mut j %i32 0;
    while lt j stk_len:
        do:
            match stk::get stack j:
                Option::Some elem:
                    print_i32 elem;
                    print " ";
                Option::None:
                    unit;
            set j add j 1;

//: print_stack_line: スタック内容を 1 行として表示する
//:
//: [目的/もくてき]:
//: - 最終的に値が複数残ったとき、エラー前に現在のスタック全体を表示します。
fn print_stack_line %impure fn &Stack i32 unit \stack:
    let stk_len %i32 stk::len stack;
    let mut j %i32 0;
    while lt j stk_len:
        do:
            if:
                gt j 0
                then:
                    print " ";
                else:
                    unit;
            match stk::get stack j:
                Option::Some elem:
                    print_i32 elem;
                Option::None:
                    unit;
            set j add j 1;

    print "\n";

//: RpnOp: RPN が対応する二項演算子
//:
//: [目的/もくてき]:
//: - token 文字列の分類結果を enum として保持し、演算適用側が文字列比較を繰り返さないようにします。
//: - `apply_op` は分類済みの operator だけを受け取り、Stack owner flow と演算結果の push に集中します。
enum RpnOp:
    Add
    Sub
    Mul

//: operator_from_span: byte 範囲の token を RPN 演算子へ分類する
//:
//: [目的/もくてき]:
//: - `+` `-` `*` の判定を 1 か所に集め、数値 token の parse と演算適用の前提を明確にします。
//: - token 用の `str` を切り出さず、元の行と byte 範囲だけで operator 判定を行います。
//:
//: [注意/ちゅうい]:
//: - `-5` のような負数 literal は `-` だけと一致しないため、`Option::None` として数値 parse 側へ渡します。
fn operator_from_span %fn str fn i32 fn i32 Option RpnOp \line\start\end:
    if:
        string_search::str_range_eq line start end "+"
        then:
            Option::Some RpnOp::Add
        else:
            if:
                string_search::str_range_eq line start end "-"
                then:
                    Option::Some RpnOp::Sub
                else:
                    if:
                        string_search::str_range_eq line start end "*"
                        then:
                            Option::Some RpnOp::Mul
                        else:
                            Option::None

//: apply_op_values: 分類済み operator を 2 つの値へ適用する
//:
//: [目的/もくてき]:
//: - Stack owner の pop / push と、純粋な i32 演算選択を分けます。
//: - `apply_op` は所有権を扱い、この helper は `RpnOp` に対応する計算だけを担当します。
fn apply_op_values %fn RpnOp fn i32 fn i32 i32 \op\a\b:
    match op:
        RpnOp::Add:
            add a b
        RpnOp::Sub:
            sub a b
        RpnOp::Mul:
            mul a b

//: print_step_after: 途中計算の適用後状態を表示する
//:
//: [目的/もくてき]:
//: - `[stack] [res]` の形式で演算子適用後の状態を出力します。
fn print_step_after %impure fn &Stack i32 impure fn i32 unit \stack\res:
    print_stack_prefix stack;
    let step_style %AnsiTextStyle ansi_color_style AnsiColor::Green;
    print_style_start step_style;
    print_i32 res;
    print_style_reset;

    print "\n";

//: apply_op: スタックから 2 値を取り出して二項演算を適用する
//:
//: [目的/もくてき]:
//: - `+` `-` `*` のいずれかの演算を適用し、結果をスタックに積みます。
//: - `pop_top2` で更新後 owner と 2 つの値を同時に受け取り、二項演算の owner flow を 1 つの境界にまとめます。
//: - token 範囲の分類は `operator_from_span` に閉じ、ここでは分類済み `RpnOp` だけを扱います。
fn apply_op %impure fn Stack i32 impure fn RpnOp Result Stack i32 str \stack\op:
    let popped %StackPop2 i32 stk::pop_top2 stack
    let a_opt %Option i32 stk::stack_pop2_lower &popped
    let b_opt %Option i32 stk::stack_pop2_top &popped
    let stack_after_pop %Stack i32 stk::stack_pop2_stack popped
    match a_opt:
        Option::Some a:
            match b_opt:
                Option::Some b:
                    let res %i32 apply_op_values op a b
                    print_step_after &stack_after_pop res;
                    push_or_report stack_after_pop res
                Option::None:
                    print_error "stack underflow";
                    ok stack_after_pop
        Option::None:
            print_error "stack underflow";
            ok stack_after_pop

//: process_token_span: 1 つの token 範囲を分類して処理する
//:
//: [目的/もくてき]:
//: - 演算子か数値かを判定しスタックに反映させ、トレースを表示します。
//: - token は `line[start..end]` として扱い、slice 用の文字列確保を行いません。
fn process_token_span %impure fn Stack i32 impure fn str impure fn i32 impure fn i32 Result Stack i32 str \stack\line\start\end:
    if:
        eq start end
        then:
            ok stack
        else:
            match operator_from_span line start end:
                Option::Some op:
                    apply_op stack op
                Option::None:
                    match string_parse::to_i32_range line start end:
                        Result::Ok val:
                            push_or_report stack val
                        Result::Err _:
                            print_error "unknown token";
                            ok stack

fn process_token_state_span %impure fn Result Stack i32 str impure fn str impure fn i32 impure fn i32 Result Stack i32 str \state\line\start\end:
    match state:
        Result::Ok stack:
            process_token_span stack line start end
        Result::Err msg:
            err msg

//: eval_line: 1 行の RPN 式を評価する
//:
//: [目的/もくてき]:
//: - ASCII 空白区切りの入力行をトークン化し、すべて適用して結果を出力します。
//:
//: [実装/じっそう]:
//: - `Stack` を new し、ASCII 空白区切り token の byte 範囲を `process_token_span` へ渡します。
//: - separator 判定は `str_byte_is_ascii_space_at` に閉じ、token 用の trim / slice 文字列は作りません。
//: - 最終的なスタック長が 1 であれば結果を表示し、超過時はエラーを出力します。
//: - `Stack` は関数終了時に正しく `free` します。
fn eval_line %impure fn str unit \line:
    let n %i32 string_access::len line;

    let stack_init %Result Stack i32 Diag stk::new;
    match stack_init:
        Result::Ok stack0:
            let mut stack_state %Result Stack i32 str ok stack0;
            let mut start %i32 0;
            let mut i %i32 0;
            while le i n:
                do:
                    let is_end %bool eq i n
                    let is_sep %bool if:
                        is_end
                        then:
                            true
                        else:
                            string_search::str_byte_is_ascii_space_at line i
                    if:
                        is_sep
                        then:
                            set stack_state process_token_state_span stack_state line start i
                            set start add i 1
                        else:
                            unit
                    set i add i 1;

            match stack_state:
                Result::Ok stack:
                    let sp %i32 stk::len &stack;
                    if:
                        eq sp 1
                        then:
                            let popped %StackPop i32 stk::pop_top stack
                            let val_opt %Option i32 stk::stack_pop_item &popped
                            let next_stack %Stack i32 stk::stack_pop_stack popped
                            match val_opt:
                                Option::Some val:
                                    print_result val
                                Option::None:
                                    unit
                            stk::free next_stack
                        else:
                            if:
                                eq sp 0
                                then:
                                    stk::free stack
                                else:
                                    print_stack_line &stack;
                                    print_stack_count_error sp;
                                    stk::free stack
                Result::Err msg:
                    string_access::len msg;
                    unit
        Result::Err _:
            print_error "out of memory";

//: main: RPN TUI REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - 初期バナーを表示後、対話式の無限ループを開始します。
fn main %impure fn void unit \void:
    let title_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Cyan;
    println_style title_style "RPN REPL";
    println_color AnsiColor::Gray "enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.";
    println "";

    let mut running %bool true;

    while running:
        do:
            print_prompt;
            let input %str read_line;
            let input_len %i32 string_access::len input;

            if:
                eq input_len 0
                then:
                    let bye_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Yellow;
                    println_style bye_style "bye";
                    set running false;
                else:
                    eval_line input;
