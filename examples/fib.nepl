//: neplg2:test[fib, normalize_newlines]
//: [目的/もくてき]: 先頭 10 個のフィボナッチ数を表示することを確認する
//: stdout: mlstr:
//:     ##: fib = 0
//:     ##: fib = 1
//:     ##: fib = 1
//:     ##: fib = 2
//:     ##: fib = 3
//:     ##: fib = 5
//:     ##: fib = 8
//:     ##: fib = 13
//:     ##: fib = 21
//:     ##: fib = 34
//:
//: fib: while と一時変数でフィボナッチ列を作る例
//:
//: [目的/もくてき]:
//: - 2 つの状態を持つ反復計算の書き方を示します。
//: - 算術関数と可変変数を組み合わせた、少し実践的なループ例です。
//:
//: [実装/じっそう]:
//: - `(a, b)` を連続する 2 項として持ち、`next = a + b` で更新します。
//: - 各反復で古い `a` を表示してから次状態へ遷移します。
//:
//: [計算量/けいさんりょう]:
//: - 反復回数を n とすると O(n) です。
#entry main
#indent 4
#target std

#import "core/math" as *
#import "std/stdio" as *

//: main: フィボナッチ列の先頭 10 項を表示する
//:
//: [目的/もくてき]:
//: - 状態を持つ逐次計算の基本形を示します。
fn main %impure fn unit unit \unit:
    let mut a %i32 0;
    let mut b %i32 1;
    let mut i %i32 0;
    while lt i 10:
        do:
            print "fib = ";
            println_i32 a;
            let next add a b;
            set a b;
            set b next;
            set i add i 1;
