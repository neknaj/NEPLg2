//: neplg2:test[rpn_legacy_simple, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 旧実装の RPN REPL で基本加算が動くことを確認する
//: stdin: "1 2 +\n"
//: stdout: mlstr:
//:     ##: RPN REPL
//:     ##: enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.
//:     ##: 
//:     ##: > ok: result = 3
//:     ##: > bye
//:
//: rpn_regacy: 旧式の生メモリ中心 RPN 実装
//:
//: [目的/もくてき]:
//: - `rpn.nepl` より低水準な手書きパーサ / スタック処理の例を残します。
//: - 新実装と比較しながら、生メモリ操作のサンプルとして参照できます。
//:
//: [実装/じっそう]:
//: - 入力文字列を 1 byte ずつ読み、数値と演算子を手続き的に判定します。
//: - スタックは固定長配列を `alloc_raw` で確保して使います。
//:
//: [注意/ちゅうい]:
//: - 数値トークンは非負整数のみ対応です。
//: - `read_line` の内部バッファサイズに合わせて明示的に解放しています。
#entry main
#indent 4
#target std

#import "core/mem" as *
#import "core/math" as *
#import "std/stdio" as *


//: print_i32_color: 色付きで整数を表示する
//:
//: [目的/もくてき]:
//: - 結果表示やエラー表示で整数部分を強調します。
fn print_i32_color <(str,i32)*>()> (color, v):
    print color;
    print_i32 v;
    print ansi_reset;
    ()

//: println_i32_color: 色付き整数の後ろに改行を出力する
//:
//: [目的/もくてき]:
//: - `print_i32_color` を 1 行出力にした補助関数です。
fn println_i32_color <(str,i32)*>()> (color, v):
    print_i32_color color v;
    print "\n";
    ()

//: println_error: エラーメッセージを赤色で表示する
//:
//: [目的/もくてき]:
//: - 旧実装でも見やすいエラー出力を提供します。
fn println_error <(str)*>()> (msg):
    print ansi_bold;
    print ansi_red;
    print "error:";
    print ansi_reset;
    print " ";
    println_color ansi_red msg;
    ()

//: print_prompt: 入力待ちプロンプトを表示する
//:
//: [目的/もくてき]:
//: - REPL の入力開始位置を示します。
fn print_prompt <()*> ()> ():
    print ansi_bold;
    print_color ansi_green "> ";
    ()


//: main: 旧式 RPN REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - 生メモリ中心の旧実装で RPN 計算を対話実行します。
fn main <()*> ()> ():
    print ansi_bold;
    println_color ansi_cyan "RPN REPL";
    println_color ansi_gray "enter space-separated tokens (e.g. 3 4 +). Ctrl+Z to exit.";
    println "";

    let mut running <bool> true;

    while running:
        do:
            print_prompt;
            let input <str> read_line;
            let input_len <i32> load_i32 input;

            if:
                eq input_len 0
                then:
                    dealloc_raw input 1028;
                    print ansi_bold;
                    println_color ansi_yellow "bye";
                    set running false;
                    ()
                else:
                    let stack <i32> alloc_raw mul 16 4;

                    let mut sp <i32> 0;
                    let mut a <i32> 0;
                    let mut b <i32> 0;
                    let mut i <i32> 0;
                    let mut ok <i32> 1;

                    while lt i input_len:
                        do:
                            let mut skip <i32> 0;
                            let ch <i32> load_u8 add input add 4 i;

                            if:
                                eq i 0
                                then:
                                    if:
                                        eq ch 255
                                        then:
                                            set i add i 2;
                                            set skip 1;
                                        else:
                                            ()
                                    if:
                                        eq ch 239
                                        then:
                                            set i add i 3;
                                            set skip 1;
                                        else:
                                            ()
                                else:
                                    ()

                            if:
                                eq skip 1
                                then:
                                    ()
                                else:
                                    if:
                                        le ch 32
                                        then:
                                            set i add i 1;
                                            ()
                                        else:
                                            if:
                                                lt ch 48
                                                then:
                                                    if:
                                                        lt sp 2
                                                        then:
                                                            println_error "stack underflow";
                                                            set ok 0;
                                                            set i input_len;
                                                        else:
                                                            set sp sub sp 1;
                                                            set b load_i32 add stack mul sp 4;
                                                            set sp sub sp 1;
                                                            set a load_i32 add stack mul sp 4;

                                                            if:
                                                                eq ch 43
                                                                then:
                                                                    store_i32 add stack mul sp 4 add a b;
                                                                    set sp add sp 1;
                                                                else:
                                                                    if:
                                                                        eq ch 45
                                                                        then:
                                                                            store_i32 add stack mul sp 4 sub a b;
                                                                            set sp add sp 1;
                                                                        else:
                                                                            if:
                                                                                eq ch 42
                                                                                then:
                                                                                    store_i32 add stack mul sp 4 mul a b;
                                                                                    set sp add sp 1;
                                                                                else:
                                                                                    println_error "unknown operator";
                                                                                    set ok 0;
                                                                                    set i input_len;

                                                            set i add i 1;
                                                else:
                                                    if:
                                                        le ch 57
                                                        then:
                                                            let mut val <i32> 0;
                                                            let mut parsing <bool> true;

                                                            while parsing:
                                                                do:
                                                                    if:
                                                                        lt i input_len
                                                                        then:
                                                                            let digit <i32> load_u8 add input add 4 i;
                                                                            if:
                                                                                eq digit 0
                                                                                then:
                                                                                    set i add i 1;
                                                                                else:
                                                                                    if:
                                                                                        lt digit 48
                                                                                        then:
                                                                                            set parsing false;
                                                                                        else:
                                                                                            if:
                                                                                                le digit 57
                                                                                                then:
                                                                                                    set val add mul val 10 sub digit 48;
                                                                                                    set i add i 1;
                                                                                                else:
                                                                                                    set parsing false;
                                                                        else:
                                                                            set parsing false;

                                                            store_i32 add stack mul sp 4 val;
                                                            set sp add sp 1;
                                                        else:
                                                            println_error "unknown token";
                                                            set ok 0;
                                                            set i input_len;

                    if:
                        eq ok 1
                        then:
                            if:
                                eq sp 1
                                then:
                                    set sp sub sp 1;
                                    set a load_i32 add stack mul sp 4;

                                    print ansi_bold;
                                    print_color ansi_green "ok";
                                    print_color ansi_gray ": result = ";

                                    print ansi_bold;
                                    print ansi_cyan;
                                    print_i32 a;
                                    print ansi_reset;
                                    print "\n";
                                else:
                                    // Colored "stack has N values"
                                    print ansi_bold;
                                    print ansi_red;
                                    print "error:";
                                    print ansi_reset;
                                    print_color ansi_red " stack has ";
                                    print_i32_color ansi_yellow sp;
                                    println_color ansi_red " values";
                        else:
                            ();

                    dealloc_raw stack mul 16 4;
                    dealloc_raw input 1028;

    ()
