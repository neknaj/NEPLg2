//: neplg2:test[bf_loop_output, normalize_newlines, strip_ansi]
//: [目的/もくてき]: loop を使った転送と出力が正しく動くことを確認する
//: stdin: "++++++++[>++++++++<-]>+.\n"
//: stdout: mlstr:
//:     ##: Brainfuck Runner
//:     ##: enter BF program. Ctrl+Z to exit.
//:     ##: 
//:     ##: > A
//:     ##: > bye
//:
//: neplg2:test[bf_unmatched_right_bracket, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 不正なジャンプ対応がエラーとして報告されることを確認する
//: stdin: "]\n"
//: stdout: mlstr:
//:     ##: Brainfuck Runner
//:     ##: enter BF program. Ctrl+Z to exit.
//:     ##: 
//:     ##: > error: unmatched ']'
//:     ##: > bye
//:
//: bf: Brainfuck 実行器のサンプル
//:
//: [目的/もくてき]:
//: - 文字列を簡単な VM で逐次解釈する例を示します。
//: - `Vec` / `Stack` / 文字列 byte API を組み合わせる、少し大きめの example です。
//:
//: [実装/じっそう]:
//: - `[` と `]` の対応は `Vec<i32>` のジャンプ表として事前に作り、高速化します。
//: - 実行時は `pc` と `dp` を進めながら 1 命令ずつ解釈します。
//:
//: [注意/ちゅうい]:
//: - `,` は簡略化のため常に 0 を読み込みます。
//: - メモリテープは固定長 30000 セルで、左右端は循環します。

#entry main
#indent 4
#target std

#import "core/math" as *
#import "core/result" as *
#import "core/option" as *
#import "core/field" as field
#import "std/stdio" as *
#import "alloc/string/access" as string_access
#import "alloc/diag/error" as *
#import "alloc/collections/stack" as stk
#import "alloc/collections/vec" as v

//: print_error: Brainfuck 実行時エラーを赤色で表示する
//:
//: [目的/もくてき]:
//: - ジャンプ対応不整合などを利用者へ分かりやすく伝えます。
fn print_error <(str)*>()> (msg):
    let label_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Red;
    print_style label_style "error: ";
    println_color AnsiColor::Red msg

//: print_prompt: REPL の入力待ちプロンプトを表示する
//:
//: [目的/もくてき]:
//: - 各入力行の先頭を視認しやすくします。
fn print_prompt <()*>()> ():
    let prompt_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Green;
    print_style prompt_style "> "

//: make_i32_vec: 指定値で埋めた `Vec<i32>` を作る
//:
//: [目的/もくてき]:
//: - Brainfuck のテープやジャンプ表のような固定長領域を、raw memory ではなく `Vec<i32>` として用意します。
//: - 確保失敗は呼び出し側で扱えるように `Result` として返します。
fn make_i32_vec <(i32,i32)*>Result<Vec<i32>, StdErrorKind>> (n, value):
    v::filled<i32> n value

//: cell_inc: Brainfuck cell を 1 増やす
//:
//: [目的/もくてき]:
//: - byte cell として 0..255 の範囲で循環させます。
fn cell_inc <(i32)->i32> (v):
    let next <i32> add v 1
    if ge next 256 0 next

//: cell_dec: Brainfuck cell を 1 減らす
//:
//: [目的/もくてき]:
//: - byte cell として 0..255 の範囲で循環させます。
fn cell_dec <(i32)->i32> (v):
    if eq v 0 255 sub v 1

//: compile_jumps: '[' と ']' のジャンプ先を事前計算する
//:
//: [目的/もくてき]:
//: - ループ命令の対応位置を `Vec<i32>` に保存し、実行時の分岐を O(1) にします。
fn compile_jumps <(str)*>Result<Vec<i32>,str>> (code):
    let code_len <i32> string_access::len code
    match make_i32_vec code_len 0:
        Result::Err _:
            err<Vec<i32>, str> "out of memory"
        Result::Ok jump_table:
            match stk::new<i32>:
                Result::Err _:
                    v::free<i32> jump_table;
                    err<Vec<i32>, str> "out of memory"
                Result::Ok stk0:
                    let mut stack_state <Result<Stack<i32>,str>> ok<Stack<i32>,str> stk0
                    let mut pc <i32> 0;
                    let mut error <bool> false;
                    let mut error_msg <str> "";

                    while and lt pc code_len not error:
                        do:
                            match stack_state:
                                Result::Ok stk:
                                    let ch <i32> match string_access::byte_at code pc:
                                        Option::Some b:
                                            b
                                        Option::None:
                                            0
                                    if:
                                        eq ch 91 // '['
                                        then:
                                            match stk::push<i32> stk pc:
                                                Result::Ok next_stack:
                                                    set stack_state ok<Stack<i32>,str> next_stack
                                                Result::Err _:
                                                    set error true;
                                                    set error_msg "out of memory";
                                                    set stack_state err<Stack<i32>,str> "out of memory"
                                        else:
                                            if:
                                                eq ch 93 // ']'
                                                then:
                                                    let popped <StackPop<i32>> stk::pop_top<i32> stk
                                                    let start_opt <Option<i32>> stk::stack_pop_item<i32> &popped
                                                    let next_stack <Stack<i32>> stk::stack_pop_stack<i32> popped
                                                    match start_opt:
                                                        Option::Some start_pc:
                                                            v::replace<i32> &jump_table start_pc pc;
                                                            v::replace<i32> &jump_table pc start_pc;
                                                            set stack_state ok<Stack<i32>,str> next_stack
                                                        Option::None:
                                                            set error true;
                                                            set error_msg "unmatched ']'";
                                                            stk::free<i32> next_stack;
                                                            set stack_state err<Stack<i32>,str> "unmatched ']'"
                                                else:
                                                    set stack_state ok<Stack<i32>,str> stk
                                Result::Err msg:
                                    set error true;
                                    set error_msg msg;
                                    set stack_state err<Stack<i32>,str> msg
                            set pc add pc 1;

                    if:
                        error
                        then:
                            match stack_state:
                                Result::Ok stk:
                                    stk::free<i32> stk
                                Result::Err msg:
                                    string_access::len msg;
                                    ()
                            v::free<i32> jump_table;
                            err<Vec<i32>, str> error_msg
                        else:
                            match stack_state:
                                Result::Ok stk:
                                    let empty <bool> stk::is_empty<i32> &stk
                                    stk::free<i32> stk;
                                    if:
                                        not empty
                                        then:
                                            v::free<i32> jump_table;
                                            err<Vec<i32>, str> "unmatched '['"
                                        else:
                                            ok<Vec<i32>, str> jump_table
                                Result::Err msg:
                                    v::free<i32> jump_table;
                                    err<Vec<i32>, str> msg

//: current_cell: テープの現在セルを読む
//:
//: [目的/もくてき]:
//: - 範囲外を 0 として扱い、VM ループ側を簡潔に保ちます。
fn current_cell <(&Vec<i32>,i32)->i32> (tape, idx):
    match v::get<i32> tape idx:
        Option::Some cell:
            cell
        Option::None:
            0

//: jump_target: ジャンプ表から移動先を読む
//:
//: [目的/もくてき]:
//: - ジャンプ表が不正な場合は現在位置に留め、範囲外アクセスを避けます。
fn jump_target <(&Vec<i32>,i32)->i32> (jump_table, pc):
    match v::get<i32> jump_table pc:
        Option::Some target:
            target
        Option::None:
            pc

//: eval_line: 1 行の Brainfuck プログラムを実行する
//:
//: [目的/もくてき]:
//: - ジャンプ表を準備し、1 命令ずつ解釈して出力します。
//:
//: [注意点/ちゅういてん]:
//: - テープ長は呼び出し側から明示的に受け取り、内部表現には `Vec<i32>` を使います。
fn eval_line <(i32,str)*>()> (tape_len, code):
    let code_len <i32> string_access::len code;
    match make_i32_vec tape_len 0:
        Result::Err _:
            print_error "out of memory"
        Result::Ok tape:
            match compile_jumps code:
                Result::Err msg:
                    print_error msg
                Result::Ok jump_table:
                    let mut ptr_idx <i32> 0;
                    let mut pc <i32> 0;

                    while lt pc code_len:
                        do:
                            let cmd <i32> match string_access::byte_at code pc:
                                Option::Some b:
                                    b
                                Option::None:
                                    0
                            let cell <i32> current_cell &tape ptr_idx

                            if:
                                eq cmd 43 // '+'
                                then: v::replace<i32> &tape ptr_idx cell_inc cell
                                else: ()

                            if:
                                eq cmd 45 // '-'
                                then: v::replace<i32> &tape ptr_idx cell_dec cell
                                else: ()

                            if:
                                eq cmd 62 // '>'
                                then:
                                    set ptr_idx add ptr_idx 1;
                                    if:
                                        ge ptr_idx tape_len
                                        then: set ptr_idx 0
                                        else: ()
                                else: ()

                            if:
                                eq cmd 60 // '<'
                                then:
                                    set ptr_idx sub ptr_idx 1;
                                    if:
                                        lt ptr_idx 0
                                        then: set ptr_idx sub tape_len 1
                                        else: ()
                                else: ()

                            if:
                                eq cmd 46 // '.'
                                then: print_byte cell
                                else: ()

                            if:
                                eq cmd 44 // ','
                                then: v::replace<i32> &tape ptr_idx 0
                                else: ()

                            if:
                                eq cmd 91 // '['
                                then:
                                    let should_skip <bool> eq cell 0;
                                    if:
                                        should_skip
                                        then:
                                            set pc jump_target &jump_table pc
                                        else:
                                            ()
                                else: ()

                            if:
                                eq cmd 93 // ']'
                                then:
                                    let should_jump_back <bool> ne cell 0;
                                    if:
                                        should_jump_back
                                        then:
                                            set pc jump_target &jump_table pc
                                        else:
                                            ()
                                else: ()

                            set pc add pc 1;

                    print "\n";
                    v::free<i32> jump_table

            v::free<i32> tape

//: main: Brainfuck REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - バナーを表示し、1 行ごとに Brainfuck プログラムを受け付けます。
fn main <()*>()> ():
    let title_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Cyan;
    println_style title_style "Brainfuck Runner";
    println_color AnsiColor::Gray "enter BF program. Ctrl+Z to exit.";
    println "";

    let tape_len <i32> 30000;
    let mut running <bool> true;

    while running:
        do:
            print_prompt;
            let input <str> read_line;
            
            if:
                eq string_access::len input 0
                then:
                    let bye_style <AnsiTextStyle> ansi_bold_color_style AnsiColor::Yellow;
                    println_style bye_style "bye";
                    set running false
                else:
                    eval_line tape_len input
