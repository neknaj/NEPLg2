//: neplg2:test[bf_loop_output, normalize_newlines, strip_ansi]
//: [目的/もくてき]: loop を使った転送と出力が正しく動くことを確認する
//: stdin: "++++++++[>++++++++<-]>+.\n"
//: stdout: mlstr:
//:     ##: Brainfuck Runner
//:     ##: enter BF program. Ctrl+Z to exit.
//:     ##:
//:     ##: > A
//:     ##: > bye
//:
//: neplg2:test[bf_unmatched_right_bracket, normalize_newlines, strip_ansi]
//: [目的/もくてき]: 不正なジャンプ対応がエラーとして報告されることを確認する
//: stdin: "]\n"
//: stdout: mlstr:
//:     ##: Brainfuck Runner
//:     ##: enter BF program. Ctrl+Z to exit.
//:     ##:
//:     ##: > error: unmatched ']'
//:     ##: > bye
//:
//: bf: Brainfuck 実行器のサンプル
//:
//: [目的/もくてき]:
//: - 文字列を簡単な VM で逐次解釈する例を示します。
//: - `Vec` / `Stack` / 文字列 byte API を組み合わせる、少し大きめの example です。
//:
//: [実装/じっそう]:
//: - `[` と `]` の対応は `Vec i32` のジャンプ表として事前に作り、高速化します。
//: - 実行時は `pc` と `dp` を進めながら 1 命令ずつ解釈します。
//:
//: [注意/ちゅうい]:
//: - `,` は簡略化のため常に 0 を読み込みます。
//: - メモリテープは固定長 30000 セルで、左右端は循環します。

#entry main
#indent 4
#target std

#import "core/math" as *
#import "core/result" as *
#import "core/option" as *
#import "core/field" as field
#import "std/stdio" as *
#import "alloc/string/access" as string_access
#import "alloc/diag/error" as *
#import "alloc/collections/stack" as stk
#import "alloc/collections/vec" as v

//: BfCommand: Brainfuck の 1 byte 命令を分類した値
//:
//: [目的/もくてき]:
//: - `43` や `91` のような ASCII 数値を VM 本体へ散らさず、命令の意味を enum として保持します。
//: - 実行 loop と jump table compiler は `match` で全命令を扱い、分岐漏れを見つけやすくします。
//:
//: [注意/ちゅうい]:
//: - Brainfuck 以外の文字は comment として扱うため `Other` に分類します。
enum BfCommand:
    Inc
    Dec
    MoveRight
    MoveLeft
    Output
    Input
    LoopStart
    LoopEnd
    Other

//: bf_command_from_byte: 入力 byte を Brainfuck 命令 enum へ分類する
//:
//: [契約/けいやく]:
//: - `+ - > < . , [ ]` は対応する `BfCommand` を返します。
//: - それ以外の byte は `Other` を返し、実行時は no-op comment として扱います。
fn bf_command_from_byte %fn i32 BfCommand \byte:
    match byte:
        43:
            BfCommand::Inc
        45:
            BfCommand::Dec
        62:
            BfCommand::MoveRight
        60:
            BfCommand::MoveLeft
        46:
            BfCommand::Output
        44:
            BfCommand::Input
        91:
            BfCommand::LoopStart
        93:
            BfCommand::LoopEnd
        _:
            BfCommand::Other

//: print_error: Brainfuck 実行時エラーを赤色で表示する
//:
//: [目的/もくてき]:
//: - ジャンプ対応不整合などを利用者へ分かりやすく伝えます。
fn print_error %impure fn str unit \msg:
    let label_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Red;
    print_style label_style "error: ";
    println_color AnsiColor::Red msg

//: print_prompt: REPL の入力待ちプロンプトを表示する
//:
//: [目的/もくてき]:
//: - 各入力行の先頭を視認しやすくします。
fn print_prompt %impure fn void unit \void:
    let prompt_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Green;
    print_style prompt_style "> "

//: make_i32_vec: 指定値で埋めた `Vec i32` を作る
//:
//: [目的/もくてき]:
//: - Brainfuck のテープやジャンプ表のような固定長領域を、raw memory ではなく `Vec i32` として用意します。
//: - 確保失敗は呼び出し側で扱えるように `Result` として返します。
fn make_i32_vec %impure fn i32 impure fn i32 Result Vec i32 StdErrorKind \n\value:
    v::filled n value

//: cell_inc: Brainfuck cell を 1 増やす
//:
//: [目的/もくてき]:
//: - byte cell として 0..255 の範囲で循環させます。
fn cell_inc %fn i32 i32 \v:
    let next %i32 add v 1
    if ge next 256 0 next

//: cell_dec: Brainfuck cell を 1 減らす
//:
//: [目的/もくてき]:
//: - byte cell として 0..255 の範囲で循環させます。
fn cell_dec %fn i32 i32 \v:
    if eq v 0 255 sub v 1

//: compile_jumps: '[' と ']' のジャンプ先を事前計算する
//:
//: [目的/もくてき]:
//: - ループ命令の対応位置を `Vec i32` に保存し、実行時の分岐を O(1) にします。
fn compile_jumps %impure fn str Result Vec i32 str \code:
    let code_len %i32 string_access::len code
    match make_i32_vec code_len 0:
        Result::Err _:
            err "out of memory"
        Result::Ok jump_table:
            let stack_init %Result Stack i32 Diag stk::new
            match stack_init:
                Result::Err _:
                    v::free jump_table;
                    err "out of memory"
                Result::Ok stk0:
                    let mut stack_state %Result Stack i32 str ok stk0
                    let mut pc %i32 0;
                    let mut error %bool false;
                    let mut error_msg %str "";

                    while and lt pc code_len not error:
                        do:
                            match stack_state:
                                Result::Ok stk:
                                    let ch %i32 match string_access::byte_at code pc:
                                        Option::Some b:
                                            b
                                        Option::None:
                                            0
                                    let command %BfCommand bf_command_from_byte ch
                                    match command:
                                        BfCommand::LoopStart:
                                            match stk::push stk pc:
                                                Result::Ok next_stack:
                                                    set stack_state ok next_stack
                                                Result::Err e:
                                                    let returned_stack %Stack i32 stk::stack_push_error_stack e
                                                    stk::free returned_stack;
                                                    set error true;
                                                    set error_msg "out of memory";
                                                    set stack_state err "out of memory"
                                        BfCommand::LoopEnd:
                                            let popped %StackPop i32 stk::pop_top stk
                                            let start_opt %Option i32 stk::stack_pop_item &popped
                                            let next_stack %Stack i32 stk::stack_pop_stack popped
                                            match start_opt:
                                                Option::Some start_pc:
                                                    v::replace &jump_table start_pc pc;
                                                    v::replace &jump_table pc start_pc;
                                                    set stack_state ok next_stack
                                                Option::None:
                                                    set error true;
                                                    set error_msg "unmatched ']'";
                                                    stk::free next_stack;
                                                    set stack_state err "unmatched ']'"
                                        _:
                                            set stack_state ok stk
                                Result::Err msg:
                                    set error true;
                                    set error_msg msg;
                                    set stack_state err msg
                            set pc add pc 1;

                    if:
                        error
                        then:
                            match stack_state:
                                Result::Ok stk:
                                    stk::free stk
                                Result::Err msg:
                                    string_access::len msg;
                                    unit
                            v::free jump_table;
                            err error_msg
                        else:
                            match stack_state:
                                Result::Ok stk:
                                    let empty %bool stk::is_empty &stk
                                    stk::free stk;
                                    if:
                                        not empty
                                        then:
                                            v::free jump_table;
                                            err "unmatched '['"
                                        else:
                                            ok jump_table
                                Result::Err msg:
                                    v::free jump_table;
                                    err msg

//: current_cell: テープの現在セルを読む
//:
//: [目的/もくてき]:
//: - 範囲外を 0 として扱い、VM ループ側を簡潔に保ちます。
fn current_cell %fn &Vec i32 fn i32 i32 \tape\idx:
    match v::get tape idx:
        Option::Some cell:
            cell
        Option::None:
            0

//: jump_target: ジャンプ表から移動先を読む
//:
//: [目的/もくてき]:
//: - ジャンプ表が不正な場合は現在位置に留め、範囲外アクセスを避けます。
fn jump_target %fn &Vec i32 fn i32 i32 \jump_table\pc:
    match v::get jump_table pc:
        Option::Some target:
            target
        Option::None:
            pc

//: eval_line: 1 行の Brainfuck プログラムを実行する
//:
//: [目的/もくてき]:
//: - ジャンプ表を準備し、1 命令ずつ解釈して出力します。
//:
//: [注意点/ちゅういてん]:
//: - テープ長は呼び出し側から明示的に受け取り、内部表現には `Vec i32` を使います。
fn eval_line %impure fn i32 impure fn str unit \tape_len\code:
    let code_len %i32 string_access::len code;
    match make_i32_vec tape_len 0:
        Result::Err _:
            print_error "out of memory"
        Result::Ok tape:
            match compile_jumps code:
                Result::Err msg:
                    print_error msg
                Result::Ok jump_table:
                    let mut ptr_idx %i32 0;
                    let mut pc %i32 0;

                    while lt pc code_len:
                        do:
                            let cmd %i32 match string_access::byte_at code pc:
                                Option::Some b:
                                    b
                                Option::None:
                                    0
                            let command %BfCommand bf_command_from_byte cmd
                            let cell %i32 current_cell &tape ptr_idx

                            match command:
                                BfCommand::Inc:
                                    let next_cell %i32 cell_inc cell
                                    v::replace &tape ptr_idx next_cell
                                BfCommand::Dec:
                                    let prev_cell %i32 cell_dec cell
                                    v::replace &tape ptr_idx prev_cell
                                BfCommand::MoveRight:
                                    set ptr_idx add ptr_idx 1;
                                    if:
                                        ge ptr_idx tape_len
                                        then: set ptr_idx 0
                                        else: unit
                                BfCommand::MoveLeft:
                                    set ptr_idx sub ptr_idx 1;
                                    if:
                                        lt ptr_idx 0
                                        then: set ptr_idx sub tape_len 1
                                        else: unit
                                BfCommand::Output:
                                    print_byte cell
                                BfCommand::Input:
                                    v::replace &tape ptr_idx 0
                                BfCommand::LoopStart:
                                    let should_skip %bool eq cell 0;
                                    if:
                                        should_skip
                                        then:
                                            set pc jump_target &jump_table pc
                                        else:
                                            unit
                                BfCommand::LoopEnd:
                                    let should_jump_back %bool ne cell 0;
                                    if:
                                        should_jump_back
                                        then:
                                            set pc jump_target &jump_table pc
                                        else:
                                            unit
                                BfCommand::Other:
                                    unit

                            set pc add pc 1;

                    print "\n";
                    v::free jump_table

            v::free tape

//: main: Brainfuck REPL のエントリーポイント
//:
//: [目的/もくてき]:
//: - バナーを表示し、1 行ごとに Brainfuck プログラムを受け付けます。
fn main %impure fn void unit \void:
    let title_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Cyan;
    println_style title_style "Brainfuck Runner";
    println_color AnsiColor::Gray "enter BF program. Ctrl+Z to exit.";
    println "";

    let tape_len %i32 30000;
    let mut running %bool true;

    while running:
        do:
            print_prompt;
            let input %str read_line;

            if:
                eq string_access::len input 0
                then:
                    let bye_style %AnsiTextStyle ansi_bold_color_style AnsiColor::Yellow;
                    println_style bye_style "bye";
                    set running false
                else:
                    eval_line tape_len input
