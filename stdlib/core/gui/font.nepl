//: gui_glyph_metrics: glyph metrics value を[作/つく]る
//:
//: neplg2:test[skip]
pub fn gui_glyph_metrics %fn GuiGlyphId fn i32 fn i32 fn GuiRect fn GuiRect GuiGlyphMetrics \glyph\advance_x\advance_y\ink_bounds\allocation_bounds:
    GuiGlyphMetrics glyph advance_x advance_y ink_bounds allocation_bounds

//: gui_glyph_metrics_glyph: metrics が[対象/たいしょう]にする glyph id を[読/よ]む
//:
//: neplg2:test[skip]
pub fn gui_glyph_metrics_glyph %fn &GuiGlyphMetrics GuiGlyphId \metrics:
