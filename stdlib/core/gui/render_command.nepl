pub struct TextRunCommand:
    run_id %TextRunId
    position %GuiPoint
    paint %TextPaint

impl Clone for TextRunCommand:
    fn clone %fn &TextRunCommand TextRunCommand \command:
        *command

impl Copy for TextRunCommand:
    fn copy_mark %fn TextRunCommand TextRunCommand \command:
        command

