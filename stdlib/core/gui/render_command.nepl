//: # core/gui/render_command
//: GUI/TUI [共通/きょうつう] render command の no_alloc [表現/ひょうげん]
//:
//: ### [目的/もくてき]
//: - pixel-only draw target より[高水準/こうすいじゅん]な command stream を、allocator なしで[受/う]け[渡/わた]せる[型/かた]として[定義/ていぎ]します。
//: - TUI text-grid backend は `TextCellRun` command を[受/う]け、具体的な output encoding は platform [層/そう]で[処理/しょり]します。
//:
//: ### [注意/ちゅうい]
//: - text/image/alpha mask の[実体/じったい]は `TextRunId` / `ImageId` / `AlphaMaskId` で[参照/さんしょう]します。文字列 buffer、image buffer、mask buffer は core では[保持/ほじ]しません。
//: - Phase 1 では command value と constructor だけを[置/お]き、trait-heavy な RenderTarget/DrawTarget 実装は[追加/ついか]しません。
//:
//: ### [計算量/けいさんりょう]
//: - constructor と accessor は O(1) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/gui/render_command" as *
//: ```

#indent 4

#import "core/field" as field
#import "core/gui/color" as *
#import "core/gui/geometry" as *
#import "core/traits/copy" as *

//: TextRunId: alloc/std [層/そう]の text run を[参照/さんしょう]する id
pub struct TextRunId:
    raw %i32

impl Clone for TextRunId:
    fn clone %fn &TextRunId TextRunId \id:
        *id

impl Copy for TextRunId:
    fn copy_mark %fn TextRunId TextRunId \id:
        id

//: ImageId: backend [側/がわ]の image resource を[参照/さんしょう]する id
pub struct ImageId:
    raw %i32

impl Clone for ImageId:
    fn clone %fn &ImageId ImageId \id:
        *id

impl Copy for ImageId:
    fn copy_mark %fn ImageId ImageId \id:
        id

//: AlphaMaskId: backend [側/がわ]の alpha mask resource を[参照/さんしょう]する id
pub struct AlphaMaskId:
    raw %i32

impl Clone for AlphaMaskId:
    fn clone %fn &AlphaMaskId AlphaMaskId \id:
        *id

impl Copy for AlphaMaskId:
    fn copy_mark %fn AlphaMaskId AlphaMaskId \id:
        id

//: GuiPaint: fill [用/よう] paint
pub struct GuiPaint:
    color %Rgba8888

impl Clone for GuiPaint:
    fn clone %fn &GuiPaint GuiPaint \paint:
        *paint

impl Copy for GuiPaint:
    fn copy_mark %fn GuiPaint GuiPaint \paint:
        paint

//: GuiStroke: stroke [用/よう] paint と width
pub struct GuiStroke:
    color %Rgba8888
    width %i32

impl Clone for GuiStroke:
    fn clone %fn &GuiStroke GuiStroke \stroke:
        *stroke

impl Copy for GuiStroke:
    fn copy_mark %fn GuiStroke GuiStroke \stroke:
        stroke

//: TextPaint: text [用/よう] paint
pub struct TextPaint:
    color %Rgba8888

impl Clone for TextPaint:
    fn clone %fn &TextPaint TextPaint \paint:
        *paint

impl Copy for TextPaint:
    fn copy_mark %fn TextPaint TextPaint \paint:
        paint

//: Transform2d: 2D affine transform の fixed-point [係数/けいすう]
//:
//: [注意/ちゅうい]:
//: - 係数の scale contract は render backend [側/がわ]で[決/き]めます。core では 6 つの i32 value として[保持/ほじ]します。
pub struct Transform2d:
    m00 %i32
    m01 %i32
    m02 %i32
    m10 %i32
    m11 %i32
    m12 %i32

impl Clone for Transform2d:
    fn clone %fn &Transform2d Transform2d \transform:
        *transform

impl Copy for Transform2d:
    fn copy_mark %fn Transform2d Transform2d \transform:
        transform

//: TextGridPoint: text-grid surface の cell [位置/いち]
pub struct TextGridPoint:
    column %i32
    row %i32

impl Clone for TextGridPoint:
    fn clone %fn &TextGridPoint TextGridPoint \point:
        *point

impl Copy for TextGridPoint:
    fn copy_mark %fn TextGridPoint TextGridPoint \point:
        point

//: TextCellStyle: text grid cell の[色/いろ] style
pub struct TextCellStyle:
    foreground %Rgba8888
    background %Rgba8888

impl Clone for TextCellStyle:
    fn clone %fn &TextCellStyle TextCellStyle \style:
        *style

impl Copy for TextCellStyle:
    fn copy_mark %fn TextCellStyle TextCellStyle \style:
        style

//: TextCellRun: text grid surface へ[渡/わた]す cell run
//:
//: [目的/もくてき]:
//: - text-grid backend が[表示/ひょうじ]する text run id、開始 cell、cell count、style を 1 value に[束/たば]ねます。
pub struct TextCellRun:
    point %TextGridPoint
    run_id %TextRunId
    cell_count %i32
    style %TextCellStyle

impl Clone for TextCellRun:
    fn clone %fn &TextCellRun TextCellRun \run:
        *run

impl Copy for TextCellRun:
    fn copy_mark %fn TextCellRun TextCellRun \run:
        run

//: FillRectCommand: [塗/ぬ]り[潰/つぶ]し[矩形/くけい] command の payload
//:
//: ### [目的/もくてき]
//: - `GuiRect` と `GuiPaint` を 1 value に[束/たば]ね、command stream の `FillRect` variant に[載/の]せます。
//:
//: ### [契約/けいやく]
//: - geometry の[正当性/せいとうせい]や clipping はこの型では[検査/けんさ]しません。layout、rasterizer、backend が `GuiError::InvalidGeometry` などで[扱/あつか]います。
//: - `GuiPaint` は color value だけを[持/も]ち、theme や platform-specific brush を core に[持/も]ち[込/こ]みません。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `GuiRect` と `GuiPaint` を保持する no_alloc / Copy value です。
//:
//: ### [計算量/けいさんりょう]
//: - construction と copy は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "test_report name=\"core_gui_fill_rect_command_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"return value\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/cast" as *
//:| #import "core/gui/color" as *
//:| #import "core/gui/geometry" as *
//:| #import "core/gui/render_command" as *
//: #import "std/test" as test
//:
//: fn run_case %fn void i32 \void:
//:     let zero %u8 cast 0
//:     let full %u8 cast 255
//:     let color %Rgba8888 rgba8888_new full zero zero full
//:     let paint %GuiPaint gui_paint_solid color
//:     let rect %GuiRect gui_rect_new 1 2 30 40
//:     let _command %FillRectCommand FillRectCommand rect paint
//:     0
//:
//: fn main %impure fn void i32 \void:
//:     let actual %i32 run_case
//:     let report:
//:         test::test_report_new "core_gui_fill_rect_command_doc"
//:         |> test::test_report_push test::assert_eq_i32 "return value" 0 actual
//:     let shown test::test_report_print_stdout report
//:     test::test_report_exit_code shown
//: ```
pub struct FillRectCommand:
    rect %GuiRect
    paint %GuiPaint

impl Clone for FillRectCommand:
    fn clone %fn &FillRectCommand FillRectCommand \command:
        *command

impl Copy for FillRectCommand:
    fn copy_mark %fn FillRectCommand FillRectCommand \command:
        command

