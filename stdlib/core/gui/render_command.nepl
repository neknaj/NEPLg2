//: AlphaMaskRectCommand: alpha mask resource [参照/さんしょう] command の payload
//:
//: ### [目的/もくてき]
//: - alpha mask buffer の[実体/じったい]を core に[持/も]たせず、`AlphaMaskId`、[配置/はいち]先 `GuiRect`、[着色/ちゃくしょく]に[使/つか]う `GuiPaint` だけを command stream に[載/の]せます。
//:
//: ### [契約/けいやく]
//: - この command は SourceOver [合成/ごうせい]で alpha mask を[塗/ぬ]るための payload です。任意の blend mode は payload に[持/も]たないため、SourceOver 以外の glyph blend は command [構築/こうちく]前に typed error で[拒否/きょひ]します。
//: - 出力 RGB は `GuiPaint` の RGB 由来です。出力 alpha は mask alpha と `GuiPaint` alpha を renderer [層/そう]が SourceOver contract に[従/したが]って[合成/ごうせい]します。
//: - mask byte storage、mask dimensions、resource 解決、missing resource、unsupported resource は alloc/std/platform/renderer [層/そう]が `Result` / `GuiError` で[扱/あつか]います。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `AlphaMaskId`、`GuiRect`、`GuiPaint` を保持する no_alloc / Copy value です。
//:
//: ### [計算量/けいさんりょう]
//: - construction と copy は O(1) です。mask decode、upload、blend 実行はこの型では[行/おこな]いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "test_report name=\"core_gui_alpha_mask_rect_command_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"mask id\" expected=\"42\" actual=\"42\" message=\"\"\n"
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/cast" as *
//:| #import "core/gui/color" as *
//:| #import "core/gui/geometry" as *
//:| #import "core/gui/render_command" as *
//: #import "std/test" as test
//:
//: fn command_code %fn RenderCommand i32 \command:
//:     match command:
//:         RenderCommand::AlphaMaskRect payload:
//:             let read_id %AlphaMaskId alpha_mask_rect_command_mask_id &payload
//:             alpha_mask_id_raw &read_id
//:         _:
//:             0
//:
//: fn run_case %fn void i32 \void:
//:     let zero %u8 cast 0
//:     let full %u8 cast 255
//:     let color %Rgba8888 rgba8888_new full full full full
//:     let paint %GuiPaint gui_paint_solid color
//:     let mask %AlphaMaskId alpha_mask_id_new 42
//:     let rect %GuiRect gui_rect_new 3 4 50 60
//:     command_code render_command_alpha_mask_rect mask rect paint
//:
//: fn main %impure fn void i32 \void:
//:     let actual %i32 run_case
//:     let report:
//:         test::test_report_new "core_gui_alpha_mask_rect_command_doc"
//:         |> test::test_report_push test::assert_eq_i32 "mask id" 42 actual
//:     let shown test::test_report_print_stdout report
//:     test::test_report_exit_code shown
//: ```
pub struct AlphaMaskRectCommand:
    mask_id %AlphaMaskId
    rect %GuiRect
    paint %GuiPaint

impl Clone for AlphaMaskRectCommand:
    fn clone %fn &AlphaMaskRectCommand AlphaMaskRectCommand \command:
        *command

impl Copy for AlphaMaskRectCommand:
    fn copy_mark %fn AlphaMaskRectCommand AlphaMaskRectCommand \command:
        command

//: TextCellRunCommand: text-grid run command の payload
//:
//: ### [目的/もくてき]
//: - GUI と TUI が[共有/きょうゆう]する command stream 上で、cell-based surface に[渡/わた]す `TextCellRun` を 1 variant の payload として[保持/ほじ]します。
//:
//: ### [契約/けいやく]
//: - `TextCellRun` は cell position、text run id、cell count、style を[持/も]ちます。文字列そのものや escape sequence は core に[持/も]ち[込/こ]みません。
//: - cell width、wide character、fallback glyph の[扱/あつか]いは text measurement / backend [層/そう]の責務です。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `TextCellRun` を保持する no_alloc / Copy value です。
//:
//: ### [計算量/けいさんりょう]
//: - construction と copy は O(1) です。cell expansion はこの型では[行/おこな]いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "test_report name=\"core_gui_text_cell_run_command_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"return value\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/cast" as *
//:| #import "core/gui/color" as *
//:| #import "core/gui/render_command" as *
//: #import "std/test" as test
//:
//: fn run_case %fn void i32 \void:
//:     let zero %u8 cast 0
//:     let full %u8 cast 255
//:     let fg %Rgba8888 rgba8888_new full full full full
//:     let bg %Rgba8888 rgba8888_new zero zero zero full
//:     let style %TextCellStyle text_cell_style_new fg bg
//:     let point %TextGridPoint text_grid_point_new 2 3
//:     let run %TextCellRun text_cell_run_new point text_run_id_new 5 4 style
//:     let _command %TextCellRunCommand TextCellRunCommand run
//:     0
//:
//: fn main %impure fn void i32 \void:
//:     let actual %i32 run_case
//:     let report:
//:         test::test_report_new "core_gui_text_cell_run_command_doc"
//:         |> test::test_report_push test::assert_eq_i32 "return value" 0 actual
//:     let shown test::test_report_print_stdout report
//:     test::test_report_exit_code shown
//: ```
pub struct TextCellRunCommand:
    run %TextCellRun

impl Clone for TextCellRunCommand:
    fn clone %fn &TextCellRunCommand TextCellRunCommand \command:
        *command

impl Copy for TextCellRunCommand:
    fn copy_mark %fn TextCellRunCommand TextCellRunCommand \command:
        command

//: RenderCommand: backend へ[渡/わた]す command stream の 1 command
//:
//: ### [目的/もくてき]
//: - GUI/TUI [共通/きょうつう]の render output を enum として[表/あらわ]し、backend は `match` で[扱/あつか]える variant だけを[処理/しょり]します。
//:
//: ### [契約/けいやく]
//: - unsupported variant は silent no-op にせず、renderer/host [層/そう]で `Result` / `GuiError::Unsupported` として[返/かえ]します。
//: - resource handle と command payload は typed value として[渡/わた]し、platform handle や string sentinel は core public API に[出/だ]しません。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - Fill/stroke/line/text/image/alpha-mask/clip/transform/text-cell command を持つ Copy enum です。
//:
//: ### [計算量/けいさんりょう]
//: - construction、copy、variant match は O(1) です。描画 cost は backend の variant [処理/しょり]に[依存/いぞん]します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "test_report name=\"core_gui_render_command_enum_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"return value\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/cast" as *
//:| #import "core/gui/color" as *
//:| #import "core/gui/geometry" as *
//:| #import "core/gui/render_command" as *
//: #import "std/test" as test
//:
//: fn command_code %fn RenderCommand i32 \command:
//:     match command:
//:         RenderCommand::FillRect _payload:
//:             0
//:         _:
//:             1
//:
//: fn run_case %fn void i32 \void:
//:     let zero %u8 cast 0
//:     let full %u8 cast 255
//:     let color %Rgba8888 rgba8888_new full zero zero full
//:     let paint %GuiPaint gui_paint_solid color
//:     let rect %GuiRect gui_rect_new 1 2 30 40
//:     command_code render_command_fill_rect rect paint
//:
//: fn main %impure fn void i32 \void:
//:     let actual %i32 run_case
//:     let report:
//:         test::test_report_new "core_gui_render_command_enum_doc"
//:         |> test::test_report_push test::assert_eq_i32 "return value" 0 actual
//:     let shown test::test_report_print_stdout report
//:     test::test_report_exit_code shown
//: ```
pub enum RenderCommand:
    FillRect %FillRectCommand
    StrokeRect %StrokeRectCommand
    Line %LineCommand
    TextRun %TextRunCommand
    ImageRect %ImageRectCommand
    AlphaMaskRect %AlphaMaskRectCommand
    PushClip %GuiRect
    PopClip
    PushTransform %Transform2d
    PopTransform
    TextCellRun %TextCellRunCommand

impl Clone for RenderCommand:
    fn clone %fn &RenderCommand RenderCommand \command:
        *command

impl Copy for RenderCommand:
    fn copy_mark %fn RenderCommand RenderCommand \command:
        command

