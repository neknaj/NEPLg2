pub struct LineCommand:
    start %GuiPoint
    end %GuiPoint
    stroke %GuiStroke

impl Clone for LineCommand:
    fn clone %fn &LineCommand LineCommand \command:
        *command

impl Copy for LineCommand:
    fn copy_mark %fn LineCommand LineCommand \command:
        command

//: TextRunCommand: text run [参照/さんしょう] command の payload
//:
//: ### [目的/もくてき]
//: - text buffer や glyph buffer の[実体/じったい]を core に[持/も]たせず、`TextRunId`、position、`TextPaint` だけを command stream に[載/の]せます。
//:
//: ### [契約/けいやく]
//: - `TextRunId` の[解決/かいけつ]、font shaping、line breaking、IME composition は alloc/std/platform [層/そう]の責務です。
//: - core は `TextRunId` を opaque handle として[運/はこ]び、missing resource は renderer 側が `Result` / `GuiError` で[返/かえ]します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `TextRunId`、`GuiPoint`、`TextPaint` を保持する no_alloc / Copy value です。
//:
//: ### [計算量/けいさんりょう]
//: - construction と copy は O(1) です。text measure や glyph layout はこの型では[行/おこな]いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "test_report name=\"core_gui_text_run_command_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"return value\" expected=\"0\" actual=\"0\" message=\"\"\n"
