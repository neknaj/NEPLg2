//: xorshift32: 32-bit Xorshift 疑似乱数生成器
//:
//: [目的/もくてき]:
//: - seed から軽量な deterministic PRNG state を作り、テスト用データや簡易な分散処理に使える値列を生成します。
//: - state を値として返す API にし、呼び出し側が次の state を明示的に保持できるようにします。
//:
//: [注意/ちゅうい]:
//: - 暗号論的安全性はありません。token、secret、security boundary の乱数には使わないでください。
//: - seed 0 は Xorshift の固定点なので `new_xorshift32` が 1 へ補正します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main %impure fn unit i32 \unit:
//:     unit
//:     0
//: ```

#indent 4
#import "core/math" as *

//: Xorshift32: 現在の PRNG state
//:
//: [目的/もくてき]:
//: - Xorshift32 の 32-bit state を保持します。
//: - `xorshift32_next` の返り値を次回呼び出しへ渡すことで、deterministic な値列を進めます。
//:
//: [実装/じっそう]:
//: - state は i32 ですが、演算は 32-bit unsigned bit pattern として扱います。
//:
//: [注意/ちゅうい]:
//: - state 0 は更新しても 0 のままなので、constructor 以外で直接作る場合も 0 を避けてください。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
pub struct Xorshift32:
    state %i32

//: new_xorshift32: seed から PRNG state を作る
//:
//: [目的/もくてき]:
//: - seed を初期 state として `Xorshift32` を返します。
//:
//: [実装/じっそう]:
//: - seed が 0 の場合だけ 1 に補正し、Xorshift32 の固定点を避けます。
//:
//: [注意/ちゅうい]:
//: - 同じ seed からは常に同じ値列が生成されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn new_xorshift32 %fn i32 Xorshift32 \seed:
    let s %i32 if:
        eq seed 0
        then 1
        else seed
    Xorshift32 s

//: xorshift32_next: state を 1 step 進める
//:
//: [目的/もくてき]:
//: - Xorshift32 の更新式を 1 回適用し、次の state を返します。
//: - 生成値として使う数値は返り値の `state` field です。
//:
//: [実装/じっそう]:
//: - Marsaglia の xorshift32 と同じ `x ^= x << 13; x ^= x >> 17; x ^= x << 5` を使います。
//: - 右 shift は `shr_u` で unsigned logical shift として扱います。
//:
//: [注意/ちゅうい]:
//: - 入力 state は消費されます。連続生成では必ず返り値を次の呼び出しへ渡してください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn xorshift32_next %fn Xorshift32 Xorshift32 \rng:
    let x %i32 rng.state
    let x1 %i32 xor x (shl x 13)
    let x2 %i32 xor x1 (shr_u x1 17)
    let x3 %i32 xor x2 (shl x2 5)
    Xorshift32 x3
