//: # math/i32/bitwise
//: i32 の bitwise 演算と bit count 演算を提供する submodule
//:
//: [目的/もくてき]:
//: - i32 の AND / OR / XOR、shift / rotate、bit count 系 intrinsic を算術・比較から分けて管理します。
//: - `core/math/i32` facade から再 export されるため、通常利用では既存の import path を変えずに使えます。
//:
//: [注意/ちゅうい]:
//: - 入力は i32 のビット列として扱い、符号付き値かどうかは演算ごとの規則に従います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/math/i32/bitwise" as *
//: fn main <()*>()> ():
//:     assert_eq_i32 7 or 6 3;
//:     assert_eq_i32 4 popcnt 15;
//: ```

#indent 4

//: and: i32 のビット AND
//:
//: [目的/もくてき]:
//: - i32 と i32 の各ビットに対して AND を取り、両方が 1 のビットだけを残します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.and`、llvm は `and i32` を使って同じ結果を返します。
//:
//: [注意/ちゅうい]:
//: - ビット演算なので符号は区別しません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main <()*>()> ():
//:     assert_eq_i32 2 and 6 3;
//:     assert_eq_i32 7 or 6 3;
//:     assert_eq_i32 5 xor 6 3;
//:     assert_eq_i32 8 shl 1 3;
//:     assert_eq_i32 -2 shr_s -8 2;
//:     assert_eq_i32 1073741822 shr_u -8 2;
//:     assert_eq_i32 2 rotl 1 1;
//:     assert_eq_i32 1 rotr 2 1;
//: ```
fn and <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.and
    #if[target=llvm]
    #llvmir:
        define i32 @and(i32 %a, i32 %b) {
        entry:
            %0 = and i32 %a, %b
            ret i32 %0
        }

//: or: i32 のビット OR
//:
//: [目的/もくてき]:
//: - i32 と i32 の各ビットに対して OR を取り、どちらかが 1 のビットを立てます。
//:
//: [実装/じっそう]:
//: - wasm は `i32.or`、llvm は `or i32` を使います。
//:
//: [注意/ちゅうい]:
//: - ビット演算なので符号は区別しません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn or <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.or
    #if[target=llvm]
    #llvmir:
        define i32 @or(i32 %a, i32 %b) {
        entry:
            %0 = or i32 %a, %b
            ret i32 %0
        }

//: xor: i32 のビット XOR
//:
//: [目的/もくてき]:
//: - i32 と i32 の各ビットに対して XOR を取り、異なるビットだけを 1 にします。
//:
//: [実装/じっそう]:
//: - wasm は `i32.xor`、llvm は `xor i32` を使います。
//:
//: [注意/ちゅうい]:
//: - ビット演算なので符号は区別しません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn xor <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.xor
    #if[target=llvm]
    #llvmir:
        define i32 @xor(i32 %a, i32 %b) {
        entry:
            %0 = xor i32 %a, %b
            ret i32 %0
        }

//: shl: i32 の左シフト
//:
//: [目的/もくてき]:
//: - `a` のビット列を `b` だけ左にずらします。
//:
//: [実装/じっそう]:
//: - wasm は `i32.shl`、llvm は `shl i32` を使います。
//:
//: [注意/ちゅうい]:
//: - シフト量は実行系の規則に従って下位ビットが使われます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shl <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.shl
    #if[target=llvm]
    #llvmir:
        define i32 @shl(i32 %a, i32 %b) {
        entry:
            %0 = shl i32 %a, %b
            ret i32 %0
        }

//: shr_s: i32 の算術右シフト
//:
//: [目的/もくてき]:
//: - 符号を保ちながら `a` を右シフトします。
//:
//: [実装/じっそう]:
//: - wasm は `i32.shr_s`、llvm は `ashr i32` を使います。
//:
//: [注意/ちゅうい]:
//: - 負数のときは符号拡張されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shr_s <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.shr_s
    #if[target=llvm]
    #llvmir:
        define i32 @shr_s(i32 %a, i32 %b) {
        entry:
            %0 = ashr i32 %a, %b
            ret i32 %0
        }

//: shr_u: i32 の論理右シフト
//:
//: [目的/もくてき]:
//: - 上位を 0 で埋めながら `a` を右シフトします。
//:
//: [実装/じっそう]:
//: - wasm は `i32.shr_u`、llvm は `lshr i32` を使います。
//:
//: [注意/ちゅうい]:
//: - 符号なし値として扱いたいときに使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shr_u <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.shr_u
    #if[target=llvm]
    #llvmir:
        define i32 @shr_u(i32 %a, i32 %b) {
        entry:
            %0 = lshr i32 %a, %b
            ret i32 %0
        }

//: rotl: i32 の左ローテート
//:
//: [目的/もくてき]:
//: - i32 のビット列を左方向に循環回転します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.rotl`、llvm は `llvm.fshl.i32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - ローテートはシフトと異なり、あふれたビットが反対側に戻ります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn rotl <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.rotl
    #if[target=llvm]
    #llvmir:
        declare i32 @llvm.fshl.i32(i32, i32, i32)
        define i32 @rotl(i32 %a, i32 %b) {
        entry:
            %0 = call i32 @llvm.fshl.i32(i32 %a, i32 %a, i32 %b)
            ret i32 %0
        }

//: rotr: i32 の右ローテート
//:
//: [目的/もくてき]:
//: - i32 のビット列を右方向に循環回転します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.rotr`、llvm は `llvm.fshr.i32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - ローテートはシフトと異なり、あふれたビットが反対側に戻ります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn rotr <(i32,i32)->i32> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.rotr
    #if[target=llvm]
    #llvmir:
        declare i32 @llvm.fshr.i32(i32, i32, i32)
        define i32 @rotr(i32 %a, i32 %b) {
        entry:
            %0 = call i32 @llvm.fshr.i32(i32 %a, i32 %a, i32 %b)
            ret i32 %0
        }

//: clz: 先頭ゼロビット数を数える
//:
//: [目的/もくてき]:
//: - i32 の上位側に連続する 0 ビット数を返します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.clz`、llvm は `llvm.ctlz.i32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - 入力が 0 の場合も実行系の規約に沿って定義されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main <()*>()> ():
//:     assert_eq_i32 31 clz 1;
//:     assert_eq_i32 3 ctz 8;
//:     assert_eq_i32 4 popcnt 15;
//: ```
fn clz <(i32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.clz
    #if[target=llvm]
    #llvmir:
        declare i32 @llvm.ctlz.i32(i32, i1)
        define i32 @clz(i32 %a) {
        entry:
            %0 = call i32 @llvm.ctlz.i32(i32 %a, i1 0)
            ret i32 %0
        }

//: ctz: 末尾ゼロビット数を数える
//:
//: [目的/もくてき]:
//: - i32 の下位側に連続する 0 ビット数を返します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.ctz`、llvm は `llvm.cttz.i32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - 入力が 0 の場合も実行系の規約に沿って定義されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn ctz <(i32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.ctz
    #if[target=llvm]
    #llvmir:
        declare i32 @llvm.cttz.i32(i32, i1)
        define i32 @ctz(i32 %a) {
        entry:
            %0 = call i32 @llvm.cttz.i32(i32 %a, i1 0)
            ret i32 %0
        }

//: popcnt: 1 ビットの個数を数える
//:
//: [目的/もくてき]:
//: - i32 のビット列に含まれる 1 の個数を返します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.popcnt`、llvm は `llvm.ctpop.i32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - 値の符号には依存しません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn popcnt <(i32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.popcnt
    #if[target=llvm]
    #llvmir:
        declare i32 @llvm.ctpop.i32(i32)
        define i32 @popcnt(i32 %a) {
        entry:
            %0 = call i32 @llvm.ctpop.i32(i32 %a)
            ret i32 %0
        }
