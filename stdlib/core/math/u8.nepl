//: # math/u8
//: u8 の算術・比較演算を再 export する core math facade
//:
//: [目的/もくてき]:
//: - u8 基本演算を算術と比較の submodule に分け、巨大な型別 module に戻らない責務境界を作ります。
//: - 既存利用者は `core/math` または `core/math/u8` から同じ overload を利用できます。
//:
//: [注意/ちゅうい]:
//: - 実装本体は `u8/arith` と `u8/compare` が所有します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/cast" as *
//:| #import "core/math/u8" as *
//: fn main <()->i32> ():
//:     let a <u8> cast 255;
//:     let b <u8> cast 1;
//:     let wrapped <u8> add a b;
//:     let twenty <u8> cast 20;
//:     let two_hundred <u8> cast 200;
//:     let ten <u8> div_u two_hundred twenty;
//:     if:
//:         eq wrapped <u8> cast 0
//:         then:
//:             if eq ten <u8> cast 10 0 1
//:         else:
//:             1
//: ```

#indent 4

pub #import "./u8/arith" as @merge
pub #import "./u8/compare" as @merge
