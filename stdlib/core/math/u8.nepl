//: # math/u8
//: u8 の算術・比較演算を提供する core math submodule
//:
//: [目的/もくてき]:
//: - `core/math` の u8 演算群を型別 module として分離し、巨大な facade に実装責務が戻らないようにします。
//: - 既存利用者は `core/math` facade から同じ overload を利用でき、u8 専用の利用者はこの module を直接 import できます。
//:
//: [注意/ちゅうい]:
//: - u8 は wasm 上では i32 value として運ばれるため、加減乗算は下位 8-bit を残すように mask します。
//: - 除算と剰余の 0 除算は wasm / llvm の trap です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/cast" as *
//:| #import "core/math/u8" as *
//: fn main <()->i32> ():
//:     let a <u8> cast 255;
//:     let b <u8> cast 1;
//:     let wrapped <u8> add a b;
//:     let twenty <u8> cast 20;
//:     let two_hundred <u8> cast 200;
//:     let ten <u8> div_u two_hundred twenty;
//:     if:
//:         eq wrapped <u8> cast 0
//:         then:
//:             if eq ten <u8> cast 10 0 1
//:         else:
//:             1
//: ```

#indent 4

//: add_u8: u8 の加算（mod 2^8）
//:
//: [目的/もくてき]:
//: - u8 と u8 を加算します。
//:
//: [実装/じっそう]:
//: - i32 演算で加算した後、`0xff` でマスクして下位 8-bit を残します。
//:
//: [注意/ちゅうい]:
//: - オーバーフロー時は 8-bit でラップします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn add_u8 <(u8,u8)->u8> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.add
        i32.const 255
        i32.and
    #if[target=llvm]
    #llvmir:
        define i32 @add_u8(i32 %a, i32 %b) {
        entry:
            %sum = add i32 %a, %b
            %0 = and i32 %sum, 255
            ret i32 %0
        }

//: sub_u8: u8 の減算（mod 2^8）
//:
//: [目的/もくてき]:
//: - u8 から u8 を減算します。
//:
//: [実装/じっそう]:
//: - i32 演算で減算した後、`0xff` でマスクして下位 8-bit を残します。
//:
//: [注意/ちゅうい]:
//: - 負の結果は 8-bit でラップします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sub_u8 <(u8,u8)->u8> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.sub
        i32.const 255
        i32.and
    #if[target=llvm]
    #llvmir:
        define i32 @sub_u8(i32 %a, i32 %b) {
        entry:
            %dif = sub i32 %a, %b
            %0 = and i32 %dif, 255
            ret i32 %0
        }

//: mul_u8: u8 の乗算（mod 2^8）
//:
//: [目的/もくてき]:
//: - u8 と u8 の積を計算します。
//:
//: [実装/じっそう]:
//: - i32 演算で乗算した後、`0xff` でマスクして下位 8-bit を残します。
//:
//: [注意/ちゅうい]:
//: - 大きな積は 8-bit でラップします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn mul_u8 <(u8,u8)->u8> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.mul
        i32.const 255
        i32.and
    #if[target=llvm]
    #llvmir:
        define i32 @mul_u8(i32 %a, i32 %b) {
        entry:
            %prd = mul i32 %a, %b
            %0 = and i32 %prd, 255
            ret i32 %0
        }

//: div_u_u8: u8 の符号なし除算
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として除算します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.div_u`、llvm は `udiv i32` を使います。
//:
//: [注意/ちゅうい]:
//: - 0 除算は trap になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn div_u_u8 <(u8,u8)->u8> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.div_u
    #if[target=llvm]
    #llvmir:
        define i32 @div_u_u8(i32 %a, i32 %b) {
        entry:
            %0 = udiv i32 %a, %b
            ret i32 %0
        }

//: rem_u_u8: u8 の符号なし剰余
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として剰余を計算します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.rem_u`、llvm は `urem i32` を使います。
//:
//: [注意/ちゅうい]:
//: - 0 除算は trap になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn rem_u_u8 <(u8,u8)->u8> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.rem_u
    #if[target=llvm]
    #llvmir:
        define i32 @rem_u_u8(i32 %a, i32 %b) {
        entry:
            %0 = urem i32 %a, %b
            ret i32 %0
        }

//: eq_u8: u8 の等値比較
//:
//: [目的/もくてき]:
//: - u8 の `a == b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.eq`、llvm は `icmp eq` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn eq_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.eq
    #if[target=llvm]
    #llvmir:
        define i32 @eq_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp eq i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: ne_u8: u8 の非等値比較
//:
//: [目的/もくてき]:
//: - u8 の `a != b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.ne`、llvm は `icmp ne` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn ne_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.ne
    #if[target=llvm]
    #llvmir:
        define i32 @ne_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp ne i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: lt_u_u8: u8 の符号なし小なり比較
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として `a < b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.lt_u`、llvm は `icmp ult` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn lt_u_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.lt_u
    #if[target=llvm]
    #llvmir:
        define i32 @lt_u_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp ult i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: le_u_u8: u8 の符号なし以下比較
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として `a <= b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.le_u`、llvm は `icmp ule` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn le_u_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.le_u
    #if[target=llvm]
    #llvmir:
        define i32 @le_u_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp ule i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: gt_u_u8: u8 の符号なし大なり比較
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として `a > b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.gt_u`、llvm は `icmp ugt` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn gt_u_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.gt_u
    #if[target=llvm]
    #llvmir:
        define i32 @gt_u_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp ugt i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: ge_u_u8: u8 の符号なし以上比較
//:
//: [目的/もくてき]:
//: - u8 を符号なし整数として `a >= b` を判定します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.ge_u`、llvm は `icmp uge` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は bool（0/1）です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn ge_u_u8 <(u8,u8)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i32.ge_u
    #if[target=llvm]
    #llvmir:
        define i32 @ge_u_u8(i32 %a, i32 %b) {
        entry:
            %cmp = icmp uge i32 %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: add: u8 の加算（mod 2^8）
fn add <(u8,u8)->u8> (a,b):
    add_u8 a b

//: sub: u8 の減算（mod 2^8）
fn sub <(u8,u8)->u8> (a,b):
    sub_u8 a b

//: mul: u8 の乗算（mod 2^8）
fn mul <(u8,u8)->u8> (a,b):
    mul_u8 a b

//: div_u: u8 の符号なし除算
fn div_u <(u8,u8)->u8> (a,b):
    div_u_u8 a b

//: rem_u: u8 の符号なし剰余
fn rem_u <(u8,u8)->u8> (a,b):
    rem_u_u8 a b

//: eq: u8 の等値比較
fn eq <(u8,u8)->bool> (a,b):
    eq_u8 a b

//: ne: u8 の非等値比較
fn ne <(u8,u8)->bool> (a,b):
    ne_u8 a b

//: lt_u: u8 の符号なし小なり比較
fn lt_u <(u8,u8)->bool> (a,b):
    lt_u_u8 a b

//: le_u: u8 の符号なし以下比較
fn le_u <(u8,u8)->bool> (a,b):
    le_u_u8 a b

//: gt_u: u8 の符号なし大なり比較
fn gt_u <(u8,u8)->bool> (a,b):
    gt_u_u8 a b

//: ge_u: u8 の符号なし以上比較
fn ge_u <(u8,u8)->bool> (a,b):
    ge_u_u8 a b
