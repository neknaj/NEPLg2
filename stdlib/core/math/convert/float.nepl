//:
//: [注意/ちゅうい]:
//: - 大きな値では下位ビットが丸められます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn convert_u_i64_to_f64 <(i64)->f64> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        f64.convert_i64_u
    #if[target=llvm]
    #llvmir:
        define double @convert_u_i64_to_f64(i64 %a) {
        entry:
            %0 = uitofp i64 %a to double
            ret double %0
        }

