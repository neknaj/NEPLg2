//: # math/convert/float
//: 整数と浮動小数点数の変換を提供する core math conversion submodule
//:
//: [目的/もくてき]:
//: - i32/i64 と f32/f64 の相互変換、f32/f64 間の拡張・縮小変換を提供します。
//:
//: [注意/ちゅうい]:
//: - 非飽和 `trunc_*` は NaN や範囲外値で基盤命令の失敗条件に従います。検査済み変換が必要な場合は呼び出し側で値域を制限してください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/math/convert/float" as *
//: fn main <()->i32> ():
//:     trunc_s_f64_to_i32 convert_s_i32_to_f64 7
//: ```

#indent 4
//: convert_s_i32_to_f32: i32(符号付き) を f32 へ変換
//:
//: [目的/もくてき]:
//: - 符号付き i32 を f32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `f32.convert_i32_s`、llvm は `sitofp i32 to float` を使います。
//:
//: [注意/ちゅうい]:
//: - 大きい整数は f32 で正確に表現できない場合があります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn convert_s_i32_to_f32 <(i32)->f32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        f32.convert_i32_s
    #if[target=llvm]
    #llvmir:
        define float @convert_s_i32_to_f32(i32 %a) {
        entry:
            %0 = sitofp i32 %a to float
            ret float %0
        }

//: convert_u_i32_to_f32: i32(符号なし) を f32 へ変換
//:
//: [目的/もくてき]:
//: - 符号なし i32 を f32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `f32.convert_i32_u`、llvm は `uitofp i32 to float` を使います。
//:
//: [注意/ちゅうい]:
//: - 符号付き値としては負に見えるビット列も、大きな正数として解釈されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn convert_u_i32_to_f32 <(i32)->f32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        f32.convert_i32_u
    #if[target=llvm]
    #llvmir:
        define float @convert_u_i32_to_f32(i32 %a) {
        entry:
            %0 = uitofp i32 %a to float
            ret float %0
        }

//: convert_s_i64_to_f32: i64(符号付き) を f32 へ変換
//:
//: [目的/もくてき]:
//: - 符号付き i64 を f32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `f32.convert_i64_s`、llvm は `sitofp i64 to float` を使います。
//:
//: [注意/ちゅうい]:
//: - 表現可能桁数を超える場合は丸めが発生します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn convert_s_i64_to_f32 <(i64)->f32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        f32.convert_i64_s
    #if[target=llvm]
    #llvmir:
        define float @convert_s_i64_to_f32(i64 %a) {
        entry:
            %0 = sitofp i64 %a to float
            ret float %0
        }

//: convert_u_i64_to_f32: i64(符号なし) を f32 へ変換
//:
//: [目的/もくてき]:
//: - 符号なし i64 を f32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `f32.convert_i64_u`、llvm は `uitofp i64 to float` を使います。
//:
//: [注意/ちゅうい]:
//: - 非常に大きな値では丸め誤差が大きくなることがあります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn convert_u_i64_to_f32 <(i64)->f32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        f32.convert_i64_u
    #if[target=llvm]
    #llvmir:
        define float @convert_u_i64_to_f32(i64 %a) {
        entry:
            %0 = uitofp i64 %a to float
            ret float %0
        }

//: trunc_s_f32_to_i32: f32 を i32(符号付き)へ切り捨て変換
//:
//: [目的/もくてき]:
//: - f32 を 0 方向へ切り捨てて符号付き i32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.trunc_f32_s`、llvm は `fptosi float to i32` を使います。
//:
//: [注意/ちゅうい]:
//: - NaN や範囲外値は trap（未定義変換）になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trunc_s_f32_to_i32 <(f32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.trunc_f32_s
    #if[target=llvm]
    #llvmir:
        define i32 @trunc_s_f32_to_i32(float %a) {
        entry:
            %0 = fptosi float %a to i32
            ret i32 %0
        }

//: trunc_u_f32_to_i32: f32 を i32(符号なし)へ切り捨て変換
//:
//: [目的/もくてき]:
//: - f32 を 0 方向へ切り捨てて符号なし i32 に変換します。
//:
//: [実装/じっそう]:
//: - wasm は `i32.trunc_f32_u`、llvm は `fptoui float to i32` を使います。
//:
//: [注意/ちゅうい]:
//: - NaN や範囲外値は trap（未定義変換）になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trunc_u_f32_to_i32 <(f32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.trunc_f32_u
    #if[target=llvm]
    #llvmir:
        define i32 @trunc_u_f32_to_i32(float %a) {
        entry:
            %0 = fptoui float %a to i32
            ret i32 %0
        }

//: trunc_sat_s_f32_to_i32: f32 を i32(符号付き)へ飽和変換
//:
//: [目的/もくてき]:
//: - f32 を i32 に変換し、範囲外は最小値/最大値に丸めます。
//:
//: [実装/じっそう]:
//: - wasm は `i32.trunc_sat_f32_s` を使います。
//: - llvm は `llvm.fptosi.sat.i32.f32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - NaN は 0 になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trunc_sat_s_f32_to_i32 <(f32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.trunc_sat_f32_s
    #if[target=llvm]
    #llvmir:
        define i32 @trunc_sat_s_f32_to_i32(float %a) {
        entry:
            %0 = call i32 @llvm.fptosi.sat.i32.f32(float %a)
            ret i32 %0
        }

//: trunc_sat_u_f32_to_i32: f32 を i32(符号なし)へ飽和変換
//:
//: [目的/もくてき]:
//: - f32 を i32 に変換し、範囲外は 0 か最大値に丸めます。
//:
//: [実装/じっそう]:
//: - wasm は `i32.trunc_sat_f32_u` を使います。
//: - llvm は `llvm.fptoui.sat.i32.f32` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - NaN は 0 になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trunc_sat_u_f32_to_i32 <(f32)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.trunc_sat_f32_u
    #if[target=llvm]
    #llvmir:
        define i32 @trunc_sat_u_f32_to_i32(float %a) {
        entry:
            %0 = call i32 @llvm.fptoui.sat.i32.f32(float %a)
            ret i32 %0
        }

