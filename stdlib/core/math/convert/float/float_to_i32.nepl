            ret i32 %0
        }

//: trunc_sat_s_f64_to_i32: f64 を i32(符号付き)へ飽和変換
//:
//: [目的/もくてき]:
//: - f64 を i32 に変換し、範囲外は最小値/最大値へ丸めます。
//:
//: [実装/じっそう]:
//: - wasm は `i32.trunc_sat_f64_s` を使います。
//: - llvm は `llvm.fptosi.sat.i32.f64` intrinsic を使います。
//:
//: [注意/ちゅうい]:
//: - NaN は 0 になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trunc_sat_s_f64_to_i32 <(f64)->i32> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i32.trunc_sat_f64_s
    #if[target=llvm]
    #llvmir:
        define i32 @trunc_sat_s_f64_to_i32(double %a) {
        entry:
            %0 = call i32 @llvm.fptosi.sat.i32.f64(double %a)
            ret i32 %0
        }

