//: # math/i64/arith
//: i64 の算術演算を提供する submodule
//:
//: [目的/もくてき]:
//: - i64 の加算・減算・乗算・除算・剰余を、bitwise や比較から分けて管理します。
//: - `core/math/i64` facade から再 export されるため、通常利用では既存の import path を変えずに使えます。
//:
//: [注意/ちゅうい]:
//: - 演算は wasm i64 の wrap / signed / unsigned 規則に従います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math/i64/arith" as *
//:| #import "core/math/i64/compare" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 40;
//:     let b %i64 cast 2;
//:     assert eq add a b %i64 cast 42;
//: ```

#indent 4

//: add: i64 の加算（mod 2^64）
//:
//: [目的/もくてき]:
//: - i64 と i64 を加算します。
//:
//: [実装/じっそう]:
//: - wasm は `i64.add`、llvm は `add i64` を使います。
//:
//: [注意/ちゅうい]:
//: - オーバーフロー時は下位 64-bit が残ります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 40;
//:     let b %i64 cast 2;
//:     let r0 %i64 add a b;
//:     assert eq r0 %i64 cast 42;
//:     let a %i64 cast 0;
//:     let b %i64 cast 7;
//:     let r1 %i64 add a b;
//:     assert eq r1 b;
//: ```
pub fn add %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.add
    #if[target=llvm]
    #llvmir:
        define i64 @add(i64 %a, i64 %b) {
        entry:
            %0 = add i64 %a, %b
            ret i64 %0
        }

//: sub: i64 の減算（mod 2^64）
//:
//: [目的/もくてき]:
//: - i64 から i64 を減算します。
//:
//: [実装/じっそう]:
//: - wasm は `i64.sub`、llvm は `sub i64` を使います。
//:
//: [注意/ちゅうい]:
//: - 結果は 64-bit 符号付き値として解釈されますが、演算自体は 64-bit ラップです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 44;
//:     let b %i64 cast 2;
//:     let r0 %i64 sub a b;
//:     assert eq r0 %i64 cast 42;
//:     let z %i64 cast 0;
//:     let one %i64 cast 1;
//:     let r1 %i64 sub z one;
//:     assert lt r1 z;
//: ```
pub fn sub %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.sub
    #if[target=llvm]
    #llvmir:
        define i64 @sub(i64 %a, i64 %b) {
        entry:
            %0 = sub i64 %a, %b
            ret i64 %0
        }

//: mul: i64 の乗算（mod 2^64）
//:
//: [目的/もくてき]:
//: - i64 と i64 を乗算します。
//:
//: [実装/じっそう]:
//: - wasm は `i64.mul`、llvm は `mul i64` を使います。
//:
//: [注意/ちゅうい]:
//: - 乗算結果が 64-bit を超える場合はラップします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 6;
//:     let b %i64 cast 7;
//:     let r0 %i64 mul a b;
//:     assert eq r0 %i64 cast 42;
//:     let z %i64 cast 0;
//:     let n %i64 cast 999;
//:     let r1 %i64 mul z n;
//:     assert eq r1 z;
//: ```
pub fn mul %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.mul
    #if[target=llvm]
    #llvmir:
        define i64 @mul(i64 %a, i64 %b) {
        entry:
            %0 = mul i64 %a, %b
            ret i64 %0
        }

//: div_s: i64 の符号付き除算
//:
//: [目的/もくてき]:
//: - i64 を符号付き整数として割り算します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.div_s` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 0 除算は trap します。
//: - 最小値 `-2^63` を `-1` で割るケースも trap します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let n9 %i64 cast -9;
//:     let p9 %i64 cast 9;
//:     let p3 %i64 cast 3;
//:     let n3 %i64 cast -3;
//:     let p %i64 div_s n9 p3;
//:     let q %i64 div_s p9 n3;
//:     assert eq p %i64 cast -3;
//:     assert eq q %i64 cast -3;
//: ```
pub fn div_s %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.div_s
    #if[target=llvm]
    #llvmir:
        define i64 @div_s(i64 %a, i64 %b) {
        entry:
            %0 = sdiv i64 %a, %b
            ret i64 %0
        }

//: div_u: i64 の符号なし除算
//:
//: [目的/もくてき]:
//: - i64 を符号なし整数として割り算します。
//:
//: [実装/じっそう]:
//: - wasm は `i64.div_u`、llvm は `udiv i64` を使います。
//:
//: [注意/ちゅうい]:
//: - 0 除算は trap します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 100;
//:     let b %i64 cast 9;
//:     let r0 %i64 div_u a b;
//:     assert eq r0 %i64 cast 11;
//:     let a %i64 cast 9;
//:     let b %i64 cast 10;
//:     let r1 %i64 div_u a b;
//:     assert eq r1 %i64 cast 0;
//: ```
pub fn div_u %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.div_u
    #if[target=llvm]
    #llvmir:
        define i64 @div_u(i64 %a, i64 %b) {
        entry:
            %0 = udiv i64 %a, %b
            ret i64 %0
        }

//: rem_s: i64 の符号付き剰余
//:
//: [目的/もくてき]:
//: - i64 の符号付き剰余（余り）を計算します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.rem_s` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 余りの符号は被除数（左辺）に従います。
//: - 0 除算は trap します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let n10 %i64 cast -10;
//:     let p10 %i64 cast 10;
//:     let p3 %i64 cast 3;
//:     let a %i64 rem_s n10 p3;
//:     let b %i64 rem_s p10 p3;
//:     assert eq a %i64 cast -1;
//:     assert eq b %i64 cast 1;
//: ```
pub fn rem_s %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.rem_s
    #if[target=llvm]
    #llvmir:
        define i64 @rem_s(i64 %a, i64 %b) {
        entry:
            %0 = srem i64 %a, %b
            ret i64 %0
        }

//: rem_u: i64 の符号なし剰余
//:
//: [目的/もくてき]:
//: - i64 の符号なし剰余を計算します。
//:
//: [実装/じっそう]:
//: - wasm は `i64.rem_u`、llvm は `urem i64` を使います。
//:
//: [注意/ちゅうい]:
//: - 戻り値は 0 以上かつ除数未満です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main %impure fn () () \():
//:     let a %i64 cast 100;
//:     let b %i64 cast 9;
//:     let r0 %i64 rem_u a b;
//:     assert eq r0 %i64 cast 1;
//:     let a %i64 cast 9;
//:     let b %i64 cast 10;
//:     let r1 %i64 rem_u a b;
//:     assert eq r1 a;
//: ```
pub fn rem_u %fn i64 fn i64 i64 \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.rem_u
    #if[target=llvm]
    #llvmir:
        define i64 @rem_u(i64 %a, i64 %b) {
        entry:
            %0 = urem i64 %a, %b
            ret i64 %0
        }
