//: # math/i64/bitwise
//: i64 の bitwise 演算と bit count 演算を提供する submodule
//:
//: [目的/もくてき]:
//: - i64 の AND / OR / XOR、shift / rotate、bit count 系 intrinsic を算術・比較から分けて管理します。
//: - `core/math/i64` facade から再 export されるため、通常利用では既存の import path を変えずに使えます。
//:
//: [注意/ちゅうい]:
//: - 入力は i64 のビット列として扱い、符号付き値かどうかは演算ごとの規則に従います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math/i64/bitwise" as *
//:| #import "core/math/i64/compare" as *
//: fn main <()*>()> ():
//:     let a <i64> cast 6;
//:     let b <i64> cast 3;
//:     assert eq or a b <i64> cast 7;
//: ```

#indent 4

//: and: i64 のビット AND
//:
//: [目的/もくてき]:
//: - 2つの i64 の各ビットに AND を適用します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.and` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 演算は整数の符号とは無関係にビット単位で行われます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/test" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//: fn main <()*>()> ():
//:     let a <i64> cast 14;
//:     let b <i64> cast 11;
//:     let r_and <i64> and a b;
//:     let r_or <i64> or a b;
//:     let r_xor <i64> xor a b;
//:     assert eq r_and <i64> cast 10;
//:     assert eq r_or <i64> cast 15;
//:     assert eq r_xor <i64> cast 5;
//: ```
fn and <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.and
    #if[target=llvm]
    #llvmir:
        define i64 @and(i64 %a, i64 %b) {
        entry:
            %0 = and i64 %a, %b
            ret i64 %0
        }

//: or: i64 のビット OR
//:
//: [目的/もくてき]:
//: - 2つの i64 の各ビットに OR を適用します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.or` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 真理値 OR ではなく、ビット論理和です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn or <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.or
    #if[target=llvm]
    #llvmir:
        define i64 @or(i64 %a, i64 %b) {
        entry:
            %0 = or i64 %a, %b
            ret i64 %0
        }

//: xor: i64 のビット XOR
//:
//: [目的/もくてき]:
//: - 2つの i64 の各ビットに XOR を適用します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.xor` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 異なるビットのみ 1 になる排他的論理和です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn xor <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.xor
    #if[target=llvm]
    #llvmir:
        define i64 @xor(i64 %a, i64 %b) {
        entry:
            %0 = xor i64 %a, %b
            ret i64 %0
        }

//: shl: i64 の左シフト
//:
//: [目的/もくてき]:
//: - i64 のビット列を左へシフトします。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.shl` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - シフト量は Wasm 仕様に従い下位 6 bit が使われます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shl <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.shl
    #if[target=llvm]
    #llvmir:
        define i64 @shl(i64 %a, i64 %b) {
        entry:
            %0 = shl i64 %a, %b
            ret i64 %0
        }

//: shr_s: i64 の算術右シフト
//:
//: [目的/もくてき]:
//: - i64 を符号付き整数として右へシフトします。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.shr_s` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 最上位ビット（符号ビット）が埋め戻されます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shr_s <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.shr_s
    #if[target=llvm]
    #llvmir:
        define i64 @shr_s(i64 %a, i64 %b) {
        entry:
            %0 = ashr i64 %a, %b
            ret i64 %0
        }

//: shr_u: i64 の論理右シフト
//:
//: [目的/もくてき]:
//: - i64 を符号なし整数として右へシフトします。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.shr_u` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 上位ビットは 0 で埋められます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn shr_u <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.shr_u
    #if[target=llvm]
    #llvmir:
        define i64 @shr_u(i64 %a, i64 %b) {
        entry:
            %0 = lshr i64 %a, %b
            ret i64 %0
        }

//: rotl: i64 の左ローテート
//:
//: [目的/もくてき]:
//: - i64 のビット列を左へ循環シフトします。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.rotl` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - シフトで失われるビットは下位側へ回り込みます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn rotl <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.rotl
    #if[target=llvm]
    #llvmir:
        declare i64 @llvm.fshl.i64(i64, i64, i64)
        define i64 @rotl(i64 %a, i64 %b) {
        entry:
            %0 = call i64 @llvm.fshl.i64(i64 %a, i64 %a, i64 %b)
            ret i64 %0
        }

//: rotr: i64 の右ローテート
//:
//: [目的/もくてき]:
//: - i64 のビット列を右へ循環シフトします。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.rotr` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - シフトで失われるビットは上位側へ回り込みます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn rotr <(i64,i64)->i64> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        i64.rotr
    #if[target=llvm]
    #llvmir:
        declare i64 @llvm.fshr.i64(i64, i64, i64)
        define i64 @rotr(i64 %a, i64 %b) {
        entry:
            %0 = call i64 @llvm.fshr.i64(i64 %a, i64 %a, i64 %b)
            ret i64 %0
        }

//: clz: 先頭ゼロビット数の計算
//:
//: [目的/もくてき]:
//: - i64 の先頭側に連続する 0 bit の個数を返します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.clz` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 入力が 0 のときは 64 を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn clz <(i64)->i64> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i64.clz
    #if[target=llvm]
    #llvmir:
        declare i64 @llvm.ctlz.i64(i64, i1)
        define i64 @clz(i64 %a) {
        entry:
            %0 = call i64 @llvm.ctlz.i64(i64 %a, i1 false)
            ret i64 %0
        }

//: ctz: 末尾ゼロビット数の計算
//:
//: [目的/もくてき]:
//: - i64 の末尾側に連続する 0 bit の個数を返します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.ctz` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - 入力が 0 のときは 64 を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn ctz <(i64)->i64> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i64.ctz
    #if[target=llvm]
    #llvmir:
        declare i64 @llvm.cttz.i64(i64, i1)
        define i64 @ctz(i64 %a) {
        entry:
            %0 = call i64 @llvm.cttz.i64(i64 %a, i1 false)
            ret i64 %0
        }

//: popcnt: 1 ビット数の計算
//:
//: [目的/もくてき]:
//: - i64 に立っている 1 bit の個数を返します。
//:
//: [実装/じっそう]:
//: - wasm 命令 `i64.popcnt` を直接実行します。
//:
//: [注意/ちゅうい]:
//: - ハミング重み（population count）として利用できます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn popcnt <(i64)->i64> (a):
    #if[target=wasm]
    #wasm:
        local.get $a
        i64.popcnt
    #if[target=llvm]
    #llvmir:
        declare i64 @llvm.ctpop.i64(i64)
        define i64 @popcnt(i64 %a) {
        entry:
            %0 = call i64 @llvm.ctpop.i64(i64 %a)
            ret i64 %0
        }
