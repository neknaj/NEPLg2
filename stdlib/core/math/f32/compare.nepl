//: [計算量/けいさんりょう]:
//: - O(1)
pub fn le %fn f32 fn f32 bool \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        f32.le
    #if[target=llvm]
    #llvmir:
        define i32 @le(float %a, float %b) {
        entry:
            %cmp = fcmp ole float %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

