pub fn ge %fn f32 fn f32 bool \a\b:
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        f32.ge
    #if[target=llvm]
    #llvmir:
        define i32 @ge(float %a, float %b) {
        entry:
            %cmp = fcmp oge float %a, %b
            %0 = zext i1 %cmp to i32
