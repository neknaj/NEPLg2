//: [計算量/けいさんりょう]:
//: - O(1)
fn gt <(f64,f64)->bool> (a,b):
    #if[target=wasm]
    #wasm:
        local.get $a
        local.get $b
        f64.gt
    #if[target=llvm]
    #llvmir:
