    #if[target=llvm]
    #llvmir:
        define i32 @le(double %a, double %b) {
        entry:
            %cmp = fcmp ole double %a, %b
            %0 = zext i1 %cmp to i32
            ret i32 %0
        }

//: gt: f64 の大なり比較
