#indent 4

#import "core/mem" as *
#import "core/traits/copy" as *

//: # option
//: [値/あたい]の[有無/うむ]を[表/あらわ]す[基本型/きほんがた]と helper
//:
//: ### [目的/もくてき]
//: - [存在/そんざい]する[値/あたい] (`Some`) と[不在/ふざい] (`None`) を[明示的/めいじてき]に[扱/あつか]う `Option` と[基本操作/きほんそうさ]を[提供/ていきょう]します。
//: - reboot [後/ご]の stdlib で「[単純/たんじゅん]な[欠如/けつじょ]は `Option`、[失敗理由/しっぱいりゆう]つきは `Result`」という[責務分離/せきむぶんり]を[支/ささ]える[最小基盤/さいしょうきばん]です。
//:
//: ### [注意/ちゅうい]
//: - `unwrap` は[便宜上/べんぎじょう][残/のこ]している unsafe helper であり、[通常/つうじょう]は `match` や `unwrap_or` を[優先/ゆうせん]してください。
//: - doctest では trap [依存/いぞん]の `should_panic` を[使/つか]わず、[安全/あんぜん]な[分岐/ぶんき]を `std/test` report と `exit_code:` で[確認/かくにん]します。
//:
//: ### [計算量/けいさんりょう]
//: - [基本操作/きほんそうさ]はすべて O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"core_option_basic\" count=4 failed=0\nassertion index=0 status=ok kind=bool label=\"some is present\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"none is absent\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"unwrap some\" expected=\"123\" actual=\"123\" message=\"\"\nassertion index=3 status=ok kind=eq_i32 label=\"unwrap_or none\" expected=\"7\" actual=\"7\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/option" as *
//: fn main %impure fn unit i32 \unit:
//:     let empty %Option i32 none;
//:     let report:
//:         test_report_new "core_option_basic"
//:         |> test_report_push assert "some is present" is_some some 123
//:         |> test_report_push assert "none is absent" is_none empty
//:         |> test_report_push assert_eq_i32 "unwrap some" 123 unwrap some 123
//:         |> test_report_push assert_eq_i32 "unwrap_or none" 7 unwrap_or empty 7
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"core_option_map\" count=3 failed=0\nassertion index=0 status=ok kind=bool label=\"some map result\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"none map result\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"mapped value\" expected=\"10\" actual=\"10\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/option" as *
//:| #import "core/math" as *
//: fn inc %fn i32 i32 \x:
//:     add x 1
//:
//: fn main %impure fn unit i32 \unit:
//:     let some0 %Option i32 some 9;
//:     let some1 %Option i32 some 9;
//:     let empty %Option i32 none;
//:     let a0 %Option i32 map some0 inc;
//:     let a1 %Option i32 map some1 inc;
//:     let b %Option i32 map empty inc;
//:     let report:
//:         test_report_new "core_option_map"
//:         |> test_report_push assert "some map result" is_some a0
//:         |> test_report_push assert "none map result" is_none b
//:         |> test_report_push assert_eq_i32 "mapped value" 10 unwrap a1
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"core_option_and_then\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"positive double\" expected=\"6\" actual=\"6\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"negative double none\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/option" as *
//:| #import "core/math" as *
//: fn positive_double %fn i32 Option i32 \x:
//:     if gt x 0:
//:         then some mul x 2
//:         else none
//:
//: fn main %impure fn unit i32 \unit:
//:     let input %Option i32 some 3;
//:     let negative %Option i32 some -1;
//:     let a %Option i32 and_then input positive_double;
//:     let b %Option i32 and_then negative positive_double;
//:     let report:
//:         test_report_new "core_option_and_then"
//:         |> test_report_push assert_eq_i32 "positive double" 6 unwrap a
//:         |> test_report_push assert "negative double none" is_none b
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```



//: Option: 値がある(Some)か無い(None)かを表す
//:
//: 目的:
//: - 失敗・欠損を明示するための共通型です。
//:
//: 実装(アルゴリズム):
//: - enum の 2 変種で表現します。
//:
//: 注意(重要):
//: - Some は payload を保持します。
//:
//: 計算量:
//: - O(1)
pub enum Option<.T>:
    None
    Some %.T

//: Option<Copy>: payload が Copy なら Option も Copy として扱う
//:
//: 目的:
//: - `Option i32` や `Option str` のような軽量値を shared reference から安全に読み取れるようにします。
//:
//: 注意:
//: - `.T` が Copy でない場合は shallow copy を避けるため、この impl は使えません。
impl<.T: Copy> Clone for Option<.T>:
    fn clone %fn &Option .T Option .T \x:
        *x

impl<.T: Copy> Copy for Option<.T>:
    fn copy_mark %fn Option .T Option .T \x:
        x

//: none: None を作る
//:
//: 目的:
//: - 値が無いことを表す Option を返します。
//:
//: 実装(アルゴリズム):
//: - Option::None を返すだけです。
//:
//: 注意(重要):
//: - 型引数 .T は文脈で決まります。
//:
//: 計算量:
//: - O(1)
pub fn none <.T> %fn unit Option .T \unit:
    Option::None

//: some: 値を包んで返す
//:
//: 目的:
//: - v を Some に包んで返します。
//:
//: 実装(アルゴリズム):
//: - Option::Some を構築します。
//:
//: 注意(重要):
//: - v の型が .T になります。
//:
//: 計算量:
//: - O(1)
pub fn some <.T> %fn .T Option .T \v:
    Option::Some v

//: is_some: 値があるか判定する
//:
//: 目的:
//: - Some なら true、None なら false を返します。
//:
//: 実装(アルゴリズム):
//: - match で Some/None を分岐します。
//:
//: 注意(重要):
//: - 値そのものは取り出しません。
//:
//: 計算量:
//: - O(1)
pub fn is_some <.T> %fn Option .T bool \o:
    match o:
        Option::Some v:
            true
        Option::None:
            false

//: is_none: 値が無いか判定する
//:
//: 目的:
//: - None なら true、Some なら false を返します。
//:
//: 実装(アルゴリズム):
//: - match で Some/None を分岐します。
//:
//: 注意(重要):
//: - is_some の否定です。
//:
//: 計算量:
//: - O(1)
pub fn is_none <.T> %fn Option .T bool \o:
    match o:
        Option::Some v:
            false
        Option::None:
            true

//: unwrap: Some の中身を取り出す（None は到達不能）
//:
//: 目的:
//: - Some(v) なら v を返します。
//:
//: 実装(アルゴリズム):
//: - match で分岐し、None は unreachable を呼びます。
//:
//: 注意(重要):
//: - None の可能性がある場合は is_some や unwrap_or を使ってください。
//:
//: 計算量:
//: - O(1)
pub fn unwrap <.T> %fn Option .T .T \o:
    match o:
        Option::Some v:
            v
        Option::None:
            #intrinsic "unreachable" <> ()

//: unwrap_or: デフォルト値を返す
//:
//: 目的:
//: - Some(v) なら v、None なら default を返します。
//:
//: 実装(アルゴリズム):
//: - match で分岐します。
//:
//: 注意(重要):
//: - default は eager に評価されます。
//:
//: 計算量:
//: - O(1)
pub fn unwrap_or <.T> %fn Option .T fn .T .T \o\default:
    match o:
        Option::Some v:
            v
        Option::None:
            default

//: map: 値がある時だけ関数を適用する
//:
//: 目的:
//: - Some(v) なら f(v) を Some として返し、None はそのまま返します。
//:
//: 実装(アルゴリズム):
//: - match で Some/None を分岐し、Some のときのみ f を適用します。
//:
//: 注意(重要):
//: - f は純粋関数を想定します。
//:
//: 計算量:
//: - O(1)
pub fn map <.T,.U> %fn Option .T fn fn .T .U Option .U \o\f:
    match o:
        Option::Some v:
            some f v
        Option::None:
            none

//: and_then: 値がある時だけ Option を返す関数へつなぐ
//:
//: 目的:
//: - Some(v) なら f(v) をそのまま返し、None はそのまま返します。
//:
//: 実装(アルゴリズム):
//: - match で Some/None を分岐し、Some のときのみ Option を返す関数を呼びます。
//:
//: 注意(重要):
//: - `map` が `a -> b` を受けるのに対し、`and_then` は `a -> Option<b>` を受けます。
//:
//: 計算量:
//: - O(1)
pub fn and_then <.T,.U> %fn Option .T fn fn .T Option .U Option .U \o\f:
    match o:
        Option::Some v:
            f v
        Option::None:
            none
