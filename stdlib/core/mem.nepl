#indent 4

//: mem: メモリ管理と低レベルロード/ストア
//:
//: 目的:
//: - WASM 線形メモリ上でのアロケータと基本的な load/store を提供します。
//:
//: 実装(アルゴリズム):
//: - free list と bump を併用し、8 バイト境界に整列します。
//: - 0..4 に heap_ptr、4..8 に free_list_head を置きます。
//: - 最初の割り当てブロックは metadata の後ろ、8 バイト目以降から始めます。
//: - free list は address order で管理し、解放時に隣接 block を coalesce します。
//:
//: 注意(重要):
//: - 領域の再利用は first-fit です。隣接 block は結合しますが、best-fit などの細かな最適化は行いません。
//: - 無効なポインタを渡すと未定義動作になります。
//:
//: 計算量:
//: - alloc_raw/free は free list の探索で O(n) になり得ます。
//: - 連続バイト列のコピーには `mem_copy` / `mem_move` を使い、backend の bulk copy 命令へ下げます。
//:
//: ---
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> eq align8 0 0;
//:     let ok1 <bool> eq align8 1 8;
//:     let ok2 <bool> eq align8 8 8;
//:     let ok3 <bool> eq align8 9 16;
//:     let ok01 <bool> and ok0 ok1;
//:     let ok23 <bool> and ok2 ok3;
//:     let ok <bool> and ok01 ok23;
//:     if ok 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let p alloc_raw 4;
//:     let ok0 <bool> ne 0 p;
//:     store_i32 p 123;
//:     let ok1 <bool> eq load_i32 p 123;
//:     dealloc_raw p 4;
//:     if and ok0 ok1 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let p <i32> alloc_raw 4;
//:     let heap <i32> load_i32 0;
//:     let free_head <i32> load_i32 4;
//:     let ok_ptr <bool> ge p 16;
//:     let ok_heap <bool> ge heap 24;
//:     let ok_free <bool> eq free_head 0;
//:     dealloc_raw p 4;
//:     if and ok_ptr and ok_heap ok_free 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let p0 <i32> alloc_raw 64;
//:     dealloc_raw p0 64;
//:     let p1 <i32> alloc_raw 8;
//:     let p2 <i32> alloc_raw 16;
//:     let ok0 <bool> eq p1 p0;
//:     let ok1 <bool> eq p2 add p1 16;
//:     dealloc_raw p2 16;
//:     dealloc_raw p1 8;
//:     if and ok0 ok1 1 0
//: ```



#import "core/math" as *
#import "core/result" as *
#import "core/option" as *

struct MemPtr<.T>:
    raw <i32>

struct RegionToken<.T>:
    ptr <MemPtr<.T>>
    size <i32>

//: region_token_ptr_ref: RegionToken の pointer field を所有権を移動せずに借用する
//:
//: 目的:
//: - `RegionToken` は領域の解放責務を持つため、観察用 API が token を move してはいけません。
//: - compiler intrinsic で field reference を作り、`MemPtr` の copy 値だけを外側に返せるようにします。
fn region_token_ptr_ref <.T> <(&RegionToken<.T>)->&MemPtr<.T>> (token):
    #intrinsic "get_field_ref" <> (token,"ptr")

//: region_token_size_ref: RegionToken の size field を所有権を移動せずに借用する
//:
//: 目的:
//: - bounds check と pointer projection が token owner を消費しないようにします。
fn region_token_size_ref <.T> <(&RegionToken<.T>)->&i32> (token):
    #intrinsic "get_field_ref" <> (token,"size")

fn mem_ptr_wrap <.T> <(i32)->MemPtr<.T>> (raw):
    MemPtr raw

fn mem_ptr_addr <.T> <(MemPtr<.T>)->i32> (p):
    get p "raw"

fn region_ptr <.T> <(&RegionToken<.T>)->MemPtr<.T>> (token):
    *region_token_ptr_ref token

fn region_size <.T> <(&RegionToken<.T>)->i32> (token):
    *region_token_size_ref token

fn region_new <.T> <(MemPtr<.T>,i32)->RegionToken<.T>> (ptr, size):
    RegionToken ptr size

fn region_in_bounds <.T> <(&RegionToken<.T>,i32,i32)->bool> (token, off, bytes):
    let total <i32> *region_token_size_ref token
    if:
        or lt off 0 lt bytes 0
        then:
            false
        else:
            let end <i32> add off bytes
            and le end total ge end off

fn region_ptr_at <.T, .U> <(&RegionToken<.T>,i32)->Result<MemPtr<.U>,str>> (token, off):
    let bytes <i32> size_of<.U>
    let total <i32> *region_token_size_ref token
    if:
        if:
            or lt off 0 lt bytes 0
            then:
                false
            else:
                let end <i32> add off bytes
                and le end total ge end off
        then:
            let base_raw <i32> mem_ptr_addr *region_token_ptr_ref token
            Result<MemPtr<.U>,str>::Ok mem_ptr_wrap add base_raw off
        else:
            Result<MemPtr<.U>,str>::Err "mem.region_ptr_at out of bounds"

fn alloc_region_bytes <.T> <(i32)->Result<RegionToken<.T>,str>> (bytes):
    if:
        lt bytes 0
        then:
            Result<RegionToken<.T>,str>::Err "mem.alloc_region_bytes invalid size"
        else:
            match alloc_ptr<.T> bytes:
                Result::Ok ptr:
                    Result<RegionToken<.T>,str>::Ok region_new ptr bytes
                Result::Err _e:
                    Result<RegionToken<.T>,str>::Err "mem.alloc_region_bytes failed"

fn alloc_region <.T> <(i32)->Result<RegionToken<.T>,str>> (count):
    if:
        lt count 0
        then:
            Result<RegionToken<.T>,str>::Err "mem.alloc_region invalid count"
        else:
            let bytes <i32> mul count size_of<.T>
            alloc_region_bytes<.T> bytes

fn dealloc_region <.T> <(RegionToken<.T>)->Result<(),str>> (token):
    let ptr <MemPtr<.T>> get token "ptr"
    let size <i32> get token "size"
    dealloc_ptr<.T> ptr size

#if[target=llvm]
#llvmir:
    @__nepl_mem = internal global [67108864 x i8] zeroinitializer, align 16
    @__nepl_pages = internal global i32 1, align 4

//: mem_size: 現在のメモリページ数を返す
//:
//: 目的:
//: - wasm の memory.size を返します。
//:
//: 実装(アルゴリズム):
//: - wasm 命令を直接実行します。
//:
//: 注意(重要):
//: - 1 ページ = 64KiB です。
//: - llvm では内部線形メモリの擬似ページ数を返します。
//:
//: 計算量:
//: - O(1)
fn mem_size <()->i32> ():
    #if[target=wasm]
    #wasm:
        memory.size
    #if[target=llvm]
    #llvmir:
        define i32 @mem_size() {
        entry:
            %0 = load i32, ptr @__nepl_pages, align 4
            ret i32 %0
        }

//: mem_grow: メモリを拡張する
//:
//: 目的:
//: - pages だけメモリを拡張し、以前のページ数を返します。
//:
//: 実装(アルゴリズム):
//: - wasm の memory.grow を呼びます。
//:
//: 注意(重要):
//: - 失敗時は -1 を返します。
//: - llvm では擬似線形メモリの総量（64MiB）を超える要求を失敗扱いにします。
//:
//: 計算量:
//: - O(1)
fn mem_grow <(i32)->i32> (pages):
    #if[target=wasm]
    #wasm:
        local.get $pages
        memory.grow
    #if[target=llvm]
    #llvmir:
        define i32 @mem_grow(i32 %pages) {
        entry:
            %neg = icmp slt i32 %pages, 0
            br i1 %neg, label %fail, label %cont
        cont:
            %old = load i32, ptr @__nepl_pages, align 4
            %new = add i32 %old, %pages
            %too_large = icmp sgt i32 %new, 1024
            br i1 %too_large, label %fail, label %ok
        ok:
            store i32 %new, ptr @__nepl_pages, align 4
            ret i32 %old
        fail:
            ret i32 -1
        }

//: align8: 8 バイト境界に切り上げる
//:
//: 目的:
//: - n を 8 の倍数に切り上げます。
//:
//: 実装(アルゴリズム):
//: - (n+7)/8*8 を計算します。
//:
//: 注意(重要):
//: - 8 バイト整列はアロケータの前提です。
//:
//: 計算量:
//: - O(1)
fn align8 <(i32)->i32> (n):
    let t <i32> add n 7
    let q <i32> div_s t 8
    mul q 8

//: mem_block_end: allocator block の[終端/しゅうたん] address を[返/かえ]す
//:
//: block header の先頭 address と header に保存された total size から、隣接判定に使う半開区間の終端を計算します。
fn mem_block_end <(i32)->i32> (blk):
    add blk load_i32 blk

//: alloc_raw: ヒープから領域を確保する（生ポインタAPI）
//:
//: 目的:
//: - size バイトの領域を返します（失敗時は 0）。
//:
//: 実装(アルゴリズム):
//: - free list を探索し、合うブロックが無ければ bump で拡張します。
//:
//: 注意(重要):
//: - size<=0 の場合は 0 を返します。
//: - 返り値 0 は失敗を意味します。
//:
//: 計算量:
//: - 平均 O(1) / 最悪 O(n)
fn alloc_raw <(i32)->i32> (size):
    if:
        cond:
            le size 0
        then:
            0
        else:
            let header <i32> 8
            let total <i32> align8 add size header
            let mut prev <i32> 0
            let mut cur <i32> load_i32 4
            let mut found <i32> 0
            while ne cur 0:
                do:
                    let blk_sz <i32> load_i32 cur
                    let next <i32> load_i32 add cur 4
                    if:
                        cond:
                            le total blk_sz
                        then:
                            let remain <i32> sub blk_sz total
                            if:
                                cond:
                                    le 16 remain
                                then:
                                    let new_blk <i32> add cur total
                                    store_i32 new_blk remain
                                    let new_blk_next_ptr <i32> add new_blk 4
                                    store_i32 new_blk_next_ptr next
                                    if:
                                        cond:
                                            eq prev 0
                                        then:
                                            store_i32 4 new_blk
                                        else:
                                            let prev_next_ptr <i32> add prev 4
                                            store_i32 prev_next_ptr new_blk
                                    store_i32 cur total
                                else:
                                    if:
                                        cond:
                                            eq prev 0
                                        then:
                                            store_i32 4 next
                                        else:
                                            let prev_next_ptr <i32> add prev 4
                                            store_i32 prev_next_ptr next
                                    store_i32 cur blk_sz
                            set found add cur header
                            set cur 0
                        else:
                            set prev cur
                            set cur next
            if:
                cond:
                    ne found 0
                then:
                    found
                else:
                    let heap_ptr0 <i32> load_i32 0
                    let heap_ptr <i32> if lt heap_ptr0 8 8 heap_ptr0
                    let start <i32> align8 heap_ptr
                    let new_heap <i32> add start total
                    let cur_pages <i32> mem_size
                    let cur_bytes <i32> mul cur_pages 65536
                    let mut ok <bool> true
                    if:
                        cond:
                            le new_heap cur_bytes
                        then:
                            ()
                        else:
                            let need_bytes <i32> sub new_heap cur_bytes
                            let need_round <i32> add need_bytes 65535
                            let grow_pages <i32> div_s need_round 65536
                            let prev_pages <i32> mem_grow grow_pages
                            if:
                                cond:
                                    lt prev_pages 0
                                then:
                                    set ok false
                                else:
                                    ()
                    if:
                        cond:
                            ok
                        then:
                            store_i32 0 new_heap
                            store_i32 start total
                            add start header
                        else:
                            0

//: dealloc_raw: 領域を解放する（生ポインタAPI）
//:
//: 目的:
//: - ptr を free list に戻します。
//:
//: 実装(アルゴリズム):
//: - ブロック先頭に total size を書き、address order の free list へ挿入します。
//: - 挿入位置の前後 block と隣接していれば、1 つの大きな free block に結合します。
//:
//: 注意(重要):
//: - ptr<=0 は無視します。
//: - size は alloc_raw 時のサイズと一致させてください。
//:
//: 計算量:
//: - O(n)
fn dealloc_raw <(i32,i32)->()> (ptr, size):
    if:
        cond:
            le ptr 0
        then:
            ()
        else:
            let header <i32> 8
            let total <i32> align8 add size header
            let blk <i32> sub ptr header
            let mut prev <i32> 0
            let mut cur <i32> load_i32 4
            let mut done <bool> false
            while and ne cur 0 not done:
                do:
                    if:
                        lt cur blk
                        then:
                            set prev cur
                            set cur load_i32 add cur 4
                        else:
                            set done true
            store_i32 blk total
            let blk_next_ptr <i32> add blk 4
            store_i32 blk_next_ptr cur
            if:
                cond:
                    eq prev 0
                then:
                    store_i32 4 blk
                else:
                    store_i32 add prev 4 blk
            if:
                cond:
                    and ne cur 0 eq mem_block_end blk cur
                then:
                    let cur_next <i32> load_i32 add cur 4
                    store_i32 blk add load_i32 blk load_i32 cur
                    store_i32 blk_next_ptr cur_next
                else:
                    ()
            if:
                cond:
                    and ne prev 0 eq mem_block_end prev blk
                then:
                    store_i32 prev add load_i32 prev load_i32 blk
                    store_i32 add prev 4 load_i32 blk_next_ptr
                else:
                    ()

//: realloc_raw: 既存領域を再確保する（生ポインタAPI）
//:
//: 目的:
//: - サイズ変更した領域を返します。
//:
//: 実装(アルゴリズム):
//: - 新領域を確保し、必要バイトをコピーして旧領域を解放します。
//:
//: 注意(重要):
//: - ptr<=0 は新規 alloc_raw と同等です。
//: - new_size<=0 は解放して 0 を返します。
//:
//: 計算量:
//: - O(n)
fn realloc_raw <(i32,i32,i32)->i32> (ptr, old_size, new_size):
    if:
        cond:
            le ptr 0
        then:
            alloc_raw new_size
        else:
            if:
                cond:
                    le new_size 0
                then:
                    dealloc_raw ptr old_size
                    0
                else:
                    let new_ptr <i32> alloc_raw new_size
                    if:
                        cond:
                            le new_ptr 0
                        then:
                            0
                        else:
                            let copy_bytes <i32> if lt new_size old_size new_size old_size
                            mem_copy new_ptr ptr copy_bytes
                            dealloc_raw ptr old_size
                            new_ptr

//: __nepl_rt_alloc: compiler runtime ABI 用の確保入口
//:
//: 目的:
//: - compiler が aggregate などの内部 lowering で使う allocator symbol を、公開 raw API 名から分離します。
//:
//: 実装(アルゴリズム):
//: - 現行 runtime allocator の `alloc_raw` へ委譲します。
//:
//: 注意(重要):
//: - これは compiler が予約する ABI です。通常の stdlib 利用コードは `alloc` または所有権付き wrapper を使ってください。
//: - 移行期間中は互換のために `alloc_raw` も残りますが、codegen はこの ABI 名を優先します。
//:
//: 計算量:
//: - O(alloc_raw)
fn __nepl_rt_alloc <(i32)->i32> (size):
    alloc_raw size

//: __nepl_rt_dealloc: compiler runtime ABI 用の解放入口
//:
//: 目的:
//: - compiler が runtime helper を保持・解決するときの deallocator symbol を、公開 raw API 名から分離します。
//:
//: 実装(アルゴリズム):
//: - 現行 runtime deallocator の `dealloc_raw` へ委譲します。
//:
//: 注意(重要):
//: - これは compiler が予約する ABI です。通常の stdlib 利用コードは安全 API または所有権付き wrapper を使ってください。
//:
//: 計算量:
//: - O(dealloc_raw)
fn __nepl_rt_dealloc <(i32,i32)->()> (ptr, size):
    dealloc_raw ptr size

//: __nepl_rt_realloc: compiler runtime ABI 用の再確保入口
//:
//: 目的:
//: - compiler が runtime helper を保持・解決するときの reallocator symbol を、公開 raw API 名から分離します。
//:
//: 実装(アルゴリズム):
//: - 現行 runtime reallocator の `realloc_raw` へ委譲します。
//:
//: 注意(重要):
//: - これは compiler が予約する ABI です。通常の stdlib 利用コードは安全 API または所有権付き wrapper を使ってください。
//:
//: 計算量:
//: - O(realloc_raw)
fn __nepl_rt_realloc <(i32,i32,i32)->i32> (ptr, old_size, new_size):
    realloc_raw ptr old_size new_size

//: alloc: alloc の結果を Result で返す安全API
//:
//: 目的:
//: - 失敗時に `0` ではなく `Result::Err` を返し、呼び出し側で明示的に処理できるようにします。
//:
//: 実装(アルゴリズム):
//: - `alloc_raw` の返値を検査し、`ptr>0` なら `Ok(ptr)`、それ以外は `Err(\"mem.alloc failed\")` を返します。
//:
//: 注意(重要):
//: - 生ポインタが必要な場合は `alloc_raw` を使います。
//:
//: 計算量:
//: - O(1)（`alloc` 本体を除く）
fn alloc <(i32)->Result<i32,str>> (size):
    let ptr <i32> alloc_raw size
    if:
        lt 0 ptr
        then:
            Result<i32,str>::Ok ptr
        else:
            Result<i32,str>::Err "mem.alloc failed"

//: realloc: realloc の結果を Result で返す安全API
//:
//: 目的:
//: - 再確保失敗を `Result` で扱い、エラー伝播しやすくします。
//:
//: 実装(アルゴリズム):
//: - `new_size<=0` は所有領域を解放せず `Err` を返します。0 サイズ化は `dealloc` を使って明示します。
//: - `new_size>0` のときだけ `realloc_raw` を呼び、返値が 0 かどうかで成功/失敗を判定します。
//:
//: 注意(重要):
//: - `Err` では元の `ptr` の所有権が呼び出し側に残ります。
//:
//: 計算量:
//: - O(1)（`realloc` 本体を除く）
fn realloc <(i32,i32,i32)->Result<i32,str>> (ptr, old_size, new_size):
    if:
        le new_size 0
        then:
            Result<i32,str>::Err "mem.realloc invalid new_size"
        else:
            let new_ptr <i32> realloc_raw ptr old_size new_size
            if:
                lt 0 new_ptr
                then:
                    Result<i32,str>::Ok new_ptr
                else:
                    Result<i32,str>::Err "mem.realloc failed"

//: dealloc: dealloc の前提を検査する安全API
//:
//: 目的:
//: - 不正な引数を早期に検出し、呼び出し側へ `Result` で返します。
//:
//: 実装(アルゴリズム):
//: - `ptr<=0` または `size<0` を `Err` とし、それ以外は `dealloc_raw` 後に `Ok(())` を返します。
//:
//: 計算量:
//: - O(1)
fn dealloc <(i32,i32)->Result<(),str>> (ptr, size):
    if:
        or le ptr 0 lt size 0
        then:
            Result<(),str>::Err "mem.dealloc invalid argument"
        else:
            dealloc_raw ptr size
            Result<(),str>::Ok ()

//: load_i32: i32 を読み出す
//:
//: 目的:
//: - ptr から i32 をロードします。
//:
//: 実装(アルゴリズム):
//: - wasm の i32.load を実行します。
//:
//: 注意(重要):
//: - アラインメントは呼び出し側の責任です。
//:
//: 計算量:
//: - O(1)
fn load_i32 <(i32)->i32> (p):
    #if[target=wasm]
    #wasm:
        local.get $p
        i32.load
    #if[target=llvm]
    #llvmir:
        define i32 @load_i32(i32 %p) {
        entry:
            %ok = icmp ule i32 %p, 67108860
            br i1 %ok, label %in, label %oob
        in:
            %idx = zext i32 %p to i64
            %ptr8 = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %0 = load i32, ptr %ptr8, align 1
            ret i32 %0
        oob:
            ret i32 0
        }

//: store_i32: i32 を書き込む
//:
//: 目的:
//: - ptr に i32 をストアします。
//:
//: 実装(アルゴリズム):
//: - wasm の i32.store を実行します。
//:
//: 注意(重要):
//: - アラインメントは呼び出し側の責任です。
//:
//: 計算量:
//: - O(1)
fn store_i32 <(i32,i32)->()> (p, v):
    #if[target=wasm]
    #wasm:
        local.get $p
        local.get $v
        i32.store
    #if[target=llvm]
    #llvmir:
        define void @store_i32(i32 %p, i32 %v) {
        entry:
            %ok = icmp ule i32 %p, 67108860
            br i1 %ok, label %in, label %oob
        in:
            %idx = zext i32 %p to i64
            %ptr8 = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            store i32 %v, ptr %ptr8, align 1
            ret void
        oob:
            ret void
        }

//: load_u8: 1 バイトを読み出す
//:
//: 目的:
//: - ptr から unsigned byte を読みます。
//:
//: 実装(アルゴリズム):
//: - wasm の i32.load8_u を実行します。
//:
//: 注意(重要):
//: - 返り値は i32 に拡張されます。
//:
//: 計算量:
//: - O(1)
fn load_u8 <(i32)->i32> (p):
    #if[target=wasm]
    #wasm:
        local.get $p
        i32.load8_u
    #if[target=llvm]
    #llvmir:
        define i32 @load_u8(i32 %p) {
        entry:
            %ok = icmp ule i32 %p, 67108863
            br i1 %ok, label %in, label %oob
        in:
            %idx = zext i32 %p to i64
            %ptr8 = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %raw = load i8, ptr %ptr8, align 1
            %0 = zext i8 %raw to i32
            ret i32 %0
        oob:
            ret i32 0
        }

//: store_u8: 1 バイトを書き込む
//:
//: 目的:
//: - ptr に 1 バイトを書き込みます。
//:
//: 実装(アルゴリズム):
//: - wasm の i32.store8 を実行します。
//:
//: 注意(重要):
//: - v の下位 8 ビットのみが使われます。
//:
//: 計算量:
//: - O(1)
fn store_u8 <(i32,i32)->()> (p, v):
    #if[target=wasm]
    #wasm:
        local.get $p
        local.get $v
        i32.store8
    #if[target=llvm]
    #llvmir:
        define void @store_u8(i32 %p, i32 %v) {
        entry:
            %ok = icmp ule i32 %p, 67108863
            br i1 %ok, label %in, label %oob
        in:
            %idx = zext i32 %p to i64
            %ptr8 = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %b = trunc i32 %v to i8
            store i8 %b, ptr %ptr8, align 1
            ret void
        oob:
            ret void
        }

//: mem_copy: 重ならないバイト列をまとめてコピーする
//:
//: 目的:
//: - `src` から `dst` へ `len` バイトをコピーします。
//:
//: 実装(アルゴリズム):
//: - wasm では `memory.copy`、llvm では `llvm.memcpy` を使います。
//:
//: 注意(重要):
//: - 呼び出し側は `dst..dst+len` と `src..src+len` が重ならないことを保証してください。
//: - `len<=0` は llvm target では何もしません。wasm target では呼び出し側が `len>=0` を守る必要があります。
//: - raw API のため、範囲外アクセスは未定義動作です。検査付きで使う場合は `MemPtr` オーバーロードを使います。
//:
//: 計算量:
//: - O(len)
fn mem_copy <(i32,i32,i32)->()> (dst, src, len):
    #if[target=wasm]
    #wasm:
        local.get $dst
        local.get $src
        local.get $len
        memory.copy
    #if[target=llvm]
    #llvmir:
        declare void @llvm.memcpy.p0.p0.i32(ptr, ptr, i32, i1)
        define void @mem_copy(i32 %dst, i32 %src, i32 %len) {
        entry:
            %has_bytes = icmp sgt i32 %len, 0
            br i1 %has_bytes, label %check_addr, label %done
        check_addr:
            %dst_neg = icmp slt i32 %dst, 0
            %src_neg = icmp slt i32 %src, 0
            %bad_addr = or i1 %dst_neg, %src_neg
            br i1 %bad_addr, label %done, label %check_bounds
        check_bounds:
            %dst64 = zext i32 %dst to i64
            %src64 = zext i32 %src to i64
            %len64 = zext i32 %len to i64
            %dst_end = add i64 %dst64, %len64
            %src_end = add i64 %src64, %len64
            %dst_ok = icmp ule i64 %dst_end, 67108864
            %src_ok = icmp ule i64 %src_end, 67108864
            %ok = and i1 %dst_ok, %src_ok
            br i1 %ok, label %copy, label %done
        copy:
            %dst_ptr = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %dst64
            %src_ptr = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %src64
            call void @llvm.memcpy.p0.p0.i32(ptr %dst_ptr, ptr %src_ptr, i32 %len, i1 false)
            ret void
        done:
            ret void
        }

//: mem_move: 重なり得るバイト列をまとめてコピーする
//:
//: 目的:
//: - `src` から `dst` へ `len` バイトをコピーします。範囲が重なっていても正しい順序で移動します。
//:
//: 実装(アルゴリズム):
//: - wasm では重なりを許す `memory.copy`、llvm では `llvm.memmove` を使います。
//:
//: 注意(重要):
//: - raw API のため、範囲外アクセスは未定義動作です。検査付きで使う場合は `MemPtr` オーバーロードを使います。
//:
//: 計算量:
//: - O(len)
fn mem_move <(i32,i32,i32)->()> (dst, src, len):
    #if[target=wasm]
    #wasm:
        local.get $dst
        local.get $src
        local.get $len
        memory.copy
    #if[target=llvm]
    #llvmir:
        declare void @llvm.memmove.p0.p0.i32(ptr, ptr, i32, i1)
        define void @mem_move(i32 %dst, i32 %src, i32 %len) {
        entry:
            %has_bytes = icmp sgt i32 %len, 0
            br i1 %has_bytes, label %check_addr, label %done
        check_addr:
            %dst_neg = icmp slt i32 %dst, 0
            %src_neg = icmp slt i32 %src, 0
            %bad_addr = or i1 %dst_neg, %src_neg
            br i1 %bad_addr, label %done, label %check_bounds
        check_bounds:
            %dst64 = zext i32 %dst to i64
            %src64 = zext i32 %src to i64
            %len64 = zext i32 %len to i64
            %dst_end = add i64 %dst64, %len64
            %src_end = add i64 %src64, %len64
            %dst_ok = icmp ule i64 %dst_end, 67108864
            %src_ok = icmp ule i64 %src_end, 67108864
            %ok = and i1 %dst_ok, %src_ok
            br i1 %ok, label %copy, label %done
        copy:
            %dst_ptr = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %dst64
            %src_ptr = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %src64
            call void @llvm.memmove.p0.p0.i32(ptr %dst_ptr, ptr %src_ptr, i32 %len, i1 false)
            ret void
        done:
            ret void
        }

//: memset_u8: バイト列を同じ値で埋める
//:
//: 目的:
//: - `ptr` から `len` バイトを `value`（下位 8bit）で埋めます。
//:
//: 実装(アルゴリズム):
//: - 0..len を順に走査し、`store_u8` で書き込みます。
//:
//: 注意(重要):
//: - `ptr` は少なくとも `len` バイトの有効領域を指している必要があります。
//:
//: 計算量:
//: - O(len)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/mem" as *
//: fn main <()*>i32> ():
//:     let p <i32> alloc_raw 8;
//:     memset_u8 p 8 65;
//:     let checks:
//:         checks_new
//:         |> checks_push assert_eq_i32 65 load_u8 add p 0
//:         |> checks_push assert_eq_i32 65 load_u8 add p 7
//:     dealloc_raw p 8;
//:     checks_exit_code checks
//: ```
fn memset_u8 <(i32,i32,i32)->()> (ptr, len, value):
    let mut i <i32> 0;
    while lt i len:
        do:
            let dst_ptr <i32> add ptr i;
            store_u8 dst_ptr value;
            set i add i 1;

//: fill_u8: `memset_u8` の同義 API
//:
//: 目的:
//: - 競プロ向けの名前でバイト埋め API を提供します。
//:
//: 実装(アルゴリズム):
//: - `memset_u8` を呼び出す薄いラッパです。
//:
//: 注意(重要):
//: - `value` は下位 8bit が使用されます。
//:
//: 計算量:
//: - O(len)
fn fill_u8 <(i32,i32,i32)->()> (ptr, len, value):
    memset_u8 ptr len value

//: fill_i32: `i32` 配列を同じ値で埋める
//:
//: 目的:
//: - `ptr` から `count` 個の `i32` 要素を `value` で埋めます。
//:
//: 実装(アルゴリズム):
//: - 0..count を順に走査し、`store_i32` で書き込みます。
//:
//: 注意(重要):
//: - `ptr` は少なくとも `count * 4` バイトの有効領域を指している必要があります。
//:
//: 計算量:
//: - O(count)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/mem" as *
//: fn main <()*>i32> ():
//:     let p <i32> alloc_raw 16;
//:     fill_i32 p 4 42;
//:     let checks:
//:         checks_new
//:         |> checks_push assert_eq_i32 42 load_i32 add p 0
//:         |> checks_push assert_eq_i32 42 load_i32 add p 12
//:     dealloc_raw p 16;
//:     checks_exit_code checks
//: ```
fn fill_i32 <(i32,i32,i32)->()> (ptr, count, value):
    let mut i <i32> 0;
    while lt i count:
        do:
            store_i32 <i32> add ptr <i32> mul i 4 value;
            set i add i 1;

//: memset_u8: MemPtr<u8> を受け取る安全オーバーロード
//:
//: 目的:
//: - 無効ポインタを `Result::Err` として扱い、`i32` 生ポインタ境界を減らします。
fn memset_u8 <(MemPtr<u8>,i32,i32)->Result<(),str>> (ptr, len, value):
    let raw <i32> mem_ptr_addr ptr;
    if:
        or lt raw 1 lt len 0
        then:
            Result<(),str>::Err "mem.memset_u8 invalid argument"
        else:
            memset_u8 raw len value
            Result<(),str>::Ok ()

//: fill_u8: MemPtr<u8> を受け取る安全オーバーロード
//:
//: 目的:
//: - `fill_u8` を `MemPtr` で利用できるようにし、呼び出し側の生ポインタ露出を減らします。
fn fill_u8 <(MemPtr<u8>,i32,i32)->Result<(),str>> (ptr, len, value):
    memset_u8 ptr len value

//: fill_i32: MemPtr<i32> を受け取る安全オーバーロード
//:
//: 目的:
//: - 無効ポインタを `Result::Err` として扱い、`i32` 生ポインタ境界を減らします。
fn fill_i32 <(MemPtr<i32>,i32,i32)->Result<(),str>> (ptr, count, value):
    let raw <i32> mem_ptr_addr ptr;
    if:
        or lt raw 1 lt count 0
        then:
            Result<(),str>::Err "mem.fill_i32 invalid argument"
        else:
            fill_i32 raw count value
            Result<(),str>::Ok ()

//: mem_copy: MemPtr の要素列をまとめてコピーする安全オーバーロード
//:
//: 目的:
//: - `src` から `dst` へ `count` 個の `.T` 要素をコピーします。
//: - `.T: Copy` の値だけを対象にし、所有権を持つ non-Copy 値の浅い複製を防ぎます。
//:
//: 実装(アルゴリズム):
//: - `count * size_of<.T>` を byte 数に変換し、raw `mem_copy` に委譲します。
//:
//: 注意(重要):
//: - `dst` と `src` の対象範囲が重ならない場合に使います。
//: - `count==0` はポインタが 0 でも成功として扱います。
//: - non-Copy 値を移動初期化する用途には使えません。将来の所有権付き region API で扱います。
//:
//: 計算量:
//: - O(count * size_of<.T>)
fn mem_copy <.T: Copy> <(MemPtr<.T>,MemPtr<.T>,i32)->Result<(),str>> (dst, src, count):
    let dst_raw <i32> mem_ptr_addr dst;
    let src_raw <i32> mem_ptr_addr src;
    if:
        lt count 0
        then:
            Result<(),str>::Err "mem.mem_copy invalid count"
        else:
            if:
                eq count 0
                then:
                    Result<(),str>::Ok ()
                else:
                    if:
                        or lt dst_raw 1 lt src_raw 1
                        then:
                            Result<(),str>::Err "mem.mem_copy invalid pointer"
                        else:
                            mem_copy dst_raw src_raw mul count size_of<.T>
                            Result<(),str>::Ok ()

//: mem_move: MemPtr の要素列を重なりを許してまとめてコピーする安全オーバーロード
//:
//: 目的:
//: - `src` から `dst` へ `count` 個の `.T` 要素を重なり許容でコピーします。
//: - `.T: Copy` の値だけを対象にし、所有権を持つ non-Copy 値の浅い複製を防ぎます。
//:
//: 実装(アルゴリズム):
//: - `count * size_of<.T>` を byte 数に変換し、raw `mem_move` に委譲します。
//:
//: 注意(重要):
//: - `dst` と `src` の対象範囲が重なり得る場合はこちらを使います。
//: - `count==0` はポインタが 0 でも成功として扱います。
//: - 名前は low-level memory move に合わせていますが、source の所有権を未初期化へ変える操作ではありません。
//:
//: 計算量:
//: - O(count * size_of<.T>)
fn mem_move <.T: Copy> <(MemPtr<.T>,MemPtr<.T>,i32)->Result<(),str>> (dst, src, count):
    let dst_raw <i32> mem_ptr_addr dst;
    let src_raw <i32> mem_ptr_addr src;
    if:
        lt count 0
        then:
            Result<(),str>::Err "mem.mem_move invalid count"
        else:
            if:
                eq count 0
                then:
                    Result<(),str>::Ok ()
                else:
                    if:
                        or lt dst_raw 1 lt src_raw 1
                        then:
                            Result<(),str>::Err "mem.mem_move invalid pointer"
                        else:
                            mem_move dst_raw src_raw mul count size_of<.T>
                            Result<(),str>::Ok ()

fn alloc_ptr <.T> <(i32)->Result<MemPtr<.T>,str>> (size):
    match alloc size:
        Result::Ok raw:
            Result<MemPtr<.T>,str>::Ok mem_ptr_wrap raw
        Result::Err _e:
            Result<MemPtr<.T>,str>::Err "mem.alloc_ptr failed"

fn realloc_ptr <.T> <(MemPtr<.T>,i32,i32)->Result<MemPtr<.T>,str>> (ptr, old_size, new_size):
    let raw <i32> mem_ptr_addr ptr;
    match realloc raw old_size new_size:
        Result::Ok next_ptr:
            Result<MemPtr<.T>,str>::Ok mem_ptr_wrap next_ptr
        Result::Err _e:
            Result<MemPtr<.T>,str>::Err "mem.realloc_ptr failed"

fn dealloc_ptr <.T> <(MemPtr<.T>,i32)->Result<(),str>> (ptr, size):
    let raw <i32> mem_ptr_addr ptr;
    match dealloc raw size:
        Result::Ok _:
            Result<(),str>::Ok ()
        Result::Err _e:
            Result<(),str>::Err "mem.dealloc_ptr invalid pointer"

fn mem_ptr_add <.T> <(MemPtr<.T>,i32)->MemPtr<.T>> (ptr, off):
    let raw <i32> mem_ptr_addr ptr;
    mem_ptr_wrap add raw off

//: load_i32: MemPtr<i32> から i32 を安全に読み出すオーバーロード
//:
//: 目的:
//: - 無効ポインタを `Option::None` として扱います。
fn load_i32 <(MemPtr<i32>)->Option<i32>> (p):
    let raw <i32> mem_ptr_addr p;
    if:
        lt raw 1
        then:
            Option<i32>::None
        else:
            Option<i32>::Some load_i32 raw

//: store_i32: MemPtr<i32> へ i32 を安全に書き込むオーバーロード
//:
//: 目的:
//: - 無効ポインタを `Result::Err` として返し、未定義動作を避けます。
fn store_i32 <(MemPtr<i32>,i32)->Result<(),str>> (p, v):
    let raw <i32> mem_ptr_addr p;
    if:
        lt raw 1
        then:
            Result<(),str>::Err "mem.store_i32 invalid pointer"
        else:
            store_i32 raw v
            Result<(),str>::Ok ()

//: load_u8: MemPtr<u8> から 1 バイトを安全に読み出すオーバーロード
//:
//: 目的:
//: - 無効ポインタを `Option::None` として扱います。
fn load_u8 <(MemPtr<u8>)->Option<i32>> (p):
    let raw <i32> mem_ptr_addr p;
    if:
        lt raw 1
        then:
            Option<i32>::None
        else:
            Option<i32>::Some load_u8 raw

//: store_u8: MemPtr<u8> へ 1 バイトを書き込む安全オーバーロード
//:
//: 目的:
//: - 無効ポインタを `Result::Err` として返し、未定義動作を避けます。
fn store_u8 <(MemPtr<u8>,i32)->Result<(),str>> (p, v):
    let raw <i32> mem_ptr_addr p;
    if:
        lt raw 1
        then:
            Result<(),str>::Err "mem.store_u8 invalid pointer"
        else:
            store_u8 raw v
            Result<(),str>::Ok ()

//: size_of: 型のサイズを取得する
//:
//: 目的:
//: - .T のサイズ（バイト）を返します。
//:
//: 実装(アルゴリズム):
//: - intrinsic "size_of" を呼びます。
//:
//: 注意(重要):
//: - サイズはコンパイル時に決まります。
//:
//: 計算量:
//: - O(1)
fn size_of <.T> <()->i32> ():
    #intrinsic "size_of" <.T> ()

//: align_of: 型のアラインメントを取得する
//:
//: 目的:
//: - .T のアラインメント（バイト）を返します。
//:
//: 実装(アルゴリズム):
//: - intrinsic "align_of" を呼びます。
//:
//: 注意(重要):
//: - アラインメントはコンパイル時に決まります。
//:
//: 計算量:
//: - O(1)
fn align_of <.T> <()->i32> ():
    #intrinsic "align_of" <.T> ()

//: load: 任意型をロードする
//:
//: 目的:
//: - ptr から .T を読み出します。
//:
//: 実装(アルゴリズム):
//: - intrinsic "load" を呼びます。
//:
//: 注意(重要):
//: - 型とメモリ内容の整合性は呼び出し側の責任です。
//:
//: 計算量:
//: - O(1)
fn load <.T> <(i32)->.T> (ptr):
    #intrinsic "load" <.T> (ptr)

//: store: 任意型をストアする
//:
//: 目的:
//: - ptr に .T を書き込みます。
//:
//: 実装(アルゴリズム):
//: - intrinsic "store" を呼びます。
//:
//: 注意(重要):
//: - 型とメモリ内容の整合性は呼び出し側の責任です。
//:
//: 計算量:
//: - O(1)
fn store <.T> <(i32,.T)->()> (ptr, val):
    #intrinsic "store" <.T> (ptr, val)
