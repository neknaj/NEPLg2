#indent 4

//: mem: 安全側のメモリ facade
//:
//: 目的:
//: - `MemPtr` / `RegionToken` の公開型、layout 計算、検査付き pointer API を提供します。
//: - raw allocator、raw address 変換、低レベル allocator wrapper、任意型 load/store は internal submodule に閉じ、ここからは再公開しません。
//:
//: 実装(アルゴリズム):
//: - `mem/types`、`mem/layout`、`mem/pointer` を public re-export します。
//: - allocator と raw load/store の実装は private import 経由で capability を持つ submodule からだけ使います。
//:
//: 注意(重要):
//: - safe caller は `alloc_region` で owner token を確保し、`region_ptr` / `region_ptr_at` で non-owning pointer view を借ります。
//: - raw helper が必要な stdlib 実装は、責務を確認したうえで internal module を明示 import します。
//:
//: 計算量:
//: - facade 自体は再公開だけなので O(1) です。各 API の計算量は submodule の doc を参照してください。
//:
//: ---
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let ok0 %bool eq align8 0 0;
//:     let ok1 %bool eq align8 1 8;
//:     let ok2 %bool eq align8 8 8;
//:     let ok3 %bool eq align8 9 16;
//:     let ok01 %bool and ok0 ok1;
//:     let ok23 %bool and ok2 ok3;
//:     let ok %bool and ok01 ok23;
//:     if ok 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let allocated %Result RegionToken i32 str alloc_region 1
//:     match allocated:
//:         Result::Ok region:
//:             let p %MemPtr i32 region_ptr &region
//:             match store_i32 p 123:
//:                 Result::Ok _:
//:                     match load_i32 p:
//:                         Option::Some v:
//:                             match dealloc_region region:
//:                                 Result::Ok _:
//:                                     if eq v 123 1 0
//:                                 Result::Err _:
//:                                     0
//:                         Option::None:
//:                             match dealloc_region region:
//:                                 Result::Ok _:
//:                                     0
//:                                 Result::Err _:
//:                                     0
//:                 Result::Err _:
//:                     match dealloc_region region:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let allocated %Result RegionToken i32 str alloc_region 2
//:     match allocated:
//:         Result::Ok region:
//:             let ok %bool eq region_size &region 8;
//:             match dealloc_region region:
//:                 Result::Ok _:
//:                     if ok 1 0
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```

pub #import "./mem/types" as *
pub #import "./mem/layout" as *
pub #import "./mem/pointer" as *
