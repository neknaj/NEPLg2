#indent 4

//: mem/types: MemPtr / RegionToken の公開型
//:
//: 目的:
//: - メモリ領域を参照する軽量な pointer view と、領域 owner token の形を定義します。
//: - direct constructor は compiler の raw-memory-boundary capability 内に閉じ、通常利用者は checked wrapper を経由します。
//: - raw address との相互変換は `mem/internal` に分離し、public facade からは再公開しません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     if ge size_of<MemPtr<i32>> 4 1 0
//: ```

#import "core/math" as *

pub struct MemPtr<.T>:
    raw <i32>

pub struct RegionToken<.T>:
    ptr <MemPtr<.T>>
    size <i32>

//: region_token_ptr_ref: RegionToken の pointer field を所有権を移動せずに借用する
//:
//: 目的:
//: - `RegionToken` は領域の解放責務を持つため、観察用 API が token を move してはいけません。
//: - compiler intrinsic で field reference を作り、`MemPtr` の copy 値だけを外側に返せるようにします。
pub fn region_token_ptr_ref <.T> <(&RegionToken<.T>)->&MemPtr<.T>> (token):
    #intrinsic "get_field_ref" <> (token,"ptr")

//: region_token_size_ref: RegionToken の size field を所有権を移動せずに借用する
//:
//: 目的:
//: - bounds check と pointer projection が token owner を消費しないようにします。
pub fn region_token_size_ref <.T> <(&RegionToken<.T>)->&i32> (token):
    #intrinsic "get_field_ref" <> (token,"size")

pub fn region_ptr <.T> <(&RegionToken<.T>)->MemPtr<.T>> (token):
    *region_token_ptr_ref token

pub fn region_size <.T> <(&RegionToken<.T>)->i32> (token):
    *region_token_size_ref token

pub fn region_in_bounds <.T> <(&RegionToken<.T>,i32,i32)->bool> (token, off, bytes):
    let total <i32> *region_token_size_ref token
    if:
        or lt off 0 lt bytes 0
        then:
            false
        else:
            let end <i32> add off bytes
            and le end total ge end off
