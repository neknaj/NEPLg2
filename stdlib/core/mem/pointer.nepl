#indent 4

//: mem/pointer: RegionToken / MemPtr を使う検査付き pointer API facade
//:
//: 目的:
//: - raw address を public caller に押し出さず、Result / Option で失敗を返す wrapper を公開します。
//: - 実装は alloc / region / bulk / scalar の submodule に分け、ここは再公開だけを担当します。
//:
//: 注意(重要):
//: - raw load/store と allocator の実装は `mem/raw` / `mem/allocator` / `mem/internal` 側に閉じます。
//: - この facade は raw-memory-boundary capability を持たず、関数本体も所有しません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_ptr<i32> 4:
//:         Result::Ok p:
//:             match dealloc_ptr<i32> p 4:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```

pub #import "./pointer/alloc" as *
pub #import "./pointer/region" as *
pub #import "./pointer/bulk" as *
pub #import "./pointer/scalar" as *
