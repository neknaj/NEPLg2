#indent 4

//: mem/pointer: RegionToken / MemPtr を使う検査付き pointer API facade
//:
//: 目的:
//: - raw address を public caller に押し出さず、Result / Option で失敗を返す wrapper を公開します。
//: - 実装は view / region / bulk / scalar の submodule に分け、ここは再公開だけを担当します。
//:
//: 注意(重要):
//: - raw load/store と allocator の実装は `mem/raw` / `mem/allocator` / `mem/internal` 側に閉じます。
//: - allocation owner は `RegionToken .T` が保持し、`MemPtr .T` は non-owning view としてだけ公開します。
//: - この facade は raw-memory-boundary capability を持たず、関数本体も所有しません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let allocated %Result RegionToken i32 str alloc_region 1
//:     match allocated:
//:         Result::Ok region:
//:             match dealloc_region region:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```

pub #import "./pointer/view" as *
pub #import "./pointer/region" as *
pub #import "./pointer/bulk" as *
pub #import "./pointer/scalar" as *
