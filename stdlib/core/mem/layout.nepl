#indent 4

//: mem/layout: メモリレイアウト計算
//:
//: 目的:
//: - raw memory identity を公開せずに、型サイズ・アラインメント・allocator 用の基本整列計算を提供します。
//: - `core/mem` facade から公開しても pointer provenance や ownership を漏らさない純粋な layout API だけを置きます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if eq align8 9 16 1 0
//: ```

#import "core/math" as *

//: align8: 8 バイト境界に切り上げる
//:
//: 目的:
//: - n を 8 の倍数に切り上げます。
//:
//: 実装(アルゴリズム):
//: - (n+7)/8*8 を計算します。
//:
//: 注意(重要):
//: - 8 バイト整列は現行 allocator の block header と payload alignment の前提です。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if and eq align8 1 8 eq align8 16 16 1 0
//: ```
pub fn align8 %fn i32 i32 \n:
    let t %i32 add n 7
    let q %i32 div_s t 8
    mul q 8

//: max_alloc_payload_bytes: allocator payload として安全に整列計算できる最大 byte 数
//:
//: 目的:
//: - allocator が `align8(size + header)` を計算するとき、i32 加算が wrap しない payload 上限を返します。
//:
//: 実装(アルゴリズム):
//: - header 8 byte と align8 の `+7` を考慮し、`i32::MAX - 15` を上限にします。
//:
//: 注意(重要):
//: - これは runtime memory の空き容量ではなく、allocator metadata 計算を安全に行える整数上限です。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if eq max_alloc_payload_bytes 2147483632 1 0
//: ```
pub fn max_alloc_payload_bytes %fn () i32 \():
    2147483632

//: alloc_payload_fits: allocator payload byte 数が整列計算可能か判定する
//:
//: 目的:
//: - allocator に渡す payload byte 数が、負数ではなく `max_alloc_payload_bytes` 以下であることを確認します。
//:
//: 実装(アルゴリズム):
//: - `0 <= bytes <= max_alloc_payload_bytes` を比較だけで判定します。
//:
//: 注意(重要):
//: - `bytes == 0` は整数上は安全ですが、実際の allocation 成功条件は allocator API が別途決めます。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if and alloc_payload_fits 2147483632 not alloc_payload_fits 2147483633 1 0
//: ```
pub fn alloc_payload_fits %fn i32 bool \bytes:
    and ge bytes 0 le bytes max_alloc_payload_bytes

//: size_of: 型のサイズを取得する
//:
//: 目的:
//: - `.T` のサイズ（バイト）を返します。
//:
//: 実装(アルゴリズム):
//: - compiler intrinsic の `size_of` を呼びます。
//:
//: 注意(重要):
//: - サイズはコンパイル時に決まります。
//: - 返り値は raw address ではないため、public facade から利用できます。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if eq size_of<i32> 4 1 0
//: ```
pub fn size_of <.T> %fn () i32 \():
    #intrinsic "size_of" <.T> ()

//: align_of: 型のアラインメントを取得する
//:
//: 目的:
//: - `.T` のアラインメント（バイト）を返します。
//:
//: 実装(アルゴリズム):
//: - compiler intrinsic の `align_of` を呼びます。
//:
//: 注意(重要):
//: - アラインメントはコンパイル時に決まります。
//: - pointer identity や storage ownership は返さないため、public facade の安全 API として扱えます。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if ge align_of<i32> 1 1 0
//: ```
pub fn align_of <.T> %fn () i32 \():
    #intrinsic "align_of" <.T> ()
