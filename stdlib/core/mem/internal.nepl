#indent 4

//: mem/internal: MemPtr / RegionToken の raw identity 境界
//:
//: 目的:
//: - `MemPtr` と raw `i32` address の相互変換、`RegionToken` の owner token 構築を internal boundary に閉じます。
//: - public `core/mem` facade からは再公開せず、raw-memory-backed stdlib implementation だけが明示的に import します。
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.raw.memory_outside_boundary
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/internal" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let p %MemPtr i32 mem_ptr_wrap 16
//:     if eq mem_ptr_addr p 16 1 0
//: ```

#import "./types" as *
#import "core/field" as *

//: mem_ptr_wrap: raw address を MemPtr に包む
//:
//: 目的:
//: - compiler-owned boundary で得た raw address を non-owning pointer view として扱うための内部 helper です。
//:
//: 注意(重要):
//: - これは storage owner を作る API ではありません。
//: - public source へ露出すると arbitrary address から `MemPtr` を forged できるため、root facade からは公開しません。
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.raw.memory_outside_boundary
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/internal" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     if eq mem_ptr_addr mem_ptr_wrap<i32> 32 32 1 0
//: ```
pub fn mem_ptr_wrap <.T> %fn i32 MemPtr .T \raw:
    MemPtr raw

//: mem_ptr_addr: MemPtr から raw address view を取り出す
//:
//: 目的:
//: - raw-memory-backed implementation が checked wrapper の内部で byte operation へ降りるための内部 helper です。
//:
//: 注意(重要):
//: - 返り値は non-owning raw view であり、free obligation owner ではありません。
//: - public source へ露出すると bounds / provenance / owner discipline を迂回できるため、root facade からは公開しません。
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.raw.memory_outside_boundary
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/internal" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let p %MemPtr u8 mem_ptr_wrap 64
//:     if eq mem_ptr_addr p 64 1 0
//: ```
pub fn mem_ptr_addr <.T> %fn MemPtr .T i32 \p:
    get p "raw"

//: region_token_raw_ref: RegionToken の raw owner identity を内部境界で借用する
//:
//: 目的:
//: - `RegionToken` の free obligation identity を、checked projection / dealloc / realloc の内部実装だけで参照します。
//: - safe `core/mem` facade からは公開せず、通常利用者が raw owner identity を観測できないようにします。
//:
//: 注意(重要):
//: - 返される参照は non-owning raw view の構築や owner-consuming raw boundary へ渡すための内部表現です。
//: - caller はこの raw identity を public API result として返してはいけません。
pub fn region_token_raw_ref <.T> %fn &RegionToken .T &i32 \token:
    #intrinsic "get_field_ref" <> (token,"raw")

//: region_new: RegionToken を構築する
//:
//: 目的:
//: - allocator wrapper が所有領域の raw identity と size をまとめ、free obligation owner token を作ります。
//: - token 内部には `MemPtr .T` ではなく raw owner identity を保存し、`MemPtr .T` は projection view としてだけ外へ作ります。
//:
//: 注意(重要):
//: - 呼び出し側は raw が allocator から得た owned storage identity であることを保証します。
//: - `MemPtr .T` は non-owning view なので、この関数の入力にはしません。
//: - public source へ露出すると任意 raw address から owner token を forged できるため、root facade からは公開しません。
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.raw.memory_outside_boundary
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/allocator" as allocator
//:| #import "core/mem/internal" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     match allocator::alloc 4:
//:         Result::Err _e:
//:             0
//:         Result::Ok raw:
//:             let token %RegionToken u8 region_new<u8> raw 4
//:             let ok %i32 if eq region_size &token 4 1 0
//:             match dealloc_region<u8> token:
//:                 Result::Err _cleanup:
//:                     0
//:                 Result::Ok _:
//:                     ok
//: ```
pub fn region_new <.T> %fn i32 fn i32 RegionToken .T \raw\size:
    RegionToken raw size
