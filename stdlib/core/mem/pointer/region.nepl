#indent 4

//: mem/pointer/region: RegionToken owner wrapper
//:
//: 目的:
//: - allocator storage を `RegionToken<T>` として扱い、bounds 付き pointer projection を提供します。
//: - `RegionToken<T>` は free obligation owner であり、`MemPtr<T>` とは責務を分けます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<i32> 1:
//:         Result::Ok region:
//:             let ok <bool> eq region_size &region 4
//:             match dealloc_region<i32> region:
//:                 Result::Ok _:
//:                     if ok 1 0
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```

#import "core/math" as *
#import "core/result" as *
#import "../types" as *
#import "../layout" as *
#import "../internal" as *
#import "../allocator" as allocator
#import "core/field" as *

//: region_ptr: RegionToken の基底を non-owning MemPtr view として得る
//:
//: 目的:
//: - `RegionToken<T>` の free obligation owner を動かさず、領域先頭を `MemPtr<T>` として観察します。
//:
//: 注意(重要):
//: - 返される `MemPtr<T>` は free obligation owner ではありません。
//: - owner を消費する dealloc / realloc は `RegionToken<T>` を受け取る core/mem helper に集約します。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<i32> 1:
//:         Result::Ok region:
//:             let ptr <MemPtr<i32>> region_ptr &region
//:             let stored <Result<(),str>> store_i32 ptr 42
//:             match stored:
//:                 Result::Ok _:
//:                     let loaded <Option<i32>> load_i32 ptr
//:                     let ok <bool> match loaded:
//:                         Option::Some value:
//:                             eq value 42
//:                         Option::None:
//:                             false
//:                     match dealloc_region<i32> region:
//:                         Result::Ok _:
//:                             if ok 1 0
//:                         Result::Err _:
//:                             0
//:                 Result::Err _:
//:                     match dealloc_region<i32> region:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
pub fn region_ptr <.T> <(&RegionToken<.T>)->MemPtr<.T>> (token):
    mem_ptr_wrap *region_token_raw_ref token

//: region_ptr_at: RegionToken 内の byte offset から MemPtr を得る
//:
//: 目的:
//: - owned region の範囲内にある byte offset を、型付きの non-owning pointer view へ変換します。
//:
//: 実装(アルゴリズム):
//: - `.U` の `size_of` を使って `off..off+size_of<U>` が region size に収まるかを確認します。
//: - `.U` の `align_of` を使って `base + off` が typed pointer projection として正しく整列しているかを確認します。
//: - 範囲内かつ整列済みであれば base pointer の raw view に offset を加え、`MemPtr<U>` として包みます。
//:
//: 注意(重要):
//: - 返される `MemPtr<U>` は free obligation owner ではありません。
//: - bounds と alignment はこの owner boundary で検査します。呼び出し側に typed pointer safety の証明を押し出しません。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<i32> 1:
//:         Result::Ok region:
//:             match region_ptr_at<i32, i32> &region 0:
//:                 Result::Ok _ptr:
//:                     match dealloc_region<i32> region:
//:                         Result::Ok _:
//:                             1
//:                         Result::Err _:
//:                             0
//:                 Result::Err _:
//:                     match dealloc_region<i32> region:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<u8> 8:
//:         Result::Ok region:
//:             let ok <bool> match region_ptr_at<u8, i32> &region 1:
//:                 Result::Ok _ptr:
//:                     false
//:                 Result::Err _:
//:                     true
//:             match dealloc_region<u8> region:
//:                 Result::Ok _:
//:                     if ok 1 0
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
pub fn region_ptr_at <.T, .U> <(&RegionToken<.T>,i32)->Result<MemPtr<.U>,str>> (token, off):
    let bytes <i32> size_of<.U>
    let align <i32> align_of<.U>
    let total <i32> *region_token_size_ref token
    let base_raw <i32> *region_token_raw_ref token
    let addr <i32> add base_raw off
    if:
        if:
            or lt off 0 lt bytes 0
            then:
                false
            else:
                let end <i32> add off bytes
                let in_bounds <bool> and and le end total ge end off ge addr base_raw
                let aligned <bool> if le align 1 true eq rem_s addr align 0
                and in_bounds aligned
        then:
            Result<MemPtr<.U>,str>::Ok mem_ptr_wrap addr
        else:
            Result<MemPtr<.U>,str>::Err "mem.region_ptr_at out of bounds or unaligned"

//: alloc_region_bytes: byte 数を指定して RegionToken を確保する
//:
//: 目的:
//: - allocator から得た storage owner を `RegionToken<T>` として束ねます。
//:
//: 実装(アルゴリズム):
//: - `bytes` が負、または allocator payload 上限を超える場合は `Err` を返します。
//: - allocator の raw allocation 結果をこの owner boundary 内で検査し、成功時だけ `region_new` で owner token に束ねます。
//:
//: 注意(重要):
//: - `RegionToken<T>` は free obligation owner です。使用後は `dealloc_region` で閉じます。
//: - `T` は pointer view の型であり、領域内の各 cell が initialized であることは別の Resource IR state が管理します。
//:
//: 計算量:
//: - allocator の free list 探索に依存し、最悪 O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region_bytes<i32> 4:
//:         Result::Ok region:
//:             let ok <bool> eq region_size &region 4
//:             match dealloc_region<i32> region:
//:                 Result::Ok _:
//:                     if ok 1 0
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
pub fn alloc_region_bytes <.T> <(i32)->Result<RegionToken<.T>,str>> (bytes):
    if:
        not alloc_payload_fits bytes
        then:
            Result<RegionToken<.T>,str>::Err "mem.alloc_region_bytes invalid size"
        else:
            let raw <i32> allocator::alloc_raw bytes
            if:
                lt 0 raw
                then:
                    Result<RegionToken<.T>,str>::Ok region_new<.T> raw bytes
                else:
                    Result<RegionToken<.T>,str>::Err "mem.alloc_region_bytes failed"

//: RegionReallocError: `RegionToken` の[再確保/さいかくほ]に[失敗/しっぱい]したときの owner payload
//:
//: 目的:
//: - `realloc_region_bytes_keep` が[失敗/しっぱい]したとき、旧 `RegionToken<T>` owner を caller に[返/かえ]します。
//: - `Result<RegionToken<T>, str>` では、失敗時に旧 owner を[保持/ほじ]しているのか、内部で[解放/かいほう]したのかが型から[読/よ]めません。
//:
//: 注意(重要):
//: - この struct は owner token を field に[持/も]つため、通常 source から直接[構築/こうちく]せず、accessor 経由で旧 token を[回収/かいしゅう]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region_bytes<i32> 4:
//:         Result::Ok region:
//:             match realloc_region_bytes_keep<i32> region sub 0 1:
//:                 Result::Err e:
//:                     let old <RegionToken<i32>> region_realloc_error_region<i32> e
//:                     let ok <bool> eq region_size &old 4
//:                     match dealloc_region<i32> old:
//:                         Result::Ok _:
//:                             if ok 1 0
//:                         Result::Err _:
//:                             0
//:                 Result::Ok grown:
//:                     match dealloc_region<i32> grown:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
pub struct RegionReallocError<.T>:
    region <RegionToken<.T>>

//: region_realloc_error_region: [再確保/さいかくほ][失敗/しっぱい]時に[戻/もど]された旧 region owner を[取/と]り[出/だ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region_bytes<i32> 4:
//:         Result::Ok region:
//:             match realloc_region_bytes_keep<i32> region sub 0 1:
//:                 Result::Err e:
//:                     let old <RegionToken<i32>> region_realloc_error_region<i32> e
//:                     let ok <bool> eq region_size &old 4
//:                     match dealloc_region<i32> old:
//:                         Result::Ok _:
//:                             if ok 1 0
//:                         Result::Err _:
//:                             0
//:                 Result::Ok grown:
//:                     match dealloc_region<i32> grown:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
pub fn region_realloc_error_region <.T> <(RegionReallocError<.T>)->RegionToken<.T>> (e):
    get e "region"

// raw realloc と storage relocation proof を同じ owner 境界で閉じる内部 helper です。
fn realloc_region_bytes_keep_relocating <.T> <(RegionToken<.T>,i32)->Result<RegionToken<.T>, RegionReallocError<.T>>> (region, new_size):
    if:
        not alloc_payload_fits new_size
        then:
            Result<RegionToken<.T>, RegionReallocError<.T>>::Err RegionReallocError<.T> region
        else:
            let old_size <i32> get region "size"
            let old_raw <i32> get region "raw"
            let next_raw <i32> allocator::realloc_raw old_raw old_size new_size
            if:
                lt 0 next_raw
                then:
                    let grown <RegionToken<.T>> region_new<.T> next_raw new_size
                    #intrinsic "collection_slot_storage_relocate" <> (&region, &grown)
                    Result<RegionToken<.T>, RegionReallocError<.T>>::Ok grown
                else:
                    Result<RegionToken<.T>, RegionReallocError<.T>>::Err RegionReallocError<.T> region

//: realloc_region_bytes_keep: `RegionToken` owner を byte [数/すう]指定で[再確保/さいかくほ]する
//:
//: 目的:
//: - `RegionToken<T>` の pointer/size field を caller に[分解/ぶんかい]させず、core/mem が[再確保/さいかくほ]境界を[所有/しょゆう]します。
//: - [成功/せいこう]時は新しい `RegionToken<T>` owner、[失敗/しっぱい]時は旧 `RegionToken<T>` owner を `RegionReallocError` に[戻/もど]します。
//:
//: 実装(アルゴリズム):
//: - 新 byte 数が allocator payload 上限に[収/おさ]まることを先に[確認/かくにん]します。
//: - 旧 token から raw owner identity と extent を[借/か]りて raw realloc 境界へ[渡/わた]し、成功時だけ新 token を[作/つく]ります。
//: - storage relocation proof は core/mem 内部 helper で発行し、public API からは marker authority を[公開/こうかい]しません。
//:
//: 注意(重要):
//: - `MemPtr<T>` は owner ではありません。この関数の API は常に `RegionToken<T>` owner を[受/う]け[取/と]り、成功/失敗のどちらかで owner を[返/かえ]します。
//: - element の initialized/drop state は別の Resource IR state が[検査/けんさ]します。この関数は storage owner の[再確保/さいかくほ]だけを[扱/あつか]います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region_bytes<i32> 4:
//:         Result::Ok region:
//:             match realloc_region_bytes_keep<i32> region 8:
//:                 Result::Ok grown:
//:                     let ok <bool> eq region_size &grown 8
//:                     match dealloc_region<i32> grown:
//:                         Result::Ok _:
//:                             if ok 1 0
//:                         Result::Err _:
//:                             0
//:                 Result::Err e:
//:                     let old <RegionToken<i32>> region_realloc_error_region<i32> e
//:                     match dealloc_region<i32> old:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
pub fn realloc_region_bytes_keep <.T> <(RegionToken<.T>,i32)->Result<RegionToken<.T>, RegionReallocError<.T>>> (region, new_size):
    let result <Result<RegionToken<.T>, RegionReallocError<.T>>> realloc_region_bytes_keep_relocating<.T> region new_size
    result

//: alloc_region: 要素数を指定して RegionToken を確保する
//:
//: 目的:
//: - `.T` の `count` 個ぶんの storage を確保し、owner token として返します。
//:
//: 実装(アルゴリズム):
//: - `count` と `size_of<T>` から乗算前に最大 count を計算し、overflow しない場合だけ byte 数へ変換します。
//:
//: 注意(重要):
//: - `count <= 0` の場合は `Err` を返します。
//: - `count * size_of<T>` が allocator payload 上限を超える場合は、wrap した byte 数を作らず `Err` を返します。
//:
//: 計算量:
//: - allocator の free list 探索に依存し、最悪 O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<i32> 2:
//:         Result::Ok region:
//:             let ok <bool> eq region_size &region 8
//:             match dealloc_region<i32> region:
//:                 Result::Ok _:
//:                     if ok 1 0
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<i32> 536870909:
//:         Result::Err _:
//:             1
//:         Result::Ok region:
//:             match dealloc_region<i32> region:
//:                 Result::Ok _:
//:                     0
//:                 Result::Err _:
//:                     0
//: ```
pub fn alloc_region <.T> <(i32)->Result<RegionToken<.T>,str>> (count):
    let elem_size <i32> size_of<.T>
    if:
        or le count 0 le elem_size 0
        then:
            Result<RegionToken<.T>,str>::Err "mem.alloc_region invalid count"
        else:
            let max_count <i32> div_s max_alloc_payload_bytes elem_size
            if:
                gt count max_count
                then:
                    Result<RegionToken<.T>,str>::Err "mem.alloc_region size overflow"
                else:
                    let bytes <i32> mul count elem_size
                    alloc_region_bytes<.T> bytes

//: dealloc_region: RegionToken が所有する storage を解放する
//:
//: 目的:
//: - `RegionToken<T>` の free obligation を消費して allocator へ返します。
//:
//: 実装(アルゴリズム):
//: - token 内の raw owner identity と size を取り出し、owner-consuming raw dealloc 境界へ直接渡します。
//: - zero-size sentinel も token としては消費し、allocator 側の `dealloc_raw` が no-op として閉じます。
//:
//: 注意(重要):
//: - initialized non-Copy value が残る storage-only free は compiler の Resource IR gate が拒否します。
//: - `MemPtr` だけから `RegionToken` は作れないため、通常 source は owner token を forge できません。
//: - この関数は cleanup destructor 境界です。無効な token を caller へ戻す API ではなく、渡された token の所有権を必ず閉じます。
//:
//: 計算量:
//: - allocator の free list 挿入 / coalesce に依存し、最悪 O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_region<u8> 4:
//:         Result::Ok region:
//:             match dealloc_region<u8> region:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
pub fn dealloc_region <.T> <(RegionToken<.T>)->Result<(),str>> (token):
    let raw <i32> get token "raw"
    let size <i32> get token "size"
    allocator::dealloc_raw raw size
    Result<(),str>::Ok ()
