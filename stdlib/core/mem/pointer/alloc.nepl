#indent 4

//: mem/pointer/alloc: MemPtr allocation wrapper
//:
//: 目的:
//: - raw allocator の戻り値を `MemPtr<T>` に包む low-level allocation boundary API を提供します。
//: - `MemPtr<T>` は non-owning pointer view であり、free obligation owner そのものではありません。
//: - public safe facade は owner token を返す `alloc_region` を使うため、この module は `core/mem` から再公開しません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/pointer/alloc" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_ptr<i32> 4:
//:         Result::Ok p:
//:             match dealloc_ptr<i32> p 4:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```

#import "core/math" as *
#import "core/result" as *
#import "../types" as *
#import "../internal" as *
#import "../allocator" as *

//: alloc_ptr: byte 数を指定して MemPtr を確保する
//:
//: 目的:
//: - raw allocator の返す `i32` address を、checked API の `MemPtr<T>` として返します。
//:
//: 実装(アルゴリズム):
//: - `alloc` が `Ok(raw)` を返した場合だけ internal boundary の `mem_ptr_wrap` で pointer view を作ります。
//:
//: 注意(重要):
//: - `MemPtr<T>` は non-owning pointer view です。free obligation は compiler の owner state / caller contract が管理します。
//: - owner token が必要な場合は `alloc_region` を使います。
//:
//: 計算量:
//: - allocator の free list 探索に依存し、最悪 O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/pointer/alloc" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_ptr<i32> 4:
//:         Result::Ok p:
//:             match dealloc_ptr<i32> p 4:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
pub fn alloc_ptr <.T> <(i32)->Result<MemPtr<.T>,str>> (size):
    match alloc size:
        Result::Ok raw:
            Result<MemPtr<.T>,str>::Ok mem_ptr_wrap raw
        Result::Err _e:
            Result<MemPtr<.T>,str>::Err "mem.alloc_ptr failed"

//: realloc_ptr: MemPtr の backing storage を再確保する
//:
//: 目的:
//: - 既存 pointer の storage を指定サイズへ再確保し、新しい `MemPtr<T>` を返します。
//:
//: 実装(アルゴリズム):
//: - `MemPtr<T>` から internal raw view を取り出し、checked `realloc` へ委譲します。
//:
//: 注意(重要):
//: - `realloc_ptr` 成功後、古い pointer の free obligation は新しい pointer へ移ったものとして扱います。
//: - initialized non-Copy payload を含む縮小 / 移動は Resource IR gate が保守的に検査します。
//:
//: 計算量:
//: - allocator の再確保と copy byte 数に依存します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/pointer/alloc" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_ptr<i32> 4:
//:         Result::Ok p:
//:             match realloc_ptr<i32> p 4 8:
//:                 Result::Ok q:
//:                     match dealloc_ptr<i32> q 8:
//:                         Result::Ok _:
//:                             1
//:                         Result::Err _:
//:                             0
//:                 Result::Err _:
//:                     match dealloc_ptr<i32> p 4:
//:                         Result::Ok _:
//:                             0
//:                         Result::Err _:
//:                             0
//:         Result::Err _:
//:             0
//: ```
pub fn realloc_ptr <.T> <(MemPtr<.T>,i32,i32)->Result<MemPtr<.T>,str>> (ptr, old_size, new_size):
    let raw <i32> mem_ptr_addr ptr;
    match realloc raw old_size new_size:
        Result::Ok next_ptr:
            Result<MemPtr<.T>,str>::Ok mem_ptr_wrap next_ptr
        Result::Err _e:
            Result<MemPtr<.T>,str>::Err "mem.realloc_ptr failed"

//: dealloc_ptr: MemPtr の backing storage を解放する
//:
//: 目的:
//: - pointer とサイズを allocator へ返し、storage の free obligation を閉じます。
//:
//: 実装(アルゴリズム):
//: - `MemPtr<T>` から internal raw view を取り出し、checked `dealloc` に委譲します。
//:
//: 注意(重要):
//: - `MemPtr<T>` 自体は Copy な non-owning view なので、所有権消費は compiler の Resource IR owner state で管理します。
//: - initialized non-Copy payload が残っている場合は storage-only free として拒否されます。
//:
//: 計算量:
//: - allocator の free list 挿入 / coalesce に依存し、最悪 O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/mem/pointer/alloc" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match alloc_ptr<u8> 1:
//:         Result::Ok p:
//:             match dealloc_ptr<u8> p 1:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _:
//:                     0
//:         Result::Err _:
//:             0
//: ```
pub fn dealloc_ptr <.T> <(MemPtr<.T>,i32)->Result<(),str>> (ptr, size):
    let raw <i32> mem_ptr_addr ptr;
    match dealloc raw size:
        Result::Ok _:
            Result<(),str>::Ok ()
        Result::Err _e:
            Result<(),str>::Err "mem.dealloc_ptr invalid pointer"
