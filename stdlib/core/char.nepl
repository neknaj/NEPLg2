//: char: Unicode scalar value と ASCII / UTF-8 helper を集めるライブラリ
//:
//: [目的/もくてき]:
//: - `char` primitive を stdlib から扱うための明示変換、ASCII 分類、UTF-8 encode 用 helper を提供します。
//: - `str` の byte API と混同しないよう、値としての文字は `char_*`、byte offset を扱う処理は `str_*` 側に分けます。
//:
//: [注意/ちゅうい]:
//: - `char` は Unicode scalar value です。surrogate range と `0x10FFFF` 超過は scalar value ではありません。
//: - `char_from_i32_result` は検証済み code point だけを `char` に戻します。検証なしの変換には `core/cast` を直接使わないでください。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"core_char_basic\" count=13 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"ascii codepoint\" expected=\"65\" actual=\"65\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"ascii alpha\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=2 status=ok kind=bool label=\"ascii digit\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=3 status=ok kind=bool label=\"ascii whitespace\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=4 status=ok kind=eq_i32 label=\"ascii utf8 len\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=5 status=ok kind=eq_i32 label=\"hiragana utf8 len\" expected=\"3\" actual=\"3\" message=\"\"\nassertion index=6 status=ok kind=eq_i32 label=\"ascii byte 0\" expected=\"65\" actual=\"65\" message=\"\"\nassertion index=7 status=ok kind=bool label=\"ascii byte 1 none\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=8 status=ok kind=eq_i32 label=\"hiragana byte 2\" expected=\"130\" actual=\"130\" message=\"\"\nassertion index=9 status=ok kind=bool label=\"negative byte none\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=10 status=ok kind=bool label=\"valid scalar accepted\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=11 status=ok kind=bool label=\"surrogate rejected\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=12 status=ok kind=bool label=\"too large rejected\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn expect_utf8_byte %fn str fn Option i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Option::Some byte:
//:             assert_eq_i32 label expected byte
//:         Option::None:
//:             assert label false
//:
//: fn main %impure fn void i32 \void:
//:     let a %char 'A'
//:     let hira %char '\u{3042}'
//:     let valid %Result char str char_from_i32_result 0x3042
//:     let surrogate %Result char str char_from_i32_result 0xD800
//:     let too_large %Result char str char_from_i32_result 0x110000
//:     let report:
//:         test_report_new "core_char_basic"
//:         |> test_report_push assert_eq_i32 "ascii codepoint" 65 char_to_i32 a
//:         |> test_report_push assert "ascii alpha" char_is_ascii_alpha a
//:         |> test_report_push assert "ascii digit" char_is_ascii_digit '7'
//:         |> test_report_push assert "ascii whitespace" char_is_ascii_whitespace '\n'
//:         |> test_report_push assert_eq_i32 "ascii utf8 len" 1 char_utf8_len a
//:         |> test_report_push assert_eq_i32 "hiragana utf8 len" 3 char_utf8_len hira
//:         |> test_report_push expect_utf8_byte "ascii byte 0" char_utf8_byte_at a 0 65
//:         |> test_report_push assert "ascii byte 1 none" is_none char_utf8_byte_at a 1
//:         |> test_report_push expect_utf8_byte "hiragana byte 2" char_utf8_byte_at hira 2 130
//:         |> test_report_push assert "negative byte none" is_none char_utf8_byte_at hira -1
//:         |> test_report_push assert "valid scalar accepted" is_ok valid
//:         |> test_report_push assert "surrogate rejected" is_err surrogate
//:         |> test_report_push assert "too large rejected" is_err too_large
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

#import "core/cast" as *
#import "core/math/i32" as *
#import "core/math/bool" as *
#import "core/option" as *
#import "core/result" as *

//: CharUtf8Step: UTF-8 decode の 1 step を表す
//:
//: [目的/もくてき]:
//: - 旧 tuple type を使わず、decode した `char` と次 byte offset を名前付き field で返します。
pub struct CharUtf8Step:
    value %char
    next %i32

impl Clone for CharUtf8Step:
    fn clone %fn &CharUtf8Step CharUtf8Step \x:
        *x

impl Copy for CharUtf8Step:
    fn copy_mark %fn CharUtf8Step CharUtf8Step \x:
        x

//: char_utf8_step_new: decode 結果と次 byte offset を `CharUtf8Step` にまとめる
//:
//: [目的/もくてき]:
//: - UTF-8 decoder が、decode した scalar value と次に読む byte offset を名前付き field で返せるようにします。
//:
//: [契約/けいやく]:
//: - `value` は decode 済みの `char`、`next` は caller が計算した次 byte offset です。
//: - この constructor は `next` の範囲検査を行いません。offset の妥当性は decoder 側の責務です。
//: - `CharUtf8Step` は `Copy` であり、owner cleanup は不要です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"char_utf8_step_new_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"step value\" expected=\"65\" actual=\"65\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"step next\" expected=\"3\" actual=\"3\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/field" as field
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let step %CharUtf8Step char_utf8_step_new 'A' 3
//:     let value_code %i32 char_to_i32 *field::get_ref &step "value"
//:     let next %i32 *field::get_ref &step "next"
//:     let report:
//:         test_report_new "char_utf8_step_new_doc"
//:         |> test_report_push assert_eq_i32 "step value" 65 value_code
//:         |> test_report_push assert_eq_i32 "step next" 3 next
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn char_utf8_step_new %fn char fn i32 CharUtf8Step \value\next:
    CharUtf8Step value next

//: char_to_i32: char の Unicode scalar value を i32 code point として返す
//:
//: [目的/もくてき]:
//: - `char` 変数を ASCII 分類、UTF-8 encode、parser 判定で使うための明示変換を提供します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn char_to_i32 %fn char i32 \c:
    cast c

//: char_is_valid_scalar_code: i32 が Unicode scalar value として妥当か判定する
//:
//: [目的/もくてき]:
//: - UTF-8 decoder や `char_from_i32_result` が、surrogate と範囲外 code point を拒否できるようにします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn char_is_valid_scalar_code %fn i32 bool \code:
    and:
        and ge code 0 le code 0x10FFFF
        not and ge code 0xD800 le code 0xDFFF

//: char_from_i32_result: code point を検証して char へ変換する
//:
//: [目的/もくてき]:
//: - UTF-8 decode などで得た i32 code point を、Unicode scalar value のときだけ `char` として返します。
//:
//: [注意/ちゅうい]:
//: - surrogate range と `0x10FFFF` 超過は `Err` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn char_from_i32_result %fn i32 Result char str \code:
    if:
        char_is_valid_scalar_code code
        then:
            Result::Ok %char cast code
        else:
            Result::Err "char.invalid scalar value"

//: char_to_u8_result: char を 1 byte の値として取り出す
//:
//: [目的/もくてき]:
//: - ASCII / binary 境界で、`0..=255` に収まる `char` だけを byte 値へ変換します。
//:
//: [注意/ちゅうい]:
//: - ASCII 専用 API ではありません。ASCII だけを受けたい場合は `char_is_ascii` も確認してください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn char_to_u8_result %fn char Result i32 str \c:
    let code %i32 char_to_i32 c
    if:
        and ge code 0 le code 255
        then:
            Result::Ok code
        else:
            Result::Err "char.not byte"

//: char_is_ascii: char が ASCII 範囲か判定する
pub fn char_is_ascii %fn char bool \c:
    le char_to_i32 c 0x7F

//: char_is_ascii_digit: char が ASCII 数字か判定する
pub fn char_is_ascii_digit %fn char bool \c:
    let code %i32 char_to_i32 c
    and ge code '0' le code '9'

//: char_is_ascii_upper: char が ASCII 大文字か判定する
pub fn char_is_ascii_upper %fn char bool \c:
    let code %i32 char_to_i32 c
    and ge code 'A' le code 'Z'

//: char_is_ascii_lower: char が ASCII 小文字か判定する
pub fn char_is_ascii_lower %fn char bool \c:
    let code %i32 char_to_i32 c
    and ge code 'a' le code 'z'

//: char_is_ascii_alpha: char が ASCII 英字か判定する
pub fn char_is_ascii_alpha %fn char bool \c:
    or char_is_ascii_upper c char_is_ascii_lower c

//: char_is_ascii_alnum: char が ASCII 英数字か判定する
pub fn char_is_ascii_alnum %fn char bool \c:
    or char_is_ascii_alpha c char_is_ascii_digit c

//: char_is_ascii_hex_digit: char が ASCII 16 進数字か判定する
pub fn char_is_ascii_hex_digit %fn char bool \c:
    let code %i32 char_to_i32 c
    let lower %bool and ge code 'a' le code 'f'
    let upper %bool and ge code 'A' le code 'F'
    or char_is_ascii_digit c or lower upper

//: char_is_ascii_whitespace: char が ASCII 空白文字か判定する
//:
//: [目的/もくてき]:
//: - space、tab、LF、CR、form feed、vertical tab を文字として分類します。
pub fn char_is_ascii_whitespace %fn char bool \c:
    match c:
        ' ':
            true
        '\t':
            true
        '\n':
            true
        '\r':
            true
        '\f':
            true
        '\x0b':
            true
        _:
            false

//: char_utf8_len: char を UTF-8 encode したときの byte 数を返す
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn char_utf8_len %fn char i32 \c:
    let code %i32 char_to_i32 c
    if:
        le code 0x7F
        then:
            1
        else:
            if:
                le code 0x7FF
                then:
                    2
                else:
                    if:
                        le code 0xFFFF
                        then:
                            3
                        else:
                            4

//: char_utf8_cont_byte: UTF-8 continuation byte を組み立てる
//:
//: [目的/もくてき]:
//: - UTF-8 encode helper が、既に shift 済みの payload bits から `10xxxxxx` 形式の byte を作ります。
//:
//: [契約/けいやく]:
//: - 戻り値は `0x80 | (bits & 0x3F)` です。
//: - caller は対象 code point のどの 6 bit を渡すかを事前に決めます。この helper は文字長や index の検査を行いません。
//: - 戻り値は常に `0x80..0xBF` に収まります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"char_utf8_cont_byte_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"continuation byte\" expected=\"130\" actual=\"130\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"continuation range\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let byte %i32 char_utf8_cont_byte 0x42
//:     let in_range %bool and ge byte 0x80 le byte 0xBF
//:     let report:
//:         test_report_new "char_utf8_cont_byte_doc"
//:         |> test_report_push assert_eq_i32 "continuation byte" 130 byte
//:         |> test_report_push assert "continuation range" in_range
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn char_utf8_cont_byte %fn i32 i32 \bits:
    or 0x80 and bits 0x3F

//: char_utf8_byte0: UTF-8 encode 後の 1 byte 目を返す
//:
//: [注意/ちゅうい]:
//: - `char_utf8_len` で必要 byte 数を確認してから使ってください。
pub fn char_utf8_byte0 %fn char i32 \c:
    let code %i32 char_to_i32 c
    if:
        le code 0x7F
        then:
            code
        else:
            if:
                le code 0x7FF
                then:
                    or 0xC0 shr_u code 6
                else:
                    if:
                        le code 0xFFFF
                        then:
                            or 0xE0 shr_u code 12
                        else:
                            or 0xF0 shr_u code 18

//: char_utf8_byte1: UTF-8 encode 後の 2 byte 目を返す
//:
//: [注意/ちゅうい]:
//: - public caller は `char_utf8_byte_at` を使い、存在しない byte を `Option::None` として扱ってください。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn main %fn void i32 \void:
//:     match char_utf8_byte_at '\u{00A2}' 1:
//:         Option::Some byte:
//:             if:
//:                 eq byte 162
//:                 then:
//:                     0
//:                 else:
//:                     1
//:         Option::None:
//:             1
//: ```
fn char_utf8_byte1 %fn char i32 \c:
    let code %i32 char_to_i32 c
    if:
        le code 0x7FF
        then:
            char_utf8_cont_byte code
        else:
            if:
                le code 0xFFFF
                then:
                    char_utf8_cont_byte shr_u code 6
                else:
                    char_utf8_cont_byte shr_u code 12

//: char_utf8_byte2: UTF-8 encode 後の 3 byte 目を返す
//:
//: [注意/ちゅうい]:
//: - public caller は `char_utf8_byte_at` を使い、存在しない byte を `Option::None` として扱ってください。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn main %fn void i32 \void:
//:     match char_utf8_byte_at '\u{3042}' 2:
//:         Option::Some byte:
//:             if:
//:                 eq byte 130
//:                 then:
//:                     0
//:                 else:
//:                     1
//:         Option::None:
//:             1
//: ```
fn char_utf8_byte2 %fn char i32 \c:
    let code %i32 char_to_i32 c
    if:
        le code 0xFFFF
        then:
            char_utf8_cont_byte code
        else:
            char_utf8_cont_byte shr_u code 6

//: char_utf8_byte3: UTF-8 encode 後の 4 byte 目を返す
//:
//: [注意/ちゅうい]:
//: - public caller は `char_utf8_byte_at` を使い、存在しない byte を `Option::None` として扱ってください。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn main %fn void i32 \void:
//:     match char_utf8_byte_at '\u{1F4AF}' 3:
//:         Option::Some byte:
//:             if:
//:                 eq byte 175
//:                 then:
//:                     0
//:                 else:
//:                     1
//:         Option::None:
//:             1
//: ```
fn char_utf8_byte3 %fn char i32 \c:
    char_utf8_cont_byte char_to_i32 c

//: char_utf8_byte_at: UTF-8 encode 後の byte を index で取り出す
//:
//: [目的/もくてき]:
//: - `char` を UTF-8 encode したとき、指定 index の byte が存在する場合だけ `Some(byte)` を返します。
//: - ASCII の index 1、3 byte 文字の index 3、負数 index など、存在しない位置は `None` として表します。
//:
//: [契約/けいやく]:
//: - `idx` は 0-based byte index です。
//: - 戻り値の byte は `0..=255` の i32 です。
//: - 欠如は sentinel 整数ではなく `Option::None` で返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"char_utf8_byte_at_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"ascii first byte\" expected=\"65\" actual=\"65\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"hiragana third byte\" expected=\"130\" actual=\"130\" message=\"\"\nassertion index=2 status=ok kind=bool label=\"ascii missing second byte\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/char" as *
//:| #import "core/option" as *
//:| #import "std/test" as *
//: fn expect_utf8_byte %fn str fn Option i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Option::Some byte:
//:             assert_eq_i32 label expected byte
//:         Option::None:
//:             assert label false
//:
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "char_utf8_byte_at_doc"
//:         |> test_report_push expect_utf8_byte "ascii first byte" char_utf8_byte_at 'A' 0 65
//:         |> test_report_push expect_utf8_byte "hiragana third byte" char_utf8_byte_at '\u{3042}' 2 130
//:         |> test_report_push assert "ascii missing second byte" is_none char_utf8_byte_at 'A' 1
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn char_utf8_byte_at %fn char fn i32 Option i32 \c\idx:
    let n %i32 char_utf8_len c
    match idx:
        0:
            some char_utf8_byte0 c
        1:
            if:
                lt 1 n
                then:
                    some char_utf8_byte1 c
                else:
                    none
        2:
            if:
                lt 2 n
                then:
                    some char_utf8_byte2 c
                else:
                    none
        3:
            if:
                lt 3 n
                then:
                    some char_utf8_byte3 c
                else:
                    none
        _:
            none
