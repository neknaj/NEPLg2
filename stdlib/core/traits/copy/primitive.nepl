#indent 4

//: copy/primitive: `Copy` / `Clone` の primitive capability
//:
//: [目的/もくてき]:
//: - compiler [内部/ないぶ]の[固定表/こていひょう]に[頼/たよ]らず、`.nepl` の trait [宣言/せんげん]と impl で primitive [型/かた]の copy/clone [能力/のうりょく]を[定義/ていぎ]します。
//: - default prelude から[読/よ]まれるため、heap allocator や pointer wrapper を import しない[軽量/けいりょう]な[境界/きょうかい]にします。
//:
//: [注意/ちゅうい]:
//: - `MemPtr .T` など stdlib [型/がた]の impl は、この file ではなく上位 facade の `core/traits/copy` 側に[置/お]きます。
//: - `i128` / `u128` は `core/math/int128/types` が[所有/しょゆう]する struct なので、Copy / Clone impl もその[型/かた]の module に[置/お]きます。
//: - prelude は[全/すべ]ての program で[暗黙/あんもく]に[読/よ]まれるため、ここへ heavy module を import してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - trait [宣言/せんげん]と primitive impl の[登録/とうろく]だけなので O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target wasm
//:| #no_prelude
//:| #import "core/traits/copy/primitive" as *
//: fn main %fn unit i32 \unit:
//:     let x %i32 1
//:     let y %i32 Clone::clone &x
//:     y
//: ```

//: Clone: [明示的/めいじてき]な[複製/ふくせい] capability
//:
//: [目的/もくてき]:
//: - `Clone::clone &x` の[形/かたち]で、[元/もと]の[値/あたい]を[消費/しょうひ]せずに[明示的/めいじてき]に[複製/ふくせい]できる[能力/のうりょく]を[表/あらわ]します。
//:
//: [注意/ちゅうい]:
//: - `Clone` が[独立/どくりつ]した[複製/ふくせい]か、[共有/きょうゆう]を[増/ふ]やす[複製/ふくせい]かは、各 impl の[意味/いみ]に[従/したが]います。
trait Clone:
    #capability clone
    fn clone %fn &Self Self \x:
        *x

//: Copy: [暗黙的/あんもくてき]な[再利用/さいりよう]を[許可/きょか]する capability
//:
//: [目的/もくてき]:
//: - `Copy` を[持/も]つ[型/かた]が、move ではなく copy として[扱/あつか]えることを[示/しめ]します。
//:
//: [注意/ちゅうい]:
//: - `Copy` は `Clone` より[強/つよ]い[制約/せいやく]です。
//: - [所有権/しょゆうけん]のある[資源/しげん]を[持/も]つ[型/かた]には impl しない[前提/ぜんてい]です。
trait Copy:
    #capability copy
    fn copy_mark %fn Self Self \x:
        x

//: bool は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for bool:
    fn clone %fn &bool bool \x:
        *x

impl Copy for bool:
    fn copy_mark %fn bool bool \x:
        x

//: char は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
//:
//: [目的/もくてき]:
//: - `char` は Unicode scalar value を i32 [幅/はば]で[表現/ひょうげん]する[値/あたい]型です。
//: - [所有権/しょゆうけん]を[持/も]たないため、move ではなく copy として[扱/あつか]えます。
impl Clone for char:
    fn clone %fn &char char \x:
        *x

impl Copy for char:
    fn copy_mark %fn char char \x:
        x

//: i32 は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for i32:
    fn clone %fn &i32 i32 \x:
        *x

impl Copy for i32:
    fn copy_mark %fn i32 i32 \x:
        x

//: i64 は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for i64:
    fn clone %fn &i64 i64 \x:
        *x

impl Copy for i64:
    fn copy_mark %fn i64 i64 \x:
        x

//: u8 は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for u8:
    fn clone %fn &u8 u8 \x:
        *x

impl Copy for u8:
    fn copy_mark %fn u8 u8 \x:
        x

//: f32 は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for f32:
    fn clone %fn &f32 f32 \x:
        *x

impl Copy for f32:
    fn copy_mark %fn f32 f32 \x:
        x

//: f64 は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
impl Clone for f64:
    fn clone %fn &f64 f64 \x:
        *x

impl Copy for f64:
    fn copy_mark %fn f64 f64 \x:
        x

//: str は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
//:
//: [目的/もくてき]:
//: - `str` は[長/なが]さつき[文字列/もじれつ] view であり、[所有権/しょゆうけん]を[持/も]たないため、[共有/きょうゆう] view の[複製/ふくせい]を capability として[明示/めいじ]します。
//:
//: [注意/ちゅうい]:
//: - [複製/ふくせい]されるのは[内容/ないよう]そのものではなく、view としての `str` です。
impl Clone for str:
    fn clone %fn &str str \x:
        *x

impl Copy for str:
    fn copy_mark %fn str str \x:
        x

//: unit は `Clone` / `Copy` の[両方/りょうほう]を[持/も]つ
//:
//: [目的/もくてき]:
//: - `unit` は[状態/じょうたい]を[持/も]たないため、move ではなく copy として[扱/あつか]ってよいことを[明示/めいじ]します。
impl Clone for unit:
    fn clone %fn &unit unit \x:
        *x

impl Copy for unit:
    fn copy_mark %fn (unit) unit \x:
        x
