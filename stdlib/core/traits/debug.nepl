//: debug: [開発者/かいはつしゃ][向/む]け[表示/ひょうじ]を[与/あた]える trait [群/ぐん]
//:
//: [目的/もくてき]:
//: - `Debug` trait を[標準化/ひょうじゅんか]し、[調査/ちょうさ]や[診断/しんだん]に[使/つか]う[文字列表現/もじれつひょうげん]を[揃/そろ]えます。
//:
//: [注意/ちゅうい]:
//: - `Debug` は[利用者/りようしゃ]向け[表示/ひょうじ]とは[限/かぎ]りません。
//: - [安定/あんてい]した[外部形式/がいぶけいしき]が[必要/ひつよう]な[場合/ばあい]は `Serialize` を[使/つか]う[予定/よてい]です。
//:
//: [計算量/けいさんりょう]:
//: - 各 impl に[依存/いぞん]します。

#indent 4

#import "alloc/string" as *
#import "core/cast" as *
#import "core/traits/stringify" as *

//: Debug: [開発者/かいはつしゃ][向/む]け[文字列表現/もじれつひょうげん]
trait Debug:
    fn debug_string %fn Self str \x:
        ""

//: debug_string: trait を[通/とお]して debug [文字列/もじれつ]を[得/え]る
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"debug_string_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"debug str quotes\" expected=\"\\\"hi\\\"\" actual=\"\\\"hi\\\"\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"debug i32\" expected=\"7\" actual=\"7\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/traits/debug" as *
//:| fn main %impure fn () i32 \():
//:     let text_str %str debug_string "hi"
//:     let text_i32 %str debug_string 7
//:     let report:
//:         test_report_new "debug_string_doc"
//:         |> test_report_push assert_str_eq "debug str quotes" "\"hi\"" text_str
//:         |> test_report_push assert_str_eq "debug i32" "7" text_i32
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
//:
//: [目的/もくてき]:
//: - [呼/よ]び[出/だ]し[側/がわ]で trait [名/めい]を[意識/いしき]せず debug [表示/ひょうじ]を[得/え]ます。
//:
//: [実装/じっそう]:
//: - `Debug::debug_string x` をそのまま[呼/よ]びます。
//:
//: [注意/ちゅうい]:
//: - `str` は[通常/つうじょう]の stringify と[区別/くべつ]できるよう、[引用符/いんようふ]を[付/つ]けて[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - impl に[依存/いぞん]します。
pub fn debug_string <.T: Debug> %fn .T str \x:
    Debug::debug_string x

impl Debug for str:
    fn debug_string %fn str str \x:
        concat3 "\"" x "\""

impl Debug for bool:
    fn debug_string %fn bool str \x:
        from_bool x

impl Debug for i32:
    fn debug_string %fn i32 str \x:
        from_i32 x

impl Debug for i64:
    fn debug_string %fn i64 str \x:
        from_i64 x

impl Debug for i128:
    fn debug_string %fn i128 str \x:
        from_i128 x

impl Debug for u8:
    fn debug_string %fn u8 str \x:
        from_i32 cast x

impl Debug for f32:
    fn debug_string %fn f32 str \x:
        from_f32 x

impl Debug for f64:
    fn debug_string %fn f64 str \x:
        from_f64 x
