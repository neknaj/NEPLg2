#indent 4

#import "core/cast" as *
#import "core/math" as *

//: memo traits: memo_call が key/value に要求する純粋性 contract
//:
//: [目的/もくてき]:
//: - `memo_call` の key と value が、通常の `Copy` とは別に満たすべき contract を表します。
//: - `MemoKey` は cache lookup に必要な同値性と hash が、外部状態や mutation に依存しないことを示します。
//: - `MemoValue` は cache から返しても内部 storage identity や resource lifecycle を外へ漏らさない値であることを示します。
//:
//: [注意/ちゅうい]:
//: - Phase 1 では primitive scalar と `unit` だけを標準実装として提供します。
//: - user-defined 型を key/value にする場合は、型の所有者が contract を確認して impl を明示します。
//: - `str`、reference、raw pointer、owner token、function value は compiler 側の Phase 1 predicate で拒否します。
//:
//: [計算量/けいさんりょう]:
//: - primitive 実装の比較と hash は O(1) です。

//: memo_key_mix32: 32-bit 整数を key 用 hash に混合する
//:
//: [目的/もくてき]:
//: - 小さな整数 key でも bucket 選択の下位 bit へ偏りが出にくいよう、軽量な avalanche 混合を行います。
fn memo_key_mix32 %fn i32 i32 \x:
    let x_s16 %i32 shr_u x 16
    let h1 %i32 xor x x_s16
    let h2 %i32 mul h1 -2048144789
    let h2_s13 %i32 shr_u h2 13
    let h3 %i32 xor h2 h2_s13
    let h4 %i32 mul h3 -1028477387
    let h4_s16 %i32 shr_u h4 16
    xor h4 h4_s16

//: MemoKey: memo cache の key にできる値
//:
//: [目的/もくてき]:
//: - key の同値性と hash が純粋で安定していることを、`Copy` とは別の trait として表します。
//:
//: [注意/ちゅうい]:
//: - `memo_key_eq a b` が true なら、`memo_key_hash32 a` と `memo_key_hash32 b` は同じ値になる必要があります。
trait MemoKey:
    fn memo_key_eq %fn Self fn Self bool \a\b:
        false

    fn memo_key_hash32 %fn Self i32 \self:
        0

//: MemoValue: memo cache から安全に返せる値
//:
//: [目的/もくてき]:
//: - cache 内部 storage への参照や observable identity を外へ漏らさない値であることを示します。
//:
//: [注意/ちゅうい]:
//: - この trait は `Copy` の代替ではありません。`memo_call` Phase 1 では `MemoValue&Copy` を同時に要求します。
trait MemoValue:
    fn memo_value_mark %fn Self Self \value:
        value

//: memo_key_equal: `MemoKey` trait 経由で key 同士を比較する
//:
//: [目的/もくてき]:
//: - cache 実装側が具体型の関数名に依存せず、`MemoKey` の同値性を呼び出せる入口にします。
pub fn memo_key_equal <.T: MemoKey> %fn .T fn .T bool \a\b:
    MemoKey::memo_key_eq a b

//: memo_key_hash32_value: `MemoKey` trait 経由で 32-bit hash を得る
//:
//: [目的/もくてき]:
//: - cache 実装側が key 型ごとの hash 実装を trait call として扱えるようにします。
pub fn memo_key_hash32_value <.T: MemoKey> %fn .T i32 \key:
    MemoKey::memo_key_hash32 key

impl MemoKey for unit:
    // memo_key_eq(unit): `unit` key は常に同じ値として比較する
    fn memo_key_eq %fn unit fn unit bool \a\b:
        true

    // memo_key_hash32(unit): singleton key の hash を固定値にする
    fn memo_key_hash32 %fn unit i32 \self:
        0

impl MemoValue for unit:
    // memo_value_mark(unit): `unit` は内部 identity を持たない値としてそのまま返せる
    fn memo_value_mark %fn unit unit \value:
        value

impl MemoKey for bool:
    // memo_key_eq(bool): boolean key を真理値として比較する
    fn memo_key_eq %fn bool fn bool bool \a\b:
        if a then b else not b

    // memo_key_hash32(bool): false/true を 0/1 として hash にする
    fn memo_key_hash32 %fn bool i32 \self:
        if self 1 0

impl MemoValue for bool:
    // memo_value_mark(bool): boolean は内部 storage identity を持たない値としてそのまま返せる
    fn memo_value_mark %fn bool bool \value:
        value

impl MemoKey for char:
    // memo_key_eq(char): Unicode scalar value を整数表現で比較する
    fn memo_key_eq %fn char fn char bool \a\b:
        eq %i32 cast a %i32 cast b

    // memo_key_hash32(char): Unicode scalar value の整数表現を hash にする
    fn memo_key_hash32 %fn char i32 \self:
        cast self

impl MemoValue for char:
    // memo_value_mark(char): char は内部 storage identity を持たない値としてそのまま返せる
    fn memo_value_mark %fn char char \value:
        value

impl MemoKey for i32:
    // memo_key_eq(i32): 32-bit 整数 key を値で比較する
    fn memo_key_eq %fn i32 fn i32 bool \a\b:
        eq a b

    // memo_key_hash32(i32): 32-bit 整数 key の bit pattern を hash の基礎値にする
    fn memo_key_hash32 %fn i32 i32 \self:
        self

impl MemoValue for i32:
    // memo_value_mark(i32): 32-bit 整数は内部 storage identity を持たない値としてそのまま返せる
    fn memo_value_mark %fn i32 i32 \value:
        value

impl MemoKey for u8:
    // memo_key_eq(u8): byte key を整数表現で比較する
    fn memo_key_eq %fn u8 fn u8 bool \a\b:
        eq %i32 cast a %i32 cast b

    // memo_key_hash32(u8): byte key を i32 に広げて hash にする
    fn memo_key_hash32 %fn u8 i32 \self:
        cast self

impl MemoValue for u8:
    // memo_value_mark(u8): byte は内部 storage identity を持たない値としてそのまま返せる
    fn memo_value_mark %fn u8 u8 \value:
        value

impl MemoValue for f32:
    // memo_value_mark(f32): f32 は value としては返せるが、MemoKey は NaN 等の同値性を設計するまで実装しない
    fn memo_value_mark %fn f32 f32 \value:
        value
