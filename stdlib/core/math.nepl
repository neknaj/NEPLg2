//: math: core/math.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//: - `as @merge` により `#import "core/math" as math` の qualified API でも再 export 先の関数を参照できます。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target core
//:| fn main %impure fn void i32 \void:
//:     unit
//:     0
//: ```

#indent 4
pub #import "./math/i32" as @merge
pub #import "./math/i64" as @merge
pub #import "./math/f32" as @merge
pub #import "./math/f64" as @merge
pub #import "./math/convert" as @merge
pub #import "./math/u8" as @merge
pub #import "./math/bool" as @merge
pub #import "./math/int128" as @merge
