//: cast: core/cast.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/result" as *
#import "core/field" as *

//: cast: 型変換ユーティリティ
//:
//: [目的/もくてき]:
//: - 数値型どうしの変換と、数値変換を伴わないビット列の再解釈を提供します。
//: - 変換の意味が異なる処理を同じ `cast` 名にまとめ、型シグネチャで使い分けます。
//:
//: [注意/ちゅうい]:
//: - `bitcast_*` は数値変換ではなくビット列の再解釈です。
//: - ポインタの再解釈は型安全化方針に反するため、このモジュールでは公開しません。
//: - 範囲外の浮動小数点数を整数に変換した場合の扱いは、基盤命令の仕様に従います。
//:
//: [計算量/けいさんりょう]:
//: - すべて O(1) です。

//: cast: i32 を f32 に数値変換する
//:
//: [目的/もくてき]:
//: - 符号付き 32 bit 整数を単精度浮動小数点数として表します。
//:
//: [実装/じっそう]:
//: - `i32_to_f32` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - f32 で正確に表せない大きな整数は丸められます。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(i32)->f32> (v):
    #intrinsic "i32_to_f32" <> (v)

//: cast: f32 を i32 に数値変換する
//:
//: [目的/もくてき]:
//: - 単精度浮動小数点数を符号付き 32 bit 整数へ変換します。
//:
//: [実装/じっそう]:
//: - `f32_to_i32` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - 飽和変換ではありません。NaN や範囲外の値は基盤命令の失敗条件に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(f32)->i32> (v):
    #intrinsic "f32_to_i32" <> (v)

//: cast: bool を i32 に変換する
//:
//: [目的/もくてき]:
//: - `true` を 1、`false` を 0 として返します。
//:
//: [実装/じっそう]:
//: - 真偽値分岐で 1 または 0 を選びます。
//:
//: [注意/ちゅうい]:
//: - 数値型から bool へ戻す場合は `cast <(i32)->bool>` の 0 判定と対になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(bool)->i32> (v):
    if:
        v
        then:
            1
        else:
            0

//: cast: i32 を bool に変換する
//:
//: [目的/もくてき]:
//: - 0 を `false`、0 以外を `true` として返します。
//:
//: [実装/じっそう]:
//: - `ne v 0` で 0 との不一致を判定します。
//:
//: [注意/ちゅうい]:
//: - 1 だけでなく、負数や 2 以上の値も `true` として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(i32)->bool> (v):
    ne v 0

//: cast: i32 を u8 に変換する
//:
//: [目的/もくてき]:
//: - i32 の下位 8 bit を取り出して u8 値として扱います。
//:
//: [実装/じっそう]:
//: - `i32_to_u8` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - 範囲検査ではなく 0xff マスク相当の縮小変換です。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(i32)->u8> (v):
    #intrinsic "i32_to_u8" <> (v)

//: cast: u8 を i32 に変換する
//:
//: [目的/もくてき]:
//: - u8 値を 0 以上 255 以下の i32 として返します。
//:
//: [実装/じっそう]:
//: - `u8_to_i32` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - 符号拡張ではなくゼロ拡張の意味で使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(u8)->i32> (v):
    #intrinsic "u8_to_i32" <> (v)

//: cast: char を Unicode scalar value の i32 code point へ変換する
//:
//: [目的/もくてき]:
//: - `char` 変数を byte / UTF-8 / parser code で扱うため、明示的に code point として取り出します。
//:
//: [注意/ちゅうい]:
//: - char literal の文脈型変換とは別の明示 API です。`char` 変数は暗黙には整数へ変換されません。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(char)->i32> (v):
    #intrinsic "char_to_i32" <> (v)

//: cast: i32 code point を char へ変換する
//:
//: [目的/もくてき]:
//: - UTF-8 decoder などが検証済み code point を `char` 値へ戻せるようにします。
//:
//: [注意/ちゅうい]:
//: - 範囲検査は行いません。通常は `core/char` の `char_from_i32_result` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn cast <(i32)->char> (v):
    #intrinsic "i32_to_char" <> (v)

//: bitcast_i32_to_f32: i32 のビット列を f32 として再解釈する
//:
//: [目的/もくてき]:
//: - i32 の 32 bit の並びを保ったまま、f32 の値として読み直します。
//:
//: [実装/じっそう]:
//: - `reinterpret_i32_f32` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - 数値変換ではありません。例えば整数 1 は浮動小数点数 1.0 にはなりません。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn bitcast_i32_to_f32 <(i32)->f32> (v):
    #intrinsic "reinterpret_i32_f32" <> (v)

//: bitcast_f32_to_i32: f32 のビット列を i32 として再解釈する
//:
//: [目的/もくてき]:
//: - f32 の 32 bit の並びを保ったまま、i32 の値として読み直します。
//:
//: [実装/じっそう]:
//: - `reinterpret_f32_i32` intrinsic に委譲します。
//:
//: [注意/ちゅうい]:
//: - 数値の丸めや切り捨ては行いません。ビット単位での検査や保存に使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn bitcast_f32_to_i32 <(f32)->i32> (v):
    #intrinsic "reinterpret_f32_i32" <> (v)

//: cast: i32 を i64 に変換する
pub fn cast <(i32)->i64> (v):
    extend_s v

//: cast: i32 を u32 に変換する
pub fn cast <(i32)->u32> (v):
    #intrinsic "i32_to_u32" <> (v)

//: cast: u32 を i32 に変換する
pub fn cast <(u32)->i32> (v):
    #intrinsic "u32_to_i32" <> (v)

//: cast: i64 を i32 に変換する
pub fn cast <(i64)->i32> (v):
    wrap v

//: cast: i64 を u64 に変換する
pub fn cast <(i64)->u64> (v):
    #intrinsic "i64_to_u64" <> (v)

//: cast: u64 を i64 に変換する
pub fn cast <(u64)->i64> (v):
    #intrinsic "u64_to_i64" <> (v)

//: cast: i32 を f64 に変換する
pub fn cast <(i32)->f64> (v):
    convert_s v

//: cast: f64 を i32 に変換する
pub fn cast <(f64)->i32> (v):
    trunc_s v

//: cast: i64 を f64 に変換する
pub fn cast <(i64)->f64> (v):
    convert_s v

//: cast: f64 を i64 に変換する
pub fn cast <(f64)->i64> (v):
    trunc_s v

//: cast: i64 を f32 に変換する
pub fn cast <(i64)->f32> (v):
    convert_s v

//: cast: f32 を i64 に変換する
pub fn cast <(f32)->i64> (v):
    trunc_s v

//: cast: f32 を f64 に昇格する
pub fn cast <(f32)->f64> (v):
    promote v

//: cast: f64 を f32 に縮小する
pub fn cast <(f64)->f32> (v):
    demote v

//: cast: i64 を i128 に変換する
pub fn cast <(i64)->i128> (v):
    to_i128 v

//: cast: i128 を i64 に変換する
pub fn cast <(i128)->i64> (v):
    get v "lo"

//: cast: i32 を i128 に変換する
pub fn cast <(i32)->i128> (v):
    to_i128 extend_s v

//: cast: i128 を i32 に変換する
pub fn cast <(i128)->i32> (v):
    wrap get v "lo"
