//: # streamio
//: `alloc/io` の stream [抽象/ちゅうしょう]を `std` の stdin/stdout と buffered sink へ[接続/せつぞく]する facade
//:
//: ### [目的/もくてき]
//: - `std/stdio` が[持/も]つ stdin/stdout/stderr の[入口/いりぐち]を、reboot [後/ご]の `alloc/io` trait [群/ぐん]と `read` / `write` / `flush` / `close` の[共通名/きょうつうめい]へ[載/の]せ[替/か]えます。
//: - binary stream を[基準/きじゅん]にしつつ text helper と buffered stdout sink を[併設/へいせつ]し、`kpwrite` / `kpread` や[将来/しょうらい]の file/socket stream の[昇格/しょうかく][先/さき]を[用意/ようい]します。
//:
//: ### [注意/ちゅうい]
//: - `StdoutStream` / `StderrStream` は `std/stdio` の Result API を[通/とお]して write error を `StdErrorKind::IoError` として[返/かえ]します。
//: - stdin の text read は `std/stdio.read_all` に[従/したが]い、EOF までの[全体/ぜんたい]を `str` として[読/よ]み[込/こ]みます。
//: - stdin の byte read と `StreamScanner` は、binary [経路/けいろ]として EOF までの[全体/ぜんたい]を `ByteBuf` / scanner buffer に[保持/ほじ]します。
//:
//: ### [計算量/けいさんりょう]
//: - byte/text の[相互/そうご][変換/へんかん]は O(n) です。
//: - buffered sink の append は O(len) / O(桁数)、flush は[現在/げんざい]の[保留/ほりゅう] byte [数/すう]を n として O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/streamio" as *
//:| #import "std/iotarget" as *
//: fn main <()*>i32> ():
//:     let bytes0 <ByteBuf> stream_bytes_from_str "ab";
//:     let _len <i32> io_bytebuf_len_ref &bytes0;
//:     io_bytebuf_free bytes0;
//:     let sc <StreamScanner> unwrap_ok open ReadStream::Text "1 2";
//:     let a <i32> read sc;
//:     let b <i32> read sc;
//:     close sc;
//:     unwrap_ok open WriteStream::Stdio
//:     |> write "x"
//:     |> writeln add a b
//:     |> close;
//:     0
//: ```

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/fs" as *
#import "std/iotarget" as *
#import "std/stdio" as *
#import "std/text" as *
pub #import "./streamio/writer" as *
pub #import "./streamio/bytes" as *
pub #import "./streamio/scanner" as *

//: ## StdinStream
//: [標準入力/ひょうじゅんにゅうりょく]を[表/あらわ]す[軽量/けいりょう] handle
//:
//: ### [目的/もくてき]
//: - `alloc/io` の reader trait [群/ぐん]に stdin を[載/の]せるための[具体型/ぐたいかた]を[与/あた]えます。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ][状態/じょうたい]を[持/も]たないので `Copy` / `Clone` を[実装/じっそう]します。
struct StdinStream:
    marker <()>

impl Copy for StdinStream:
    fn copy_mark <(StdinStream)->StdinStream> (stream):
        stream

impl Clone for StdinStream:
    fn clone <(&StdinStream)->StdinStream> (stream):
        *stream

//: ## StdoutStream
//: [標準出力/ひょうじゅんしゅつりょく]を[表/あらわ]す[軽量/けいりょう] handle
//:
//: ### [目的/もくてき]
//: - `alloc/io` の write / flush / close trait [群/ぐん]に stdout を[載/の]せるための[具体型/ぐたいかた]を[与/あた]えます。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ][状態/じょうたい]を[持/も]たないので `Copy` / `Clone` を[実装/じっそう]します。
struct StdoutStream:
    marker <()>

impl Copy for StdoutStream:
    fn copy_mark <(StdoutStream)->StdoutStream> (stream):
        stream

impl Clone for StdoutStream:
    fn clone <(&StdoutStream)->StdoutStream> (stream):
        *stream

//: ## StderrStream
//: [標準エラー/ひょうじゅんえらー]を[表/あらわ]す[軽量/けいりょう] handle
//:
//: ### [目的/もくてき]
//: - diagnostic や progress log を stdout の artifact / JSON と[分離/ぶんり]して[書/か]けるようにします。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ][状態/じょうたい]を[持/も]たないので `Copy` / `Clone` を[実装/じっそう]します。
struct StderrStream:
    marker <()>

impl Copy for StderrStream:
    fn copy_mark <(StderrStream)->StderrStream> (stream):
        stream

impl Clone for StderrStream:
    fn clone <(&StderrStream)->StderrStream> (stream):
        *stream

//: ## TextInputStream
//: in-memory text を stream として[扱/あつか]う[軽量/けいりょう] handle
//:
//: ### [目的/もくてき]
//: - `ReadStream::Text "..."` から[入力/にゅうりょく] stream を[作/つく]り、stdin や file read と[同/おな]じ `read` [面/めん]へ[載/の]せます。
//:
//: ### [注意/ちゅうい]
//: - [現在/げんざい]は[全読込/ぜんよみこみ] helper だけを[想定/そうてい]した in-memory source です。
struct TextInputStream:
    text <str>

//: ## ByteInputStream
//: raw binary を stream として[扱/あつか]う in-memory input handle
//:
//: ### [目的/もくてき]
//: - `ReadStream::Bytes bytes` から binary input stream を[作/つく]り、stdin や file read と[同/おな]じ `read` [面/めん]へ[載/の]せます。
//:
//: ### [注意/ちゅうい]
//: - `bytes` は stream [内部/ないぶ]へ[所有権/しょゆうけん]ごと[移動/いどう]します。
struct ByteInputStream:
    bytes <ByteBuf>

impl ByteReader for StdinStream:
    fn read_all_bytes <(StdinStream)*>Result<ByteBuf, StdErrorKind>> (_stream):
        stdio_read_all_bytes_result

impl TextReader for StdinStream:
    fn read_all_text <(StdinStream)*>Result<str, StdErrorKind>> (_stream):
        stdio_read_all_text_result

impl ByteReader for TextInputStream:
    fn read_all_bytes <(TextInputStream)*>Result<ByteBuf, StdErrorKind>> (stream):
        io_bytebuf_from_str_result get stream "text"

impl TextReader for TextInputStream:
    fn read_all_text <(TextInputStream)*>Result<str, StdErrorKind>> (stream):
        Result::Ok get stream "text"

impl Close for TextInputStream:
    fn close <(TextInputStream)*>Result<(), StdErrorKind>> (_stream):
        Result::Ok ()

impl ByteReader for ByteInputStream:
    fn read_all_bytes <(ByteInputStream)*>Result<ByteBuf, StdErrorKind>> (stream):
        Result::Ok get stream "bytes"

impl TextReader for ByteInputStream:
    fn read_all_text <(ByteInputStream)*>Result<str, StdErrorKind>> (stream):
        text_bytebuf_to_utf8_str_result get stream "bytes"

impl Close for ByteInputStream:
    fn close <(ByteInputStream)*>Result<(), StdErrorKind>> (_stream):
        Result::Ok ()

impl Close for StdinStream:
    fn close <(StdinStream)*>Result<(), StdErrorKind>> (_stream):
        Result::Ok ()

//: ## write_bytes_result
//: `StdoutStream` へ byte [列/れつ]を[書/か]き、失敗を `Result` で[返/かえ]す
fn write_bytes_result <(StdoutStream, ByteBuf)*>Result<StdoutStream, StdErrorKind>> (stream, bytes):
    match stdio_write_bytes_result bytes:
        Result::Ok _:
            Result<StdoutStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## write_str_result
//: `StdoutStream` へ text を[書/か]き、失敗を `Result` で[返/かえ]す
fn write_str_result <(StdoutStream, str)*>Result<StdoutStream, StdErrorKind>> (stream, text):
    match stdio_write_str_result text:
        Result::Ok _:
            Result<StdoutStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## flush_result
//: `StdoutStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
fn flush_result <(StdoutStream)*>Result<StdoutStream, StdErrorKind>> (stream):
    Result::Ok stream

//: ## write_bytes_result
//: `StderrStream` へ byte [列/れつ]を[書/か]き、失敗を `Result` で[返/かえ]す
fn write_bytes_result <(StderrStream, ByteBuf)*>Result<StderrStream, StdErrorKind>> (stream, bytes):
    match stdio_write_stderr_bytes_result bytes:
        Result::Ok _:
            Result<StderrStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## write_str_result
//: `StderrStream` へ text を[書/か]き、失敗を `Result` で[返/かえ]す
fn write_str_result <(StderrStream, str)*>Result<StderrStream, StdErrorKind>> (stream, text):
    match stdio_write_stderr_str_result text:
        Result::Ok _:
            Result<StderrStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## flush_result
//: `StderrStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
fn flush_result <(StderrStream)*>Result<StderrStream, StdErrorKind>> (stream):
    Result::Ok stream

impl ByteWriter for StdoutStream:
    fn write_bytes <(StdoutStream, ByteBuf)*>Result<StdoutStream, StdErrorKind>> (stream, bytes):
        write_bytes_result stream bytes

impl TextWriter for StdoutStream:
    fn write_str <(StdoutStream, str)*>Result<StdoutStream, StdErrorKind>> (stream, text):
        write_str_result stream text

impl Flush for StdoutStream:
    fn flush <(StdoutStream)*>Result<StdoutStream, StdErrorKind>> (stream):
        flush_result stream

impl Close for StdoutStream:
    fn close <(StdoutStream)*>Result<(), StdErrorKind>> (_stream):
        Result::Ok ()

impl ByteWriter for StderrStream:
    fn write_bytes <(StderrStream, ByteBuf)*>Result<StderrStream, StdErrorKind>> (stream, bytes):
        write_bytes_result stream bytes

impl TextWriter for StderrStream:
    fn write_str <(StderrStream, str)*>Result<StderrStream, StdErrorKind>> (stream, text):
        write_str_result stream text

impl Flush for StderrStream:
    fn flush <(StderrStream)*>Result<StderrStream, StdErrorKind>> (stream):
        flush_result stream

impl Close for StderrStream:
    fn close <(StderrStream)*>Result<(), StdErrorKind>> (_stream):
        Result::Ok ()

//: ## StreamReadableResult
//: input stream を[指定/してい]した[型/かた]として[読/よ]み[出/だ]す[能力/のうりょく]
trait StreamReadableResult:
    fn read_from_stdin <(StdinStream)*>Result<Self, StdErrorKind>> (_stream):
        Result::Err StdErrorKind::InvalidOperation

    fn read_from_text_stream <(TextInputStream)*>Result<Self, StdErrorKind>> (_stream):
        Result::Err StdErrorKind::InvalidOperation

    fn read_from_byte_stream <(ByteInputStream)*>Result<Self, StdErrorKind>> (_stream):
        Result::Err StdErrorKind::InvalidOperation

impl StreamReadableResult for ByteBuf:
    fn read_from_stdin <(StdinStream)*>Result<ByteBuf, StdErrorKind>> (stream):
        io_read_all_bytes stream

    fn read_from_text_stream <(TextInputStream)*>Result<ByteBuf, StdErrorKind>> (stream):
        io_read_all_bytes stream

    fn read_from_byte_stream <(ByteInputStream)*>Result<ByteBuf, StdErrorKind>> (stream):
        io_read_all_bytes stream

impl StreamReadableResult for str:
    fn read_from_stdin <(StdinStream)*>Result<str, StdErrorKind>> (stream):
        io_read_all_text stream

    fn read_from_text_stream <(TextInputStream)*>Result<str, StdErrorKind>> (stream):
        io_read_all_text stream

    fn read_from_byte_stream <(ByteInputStream)*>Result<str, StdErrorKind>> (stream):
        io_read_all_text stream

//: ## StdoutWritable
//: `StdoutStream` へ[書/か]き[込/こ]める[値/あたい]の[能力/のうりょく]
trait StdoutWritable:
    fn emit <(StdoutStream,Self)*>Result<StdoutStream, StdErrorKind>> (stream, value):
        Result::Err StdErrorKind::InvalidOperation

//: ## StderrWritable
//: `StderrStream` へ[書/か]き[込/こ]める[値/あたい]の[能力/のうりょく]
trait StderrWritable:
    fn emit <(StderrStream,Self)*>Result<StderrStream, StdErrorKind>> (stream, value):
        Result::Err StdErrorKind::InvalidOperation

//: ## read
//: `StdinStream` を[指定/してい]した[型/かた]として[読/よ]む
fn read <.T: StreamReadableResult> <(StdinStream)*>Result<.T, StdErrorKind>> (stream):
    StreamReadableResult::read_from_stdin stream

//: ## read
//: in-memory text stream を[指定/してい]した[型/かた]として[読/よ]む
fn read <.T: StreamReadableResult> <(TextInputStream)*>Result<.T, StdErrorKind>> (stream):
    StreamReadableResult::read_from_text_stream stream

//: ## read
//: in-memory byte stream を[指定/してい]した[型/かた]として[読/よ]む
fn read <.T: StreamReadableResult> <(ByteInputStream)*>Result<.T, StdErrorKind>> (stream):
    StreamReadableResult::read_from_byte_stream stream

impl StdoutWritable for ByteBuf:
    fn emit <(StdoutStream,ByteBuf)*>Result<StdoutStream, StdErrorKind>> (stream, value):
        io_write_bytes stream value

impl StdoutWritable for str:
    fn emit <(StdoutStream,str)*>Result<StdoutStream, StdErrorKind>> (stream, value):
        io_write_str stream value

impl StderrWritable for ByteBuf:
    fn emit <(StderrStream,ByteBuf)*>Result<StderrStream, StdErrorKind>> (stream, value):
        io_write_bytes stream value

impl StderrWritable for str:
    fn emit <(StderrStream,str)*>Result<StderrStream, StdErrorKind>> (stream, value):
        io_write_str stream value

//: ## write
//: `StdoutStream` へ byte [列/れつ]や text を[書/か]く
fn write <.T: StdoutWritable> <(StdoutStream,.T)*>Result<StdoutStream, StdErrorKind>> (stream, value):
    StdoutWritable::emit stream value

//: ## write
//: pipe [終端/しゅうたん]から `StdoutStream` へ byte [列/れつ]や text を[書/か]く overload
fn write <.T: StdoutWritable> <(.T, StdoutStream)*>Result<StdoutStream, StdErrorKind>> (value, stream):
    StdoutWritable::emit stream value

//: ## writeln
//: `StdoutStream` へ text と `\n` を[続/つづ]けて[書/か]く
fn writeln <(StdoutStream, str)*>Result<StdoutStream, StdErrorKind>> (stream, text):
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## writeln
//: pipe [終端/しゅうたん]から `StdoutStream` へ text と `\n` を[続/つづ]けて[書/か]く overload
fn writeln <(str, StdoutStream)*>Result<StdoutStream, StdErrorKind>> (text, stream):
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## flush
//: `StdoutStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
fn flush <(StdoutStream)*>Result<StdoutStream, StdErrorKind>> (stream):
    io_flush stream

//: ## write
//: `StderrStream` へ byte [列/れつ]や text を[書/か]く
fn write <.T: StderrWritable> <(StderrStream,.T)*>Result<StderrStream, StdErrorKind>> (stream, value):
    StderrWritable::emit stream value

//: ## write
//: pipe [終端/しゅうたん]から `StderrStream` へ byte [列/れつ]や text を[書/か]く overload
fn write <.T: StderrWritable> <(.T, StderrStream)*>Result<StderrStream, StdErrorKind>> (value, stream):
    StderrWritable::emit stream value

//: ## writeln
//: `StderrStream` へ text と `\n` を[続/つづ]けて[書/か]く
fn writeln <(StderrStream, str)*>Result<StderrStream, StdErrorKind>> (stream, text):
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## writeln
//: pipe [終端/しゅうたん]から `StderrStream` へ text と `\n` を[続/つづ]けて[書/か]く overload
fn writeln <(str, StderrStream)*>Result<StderrStream, StdErrorKind>> (text, stream):
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## flush
//: `StderrStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
fn flush <(StderrStream)*>Result<StderrStream, StdErrorKind>> (stream):
    io_flush stream

//: ## close
//: `StdinStream` を[閉/と]じる
fn close <(StdinStream)*>Result<(), StdErrorKind>> (stream):
    io_close stream

//: ## close
//: `TextInputStream` を[閉/と]じる
fn close <(TextInputStream)*>Result<(), StdErrorKind>> (stream):
    io_close stream

//: ## close
//: `ByteInputStream` を[閉/と]じる
fn close <(ByteInputStream)*>Result<(), StdErrorKind>> (stream):
    io_close stream

//: ## close
//: `StdoutStream` を[閉/と]じる
fn close <(StdoutStream)*>Result<(), StdErrorKind>> (stream):
    io_close stream

//: ## close
//: `StderrStream` を[閉/と]じる
fn close <(StderrStream)*>Result<(), StdErrorKind>> (stream):
    io_close stream
