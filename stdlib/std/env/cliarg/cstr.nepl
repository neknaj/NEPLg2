//: # env/cliarg/cstr
//: argv raw pointer から NEPL `str` へ変換する helper
//:
//: ### [目的/もくてき]
//: - NUL 終端 C string の長さ計測と `str` コピーを `cliarg` root から分離します。
//: - argv byte buffer の残り長を受け取り、NUL がその範囲内にあることを確認してから `str` へコピーします。
//: - public `cliarg_get` は argv buffer の寿命と独立した UTF-8 `str` を、この module の bounded 境界を通して作ります。

#indent 4

#import "alloc/string" as *
#import "alloc/string/storage" as *
#import "core/mem" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *

//: cstr_len_bounded_result: NUL 終端文字列の長さを bounded checked load で求める
//:
//: 目的:
//: - `MemPtr<u8>` と読み取り上限で与えられた C 文字列の長さを返します。
//: - NUL が上限内に見つからない場合は `Err` にします。
//:
//: 実装(アルゴリズム):
//: - 1 バイトずつ読み、0 に達したら停止します。
//: - `max_len` byte を読み切る前に必ず停止し、上限の外へ pointer を進めません。
//:
//: 注意(重要):
//: - `p` は `max_len` byte の有効な範囲内に NUL 終端を持つ必要があります。
//: - 無効 pointer に到達した場合は `Err` を返します。
//:
//: 計算量:
//: - O(min(n, max_len))
//: cstr_len_bounded_result: 使い方の最小例
//:
//: [目的/もくてき]:
//: - NUL を含む文字列 literal の data pointer と上限を渡し、上限内の NUL で停止することを確認します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/env/cliarg/cstr" as *
//:| #import "alloc/string/storage" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let p <MemPtr<u8>> string_data_ptr "nep\0";
//:     match cstr_len_bounded_result p 4:
//:         Result::Ok n:
//:             if eq n 3 0 1
//:         Result::Err _:
//:             1
//: ```
pub fn cstr_len_bounded_result <(MemPtr<u8>,i32)*>Result<i32,str>> (p, max_len):
    if:
        le max_len 0
        then:
            Result<i32,str>::Err "cliarg.cstr_len empty bound"
        else:
            let mut i <i32> 0
            let mut done <i32> 0
            let mut ok <i32> 1
            while and and eq done 0 eq ok 1 lt i max_len:
                do:
                    match load_u8 mem_ptr_add p i:
                        Option::Some b:
                            if:
                                cond:
                                    eq b 0
                                then:
                                    set done 1;
                                else:
                                    set i add i 1
                        Option::None:
                            set ok 0
            if:
                eq ok 0
                then:
                    Result<i32,str>::Err "cliarg.cstr_len invalid pointer"
                else:
                    if:
                        eq done 1
                        then:
                            Result<i32,str>::Ok i
                        else:
                            Result<i32,str>::Err "cliarg.cstr_len missing nul terminator"

//: cstr_to_str_bounded_result: NUL 終端文字列を UTF-8 検証して `str` にコピーする
//:
//: 目的:
//: - `MemPtr<u8>` と読み取り上限で与えられた C 文字列を、独立した `str` にコピーします。
//: - NUL 終端が上限内にあることと、NUL より前の byte 列が UTF-8 として妥当であることを確認します。
//:
//: 実装(アルゴリズム):
//: - `cstr_len_bounded_result` で NUL の位置を求めます。
//: - `string_from_utf8_mem_result` に委譲し、UTF-8 検証と string owner transfer を `alloc/string` 境界で行います。
//:
//: 注意(重要):
//: - 呼び出しごとに新しい領域を確保します。
//: - 返り値は元の C 文字列の寿命と独立です。
//: - NUL 不在、無効 pointer、UTF-8 不正、確保失敗は `Err` として呼び出し側へ返します。
//:
//: 計算量:
//: - O(min(n, max_len))
//: cstr_to_str_bounded_result: 使い方の最小例
//:
//: [目的/もくてき]:
//: - NUL を含む文字列 literal を上限付きで `str` にコピーする典型例を示します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/env/cliarg/cstr" as *
//:| #import "alloc/string/storage" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let p <MemPtr<u8>> string_data_ptr "nep\0";
//:     match cstr_to_str_bounded_result p 4:
//:         Result::Ok s:
//:             if str_eq s "nep" 0 1
//:         Result::Err _:
//:             1
//: ```
pub fn cstr_to_str_bounded_result <(MemPtr<u8>,i32)*>Result<str,str>> (p, max_len):
    match cstr_len_bounded_result p max_len:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok len:
            match string_from_utf8_mem_result p len:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok s:
                    Result<str,str>::Ok s
