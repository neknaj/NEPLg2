//: # env/cliarg/raw
//: WASI / LLVM の argv raw 取得境界
//:
//: ### [目的/もくてき]
//: - `args_sizes_get` / `args_get` と、その LLVM fallback を `std/env/cliarg` root から分離します。
//: - public `cliarg_*` API は raw syscall / scratch buffer の詳細を直接持たず、この module の checked helper を使います。

#indent 4

#if[target=wasm]
#extern "wasi_snapshot_preview1" "args_sizes_get" fn args_sizes_get <(i32,i32)*>i32>
#if[target=wasm]
#extern "wasi_snapshot_preview1" "args_get" fn args_get <(i32,i32)*>i32>
#if[target=llvm]
#extern "c" "syscall" fn __cli_syscall <(i64,i64,i64,i64,i64,i64,i64)*>i64>

#import "alloc/string" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as *
#import "std/env/cliarg/cstr" as cstr

pub struct CliArgSizes:
    argc <i32>
    buf_size <i32>

pub fn cli_args_sizes_result <(MemPtr<u8>)*>Result<CliArgSizes,i32>> (meta):
    let meta_raw <i32> mem_ptr_addr meta
    if:
        le meta_raw 0
        then:
            Result<CliArgSizes,i32>::Err 1
        else:
            store_i32 meta_raw 0
            store_i32 add meta_raw 4 0
            let errno <i32> args_sizes_get meta_raw add meta_raw 4
            if:
                ne errno 0
                then:
                    Result<CliArgSizes,i32>::Err errno
                else:
                    let argc <i32> load_i32 meta_raw
                    let buf_size <i32> load_i32 add meta_raw 4
                    if:
                        or lt argc 0 lt buf_size 0
                        then:
                            Result<CliArgSizes,i32>::Err 1
                        else:
                            Result<CliArgSizes,i32>::Ok CliArgSizes argc buf_size

pub fn cli_zero_u8_buffer_result <(MemPtr<u8>,i32)->Result<(),i32>> (buf, size):
    if:
        lt size 0
        then:
            Result<(),i32>::Err 1
        else:
            let mut i <i32> 0
            let mut err <i32> 0
            while and eq err 0 lt i size:
                do:
                    match store_u8 mem_ptr_add buf i 0:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            set err 1
                    set i add i 1
            if:
                eq err 0
                then:
                    Result<(),i32>::Ok ()
                else:
                    Result<(),i32>::Err err

pub fn cli_zero_i32_slots_result <(MemPtr<u8>,i32)->Result<(),i32>> (base, byte_size):
    let raw <i32> mem_ptr_addr base
    if:
        or le raw 0 lt byte_size 0
        then:
            Result<(),i32>::Err 1
        else:
            let mut off <i32> 0
            while lt off byte_size:
                do:
                    store_i32 add raw off 0
                    set off add off 4
            Result<(),i32>::Ok ()

pub fn cli_load_u8_result <(MemPtr<u8>,i32)->Result<i32,i32>> (base, off):
    match load_u8 mem_ptr_add base off:
        Option::Some b:
            Result<i32,i32>::Ok b
        Option::None:
            Result<i32,i32>::Err 1

//: cliarg_count_result: argc を raw argv 境界内で取得する
//:
//: 目的:
//: - `std/env/cliarg` root facade が raw out pointer を直接扱わずに argc を取得できるようにします。
//:
//: 実装(アルゴリズム):
//: - 8 byte の scratch 領域を確保し、`cli_args_sizes_result` で argc / buf_size を読みます。
//: - scratch 領域は成功・失敗にかかわらずこの関数内で解放します。
//:
//: 注意(重要):
//: - 失敗時は `Err(errno)` を返します。root public API はこの結果を 0 に丸めます。
//:
//: 計算量:
//: - O(1)
pub fn cliarg_count_result <()*>Result<i32,i32>> ():
    match alloc_ptr<u8> 8:
        Result::Err _:
            Result<i32,i32>::Err 1
        Result::Ok meta:
            let res <Result<i32,i32>> match cli_args_sizes_result meta:
                Result::Err e:
                    Result<i32,i32>::Err e
                Result::Ok sizes:
                    let argc <i32> get sizes "argc"
                    Result<i32,i32>::Ok argc
            match dealloc_ptr<u8> meta 8:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res

//: cliarg_get_checked: argv[index] を raw argv 境界内で取得する
//:
//: 目的:
//: - `std/env/cliarg` root facade から raw address / out pointer / scratch buffer の責務を分離します。
//:
//: 実装(アルゴリズム):
//: - argc / argv byte size を取得し、argv pointer 配列と argv byte buffer を scratch 領域として確保します。
//: - out pointer slot を 0 で初期化してから `args_get` を呼び、返された C string pointer を `cstr_to_str` で独立した `str` へコピーします。
//: - scratch 領域は戻り値の `str` とは独立して、この関数内で必ず解放します。
//:
//: 注意(重要):
//: - idx が範囲外、raw syscall 失敗、scratch 確保失敗、invalid pointer の場合は `None` を返します。
//:
//: 計算量:
//: - O(total_bytes + len(argv[idx]))
pub fn cliarg_get_checked <(i32)*>Option<str>> (idx):
    match alloc_ptr<u8> 8:
        Result::Err _:
            none<str>
        Result::Ok meta:
            let res <Option<str>> match cli_args_sizes_result meta:
                Result::Err _:
                    none<str>
                Result::Ok sizes:
                    let argc <i32> get sizes "argc"
                    let buf_size <i32> get sizes "buf_size"
                    if:
                        or ge idx argc le buf_size 0
                        then:
                            none<str>
                        else:
                            let argv_size <i32> mul argc 4
                            match alloc_ptr<u8> argv_size:
                                Result::Err _:
                                    none<str>
                                Result::Ok argv:
                                    match alloc_ptr<u8> buf_size:
                                        Result::Err _:
                                            match dealloc_ptr<u8> argv argv_size:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _:
                                                    ()
                                            none<str>
                                        Result::Ok argv_buf:
                                            let argv_raw <i32> mem_ptr_addr argv
                                            let argv_buf_raw <i32> mem_ptr_addr argv_buf
                                            let arg_slot_raw <i32> add argv_raw mul idx 4
                                            let inner <Option<str>> if:
                                                or le argv_raw 0 le argv_buf_raw 0
                                                then:
                                                    none<str>
                                                else:
                                                    match cli_zero_i32_slots_result argv argv_size:
                                                        Result::Err _:
                                                            none<str>
                                                        Result::Ok _:
                                                            match cli_zero_u8_buffer_result argv_buf buf_size:
                                                                Result::Err _:
                                                                    none<str>
                                                                Result::Ok _:
                                                                    store_i32 arg_slot_raw 0
                                                                    let errno2 <i32> args_get argv_raw argv_buf_raw
                                                                    if:
                                                                        ne errno2 0
                                                                        then:
                                                                            none<str>
                                                                        else:
                                                                            let arg_ptr <i32> load_i32 arg_slot_raw
                                                                            if:
                                                                                le arg_ptr 0
                                                                                then:
                                                                                    none<str>
                                                                                else:
                                                                                    some<str> cstr::cstr_to_str mem_ptr_wrap arg_ptr
                                            match dealloc_ptr<u8> argv_buf buf_size:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _:
                                                    ()
                                            match dealloc_ptr<u8> argv argv_size:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _:
                                                    ()
                                            inner
            match dealloc_ptr<u8> meta 8:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res

#if[target=llvm]
pub fn __cli_copy_to_cstr <(str)*>Result<MemPtr<u8>,i32>> (s):
    let byte_len <i32> len s;
    let src <i32> mem_ptr_addr string_data_ptr s;
    let size <i32> add byte_len 1;
    match alloc_ptr<u8> size:
        Result::Err e:
            Result<MemPtr<u8>,i32>::Err e
        Result::Ok dst:
            let mut i <i32> 0;
            while lt i byte_len:
                do:
                    match store_u8 mem_ptr_add dst i load_u8 add src i:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                    set i add i 1;
            match store_u8 mem_ptr_add dst byte_len 0:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            Result<MemPtr<u8>,i32>::Ok dst

#if[target=llvm]
pub fn __cli_open_cmdline <()*>i32> ():
    let path <str> "/proc/self/cmdline";
    match __cli_copy_to_cstr path:
        Result::Err _:
            -1
        Result::Ok cpath:
            let fd64 <i64> __cli_syscall <i64> cast 257 <i64> cast -100 <i64> cast mem_ptr_addr cpath <i64> cast 0 <i64> cast 0 <i64> cast 0 <i64> cast 0;
            match dealloc_ptr<u8> cpath add len path 1:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            if:
                cond:
                    lt fd64 <i64> cast 0
                then -1
                else <i32> cast fd64

#if[target=llvm]
pub fn __cli_read_cmdline <(MemPtr<u8>,i32)*>i32> (buf, cap):
    let fd <i32> __cli_open_cmdline;
    if:
        cond:
            lt fd 0
        then:
            -1
        else:
            let n64 <i64> __cli_syscall <i64> cast 0 <i64> cast fd <i64> cast mem_ptr_addr buf <i64> cast cap <i64> cast 0 <i64> cast 0 <i64> cast 0;
            __cli_syscall <i64> cast 3 <i64> cast fd <i64> cast 0 <i64> cast 0 <i64> cast 0 <i64> cast 0 <i64> cast 0;
            if:
                cond:
                    lt n64 <i64> cast 0
                then -1
                else <i32> cast n64

#if[target=llvm]
pub fn args_sizes_get <(i32,i32)*>i32> (argc_ptr, buf_ptr):
    let cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _:
            1
        Result::Ok tmp:
            let n <i32> __cli_read_cmdline tmp cap;
            if:
                cond:
                    lt n 0
                then:
                    match dealloc_ptr<u8> tmp cap:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ();
                    1
                else:
                    let mut argc <i32> 0;
                    let mut i <i32> 0;
                    let mut err <i32> 0;
                    while and eq err 0 lt i n:
                        do:
                            match cli_load_u8_result tmp i:
                                Result::Ok b:
                                    if:
                                        eq b 0
                                        then set argc add argc 1
                                        else ()
                                Result::Err e:
                                    set err e
                            set i add i 1;
                    if:
                        eq err 0
                        then:
                            store_i32 argc_ptr argc;
                            store_i32 buf_ptr n;
                        else:
                            ()
                    match dealloc_ptr<u8> tmp cap:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ();
                    if eq err 0 0 err

#if[target=llvm]
pub fn args_get <(i32,i32)*>i32> (argv_ptr, argv_buf):
    let cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _:
            1
        Result::Ok tmp:
            let argv_buf_ptr <MemPtr<u8>> mem_ptr_wrap argv_buf
            let argv_ptr_i32 <MemPtr<i32>> mem_ptr_wrap argv_ptr
            let n <i32> __cli_read_cmdline tmp cap;
            if:
                cond:
                    lt n 0
                then:
                    match dealloc_ptr<u8> tmp cap:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ();
                    1
                else:
                    let mut err <i32> 0;
                    let mut i <i32> 0;
                    while and eq err 0 lt i n:
                        do:
                            match cli_load_u8_result tmp i:
                                Result::Ok b:
                                    match store_u8 mem_ptr_add argv_buf_ptr i b:
                                        Result::Ok _:
                                            ()
                                        Result::Err _:
                                            set err 1
                                Result::Err e:
                                    set err e
                            set i add i 1;

                    let mut argi <i32> 0;
                    if:
                        and eq err 0 lt 0 n
                        then:
                            match store_i32 argv_ptr_i32 argv_buf:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    set err 1
                        else ()

                    let mut j <i32> 0;
                    while and eq err 0 lt j n:
                        do:
                            match cli_load_u8_result argv_buf_ptr j:
                                Result::Ok b:
                                    if:
                                        eq b 0
                                        then:
                                            set argi add argi 1;
                                            if:
                                                cond:
                                                    lt add j 1 n
                                                then:
                                                    match store_i32 mem_ptr_add argv_ptr_i32 mul argi 4 add argv_buf add j 1:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _:
                                                            set err 1
                                                else ()
                                        else ()
                                Result::Err e:
                                    set err e
                            set j add j 1;
                    match dealloc_ptr<u8> tmp cap:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ();
                    if eq err 0 0 err
