#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "std/env/cliarg/cstr" as *
#import "std/env/cliarg/raw" as *

//: cliarg: コマンドライン引数取得（WASI / LLVM）
//:
//: 目的:
//: - `cliarg_count` / `cliarg_get` で argv を読み出します。
//:
//: 実装(アルゴリズム):
//: - wasm は WASI `args_sizes_get/args_get` を使います。
//: - llvm は Linux `/proc/self/cmdline` を syscall で読み、互換 `args_sizes_get/args_get` を実装します。
//: - NUL 終端の文字列を [len][bytes] 形式の str にコピーします。
//:
//: 注意(重要):
//: - WASI ターゲット専用です（wasm では使用できません）。
//: - `cliarg_get` / `cliarg_program` は返り値の `str` を新しく確保します。
//: - 内部の一時バッファは各呼び出し内で解放します。
//: - argv[0] はプログラム名相当です。
//:
//: 計算量:
//: - 引数取得は O(total_bytes)

//: cliarg_count: 引数の個数を返す
//:
//: 目的:
//: - argc を返します（argv[0] を含みます）。
//:
//: 実装(アルゴリズム):
//: - args_sizes_get で argc を取得します。
//:
//: 注意(重要):
//: - 失敗時は 0 を返します。
//:
//: 計算量:
//: - O(1)
//: cliarg_count: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `cliarg_count` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: argv: ["alpha", "beta"]
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/env/cliarg" as *
//: fn main <()*>i32> ():
//:     if eq cliarg_count () 3 0 1
//: ```
pub fn cliarg_count <()*>i32> ():
    match alloc_ptr<u8> 8:
        Result::Err _:
            0
        Result::Ok meta:
            let res <i32> match cli_args_sizes_result meta:
                Result::Err _:
                    0
                Result::Ok sizes:
                    get sizes "argc"
            match dealloc_ptr<u8> meta 8:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res

//: cliarg_get: 指定 index の引数を取得する
//:
//: 目的:
//: - idx が範囲内なら Some(str)、範囲外なら None を返します。
//:
//: 実装(アルゴリズム):
//: - args_sizes_get/args_get を呼び出し、argv を取得します。
//: - argv[idx] を NUL 終端として読み取り、str にコピーします。
//:
//: 注意(重要):
//: - idx < 0 は None になります。
//: - 取得ごとにメモリを確保します。
//:
//: 計算量:
//: - O(total_bytes + len)
//: cliarg_get: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `cliarg_get` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: argv: ["alpha", "beta"]
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/env/cliarg" as *
//:| #import "alloc/string" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     match cliarg_get 1:
//:         Option::Some arg:
//:             if str_eq arg "alpha" 0 1
//:         Option::None:
//:             1
//: ```
pub fn cliarg_get <(i32)*>Option<str>> (idx):
    if:
        cond:
            lt idx 0
        then:
            none<str>
        else:
            match alloc_ptr<u8> 8:
                Result::Err _:
                    none<str>
                Result::Ok meta:
                    let res <Option<str>> match cli_args_sizes_result meta:
                        Result::Err _:
                            none<str>
                        Result::Ok sizes:
                            let argc <i32> get sizes "argc"
                            let buf_size <i32> get sizes "buf_size"
                            if:
                                or ge idx argc le buf_size 0
                                then:
                                    none<str>
                                else:
                                    let argv_size <i32> mul argc 4
                                    match alloc_ptr<u8> argv_size:
                                        Result::Err _:
                                            none<str>
                                        Result::Ok argv:
                                            match alloc_ptr<u8> buf_size:
                                                Result::Err _:
                                                    match dealloc_ptr<u8> argv argv_size:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _:
                                                            ()
                                                    none<str>
                                                Result::Ok argv_buf:
                                                    let argv_raw <i32> mem_ptr_addr argv
                                                    let argv_buf_raw <i32> mem_ptr_addr argv_buf
                                                    let arg_slot_raw <i32> add argv_raw mul idx 4
                                                    let inner <Option<str>> if:
                                                        or le argv_raw 0 le argv_buf_raw 0
                                                        then:
                                                            none<str>
                                                        else:
                                                            match cli_zero_i32_slots_result argv argv_size:
                                                                Result::Err _:
                                                                    none<str>
                                                                Result::Ok _:
                                                                    match cli_zero_u8_buffer_result argv_buf buf_size:
                                                                        Result::Err _:
                                                                            none<str>
                                                                        Result::Ok _:
                                                                            store_i32 arg_slot_raw 0
                                                                            let errno2 <i32> args_get argv_raw argv_buf_raw
                                                                            if:
                                                                                ne errno2 0
                                                                                then:
                                                                                    none<str>
                                                                                else:
                                                                                    let arg_ptr <i32> load_i32 arg_slot_raw
                                                                                    if:
                                                                                        le arg_ptr 0
                                                                                        then:
                                                                                            none<str>
                                                                                        else:
                                                                                            some<str> cstr_to_str mem_ptr_wrap arg_ptr
                                                    match dealloc_ptr<u8> argv_buf buf_size:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _:
                                                            ()
                                                    match dealloc_ptr<u8> argv argv_size:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _:
                                                            ()
                                                    inner
                    match dealloc_ptr<u8> meta 8:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                    res

//: cliarg_program: argv[0] を返す
//:
//: 目的:
//: - プログラム名相当の引数を返します。
//:
//: 実装(アルゴリズム):
//: - cliarg_get 0 を呼びます。
//:
//: 注意(重要):
//: - 取得に失敗した場合は None です。
//:
//: 計算量:
//: - O(total_bytes + len)
//: cliarg_program: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `cliarg_program` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: argv: ["alpha", "beta"]
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/env/cliarg" as *
//:| #import "alloc/string" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     match cliarg_program ():
//:         Option::Some arg:
//:             if gt len arg 0 0 1
//:         Option::None:
//:             1
//: ```
pub fn cliarg_program <()*>Option<str>> ():
    cliarg_get 0
