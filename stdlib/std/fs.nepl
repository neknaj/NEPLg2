// WASI rights_base の fd_read bit。
fn fs_right_fd_read <()->i64> ():
    <i64> cast 2

// WASI rights_base の fd_write bit。
fn fs_right_fd_write <()->i64> ():
    <i64> cast 64

// WASI rights_base の fd_readdir bit。
fn fs_right_fd_readdir <()->i64> ():
    <i64> cast 16384

// WASI oflags の create + truncate bit。
fn fs_oflags_create_truncate <()->i32> ():
    9

// WASI oflags の directory bit。
fn fs_oflags_directory <()->i32> ():
    2

fn fs_errno_inval <()->i32> ():
    28

fn fs_errno_notcapable <()->i32> ():
    76

fn fs_errno_ilseq <()->i32> ():
    84

fn fs_filetype_directory <()->i32> ():
    3

fn fs_filetype_regular_file <()->i32> ():
    4

fn fs_dirent_header_size <()->i32> ():
    24

fn fs_readdir_buf_size <()->i32> ():
    65536

//: fs_fd_read_into_result: WASI fd_read の iov/nread scratch を検査可能な境界へ閉じ込める
//:
//: 目的:
//: - `fd_read` が要求する iovec と nread の raw layout をこの関数内で初期化し、読み戻した byte 数だけを返します。
//:
//: 実装(アルゴリズム):
//: - `iov` の base/len と `nread` の初期値を raw address に対して同じ関数内で store します。
//: - `fd_read` 成功後、同じ raw address から `nread` を load します。
//: - 任意の `MemPtr<i32>` を作って関数境界越しに読む形にはしません。Resource IR の RawMemoryLoadCell が初期化 store を追跡できるようにするためです。
//:
//: 注意(重要):
//: - `iov` は 8 byte、`nread` は 4 byte、`data` は `data_len` byte 以上の有効領域を指している必要があります。
//: - `data_len == 0` の場合は WASI を呼ばず 0 byte read として返します。
//:
//: 計算量:
//: - O(1)
fn fs_fd_read_into_result <(i32,MemPtr<u8>,MemPtr<u8>,MemPtr<u8>,i32)*>Result<i32,i32>> (fd, iov, nread, data, data_len):
    if:
        lt data_len 0
        then:
            Result<i32,i32>::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    Result<i32,i32>::Ok 0
                else:
                    let iov_raw <i32> mem_ptr_addr iov
                    let nread_raw <i32> mem_ptr_addr nread
                    let data_raw <i32> mem_ptr_addr data
                    if:
                        or or le iov_raw 0 le nread_raw 0 le data_raw 0
                        then:
                            Result<i32,i32>::Err fs_errno_inval
                        else:
                            store_i32 iov_raw data_raw
                            store_i32 add iov_raw 4 data_len
                            store_i32 nread_raw 0
                            let errno <i32> wasi_fd_read fd iov_raw 1 nread_raw
                            if:
                                ne errno 0
                                then:
                                    Result<i32,i32>::Err errno
                                else:
                                    Result<i32,i32>::Ok load_i32 nread_raw

//: fs_fd_write_from_result: WASI fd_write の iov/nwritten scratch を検査可能な境界へ閉じ込める
//:
//: 目的:
//: - `fd_write` が要求する iovec と nwritten の raw layout をこの関数内で初期化し、書けた byte 数だけを返します。
//:
//: 実装(アルゴリズム):
//: - `iov` の base/len と `nwritten` の初期値を raw address に対して同じ関数内で store します。
//: - `fd_write` 成功後、同じ raw address から `nwritten` を load します。
//:
//: 注意(重要):
//: - `iov` は 8 byte、`nwritten` は 4 byte、`data` は `data_len` byte 以上の有効領域を指している必要があります。
//:
//: 計算量:
//: - O(1)
fn fs_fd_write_from_result <(i32,MemPtr<u8>,MemPtr<u8>,MemPtr<u8>,i32)*>Result<i32,i32>> (fd, iov, nwritten, data, data_len):
    if:
        lt data_len 0
        then:
            Result<i32,i32>::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    Result<i32,i32>::Ok 0
                else:
                    let iov_raw <i32> mem_ptr_addr iov
                    let nwritten_raw <i32> mem_ptr_addr nwritten
                    let data_raw <i32> mem_ptr_addr data
                    if:
                        or or le iov_raw 0 le nwritten_raw 0 le data_raw 0
                        then:
                            Result<i32,i32>::Err fs_errno_inval
                        else:
                            store_i32 iov_raw data_raw
                            store_i32 add iov_raw 4 data_len
                            store_i32 nwritten_raw 0
                            let errno <i32> wasi_fd_write fd iov_raw 1 nwritten_raw
                            if:
                                ne errno 0
                                then:
                                    Result<i32,i32>::Err errno
                                else:
                                    Result<i32,i32>::Ok load_i32 nwritten_raw

//: fs_finish_read_buffer: capacity 付き読み込み buffer を ByteBuf の所有権 invariant へ詰め直す
//:
//: 目的:
//: - `alloc_ptr` / `realloc_ptr` で確保した一時読み込み buffer を、`ByteBuf.ptr` が `Some` の場合だけ `ByteBuf.len` byte の所有領域を指す形へ戻します。
//:
//: 実装(アルゴリズム):
//: - 読み込み長が 0 の場合は元 buffer を解放し、空 `ByteBuf` を返します。
//: - 読み込み長が capacity 未満の場合は exact-size に shrink してから `ByteBuf` にします。
//:
//: 注意(重要):
//: - 成功時は返った `ByteBuf` が buffer を所有します。
//: - 失敗時はこの関数が元 buffer を解放します。
//:
//: 計算量:
//: - allocator の shrink に依存します。copy が発生する場合は O(data_len) です。
fn fs_finish_read_buffer <(MemPtr<u8>,i32,i32)*>Result<ByteBuf,i32>> (buf, cap, data_len):
    if:
        or or lt cap 0 lt data_len 0 gt data_len cap
        then:
            if:
                gt cap 0
                then:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                else:
                    ()
            Result<ByteBuf,i32>::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    if:
                        gt cap 0
                        then:
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                        else:
                            ()
                    Result<ByteBuf,i32>::Ok io_bytebuf_empty
                else:
                    if:
                        eq data_len cap
                        then:
                            Result<ByteBuf,i32>::Ok io_bytebuf_from_owned_ptr buf data_len
                        else:
                            match realloc_ptr<u8> buf cap data_len:
                                Result::Ok exact:
                                    Result<ByteBuf,i32>::Ok io_bytebuf_from_owned_ptr exact data_len
                                Result::Err _e:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e2:
                                            ()
                                    Result<ByteBuf,i32>::Err 12

//: fs: ファイル読み書き（WASI / LLVM）
//:
//: 目的:
//: - `fs_read_to_bytes` / `fs_read_to_string` と `fs_write_to_bytes` / `fs_write_to_string` など、target 非依存のファイル I/O API を提供します。
//:
//: 実装(アルゴリズム):
//: - wasm では WASI `path_open/fd_read/fd_write/fd_close` を呼びます。
//: - llvm では Linux `openat/read/write/close` syscall を使って同名 API を互換実装します。
//: - 読み込み結果と書き込み入力は `ByteBuf` または str を介して扱います。
//: - `str` として返す API は `ByteBuf -> str` 境界で UTF-8 を検証します。
//:
//: 注意(重要):
//: - 権限/パス解決はホスト環境に依存します。
//: - raw bytes が必要な場合は `fs_read_to_bytes` / `fs_write_to_bytes` を使い、`str` へ変換しないでください。
//: - `ByteBuf` を受け取る write API は所有権を消費し、成功時も失敗時も buffer を解放します。
//:
//: 計算量:
//: - 読み込みバイト数に比例 (O(n))

#if[target=llvm]
fn __fs_copy_to_cstr <(i32,i32)*>Result<MemPtr<u8>,i32>> (src_ptr, src_len):
    let size <i32> add src_len 1;
    match alloc_ptr<u8> size:
        Result::Err e:
            Result<MemPtr<u8>,i32>::Err e
        Result::Ok dst:
            let mut i <i32> 0;
            while lt i src_len:
                do:
                    match store_u8 mem_ptr_add dst i load_u8 add src_ptr i:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                    set i add i 1;
            match store_u8 mem_ptr_add dst src_len 0:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            Result<MemPtr<u8>,i32>::Ok dst

#if[target=llvm]
fn __linux_syscall_openat_path <(i32,i32,i32)*>i64> (path_ptr, flags, mode):
    #llvmir:
        define i64 @__linux_syscall_openat_path(i32 %path_ptr, i32 %flags, i32 %mode) {
        entry:
            %idx = zext i32 %path_ptr to i64
            %path = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %path64 = ptrtoint ptr %path to i64
            %flags64 = zext i32 %flags to i64
            %mode64 = zext i32 %mode to i64
            %ret = call i64 @__fs_syscall(i64 257, i64 -100, i64 %path64, i64 %flags64, i64 %mode64, i64 0, i64 0)
            ret i64 %ret
        }

#if[target=llvm]
fn __linux_syscall_rw <(i32,i32,i32,i32)*>i64> (nr,fd,ptr,len):
    #llvmir:
        define i64 @__linux_syscall_rw(i32 %nr, i32 %fd, i32 %ptr, i32 %len) {
        entry:
            %nr64 = zext i32 %nr to i64
            %fd64 = zext i32 %fd to i64
            %len64 = zext i32 %len to i64
            %idx = zext i32 %ptr to i64
            %buf = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %buf64 = ptrtoint ptr %buf to i64
            %ret = call i64 @__fs_syscall(i64 %nr64, i64 %fd64, i64 %buf64, i64 %len64, i64 0, i64 0, i64 0)
            ret i64 %ret
        }

#if[target=llvm]
fn wasi_path_open <(i32,i32,i32,i32,i32,i64,i64,i32,i32)*>i32> (_dirfd,_dirflags,path_ptr,path_len,_oflags,_rights_base,_rights_inheriting,_fdflags,fd_out):
    match __fs_copy_to_cstr path_ptr path_len:
        Result::Err e:
            e
        Result::Ok cpath:
            let linux_flags <i32> if:
                eq _oflags 0
                then:
                    0
                else:
                    577
            let linux_mode <i32> if:
                eq _oflags 0
                then:
                    0
                else:
                    438
            // Linux x86_64: openat(AT_FDCWD=-100, path, flags, mode)
            let fd64 <i64> __linux_syscall_openat_path mem_ptr_addr cpath linux_flags linux_mode;
            match dealloc_ptr<u8> cpath add path_len 1:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            if:
                cond:
                    lt fd64 <i64> cast 0
                then:
                    1
                else:
                    store_i32 fd_out <i32> cast fd64;
                    0

#if[target=llvm]
fn wasi_path_filestat_get <(i32,i32,i32,i32,i32)*>i32> (_dirfd,_flags,_path_ptr,_path_len,_buf):
    52

#if[target=llvm]
fn wasi_fd_readdir <(i32,i32,i32,i64,i32)*>i32> (_fd,_buf,_buf_len,_cookie,bufused):
    store_i32 bufused 0;
    52

#if[target=llvm]
fn wasi_fd_read <(i32,i32,i32,i32)*>i32> (fd,iovs,iovs_len,nread_ptr):
    let mut total <i32> 0;
    let mut iov_idx <i32> 0;
    let mut err <i32> 0;
    let mut done <i32> 0;
    while eq done 0:
        do:
            if:
                cond:
                    lt iov_idx iovs_len
                then:
                    let iov_ptr <i32> add iovs mul iov_idx 8;
                    let base <i32> load_i32 iov_ptr;
                    let len <i32> load_i32 add iov_ptr 4;
                    // Linux x86_64: read(fd, buf, count)
                    let n64 <i64> __linux_syscall_rw 0 fd base len;
                    if:
                        cond:
                            lt n64 <i64> cast 0
                        then:
                            set err 1;
                            set done 1;
                        else:
                            let n <i32> cast n64;
                            set total add total n;
                            if:
                                cond:
                                    lt n len
                                then:
                                    set done 1;
                                else:
                                    ();
                    set iov_idx add iov_idx 1;
                else:
                    set done 1;
    store_i32 nread_ptr total;
    err

#if[target=llvm]
fn wasi_fd_write <(i32,i32,i32,i32)*>i32> (fd,iovs,iovs_len,nwritten_ptr):
    let mut total <i32> 0;
    let mut iov_idx <i32> 0;
    let mut err <i32> 0;
    let mut done <i32> 0;
    while eq done 0:
        do:
            if:
                cond:
                    lt iov_idx iovs_len
                then:
                    let iov_ptr <i32> add iovs mul iov_idx 8;
                    let base <i32> load_i32 iov_ptr;
                    let len <i32> load_i32 add iov_ptr 4;
                    // Linux x86_64: write(fd, buf, count)
                    let n64 <i64> __linux_syscall_rw 1 fd base len;
                    if:
                        cond:
                            lt n64 <i64> cast 0
                        then:
                            set err 1;
                            set done 1;
                        else:
                            let n <i32> cast n64;
                            set total add total n;
                            if:
                                cond:
                                    lt n len
                                then:
                                    set done 1;
                                else:
                                    ();
                    set iov_idx add iov_idx 1;
                else:
                    set done 1;
    store_i32 nwritten_ptr total;
    err

#if[target=llvm]
fn wasi_fd_close <(i32)*>i32> (fd):
    // Linux x86_64: close(fd)
    let rc64 <i64> __fs_syscall <i64> cast 3 <i64> cast fd <i64> cast 0 <i64> cast 0 <i64> cast 0 <i64> cast 0 <i64> cast 0;
    if:
        cond:
            lt rc64 <i64> cast 0
        then 1
        else 0

//: fs_open_with_flags: path_open の fd_out 確保と結果変換を共通化する
//:
//: 目的:
//: - read/write で共通する WASI `path_open` 呼び出しを 1 箇所へ集約します。
//:
//: 実装(アルゴリズム):
//: - fd_out 用の 4 byte buffer を確保し、`path_open` 成功時だけ fd を読み出して返します。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 失敗時は WASI errno または確保失敗相当の 12 を返します。
//:
//: 計算量:
//: - O(1)
fn fs_open_with_flags <(str,i32,i64)*>Result<i32,i32>> (path, oflags, rights):
    match alloc_ptr<u8> 4:
        Result::Err _e:
            Result<i32,i32>::Err 12
        Result::Ok fd_out_buf:
            let fd_out_raw <i32> mem_ptr_addr fd_out_buf
            let res <Result<i32,i32>> if:
                le fd_out_raw 0
                then:
                    Result<i32,i32>::Err fs_errno_inval
                else:
                    store_i32 fd_out_raw 0
                    let path_ptr <i32> mem_ptr_addr string_data_ptr path
                    let path_len <i32> len path
                    let errno <i32> wasi_path_open 3 0 path_ptr path_len oflags rights rights 0 fd_out_raw
                    if:
                        eq errno 0
                        then:
                            Result<i32,i32>::Ok load_i32 fd_out_raw
                        else:
                            Result<i32,i32>::Err errno
            match dealloc_ptr<u8> fd_out_buf 4:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res

//: fs_open_read: ファイルを読み込み専用で開く
//:
//: 目的:
//: - path を開き、fd を返します。
//:
//: 実装(アルゴリズム):
//: - path_open を呼び、fd_out から fd を取得します。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 失敗時は Err(errno) を返します。
//:
//: 計算量:
//: - O(1)
//: fs_open_read: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_open_read` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_open_read "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok _fd:
//:             0
//:         Result::Err _e:
//:             1
//: ```
fn fs_open_read <(str)*>Result<i32,i32>> (path):
    fs_open_with_flags path 0 fs_right_fd_read

//: fs_open_write: ファイルを書き込み専用で開く
//:
//: 目的:
//: - path を create + truncate + write の権限で開き、fd を返します。
//:
//: 実装(アルゴリズム):
//: - `path_open` に WASI oflags create/truncate と fd_write right を渡します。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 既存ファイルは truncate されます。
//: - 失敗時は Err(errno) を返します。
//:
//: 計算量:
//: - O(1)
//: fs_open_write: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_open_write` が file descriptor を返し、`fs_close` で閉じられることを確認します。
//:
//: [注意/ちゅうい]:
//: - 内容書き込みは `fs_write_to_string` / `fs_write_to_bytes` の回帰テストで確認します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_open_write "tmp/fs_open_write_doctest.txt":
//:         Result::Ok fd:
//:             match fs_close fd:
//:                 Result::Ok _:
//:                     0
//:                 Result::Err _e:
//:                     2
//:         Result::Err _e:
//:             1
//: ```
fn fs_open_write <(str)*>Result<i32,i32>> (path):
    fs_open_with_flags path fs_oflags_create_truncate fs_right_fd_write

//: fs_path_has_forbidden_host_byte: WASI guest path と host path の混同を招く byte を検出する
//:
//: 目的:
//: - `\` や `:` を含む path を、preopen root の外へ出る可能性がある host path 表現として拒否できるようにします。
//:
//: 実装(アルゴリズム):
//: - 文字列を byte 単位で走査し、Windows 区切りや drive prefix に使われる byte を探します。
//:
//: 注意(重要):
//: - std/fs の公開 path API は `/` 区切りの WASI guest path だけを受け付けます。
//:
//: 計算量:
//: - path 長 n に対して O(n)
fn fs_path_has_forbidden_host_byte <(str)->bool> (path):
    let n <i32> len path
    let mut i <i32> 0
    let mut found <bool> false
    while and not found lt i n:
        do:
            let ch <i32> string_byte_at_unchecked path i
            if:
                or eq ch '\\' eq ch ':'
                then:
                    set found true
                else:
                    set i add i 1
    found

//: fs_str_lt: directory entry の安定順を決める byte 辞書順比較
//:
//: 目的:
//: - host の `readdir` 順に依存しないよう、`fs_read_dir` の結果を byte 順で並べ替えます。
//:
//: 実装(アルゴリズム):
//: - 2 つの str を先頭から byte 比較し、共通 prefix の場合は短い方を小さいとみなします。
//:
//: 注意(重要):
//: - locale や Unicode 正規化は扱わず、filesystem discovery 用の安定順だけを提供します。
//:
//: 計算量:
//: - 短い方の長さ m に対して O(m)
fn fs_str_lt <(str,str)->bool> (a, b):
    let la <i32> len a
    let lb <i32> len b
    let n <i32> if lt la lb then la else lb
    let mut i <i32> 0
    let mut done <bool> false
    let mut answer <bool> false
    while and not done lt i n:
        do:
            let ba <i32> string_byte_at_unchecked a i
            let bb <i32> string_byte_at_unchecked b i
            if:
                lt ba bb
                then:
                    set answer true
                    set done true
                else:
                    if:
                        gt ba bb
                        then:
                            set done true
                        else:
                            set i add i 1
    if:
        done
        then answer
        else lt la lb

//: fs_sort_strings: Vec<str> を in-place に安定した byte 順へ並べる
//:
//: 目的:
//: - `fs_read_dir` の戻り値を platform 非依存の順序に揃えます。
//:
//: 実装(アルゴリズム):
//: - entry 数は通常小さいため、追加の heap 確保を避けた insertion sort を使います。
//:
//: 注意(重要):
//: - 要素の所有権は Vec 内に保持したまま、str handle だけを並べ替えます。
//:
//: 計算量:
//: - entry 数 n、名前長比較を含めて最悪 O(n^2)
fn fs_sort_strings <(i32,i32)*>()> (data, n):
    let mut i <i32> 1
    while lt i n:
        do:
            let key <str> load<str> add data mul i size_of<str>
            let mut j <i32> i
            let mut moving <bool> true
            while and moving gt j 0:
                do:
                    let prev_idx <i32> sub j 1
                    let prev <str> load<str> add data mul prev_idx size_of<str>
                    if:
                        fs_str_lt key prev
                        then:
                            store<str> add data mul j size_of<str> prev
                            set j prev_idx
                        else:
                            set moving false
            store<str> add data mul j size_of<str> key
            set i add i 1
    ()

//: fs_string_from_bytes: fd_readdir の name byte range を UTF-8 検証して str へ複製する
//:
//: 目的:
//: - WASI dirent buffer 内の一時 byte 列を、UTF-8 として妥当な場合だけ戻り値として保持できる str に変換します。
//:
//: 実装(アルゴリズム):
//: - `string_utf8_validate_mem` で byte 列を検証し、成功時だけ `string_from_mem_unchecked_result` で複製します。
//:
//: 注意(重要):
//: - invalid UTF-8 の directory entry は errno 84 (ILSEQ 相当) として返します。
//:
//: 計算量:
//: - 名前長 n に対して O(n)
fn fs_string_from_bytes <(i32,i32)->Result<str,i32>> (src, byte_len):
    let src_ptr <MemPtr<u8>> mem_ptr_wrap src
    match string_utf8_validate_mem src_ptr byte_len:
        Result::Err _e:
            Result<str,i32>::Err fs_errno_ilseq
        Result::Ok _:
            match string_from_mem_unchecked_result src_ptr byte_len:
                Result::Err _e:
                    Result<str,i32>::Err 12
                Result::Ok text:
                    Result<str,i32>::Ok text

fn fs_dir_name_is_dot <(str)->bool> (name):
    or str_eq name "." str_eq name ".."

//: fs_normalize_build: 正規化済み component stack を `/` 区切り path へ戻す
//:
//: 目的:
//: - `fs_normalize_relative` の内部 stack から、WASI runtime へ渡す guest path を作ります。
//:
//: 実装(アルゴリズム):
//: - component を順に StringBuilder へ追加し、component 間にだけ `/` を入れます。
//:
//: 注意(重要):
//: - 空 stack は current preopen root を表す `"."` として返します。
//:
//: 計算量:
//: - component の総 byte 数 n に対して O(n)
fn fs_normalize_build <(i32,i32)->str> (data, n):
    if:
        eq n 0
        then:
            "."
        else:
            let mut sb <StringBuilder> string_builder_new
            let mut i <i32> 0
            while lt i n:
                do:
                    if:
                        gt i 0
                        then:
                            set sb sb_append sb "/"
                        else:
                            ()
                    let part <str> load<str> add data mul i size_of<str>
                    set sb sb_append sb part
                    set i add i 1
            sb_build sb

//: fs_normalize_relative: `/` 区切りの相対 path を preopen root 内の正規形へ畳む
//:
//: 目的:
//: - import 解決や directory traversal が、caller ごとの ad hoc な path 処理に依存しないようにします。
//:
//: 実装(アルゴリズム):
//: - `/` で分割し、空 component と `.` を捨て、`..` は stack を 1 つ戻します。
//: - stack が空の状態で `..` が来た場合は preopen root 外へ出るため拒否します。
//:
//: 注意(重要):
//: - absolute path、Windows host path 風の `\` / `:` を含む path は `Err(76)` にします。
//: - 空 path は preopen root 自体を表す `"."` に正規化します。
//: - component 分割や stack 確保に失敗した場合は `Err(12)` を返します。
//:
//: 計算量:
//: - path 長 n に対して O(n)
fn fs_normalize_relative <(str)->Result<str,i32>> (path):
    let path_len <i32> len path
    if:
        fs_path_has_forbidden_host_byte path
        then:
            Result<str,i32>::Err fs_errno_notcapable
        else:
            if:
                and gt path_len 0 eq string_byte_at_unchecked path 0 47
                then:
                    Result<str,i32>::Err fs_errno_notcapable
                else:
                    match str_split_result path "/":
                        Result::Err _e:
                            Result<str,i32>::Err 12
                        Result::Ok parts:
                            let parts_len <i32> get parts "len"
                            match v::with_capacity<str> parts_len:
                                Result::Err _e:
                                    v::free<str> parts
                                    Result<str,i32>::Err 12
                                Result::Ok stack0:
                                    let mut stack <Vec<str>> stack0
                                    let parts_data <i32> mem_ptr_addr get parts "data"
                                    let mut i <i32> 0
                                    let mut err <i32> 0
                                    while and eq err 0 lt i parts_len:
                                        do:
                                            let part <str> load<str> add parts_data mul i size_of<str>
                                            if:
                                                or str_eq part "" str_eq part "."
                                                then:
                                                    ()
                                                else:
                                                    if:
                                                        str_eq part ".."
                                                        then:
                                                            let stack_len <i32> get stack "len"
                                                            if:
                                                                eq stack_len 0
                                                                then:
                                                                    set err fs_errno_notcapable
                                                                else:
                                                                    let popped v::pop<str> stack
                                                                    set stack get popped 0
                                                        else:
                                                            match v::push<str> stack part:
                                                                Result::Ok next_stack:
                                                                    set stack next_stack
                                                                Result::Err _e:
                                                                    set stack v::Vec<str> 0 0 mem_ptr_wrap 0
                                                                    set err 12
                                            set i add i 1
                                    let result <Result<str,i32>> if:
                                        eq err 0
                                        then:
                                            let stack_len <i32> get stack "len"
                                            let stack_data <i32> mem_ptr_addr get stack "data"
                                            Result<str,i32>::Ok fs_normalize_build stack_data stack_len
                                        else:
                                            Result<str,i32>::Err err
                                    v::free<str> parts
                                    v::free<str> stack
                                    result

//: fs_path_filetype: path の WASI filetype を取得する
//:
//: 目的:
//: - existence check と file/dir 判定を、read 失敗の副作用に頼らず取得します。
//:
//: 実装(アルゴリズム):
//: - path を `fs_normalize_relative` で正規化し、WASI `path_filestat_get` の filestat.filetype byte を読みます。
//:
//: 注意(重要):
//: - 戻り値は WASI filetype の整数値です。regular file は 4、directory は 3 です。
//:
//: 計算量:
//: - path 正規化 O(n) と host stat 1 回
fn fs_path_filetype <(str)*>Result<i32,i32>> (path):
    match fs_normalize_relative path:
        Result::Err e:
            Result<i32,i32>::Err e
        Result::Ok normalized:
            match alloc_ptr<u8> 64:
                Result::Err _e:
                    Result<i32,i32>::Err 12
                Result::Ok stat_buf:
                    let path_ptr <i32> mem_ptr_addr string_data_ptr normalized
                    let path_len <i32> len normalized
                    let errno <i32> wasi_path_filestat_get 3 0 path_ptr path_len mem_ptr_addr stat_buf
                    let res <Result<i32,i32>> if:
                        eq errno 0
                        then:
                            Result<i32,i32>::Ok load_u8 add mem_ptr_addr stat_buf 16
                        else:
                            Result<i32,i32>::Err errno
                    match dealloc_ptr<u8> stat_buf 64:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                    res

//: fs_exists: path が preopen root 内に存在するかを返す
//:
//: 目的:
//: - import 解決で候補ファイルの有無を軽量に判定します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` が成功するかどうかだけを bool に変換します。
//:
//: 注意(重要):
//: - 権限違反や root escape も false になります。詳細 errno が必要なら `fs_path_filetype` を使ってください。
//:
//: 計算量:
//: - host stat 1 回
fn fs_exists <(str)*>bool> (path):
    match fs_path_filetype path:
        Result::Ok _kind:
            true
        Result::Err _e:
            false

//: fs_is_file: path が regular file かを返す
//:
//: 目的:
//: - `.nepl` / `.n.md` 候補を directory と区別します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` の WASI filetype を regular file 値と比較します。
//:
//: 計算量:
//: - host stat 1 回
fn fs_is_file <(str)*>bool> (path):
    match fs_path_filetype path:
        Result::Ok kind:
            eq kind fs_filetype_regular_file
        Result::Err _e:
            false

//: fs_is_dir: path が directory かを返す
//:
//: 目的:
//: - stdlib root や module root の探索で directory を検出します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` の WASI filetype を directory 値と比較します。
//:
//: 計算量:
//: - host stat 1 回
fn fs_is_dir <(str)*>bool> (path):
    match fs_path_filetype path:
        Result::Ok kind:
            eq kind fs_filetype_directory
        Result::Err _e:
            false

//: fs_open_dir: directory を fd_readdir 用に開く
//:
//: 目的:
//: - `fs_read_dir` と将来の directory iterator が同じ権限指定で fd を取得できるようにします。
//:
//: 実装(アルゴリズム):
//: - path を正規化してから、WASI fd_readdir right だけで `path_open` を呼びます。
//:
//: 注意(重要):
//: - path escape は open 前に `fs_normalize_relative` で拒否します。
//:
//: 計算量:
//: - path 正規化 O(n) と host open 1 回
fn fs_open_dir <(str)*>Result<i32,i32>> (path):
    match fs_normalize_relative path:
        Result::Err e:
            Result<i32,i32>::Err e
        Result::Ok normalized:
            fs_open_with_flags normalized fs_oflags_directory fs_right_fd_readdir

//: fs_read_dir_fd: directory fd から entry 名を読み出す
//:
//: 目的:
//: - `fd_readdir` の raw dirent 配列を `Vec<str>` に変換し、`fs_read_dir` の本体処理を分離します。
//:
//: 実装(アルゴリズム):
//: - 64KiB buffer で `fd_readdir` を繰り返し、dirent header と name byte 列を順に読みます。
//: - `.` / `..` を除外してから byte 辞書順に sort します。
//: - directory entry name の蓄積で確保に失敗した場合は `Err(12)` を返します。
//:
//: 注意(重要):
//: - WASI cookie は通常の directory 規模を想定し、dirent の `d_next` low 32 bit を次回 cookie として使います。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
fn fs_read_dir_fd <(i32)*>Result<Vec<str>,i32>> (fd):
    match v::new<str>:
        Result::Err _e:
            Result<Vec<str>,i32>::Err 12
        Result::Ok entries0:
            let mut entries <Vec<str>> entries0
            let buf_len <i32> fs_readdir_buf_size
            match alloc_ptr<u8> buf_len:
                Result::Err _e:
                    v::free<str> entries
                    Result<Vec<str>,i32>::Err 12
                Result::Ok buf:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> buf buf_len:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            v::free<str> entries
                            Result<Vec<str>,i32>::Err 12
                        Result::Ok used_buf:
                            let mut cookie <i64> <i64> cast 0
                            let mut err <i32> 0
                            let mut done <bool> false
                            let buf_raw <i32> mem_ptr_addr buf
                            let used_raw <i32> mem_ptr_addr used_buf
                            while and not done eq err 0:
                                do:
                                    store_i32 used_raw 0
                                    let errno <i32> wasi_fd_readdir fd buf_raw buf_len cookie used_raw
                                    if:
                                        ne errno 0
                                        then:
                                            set err errno
                                        else:
                                            let used <i32> load_i32 used_raw
                                            if:
                                                eq used 0
                                                then:
                                                    set done true
                                                else:
                                                    let mut off <i32> 0
                                                    while and eq err 0 lt off used:
                                                        do:
                                                            let header_end <i32> add off fs_dirent_header_size
                                                            if:
                                                                gt header_end used
                                                                then:
                                                                    set err fs_errno_inval
                                                                else:
                                                                    let rec <i32> add buf_raw off
                                                                    let next_cookie_low <i32> load_i32 rec
                                                                    let name_len <i32> load_i32 add rec 16
                                                                    let name_off <i32> add header_end name_len
                                                                    if:
                                                                        or lt name_len 0 or lt name_off header_end gt name_off used
                                                                        then:
                                                                            set err fs_errno_inval
                                                                        else:
                                                                            match fs_string_from_bytes add rec fs_dirent_header_size name_len:
                                                                                Result::Err e:
                                                                                    set err e
                                                                                Result::Ok name:
                                                                                    if:
                                                                                        fs_dir_name_is_dot name
                                                                                        then:
                                                                                            ()
                                                                                        else:
                                                                                            match v::push<str> entries name:
                                                                                                Result::Ok next_entries:
                                                                                                    set entries next_entries
                                                                                                Result::Err _e:
                                                                                                    set entries v::Vec<str> 0 0 mem_ptr_wrap 0
                                                                                                    set err 12
                                                                            set cookie <i64> cast next_cookie_low
                                                                            set off name_off
                                                    if:
                                                        lt used buf_len
                                                        then:
                                                            set done true
                                                        else:
                                                            ()
                            match dealloc_ptr<u8> used_buf 4:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            match dealloc_ptr<u8> buf buf_len:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            if:
                                eq err 0
                                then:
                                    let entries_len <i32> get entries "len"
                                    let entries_data <i32> mem_ptr_addr get entries "data"
                                    fs_sort_strings entries_data entries_len
                                    Result<Vec<str>,i32>::Ok entries
                                else:
                                    v::free<str> entries
                                    Result<Vec<str>,i32>::Err err

//: fs_read_dir: directory entry 名を安定順で返す
//:
//: 目的:
//: - self-host compiler の stdlib discovery と import root scanning に必要な directory traversal を提供します。
//:
//: 実装(アルゴリズム):
//: - path を正規化して directory fd を開き、`fd_readdir` の結果を `Vec<str>` に変換して sort します。
//:
//: 注意(重要):
//: - 戻り値は entry 名だけです。親 path との結合は caller が `/` 区切りで行います。
//: - `..` による preopen root 外への escape は `Err(76)` です。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
fn fs_read_dir <(str)*>Result<Vec<str>,i32>> (path):
    match fs_open_dir path:
        Result::Err e:
            Result<Vec<str>,i32>::Err e
        Result::Ok fd:
            let res <Result<Vec<str>,i32>> fs_read_dir_fd fd
            match fs_close fd:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res

//: fs_read_fd_bytes: fd から全て読み込んで `ByteBuf` を返す
//:
//: 目的:
//: - fd の内容をすべて読み込み、バイト列として返します。
//:
//: 実装(アルゴリズム):
//: - 64KiB から開始する連続 buffer を必要に応じて再確保し、EOF まで `fd_read` を繰り返します。
//:
//: 注意(重要):
//: - 途中でエラーが出た場合は Err(errno) を返します。
//:
//: 計算量:
//: - O(n)
//: fs_read_fd_bytes: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_fd_bytes` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "fd bytes"
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_read_fd_bytes 0:
//:         Result::Ok bytes:
//:             let text <str> fs_bytes_to_string bytes;
//:             if str_eq text "fd bytes" 0 1
//:         Result::Err _e:
//:             1
//: ```
fn fs_read_fd_bytes <(i32)*>Result<ByteBuf,i32>> (fd):
    let mut cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<ByteBuf,i32>::Err 12
        Result::Ok buf0:
            let mut buf <MemPtr<u8>> buf0;
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _e:
                            ();
                    Result<ByteBuf,i32>::Err 12
                Result::Ok iov_buf:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> iov_buf 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            Result<ByteBuf,i32>::Err 12
                        Result::Ok nread_buf:
                            let mut read_len <i32> 0;
                            let mut done <i32> 0;
                            let mut err <i32> 0;
                            let mut alloc_failed <i32> 0;

                            while eq done 0:
                                do:
                                    if:
                                        eq read_len cap
                                        then:
                                            let new_cap <i32> mul cap 2;
                                            match realloc_ptr<u8> buf cap new_cap:
                                                Result::Ok new_buf:
                                                    set buf new_buf;
                                                    set cap new_cap;
                                                Result::Err _e:
                                                    set alloc_failed 1;
                                                    set done 1;
                                        else:
                                            ();
                                    if:
                                        eq done 0
                                        then:
                                            match fs_fd_read_into_result fd iov_buf nread_buf mem_ptr_add buf read_len sub cap read_len:
                                                Result::Ok n:
                                                    if:
                                                        eq n 0
                                                        then:
                                                            set done 1
                                                        else:
                                                            set read_len add read_len n
                                                Result::Err e:
                                                    set err e;
                                                    set done 1
                                        else:
                                            ()

                            let res <Result<ByteBuf,i32>> if:
                                eq alloc_failed 1
                                then:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e:
                                            ()
                                    Result<ByteBuf,i32>::Err 12
                                else:
                                    if:
                                        eq err 0
                                        then:
                                            fs_finish_read_buffer buf cap read_len
                                        else:
                                            match dealloc_ptr<u8> buf cap:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _e:
                                                    ()
                                            Result<ByteBuf,i32>::Err err
                            match dealloc_ptr<u8> nread_buf 4:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            match dealloc_ptr<u8> iov_buf 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            res

//: fs_std_error_to_errno: stdlib 共通 error kind を fs errno へ写す
//:
//: 目的:
//: - `alloc/io` の `StdErrorKind` を、`std/fs` の既存 API が使う i32 errno へ変換します。
//:
//: 実装(アルゴリズム):
//: - OutOfMemory は WASI errno の 12、InvalidUtf8 は ILSEQ 相当の 84 に対応させ、それ以外は I/O error 相当の 5 に丸めます。
//:
//: 注意(重要):
//: - fs API の error 型が `StdErrorKind` へ移行するまでの境界変換です。
//:
//: 計算量:
//: - O(1)
fn fs_std_error_to_errno <(StdErrorKind)->i32> (kind):
    match kind:
        StdErrorKind::Failure:
            5
        StdErrorKind::OutOfMemory:
            12
        StdErrorKind::EmptyCollection:
            5
        StdErrorKind::IndexOutOfBounds:
            5
        StdErrorKind::KeyNotFound:
            5
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            5
        StdErrorKind::InvalidUtf8:
            fs_errno_ilseq
        StdErrorKind::ParseError:
            5
        StdErrorKind::IoError:
            5
        StdErrorKind::Other:
            5

//: fs_bytes_to_string_result: `ByteBuf` を UTF-8 検証して str に変換する
//:
//: 目的:
//: - バイト列が UTF-8 として妥当な場合だけ str 形式に詰め直し、invalid UTF-8 と確保失敗を errno として返します。
//:
//: 実装(アルゴリズム):
//: - `io_bytebuf_to_str_result` を使い、所有 buffer を UTF-8 検証つきで str 形式へ詰め替えます。
//: - `StdErrorKind` は fs API の errno へ写します。
//:
//: 注意(重要):
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
//: - invalid UTF-8 は errno 84 (ILSEQ 相当) として返します。
//:
//: 計算量:
//: - O(n)
fn fs_bytes_to_string_result <(ByteBuf)*>Result<str,i32>> (buf):
    match io_bytebuf_to_str_result buf:
        Result::Ok text:
            Result<str,i32>::Ok text
        Result::Err e:
            Result<str,i32>::Err fs_std_error_to_errno e

//: fs_bytes_to_string: `ByteBuf` を str に変換する互換 facade
//:
//: 目的:
//: - 既存コード向けに `str` を直接返す入口を維持します。
//:
//: 実装(アルゴリズム):
//: - `fs_bytes_to_string_result` に委譲し、失敗時だけ空文字列へ丸めます。
//:
//: 注意(重要):
//: - 空 buffer と確保失敗や invalid UTF-8 を区別する必要がある場合は `fs_bytes_to_string_result` を使ってください。
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
//:
//: 計算量:
//: - O(n)
//: fs_bytes_to_string: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_bytes_to_string` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "alloc/io" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let text <str> fs_bytes_to_string io_bytebuf_from_str "A";
//:     if str_eq text "A" 0 1
//: ```
fn fs_bytes_to_string <(ByteBuf)*>str> (buf):
    match fs_bytes_to_string_result buf:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: fs_bytes_to_utf8_string_result: `ByteBuf` を UTF-8 [検証/けんしょう]して str に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - source file など text として[扱/あつか]う byte [列/れつ]を、invalid UTF-8 を[拒否/きょひ]してから `str` へ[変換/へんかん]します。
//:
//: [実装/じっそう]:
//: - `std/text` の checked conversion に[委譲/いじょう]し、`StdErrorKind` を fs API の errno に[写/うつ]します。
//:
//: [注意/ちゅうい]:
//: - 入力 `ByteBuf` は成功時も失敗時も[消費/しょうひ]されます。
//: - binary protocol や互換読み込みでは unchecked `fs_bytes_to_string_result` を使い、source text ではこの関数を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn fs_bytes_to_utf8_string_result <(ByteBuf)*>Result<str,i32>> (buf):
    match text_bytebuf_to_utf8_str_result buf:
        Result::Ok text:
            Result<str,i32>::Ok text
        Result::Err e:
            Result<str,i32>::Err fs_std_error_to_errno e

//: fs_close: fd を閉じる
//:
//: 目的:
//: - `fs_open_read` / `fs_open_write` で得た fd を明示的に閉じます。
//:
//: 実装(アルゴリズム):
//: - WASI `fd_close` を呼び、errno 0 を `Ok(())`、それ以外を `Err(errno)` に変換します。
//:
//: 注意(重要):
//: - write fd では close 時に host runtime が残りの出力を確定する場合があります。
//:
//: 計算量:
//: - O(1)
fn fs_close <(i32)*>Result<(),i32>> (fd):
    let errno <i32> wasi_fd_close fd
    if:
        eq errno 0
        then:
            Result<(),i32>::Ok ()
        else:
            Result<(),i32>::Err errno

//: fs_write_fd_bytes: fd へ `ByteBuf` をすべて書き込む
//:
//: 目的:
//: - 既に開いている fd に所有 byte buffer の内容を最後まで書き込みます。
//:
//: 実装(アルゴリズム):
//: - 1 要素 iovec を使って `fd_write` を呼び、partial write の場合は offset を進めて再試行します。
//: - `nwritten <= 0` は進捗不能な I/O failure として errno 5 に丸めます。
//:
//: 注意(重要):
//: - 入力 `ByteBuf` は成功時も失敗時もこの関数が解放します。
//: - fd の妥当性と host 側の権限は WASI runtime に委ねます。
//:
//: 計算量:
//: - 書き込み byte 数 n に対して O(n)
fn fs_write_fd_mem_result <(i32,MemPtr<u8>,i32)*>Result<(),i32>> (fd, data, data_len):
    if:
        le data_len 0
        then:
            Result<(),i32>::Ok ()
        else:
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    Result<(),i32>::Err 12
                Result::Ok iov_buf:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> iov_buf 8:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            Result<(),i32>::Err 12
                        Result::Ok nwritten_buf:
                            let mut off <i32> 0
                            let mut done <i32> 0
                            let mut err <i32> 0
                            while eq done 0:
                                do:
                                    if:
                                        ge off data_len
                                        then:
                                            set done 1
                                        else:
                                            match fs_fd_write_from_result fd iov_buf nwritten_buf mem_ptr_add data off sub data_len off:
                                                Result::Ok n:
                                                    if:
                                                        le n 0
                                                        then:
                                                            set err 5
                                                            set done 1
                                                        else:
                                                            set off add off n
                                                Result::Err e:
                                                    set err e
                                                    set done 1
                            match dealloc_ptr<u8> nwritten_buf 4:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            match dealloc_ptr<u8> iov_buf 8:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            if:
                                eq err 0
                                then:
                                    Result<(),i32>::Ok ()
                                else:
                                    Result<(),i32>::Err err

fn fs_write_fd_bytes <(i32,ByteBuf)*>Result<(),i32>> (fd, bytes):
    let data_len <i32> get bytes "len"
    match get bytes "ptr":
        Option::None:
            if:
                eq data_len 0
                then:
                    Result<(),i32>::Ok ()
                else:
                    Result<(),i32>::Err 22
        Option::Some data:
            let result <Result<(),i32>> fs_write_fd_mem_result fd data data_len
            match dealloc_ptr<u8> data io_bytebuf_storage_size data_len:
                Result::Ok _:
                    result
                Result::Err _:
                    result

//: fs_write_to_bytes: path へ `ByteBuf` を create/truncate して書き込む
//:
//: 目的:
//: - path に binary artifact を保存します。
//:
//: 実装(アルゴリズム):
//: - `fs_open_write` → `fs_write_fd_bytes` → `fs_close` の順に処理します。
//:
//: 注意(重要):
//: - 入力 `ByteBuf` は open 失敗時も含めてこの関数が解放します。
//: - write 成功後に close が失敗した場合は close の errno を返します。
//:
//: 計算量:
//: - 書き込み byte 数 n に対して O(n)
fn fs_write_to_bytes <(str,ByteBuf)*>Result<(),i32>> (path, bytes):
    match fs_open_write path:
        Result::Err e:
            io_bytebuf_free bytes
            Result<(),i32>::Err e
        Result::Ok fd:
            match fs_write_fd_bytes fd bytes:
                Result::Ok _:
                    fs_close fd
                Result::Err e:
                    match fs_close fd:
                        Result::Ok _:
                            ()
                        Result::Err _:
                            ()
                    Result<(),i32>::Err e

//: fs_write_to_string: path へ str を create/truncate して書き込む
//:
//: 目的:
//: - text artifact を file として保存します。
//:
//: 実装(アルゴリズム):
//: - `io_bytebuf_from_str_result` で byte buffer へ複製し、`fs_write_to_bytes` に委譲します。
//:
//: 注意(重要):
//: - UTF-8 検証や改行変換は行わず、str の byte 表現をそのまま保存します。
//:
//: 計算量:
//: - 入力長 n に対して O(n)
//: fs_write_to_string: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_write_to_string` で作ったファイルを `fs_read_to_string` で読み戻せることを確認します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_write_to_string "tmp/fs_write_to_string_doctest.txt" "fs write":
//:         Result::Err _e:
//:             1
//:         Result::Ok _:
//:             match fs_read_to_string "tmp/fs_write_to_string_doctest.txt":
//:                 Result::Ok text:
//:                     if str_eq text "fs write" 0 2
//:                 Result::Err _e:
//:                     3
//: ```
fn fs_write_to_string <(str,str)*>Result<(),i32>> (path, text):
    match io_bytebuf_from_str_result text:
        Result::Ok bytes:
            fs_write_to_bytes path bytes
        Result::Err e:
            Result<(),i32>::Err fs_std_error_to_errno e

//: fs_read_to_bytes: ファイルを読み込んで `ByteBuf` を返す
//:
//: 目的:
//: - path を開き、内容をバイト列として返します。
//:
//: 実装(アルゴリズム):
//: - fs_open_read → fs_read_fd_bytes → fd_close の順に処理します。
//:
//: 注意(重要):
//: - 失敗時は Err(errno) を返します。
//:
//: 計算量:
//: - O(n)
//: fs_read_to_bytes: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_to_bytes` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_read_to_bytes "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok bytes:
//:             let text <str> fs_bytes_to_string bytes;
//:             if:
//:                 str_eq text "fs fixture text\n"
//:                 then 0
//:                 else if str_eq text "fs fixture text\r\n" 0 1
//:         Result::Err _e:
//:             2
//: ```
fn fs_read_to_bytes <(str)*>Result<ByteBuf,i32>> (path):
    match fs_open_read path:
        Result::Ok fd:
            let res <Result<ByteBuf,i32>> fs_read_fd_bytes fd;
            match fs_close fd:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res
        Result::Err e:
            Result::Err e

//: fs_read_to_string: ファイルを読み込んで str を返す
//:
//: 目的:
//: - path を読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - fs_read_to_bytes で読み込み、fs_bytes_to_string_result で UTF-8 検証つき変換を行います。
//:
//: 注意(重要):
//: - invalid UTF-8 は errno 84 (ILSEQ 相当) として返します。
//: - 失敗時は Err(errno) を返します。
//:
//: 計算量:
//: - O(n)
//: fs_read_to_string: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_to_string` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_read_to_string "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok text:
//:             if:
//:                 str_eq text "fs fixture text\n"
//:                 then 0
//:                 else if str_eq text "fs fixture text\r\n" 0 1
//:         Result::Err _e:
//:             2
//: ```
fn fs_read_to_string <(str)*>Result<str,i32>> (path):
    match fs_read_to_bytes path:
        Result::Ok bytes:
            fs_bytes_to_string_result bytes
        Result::Err e:
            Result::Err e

//: fs_read_to_string_checked: ファイルを UTF-8 [検証/けんしょう]して str として[読/よ]み[込/こ]む
//:
//: [目的/もくてき]:
//: - compiler source や設定 file など、`str` として[扱/あつか]う[前提/ぜんてい]の file を invalid UTF-8 から[守/まも]ります。
//:
//: [実装/じっそう]:
//: - `fs_read_to_bytes` で binary として[読/よ]み、`fs_bytes_to_utf8_string_result` で UTF-8 [検証/けんしょう]と `str` [変換/へんかん]を[行/おこな]います。
//:
//: [注意/ちゅうい]:
//: - binary file を text として[読/よ]む API ではありません。binary artifact は `fs_read_to_bytes` を[使/つか]ってください。
//: - invalid UTF-8 は errno 84 (ILSEQ 相当) として[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn fs_read_to_string_checked <(str)*>Result<str,i32>> (path):
    match fs_read_to_bytes path:
        Result::Ok bytes:
            fs_bytes_to_utf8_string_result bytes
        Result::Err e:
            Result::Err e
