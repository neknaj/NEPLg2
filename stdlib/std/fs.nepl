//: # std/fs
//: filesystem API の facade module
//:
//: ### 目的
//: - `std/fs/*` の責務別 submodule をまとめて re-export します。
//: - 利用側は必要に応じて `std/fs` 全体、または `std/fs/read` などの個別 module を import できます。
//:
//: ### 注意
//: - 実装本体は submodule に置き、この facade は API 公開境界だけを担当します。
//: - `std/fs/raw` は WASI / LLVM ABI 境界なので、この root facade からは再公開しません。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//: fn main %impure fn unit i32 \unit:
//:     if fs_exists "__definitely_missing_fs_facade_case__.txt" then 1 else 0
//: ```

#indent 4

pub #import "./fs/constants" as *
pub #import "./fs/path" as *
pub #import "./fs/fd" as *
pub #import "./fs/stat" as *
pub #import "./fs/dir" as *
pub #import "./fs/bytes" as *
pub #import "./fs/read" as *
pub #import "./fs/write" as *
