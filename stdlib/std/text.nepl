//: # text
//: UTF-8 text [境界/きょうかい]で[使/つか]う byte [列/れつ]の[検証/けんしょう]と checked [変換/へんかん]を[集/あつ]めるライブラリ
//:
//: ### [目的/もくてき]
//: - filesystem や stdin から[入/はい]る raw `ByteBuf` を、`str` として[扱/あつか]う[前/まえ]に UTF-8 として[妥当/だとう]か[検査/けんさ]します。
//: - `alloc/io` の `ByteBuf -> str` 境界も checked ですが、source text [向/む]けには invalid UTF-8 を明示的に `InvalidUtf8` として返すこの入口を使います。
//:
//: ### [注意/ちゅうい]
//: - `text_bytebuf_to_utf8_str_result` は[入力/にゅうりょく] `ByteBuf` の[所有権/しょゆうけん]を[消費/しょうひ]し、成功時も失敗時も caller は buffer を[再利用/さいりよう]しません。
//: - UTF-8 の scalar value [制約/せいやく]も[確認/かくにん]するため、overlong sequence や surrogate range は `InvalidUtf8` になります。
//:
//: ### [計算量/けいさんりょう]
//: - [入力/にゅうりょく] byte [数/すう] n に[対/たい]して O(n) です。

#indent 4

#import "alloc/io" as *
#import "core/char" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *

//: UTF-8 leading byte の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - leading byte の range [判定/はんてい]を enum にし、sequence [長/なが]さごとの[検証/けんしょう]を `match` で[分岐/ぶんき]します。
enum TextUtf8LeadKind:
    Ascii
    Two
    Three
    Four
    Invalid

fn text_utf8_in_range <(i32,i32,i32)->bool> (b, lo, hi):
    and ge b lo le b hi

fn text_utf8_is_continuation <(i32)->bool> (b):
    text_utf8_in_range b 128 191

fn text_utf8_lead_kind <(i32)->TextUtf8LeadKind> (b):
    if:
        le b 127
        then:
            TextUtf8LeadKind::Ascii
        else:
            if:
                text_utf8_in_range b 194 223
                then:
                    TextUtf8LeadKind::Two
                else:
                    if:
                        text_utf8_in_range b 224 239
                        then:
                            TextUtf8LeadKind::Three
                        else:
                            if:
                                text_utf8_in_range b 240 244
                                then:
                                    TextUtf8LeadKind::Four
                                else:
                                    TextUtf8LeadKind::Invalid

fn text_utf8_byte_at <(MemPtr<u8>,i32)->Result<i32, StdErrorKind>> (data, idx):
    match load_u8 mem_ptr_add data idx:
        Option::Some b:
            Result<i32, StdErrorKind>::Ok b
        Option::None:
            Result<i32, StdErrorKind>::Err StdErrorKind::InvalidOperation

fn text_utf8_validate_two <(MemPtr<u8>,i32,i32)->Result<(), StdErrorKind>> (data, i, byte_len):
    if:
        gt add i 2 byte_len
        then:
            Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(), StdErrorKind>::Err e
                Result::Ok b1:
                    if:
                        text_utf8_is_continuation b1
                        then:
                            Result<(), StdErrorKind>::Ok ()
                        else:
                            Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8

fn text_utf8_validate_three <(MemPtr<u8>,i32,i32,i32)->Result<(), StdErrorKind>> (data, i, byte_len, b0):
    if:
        gt add i 3 byte_len
        then:
            Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(), StdErrorKind>::Err e
                Result::Ok b1:
                    match text_utf8_byte_at data add i 2:
                        Result::Err e:
                            Result<(), StdErrorKind>::Err e
                        Result::Ok b2:
                            let first_ok <bool>:
                                if:
                                    eq b0 224
                                    then:
                                        text_utf8_in_range b1 160 191
                                    else:
                                        if:
                                            eq b0 237
                                            then:
                                                text_utf8_in_range b1 128 159
                                            else:
                                                text_utf8_is_continuation b1
                            if:
                                and first_ok text_utf8_is_continuation b2
                                then:
                                    Result<(), StdErrorKind>::Ok ()
                                else:
                                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8

fn text_utf8_validate_four <(MemPtr<u8>,i32,i32,i32)->Result<(), StdErrorKind>> (data, i, byte_len, b0):
    if:
        gt add i 4 byte_len
        then:
            Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(), StdErrorKind>::Err e
                Result::Ok b1:
                    match text_utf8_byte_at data add i 2:
                        Result::Err e:
                            Result<(), StdErrorKind>::Err e
                        Result::Ok b2:
                            match text_utf8_byte_at data add i 3:
                                Result::Err e:
                                    Result<(), StdErrorKind>::Err e
                                Result::Ok b3:
                                    let first_ok <bool>:
                                        if:
                                            eq b0 240
                                            then:
                                                text_utf8_in_range b1 144 191
                                            else:
                                                if:
                                                    eq b0 244
                                                    then:
                                                        text_utf8_in_range b1 128 143
                                                    else:
                                                        text_utf8_is_continuation b1
                                    if:
                                        and first_ok and text_utf8_is_continuation b2 text_utf8_is_continuation b3
                                        then:
                                            Result<(), StdErrorKind>::Ok ()
                                        else:
                                            Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8

//: text_utf8_validate_mem: raw byte [列/れつ]が UTF-8 として[妥当/だとう]か[検証/けんしょう]する
//:
//: [目的/もくてき]:
//: - `MemPtr<u8>` と byte [長/なが]さで[表/あらわ]された[領域/りょういき]を、`str` へ[変換/へんかん]する[前/まえ]に[検査/けんさ]します。
//:
//: [実装/じっそう]:
//: - leading byte を `TextUtf8LeadKind` に[分類/ぶんるい]し、sequence [長/なが]さごとに continuation byte と overlong/surrogate [制約/せいやく]を[確認/かくにん]します。
//:
//: [注意/ちゅうい]:
//: - byte_len が[負/ふ]の[場合/ばあい]や pointer [読/よ]み[出/だ]しに[失敗/しっぱい]した[場合/ばあい]は `InvalidOperation` を[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn text_utf8_validate_mem <(MemPtr<u8>,i32)->Result<(), StdErrorKind>> (data, byte_len):
    if:
        lt byte_len 0
        then:
            Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            let mut i <i32> 0
            let mut done <i32> 0
            let mut res <Result<(), StdErrorKind>> Result<(), StdErrorKind>::Ok ()
            while eq done 0:
                do:
                    if:
                        ge i byte_len
                        then:
                            set done 1
                        else:
                            match text_utf8_byte_at data i:
                                Result::Err e:
                                    set res Result<(), StdErrorKind>::Err e
                                    set done 1
                                Result::Ok b0:
                                    match text_utf8_lead_kind b0:
                                        TextUtf8LeadKind::Ascii:
                                            set i add i 1
                                        TextUtf8LeadKind::Two:
                                            match text_utf8_validate_two data i byte_len:
                                                Result::Ok _:
                                                    set i add i 2
                                                Result::Err e:
                                                    set res Result<(), StdErrorKind>::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Three:
                                            match text_utf8_validate_three data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 3
                                                Result::Err e:
                                                    set res Result<(), StdErrorKind>::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Four:
                                            match text_utf8_validate_four data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 4
                                                Result::Err e:
                                                    set res Result<(), StdErrorKind>::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Invalid:
                                            set res Result<(), StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                            set done 1
            res

//: text_is_valid_scalar: i32 code point が Unicode scalar value として[妥当/だとう]か[判定/はんてい]する
fn text_is_valid_scalar <(i32)->bool> (code):
    char_is_valid_scalar_code code

fn text_utf8_decode_ok <(char,i32)->Result<CharUtf8Step, StdErrorKind>> (c, next_byte_index):
    Result<CharUtf8Step, StdErrorKind>::Ok char_utf8_step_new c next_byte_index

fn text_utf8_decode_char_result <(i32,i32)->Result<CharUtf8Step, StdErrorKind>> (code, next_byte_index):
    match char_from_i32_result code:
        Result::Err _e:
            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
        Result::Ok c:
            text_utf8_decode_ok c next_byte_index

//: text_utf8_decode_next: raw byte [列/れつ]から UTF-8 の 1 char を decode する
//:
//: [目的/もくてき]:
//: - `ByteBuf` や外部入力を `str` に変換する前でも、1 scalar value ずつ検査しながら読めるようにします。
//:
//: [注意/ちゅうい]:
//: - 戻り値の `CharUtf8Step.value` が `char`、`CharUtf8Step.next` が次の byte offset です。
fn text_utf8_decode_next <(MemPtr<u8>,i32,i32)->Result<CharUtf8Step, StdErrorKind>> (data, byte_len, i):
    if:
        or lt i 0 le byte_len i
        then:
            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
        else:
            match text_utf8_byte_at data i:
                Result::Err e:
                    Result<CharUtf8Step, StdErrorKind>::Err e
                Result::Ok b0:
                    if:
                        le b0 0x7F
                        then:
                            text_utf8_decode_char_result b0 add i 1
                        else:
                            match text_utf8_lead_kind b0:
                                TextUtf8LeadKind::Ascii:
                                    Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                TextUtf8LeadKind::Two:
                                    if:
                                        le byte_len add i 1
                                        then:
                                            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                        else:
                                            match text_utf8_byte_at data add i 1:
                                                Result::Err e:
                                                    Result<CharUtf8Step, StdErrorKind>::Err e
                                                Result::Ok b1:
                                                    if:
                                                        text_utf8_is_continuation b1
                                                        then:
                                                            let hi <i32> shl and b0 0x1F 6
                                                            let lo <i32> and b1 0x3F
                                                            text_utf8_decode_char_result or hi lo add i 2
                                                        else:
                                                            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                TextUtf8LeadKind::Three:
                                    if:
                                        le byte_len add i 2
                                        then:
                                            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                        else:
                                            match text_utf8_byte_at data add i 1:
                                                Result::Err e:
                                                    Result<CharUtf8Step, StdErrorKind>::Err e
                                                Result::Ok b1:
                                                    match text_utf8_byte_at data add i 2:
                                                        Result::Err e:
                                                            Result<CharUtf8Step, StdErrorKind>::Err e
                                                        Result::Ok b2:
                                                            let first_ok <bool>:
                                                                if:
                                                                    eq b0 0xE0
                                                                    then:
                                                                        text_utf8_in_range b1 0xA0 0xBF
                                                                    else:
                                                                        if:
                                                                            eq b0 0xED
                                                                            then:
                                                                                text_utf8_in_range b1 0x80 0x9F
                                                                            else:
                                                                                text_utf8_is_continuation b1
                                                            if:
                                                                and first_ok text_utf8_is_continuation b2
                                                                then:
                                                                    let part0 <i32> shl and b0 0x0F 12
                                                                    let part1 <i32> shl and b1 0x3F 6
                                                                    let part2 <i32> and b2 0x3F
                                                                    text_utf8_decode_char_result or part0 or part1 part2 add i 3
                                                                else:
                                                                    Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                TextUtf8LeadKind::Four:
                                    if:
                                        le byte_len add i 3
                                        then:
                                            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                        else:
                                            match text_utf8_byte_at data add i 1:
                                                Result::Err e:
                                                    Result<CharUtf8Step, StdErrorKind>::Err e
                                                Result::Ok b1:
                                                    match text_utf8_byte_at data add i 2:
                                                        Result::Err e:
                                                            Result<CharUtf8Step, StdErrorKind>::Err e
                                                        Result::Ok b2:
                                                            match text_utf8_byte_at data add i 3:
                                                                Result::Err e:
                                                                    Result<CharUtf8Step, StdErrorKind>::Err e
                                                                Result::Ok b3:
                                                                    let first_ok <bool>:
                                                                        if:
                                                                            eq b0 0xF0
                                                                            then:
                                                                                text_utf8_in_range b1 0x90 0xBF
                                                                            else:
                                                                                if:
                                                                                    eq b0 0xF4
                                                                                    then:
                                                                                        text_utf8_in_range b1 0x80 0x8F
                                                                                    else:
                                                                                        text_utf8_is_continuation b1
                                                                    if:
                                                                        and first_ok and text_utf8_is_continuation b2 text_utf8_is_continuation b3
                                                                        then:
                                                                            let part0 <i32> shl and b0 0x07 18
                                                                            let part1 <i32> shl and b1 0x3F 12
                                                                            let part2 <i32> shl and b2 0x3F 6
                                                                            let part3 <i32> and b3 0x3F
                                                                            text_utf8_decode_char_result or part0 or part1 or part2 part3 add i 4
                                                                        else:
                                                                            Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                                TextUtf8LeadKind::Invalid:
                                    Result<CharUtf8Step, StdErrorKind>::Err StdErrorKind::InvalidUtf8

//: text_utf8_encode_char: char 1 つを UTF-8 `ByteBuf` へ encode する
fn text_utf8_encode_char <(char)*>Result<ByteBuf, StdErrorKind>> (c):
    io_bytebuf_from_char_utf8_result c

//: text_bytebuf_to_utf8_str_result: `ByteBuf` を UTF-8 [検証/けんしょう]して `str` へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - file / stdin / binary stream から[得/え]た byte [列/れつ]を、source text [向/む]けに checked `str` へ[変換/へんかん]します。
//:
//: [実装/じっそう]:
//: - 先に `text_utf8_validate_mem` で[全体/ぜんたい]を[検査/けんさ]し、成功したときだけ `io_bytebuf_to_str_result` で text layout へ[詰/つ]め[直/なお]します。
//:
//: [注意/ちゅうい]:
//: - 入力 `ByteBuf` は成功時も失敗時も[消費/しょうひ]されます。
//: - invalid UTF-8 の[場合/ばあい]は buffer を[解放/かいほう]して `StdErrorKind::InvalidUtf8` を[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn text_bytebuf_to_utf8_str_result <(ByteBuf)*>Result<str, StdErrorKind>> (buf):
    let byte_len <i32> get buf "len"
    match get buf "ptr":
        Option::None:
            if:
                eq byte_len 0
                then:
                    Result<str, StdErrorKind>::Ok ""
                else:
                    Result<str, StdErrorKind>::Err StdErrorKind::InvalidOperation
        Option::Some data:
            match text_utf8_validate_mem data byte_len:
                Result::Ok _:
                    io_bytebuf_to_str_result io_bytebuf_from_owned_ptr data byte_len
                Result::Err e:
                    match dealloc_ptr<u8> data io_bytebuf_storage_size byte_len:
                        Result::Ok _:
                            Result<str, StdErrorKind>::Err e
                        Result::Err _free:
                            Result<str, StdErrorKind>::Err e
