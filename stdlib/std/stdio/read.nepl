//: # std/stdio/read
//: `std/stdio` の stdin read API を提供する submodule
//:
//: ### 目的
//: - fd read の iovec scratch、growable buffer、UTF-8 検証を `std/stdio` 本体から分離します。
//: - raw ABI 境界は `std/stdio/raw`、read 用所有権 invariant はこの module に閉じ込めます。
//:
//: ### 注意
//: - `stdio_read_all_bytes_result` が返す `ByteBuf` は呼び出し側が所有します。
//: - text API は byte 入力を UTF-8 として検証し、不正な入力を `StdErrorKind` で返します。

#indent 4

#import "alloc/io" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/result" as *
#import "std/text" as *
#import "std/stdio/read/buffer" as *

//: ## stdio_read_all_bytes_result
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]み、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` や `StreamScanner` の binary read [入口/いりぐち]として、stdin [全体/ぜんたい]を `ByteBuf` として[保持/ほじ]します。
//:
//: ### [実装/じっそう]
//: - 64KiB から[開始/かいし]して buffer を[必要/ひつよう]に[応/おう]じて[拡張/かくちょう]し、EOF まで `fd_read` を[反復/はんぷく]します。
//: - [返/かえ]り[値/あたい]の `ByteBuf` は[呼/よ]び[出/だ]し[側/がわ]が[所有/しょゆう]します。
//: - allocation failure / invalid read boundary / fd_read failure は、それぞれ `StdErrorKind` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - text helper `read_all` とは[別経路/べつけいろ]です。text [変換/へんかん]を[伴/ともな]わないため、NUL を[含/ふく]む入力もそのまま[保持/ほじ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [読/よ]み[込/こ]んだ byte [数/すう]を n として O(n) です。
fn stdio_read_all_bytes_result <()*>Result<ByteBuf, StdErrorKind>> ():
    let mut cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok buf0:
            let mut buf <MemPtr<u8>> buf0;
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    dealloc_raw mem_ptr_addr buf cap;
                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok iov:
                    let iov_raw <i32> mem_ptr_addr iov;
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            dealloc_raw iov_raw 8;
                            dealloc_raw mem_ptr_addr buf cap;
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                        Result::Ok nread_ptr:
                            let nread_raw <i32> mem_ptr_addr nread_ptr;
                            let mut read_len <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            let mut failure <StdErrorKind> StdErrorKind::Failure;

                            while eq done 0:
                                do:
                                    if:
                                        eq read_len cap
                                        then:
                                            let new_cap <i32> mul cap 2;
                                            if:
                                                le new_cap cap
                                                then:
                                                    set failed 1;
                                                    set failure StdErrorKind::CapacityExceeded;
                                                    set done 1;
                                                else:
                                                    match realloc_ptr<u8> buf cap new_cap:
                                                        Result::Ok new_buf:
                                                            set buf new_buf;
                                                            set cap new_cap;
                                                        Result::Err _e:
                                                            set failed 1;
                                                            set failure StdErrorKind::OutOfMemory;
                                                            set done 1;
                                        else:
                                            ();

                                    if:
                                        eq done 0
                                        then:
                                            let remaining <i32> sub cap read_len;
                                            match stdio_fd_read_into_result 0 iov nread_ptr mem_ptr_add buf read_len remaining:
                                                Result::Err e:
                                                    set failed 1;
                                                    set failure e;
                                                    set done 1;
                                                Result::Ok n:
                                                    if:
                                                        or lt n 0 gt n remaining
                                                        then:
                                                            set failed 1;
                                                            set failure StdErrorKind::InvalidOperation;
                                                            set done 1;
                                                        else:
                                                            if:
                                                                eq n 0
                                                                then:
                                                                    set done 1;
                                                                else:
                                                                    set read_len add read_len n;
                                        else:
                                            ();

                            dealloc_raw iov_raw 8;
                            dealloc_raw nread_raw 4;

                            if:
                                eq failed 1
                                then:
                                    dealloc_raw mem_ptr_addr buf cap;
                                    Result<ByteBuf, StdErrorKind>::Err failure
                                else:
                                    stdio_finish_read_buffer buf cap read_len

//: ## stdio_read_all_bytes
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]む互換 facade
fn stdio_read_all_bytes <()*>ByteBuf> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            bytes
        Result::Err _e:
            io_bytebuf_empty

//: stdio_read_all_text_result: 標準入力を UTF-8 [検証/けんしょう]して[読/よ]み[込/こ]む
//:
//: [目的/もくてき]:
//: - stdin の raw byte [列/れつ]を text として[扱/あつか]う[前/まえ]に UTF-8 として[妥当/だとう]か[検証/けんしょう]し、invalid input を caller へ `Result` で[返/かえ]します。
//:
//: [実装/じっそう]:
//: - `stdio_read_all_bytes_result` で EOF まで[読/よ]み、成功時だけ `std/text` の checked conversion へ[委譲/いじょう]します。
//:
//: [注意/ちゅうい]:
//: - 入力 buffer は成功時も失敗時も[消費/しょうひ]されます。
//: - 互換 API の `read_all` は、この関数の失敗を空文字列へ[丸/まる]めます。error を[扱/あつか]うコードではこの関数を[使/つか]ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn stdio_read_all_text_result <()*>Result<str, StdErrorKind>> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            text_bytebuf_to_utf8_str_result bytes
        Result::Err e:
            Result<str, StdErrorKind>::Err e

//: read_all: 標準入力を EOF まで読み込む
//:
//: 目的:
//: - stdin から EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - `stdio_read_all_text_result` で UTF-8 検証付きの text read を行います。
//:
//: 注意(重要):
//: - 失敗時は空文字列を返します。
//: - error を扱う必要がある場合は `stdio_read_all_text_result` を使ってください。
//:
//: 計算量:
//: - O(n)
//: read_all: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_all` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "sample input"
//: stdout: "sample input"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_all;
//: ```
fn read_all <()*>str> ():
    match stdio_read_all_text_result:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: stdio_read_line_result: 1 行を UTF-8 検証付きで読み込む
//:
//: 目的:
//: - newline か EOF まで raw bytes を読み込み、UTF-8 として妥当な場合だけ `str` として返します。
//:
//: 実装(アルゴリズム):
//: - 1 バイトずつ `fd_read` し、改行または EOF で停止します。
//: - 読み込んだ byte 列は exact-size の `ByteBuf` に詰め直してから `text_bytebuf_to_utf8_str_result` へ渡します。
//:
//: 注意(重要):
//: - 最大 1024 バイトまでです。
//: - 失敗時は `StdErrorKind` を返します。互換 API の `read_line` は失敗を空文字列へ丸めます。
//:
//: 計算量:
//: - O(n)
fn stdio_read_line_result <()*>Result<str, StdErrorKind>> ():
    let cap <i32> 1024;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok buf:
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    dealloc_raw mem_ptr_addr buf cap;
                    Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok iov:
                    let iov_raw <i32> mem_ptr_addr iov;
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            dealloc_raw iov_raw 8;
                            dealloc_raw mem_ptr_addr buf cap;
                            Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                        Result::Ok nread:
                            let nread_raw <i32> mem_ptr_addr nread;
                            let mut line_len <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            let mut failure <StdErrorKind> StdErrorKind::Failure;

                            while eq done 0:
                                do:
                                    if:
                                        ge line_len cap
                                        then:
                                            set done 1;
                                        else:
                                            let write_ptr <MemPtr<u8>> mem_ptr_add buf line_len;
                                            let write_raw <i32> mem_ptr_addr write_ptr;
                                            if:
                                                le write_raw 0
                                                then:
                                                    set failed 1;
                                                    set failure StdErrorKind::InvalidOperation;
                                                    set done 1;
                                                else:
                                                    store_u8 write_raw 0;
                                                    match stdio_fd_read_into_result 0 iov nread write_ptr 1:
                                                        Result::Err e:
                                                            set failed 1;
                                                            set failure e;
                                                            set done 1;
                                                        Result::Ok n:
                                                            if:
                                                                or lt n 0 gt n 1
                                                                then:
                                                                    set failed 1;
                                                                    set failure StdErrorKind::InvalidOperation;
                                                                    set done 1;
                                                                else:
                                                                    if:
                                                                        eq n 0
                                                                        then:
                                                                            set done 1;
                                                                        else:
                                                                            let b <i32> load_u8 write_raw;
                                                                            if:
                                                                                eq b '\n'
                                                                                then:
                                                                                    set done 1;
                                                                                else:
                                                                                    set line_len add line_len 1;

                            dealloc_raw iov_raw 8;
                            dealloc_raw nread_raw 4;

                            if:
                                eq failed 1
                                then:
                                    dealloc_raw mem_ptr_addr buf cap;
                                    Result<str, StdErrorKind>::Err failure
                                else:
                                    match stdio_finish_read_buffer buf cap line_len:
                                        Result::Err e:
                                            Result<str, StdErrorKind>::Err e
                                        Result::Ok bytes:
                                            text_bytebuf_to_utf8_str_result bytes

//: read_line: 1 行読み込む
//:
//: 目的:
//: - newline か EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - `stdio_read_line_result` に委譲し、raw byte 列を UTF-8 として検証してから `str` にします。
//:
//: 注意(重要):
//: - 最大 1024 バイトまでです。
//: - 失敗時は空文字列を返します。error を扱う必要がある場合は `stdio_read_line_result` を使ってください。
//:
//: 計算量:
//: - O(n)
//: read_line: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_line` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "line1\nline2"
//: stdout: "line1"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_line;
//: ```
fn noshadow read_line <()*>str> ():
    match stdio_read_line_result:
        Result::Ok text:
            text
        Result::Err _e:
            ""
