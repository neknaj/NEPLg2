//: # std/stdio/ansi
//: `std/stdio` の ANSI escape code と color output helper を提供する submodule
//:
//: ### 目的
//: - 端末装飾用の escape code を `AnsiStyle` enum で表し、style 指定に静的検査を効かせます。
//: - escape code 生成は `match` に集約し、style 追加時に網羅性検査が働く形にします。
//:
//: ### 注意
//: - 端末が ANSI escape code に対応している環境での利用を想定します。
//: - `print_style` / `println_style` は互換 facade と同じく write error を扱いません。

#indent 4

#import "std/stdio/print" as *

//: AnsiStyle: ANSI escape code で表せる端末装飾
//:
//: [目的/もくてき]:
//: - color/style を任意 `str` ではなく enum として受け渡し、typo や未定義 style を型で排除します。
//:
//: [注意/ちゅうい]:
//: - `Reset` は装飾解除、`Bold` / `Underline` は文字装飾、その他は前景色です。
enum AnsiStyle:
    Reset
    Bold
    Underline
    Red
    Green
    Yellow
    Blue
    Magenta
    Cyan
    White
    Gray

//: ansi_style_code: ANSI style enum を escape code へ変換する
//:
//: [目的/もくてき]:
//: - `AnsiStyle` の全 variant を `match` で escape code に対応させます。
//:
//: [実装/じっそう]:
//: - variant ごとに固定の文字列リテラルを返します。
//: - wildcard を使わず全 variant を列挙し、style 追加時に網羅性検査で更新漏れを検出できる形にします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: stdout: "\u001b[31m"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print ansi_style_code AnsiStyle::Red;
//: ```
fn ansi_style_code <(AnsiStyle)->str> (style):
    match style:
        AnsiStyle::Reset:
            "\x1b[0m"
        AnsiStyle::Bold:
            "\x1b[1m"
        AnsiStyle::Underline:
            "\x1b[4m"
        AnsiStyle::Red:
            "\x1b[31m"
        AnsiStyle::Green:
            "\x1b[32m"
        AnsiStyle::Yellow:
            "\x1b[33m"
        AnsiStyle::Blue:
            "\x1b[34m"
        AnsiStyle::Magenta:
            "\x1b[35m"
        AnsiStyle::Cyan:
            "\x1b[36m"
        AnsiStyle::White:
            "\x1b[37m"
        AnsiStyle::Gray:
            "\x1b[90m"

//: ansi_reset_code: reset escape code を返す
//:
//: [目的/もくてき]:
//: - color output helper が最後に必ず使う reset code を名前付き helper として提供します。
//:
//: [実装/じっそう]:
//: - `ansi_style_code AnsiStyle::Reset` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn ansi_reset_code <()->str> ():
    ansi_style_code AnsiStyle::Reset

//: print_style: style を適用して文字列を出力する
//:
//: [目的/もくてき]:
//: - `style` を適用して `s` を出力し、最後に reset code を出力します。
//:
//: [実装/じっそう]:
//: - style code、本文、reset code の順に `print` へ委譲します。
//:
//: [注意/ちゅうい]:
//: - `style` は `AnsiStyle` なので任意の raw escape string は渡せません。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test
//: stdout: "\u001b[31msample\u001b[0m"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print_style AnsiStyle::Red "sample";
//: ```
fn print_style <(AnsiStyle,str)*>()> (style, s):
    print ansi_style_code style;
    print s;
    print ansi_reset_code;
    ()

//: println_style: style を適用して改行付きで出力する
//:
//: [目的/もくてき]:
//: - `print_style` の後に改行を追加します。
//:
//: [実装/じっそう]:
//: - `print_style` と `print "\\n"` を呼びます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test
//: stdout: "\u001b[31msample\u001b[0m\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     println_style AnsiStyle::Red "sample";
//: ```
fn println_style <(AnsiStyle,str)*>()> (style, s):
    print_style style s;
    print "\n";
