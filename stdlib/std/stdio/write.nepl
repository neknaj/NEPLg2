//: # std/stdio/write
//: stdout / stderr write API の public facade
//:
//: ### 目的
//: - fd write scratch、text adapter、ByteBuf owner cleanup、1 byte output を既存 import path から公開します。
//: - 実装は `write/fd`、`write/text`、`write/bytes`、`write/byte` に分け、WASI iovec 境界と利用者向け adapter が同居しないようにします。
//:
//: ### 注意
//: - `stdio_write_bytes_result` / `stdio_write_stderr_bytes_result` は入力 `ByteBuf` を成功/失敗にかかわらず消費します。
//: - この facade には処理本体を置きません。

#indent 4

pub #import "./write/fd" as @merge
pub #import "./write/text" as @merge
pub #import "./write/bytes" as @merge
pub #import "./write/byte" as @merge
