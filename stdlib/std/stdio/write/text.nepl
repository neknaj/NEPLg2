//: # std/stdio/write/text
//: `str` を stdout / stderr へ書き出す adapter
//:
//: ### 目的
//: - `str` の data pointer と length は `write/fd` の typed wrapper が同じ source object から導出します。
//: - stdout / stderr の fd 差分は `write/fd` の `stdio_write_fd_str_result` に委譲します。

#indent 4

#import "core/result" as *
#import "./fd" as *

//: ## stdio_write_str_result
//: `str` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
pub fn stdio_write_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_fd_str_result 1 s

//: ## stdio_write_stderr_str_result
//: `str` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
pub fn stdio_write_stderr_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_fd_str_result 2 s
