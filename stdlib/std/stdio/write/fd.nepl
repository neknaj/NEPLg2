//: # std/stdio/write/fd
//: stdout / stderr の fd write scratch 境界
//:
//: ### 目的
//: - WASI `fd_write` が要求する iovec / nwritten scratch と partial write 吸収をこの module に閉じ込めます。
//: - text / ByteBuf / print_byte adapter はこの fd 境界に委譲します。

#indent 4

#import "alloc/io" as *
#import "alloc/string" as string
#import "alloc/string/storage" as string_storage
#import "core/field" as *
#import "core/math" as math
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "std/stdio/raw" as *

//: ## stdio_write_fd_mem_result
//: fd を[指定/してい]して byte span を[書/か]き[出/だ]す内部 helper
//:
//: ### [目的/もくてき]
//: - stdout / stderr などの fd [差/さ]だけを[分/わ]け、partial write [吸収/きゅうしゅう]と error [返却/へんきゃく]を 1 [箇所/かしょ]へ[集約/しゅうやく]します。
//: - public API は `str` / `ByteBuf` / `ByteBuilder` / 1 byte の typed wrapper に限定し、この raw span helper は fd module 内部に閉じます。
//:
//: ### [実装/じっそう]
//: - WASI `fd_write(fd, iov, 1, nwritten)` を[呼/よ]び、`nwritten` が[残/のこ]り byte [数/すう]より[小/ちい]さい[場合/ばあい]は offset を[進/すす]めて[再試行/さいしこう]します。
//: - `fd_write` error、`nwritten == 0`、iov [確保/かくほ][失敗/しっぱい]は `StdErrorKind::IoError` へ[正規化/せいきか]します。
//: - `iov` / `nwritten` はこの関数だけが所有する `RegionToken<u8>` scratch 領域です。raw ABI layout は `std/stdio/raw` 境界へ委譲し、終了前に `dealloc_region` で必ず解放します。
//:
//: ### [注意/ちゅうい]
//: - `data` の[所有権/しょゆうけん]は[受/う]け[取/と]りません。呼び出し側が lifetime と解放を[管理/かんり]します。
//: - `data` と `data_len` の対応は、この file の typed wrapper が同じ source object から導出します。外部 caller には任意の pointer/length pair を渡させません。
//: - fd の[妥当性/だとうせい]は host WASI runtime に[委/ゆだ]ね、invalid fd は `Err(IoError)` として[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_fd_mem_result <(i32,MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (fd, data, data_len):
    if:
        math::le data_len 0
        then:
            Result<(), StdErrorKind>::Ok ()
        else:
            match alloc_region<u8> 8:
                Result::Err iov_alloc_error:
                    Result<(), StdErrorKind>::Err StdErrorKind::IoError
                Result::Ok iov_region:
                    let iov <MemPtr<u8>> region_ptr &iov_region
                    match alloc_region<u8> 4:
                        Result::Err nwritten_alloc_error:
                            match dealloc_region<u8> iov_region:
                                Result::Ok released_iov_after_alloc_error:
                                    ()
                                Result::Err release_iov_error_after_alloc_error:
                                    ()
                            Result<(), StdErrorKind>::Err StdErrorKind::IoError
                        Result::Ok nwritten_region:
                            let nwritten <MemPtr<u8>> region_ptr &nwritten_region
                            let mut off <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            while math::eq done 0:
                                do:
                                    if:
                                        math::ge off data_len
                                        then:
                                            set done 1;
                                            ()
                                        else:
                                            match stdio_fd_write_from_result fd iov nwritten mem_ptr_add data off math::sub data_len off:
                                                Result::Ok n:
                                                    if:
                                                        math::le n 0
                                                        then:
                                                            set failed 1;
                                                            set done 1;
                                                            ()
                                                        else:
                                                            set off math::add off n;
                                                            ()
                                                Result::Err write_error:
                                                    set failed 1;
                                                    set done 1;
                                                    ()
                            match dealloc_region<u8> nwritten_region:
                                Result::Ok released_nwritten:
                                    ()
                                Result::Err release_nwritten_error:
                                    ()
                            match dealloc_region<u8> iov_region:
                                Result::Ok released_iov:
                                    ()
                                Result::Err release_iov_error:
                                    ()
                            if:
                                math::eq failed 0
                                then:
                                    Result<(), StdErrorKind>::Ok ()
                                else:
                                    Result<(), StdErrorKind>::Err StdErrorKind::IoError

//: ## stdio_write_fd_str_result
//: fd を[指定/してい]して `str` を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - `str` の pointer と length を同じ文字列 object から導出してから fd write loop へ渡します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
pub fn stdio_write_fd_str_result <(i32,str)*>Result<(), StdErrorKind>> (fd, s):
    stdio_write_fd_mem_result fd string_storage::string_data_ptr s string::len s

//: ## stdio_write_fd_bytebuf_result
//: fd を[指定/してい]して `ByteBuf` を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - `ByteBuf` owner を消費し、成功/失敗にかかわらず storage を解放します。
//: - readable span は `ByteBuf` の `len` と storage view から導出し、raw pointer/length pair を public caller へ押し出しません。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
pub fn stdio_write_fd_bytebuf_result <(i32,ByteBuf)*>Result<(), StdErrorKind>> (fd, bytes):
    let data_len <i32> io_bytebuf_len_ref &bytes;
    if:
        math::le data_len 0
        then:
            io_bytebuf_free bytes
            Result<(), StdErrorKind>::Ok ()
        else:
            match io_bytebuf_ptr_ref &bytes:
                Option::Some data:
                    let result <Result<(), StdErrorKind>> stdio_write_fd_mem_result fd data data_len;
                    io_bytebuf_free bytes;
                    result
                Option::None:
                    io_bytebuf_free bytes
                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation

//: ## stdio_write_fd_bytebuilder_prefix_result
//: fd を[指定/してい]して `ByteBuilder` の有効 prefix を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - `StreamWriter` のように builder owner を保持したまま flush する処理のため、borrowed builder と byte count を受けます。
//: - `byte_len` が builder の現在 length 内にあることを確認した場合だけ、builder storage view から raw fd write loop へ進みます。
//:
//: ### [注意/ちゅうい]
//: - この関数は builder を消費しません。caller は成功/失敗にかかわらず builder owner を保持します。
//: - `ByteBuilderStorage::Empty` で正の `byte_len` を指定した場合は `InvalidOperation` として拒否します。
pub fn stdio_write_fd_bytebuilder_prefix_result <(i32,&ByteBuilder,i32)*>Result<(), StdErrorKind>> (fd, builder, byte_len):
    let builder_len <i32> *get_ref builder "len";
    if:
        math::lt byte_len 0
        then:
            Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                math::gt byte_len builder_len
                then:
                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
                else:
                    if:
                        math::le byte_len 0
                        then:
                            Result<(), StdErrorKind>::Ok ()
                        else:
                            match byte_builder_ptr_ref builder:
                                Option::Some data:
                                    stdio_write_fd_mem_result fd data byte_len
                                Option::None:
                                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation

//: ## stdio_write_fd_byte_result
//: fd を[指定/してい]して 1 byte を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - 1 byte scratch owner を `RegionToken<u8>` に閉じ、single-byte output が raw `MemPtr` API を公開しないようにします。
pub fn stdio_write_fd_byte_result <(i32,i32)*>Result<(), StdErrorKind>> (fd, b):
    match alloc_region<u8> 1:
        Result::Err _e:
            Result<(), StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok region:
            let out <MemPtr<u8>> region_ptr &region
            match store_u8 out b:
                Result::Ok stored_byte:
                    let result <Result<(), StdErrorKind>> stdio_write_fd_mem_result fd out 1;
                    match dealloc_region<u8> region:
                        Result::Ok released_after_write:
                            result
                        Result::Err release_error_after_write:
                            Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
                Result::Err store_error:
                    match dealloc_region<u8> region:
                        Result::Ok released_after_store_error:
                            Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
                        Result::Err release_error_after_store_error:
                            Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
