//: # std/stdio/write/byte
//: 1 byte stdout output helper
//:
//: ### 目的
//: - `print_byte` の 1 byte scratch buffer を text / ByteBuf adapter から分離します。
//: - 実際の partial write 処理と 1 byte scratch owner は `write/fd` の typed byte wrapper に委譲します。

#indent 4

#import "core/result" as *
#import "./fd" as *

//: print_byte: 1 byte を stdout へ出力する
//:
//: [目的/もくてき]:
//: - binary/VM 系の処理で、`str` を組み立てずに 1 byte だけを stdout へ書き出します。
//:
//: [実装/じっそう]:
//: - `write/fd` の typed byte wrapper に委譲し、1 byte scratch owner と raw fd write loop を fd 境界に閉じます。
//: - この関数自体は raw `MemPtr` を生成せず、stdout 向けの unit API だけを提供します。
//:
//: [注意/ちゅうい]:
//: - `b` の下位 8 bit が出力されます。
//: - UTF-8 文字列としての妥当性は検証しません。text 出力には `print` / `println` を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[normalize_newlines]
//: stdout: "A"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/stdio/write" as *
//: fn main %impure fn unit unit \unit:
//:     print_byte 'A'
//: ```
pub fn print_byte %impure fn i32 unit \b:
    match stdio_write_fd_byte_result 1 b:
        Result::Ok _:
            unit
        Result::Err _e:
            unit
