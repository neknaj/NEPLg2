//: # std/stdio/write/bytes
//: `ByteBuf` を stdout / stderr へ書き出す adapter
//:
//: ### 目的
//: - `ByteBuf` owner の消費と cleanup を text / fd scratch 境界から分離します。
//: - 成功/失敗にかかわらず入力 buffer を解放し、write result を caller へ返します。

#indent 4

#import "alloc/io" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "./fd" as *
#import "core/field" as *
#import "core/math" as *

//: ## stdio_write_bytes_result
//: `ByteBuf` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` が binary write を `str` [変換/へんかん]なしで[実行/じっこう]し、stdout write [失敗/しっぱい]を[保持/ほじ]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
pub fn stdio_write_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data_len <i32> io_bytebuf_len_ref &bytes;
    if:
        le data_len 0
        then:
            io_bytebuf_free bytes
            Result<(), StdErrorKind>::Ok ()
        else:
            let data <MemPtr<u8>> io_bytebuf_data_ptr_ref &bytes
            let result <Result<(), StdErrorKind>> stdio_write_mem_result data data_len;
            io_bytebuf_free bytes
            result

//: ## stdio_write_stderr_bytes_result
//: `ByteBuf` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
pub fn stdio_write_stderr_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data_len <i32> io_bytebuf_len_ref &bytes;
    if:
        le data_len 0
        then:
            io_bytebuf_free bytes
            Result<(), StdErrorKind>::Ok ()
        else:
            let data <MemPtr<u8>> io_bytebuf_data_ptr_ref &bytes
            let result <Result<(), StdErrorKind>> stdio_write_stderr_mem_result data data_len;
            io_bytebuf_free bytes
            result

//: ## stdio_write_bytes
//: `ByteBuf` を stdout へ[書/か]き[出/だ]す互換 facade
pub fn stdio_write_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()

//: ## stdio_write_stderr_bytes
//: `ByteBuf` を stderr へ[書/か]き[出/だ]す互換 facade
pub fn stdio_write_stderr_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_stderr_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()
