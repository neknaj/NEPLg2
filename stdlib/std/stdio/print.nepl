//: # std/stdio/print
//: `std/stdio` の基本 stdout 出力 facade を提供する submodule
//:
//: ### 目的
//: - 文字列出力と整数出力を `std/stdio` root facade から分離します。
//: - 低水準の partial write 処理は `std/stdio/write` に委譲し、この module は利用者向け API だけを持ちます。
//:
//: ### 注意
//: - 既存の `print` / `println` 系 API は互換性のため error を無視します。
//: - error を扱う必要がある場合は `stdio_write_*_result` を使ってください。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "std/stdio/write" as *

//: print: 文字列を標準出力へ出す
//:
//: 目的:
//: - s をそのまま stdout に書き込みます。
//:
//: 実装(アルゴリズム):
//: - `stdio_write_str_result` を[使/つか]い、文字列 object から導出した byte span を stdout へ[書/か]き[出/だ]します。
//:
//: 注意(重要):
//: - エラーは無視します。
//:
//: 計算量:
//: - O(n)
//: print: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     print "sample";
//: ```
pub fn noshadow print %impure fn str unit \s:
    match stdio_write_str_result s:
        Result::Ok _:
            unit
        Result::Err _:
            unit

//: println: 改行付き出力
//:
//: 目的:
//: - s を出力し、改行を追加します。
//:
//: 実装(アルゴリズム):
//: - print を 2 回呼びます。
//:
//: 注意(重要):
//: - 改行は "\n" 固定です。
//:
//: 計算量:
//: - O(n)
//: println: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     println "sample";
//: ```
pub fn noshadow println %impure fn str unit \s:
    print s;
    print "\n";
    unit

//: print_i32_negative_digits: 負数 magnitude を確保なしで 10 進出力する内部 helper
//:
//: [目的/もくてき]:
//: - `print_i32` が `str` を組み立てず、stdout へ digit byte を直接書けるようにします。
//:
//: [実装/じっそう]:
//: - `n` は 0 以下の値として扱います。`i32` 最小値は正数へ反転できないため、負数のまま
//:   `-1000000000` から `-1` までの divisor で上位桁から取り出します。
//: - digit を 1 つでも出力した後は、0 digit も含めて残りの桁を出力します。
//:
//: [注意/ちゅうい]:
//: - `n` が正の場合の結果はこの helper の契約外です。
//: - write error は `print_byte` と同じく互換 API として無視します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。i32 は最大 10 桁なので、loop 回数は固定です。
fn print_i32_negative_digits %impure fn i32 unit \n0:
    let mut n %i32 n0;
    let mut divisor %i32 -1000000000;
    let mut started %bool false;
    while ne divisor 0:
        do:
            let digit %i32 div_s n divisor;
            if:
                or started ne digit 0
                then:
                    print_byte add 48 digit;
                    set started true;
                    set n rem_s n divisor
                else:
                    unit;
            set divisor div_s divisor 10;
    if:
        started
        then:
            unit
        else:
            print_byte 48;

//: print_i32: i32 を確保せず 10 進表記で出力
//:
//: 目的:
//: - v を 10 進表記で stdout へ出力します。
//:
//: 実装(アルゴリズム):
//: - `str` を確保せず、digit byte を `print_byte` で上位桁から直接出力します。
//: - 負数は先に `-` を出力し、値は負数のまま helper へ渡します。これにより `i32` 最小値の
//:   符号反転 overflow に依存しません。
//:
//: 注意(重要):
//: - write error は互換性のため無視します。
//: - allocation を行わないため、整数表示だけで `alloc/string/integer/format` と
//:   `StringBuilder` / `ByteBuilder` を引き込まない境界になります。
//:
//: 計算量:
//: - O(1)。i32 の桁数上限は固定です。
//: print_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     print_i32 42;
//: ```
//:
//: neplg2:test[print_i32_edges]
//: stdout: "0 -42 -2147483648 2147483647"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/math" as *
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     print_i32 0;
//:     print " ";
//:     print_i32 -42;
//:     print " ";
//:     let min_i32 %i32 sub -2147483647 1;
//:     print_i32 min_i32;
//:     print " ";
//:     print_i32 2147483647;
//: ```
pub fn noshadow print_i32 %impure fn i32 unit \v:
    if:
        eq v 0
        then:
            print_byte 48
        else:
            if:
                lt v 0
                then:
                    print_byte 45;
                    print_i32_negative_digits v
                else:
                    print_i32_negative_digits sub 0 v

//: println_i32: i32 を改行付きで出力
//:
//: 目的:
//: - print_i32 の後に改行を出力します。
//:
//: 実装(アルゴリズム):
//: - print_i32 と print("\n") を呼びます。
//:
//: 注意(重要):
//: - 改行は常に追加されます。
//:
//: 計算量:
//: - O(1)。`print_i32` と改行 1 byte の出力だけを行います。
//: println_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     println_i32 42;
//: ```
pub fn noshadow println_i32 %impure fn i32 unit \v:
    print_i32 v;
    print "\n";
