//: # std/stdio/print
//: `std/stdio` の基本 stdout 出力 facade を提供する submodule
//:
//: ### 目的
//: - 文字列出力と整数出力を `std/stdio` root facade から分離します。
//: - 低水準の partial write 処理は `std/stdio/write` に委譲し、この module は利用者向け API だけを持ちます。
//:
//: ### 注意
//: - 既存の `print` / `println` 系 API は互換性のため error を無視します。
//: - error を扱う必要がある場合は `stdio_write_*_result` を使ってください。

#indent 4

#import "alloc/string/integer/format/i32_decimal" as i32_decimal
#import "core/math/i32/arith" as *
#import "core/math/i32/compare" as *
#import "core/result" as *
#import "std/stdio/write/byte" as *
#import "std/stdio/write/text" as *

//: print: 文字列を標準出力へ出す
//:
//: 目的:
//: - s をそのまま stdout に書き込みます。
//:
//: 実装(アルゴリズム):
//: - `stdio_write_str_result` を[使/つか]い、文字列 object から導出した byte span を stdout へ[書/か]き[出/だ]します。
//:
//: 注意(重要):
//: - エラーは無視します。
//:
//: 計算量:
//: - O(n)
//: print: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn void unit \void:
//:     print "sample";
//: ```
pub fn noshadow print %impure fn str unit \s:
    match stdio_write_str_result s:
        Result::Ok _:
            unit
        Result::Err _:
            unit

//: println: 改行付き出力
//:
//: 目的:
//: - s を出力し、改行を追加します。
//:
//: 実装(アルゴリズム):
//: - print を 2 回呼びます。
//:
//: 注意(重要):
//: - 改行は "\n" 固定です。
//:
//: 計算量:
//: - O(n)
//: println: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn void unit \void:
//:     println "sample";
//: ```
pub fn noshadow println %impure fn str unit \s:
    print s;
    print "\n";
    unit

//: print_i32: i32 を 10 進表記で出力
//:
//: 目的:
//: - v を 10 進表記で stdout へ出力します。
//:
//: 実装(アルゴリズム):
//: - 10 進 digit の生成規則は `alloc/string/integer/format/i32_decimal` に委譲します。
//: - この module は必要な byte 数だけを順に読み、stdout への effect だけを担当します。
//:
//: 注意(重要):
//: - write error は互換性のため無視します。
//: - `str` 値が必要な場合は `alloc/string/integer/format::from_i32` を使います。この関数は stdout へ直接出力するため、文字列 object を確保しません。
//:
//: 計算量:
//: - O(1)。i32 の 10 進桁数上限 10 に固定されます。
//: print_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn void unit \void:
//:     print_i32 42;
//: ```
//:
//: neplg2:test[print_i32_edges]
//: stdout: "0 -42 -2147483648 2147483647"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "core/math" as *
//:| #import "std/stdio" as *
//: fn main %impure fn void unit \void:
//:     print_i32 0;
//:     print " ";
//:     print_i32 -42;
//:     print " ";
//:     let min_i32 %i32 sub -2147483647 1;
//:     print_i32 min_i32;
//:     print " ";
//:     print_i32 2147483647;
//: ```
pub fn noshadow print_i32 %impure fn i32 unit \v:
    let output_len %i32 i32_decimal::i32_decimal_len v;
    let mut idx %i32 0;
    while lt idx output_len:
        do:
            print_byte i32_decimal::i32_decimal_byte_at v idx;
            set idx add idx 1

//: println_i32: i32 を改行付きで出力
//:
//: 目的:
//: - print_i32 の後に改行を出力します。
//:
//: 実装(アルゴリズム):
//: - print_i32 と print("\n") を呼びます。
//:
//: 注意(重要):
//: - 改行は常に追加されます。
//:
//: 計算量:
//: - O(1)。`print_i32` と改行 1 byte の出力だけを行います。
//: println_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main %impure fn void unit \void:
//:     println_i32 42;
//: ```
pub fn noshadow println_i32 %impure fn i32 unit \v:
    print_i32 v;
    print "\n";
