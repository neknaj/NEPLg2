//: # std/text/validate
//: UTF-8 byte [列/れつ]の[分類/ぶんるい]と[検証/けんしょう]を[担当/たんとう]する submodule
//:
//: ### [目的/もくてき]
//: - raw `MemPtr u8` と byte [長/なが]さを、`str` や `char` として[扱/あつか]う[前/まえ]に UTF-8 として[検証/けんしょう]します。
//: - leading byte の[種類/しゅるい]を enum にし、sequence [長/なが]さごとの[検証/けんしょう]を `match` で[分岐/ぶんき]します。
//:
//: ### [注意/ちゅうい]
//: - UTF-8 の scalar value [制約/せいやく]も[確認/かくにん]するため、overlong sequence や surrogate range は `InvalidUtf8` になります。
//:
//: ### [計算量/けいさんりょう]
//: - [入力/にゅうりょく] byte [数/すう] n に[対/たい]して O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"std_text_validate_module_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"valid UTF-8 bytes\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/text/validate" as *
//:| #import "alloc/io" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let valid %bool match io_bytebuf_from_str_result "nep":
//:         Result::Err _e:
//:             false
//:         Result::Ok buf:
//:             let data %MemPtr u8 io_bytebuf_data_ptr_ref &buf
//:             let byte_len %i32 io_bytebuf_len_ref &buf
//:             let ok %bool match text_utf8_validate_mem data byte_len:
//:                 Result::Err _e:
//:                     false
//:                 Result::Ok _:
//:                     true
//:             io_bytebuf_free buf
//:             ok
//:     let report:
//:         test_report_new "std_text_validate_module_doc"
//:         |> test_report_push assert "valid UTF-8 bytes" valid
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

#import "core/mem" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *

//: UTF-8 leading byte の[種類/しゅるい]
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"std_text_validate_lead_kind_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"ASCII lead kind\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/text/validate" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let is_ascii %bool match text_utf8_lead_kind 65:
//:         TextUtf8LeadKind::Ascii:
//:             true
//:         _:
//:             false
//:     let report:
//:         test_report_new "std_text_validate_lead_kind_doc"
//:         |> test_report_push assert "ASCII lead kind" is_ascii
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub enum TextUtf8LeadKind:
    Ascii
    Two
    Three
    Four
    Invalid

pub fn text_utf8_in_range %fn i32 fn i32 fn i32 bool \b\lo\hi:
    and ge b lo le b hi

pub fn text_utf8_is_continuation %fn i32 bool \b:
    text_utf8_in_range b 128 191

pub fn text_utf8_lead_kind %fn i32 TextUtf8LeadKind \b:
    if:
        le b 127
        then:
            TextUtf8LeadKind::Ascii
        else:
            if:
                text_utf8_in_range b 194 223
                then:
                    TextUtf8LeadKind::Two
                else:
                    if:
                        text_utf8_in_range b 224 239
                        then:
                            TextUtf8LeadKind::Three
                        else:
                            if:
                                text_utf8_in_range b 240 244
                                then:
                                    TextUtf8LeadKind::Four
                                else:
                                    TextUtf8LeadKind::Invalid

//: text_utf8_byte_at_checked: byte_len で[範囲/はんい]を[縛/しば]った UTF-8 byte reader
//:
//: [目的/もくてき]:
//: - `text_utf8_validate_mem` と `text_utf8_decode_next` が、同じ `MemPtr u8` / byte_len contract で byte を[読/よ]めるようにします。
//: - index が[負/ふ]、または byte_len 以上なら raw pointer [計算/けいさん]へ[進/すす]まず `IndexOutOfBounds` を[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - この helper は root `std/text` からは再公開しません。通常利用者は `text_bytebuf_to_utf8_str_result` を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"std_text_validate_byte_at_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"byte at index 1\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/text/validate" as *
//:| #import "alloc/io" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let matched %bool match io_bytebuf_from_str_result "nep":
//:         Result::Err _e:
//:             false
//:         Result::Ok buf:
//:             let data %MemPtr u8 io_bytebuf_data_ptr_ref &buf
//:             let byte_len %i32 io_bytebuf_len_ref &buf
//:             let ok %bool match text_utf8_byte_at_checked data byte_len 1:
//:                 Result::Err _e:
//:                     false
//:                 Result::Ok b:
//:                     eq b 101
//:             io_bytebuf_free buf
//:             ok
//:     let report:
//:         test_report_new "std_text_validate_byte_at_doc"
//:         |> test_report_push assert "byte at index 1" matched
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn text_utf8_byte_at_checked %fn MemPtr u8 fn i32 fn i32 Result i32 StdErrorKind \data\byte_len\idx:
    if:
        or lt idx 0 le byte_len idx
        then:
            Result::Err StdErrorKind::IndexOutOfBounds
        else:
            let ptr %MemPtr u8 mem_ptr_add data idx
            match load_u8 ptr:
                Option::Some b:
                    Result::Ok b
                Option::None:
                    Result::Err StdErrorKind::InvalidOperation

fn text_utf8_validate_two %fn MemPtr u8 fn i32 fn i32 Result unit StdErrorKind \data\i\byte_len:
    if:
        gt add i 2 byte_len
        then:
            Result::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at_checked data byte_len add i 1:
                Result::Err e:
                    Result::Err e
                Result::Ok b1:
                    if:
                        text_utf8_is_continuation b1
                        then:
                            Result::Ok unit
                        else:
                            Result::Err StdErrorKind::InvalidUtf8

fn text_utf8_validate_three %fn MemPtr u8 fn i32 fn i32 fn i32 Result unit StdErrorKind \data\i\byte_len\b0:
    if:
        gt add i 3 byte_len
        then:
            Result::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at_checked data byte_len add i 1:
                Result::Err e:
                    Result::Err e
                Result::Ok b1:
                    match text_utf8_byte_at_checked data byte_len add i 2:
                        Result::Err e:
                            Result::Err e
                        Result::Ok b2:
                            let first_ok %bool:
                                if:
                                    eq b0 224
                                    then:
                                        text_utf8_in_range b1 160 191
                                    else:
                                        if:
                                            eq b0 237
                                            then:
                                                text_utf8_in_range b1 128 159
                                            else:
                                                text_utf8_is_continuation b1
                            if:
                                and first_ok text_utf8_is_continuation b2
                                then:
                                    Result::Ok unit
                                else:
                                    Result::Err StdErrorKind::InvalidUtf8

fn text_utf8_validate_four %fn MemPtr u8 fn i32 fn i32 fn i32 Result unit StdErrorKind \data\i\byte_len\b0:
    if:
        gt add i 4 byte_len
        then:
            Result::Err StdErrorKind::InvalidUtf8
        else:
            match text_utf8_byte_at_checked data byte_len add i 1:
                Result::Err e:
                    Result::Err e
                Result::Ok b1:
                    match text_utf8_byte_at_checked data byte_len add i 2:
                        Result::Err e:
                            Result::Err e
                        Result::Ok b2:
                            match text_utf8_byte_at_checked data byte_len add i 3:
                                Result::Err e:
                                    Result::Err e
                                Result::Ok b3:
                                    let first_ok %bool:
                                        if:
                                            eq b0 240
                                            then:
                                                text_utf8_in_range b1 144 191
                                            else:
                                                if:
                                                    eq b0 244
                                                    then:
                                                        text_utf8_in_range b1 128 143
                                                    else:
                                                        text_utf8_is_continuation b1
                                    if:
                                        and first_ok and text_utf8_is_continuation b2 text_utf8_is_continuation b3
                                        then:
                                            Result::Ok unit
                                        else:
                                            Result::Err StdErrorKind::InvalidUtf8

//: text_utf8_validate_mem: raw byte [列/れつ]が UTF-8 として[妥当/だとう]か[検証/けんしょう]する
//:
//: [目的/もくてき]:
//: - `MemPtr u8` と byte [長/なが]さで[表/あらわ]された[領域/りょういき]を、`str` へ[変換/へんかん]する[前/まえ]に[検査/けんさ]します。
//:
//: [実装/じっそう]:
//: - leading byte を `TextUtf8LeadKind` に[分類/ぶんるい]し、sequence [長/なが]さごとに continuation byte と overlong/surrogate [制約/せいやく]を[確認/かくにん]します。
//:
//: [注意/ちゅうい]:
//: - byte_len が[負/ふ]の[場合/ばあい]や pointer [読/よ]み[出/だ]しに[失敗/しっぱい]した[場合/ばあい]は `InvalidOperation` を[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"std_text_validate_mem_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"valid memory span\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/text/validate" as *
//:| #import "alloc/io" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let valid %bool match io_bytebuf_from_str_result "nep":
//:         Result::Err _e:
//:             false
//:         Result::Ok buf:
//:             let data %MemPtr u8 io_bytebuf_data_ptr_ref &buf
//:             let byte_len %i32 io_bytebuf_len_ref &buf
//:             let ok %bool match text_utf8_validate_mem data byte_len:
//:                 Result::Err _e:
//:                     false
//:                 Result::Ok _:
//:                     true
//:             io_bytebuf_free buf
//:             ok
//:     let report:
//:         test_report_new "std_text_validate_mem_doc"
//:         |> test_report_push assert "valid memory span" valid
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn text_utf8_validate_mem %fn MemPtr u8 fn i32 Result unit StdErrorKind \data\byte_len:
    if:
        lt byte_len 0
        then:
            Result::Err StdErrorKind::InvalidOperation
        else:
            let mut i %i32 0
            let mut done %i32 0
            let mut res %Result unit StdErrorKind Result::Ok unit
            while eq done 0:
                do:
                    if:
                        ge i byte_len
                        then:
                            set done 1
                        else:
                            match text_utf8_byte_at_checked data byte_len i:
                                Result::Err e:
                                    set res Result::Err e
                                    set done 1
                                Result::Ok b0:
                                    match text_utf8_lead_kind b0:
                                        TextUtf8LeadKind::Ascii:
                                            set i add i 1
                                        TextUtf8LeadKind::Two:
                                            match text_utf8_validate_two data i byte_len:
                                                Result::Ok _:
                                                    set i add i 2
                                                Result::Err e:
                                                    set res Result::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Three:
                                            match text_utf8_validate_three data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 3
                                                Result::Err e:
                                                    set res Result::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Four:
                                            match text_utf8_validate_four data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 4
                                                Result::Err e:
                                                    set res Result::Err e
                                                    set done 1
                                        TextUtf8LeadKind::Invalid:
                                            set res Result::Err StdErrorKind::InvalidUtf8
                                            set done 1
            res
