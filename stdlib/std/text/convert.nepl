//: # std/text/convert
//: checked `ByteBuf -> str` [変換/へんかん]を[担当/たんとう]する submodule
//:
//: ### [目的/もくてき]
//: - file / stdin / binary stream から[得/え]た byte [列/れつ]を、source text [向/む]けに checked `str` へ[変換/へんかん]します。
//: - UTF-8 validation は `text/validate`、str layout への[詰/つ]め[直/なお]しは `alloc/io` の checked conversion に[委譲/いじょう]します。
//:
//: ### [注意/ちゅうい]
//: - 入力 `ByteBuf` は成功時も失敗時も[消費/しょうひ]されます。
//: - invalid UTF-8 の[場合/ばあい]は buffer を[解放/かいほう]して `StdErrorKind::InvalidUtf8` を[返/かえ]します。

#indent 4

#import "alloc/io" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "./validate" as *
#import "core/field" as *
#import "core/math" as *

//: text_bytebuf_to_utf8_str_result: `ByteBuf` を UTF-8 [検証/けんしょう]して `str` へ[変換/へんかん]する
//:
//: [実装/じっそう]:
//: - 先に `text_utf8_validate_mem` で[全体/ぜんたい]を[検査/けんさ]し、成功したときだけ `io_bytebuf_to_str_result` で text layout へ[詰/つ]め[直/なお]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn text_bytebuf_to_utf8_str_result <(ByteBuf)*>Result<str, StdErrorKind>> (buf):
    let byte_len <i32> io_bytebuf_len_ref &buf
    if:
        le byte_len 0
        then:
            io_bytebuf_free buf
            Result<str, StdErrorKind>::Ok ""
        else:
            let data <MemPtr<u8>> io_bytebuf_data_ptr_ref &buf
            match text_utf8_validate_mem data byte_len:
                Result::Ok _:
                    io_bytebuf_to_str_result buf
                Result::Err e:
                    io_bytebuf_free buf
                    Result<str, StdErrorKind>::Err e
