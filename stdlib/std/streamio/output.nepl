//: # streamio/output
//: stdout / stderr output stream adapter public facade
//:
//: ### [目的/もくてき]
//: - `alloc/io` の writer/flush/close trait 群に stdout と stderr を接続します。
//: - output handle 型、stdout 実装、stderr 実装を分け、write error 変換と overload の責務を見通しやすくします。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "std/streamio/output" as *
//: fn main %impure fn void i32 \void:
//:     let r %Result StdoutStream StdErrorKind flush StdoutStream unit;
//:     match r:
//:         Result::Ok _s:
//:             0
//:         Result::Err _e:
//:             1
//: ```

#indent 4

pub #import "std/streamio/output/types" as *
pub #import "std/streamio/output/stdout" as *
pub #import "std/streamio/output/stderr" as *
