//: # streamio/scanner
//: `std/streamio` の token scanner と read target API を提供する submodule
//:
//: ### [目的/もくてき]
//: - `StreamScanner` の cursor/header state、token parser、`open ReadStream`、scanner read overload を `std/streamio` facade から分離します。
//: - scanner の raw memory backed header boundary を writer とは別 module に閉じ込め、source policy で再肥大化を検出できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `StreamScanner` は header と buffer を共有する軽量 handle です。`close` は最後に 1 回だけ呼び出してください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//: fn main <()*>i32> ():
//:     let sc <StreamScanner> unwrap_ok open ReadStream::Text "4 5";
//:     let a <i32> read sc;
//:     let b <i32> read sc;
//:     close sc;
//:     add a b
//: ```

#indent 4

#import "alloc/io" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/fs" as *
#import "std/iotarget" as *
#import "std/stdio" as *
//: ## StreamScanner
//: read target を token [単位/たんい]に[走査/そうさ]する scanner
//:
//: ### [目的/もくてき]
//: - `kpread` にあった token parser の[中核/ちゅうかく]を `std` 側へ[昇格/しょうかく]し、stdin / in-memory text / binary / file を[同/おな]じ scanner [面/めん]へ[載/の]せます。
//:
//: ### [注意/ちゅうい]
//: - scanner handle [自体/じたい]は[軽量/けいりょう]なので `Copy` / `Clone` を[実装/じっそう]します。
//: - copy / clone は[同/おな]じ cursor と buffer を[共有/きょうゆう]する alias です。`read` を[進/すす]めると、ほかの alias から[見/み]える[位置/いち]も[進/すす]みます。
//: - buffer の[解放/かいほう]は `close` が[担当/たんとう]するので、alias を[作/つく]った[場合/ばあい]でも `close` は[最後/さいご]に 1 [回/かい]だけ[呼/よ]んでください。
//: - [別々/べつべつ]に `open` した scanner [同士/どうし]は[状態/じょうたい]を[共有/きょうゆう]しないので、[複数/ふくすう]の stream を[同時/どうじ]に[維持/いじ]できます。
struct StreamScanner:
    header <MemPtr<u8>>

impl Copy for StreamScanner:
    fn copy_mark <(StreamScanner)->StreamScanner> (sc):
        sc

impl Clone for StreamScanner:
    fn clone <(&StreamScanner)->StreamScanner> (sc):
        *sc

enum StreamScannerHeaderField:
    BufPtr
    Len
    Pos

fn stream_scanner_wrap <(MemPtr<u8>)->StreamScanner> (raw):
    StreamScanner raw

//: stream_scanner_is_leading_skip_byte: scanner 先頭で読み飛ばす byte か判定する
//:
//: [目的/もくてき]:
//: - BOM 後の NUL と ASCII 空白を、decimal code ではなく文字として明示します。
fn stream_scanner_is_leading_skip_byte <(i32)->bool> (byte):
    match byte:
        '\0':
            true
        ' ':
            true
        '\n':
            true
        '\r':
            true
        '\t':
            true
        _:
            false

//: stream_scanner_is_token_separator: token を区切る ASCII 空白か判定する
fn stream_scanner_is_token_separator <(i32)->bool> (byte):
    match byte:
        ' ':
            true
        '\n':
            true
        '\r':
            true
        '\t':
            true
        _:
            false

//: stream_scanner_is_ascii_digit: ASCII digit か判定する
fn stream_scanner_is_ascii_digit <(i32)->bool> (byte):
    and ge byte '0' le byte '9'

//: stream_scanner_digit_value: ASCII digit byte を 0..9 の値へ変換する
fn stream_scanner_digit_value <(i32)->i32> (byte):
    sub byte '0'

//: stream_scanner_is_exponent_marker: 浮動小数点 token の指数 marker か判定する
fn stream_scanner_is_exponent_marker <(i32)->bool> (byte):
    match byte:
        'e':
            true
        'E':
            true
        _:
            false

fn stream_scanner_header_off <(StreamScannerHeaderField)->i32> (field):
    match field:
        StreamScannerHeaderField::BufPtr:
            0
        StreamScannerHeaderField::Len:
            4
        StreamScannerHeaderField::Pos:
            8

//: ## stream_scanner_load_header_result
//: scanner header の 32 bit field を scanner state boundary として読む
//:
//: ### [目的/もくてき]
//: - `StreamScanner` の共有 cursor state を保持する header から field を読み、invalid header を `Result` として呼び出し側へ返します。
//: - scanner の公開 facade が失敗を sentinel へ丸める前に、内部初期化では失敗を検出できるようにします。
fn stream_scanner_load_header_result <(MemPtr<u8>,StreamScannerHeaderField)->Result<i32,str>> (header, field):
    let raw <i32> mem_ptr_addr header
    if:
        le raw 0
        then:
            Result<i32,str>::Err "streamio.stream_scanner_load_header failed"
        else:
            Result<i32,str>::Ok load_i32 add raw stream_scanner_header_off field

//: ## stream_scanner_load_header
//: scanner header を読む互換 facade
//:
//: ### [注意/ちゅうい]
//: - 既存の scanner API は `Result` を返さないため、header が壊れている場合は 0 に丸めます。
//: - 初期化など失敗を区別すべき箇所では `stream_scanner_load_header_result` を使います。
fn stream_scanner_load_header <(MemPtr<u8>,StreamScannerHeaderField)->i32> (header, field):
    match stream_scanner_load_header_result header field:
        Result::Ok v:
            v
        Result::Err _e:
            0

//: ## stream_scanner_store_header_result
//: scanner header の 32 bit field を scanner state boundary として書く
//:
//: ### [目的/もくてき]
//: - `StreamScanner` の共有 cursor state を保持する header へ field を書き、invalid header を `Result` として呼び出し側へ返します。
//: - scanner 初期化時に header 設定失敗を握りつぶさず、buffer と header を解放して失敗できます。
fn stream_scanner_store_header_result <(MemPtr<u8>,StreamScannerHeaderField,i32)->Result<(),str>> (header, field, v):
    let raw <i32> mem_ptr_addr header
    if:
        le raw 0
        then:
            Result<(),str>::Err "streamio.stream_scanner_store_header failed"
        else:
            store_i32 add raw stream_scanner_header_off field v
            Result<(),str>::Ok ()

//: ## stream_scanner_store_header
//: scanner header を書く互換 facade
//:
//: ### [注意/ちゅうい]
//: - 既存の scanner API は `Result` を返さないため、失敗時は状態を進めず no-op にします。
//: - 初期化など失敗を区別すべき箇所では `stream_scanner_store_header_result` を使います。
fn stream_scanner_store_header <(MemPtr<u8>,StreamScannerHeaderField,i32)->()> (header, field, v):
    match stream_scanner_store_header_result header field v:
        Result::Ok _:
            ()
        Result::Err _e:
            ()

//: ## stream_scanner_byte_at
//: scanner buffer の byte を安全な範囲内で読む
//:
//: ### [目的/もくてき]
//: - scanner header に保存された buffer pointer を `MemPtr<u8>` として扱い、tokenizer が直接 raw address を読まないようにします。
//: - 呼び出し側の境界確認漏れや低レベル load 失敗は byte `0` として扱い、scanner の sentinel と同じ意味に丸めます。
fn stream_scanner_byte_at <(MemPtr<u8>,i32,i32)->i32> (buf, len, pos):
    if:
        or lt pos 0 ge pos len
        then:
            0
        else:
            match load_u8 mem_ptr_add buf pos:
                Option::Some byte:
                    byte
                Option::None:
                    0

fn scanner_from_bytes <(ByteBuf)*>Result<StreamScanner,str>> (bytes):
    let len <i32> get bytes "len";
    match get bytes "ptr":
        Option::None:
            if:
                eq len 0
                then:
                    match alloc_ptr<u8> 12:
                        Result::Err _e:
                            io_bytebuf_free bytes
                            Result<StreamScanner,str>::Err "streamio.scanner header alloc failed"
                        Result::Ok header:
                            match stream_scanner_store_header_result header StreamScannerHeaderField::BufPtr 0:
                                Result::Err _e:
                                    io_bytebuf_free bytes
                                    match dealloc_ptr<u8> header 12:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e2:
                                            ();
                                    Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                                Result::Ok _:
                                    match stream_scanner_store_header_result header StreamScannerHeaderField::Len 0:
                                        Result::Err _e:
                                            io_bytebuf_free bytes
                                            match dealloc_ptr<u8> header 12:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _e2:
                                                    ();
                                            Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                                        Result::Ok _:
                                            match stream_scanner_store_header_result header StreamScannerHeaderField::Pos 0:
                                                Result::Err _e:
                                                    io_bytebuf_free bytes
                                                    match dealloc_ptr<u8> header 12:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _e2:
                                                            ();
                                                    Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                                                Result::Ok _:
                                                    Result<StreamScanner,str>::Ok stream_scanner_wrap header
                else:
                    io_bytebuf_free bytes
                    Result<StreamScanner,str>::Err "streamio.scanner invalid byte buffer"
        Option::Some buf:
            match alloc_ptr<u8> 12:
                Result::Err _e:
                    io_bytebuf_free bytes
                    Result<StreamScanner,str>::Err "streamio.scanner header alloc failed"
                Result::Ok header:
                    match stream_scanner_store_header_result header StreamScannerHeaderField::BufPtr mem_ptr_addr buf:
                        Result::Err _e:
                            io_bytebuf_free bytes
                            match dealloc_ptr<u8> header 12:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                        Result::Ok _:
                            match stream_scanner_store_header_result header StreamScannerHeaderField::Len len:
                                Result::Err _e:
                                    io_bytebuf_free bytes
                                    match dealloc_ptr<u8> header 12:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e2:
                                            ();
                                    Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                                Result::Ok _:
                                    match stream_scanner_store_header_result header StreamScannerHeaderField::Pos 0:
                                        Result::Err _e:
                                            io_bytebuf_free bytes
                                            match dealloc_ptr<u8> header 12:
                                                Result::Ok _:
                                                    ()
                                                Result::Err _e2:
                                                    ();
                                            Result<StreamScanner,str>::Err "streamio.scanner header init failed"
                                        Result::Ok _:
                                            Result<StreamScanner,str>::Ok stream_scanner_wrap header

//: ## open
//: read target から scanner を[開/ひら]く
//:
//: ### [目的/もくてき]
//: - stdin / in-memory text / binary buffer / file path を、1 [個/こ]の `open` [入口/いりぐち]で token scanner へ[載/の]せます。
//: - `ReadStream` だけを[受/う]け[付/つ]けることで、`open WriteStream::Stdio` のような[誤用/ごよう]を compile error にします。
//:
//: ### [実装/じっそう]
//: - target ごとに byte [列/れつ]へ[正規化/せいきか]してから header を[確保/かくほ]し、`buf ptr` / `len` / `pos` を[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - file read [失敗/しっぱい]や[確保/かくほ][失敗/しっぱい]は `Result::Err` に[丸/まる]めます。
fn open <(ReadStream)*>Result<StreamScanner,str>> (target):
    match target:
        ReadStream::Stdio:
            scanner_from_bytes stdio_read_all_bytes
        ReadStream::Text text:
            match io_bytebuf_from_str_result text:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result<StreamScanner,str>::Err "streamio.scanner text alloc failed"
        ReadStream::Bytes bytes:
            scanner_from_bytes bytes
        ReadStream::Fs path:
            match fs_read_to_bytes path:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result<StreamScanner,str>::Err "streamio.scanner read failed"

fn stream_scanner_skip_ws_header <(MemPtr<u8>)*>()> (header):
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;

    if:
        eq p 0
        then:
            if:
                ge len 2
                then:
                    let b0 <i32> stream_scanner_byte_at buf len 0;
                    let b1 <i32> stream_scanner_byte_at buf len 1;
                    if:
                        ge len 3
                        then:
                            let b2 <i32> stream_scanner_byte_at buf len 2;
                            if:
                                and and eq b0 239 eq b1 187 eq b2 191
                                then:
                                    set p 3;
                                else:
                                    if:
                                        or and eq b0 255 eq b1 254 and eq b0 254 eq b1 255
                                        then:
                                            set p 2;
                                        else:
                                            ()
                        else:
                            if:
                                or and eq b0 255 eq b1 254 and eq b0 254 eq b1 255
                                then:
                                    set p 2;
                                else:
                                    ()
                else:
                    ()
        else:
            ();

    let mut done <i32> 0;
    while eq done 0:
        if:
            lt p len
            then:
                let byte <i32> stream_scanner_byte_at buf len p;
                if:
                    stream_scanner_is_leading_skip_byte byte
                    then:
                        set p add p 1;
                    else:
                        set done 1;
            else:
                set done 1;

    stream_scanner_store_header header StreamScannerHeaderField::Pos p;
    ()

//: ## skip_ws
//: ASCII [空白/くうはく]と[先頭/せんとう] BOM を[飛/と]ばす
fn skip_ws <(StreamScanner)*>()> (sc):
    stream_scanner_skip_ws_header get sc "header"

//: ## is_eof
//: token が[残/のこ]っていないか[確認/かくにん]する
fn is_eof <(StreamScanner)*>bool> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    ge stream_scanner_load_header header StreamScannerHeaderField::Pos stream_scanner_load_header header StreamScannerHeaderField::Len

//: ## skip
//: [現在/げんざい] token を 1 [個/こ][消費/しょうひ]する
fn skip <(StreamScanner)*>()> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    let mut done <i32> 0;
    while eq done 0:
        if:
            lt p len
            then:
                let byte <i32> stream_scanner_byte_at buf len p;
                if:
                    stream_scanner_is_token_separator byte
                    then:
                        set done 1;
                    else:
                        set p add p 1;
            else:
                set done 1;
    stream_scanner_store_header header StreamScannerHeaderField::Pos p;
    ()

//: ## scan_token_impl
//: [次/つぎ]の token を `str` として[読/よ]む
fn scan_token_impl <(StreamScanner)*>str> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let start <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    let mut p <i32> start;
    let mut done <i32> 0;
    while eq done 0:
        if:
            lt p len
            then:
                let byte <i32> stream_scanner_byte_at buf len p;
                if:
                    stream_scanner_is_token_separator byte
                    then:
                        set done 1;
                    else:
                        set p add p 1;
            else:
                set done 1;
    let tlen <i32> sub p start;
    if:
        eq tlen 0
        then:
            ""
        else:
            match string_from_mem_unchecked_result mem_ptr_add buf start tlen:
                Result::Err _e:
                    stream_scanner_store_header header StreamScannerHeaderField::Pos p;
                    ""
                Result::Ok token:
                    stream_scanner_store_header header StreamScannerHeaderField::Pos p;
                    token

//: ## scan_i32_impl
//: [次/つぎ]の token を `i32` として[読/よ]む
fn scan_i32_impl <(StreamScanner)*>i32> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p len
        then:
            0
        else:
            let mut sign <i32> 1;
            let b0 <i32> stream_scanner_byte_at buf len p;
            if:
                eq b0 '-'
                then:
                    set sign -1;
                    set p add p 1;
                else:
                    ();
            let mut val <i32> 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at buf len p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        set val add mul val 10 stream_scanner_digit_value byte;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            mul val sign

//: ## scan_u32_impl
//: [次/つぎ]の token を `u32` として[読/よ]む
fn scan_u32_impl <(StreamScanner)*>u32> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p len
        then:
            <u32> cast 0
        else:
            if:
                eq stream_scanner_byte_at buf len p '+'
                then:
                    set p add p 1;
                else:
                    ();
            let mut val <i32> 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at buf len p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit <i32> stream_scanner_digit_value byte;
                                        let scaled <i32> mul val 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            <u32> cast val

//: ## scan_u64_impl
//: [次/つぎ]の token を `u64` として[読/よ]む
fn scan_u64_impl <(StreamScanner)*>u64> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p len
        then:
            let zero64 <i64> cast 0;
            <u64> cast zero64
        else:
            if:
                eq stream_scanner_byte_at buf len p '+'
                then:
                    set p add p 1;
                else:
                    ();
            let mut val <i64> cast 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at buf len p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit32 <i32> stream_scanner_digit_value byte;
                                        let digit <i64> cast digit32;
                                        let scaled <i64> mul val <i64> cast 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            <u64> cast val

//: ## scan_i64_impl
//: [次/つぎ]の token を `i64` として[読/よ]む
fn scan_i64_impl <(StreamScanner)*>i64> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p len
        then:
            <i64> cast 0
        else:
            let mut is_neg <i32> 0;
            let b0 <i32> stream_scanner_byte_at buf len p;
            if:
                eq b0 '-'
                then:
                    set is_neg 1;
                    set p add p 1;
                else:
                    if:
                        eq b0 '+'
                        then:
                            set p add p 1;
                        else:
                            ();
            let mut val <i64> cast 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at buf len p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit32 <i32> stream_scanner_digit_value byte;
                                        let digit <i64> cast digit32;
                                        let scaled <i64> mul val <i64> cast 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            if:
                eq is_neg 1
                then:
                    sub <i64> cast 0 val
                else:
                    val

//: ## scan_f64_impl
//: [次/つぎ]の token を `f64` として[読/よ]む
fn scan_f64_impl <(StreamScanner)*>f64> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let buf_len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p buf_len
        then:
            <f64> cast 0
        else:
            let mut is_neg <i32> 0;
            let b0 <i32> stream_scanner_byte_at buf buf_len p;
            if:
                eq b0 '-'
                then:
                    set is_neg 1;
                    set p add p 1;
                else:
                    if:
                        eq b0 '+'
                        then:
                            set p add p 1;
                        else:
                            ();
            let mut val <f64> cast 0;
            let mut any_digit <i32> 0;
            let ten <f64> cast 10;
            let mut done_int <i32> 0;
            while eq done_int 0:
                if:
                    lt p buf_len
                    then:
                        let byte <i32> stream_scanner_byte_at buf buf_len p;
                        if:
                            stream_scanner_is_ascii_digit byte
                            then:
                                let d <f64> cast stream_scanner_digit_value byte;
                                set val add mul val ten d;
                                set p add p 1;
                                set any_digit 1;
                            else:
                                set done_int 1;
                    else:
                        set done_int 1;
            let mut has_dot <i32> 0;
            if:
                lt p buf_len
                then:
                    if:
                        eq stream_scanner_byte_at buf buf_len p '.'
                        then set has_dot 1
                        else ()
                else:
                    ();
            if:
                eq has_dot 1
                then:
                    set p add p 1;
                    let one <f64> cast 1;
                    let mut place <f64> div one ten;
                    let mut done_frac <i32> 0;
                    while eq done_frac 0:
                        if:
                            lt p buf_len
                            then:
                                let byte <i32> stream_scanner_byte_at buf buf_len p;
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let d <f64> cast stream_scanner_digit_value byte;
                                        set val add val mul d place;
                                        set place div place ten;
                                        set p add p 1;
                                        set any_digit 1;
                                    else:
                                        set done_frac 1;
                            else:
                                set done_frac 1;
                else:
                    ();
            let mut has_exp <i32> 0;
            if:
                lt p buf_len
                then:
                    let ec <i32> stream_scanner_byte_at buf buf_len p;
                    if:
                        stream_scanner_is_exponent_marker ec
                        then set has_exp 1
                        else ()
                else:
                    ();
            if:
                eq has_exp 1
                then:
                    set p add p 1;
                    let mut exp_neg <i32> 0;
                    if:
                        lt p buf_len
                        then:
                            let eb <i32> stream_scanner_byte_at buf buf_len p;
                            if:
                                eq eb '-'
                                then:
                                    set exp_neg 1;
                                    set p add p 1;
                                else:
                                    if:
                                        eq eb '+'
                                        then:
                                            set p add p 1;
                                        else:
                                            ();
                        else:
                            ();
                    let mut exp_val <i32> 0;
                    let mut done_exp <i32> 0;
                    while eq done_exp 0:
                        if:
                            lt p buf_len
                            then:
                                let byte <i32> stream_scanner_byte_at buf buf_len p;
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        set exp_val add mul exp_val 10 stream_scanner_digit_value byte;
                                        set p add p 1;
                                    else:
                                        set done_exp 1;
                            else:
                                set done_exp 1;
                    let mut k <i32> 0;
                    while lt k exp_val:
                        do:
                            if:
                                eq exp_neg 1
                                then:
                                    set val div val ten;
                                else:
                                    set val mul val ten;
                            set k add k 1;
                else:
                    ();
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            if:
                eq any_digit 0
                then:
                    <f64> cast 0
                else:
                    if:
                        eq is_neg 1
                        then:
                            neg val
                        else:
                            val

//: ## scan_f32_impl
//: [次/つぎ]の token を `f32` として[読/よ]む
fn scan_f32_impl <(StreamScanner)*>f32> (sc):
    <f32> cast scan_f64_impl sc

//: ## read
//: `StreamScanner` から token / [数値/すうち]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - suffix [付/つ]き API を[残/のこ]さず、`read sc` の 1 [個/こ]の[名前/なまえ]へ[統一/とういつ]します。
//: - 対応型ごとの overload として定義し、未対応型は runtime trap ではなく overload 解決失敗にします。
//:
//: ### [注意/ちゅうい]
//: - [受/う]け[側/がわ]の[型注釈/かたちゅうしゃく]または式の期待型で[読/よ]む[型/かた]を[決/き]めます。
fn read <(StreamScanner)*>str> (sc):
    scan_token_impl sc

fn read <(StreamScanner)*>i32> (sc):
    scan_i32_impl sc

fn read <(StreamScanner)*>i64> (sc):
    scan_i64_impl sc

fn read <(StreamScanner)*>u32> (sc):
    scan_u32_impl sc

fn read <(StreamScanner)*>u64> (sc):
    scan_u64_impl sc

fn read <(StreamScanner)*>f64> (sc):
    scan_f64_impl sc

fn read <(StreamScanner)*>f32> (sc):
    scan_f32_impl sc

//: ## close
//: `StreamScanner` を[閉/と]じて[内部/ないぶ] buffer を[解放/かいほう]する
fn close <(StreamScanner)*>()> (sc):
    let header <MemPtr<u8>> get sc "header";
    let buf_addr <i32> stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let bytes <ByteBuf>:
        if:
            eq len 0
            then:
                io_bytebuf_empty
            else:
                io_bytebuf_from_owned_ptr mem_ptr_wrap buf_addr len
    io_bytebuf_free bytes;
    match dealloc_ptr<u8> header 12:
        Result::Ok _:
            ()
        Result::Err _e:
            ()
