//: # streamio/scanner
//: `std/streamio` の token scanner と read target API を提供する submodule
//:
//: ### [目的/もくてき]
//: - `StreamScanner` の ByteBuf/cursor state、token parser、`open ReadStream`、scanner read overload を `std/streamio` facade から分離します。
//: - scanner の typed cursor storage boundary を writer とは別 module に閉じ込め、source policy で再肥大化を検出できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `StreamScanner` は input `ByteBuf` と typed cursor storage を所有する handle です。`read` は borrow で呼び、`close` は owner を消費します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//: fn main %impure fn void i32 \void:
//:     let sc %StreamScanner unwrap_ok open ReadStream::Text "4 5";
//:     let a %i32 read &sc;
//:     let b %i32 read &sc;
//:     close sc;
//:     add a b
//: ```

#indent 4

#import "alloc/collections/vec" as vec
#import "alloc/io" as *
#import "alloc/string" as *
#import "core/result" as *
#import "std/fs" as *
#import "std/iotarget" as *
#import "std/stdio" as *
#import "std/streamio/scanner/cursor" as *
#import "std/streamio/scanner/error" as *
#import "std/streamio/scanner/number" as *
#import "std/streamio/scanner/state" as *
#import "core/field" as *
#import "core/math" as *

//: ## open
//: read target から scanner を[開/ひら]く
//:
//: ### [目的/もくてき]
//: - stdin / in-memory text / binary buffer / file path を、1 [個/こ]の `open` [入口/いりぐち]で token scanner へ[載/の]せます。
//: - `ReadStream` だけを[受/う]け[付/つ]けることで、`open WriteStream::Stdio` のような[誤用/ごよう]を compile error にします。
//:
//: ### [実装/じっそう]
//: - target ごとに byte [列/れつ]へ[正規化/せいきか]してから typed cursor storage を[確保/かくほ]し、input owner は `ByteBuf` field として[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - file read [失敗/しっぱい]や[確保/かくほ][失敗/しっぱい]は `StreamScannerError` に[分類/ぶんるい]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "1 2";
//:| close sc;
//: ```
pub fn open %impure fn ReadStream Result StreamScanner StreamScannerError \target:
    match target:
        ReadStream::Stdio:
            match stdio_read_all_bytes_result:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result::Err StreamScannerError::InputReadFailed
        ReadStream::Text text:
            match io_bytebuf_from_str_result text:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result::Err StreamScannerError::TextAllocFailed
        ReadStream::Bytes bytes:
            scanner_from_bytes bytes
        ReadStream::Fs path:
            match fs_read_to_bytes path:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result::Err StreamScannerError::InputReadFailed

//: ## skip_ws_result
//: ASCII [空白/くうはく]と[先頭/せんとう] BOM を[飛/と]ばす
//:
//: ### [契約/けいやく]
//: - cursor storage が[壊/こわ]れている[場合/ばあい]は `Result::Err` を[返/かえ]します。
//: - 成功時だけ cursor を[更新/こうしん]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "   x";
//:| unwrap_ok skip_ws_result &sc;
//:| close sc;
//: ```
pub fn skip_ws_result %impure fn &StreamScanner Result unit StreamScannerError \sc:
    stream_scanner_skip_ws_result sc

//: ## skip_ws
//: `skip_ws_result` の互換 facade
//:
//: ### [注意/ちゅうい]
//: - 旧 API との互換用です。失敗を観測する場合は `skip_ws_result` を使ってください。
pub fn skip_ws %impure fn &StreamScanner unit \sc:
    match skip_ws_result sc:
        Result::Ok _:
            unit
        Result::Err _e:
            unit

//: ## is_eof
//: token が[残/のこ]っていないか[確認/かくにん]する
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "";
//:| let eof %bool unwrap_ok is_eof_result &sc;
//:| close sc;
//: ```
pub fn is_eof_result %impure fn &StreamScanner Result bool StreamScannerError \sc:
    match skip_ws_result sc:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            match stream_scanner_load_pos_result sc:
                Result::Err e:
                    Result::Err e
                Result::Ok pos:
                    Result::Ok ge pos stream_scanner_len sc

//: ## is_eof
//: `is_eof_result` の互換 facade
pub fn is_eof %impure fn &StreamScanner bool \sc:
    match is_eof_result sc:
        Result::Ok eof:
            eof
        Result::Err _e:
            true

//: ## skip
//: [現在/げんざい] token を 1 [個/こ][消費/しょうひ]する
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "skip keep";
//:| unwrap_ok skip_result &sc;
//:| close sc;
//: ```
pub fn skip_result %impure fn &StreamScanner Result unit StreamScannerError \sc:
    match skip_ws_result sc:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            let bytes %&ByteBuf get_ref sc "bytes";
            let len %i32 stream_scanner_len sc;
            match stream_scanner_load_pos_result sc:
                Result::Err e:
                    Result::Err e
                Result::Ok start:
                    let mut p %i32 start;
                    let mut done %i32 0;
                    let mut failed %i32 0;
                    let mut err %StreamScannerError StreamScannerError::InvalidByteBuffer;
                    while eq done 0:
                        if:
                            lt p len
                            then:
                                match stream_scanner_byte_at_result bytes p:
                                    Result::Err e:
                                        set err e;
                                        set failed 1;
                                        set done 1;
                                    Result::Ok byte:
                                        if:
                                            stream_scanner_is_token_separator byte
                                            then:
                                                set done 1;
                                            else:
                                                set p add p 1;
                            else:
                                set done 1;
                    if:
                        eq failed 1
                        then:
                            Result::Err err
                        else:
                            stream_scanner_store_pos_result sc p

//: ## skip
//: `skip_result` の互換 facade
pub fn skip %impure fn &StreamScanner unit \sc:
    match skip_result sc:
        Result::Ok _:
            unit
        Result::Err _e:
            unit

//: ## scan_token_result
//: [次/つぎ]の token を `str` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - EOF は空文字ではなく `StreamScannerError::Eof` として返します。
//: - invalid UTF-8 は `StreamScannerError::InvalidUtf8` として返し、cursor を進めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "token";
//:| let token %str unwrap_ok scan_token_result &sc;
//:| close sc;
//: ```
pub fn scan_token_result %impure fn &StreamScanner Result str StreamScannerError \sc:
    match skip_ws_result sc:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            let bytes %&ByteBuf get_ref sc "bytes";
            let len %i32 stream_scanner_len sc;
            match stream_scanner_load_pos_result sc:
                Result::Err e:
                    Result::Err e
                Result::Ok start:
                    let mut p %i32 start;
                    let mut done %i32 0;
                    let mut failed %i32 0;
                    let mut err %StreamScannerError StreamScannerError::InvalidByteBuffer;
                    while eq done 0:
                        if:
                            lt p len
                            then:
                                match stream_scanner_byte_at_result bytes p:
                                    Result::Err e:
                                        set err e;
                                        set failed 1;
                                        set done 1;
                                    Result::Ok byte:
                                        if:
                                            stream_scanner_is_token_separator byte
                                            then:
                                                set done 1;
                                            else:
                                                set p add p 1;
                            else:
                                set done 1;
                    if:
                        eq failed 1
                        then:
                            Result::Err err
                        else:
                            let tlen %i32 sub p start;
                            if:
                                eq tlen 0
                                then:
                                    Result::Err StreamScannerError::Eof
                                else:
                                    match stream_scanner_slice_to_str_result sc start tlen:
                                        Result::Err e:
                                            Result::Err e
                                        Result::Ok token:
                                            match stream_scanner_store_pos_result sc p:
                                                Result::Err e:
                                                    Result::Err e
                                                Result::Ok _:
                                                    Result::Ok token

//: ## scan_token_impl
//: `scan_token_result` の互換 facade
pub fn scan_token_impl %impure fn &StreamScanner str \sc:
    match scan_token_result sc:
        Result::Ok token:
            token
        Result::Err _e:
            ""

//: ## read
//: `StreamScanner` から token / [数値/すうち]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - suffix [付/つ]き API を[残/のこ]さず、`read &sc` の 1 [個/こ]の[名前/なまえ]へ[統一/とういつ]します。
//: - 対応型ごとの overload として定義し、未対応型は runtime trap ではなく overload 解決失敗にします。
//:
//: ### [注意/ちゅうい]
//: - [受/う]け[側/がわ]の[型注釈/かたちゅうしゃく]または式の期待型で[読/よ]む[型/かた]を[決/き]めます。
pub fn read %impure fn &StreamScanner str \sc:
    scan_token_impl sc

//: ## read_result str
//: `str` token を typed error として読む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "word";
//:| let word %str unwrap_ok read_result &sc;
//:| close sc;
//: ```
pub fn read_result %impure fn &StreamScanner Result str StreamScannerError \sc:
    scan_token_result sc

pub fn read %impure fn &StreamScanner i32 \sc:
    scan_i32_impl sc

//: ## read_result i32
//: `i32` token を typed error として読む
//:
//: neplg2:test[skip]
