//: # streamio/scanner
//: `std/streamio` の token scanner と read target API を提供する submodule
//:
//: ### [目的/もくてき]
//: - `StreamScanner` の ByteBuf/cursor state、token parser、`open ReadStream`、scanner read overload を `std/streamio` facade から分離します。
//: - scanner の typed cursor storage boundary を writer とは別 module に閉じ込め、source policy で再肥大化を検出できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `StreamScanner` は input `ByteBuf` と typed cursor storage を所有する handle です。`read` は borrow で呼び、`close` は owner を消費します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//: fn main %impure fn void i32 \void:
//:     let sc %StreamScanner unwrap_ok open ReadStream::Text "4 5";
//:     let a %i32 read &sc;
//:     let b %i32 read &sc;
//:     close sc;
//:     add a b
//: ```

#indent 4

#import "alloc/collections/vec" as vec
#import "alloc/io" as *
#import "alloc/string" as *
#import "core/result" as *
#import "std/fs" as *
#import "std/iotarget" as *
#import "std/stdio" as *
#import "std/streamio/scanner/cursor" as *
#import "std/streamio/scanner/number" as *
#import "std/streamio/scanner/state" as *
#import "core/field" as *
#import "core/math" as *

//: ## open
//: read target から scanner を[開/ひら]く
//:
//: ### [目的/もくてき]
//: - stdin / in-memory text / binary buffer / file path を、1 [個/こ]の `open` [入口/いりぐち]で token scanner へ[載/の]せます。
//: - `ReadStream` だけを[受/う]け[付/つ]けることで、`open WriteStream::Stdio` のような[誤用/ごよう]を compile error にします。
//:
//: ### [実装/じっそう]
//: - target ごとに byte [列/れつ]へ[正規化/せいきか]してから typed cursor storage を[確保/かくほ]し、input owner は `ByteBuf` field として[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - file read [失敗/しっぱい]や[確保/かくほ][失敗/しっぱい]は `Result::Err` に[丸/まる]めます。
pub fn open %impure fn ReadStream Result StreamScanner str \target:
    match target:
        ReadStream::Stdio:
            scanner_from_bytes stdio_read_all_bytes
        ReadStream::Text text:
            match io_bytebuf_from_str_result text:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result::Err "streamio.scanner text alloc failed"
        ReadStream::Bytes bytes:
            scanner_from_bytes bytes
        ReadStream::Fs path:
            match fs_read_to_bytes path:
                Result::Ok bytes:
                    scanner_from_bytes bytes
                Result::Err _e:
                    Result::Err "streamio.scanner read failed"

//: ## skip_ws
//: ASCII [空白/くうはく]と[先頭/せんとう] BOM を[飛/と]ばす
pub fn skip_ws %impure fn &StreamScanner unit \sc:
    stream_scanner_skip_ws_state sc

//: ## is_eof
//: token が[残/のこ]っていないか[確認/かくにん]する
pub fn is_eof %impure fn &StreamScanner bool \sc:
    stream_scanner_skip_ws_state sc;
    ge stream_scanner_load_pos sc stream_scanner_len sc

//: ## skip
//: [現在/げんざい] token を 1 [個/こ][消費/しょうひ]する
pub fn skip %impure fn &StreamScanner unit \sc:
    stream_scanner_skip_ws_state sc;
    let bytes %&ByteBuf get_ref sc "bytes";
    let len %i32 stream_scanner_len sc;
    let mut p %i32 stream_scanner_load_pos sc;
    let mut done %i32 0;
    while eq done 0:
        if:
            lt p len
            then:
                let byte %i32 stream_scanner_byte_at bytes p;
                if:
                    stream_scanner_is_token_separator byte
                    then:
                        set done 1;
                    else:
                        set p add p 1;
            else:
                set done 1;
    stream_scanner_store_pos sc p;
    unit

//: ## scan_token_impl
//: [次/つぎ]の token を `str` として[読/よ]む
pub fn scan_token_impl %impure fn &StreamScanner str \sc:
    stream_scanner_skip_ws_state sc;
    let bytes %&ByteBuf get_ref sc "bytes";
    let len %i32 stream_scanner_len sc;
    let start %i32 stream_scanner_load_pos sc;
    let mut p %i32 start;
    let mut done %i32 0;
    while eq done 0:
        if:
            lt p len
            then:
                let byte %i32 stream_scanner_byte_at bytes p;
                if:
                    stream_scanner_is_token_separator byte
                    then:
                        set done 1;
                    else:
                        set p add p 1;
            else:
                set done 1;
    let tlen %i32 sub p start;
    if:
        eq tlen 0
        then:
            ""
        else:
            match stream_scanner_slice_to_str_result sc start tlen:
                Result::Err _e:
                    stream_scanner_store_pos sc p;
                    ""
                Result::Ok token:
                    stream_scanner_store_pos sc p;
                    token

//: ## read
//: `StreamScanner` から token / [数値/すうち]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - suffix [付/つ]き API を[残/のこ]さず、`read &sc` の 1 [個/こ]の[名前/なまえ]へ[統一/とういつ]します。
//: - 対応型ごとの overload として定義し、未対応型は runtime trap ではなく overload 解決失敗にします。
//:
//: ### [注意/ちゅうい]
//: - [受/う]け[側/がわ]の[型注釈/かたちゅうしゃく]または式の期待型で[読/よ]む[型/かた]を[決/き]めます。
pub fn read %impure fn &StreamScanner str \sc:
    scan_token_impl sc

pub fn read %impure fn &StreamScanner i32 \sc:
    scan_i32_impl sc

pub fn read %impure fn &StreamScanner i64 \sc:
    scan_i64_impl sc

pub fn read %impure fn &StreamScanner u32 \sc:
    scan_u32_impl sc

pub fn read %impure fn &StreamScanner u64 \sc:
    scan_u64_impl sc

pub fn read %impure fn &StreamScanner f64 \sc:
    scan_f64_impl sc

pub fn read %impure fn &StreamScanner f32 \sc:
    scan_f32_impl sc

//: ## close
//: `StreamScanner` を[閉/と]じて[内部/ないぶ] buffer を[解放/かいほう]する
pub fn close %impure fn StreamScanner unit \sc:
    let bytes %ByteBuf get sc "bytes";
    let cursor %Vec i32 get sc "cursor";
    io_bytebuf_free bytes;
    vec::free cursor
