//: # streamio/scanner/cursor
//: `StreamScanner` の cursor 移動と token 境界判定 helper
//:
//: ### [目的/もくてき]
//: - scanner の BOM / 空白 skip と ASCII byte classifier を token parser / numeric parser から分離します。
//: - parser 本体は cursor storage を直接走査せず、この module の境界 helper を通して読み取り開始位置を整えます。

#indent 4

#import "alloc/io" as *
#import "core/result" as *
#import "std/streamio/scanner/error" as *
#import "std/streamio/scanner/state" as *
#import "core/field" as *
#import "core/math" as *

//: stream_scanner_is_leading_skip_byte: scanner 先頭で読み飛ばす byte か判定する
//:
//: [目的/もくてき]:
//: - BOM 後の NUL と ASCII 空白を、decimal code ではなく文字として明示します。
pub fn stream_scanner_is_leading_skip_byte %fn i32 bool \byte:
    match byte:
        '\0':
            true
        ' ':
            true
        '\n':
            true
        '\r':
            true
        '\t':
            true
        _:
            false

//: stream_scanner_is_token_separator: token を区切る ASCII 空白か判定する
pub fn stream_scanner_is_token_separator %fn i32 bool \byte:
    match byte:
        ' ':
            true
        '\n':
            true
        '\r':
            true
        '\t':
            true
        _:
            false

//: stream_scanner_is_ascii_digit: ASCII digit か判定する
pub fn stream_scanner_is_ascii_digit %fn i32 bool \byte:
    and ge byte '0' le byte '9'

//: stream_scanner_digit_value: ASCII digit byte を 0..9 の値へ変換する
pub fn stream_scanner_digit_value %fn i32 i32 \byte:
    sub byte '0'

//: stream_scanner_is_exponent_marker: 浮動小数点 token の指数 marker か判定する
pub fn stream_scanner_is_exponent_marker %fn i32 bool \byte:
    match byte:
        'e':
            true
        'E':
            true
        _:
            false

//: stream_scanner_detect_bom_skip: 先頭 BOM の byte 数を返す
//:
//: [目的/もくてき]:
//: - UTF-8 BOM と UTF-16 BOM の判定を cursor 更新から分離します。
//: - BOM がない場合は 0 を返し、caller が cursor を変更しないようにします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "abc";
//:| let bytes %&ByteBuf get_ref &sc "bytes";
//:| let n %i32 unwrap_ok stream_scanner_detect_bom_skip bytes stream_scanner_len &sc;
//:| close sc;
//: ```
pub fn stream_scanner_detect_bom_skip %fn &ByteBuf fn i32 Result i32 StreamScannerError \bytes\byte_len:
    let mut skip_len %i32 0;
    if:
        ge byte_len 2
        then:
            match stream_scanner_byte_at_result bytes 0:
                Result::Err e:
                    Result::Err e
                Result::Ok b0:
                    match stream_scanner_byte_at_result bytes 1:
                        Result::Err e:
                            Result::Err e
                        Result::Ok b1:
                            let is_utf16_bom %bool or and eq b0 255 eq b1 254 and eq b0 254 eq b1 255;
                            if:
                                is_utf16_bom
                                then:
                                    set skip_len 2;
                                else:
                                    unit;
                            if:
                                ge byte_len 3
                                then:
                                    match stream_scanner_byte_at_result bytes 2:
                                        Result::Err e:
                                            Result::Err e
                                        Result::Ok b2:
                                            let is_utf8_bom %bool and and eq b0 239 eq b1 187 eq b2 191;
                                            if:
                                                is_utf8_bom
                                                then:
                                                    set skip_len 3;
                                                else:
                                                    unit;
                                            Result::Ok skip_len
                                else:
                                    Result::Ok skip_len
        else:
            Result::Ok skip_len

//: ## stream_scanner_skip_ws_result
//: scanner cursor を token の開始位置まで進める
//:
//: ### [契約/けいやく]
//: - BOM と ASCII 空白だけを読み飛ばします。
//: - byte 読み取りや cursor storage の失敗は `StreamScannerError` として返し、失敗を NUL byte に丸めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "  abc";
//:| unwrap_ok stream_scanner_skip_ws_result &sc;
//:| close sc;
//: ```
pub fn stream_scanner_skip_ws_result %impure fn &StreamScanner Result unit StreamScannerError \sc:
    let bytes %&ByteBuf get_ref sc "bytes";
    let len %i32 stream_scanner_len sc;
    match stream_scanner_load_pos_result sc:
        Result::Err e:
            Result::Err e
        Result::Ok p0:
            let mut p %i32 p0;
            let mut done %i32 0;
            let mut failed %i32 0;
            let mut scan_error %StreamScannerError StreamScannerError::InvalidByteBuffer;
            if:
                eq p 0
                then:
                    match stream_scanner_detect_bom_skip bytes len:
                        Result::Err e:
                            set scan_error e;
                            set failed 1;
                        Result::Ok bom_skip:
                            if:
                                gt bom_skip 0
                                then:
                                    set p bom_skip;
                                else:
                                    unit
                else:
                    unit

            while eq done 0:
                if:
                    and eq failed 0 lt p len
                    then:
                        match stream_scanner_byte_at_result bytes p:
                            Result::Err e:
                                set scan_error e;
                                set failed 1;
                                set done 1;
                            Result::Ok byte:
                                if:
                                    stream_scanner_is_leading_skip_byte byte
                                    then:
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;

            if:
                eq failed 1
                then:
                    Result::Err scan_error
                else:
                    stream_scanner_store_pos_result sc p

pub fn stream_scanner_skip_ws_state %impure fn &StreamScanner unit \sc:
    match stream_scanner_skip_ws_result sc:
        Result::Ok _:
            unit
        Result::Err _e:
            unit
