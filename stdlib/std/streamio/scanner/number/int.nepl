//: # streamio/scanner/number/int
//: `StreamScanner` から整数 token を読む parser
//:
//: ### [目的/もくてき]
//: - `i32` / `u32` / `u64` / `i64` の token parser を浮動小数点 parser から分離します。
//: - 整数 parser は cursor helper と state boundary だけに依存し、raw buffer access を直接行いません。

#indent 4

#import "alloc/io" as *
#import "core/cast" as *
#import "core/math" as *
#import "std/streamio/scanner/cursor" as *
#import "std/streamio/scanner/state" as *
#import "core/field" as *

//: ## scan_i32_impl
//: [次/つぎ]の token を `i32` として[読/よ]む
pub fn scan_i32_impl <(&StreamScanner)*>i32> (sc):
    stream_scanner_skip_ws_state sc;
    let bytes <&ByteBuf> get_ref sc "bytes";
    let len <i32> stream_scanner_len sc;
    let mut p <i32> stream_scanner_load_pos sc;
    if:
        ge p len
        then:
            0
        else:
            let mut sign <i32> 1;
            let b0 <i32> stream_scanner_byte_at bytes p;
            if:
                eq b0 '-'
                then:
                    set sign -1;
                    set p add p 1;
                else:
                    ();
            let mut val <i32> 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at bytes p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        set val add mul val 10 stream_scanner_digit_value byte;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_pos sc p;
            mul val sign

//: ## scan_u32_impl
//: [次/つぎ]の token を `u32` として[読/よ]む
pub fn scan_u32_impl <(&StreamScanner)*>u32> (sc):
    stream_scanner_skip_ws_state sc;
    let bytes <&ByteBuf> get_ref sc "bytes";
    let len <i32> stream_scanner_len sc;
    let mut p <i32> stream_scanner_load_pos sc;
    if:
        ge p len
        then:
            <u32> cast 0
        else:
            if:
                eq stream_scanner_byte_at bytes p '+'
                then:
                    set p add p 1;
                else:
                    ();
            let mut val <i32> 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at bytes p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit <i32> stream_scanner_digit_value byte;
                                        let scaled <i32> mul val 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_pos sc p;
            <u32> cast val

//: ## scan_u64_impl
//: [次/つぎ]の token を `u64` として[読/よ]む
pub fn scan_u64_impl <(&StreamScanner)*>u64> (sc):
    stream_scanner_skip_ws_state sc;
    let bytes <&ByteBuf> get_ref sc "bytes";
    let len <i32> stream_scanner_len sc;
    let mut p <i32> stream_scanner_load_pos sc;
    if:
        ge p len
        then:
            let zero64 <i64> cast 0;
            <u64> cast zero64
        else:
            if:
                eq stream_scanner_byte_at bytes p '+'
                then:
                    set p add p 1;
                else:
                    ();
            let mut val <i64> cast 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at bytes p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit32 <i32> stream_scanner_digit_value byte;
                                        let digit <i64> cast digit32;
                                        let scaled <i64> mul val <i64> cast 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_pos sc p;
            <u64> cast val

//: ## scan_i64_impl
//: [次/つぎ]の token を `i64` として[読/よ]む
pub fn scan_i64_impl <(&StreamScanner)*>i64> (sc):
    stream_scanner_skip_ws_state sc;
    let bytes <&ByteBuf> get_ref sc "bytes";
    let len <i32> stream_scanner_len sc;
    let mut p <i32> stream_scanner_load_pos sc;
    if:
        ge p len
        then:
            <i64> cast 0
        else:
            let mut is_neg <i32> 0;
            let b0 <i32> stream_scanner_byte_at bytes p;
            if:
                eq b0 '-'
                then:
                    set is_neg 1;
                    set p add p 1;
                else:
                    if:
                        eq b0 '+'
                        then:
                            set p add p 1;
                        else:
                            ();
            let mut val <i64> cast 0;
            let mut done <i32> 0;
            while eq done 0:
                if:
                    lt p len
                    then:
                        let byte <i32> stream_scanner_byte_at bytes p;
                        if:
                            eq byte 0
                            then:
                                set p add p 1;
                            else:
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let digit32 <i32> stream_scanner_digit_value byte;
                                        let digit <i64> cast digit32;
                                        let scaled <i64> mul val <i64> cast 10;
                                        set val add scaled digit;
                                        set p add p 1;
                                    else:
                                        set done 1;
                    else:
                        set done 1;
            stream_scanner_store_pos sc p;
            if:
                eq is_neg 1
                then:
                    sub <i64> cast 0 val
                else:
                    val
