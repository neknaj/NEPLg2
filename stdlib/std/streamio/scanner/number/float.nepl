//: # streamio/scanner/number/float
//: `StreamScanner` から浮動小数点 token を読む parser
//:
//: ### [目的/もくてき]
//: - `f64` / `f32` の token parser を整数 parser から分離します。
//: - cursor helper と scanner state boundary だけに依存し、raw buffer access を直接行いません。

#indent 4

#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "std/streamio/scanner/cursor" as *
#import "std/streamio/scanner/state" as *

//: ## scan_f64_impl
//: [次/つぎ]の token を `f64` として[読/よ]む
fn scan_f64_impl <(StreamScanner)*>f64> (sc):
    let header <MemPtr<u8>> get sc "header";
    stream_scanner_skip_ws_header header;
    let buf <MemPtr<u8>> mem_ptr_wrap stream_scanner_load_header header StreamScannerHeaderField::BufPtr;
    let buf_len <i32> stream_scanner_load_header header StreamScannerHeaderField::Len;
    let mut p <i32> stream_scanner_load_header header StreamScannerHeaderField::Pos;
    if:
        ge p buf_len
        then:
            <f64> cast 0
        else:
            let mut is_neg <i32> 0;
            let b0 <i32> stream_scanner_byte_at buf buf_len p;
            if:
                eq b0 '-'
                then:
                    set is_neg 1;
                    set p add p 1;
                else:
                    if:
                        eq b0 '+'
                        then:
                            set p add p 1;
                        else:
                            ();
            let mut val <f64> cast 0;
            let mut any_digit <i32> 0;
            let ten <f64> cast 10;
            let mut done_int <i32> 0;
            while eq done_int 0:
                if:
                    lt p buf_len
                    then:
                        let byte <i32> stream_scanner_byte_at buf buf_len p;
                        if:
                            stream_scanner_is_ascii_digit byte
                            then:
                                let d <f64> cast stream_scanner_digit_value byte;
                                set val add mul val ten d;
                                set p add p 1;
                                set any_digit 1;
                            else:
                                set done_int 1;
                    else:
                        set done_int 1;
            let mut has_dot <i32> 0;
            if:
                lt p buf_len
                then:
                    if:
                        eq stream_scanner_byte_at buf buf_len p '.'
                        then set has_dot 1
                        else ()
                else:
                    ();
            if:
                eq has_dot 1
                then:
                    set p add p 1;
                    let one <f64> cast 1;
                    let mut place <f64> div one ten;
                    let mut done_frac <i32> 0;
                    while eq done_frac 0:
                        if:
                            lt p buf_len
                            then:
                                let byte <i32> stream_scanner_byte_at buf buf_len p;
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        let d <f64> cast stream_scanner_digit_value byte;
                                        set val add val mul d place;
                                        set place div place ten;
                                        set p add p 1;
                                        set any_digit 1;
                                    else:
                                        set done_frac 1;
                            else:
                                set done_frac 1;
                else:
                    ();
            let mut has_exp <i32> 0;
            if:
                lt p buf_len
                then:
                    let ec <i32> stream_scanner_byte_at buf buf_len p;
                    if:
                        stream_scanner_is_exponent_marker ec
                        then set has_exp 1
                        else ()
                else:
                    ();
            if:
                eq has_exp 1
                then:
                    set p add p 1;
                    let mut exp_neg <i32> 0;
                    if:
                        lt p buf_len
                        then:
                            let eb <i32> stream_scanner_byte_at buf buf_len p;
                            if:
                                eq eb '-'
                                then:
                                    set exp_neg 1;
                                    set p add p 1;
                                else:
                                    if:
                                        eq eb '+'
                                        then:
                                            set p add p 1;
                                        else:
                                            ();
                        else:
                            ();
                    let mut exp_val <i32> 0;
                    let mut done_exp <i32> 0;
                    while eq done_exp 0:
                        if:
                            lt p buf_len
                            then:
                                let byte <i32> stream_scanner_byte_at buf buf_len p;
                                if:
                                    stream_scanner_is_ascii_digit byte
                                    then:
                                        set exp_val add mul exp_val 10 stream_scanner_digit_value byte;
                                        set p add p 1;
                                    else:
                                        set done_exp 1;
                            else:
                                set done_exp 1;
                    let mut k <i32> 0;
                    while lt k exp_val:
                        do:
                            if:
                                eq exp_neg 1
                                then:
                                    set val div val ten;
                                else:
                                    set val mul val ten;
                            set k add k 1;
                else:
                    ();
            stream_scanner_store_header header StreamScannerHeaderField::Pos p;
            if:
                eq any_digit 0
                then:
                    <f64> cast 0
                else:
                    if:
                        eq is_neg 1
                        then:
                            neg val
                        else:
                            val

//: ## scan_f32_impl
//: [次/つぎ]の token を `f32` として[読/よ]む
fn scan_f32_impl <(StreamScanner)*>f32> (sc):
    <f32> cast scan_f64_impl sc
