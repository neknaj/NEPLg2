//: # streamio/scanner/number/float
//: `StreamScanner` から浮動小数点 token を読む parser
//:
//: ### [目的/もくてき]
//: - `f64` / `f32` の token parser を整数 parser から分離します。
//: - primary API は `Result` を返し、EOF / malformed token / cursor failure を呼び出し側が `match` で扱えるようにします。

#indent 4

#import "alloc/io" as *
#import "core/math" as *
#import "core/math/convert/float" as *
#import "core/result" as *
#import "std/streamio/scanner/cursor" as *
#import "std/streamio/scanner/error" as *
#import "std/streamio/scanner/state" as *
#import "core/field" as *

//: ## scan_f64_result
//: [次/つぎ]の token を `f64` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - 整数部または小数部に少なくとも 1 digit が必要です。
//: - 指数 marker がある場合は、指数部にも少なくとも 1 digit が必要です。
//: - 成功時だけ cursor を token 末尾へ進めます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "-1.25e2";
//:| let n %f64 unwrap_ok scan_f64_result &sc;
//:| close sc;
//: ```
pub fn scan_f64_result %impure fn &StreamScanner Result f64 StreamScannerError \sc:
    match stream_scanner_skip_ws_result sc:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            let bytes %&ByteBuf get_ref sc "bytes";
            let buf_len %i32 stream_scanner_len sc;
            match stream_scanner_load_pos_result sc:
                Result::Err e:
                    Result::Err e
                Result::Ok start:
                    if:
                        ge start buf_len
                        then:
                            Result::Err StreamScannerError::Eof
                        else:
                            let mut p %i32 start;
                            let mut is_neg %i32 0;
                            let mut failed %i32 0;
                            let mut err %StreamScannerError StreamScannerError::InvalidByteBuffer;
                            match stream_scanner_byte_at_result bytes p:
                                Result::Err e:
                                    set err e;
                                    set failed 1;
                                Result::Ok b0:
                                    if:
                                        eq b0 '-'
                                        then:
                                            set is_neg 1;
                                            set p add p 1;
                                        else:
                                            if:
                                                eq b0 '+'
                                                then:
                                                    set p add p 1;
                                                else:
                                                    unit;
                            let mut val %f64 convert_s_i32_to_f64 0;
                            let mut any_digit %i32 0;
                            let ten %f64 convert_s_i32_to_f64 10;
                            let mut done_int %i32 0;
                            while eq done_int 0:
                                if:
                                    and eq failed 0 lt p buf_len
                                    then:
                                        match stream_scanner_byte_at_result bytes p:
                                            Result::Err e:
                                                set err e;
                                                set failed 1;
                                                set done_int 1;
                                            Result::Ok byte:
                                                if:
                                                    stream_scanner_is_ascii_digit byte
                                                    then:
                                                        let d %f64 convert_s_i32_to_f64 stream_scanner_digit_value byte;
                                                        set val add mul val ten d;
                                                        set p add p 1;
                                                        set any_digit 1;
                                                    else:
                                                        set done_int 1;
                                    else:
                                        set done_int 1;
                            let mut has_dot %i32 0;
                            if:
                                and eq failed 0 lt p buf_len
                                then:
                                    match stream_scanner_byte_at_result bytes p:
                                        Result::Err e:
                                            set err e;
                                            set failed 1;
                                        Result::Ok dot_byte:
                                            if:
                                                eq dot_byte '.'
                                                then:
                                                    set has_dot 1;
                                                else:
                                                    unit
                                else:
                                    unit;
                            if:
                                and eq failed 0 eq has_dot 1
                                then:
                                    set p add p 1;
                                    let one %f64 convert_s_i32_to_f64 1;
                                    let mut place %f64 div one ten;
                                    let mut done_frac %i32 0;
                                    while eq done_frac 0:
                                        if:
                                            and eq failed 0 lt p buf_len
                                            then:
                                                match stream_scanner_byte_at_result bytes p:
                                                    Result::Err e:
                                                        set err e;
                                                        set failed 1;
                                                        set done_frac 1;
                                                    Result::Ok byte:
                                                        if:
                                                            stream_scanner_is_ascii_digit byte
                                                            then:
                                                                let d %f64 convert_s_i32_to_f64 stream_scanner_digit_value byte;
                                                                set val add val mul d place;
                                                                set place div place ten;
                                                                set p add p 1;
                                                                set any_digit 1;
                                                            else:
                                                                set done_frac 1;
                                            else:
                                                set done_frac 1;
                                else:
                                    unit;
                            if:
                                eq failed 1
                                then:
                                    Result::Err err
                                else:
                                    if:
                                        eq any_digit 0
                                        then:
                                            Result::Err StreamScannerError::MalformedToken
                                        else:
                                            let mut has_exp %i32 0;
                                            if:
                                                lt p buf_len
                                                then:
                                                    match stream_scanner_byte_at_result bytes p:
                                                        Result::Err e:
                                                            set err e;
                                                            set failed 1;
                                                        Result::Ok ec:
                                                            if:
                                                                stream_scanner_is_exponent_marker ec
                                                                then:
                                                                    set has_exp 1;
                                                                else:
                                                                    unit
                                                else:
                                                    unit;
                                            let mut exp_ok %i32 1;
                                            if:
                                                and eq failed 0 eq has_exp 1
                                                then:
                                                    set p add p 1;
                                                    let mut exp_neg %i32 0;
                                                    if:
                                                        lt p buf_len
                                                        then:
                                                            match stream_scanner_byte_at_result bytes p:
                                                                Result::Err e:
                                                                    set err e;
                                                                    set failed 1;
                                                                Result::Ok eb:
                                                                    if:
                                                                        eq eb '-'
                                                                        then:
                                                                            set exp_neg 1;
                                                                            set p add p 1;
                                                                        else:
                                                                            if:
                                                                                eq eb '+'
                                                                                then:
                                                                                    set p add p 1;
                                                                                else:
                                                                                    unit;
                                                        else:
                                                            unit;
                                                    let mut exp_val %i32 0;
                                                    let mut exp_digits %i32 0;
                                                    let mut done_exp %i32 0;
                                                    while eq done_exp 0:
                                                        if:
                                                            and eq failed 0 lt p buf_len
                                                            then:
                                                                match stream_scanner_byte_at_result bytes p:
                                                                    Result::Err e:
                                                                        set err e;
                                                                        set failed 1;
                                                                        set done_exp 1;
                                                                    Result::Ok byte:
                                                                        if:
                                                                            stream_scanner_is_ascii_digit byte
                                                                            then:
                                                                                set exp_val add mul exp_val 10 stream_scanner_digit_value byte;
                                                                                set p add p 1;
                                                                                set exp_digits 1;
                                                                            else:
                                                                                set done_exp 1;
                                                            else:
                                                                set done_exp 1;
                                                    if:
                                                        eq exp_digits 0
                                                        then:
                                                            set exp_ok 0;
                                                        else:
                                                            let mut k %i32 0;
                                                            while lt k exp_val:
                                                                do:
                                                                    if:
                                                                        eq exp_neg 1
                                                                        then:
                                                                            set val div val ten;
                                                                        else:
                                                                            set val mul val ten;
                                                                    set k add k 1;
                                                else:
                                                    unit;
                                            if:
                                                eq failed 1
                                                then:
                                                    Result::Err err
                                                else:
                                                    if:
                                                        eq exp_ok 0
                                                        then:
                                                            Result::Err StreamScannerError::MalformedToken
                                                        else:
                                                            match stream_scanner_store_pos_result sc p:
                                                                Result::Err e:
                                                                    Result::Err e
                                                                Result::Ok _:
                                                                    if:
                                                                        eq is_neg 1
                                                                        then:
                                                                            Result::Ok neg val
                                                                        else:
                                                                            Result::Ok val

//: ## scan_f64_impl
//: `scan_f64_result` の互換 facade
pub fn scan_f64_impl %impure fn &StreamScanner f64 \sc:
    match scan_f64_result sc:
        Result::Ok value:
            value
        Result::Err _e:
            convert_s_i32_to_f64 0

//: ## scan_f32_result
//: [次/つぎ]の token を `f32` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - parsing は `scan_f64_result` と同じ token 契約に従い、成功値だけを `f32` へ変換します。
//: - malformed token や cursor failure は同じ `StreamScannerError` を返します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/scanner" as *
//:| let sc %StreamScanner unwrap_ok open ReadStream::Text "1.25";
//:| let n %f32 unwrap_ok scan_f32_result &sc;
//:| close sc;
//: ```
pub fn scan_f32_result %impure fn &StreamScanner Result f32 StreamScannerError \sc:
    match scan_f64_result sc:
        Result::Ok value:
            Result::Ok demote_f64_to_f32 value
        Result::Err e:
            Result::Err e

//: ## scan_f32_impl
//: `scan_f32_result` の互換 facade
pub fn scan_f32_impl %impure fn &StreamScanner f32 \sc:
    match scan_f32_result sc:
        Result::Ok value:
            value
        Result::Err _e:
            demote_f64_to_f32 convert_s_i32_to_f64 0
