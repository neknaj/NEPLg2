//: # streamio/scanner/state
//: `StreamScanner` の owning state と ByteBuf/cursor 境界
//:
//: ### [目的/もくてき]
//: - scanner の input buffer owner を `ByteBuf` field として静的検査に見える形で保持します。
//: - borrowed `read &sc` で cursor だけを進められるよう、cursor position は小さな typed storage に閉じます。
//: - token parser は raw pointer を直接組み立てず、この module の ByteBuf/cursor helper を通して byte と slice を扱います。
//:
//: ### [注意/ちゅうい]
//: - `StreamScanner` は input bytes と typed cursor storage を所有する handle です。読み取りは borrow、解放は `close` で行います。
//: - `scanner_from_bytes` は渡された `ByteBuf` を成功/失敗にかかわらず消費します。

#indent 4

#import "alloc/collections/vec" as vec
#import "alloc/io" as *
#import "alloc/string" as *
#import "alloc/string/storage" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "core/field" as *

//: ## StreamScanner
//: read target を token [単位/たんい]に[走査/そうさ]する scanner
//:
//: ### [目的/もくてき]
//: - `kpread` にあった token parser の[中核/ちゅうかく]を `std` 側へ[昇格/しょうかく]し、stdin / in-memory text / binary / file を[同/おな]じ scanner [面/めん]へ[載/の]せます。
//:
//: ### [注意/ちゅうい]
//: - scanner handle は input bytes と cursor storage の[解放/かいほう][責務/せきむ]を[持/も]つため、`Copy` / `Clone` を[実装/じっそう]しません。
//: - `read` / `skip` / `is_eof` は `&StreamScanner` を[受/う]け[取/と]り、cursor だけを[進/すす]めます。
//: - buffer と cursor storage の[解放/かいほう]は owner を[消費/しょうひ]する `close` が[担当/たんとう]します。
//: - [別々/べつべつ]に `open` した scanner [同士/どうし]は[状態/じょうたい]を[共有/きょうゆう]しないので、[複数/ふくすう]の stream を[同時/どうじ]に[維持/いじ]できます。
pub struct StreamScanner:
    bytes %ByteBuf
    cursor %Vec i32

//: ## stream_scanner_byte_at
//: scanner buffer の byte を安全な範囲内で読む
//:
//: ### [目的/もくてき]
//: - scanner が所有する `ByteBuf` を borrowed view として読み、tokenizer が raw address を直接扱わないようにします。
//: - 呼び出し側の境界確認漏れや低レベル load 失敗は byte `0` として扱い、scanner の sentinel と同じ意味に丸めます。
pub fn stream_scanner_byte_at %fn &ByteBuf fn i32 i32 \bytes\pos:
    match io_bytebuf_byte_at bytes pos:
        Option::Some byte:
            byte
        Option::None:
            0

//: ## stream_scanner_load_pos_result
//: scanner cursor position を読む
//:
//: ### [目的/もくてき]
//: - borrowed scanner API から cursor だけを更新するため、position は dedicated typed cursor storage に保持します。
//: - cursor storage の破損は `Result` として返し、public facade が必要に応じて sentinel へ丸めます。
pub fn stream_scanner_load_pos_result %fn &StreamScanner Result i32 str \sc:
    let cursor %&Vec i32 get_ref sc "cursor";
    match vec::get<i32> cursor 0:
        Option::Some pos:
            Result<i32,str>::Ok pos
        Option::None:
            Result<i32,str>::Err "streamio.stream_scanner_load_pos failed"

//: ## stream_scanner_load_pos
//: scanner cursor position を読む互換 facade
//:
//: ### [注意/ちゅうい]
//: - 既存の scanner API は `Result` を返さないため、cursor storage が壊れている場合は 0 に丸めます。
pub fn stream_scanner_load_pos %fn &StreamScanner i32 \sc:
    match stream_scanner_load_pos_result sc:
        Result::Ok v:
            v
        Result::Err _e:
            0

//: ## stream_scanner_store_pos_result
//: scanner cursor position を書く
//:
//: ### [目的/もくてき]
//: - `read &sc` のような borrowed API で scanner owner を移動せず、typed cursor position だけを scanner state boundary として更新します。
pub fn stream_scanner_store_pos_result %impure fn &StreamScanner impure fn i32 Result unit str \sc\pos:
    let cursor %&Vec i32 get_ref sc "cursor";
    match vec::get<i32> cursor 0:
        Option::Some _old:
            vec::replace<i32> cursor 0 pos
            Result::Ok unit
        Option::None:
            Result::Err "streamio.stream_scanner_store_pos failed"

//: ## stream_scanner_store_pos
//: scanner cursor position を書く互換 facade
pub fn stream_scanner_store_pos %impure fn &StreamScanner impure fn i32 unit \sc\pos:
    match stream_scanner_store_pos_result sc pos:
        Result::Ok _:
            unit
        Result::Err _e:
            unit

//: ## stream_scanner_len
//: scanner input byte length を返す
pub fn stream_scanner_len %fn &StreamScanner i32 \sc:
    let bytes %&ByteBuf get_ref sc "bytes";
    io_bytebuf_len_ref bytes

//: ## stream_scanner_slice_to_str_result
//: scanner input の byte slice を UTF-8 検証して `str` へ複製する
//:
//: ### [目的/もくてき]
//: - token parser が `ByteBuf` の raw pointer を直接取り出さず、slice-to-string の raw boundary をこの module に閉じます。
//: - `ByteBuf` owner は借用のまま保持し、返る `str` は新しい owned string です。
//: - 入力は `ReadStream::Bytes` や file 由来の任意 byte 列でもあり得るため、`str` 化の直前に UTF-8 として検証します。
pub fn stream_scanner_slice_to_str_result %impure fn &StreamScanner impure fn i32 impure fn i32 Result str str \sc\start\tlen:
    let bytes %&ByteBuf get_ref sc "bytes";
    let len %i32 io_bytebuf_len_ref bytes;
    let end %i32 add start tlen;
    if:
        or or or lt start 0 lt tlen 0 lt end start gt end len
        then:
            Result<str,str>::Err "streamio.stream_scanner_slice invalid range"
        else:
            if:
                eq tlen 0
                then:
                    Result<str,str>::Ok ""
                else:
                    match io_bytebuf_ptr_ref bytes:
                        Option::Some ptr:
                            match string_from_utf8_mem_result mem_ptr_add ptr start tlen:
                                Result::Ok token:
                                    Result<str,str>::Ok token
                                Result::Err _e:
                                    Result<str,str>::Err "streamio.stream_scanner_slice invalid utf8"
                        Option::None:
                            Result<str,str>::Err "streamio.stream_scanner_slice missing buffer"

//: ## stream_scanner_cursor_new
//: cursor position storage を作る
//:
//: ### [目的/もくてき]
//: - input buffer owner とは別に、borrowed scanner API が更新する 1 element の typed cursor storage を確保します。
pub fn stream_scanner_cursor_new %fn unit Result Vec i32 str \unit:
    match vec::filled<i32> 1 0:
        Result::Err _e:
            Result<Vec<i32>,str>::Err "streamio.scanner cursor alloc failed"
        Result::Ok cursor:
            Result<Vec<i32>,str>::Ok cursor

pub fn scanner_from_bytes %impure fn ByteBuf Result StreamScanner str \bytes:
    let len %i32 io_bytebuf_len_ref &bytes;
    match io_bytebuf_ptr_ref &bytes:
        Option::None:
            if:
                eq len 0
                then:
                    match stream_scanner_cursor_new:
                        Result::Ok cursor:
                            Result<StreamScanner,str>::Ok StreamScanner bytes cursor
                        Result::Err e:
                            io_bytebuf_free bytes
                            Result<StreamScanner,str>::Err e
                else:
                    io_bytebuf_free bytes
                    Result<StreamScanner,str>::Err "streamio.scanner invalid byte buffer"
        Option::Some _buf:
            match stream_scanner_cursor_new:
                Result::Ok cursor:
                    Result<StreamScanner,str>::Ok StreamScanner bytes cursor
                Result::Err e:
                    io_bytebuf_free bytes
                    Result<StreamScanner,str>::Err e
