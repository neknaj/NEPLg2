//: # streamio/writer
//: `std/streamio` の buffered writer と write target API を提供する submodule
//:
//: ### [目的/もくてき]
//: - `StreamWriter` の owning buffer、target enum、write / writeln / flush / close API を `std/streamio` facade から分離します。
//: - scanner と writer の内部状態を別 module に分け、raw memory backed API の責務境界を静的検査と source policy で追いやすくします。
//:
//: ### [注意/ちゅうい]
//: - `StreamWriter` は buffer owner を持つため `Copy` / `Clone` を実装しません。
//: - target は `StreamWriterTargetKind` enum と `match` で扱い、数値 code に戻さないでください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/writer" as *
//: fn main <()*>i32> ():
//:     let w <StreamWriter> unwrap_ok open WriteStream::Stdio;
//:     close write w "x";
//:     0
//: ```

#indent 4

#import "alloc/io" as *
#import "alloc/string" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/iotarget" as *
#import "std/stdio" as *
//: ## StreamWriter
//: write target へ[追記/ついき]していく buffered sink
//:
//: ### [目的/もくてき]
//: - `kpwrite` などの buffered write [中核/ちゅうかく]を `std` へ[昇格/しょうかく]し、競技向け helper 以外でも[再利用/さいりよう]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]で[確保/かくほ]した[書/か]き[込/こ]み buffer を[所有/しょゆう]するため `Copy` / `Clone` は[実装/じっそう]しません。
//: - [使/つか]い[終/お]わったら `close` で[解放/かいほう]してください。`flush` は[出力/しゅつりょく]のみを[行/おこな]い、[所有権/しょゆうけん]は[維持/いじ]します。
//: - target kind は stdout/stderr を[保持/ほじ]し、flush [時/じ]に[対応/たいおう]する fd へ[流/なが]します。
//: - [各/かく] writer は[独立/どくりつ]した buffer を[持/も]つため、[複数/ふくすう]の reader / writer を[同時/どうじ]に[保持/ほじ]できます。
struct StreamWriter:
    buf <MemPtr<u8>>
    cap <i32>
    write_len <i32>
    target <StreamWriterTargetKind>
    marker <(i32)->i32>

enum StreamWriterTargetKind:
    Stdout
    Stderr

impl Clone for StreamWriterTargetKind:
    fn clone <(&StreamWriterTargetKind)->StreamWriterTargetKind> (target):
        *target

impl Copy for StreamWriterTargetKind:
    fn copy_mark <(StreamWriterTargetKind)->StreamWriterTargetKind> (target):
        target

fn stream_writer_noncopy_marker <(i32)->i32> (x):
    x

//: ## stream_writer_bytebuf_byte_at
//: borrowed ByteBuf から 1 byte を読む
//:
//: ### [目的/もくてき]
//: - `append_bytebuf_impl` が `ByteBuf` owner を消費前に保持したまま、範囲内 byte だけを読めるようにします。
//: - `ByteBuf` の field を `get_ref` で読むため、append loop 中に buffer owner を移動しません。
fn stream_writer_bytebuf_byte_at <(&ByteBuf,i32)->Option<i32>> (bytes, idx):
    io_bytebuf_byte_at bytes idx

fn stream_writer_try_free_ptr <.T> <(MemPtr<.T>,i32)*>()> (ptr, size):
    match dealloc_ptr<.T> ptr size:
        Result::Ok _:
            ()
        Result::Err _e:
            ()

//: ## stream_writer_new
//: StreamWriter の buffer を確保して owning handle を作る
//:
//: ### [目的/もくてき]
//: - `StreamWriter` は非 Copy の owning struct として buffer pointer / capacity / pending length / target enum を直接保持します。
//: - scanner のような共有 cursor ではないため raw header を持たず、所有権は struct field として静的検査に見える形で管理します。
fn stream_writer_new <(StreamWriterTargetKind)*>Result<StreamWriter,str>> (target):
    match alloc_ptr<u8> 4096:
        Result::Ok buf:
            Result<StreamWriter,str>::Ok StreamWriter buf 4096 0 target @stream_writer_noncopy_marker
        Result::Err _e:
            Result<StreamWriter,str>::Err "streamio.stream_writer_new buffer alloc failed"

//: ## open
//: write target へ[書/か]く buffered sink を[作/つく]る
//:
//: ### [目的/もくてき]
//: - stdout などの write target を[指定/してい]して、buffered sink を[生成/せいせい]します。
//: - `WriteStream` だけを[受/う]け[付/つ]けることで、`open ReadStream::Stdio` のような[誤用/ごよう]を compile error にします。
//:
//: ### [実装/じっそう]
//: - `WriteStream::Stdio` と `WriteStream::Stderr` を[受/う]け[付/つ]け、writer field に target enum を[記録/きろく]します。
//:
//: ### [注意/ちゅうい]
//: - [未対応/みたいおう] target は `Result::Err` を[返/かえ]します。
fn open <(WriteStream)*>Result<StreamWriter,str>> (target):
    match target:
        WriteStream::Stdio:
            match stream_writer_new StreamWriterTargetKind::Stdout:
                Result::Ok w:
                    Result<StreamWriter,str>::Ok w
                Result::Err e:
                    Result<StreamWriter,str>::Err e
        WriteStream::Stderr:
            match stream_writer_new StreamWriterTargetKind::Stderr:
                Result::Ok w:
                    Result<StreamWriter,str>::Ok w
                Result::Err e:
                    Result<StreamWriter,str>::Err e
        WriteStream::Fs:
            Result<StreamWriter,str>::Err "streamio.open invalid target"

//: ## close
//: buffered sink の[確保領域/かくほりょういき]を[解放/かいほう]する
//:
//: ### [注意/ちゅうい]
//: - 未 flush の[内容/ないよう]は[捨/す]てられます。[必要/ひつよう]なら[先/さき]に `flush` を[呼/よ]んでください。
fn close <(StreamWriter)*>()> (w):
    let cap <i32> *get_ref &w "cap";
    let buf <MemPtr<u8>> get w "buf";
    stream_writer_try_free_ptr<u8> buf cap
    ()

//: ## drain_impl
//: buffered sink の[内容/ないよう]を target fd へ[書/か]き[出/だ]す
//:
//: ### [実装/じっそう]
//: - target kind に[応/おう]じて stdout/stderr を[選/えら]び、partial write を[吸収/きゅうしゅう]しながら[保留/ほりゅう] byte [列/れつ]を[出力/しゅつりょく]します。
//:
//: ### [計算量/けいさんりょう]
//: - [現在/げんざい]の[書/か]き[込/こ]み[長/なが]さを n として O(n) です。
fn drain_impl <(StreamWriter)*>StreamWriter> (w):
    let write_len <i32> *get_ref &w "write_len";
    if:
        le write_len 0
        then:
            w
        else:
            let target <StreamWriterTargetKind> *get_ref &w "target";
            match target:
                StreamWriterTargetKind::Stdout:
                    stdio_write_mem *get_ref &w "buf" write_len
                StreamWriterTargetKind::Stderr:
                    stdio_write_stderr_mem *get_ref &w "buf" write_len
            let cap <i32> *get_ref &w "cap";
            StreamWriter get w "buf" cap 0 target @stream_writer_noncopy_marker

//: ## reserve_impl
//: need byte [分/ぶん]の[空/あ]きを[確保/かくほ]する
//:
//: ### [注意/ちゅうい]
//: - need が capacity を[超/こ]える case は[呼/よ]び[出/だ]し[側/がわ]で[避/さ]けてください。この[版/ばん]では buffer [拡張/かくちょう]ではなく flush を[選/えら]びます。
fn reserve_impl <(StreamWriter,i32)*>StreamWriter> (w, need):
    let cap <i32> *get_ref &w "cap";
    let write_len <i32> *get_ref &w "write_len";
    let required <i32> add write_len need;
    if:
        le required cap
        then:
            w
        else:
            drain_impl w

//: ## push_u8_impl
//: 1 byte [追記/ついき]する
//:
//: ### [計算量/けいさんりょう]
//: - [通常/つうじょう]は O(1) で、flush が[入/はい]ると O(len) です。
fn push_u8_impl <(StreamWriter,i32)*>StreamWriter> (w, b):
    let cap0 <i32> *get_ref &w "cap";
    if:
        le cap0 0
        then:
            w
        else:
            let w1 <StreamWriter> reserve_impl w 1;
            let write_len <i32> *get_ref &w1 "write_len";
            let cap <i32> *get_ref &w1 "cap";
            let target <StreamWriterTargetKind> *get_ref &w1 "target";
            match store_u8 mem_ptr_add *get_ref &w1 "buf" write_len b:
                Result::Ok _:
                    StreamWriter get w1 "buf" cap add write_len 1 target @stream_writer_noncopy_marker
                Result::Err _e:
                    w1

//: ## push_newline_impl
//: [改行/かいぎょう] `\n` を 1 byte [出力/しゅつりょく]する
fn push_newline_impl <(StreamWriter)*>StreamWriter> (w):
    push_u8_impl w 10

//: ## append_str_impl
//: `str` を buffered sink へ[追記/ついき]する
//:
//: ### [注意/ちゅうい]
//: - `str` は `[len][bytes]` [形式/けいしき]なので、bytes [先頭/せんとう]は `string_data_ptr` で[得/え]ます。
//: - writer buffer の capacity を[超/こ]える文字列でも、1 byte ずつ `push_u8_impl` に通して flush 境界を保ちます。
fn append_str_impl <(StreamWriter,str)*>StreamWriter> (w, s):
    let n <i32> len s;
    let mut ww <StreamWriter> w;
    let mut i <i32> 0;
    while lt i n:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            set ww push_u8_impl ww ch;
            set i add i 1;
    ww

//: ## append_bytebuf_impl
//: `ByteBuf` を buffered sink へ[追記/ついき]する
//:
//: ### [目的/もくてき]
//: - binary payload を `str` へ[変換/へんかん]せず、`StreamWriter` の byte buffer へそのまま[積/つ]みます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuf` の[所有権/しょゆうけん]を[受/う]け[取/と]り、copy [後/ご]に[解放/かいほう]します。
//: - writer の[内部/ないぶ] capacity を[超/こ]える入力でも、1 byte [単位/たんい]で必要に応じて flush するため overflow しません。
fn append_bytebuf_impl <(StreamWriter,ByteBuf)*>StreamWriter> (w, bytes):
    let n <i32> get bytes "len";
    let mut ww <StreamWriter> w;
    let mut i <i32> 0;
    let mut done <i32> 0;
    while and eq done 0 lt i n:
        do:
            match stream_writer_bytebuf_byte_at &bytes i:
                Option::Some ch:
                    set ww push_u8_impl ww ch;
                    set i add i 1;
                Option::None:
                    set done 1;
    io_bytebuf_free bytes;
    ww

//: ## append_i32_digits_impl
//: 正の `i32` を 10 [進/しん] digit として[追記/ついき]する
//:
//: ### [実装/じっそう]
//: - 上位 digit を再帰で先に出し、各 digit は `push_u8_impl` に通します。
//: - 直接 length field を進めず `push_u8_impl` に通すため、checked store 失敗時も writer の長さだけが先に進むことを避けます。
fn append_i32_digits_impl <(StreamWriter,i32)*>StreamWriter> (w, x):
    if:
        ge x 10
        then:
            let w1 <StreamWriter> append_i32_digits_impl w div_s x 10;
            let digit <i32> mod_s x 10;
            push_u8_impl w1 add '0' digit
        else:
            push_u8_impl w add '0' x

//: ## append_u32_digits_impl
//: `u32` 表現の `i32` を符号なし 10 [進/しん] digit として[追記/ついき]する
fn append_u32_digits_impl <(StreamWriter,i32)*>StreamWriter> (w, x):
    if:
        ge_u x 10
        then:
            let w1 <StreamWriter> append_u32_digits_impl w div_u x 10;
            let digit <i32> rem_u x 10;
            push_u8_impl w1 add '0' digit
        else:
            push_u8_impl w add '0' x

//: ## append_u64_digits_impl
//: `u64` 表現の `i64` を符号なし 10 [進/しん] digit として[追記/ついき]する
fn append_u64_digits_impl <(StreamWriter,i64)*>StreamWriter> (w, x):
    let ten <i64> cast 10;
    if:
        ge_u x ten
        then:
            let w1 <StreamWriter> append_u64_digits_impl w div_u x ten;
            let rem <i32> cast rem_u x ten;
            push_u8_impl w1 add '0' rem
        else:
            let digit <i32> cast x;
            push_u8_impl w add '0' digit

//: ## append_i32_impl
//: `i32` を 10 [進/しん]で buffered sink へ[追記/ついき]する
//:
//: ### [実装/じっそう]
//: - `INT_MIN` は[絶対値/ぜったいち]が overflow するため[定数/ていすう][文字列/もじれつ]で[処理/しょり]します。
//: - それ[以外/いがい]は digit helper で上位桁から `push_u8_impl` へ通します。
fn append_i32_impl <(StreamWriter,i32)*>StreamWriter> (w, v):
    if:
        eq v -2147483648
        then:
            append_str_impl w "-2147483648"
        else:
            if:
                eq v 0
                then:
                    push_u8_impl w 48
                else:
                    let mut ww <StreamWriter> w;
                    let mut x <i32> v;

                    if:
                        lt x 0
                        then:
                            set ww push_u8_impl ww 45;
                            set x sub 0 x;
                            ()
                        else:
                            ();
                    append_i32_digits_impl ww x

//: ## append_u32_impl
//: `u32` を 10 [進/しん]で buffered sink へ[追記/ついき]する
fn append_u32_impl <(StreamWriter,u32)*>StreamWriter> (w, v):
    let vi <i32> cast v;
    let zero <i32> 0;
    if:
        eq vi zero
        then:
            push_u8_impl w 48
        else:
            append_u32_digits_impl w vi

//: ## append_u64_impl
//: `u64` を 10 [進/しん]で[追記/ついき]する
fn append_u64_impl <(StreamWriter,u64)*>StreamWriter> (w, v):
    let vi <i64> cast v;
    let zero <i64> cast 0;
    if:
        eq vi zero
        then:
            push_u8_impl w 48
        else:
            append_u64_digits_impl w vi

//: ## append_i64_impl
//: `i64` を[符号付/ふごうつ]き 10 [進/しん]で[追記/ついき]する
fn append_i64_impl <(StreamWriter,i64)*>StreamWriter> (w, v):
    let zero <i64> cast 0;
    if:
        lt v zero
        then:
            let w1 <StreamWriter> push_u8_impl w 45;
            let abs_i <i64> sub zero v;
            let abs_u <u64> cast abs_i;
            append_u64_impl w1 abs_u
        else:
            let as_u <u64> cast v;
            append_u64_impl w as_u

//: ## append_f64_fixed_impl
//: `f64` を[固定/こてい][小数点/しょうすうてん]で[追記/ついき]する
//:
//: ### [注意/ちゅうい]
//: - `NaN` / `inf` は[未対応/みたいおう]です。
fn append_f64_fixed_impl <(StreamWriter,f64,i32)*>StreamWriter> (w, v, precision):
    let mut x <f64> v;
    let zero <f64> cast 0;
    let is_neg <bool> lt x zero;
    let mut ww <StreamWriter> w;
    if:
        is_neg
        then:
            set ww push_u8_impl ww 45;
            let nx <f64> neg x;
            set x nx;
            ()
        else:
            ();

    let int_part <i64> cast x;
    let int_u <u64> cast int_part;
    set ww append_u64_impl ww int_u;

    if:
        le precision 0
        then:
            ww
        else:
            set ww push_u8_impl ww 46;
            let int_as_f64 <f64> cast int_part;
            let mut frac <f64> sub x int_as_f64;
            let ten <f64> cast 10;
            let mut i <i32> 0;
            while lt i precision:
                do:
                    let frac10 <f64> mul frac ten;
                    set frac frac10;
                    let digit <i32> cast frac;
                    set ww push_u8_impl ww add '0' digit;
                    let digit_f <f64> cast digit;
                    let next_frac <f64> sub frac digit_f;
                    set frac next_frac;
                    set i add i 1;
            ww

//: ## append_f64_impl
//: `f64` を[小数点以下/しょうすうてんいか] 6 [桁/けた]で[追記/ついき]する
fn append_f64_impl <(StreamWriter,f64)*>StreamWriter> (w, v):
    append_f64_fixed_impl w v 6

//: ## append_f32_fixed_impl
//: `f32` を[固定/こてい][小数点/しょうすうてん]で[追記/ついき]する
fn append_f32_fixed_impl <(StreamWriter,f32,i32)*>StreamWriter> (w, v, precision):
    let v64 <f64> cast v;
    append_f64_fixed_impl w v64 precision

//: ## append_f32_impl
//: `f32` を[小数点以下/しょうすうてんいか] 6 [桁/けた]で[追記/ついき]する
fn append_f32_impl <(StreamWriter,f32)*>StreamWriter> (w, v):
    append_f32_fixed_impl w v 6

//: ## StreamWritable
//: `StreamWriter` へ[追記/ついき]できる[値/あたい]の[能力/のうりょく]
trait StreamWritable:
    fn append <(StreamWriter,Self)*>StreamWriter> (w, value):
        w

impl StreamWritable for str:
    fn append <(StreamWriter,str)*>StreamWriter> (w, value):
        append_str_impl w value

impl StreamWritable for ByteBuf:
    fn append <(StreamWriter,ByteBuf)*>StreamWriter> (w, value):
        append_bytebuf_impl w value

impl StreamWritable for i32:
    fn append <(StreamWriter,i32)*>StreamWriter> (w, value):
        append_i32_impl w value

impl StreamWritable for i64:
    fn append <(StreamWriter,i64)*>StreamWriter> (w, value):
        append_i64_impl w value

impl StreamWritable for u32:
    fn append <(StreamWriter,u32)*>StreamWriter> (w, value):
        append_u32_impl w value

impl StreamWritable for u64:
    fn append <(StreamWriter,u64)*>StreamWriter> (w, value):
        append_u64_impl w value

impl StreamWritable for f64:
    fn append <(StreamWriter,f64)*>StreamWriter> (w, value):
        append_f64_impl w value

impl StreamWritable for f32:
    fn append <(StreamWriter,f32)*>StreamWriter> (w, value):
        append_f32_impl w value

//: ## write
//: `StreamWriter` へ text を[追記/ついき]する[共通名/きょうつうめい] overload
//:
//: ### [目的/もくてき]
//: - `StreamWriter` の text / [数値/すうち][出力/しゅつりょく]を trait dispatch で 1 [個/こ]の `write` へ[集約/しゅうやく]し、公開面に型 suffix を[残/のこ]しません。
fn write <.T: StreamWritable> <(StreamWriter,.T)*>StreamWriter> (w, value):
    StreamWritable::append w value

//: ## write
//: pipe [終端/しゅうたん]から `StreamWriter` へ[追記/ついき]する overload
fn write <.T: StreamWritable> <(.T,StreamWriter)*>StreamWriter> (value, w):
    StreamWritable::append w value

//: ## writeln
//: `StreamWriter` へ[追記/ついき]して[改行/かいぎょう]する
fn writeln <.T: StreamWritable> <(StreamWriter,.T)*>StreamWriter> (w, value):
    let w1 <StreamWriter> StreamWritable::append w value;
    push_newline_impl w1

//: ## writeln
//: pipe [終端/しゅうたん]から `StreamWriter` へ[追記/ついき]して[改行/かいぎょう]する overload
fn writeln <.T: StreamWritable> <(.T,StreamWriter)*>StreamWriter> (value, w):
    let w1 <StreamWriter> StreamWritable::append w value;
    push_newline_impl w1

//: ## flush
//: `StreamWriter` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する[共通名/きょうつうめい] overload
fn flush <(StreamWriter)*>StreamWriter> (w):
    drain_impl w
