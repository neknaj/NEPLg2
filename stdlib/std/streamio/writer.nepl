//: # streamio/writer
//: `std/streamio` の buffered writer と write target API を提供する submodule
//:
//: ### [目的/もくてき]
//: - `StreamWriter` の owning buffer/state、append/format、public write/close API を責務別 module に分けます。
//: - root は `WriteStream` から writer を開く入口、`StreamWritable` trait dispatch、owner-consuming close facade を担当します。
//:
//: ### [構成/こうせい]
//: - `std/streamio/writer/state` は `StreamWriter`、target enum、flush/buffer state を所有します。
//: - `std/streamio/writer/append` は `str` / `ByteBuf` / 数値の append と format helper を所有します。
//:
//: ### [注意/ちゅうい]
//: - `StreamWriter` は buffer owner を持つため `Copy` / `Clone` を実装しません。
//: - target は `StreamWriterTargetKind` enum と `match` で扱い、数値 code に戻さないでください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/writer" as *
//: fn main %impure fn () i32 \():
//:     let w %StreamWriter unwrap_ok open WriteStream::Stdio;
//:     close write w "x";
//:     0
//: ```

#indent 4

#import "alloc/io" as *
#import "core/result" as *
#import "std/iotarget" as *
#import "std/streamio/writer/append" as *
#import "std/streamio/writer/state" as *

//: ## open
//: write target へ[書/か]く buffered sink を[作/つく]る
//:
//: ### [目的/もくてき]
//: - stdout などの write target を[指定/してい]して、buffered sink を[生成/せいせい]します。
//: - `WriteStream` だけを[受/う]け[付/つ]けることで、`open ReadStream::Stdio` のような[誤用/ごよう]を compile error にします。
//:
//: ### [実装/じっそう]
//: - `WriteStream::Stdio` と `WriteStream::Stderr` を[受/う]け[付/つ]け、writer field に target enum を[記録/きろく]します。
//:
//: ### [注意/ちゅうい]
//: - [未対応/みたいおう] target は `Result::Err` を[返/かえ]します。
pub fn open %impure fn WriteStream Result StreamWriter str \target:
    match target:
        WriteStream::Stdio:
            match stream_writer_new StreamWriterTargetKind::Stdout:
                Result::Ok w:
                    Result<StreamWriter,str>::Ok w
                Result::Err e:
                    Result<StreamWriter,str>::Err e
        WriteStream::Stderr:
            match stream_writer_new StreamWriterTargetKind::Stderr:
                Result::Ok w:
                    Result<StreamWriter,str>::Ok w
                Result::Err e:
                    Result<StreamWriter,str>::Err e
        WriteStream::Fs:
            Result<StreamWriter,str>::Err "streamio.open invalid target"

//: ## StreamWritable
//: `StreamWriter` へ[追記/ついき]できる[値/あたい]の[能力/のうりょく]
trait StreamWritable:
    fn append %impure fn StreamWriter impure fn Self StreamWriter \w\value:
        w

impl StreamWritable for str:
    fn append %impure fn StreamWriter impure fn str StreamWriter \w\value:
        append_str_impl w value

impl StreamWritable for ByteBuf:
    fn append %impure fn StreamWriter impure fn ByteBuf StreamWriter \w\value:
        append_bytebuf_impl w value

impl StreamWritable for i32:
    fn append %impure fn StreamWriter impure fn i32 StreamWriter \w\value:
        append_i32_impl w value

impl StreamWritable for i64:
    fn append %impure fn StreamWriter impure fn i64 StreamWriter \w\value:
        append_i64_impl w value

impl StreamWritable for u32:
    fn append %impure fn StreamWriter impure fn u32 StreamWriter \w\value:
        append_u32_impl w value

impl StreamWritable for u64:
    fn append %impure fn StreamWriter impure fn u64 StreamWriter \w\value:
        append_u64_impl w value

impl StreamWritable for f64:
    fn append %impure fn StreamWriter impure fn f64 StreamWriter \w\value:
        append_f64_impl w value

impl StreamWritable for f32:
    fn append %impure fn StreamWriter impure fn f32 StreamWriter \w\value:
        append_f32_impl w value

//: ## write
//: `StreamWriter` へ text を[追記/ついき]する[共通名/きょうつうめい] overload
//:
//: ### [目的/もくてき]
//: - `StreamWriter` の text / [数値/すうち][出力/しゅつりょく]を trait dispatch で 1 [個/こ]の `write` へ[集約/しゅうやく]し、公開面に型 suffix を[残/のこ]しません。
pub fn write <.T: StreamWritable> %impure fn StreamWriter impure fn .T StreamWriter \w\value:
    StreamWritable::append w value

//: ## write
//: pipe [終端/しゅうたん]から `StreamWriter` へ[追記/ついき]する overload
pub fn write <.T: StreamWritable> %impure fn .T impure fn StreamWriter StreamWriter \value\w:
    StreamWritable::append w value

//: ## writeln
//: `StreamWriter` へ[追記/ついき]して[改行/かいぎょう]する
pub fn writeln <.T: StreamWritable> %impure fn StreamWriter impure fn .T StreamWriter \w\value:
    let w1 %StreamWriter StreamWritable::append w value;
    push_newline_impl w1

//: ## writeln
//: pipe [終端/しゅうたん]から `StreamWriter` へ[追記/ついき]して[改行/かいぎょう]する overload
pub fn writeln <.T: StreamWritable> %impure fn .T impure fn StreamWriter StreamWriter \value\w:
    let w1 %StreamWriter StreamWritable::append w value;
    push_newline_impl w1

//: ## flush
//: `StreamWriter` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する[共通名/きょうつうめい] overload
pub fn flush %impure fn StreamWriter StreamWriter \w:
    drain_impl w

//: ## close
//: `StreamWriter` を[閉/と]じて buffered sink の[確保領域/かくほりょういき]を[解放/かいほう]する[共通名/きょうつうめい] overload
//:
//: ### [注意/ちゅうい]
//: - `close` は owner を[消費/しょうひ]します。未 flush の[内容/ないよう]は[捨/す]てられるため、[必要/ひつよう]なら[先/さき]に `flush` を[呼/よ]んでください。
pub fn close %impure fn StreamWriter () \w:
    stream_writer_close_impl w
