//: # streamio/output/stderr
//: stderr output stream adapter
//:
//: ### [目的/もくてき]
//: - `StderrStream` の write / flush / close trait 実装と convenience overload を所有します。
//: - stdout と分け、diagnostic / progress log の出力 policy を確認しやすくします。

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io" as *
#import "core/result" as *
#import "std/stdio" as *
#import "std/streamio/output/types" as *

//: ## write_bytes_result
//: `StderrStream` へ byte [列/れつ]を[書/か]き、失敗を `Result` で[返/かえ]す
pub fn write_bytes_result %impure fn StderrStream impure fn ByteBuf Result StderrStream StdErrorKind \stream\bytes:
    match stdio_write_stderr_bytes_result bytes:
        Result::Ok _:
            Result<StderrStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## write_str_result
//: `StderrStream` へ text を[書/か]き、失敗を `Result` で[返/かえ]す
pub fn write_str_result %impure fn StderrStream impure fn str Result StderrStream StdErrorKind \stream\text:
    match stdio_write_stderr_str_result text:
        Result::Ok _:
            Result<StderrStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## flush_result
//: `StderrStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
pub fn flush_result %impure fn StderrStream Result StderrStream StdErrorKind \stream:
    Result::Ok stream

impl ByteWriter for StderrStream:
    fn write_bytes %impure fn StderrStream impure fn ByteBuf Result StderrStream StdErrorKind \stream\bytes:
        write_bytes_result stream bytes

impl TextWriter for StderrStream:
    fn write_str %impure fn StderrStream impure fn str Result StderrStream StdErrorKind \stream\text:
        write_str_result stream text

impl Flush for StderrStream:
    fn flush %impure fn StderrStream Result StderrStream StdErrorKind \stream:
        flush_result stream

impl Close for StderrStream:
    fn close %impure fn StderrStream Result () StdErrorKind \_stream:
        Result::Ok ()

//: ## StderrWritable
//: `StderrStream` へ[書/か]き[込/こ]める[値/あたい]の[能力/のうりょく]
trait StderrWritable:
    fn emit %impure fn StderrStream impure fn Self Result StderrStream StdErrorKind \stream\value:
        Result::Err StdErrorKind::InvalidOperation

impl StderrWritable for ByteBuf:
    fn emit %impure fn StderrStream impure fn ByteBuf Result StderrStream StdErrorKind \stream\value:
        io_write_bytes stream value

impl StderrWritable for str:
    fn emit %impure fn StderrStream impure fn str Result StderrStream StdErrorKind \stream\value:
        io_write_str stream value

//: ## write
//: `StderrStream` へ byte [列/れつ]や text を[書/か]く
pub fn write <.T: StderrWritable> %impure fn StderrStream impure fn .T Result StderrStream StdErrorKind \stream\value:
    StderrWritable::emit stream value

//: ## write
//: pipe [終端/しゅうたん]から `StderrStream` へ byte [列/れつ]や text を[書/か]く overload
pub fn write <.T: StderrWritable> %impure fn .T impure fn StderrStream Result StderrStream StdErrorKind \value\stream:
    StderrWritable::emit stream value

//: ## writeln
//: `StderrStream` へ text と `\n` を[続/つづ]けて[書/か]く
pub fn writeln %impure fn StderrStream impure fn str Result StderrStream StdErrorKind \stream\text:
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## writeln
//: pipe [終端/しゅうたん]から `StderrStream` へ text と `\n` を[続/つづ]けて[書/か]く overload
pub fn writeln %impure fn str impure fn StderrStream Result StderrStream StdErrorKind \text\stream:
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StderrStream, StdErrorKind>::Err e

//: ## flush
//: `StderrStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
pub fn flush %impure fn StderrStream Result StderrStream StdErrorKind \stream:
    io_flush stream

//: ## close
//: `StderrStream` を[閉/と]じる
pub fn close %impure fn StderrStream Result () StdErrorKind \stream:
    io_close stream
