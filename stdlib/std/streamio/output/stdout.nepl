//: # streamio/output/stdout
//: stdout output stream adapter
//:
//: ### [目的/もくてき]
//: - `StdoutStream` の write / flush / close trait 実装と convenience overload を所有します。
//: - stderr と分け、stdout artifact への出力 policy を確認しやすくします。

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io" as *
#import "core/result" as *
#import "std/stdio" as *
#import "std/streamio/output/types" as *

//: ## write_bytes_result
//: `StdoutStream` へ byte [列/れつ]を[書/か]き、失敗を `Result` で[返/かえ]す
pub fn write_bytes_result %impure fn StdoutStream impure fn ByteBuf Result StdoutStream StdErrorKind \stream\bytes:
    match stdio_write_bytes_result bytes:
        Result::Ok _:
            Result<StdoutStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## write_str_result
//: `StdoutStream` へ text を[書/か]き、失敗を `Result` で[返/かえ]す
pub fn write_str_result %impure fn StdoutStream impure fn str Result StdoutStream StdErrorKind \stream\text:
    match stdio_write_str_result text:
        Result::Ok _:
            Result<StdoutStream, StdErrorKind>::Ok stream
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## flush_result
//: `StdoutStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
pub fn flush_result %impure fn StdoutStream Result StdoutStream StdErrorKind \stream:
    Result::Ok stream

impl ByteWriter for StdoutStream:
    fn write_bytes %impure fn StdoutStream impure fn ByteBuf Result StdoutStream StdErrorKind \stream\bytes:
        write_bytes_result stream bytes

impl TextWriter for StdoutStream:
    fn write_str %impure fn StdoutStream impure fn str Result StdoutStream StdErrorKind \stream\text:
        write_str_result stream text

impl Flush for StdoutStream:
    fn flush %impure fn StdoutStream Result StdoutStream StdErrorKind \stream:
        flush_result stream

impl Close for StdoutStream:
    fn close %impure fn StdoutStream Result unit StdErrorKind \_stream:
        Result::Ok unit

//: ## StdoutWritable
//: `StdoutStream` へ[書/か]き[込/こ]める[値/あたい]の[能力/のうりょく]
trait StdoutWritable:
    fn emit %impure fn StdoutStream impure fn Self Result StdoutStream StdErrorKind \stream\value:
        Result::Err StdErrorKind::InvalidOperation

impl StdoutWritable for ByteBuf:
    fn emit %impure fn StdoutStream impure fn ByteBuf Result StdoutStream StdErrorKind \stream\value:
        io_write_bytes stream value

impl StdoutWritable for str:
    fn emit %impure fn StdoutStream impure fn str Result StdoutStream StdErrorKind \stream\value:
        io_write_str stream value

//: ## write
//: `StdoutStream` へ byte [列/れつ]や text を[書/か]く
pub fn write <.T: StdoutWritable> %impure fn StdoutStream impure fn .T Result StdoutStream StdErrorKind \stream\value:
    StdoutWritable::emit stream value

//: ## write
//: pipe [終端/しゅうたん]から `StdoutStream` へ byte [列/れつ]や text を[書/か]く overload
pub fn write <.T: StdoutWritable> %impure fn .T impure fn StdoutStream Result StdoutStream StdErrorKind \value\stream:
    StdoutWritable::emit stream value

//: ## writeln
//: `StdoutStream` へ text と `\n` を[続/つづ]けて[書/か]く
pub fn writeln %impure fn StdoutStream impure fn str Result StdoutStream StdErrorKind \stream\text:
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## writeln
//: pipe [終端/しゅうたん]から `StdoutStream` へ text と `\n` を[続/つづ]けて[書/か]く overload
pub fn writeln %impure fn str impure fn StdoutStream Result StdoutStream StdErrorKind \text\stream:
    match io_write_str stream text:
        Result::Ok stream1:
            io_write_str stream1 "\n"
        Result::Err e:
            Result<StdoutStream, StdErrorKind>::Err e

//: ## flush
//: `StdoutStream` の[保留中/ほりゅうちゅう][出力/しゅつりょく]を[反映/はんえい]する
pub fn flush %impure fn StdoutStream Result StdoutStream StdErrorKind \stream:
    io_flush stream

//: ## close
//: `StdoutStream` を[閉/と]じる
pub fn close %impure fn StdoutStream Result unit StdErrorKind \stream:
    io_close stream
