//: # streamio/writer/append/text
//: `StreamWriter` へ `str` を byte 列として追記する helper
//:
//: ### [目的/もくてき]
//: - writer state の flush/buffer 管理から、文字列 byte 走査の責務を分離します。
//: - 文字列の内部表現へ raw pointer で入らず、`alloc/string` の byte access helper を通します。

#indent 4

#import "alloc/io/bytebuilder" as *
#import "alloc/string" as *
#import "alloc/string/byte_index" as *
#import "core/field" as *
#import "core/result" as *
#import "std/streamio/writer/state" as *
#import "core/math" as *
#import "core/option" as *

//: ## append_str_result
//: `str` を buffered sink へ[追記/ついき]する
//:
//: ### [注意/ちゅうい]
//: - `str` の raw byte 範囲は `ByteBuilder` 側の checked bulk append に委譲します。
//: - 失敗時は writer owner を `StreamWriterError` に戻し、呼び出し側が cleanup や retry を選べるようにします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let next %StreamWriter unwrap_ok append_str_result w "abc";
//:| close next;
//: ```
pub fn append_str_result %impure fn StreamWriter impure fn str Result StreamWriter StreamWriterError \w\s:
    let target %StreamWriterTargetKind *get_ref &w "target";
    let builder %ByteBuilder get w "builder";
    match byte_builder_push_str builder s:
        Result::Ok next_builder:
            Result::Ok StreamWriter next_builder target @stream_writer_noncopy_marker
        Result::Err e:
            let returned %ByteBuilder byte_builder_error_builder e
            let failed %StreamWriter StreamWriter returned target @stream_writer_noncopy_marker
            Result::Err stream_writer_error_with_writer failed StreamWriterErrorKind::AppendFailed

//: ## append_str_impl
//: `append_str_result` の互換 facade
pub fn append_str_impl %impure fn StreamWriter impure fn str StreamWriter \w\s:
    match append_str_result w s:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e
