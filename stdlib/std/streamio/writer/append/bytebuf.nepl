//: # streamio/writer/append/bytebuf
//: `StreamWriter` へ `ByteBuf` を byte 列として追記する helper
//:
//: ### [目的/もくてき]
//: - binary payload を `str` へ変換せず、borrowed byte access helper 経由で writer buffer へ積みます。
//: - `ByteBuf` の owner 消費と append loop をこの module に閉じ込めます。

#indent 4

#import "alloc/io" as *
#import "core/option" as *
#import "std/streamio/writer/state" as *
#import "core/field" as *
#import "core/math" as *

//: ## stream_writer_bytebuf_byte_at
//: borrowed ByteBuf から 1 byte を読む
//:
//: ### [目的/もくてき]
//: - `append_bytebuf_impl` が `ByteBuf` owner を消費前に保持したまま、範囲内 byte だけを読めるようにします。
//: - `ByteBuf` の field を `get_ref` で読むため、append loop 中に buffer owner を移動しません。
pub fn stream_writer_bytebuf_byte_at <(&ByteBuf,i32)->Option<i32>> (bytes, idx):
    io_bytebuf_byte_at bytes idx

//: ## append_bytebuf_impl
//: `ByteBuf` を buffered sink へ[追記/ついき]する
//:
//: ### [目的/もくてき]
//: - binary payload を `str` へ[変換/へんかん]せず、`StreamWriter` の byte buffer へそのまま[積/つ]みます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuf` の[所有権/しょゆうけん]を[受/う]け[取/と]り、copy [後/ご]に[解放/かいほう]します。
//: - writer の[内部/ないぶ] capacity を[超/こ]える入力でも、1 byte [単位/たんい]で必要に応じて flush するため overflow しません。
pub fn append_bytebuf_impl <(StreamWriter,ByteBuf)*>StreamWriter> (w, bytes):
    let n <i32> get bytes "len";
    let mut ww <StreamWriter> w;
    let mut i <i32> 0;
    let mut done <i32> 0;
    while and eq done 0 lt i n:
        do:
            match stream_writer_bytebuf_byte_at &bytes i:
                Option::Some ch:
                    set ww push_u8_impl ww ch;
                    set i add i 1;
                Option::None:
                    set done 1;
    io_bytebuf_free bytes;
    ww
