//: # streamio/writer/append/bytebuf
//: `StreamWriter` へ `ByteBuf` を byte 列として追記する helper
//:
//: ### [目的/もくてき]
//: - binary payload を `str` へ変換せず、borrowed byte access helper 経由で writer buffer へ積みます。
//: - `ByteBuf` の owner 消費と append loop をこの module に閉じ込めます。

#indent 4

#import "alloc/io" as *
#import "alloc/io/bytebuilder" as *
#import "core/option" as *
#import "core/result" as *
#import "std/streamio/writer/state" as *
#import "core/field" as *
#import "core/math" as *

//: ## stream_writer_bytebuf_byte_at
//: borrowed ByteBuf から 1 byte を読む
//:
//: ### [目的/もくてき]
//: - `append_bytebuf_impl` が `ByteBuf` owner を消費前に保持したまま、範囲内 byte だけを読めるようにします。
//: - `ByteBuf` の field を `get_ref` で読むため、append loop 中に buffer owner を移動しません。
pub fn stream_writer_bytebuf_byte_at %fn &ByteBuf fn i32 Option i32 \bytes\idx:
    io_bytebuf_byte_at bytes idx

//: ## append_bytebuf_result
//: `ByteBuf` を buffered sink へ[追記/ついき]する
//:
//: ### [目的/もくてき]
//: - binary payload を `str` へ[変換/へんかん]せず、`StreamWriter` の byte buffer へそのまま[積/つ]みます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuf` の[所有権/しょゆうけん]を[受/う]け[取/と]り、copy [後/ご]に[解放/かいほう]します。
//: - 失敗時は input `ByteBuf` を閉じ、writer owner は `StreamWriterError` に戻します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/io" as *
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let bytes %ByteBuf unwrap_ok io_bytebuf_from_str_result "abc";
//:| let next %StreamWriter unwrap_ok append_bytebuf_result w bytes;
//:| close next;
//: ```
pub fn append_bytebuf_result %impure fn StreamWriter impure fn ByteBuf Result StreamWriter StreamWriterError \w\bytes:
    let target %StreamWriterTargetKind *get_ref &w "target";
    let builder %ByteBuilder get w "builder";
    match byte_builder_push_bytebuf builder bytes:
        Result::Ok next_builder:
            Result::Ok StreamWriter next_builder target @stream_writer_noncopy_marker
        Result::Err e:
            let returned %ByteBuilder get e "builder";
            let returned_bytes %ByteBuf get e "bytes";
            io_bytebuf_free returned_bytes
            let failed %StreamWriter StreamWriter returned target @stream_writer_noncopy_marker
            Result::Err stream_writer_error_with_writer failed StreamWriterErrorKind::AppendFailed

//: ## append_bytebuf_impl
//: `append_bytebuf_result` の互換 facade
pub fn append_bytebuf_impl %impure fn StreamWriter impure fn ByteBuf StreamWriter \w\bytes:
    match append_bytebuf_result w bytes:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e
