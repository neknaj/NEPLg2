//: # streamio/writer/state
//: `StreamWriter` の owning state と flush boundary
//:
//: ### [目的/もくてき]
//: - writer の buffer owner を `ByteBuilder` に集約し、pending length、target enum を構造体 field として静的検査に見える形で管理します。
//: - stdout/stderr の選択は `StreamWriterTargetKind` enum と `match` に閉じ、数値 code に戻しません。

#indent 4

#import "alloc/io/bytebuilder" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/stdio" as *
#import "core/field" as *

//: ## StreamWriter
//: write target へ[追記/ついき]していく buffered sink
//:
//: ### [目的/もくてき]
//: - `kpwrite` などの buffered write [中核/ちゅうかく]を `std` へ[昇格/しょうかく]し、競技向け helper 以外でも[再利用/さいりよう]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]で[確保/かくほ]した[書/か]き[込/こ]み buffer を[所有/しょゆう]するため `Copy` / `Clone` は[実装/じっそう]しません。
//: - [使/つか]い[終/お]わったら `close` で[解放/かいほう]してください。`flush` は[出力/しゅつりょく]のみを[行/おこな]い、[所有権/しょゆうけん]は[維持/いじ]します。
//: - target kind は stdout/stderr を[保持/ほじ]し、flush [時/じ]に[対応/たいおう]する fd へ[流/なが]します。
//: - [各/かく] writer は[独立/どくりつ]した buffer を[持/も]つため、[複数/ふくすう]の reader / writer を[同時/どうじ]に[保持/ほじ]できます。
pub struct StreamWriter:
    builder %ByteBuilder
    target %StreamWriterTargetKind
    marker %fn i32 i32

pub enum StreamWriterTargetKind:
    Stdout
    Stderr

//: ## StreamWriterErrorKind
//: writer operation の失敗理由を静的検査できる enum として表す
//:
//: ### [契約/けいやく]
//: - 表示文字列ではなく error kind を data として保持し、表示は `stream_writer_error_name` 側に分離します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let kind %StreamWriterErrorKind StreamWriterErrorKind::UnsupportedTarget;
//: ```
pub enum StreamWriterErrorKind:
    UnsupportedTarget
    BufferAllocFailed
    WriteFailed
    AppendFailed
    InvalidInput

impl Clone for StreamWriterTargetKind:
    fn clone %fn &StreamWriterTargetKind StreamWriterTargetKind \target:
        *target

impl Copy for StreamWriterTargetKind:
    fn copy_mark %fn StreamWriterTargetKind StreamWriterTargetKind \target:
        target

impl Clone for StreamWriterErrorKind:
    fn clone %fn &StreamWriterErrorKind StreamWriterErrorKind \kind:
        *kind

impl Copy for StreamWriterErrorKind:
    fn copy_mark %fn StreamWriterErrorKind StreamWriterErrorKind \kind:
        kind

//: ## StreamWriterError
//: writer failure と recovery 用 writer owner をまとめる error data
//:
//: ### [契約/けいやく]
//: - writer owner が recover 可能な失敗では `Option::Some writer` を保持します。
//: - owner が存在しない失敗では `Option::None` を保持し、caller は kind だけを処理します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/option" as *
//:| #import "std/streamio/writer" as *
//:| let e %StreamWriterError stream_writer_error_without_writer StreamWriterErrorKind::UnsupportedTarget;
//: ```
pub struct StreamWriterError:
    kind %StreamWriterErrorKind
    writer %Option StreamWriter

pub fn stream_writer_noncopy_marker %fn i32 i32 \x:
    x

//: ## stream_writer_error_without_writer
//: owner を含まない writer error を作る
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let e %StreamWriterError stream_writer_error_without_writer StreamWriterErrorKind::UnsupportedTarget;
//: ```
pub fn stream_writer_error_without_writer %fn StreamWriterErrorKind StreamWriterError \kind:
    StreamWriterError kind Option::None

//: ## stream_writer_error_with_writer
//: retry / cleanup 可能な writer owner 付き error を作る
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/iotarget" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok open WriteStream::Stdio;
//:| let e %StreamWriterError stream_writer_error_with_writer w StreamWriterErrorKind::WriteFailed;
//:| stream_writer_error_free e;
//: ```
pub fn stream_writer_error_with_writer %fn StreamWriter fn StreamWriterErrorKind StreamWriterError \w\kind:
    StreamWriterError kind Option::Some w

//: ## stream_writer_error_kind
//: error data から分類 enum を取り出す
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let e %StreamWriterError stream_writer_error_without_writer StreamWriterErrorKind::UnsupportedTarget;
//:| let kind %StreamWriterErrorKind stream_writer_error_kind &e;
//: ```
pub fn stream_writer_error_kind %fn &StreamWriterError StreamWriterErrorKind \e:
    *get_ref e "kind"

//: ## stream_writer_error_recover_or_empty
//: error payload の writer owner を回収し、なければ空 writer を返す互換 helper
//:
//: ### [注意/ちゅうい]
//: - 新規 code は error kind を `match` し、必要なら owner の有無を明示的に扱うべきです。
//: - この helper は既存の sentinel 互換 API のために残します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let e %StreamWriterError stream_writer_error_without_writer StreamWriterErrorKind::UnsupportedTarget;
//:| let w %StreamWriter stream_writer_error_recover_or_empty e;
//:| close w;
//: ```
pub fn stream_writer_error_recover_or_empty %fn StreamWriterError StreamWriter \e:
    match get e "writer":
        Option::Some w:
            w
        Option::None:
            StreamWriter byte_builder_empty StreamWriterTargetKind::Stdout @stream_writer_noncopy_marker

//: ## stream_writer_error_name
//: error kind の安定した診断名を返す
//:
//: ### [契約/けいやく]
//: - error 自体は enum で保持し、この関数はログや doctest 用の表示名だけを担当します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let name %str stream_writer_error_name StreamWriterErrorKind::WriteFailed;
//: ```
pub fn stream_writer_error_name %fn StreamWriterErrorKind str \kind:
    match kind:
        StreamWriterErrorKind::UnsupportedTarget:
            "UnsupportedTarget"
        StreamWriterErrorKind::BufferAllocFailed:
            "BufferAllocFailed"
        StreamWriterErrorKind::WriteFailed:
            "WriteFailed"
        StreamWriterErrorKind::AppendFailed:
            "AppendFailed"
        StreamWriterErrorKind::InvalidInput:
            "InvalidInput"

//: ## stream_writer_new
//: StreamWriter の buffer を確保して owning handle を作る
//:
//: ### [目的/もくてき]
//: - `StreamWriter` は非 Copy の owning struct として `ByteBuilder` と target enum を保持します。
//: - raw pointer owner は writer state へ直接持たず、byte storage の所有権境界を `ByteBuilder` に集約します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| close w;
//: ```
pub fn stream_writer_new %impure fn StreamWriterTargetKind Result StreamWriter StreamWriterError \target:
    match byte_builder_with_capacity 4096:
        Result::Ok builder:
            Result::Ok StreamWriter builder target @stream_writer_noncopy_marker
        Result::Err _e:
            Result::Err stream_writer_error_without_writer StreamWriterErrorKind::BufferAllocFailed

//: ## stream_writer_close_impl
//: buffered sink の[確保領域/かくほりょういき]を[解放/かいほう]する cleanup helper
//:
//: ### [注意/ちゅうい]
//: - 公開 API 名 `close` は `std/streamio/writer` root が所有します。この helper は state layout を知る実装境界です。
//: - 未 flush の[内容/ないよう]は[捨/す]てられます。[必要/ひつよう]なら[先/さき]に root の `flush` を[呼/よ]んでください。
pub fn stream_writer_close_impl %impure fn StreamWriter unit \w:
    let builder %ByteBuilder get w "builder";
    byte_builder_free builder
    unit

//: ## stream_writer_error_free
//: error payload に残った writer owner を破棄する
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/streamio/writer" as *
//:| let e %StreamWriterError stream_writer_error_without_writer StreamWriterErrorKind::UnsupportedTarget;
//:| stream_writer_error_free e;
//: ```
pub fn stream_writer_error_free %impure fn StreamWriterError unit \e:
    match get e "writer":
        Option::Some w:
            stream_writer_close_impl w
        Option::None:
            unit

//: ## drain_result
//: buffered sink の[内容/ないよう]を target fd へ[書/か]き[出/だ]す
//:
//: ### [実装/じっそう]
//: - `ByteBuilder` の現在の有効 byte 範囲を target kind に[応/おう]じて stdout/stderr へ[出力/しゅつりょく]し、builder の[長/なが]さだけを 0 に[戻/もど]します。
//: - write error の場合は buffer を消さず、`StreamWriterError` に writer owner を戻します。
//:
//: ### [計算量/けいさんりょう]
//: - [現在/げんざい]の[書/か]き[込/こ]み[長/なが]さを n として O(n) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let flushed %StreamWriter unwrap_ok drain_result w;
//:| close flushed;
//: ```
pub fn drain_result %impure fn StreamWriter Result StreamWriter StreamWriterError \w:
    let target %StreamWriterTargetKind *get_ref &w "target";
    let builder %ByteBuilder get w "builder";
    let write_len %i32 *get_ref &builder "len";
    if:
        le write_len 0
        then:
            Result::Ok StreamWriter builder target @stream_writer_noncopy_marker
        else:
            match target:
                StreamWriterTargetKind::Stdout:
                    match stdio_write_fd_bytebuilder_prefix_result 1 &builder write_len:
                        Result::Ok _:
                            Result::Ok StreamWriter byte_builder_with_len builder 0 target @stream_writer_noncopy_marker
                        Result::Err _:
                            let failed %StreamWriter StreamWriter builder target @stream_writer_noncopy_marker
                            Result::Err stream_writer_error_with_writer failed StreamWriterErrorKind::WriteFailed
                StreamWriterTargetKind::Stderr:
                    match stdio_write_fd_bytebuilder_prefix_result 2 &builder write_len:
                        Result::Ok _:
                            Result::Ok StreamWriter byte_builder_with_len builder 0 target @stream_writer_noncopy_marker
                        Result::Err _:
                            let failed %StreamWriter StreamWriter builder target @stream_writer_noncopy_marker
                            Result::Err stream_writer_error_with_writer failed StreamWriterErrorKind::WriteFailed

//: ## drain_impl
//: `drain_result` の互換 facade
pub fn drain_impl %impure fn StreamWriter StreamWriter \w:
    match drain_result w:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e

//: ## reserve_result
//: need byte [分/ぶん]の[空/あ]きを[確保/かくほ]する
//:
//: ### [注意/ちゅうい]
//: - need が capacity を[超/こ]える case は[呼/よ]び[出/だ]し[側/がわ]で[避/さ]けてください。この[版/ばん]では buffer [拡張/かくちょう]ではなく flush を[選/えら]びます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let reserved %StreamWriter unwrap_ok reserve_result w 1;
//:| close reserved;
//: ```
pub fn reserve_result %impure fn StreamWriter impure fn i32 Result StreamWriter StreamWriterError \w\need:
    let target %StreamWriterTargetKind *get_ref &w "target";
    let builder %ByteBuilder get w "builder";
    let cap %i32 *get_ref &builder "cap";
    let write_len %i32 *get_ref &builder "len";
    let required %i32 add write_len need;
    if:
        le required cap
        then:
            Result::Ok StreamWriter builder target @stream_writer_noncopy_marker
        else:
            drain_result StreamWriter builder target @stream_writer_noncopy_marker

//: ## reserve_impl
//: `reserve_result` の互換 facade
pub fn reserve_impl %impure fn StreamWriter impure fn i32 StreamWriter \w\need:
    match reserve_result w need:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e

//: ## push_u8_result
//: 1 byte [追記/ついき]する
//:
//: ### [計算量/けいさんりょう]
//: - [通常/つうじょう]は O(1) で、flush が[入/はい]ると O(len) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let next %StreamWriter unwrap_ok push_u8_result w 65;
//:| close next;
//: ```
pub fn push_u8_result %impure fn StreamWriter impure fn i32 Result StreamWriter StreamWriterError \w\b:
    match reserve_result w 1:
        Result::Err e:
            Result::Err e
        Result::Ok w1:
            let target %StreamWriterTargetKind *get_ref &w1 "target";
            let builder %ByteBuilder get w1 "builder";
            match byte_builder_push_u8 builder b:
                Result::Ok next_builder:
                    Result::Ok StreamWriter next_builder target @stream_writer_noncopy_marker
                Result::Err e:
                    let returned %ByteBuilder byte_builder_error_builder e
                    let failed %StreamWriter StreamWriter returned target @stream_writer_noncopy_marker
                    Result::Err stream_writer_error_with_writer failed StreamWriterErrorKind::AppendFailed

//: ## push_u8_impl
//: `push_u8_result` の互換 facade
pub fn push_u8_impl %impure fn StreamWriter impure fn i32 StreamWriter \w\b:
    match push_u8_result w b:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e

//: ## push_newline_impl
//: [改行/かいぎょう] `\n` を 1 byte [出力/しゅつりょく]する
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "core/result" as *
//:| #import "std/streamio/writer" as *
//:| let w %StreamWriter unwrap_ok stream_writer_new StreamWriterTargetKind::Stdout;
//:| let next %StreamWriter unwrap_ok push_newline_result w;
//:| close next;
//: ```
pub fn push_newline_result %impure fn StreamWriter Result StreamWriter StreamWriterError \w:
    push_u8_result w 10

pub fn push_newline_impl %impure fn StreamWriter StreamWriter \w:
    match push_newline_result w:
        Result::Ok next:
            next
        Result::Err e:
            stream_writer_error_recover_or_empty e
