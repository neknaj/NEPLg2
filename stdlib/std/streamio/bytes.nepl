//: # streamio/bytes
//: `std/streamio` の byte/text conversion helper を提供する submodule
//:
//: ### [目的/もくてき]
//: - `ByteBuf` と `str` の相互変換 helper を stream scanner や stdio bridge から独立した責務として提供します。
//: - `std/streamio` facade から同じ API を re-export します。
//:
//: ### [注意/ちゅうい]
//: - `stream_bytes_to_str_*` は入力 `ByteBuf` owner を消費します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io" as *
//:| #import "std/streamio/bytes" as *
//: fn main %fn unit i32 \unit:
//:     let bytes %ByteBuf stream_bytes_from_str "ab";
//:     let n %i32 io_bytebuf_len_ref &bytes;
//:     io_bytebuf_free bytes;
//:     n
//: ```

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io" as *
#import "core/result" as *
//: ## stream_bytes_from_str_result
//: `str` を byte [列/れつ]へ[変換/へんかん]する Result API
//:
//: ### [目的/もくてき]
//: - text helper と binary helper の[橋渡/はしわた]しとして、`str` を[連続/れんぞく] byte buffer へ[複製/ふくせい]します。
//: - buffer 確保失敗を `StdErrorKind::OutOfMemory` として呼び出し側へ返します。
pub fn stream_bytes_from_str_result %fn str Result ByteBuf StdErrorKind \text:
    io_bytebuf_from_str_result text

//: ## stream_bytes_from_str
//: `str` を byte [列/れつ]へ[変換/へんかん]する互換 facade
//:
//: ### [目的/もくてき]
//: - 既存の streamio helper として `ByteBuf` を直接返します。
//:
//: ### [注意/ちゅうい]
//: - 空入力と確保失敗を区別する場合は `stream_bytes_from_str_result` を使ってください。
pub fn stream_bytes_from_str %fn str ByteBuf \text:
    io_bytebuf_from_str text

//: ## stream_bytes_to_str_result
//: byte [列/れつ]を `str` として[包/つつ]み[直/なお]す Result API
//:
//: ### [目的/もくてき]
//: - binary stream の[内容/ないよう]を text helper へ[渡/わた]したい[場合/ばあい]の[最小/さいしょう][変換/へんかん]を[提供/ていきょう]します。
//: - 文字列領域の確保失敗を `StdErrorKind::OutOfMemory` として呼び出し側へ返します。
//:
//: ### [実装/じっそう]
//: - UTF-8 [検証/けんしょう]は[行/おこな]わず、byte [列/れつ]をそのまま `str` [表現/ひょうげん]へ[移/うつ]します。
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
pub fn stream_bytes_to_str_result %impure fn ByteBuf Result str StdErrorKind \bytes:
    io_bytebuf_to_str_result bytes

//: ## stream_bytes_to_str
//: byte [列/れつ]を `str` として[包/つつ]み[直/なお]す互換 facade
//:
//: ### [目的/もくてき]
//: - 既存の streamio helper として `str` を直接返します。
//:
//: ### [注意/ちゅうい]
//: - 空 buffer と確保失敗を区別する場合は `stream_bytes_to_str_result` を使ってください。
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
pub fn stream_bytes_to_str %impure fn ByteBuf str \bytes:
    io_bytebuf_to_str bytes
