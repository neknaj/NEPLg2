#indent 4

#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/string" as *
#if[target=std]
#import "std/stdio" as *

//: ## Checks
//: [複数/ふくすう]の[検査/けんさ][結果/けっか]を[逐次/ちくじ][集約/しゅうやく]する[値/あたい]
//:
//: ### [目的/もくてき]
//: - `checks_push` のたびに summary、失敗有無、人間向け一覧を更新し、最後に raw memory を走査しなくても結果を出せるようにします。
//: - 旧 `Vec<Result<(),str>>` 実装のように非 Copy payload を積んで後から `load<Result<(),str>>` する設計を避けます。
//:
//: ### [実装/じっそう]
//: - `summary` は末尾の `]` をまだ付けていない `[ok,err ...` 形式を保持します。
//: - `human` は `[0] ok\n` のような人間向け行を連結して保持します。
//:
//: ### [注意/ちゅうい]
//: - `str` は Copy な immutable value として扱われるため、この struct 自体も Copy です。
//: - 大量の検査では文字列連結により O(n^2) になりえます。これは test helper 用の単純さを優先した設計です。
struct Checks:
    count <i32>
    failed <bool>
    summary <str>
    human <str>

impl Clone for Checks:
    fn clone <(&Checks)->Checks> (checks):
        *checks

impl Copy for Checks:
    fn copy_mark <(Checks)->Checks> (checks):
        checks

//: ## checks_empty
//: [集約/しゅうやく][検査/けんさ]の[空/から] sentinel を[作/つく]る
//:
//: ### [目的/もくてき]
//: - allocation に依存せず、空の `Checks` を返します。
//:
//: ### [実装/じっそう]
//: - summary は `[`、human は空文字列から開始します。
fn checks_empty <()->Checks> ():
    Checks 0 false "[" ""

//: ## checks_single_error
//: [単一/たんいつ]の[失敗/しっぱい]だけを[持/も]つ[検査/けんさ][列/れつ]を[作/つく]る
//:
//: ### [目的/もくてき]
//: - 初期化に失敗した場合など、単一の `Err msg` だけを持つ `Checks` を返します。
fn checks_single_error <(str)*>Checks> (msg):
    checks_push checks_empty Result<(),str>::Err msg

//: # test
//: [標準/ひょうじゅん]ライブラリ[用/よう]の[簡易/かんい]テスト[支援/しえん]
//:
//: ### [目的/もくてき]
//: - stdlib と tutorials で共通に使う `assert_*` / `check_*` / `finish_checks` を提供し、[失敗/しっぱい]を trap ではなく `Result<(),str>` として[表現/ひょうげん]します。
//: - [単発/たんぱつ]の[検査/けんさ]と、[複数/ふくすう][検査/けんさ]を[継続/けいぞく][実行/じっこう]する collectable な[検査/けんさ]の[両方/りょうほう]を[同/おな]じモジュールで[扱/あつか]います。
//:
//: ### [実装/じっそう]
//: - [単発/たんぱつ]の `assert_*` は[対応/たいおう]する `check_*` の[結果/けっか]を[受/う]け、`Err` のときだけ `FAIL:` [形式/けいしき]の[表示/ひょうじ]を[行/おこな]ったうえで `Result::Err` を[返/かえ]します。
//: - [集約/しゅうやく][検査/けんさ]は `Checks` を[保持/ほじ]し、`finish_checks` は[表示/ひょうじ]せずに `Result<(),str>` へ[畳/たた]みます。
//: - [表示/ひょうじ]が[必要/ひつよう]な test case は `checks_print_machine` / `checks_print_human` を[明示的/めいじてき]に[呼/よ]びます。
//:
//: ### [注意/ちゅうい]
//: - [失敗/しっぱい]の[最終/さいしゅう][判定/はんてい]は `result_exit_code` や `checks_exit_code` のような helper で i32 に[落/お]とし、runner [側/がわ]で[比較/ひかく]する[前提/ぜんてい]です。
//: - [表示/ひょうじ]は `#target std` のときだけ[行/おこな]います。`std` 以外の target では `Result` だけが[返/かえ]ります。
//: - reboot [後/ご]は「[明示的/めいじてき]に print する」[方針/ほうしん]とし、`checks_exit_code` は stdout を[汚/よご]しません。
//: - doctest は[使/つか]い[方/かた]の[保証/ほしょう]が目的であり、境界条件や回帰確認は `tests/stdlib/*` 側で行います。
//:
//: ### [計算量/けいさんりょう]
//: - `assert_*` と `check_*` の単体判定は O(1) か、比較対象の長さに応じた O(n) です。
//: - 集約 API は summary [文字列/もじれつ][構築/こうちく]を[含/ふく]むため、`finish_checks` [全体/ぜんたい]では O(n^2) になりえます。

//: ## test_str_eq
//: [文字列/もじれつ]が[等/ひと]しいか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - a と b の内容が同じなら true を返します。
//:
//: ### [実装/じっそう]
//: - 長さ一致を確認し、バイト単位で比較します。
//:
//: ### [注意/ちゅうい]
//: - UTF-8 のバイト列として比較します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（再帰呼び出しぶん）
fn test_str_eq <(str,str)->bool> (a,b):
    let la <i32> len a;
    let lb <i32> len b;
    if:
        eq la lb
        then:
            test_str_eq_loop a b la 0
        else:
            false

//: ## test_str_eq_loop
//: [文字列/もじれつ][比較/ひかく]の[内部/ないぶ]ループ
//:
//: ### [目的/もくてき]
//: - i を進めながら各バイトを比較します。
//:
//: ### [実装/じっそう]
//: - 一致なら再帰、差異があれば false を返します。
//:
//: ### [注意/ちゅうい]
//: - 呼び出し側で長さ一致を確認している前提です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（再帰呼び出しぶん）
fn test_str_eq_loop <(str,str,i32,i32)->bool> (a,b,len,i):
    if:
        eq i len
        then:
            true
        else:
            let ba <i32> string_byte_at_unchecked a i;
            let bb <i32> string_byte_at_unchecked b i;
            if:
                eq ba bb
                then test_str_eq_loop a b len add i 1
                else false

//: ## test_print_fail
//: [失敗/しっぱい]メッセージを[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - msg を赤色で標準出力へ表示します。
//:
//: ### [実装/じっそう]
//: - ANSI 赤色コードで色付けして出力します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` の[表示/ひょうじ] helper です。
//: - 端末が ANSI に対応している必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
#if[target=std]
#if[target=std]
fn test_print_fail <(str)*>()> (msg):
    let m0 <str> concat "FAIL: " msg;
    println_color ansi_red m0

//: ## test_checked
//: [成功/せいこう]ログを[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - "Checked " [付/つ]きの[成功/せいこう]ログを[色付/いろづ]きで[表示/ひょうじ]し、`Result::Ok ()` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 文字列を連結し、ansi_green で出力します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` の[表示/ひょうじ] helper です。
//: - 端末が ANSI に対応している必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
#if[target=std]
#if[target=std]
fn test_checked <(str)*>Result<(),str>> (msg):
    print_color ansi_green "Checked ";
    println msg;
    Result<(),str>::Ok ()

//: ## test_fail
//: [失敗/しっぱい]メッセージを[出/だ]して `Result::Err` を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - msg を `FAIL:` [形式/けいしき]で[表示/ひょうじ]し、[安全/あんぜん]に `Result::Err` として[失敗/しっぱい]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `#target std` では `test_print_fail` を[呼/よ]び、そのあと `Result::Err msg` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - この helper [自体/じたい]は trap しません。[最終/さいしゅう][判定/はんてい]は[呼/よ]び[出/だ]し[側/がわ]が[行/おこな]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
fn noshadow test_fail <(str)*>Result<(),str>> (msg):
    #if[target=std]
    test_print_fail msg;
    Result<(),str>::Err msg

//: ## checks_new
//: [集約/しゅうやく][検査/けんさ]の[空/から]状態を[作/つく]る
//:
//: ### [目的/もくてき]
//: - `finish_checks` に渡す `Checks` を空の状態で作ります。
//: - `push` の型引数を毎回書かずに collectable な検査列を組み立てる入口として使います。
//:
//: ### [実装/じっそう]
//: - allocation せずに空の summary と human report を持つ値を返します。
//:
//: ### [注意/ちゅうい]
//: - 返り値は `Result<(),str>` 専用です。
//: - 以後の追加は `checks_push` を使うと型引数を書かずに済みます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks checks_new;
//:     checks_exit_code checks
//: ```
fn checks_new <()*>Checks> ():
    checks_empty

//: ## checks_push
//: [集約/しゅうやく][検査/けんさ]に 1 [件/けん][追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `Result<(),str>` を `Checks` に追加し、pipe で連結しやすい形を提供します。
//:
//: ### [実装/じっそう]
//: - 追加時点で machine summary と human report の文字列へ反映します。
//: - 後段で `Vec` backing store を raw scan しないため、非 Copy payload の再読みに依存しません。
//:
//: ### [注意/ちゅうい]
//: - 検査そのものは `check_*` 側で評価済みであり、この関数は格納しかしません。
//: - 返り値は更新済みの `Checks` なので、`|> checks_push ... |> checks_push ...` と連結できます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)（文字列連結ぶん）
//: - [空間/くうかん]: O(n)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push check true
//:         |> checks_push check true
//:     checks_exit_code checks
//: ```
fn checks_push <(Checks,Result<(),str>)*>Checks> (checks, r):
    let count <i32> checks.count;
    let status <str> check_status_str r;
    let sep <str> if eq count 0 "" ",";
    let summary0 <str> concat checks.summary sep;
    let summary1 <str> concat summary0 status;
    let si <str> from_i32 count;
    let prefix0 <str> concat "[" si;
    let prefix1 <str> concat prefix0 "] ";
    let line0 <str> concat prefix1 status;
    let line1 <str> concat line0 "\n";
    let human1 <str> concat checks.human line1;
    let failed1 <bool> match r:
        Result::Ok v:
            checks.failed
        Result::Err e:
            true
    Checks add count 1 failed1 summary1 human1

//: ## check
//: [条件/じょうけん]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `assert` と同じ条件判定を行い、その場で停止せず `Result<(),str>` として返します。
//: - 複数の検査を `Checks` に集約して最後にまとめて判定したいときに使います。
//:
//: ### [実装/じっそう]
//: - `ok` が true なら `Ok(())`、false なら固定メッセージ付きの `Err` を返します。
//:
//: ### [注意/ちゅうい]
//: - 失敗時に詳細な説明が必要なら、この関数ではなく `check_eq_i32` や `check_str_eq` のような専用版を使ってください。
//: - この関数自体は何も表示しません。表示と最終失敗判定は `finish_checks` が担当します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push check true
//:         |> checks_push check true
//:     checks_exit_code checks
//: ```
fn check <(bool)->Result<(),str>> (okv):
    if:
        okv
        then:
            Result<(),str>::Ok ()
        else:
            Result<(),str>::Err "check failed"

//: ## check_eq_i32
//: i32 の[等値/とうち][検査/けんさ]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `expected` と `actual` の比較結果を即時停止ではなく値として返します。
//:
//: ### [実装/じっそう]
//: - 等しければ `Ok(())`、異なれば `expected` と `actual` を文字列化したメッセージ付き `Err` を返します。
//:
//: ### [注意/ちゅうい]
//: - `assert_eq_i32` はこの関数の結果を受けてただちに失敗終了する薄いラッパです。
//: - 失敗を複数件まとめたいときはこの関数を `Checks` に積んでください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push check_eq_i32 10 add 4 6
//:         |> checks_push check_eq_i32 3 sub 8 5
//:     checks_exit_code checks
//: ```
fn check_eq_i32 <(i32,i32)->Result<(),str>> (expected, actual):
    if:
        eq expected actual
        then:
            Result<(),str>::Ok ()
        else:
            let se <str> from_i32 expected
            let sa <str> from_i32 actual
            let m0 <str> concat "assert_eq_i32 failed: expected=" se
            let m1 <str> concat m0 " actual="
            let m2 <str> concat m1 sa
            Result<(),str>::Err m2

//: ## check_ne
//: bool が[等/ひと]しくないことを `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `a` と `b` が同じなら詳細メッセージ付き `Err`、違えば `Ok(())` を返します。
//:
//: ### [実装/じっそう]
//: - bool の組み合わせを分岐し、一致時だけ値を文字列化して失敗メッセージを組み立てます。
//:
//: ### [注意/ちゅうい]
//: - bool 専用です。
//: - true/false のどちらで一致したかを失敗メッセージに含めます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_ne <(bool,bool)->Result<(),str>> (a, b):
    if:
        a
        then:
            if:
                b
                then:
                    let sa <str> from_bool a
                    let sb <str> from_bool b
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    Result<(),str>::Err m2
                else:
                    Result<(),str>::Ok ()
        else:
            if:
                b
                then:
                    Result<(),str>::Ok ()
                else:
                    let sa <str> from_bool a
                    let sb <str> from_bool b
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    Result<(),str>::Err m2

//: ## check_str_eq
//: [文字列/もじれつ]の[等値/とうち][検査/けんさ]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - 文字列比較の結果を、直ちに停止せずに後段へ渡せる形で返します。
//:
//: ### [実装/じっそう]
//: - `test_str_eq` で UTF-8 バイト列を比較し、不一致時だけ詳細メッセージを組み立てます。
//:
//: ### [注意/ちゅうい]
//: - 比較単位は Unicode の文字数ではなく UTF-8 のバイト列です。
//: - 長い文字列では、失敗メッセージ自体の生成にも連結コストがかかります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（失敗時メッセージ生成ぶん）
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push check_str_eq "hello" concat "he" "llo"
//:     checks_exit_code checks
//: ```
fn check_str_eq <(str,str)->Result<(),str>> (expected, actual):
    if:
        test_str_eq expected actual
        then:
            Result<(),str>::Ok ()
        else:
            let m0 <str> concat "assert_str_eq failed: expected=\"" expected
            let m1 <str> concat m0 "\" actual=\""
            let m2 <str> concat m1 actual
            let m3 <str> concat m2 "\""
            Result<(),str>::Err m3

//: ## check_ok_i32
//: `Result<i32,i32>` が `Ok` であることを[値/あたい]として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result::Ok` を期待する検査を集約可能な `Result<(),str>` に変換します。
//:
//: ### [実装/じっそう]
//: - `match` で `Ok/Err` を分け、`Err` の場合だけ失敗メッセージを返します。
//:
//: ### [注意/ちゅうい]
//: - `Result<i32,i32>` 専用です。
//: - `Ok` の中身は返さず、成功・失敗だけを返します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_ok_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    match r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err e:
            let se <str> from_i32 e
            let m0 <str> concat "assert_ok_i32 failed: Err=" se
            Result<(),str>::Err m0

//: ## check_err_i32
//: `Result<i32,i32>` が `Err` であることを[値/あたい]として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result::Err` を期待する検査を集約可能な `Result<(),str>` に変換します。
//:
//: ### [実装/じっそう]
//: - `match` で `Ok/Err` を分け、`Ok` の場合だけ失敗メッセージを返します。
//:
//: ### [注意/ちゅうい]
//: - `Result<i32,i32>` 専用です。
//: - `Err` の中身は返さず、成功・失敗だけを返します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_err_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    match r:
        Result::Ok v:
            let sv <str> from_i32 v
            let m0 <str> concat "assert_err_i32 failed: Ok=" sv
            Result<(),str>::Err m0
        Result::Err e:
            Result<(),str>::Ok ()

//: ## check_status_str
//: [機械/きかい][向/む]け summary [用/よう]の[状態/じょうたい][文字列/もじれつ]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result<(),str>` を `ok` / `err <msg>` の[安定/あんてい]した summary [片/へん]へ[変換/へんかん]し、machine [側/がわ]でも[追跡/ついせき]しやすくします。
//:
//: ### [実装/じっそう]
//: - `Ok` は `ok` を[返/かえ]し、`Err msg` は `err ` と msg を[連結/れんけつ]して[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `checks_summary` の[内部/ないぶ] helper です。
//: - msg をそのまま summary に[含/ふく]めるため、[非常/ひじょう]に[長/なが]い[失敗/しっぱい][文/ぶん]は summary [行/ぎょう]も[長/なが]くなります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_status_str <(Result<(),str>)->str> (r):
    match r:
        Result::Ok v:
            "ok"
        Result::Err e:
            concat "err " e

//: ## checks_has_err
//: [集約/しゅうやく][済/ず]み[検査列/けんされつ]に `Err` が[含/ふく]まれるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - [最終/さいしゅう][失敗/しっぱい][判定/はんてい]の[前/まえ]に、[少/すく]なくとも 1 [件/けん]の[失敗/しっぱい]があるかを[調/しら]べます。
//:
//: ### [実装/じっそう]
//: - `checks_push` が更新した失敗 flag をそのまま返します。
//:
//: ### [注意/ちゅうい]
//: - [失敗/しっぱい]の[詳細/しょうさい]は[返/かえ]しません。[詳細/しょうさい][表示/ひょうじ]には `finish_checks` を[使/つか]ってください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn checks_has_err <(Checks)->bool> (checks):
    checks.failed

//: ## checks_summary_text
//: `Checks` の machine summary を[閉/と]じる
//:
//: ### [目的/もくてき]
//: - `checks_push` が保持している途中 summary に `]` を付けて、外部へ返せる形にします。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
fn checks_summary_text <(Checks)->str> (checks):
    concat checks.summary "]"

//: ## checks_summary
//: [集約/しゅうやく][済/ず]み[検査列/けんされつ]を `[ok,err <msg>,...]` [形式/けいしき]へ[整形/せいけい]する
//:
//: ### [目的/もくてき]
//: - [複数/ふくすう]の[検査/けんさ][結果/けっか]を[安定/あんてい]した 1 [行/ぎょう]の[文字列表現/もじれつひょうげん]へ[畳/たた]み、runner や log [側/がわ]で[扱/あつか]いやすくします。
//:
//: ### [実装/じっそう]
//: - 追加時点で保持していた summary を閉じて返します。
//:
//: ### [注意/ちゅうい]
//: - これは machine / log [向/む]けの[安定/あんてい][表現/ひょうげん]です。[人間/にんげん][向/む]けの[色付/いろづ]き[表示/ひょうじ]は `checks_print_human` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（[文字列/もじれつ][連結/れんけつ]を[繰/く]り[返/かえ]すため）
//: - [空間/くうかん]: O(n)
fn checks_summary <(Checks)->str> (checks):
    checks_summary_text checks

//: ## checks_print_human
//: `Checks` を[人間/にんげん][向/む]けに[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - `[index] ok / err <msg>` の[形/かたち]で[全件/ぜんけん][表示/ひょうじ]し、[人間/にんげん]が[成功/せいこう]と[失敗/しっぱい]を[即座/そくざ]に[読/よ]めるようにします。
//: - [表示/ひょうじ][後/ご]も[同/おな]じ `Checks` を[返/かえ]し、その[後/あと]の `checks_exit_code` や[追加/ついか] helper と[合成/ごうせい]できるようにします。
//:
//: ### [実装/じっそう]
//: - `checks_push` が構築済みの human report を 1 回だけ出力します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` [専用/せんよう]です。
//: - machine [向/む]けの[安定/あんてい][表現/ひょうげん]が[必要/ひつよう]なら `checks_summary` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(1)
#if[target=std]
fn checks_print_human <(Checks)*>Checks> (checks):
    print checks.human;
    checks

//: ## checks_print_machine
//: `Checks` を machine [向/む]け summary として[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - test case [側/がわ]で summary だけを stdout へ[明示的/めいじてき]に[出/だ]したいときに[使/つか]います。
//: - [表示/ひょうじ][後/ご]も[同/おな]じ `Checks` を[返/かえ]し、その[後/あと]の[処理/しょり]へ[繋/つな]げられるようにします。
//:
//: ### [実装/じっそう]
//: - `checks_push` が構築済みの summary と失敗 flag を使って表示します。
//: - [最後/さいご]に[元/もと]の `Checks` をそのまま[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `finish_checks` や `checks_exit_code` は[自動/じどう]で[表示/ひょうじ]しません。stdout が[必要/ひつよう]な test case ではこの helper を[明示的/めいじてき]に[呼/よ]んでください。
//: - `#target std` [専用/せんよう]です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
#if[target=std]
fn checks_print_machine <(Checks)*>Checks> (checks):
    let summary <str> checks_summary_text checks;
    if:
        checks.failed
        then:
            test_print_fail summary
        else:
            test_checked summary;
    checks

//: ## checks_print_report
//: test [終了時/しゅうりょうじ]に summary と human [向/む]け[一覧/いちらん]を[まとめて/まとめて][表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - `checks_push` [中/ちゅう]には[何/なに]も print せず、test [本体/ほんたい]の[末尾/まつび]で 1 [回/かい]だけ[明示的/めいじてき]に[結果/けっか]を[出/だ]したい[場合/ばあい]の[標準/ひょうじゅん] helper を[提供/ていきょう]します。
//:
//: ### [実装/じっそう]
//: - `checks_print_machine` の[後/あと]に `checks_print_human` を[呼/よ]び、[同/おな]じ `Checks` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `checks_exit_code` とは[別/べつ]です。stdout が[必要/ひつよう]な test case だけ、`return` [直前/ちょくぜん]でこの helper を[呼/よ]んでください。
//: - `#target std` [専用/せんよう]です。
//:
//: ### [計算量/けいさんりょう]
//: - `checks_print_machine` と `checks_print_human` の[合計/ごうけい]に[準/じゅん]じます。
#if[target=std]
fn checks_print_report <(Checks)*>Checks> (checks):
    checks
    |> checks_print_machine
    |> checks_print_human

//: ## finish_checks
//: [複数/ふくすう][検査/けんさ]をまとめて `Result<(),str>` に[畳/たた]む
//:
//: ### [目的/もくてき]
//: - `Checks` として[集約/しゅうやく]した[検査/けんさ]を[最後/さいご]にまとめて[評価/ひょうか]します。
//: - [途中/とちゅう]の[検査/けんさ]は[継続/けいぞく]しつつ、[最後/さいご]に[表示/ひょうじ]なしで[成功/せいこう] / [失敗/しっぱい]を[値/あたい]として[得/え]られます。
//:
//: ### [実装/じっそう]
//: - `checks_push` が更新した summary と失敗 flag をそのまま使います。
//: - [失敗/しっぱい]が 1 [件/けん]でもあれば `Result::Err summary`、なければ `Result::Ok ()` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [想定/そうてい][用途/ようと]は `checks_new |> checks_push check_* ...` のような[段階的/だんかいてき][収集/しゅうしゅう]です。
//: - stdout へ[出/だ]したい[場合/ばあい]は `checks_print_report` などを test case [側/がわ]で[明示的/めいじてき]に[呼/よ]んでください。
//: - runner [連携/れんけい]で[終了/しゅうりょう] code が[必要/ひつよう]な[場合/ばあい]は `checks_exit_code` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（summary [文字列/もじれつ][構築/こうちく]を[含/ふく]む）
//: - [空間/くうかん]: O(n)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push check_eq_i32 3 add 1 2
//:         |> checks_push check_str_eq "ok" "ok"
//:         |> checks_push check_ok_i32 Result::Ok 7
//:     checks_exit_code checks
//: ```
fn finish_checks <(Checks)*>Result<(),str>> (checks):
    let summary <str> checks_summary_text checks;
    let failed <bool> checks.failed;
    if:
        failed
        then:
            Result<(),str>::Err summary
        else:
            Result<(),str>::Ok ()

//: ## result_exit_code
//: `Result<(),str>` を i32 の[終了/しゅうりょう] code へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - [安全/あんぜん]な `Result<(),str>` [表現/ひょうげん]を、runner が[比較/ひかく]できる i32 に[落/お]とします。
//:
//: ### [実装/じっそう]
//: - `Ok` なら 0、`Err` なら 1 を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [詳細/しょうさい]な[失敗/しっぱい][内容/ないよう]の[表示/ひょうじ]は `test_fail` や `checks_print_*` helper が[担当/たんとう]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn result_exit_code <(Result<(),str>)->i32> (r):
    match r:
        Result::Ok v:
            0
        Result::Err e:
            1

//: ## checks_exit_code
//: [集約/しゅうやく][検査/けんさ]を i32 の[終了/しゅうりょう] code へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `finish_checks` の[結果/けっか]をそのまま `main` の[返/かえ]り[値/あたい]へ[繋/つな]げられるようにします。
//:
//: ### [実装/じっそう]
//: - `finish_checks` を[呼/よ]んでから `result_exit_code` へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - stdout を[伴/ともな]う[表示/ひょうじ]は[行/おこな]いません。必要なら test case [側/がわ]で `checks_print_machine` / `checks_print_human` を[呼/よ]んでください。
//:
//: ### [計算量/けいさんりょう]
//: - `finish_checks` に[準/じゅん]じます。
fn checks_exit_code <(Checks)*>i32> (checks):
    result_exit_code finish_checks checks

//: ## assert
//: [条件/じょうけん]が false のとき[失敗/しっぱい]する
//:
//: ### [目的/もくてき]
//: - ok が false なら `FAIL:` [表示/ひょうじ]つきの `Result::Err` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - if で分岐し、false なら test_fail を呼びます。
//:
//: ### [注意/ちゅうい]
//: - ok は bool である必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push assert true
//:         |> checks_push assert eq 3 add 1 2
//:     checks_exit_code checks
//: ```
fn noshadow assert <(bool)*>Result<(),str>> (ok):
    match check ok:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_eq_i32
//: i32 の[等値/とうち]を[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - expected と actual が等しいことを保証します。
//:
//: ### [実装/じっそう]
//: - eq の結果が false なら詳細メッセージを作って test_fail します。
//:
//: ### [注意/ちゅうい]
//: - i32 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push assert_eq_i32 6 add 1 5
//:         |> checks_push assert_eq_i32 3 sub 10 7
//:     checks_exit_code checks
//: ```
fn noshadow assert_eq_i32 <(i32,i32)*>Result<(),str>> (expected, actual):
    match check_eq_i32 expected actual:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_ne
//: bool が[等/ひと]しくないことを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - a と b が同じなら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - a の値で分岐し、b との一致を確認します。
//:
//: ### [注意/ちゅうい]
//: - bool 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push assert_ne true false
//:         |> checks_push assert_ne false true
//:     checks_exit_code checks
//: ```
fn noshadow assert_ne <(bool,bool)*>Result<(),str>> (a, b):
    match check_ne a b:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_str_eq
//: [文字列/もじれつ]が[等/ひと]しいことを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - expected と actual が同じであることを保証します。
//:
//: ### [実装/じっそう]
//: - test_str_eq で比較し、false なら詳細メッセージを作って test_fail します。
//:
//: ### [注意/ちゅうい]
//: - UTF-8 のバイト列として比較します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push assert_str_eq "prefix-suffix" concat "prefix-" "suffix"
//:         |> checks_push assert_str_eq "true" from_bool true
//:     checks_exit_code checks
//: ```
fn noshadow assert_str_eq <(str,str)*>Result<(),str>> (expected, actual):
    match check_str_eq expected actual:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_ok_i32
//: `Result` が `Ok` であることを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - Result::Ok を受け付け、Err なら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - match で Ok/Err を分岐します。
//:
//: ### [注意/ちゅうい]
//: - Result<i32,i32> 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     result_exit_code assert_ok_i32 Result<i32,i32>::Ok 42
//: ```
fn noshadow assert_ok_i32 <(Result<i32,i32>)*>Result<(),str>> (r):
    match check_ok_i32 r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_err_i32
//: `Result` が `Err` であることを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - Result::Err を受け付け、Ok なら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - match で Ok/Err を分岐します。
//:
//: ### [注意/ちゅうい]
//: - Result<i32,i32> 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     result_exit_code assert_err_i32 Result<i32,i32>::Err 7
//: ```
fn noshadow assert_err_i32 <(Result<i32,i32>)*>Result<(),str>> (r):
    match check_err_i32 r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg
