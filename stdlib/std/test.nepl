#indent 4

#import "core/math" as *
#import "core/mem" as *
#import "core/result" as *
#import "alloc/string" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec" as v
#if[target=std]
#import "std/stdio" as *

//: ## checks_empty_vec
//: [集約/しゅうやく][検査/けんさ][列/れつ]の[空/から] sentinel を[作/つく]る
//:
//: ### [目的/もくてき]
//: - allocation failure [時/じ]に consumed owner を[再利用/さいりよう]せず、空の `Vec<Result<(),str>>` に[切/き]り[替/か]えます。
fn checks_empty_vec <()->Vec<Result<(),str>>> ():
    v::Vec<Result<(),str>> 0 0 mem_ptr_wrap 0

//: ## checks_single_error
//: [単一/たんいつ]の[失敗/しっぱい]だけを[持/も]つ[検査/けんさ][列/れつ]を[作/つく]る
//:
//: ### [目的/もくてき]
//: - `checks_push` の grow failure を test failure として[観測/かんそく]できるよう、可能なら `Err msg` だけを[持/も]つ Vec を[返/かえ]します。
//: - その[確保/かくほ]も[失敗/しっぱい]した[場合/ばあい]は空 sentinel を[返/かえ]し、trap は[起/お]こしません。
fn checks_single_error <(str)*>Vec<Result<(),str>>> (msg):
    match v::new<Result<(),str>>:
        Result::Ok items0:
            let marker <Result<(),str>> Result<(),str>::Err msg;
            match v::push<Result<(),str>> items0 marker:
                Result::Ok items1:
                    items1
                Result::Err _e:
                    checks_empty_vec
        Result::Err _e:
            checks_empty_vec

//: # test
//: [標準/ひょうじゅん]ライブラリ[用/よう]の[簡易/かんい]テスト[支援/しえん]
//:
//: ### [目的/もくてき]
//: - stdlib と tutorials で共通に使う `assert_*` / `check_*` / `finish_checks` を提供し、[失敗/しっぱい]を trap ではなく `Result<(),str>` として[表現/ひょうげん]します。
//: - [単発/たんぱつ]の[検査/けんさ]と、[複数/ふくすう][検査/けんさ]を[継続/けいぞく][実行/じっこう]する collectable な[検査/けんさ]の[両方/りょうほう]を[同/おな]じモジュールで[扱/あつか]います。
//:
//: ### [実装/じっそう]
//: - [単発/たんぱつ]の `assert_*` は[対応/たいおう]する `check_*` の[結果/けっか]を[受/う]け、`Err` のときだけ `FAIL:` [形式/けいしき]の[表示/ひょうじ]を[行/おこな]ったうえで `Result::Err` を[返/かえ]します。
//: - [集約/しゅうやく][検査/けんさ]は `Vec<Result<(),str>>` を[保持/ほじ]し、`finish_checks` は[表示/ひょうじ]せずに `Result<(),str>` へ[畳/たた]みます。
//: - [表示/ひょうじ]が[必要/ひつよう]な test case は `checks_print_machine` / `checks_print_human` を[明示的/めいじてき]に[呼/よ]びます。
//:
//: ### [注意/ちゅうい]
//: - [失敗/しっぱい]の[最終/さいしゅう][判定/はんてい]は `result_exit_code` や `checks_exit_code` のような helper で i32 に[落/お]とし、runner [側/がわ]で[比較/ひかく]する[前提/ぜんてい]です。
//: - [表示/ひょうじ]は `#target std` のときだけ[行/おこな]います。`std` 以外の target では `Result` だけが[返/かえ]ります。
//: - reboot [後/ご]は「[明示的/めいじてき]に print する」[方針/ほうしん]とし、`checks_exit_code` は stdout を[汚/よご]しません。
//: - doctest は[使/つか]い[方/かた]の[保証/ほしょう]が目的であり、境界条件や回帰確認は `tests/stdlib/*` 側で行います。
//:
//: ### [計算量/けいさんりょう]
//: - `assert_*` と `check_*` の単体判定は O(1) か、比較対象の長さに応じた O(n) です。
//: - 集約 API は summary [文字列/もじれつ][構築/こうちく]を[含/ふく]むため、`finish_checks` [全体/ぜんたい]では O(n^2) になりえます。

//: ## test_str_eq
//: [文字列/もじれつ]が[等/ひと]しいか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - a と b の内容が同じなら true を返します。
//:
//: ### [実装/じっそう]
//: - 長さ一致を確認し、バイト単位で比較します。
//:
//: ### [注意/ちゅうい]
//: - UTF-8 のバイト列として比較します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（再帰呼び出しぶん）
fn test_str_eq <(str,str)->bool> (a,b):
    let la <i32> len a;
    let lb <i32> len b;
    if:
        eq la lb
        then:
            test_str_eq_loop a b la 0
        else:
            false

//: ## test_str_eq_loop
//: [文字列/もじれつ][比較/ひかく]の[内部/ないぶ]ループ
//:
//: ### [目的/もくてき]
//: - i を進めながら各バイトを比較します。
//:
//: ### [実装/じっそう]
//: - 一致なら再帰、差異があれば false を返します。
//:
//: ### [注意/ちゅうい]
//: - 呼び出し側で長さ一致を確認している前提です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（再帰呼び出しぶん）
fn test_str_eq_loop <(str,str,i32,i32)->bool> (a,b,len,i):
    if:
        eq i len
        then:
            true
        else:
            let ba <i32> string_byte_at_unchecked a i;
            let bb <i32> string_byte_at_unchecked b i;
            if:
                eq ba bb
                then test_str_eq_loop a b len add i 1
                else false

//: ## test_print_fail
//: [失敗/しっぱい]メッセージを[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - msg を赤色で標準出力へ表示します。
//:
//: ### [実装/じっそう]
//: - ANSI 赤色コードで色付けして出力します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` の[表示/ひょうじ] helper です。
//: - 端末が ANSI に対応している必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
#if[target=std]
#if[target=std]
fn test_print_fail <(str)*>()> (msg):
    let m0 <str> concat "FAIL: " msg;
    println_color ansi_red m0

//: ## test_checked
//: [成功/せいこう]ログを[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - "Checked " [付/つ]きの[成功/せいこう]ログを[色付/いろづ]きで[表示/ひょうじ]し、`Result::Ok ()` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 文字列を連結し、ansi_green で出力します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` の[表示/ひょうじ] helper です。
//: - 端末が ANSI に対応している必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
#if[target=std]
#if[target=std]
fn test_checked <(str)*>Result<(),str>> (msg):
    print_color ansi_green "Checked ";
    println msg;
    Result<(),str>::Ok ()

//: ## test_fail
//: [失敗/しっぱい]メッセージを[出/だ]して `Result::Err` を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - msg を `FAIL:` [形式/けいしき]で[表示/ひょうじ]し、[安全/あんぜん]に `Result::Err` として[失敗/しっぱい]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `#target std` では `test_print_fail` を[呼/よ]び、そのあと `Result::Err msg` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - この helper [自体/じたい]は trap しません。[最終/さいしゅう][判定/はんてい]は[呼/よ]び[出/だ]し[側/がわ]が[行/おこな]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
fn noshadow test_fail <(str)*>Result<(),str>> (msg):
    #if[target=std]
    test_print_fail msg;
    Result<(),str>::Err msg

//: ## checks_new
//: [集約/しゅうやく][検査/けんさ][列/れつ]の[空/から]ベクタを[作/つく]る
//:
//: ### [目的/もくてき]
//: - `finish_checks` に渡す `Vec<Result<(),str>>` を空の状態で作ります。
//: - `push` の型引数を毎回書かずに collectable な検査列を組み立てる入口として使います。
//:
//: ### [実装/じっそう]
//: - `new<Result<(),str>>` を `match` し、確保に失敗した場合は空 sentinel を返します。
//:
//: ### [注意/ちゅうい]
//: - 返り値は `Result<(),str>` 専用です。
//: - 以後の追加は `checks_push` を使うと型引数を書かずに済みます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>> checks_new;
//:     checks_exit_code checks
//: ```
fn checks_new <()*>Vec<Result<(),str>>> ():
    match v::new<Result<(),str>>:
        Result::Ok checks:
            checks
        Result::Err _e:
            checks_empty_vec

//: ## checks_push
//: [集約/しゅうやく][検査/けんさ][列/れつ]に 1 [件/けん][追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `Result<(),str>` を `Vec<Result<(),str>>` に追加し、pipe で連結しやすい形を提供します。
//:
//: ### [実装/じっそう]
//: - `push<Result<(),str>>` を固定して呼び、`push` の型推論詳細を利用者へ露出させません。
//: - grow failure は `Err` marker だけを持つ Vec に丸め、test [失敗/しっぱい]として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - 検査そのものは `check_*` 側で評価済みであり、この関数は格納しかしません。
//: - 返り値は同じベクタなので、`|> checks_push ... |> checks_push ...` と連結できます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: 償却 O(1)
//: - [最悪/さいあく][時間/じかん]: O(n)（再確保が起きる場合）
//: - [空間/くうかん]: 償却 O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push check true
//:         |> checks_push check true
//:     checks_exit_code checks
//: ```
fn checks_push <(Vec<Result<(),str>>,Result<(),str>)*>Vec<Result<(),str>>> (checks, r):
    match v::push<Result<(),str>> checks r:
        Result::Ok next:
            next
        Result::Err _e:
            checks_single_error "std/test checks_push allocation failed"

//: ## check
//: [条件/じょうけん]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `assert` と同じ条件判定を行い、その場で停止せず `Result<(),str>` として返します。
//: - 複数の検査を `Vec<Result<(),str>>` に集約して最後にまとめて判定したいときに使います。
//:
//: ### [実装/じっそう]
//: - `ok` が true なら `Ok(())`、false なら固定メッセージ付きの `Err` を返します。
//:
//: ### [注意/ちゅうい]
//: - 失敗時に詳細な説明が必要なら、この関数ではなく `check_eq_i32` や `check_str_eq` のような専用版を使ってください。
//: - この関数自体は何も表示しません。表示と最終失敗判定は `finish_checks` が担当します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push check true
//:         |> checks_push check true
//:     checks_exit_code checks
//: ```
fn check <(bool)->Result<(),str>> (okv):
    if:
        okv
        then:
            Result<(),str>::Ok ()
        else:
            Result<(),str>::Err "check failed"

//: ## check_eq_i32
//: i32 の[等値/とうち][検査/けんさ]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `expected` と `actual` の比較結果を即時停止ではなく値として返します。
//:
//: ### [実装/じっそう]
//: - 等しければ `Ok(())`、異なれば `expected` と `actual` を文字列化したメッセージ付き `Err` を返します。
//:
//: ### [注意/ちゅうい]
//: - `assert_eq_i32` はこの関数の結果を受けてただちに失敗終了する薄いラッパです。
//: - 失敗を複数件まとめたいときはこの関数を `Vec<Result<(),str>>` に積んでください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push check_eq_i32 10 add 4 6
//:         |> checks_push check_eq_i32 3 sub 8 5
//:     checks_exit_code checks
//: ```
fn check_eq_i32 <(i32,i32)->Result<(),str>> (expected, actual):
    if:
        eq expected actual
        then:
            Result<(),str>::Ok ()
        else:
            let se <str> from_i32 expected
            let sa <str> from_i32 actual
            let m0 <str> concat "assert_eq_i32 failed: expected=" se
            let m1 <str> concat m0 " actual="
            let m2 <str> concat m1 sa
            Result<(),str>::Err m2

//: ## check_ne
//: bool が[等/ひと]しくないことを `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `a` と `b` が同じなら詳細メッセージ付き `Err`、違えば `Ok(())` を返します。
//:
//: ### [実装/じっそう]
//: - bool の組み合わせを分岐し、一致時だけ値を文字列化して失敗メッセージを組み立てます。
//:
//: ### [注意/ちゅうい]
//: - bool 専用です。
//: - true/false のどちらで一致したかを失敗メッセージに含めます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_ne <(bool,bool)->Result<(),str>> (a, b):
    if:
        a
        then:
            if:
                b
                then:
                    let sa <str> from_bool a
                    let sb <str> from_bool b
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    Result<(),str>::Err m2
                else:
                    Result<(),str>::Ok ()
        else:
            if:
                b
                then:
                    Result<(),str>::Ok ()
                else:
                    let sa <str> from_bool a
                    let sb <str> from_bool b
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    Result<(),str>::Err m2

//: ## check_str_eq
//: [文字列/もじれつ]の[等値/とうち][検査/けんさ]を `Result<(),str>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - 文字列比較の結果を、直ちに停止せずに後段へ渡せる形で返します。
//:
//: ### [実装/じっそう]
//: - `test_str_eq` で UTF-8 バイト列を比較し、不一致時だけ詳細メッセージを組み立てます。
//:
//: ### [注意/ちゅうい]
//: - 比較単位は Unicode の文字数ではなく UTF-8 のバイト列です。
//: - 長い文字列では、失敗メッセージ自体の生成にも連結コストがかかります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（失敗時メッセージ生成ぶん）
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push check_str_eq "hello" concat "he" "llo"
//:     checks_exit_code checks
//: ```
fn check_str_eq <(str,str)->Result<(),str>> (expected, actual):
    if:
        test_str_eq expected actual
        then:
            Result<(),str>::Ok ()
        else:
            let m0 <str> concat "assert_str_eq failed: expected=\"" expected
            let m1 <str> concat m0 "\" actual=\""
            let m2 <str> concat m1 actual
            let m3 <str> concat m2 "\""
            Result<(),str>::Err m3

//: ## check_ok_i32
//: `Result<i32,i32>` が `Ok` であることを[値/あたい]として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result::Ok` を期待する検査を集約可能な `Result<(),str>` に変換します。
//:
//: ### [実装/じっそう]
//: - `match` で `Ok/Err` を分け、`Err` の場合だけ失敗メッセージを返します。
//:
//: ### [注意/ちゅうい]
//: - `Result<i32,i32>` 専用です。
//: - `Ok` の中身は返さず、成功・失敗だけを返します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_ok_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    match r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err e:
            let se <str> from_i32 e
            let m0 <str> concat "assert_ok_i32 failed: Err=" se
            Result<(),str>::Err m0

//: ## check_err_i32
//: `Result<i32,i32>` が `Err` であることを[値/あたい]として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result::Err` を期待する検査を集約可能な `Result<(),str>` に変換します。
//:
//: ### [実装/じっそう]
//: - `match` で `Ok/Err` を分け、`Ok` の場合だけ失敗メッセージを返します。
//:
//: ### [注意/ちゅうい]
//: - `Result<i32,i32>` 専用です。
//: - `Err` の中身は返さず、成功・失敗だけを返します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_err_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    match r:
        Result::Ok v:
            let sv <str> from_i32 v
            let m0 <str> concat "assert_err_i32 failed: Ok=" sv
            Result<(),str>::Err m0
        Result::Err e:
            Result<(),str>::Ok ()

//: ## check_status_str
//: [機械/きかい][向/む]け summary [用/よう]の[状態/じょうたい][文字列/もじれつ]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Result<(),str>` を `ok` / `err <msg>` の[安定/あんてい]した summary [片/へん]へ[変換/へんかん]し、machine [側/がわ]でも[追跡/ついせき]しやすくします。
//:
//: ### [実装/じっそう]
//: - `Ok` は `ok` を[返/かえ]し、`Err msg` は `err ` と msg を[連結/れんけつ]して[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `checks_summary` の[内部/ないぶ] helper です。
//: - msg をそのまま summary に[含/ふく]めるため、[非常/ひじょう]に[長/なが]い[失敗/しっぱい][文/ぶん]は summary [行/ぎょう]も[長/なが]くなります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn check_status_str <(Result<(),str>)->str> (r):
    match r:
        Result::Ok v:
            "ok"
        Result::Err e:
            concat "err " e

//: ## checks_has_err_loop
//: `Err` を[含/ふく]むかを[順/じゅん]に[調/しら]べる[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - [集約/しゅうやく][済/ず]み[検査列/けんされつ]に[失敗/しっぱい]があるかを[線形/せんけい][走査/そうさ]で[判定/はんてい]します。
//:
//: ### [実装/じっそう]
//: - `Vec` の backing store を 1 [回/かい]だけ[取/と]り[出/だ]し、raw data を[添字/そえじ]で[走査/そうさ]します。
//: - [最初/さいしょ]の `Err` が[見/み]つかった[時点/じてん]で true を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper です。
//: - `checks_data` は `Vec<Result<(),str>>` の data pointer、`n` は[長/なが]さです。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（[再帰/さいき]）
fn checks_has_err_loop <(i32,i32,i32)->bool> (checks_data, n, i):
    if:
        eq i n
        then:
            false
        else:
            let r <Result<(),str>> load<Result<(),str>> add checks_data mul i size_of<Result<(),str>>;
            match r:
                Result::Ok v:
                    checks_has_err_loop checks_data n add i 1
                Result::Err e:
                    true

//: ## checks_has_err
//: [集約/しゅうやく][済/ず]み[検査列/けんされつ]に `Err` が[含/ふく]まれるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - [最終/さいしゅう][失敗/しっぱい][判定/はんてい]の[前/まえ]に、[少/すく]なくとも 1 [件/けん]の[失敗/しっぱい]があるかを[調/しら]べます。
//:
//: ### [実装/じっそう]
//: - `Vec<Result<(),str>>` を temporary memory に[保存/ほぞん]し、長さと data pointer を 1 [回/かい]だけ[取/と]り[出/だ]して `checks_has_err_loop` へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [失敗/しっぱい]の[詳細/しょうさい]は[返/かえ]しません。[詳細/しょうさい][表示/ひょうじ]には `finish_checks` を[使/つか]ってください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（[再帰/さいき]）
fn checks_has_err <(Vec<Result<(),str>>)->bool> (checks):
    let checks_mem <i32> alloc_raw size_of<Vec<Result<(),str>>>;
    store<Vec<Result<(),str>>> checks_mem checks;
    let checks_len <i32> get load<Vec<Result<(),str>>> checks_mem "len";
    let checks_data <i32> mem_ptr_addr get load<Vec<Result<(),str>>> checks_mem "data";
    let out <bool> checks_has_err_loop checks_data checks_len 0;
    dealloc_raw checks_mem size_of<Vec<Result<(),str>>>;
    out

//: ## checks_summary_loop
//: `[ok,err <msg>,...]` [形式/けいしき]の[要約/ようやく]を[作/つく]る[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - [集約/しゅうやく][済/ず]み[検査列/けんされつ]を、`ok` と `err <msg>` が[並/なら]ぶ summary [文字列/もじれつ]へ[変換/へんかん]します。
//:
//: ### [実装/じっそう]
//: - `Vec` の raw data を[先頭/せんとう]から[順/じゅん]に[走査/そうさ]し、`check_status_str` の[結果/けっか]を[必要/ひつよう]な[区切/くぎ]りとともに[連結/れんけつ]します。
//:
//: ### [注意/ちゅうい]
//: - [失敗/しっぱい][件数/けんすう]だけでなく、summary [行/ぎょう]だけで[各/かく][失敗/しっぱい][理由/りゆう]まで[追/お]いたい[場面/ばめん]を[想定/そうてい]した helper です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（[文字列/もじれつ][連結/れんけつ]を[繰/く]り[返/かえ]すため）
//: - [空間/くうかん]: O(n)
fn checks_summary_loop <(i32,i32,i32,str)->str> (checks_data, n, i, acc):
    if:
        eq i n
        then:
            concat acc "]"
        else:
            let sep <str> if eq i 0 "" ",";
            let r <Result<(),str>> load<Result<(),str>> add checks_data mul i size_of<Result<(),str>>;
            let a0 <str> concat acc sep;
            let a1 <str> concat a0 check_status_str r;
            checks_summary_loop checks_data n add i 1 a1

//: ## checks_summary
//: [集約/しゅうやく][済/ず]み[検査列/けんされつ]を `[ok,err <msg>,...]` [形式/けいしき]へ[整形/せいけい]する
//:
//: ### [目的/もくてき]
//: - [複数/ふくすう]の[検査/けんさ][結果/けっか]を[安定/あんてい]した 1 [行/ぎょう]の[文字列表現/もじれつひょうげん]へ[畳/たた]み、runner や log [側/がわ]で[扱/あつか]いやすくします。
//:
//: ### [実装/じっそう]
//: - `Vec<Result<(),str>>` を temporary memory に[保存/ほぞん]し、`[` から[始/はじ]めて `checks_summary_loop` で[連結/れんけつ]します。
//:
//: ### [注意/ちゅうい]
//: - これは machine / log [向/む]けの[安定/あんてい][表現/ひょうげん]です。[人間/にんげん][向/む]けの[色付/いろづ]き[表示/ひょうじ]は `checks_print_human` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（[文字列/もじれつ][連結/れんけつ]を[繰/く]り[返/かえ]すため）
//: - [空間/くうかん]: O(n)
fn checks_summary <(Vec<Result<(),str>>)->str> (checks):
    let checks_mem <i32> alloc_raw size_of<Vec<Result<(),str>>>;
    store<Vec<Result<(),str>>> checks_mem checks;
    let checks_len <i32> get load<Vec<Result<(),str>>> checks_mem "len";
    let checks_data <i32> mem_ptr_addr get load<Vec<Result<(),str>>> checks_mem "data";
    let out <str> checks_summary_loop checks_data checks_len 0 "[";
    dealloc_raw checks_mem size_of<Vec<Result<(),str>>>;
    out

//: ## checks_print_human_line
//: 1 [件/けん]ぶんの test [結果/けっか]を[人間/にんげん][向/む]けに[色付/いろづ]きで[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - `[index] ok` または `[index] err <msg>` の[形/かたち]で、1 [件/けん]の[検査/けんさ][結果/けっか]を[見/み]やすく[表示/ひょうじ]します。
//:
//: ### [実装/じっそう]
//: - [添字/そえじ][部分/ぶぶん]は灰色、`ok` は緑、`err <msg>` は赤で[表示/ひょうじ]します。
//:
//: ### [注意/ちゅうい]
//: - [標準/ひょうじゅん][出力/しゅつりょく]への[表示/ひょうじ]は `#target std` のときだけ[行/おこな]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(m)（m は msg の[長/なが]さ）
//: - [空間/くうかん]: O(m)
#if[target=std]
fn checks_print_human_line <(i32,Result<(),str>)*>()> (i, r):
    let si <str> from_i32 i;
    let prefix0 <str> concat "[" si;
    let prefix <str> concat prefix0 "] ";
    print_color ansi_gray prefix;
    match r:
        Result::Ok v:
            println_color ansi_green "ok"
        Result::Err msg:
            println_color ansi_red concat "err " msg

//: ## checks_print_human_loop
//: `Vec<Result<(),str>>` を[順/じゅん]に[色付/いろづ]き[表示/ひょうじ]する[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - [集約/しゅうやく][済/ず]み[検査列/けんされつ]の[全要素/ぜんようそ]を[人間/にんげん][向/む]けに[並/なら]べて[表示/ひょうじ]します。
//:
//: ### [実装/じっそう]
//: - raw data を[順/じゅん]に[走査/そうさ]し、`checks_print_human_line` へ 1 [件/けん]ずつ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [成功/せいこう] case でも[失敗/しっぱい] case でも[全件/ぜんけん]を[表示/ひょうじ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n + s)（s は[全/すべ]ての msg [長/なが]さの[合計/ごうけい]）
//: - [空間/くうかん]: O(n)（[再帰/さいき]）
#if[target=std]
fn checks_print_human_loop <(i32,i32,i32)*>()> (checks_data, n, i):
    if:
        eq i n
        then:
            ()
        else:
            let r <Result<(),str>> load<Result<(),str>> add checks_data mul i size_of<Result<(),str>>;
            checks_print_human_line i r
            checks_print_human_loop checks_data n add i 1

//: ## checks_print_human
//: `Vec<Result<(),str>>` を[人間/にんげん][向/む]けに[色付/いろづ]き[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - `Vec<Result<(),str>>` を `[index] ok / err <msg>` の[形/かたち]で[全件/ぜんけん][表示/ひょうじ]し、[人間/にんげん]が[成功/せいこう]と[失敗/しっぱい]を[即座/そくざ]に[読/よ]めるようにします。
//: - [表示/ひょうじ][後/ご]も[同/おな]じ `Vec<Result<(),str>>` を[返/かえ]し、その[後/あと]の `checks_exit_code` や[追加/ついか] helper と[合成/ごうせい]できるようにします。
//:
//: ### [実装/じっそう]
//: - `checks` を temporary memory に[保存/ほぞん]し、raw data を `checks_print_human_loop` へ[渡/わた]したあと、[同/おな]じ `Vec<Result<(),str>>` を[読/よ]み[戻/もど]して[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `#target std` [専用/せんよう]です。
//: - machine [向/む]けの[安定/あんてい][表現/ひょうげん]が[必要/ひつよう]なら `checks_summary` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n + s)（s は[全/すべ]ての msg [長/なが]さの[合計/ごうけい]）
//: - [空間/くうかん]: O(n)（[再帰/さいき]）
#if[target=std]
fn checks_print_human <(Vec<Result<(),str>>)*>Vec<Result<(),str>>> (checks):
    let checks_mem <i32> alloc_raw size_of<Vec<Result<(),str>>>;
    store<Vec<Result<(),str>>> checks_mem checks;
    let checks_len <i32> get load<Vec<Result<(),str>>> checks_mem "len";
    let checks_data <i32> mem_ptr_addr get load<Vec<Result<(),str>>> checks_mem "data";
    checks_print_human_loop checks_data checks_len 0;
    let out <Vec<Result<(),str>>> load<Vec<Result<(),str>>> checks_mem;
    dealloc_raw checks_mem size_of<Vec<Result<(),str>>>;
    out

//: ## checks_print_machine
//: `Vec<Result<(),str>>` を machine [向/む]け summary として[表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - test case [側/がわ]で summary だけを stdout へ[明示的/めいじてき]に[出/だ]したいときに[使/つか]います。
//: - [表示/ひょうじ][後/ご]も[同/おな]じ `Vec<Result<(),str>>` を[返/かえ]し、その[後/あと]の[処理/しょり]へ[繋/つな]げられるようにします。
//:
//: ### [実装/じっそう]
//: - `checks` を temporary memory に[保存/ほぞん]し、`checks_summary` を[計算/けいさん]して[失敗/しっぱい]があるときは `FAIL: ` [付き/つき]、なければ `Checked ` [付き/つき]で 1 [行/ぎょう][表示/ひょうじ]します。
//: - [最後/さいご]に[同/おな]じ `Vec<Result<(),str>>` を[読/よ]み[戻/もど]して[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `finish_checks` や `checks_exit_code` は[自動/じどう]で[表示/ひょうじ]しません。stdout が[必要/ひつよう]な test case ではこの helper を[明示的/めいじてき]に[呼/よ]んでください。
//: - `#target std` [専用/せんよう]です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（`checks_summary` の[構築/こうちく]を[含/ふく]む）
//: - [空間/くうかん]: O(n)
#if[target=std]
fn checks_print_machine <(Vec<Result<(),str>>)*>Vec<Result<(),str>>> (checks):
    let checks_mem <i32> alloc_raw size_of<Vec<Result<(),str>>>;
    store<Vec<Result<(),str>>> checks_mem checks;
    let summary <str> checks_summary load<Vec<Result<(),str>>> checks_mem;
    if:
        checks_has_err load<Vec<Result<(),str>>> checks_mem
        then:
            test_print_fail summary
        else:
            test_checked summary;
    let out <Vec<Result<(),str>>> load<Vec<Result<(),str>>> checks_mem;
    dealloc_raw checks_mem size_of<Vec<Result<(),str>>>;
    out

//: ## checks_print_report
//: test [終了時/しゅうりょうじ]に summary と human [向/む]け[一覧/いちらん]を[まとめて/まとめて][表示/ひょうじ]する
//:
//: ### [目的/もくてき]
//: - `checks_push` [中/ちゅう]には[何/なに]も print せず、test [本体/ほんたい]の[末尾/まつび]で 1 [回/かい]だけ[明示的/めいじてき]に[結果/けっか]を[出/だ]したい[場合/ばあい]の[標準/ひょうじゅん] helper を[提供/ていきょう]します。
//:
//: ### [実装/じっそう]
//: - `checks_print_machine` の[後/あと]に `checks_print_human` を[呼/よ]び、[同/おな]じ `Vec<Result<(),str>>` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `checks_exit_code` とは[別/べつ]です。stdout が[必要/ひつよう]な test case だけ、`return` [直前/ちょくぜん]でこの helper を[呼/よ]んでください。
//: - `#target std` [専用/せんよう]です。
//:
//: ### [計算量/けいさんりょう]
//: - `checks_print_machine` と `checks_print_human` の[合計/ごうけい]に[準/じゅん]じます。
#if[target=std]
fn checks_print_report <(Vec<Result<(),str>>)*>Vec<Result<(),str>>> (checks):
    checks
    |> checks_print_machine
    |> checks_print_human

//: ## finish_checks
//: [複数/ふくすう][検査/けんさ]をまとめて `Result<(),str>` に[畳/たた]む
//:
//: ### [目的/もくてき]
//: - `Vec<Result<(),str>>` として[集約/しゅうやく]した[検査/けんさ]を[最後/さいご]にまとめて[評価/ひょうか]します。
//: - [途中/とちゅう]の[検査/けんさ]は[継続/けいぞく]しつつ、[最後/さいご]に[表示/ひょうじ]なしで[成功/せいこう] / [失敗/しっぱい]を[値/あたい]として[得/え]られます。
//:
//: ### [実装/じっそう]
//: - `checks_summary` で machine [向/む]け summary を[作/つく]ります。
//: - [失敗/しっぱい]が 1 [件/けん]でもあれば `Result::Err summary`、なければ `Result::Ok ()` を[返/かえ]します。
//: - move model に[合/あ]わせ、[入力/にゅうりょく]の `Vec<Result<(),str>>` は 1 [回/かい]だけ memory に[保存/ほぞん]してから helper へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [想定/そうてい][用途/ようと]は `<Vec<Result<(),str>>> new |> push check_* ...` のような[段階的/だんかいてき][収集/しゅうしゅう]です。
//: - stdout へ[出/だ]したい[場合/ばあい]は `checks_print_report` などを test case [側/がわ]で[明示的/めいじてき]に[呼/よ]んでください。
//: - runner [連携/れんけい]で[終了/しゅうりょう] code が[必要/ひつよう]な[場合/ばあい]は `checks_exit_code` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n^2)（summary [文字列/もじれつ][構築/こうちく]を[含/ふく]む）
//: - [空間/くうかん]: O(n)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push check_eq_i32 3 add 1 2
//:         |> checks_push check_str_eq "ok" "ok"
//:         |> checks_push check_ok_i32 Result::Ok 7
//:     checks_exit_code checks
//: ```
fn finish_checks <(Vec<Result<(),str>>)*>Result<(),str>> (checks):
    let checks_mem <i32> alloc_raw size_of<Vec<Result<(),str>>>;
    store<Vec<Result<(),str>>> checks_mem checks;
    let summary <str> checks_summary load<Vec<Result<(),str>>> checks_mem;
    if:
        checks_has_err load<Vec<Result<(),str>>> checks_mem
        then:
            dealloc_raw checks_mem size_of<Vec<Result<(),str>>>
            Result<(),str>::Err summary
        else:
            dealloc_raw checks_mem size_of<Vec<Result<(),str>>>
            Result<(),str>::Ok ()

//: ## result_exit_code
//: `Result<(),str>` を i32 の[終了/しゅうりょう] code へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - [安全/あんぜん]な `Result<(),str>` [表現/ひょうげん]を、runner が[比較/ひかく]できる i32 に[落/お]とします。
//:
//: ### [実装/じっそう]
//: - `Ok` なら 0、`Err` なら 1 を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [詳細/しょうさい]な[失敗/しっぱい][内容/ないよう]の[表示/ひょうじ]は `test_fail` や `checks_print_*` helper が[担当/たんとう]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
fn result_exit_code <(Result<(),str>)->i32> (r):
    match r:
        Result::Ok v:
            0
        Result::Err e:
            1

//: ## checks_exit_code
//: [集約/しゅうやく][検査/けんさ]を i32 の[終了/しゅうりょう] code へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `finish_checks` の[結果/けっか]をそのまま `main` の[返/かえ]り[値/あたい]へ[繋/つな]げられるようにします。
//:
//: ### [実装/じっそう]
//: - `finish_checks` を[呼/よ]んでから `result_exit_code` へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - stdout を[伴/ともな]う[表示/ひょうじ]は[行/おこな]いません。必要なら test case [側/がわ]で `checks_print_machine` / `checks_print_human` を[呼/よ]んでください。
//:
//: ### [計算量/けいさんりょう]
//: - `finish_checks` に[準/じゅん]じます。
fn checks_exit_code <(Vec<Result<(),str>>)*>i32> (checks):
    result_exit_code finish_checks checks

//: ## assert
//: [条件/じょうけん]が false のとき[失敗/しっぱい]する
//:
//: ### [目的/もくてき]
//: - ok が false なら `FAIL:` [表示/ひょうじ]つきの `Result::Err` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - if で分岐し、false なら test_fail を呼びます。
//:
//: ### [注意/ちゅうい]
//: - ok は bool である必要があります。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push assert true
//:         |> checks_push assert eq 3 add 1 2
//:     checks_exit_code checks
//: ```
fn noshadow assert <(bool)*>Result<(),str>> (ok):
    match check ok:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_eq_i32
//: i32 の[等値/とうち]を[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - expected と actual が等しいことを保証します。
//:
//: ### [実装/じっそう]
//: - eq の結果が false なら詳細メッセージを作って test_fail します。
//:
//: ### [注意/ちゅうい]
//: - i32 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push assert_eq_i32 6 add 1 5
//:         |> checks_push assert_eq_i32 3 sub 10 7
//:     checks_exit_code checks
//: ```
fn noshadow assert_eq_i32 <(i32,i32)*>Result<(),str>> (expected, actual):
    match check_eq_i32 expected actual:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_ne
//: bool が[等/ひと]しくないことを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - a と b が同じなら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - a の値で分岐し、b との一致を確認します。
//:
//: ### [注意/ちゅうい]
//: - bool 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push assert_ne true false
//:         |> checks_push assert_ne false true
//:     checks_exit_code checks
//: ```
fn noshadow assert_ne <(bool,bool)*>Result<(),str>> (a, b):
    match check_ne a b:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_str_eq
//: [文字列/もじれつ]が[等/ひと]しいことを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - expected と actual が同じであることを保証します。
//:
//: ### [実装/じっそう]
//: - test_str_eq で比較し、false なら詳細メッセージを作って test_fail します。
//:
//: ### [注意/ちゅうい]
//: - UTF-8 のバイト列として比較します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let checks <Vec<Result<(),str>>>:
//:         checks_new
//:         |> checks_push assert_str_eq "prefix-suffix" concat "prefix-" "suffix"
//:         |> checks_push assert_str_eq "true" from_bool true
//:     checks_exit_code checks
//: ```
fn noshadow assert_str_eq <(str,str)*>Result<(),str>> (expected, actual):
    match check_str_eq expected actual:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_ok_i32
//: `Result` が `Ok` であることを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - Result::Ok を受け付け、Err なら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - match で Ok/Err を分岐します。
//:
//: ### [注意/ちゅうい]
//: - Result<i32,i32> 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     result_exit_code assert_ok_i32 Result<i32,i32>::Ok 42
//: ```
fn noshadow assert_ok_i32 <(Result<i32,i32>)*>Result<(),str>> (r):
    match check_ok_i32 r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg

//: ## assert_err_i32
//: `Result` が `Err` であることを[検証/けんしょう]する
//:
//: ### [目的/もくてき]
//: - Result::Err を受け付け、Ok なら詳細メッセージを作って test_fail します。
//:
//: ### [実装/じっそう]
//: - match で Ok/Err を分岐します。
//:
//: ### [注意/ちゅうい]
//: - Result<i32,i32> 専用です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: ### [使い方/つかいかた]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     result_exit_code assert_err_i32 Result<i32,i32>::Err 7
//: ```
fn noshadow assert_err_i32 <(Result<i32,i32>)*>Result<(),str>> (r):
    match check_err_i32 r:
        Result::Ok v:
            Result<(),str>::Ok ()
        Result::Err msg:
            test_fail msg
