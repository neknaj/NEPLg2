#indent 4

#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/string" as *
#import "alloc/encoding/json" as json
#if[target=std]
#import "std/stdio" as *

//: # test
//: [標準/ひょうじゅん]ライブラリ[用/よう]の[構造化/こうぞうか]テスト[支援/しえん]
//:
//: [目的/もくてき]:
//: - assertion の[評価/ひょうか]、report [集約/しゅうやく]、stdout [表示/ひょうじ]、exit code [変換/へんかん]を[別/べつ]の API に[分/わ]けます。
//: - assertion [結果/けっか]は `AssertionStatus` / `AssertionKind` / `TestAssertion` として[保持/ほじ]し、分岐は `match` による enum [網羅/もうら]で[扱/あつか]います。
//: - `.n.md` では stdout report と `exit_code:` を[両方/りょうほう]固定できるようにします。
//:
//: [注意/ちゅうい]:
//: - `assert_*` は stdout を[出/だ]しません。表示は `test_report_print_stdout` だけが[担当/たんとう]します。
//: - `test_report_exit_code` は stdout を[出/だ]さず、失敗件数から 0/1 を[返/かえ]します。
//: - 既存 doctest の段階移行用に `checks_*` という短い入口も同じ `TestReport` へ委譲します。旧 `Result<(),str>` accumulator へ戻すものではありません。
//: - report は test helper 用なので、[集約/しゅうやく]時に安定文字列を[蓄積/ちくせき]します。大量 case では O(n^2) の文字列連結になります。

//: AssertionStatus: assertion の[成否/せいひ]
//:
//: [目的/もくてき]:
//: - 成功/失敗を bool や文字列ではなく enum として[保持/ほじ]します。
enum AssertionStatus:
    Passed
    Failed

impl Clone for AssertionStatus:
    fn clone <(&AssertionStatus)->AssertionStatus> (status):
        *status

impl Copy for AssertionStatus:
    fn copy_mark <(AssertionStatus)->AssertionStatus> (status):
        status

//: AssertionKind: assertion の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - bool、i32 等値、文字列等値などの[種類/しゅるい]を enum で[表/あらわ]し、renderer の分岐を `match` に[閉/と]じます。
enum AssertionKind:
    Bool
    EqI32
    NeBool
    StrEq
    OkI32
    ErrI32
    Manual

impl Clone for AssertionKind:
    fn clone <(&AssertionKind)->AssertionKind> (kind):
        *kind

impl Copy for AssertionKind:
    fn copy_mark <(AssertionKind)->AssertionKind> (kind):
        kind

//: TestAssertion: [単一/たんいつ] assertion の[構造化/こうぞうか][結果/けっか]
//:
//: [目的/もくてき]:
//: - kind、status、label、expected、actual、message を[分離/ぶんり]して[保持/ほじ]します。
//: - stdout 用の整形は renderer に[任/まか]せ、この値を[作/つく]る関数は print しません。
struct TestAssertion:
    kind <AssertionKind>
    status <AssertionStatus>
    label <str>
    expected <str>
    actual <str>
    message <str>

impl Clone for TestAssertion:
    fn clone <(&TestAssertion)->TestAssertion> (a):
        *a

impl Copy for TestAssertion:
    fn copy_mark <(TestAssertion)->TestAssertion> (a):
        a

//: TestReport: assertion の[集約/しゅうやく] report
//:
//: [目的/もくてき]:
//: - assertion を push [順/じゅん]に deterministic な report [文字列/もじれつ]へ[追加/ついか]します。
//: - exit code 判定に必要な failed_count を[明示/めいじ]して[持/も]ちます。
//:
//: [実装/じっそう]:
//: - `lines` は新しい canonical stdout report 用の本文です。
//: - `legacy_summary` / `legacy_human` は、移行中の既存 doctest が使う `checks_print_report` の安定出力を同じ構造化 assertion から生成するための文字列です。
struct TestReport:
    name <str>
    count <i32>
    failed_count <i32>
    lines <str>
    legacy_summary <str>
    legacy_human <str>

impl Clone for TestReport:
    fn clone <(&TestReport)->TestReport> (report):
        *report

impl Copy for TestReport:
    fn copy_mark <(TestReport)->TestReport> (report):
        report

//: assertion_status_name: status を stable な[名前/なまえ]へ[変換/へんかん]する
fn assertion_status_name <(AssertionStatus)->str> (status):
    match status:
        AssertionStatus::Passed:
            "ok"
        AssertionStatus::Failed:
            "fail"

//: assertion_kind_name: kind を stable な[名前/なまえ]へ[変換/へんかん]する
fn assertion_kind_name <(AssertionKind)->str> (kind):
    match kind:
        AssertionKind::Bool:
            "bool"
        AssertionKind::EqI32:
            "eq_i32"
        AssertionKind::NeBool:
            "ne_bool"
        AssertionKind::StrEq:
            "str_eq"
        AssertionKind::OkI32:
            "ok_i32"
        AssertionKind::ErrI32:
            "err_i32"
        AssertionKind::Manual:
            "manual"

//: test_assertion_passed: [成功/せいこう] assertion を[作/つく]る
fn test_assertion_passed <(AssertionKind,str,str,str)->TestAssertion> (kind, label, expected, actual):
    TestAssertion kind AssertionStatus::Passed label expected actual ""

//: test_assertion_failed: [失敗/しっぱい] assertion を[作/つく]る
fn test_assertion_failed <(AssertionKind,str,str,str,str)->TestAssertion> (kind, label, expected, actual, message):
    TestAssertion kind AssertionStatus::Failed label expected actual message

//: test_assertion_ok: [手動/しゅどう]の[成功/せいこう] assertion を[作/つく]る
fn test_assertion_ok <(str)->TestAssertion> (label):
    test_assertion_passed AssertionKind::Manual label "ok" "ok"

//: test_assertion_fail: [手動/しゅどう]の[失敗/しっぱい] assertion を[作/つく]る
fn test_assertion_fail <(str,str)->TestAssertion> (label, message):
    test_assertion_failed AssertionKind::Manual label "ok" "fail" message

//: test_str_eq: [文字列/もじれつ]が[等/ひと]しいか[判定/はんてい]する
//:
//: [実装/じっそう]:
//: - 長さ一致を確認し、byte [単位/たんい]で[比較/ひかく]します。
fn test_str_eq <(str,str)->bool> (a,b):
    let la <i32> len a
    let lb <i32> len b
    if:
        eq la lb
        then:
            test_str_eq_loop a b la 0
        else:
            false

fn test_str_eq_loop <(str,str,i32,i32)->bool> (a,b,total,i):
    if:
        eq i total
        then:
            true
        else:
            let ba <i32> string_byte_at_unchecked a i
            let bb <i32> string_byte_at_unchecked b i
            if:
                eq ba bb
                then:
                    test_str_eq_loop a b total add i 1
                else:
                    false

//: assert: bool 条件を[構造化/こうぞうか] assertion にする
fn noshadow assert <(str,bool)->TestAssertion> (label, okv):
    if:
        okv
        then:
            test_assertion_passed AssertionKind::Bool label "true" "true"
        else:
            test_assertion_failed AssertionKind::Bool label "true" "false" "check failed"

fn noshadow assert <(bool)->TestAssertion> (okv):
    assert "assert" okv

//: assert_eq_i32: i32 の[等値/とうち] assertion を[作/つく]る
fn noshadow assert_eq_i32 <(str,i32,i32)->TestAssertion> (label, expected, actual):
    let se <str> from_i32 expected
    let sa <str> from_i32 actual
    if:
        eq expected actual
        then:
            test_assertion_passed AssertionKind::EqI32 label se sa
        else:
            let m0 <str> concat "assert_eq_i32 failed: expected=" se
            let m1 <str> concat m0 " actual="
            let m2 <str> concat m1 sa
            test_assertion_failed AssertionKind::EqI32 label se sa m2

fn noshadow assert_eq_i32 <(i32,i32)->TestAssertion> (expected, actual):
    assert_eq_i32 "assert_eq_i32" expected actual

//: assert_ne_bool: bool が[等/ひと]しくないことを[検査/けんさ]する
fn assert_ne_bool <(str,bool,bool)->TestAssertion> (label, a, b):
    let sa <str> from_bool a
    let sb <str> from_bool b
    let actual0 <str> concat sa " vs "
    let actual <str> concat actual0 sb
    if:
        a
        then:
            if:
                b
                then:
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    test_assertion_failed AssertionKind::NeBool label "different" actual m2
                else:
                    test_assertion_passed AssertionKind::NeBool label "different" actual
        else:
            if:
                b
                then:
                    test_assertion_passed AssertionKind::NeBool label "different" actual
                else:
                    let m0 <str> concat "assert_ne failed: a=" sa
                    let m1 <str> concat m0 " b="
                    let m2 <str> concat m1 sb
                    test_assertion_failed AssertionKind::NeBool label "different" actual m2

fn noshadow assert_ne <(str,bool,bool)->TestAssertion> (label, a, b):
    assert_ne_bool label a b

fn noshadow assert_ne <(bool,bool)->TestAssertion> (a, b):
    assert_ne_bool "assert_ne" a b

//: assert_str_eq: str の[等値/とうち] assertion を[作/つく]る
fn noshadow assert_str_eq <(str,str,str)->TestAssertion> (label, expected, actual):
    if:
        test_str_eq expected actual
        then:
            test_assertion_passed AssertionKind::StrEq label expected actual
        else:
            let m0 <str> concat "assert_str_eq failed: expected=\"" expected
            let m1 <str> concat m0 "\" actual=\""
            let m2 <str> concat m1 actual
            let m3 <str> concat m2 "\""
            test_assertion_failed AssertionKind::StrEq label expected actual m3

fn noshadow assert_str_eq <(str,str)->TestAssertion> (expected, actual):
    assert_str_eq "assert_str_eq" expected actual

//: assert_ok_i32: `Result<i32,i32>` が Ok であることを[検査/けんさ]する
fn noshadow assert_ok_i32 <(str,Result<i32,i32>)->TestAssertion> (label, r):
    match r:
        Result::Ok v:
            test_assertion_passed AssertionKind::OkI32 label "Ok" from_i32 v
        Result::Err e:
            let se <str> from_i32 e
            let actual <str> concat "Err " se
            let msg <str> concat "assert_ok_i32 failed: Err=" se
            test_assertion_failed AssertionKind::OkI32 label "Ok" actual msg

fn noshadow assert_ok_i32 <(Result<i32,i32>)->TestAssertion> (r):
    assert_ok_i32 "assert_ok_i32" r

//: assert_err_i32: `Result<i32,i32>` が Err であることを[検査/けんさ]する
fn noshadow assert_err_i32 <(str,Result<i32,i32>)->TestAssertion> (label, r):
    match r:
        Result::Ok v:
            let sv <str> from_i32 v
            let actual <str> concat "Ok " sv
            let msg <str> concat "assert_err_i32 failed: Ok=" sv
            test_assertion_failed AssertionKind::ErrI32 label "Err" actual msg
        Result::Err e:
            test_assertion_passed AssertionKind::ErrI32 label "Err" from_i32 e

fn noshadow assert_err_i32 <(Result<i32,i32>)->TestAssertion> (r):
    assert_err_i32 "assert_err_i32" r

//: check: bool 条件を quiet な Result にする
//:
//: [注意/ちゅうい]:
//: - 移行中の helper 用です。新しい canonical report では `assert` が返す `TestAssertion` を[優先/ゆうせん]します。
fn check <(bool)->Result<(),str>> (okv):
    if:
        okv
        then:
            Result<(),str>::Ok ()
        else:
            Result<(),str>::Err "check failed"

fn check_eq_i32 <(i32,i32)->Result<(),str>> (expected, actual):
    let a <TestAssertion> assert_eq_i32 expected actual
    match a.status:
        AssertionStatus::Passed:
            Result<(),str>::Ok ()
        AssertionStatus::Failed:
            Result<(),str>::Err a.message

fn check_ne <(bool,bool)->Result<(),str>> (a, b):
    let assertion <TestAssertion> assert_ne a b
    match assertion.status:
        AssertionStatus::Passed:
            Result<(),str>::Ok ()
        AssertionStatus::Failed:
            Result<(),str>::Err assertion.message

fn check_str_eq <(str,str)->Result<(),str>> (expected, actual):
    let a <TestAssertion> assert_str_eq expected actual
    match a.status:
        AssertionStatus::Passed:
            Result<(),str>::Ok ()
        AssertionStatus::Failed:
            Result<(),str>::Err a.message

fn check_ok_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    let a <TestAssertion> assert_ok_i32 r
    match a.status:
        AssertionStatus::Passed:
            Result<(),str>::Ok ()
        AssertionStatus::Failed:
            Result<(),str>::Err a.message

fn check_err_i32 <(Result<i32,i32>)->Result<(),str>> (r):
    let a <TestAssertion> assert_err_i32 r
    match a.status:
        AssertionStatus::Passed:
            Result<(),str>::Ok ()
        AssertionStatus::Failed:
            Result<(),str>::Err a.message

//: test_report_new: [空/から] report を[作/つく]る
fn test_report_new <(str)->TestReport> (name):
    TestReport name 0 0 "" "[" ""

fn test_report_default <()->TestReport> ():
    test_report_new "checks"

fn test_assertion_from_result <(str,Result<(),str>)->TestAssertion> (label, r):
    match r:
        Result::Ok v:
            test_assertion_ok label
        Result::Err e:
            test_assertion_fail label e

fn test_report_legacy_status <(TestAssertion)->str> (a):
    match a.status:
        AssertionStatus::Passed:
            "ok"
        AssertionStatus::Failed:
            concat "err " a.message

fn test_report_assertion_line <(i32,TestAssertion)->str> (idx, a):
    let idx_text <str> from_i32 idx
    let status_text <str> assertion_status_name a.status
    let kind_text <str> assertion_kind_name a.kind
    let label_text <str> json::json_quote_string a.label
    let expected_text <str> json::json_quote_string a.expected
    let actual_text <str> json::json_quote_string a.actual
    let message_text <str> json::json_quote_string a.message
    let l0 <str> concat "assertion index=" idx_text
    let l1 <str> concat l0 " status="
    let l2 <str> concat l1 status_text
    let l3 <str> concat l2 " kind="
    let l4 <str> concat l3 kind_text
    let l5 <str> concat l4 " label="
    let l6 <str> concat l5 label_text
    let l7 <str> concat l6 " expected="
    let l8 <str> concat l7 expected_text
    let l9 <str> concat l8 " actual="
    let l10 <str> concat l9 actual_text
    let l11 <str> concat l10 " message="
    let l12 <str> concat l11 message_text
    concat l12 "\n"

//: test_report_push: report に assertion を[追加/ついか]する
fn test_report_push <(TestReport,TestAssertion)*>TestReport> (report, assertion):
    let count0 <i32> report.count
    let failed1 <i32> match assertion.status:
        AssertionStatus::Passed:
            report.failed_count
        AssertionStatus::Failed:
            add report.failed_count 1
    let line <str> test_report_assertion_line count0 assertion
    let lines1 <str> concat report.lines line
    let legacy_status <str> test_report_legacy_status assertion
    let sep <str> if eq count0 0 "" ","
    let legacy_summary0 <str> concat report.legacy_summary sep
    let legacy_summary1 <str> concat legacy_summary0 legacy_status
    let idx_text <str> from_i32 count0
    let human0 <str> concat "[" idx_text
    let human1 <str> concat human0 "] "
    let human2 <str> concat human1 legacy_status
    let human3 <str> concat human2 "\n"
    let legacy_human1 <str> concat report.legacy_human human3
    TestReport report.name add count0 1 failed1 lines1 legacy_summary1 legacy_human1

fn test_report_push <(TestReport,Result<(),str>)*>TestReport> (report, r):
    test_report_push report test_assertion_from_result "result" r

//: test_report_render: report を canonical stdout [文字列/もじれつ]へ[整形/せいけい]する
fn test_report_render <(TestReport)->str> (report):
    let name_text <str> json::json_quote_string report.name
    let count_text <str> from_i32 report.count
    let failed_text <str> from_i32 report.failed_count
    let h0 <str> concat "test_report name=" name_text
    let h1 <str> concat h0 " count="
    let h2 <str> concat h1 count_text
    let h3 <str> concat h2 " failed="
    let h4 <str> concat h3 failed_text
    let h5 <str> concat h4 "\n"
    concat h5 report.lines

//: test_report_print_stdout: report を stdout に[表示/ひょうじ]する
//:
//: [注意/ちゅうい]:
//: - stdout を[出/だ]す canonical API はこの関数だけです。
#if[target=std]
fn test_report_print_stdout <(TestReport)*>TestReport> (report):
    print test_report_render report
    report

fn test_report_has_failure <(TestReport)->bool> (report):
    gt report.failed_count 0

//: test_report_exit_code: report を 0/1 の[終了/しゅうりょう] code へ[変換/へんかん]する
fn test_report_exit_code <(TestReport)->i32> (report):
    if:
        test_report_has_failure report
        then:
            1
        else:
            0

fn test_report_legacy_summary_text <(TestReport)->str> (report):
    concat report.legacy_summary "]"

//: checks_new: `TestReport` の[短/みじか]い[作成/さくせい]入口
fn checks_new <()*>TestReport> ():
    test_report_default

fn checks_empty <()->TestReport> ():
    test_report_default

fn checks_single_error <(str)*>TestReport> (msg):
    test_report_push test_report_default test_assertion_fail "result" msg

fn checks_push <(TestReport,TestAssertion)*>TestReport> (report, assertion):
    test_report_push report assertion

fn checks_push <(TestReport,Result<(),str>)*>TestReport> (report, r):
    test_report_push report r

fn checks_has_err <(TestReport)->bool> (report):
    test_report_has_failure report

fn checks_summary <(TestReport)->str> (report):
    test_report_legacy_summary_text report

#if[target=std]
fn checks_print_machine <(TestReport)*>TestReport> (report):
    let summary <str> test_report_legacy_summary_text report
    if:
        test_report_has_failure report
        then:
            println concat "FAIL: " summary
        else:
            println concat "Checked " summary
    report

#if[target=std]
fn checks_print_human <(TestReport)*>TestReport> (report):
    print report.legacy_human
    report

#if[target=std]
fn checks_print_report <(TestReport)*>TestReport> (report):
    report
    |> checks_print_machine
    |> checks_print_human

fn finish_checks <(TestReport)*>Result<(),str>> (report):
    if:
        test_report_has_failure report
        then:
            Result<(),str>::Err test_report_legacy_summary_text report
        else:
            Result<(),str>::Ok ()

fn result_exit_code <(Result<(),str>)->i32> (r):
    match r:
        Result::Ok v:
            0
        Result::Err e:
            1

fn test_assertion_exit_code <(TestAssertion)->i32> (assertion):
    match assertion.status:
        AssertionStatus::Passed:
            0
        AssertionStatus::Failed:
            1

fn checks_exit_code <(TestReport)*>i32> (report):
    test_report_exit_code report
