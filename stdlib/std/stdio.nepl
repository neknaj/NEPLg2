//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print ansi_white;
//: ```
fn ansi_white <()->str> ():
    "\x1b[37m"

//: ansi_gray: 灰色コード
//:
//: 目的:
//: - ANSI の灰色コードを返します。
//:
//: 実装(アルゴリズム):
//: - 文字列リテラルを返します。
//:
//: 注意(重要):
//: - 端末が ANSI に対応している必要があります。
//:
//: 計算量:
//: - O(1)
//: ansi_gray: 使い方の最小例
//:
//: [目的/もくてき]:
