#indent 4

#import "alloc/collections/vec" as *
#import "alloc/io" as *
#import "alloc/string" as string
#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "std/text" as *
pub #import "./stdio/raw" as *

//: stdio_fd_read_into_result: WASI fd_read の iov/nread scratch を安全な境界へ閉じ込める
//:
//: [目的/もくてき]:
//: - `fd_read` の ABI が要求する iovec と nread の raw memory layout を stdio 内部へ閉じ込め、呼び出し側には「読めた byte 数」だけを返します。
//:
//: [実装/じっそう]:
//: - caller が所有する `iov` 8 byte と `nread` 4 byte を、この関数内で初期化してから `fd_read` を呼びます。
//: - `nread` は同じ関数内で `0` に初期化したうえで読み戻すため、任意 pointer を読む汎用 helper を作らず ResourceIR の初期化追跡に沿わせます。
//:
//: [注意/ちゅうい]:
//: - `iov` は 8 byte、`nread` は 4 byte の有効領域である必要があります。
//: - `data_len > 0` の場合、`data` は `data_len` byte 以上の有効領域を指している必要があります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn stdio_fd_read_into_result <(i32,MemPtr<u8>,MemPtr<u8>,MemPtr<u8>,i32)*>Result<i32, StdErrorKind>> (fd, iov, nread, data, data_len):
    if:
        lt data_len 0
        then:
            Result<i32, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq data_len 0
                then:
                    Result<i32, StdErrorKind>::Ok 0
                else:
                    let iov_raw <i32> mem_ptr_addr iov
                    let nread_raw <i32> mem_ptr_addr nread
                    let data_raw <i32> mem_ptr_addr data
                    if:
                        or or le iov_raw 0 le nread_raw 0 le data_raw 0
                        then:
                            Result<i32, StdErrorKind>::Err StdErrorKind::InvalidOperation
                        else:
                            store_i32 iov_raw data_raw
                            store_i32 add iov_raw 4 data_len
                            store_i32 nread_raw 0
                            let errno <i32> stdio_fd_read_mem fd iov 1 nread
                            if:
                                ne errno 0
                                then:
                                    Result<i32, StdErrorKind>::Err StdErrorKind::IoError
                                else:
                                    Result<i32, StdErrorKind>::Ok load_i32 nread_raw

//: stdio_finish_read_buffer: capacity 付き読込 buffer を ByteBuf の所有権 invariant へ詰め直す
//:
//: [目的/もくてき]:
//: - `alloc_ptr` / `realloc_ptr` で確保した一時読込 buffer を、`ByteBuf.ptr` が `ByteBuf.len` byte の所有領域を指す形へ戻します。
//:
//: [実装/じっそう]:
//: - 読込長が 0 の場合は元 buffer を解放し、空 `ByteBuf` を返します。
//: - 読込長が capacity 未満の場合は exact-size に shrink してから `ByteBuf` にします。
//:
//: [注意/ちゅうい]:
//: - 成功時は返った `ByteBuf` が buffer を所有します。
//: - 失敗時はこの関数が元 buffer を解放します。
//:
//: [計算量/けいさんりょう]:
//: - allocator の shrink に依存します。copy が発生する場合は O(data_len) です。
fn stdio_finish_read_buffer <(MemPtr<u8>,i32,i32)*>Result<ByteBuf, StdErrorKind>> (buf, cap, data_len):
    if:
        or or lt cap 0 lt data_len 0 gt data_len cap
        then:
            if:
                gt cap 0
                then:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _e:
                            ()
                else:
                    ()
            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq data_len 0
                then:
                    if:
                        gt cap 0
                        then:
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ()
                        else:
                            ()
                    Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_empty
                else:
                    if:
                        eq data_len cap
                        then:
                            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr buf data_len
                        else:
                            match realloc_ptr<u8> buf cap data_len:
                                Result::Ok exact:
                                    Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr exact data_len
                                Result::Err _e:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e2:
                                            ()
                                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: stdio: 標準入出力（WASI / LLVM）
//:
//: 目的:
//: - `print` / `read_line` などの基本 I/O を target 非依存で提供します。
//:
//: 実装(アルゴリズム):
//: - wasm では `std/stdio/raw` の WASI `fd_read` / `fd_write` を呼びます。
//: - llvm では `std/stdio/raw` の Linux `syscall(read/write)` fallback を使います。
//: - 文字列は [len][bytes] の形式です。
//:
//: 注意(重要):
//: - text 入力は growable buffer で EOF まで読み込みます。
//: - 既存の `print` 系 API は互換性のため error を無視します。error を扱う場合は `stdio_write_*_result` を使います。
//:
//: 計算量:
//: - 文字列長に比例

//: ## stdio_write_fd_mem_result
//: fd を[指定/してい]して byte span を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - stdout / stderr などの fd [差/さ]だけを[分/わ]け、partial write [吸収/きゅうしゅう]と error [返却/へんきゃく]を 1 [箇所/かしょ]へ[集約/しゅうやく]します。
//:
//: ### [実装/じっそう]
//: - WASI `fd_write(fd, iov, 1, nwritten)` を[呼/よ]び、`nwritten` が[残/のこ]り byte [数/すう]より[小/ちい]さい[場合/ばあい]は offset を[進/すす]めて[再試行/さいしこう]します。
//: - `fd_write` error、`nwritten == 0`、iov [確保/かくほ][失敗/しっぱい]は `StdErrorKind::IoError` へ[正規化/せいきか]します。
//:
//: ### [注意/ちゅうい]
//: - `data` の[所有権/しょゆうけん]は[受/う]け[取/と]りません。呼び出し側が lifetime と解放を[管理/かんり]します。
//: - fd の[妥当性/だとうせい]は host WASI runtime に[委/ゆだ]ね、invalid fd は `Err(IoError)` として[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_fd_mem_result <(i32,MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (fd, data, data_len):
    let data_ptr <i32> mem_ptr_addr data;
    if:
        le data_len 0
        then:
            Result<(), StdErrorKind>::Ok ()
        else:
            match std_alloc 8:
                Result::Err _:
                    Result<(), StdErrorKind>::Err StdErrorKind::IoError
                Result::Ok iov:
                    match std_alloc 4:
                        Result::Err _:
                            std_free iov 8;
                            Result<(), StdErrorKind>::Err StdErrorKind::IoError
                        Result::Ok nwritten:
                            let mut off <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            while eq done 0:
                                do:
                                    if:
                                        ge off data_len
                                        then:
                                            set done 1;
                                            ()
                                        else:
                                            store_i32 iov add data_ptr off;
                                            store_i32 add iov 4 sub data_len off;
                                            store_i32 nwritten 0;
                                            let errno <i32> fd_write fd iov 1 nwritten;
                                            if:
                                                ne errno 0
                                                then:
                                                    set failed 1;
                                                    set done 1;
                                                    ()
                                                else:
                                                    let n <i32> load_i32 nwritten;
                                                    if:
                                                        le n 0
                                                        then:
                                                            set failed 1;
                                                            set done 1;
                                                            ()
                                                        else:
                                                            set off add off n;
                                                            ();
                            std_free nwritten 4;
                            std_free iov 8;
                            if:
                                eq failed 0
                                then:
                                    Result<(), StdErrorKind>::Ok ()
                                else:
                                    Result<(), StdErrorKind>::Err StdErrorKind::IoError

//: ## stdio_write_mem_result
//: byte span を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `print` より[低水準/ていすいじゅん]で、stdout write [失敗/しっぱい]を caller が[検出/けんしゅつ]できるようにします。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_mem_result <(MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (data, data_len):
    stdio_write_fd_mem_result 1 data data_len

//: ## stdio_write_stderr_mem_result
//: byte span を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - diagnostic 出力を stdout と[分離/ぶんり]し、stderr write [失敗/しっぱい]を caller が[扱/あつか]えるようにします。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_stderr_mem_result <(MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (data, data_len):
    stdio_write_fd_mem_result 2 data data_len

//: ## stdio_write_mem
//: byte span を stdout へ[書/か]き[出/だ]す互換 facade
//:
//: ### [目的/もくてき]
//: - 既存の `print` / `print_byte` が unit API のまま[使/つか]えるようにします。
//:
//: ### [注意/ちゅうい]
//: - error は[呼/よ]び[出/だ]し[側/がわ]へ[返/かえ]しません。新しい code は `stdio_write_mem_result` を[使/つか]います。
fn stdio_write_mem <(MemPtr<u8>,i32)*>()> (data, data_len):
    match stdio_write_mem_result data data_len:
        Result::Ok _:
            ()
        Result::Err _:
            ()

//: ## stdio_write_stderr_mem
//: byte span を stderr へ[書/か]き[出/だ]す互換 facade
//:
//: ### [注意/ちゅうい]
//: - error は[呼/よ]び[出/だ]し[側/がわ]へ[返/かえ]しません。diagnostic caller は `stdio_write_stderr_mem_result` を[使/つか]います。
fn stdio_write_stderr_mem <(MemPtr<u8>,i32)*>()> (data, data_len):
    match stdio_write_stderr_mem_result data data_len:
        Result::Ok _:
            ()
        Result::Err _:
            ()

//: ## stdio_write_str_result
//: `str` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
fn stdio_write_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_mem_result string_data_ptr s len s

//: ## stdio_write_stderr_str_result
//: `str` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
fn stdio_write_stderr_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_stderr_mem_result string_data_ptr s len s

//: ## stdio_write_bytes_result
//: `ByteBuf` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` が binary write を `str` [変換/へんかん]なしで[実行/じっこう]し、stdout write [失敗/しっぱい]を[保持/ほじ]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data_len <i32> get bytes "len";
    match get bytes "ptr":
        Option::None:
            if:
                eq data_len 0
                then:
                    Result<(), StdErrorKind>::Ok ()
                else:
                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
        Option::Some data:
            let result <Result<(), StdErrorKind>> stdio_write_mem_result data data_len;
            match dealloc_ptr<u8> data io_bytebuf_storage_size data_len:
                Result::Ok _:
                    result
                Result::Err _e:
                    result

//: ## stdio_write_stderr_bytes_result
//: `ByteBuf` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
fn stdio_write_stderr_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data_len <i32> get bytes "len";
    match get bytes "ptr":
        Option::None:
            if:
                eq data_len 0
                then:
                    Result<(), StdErrorKind>::Ok ()
                else:
                    Result<(), StdErrorKind>::Err StdErrorKind::InvalidOperation
        Option::Some data:
            let result <Result<(), StdErrorKind>> stdio_write_stderr_mem_result data data_len;
            match dealloc_ptr<u8> data io_bytebuf_storage_size data_len:
                Result::Ok _:
                    result
                Result::Err _e:
                    result

//: ## stdio_write_bytes
//: `ByteBuf` を stdout へ[書/か]き[出/だ]す互換 facade
fn stdio_write_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()

//: ## stdio_write_stderr_bytes
//: `ByteBuf` を stderr へ[書/か]き[出/だ]す互換 facade
fn stdio_write_stderr_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_stderr_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()

//: print_byte: 1 byte を stdout へ出力する
//:
//: [目的/もくてき]:
//: - binary/VM 系の処理で、`str` を組み立てずに 1 byte だけを stdout へ書き出します。
//:
//: [実装/じっそう]:
//: - 1 byte の一時 buffer を確保して値を書き、`stdio_write_mem` で出力してから解放します。
//:
//: [注意/ちゅうい]:
//: - `b` の下位 8 bit が出力されます。
//: - UTF-8 文字列としての妥当性は検証しません。text 出力には `print` / `println` を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[normalize_newlines]
//: stdout: "A"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print_byte 'A'
//: ```
fn print_byte <(i32)*>()> (b):
    match alloc_ptr<u8> 1:
        Result::Err _e:
            ()
        Result::Ok out:
            match store_u8 out b:
                Result::Ok _:
                    stdio_write_mem out 1
                Result::Err _e:
                    ()
            match dealloc_ptr<u8> out 1:
                Result::Ok _:
                    ()
                Result::Err _e:
                    ()

//: ## stdio_read_all_bytes_result
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]み、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` や `StreamScanner` の binary read [入口/いりぐち]として、stdin [全体/ぜんたい]を `ByteBuf` として[保持/ほじ]します。
//:
//: ### [実装/じっそう]
//: - 64KiB から[開始/かいし]して buffer を[必要/ひつよう]に[応/おう]じて[拡張/かくちょう]し、EOF まで `fd_read` を[反復/はんぷく]します。
//: - [返/かえ]り[値/あたい]の `ByteBuf` は[呼/よ]び[出/だ]し[側/がわ]が[所有/しょゆう]します。
//: - allocation failure / invalid read boundary / fd_read failure は、それぞれ `StdErrorKind` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - text helper `read_all` とは[別経路/べつけいろ]です。text [変換/へんかん]を[伴/ともな]わないため、NUL を[含/ふく]む入力もそのまま[保持/ほじ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [読/よ]み[込/こ]んだ byte [数/すう]を n として O(n) です。
fn stdio_read_all_bytes_result <()*>Result<ByteBuf, StdErrorKind>> ():
    let mut cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok buf0:
            let mut buf <MemPtr<u8>> buf0;
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _e2:
                            ();
                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok iov:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                        Result::Ok nread_ptr:
                            let mut read_len <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            let mut failure <StdErrorKind> StdErrorKind::Failure;

                            while eq done 0:
                                do:
                                    if:
                                        eq read_len cap
                                        then:
                                            let new_cap <i32> mul cap 2;
                                            if:
                                                le new_cap cap
                                                then:
                                                    set failed 1;
                                                    set failure StdErrorKind::CapacityExceeded;
                                                    set done 1;
                                                else:
                                                    match realloc_ptr<u8> buf cap new_cap:
                                                        Result::Ok new_buf:
                                                            set buf new_buf;
                                                            set cap new_cap;
                                                        Result::Err _e:
                                                            set failed 1;
                                                            set failure StdErrorKind::OutOfMemory;
                                                            set done 1;
                                        else:
                                            ();

                                    if:
                                        eq done 0
                                        then:
                                            let remaining <i32> sub cap read_len;
                                            match stdio_fd_read_into_result 0 iov nread_ptr mem_ptr_add buf read_len remaining:
                                                Result::Err e:
                                                    set failed 1;
                                                    set failure e;
                                                    set done 1;
                                                Result::Ok n:
                                                    if:
                                                        or lt n 0 gt n remaining
                                                        then:
                                                            set failed 1;
                                                            set failure StdErrorKind::InvalidOperation;
                                                            set done 1;
                                                        else:
                                                            if:
                                                                eq n 0
                                                                then:
                                                                    set done 1;
                                                                else:
                                                                    set read_len add read_len n;
                                        else:
                                            ();

                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            match dealloc_ptr<u8> nread_ptr 4:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();

                            if:
                                eq failed 1
                                then:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e:
                                            ();
                                    Result<ByteBuf, StdErrorKind>::Err failure
                                else:
                                    stdio_finish_read_buffer buf cap read_len

//: ## stdio_read_all_bytes
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]む互換 facade
fn stdio_read_all_bytes <()*>ByteBuf> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            bytes
        Result::Err _e:
            io_bytebuf_empty

//: print: 文字列を標準出力へ出す
//:
//: 目的:
//: - s をそのまま stdout に書き込みます。
//:
//: 実装(アルゴリズム):
//: - `stdio_write_mem` を[使/つか]い、partial write を[吸収/きゅうしゅう]しながら stdout へ[書/か]き[出/だ]します。
//:
//: 注意(重要):
//: - エラーは無視します。
//:
//: 計算量:
//: - O(n)
//: print: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print "sample";
//: ```
fn noshadow print <(str)*>()> (s):
    stdio_write_mem string_data_ptr s len s

//: stdio_read_all_text_result: 標準入力を UTF-8 [検証/けんしょう]して[読/よ]み[込/こ]む
//:
//: [目的/もくてき]:
//: - stdin の raw byte [列/れつ]を text として[扱/あつか]う[前/まえ]に UTF-8 として[妥当/だとう]か[検証/けんしょう]し、invalid input を caller へ `Result` で[返/かえ]します。
//:
//: [実装/じっそう]:
//: - `stdio_read_all_bytes_result` で EOF まで[読/よ]み、成功時だけ `std/text` の checked conversion へ[委譲/いじょう]します。
//:
//: [注意/ちゅうい]:
//: - 入力 buffer は成功時も失敗時も[消費/しょうひ]されます。
//: - 互換 API の `read_all` は、この関数の失敗を空文字列へ[丸/まる]めます。error を[扱/あつか]うコードではこの関数を[使/つか]ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn stdio_read_all_text_result <()*>Result<str, StdErrorKind>> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            text_bytebuf_to_utf8_str_result bytes
        Result::Err e:
            Result<str, StdErrorKind>::Err e

//: read_all: 標準入力を EOF まで読み込む
//:
//: 目的:
//: - stdin から EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - `stdio_read_all_text_result` で UTF-8 検証付きの text read を行います。
//:
//: 注意(重要):
//: - 失敗時は空文字列を返します。
//: - error を扱う必要がある場合は `stdio_read_all_text_result` を使ってください。
//:
//: 計算量:
//: - O(n)
//: read_all: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_all` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "sample input"
//: stdout: "sample input"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_all;
//: ```
fn read_all <()*>str> ():
    match stdio_read_all_text_result:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: stdio_read_line_result: 1 行を UTF-8 検証付きで読み込む
//:
//: 目的:
//: - newline か EOF まで raw bytes を読み込み、UTF-8 として妥当な場合だけ `str` として返します。
//:
//: 実装(アルゴリズム):
//: - 1 バイトずつ `fd_read` し、改行または EOF で停止します。
//: - 読み込んだ byte 列は exact-size の `ByteBuf` に詰め直してから `text_bytebuf_to_utf8_str_result` へ渡します。
//:
//: 注意(重要):
//: - 最大 1024 バイトまでです。
//: - 失敗時は `StdErrorKind` を返します。互換 API の `read_line` は失敗を空文字列へ丸めます。
//:
//: 計算量:
//: - O(n)
fn stdio_read_line_result <()*>Result<str, StdErrorKind>> ():
    let cap <i32> 1024;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok buf:
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _e2:
                            ();
                    Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok iov:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                        Result::Ok nread:
                            let mut line_len <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            let mut failure <StdErrorKind> StdErrorKind::Failure;

                            while eq done 0:
                                do:
                                    if:
                                        ge line_len cap
                                        then:
                                            set done 1;
                                        else:
                                            let write_ptr <MemPtr<u8>> mem_ptr_add buf line_len;
                                            let write_raw <i32> mem_ptr_addr write_ptr;
                                            if:
                                                le write_raw 0
                                                then:
                                                    set failed 1;
                                                    set failure StdErrorKind::InvalidOperation;
                                                    set done 1;
                                                else:
                                                    store_u8 write_raw 0;
                                                    match stdio_fd_read_into_result 0 iov nread write_ptr 1:
                                                        Result::Err e:
                                                            set failed 1;
                                                            set failure e;
                                                            set done 1;
                                                        Result::Ok n:
                                                            if:
                                                                or lt n 0 gt n 1
                                                                then:
                                                                    set failed 1;
                                                                    set failure StdErrorKind::InvalidOperation;
                                                                    set done 1;
                                                                else:
                                                                    if:
                                                                        eq n 0
                                                                        then:
                                                                            set done 1;
                                                                        else:
                                                                            let b <i32> load_u8 write_raw;
                                                                            if:
                                                                                eq b '\n'
                                                                                then:
                                                                                    set done 1;
                                                                                else:
                                                                                    set line_len add line_len 1;

                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            match dealloc_ptr<u8> nread 4:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();

                            if:
                                eq failed 1
                                then:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e:
                                            ();
                                    Result<str, StdErrorKind>::Err failure
                                else:
                                    match stdio_finish_read_buffer buf cap line_len:
                                        Result::Err e:
                                            Result<str, StdErrorKind>::Err e
                                        Result::Ok bytes:
                                            text_bytebuf_to_utf8_str_result bytes

//: read_line: 1 行読み込む
//:
//: 目的:
//: - newline か EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - `stdio_read_line_result` に委譲し、raw byte 列を UTF-8 として検証してから `str` にします。
//:
//: 注意(重要):
//: - 最大 1024 バイトまでです。
//: - 失敗時は空文字列を返します。error を扱う必要がある場合は `stdio_read_line_result` を使ってください。
//:
//: 計算量:
//: - O(n)
//: read_line: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_line` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "line1\nline2"
//: stdout: "line1"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_line;
//: ```
fn noshadow read_line <()*>str> ():
    match stdio_read_line_result:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: println: 改行付き出力
//:
//: 目的:
//: - s を出力し、改行を追加します。
//:
//: 実装(アルゴリズム):
//: - print を 2 回呼びます。
//:
//: 注意(重要):
//: - 改行は "\n" 固定です。
//:
//: 計算量:
//: - O(n)
//: println: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     println "sample";
//: ```
fn noshadow println <(str)*>()> (s):
    print s;
    print "\n";
    ()

//: print_i32: i32 を文字列にして出力
//:
//: 目的:
//: - v を 10 進文字列にして出力します。
//:
//: 実装(アルゴリズム):
//: - 整数の文字列化は `alloc/string::from_i32` に委譲し、stdio は出力だけを担当します。
//:
//: 注意(重要):
//: - 文字列化に必要な allocation に失敗した場合は `from_i32` の fallback に従います。
//:
//: 計算量:
//: - O(d)
//: print_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print_i32 42;
//: ```
fn noshadow print_i32 <(i32)*>()> (v):
    print string::from_i32 v;
    ()

//: println_i32: i32 を改行付きで出力
//:
//: 目的:
//: - print_i32 の後に改行を出力します。
//:
//: 実装(アルゴリズム):
//: - print_i32 と print("\n") を呼びます。
//:
//: 注意(重要):
