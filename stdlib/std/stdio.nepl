//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "\u001b[31msample\u001b[0m\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     println_color ansi_red "sample";
//: ```
fn println_color <(str,str)*>()> (color, s):
    print_color color s;
    print "\n";

