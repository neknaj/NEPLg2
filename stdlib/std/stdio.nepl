//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     println_i32 42;
//: ```
fn noshadow println_i32 <(i32)*>()> (v):
    print_i32 v;
    print "\n";

