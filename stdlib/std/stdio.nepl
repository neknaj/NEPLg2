#indent 4

#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_read" fn fd_read <(i32,i32,i32,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_write" fn fd_write <(i32,i32,i32,i32)*>i32>

#if[target=llvm]
#extern "c" "syscall" fn __nepl_syscall <(i64,i64,i64,i64,i64,i64,i64)*>i64>


#import "alloc/collections/vec" as *
#import "alloc/io" as *
#import "alloc/string" as string
#import "core/mem" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/result" as *
#import "std/text" as *

fn std_alloc <(i32)->Result<i32,str>> (size):
    alloc size

fn std_free <(i32,i32)->()> (ptr, size):
    match dealloc ptr size:
        Result::Ok _:
            ()
        Result::Err _:
            ()

fn std_store_i32_at <(MemPtr<u8>,i32,i32,i32)->Result<(),str>> (base, size, off, v):
    match region_ptr_at<u8,i32> region_new base size off:
        Result::Err _e:
            Result<(),str>::Err "stdio.mem store_i32 oob"
        Result::Ok p:
            store_i32 p v

fn std_load_i32_at <(MemPtr<u8>,i32,i32)->Result<i32,str>> (base, size, off):
    match region_ptr_at<u8,i32> region_new base size off:
        Result::Err _e:
            Result<i32,str>::Err "stdio.mem load_i32 oob"
        Result::Ok p:
            match load_i32 p:
                Option::Some v:
                    Result<i32,str>::Ok v
                Option::None:
                    Result<i32,str>::Err "stdio.mem load_i32 failed"

fn stdio_fd_read_mem <(i32,MemPtr<u8>,i32,MemPtr<u8>)*>i32> (fd, iov, iovcnt, nread):
    fd_read fd mem_ptr_addr iov iovcnt mem_ptr_addr nread

//: stdio: 標準入出力（WASI / LLVM）
//:
//: 目的:
//: - `print` / `read_line` などの基本 I/O を target 非依存で提供します。
//:
//: 実装(アルゴリズム):
//: - wasm では WASI `fd_read` / `fd_write` を呼びます。
//: - llvm では Linux の `syscall(read/write)` で互換 `fd_read` / `fd_write` を実装します。
//: - 文字列は [len][bytes] の形式です。
//:
//: 注意(重要):
//: - text 入力は growable buffer で EOF まで読み込みます。
//: - 既存の `print` 系 API は互換性のため error を無視します。error を扱う場合は `stdio_write_*_result` を使います。
//:
//: 計算量:
//: - 文字列長に比例

#if[target=llvm]
fn __linux_syscall_rw <(i32,i32,i32,i32)*>i64> (nr,fd,ptr,len):
    #llvmir:
        define i64 @__linux_syscall_rw(i32 %nr, i32 %fd, i32 %ptr, i32 %len) {
        entry:
            %nr64 = zext i32 %nr to i64
            %fd64 = zext i32 %fd to i64
            %len64 = zext i32 %len to i64
            %idx = zext i32 %ptr to i64
            %buf = getelementptr [67108864 x i8], ptr @__nepl_mem, i64 0, i64 %idx
            %buf64 = ptrtoint ptr %buf to i64
            %ret = call i64 @__nepl_syscall(i64 %nr64, i64 %fd64, i64 %buf64, i64 %len64, i64 0, i64 0, i64 0)
            ret i64 %ret
        }

#if[target=llvm]
fn fd_write <(i32,i32,i32,i32)*>i32> (_fd,iovs,iovs_len,nwritten_ptr):
    let mut total <i32> 0;
    let mut iov_idx <i32> 0;
    let mut err <i32> 0;
    let mut done <i32> 0;
    let fd <i32> _fd;
    while eq done 0:
        do:
            if:
                cond:
                    lt iov_idx iovs_len
                then:
                    let iov_ptr <i32> add iovs mul iov_idx 8;
                    let base <i32> load_i32 iov_ptr;
                    let len <i32> load_i32 add iov_ptr 4;
                    // Linux x86_64: write(fd, buf, count)
                    let n64 <i64> __linux_syscall_rw 1 fd base len;
                    if:
                        cond:
                            lt n64 <i64> cast 0
                        then:
                            set err 1;
                            set done 1;
                        else:
                            let n <i32> cast n64;
                            set total add total n;
                            if:
                                cond:
                                    lt n len
                                then:
                                    set done 1;
                                else:
                                    ();
                    set iov_idx add iov_idx 1;
                else:
                    set done 1;
    store_i32 nwritten_ptr total;
    err

#if[target=llvm]
fn fd_read <(i32,i32,i32,i32)*>i32> (_fd,iovs,iovs_len,nread_ptr):
    let mut total <i32> 0;
    let mut iov_idx <i32> 0;
    let mut err <i32> 0;
    let mut done <i32> 0;
    let fd <i32> _fd;
    while eq done 0:
        do:
            if:
                cond:
                    lt iov_idx iovs_len
                then:
                    let iov_ptr <i32> add iovs mul iov_idx 8;
                    let base <i32> load_i32 iov_ptr;
                    let len <i32> load_i32 add iov_ptr 4;
                    // Linux x86_64: read(fd, buf, count)
                    let n64 <i64> __linux_syscall_rw 0 fd base len;
                    if:
                        cond:
                            lt n64 <i64> cast 0
                        then:
                            set err 1;
                            set done 1;
                        else:
                            let n <i32> cast n64;
                            set total add total n;
                            if:
                                cond:
                                    lt n len
                                then:
                                    set done 1;
                                else:
                                    ();
                    set iov_idx add iov_idx 1;
                else:
                    set done 1;
    store_i32 nread_ptr total;
    err

//: ## stdio_write_fd_mem_result
//: fd を[指定/してい]して byte span を[書/か]き[出/だ]す
//:
//: ### [目的/もくてき]
//: - stdout / stderr などの fd [差/さ]だけを[分/わ]け、partial write [吸収/きゅうしゅう]と error [返却/へんきゃく]を 1 [箇所/かしょ]へ[集約/しゅうやく]します。
//:
//: ### [実装/じっそう]
//: - WASI `fd_write(fd, iov, 1, nwritten)` を[呼/よ]び、`nwritten` が[残/のこ]り byte [数/すう]より[小/ちい]さい[場合/ばあい]は offset を[進/すす]めて[再試行/さいしこう]します。
//: - `fd_write` error、`nwritten == 0`、iov [確保/かくほ][失敗/しっぱい]は `StdErrorKind::IoError` へ[正規化/せいきか]します。
//:
//: ### [注意/ちゅうい]
//: - `data` の[所有権/しょゆうけん]は[受/う]け[取/と]りません。呼び出し側が lifetime と解放を[管理/かんり]します。
//: - fd の[妥当性/だとうせい]は host WASI runtime に[委/ゆだ]ね、invalid fd は `Err(IoError)` として[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_fd_mem_result <(i32,MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (fd, data, data_len):
    let data_ptr <i32> mem_ptr_addr data;
    if:
        le data_len 0
        then:
            Result<(), StdErrorKind>::Ok ()
        else:
            match std_alloc 8:
                Result::Err _:
                    Result<(), StdErrorKind>::Err StdErrorKind::IoError
                Result::Ok iov:
                    match std_alloc 4:
                        Result::Err _:
                            std_free iov 8;
                            Result<(), StdErrorKind>::Err StdErrorKind::IoError
                        Result::Ok nwritten:
                            let mut off <i32> 0;
                            let mut done <i32> 0;
                            let mut failed <i32> 0;
                            while eq done 0:
                                do:
                                    if:
                                        ge off data_len
                                        then:
                                            set done 1;
                                            ()
                                        else:
                                            store_i32 iov add data_ptr off;
                                            store_i32 add iov 4 sub data_len off;
                                            store_i32 nwritten 0;
                                            let errno <i32> fd_write fd iov 1 nwritten;
                                            if:
                                                ne errno 0
                                                then:
                                                    set failed 1;
                                                    set done 1;
                                                    ()
                                                else:
                                                    let n <i32> load_i32 nwritten;
                                                    if:
                                                        le n 0
                                                        then:
                                                            set failed 1;
                                                            set done 1;
                                                            ()
                                                        else:
                                                            set off add off n;
                                                            ();
                            std_free nwritten 4;
                            std_free iov 8;
                            if:
                                eq failed 0
                                then:
                                    Result<(), StdErrorKind>::Ok ()
                                else:
                                    Result<(), StdErrorKind>::Err StdErrorKind::IoError

//: ## stdio_write_mem_result
//: byte span を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `print` より[低水準/ていすいじゅん]で、stdout write [失敗/しっぱい]を caller が[検出/けんしゅつ]できるようにします。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_mem_result <(MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (data, data_len):
    stdio_write_fd_mem_result 1 data data_len

//: ## stdio_write_stderr_mem_result
//: byte span を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - diagnostic 出力を stdout と[分離/ぶんり]し、stderr write [失敗/しっぱい]を caller が[扱/あつか]えるようにします。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_stderr_mem_result <(MemPtr<u8>,i32)*>Result<(), StdErrorKind>> (data, data_len):
    stdio_write_fd_mem_result 2 data data_len

//: ## stdio_write_mem
//: byte span を stdout へ[書/か]き[出/だ]す互換 facade
//:
//: ### [目的/もくてき]
//: - 既存の `print` / `print_byte` が unit API のまま[使/つか]えるようにします。
//:
//: ### [注意/ちゅうい]
//: - error は[呼/よ]び[出/だ]し[側/がわ]へ[返/かえ]しません。新しい code は `stdio_write_mem_result` を[使/つか]います。
fn stdio_write_mem <(MemPtr<u8>,i32)*>()> (data, data_len):
    match stdio_write_mem_result data data_len:
        Result::Ok _:
            ()
        Result::Err _:
            ()

//: ## stdio_write_stderr_mem
//: byte span を stderr へ[書/か]き[出/だ]す互換 facade
//:
//: ### [注意/ちゅうい]
//: - error は[呼/よ]び[出/だ]し[側/がわ]へ[返/かえ]しません。diagnostic caller は `stdio_write_stderr_mem_result` を[使/つか]います。
fn stdio_write_stderr_mem <(MemPtr<u8>,i32)*>()> (data, data_len):
    match stdio_write_stderr_mem_result data data_len:
        Result::Ok _:
            ()
        Result::Err _:
            ()

//: ## stdio_write_str_result
//: `str` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
fn stdio_write_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_mem_result string_data_ptr s len s

//: ## stdio_write_stderr_str_result
//: `str` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
fn stdio_write_stderr_str_result <(str)*>Result<(), StdErrorKind>> (s):
    stdio_write_stderr_mem_result string_data_ptr s len s

//: ## stdio_write_bytes_result
//: `ByteBuf` を stdout へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` が binary write を `str` [変換/へんかん]なしで[実行/じっこう]し、stdout write [失敗/しっぱい]を[保持/ほじ]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
//:
//: ### [計算量/けいさんりょう]
//: - [書/か]き[込/こ]み byte [数/すう]を n として O(n) です。
fn stdio_write_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data <MemPtr<u8>> get bytes "ptr";
    let data_len <i32> get bytes "len";
    let result <Result<(), StdErrorKind>> stdio_write_mem_result data data_len;
    io_bytebuf_free bytes;
    result

//: ## stdio_write_stderr_bytes_result
//: `ByteBuf` を stderr へ[書/か]き[出/だ]し、失敗を `Result` で[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - `bytes` の[所有権/しょゆうけん]を[受/う]け[取/と]り、成功/失敗にかかわらず最後に解放します。
fn stdio_write_stderr_bytes_result <(ByteBuf)*>Result<(), StdErrorKind>> (bytes):
    let data <MemPtr<u8>> get bytes "ptr";
    let data_len <i32> get bytes "len";
    let result <Result<(), StdErrorKind>> stdio_write_stderr_mem_result data data_len;
    io_bytebuf_free bytes;
    result

//: ## stdio_write_bytes
//: `ByteBuf` を stdout へ[書/か]き[出/だ]す互換 facade
fn stdio_write_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()

//: ## stdio_write_stderr_bytes
//: `ByteBuf` を stderr へ[書/か]き[出/だ]す互換 facade
fn stdio_write_stderr_bytes <(ByteBuf)*>()> (bytes):
    match stdio_write_stderr_bytes_result bytes:
        Result::Ok _:
            ()
        Result::Err _:
            ()
    ()

//: print_byte: 1 byte を stdout へ出力する
//:
//: [目的/もくてき]:
//: - binary/VM 系の処理で、`str` を組み立てずに 1 byte だけを stdout へ書き出します。
//:
//: [実装/じっそう]:
//: - 1 byte の一時 buffer を確保して値を書き、`stdio_write_mem` で出力してから解放します。
//:
//: [注意/ちゅうい]:
//: - `b` の下位 8 bit が出力されます。
//: - UTF-8 文字列としての妥当性は検証しません。text 出力には `print` / `println` を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[normalize_newlines]
//: stdout: "A"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print_byte 'A'
//: ```
fn print_byte <(i32)*>()> (b):
    match alloc_ptr<u8> 1:
        Result::Err _e:
            ()
        Result::Ok out:
            match store_u8 out b:
                Result::Ok _:
                    stdio_write_mem out 1
                Result::Err _e:
                    ()
            match dealloc_ptr<u8> out 1:
                Result::Ok _:
                    ()
                Result::Err _e:
                    ()

//: ## stdio_read_all_bytes_result
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]み、失敗を `Result` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `std/streamio` や `StreamScanner` の binary read [入口/いりぐち]として、stdin [全体/ぜんたい]を `ByteBuf` として[保持/ほじ]します。
//:
//: ### [実装/じっそう]
//: - 64KiB から[開始/かいし]して buffer を[必要/ひつよう]に[応/おう]じて[拡張/かくちょう]し、EOF まで `fd_read` を[反復/はんぷく]します。
//: - [返/かえ]り[値/あたい]の `ByteBuf` は[呼/よ]び[出/だ]し[側/がわ]が[所有/しょゆう]します。
//: - allocation failure / memory helper failure / fd_read failure は、それぞれ `StdErrorKind` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - text helper `read_all` とは[別経路/べつけいろ]です。text [変換/へんかん]を[伴/ともな]わないため、NUL を[含/ふく]む入力もそのまま[保持/ほじ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [読/よ]み[込/こ]んだ byte [数/すう]を n として O(n) です。
fn stdio_read_all_bytes_result <()*>Result<ByteBuf, StdErrorKind>> ():
    let mut cap <i32> 65536;
    match alloc_ptr<u8> cap:
        Result::Err _e:
            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Result::Ok buf0:
            let mut buf <MemPtr<u8>> buf0;
            match alloc_ptr<u8> 8:
                Result::Err _e:
                    match dealloc_ptr<u8> buf cap:
                        Result::Ok _:
                            ()
                        Result::Err _e2:
                            ();
                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok iov:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            match dealloc_ptr<u8> buf cap:
                                Result::Ok _:
                                    ()
                                Result::Err _e2:
                                    ();
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                        Result::Ok nread_ptr:
                            let mut read_len <i32> 0;
                            let mut done <i32> 0;
                            let mut alloc_failed <i32> 0;
                            let mut mem_failed <i32> 0;
                            let mut io_failed <i32> 0;

                            while eq done 0:
                                do:
                                    if:
                                        eq read_len cap
                                        then:
                                            let new_cap <i32> mul cap 2;
                                            match realloc_ptr<u8> buf cap new_cap:
                                                Result::Ok new_buf:
                                                    set buf new_buf;
                                                    set cap new_cap;
                                                Result::Err _e:
                                                    set alloc_failed 1;
                                                    set done 1;
                                        else:
                                            ();

                                    if:
                                        eq done 0
                                        then:
                                            match std_store_i32_at iov 8 0 add mem_ptr_addr buf read_len:
                                                Result::Err _e:
                                                    set mem_failed 1;
                                                    set done 1;
                                                Result::Ok _:
                                                    match std_store_i32_at iov 8 4 sub cap read_len:
                                                        Result::Err _e:
                                                            set mem_failed 1;
                                                            set done 1;
                                                        Result::Ok _:
                                                            match std_store_i32_at nread_ptr 4 0 0:
                                                                Result::Err _e:
                                                                    set mem_failed 1;
                                                                    set done 1;
                                                                Result::Ok _:
                                                                    let errno <i32> stdio_fd_read_mem 0 iov 1 nread_ptr;
                                                                    if:
                                                                        ne errno 0
                                                                        then:
                                                                            set io_failed 1;
                                                                            set done 1;
                                                                        else:
                                                                            match std_load_i32_at nread_ptr 4 0:
                                                                                Result::Err _e:
                                                                                    set mem_failed 1;
                                                                                    set done 1;
                                                                                Result::Ok n:
                                                                                    if:
                                                                                        eq n 0
                                                                                        then:
                                                                                            set done 1;
                                                                                        else:
                                                                                            set read_len add read_len n;
                                        else:
                                            ();

                            match dealloc_ptr<u8> iov 8:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();
                            match dealloc_ptr<u8> nread_ptr 4:
                                Result::Ok _:
                                    ()
                                Result::Err _e:
                                    ();

                            if:
                                or or eq alloc_failed 1 eq mem_failed 1 eq io_failed 1
                                then:
                                    match dealloc_ptr<u8> buf cap:
                                        Result::Ok _:
                                            ()
                                        Result::Err _e:
                                            ();
                                    if:
                                        eq alloc_failed 1
                                        then:
                                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory
                                        else:
                                            if:
                                                eq mem_failed 1
                                                then:
                                                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                                else:
                                                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::IoError
                                else:
                                    Result<ByteBuf, StdErrorKind>::Ok ByteBuf buf read_len

//: ## stdio_read_all_bytes
//: stdin の[残/のこ]りを `ByteBuf` として[読/よ]み[込/こ]む互換 facade
fn stdio_read_all_bytes <()*>ByteBuf> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            bytes
        Result::Err _e:
            io_bytebuf_empty

//: print: 文字列を標準出力へ出す
//:
//: 目的:
//: - s をそのまま stdout に書き込みます。
//:
//: 実装(アルゴリズム):
//: - `stdio_write_mem` を[使/つか]い、partial write を[吸収/きゅうしゅう]しながら stdout へ[書/か]き[出/だ]します。
//:
//: 注意(重要):
//: - エラーは無視します。
//:
//: 計算量:
//: - O(n)
//: print: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print "sample";
//: ```
fn noshadow print <(str)*>()> (s):
    stdio_write_mem string_data_ptr s len s

//: stdio_read_all_text_result: 標準入力を UTF-8 [検証/けんしょう]して[読/よ]み[込/こ]む
//:
//: [目的/もくてき]:
//: - stdin の raw byte [列/れつ]を text として[扱/あつか]う[前/まえ]に UTF-8 として[妥当/だとう]か[検証/けんしょう]し、invalid input を caller へ `Result` で[返/かえ]します。
//:
//: [実装/じっそう]:
//: - `stdio_read_all_bytes_result` で EOF まで[読/よ]み、成功時だけ `std/text` の checked conversion へ[委譲/いじょう]します。
//:
//: [注意/ちゅうい]:
//: - 入力 buffer は成功時も失敗時も[消費/しょうひ]されます。
//: - 互換 API の `read_all` は、この関数の失敗を空文字列へ[丸/まる]めます。error を[扱/あつか]うコードではこの関数を[使/つか]ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn stdio_read_all_text_result <()*>Result<str, StdErrorKind>> ():
    match stdio_read_all_bytes_result:
        Result::Ok bytes:
            text_bytebuf_to_utf8_str_result bytes
        Result::Err e:
            Result<str, StdErrorKind>::Err e

//: read_all: 標準入力を EOF まで読み込む
//:
//: 目的:
//: - stdin から EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - `stdio_read_all_text_result` で UTF-8 検証付きの text read を行います。
//:
//: 注意(重要):
//: - 失敗時は空文字列を返します。
//: - error を扱う必要がある場合は `stdio_read_all_text_result` を使ってください。
//:
//: 計算量:
//: - O(n)
//: read_all: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_all` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "sample input"
//: stdout: "sample input"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_all;
//: ```
fn read_all <()*>str> ():
    match stdio_read_all_text_result:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: read_line: 1 行読み込む
//:
//: 目的:
//: - newline か EOF まで読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - 1 バイトずつ読み取り、改行か EOF で停止します。
//:
//: 注意(重要):
//: - 最大 1024 バイトまでです。
//: - 失敗時は短い文字列になる可能性があります。
//:
//: 計算量:
//: - O(n)
//: read_line: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `read_line` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "line1\nline2"
//: stdout: "line1"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print read_line;
//: ```
fn noshadow read_line <()*>str> ():
    let cap <i32> 1024;
    match std_alloc add 4 cap:
        Result::Err _:
            ""
        Result::Ok out:
            match std_alloc 8:
                Result::Err _:
                    std_free out add 4 cap;
                    ""
                Result::Ok iov:
                    match std_alloc 4:
                        Result::Err _:
                            std_free iov 8;
                            std_free out add 4 cap;
                            ""
                        Result::Ok nread:
                            let mut len <i32> 0;
                            let mut done <i32> 0;

                            while eq done 0:
                                if:
                                    lt len cap
                                    then:
                                        let out_base <i32> add out 4;
                                        let write_ptr <i32> add out_base len;
                                        store_i32 iov write_ptr;
                                        store_i32 add iov 4 1;
                                        store_i32 nread 0;
                                        let errno <i32> fd_read 0 iov 1 nread;
                                        if:
                                            eq errno 0
                                            then:
                                                let n <i32> load_i32 nread;
                                                if:
                                                    eq n 0
                                                    then:
                                                        set done 1;
                                                    else:
                                                        let out_base <i32> add out 4;
                                                        let read_ptr <i32> add out_base len;
                                                        let b <i32> load_u8 read_ptr;
                                                        if:
                                                            eq b '\n'
                                                            then:
                                                                set done 1;
                                                            else:
                                                                set len add len 1;
                                            else:
                                                set done 1;
                                    else:
                                        set done 1;
                            store_i32 out len;
                            std_free nread 4;
                            std_free iov 8;
                            string_from_addr_unchecked out

//: println: 改行付き出力
//:
//: 目的:
//: - s を出力し、改行を追加します。
//:
//: 実装(アルゴリズム):
//: - print を 2 回呼びます。
//:
//: 注意(重要):
//: - 改行は "\n" 固定です。
//:
//: 計算量:
//: - O(n)
//: println: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `println` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "sample\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     println "sample";
//: ```
fn noshadow println <(str)*>()> (s):
    print s;
    print "\n";
    ()

//: print_i32: i32 を文字列にして出力
//:
//: 目的:
//: - v を 10 進文字列にして出力します。
//:
//: 実装(アルゴリズム):
//: - 整数の文字列化は `alloc/string::from_i32` に委譲し、stdio は出力だけを担当します。
//:
//: 注意(重要):
//: - 文字列化に必要な allocation に失敗した場合は `from_i32` の fallback に従います。
//:
//: 計算量:
//: - O(d)
//: print_i32: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `print_i32` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "42"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print_i32 42;
//: ```
fn noshadow print_i32 <(i32)*>()> (v):
    print string::from_i32 v;
    ()

