#indent 4

pub #import "./stdio/raw" as *
pub #import "./stdio/write" as *
pub #import "./stdio/read" as *
pub #import "./stdio/print" as *

//: stdio: 標準入出力（WASI / LLVM）
//:
//: 目的:
//: - `print` / `read_line` などの基本 I/O を target 非依存で提供します。
//:
//: 実装(アルゴリズム):
//: - wasm では `std/stdio/raw` の WASI `fd_read` / `fd_write` を呼びます。
//: - llvm では `std/stdio/raw` の Linux `syscall(read/write)` fallback を使います。
//: - 文字列は [len][bytes] の形式です。
//:
//: 注意(重要):
//: - text 入力は growable buffer で EOF まで読み込みます。
//: - 既存の `print` 系 API は互換性のため error を無視します。error を扱う場合は `stdio_write_*_result` を使います。
//:
//: 計算量:
//: - 文字列長に比例

//: ansi_reset: 色リセットコード
//:
//: 目的:
//: - ANSI のリセットコードを返します。
//:
//: 実装(アルゴリズム):
//: - 文字列リテラルを返します。
//:
//: 注意(重要):
//: - 端末が ANSI に対応している必要があります。
//:
//: 計算量:
//: - O(1)
//: ansi_reset: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `ansi_reset` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdout: "\u001b[0m"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     print ansi_reset;
//: ```
fn ansi_reset <()->str> ():
    "\x1b[0m"

//: ansi_bold: 太字コード
//:
//: 目的:
//: - ANSI の太字コードを返します。
