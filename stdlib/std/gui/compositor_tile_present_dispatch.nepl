//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_dispatch_step_record %fn &GuiHost fn &GuiRgba8888CompositorTileRlePresentSchedulePolicy fn GuiRgba8888CompositorTileRlePresentDispatchState fn GuiRgba8888CompositorTileRlePresentHostCommandRecord Result GuiRgba8888CompositorTileRlePresentDispatchStep GuiRgba8888CompositorTileRlePresentDispatchStepError \host\policy\state\record:
