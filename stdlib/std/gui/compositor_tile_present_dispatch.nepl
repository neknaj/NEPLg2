    match gui_rgba8888_compositor_tile_rle_present_schedule_step_record policy schedule_state record:
        Result::Err lower_error:
            let lower_kind %GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind gui_rgba8888_compositor_tile_rle_present_schedule_step_error_kind &lower_error
            let lower_category %Option GuiError gui_rgba8888_compositor_tile_rle_present_schedule_step_error_category_value &lower_error
            let kind %GuiRgba8888CompositorTileRlePresentDispatchStepErrorKind GuiRgba8888CompositorTileRlePresentDispatchStepErrorKind::ScheduleFailed lower_kind
            Result::Err gui_rgba8888_compositor_tile_rle_present_dispatch_step_error kind lower_category state
        Result::Ok schedule_step:
            let schedule_phase %GuiRgba8888CompositorTileRlePresentSchedulePhase gui_rgba8888_compositor_tile_rle_present_schedule_step_phase &schedule_step
            let post_phase %GuiRgba8888CompositorTileRlePresentDispatchPostPhase gui_rgba8888_compositor_tile_rle_present_dispatch_post_phase_from_schedule schedule_phase
            match gui_rgba8888_compositor_tile_rle_present_host_import_request host record:
                Result::Err host_error:
                    let kind %GuiRgba8888CompositorTileRlePresentDispatchStepErrorKind GuiRgba8888CompositorTileRlePresentDispatchStepErrorKind::HostImportRequestFailed host_error
                    Result::Err gui_rgba8888_compositor_tile_rle_present_dispatch_step_error kind Option::Some host_error state
                Result::Ok request:
                    let next_schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_schedule_step_state &schedule_step
                    let next_state %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_state_new next_schedule
                    let ready %GuiRgba8888CompositorTileRlePresentDispatchReadyRequest gui_rgba8888_compositor_tile_rle_present_dispatch_ready_request_new request post_phase
                    let output %GuiRgba8888CompositorTileRlePresentDispatchOutput GuiRgba8888CompositorTileRlePresentDispatchOutput::RequestReady ready
                    Result::Ok gui_rgba8888_compositor_tile_rle_present_dispatch_step_new next_state output
