#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/compositor_tile_present" as *
#import "std/gui/compositor_tile_present_run_cursor" as *
#import "std/gui/tile_present_run_cursor" as *

//: GuiRgba8888CompositorTileRlePresentRunStepErrorKind: present run step bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower F5co run cursor step failure を compositor layer の typed kind として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentRunStepErrorKind:
    RunCursorStepFailed %GuiRgba8888RowTileRlePresentRunCursorStepErrorKind

impl Clone for GuiRgba8888CompositorTileRlePresentRunStepErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentRunStepErrorKind GuiRgba8888CompositorTileRlePresentRunStepErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentRunStepErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentRunStepErrorKind GuiRgba8888CompositorTileRlePresentRunStepErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentRunStep: lower step result と next compositor run cursor owner
//:
//: lower step が[返/かえ]した RunReady / Completed result と、metadata [付/つ]き next run cursor owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
pub struct GuiRgba8888CompositorTileRlePresentRunStep:
    result %GuiRgba8888RowTileRlePresentRunCursorStepResult
    owner %GuiRgba8888CompositorTileRlePresentRunCursorOwner

//: GuiRgba8888CompositorTileRlePresentRunStepError: run cursor owner を[回収/かいしゅう]できる step error
//:
//: lower kind / category と、metadata [付/つ]き compositor run cursor owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
pub struct GuiRgba8888CompositorTileRlePresentRunStepError:
    kind %GuiRgba8888CompositorTileRlePresentRunStepErrorKind
    category %Option GuiError
    owner %GuiRgba8888CompositorTileRlePresentRunCursorOwner

//: gui_rgba8888_compositor_tile_rle_present_run_step_new: step terminal を[作/つく]る
//:
//: lower run step が[成功/せいこう]した後だけ呼ぶ module-private constructor です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_step_new %fn GuiRgba8888RowTileRlePresentRunCursorStepResult fn GuiRgba8888CompositorTileRlePresentRunCursorOwner GuiRgba8888CompositorTileRlePresentRunStep \result\owner:
    GuiRgba8888CompositorTileRlePresentRunStep result owner

//: gui_rgba8888_compositor_tile_rle_present_run_step_error_new: step error payload を[作/つく]る
//:
//: lower kind、category、回収用 run cursor owner を 1 つの owner-bearing error にまとめます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_step_error_new %fn GuiRgba8888CompositorTileRlePresentRunStepErrorKind fn Option GuiError fn GuiRgba8888CompositorTileRlePresentRunCursorOwner GuiRgba8888CompositorTileRlePresentRunStepError \kind\category\owner:
    GuiRgba8888CompositorTileRlePresentRunStepError kind category owner

//: gui_rgba8888_compositor_tile_rle_present_run_step_error_from_lower: lower step error を compositor step error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから lower run cursor owner を[回収/かいしゅう]し、metadata [付/つ]き run cursor owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_step_error_from_lower %fn GuiRgba8888RowTileRlePresentRunCursorStepError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRlePresentRunStepError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRlePresentRunCursorStepErrorKind gui_rgba8888_row_tile_rle_present_run_cursor_step_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_present_run_cursor_step_error_category_value &lower
    let lower_owner %GuiRgba8888RowTileRlePresentRunCursorOwner gui_rgba8888_row_tile_rle_present_run_cursor_step_error_finish_owner lower
    let owner %GuiRgba8888CompositorTileRlePresentRunCursorOwner GuiRgba8888CompositorTileRlePresentRunCursorOwner lower_owner metadata
    let kind %GuiRgba8888CompositorTileRlePresentRunStepErrorKind GuiRgba8888CompositorTileRlePresentRunStepErrorKind::RunCursorStepFailed lower_kind
    gui_rgba8888_compositor_tile_rle_present_run_step_error_new kind category owner

//: gui_rgba8888_compositor_tile_rle_present_run_step_one: compositor run cursor owner を 1 record [進/すす]める
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower run cursor owner を[取/と]り[出/だ]します。
//: - lower F5co step を 1 [回/かい]だけ[呼/よ]び、success では result と next owner を[包/つつ]みます。
//: - lower error では run cursor owner を metadata [付/つ]き recovery owner として[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_step" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_run_step_one %fn GuiRgba8888CompositorTileRlePresentRunCursorOwner Result GuiRgba8888CompositorTileRlePresentRunStep GuiRgba8888CompositorTileRlePresentRunStepError \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_run_cursor_owner_metadata &owner
    let lower_owner %GuiRgba8888RowTileRlePresentRunCursorOwner field::get owner "run_cursor"
    match gui_rgba8888_row_tile_rle_present_run_cursor_step lower_owner:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_present_run_step_error_from_lower lower metadata
        Result::Ok lower_step:
            let result %GuiRgba8888RowTileRlePresentRunCursorStepResult gui_rgba8888_row_tile_rle_present_run_cursor_step_result &lower_step
            let lower_next %GuiRgba8888RowTileRlePresentRunCursorOwner gui_rgba8888_row_tile_rle_present_run_cursor_step_finish_owner lower_step
            let next %GuiRgba8888CompositorTileRlePresentRunCursorOwner GuiRgba8888CompositorTileRlePresentRunCursorOwner lower_next metadata
            Result::Ok gui_rgba8888_compositor_tile_rle_present_run_step_new result next

//: gui_rgba8888_compositor_tile_rle_present_run_step_result: step result を[返/かえ]す
