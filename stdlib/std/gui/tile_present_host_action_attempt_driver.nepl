    let attempted %GuiRgba8888RowTileRlePresentHostExecutionAction gui_rgba8888_row_tile_rle_present_host_action_attempt_action &attempt
    if gui_rgba8888_row_tile_rle_present_host_executor_action_same &expected &attempted:
        then:
            let outcome %Result unit GuiError gui_rgba8888_row_tile_rle_present_host_action_attempt_outcome &attempt
            match gui_rgba8888_row_tile_rle_present_host_action_sink_driver_step support driver outcome:
                Result::Ok sink_driver_step:
                    Result::Ok gui_rgba8888_row_tile_rle_present_host_action_attempt_driver_step_new attempt sink_driver_step
