pub fn gui_rgba8888_compositor_tile_rle_present_frame_prepare_error_free %fn GuiRgba8888CompositorTileRlePresentFramePrepareError Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \error:
    let packet %GuiRgba8888CompositorTileRlePacketOwner gui_rgba8888_compositor_tile_rle_present_frame_prepare_error_finish_packet error
    gui_rgba8888_compositor_tile_rle_packet_owner_free packet

//: gui_rgba8888_compositor_tile_rle_present_frame_owner_free: success present owner を[閉/と]じる
//:
//: lower present-frame owner free に[委譲/いじょう]し、lower encoded finish kind を compositor encoded finish kind に[包/つつ]みます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_frame_owner_free %fn GuiRgba8888CompositorTileRlePresentFrameOwner Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    let present %GuiRgba8888RowTileRlePresentFrameOwner field::get owner "present"
