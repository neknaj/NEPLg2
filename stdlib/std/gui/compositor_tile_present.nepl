    let present %&GuiRgba8888RowTileRlePresentFrameOwner field::get_ref owner "present"
    let present_descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_frame_descriptor present
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_owner_metadata owner
    gui_rgba8888_compositor_tile_rle_present_frame_descriptor_new present_descriptor metadata

