//: gui_rgba8888_row_tile_rle_present_virtual_drain_step: F5cq record を headless/test drain に[流/なが]す
//:
//: [契約/けいやく]:
//: - Begin / Run / End の[順序/じゅんじょ]を enum phase で[検査/けんさ]します。
//: - Run は `pixel_offset == seen_pixel_count` を[要求/ようきゅう]し、gap / overlap / reorder を[拒否/きょひ]します。
//: - End は expected run count と expected pixel count を[満/み]たした場合だけ success です。
pub fn gui_rgba8888_row_tile_rle_present_virtual_drain_step %fn GuiRgba8888RowTileRlePresentVirtualDrain fn GuiRgba8888RowTileRlePresentHostCommandRecord Result GuiRgba8888RowTileRlePresentVirtualDrain GuiRgba8888RowTileRlePresentVirtualDrainError \drain\record:
    match record:
        GuiRgba8888RowTileRlePresentHostCommandRecord::BeginFrame descriptor:
            gui_rgba8888_row_tile_rle_present_virtual_drain_begin drain descriptor
        GuiRgba8888RowTileRlePresentHostCommandRecord::RunRecord run_record:
            gui_rgba8888_row_tile_rle_present_virtual_drain_run drain run_record
        GuiRgba8888RowTileRlePresentHostCommandRecord::EndFrame descriptor:
            gui_rgba8888_row_tile_rle_present_virtual_drain_end drain descriptor

pub fn gui_rgba8888_row_tile_rle_present_virtual_drain_is_ended %fn &GuiRgba8888RowTileRlePresentVirtualDrain bool \drain:
    match gui_rgba8888_row_tile_rle_present_virtual_drain_phase drain:
        GuiRgba8888RowTileRlePresentVirtualDrainPhase::Ended:
            true
