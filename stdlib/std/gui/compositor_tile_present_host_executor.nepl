//: # std/gui/compositor_tile_present_host_executor
//: compositor tile RLE present host executor の validation boundary
//:
//: ### [目的/もくてき]
//: - F5mz の executor action と F5na の execution report を、actual platform executor の[手前/てまえ]で[検証/けんしょう]します。
//: - Web、native、bare executor が「対応していない target を[実行/じっこう]したことにする」ことや「別 action の report を[返/かえ]す」ことを typed error として[検出/けんしゅつ]します。
//:
//: ### [契約/けいやく]
//: - support は空集合を[表現/ひょうげん]できない enum です。
//: - unsupported target は bool ではなく `Result` の Err として[返/かえ]します。
//: - report validation は action variant だけでなく、window、surface、frame、packet metadata、compositor metadata、run offset、run count、RGBA channel まで[比較/ひかく]します。
//: - report の success / failure はこの boundary では[解釈/かいしゃく]せず、matching action の report は failure report でも[有効/ゆうこう]です。
//: - actual host import、pending completion、queue、timer、scheduler、platform API、DOM、Canvas、minifb、video memory、代替 no-op は[含/ふく]めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```

#indent 4

#import "alloc/gui/render2d/compositor_frame_entry" as *
#import "alloc/gui/render2d/compositor_tile_rle_packet" as *
#import "alloc/gui/render2d/row_tile_rle" as *
#import "core/field" as field
#import "core/gui/color" as *
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/compositor_tile_present" as *
#import "std/gui/compositor_tile_present_host_command" as *
#import "std/gui/compositor_tile_present_host_execution" as *
#import "std/gui/compositor_tile_present_host_execution_report" as *
#import "std/gui/window" as *

//: GuiRgba8888CompositorTileRlePresentHostExecutorSupport: executor が[対応/たいおう]する presentation target set
//:
//: 空集合を[表現/ひょうげん]しないことで、caller が「何にも対応しない executor」を validation success として[扱/あつか]えないようにします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentHostExecutorSupport:
    Window
    Offscreen
    Device
    WindowOffscreen
    WindowDevice
    OffscreenDevice
    All

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutorSupport:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutorSupport GuiRgba8888CompositorTileRlePresentHostExecutorSupport \support:
        *support

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutorSupport:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport GuiRgba8888CompositorTileRlePresentHostExecutorSupport \support:
        support

//: GuiRgba8888CompositorTileRlePresentHostExecutorActionKind: target x record kind の[平坦/へいたん]分類
//:
//: diagnostics と focused doctest が action variant を[観測/かんそく]できるように、F5mz action enum と同じ 9 [種類/しゅるい]へ[写/うつ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentHostExecutorActionKind:
    WindowBegin
    WindowRun
    WindowEnd
    OffscreenBegin
    OffscreenRun
    OffscreenEnd
    DeviceBegin
    DeviceRun
    DeviceEnd

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutorActionKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutorActionKind GuiRgba8888CompositorTileRlePresentHostExecutorActionKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutorActionKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutorActionKind GuiRgba8888CompositorTileRlePresentHostExecutorActionKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind: validation failure の[種類/しゅるい]
//:
//: unsupported target と report/action mismatch を[分/わ]けて、host executor wrapper が recovery を[選/えら]べるようにします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind:
    UnsupportedAction
    ReportActionMismatch

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentHostExecutorError: expected action と reported action を[保持/ほじ]する typed error
//:
//: unsupported target では reported action を `None`、mismatch では report が[返/かえ]した action を `Some` として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub struct GuiRgba8888CompositorTileRlePresentHostExecutorError:
    kind %GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind
    category %Option GuiError
    expected %GuiRgba8888CompositorTileRlePresentHostExecutionAction
    reported %Option GuiRgba8888CompositorTileRlePresentHostExecutionAction

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutorError:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutorError GuiRgba8888CompositorTileRlePresentHostExecutorError \error:
        *error

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutorError:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutorError GuiRgba8888CompositorTileRlePresentHostExecutorError \error:
        error

//: gui_rgba8888_compositor_tile_rle_present_host_executor_error_new: typed error payload を[作/つく]る
//:
//: kind、category、expected action、optional reported action を 1 value に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_error_new %fn GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind fn Option GuiError fn GuiRgba8888CompositorTileRlePresentHostExecutionAction fn Option GuiRgba8888CompositorTileRlePresentHostExecutionAction GuiRgba8888CompositorTileRlePresentHostExecutorError \kind\category\expected\reported:
    GuiRgba8888CompositorTileRlePresentHostExecutorError kind category expected reported

//: gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error: unsupported target error を[作/つく]る
//:
//: support preflight で[拒否/きょひ]した expected action を[保持/ほじ]し、category は `Unsupported` にします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error %fn GuiRgba8888CompositorTileRlePresentHostExecutionAction GuiRgba8888CompositorTileRlePresentHostExecutorError \expected:
    let category %Option GuiError Option::Some GuiError::Unsupported
    gui_rgba8888_compositor_tile_rle_present_host_executor_error_new GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind::UnsupportedAction category expected Option::None

//: gui_rgba8888_compositor_tile_rle_present_host_executor_mismatch_error: report/action mismatch error を[作/つく]る
//:
//: expected と reported の両方を[保持/ほじ]し、category は `InvalidCommand` にします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_mismatch_error %fn GuiRgba8888CompositorTileRlePresentHostExecutionAction fn GuiRgba8888CompositorTileRlePresentHostExecutionAction GuiRgba8888CompositorTileRlePresentHostExecutorError \expected\reported:
    let category %Option GuiError Option::Some GuiError::InvalidCommand
    let reported_value %Option GuiRgba8888CompositorTileRlePresentHostExecutionAction Option::Some reported
    gui_rgba8888_compositor_tile_rle_present_host_executor_error_new GuiRgba8888CompositorTileRlePresentHostExecutorErrorKind::ReportActionMismatch category expected reported_value

//: gui_rgba8888_compositor_tile_rle_present_host_executor_supports_window: support が Window target を[含/ふく]むか[返/かえ]す
//:
//: enum の exhaustive match だけで[判定/はんてい]し、bool flag set や raw bit mask は[使/つか]いません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_supports_window %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport bool \support:
    match support:
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Window:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Device:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowOffscreen:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowDevice:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::OffscreenDevice:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::All:
            true

//: gui_rgba8888_compositor_tile_rle_present_host_executor_supports_offscreen: support が Offscreen target を[含/ふく]むか[返/かえ]す
//:
//: enum の exhaustive match だけで[判定/はんてい]し、unsupported target fallback は[行/おこな]いません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_supports_offscreen %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport bool \support:
    match support:
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Window:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Device:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowOffscreen:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowDevice:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::OffscreenDevice:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::All:
            true

//: gui_rgba8888_compositor_tile_rle_present_host_executor_supports_device: support が Device target を[含/ふく]むか[返/かえ]す
//:
//: enum の exhaustive match だけで[判定/はんてい]し、unsupported target fallback は[行/おこな]いません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_supports_device %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport bool \support:
    match support:
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Window:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Device:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowOffscreen:
            false
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::WindowDevice:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::OffscreenDevice:
            true
        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::All:
            true

//: gui_rgba8888_compositor_tile_rle_present_host_executor_action_kind: action を target x record kind に[写/うつ]す
//:
//: F5mz action enum の 9 variant を[平坦/へいたん]な kind enum に[投影/とうえい]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_host_executor_action_kind %fn &GuiRgba8888CompositorTileRlePresentHostExecutionAction GuiRgba8888CompositorTileRlePresentHostExecutorActionKind \action:
    match *action:
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowBegin _payload:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::WindowBegin
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowRun _payload:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::WindowRun
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowEnd _payload:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::WindowEnd
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenBegin _descriptor:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::OffscreenBegin
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenRun _record:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::OffscreenRun
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenEnd _descriptor:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::OffscreenEnd
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceBegin _descriptor:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::DeviceBegin
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceRun _record:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::DeviceRun
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceEnd _descriptor:
            GuiRgba8888CompositorTileRlePresentHostExecutorActionKind::DeviceEnd

//: gui_rgba8888_compositor_tile_rle_present_host_executor_require_supported: support target を[検査/けんさ]する
//:
//: action の target が support に[含/ふく]まれない[場合/ばあい]は typed `UnsupportedAction` error を[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_host_executor_require_supported %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentHostExecutionAction Result unit GuiRgba8888CompositorTileRlePresentHostExecutorError \support\action:
    match action:
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowBegin _payload:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_window support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowRun _payload:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_window support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowEnd _payload:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_window support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenBegin _descriptor:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenRun _record:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenEnd _descriptor:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceBegin _descriptor:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceRun _record:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceEnd _descriptor:
            if gui_rgba8888_compositor_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_compositor_tile_rle_present_host_executor_unsupported_error action

//: gui_rgba8888_compositor_tile_rle_present_host_executor_color_same: RGBA channel を[比較/ひかく]する
//:
//: color value の identity は 4 channel の exact equality とします。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_color_same %fn &Rgba8888 fn &Rgba8888 bool \left\right:
    and:
        eq rgba8888_r left rgba8888_r right
        and:
            eq rgba8888_g left rgba8888_g right
            and:
                eq rgba8888_b left rgba8888_b right
                eq rgba8888_a left rgba8888_a right

//: gui_rgba8888_compositor_tile_rle_present_host_executor_run_same: RLE run payload を[比較/ひかく]する
//:
//: pixel offset、pixel count、RGBA color を exact equality で[比較/ひかく]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_run_same %fn &GuiRgba8888RowTileRleRun fn &GuiRgba8888RowTileRleRun bool \left\right:
    let left_color %Rgba8888 gui_rgba8888_row_tile_rle_run_color left
    let right_color %Rgba8888 gui_rgba8888_row_tile_rle_run_color right
    and:
        eq gui_rgba8888_row_tile_rle_run_pixel_offset left gui_rgba8888_row_tile_rle_run_pixel_offset right
        and:
            eq gui_rgba8888_row_tile_rle_run_pixel_count left gui_rgba8888_row_tile_rle_run_pixel_count right
            gui_rgba8888_compositor_tile_rle_present_host_executor_color_same &left_color &right_color

//: gui_rgba8888_compositor_tile_rle_present_host_executor_metadata_same: compositor metadata を[比較/ひかく]する
//:
//: frame id、surface shape、row range、batch count、batch row [上限/じょうげん]を exact equality で[比較/ひかく]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_metadata_same %fn &GuiRgba8888CompositorFrameEntryMetadata fn &GuiRgba8888CompositorFrameEntryMetadata bool \left\right:
    and:
        eq gui_rgba8888_compositor_frame_entry_metadata_frame_id left gui_rgba8888_compositor_frame_entry_metadata_frame_id right
        and:
            eq gui_rgba8888_compositor_frame_entry_metadata_width left gui_rgba8888_compositor_frame_entry_metadata_width right
            and:
                eq gui_rgba8888_compositor_frame_entry_metadata_height left gui_rgba8888_compositor_frame_entry_metadata_height right
                and:
                    eq gui_rgba8888_compositor_frame_entry_metadata_row_start left gui_rgba8888_compositor_frame_entry_metadata_row_start right
                    and:
                        eq gui_rgba8888_compositor_frame_entry_metadata_row_count left gui_rgba8888_compositor_frame_entry_metadata_row_count right
                        and:
                            eq gui_rgba8888_compositor_frame_entry_metadata_batch_count left gui_rgba8888_compositor_frame_entry_metadata_batch_count right
                            eq gui_rgba8888_compositor_frame_entry_metadata_max_rows_per_batch left gui_rgba8888_compositor_frame_entry_metadata_max_rows_per_batch right

//: gui_rgba8888_compositor_tile_rle_present_host_executor_packet_descriptor_same: packet descriptor を[比較/ひかく]する
//:
//: compositor packet descriptor の scalar accessor だけを[使/つか]い、lower row-tile host command へは[戻/もど]りません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_executor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_executor_packet_descriptor_same %fn &GuiRgba8888CompositorTileRlePacketDescriptor fn &GuiRgba8888CompositorTileRlePacketDescriptor bool \left\right:
    and:
        eq gui_rgba8888_compositor_tile_rle_packet_descriptor_frame_id left gui_rgba8888_compositor_tile_rle_packet_descriptor_frame_id right
        and:
            eq gui_rgba8888_compositor_tile_rle_packet_descriptor_batch_index left gui_rgba8888_compositor_tile_rle_packet_descriptor_batch_index right
            and:
                eq gui_rgba8888_compositor_tile_rle_packet_descriptor_tile_index left gui_rgba8888_compositor_tile_rle_packet_descriptor_tile_index right
                and:
                    eq gui_rgba8888_compositor_tile_rle_packet_descriptor_plan_row_start left gui_rgba8888_compositor_tile_rle_packet_descriptor_plan_row_start right
                    and:
                        eq gui_rgba8888_compositor_tile_rle_packet_descriptor_plan_row_count left gui_rgba8888_compositor_tile_rle_packet_descriptor_plan_row_count right
                        and:
                            eq gui_rgba8888_compositor_tile_rle_packet_descriptor_row_start left gui_rgba8888_compositor_tile_rle_packet_descriptor_row_start right
                            and:
