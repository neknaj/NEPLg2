#import "std/gui/compositor_tile_present_host_executor" as *

//: GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind: report bridge failure の[種類/しゅるい]
//:
//: validation failure と loop completion failure を[分/わ]け、lower typed error を[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind:
    ExecutorValidationFailed %GuiRgba8888CompositorTileRlePresentHostExecutorError
    LoopCompletionFailed %GuiRgba8888CompositorTileRlePresentDispatchLoopError

impl Clone for GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError: category と recovery state を[持/も]つ bridge error
//:
//: validation failure では pending previous state、completion failure では dispatch loop error state を[返/かえ]します。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError:
    kind %GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind
    category %Option GuiError
    state %GuiRgba8888CompositorTileRlePresentDispatchLoopState

impl Clone for GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \error:
        *error

impl Copy for GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \error:
        error

//: gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_error_new: bridge error payload を[作/つく]る
//:
//: validation failure と completion failure のどちらでも、category と recovery state を[同/おな]じ構造に[保存/ほぞん]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_error_new %fn GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind fn Option GuiError fn GuiRgba8888CompositorTileRlePresentDispatchLoopState GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \kind\category\state:
    GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError kind category state

//: gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_validation_error: F5nb validation failure を bridge error に[写/うつ]す
//:
//: pending を completion に[渡/わた]さず、previous state と lower category を[回収/かいしゅう]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_validation_error %fn GuiRgba8888CompositorTileRlePresentHostExecutorError fn GuiRgba8888CompositorTileRlePresentDispatchLoopState GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \lower\previous:
    let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_host_executor_error_category_value &lower
    let kind %GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind::ExecutorValidationFailed lower
    gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_error_new kind category previous

//: gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_completion_error: F5nc completion failure を bridge error に[写/うつ]す
//:
//: F5nc error が[保持/ほじ]する recovery state と category を bridge caller へそのまま[返/かえ]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_completion_error %fn GuiRgba8888CompositorTileRlePresentDispatchLoopError GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \lower:
    let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_dispatch_loop_error_category_value &lower
    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_error_state &lower
    let kind %GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeErrorKind::LoopCompletionFailed lower
    gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_error_new kind category state

//: gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_complete: validated report を loop completion に[戻/もど]す
//:
//: [契約/けいやく]:
//: - pending request から expected action を[作/つく]り、report の action と full identity で[比較/ひかく]します。
//: - validation failure では pending を completion に[渡/わた]しません。
//: - validation success の[場合/ばあい]だけ report outcome を dispatch loop `complete_request` へ[渡/わた]します。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_complete %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest fn GuiRgba8888CompositorTileRlePresentHostExecutionReport Result GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError \support\pending\report:
    let previous %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_previous &pending
    let request gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_request &pending
    let expected %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_execution_action &request
    match gui_rgba8888_compositor_tile_rle_present_host_executor_validate_report_for_action support expected report:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_validation_error lower previous
        Result::Ok validated:
            let outcome %Result unit GuiError gui_rgba8888_compositor_tile_rle_present_host_execution_report_outcome &validated
            match gui_rgba8888_compositor_tile_rle_present_dispatch_loop_complete_request pending outcome:
                Result::Ok completion:
                    Result::Ok completion
                Result::Err lower:
                    Result::Err gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_completion_error lower

