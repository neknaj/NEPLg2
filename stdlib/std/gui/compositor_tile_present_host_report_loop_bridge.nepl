//: # std/gui/compositor_tile_present_host_report_loop_bridge
//: compositor tile RLE present host report と dispatch loop completion の std layer bridge
//:
//: ### [目的/もくてき]
//: - compositor dispatch loop pending request、F5mz action decoding、F5na execution report、F5nb executor validation を 1 つの[戻/もど]し[境界/きょうかい]に[束/たば]ねます。
//: - platform executor が[返/かえ]した report を loop state に[反映/はんえい]する[前/まえ]に、support と full action identity を[検証/けんしょう]します。
//:
//: ### [契約/けいやく]
//: - `pending` は value として[消費/しょうひ]され、successful validation の[後/あと]だけ dispatch loop completion に[渡/わた]されます。
//: - validation failure では completion を[呼/よ]ばず、pending の previous state を error に[保持/ほじ]します。
//: - execution failure report は action が[一致/いっち]していれば validation success とし、F5na `report_outcome` を loop completion へ[渡/わた]します。
//: - actual host import、platform API、queue、timer、scheduler、raw storage、Vec、DOM、Canvas、minifb、video memory、fallback、silent no-op は[含/ふく]めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_report_loop_bridge" as *
//: ```

#indent 4

#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
