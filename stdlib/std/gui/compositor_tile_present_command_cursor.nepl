#import "std/gui/tile_present_run_cursor" as *

//: GuiRgba8888CompositorTileRlePresentCommand: compositor present command stream の 1 command
//:
//: BeginFrame / EndFrame は compositor metadata [付/つ]き descriptor を[持/も]ち、Run は typed RLE run だけを[持/も]ちます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_command_cursor" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentCommand:
    BeginFrame %GuiRgba8888CompositorTileRlePresentFrameDescriptor
    Run %GuiRgba8888RowTileRleRun
    EndFrame %GuiRgba8888CompositorTileRlePresentFrameDescriptor

impl Clone for GuiRgba8888CompositorTileRlePresentCommand:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentCommand GuiRgba8888CompositorTileRlePresentCommand \command:
        *command

impl Copy for GuiRgba8888CompositorTileRlePresentCommand:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentCommand GuiRgba8888CompositorTileRlePresentCommand \command:
        command

