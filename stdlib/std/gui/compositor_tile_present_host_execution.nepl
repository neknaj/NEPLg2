//: gui_rgba8888_compositor_tile_rle_present_host_execution_action: request を executor action に[写/うつ]す
//:
//: [契約/けいやく]:
//: - F5mx request target と F5mu record を public accessor で[読/よ]み、flat action enum に[変換/へんかん]します。
//: - capability validation や request construction は F5mx の[責務/せきむ]なので、この関数では[行/おこな]いません。
//: - host import の[実行/じっこう][結果/けっか]はこの action ではなく、後続 executor が `Result unit GuiError` として completion boundary に[渡/わた]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_execution" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_host_execution_action %fn &GuiRgba8888CompositorTileRlePresentHostImportRequest GuiRgba8888CompositorTileRlePresentHostExecutionAction \request:
    let target %GuiRgba8888CompositorTileRlePresentHostImportTarget gui_rgba8888_compositor_tile_rle_present_host_import_request_target request
    let record %GuiRgba8888CompositorTileRlePresentHostCommandRecord gui_rgba8888_compositor_tile_rle_present_host_import_request_record request
    match target:
        GuiRgba8888CompositorTileRlePresentHostImportTarget::Window window:
            gui_rgba8888_compositor_tile_rle_present_host_execution_action_for_window window record
        GuiRgba8888CompositorTileRlePresentHostImportTarget::Offscreen:
            gui_rgba8888_compositor_tile_rle_present_host_execution_action_for_offscreen record
        GuiRgba8888CompositorTileRlePresentHostImportTarget::Device:
            gui_rgba8888_compositor_tile_rle_present_host_execution_action_for_device record
