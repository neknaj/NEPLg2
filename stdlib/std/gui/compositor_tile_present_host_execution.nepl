//: gui_rgba8888_compositor_tile_rle_present_host_execution_action_for_window: Window target の record を action に[写/うつ]す
//:
//: Begin / Run / End の record kind を Window action payload に[分/わ]けます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_host_execution" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_host_execution_action_for_window %fn WindowId fn GuiRgba8888CompositorTileRlePresentHostCommandRecord GuiRgba8888CompositorTileRlePresentHostExecutionAction \window\record:
    match record:
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::BeginFrame descriptor:
            let payload %GuiRgba8888CompositorTileRlePresentHostExecutionWindowBegin gui_rgba8888_compositor_tile_rle_present_host_execution_window_begin_new window descriptor
            GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowBegin payload
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::RunRecord run_record:
            let payload %GuiRgba8888CompositorTileRlePresentHostExecutionWindowRun gui_rgba8888_compositor_tile_rle_present_host_execution_window_run_new window run_record
            GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowRun payload
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::EndFrame descriptor:
            let payload %GuiRgba8888CompositorTileRlePresentHostExecutionWindowEnd gui_rgba8888_compositor_tile_rle_present_host_execution_window_end_new window descriptor
            GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowEnd payload

