//: gui_rgba8888_row_tile_rle_present_host_execution_action: request を executor action に[写/うつ]す
//:
//: [契約/けいやく]:
//: - F5cr request target と F5cq record を public accessor で[読/よ]み、flat action enum に[変換/へんかん]します。
//: - capability validation や request construction は F5cr の[責務/せきむ]なので、この関数では[行/おこな]いません。
//: - host import の[実行/じっこう][結果/けっか]はこの action ではなく、後続 executor が `Result unit GuiError` として F5cv completion に[渡/わた]します。
pub fn gui_rgba8888_row_tile_rle_present_host_execution_action %fn &GuiRgba8888RowTileRlePresentHostImportRequest GuiRgba8888RowTileRlePresentHostExecutionAction \request:
    let target %GuiRgba8888RowTileRlePresentHostImportTarget gui_rgba8888_row_tile_rle_present_host_import_request_target request
    let record %GuiRgba8888RowTileRlePresentHostCommandRecord gui_rgba8888_row_tile_rle_present_host_import_request_record request
    match target:
        GuiRgba8888RowTileRlePresentHostImportTarget::Window window:
            gui_rgba8888_row_tile_rle_present_host_execution_action_for_window window record
        GuiRgba8888RowTileRlePresentHostImportTarget::Offscreen:
            gui_rgba8888_row_tile_rle_present_host_execution_action_for_offscreen record
        GuiRgba8888RowTileRlePresentHostImportTarget::Device:
            gui_rgba8888_row_tile_rle_present_host_execution_action_for_device record
