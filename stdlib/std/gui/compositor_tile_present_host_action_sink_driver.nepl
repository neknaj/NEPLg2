//: gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_step: F5nf sink step を F5ne one-shot completion へ[接続/せつぞく]する
//:
//: [契約/けいやく]:
//: - F5ne driver pending から action を[借用/しゃくよう]で[読/よ]み、F5nf support preflight と outcome packaging を[先/さき]に[行/おこな]います。
//: - F5nf が[拒否/きょひ]した[場合/ばあい]、driver pending は error payload へ[移/うつ]され、F5ne completion は[呼/よ]ばれません。
//: - F5nf が[成功/せいこう]した[場合/ばあい]だけ、同じ caller-supplied outcome で F5ne completion を[呼/よ]びます。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_step %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending fn Result unit GuiError Result GuiRgba8888CompositorTileRlePresentHostActionSinkDriverStep GuiRgba8888CompositorTileRlePresentHostActionSinkDriverError \support\driver\outcome:
    let action gui_rgba8888_compositor_tile_rle_present_host_execution_driver_pending_action &driver
    match gui_rgba8888_compositor_tile_rle_present_host_action_sink_step support action outcome:
        Result::Err sink_error:
            Result::Err gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_sink_error sink_error driver
        Result::Ok sink_step:
            match gui_rgba8888_compositor_tile_rle_present_host_execution_driver_complete_outcome support driver outcome:
                Result::Ok completion:
                    Result::Ok gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_step_new sink_step completion
                Result::Err driver_error:
                    Result::Err gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_completion_error sink_step driver_error

