//: gui_rgba8888_compositor_tile_rle_present_host_action_attempt_driver_step: attempt action と pending action の[一致/いっち]を[検査/けんさ]してから F5nf へ[委譲/いじょう]する
//:
//: [契約/けいやく]:
//: - pending action と attempt action は F5nb full action equality で[比較/ひかく]します。
//: - mismatch では F5nf sink driver を[呼/よ]ばず、driver pending を error payload へ[移/うつ]します。
//: - match した[場合/ばあい]だけ、attempt outcome を F5nf action sink driver step へ[渡/わた]します。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_action_attempt_driver_step %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending fn GuiRgba8888CompositorTileRlePresentHostActionAttempt Result GuiRgba8888CompositorTileRlePresentHostActionAttemptDriverStep GuiRgba8888CompositorTileRlePresentHostActionAttemptDriverError \support\driver\attempt:
    let expected %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_execution_driver_pending_action &driver
    let attempted %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_action_attempt_action &attempt
    if gui_rgba8888_compositor_tile_rle_present_host_executor_action_same &expected &attempted:
        then:
            let outcome %Result unit GuiError gui_rgba8888_compositor_tile_rle_present_host_action_attempt_outcome &attempt
            match gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_step support driver outcome:
                Result::Ok sink_driver_step:
                    Result::Ok gui_rgba8888_compositor_tile_rle_present_host_action_attempt_driver_step_new attempt sink_driver_step
                Result::Err lower:
                    Result::Err gui_rgba8888_compositor_tile_rle_present_host_action_attempt_sink_driver_error lower
        else:
            Result::Err gui_rgba8888_compositor_tile_rle_present_host_action_attempt_mismatch_error expected attempted driver

