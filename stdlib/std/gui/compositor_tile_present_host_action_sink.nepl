//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_action_sink_step %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentHostExecutionAction fn Result unit GuiError Result GuiRgba8888CompositorTileRlePresentHostActionSinkStep GuiRgba8888CompositorTileRlePresentHostActionSinkError \support\action\outcome:
    match gui_rgba8888_compositor_tile_rle_present_host_executor_require_supported support action:
        Result::Err support_error:
            Result::Err gui_rgba8888_compositor_tile_rle_present_host_action_sink_unsupported_error action support_error
        Result::Ok _unit:
            let step %GuiRgba8888CompositorTileRlePresentHostActionSinkStep gui_rgba8888_compositor_tile_rle_present_host_action_sink_step_new action outcome
            Result::Ok step

