    lower %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnCompleteError

fn gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_step_start_error_new %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnStartError GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnStepStartError \lower:
