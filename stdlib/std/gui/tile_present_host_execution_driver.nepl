//: gui_rgba8888_row_tile_rle_present_host_execution_driver_complete_outcome: executor outcome を loop completion へ[戻/もど]す
//:
//: [契約/けいやく]:
//: - action を[読/よ]んでから pending value を driver から[取/と]り[出/だ]します。
//: - F5cx report を[作/つく]り、F5cz bridge に validation と completion を[委譲/いじょう]します。
//: - F5cv completion、F5cy validation、F5cr request construction を[直接/ちょくせつ][呼/よ]びません。
pub fn gui_rgba8888_row_tile_rle_present_host_execution_driver_complete_outcome %fn GuiRgba8888RowTileRlePresentHostExecutorSupport fn GuiRgba8888RowTileRlePresentHostExecutionDriverPending fn Result unit GuiError Result GuiRgba8888RowTileRlePresentDispatchLoopCompletion GuiRgba8888RowTileRlePresentHostExecutionDriverError \support\driver\outcome:
    let action %GuiRgba8888RowTileRlePresentHostExecutionAction gui_rgba8888_row_tile_rle_present_host_execution_driver_pending_action &driver
    let pending %GuiRgba8888RowTileRlePresentDispatchLoopPendingRequest field::get driver "pending"
    let report %GuiRgba8888RowTileRlePresentHostExecutionReport gui_rgba8888_row_tile_rle_present_host_execution_report action outcome
    match gui_rgba8888_row_tile_rle_present_host_report_loop_bridge_complete support pending report:
        Result::Ok completion:
            Result::Ok completion
        Result::Err lower:
            Result::Err gui_rgba8888_row_tile_rle_present_host_execution_driver_bridge_error lower

