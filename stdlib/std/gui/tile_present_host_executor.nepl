pub fn gui_rgba8888_row_tile_rle_present_host_executor_require_supported %fn GuiRgba8888RowTileRlePresentHostExecutorSupport fn GuiRgba8888RowTileRlePresentHostExecutionAction Result unit GuiRgba8888RowTileRlePresentHostExecutorError \support\action:
    match action:
