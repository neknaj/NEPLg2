                    and:
                        eq gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count left gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count right
                        and:
                            eq gui_rgba8888_row_tile_rle_packet_descriptor_row_start left gui_rgba8888_row_tile_rle_packet_descriptor_row_start right
                            and:
                                eq gui_rgba8888_row_tile_rle_packet_descriptor_row_count left gui_rgba8888_row_tile_rle_packet_descriptor_row_count right
                                and:
                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_width left gui_rgba8888_row_tile_rle_packet_descriptor_width right
                                    and:
                                        eq gui_rgba8888_row_tile_rle_packet_descriptor_height left gui_rgba8888_row_tile_rle_packet_descriptor_height right
                                        and:
                                            eq gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes left gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes right
                                            and:
                                                eq gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows left gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows right
                                                and:
                                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_tile_count left gui_rgba8888_row_tile_rle_packet_descriptor_tile_count right
                                                    and:
                                                        eq gui_rgba8888_row_tile_rle_packet_descriptor_pixel_count left gui_rgba8888_row_tile_rle_packet_descriptor_pixel_count right
                                                        and:
                                                            eq gui_rgba8888_row_tile_rle_packet_descriptor_total_run_count left gui_rgba8888_row_tile_rle_packet_descriptor_total_run_count right
                                                            eq gui_rgba8888_row_tile_rle_packet_descriptor_encoded_byte_count left gui_rgba8888_row_tile_rle_packet_descriptor_encoded_byte_count right

