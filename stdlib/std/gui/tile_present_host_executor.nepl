//: # std/gui/tile_present_host_executor
//: RGBA8888 row tile RLE present host executor の validation boundary
//:
//: ### [目的/もくてき]
//: - F5cw の executor action と F5cx の execution report を、actual platform executor の[手前/てまえ]で[検証/けんしょう]します。
//: - Web、native、bare、headless executor が「対応していない target を[実行/じっこう]したことにする」ことや「別 action の report を[返/かえ]す」ことを typed error として[検出/けんしゅつ]します。
//:
//: ### [契約/けいやく]
//: - support は空集合を[表現/ひょうげん]できない enum です。
//: - unsupported target は bool ではなく `Result` の Err として[返/かえ]します。
//: - report validation は action variant だけでなく、window、surface、frame、packet metadata、run offset、run count、RGBA channel まで[比較/ひかく]します。
//: - report の success / failure はこの boundary では[解釈/かいしゃく]せず、matching action の report は failure report でも[有効/ゆうこう]です。
//: - actual host import、dispatch loop completion、queue、timer、scheduler、platform API、DOM、Canvas、minifb、video memory、代替 no-op は[含/ふく]めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/tile_present_host_executor" as *
//: ```

#indent 4

#import "alloc/gui/render2d/row_tile_rle" as *
#import "alloc/gui/render2d/row_tile_rle_packet" as *
#import "core/field" as field
#import "core/gui/color" as *
