fn gui_rgba8888_row_tile_rle_present_host_executor_mismatch_error %fn GuiRgba8888RowTileRlePresentHostExecutionAction fn GuiRgba8888RowTileRlePresentHostExecutionAction GuiRgba8888RowTileRlePresentHostExecutorError \expected\reported:
    let category %Option GuiError Option::Some GuiError::InvalidCommand
