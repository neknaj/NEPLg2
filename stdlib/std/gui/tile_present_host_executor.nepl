impl Copy for GuiRgba8888RowTileRlePresentHostExecutorSupport:
    fn copy_mark %fn GuiRgba8888RowTileRlePresentHostExecutorSupport GuiRgba8888RowTileRlePresentHostExecutorSupport \support:
        support

