        GuiRgba8888RowTileRlePresentHostExecutionAction::OffscreenRun _record:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888RowTileRlePresentHostExecutionAction::OffscreenEnd _descriptor:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888RowTileRlePresentHostExecutionAction::DeviceBegin _descriptor:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888RowTileRlePresentHostExecutionAction::DeviceRun _record:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888RowTileRlePresentHostExecutionAction::DeviceEnd _descriptor:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_device support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action

fn gui_rgba8888_row_tile_rle_present_host_executor_color_same %fn &Rgba8888 fn &Rgba8888 bool \left\right:
    and:
        eq rgba8888_r left rgba8888_r right
        and:
            eq rgba8888_g left rgba8888_g right
            and:
                eq rgba8888_b left rgba8888_b right
                eq rgba8888_a left rgba8888_a right

fn gui_rgba8888_row_tile_rle_present_host_executor_run_same %fn &GuiRgba8888RowTileRleRun fn &GuiRgba8888RowTileRleRun bool \left\right:
    let left_color %Rgba8888 gui_rgba8888_row_tile_rle_run_color left
    let right_color %Rgba8888 gui_rgba8888_row_tile_rle_run_color right
    and:
        eq gui_rgba8888_row_tile_rle_run_pixel_offset left gui_rgba8888_row_tile_rle_run_pixel_offset right
        and:
            eq gui_rgba8888_row_tile_rle_run_pixel_count left gui_rgba8888_row_tile_rle_run_pixel_count right
            gui_rgba8888_row_tile_rle_present_host_executor_color_same &left_color &right_color

