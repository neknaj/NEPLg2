    fn clone %fn &GuiRgba8888RowTileRlePresentHostExecutorActionKind GuiRgba8888RowTileRlePresentHostExecutorActionKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRlePresentHostExecutorActionKind:
    fn copy_mark %fn GuiRgba8888RowTileRlePresentHostExecutorActionKind GuiRgba8888RowTileRlePresentHostExecutorActionKind \kind:
        kind

