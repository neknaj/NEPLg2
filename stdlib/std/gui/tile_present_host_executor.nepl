        GuiRgba8888RowTileRlePresentHostExecutionAction::WindowEnd _payload:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_window support:
                then Result::Ok unit
                else Result::Err gui_rgba8888_row_tile_rle_present_host_executor_unsupported_error action
        GuiRgba8888RowTileRlePresentHostExecutionAction::OffscreenBegin _descriptor:
            if gui_rgba8888_row_tile_rle_present_host_executor_supports_offscreen support:
                then Result::Ok unit
