//: # std/gui/keymap
//: GUI/TUI keyboard event を focus routing command へ[写像/しゃぞう]する pure data helper
//:
//: ### [目的/もくてき]
//: - platform 境界から来た `KeyboardEvent` の key code と modifier bit を、application へそのまま[渡/わた]さず `FocusRouteCommand` へ[変換/へんかん]します。
//: - `alloc/gui/routing/focus` は platform-specific raw key code や modifier bit を[知/し]らず、解釈済みの focus command だけを[受/う]け[取/と]ります。
//:
//: ### [契約/けいやく]
//: - terminal raw sequence、DOM key 名、OS API の定数はこの module へ[持/も]ち[込/こ]みません。
//: - `FocusKeyMap` は std layer の portable default contract と platform adapter の差し替え点です。
//: - navigation key code と modifier bit は platform raw value ではなく、この module の std contract として[扱/あつか]います。
//: - `KeyDown` だけを command に[変換/へんかん]し、`KeyUp` は `Option::None` です。
//:
//: neplg2:test
//: ret: 2
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/gui/keymap" as *
//:| #import "core/gui" as *
//:| #import "core/option" as *
//: fn main %fn unit i32 \unit:
//:     let event %KeyboardEvent keyboard_event_from_key_code KeyboardEventKind::KeyDown 9 1
//:     match keyboard_event_to_focus_route_command &focus_key_map_default event:
//:         Option::Some command:
//:             match command:
//:                 FocusRouteCommand::Previous:
//:                     2
//:                 _:
//:                     1
//:         Option::None:
//:             0
//: ```

#indent 4

pub #import "alloc/gui/routing/focus" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/traits/copy" as *

//: FocusKeyMap: focus routing に使う key code と modifier mask
//:
//: [目的/もくてき]:
//: - backend が標準 key code contract と異なる場合でも、`alloc/gui` に raw 値を[漏/も]らさず std layer で mapping を[差/さ]し[替/か]えます。
//:
//: [注意/ちゅうい]:
//: - `shift_modifier_mask` は modifier bitset のうち Shift を[表/あらわ]す bit mask です。default は 1 です。
pub struct FocusKeyMap:
    tab_key_code %i32
    enter_key_code %i32
    space_key_code %i32
    shift_modifier_mask %i32

impl Clone for FocusKeyMap:
    fn clone %fn &FocusKeyMap FocusKeyMap \key_map:
        *key_map

impl Copy for FocusKeyMap:
    fn copy_mark %fn FocusKeyMap FocusKeyMap \key_map:
        key_map

//: focus_key_map: key code contract を[指定/してい]して `FocusKeyMap` を[作/つく]る
//:
//: [目的/もくてき]:
//: - platform adapter が Tab / Enter / Space / Shift mask の数値 contract を明示して mapping helper へ[渡/わた]せるようにします。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn focus_key_map %fn i32 fn i32 fn i32 fn i32 FocusKeyMap \tab_key_code\enter_key_code\space_key_code\shift_modifier_mask:
    FocusKeyMap tab_key_code enter_key_code space_key_code shift_modifier_mask

//: focus_key_map_default: portable default の focus key map を[返/かえ]す
//:
//: [仕様/しよう]:
//: - Tab は 9、Enter は 13、Space は 32、Shift mask は 1 とします。
//: - この値は std layer の contract であり、terminal raw sequence parsing や DOM key parsing は platform adapter が[担当/たんとう]します。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn focus_key_map_default %fn unit FocusKeyMap \unit:
    focus_key_map 9 13 32 1

//: key_code_arrow_up: std layer の ArrowUp key code を[返/かえ]す
//:
//: [目的/もくてき]:
//: - terminal CSI、DOM key、OS virtual key などを同じ `KeyboardEvent` contract に[正規化/せいきか]するための値です。
//:
//: [注意/ちゅうい]:
//: - この値は raw ANSI sequence ではありません。platform adapter が raw input を[解析/かいせき]した後に[使/つか]います。
pub fn key_code_arrow_up %fn unit i32 \unit:
    1001

//: key_code_arrow_down: std layer の ArrowDown key code を[返/かえ]す
pub fn key_code_arrow_down %fn unit i32 \unit:
    1002

//: key_code_arrow_right: std layer の ArrowRight key code を[返/かえ]す
pub fn key_code_arrow_right %fn unit i32 \unit:
    1003

//: key_code_arrow_left: std layer の ArrowLeft key code を[返/かえ]す
pub fn key_code_arrow_left %fn unit i32 \unit:
    1004

//: key_modifier_shift_bit: std layer の Shift modifier bit を[返/かえ]す
pub fn key_modifier_shift_bit %fn unit i32 \unit:
    1

//: key_modifier_alt_bit: std layer の Alt modifier bit を[返/かえ]す
pub fn key_modifier_alt_bit %fn unit i32 \unit:
    2

//: key_modifier_control_bit: std layer の Control modifier bit を[返/かえ]す
pub fn key_modifier_control_bit %fn unit i32 \unit:
    4

//: keyboard_event_from_key_code: std key code と modifier bit から `KeyboardEvent` を[作/つく]る
//:
//: [目的/もくてき]:
//: - platform adapter や test が、std layer の key code contract に[沿/そ]った `KeyboardEvent` を明示的に[作/つく]れるようにします。
//:
//: [注意/ちゅうい]:
//: - raw sequence parsing はここでは[行/おこな]いません。すでに std key code と modifier bit に[正規化/せいきか]された値だけを[受/う]け[取/と]ります。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn keyboard_event_from_key_code %fn KeyboardEventKind fn i32 fn i32 KeyboardEvent \kind\key_code\modifier_bits:
    KeyboardEvent kind key_code key_modifiers_new modifier_bits

//: keyboard_event_kind: keyboard event kind を[読/よ]む
fn keyboard_event_kind %fn &KeyboardEvent KeyboardEventKind \event:
    *field::get_ref event "kind"

//: keyboard_event_key_code: keyboard event の key code を[読/よ]む
//:
//: [目的/もくてき]:
//: - platform adapter の test や上位 mapping が、raw sequence ではなく正規化済み key code を[確認/かくにん]できるようにします。
pub fn keyboard_event_key_code %fn &KeyboardEvent i32 \event:
    *field::get_ref event "key_code"

//: keyboard_event_modifier_bits: keyboard event の modifier bitset を[読/よ]む
//:
//: [目的/もくてき]:
//: - modifier decoding が std modifier bit contract に[変換/へんかん]されたことを[確認/かくにん]できるようにします。
pub fn keyboard_event_modifier_bits %fn &KeyboardEvent i32 \event:
    let modifiers %KeyModifiers *field::get_ref event "modifiers"
    *field::get_ref &modifiers "bits"

//: focus_key_map_tab_key_code: Tab key code を[読/よ]む
fn focus_key_map_tab_key_code %fn &FocusKeyMap i32 \key_map:
    *field::get_ref key_map "tab_key_code"

//: focus_key_map_enter_key_code: Enter key code を[読/よ]む
fn focus_key_map_enter_key_code %fn &FocusKeyMap i32 \key_map:
    *field::get_ref key_map "enter_key_code"

//: focus_key_map_space_key_code: Space key code を[読/よ]む
fn focus_key_map_space_key_code %fn &FocusKeyMap i32 \key_map:
    *field::get_ref key_map "space_key_code"

//: focus_key_map_shift_modifier_mask: Shift modifier mask を[読/よ]む
fn focus_key_map_shift_modifier_mask %fn &FocusKeyMap i32 \key_map:
    *field::get_ref key_map "shift_modifier_mask"

//: focus_key_event_has_shift: event が key map の Shift mask を[含/ふく]むか[判定/はんてい]する
fn focus_key_event_has_shift %fn &FocusKeyMap fn &KeyboardEvent bool \key_map\event:
    let mask %i32 focus_key_map_shift_modifier_mask key_map
    let bits %i32 keyboard_event_modifier_bits event
    if eq mask 0:
        then false
        else:
            let overlap %i32 and bits mask
            ne overlap 0

//: focus_key_down_command: KeyDown event の key code を focus command へ[変換/へんかん]する
fn focus_key_down_command %fn &FocusKeyMap fn &KeyboardEvent Option FocusRouteCommand \key_map\event:
    let key_code %i32 keyboard_event_key_code event
    if eq key_code focus_key_map_tab_key_code key_map:
        then:
            if focus_key_event_has_shift key_map event:
                then some FocusRouteCommand::Previous
                else some FocusRouteCommand::Next
        else:
            if eq key_code focus_key_map_enter_key_code key_map:
                then some FocusRouteCommand::Activate
                else:
                    if eq key_code focus_key_map_space_key_code key_map:
                        then some FocusRouteCommand::Activate
                        else none

//: keyboard_event_to_focus_route_command: `KeyboardEvent` を focus routing command へ[変換/へんかん]する
//:
//: [仕様/しよう]:
//: - `KeyDown` の Tab は `Next`、Shift+Tab は `Previous`、Enter と Space は `Activate` です。
//: - `KeyUp` と未定義 key code は `Option::None` です。
//:
//: [計算量/けいさんりょう]:
//: - key code と modifier mask だけを[調/しら]べるため O(1) です。
pub fn keyboard_event_to_focus_route_command %fn &FocusKeyMap fn KeyboardEvent Option FocusRouteCommand \key_map\event:
    match keyboard_event_kind &event:
        KeyboardEventKind::KeyDown:
            focus_key_down_command key_map &event
        KeyboardEventKind::KeyUp:
            none
