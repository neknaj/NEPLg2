//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_execution_driver_prepare %fn GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending \pending:
    let request gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_request &pending
    let action %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_execution_action &request
    gui_rgba8888_compositor_tile_rle_present_host_execution_driver_pending_new pending action

