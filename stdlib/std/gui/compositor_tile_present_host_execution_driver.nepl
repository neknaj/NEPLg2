//: gui_rgba8888_compositor_tile_rle_present_host_execution_driver_complete_outcome: executor outcome を loop completion へ[戻/もど]す
//:
//: [契約/けいやく]:
//: - action を[読/よ]んでから pending value を driver から[取/と]り[出/だ]します。
//: - F5na report を[作/つく]り、F5nd bridge に validation と completion を[委譲/いじょう]します。
//: - F5nc completion、F5nb validation、F5mx request construction を[直接/ちょくせつ][呼/よ]びません。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_tile_rle_present_host_execution_driver_complete_outcome %fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport fn GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending fn Result unit GuiError Result GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion GuiRgba8888CompositorTileRlePresentHostExecutionDriverError \support\driver\outcome:
    let action %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_execution_driver_pending_action &driver
    let pending %GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest field::get driver "pending"
    let report %GuiRgba8888CompositorTileRlePresentHostExecutionReport gui_rgba8888_compositor_tile_rle_present_host_execution_report action outcome
    match gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_complete support pending report:
        Result::Ok completion:
            Result::Ok completion
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_present_host_execution_driver_bridge_error lower

