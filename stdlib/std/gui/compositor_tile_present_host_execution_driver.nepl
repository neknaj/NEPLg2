//: GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending: executor action と pending owner を[保持/ほじ]する
//:
//: pending value を one-shot completion まで[所有/しょゆう]するため Clone / Copy を[実装/じっそう]しません。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending:
    pending %GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest
    action %GuiRgba8888CompositorTileRlePresentHostExecutionAction

//: GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind: driver failure の[種類/しゅるい]
//:
//: validation と completion の lower failure は F5nd bridge error として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind:
    BridgeFailed %GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentHostExecutionDriverError: category と recovery state を[持/も]つ driver error
//:
//: F5nd bridge error から category と loop state を[回収/かいしゅう]し、actual executor wrapper が recovery を[選/えら]べるようにします。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorTileRlePresentHostExecutionDriverError:
    kind %GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind
    category %Option GuiError
    state %GuiRgba8888CompositorTileRlePresentDispatchLoopState

impl Clone for GuiRgba8888CompositorTileRlePresentHostExecutionDriverError:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentHostExecutionDriverError GuiRgba8888CompositorTileRlePresentHostExecutionDriverError \error:
        *error

impl Copy for GuiRgba8888CompositorTileRlePresentHostExecutionDriverError:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentHostExecutionDriverError GuiRgba8888CompositorTileRlePresentHostExecutionDriverError \error:
        error

//: gui_rgba8888_compositor_tile_rle_present_host_execution_driver_pending_new: driver pending payload を[作/つく]る
//:
