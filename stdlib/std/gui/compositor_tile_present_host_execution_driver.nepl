    let kind %GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind GuiRgba8888CompositorTileRlePresentHostExecutionDriverErrorKind::BridgeFailed lower
    gui_rgba8888_compositor_tile_rle_present_host_execution_driver_error_new kind category state

//: gui_rgba8888_compositor_tile_rle_present_host_execution_driver_prepare: pending request を executor action と[一緒/いっしょ]に[保持/ほじ]する
//:
//: [契約/けいやく]:
