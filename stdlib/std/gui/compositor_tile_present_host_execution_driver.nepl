fn gui_rgba8888_compositor_tile_rle_present_host_execution_driver_bridge_error %fn GuiRgba8888CompositorTileRlePresentHostReportLoopBridgeError GuiRgba8888CompositorTileRlePresentHostExecutionDriverError \lower:
    let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_host_report_loop_bridge_error_category_value &lower
