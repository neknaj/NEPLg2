//: gui_rgba8888_compositor_tile_rle_present_schedule_step_error_category: error kind を coarse GUI category へ[写/うつ]す
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_schedule_step_error_category %fn GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PolicyMaxCommandsInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PolicyMaxPixelsInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::RunPixelCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::RunPixelBudgetExceeded:
            Option::Some GuiError::ResourceExhausted
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::CommandBudgetExceeded:
            Option::Some GuiError::ResourceExhausted
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PixelBudgetExceeded:
            Option::Some GuiError::ResourceExhausted
        GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::VirtualDrainFailed _:
            Option::Some GuiError::InvalidCommand
        _:
            Option::Some GuiError::InvalidCommand

