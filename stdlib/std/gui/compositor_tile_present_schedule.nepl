fn gui_rgba8888_compositor_tile_rle_present_schedule_validate_policy_for_step %fn &GuiRgba8888CompositorTileRlePresentSchedulePolicy Result unit GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind \policy:
    let max_commands %i32 gui_rgba8888_compositor_tile_rle_present_schedule_policy_max_commands_per_slice policy
    if le max_commands 0:
        then Result::Err GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PolicyMaxCommandsInvalid
        else:
