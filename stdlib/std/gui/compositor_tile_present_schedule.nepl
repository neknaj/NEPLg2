//: # std/gui/compositor_tile_present_schedule
//: compositor tile RLE present host-command stream の scheduling boundary
//:
//: ### [目的/もくてき]
//: - F5mu の metadata [付/つ]き compositor host-command record stream を、host continuation / scheduler に[渡/わた]す[前/まえ]に deterministic な slice budget で[区切/くぎ]るための std layer boundary です。
//: - F5mv virtual drain を stream validation の single authority として[用/もち]い、この module は slice counter と yield decision だけを[担当/たんとう]します。
//:
//: ### [契約/けいやく]
//: - input は `GuiRgba8888CompositorTileRlePresentHostCommandRecord` だけです。
//: - Begin / Run / End の[順序/じゅんじょ]、metadata [整合/せいごう]、run offset continuity は F5mv に[委譲/いじょう]します。
//: - `Yield` は valid record を[消費/しょうひ]した[後/あと]に slice budget へちょうど[到達/とうたつ]したことを[表/あらわ]します。
//: - budget [超過/ちょうか]は fallback ではなく typed error です。single run が pixel budget を[超/こ]える場合も error です。
//: - lower F5ct / F5cs / F5cq、timer、queue、host import、platform API、DOM、Canvas、minifb、video memory はこの module に[含/ふく]めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_schedule" as *
//: ```

#indent 4

#import "alloc/gui/render2d/row_tile_rle" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/compositor_tile_present_host_command" as *
#import "std/gui/compositor_tile_present_virtual_drain" as *

//: GuiRgba8888CompositorTileRlePresentSchedulePolicy: compositor present record slice の[上限/じょうげん]
//:
//: command count と pixel count の 2 つの budget を positive value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorTileRlePresentSchedulePolicy:
    max_commands_per_slice %i32
    max_pixels_per_slice %i32

impl Clone for GuiRgba8888CompositorTileRlePresentSchedulePolicy:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentSchedulePolicy GuiRgba8888CompositorTileRlePresentSchedulePolicy \policy:
        *policy

impl Copy for GuiRgba8888CompositorTileRlePresentSchedulePolicy:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentSchedulePolicy GuiRgba8888CompositorTileRlePresentSchedulePolicy \policy:
        policy

//: GuiRgba8888CompositorTileRlePresentSchedulePolicyErrorKind: policy [生成/せいせい][失敗/しっぱい]の[原因/げんいん]
//:
//: budget は 0 以下を[許可/きょか]しないため、command と pixel を[分/わ]けて[返/かえ]します。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorTileRlePresentSchedulePolicyErrorKind:
    MaxCommandsPerSliceInvalid
    MaxPixelsPerSliceInvalid

impl Clone for GuiRgba8888CompositorTileRlePresentSchedulePolicyErrorKind:
