fn gui_rgba8888_compositor_tile_rle_present_schedule_checked_add %fn i32 fn i32 fn GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind Result i32 GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 gui_rgba8888_compositor_tile_rle_present_schedule_i32_max
            let max_left %i32 sub max_i32 right
            if gt left max_left:
                then Result::Err overflow_kind
                else Result::Ok add left right

//: gui_rgba8888_compositor_tile_rle_present_schedule_count_result: F5mv success 後の counter と phase を[決/き]める
//:
//: Completed は budget comparison より[優先/ゆうせん]し、Yield は budget ちょうどの[到達/とうたつ]だけにします。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_schedule_count_result %fn &GuiRgba8888CompositorTileRlePresentSchedulePolicy fn GuiRgba8888CompositorTileRlePresentScheduleState fn GuiRgba8888CompositorTileRlePresentVirtualDrain fn i32 Result GuiRgba8888CompositorTileRlePresentScheduleStep GuiRgba8888CompositorTileRlePresentScheduleStepError \policy\previous_state\next_drain\pixel_cost:
    let slice_command_count %i32 gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &previous_state
    if lt slice_command_count 0:
        then Result::Err gui_rgba8888_compositor_tile_rle_present_schedule_step_error GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::SliceCommandCountInvalid previous_state
        else:
            let slice_pixel_count %i32 gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &previous_state
            if lt slice_pixel_count 0:
                then Result::Err gui_rgba8888_compositor_tile_rle_present_schedule_step_error GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::SlicePixelCountInvalid previous_state
                else:
                    match gui_rgba8888_compositor_tile_rle_present_schedule_checked_add slice_command_count 1 GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::CommandCountOverflow:
                        Result::Err kind:
                            Result::Err gui_rgba8888_compositor_tile_rle_present_schedule_step_error kind previous_state
                        Result::Ok next_command_count:
                            match gui_rgba8888_compositor_tile_rle_present_schedule_checked_add slice_pixel_count pixel_cost GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PixelCountOverflow:
                                Result::Err kind:
                                    Result::Err gui_rgba8888_compositor_tile_rle_present_schedule_step_error kind previous_state
                                Result::Ok next_pixel_count:
                                    let next_state %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_schedule_state_new next_drain next_command_count next_pixel_count
                                    if gui_rgba8888_compositor_tile_rle_present_virtual_drain_is_ended &next_drain:
                                        then Result::Ok gui_rgba8888_compositor_tile_rle_present_schedule_step_new next_state GuiRgba8888CompositorTileRlePresentSchedulePhase::Completed
