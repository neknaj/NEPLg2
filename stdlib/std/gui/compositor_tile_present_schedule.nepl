            if le max_pixels 0:
                then Result::Err GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::PolicyMaxPixelsInvalid
                else Result::Ok unit

//: gui_rgba8888_compositor_tile_rle_present_schedule_record_pixel_cost: F5mu record の pixel cost を[求/もと]める
//:
//: Begin / End は 0 cost、Run は RLE run の pixel count を cost にします。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_schedule_record_pixel_cost %fn &GuiRgba8888CompositorTileRlePresentHostCommandRecord Result i32 GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind \record:
    match *record:
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::BeginFrame _descriptor:
            Result::Ok 0
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::RunRecord run_record:
            let run %GuiRgba8888RowTileRleRun gui_rgba8888_compositor_tile_rle_present_host_command_run_record_run &run_record
            let pixel_count %i32 gui_rgba8888_row_tile_rle_run_pixel_count &run
            if le pixel_count 0:
                then Result::Err GuiRgba8888CompositorTileRlePresentScheduleStepErrorKind::RunPixelCountInvalid
                else Result::Ok pixel_count
        GuiRgba8888CompositorTileRlePresentHostCommandRecord::EndFrame _descriptor:
            Result::Ok 0

