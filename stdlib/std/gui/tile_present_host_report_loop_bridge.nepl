    *field::get_ref error "category"

pub fn gui_rgba8888_row_tile_rle_present_host_report_loop_bridge_error_state %fn &GuiRgba8888RowTileRlePresentHostReportLoopBridgeError GuiRgba8888RowTileRlePresentDispatchLoopState \error:
    *field::get_ref error "state"
