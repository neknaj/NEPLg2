//: # std/gui/runtime
//: GuiEffect を host dispatch value へ[解釈/かいしゃく]する runtime helper
//:
//: ### [目的/もくてき]
//: - application が[返/かえ]した `GuiEffect` を、platform host が[実行/じっこう]できる typed command value へ[変換/へんかん]します。
//: - 初期 contract では実行を行わず、`Result GuiRuntimeCommand GuiError` を[返/かえ]して unsupported や invalid command を静的に[扱/あつか]えるようにします。
//:
//: ### [注意/ちゅうい]
//: - この module は window title API、redraw API、event loop を直接[呼/よ]びません。platform backend は `GuiRuntimeCommand` を[受/う]けて[解釈/かいしゃく]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/runtime" as *
//: ```

#indent 4

#import "alloc/gui" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/host" as *
#import "std/gui/window" as *

//: WindowTitleUpdate: title change request の typed payload
pub struct WindowTitleUpdate:
    window %WindowId
    title %str

impl Clone for WindowTitleUpdate:
    fn clone %fn &WindowTitleUpdate WindowTitleUpdate \update:
        *update

impl Copy for WindowTitleUpdate:
    fn copy_mark %fn WindowTitleUpdate WindowTitleUpdate \update:
        update

//: GuiRuntimeCommand: platform host が[実行/じっこう]する command value
pub enum GuiRuntimeCommand:
    Noop
    RequestRedraw %WindowId
    SetTitle %WindowTitleUpdate

impl Clone for GuiRuntimeCommand:
    fn clone %fn &GuiRuntimeCommand GuiRuntimeCommand \command:
        *command

impl Copy for GuiRuntimeCommand:
    fn copy_mark %fn GuiRuntimeCommand GuiRuntimeCommand \command:
        command

//: GuiRuntimeCommandBatch: runtime が host へ[渡/わた]す command 群
//:
//: [現状/げんじょう]:
//: - `GuiEffectBatch` と同じ capacity 2 の bounded batch です。capacity overflow は `GuiError::ResourceExhausted` を[返/かえ]します。
pub struct GuiRuntimeCommandBatch:
    first %GuiRuntimeCommand
    second %GuiRuntimeCommand
    count %i32

impl Clone for GuiRuntimeCommandBatch:
    fn clone %fn &GuiRuntimeCommandBatch GuiRuntimeCommandBatch \batch:
        *batch

impl Copy for GuiRuntimeCommandBatch:
    fn copy_mark %fn GuiRuntimeCommandBatch GuiRuntimeCommandBatch \batch:
        batch

//: window_title_update: title change payload を[作/つく]る
pub fn window_title_update %fn WindowId fn str WindowTitleUpdate \window\title:
    WindowTitleUpdate window title

//: window_title_update_window: title change target window を[読/よ]む
pub fn window_title_update_window %fn &WindowTitleUpdate WindowId \update:
    *field::get_ref update "window"

//: window_title_update_title: title change text を[読/よ]む
pub fn window_title_update_title %fn &WindowTitleUpdate str \update:
    *field::get_ref update "title"

//: gui_runtime_command_batch_empty: 空 command batch を[作/つく]る
pub fn gui_runtime_command_batch_empty %fn unit GuiRuntimeCommandBatch \unit:
    GuiRuntimeCommandBatch GuiRuntimeCommand::Noop GuiRuntimeCommand::Noop 0

//: gui_runtime_command_batch_count: command count を[読/よ]む
pub fn gui_runtime_command_batch_count %fn &GuiRuntimeCommandBatch i32 \batch:
    *field::get_ref batch "count"

//: gui_runtime_command_batch_first: 1 個目の command を Option で[読/よ]む
pub fn gui_runtime_command_batch_first %fn &GuiRuntimeCommandBatch Option GuiRuntimeCommand \batch:
    let count %i32 gui_runtime_command_batch_count batch
    if eq count 0:
        then none
        else:
            let first %GuiRuntimeCommand *field::get_ref batch "first"
            some first

//: gui_runtime_command_batch_second: 2 個目の command を Option で[読/よ]む
pub fn gui_runtime_command_batch_second %fn &GuiRuntimeCommandBatch Option GuiRuntimeCommand \batch:
    let count %i32 gui_runtime_command_batch_count batch
    if lt count 2:
        then none
        else:
            let second %GuiRuntimeCommand *field::get_ref batch "second"
            some second

//: gui_runtime_command_batch_push: bounded command batch に command を[追加/ついか]する
pub fn gui_runtime_command_batch_push %fn GuiRuntimeCommandBatch fn GuiRuntimeCommand Result GuiRuntimeCommandBatch GuiError \batch\command:
    match command:
        GuiRuntimeCommand::Noop:
            Result::Ok batch
        _:
            let count %i32 gui_runtime_command_batch_count &batch
            if eq count 0:
                then Result::Ok GuiRuntimeCommandBatch command GuiRuntimeCommand::Noop 1
                else:
                    if eq count 1:
                        then:
                            let first %GuiRuntimeCommand *field::get_ref &batch "first"
                            Result::Ok GuiRuntimeCommandBatch first command 2
                        else Result::Err GuiError::ResourceExhausted

//: gui_runtime_can_request_redraw: host が redraw request を[受/う]けられるか[確認/かくにん]する
fn gui_runtime_can_request_redraw %fn &GuiHost bool \host:
    let capabilities %GuiCapabilities gui_host_capabilities host
    not surface_kind_is_headless gui_capabilities_surface_kind &capabilities

//: gui_runtime_can_set_title: host が title change を[受/う]けられるか[確認/かくにん]する
fn gui_runtime_can_set_title %fn &GuiHost bool \host:
    let capabilities %GuiCapabilities gui_host_capabilities host
    gui_capabilities_has_windowing &capabilities

//: gui_runtime_interpret_effect: GuiEffect を runtime command に[変換/へんかん]する
pub fn gui_runtime_interpret_effect %fn &GuiHost fn GuiEffect Result GuiRuntimeCommand GuiError \host\effect:
    match effect:
        GuiEffect::None:
            gui_ok GuiRuntimeCommand::Noop
        GuiEffect::RequestRedraw payload:
            if gui_runtime_can_request_redraw host:
                then:
                    let target %i32 field::get payload "target"
                    gui_ok GuiRuntimeCommand::RequestRedraw window_id target
                else Result::Err GuiError::Unsupported
        GuiEffect::SetTitle payload:
            if gui_runtime_can_set_title host:
                then:
                    let target %i32 field::get payload "target"
                    let title %str field::get payload "title"
                    gui_ok GuiRuntimeCommand::SetTitle window_title_update window_id target title
                else Result::Err GuiError::Unsupported

//: gui_runtime_interpret_second_effect: 2 個目の effect を command batch に[反映/はんえい]する
fn gui_runtime_interpret_second_effect %fn &GuiHost fn GuiRuntimeCommandBatch fn GuiEffectBatch Result GuiRuntimeCommandBatch GuiError \host\commands\effects:
    match gui_effect_batch_second &effects:
        Option::Some effect:
            match gui_runtime_interpret_effect host effect:
                Result::Ok command:
                    gui_runtime_command_batch_push commands command
                Result::Err error:
                    Result::Err error
        Option::None:
            Result::Ok commands

//: gui_runtime_interpret_effects: GuiEffectBatch 全体を runtime command batch に[変換/へんかん]する
pub fn gui_runtime_interpret_effects %fn &GuiHost fn GuiEffectBatch Result GuiRuntimeCommandBatch GuiError \host\effects:
    let empty %GuiRuntimeCommandBatch gui_runtime_command_batch_empty
    match gui_effect_batch_first &effects:
        Option::Some effect:
            match gui_runtime_interpret_effect host effect:
                Result::Ok command:
                    match gui_runtime_command_batch_push empty command:
                        Result::Ok commands:
                            gui_runtime_interpret_second_effect host commands effects
                        Result::Err error:
                            Result::Err error
                Result::Err error:
                    Result::Err error
        Option::None:
            Result::Ok empty

//: gui_runtime_interpret_update: Update に[含/ふく]まれる effect 群を runtime command batch に[変換/へんかん]する
pub fn gui_runtime_interpret_update <.Model> %fn &GuiHost fn Update .Model Result GuiRuntimeCommandBatch GuiError \host\update:
    gui_runtime_interpret_effects host update_effects update
