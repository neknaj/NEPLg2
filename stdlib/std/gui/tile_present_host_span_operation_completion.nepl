    *field::get_ref failure "ready"

pub fn gui_rgba8888_row_tile_rle_present_host_span_operation_completion_host_failed_attempt %fn &GuiRgba8888RowTileRlePresentHostSpanOperationCompletionHostFailed GuiRgba8888RowTileRlePresentHostSpanOperationAttempt \failure:
