#import "std/gui/tile_present_run_cursor" as *

//: GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind: compositor run cursor start bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower F5co run cursor start failure と F5mq rewrap failure を compositor layer の typed kind として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind:
    RunCursorStartFailed %GuiRgba8888RowTileRlePresentRunCursorStartErrorKind
    PresentFrameRewrapFailed %GuiRgba8888CompositorTileRlePresentFrameRewrapErrorKind

impl Clone for GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentRunCursorOwner: lower run cursor owner と compositor metadata の owner
//:
//: lower F5co run cursor を[保持/ほじ]しつつ、recovery / abort 時に compositor metadata を[失/うしな]わないための wrapper です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
pub struct GuiRgba8888CompositorTileRlePresentRunCursorOwner:
    run_cursor %GuiRgba8888RowTileRlePresentRunCursorOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTileRlePresentRunCursorStartError: present-frame owner を[回収/かいしゅう]できる start error
//:
//: lower run cursor start failure でも metadata [付/つ]き compositor present-frame owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
pub struct GuiRgba8888CompositorTileRlePresentRunCursorStartError:
    kind %GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind
    category %Option GuiError
    present %GuiRgba8888CompositorTileRlePresentFrameOwner

//: gui_rgba8888_compositor_tile_rle_present_run_cursor_owner_new: lower run cursor owner と metadata を[束/たば]ねる
//:
//: lower F5co start が[成功/せいこう]した後だけ呼ぶ module-private constructor です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_cursor_owner_new %fn GuiRgba8888RowTileRlePresentRunCursorOwner fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRlePresentRunCursorOwner \run_cursor\metadata:
    GuiRgba8888CompositorTileRlePresentRunCursorOwner run_cursor metadata

//: gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_new: start error payload を[作/つく]る
//:
//: kind、category、recovery present-frame owner を 1 つの owner-bearing error にまとめます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_new %fn GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind fn Option GuiError fn GuiRgba8888CompositorTileRlePresentFrameOwner GuiRgba8888CompositorTileRlePresentRunCursorStartError \kind\category\present:
    GuiRgba8888CompositorTileRlePresentRunCursorStartError kind category present

//: gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_from_lower: lower F5co start error を compositor error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから lower present owner を[回収/かいしゅう]し、metadata [付/つ]き compositor present-frame owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_from_lower %fn GuiRgba8888RowTileRlePresentRunCursorStartError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRlePresentRunCursorStartError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRlePresentRunCursorStartErrorKind gui_rgba8888_row_tile_rle_present_run_cursor_start_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_present_run_cursor_start_error_category_value &lower
    let lower_present %GuiRgba8888RowTileRlePresentFrameOwner gui_rgba8888_row_tile_rle_present_run_cursor_start_error_finish_present lower
    match gui_rgba8888_compositor_tile_rle_present_frame_rewrap lower_present metadata:
        Result::Err rewrap:
            let rewrap_kind %GuiRgba8888CompositorTileRlePresentFrameRewrapErrorKind gui_rgba8888_compositor_tile_rle_present_frame_rewrap_error_kind &rewrap
            let rewrap_category %Option GuiError gui_rgba8888_compositor_tile_rle_present_frame_rewrap_error_category_value &rewrap
            let present %GuiRgba8888CompositorTileRlePresentFrameOwner gui_rgba8888_compositor_tile_rle_present_frame_rewrap_error_finish_present_frame rewrap
            let kind %GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind::PresentFrameRewrapFailed rewrap_kind
            gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_new kind rewrap_category present
        Result::Ok present:
            let kind %GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind GuiRgba8888CompositorTileRlePresentRunCursorStartErrorKind::RunCursorStartFailed lower_kind
            gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_new kind category present

//: gui_rgba8888_compositor_tile_rle_present_run_cursor_start: compositor present-frame owner を run cursor に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower present owner を[取/と]り[出/だ]します。
//: - lower F5co start を 1 [回/かい]だけ[呼/よ]び、success では lower run cursor owner と metadata を[包/つつ]みます。
//: - lower error では present-frame owner を metadata [付/つ]き recovery owner として[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_run_cursor" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_present_run_cursor_start %fn GuiRgba8888CompositorTileRlePresentFrameOwner Result GuiRgba8888CompositorTileRlePresentRunCursorOwner GuiRgba8888CompositorTileRlePresentRunCursorStartError \present:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_owner_metadata &present
    let lower_present %GuiRgba8888RowTileRlePresentFrameOwner gui_rgba8888_compositor_tile_rle_present_frame_owner_finish_present_frame present
    match gui_rgba8888_row_tile_rle_present_run_cursor_start lower_present:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_present_run_cursor_start_error_from_lower lower metadata
        Result::Ok lower_cursor:
            Result::Ok gui_rgba8888_compositor_tile_rle_present_run_cursor_owner_new lower_cursor metadata

