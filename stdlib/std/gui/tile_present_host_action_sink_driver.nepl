//: gui_rgba8888_row_tile_rle_present_host_action_sink_driver_step: F5dc sink step を F5da one-shot completion へ[接続/せつぞく]する
//:
//: [契約/けいやく]:
//: - F5da driver pending から action を[借用/しゃくよう]で[読/よ]み、F5dc support preflight と outcome packaging を[先/さき]に[行/おこな]います。
//: - F5dc が[拒否/きょひ]した[場合/ばあい]、driver pending は error payload へ[移/うつ]され、F5da completion は[呼/よ]ばれません。
//: - F5dc が[成功/せいこう]した[場合/ばあい]だけ、同じ caller-supplied outcome で F5da completion を[呼/よ]びます。
pub fn gui_rgba8888_row_tile_rle_present_host_action_sink_driver_step %fn GuiRgba8888RowTileRlePresentHostExecutorSupport fn GuiRgba8888RowTileRlePresentHostExecutionDriverPending fn Result unit GuiError Result GuiRgba8888RowTileRlePresentHostActionSinkDriverStep GuiRgba8888RowTileRlePresentHostActionSinkDriverError \support\driver\outcome:
    let action gui_rgba8888_row_tile_rle_present_host_execution_driver_pending_action &driver
    match gui_rgba8888_row_tile_rle_present_host_action_sink_step support action outcome:
        Result::Err sink_error:
            Result::Err gui_rgba8888_row_tile_rle_present_host_action_sink_driver_sink_error sink_error driver
        Result::Ok sink_step:
            match gui_rgba8888_row_tile_rle_present_host_execution_driver_complete_outcome support driver outcome:
                Result::Ok completion:
                    Result::Ok gui_rgba8888_row_tile_rle_present_host_action_sink_driver_step_new sink_step completion
                Result::Err driver_error:
                    Result::Err gui_rgba8888_row_tile_rle_present_host_action_sink_driver_completion_error sink_step driver_error

