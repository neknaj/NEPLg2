pub fn gui_rgba8888_row_tile_rle_present_frame_prepare_error_free %fn GuiRgba8888RowTileRlePresentFramePrepareError Result unit GuiRgba8888RowTileRleEncodedFinishErrorKind \error:
    let packet %GuiRgba8888RowTileRlePacketOwner gui_rgba8888_row_tile_rle_present_frame_prepare_error_finish_packet error
    gui_rgba8888_row_tile_rle_packet_owner_free packet

pub fn gui_rgba8888_row_tile_rle_present_frame_owner_free %fn GuiRgba8888RowTileRlePresentFrameOwner Result unit GuiRgba8888RowTileRleEncodedFinishErrorKind \owner:
    let packet %GuiRgba8888RowTileRlePacketOwner gui_rgba8888_row_tile_rle_present_frame_finish_packet owner
    gui_rgba8888_row_tile_rle_packet_owner_free packet
