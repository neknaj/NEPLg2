//: # std/gui/tile_present_host_execution_report
//: RGBA8888 row tile RLE present host execution report の std layer boundary
//:
//: ### [目的/もくてき]
//: - F5cw の executor action と platform executor が[返/かえ]した outcome を、action context を[失/うしな]わない typed report に[束/たば]ねます。
//: - actual host import は[実行/じっこう]せず、Web / native / bare executor が[返/かえ]す[結果/けっか]の[形/かたち]だけを std layer で[固定/こてい]します。
//:
//: ### [契約/けいやく]
//: - report construction は executor outcome を[包/つつ]むだけなので、新しい failure mode を[作/つく]りません。
//: - failure は string や bool ではなく `GuiError` payload として[保持/ほじ]します。
//: - F5cv pending completion には[進/すす]まず、caller が `report_outcome` で[元/もと]の `Result unit GuiError` を[渡/わた]します。
//: - platform API、DOM、Canvas、minifb、video memory、queue、timer、scheduler、dispatch loop、fallback、silent no-op は[含/ふく]めません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/tile_present_host_execution_report" as *
//: ```

#indent 4

#import "core/field" as field
#import "core/gui/error" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/tile_present_host_execution" as *
#import "std/gui/tile_present_host_import" as *

pub enum GuiRgba8888RowTileRlePresentHostExecutionReportKind:
    Succeeded
    Failed %GuiError

impl Clone for GuiRgba8888RowTileRlePresentHostExecutionReportKind:
    fn clone %fn &GuiRgba8888RowTileRlePresentHostExecutionReportKind GuiRgba8888RowTileRlePresentHostExecutionReportKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRlePresentHostExecutionReportKind:
    fn copy_mark %fn GuiRgba8888RowTileRlePresentHostExecutionReportKind GuiRgba8888RowTileRlePresentHostExecutionReportKind \kind:
        kind

pub struct GuiRgba8888RowTileRlePresentHostExecutionReport:
    action %GuiRgba8888RowTileRlePresentHostExecutionAction
    kind %GuiRgba8888RowTileRlePresentHostExecutionReportKind

impl Clone for GuiRgba8888RowTileRlePresentHostExecutionReport:
    fn clone %fn &GuiRgba8888RowTileRlePresentHostExecutionReport GuiRgba8888RowTileRlePresentHostExecutionReport \report:
        *report

impl Copy for GuiRgba8888RowTileRlePresentHostExecutionReport:
    fn copy_mark %fn GuiRgba8888RowTileRlePresentHostExecutionReport GuiRgba8888RowTileRlePresentHostExecutionReport \report:
        report

fn gui_rgba8888_row_tile_rle_present_host_execution_report_kind_from_outcome %fn Result unit GuiError GuiRgba8888RowTileRlePresentHostExecutionReportKind \outcome:
    match outcome:
        Result::Ok _unit:
            GuiRgba8888RowTileRlePresentHostExecutionReportKind::Succeeded
        Result::Err error:
            GuiRgba8888RowTileRlePresentHostExecutionReportKind::Failed error

fn gui_rgba8888_row_tile_rle_present_host_execution_report_new %fn GuiRgba8888RowTileRlePresentHostExecutionAction fn GuiRgba8888RowTileRlePresentHostExecutionReportKind GuiRgba8888RowTileRlePresentHostExecutionReport \action\kind:
    GuiRgba8888RowTileRlePresentHostExecutionReport action kind

//: gui_rgba8888_row_tile_rle_present_host_execution_report: action と outcome を report に[束/たば]ねる
//:
//: [契約/けいやく]:
//: - outcome の Ok / Err を `Succeeded` / `Failed GuiError` に[写/うつ]します。
//: - actual executor の[成功/せいこう][失敗/しっぱい]を[解釈/かいしゃく]せず、action context と[一緒/いっしょ]に[保持/ほじ]します。
//: - report construction は `Result` を[返/かえ]しません。ここでは新しい validation を[行/おこな]わないためです。
pub fn gui_rgba8888_row_tile_rle_present_host_execution_report %fn GuiRgba8888RowTileRlePresentHostExecutionAction fn Result unit GuiError GuiRgba8888RowTileRlePresentHostExecutionReport \action\outcome:
    let kind %GuiRgba8888RowTileRlePresentHostExecutionReportKind gui_rgba8888_row_tile_rle_present_host_execution_report_kind_from_outcome outcome
    gui_rgba8888_row_tile_rle_present_host_execution_report_new action kind

//: gui_rgba8888_row_tile_rle_present_host_execution_report_for_request: request を action に[写/うつ]して outcome と[束/たば]ねる
//:
//: [契約/けいやく]:
//: - F5cw の action decoding を 1 [回/かい]だけ[呼/よ]びます。
//: - capability validation、request construction、dispatch loop completion は[行/おこな]いません。
pub fn gui_rgba8888_row_tile_rle_present_host_execution_report_for_request %fn &GuiRgba8888RowTileRlePresentHostImportRequest fn Result unit GuiError GuiRgba8888RowTileRlePresentHostExecutionReport \request\outcome:
    let action %GuiRgba8888RowTileRlePresentHostExecutionAction gui_rgba8888_row_tile_rle_present_host_execution_action request
    gui_rgba8888_row_tile_rle_present_host_execution_report action outcome

pub fn gui_rgba8888_row_tile_rle_present_host_execution_report_action %fn &GuiRgba8888RowTileRlePresentHostExecutionReport GuiRgba8888RowTileRlePresentHostExecutionAction \report:
    *field::get_ref report "action"

pub fn gui_rgba8888_row_tile_rle_present_host_execution_report_kind %fn &GuiRgba8888RowTileRlePresentHostExecutionReport GuiRgba8888RowTileRlePresentHostExecutionReportKind \report:
    *field::get_ref report "kind"

pub fn gui_rgba8888_row_tile_rle_present_host_execution_report_error %fn &GuiRgba8888RowTileRlePresentHostExecutionReport Result GuiError GuiError \report:
    let kind %GuiRgba8888RowTileRlePresentHostExecutionReportKind gui_rgba8888_row_tile_rle_present_host_execution_report_kind report
    match kind:
        GuiRgba8888RowTileRlePresentHostExecutionReportKind::Succeeded:
            Result::Err GuiError::InvalidCommand
        GuiRgba8888RowTileRlePresentHostExecutionReportKind::Failed error:
            Result::Ok error

pub fn gui_rgba8888_row_tile_rle_present_host_execution_report_outcome %fn &GuiRgba8888RowTileRlePresentHostExecutionReport Result unit GuiError \report:
    let kind %GuiRgba8888RowTileRlePresentHostExecutionReportKind gui_rgba8888_row_tile_rle_present_host_execution_report_kind report
    match kind:
        GuiRgba8888RowTileRlePresentHostExecutionReportKind::Succeeded:
            Result::Ok unit
        GuiRgba8888RowTileRlePresentHostExecutionReportKind::Failed error:
            Result::Err error
