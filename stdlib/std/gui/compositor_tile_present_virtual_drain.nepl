fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_error %fn GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind fn GuiRgba8888CompositorTileRlePresentVirtualDrain GuiRgba8888CompositorTileRlePresentVirtualDrainError \kind\drain:
    let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_virtual_drain_error_category kind
    GuiRgba8888CompositorTileRlePresentVirtualDrainError kind category drain

