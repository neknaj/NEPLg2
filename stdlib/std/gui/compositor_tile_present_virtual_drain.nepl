//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_count_matches: fixed expected counts と descriptor counts を[照合/しょうごう]する
//:
//: Run / End の descriptor が BeginFrame と同じ run / pixel count authority を[持/も]つことを[検査/けんさ]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_count_matches %fn &GuiRgba8888CompositorTileRlePresentVirtualDrain fn &GuiRgba8888CompositorTileRlePresentFrameDescriptor Result unit GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind \drain\descriptor:
    let expected_run_count %i32 gui_rgba8888_compositor_tile_rle_present_virtual_drain_expected_run_count drain
    let descriptor_run_count %i32 gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_run_count descriptor
    if ne expected_run_count descriptor_run_count:
        then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorExpectedRunCountMismatch
        else:
            let expected_pixel_count %i32 gui_rgba8888_compositor_tile_rle_present_virtual_drain_expected_pixel_count drain
            let descriptor_pixel_count %i32 gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_pixel_count descriptor
            if ne expected_pixel_count descriptor_pixel_count:
                then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorExpectedPixelCountMismatch
                else Result::Ok unit

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_metadata_matches: fixed metadata と descriptor metadata を[照合/しょうごう]する
//:
//: frame id、size、row range、batch count、batch capacity の full equality を[検査/けんさ]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_metadata_matches %fn &GuiRgba8888CompositorTileRlePresentVirtualDrain fn &GuiRgba8888CompositorTileRlePresentFrameDescriptor Result unit GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind \drain\descriptor:
    match gui_rgba8888_compositor_tile_rle_present_virtual_drain_metadata drain:
        Option::Some metadata:
            let descriptor_metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_descriptor_metadata descriptor
            let metadata_frame_id %i32 gui_rgba8888_compositor_frame_entry_metadata_frame_id &metadata
            let descriptor_frame_id %i32 gui_rgba8888_compositor_frame_entry_metadata_frame_id &descriptor_metadata
            if ne metadata_frame_id descriptor_frame_id:
                then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorMetadataFrameMismatch
                else:
                    let metadata_width %i32 gui_rgba8888_compositor_frame_entry_metadata_width &metadata
                    let descriptor_width %i32 gui_rgba8888_compositor_frame_entry_metadata_width &descriptor_metadata
                    if ne metadata_width descriptor_width:
                        then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorMetadataWidthMismatch
                        else:
                            let metadata_height %i32 gui_rgba8888_compositor_frame_entry_metadata_height &metadata
                            let descriptor_height %i32 gui_rgba8888_compositor_frame_entry_metadata_height &descriptor_metadata
                            if ne metadata_height descriptor_height:
                                then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorMetadataHeightMismatch
                                else:
                                    let metadata_row_start %i32 gui_rgba8888_compositor_frame_entry_metadata_row_start &metadata
                                    let descriptor_row_start %i32 gui_rgba8888_compositor_frame_entry_metadata_row_start &descriptor_metadata
                                    if ne metadata_row_start descriptor_row_start:
                                        then Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorMetadataRowStartMismatch
                                        else:
