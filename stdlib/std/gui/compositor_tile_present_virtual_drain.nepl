    drain %GuiRgba8888CompositorTileRlePresentVirtualDrain

impl Clone for GuiRgba8888CompositorTileRlePresentVirtualDrainError:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentVirtualDrainError GuiRgba8888CompositorTileRlePresentVirtualDrainError \error:
        *error

impl Copy for GuiRgba8888CompositorTileRlePresentVirtualDrainError:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentVirtualDrainError GuiRgba8888CompositorTileRlePresentVirtualDrainError \error:
        error

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_new: drain state を[組/く]み[立/た]てる
//:
//: phase、optional identity、metadata、count を 1 つの Copy state に[束/たば]ねます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_new %fn GuiRgba8888CompositorTileRlePresentVirtualDrainPhase fn Option SurfaceId fn Option FrameId fn Option GuiRgba8888CompositorFrameEntryMetadata fn i32 fn i32 fn i32 fn i32 GuiRgba8888CompositorTileRlePresentVirtualDrain \phase\surface\frame\metadata\expected_run_count\seen_run_count\expected_pixel_count\seen_pixel_count:
    GuiRgba8888CompositorTileRlePresentVirtualDrain phase surface frame metadata expected_run_count seen_run_count expected_pixel_count seen_pixel_count

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_error_category: error kind を coarse GUI category へ[写/うつ]す
//:
//: geometry 由来の値不正と stream command 不正を[分/わ]けます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_error_category %fn GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::ExpectedRunCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::ExpectedPixelCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::RunPixelCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::RunEndOutOfBounds:
            Option::Some GuiError::InvalidGeometry
        _:
            Option::Some GuiError::InvalidCommand

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_error: drain error payload を[作/つく]る
//:
//: kind と直前 state から category [付/つ]き error を[作/つく]ります。
