//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_frame_metadata_consistent: descriptor 内の frame と metadata frame を[照合/しょうごう]する
//:
//: descriptor frame id と metadata frame id が同じ frame を[指/さ]すことを[確/たし]かめます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_frame_metadata_consistent %fn &GuiRgba8888CompositorTileRlePresentFrameDescriptor Result unit GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind \descriptor:
    let descriptor_frame %FrameId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_frame descriptor
    let descriptor_frame_id %i32 frame_id_raw &descriptor_frame
    let descriptor_metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_descriptor_metadata descriptor
    let metadata_frame_id %i32 gui_rgba8888_compositor_frame_entry_metadata_frame_id &descriptor_metadata
    if eq descriptor_frame_id metadata_frame_id:
        then Result::Ok unit
        else Result::Err GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::DescriptorFrameMetadataMismatch

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_expected_counts_from_descriptor: BeginFrame descriptor から authority state を[作/つく]る
//:
//: expected count と descriptor / metadata consistency を[検査/けんさ]してから InFrame state へ[進/すす]めます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_tile_rle_present_virtual_drain_expected_counts_from_descriptor %fn &GuiRgba8888CompositorTileRlePresentFrameDescriptor fn GuiRgba8888CompositorTileRlePresentVirtualDrain Result GuiRgba8888CompositorTileRlePresentVirtualDrain GuiRgba8888CompositorTileRlePresentVirtualDrainError \descriptor\drain:
    let expected_run_count %i32 gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_run_count descriptor
    if le expected_run_count 0:
        then gui_rgba8888_compositor_tile_rle_present_virtual_drain_result_error GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::ExpectedRunCountInvalid drain
        else:
            let expected_pixel_count %i32 gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_pixel_count descriptor
            if le expected_pixel_count 0:
                then gui_rgba8888_compositor_tile_rle_present_virtual_drain_result_error GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind::ExpectedPixelCountInvalid drain
                else:
                    match gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_frame_metadata_consistent descriptor:
                        Result::Err kind:
                            gui_rgba8888_compositor_tile_rle_present_virtual_drain_result_error kind drain
                        Result::Ok _:
                            let surface %SurfaceId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_surface descriptor
                            let frame %FrameId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_frame descriptor
                            let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_descriptor_metadata descriptor
                            Result::Ok:
                                gui_rgba8888_compositor_tile_rle_present_virtual_drain_new:
                                    GuiRgba8888CompositorTileRlePresentVirtualDrainPhase::InFrame
                                    some surface
                                    some frame
                                    some metadata
                                    expected_run_count
                                    0
                                    expected_pixel_count
                                    0

//: gui_rgba8888_compositor_tile_rle_present_virtual_drain_descriptor_surface_matches: fixed surface と descriptor surface を[照合/しょうごう]する
//:
