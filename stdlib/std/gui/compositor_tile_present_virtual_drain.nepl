//: # std/gui/compositor_tile_present_virtual_drain
//: compositor tile RLE present host-command record の headless/test drain
//:
//: ### [目的/もくてき]
//: - F5mu の metadata [付/つ]き compositor host-command record stream を、headless / test で deterministic に[検査/けんさ]する virtual drain を[提供/ていきょう]します。
//: - この module は presentation target、host import、scheduler、platform presenter ではなく、Begin / Run / End の[順序/じゅんじょ]、count [整合/せいごう]、metadata [一貫性/いっかんせい]を[検査/けんさ]するだけです。
//:
//: ### [契約/けいやく]
//: - input は `GuiRgba8888CompositorTileRlePresentHostCommandRecord` だけです。
//: - lower F5cq / F5cs に[落/お]とさず、compositor descriptor と metadata を drain authority として[保持/ほじ]します。
//: - run は `pixel_offset == seen_pixel_count` を[要求/ようきゅう]し、gap / overlap / reorder を[検出/けんしゅつ]します。
//: - failure は enum kind と `Option GuiError` category と直前 drain state を[返/かえ]します。
//: - Headless を presentation target として[扱/あつか]わず、pixel present / screenshot の fallback も[行/おこな]いません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/gui/compositor_tile_present_virtual_drain" as *
//: ```

#indent 4

#import "alloc/gui/render2d/compositor_frame_entry" as *
#import "alloc/gui/render2d/row_tile_rle" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/compositor_tile_present" as *
#import "std/gui/compositor_tile_present_host_command" as *
#import "std/gui/window" as *

//: GuiRgba8888CompositorTileRlePresentVirtualDrainPhase: compositor virtual drain の[段階/だんかい]
//:
//: Begin [前/まえ]、frame [中/ちゅう]、End [後/あと]を enum で[表/あらわ]し、不正な record 順序を typed error にします。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorTileRlePresentVirtualDrainPhase:
    WaitingBegin
    InFrame
    Ended

impl Clone for GuiRgba8888CompositorTileRlePresentVirtualDrainPhase:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentVirtualDrainPhase GuiRgba8888CompositorTileRlePresentVirtualDrainPhase \phase:
        *phase

impl Copy for GuiRgba8888CompositorTileRlePresentVirtualDrainPhase:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentVirtualDrainPhase GuiRgba8888CompositorTileRlePresentVirtualDrainPhase \phase:
        phase

//: GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind: drain [失敗/しっぱい]の[原因/げんいん]
//:
//: record 順序、descriptor [不一致/ふいっち]、metadata [不一致/ふいっち]、run offset / count [不整合/ふせいごう]を[分/わ]けて[返/かえ]します。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind:
    BeginAfterBegin
    BeginAfterEnd
    RunBeforeBegin
    RunAfterEnd
    EndBeforeBegin
    EndAfterEnd
    SurfaceMissing
    FrameMissing
    MetadataMissing
    DescriptorSurfaceMismatch
    DescriptorFrameMismatch
    DescriptorFrameMetadataMismatch
    DescriptorExpectedRunCountMismatch
    DescriptorExpectedPixelCountMismatch
    DescriptorMetadataFrameMismatch
    DescriptorMetadataWidthMismatch
    DescriptorMetadataHeightMismatch
    DescriptorMetadataRowStartMismatch
    DescriptorMetadataRowCountMismatch
    DescriptorMetadataBatchCountMismatch
    DescriptorMetadataMaxRowsPerBatchMismatch
    ExpectedRunCountInvalid
    ExpectedPixelCountInvalid
    SeenRunCountInvalid
    SeenPixelCountInvalid
    RunPixelCountInvalid
    RunPixelOffsetMismatch
    RunEndOverflow
    RunEndOutOfBounds
    SeenRunCountOverflow
    SeenRunCountExceeded
    IncompleteRunCount
    IncompletePixelCount

impl Clone for GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind GuiRgba8888CompositorTileRlePresentVirtualDrainErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePresentVirtualDrain: compositor record stream の[検査/けんさ][状態/じょうたい]
//:
//: BeginFrame で surface / frame / metadata / expected count を[固定/こてい]し、RunRecord ごとに seen count を[進/すす]めます。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorTileRlePresentVirtualDrain:
    phase %GuiRgba8888CompositorTileRlePresentVirtualDrainPhase
    surface %Option SurfaceId
    frame %Option FrameId
    metadata %Option GuiRgba8888CompositorFrameEntryMetadata
    expected_run_count %i32
    seen_run_count %i32
    expected_pixel_count %i32
    seen_pixel_count %i32

impl Clone for GuiRgba8888CompositorTileRlePresentVirtualDrain:
    fn clone %fn &GuiRgba8888CompositorTileRlePresentVirtualDrain GuiRgba8888CompositorTileRlePresentVirtualDrain \drain:
        *drain

impl Copy for GuiRgba8888CompositorTileRlePresentVirtualDrain:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePresentVirtualDrain GuiRgba8888CompositorTileRlePresentVirtualDrain \drain:
        drain

