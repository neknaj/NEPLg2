//: gui_rgba8888_row_tile_rle_present_run_cursor_start: present-frame owner を typed run cursor に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - present owner は host へ[渡/わた]さず、この cursor owner に[移/うつ]します。
//: - count invariant が[壊/こわ]れている場合は original present owner を error に[保持/ほじ]します。
pub fn gui_rgba8888_row_tile_rle_present_run_cursor_start %fn GuiRgba8888RowTileRlePresentFrameOwner Result GuiRgba8888RowTileRlePresentRunCursorOwner GuiRgba8888RowTileRlePresentRunCursorStartError \present:
    let present_descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_frame_descriptor &present
    let packet_descriptor %GuiRgba8888RowTileRlePacketDescriptor gui_rgba8888_row_tile_rle_present_descriptor_packet &present_descriptor
    match gui_rgba8888_row_tile_rle_present_run_cursor_validate_descriptor &packet_descriptor:
        Result::Err kind:
            Result::Err gui_rgba8888_row_tile_rle_present_run_cursor_start_error kind present
        Result::Ok total_run_count:
            Result::Ok gui_rgba8888_row_tile_rle_present_run_cursor_owner_new present 0 total_run_count

//: gui_rgba8888_row_tile_rle_present_run_cursor_step: present cursor から 1 run を[読/よ]む
//:
//: [契約/けいやく]:
//: - `next_record_index == total_run_count` は `Completed` です。
//: - record read が[失敗/しっぱい]した場合は cursor owner を error に[保持/ほじ]します。
//: - success path だけが `next_record_index` を 1 [進/すす]めます。
pub fn gui_rgba8888_row_tile_rle_present_run_cursor_step %fn GuiRgba8888RowTileRlePresentRunCursorOwner Result GuiRgba8888RowTileRlePresentRunCursorStep GuiRgba8888RowTileRlePresentRunCursorStepError \owner:
    let next_record_index %i32 gui_rgba8888_row_tile_rle_present_run_cursor_owner_next_record_index &owner
    if lt next_record_index 0:
        then Result::Err gui_rgba8888_row_tile_rle_present_run_cursor_step_error GuiRgba8888RowTileRlePresentRunCursorStepErrorKind::RecordIndexNegative owner
        else:
            let total_run_count %i32 gui_rgba8888_row_tile_rle_present_run_cursor_owner_total_run_count &owner
            if gt next_record_index total_run_count:
                then Result::Err gui_rgba8888_row_tile_rle_present_run_cursor_step_error GuiRgba8888RowTileRlePresentRunCursorStepErrorKind::RecordIndexPastEnd owner
                else:
                    if eq next_record_index total_run_count:
                        then:
                            let result %GuiRgba8888RowTileRlePresentRunCursorStepResult GuiRgba8888RowTileRlePresentRunCursorStepResult::Completed
                            Result::Ok gui_rgba8888_row_tile_rle_present_run_cursor_step_new owner result
                        else:
                            let packet %&GuiRgba8888RowTileRlePacketOwner gui_rgba8888_row_tile_rle_present_run_cursor_packet_ref &owner
                            match gui_rgba8888_row_tile_rle_packet_record_at packet next_record_index:
                                Result::Err kind:
                                    Result::Err gui_rgba8888_row_tile_rle_present_run_cursor_step_error GuiRgba8888RowTileRlePresentRunCursorStepErrorKind::PacketRecordReadFailed kind owner
                                Result::Ok run:
                                    match gui_rgba8888_row_tile_rle_present_run_cursor_checked_add next_record_index 1:
                                        Result::Err kind:
                                            Result::Err gui_rgba8888_row_tile_rle_present_run_cursor_step_error kind owner
                                        Result::Ok next_index:
                                            let present %GuiRgba8888RowTileRlePresentFrameOwner field::get owner "present"
                                            let next_owner %GuiRgba8888RowTileRlePresentRunCursorOwner gui_rgba8888_row_tile_rle_present_run_cursor_owner_new present next_index total_run_count
                                            let result %GuiRgba8888RowTileRlePresentRunCursorStepResult GuiRgba8888RowTileRlePresentRunCursorStepResult::RunReady run
                                            Result::Ok gui_rgba8888_row_tile_rle_present_run_cursor_step_new next_owner result

