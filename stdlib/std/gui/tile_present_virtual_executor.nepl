//: gui_rgba8888_row_tile_rle_present_virtual_executor_execute: F5da pending を virtual executor で one-shot execution する
//:
//: [契約/けいやく]:
//: - support preflight が[失敗/しっぱい]した[場合/ばあい]、virtual drain は[更新/こうしん]せず pending だけを F5da で cleanup します。
//: - drain failure でも pending を F5da に Err outcome として[渡/わた]し、caller は同じ pending を[再利用/さいりよう]できません。
//: - success path は updated executor と dispatch loop completion を[返/かえ]します。
pub fn gui_rgba8888_row_tile_rle_present_virtual_executor_execute %fn GuiRgba8888RowTileRlePresentVirtualExecutor fn GuiRgba8888RowTileRlePresentHostExecutionDriverPending Result GuiRgba8888RowTileRlePresentVirtualExecutorStep GuiRgba8888RowTileRlePresentVirtualExecutorError \executor\driver:
    let action %GuiRgba8888RowTileRlePresentHostExecutionAction gui_rgba8888_row_tile_rle_present_host_execution_driver_pending_action &driver
    let support %GuiRgba8888RowTileRlePresentHostExecutorSupport gui_rgba8888_row_tile_rle_present_virtual_executor_support &executor
    match gui_rgba8888_row_tile_rle_present_host_executor_require_supported support action:
        Result::Err support_error:
            gui_rgba8888_row_tile_rle_present_virtual_executor_complete_supported_rejection executor support_error driver
        Result::Ok _unit:
            let record %GuiRgba8888RowTileRlePresentHostCommandRecord gui_rgba8888_row_tile_rle_present_virtual_executor_record_from_action &action
            let drain %GuiRgba8888RowTileRlePresentVirtualDrain gui_rgba8888_row_tile_rle_present_virtual_executor_drain &executor
            match gui_rgba8888_row_tile_rle_present_virtual_drain_step drain record:
                Result::Err drain_error:
                    gui_rgba8888_row_tile_rle_present_virtual_executor_complete_drain_failure executor drain_error driver
                Result::Ok next_drain:
                    let next_executor %GuiRgba8888RowTileRlePresentVirtualExecutor gui_rgba8888_row_tile_rle_present_virtual_executor_new support next_drain
                    gui_rgba8888_row_tile_rle_present_virtual_executor_complete_success next_executor driver
