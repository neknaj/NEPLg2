//: # std/fs/write/fd
//: fd へ `ByteBuf` を書き込む helper
//:
//: ### 目的
//: - raw fd write loop と scratch buffer cleanup を path-based API から分離します。
//: - `ByteBuf` owner の消費責務を fd write 境界へ閉じ込めます。
//:
//: ### 注意
//: - fd の open/close は呼び出し側の責務です。

#indent 4

#import "alloc/io" as *
#import "core/field" as field
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "std/fs/bytes" as *
#import "std/fs/constants" as *
#import "std/fs/error" as *
#import "std/fs/raw" as *
#import "core/field" as *

//: fs_fd_write_from_result: WASI fd_write の iov/nwritten scratch を fd write 境界へ閉じ込める内部 helper
//:
//: 目的:
//: - `fd_write` が要求する iovec と nwritten の raw layout を、この module が借用した scratch owner token から初期化し、書けた byte 数だけを返します。
//: - public caller には `fs_write_fd_bytes` の `ByteBuf` owner 境界だけを公開し、この raw span helper は fd write loop 内部に閉じます。
//:
//: 実装(アルゴリズム):
//: - `iov` の base/len と `nwritten` の初期値を raw address に対して同じ関数内で store します。
//: - `fd_write` 成功後、同じ raw address から `nwritten` を load します。
//:
//: 注意(重要):
//: - `iov_region` は 8 byte、`nwritten_region` は 4 byte、`data` は `data_len` byte 以上の有効領域を指している必要があります。
//:
//: 計算量:
//: - O(1)
fn fs_fd_write_from_result %impure fn i32 impure fn &RegionToken u8 impure fn &RegionToken u8 impure fn MemPtr u8 impure fn i32 Result i32 i32 \fd\iov_region\nwritten_region\data\data_len:
    if:
        lt data_len 0
        then:
            Result::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    Result::Ok 0
                else:
                    let iov %MemPtr u8 region_ptr iov_region
                    let nwritten %MemPtr u8 region_ptr nwritten_region
                    let iov_raw %i32 mem_ptr_addr iov
                    let nwritten_raw %i32 mem_ptr_addr nwritten
                    let data_raw %i32 mem_ptr_addr data
                    if:
                        or or le iov_raw 0 le nwritten_raw 0 le data_raw 0
                        then:
                            Result::Err fs_errno_inval
                        else:
                            let iov_len_raw %i32 add iov_raw 4
                            store_i32 iov_raw data_raw
                            store_i32 iov_len_raw data_len
                            store_i32 nwritten_raw 0
                            let errno %i32 wasi_fd_write fd iov_raw 1 nwritten_raw
                            if:
                                ne errno 0
                                then:
                                    Result::Err errno
                                else:
                                    Result::Ok load_i32 nwritten_raw

//: fs_write_fd_mem_result: fd へ raw memory range をすべて書き込む内部 helper
//:
//: 目的:
//: - `ByteBuf` の storage を確定した後、partial write を処理しながら全 byte を書き込みます。
//: - public caller には `fs_write_fd_bytes` の `ByteBuf` owner 境界だけを公開し、この raw span helper は fd module 内部に閉じます。
//:
//: 実装(アルゴリズム):
//: - 1 要素 iovec を使って `fd_write` を呼び、partial write の場合は offset を進めて再試行します。
//: - `nwritten <= 0` は進捗不能な I/O failure として errno 5 に丸めます。
//: - iovec / nwritten scratch は `RegionToken u8` が所有し、raw ABI view は `fs_fd_write_from_result` にだけ渡します。
//:
//: 注意(重要):
//: - この関数は raw memory range を借りて書き込むだけで、data owner は解放しません。
//: - `MemPtr` と byte length の対応は `fs_write_fd_bytes` が `ByteBuf` から同時に導出します。外部 caller に任意の pointer/length pair を渡させません。
//:
//: 計算量:
//: - 書き込み byte 数 n に対して O(n)
fn fs_write_fd_mem_result %impure fn i32 impure fn MemPtr u8 impure fn i32 Result unit i32 \fd\data\data_len:
    if:
        le data_len 0
        then:
            Result::Ok unit
        else:
            match alloc_region<u8> 8:
                Result::Err _e:
                    Result::Err 12
                Result::Ok iov_region:
                    match alloc_region<u8> 4:
                        Result::Err _e:
                            match dealloc_region<u8> iov_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            Result::Err 12
                        Result::Ok nwritten_region:
                            let mut off %i32 0
                            let mut done %i32 0
                            let mut write_error %i32 0
                            while eq done 0:
                                do:
                                    if:
                                        ge off data_len
                                        then:
                                            set done 1
                                        else:
                                            match fs_fd_write_from_result fd &iov_region &nwritten_region mem_ptr_add data off sub data_len off:
                                                Result::Ok n:
                                                    if:
                                                        le n 0
                                                        then:
                                                            set write_error 5
                                                            set done 1
                                                        else:
                                                            set off add off n
                                                Result::Err e:
                                                    set write_error e
                                                    set done 1
                            match dealloc_region<u8> nwritten_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            match dealloc_region<u8> iov_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            if:
                                eq write_error 0
                                then:
                                    Result::Ok unit
                                else:
                                    Result::Err write_error

//: fs_write_fd_bytes_raw_errno: fd へ `ByteBuf` をすべて書き込み、失敗を raw errno で返す
//:
//: 目的:
//: - 既に開いている fd に所有 byte buffer の内容を最後まで書き込みます。
//:
//: 実装(アルゴリズム):
//: - `ByteBuf` の empty / non-empty storage を判定し、non-empty の場合は `fs_write_fd_mem_result` に委譲します。
//:
//: 注意(重要):
//: - 入力 `ByteBuf` は成功時も失敗時もこの関数が解放します。
//: - fd の妥当性と host 側の権限は WASI runtime に委ねます。
//:
//: 計算量:
//: - 書き込み byte 数 n に対して O(n)
pub fn fs_write_fd_bytes_raw_errno %impure fn i32 impure fn ByteBuf Result unit i32 \fd\bytes:
    let data_len %i32 io_bytebuf_len_ref &bytes
    if:
        le data_len 0
        then:
            io_bytebuf_free bytes
            Result::Ok unit
        else:
            let data %MemPtr u8 io_bytebuf_data_ptr_ref &bytes
            let result %Result unit i32 fs_write_fd_mem_result fd data data_len
            io_bytebuf_free bytes
            result

//: fs_write_fd_bytes: fd へ `ByteBuf` をすべて書き込む
//:
//: [目的/もくてき]:
//: - fd write loop の errno を `FsError` へ[包/つつ]み、通常 public API で raw integer を primary error にしないようにします。
//:
//: [注意/ちゅうい]:
//: - 入力 `ByteBuf` は成功時も失敗時もこの関数が解放します。raw errno が必要な互換境界では `fs_write_fd_bytes_raw_errno` を使います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/write/fd" as *
//: ```
pub fn fs_write_fd_bytes %impure fn i32 impure fn ByteBuf Result unit FsError \fd\bytes:
    match fs_write_fd_bytes_raw_errno fd bytes:
        Result::Ok _:
            Result::Ok unit
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::WriteFd e
