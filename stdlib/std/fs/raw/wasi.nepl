//: # std/fs/raw/wasi
//: WASI preview1 extern と bare wasm fallback
//:
//: ### 目的
//: - WASI target では preview1 syscall を extern として宣言します。
//: - bare wasm target では filesystem が使えないことを errno で返す fallback を提供します。

#indent 4
#import "core/math" as *

#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "path_open" fn wasi_path_open %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i64 impure fn i64 impure fn i32 impure fn i32 i32
#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "path_filestat_get" fn wasi_path_filestat_get %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "fd_readdir" fn wasi_fd_readdir %impure fn i32 impure fn i32 impure fn i32 impure fn i64 impure fn i32 i32
#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "fd_read" fn wasi_fd_read %impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "fd_write" fn wasi_fd_write %impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#if[target=wasi]
pub #extern "wasi_snapshot_preview1" "fd_close" fn wasi_fd_close %impure fn i32 i32

#if[target=bare_wasm]
pub fn wasi_path_open %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i64 impure fn i64 impure fn i32 impure fn i32 i32 \_dirfd\_dirflags\_path_ptr\_path_len\_oflags\_rights_base\_rights_inheriting\_fdflags\_fd_out:
    1 // EPERM or similar

#if[target=bare_wasm]
pub fn wasi_path_filestat_get %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32 \_dirfd\_flags\_path_ptr\_path_len\_buf:
    1

#if[target=bare_wasm]
pub fn wasi_fd_readdir %impure fn i32 impure fn i32 impure fn i32 impure fn i64 impure fn i32 i32 \_fd\_buf\_buf_len\_cookie\_bufused:
    1

#if[target=bare_wasm]
pub fn wasi_fd_read %impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32 \_fd\_iovs\_iovs_len\_nread_ptr:
    1

#if[target=bare_wasm]
pub fn wasi_fd_write %impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32 \_fd\_iovs\_iovs_len\_nwritten_ptr:
    1

#if[target=bare_wasm]
pub fn wasi_fd_close %impure fn i32 i32 \_fd:
    1
