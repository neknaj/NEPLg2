//: # std/fs/raw
//: `std/fs` の raw filesystem boundary public facade
//:
//: ### 目的
//: - WASI extern / bare fallback、fd scratch helper、LLVM syscall fallback を既存の `std/fs/raw` import path から公開します。
//: - target ABI と out-pointer 初期化境界を submodule に分け、public filesystem API から raw syscall details を隔離します。
//:
//: ### 注意
//: - この module は raw address / iovec / out-pointer を扱います。公開 API から直接使うより、`std/fs` の read/write/path helper を優先してください。
//: - ここは互換 import path のための facade です。処理本体は `raw/wasi`、`raw/fd_io`、`raw/llvm` に置きます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/fs/raw" as *
//: fn main <()*>i32> ():
//:     match fs_fd_read_into_result 0 mem_ptr_wrap 0 mem_ptr_wrap 0 mem_ptr_wrap 0 0:
//:         Result::Err _e:
//:             1
//:         Result::Ok n:
//:             if eq n 0 then 0 else 2
//: ```

#indent 4

pub #import "std/fs/raw/wasi" as *
pub #import "std/fs/raw/fd_io" as *
pub #import "std/fs/raw/llvm" as *
