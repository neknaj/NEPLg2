//: # std/fs/raw
//: `std/fs` の WASI extern、bare wasm fallback、LLVM syscall fallback、fd scratch 境界を集める submodule
//:
//: ### 目的
//: - public filesystem API から raw syscall 境界を分離し、out-pointer 初期化と target 別 fallback を 1 箇所に閉じ込めます。
//: - `std/fs` facade から re-export されるため、既存利用者の import は維持されます。
//:
//: ### 注意
//: - この module は raw address / iovec / out-pointer を扱います。公開 API から直接使うより、`std/fs` の read/write/path helper を優先してください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/fs/raw" as *
//: fn main <()*>i32> ():
//:     match fs_fd_read_into_result 0 mem_ptr_wrap 0 mem_ptr_wrap 0 mem_ptr_wrap 0 0:
//:         Result::Err _e:
//:             1
//:         Result::Ok n:
//:             if eq n 0 then 0 else 2
//: ```

#indent 4

#if[target=wasi]
#extern "wasi_snapshot_preview1" "path_open" fn wasi_path_open <(i32,i32,i32,i32,i32,i64,i64,i32,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "path_filestat_get" fn wasi_path_filestat_get <(i32,i32,i32,i32,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_readdir" fn wasi_fd_readdir <(i32,i32,i32,i64,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_read" fn wasi_fd_read <(i32,i32,i32,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_write" fn wasi_fd_write <(i32,i32,i32,i32)*>i32>
#if[target=wasi]
#extern "wasi_snapshot_preview1" "fd_close" fn wasi_fd_close <(i32)*>i32>

#if[target=llvm]
#extern "c" "syscall" fn __fs_syscall <(i64,i64,i64,i64,i64,i64,i64)*>i64>

#if[target=bare_wasm]
fn wasi_path_open <(i32,i32,i32,i32,i32,i64,i64,i32,i32)*>i32> (_dirfd,_dirflags,_path_ptr,_path_len,_oflags,_rights_base,_rights_inheriting,_fdflags,_fd_out):
    1 // EPERM or similar

#if[target=bare_wasm]
fn wasi_path_filestat_get <(i32,i32,i32,i32,i32)*>i32> (_dirfd,_flags,_path_ptr,_path_len,_buf):
    1

#if[target=bare_wasm]
fn wasi_fd_readdir <(i32,i32,i32,i64,i32)*>i32> (_fd,_buf,_buf_len,_cookie,_bufused):
    1

#if[target=bare_wasm]
fn wasi_fd_read <(i32,i32,i32,i32)*>i32> (_fd,_iovs,_iovs_len,_nread_ptr):
    1

#if[target=bare_wasm]
fn wasi_fd_write <(i32,i32,i32,i32)*>i32> (_fd,_iovs,_iovs_len,_nwritten_ptr):
    1

#if[target=bare_wasm]
