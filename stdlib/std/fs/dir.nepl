//: # std/fs/dir
//: `std/fs` の directory open / listing helper を提供する submodule
//:
//: ### 目的
//: - `fd_readdir` と entry 名の整形を read/write API から分離します。
//: - selfhost の module discovery が directory traversal だけへ依存できるようにします。
//:
//: ### 注意
//: - `fs_read_dir` の戻り値は entry 名だけです。親 path との結合は caller が行います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/dir" as *
//:| #import "std/fs/fd" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match fs_open_dir "__definitely_missing_dir_case__":
//:         Result::Err _e:
//:             0
//:         Result::Ok fd:
//:             match fs_close fd:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _e:
//:                     1
//: ```

#indent 4

#import "alloc/collections/vec" as v
#import "alloc/string" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/fd" as *
#import "std/fs/path" as *
#import "std/fs/raw" as *

//: fs_open_dir: directory を fd_readdir 用に開く
//:
//: 目的:
//: - `fs_read_dir` と将来の directory iterator が同じ権限指定で fd を取得できるようにします。
//:
//: 実装(アルゴリズム):
//: - path を正規化してから、WASI fd_readdir right だけで `path_open` を呼びます。
//:
//: 注意(重要):
//: - path escape は open 前に `fs_normalize_relative` で拒否します。
//:
//: 計算量:
//: - path 正規化 O(n) と host open 1 回
fn fs_open_dir <(str)*>Result<i32,i32>> (path):
    match fs_normalize_relative path:
        Result::Err e:
            Result<i32,i32>::Err e
        Result::Ok normalized:
            fs_open_with_flags normalized fs_oflags_directory fs_right_fd_readdir

//: fs_read_dir_fd: directory fd から entry 名を読み出す
//:
//: 目的:
//: - `fd_readdir` の raw dirent 配列を `Vec<str>` に変換し、`fs_read_dir` の本体処理を分離します。
//:
//: 実装(アルゴリズム):
//: - 64KiB buffer で `fd_readdir` を繰り返し、dirent header と name byte 列を順に読みます。
//: - `.` / `..` を除外してから byte 辞書順に sort します。
//: - directory entry name の蓄積で確保に失敗した場合は `Err(12)` を返します。
//:
//: 注意(重要):
//: - WASI cookie は通常の directory 規模を想定し、dirent の `d_next` low 32 bit を次回 cookie として使います。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
fn fs_read_dir_fd <(i32)*>Result<Vec<str>,i32>> (fd):
    match v::new<str>:
        Result::Err _e:
            Result<Vec<str>,i32>::Err 12
        Result::Ok entries0:
            let mut entries <Vec<str>> entries0
            let buf_len <i32> fs_readdir_buf_size
            match alloc_ptr<u8> buf_len:
                Result::Err _e:
                    v::free<str> entries
                    Result<Vec<str>,i32>::Err 12
                Result::Ok buf:
                    match alloc_ptr<u8> 4:
                        Result::Err _e:
                            match dealloc_ptr<u8> buf buf_len:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            v::free<str> entries
                            Result<Vec<str>,i32>::Err 12
                        Result::Ok used_buf:
                            let mut cookie <i64> <i64> cast 0
                            let mut err <i32> 0
                            let mut done <bool> false
                            let buf_raw <i32> mem_ptr_addr buf
                            let used_raw <i32> mem_ptr_addr used_buf
                            while and not done eq err 0:
                                do:
                                    store_i32 used_raw 0
                                    let errno <i32> wasi_fd_readdir fd buf_raw buf_len cookie used_raw
                                    if:
                                        ne errno 0
                                        then:
                                            set err errno
                                        else:
                                            let used <i32> load_i32 used_raw
                                            if:
                                                eq used 0
                                                then:
                                                    set done true
                                                else:
                                                    let mut off <i32> 0
                                                    while and eq err 0 lt off used:
                                                        do:
                                                            let header_end <i32> add off fs_dirent_header_size
                                                            if:
                                                                gt header_end used
                                                                then:
                                                                    set err fs_errno_inval
                                                                else:
                                                                    let rec <i32> add buf_raw off
                                                                    let next_cookie_low <i32> load_i32 rec
                                                                    let name_len <i32> load_i32 add rec 16
                                                                    let name_off <i32> add header_end name_len
                                                                    if:
                                                                        or lt name_len 0 or lt name_off header_end gt name_off used
                                                                        then:
                                                                            set err fs_errno_inval
                                                                        else:
                                                                            match fs_string_from_bytes add rec fs_dirent_header_size name_len:
                                                                                Result::Err e:
                                                                                    set err e
                                                                                Result::Ok name:
                                                                                    if:
                                                                                        fs_dir_name_is_dot name
                                                                                        then:
                                                                                            ()
                                                                                        else:
                                                                                            match v::push<str> entries name:
                                                                                                Result::Ok next_entries:
                                                                                                    set entries next_entries
                                                                                                Result::Err _e:
                                                                                                    set entries v::Vec<str> 0 0 mem_ptr_wrap 0
                                                                                                    set err 12
                                                                            set cookie <i64> cast next_cookie_low
                                                                            set off name_off
                                                    if:
                                                        lt used buf_len
                                                        then:
                                                            set done true
                                                        else:
                                                            ()
                            match dealloc_ptr<u8> used_buf 4:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            match dealloc_ptr<u8> buf buf_len:
                                Result::Ok _:
                                    ()
                                Result::Err _:
                                    ()
                            if:
                                eq err 0
                                then:
                                    let entries_len <i32> get entries "len"
                                    let entries_data <i32> mem_ptr_addr get entries "data"
                                    fs_sort_strings entries_data entries_len
                                    Result<Vec<str>,i32>::Ok entries
                                else:
                                    v::free<str> entries
                                    Result<Vec<str>,i32>::Err err

//: fs_read_dir: directory entry 名を安定順で返す
//:
//: 目的:
//: - self-host compiler の stdlib discovery と import root scanning に必要な directory traversal を提供します。
//:
//: 実装(アルゴリズム):
//: - path を正規化して directory fd を開き、`fd_readdir` の結果を `Vec<str>` に変換して sort します。
//:
//: 注意(重要):
//: - 戻り値は entry 名だけです。親 path との結合は caller が `/` 区切りで行います。
//: - `..` による preopen root 外への escape は `Err(76)` です。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
fn fs_read_dir <(str)*>Result<Vec<str>,i32>> (path):
    match fs_open_dir path:
        Result::Err e:
            Result<Vec<str>,i32>::Err e
        Result::Ok fd:
            let res <Result<Vec<str>,i32>> fs_read_dir_fd fd
            match fs_close fd:
                Result::Ok _:
                    ()
                Result::Err _:
                    ()
            res
