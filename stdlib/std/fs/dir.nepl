//: # std/fs/dir
//: `std/fs` の directory open / listing helper public facade
//:
//: ### 目的
//: - directory open、fd_readdir entry 変換、path-based listing API を既存 `std/fs/dir` import path から公開します。
//: - selfhost の module discovery が directory traversal だけへ依存できるようにします。
//:
//: ### 注意
//: - `fs_read_dir` の戻り値は entry 名だけです。親 path との結合は caller が行います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/dir" as *
//:| #import "std/fs/fd" as *
//:| #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     match fs_open_dir "__definitely_missing_dir_case__":
//:         Result::Err _e:
//:             0
//:         Result::Ok fd:
//:             match fs_close fd:
//:                 Result::Ok _:
//:                     1
//:                 Result::Err _e:
//:                     1
//: ```

#indent 4

pub #import "std/fs/dir/open" as *
pub #import "std/fs/dir/read_fd" as *
pub #import "std/fs/dir/path" as *
