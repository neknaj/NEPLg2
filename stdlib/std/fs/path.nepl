//: # std/fs/path
//: `std/fs` の path helper public facade
//:
//: ### 目的
//: - `std/fs/path` の既存 import path から、directory entry helper と path normalization を公開します。
//: - entry 名の byte helper と relative path 正規化を submodule に分け、WASI syscall や fd read/write helper と責務を混ぜないようにします。
//:
//: ### 注意
//: - path API は `/` 区切りの WASI guest path だけを受け付け、absolute path と Windows host path 風の `\` / `:` を拒否します。
//: - ここは互換 import path のための facade です。処理本体は `std/fs/path/entry` と `std/fs/path/normalize` に置きます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//:| #import "std/fs/path" as *
//: fn main %impure fn void i32 \void:
//:     match fs_normalize_relative "a/./b//c":
//:         Result::Err _e:
//:             1
//:         Result::Ok normalized:
//:             if str_eq normalized "a/b/c" then 0 else 2
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "std/fs/error" as *
//:| #import "std/fs/path" as *
//: fn main %impure fn void i32 \void:
//:     match fs_normalize_relative "../outside":
//:         Result::Err e:
//:             if eq fs_error_to_errno e 76 then 0 else 2
//:         Result::Ok normalized:
//:             if str_eq normalized "../outside" then 1 else 1
//: ```

#indent 4
#import "core/math" as *

pub #import "std/fs/path/entry" as *
pub #import "std/fs/path/normalize" as *
