//: # std/fs/read/path
//: path-based file read helper
//:
//: ### 目的
//: - path open/close と fd read helper の組み合わせを、fd read loop から分離します。
//: - binary read と text read の UTF-8 boundary を同じ場所で確認できるようにします。
//:
//: ### 注意
//: - text として読む場合は `fs_read_to_string_checked` を使うと UTF-8 検証境界が明示されます。

#indent 4

#import "alloc/io" as *
#import "alloc/string" as *
#import "core/result" as *
#import "std/fs/bytes" as *
#import "std/fs/error" as *
#import "std/fs/fd" as *
#import "std/fs/read/fd" as *

//: fs_read_to_bytes: ファイルを読み込んで `ByteBuf` を返す
//:
//: 目的:
//: - path を開き、内容をバイト列として返します。
//:
//: 実装(アルゴリズム):
//: - fs_open_read → fs_read_fd_bytes → fs_close_raw_errno の順に処理します。
//:
//: 注意(重要):
//: - 失敗時は `Err(FsError)` を返します。
//: - read 成功後の close 失敗は `FsOperation::CloseAfterRead` として扱い、返さない `ByteBuf` は解放します。
//:
//: 計算量:
//: - O(n)
//: fs_read_to_bytes: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_to_bytes` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/read" as *
//:| #import "std/fs/bytes" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match fs_read_to_bytes "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok bytes:
//:             let text %str fs_bytes_to_string bytes;
//:             if:
//:                 str_eq text "fs fixture text\n"
//:                 then 0
//:                 else if str_eq text "fs fixture text\r\n" 0 1
//:         Result::Err _e:
//:             2
//: ```
pub fn fs_read_to_bytes %impure fn str Result ByteBuf FsError \path:
    match fs_open_read path:
        Result::Ok fd:
            match fs_read_fd_bytes fd:
                Result::Ok bytes:
                    match fs_close_raw_errno fd:
                        Result::Ok _:
                            Result::Ok bytes
                        Result::Err close_errno:
                            io_bytebuf_free bytes
                            Result::Err fs_error_from_errno FsOperation::CloseAfterRead close_errno
                Result::Err read_error:
                    match fs_close_raw_errno fd:
                        Result::Ok _:
                            unit
                        Result::Err _close_errno:
                            unit
                    Result::Err read_error
        Result::Err e:
            Result::Err e

//: fs_read_to_bytes_errno: file read error を errno 互換値へ[写/うつ]す legacy wrapper
//:
//: [注意/ちゅうい]:
//: - 新規実装は `fs_read_to_bytes` の `FsError` を match してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/read" as *
//: ```
pub fn fs_read_to_bytes_errno %impure fn str Result ByteBuf i32 \path:
    match fs_read_to_bytes path:
        Result::Ok bytes:
            Result::Ok bytes
        Result::Err e:
            Result::Err fs_error_to_errno e

//: fs_read_to_string: ファイルを読み込んで str を返す
//:
//: 目的:
//: - path を読み込み、文字列として返します。
//:
//: 実装(アルゴリズム):
//: - fs_read_to_bytes で読み込み、fs_bytes_to_string_result で UTF-8 検証つき変換を行います。
//:
//: 注意(重要):
//: - invalid UTF-8 は `FsErrorKind::InvalidUtf8` として返します。
//: - 失敗時は `Err(FsError)` を返します。
//:
//: 計算量:
//: - O(n)
//: fs_read_to_string: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_to_string` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/read" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match fs_read_to_string "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok text:
//:             if:
//:                 str_eq text "fs fixture text\n"
//:                 then 0
//:                 else if str_eq text "fs fixture text\r\n" 0 1
//:         Result::Err _e:
//:             2
//: ```
pub fn fs_read_to_string %impure fn str Result str FsError \path:
    match fs_read_to_bytes path:
        Result::Ok bytes:
            fs_bytes_to_string_result bytes
        Result::Err e:
            Result::Err e

//: fs_read_to_string_errno: text read error を errno 互換値へ[写/うつ]す legacy wrapper
//:
//: [注意/ちゅうい]:
//: - 新規実装は `fs_read_to_string` の `FsError` を match してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/read" as *
//: ```
pub fn fs_read_to_string_errno %impure fn str Result str i32 \path:
    match fs_read_to_string path:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_to_errno e

//: fs_read_to_string_checked: ファイルを UTF-8 [検証/けんしょう]して str として[読/よ]み[込/こ]む
//:
//: [目的/もくてき]:
//: - compiler source や設定 file など、`str` として[扱/あつか]う[前提/ぜんてい]の file を invalid UTF-8 から[守/まも]ります。
//:
//: [実装/じっそう]:
//: - `fs_read_to_bytes` で binary として[読/よ]み、`fs_bytes_to_utf8_string_result` で UTF-8 [検証/けんしょう]と `str` [変換/へんかん]を[行/おこな]います。
//:
//: [注意/ちゅうい]:
//: - binary file を text として[読/よ]む API ではありません。binary artifact は `fs_read_to_bytes` を[使/つか]ってください。
//: - invalid UTF-8 は `FsErrorKind::InvalidUtf8` として[返/かえ]します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn fs_read_to_string_checked %impure fn str Result str FsError \path:
    match fs_read_to_bytes path:
        Result::Ok bytes:
            fs_bytes_to_utf8_string_result bytes
        Result::Err e:
            Result::Err e

//: fs_read_to_string_checked_errno: checked text read error を errno 互換値へ[写/うつ]す legacy wrapper
//:
//: [注意/ちゅうい]:
//: - 新規実装は `fs_read_to_string_checked` の `FsError` を match してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/read" as *
//: ```
pub fn fs_read_to_string_checked_errno %impure fn str Result str i32 \path:
    match fs_read_to_string_checked path:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_to_errno e
