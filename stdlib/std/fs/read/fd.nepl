//: # std/fs/read/fd
//: fd から `ByteBuf` を構築する read helper
//:
//: ### 目的
//: - raw fd read loop と scratch buffer cleanup を path-based API から分離します。
//: - `ByteBuf` owner の確定は `fs_finish_read_buffer` に集約します。
//:
//: ### 注意
//: - fd の open/close は呼び出し側の責務です。

#indent 4

#import "alloc/io" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/result" as *
#import "std/fs/bytes" as *
#import "std/fs/constants" as *
#import "std/fs/raw" as *

//: fs_fd_read_into_result: WASI fd_read の iov/nread scratch を fd read 境界へ閉じ込める内部 helper
//:
//: 目的:
//: - `fd_read` が要求する iovec と nread の raw layout をこの module 内で初期化し、読み戻した byte 数だけを返します。
//: - public caller には `fs_read_fd_bytes` の `ByteBuf` owner 境界だけを公開し、この raw span helper は fd read loop 内部に閉じます。
//:
//: 実装(アルゴリズム):
//: - `iov` の base/len と `nread` の初期値を raw address に対して同じ関数内で store します。
//: - `fd_read` 成功後、同じ raw address から `nread` を load します。
//: - 任意の `MemPtr i32` を作って関数境界越しに読む形にはしません。Resource IR の RawMemoryLoadCell が初期化 store を追跡できるようにするためです。
//:
//: 注意(重要):
//: - `iov` は 8 byte、`nread` は 4 byte、`data` は `data_len` byte 以上の有効領域を指している必要があります。
//: - `data_len == 0` の場合は WASI を呼ばず 0 byte read として返します。
//:
//: 計算量:
//: - O(1)
fn fs_fd_read_into_result %impure fn i32 impure fn MemPtr u8 impure fn MemPtr u8 impure fn MemPtr u8 impure fn i32 Result i32 i32 \fd\iov\nread\data\data_len:
    if:
        lt data_len 0
        then:
            Result::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    Result::Ok 0
                else:
                    let iov_raw %i32 mem_ptr_addr iov
                    let nread_raw %i32 mem_ptr_addr nread
                    let data_raw %i32 mem_ptr_addr data
                    if:
                        or or le iov_raw 0 le nread_raw 0 le data_raw 0
                        then:
                            Result::Err fs_errno_inval
                        else:
                            store_i32 iov_raw data_raw
                            store_i32 add iov_raw 4 data_len
                            store_i32 nread_raw 0
                            let errno %i32 wasi_fd_read fd iov_raw 1 nread_raw
                            if:
                                ne errno 0
                                then:
                                    Result::Err errno
                                else:
                                    Result::Ok load_i32 nread_raw

//: fs_discard_read_buffer: owner 付き読み込み buffer を破棄して Err を返す内部 helper
//:
//: 目的:
//: - read loop 側の error path で、`RegionToken u8` owner の破棄と `Result::Err` の構築を同じ所有権境界に閉じ込めます。
//:
//: 注意(重要):
//: - `region` はこの関数が必ず消費します。
//: - cleanup failure でも owner を caller へ戻さず、元の errno を返します。
fn fs_discard_read_buffer %impure fn RegionToken u8 impure fn i32 Result ByteBuf i32 \region\errno:
    match dealloc_region<u8> region:
        Result::Ok _:
            unit
        Result::Err _:
            unit
    Result::Err errno

//: fs_finish_read_buffer: capacity 付き読み込み buffer を ByteBuf の所有権 invariant へ詰め直す内部 helper
//:
//: 目的:
//: - `RegionToken u8` で所有している一時読み込み buffer を、`ByteBuf` の storage が `ByteBuf.len` byte の所有領域を持つ形へ戻します。
//:
//: 実装(アルゴリズム):
//: - 読み込み長が 0 の場合は元 buffer を解放し、空 `ByteBuf` を返します。
//: - 読み込み長が capacity 未満の場合は owner-preserving `realloc_region_bytes_keep` で exact-size に shrink してから `ByteBuf` にします。
//: - `MemPtr` は non-owning view なので、この helper は `RegionToken u8` owner だけを受け取り、成功/失敗のどちらでも owner の行方を閉じます。
//:
//: 注意(重要):
//: - 成功時は返った `ByteBuf` が buffer を所有します。
//: - 失敗時はこの関数が元 region を解放します。owner token を受け取るため、invalid path でも buffer を放置しません。
//:
//: 計算量:
//: - allocator の shrink に依存します。copy が発生する場合は O(data_len) です。
fn fs_finish_read_buffer %impure fn RegionToken u8 impure fn i32 Result ByteBuf i32 \region\data_len:
    let cap %i32 region_size &region
    if:
        or or lt cap 0 lt data_len 0 gt data_len cap
        then:
            match dealloc_region<u8> region:
                Result::Ok _:
                    unit
                Result::Err _:
                    unit
            Result::Err fs_errno_inval
        else:
            if:
                eq data_len 0
                then:
                    match dealloc_region<u8> region:
                        Result::Ok _:
                            unit
                        Result::Err _:
                            unit
                    Result::Ok io_bytebuf_empty
                else:
                    if:
                        eq data_len cap
                        then:
                            Result::Ok io_bytebuf_finish_region region data_len
                        else:
                            match realloc_region_bytes_keep<u8> region data_len:
                                Result::Ok exact_region:
                                    Result::Ok io_bytebuf_finish_region exact_region data_len
                                Result::Err _e:
                                    let old_region %RegionToken u8 region_realloc_error_region<u8> _e
                                    match dealloc_region<u8> old_region:
                                        Result::Ok _:
                                            unit
                                        Result::Err _:
                                            unit
                                    Result::Err 12

//: fs_read_fd_bytes: fd から全て読み込んで `ByteBuf` を返す
//:
//: 目的:
//: - fd の内容をすべて読み込み、バイト列として返します。
//:
//: 実装(アルゴリズム):
//: - 64KiB から開始する連続 buffer を必要に応じて再確保し、EOF まで `fd_read` を繰り返します。
//: - 読み込み buffer と iovec / nread scratch は `RegionToken u8` が所有し、raw ABI へ渡す `MemPtr u8` は `region_ptr` から得る非所有 view に限定します。
//:
//: 注意(重要):
//: - 途中でエラーが出た場合は Err(errno) を返します。
//:
//: 計算量:
//: - O(n)
//: fs_read_fd_bytes: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_read_fd_bytes` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: stdin: "fd bytes"
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/read" as *
//:| #import "std/fs/bytes" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     match fs_read_fd_bytes 0:
//:         Result::Ok bytes:
//:             let text %str fs_bytes_to_string bytes;
//:             if str_eq text "fd bytes" 0 1
//:         Result::Err _e:
//:             1
//: ```
pub fn fs_read_fd_bytes %impure fn i32 Result ByteBuf i32 \fd:
    let mut cap %i32 65536;
    match alloc_region<u8> cap:
        Result::Err _e:
            Result::Err 12
        Result::Ok buf0_region:
            let mut buf_region %RegionToken u8 buf0_region;
            match alloc_region<u8> 8:
                Result::Err _e:
                    fs_discard_read_buffer buf_region 12
                Result::Ok iov_region:
                    let iov_buf %MemPtr u8 region_ptr &iov_region
                    match alloc_region<u8> 4:
                        Result::Err _e:
                            match dealloc_region<u8> iov_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit;
                            fs_discard_read_buffer buf_region 12
                        Result::Ok nread_region:
                            let nread_buf %MemPtr u8 region_ptr &nread_region
                            let mut read_len %i32 0;
                            let mut done %i32 0;
                            let mut err %i32 0;
                            let mut alloc_failed %i32 0;

                            while eq done 0:
                                do:
                                    if:
                                        eq read_len cap
                                        then:
                                            let new_cap %i32 mul cap 2;
                                            if:
                                                or le new_cap cap not alloc_payload_fits new_cap
                                                then:
                                                    set alloc_failed 1;
                                                    set done 1;
                                                else:
                                                    match realloc_region_bytes_keep<u8> buf_region new_cap:
                                                        Result::Ok new_region:
                                                            set buf_region new_region;
                                                            set cap new_cap;
                                                        Result::Err e:
                                                            let old_region %RegionToken u8 region_realloc_error_region<u8> e
                                                            set buf_region old_region;
                                                            set alloc_failed 1;
                                                            set done 1;
                                        else:
                                            unit;
                                    if:
                                        eq done 0
                                        then:
                                            let data_base %MemPtr u8 region_ptr &buf_region
                                            let data_ptr %MemPtr u8 mem_ptr_add data_base read_len
                                            match fs_fd_read_into_result fd iov_buf nread_buf data_ptr sub cap read_len:
                                                Result::Ok n:
                                                    if:
                                                        eq n 0
                                                        then:
                                                            set done 1
                                                        else:
                                                            set read_len add read_len n
                                                Result::Err e:
                                                    set err e;
                                                    set done 1
                                        else:
                                            unit

                            match dealloc_region<u8> nread_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            match dealloc_region<u8> iov_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            if:
                                eq alloc_failed 1
                                then:
                                    fs_discard_read_buffer buf_region 12
                                else:
                                    if:
                                        eq err 0
                                        then:
                                            fs_finish_read_buffer buf_region read_len
                                        else:
                                            fs_discard_read_buffer buf_region err
