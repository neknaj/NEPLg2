//: # std/fs/read
//: `std/fs` の file read helper public facade
//:
//: ### 目的
//: - fd read loop と path-based read API を、既存 `std/fs/read` import path から公開します。
//: - fd scratch buffer cleanup は `std/fs/read/fd`、path open/close と text conversion は `std/fs/read/path` に分けます。
//:
//: ### 注意
//: - text として読む場合は `fs_read_to_string_checked` を使うと UTF-8 検証境界が明示されます。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/read" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     match fs_read_to_string "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok text:
//:             if:
//:                 str_eq text "fs fixture text\n"
//:                 then 0
//:                 else if str_eq text "fs fixture text\r\n" 0 1
//:         Result::Err _e:
//:             2
//: ```

#indent 4

pub #import "std/fs/read/fd" as *
pub #import "std/fs/read/path" as *
