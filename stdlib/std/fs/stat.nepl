//: # std/fs/stat
//: `std/fs` の file type / existence 判定 helper を提供する submodule
//:
//: ### 目的
//: - `path_filestat_get` を使う existence / file / directory 判定を、directory listing や read/write API から分離します。
//: - selfhost の module discovery が read 失敗に頼らず候補 path を分類できるようにします。
//:
//: ### 注意
//: - 権限違反や preopen root escape は existence false として扱います。詳細 error が必要な場合は `fs_path_filetype` を使ってください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/fs/stat" as *
//: fn main %impure fn void i32 \void:
//:     if fs_exists "__definitely_missing_fs_stat_case__.txt" then 1 else 0
//: ```

#indent 4

#import "alloc/string" as *
#import "alloc/string/storage" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/error" as *
#import "std/fs/path" as *
#import "std/fs/raw" as *
#import "core/field" as *

//: fs_path_filetype_normalized: 正規化済み path から WASI filetype を取得する内部 helper
//:
//: 目的:
//: - `fs_normalize_relative_builder` と `sb_build_result` が作った owned `str` を受け取り、既存の `string_data_ptr` 境界で syscall に渡します。
//: - match arm の一時 binding から raw pointer を直接作らず、関数 parameter として owner 境界を明確にします。
fn fs_path_filetype_normalized %impure fn str Result i32 i32 \stat_path:
    match alloc_region<u8> 64:
        Result::Err _e:
            Result::Err 12
        Result::Ok stat_region:
            let stat_buf %MemPtr u8 region_ptr &stat_region
            let path_ptr %i32 mem_ptr_addr string_data_ptr stat_path
            let path_len %i32 len stat_path
            let stat_raw %i32 mem_ptr_addr stat_buf
            store_u8 add stat_raw 16 0;
            let errno %i32 if:
                le path_ptr 0
                then:
                    fs_errno_inval
                else:
                    wasi_path_filestat_get 3 0 path_ptr path_len stat_raw
            let res %Result i32 i32 if:
                eq errno 0
                then:
                    Result::Ok load_u8 add stat_raw 16
                else:
                    Result::Err errno
            match dealloc_region<u8> stat_region:
                Result::Ok _:
                    unit
                Result::Err _:
                    unit
            res

//: fs_path_filetype_raw_errno: path の WASI filetype を取得し、失敗を raw errno で返す
//:
//: 目的:
//: - existence check と file/dir 判定を、read 失敗の副作用に頼らず取得します。
//:
//: 実装(アルゴリズム):
//: - path を `fs_normalize_relative_builder` で正規化し、`str` owner として確定してから WASI `path_filestat_get` の filestat.filetype byte を読みます。
//: - syscall へ渡す path pointer は `string_data_ptr` 由来に限定し、builder 内部 storage の raw view を外へ直接出しません。
//: - syscall 成功時に読む filetype byte は呼び出し前に初期化し、外部 out-buffer 境界を Resource IR が追跡できる形にします。
//: - filestat scratch の free obligation は `RegionToken u8` が持ち、raw address view には移しません。
//:
//: 注意(重要):
//: - 戻り値は WASI filetype の整数値です。regular file は 4、directory は 3 です。
//:
//: 計算量:
//: - path 正規化 O(n) と host stat 1 回
pub fn fs_path_filetype_raw_errno %impure fn str Result i32 i32 \path:
    match fs_normalize_relative_builder_raw_errno path:
        Result::Err e:
            Result::Err e
        Result::Ok normalized:
            match sb_build_result normalized:
                Result::Err _e:
                    Result::Err 12
                Result::Ok stat_path:
                    fs_path_filetype_normalized stat_path

//: fs_path_filetype: path の WASI filetype を取得する
//:
//: [目的/もくてき]:
//: - existence check と file/dir 判定を、read 失敗の副作用に頼らず取得します。
//:
//: [注意/ちゅうい]:
//: - 失敗時は `FsError` を返します。errno 互換が必要な境界では `fs_path_filetype_raw_errno` を使います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/stat" as *
//: ```
pub fn fs_path_filetype %impure fn str Result i32 FsError \path:
    match fs_path_filetype_raw_errno path:
        Result::Ok kind:
            Result::Ok kind
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::PathFileType e

//: fs_exists: path が preopen root 内に存在するかを返す
//:
//: 目的:
//: - import 解決で候補ファイルの有無を軽量に判定します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` が成功するかどうかだけを bool に変換します。
//:
//: 注意(重要):
//: - 権限違反や root escape も false になります。詳細 error が必要なら `fs_path_filetype` を使ってください。
//:
//: 計算量:
//: - host stat 1 回
pub fn fs_exists %impure fn str bool \path:
    match fs_path_filetype path:
        Result::Ok _kind:
            true
        Result::Err _e:
            false

//: fs_is_file: path が regular file かを返す
//:
//: 目的:
//: - `.nepl` / `.n.md` 候補を directory と区別します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` の WASI filetype を regular file 値と比較します。
//:
//: 計算量:
//: - host stat 1 回
pub fn fs_is_file %impure fn str bool \path:
    match fs_path_filetype path:
        Result::Ok kind:
            eq kind fs_filetype_regular_file
        Result::Err _e:
            false

//: fs_is_dir: path が directory かを返す
//:
//: 目的:
//: - stdlib root や module root の探索で directory を検出します。
//:
//: 実装(アルゴリズム):
//: - `fs_path_filetype` の WASI filetype を directory 値と比較します。
//:
//: 計算量:
//: - host stat 1 回
pub fn fs_is_dir %impure fn str bool \path:
    match fs_path_filetype path:
        Result::Ok kind:
            eq kind fs_filetype_directory
        Result::Err _e:
            false
