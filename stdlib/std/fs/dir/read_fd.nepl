//: # std/fs/dir/read_fd
//: directory fd から entry 名を読み出す helper
//:
//: ### 目的
//: - `fd_readdir` の raw dirent 配列を `Vec<str>` に変換する処理を path API から分離します。
//:
//: ### 注意
//: - fd の open/close は呼び出し側の責務です。
//: - 戻り値は entry 名だけです。親 path との結合は caller が行います。

#indent 4

#import "alloc/collections/vec" as v
#import "alloc/string" as *
#import "alloc/string/storage" as *
#import "alloc/string/utf8" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/path" as *
#import "std/fs/raw" as *

//: fs_dirent_name_to_string: fd_readdir の name byte range を UTF-8 検証して str へ複製する
//:
//: 目的:
//: - WASI dirent buffer 内の一時 byte 列を、UTF-8 として妥当な場合だけ戻り値として保持できる `str` に変換します。
//:
//: 実装(アルゴリズム):
//: - caller が `RegionToken` 所有 buffer から導出した `MemPtr<u8>` view と byte length を受け取ります。
//: - `string_utf8_validate_mem` で byte 列を検証し、成功時だけ `string_from_mem_unchecked_result` で複製します。
//:
//: 注意(重要):
//: - この helper は fd_readdir raw ABI 境界の private helper です。任意の raw `i32` address から `MemPtr` を作る public API にはしません。
//: - invalid UTF-8 の directory entry は errno 84 (ILSEQ 相当) として返します。
//:
//: 計算量:
//: - 名前長 n に対して O(n)
fn fs_dirent_name_to_string %fn MemPtr u8 fn i32 Result str i32 \src_ptr\byte_len:
    match string_utf8_validate_mem src_ptr byte_len:
        Result::Err _e:
            Result::Err fs_errno_ilseq
        Result::Ok _:
            match string_from_mem_unchecked_result src_ptr byte_len:
                Result::Err _e:
                    Result::Err 12
                Result::Ok text:
                    Result::Ok text

//: fs_read_dir_fd: directory fd から entry 名を読み出す
//:
//: 目的:
//: - `fd_readdir` の raw dirent 配列を `Vec<str>` に変換し、`fs_read_dir` の本体処理を分離します。
//:
//: 実装(アルゴリズム):
//: - 64KiB buffer で `fd_readdir` を繰り返し、dirent header と name byte 列を順に読みます。
//: - fd_readdir buffer と used out-pointer は `RegionToken<u8>` が所有し、raw ABI へ渡す address は token から借りた non-owning view からだけ得ます。
//: - `.` / `..` を除外してから byte 辞書順に sort します。
//: - directory entry name の蓄積で確保に失敗した場合は `Err(12)` を返します。
//:
//: 注意(重要):
//: - WASI cookie は通常の directory 規模を想定し、dirent の `d_next` low 32 bit を次回 cookie として使います。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
pub fn fs_read_dir_fd %impure fn i32 Result Vec str i32 \fd:
    let entries_result %Result Vec str StdErrorKind v::new
    match entries_result:
        Result::Err _e:
            Result::Err 12
        Result::Ok entries0:
            let mut entries %Vec str entries0
            let buf_len %i32 fs_readdir_buf_size
            match alloc_region<u8> buf_len:
                Result::Err _e:
                    v::free entries
                    Result::Err 12
                Result::Ok buf_region:
                    match alloc_region<u8> 4:
                        Result::Err _e:
                            match dealloc_region<u8> buf_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            v::free entries
                            Result::Err 12
                        Result::Ok used_region:
                            let mut cookie %i64 %i64 cast 0
                            let mut err %i32 0
                            let mut done %bool false
                            let buf_ptr %MemPtr u8 region_ptr &buf_region
                            let used_ptr %MemPtr u8 region_ptr &used_region
                            let buf_raw %i32 mem_ptr_addr buf_ptr
                            let used_raw %i32 mem_ptr_addr used_ptr
                            while and not done eq err 0:
                                do:
                                    store_i32 used_raw 0
                                    let errno %i32 wasi_fd_readdir fd buf_raw buf_len cookie used_raw
                                    if:
                                        ne errno 0
                                        then:
                                            set err errno
                                        else:
                                            let used %i32 load_i32 used_raw
                                            if:
                                                eq used 0
                                                then:
                                                    set done true
                                                else:
                                                    let mut off %i32 0
                                                    while and eq err 0 and ge off 0 lt off used:
                                                        do:
                                                            let header_end %i32 add off fs_dirent_header_size
                                                            if:
                                                                gt header_end used
                                                                then:
                                                                    set err fs_errno_inval
                                                                else:
                                                                    let rec %i32 add buf_raw off
                                                                    let next_cookie_low %i32 load_i32 rec
                                                                    let name_len %i32 load_i32 add rec 16
                                                                    let name_off %i32 add header_end name_len
                                                                    if:
                                                                        or lt name_len 0 or lt name_off header_end gt name_off used
                                                                        then:
                                                                            set err fs_errno_inval
                                                                        else:
                                                                            let name_ptr %MemPtr u8 mem_ptr_add buf_ptr add off fs_dirent_header_size
                                                                            match fs_dirent_name_to_string name_ptr name_len:
                                                                                Result::Err e:
                                                                                    set err e
                                                                                Result::Ok name:
                                                                                    if:
                                                                                        fs_dir_name_is_dot name
                                                                                        then:
                                                                                            unit
                                                                                        else:
                                                                                            match v::push entries name:
                                                                                                Result::Ok next_entries:
                                                                                                    set entries next_entries
                                                                                                Result::Err e:
                                                                                                    set entries v::vec_push_error_vec e
                                                                                                    set err 12
                                                                            set cookie %i64 cast next_cookie_low
                                                                            set off name_off
                                                    if:
                                                        lt used buf_len
                                                        then:
                                                            set done true
                                                        else:
                                                            unit
                            match dealloc_region<u8> used_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            match dealloc_region<u8> buf_region:
                                Result::Ok _:
                                    unit
                                Result::Err _:
                                    unit
                            if:
                                eq err 0
                                then:
                                    match fs_sort_strings &entries:
                                        Result::Ok _:
                                            Result::Ok entries
                                        Result::Err e:
                                            v::free entries
                                            Result::Err e
                                else:
                                    v::free entries
                                    Result::Err err
