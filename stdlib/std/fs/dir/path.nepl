//: # std/fs/dir/path
//: path-based directory listing helper
//:
//: ### 目的
//: - directory path open/close と fd read helper の組み合わせを、fd_readdir 変換から分離します。
//:
//: ### 注意
//: - 戻り値は entry 名だけです。親 path との結合は caller が行います。

#indent 4

#import "alloc/collections/vec" as v
#import "core/result" as *
#import "std/fs/dir/open" as *
#import "std/fs/dir/read_fd" as *
#import "std/fs/error" as *
#import "std/fs/fd" as *

//: fs_read_dir_raw_errno: directory entry 名を安定順で返し、失敗を raw errno で返す
//:
//: 目的:
//: - self-host compiler の stdlib discovery と import root scanning に必要な directory traversal を提供します。
//:
//: 実装(アルゴリズム):
//: - path を正規化して directory fd を開き、`fd_readdir` の結果を `Vec str` に変換して sort します。
//:
//: 注意(重要):
//: - 戻り値は entry 名だけです。親 path との結合は caller が `/` 区切りで行います。
//: - `..` による preopen root 外への escape は `Err(76)` です。
//:
//: 計算量:
//: - entry 総 byte 数 n と sort の O(k^2)
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/dir/path" as *
//: ```
pub fn fs_read_dir_raw_errno %impure fn str Result Vec str i32 \path:
    match fs_open_dir_raw_errno path:
        Result::Err e:
            Result::Err e
        Result::Ok fd:
            let res %Result Vec str i32 fs_read_dir_fd_raw_errno fd
            match fs_close_raw_errno fd:
                Result::Ok _:
                    unit
                Result::Err _:
                    unit
            res

//: fs_read_dir: directory entry 名を安定順で返す
//:
//: [目的/もくてき]:
//: - directory listing failure を `FsError` として[返/かえ]し、通常 public API で raw integer を primary error にしないようにします。
//:
//: [注意/ちゅうい]:
//: - read 成功後の close 失敗では、返せない `Vec str` を解放して `CloseAfterReadDir` を返します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/dir/path" as *
//: ```
pub fn fs_read_dir %impure fn str Result Vec str FsError \path:
    match fs_open_dir path:
        Result::Err e:
            Result::Err e
        Result::Ok fd:
            match fs_read_dir_fd fd:
                Result::Ok entries:
                    match fs_close_raw_errno fd:
                        Result::Ok _:
                            Result::Ok entries
                        Result::Err close_errno:
                            v::free entries
                            Result::Err fs_error_from_errno FsOperation::CloseAfterReadDir close_errno
                Result::Err read_error:
                    match fs_close_raw_errno fd:
                        Result::Ok _:
                            unit
                        Result::Err _close_errno:
                            unit
                    Result::Err read_error
