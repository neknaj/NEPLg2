//: # std/fs/bytes
//: `std/fs` の ByteBuf / text 変換 helper と typed error 変換を提供する submodule
//:
//: ### 目的
//: - file read/write 本体から、ByteBuf と str の変換責務を分離します。
//: - `StdErrorKind` を `FsError` へ写し、errno 互換は明示 wrapper だけに閉じます。
//:
//: ### 注意
//: - `fs_bytes_to_string_result` と `fs_bytes_to_utf8_string_result` は入力 `ByteBuf` を成功時も失敗時も消費します。

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io" as *
#import "alloc/string" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/error" as *
#import "std/text" as *

//: fs_bytes_to_string_result: `ByteBuf` を UTF-8 検証して str に変換する
//:
//: 目的:
//: - バイト列が UTF-8 として妥当な場合だけ str 形式に詰め直し、invalid UTF-8 と確保失敗を `FsError` として返します。
//:
//: 実装(アルゴリズム):
//: - `io_bytebuf_to_str_result` を使い、所有 buffer を UTF-8 検証つきで str 形式へ詰め替えます。
//: - `StdErrorKind` は `FsError` へ写します。
//:
//: 注意(重要):
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
//: - invalid UTF-8 は `FsErrorKind::InvalidUtf8` として返します。
//:
//: 計算量:
//: - O(n)
pub fn fs_bytes_to_string_result %impure fn ByteBuf Result str FsError \buf:
    match io_bytebuf_to_str_result buf:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_from_std_error FsOperation::BytesToString e

//: fs_bytes_to_string_errno_result: `ByteBuf` を str に[変換/へんかん]し error を errno 互換値へ[写/うつ]す
//:
//: [注意/ちゅうい]:
//: - legacy caller のための wrapper です。新規実装は `fs_bytes_to_string_result` を使います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/bytes" as *
//: ```
pub fn fs_bytes_to_string_errno_result %impure fn ByteBuf Result str i32 \buf:
    match fs_bytes_to_string_result buf:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_to_errno e

//: fs_bytes_to_string: `ByteBuf` を str に変換する互換 facade
//:
//: 目的:
//: - 既存コード向けに `str` を直接返す入口を維持します。
//:
//: 実装(アルゴリズム):
//: - `fs_bytes_to_string_result` に委譲し、失敗時だけ空文字列へ丸めます。
//:
//: 注意(重要):
//: - 空 buffer と確保失敗や invalid UTF-8 を区別する必要がある場合は `fs_bytes_to_string_result` を使ってください。
//: - この関数は legacy compatibility 用です。新しい処理では `Result str FsError` を返す入口を使ってください。
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
//:
//: 計算量:
//: - O(n)
//: fs_bytes_to_string: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_bytes_to_string` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/bytes" as *
//:| #import "alloc/io" as *
//:| #import "alloc/string" as *
//: fn main %impure fn void i32 \void:
//:     let text %str fs_bytes_to_string io_bytebuf_from_str "A";
//:     if str_eq text "A" 0 1
//: ```
pub fn fs_bytes_to_string %impure fn ByteBuf str \buf:
    match fs_bytes_to_string_result buf:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: fs_bytes_to_utf8_string_result: `ByteBuf` を UTF-8 [検証/けんしょう]して str に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - source file など text として[扱/あつか]う byte [列/れつ]を、invalid UTF-8 を[拒否/きょひ]してから `str` へ[変換/へんかん]します。
//:
//: [実装/じっそう]:
//: - `std/text` の checked conversion に[委譲/いじょう]し、`StdErrorKind` を `FsError` に[写/うつ]します。
//:
//: [注意/ちゅうい]:
//: - 入力 `ByteBuf` は成功時も失敗時も[消費/しょうひ]されます。
//: - binary protocol や互換読み込みでは unchecked `fs_bytes_to_string_result` を使い、source text ではこの関数を使います。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn fs_bytes_to_utf8_string_result %impure fn ByteBuf Result str FsError \buf:
    match text_bytebuf_to_utf8_str_result buf:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_from_std_error FsOperation::BytesToUtf8String e

//: fs_bytes_to_utf8_string_errno_result: UTF-8 checked conversion error を errno 互換値へ[写/うつ]す
//:
//: [注意/ちゅうい]:
//: - legacy caller のための wrapper です。新規実装は `fs_bytes_to_utf8_string_result` を使います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/bytes" as *
//: ```
pub fn fs_bytes_to_utf8_string_errno_result %impure fn ByteBuf Result str i32 \buf:
    match fs_bytes_to_utf8_string_result buf:
        Result::Ok text:
            Result::Ok text
        Result::Err e:
            Result::Err fs_error_to_errno e
