//: # std/fs/fd
//: `std/fs` の file descriptor open/close helper を提供する submodule
//:
//: ### 目的
//: - path_open と fd_close の Result 変換を raw syscall module から切り離し、read/write API が共有する fd lifecycle 境界としてまとめます。
//: - `std/fs` facade から re-export されるため、既存利用者の import は維持されます。
//:
//: ### 注意
//: - `fs_open_read` / `fs_open_write` で得た fd は、呼び出し側が `fs_close` で閉じる必要があります。

#indent 4

#import "alloc/string" as *
#import "alloc/string/storage" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/error" as *
#import "std/fs/raw" as *
//: fs_open_with_flags_raw_errno: path_open の fd_out 確保と errno 結果変換を共通化する raw helper
//:
//: 目的:
//: - read/write で共通する WASI `path_open` 呼び出しを 1 箇所へ集約します。
//: - host errno を保持する syscall 近傍の境界として使います。
//:
//: 実装(アルゴリズム):
//: - fd_out 用の 4 byte buffer を確保し、`path_open` 成功時だけ fd を読み出して返します。
//: - scratch の所有権は `RegionToken u8` が持ち、raw address view には解放責務を移しません。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 失敗時は WASI errno または確保失敗相当の 12 を返します。
//:
//: 計算量:
//: - O(1)
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_open_with_flags_raw_errno %impure fn str impure fn i32 impure fn i64 Result i32 i32 \path\oflags\rights:
    match alloc_region<u8> 4:
        Result::Err _e:
            Result::Err 12
        Result::Ok fd_out_region:
            let fd_out_buf %MemPtr u8 region_ptr &fd_out_region
            let fd_out_raw %i32 mem_ptr_addr fd_out_buf
            let res %Result i32 i32 if:
                le fd_out_raw 0
                then:
                    Result::Err fs_errno_inval
                else:
                    store_i32 fd_out_raw 0
                    let path_ptr %i32 mem_ptr_addr string_data_ptr path
                    let path_len %i32 len path
                    let errno %i32 wasi_path_open 3 0 path_ptr path_len oflags rights rights 0 fd_out_raw
                    if:
                        eq errno 0
                        then:
                            Result::Ok load_i32 fd_out_raw
                        else:
                            Result::Err errno
            match dealloc_region<u8> fd_out_region:
                Result::Ok _:
                    unit
                Result::Err _:
                    unit;
            res

//: fs_open_with_flags: path_open の fd_out 確保と typed error 変換を共通化する
//:
//: [目的/もくてき]:
//: - public helper の通常名では raw errno を直接返さず、`FsError` に[操作/そうさ]と kind を[保持/ほじ]します。
//:
//: [注意/ちゅうい]:
//: - raw errno が必要な境界では `fs_open_with_flags_raw_errno` を使います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_open_with_flags %impure fn str impure fn i32 impure fn i64 Result i32 FsError \path\oflags\rights:
    match fs_open_with_flags_raw_errno path oflags rights:
        Result::Ok fd:
            Result::Ok fd
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::OpenWithFlags e

//: fs_open_read: ファイルを読み込み専用で開く
//:
//: 目的:
//: - path を開き、fd を返します。
//:
//: 実装(アルゴリズム):
//: - path_open を呼び、fd_out から fd を取得します。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 失敗時は `Err(FsError)` を返します。
//:
//: 計算量:
//: - O(1)
//: fs_open_read: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_open_read` の典型的な使い方を最小構成で示します。
//: - 値を返す関数は結果の受け取り方も合わせて確認できます。
//:
//: [注意/ちゅうい]:
//: - 例は用途が伝わる最短の呼び出しに絞っています。
//: - 境界条件や詳細な正当性検証は専用テストで扱います。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match fs_open_read "tests/fixtures/fs/read_sample.txt":
//:         Result::Ok _fd:
//:             0
//:         Result::Err _e:
//:             1
//: ```
pub fn fs_open_read %impure fn str Result i32 FsError \path:
    match fs_open_read_raw_errno path:
        Result::Ok fd:
            Result::Ok fd
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::OpenRead e

//: fs_open_read_raw_errno: 読み込み fd open error を raw errno で返す互換境界
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_open_read_raw_errno %impure fn str Result i32 i32 \path:
    fs_open_with_flags_raw_errno path 0 fs_right_fd_read

//: fs_open_write: ファイルを書き込み専用で開く
//:
//: 目的:
//: - path を create + truncate + write の権限で開き、fd を返します。
//:
//: 実装(アルゴリズム):
//: - `path_open` に WASI oflags create/truncate と fd_write right を渡します。
//:
//: 注意(重要):
//: - dirfd は 3 (preopen) を仮定します。
//: - 既存ファイルは truncate されます。
//: - 失敗時は `Err(FsError)` を返します。
//:
//: 計算量:
//: - O(1)
//: fs_open_write: 使い方の最小例
//:
//: [目的/もくてき]:
//: - `fs_open_write` が file descriptor を返し、`fs_close` で閉じられることを確認します。
//:
//: [注意/ちゅうい]:
//: - 内容書き込みは `fs_write_to_string` / `fs_write_to_bytes` の回帰テストで確認します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match fs_open_write "tmp/fs_open_write_doctest.txt":
//:         Result::Ok fd:
//:             match fs_close fd:
//:                 Result::Ok _:
//:                     0
//:                 Result::Err _e:
//:                     2
//:         Result::Err _e:
//:             1
//: ```
pub fn fs_open_write %impure fn str Result i32 FsError \path:
    match fs_open_write_raw_errno path:
        Result::Ok fd:
            Result::Ok fd
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::OpenWrite e

//: fs_open_write_raw_errno: 書き込み fd open error を raw errno で返す互換境界
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_open_write_raw_errno %impure fn str Result i32 i32 \path:
    fs_open_with_flags_raw_errno path fs_oflags_create_truncate fs_right_fd_write

//: fs_close_raw_errno: fd を閉じ、host errno を raw integer で返す境界 helper
//:
//: 目的:
//: - fd close syscall の raw errno を保持します。
//:
//: 実装(アルゴリズム):
//: - WASI `fd_close` を呼び、errno 0 を `Ok(unit)`、それ以外を `Err(errno)` に変換します。
//:
//: 注意(重要):
//: - write fd では close 時に host runtime が残りの出力を確定する場合があります。
//:
//: 計算量:
//: - O(1)
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_close_raw_errno %impure fn i32 Result unit i32 \fd:
    let errno %i32 wasi_fd_close fd
    if:
        eq errno 0
        then:
            Result::Ok unit
        else:
            Result::Err errno

//: fs_close: fd を閉じる
//:
//: [目的/もくてき]:
//: - `fs_open_read` / `fs_open_write` で得た fd を閉じ、失敗を `FsError` として[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - read/write path API は close-after-operation を区別するため、必要に応じて raw 境界から別 operation へ包み直します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/fd" as *
//: ```
pub fn fs_close %impure fn i32 Result unit FsError \fd:
    match fs_close_raw_errno fd:
        Result::Ok _:
            Result::Ok unit
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::CloseFd e
