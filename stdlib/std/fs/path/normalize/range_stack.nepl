//: # std/fs/path/normalize/range_stack
//: path component range stack の owner 操作
//:
//: ### 目的
//: - 正規化中の component stack を `Vec i32` の `[start,end)` pair として扱う操作を集約します。
//:
//: ### 注意
//: - stack element は Copy な byte offset だけです。owned substring は作らず、元 path 上の range だけを保持します。

#indent 4

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/result" as *
#import "core/field" as *
#import "std/fs/error" as *

//: fs_normalize_range_push_raw_errno: component range を stack に積み、失敗を raw errno で返す
//:
//: 目的:
//: - path component の `[start,end)` byte range を Copy な `i32` pair として stack に積みます。
//:
//: 実装(アルゴリズム):
//: - `Vec i32` に start/end を順に push します。
//:
//: 注意(重要):
//: - 失敗時は `v::push` が返した stack owner をこの関数内で閉じ、呼び出し側へ errno 12 を返します。
//: - `Vec i32` storage を consuming に更新するため、effect は `impure` です。
//:
//: 計算量:
//: - ならし O(1)
pub fn fs_normalize_range_push_raw_errno %impure fn Vec i32 impure fn i32 impure fn i32 Result Vec i32 i32 \stack\start\end:
    match v::push stack start:
        Result::Err e:
            let returned %Vec i32 v::vec_push_error_vec e
            v::free returned
            Result::Err 12
        Result::Ok with_start:
            match v::push with_start end:
                Result::Err e:
                    let returned %Vec i32 v::vec_push_error_vec e
                    v::free returned
                    Result::Err 12
                Result::Ok with_end:
                    Result::Ok with_end

//: fs_normalize_range_push: component range を stack に積む
//:
//: [目的/もくてき]:
//: - range stack の push failure を `FsError` として[返/かえ]し、通常 public API から raw errno を[隠/かく]します。
//: - 内部では `fs_normalize_range_push_raw_errno` と同じ owner 更新を行うため、effect は `impure` です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "std/fs/path/normalize/range_stack" as *
//: ```
pub fn fs_normalize_range_push %impure fn Vec i32 impure fn i32 impure fn i32 Result Vec i32 FsError \stack\start\end:
    match fs_normalize_range_push_raw_errno stack start end:
        Result::Ok next_stack:
            Result::Ok next_stack
        Result::Err e:
            Result::Err fs_error_from_errno FsOperation::NormalizePathBuilder e

//: fs_normalize_range_pop: component range を stack から 1 件捨てる
//:
//: 目的:
//: - `..` component を処理するため、直前の start/end pair を stack から取り除きます。
//:
//: 実装(アルゴリズム):
//: - `Vec i32` は `[start0,end0,start1,end1,...]` なので、末尾を 2 回 `pop` します。
//:
//: 注意(重要):
//: - 呼び出し側は stack に少なくとも 1 component、つまり 2 要素あることを確認してから呼びます。
//: - `Vec i32` storage を consuming に縮めるため、effect は `impure` です。
//:
//: 計算量:
//: - O(1)
pub fn fs_normalize_range_pop %impure fn Vec i32 Vec i32 \stack:
    let popped_end v::pop stack
    let without_end %Vec i32 field::get popped_end "vec"
    let popped_start v::pop without_end
    field::get popped_start "vec"
