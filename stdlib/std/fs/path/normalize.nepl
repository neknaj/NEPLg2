//: # std/fs/path/normalize
//: relative path の検証と正規化
//:
//: ### 目的
//: - `/` 区切りの WASI guest path を preopen root 内の正規形へ畳みます。
//: - 走査制御、入力検証、range stack 操作、出力 builder 生成を submodule に分けます。
//:
//: ### 注意
//: - absolute path、Windows host path 風の `\` / `:`、preopen root 外へ出る `..` は拒否します。

#indent 4

#import "alloc/collections/vec" as v
#import "alloc/string" as *
#import "alloc/string/unchecked_access" as *
#import "core/math" as *
#import "core/result" as *
#import "std/fs/constants" as *
#import "std/fs/path/normalize/build" as normalize_build
#import "std/fs/path/normalize/range_stack" as normalize_range_stack
#import "std/fs/path/normalize/validate" as normalize_validate
#import "core/field" as *

//: fs_normalize_relative_builder: 正規 path を builder owner のまま返す
//:
//: 目的:
//: - syscall 境界で一時 path を `str` owner にせず、明示的に `StringBuilder` として解放できるようにします。
//:
//: 実装(アルゴリズム):
//: - `/` で分割し、空 component と `.` を捨て、`..` は stack を 1 つ戻します。
//: - stack が空の状態で `..` が来た場合は preopen root 外へ出るため拒否します。
//: - host path byte 検証、range stack 操作、出力 builder 生成は責務別 submodule に委譲します。
//:
//: 注意(重要):
//: - absolute path、Windows host path 風の `\` / `:` を含む path は `Err(76)` にします。
//: - 空 path は preopen root 自体を表す `"."` に正規化します。
//: - component 分割や stack 確保に失敗した場合は `Err(12)` を返します。
//:
//: 計算量:
//: - path 長 n に対して O(n)
pub fn fs_normalize_relative_builder <(str)->Result<StringBuilder,i32>> (path):
    let path_len <i32> len path
    if:
        normalize_validate::fs_path_has_forbidden_host_byte path
        then:
            Result<StringBuilder,i32>::Err fs_errno_notcapable
        else:
            if:
                and gt path_len 0 eq string_byte_at_unchecked path 0 47
                then:
                    Result<StringBuilder,i32>::Err fs_errno_notcapable
                else:
                    match v::with_capacity<i32> path_len:
                        Result::Err _e:
                            Result<StringBuilder,i32>::Err 12
                        Result::Ok stack0:
                            let mut stack <Vec<i32>> stack0
                            let mut cursor <i32> 0
                            let mut done <i32> 0
                            let mut err <i32> 0
                            while and eq err 0 eq done 0:
                                do:
                                    let step <StrSplitStep> str_split_next path "/" cursor
                                    match get step "kind":
                                        StrSplitStepKind::Done:
                                            set done 1
                                        StrSplitStepKind::Part:
                                            let part_start <i32> get step "start"
                                            let part_end <i32> get step "end"
                                            if:
                                                or eq part_start part_end str_range_eq path part_start part_end "."
                                                then:
                                                    ()
                                                else:
                                                    if:
                                                        str_range_eq path part_start part_end ".."
                                                        then:
                                                            let stack_len <i32> v::len<i32> &stack
                                                            if:
                                                                eq stack_len 0
                                                                then:
                                                                    set err fs_errno_notcapable
                                                                else:
                                                                    set stack normalize_range_stack::fs_normalize_range_pop stack
                                                        else:
                                                            match normalize_range_stack::fs_normalize_range_push stack part_start part_end:
                                                                Result::Ok next_stack:
                                                                    set stack next_stack
                                                                Result::Err e:
                                                                    set stack v::vec_empty<i32>
                                                                    set err e
                                            set cursor get step "next"
                            let result <Result<StringBuilder,i32>> if:
                                eq err 0
                                then:
                                    normalize_build::fs_normalize_build_ranges_builder path &stack
                                else:
                                    Result<StringBuilder,i32>::Err err
                            v::free<i32> stack
                            result

//: fs_normalize_relative: `/` 区切りの相対 path を preopen root 内の正規形へ畳む
//:
//: 目的:
//: - import 解決や directory traversal が、caller ごとの ad hoc な path 処理に依存しないようにします。
//:
//: 実装(アルゴリズム):
//: - 内部では `StringBuilder` owner として正規形を作り、public API の戻り値だけ `str` に確定します。
//:
//: 注意(重要):
//: - absolute path、Windows host path 風の `\` / `:` を含む path は `Err(76)` にします。
//: - 空 path は preopen root 自体を表す `"."` に正規化します。
//: - component 分割や stack 確保に失敗した場合は `Err(12)` を返します。
pub fn fs_normalize_relative <(str)->Result<str,i32>> (path):
    match fs_normalize_relative_builder path:
        Result::Err e:
            Result<str,i32>::Err e
        Result::Ok sb:
            match sb_build_result sb:
                Result::Err _e:
                    Result<str,i32>::Err 12
                Result::Ok normalized:
                    Result<str,i32>::Ok normalized
