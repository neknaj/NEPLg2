//: # std/fs/path/entry
//: directory entry 名の path helper
//:
//: ### 目的
//: - directory entry の安定 sort と `.` / `..` 判定をまとめます。
//: - fd_readdir buffer の raw byte range 変換は `std/fs/dir/read_fd` の raw ABI 境界に閉じ、path facade からは公開しません。

#indent 4

#import "alloc/string" as *
#import "alloc/string/byte_index" as *
#import "alloc/collections/vec" as v
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "std/fs/constants" as *

//: fs_str_lt: directory entry の安定順を決める byte 辞書順比較
//:
//: 目的:
//: - host の `readdir` 順に依存しないよう、`fs_read_dir` の結果を byte 順で並べ替えます。
//:
//: 実装(アルゴリズム):
//: - 2 つの str を先頭から byte 比較し、共通 prefix の場合は短い方を小さいとみなします。
//:
//: 注意(重要):
//: - locale や Unicode 正規化は扱わず、filesystem discovery 用の安定順だけを提供します。
//:
//: 計算量:
//: - 短い方の長さ m に対して O(m)
pub fn fs_str_lt %fn str fn str bool \a\b:
    let la %i32 len a
    let lb %i32 len b
    let n %i32 if lt la lb then la else lb
    let mut i %i32 0
    let mut done %bool false
    let mut answer %bool false
    while and not done lt i n:
        do:
            match string_bytes_cmp a i b i:
                Option::Some ordering:
                    if:
                        lt ordering 0
                        then:
                            set answer true
                            set done true
                        else:
                            if:
                                gt ordering 0
                                then:
                                    set done true
                                else:
                                    set i add i 1
                Option::None:
                    set done true
    if:
        done
        then answer
        else lt la lb

//: fs_sort_strings: Vec<str> を in-place に安定した byte 順へ並べる
//:
//: 目的:
//: - `fs_read_dir` の戻り値を platform 非依存の順序に揃えます。
//:
//: 実装(アルゴリズム):
//: - entry 数は通常小さいため、追加の heap 確保を避けた insertion sort を使います。
//: - Vec の storage layout には依存せず、Copy view としての `str` を `Vec` public API 経由で読み書きします。
//:
//: 注意(重要):
//: - 要素の所有権は Vec 内に保持したまま、所有権を持たない `str` view だけを並べ替えます。
//: - 範囲外 access は内部不変条件違反として `Err(EINVAL)` を返します。
//:
//: 計算量:
//: - entry 数 n、名前長比較を含めて最悪 O(n^2)
pub fn fs_sort_strings %impure fn &Vec str Result unit i32 \entries:
    let n %i32 v::len entries
    let mut i %i32 1
    let mut err %i32 0
    while and eq err 0 lt i n:
        do:
            match v::get entries i:
                Option::None:
                    set err fs_errno_inval
                Option::Some key:
                    let mut j %i32 i
                    let mut moving %bool true
                    while and and eq err 0 moving gt j 0:
                        do:
                            let prev_idx %i32 sub j 1
                            match v::get entries prev_idx:
                                Option::None:
                                    set err fs_errno_inval
                                Option::Some prev:
                                    if:
                                        fs_str_lt key prev
                                        then:
                                            v::replace entries j prev
                                            set j prev_idx
                                        else:
                                            set moving false
                    if:
                        eq err 0
                        then:
                            v::replace entries j key
                        else:
                            unit
            set i add i 1
    if:
        eq err 0
        then Result::Ok unit
        else Result::Err err

pub fn fs_dir_name_is_dot %fn str bool \name:
    or str_eq name "." str_eq name ".."
