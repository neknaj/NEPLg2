//: # std/fs/write
//: `std/fs` の file write helper public facade
//:
//: ### 目的
//: - fd write loop と path/string write API を、既存 `std/fs/write` import path から公開します。
//: - fd scratch buffer cleanup は `std/fs/write/fd`、path open/close と text conversion は `std/fs/write/path` に分けます。
//:
//: ### 注意
//: - `fs_write_to_bytes` は open 失敗時も含めて入力 `ByteBuf` を消費します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "std/fs/write" as *
//:| #import "std/fs/read" as *
//:| #import "alloc/string" as *
//:| #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     match fs_write_to_string "tmp/fs_write_to_string_doctest_facade.txt" "fs write facade":
//:         Result::Err _e:
//:             1
//:         Result::Ok _:
//:             match fs_read_to_string "tmp/fs_write_to_string_doctest_facade.txt":
//:                 Result::Ok text:
//:                     if str_eq text "fs write facade" 0 2
//:                 Result::Err _e:
//:                     3
//: ```

#indent 4

pub #import "std/fs/write/fd" as *
pub #import "std/fs/write/path" as *
