#indent 4
#target std

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: kpprefix: 競技プログラミング向け累積和ユーティリティ
//:
//: [目的/もくてき]:
//: - 1 次元累積和の構築と区間和クエリを定型化します。
//: - 公開 API は raw pointer ではなく `Vec<i32>` owner を保持する `PrefixI32` を扱います。
//:
//: [実装/じっそう]:
//: - `pref[0]=0`, `pref[i+1]=pref[i]+a[i]` で長さ `n+1` の `Vec<i32>` を構築します。
//: - 入力 `Vec<i32>` は構築関数が消費し、成功時は prefix buffer の owner を `PrefixI32` に移します。
//: - raw memory 操作は `Vec` の実装境界に閉じ、ここでは `vec::filled` / `vec::get` / `vec::replace` / `vec::free` だけを使います。
//:
//: [注意/ちゅうい]:
//: - 値型は `i32` です。総和が大きい場合は `i64` 版へ拡張してください。
//: - `PrefixI32` は内部 `Vec<i32>` の owner であり、`Copy` / `Clone` しません。使い終わったら `prefix_free_i32` で解放します。
//: - 構築失敗や範囲外 query は trap ではなく `Result::Err Diag` として返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "6 14\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "kp/kpprefix" as *
//:| #import "alloc/collections/vec" as v
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "std/stdio" as *
//: fn main %impure fn unit unit \unit:
//:     let data %Vec i32:
//:         unwrap_ok v::new<i32>
//:         |> v::push<i32> 1 |> unwrap_ok
//:         |> v::push<i32> 2 |> unwrap_ok
//:         |> v::push<i32> 3 |> unwrap_ok
//:         |> v::push<i32> 4 |> unwrap_ok
//:         |> v::push<i32> 5 |> unwrap_ok
//:     let pref %PrefixI32 unwrap_ok<PrefixI32, Diag> prefix_build_vec_i32 data;
//:     print_i32 unwrap_ok<i32, Diag> prefix_sum_i32 &pref 0 3;
//:     print " ";
//:     println_i32 unwrap_ok<i32, Diag> prefix_sum_i32 &pref 1 5;
//:     prefix_free_i32 pref
//: ```

//: PrefixI32: i32 用累積和 buffer の owner handle
//:
//: [目的/もくてき]:
//: - 累積和 `Vec<i32>` の free obligation を 1 つの handle にまとめます。
//:
//: [注意/ちゅうい]:
//: - `data` は公開利用者が直接組み立てる field ではありません。`prefix_build_vec_i32` で作り、`prefix_sum_i32` と `prefix_free_i32` で扱います。
pub struct PrefixI32:
    data %Vec i32

fn prefix_diag_capacity %impure fn unit Diag \unit:
    diag_error StdErrorKind::CapacityExceeded "prefix length exceeds i32 capacity"

fn prefix_diag_range %impure fn unit Diag \unit:
    diag_error StdErrorKind::IndexOutOfBounds "prefix range out of bounds"

fn prefix_diag_std_error %impure fn StdErrorKind Diag \kind:
    diag_error kind "prefix storage operation failed"

fn prefix_build_loop_i32 %impure fn &Vec i32 impure fn &Vec i32 impure fn i32 impure fn i32 impure fn i32 Result unit Diag \input\pref\n\idx\acc:
    if:
        lt idx n
        then:
            match vec::get<i32> input idx:
                Option::Some cur:
                    let next_acc %i32 add acc cur
                    vec::replace<i32> pref add idx 1 next_acc;
                    prefix_build_loop_i32 input pref n add idx 1 next_acc
                Option::None:
                    diag_err<unit> prefix_diag_range
        else:
            ok<unit, Diag> unit

//: prefix_build_vec_i32: `Vec<i32>` から累積和ハンドルを作る
//:
//: [実装/じっそう]:
//: - 入力 `Vec<i32>` の長さを読み、`n+1` 個の初期化済み prefix buffer を `Vec` API で確保します。
//: - 構築中の読み書きも `Vec` API を通すため、この module は raw storage identity を公開面にも実装面にも保持しません。
//: - 成功・失敗のどちらでも入力 `Vec<i32>` owner をこの関数内で閉じます。
pub fn prefix_build_vec_i32 %impure fn Vec i32 Result PrefixI32 Diag \input:
    let n %i32 vec::len<i32> &input
    if:
        gt n 2147483646
        then:
            vec::free<i32> input
            diag_err<PrefixI32> prefix_diag_capacity
        else:
            let pref_len %i32 add n 1
            match vec::filled<i32> pref_len 0:
                Result::Ok pref_data:
                    match prefix_build_loop_i32 &input &pref_data n 0 0:
                        Result::Ok _:
                            vec::free<i32> input
                            ok<PrefixI32, Diag> PrefixI32 pref_data
                        Result::Err d:
                            vec::free<i32> input
                            vec::free<i32> pref_data
                            err<PrefixI32, Diag> d
                Result::Err e:
                    vec::free<i32> input
                    diag_err<PrefixI32> prefix_diag_std_error e

//: prefix_sum_i32: ハンドルから半開区間 `[l,r)` の和を返す
//:
//: [仕様/しよう]:
//: - `0 <= l <= r <= 元の長さ` のとき、`a[l] + ... + a[r-1]` を返します。
//: - 範囲外は `Diag` を返し、raw load や `unreachable` には落としません。
pub fn prefix_sum_i32 %impure fn &PrefixI32 impure fn i32 impure fn i32 Result i32 Diag \pref\l\r:
    let data %&Vec i32 field::get_ref pref "data"
    let pref_len %i32 vec::len<i32> data
    if:
        and and le 0 l le l r lt r pref_len
        then:
            match vec::get<i32> data l:
                Option::Some left:
                    match vec::get<i32> data r:
                        Option::Some right:
                            ok<i32, Diag> sub right left
                        Option::None:
                            diag_err<i32> prefix_diag_range
                Option::None:
                    diag_err<i32> prefix_diag_range
        else:
            diag_err<i32> prefix_diag_range

//: prefix_free_i32: 累積和ハンドルの buffer owner を解放する
pub fn prefix_free_i32 %fn PrefixI32 unit \pref:
    vec::free<i32> field::get pref "data"
