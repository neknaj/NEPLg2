#indent 4
#target std

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "alloc/collections/vec" as *

//: # kpsearch
//: [競技/きょうぎ]プログラミング向け探索ユーティリティ
//:
//: ### [目的/もくてき]
//: - ソート済み `Vec<i32>` に対する `lower_bound` / `upper_bound` / 個数カウントを提供します。
//: - 「条件を満たす最初の位置」を求める二分探索の雛形を固定化します。
//:
//: ### [設計/せっけい]
//: - query API は `&Vec<i32>` を受け取り、入力 owner を消費しません。
//: - `unique_sorted_vec_i32` だけは in-place 圧縮なので `Vec<i32>` owner を消費し、結果 owner を `UniqueSortedVecI32` に入れて返します。
//: - 実装は `Vec` の `len` / `get` / `replace` を使い、raw pointer や raw address observer を扱いません。
//:
//: ### [注意/ちゅうい]
//: - 入力配列は昇順である必要があります。
//: - `unique_sorted_vec_i32` の返す `len` は有効 prefix 長であり、内部 `Vec` の物理長は元のままです。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "1 3 1\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "kp/kpsearch" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "std/stdio" as *
//: fn main <()*> ()> ():
//:     let data <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 5
//:         |> push 1 |> unwrap_ok
//:         |> push 3 |> unwrap_ok
//:         |> push 3 |> unwrap_ok
//:         |> push 7 |> unwrap_ok
//:         |> push 9 |> unwrap_ok
//:     print_i32 lower_bound_vec_i32 &data 2;
//:     print " ";
//:     print_i32 upper_bound_vec_i32 &data 3;
//:     print " ";
//:     println_i32 if contains_vec_i32 &data 3 then 1 else 0;
//:     free<i32> data
//: ```

fn lower_bound_loop_i32 <(&Vec<i32>,i32,i32,i32)->i32> (items, lo0, hi0, x):
    let mut lo <i32> lo0
    let mut hi <i32> hi0
    while lt lo hi:
        do:
            let sum <i32> add lo hi
            let mid <i32> div_s sum 2
            match get<i32> items mid:
                Option::Some value:
                    if lt value x:
                        then:
                            set lo add mid 1
                        else:
                            set hi mid
                Option::None:
                    set hi mid
    lo

fn upper_bound_loop_i32 <(&Vec<i32>,i32,i32,i32)->i32> (items, lo0, hi0, x):
    let mut lo <i32> lo0
    let mut hi <i32> hi0
    while lt lo hi:
        do:
            let sum <i32> add lo hi
            let mid <i32> div_s sum 2
            match get<i32> items mid:
                Option::Some value:
                    if le value x:
                        then:
                            set lo add mid 1
                        else:
                            set hi mid
                Option::None:
                    set hi mid
    lo

//: lower_bound_vec_i32: `x` 以上が最初に現れる位置を返す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
pub fn lower_bound_vec_i32 <(&Vec<i32>,i32)->i32> (items, x):
    lower_bound_loop_i32 items 0 len<i32> items x

//: upper_bound_vec_i32: `x` より大きい値が最初に現れる位置を返す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
pub fn upper_bound_vec_i32 <(&Vec<i32>,i32)->i32> (items, x):
    upper_bound_loop_i32 items 0 len<i32> items x

//: contains_vec_i32: `x` が含まれるかを返す
pub fn contains_vec_i32 <(&Vec<i32>,i32)->bool> (items, x):
    let n <i32> len<i32> items
    let idx <i32> lower_bound_vec_i32 items x
    if:
        ge idx n
        then:
            false
        else:
            match get<i32> items idx:
                Option::Some value:
                    eq value x
                Option::None:
                    false

//: count_equal_range_vec_i32: `x` の出現回数を返す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "3\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "kp/kpsearch" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "std/stdio" as *
//: fn main <()*> ()> ():
//:     let values <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 6
//:         |> push 1 |> unwrap_ok
//:         |> push 2 |> unwrap_ok
//:         |> push 2 |> unwrap_ok
//:         |> push 2 |> unwrap_ok
//:         |> push 5 |> unwrap_ok
//:         |> push 9 |> unwrap_ok
//:     println_i32 count_equal_range_vec_i32 &values 2;
//:     free<i32> values
//: ```
pub fn count_equal_range_vec_i32 <(&Vec<i32>,i32)->i32> (items, x):
    let lb <i32> lower_bound_vec_i32 items x
    let ub <i32> upper_bound_vec_i32 items x
    sub ub lb

//: UniqueSortedVecI32
//: `Vec<i32>` の重複除去結果
//:
//: ### [目的/もくてき]
//: - `unique_sorted_vec_i32` が in-place に圧縮した `Vec<i32>` owner と、有効な prefix 長を一緒に返します。
//:
//: ### [注意/ちゅうい]
//: - `vec` の物理長は元の長さのままです。重複除去後に読むべき範囲は `len` が示す prefix だけです。
pub struct UniqueSortedVecI32:
    vec <Vec<i32>>
    len <i32>

//: unique_sorted_vec_i32: `Vec<i32>` を in-place で重複除去し、有効 prefix 長と owner を返す
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "3\n1 2 5\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "kp/kpsearch" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "std/stdio" as *
//: fn main <()*>()> ():
//:     let values <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 6
//:         |> push 1 |> unwrap_ok
//:         |> push 1 |> unwrap_ok
//:         |> push 2 |> unwrap_ok
//:         |> push 2 |> unwrap_ok
//:         |> push 5 |> unwrap_ok
//:         |> push 5 |> unwrap_ok
//:     let unique <UniqueSortedVecI32> unique_sorted_vec_i32 values;
//:     let n <i32> unique_sorted_vec_i32_len &unique;
//:     println_i32 n;
//:     let mut i <i32> 0;
//:     while lt i n:
//:         do:
//:             if gt i 0:
//:                 then print " "
//:                 else ()
//:             match unique_sorted_vec_i32_get &unique i:
//:                 Option::Some value:
//:                     print_i32 value
//:                 Option::None:
//:                     ()
//:             set i add i 1;
//:     println "";
//:     free unique;
//: ```
pub fn unique_sorted_vec_i32 <(Vec<i32>)*>UniqueSortedVecI32> (items):
    let n <i32> len<i32> &items
    if:
        le n 1
        then:
            UniqueSortedVecI32 items n
        else:
            let mut read <i32> 1
            let mut write <i32> 1
            while lt read n:
                do:
                    match get<i32> &items read:
                        Option::Some cur:
                            let prev_idx <i32> sub write 1
                            match get<i32> &items prev_idx:
                                Option::Some prev:
                                    if ne cur prev:
                                        then:
                                            replace<i32> &items write cur
                                            set write add write 1
                                        else:
                                            ()
                                Option::None:
                                    ()
                        Option::None:
                            ()
                    set read add read 1
            UniqueSortedVecI32 items write

//: unique_sorted_vec_i32_len: 重複除去後の有効 prefix 長を返す
pub fn unique_sorted_vec_i32_len <(&UniqueSortedVecI32)->i32> (u):
    *field::get_ref u "len"

//: unique_sorted_vec_i32_get: 重複除去後 prefix の要素を取得する
//:
//: ### [注意/ちゅうい]
//: - `idx` が有効 prefix の外なら `Option::None` を返します。
pub fn unique_sorted_vec_i32_get <(&UniqueSortedVecI32,i32)->Option<i32>> (u, idx):
    let n <i32> *field::get_ref u "len"
    if:
        or lt idx 0 le n idx
        then:
            Option::None<i32>
        else:
            let vec_ref <&Vec<i32>> field::get_ref u "vec"
            get<i32> vec_ref idx

//: free: `UniqueSortedVecI32` が保持する `Vec<i32>` owner を解放する
pub fn free <(UniqueSortedVecI32)*>()> (u):
    free<i32> field::get u "vec"
