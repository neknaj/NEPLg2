#indent 4
#target std

#import "alloc/collections/adjacency_matrix" as am
#import "alloc/collections/adjacency_matrix/types" as *
#import "alloc/collections/vec" as v
#import "alloc/diag/error" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "std/streamio" as *

//: # kpgraph
//: [競技/きょうぎ]プログラミング向けグラフ補助ライブラリ
//:
//: ### [目的/もくてき]
//: - 小〜中規模入力で使いやすい密行列表現のグラフ API を提供します。
//: - 無向グラフの BFS 距離計算を定型化し、解法実装を短くします。
//:
//: ### [設計/せっけい]
//: - `DenseGraph` は raw pointer ではなく `AdjacencyMatrix` owner を保持します。
//: - 辺の更新は owner を消費して更新後 owner を返し、失敗時は `DenseGraphUpdateError` に owner を戻します。
//: - BFS の距離配列とキューは `Vec<i32>` を使い、raw load/store や raw address observer を公開しません。
//:
//: ### [注意/ちゅうい]
//: - メモリ使用量は O(n^2) です。大規模グラフには不向きです。
//: - 頂点番号は 0-index を前提にしています。
//: - 古い `dense_graph_bfs_dist_raw(n, mat, start)` は提供しません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdin: "4 3\n1 2\n2 3\n3 4\n"
//: stdout: "0 1 2 3\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/streamio" as *
//:| #import "std/iotarget" as *
//:| #import "std/stdio" as *
//:| #import "kp/kpgraph" as *
//:| #import "alloc/collections/vec" as v
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit unit \unit:
//:     let sc %StreamScanner unwrap_ok open ReadStream::Stdio;
//:     let g %DenseGraph unwrap_ok<DenseGraph, Diag> dense_graph_read_undirected_1indexed &sc;
//:     let dist %Vec i32 unwrap_ok<Vec<i32>, Diag> dense_graph_bfs_dist &g 0;
//:     let n %i32 dense_graph_len &g;
//:     let mut i %i32 0;
//:     while lt i n:
//:         do:
//:             if lt 0 i:
//:                 then print " "
//:                 else unit
//:             let d %i32 match v::get<i32> &dist i:
//:                 Option::Some x:
//:                     x
//:                 Option::None:
//:                     -1
//:             print_i32 d;
//:             set i add i 1;
//:     print "\n";
//:     v::free<i32> dist;
//:     dense_graph_free g;
//:     close sc
//: ```

//: DenseGraph
//: 密行列表現の graph owner
//:
//: ### [目的/もくてき]
//: - `AdjacencyMatrix` owner を KP 用 API の型として包みます。
//: - raw matrix address を public field として見せないことで、free obligation を型に残します。
pub struct DenseGraph:
    matrix %AdjacencyMatrix

//: DenseGraphUpdateError
//: graph 更新失敗時に owner を返す error
pub struct DenseGraphUpdateError:
    graph %DenseGraph
    diag %Diag

//: dense_graph_update_error_diag: 更新失敗の診断を owner を動かさず読む
pub fn dense_graph_update_error_diag %fn &DenseGraphUpdateError Diag \e:
    *field::get_ref e "diag"

//: dense_graph_update_error_graph: 更新失敗で戻された graph owner を取り出す
pub fn dense_graph_update_error_graph %fn DenseGraphUpdateError DenseGraph \e:
    field::get e "graph"

fn dense_graph_diag_vertex %impure fn unit Diag \unit:
    diag_error StdErrorKind::IndexOutOfBounds "dense graph vertex out of bounds"

fn dense_graph_diag_input %impure fn unit Diag \unit:
    diag_error StdErrorKind::InvalidOperation "dense graph input is invalid"

fn dense_graph_diag_storage %impure fn unit Diag \unit:
    diag_error StdErrorKind::InvalidOperation "dense graph storage invariant failed"

fn dense_graph_diag_std_error %impure fn StdErrorKind Diag \kind:
    diag_error kind "dense graph storage operation failed"

fn dense_graph_matrix_error %fn AdjacencyMatrixUpdateError Result DenseGraph DenseGraphUpdateError \e:
    let d %Diag am::adjacency_matrix_update_error_diag &e
    let matrix %AdjacencyMatrix am::adjacency_matrix_update_error_owner e
    err DenseGraphUpdateError DenseGraph matrix d

//: dense_graph_new: 頂点数 `n` の空グラフを作る
//:
//: ### [計算量/けいさんりょう]
//: - O(n^2)
pub fn dense_graph_new %impure fn i32 Result DenseGraph Diag \n:
    match am::new n:
        Result::Ok matrix:
            ok DenseGraph matrix
        Result::Err d:
            err d

//: dense_graph_free: graph owner を解放する
pub fn dense_graph_free %fn DenseGraph unit \g:
    am::free field::get g "matrix"

//: dense_graph_len: 頂点数を返す
pub fn dense_graph_len %fn &DenseGraph i32 \g:
    let matrix %&AdjacencyMatrix field::get_ref g "matrix"
    am::len matrix

//: dense_graph_has_edge: 辺 `(from, to)` の有無を返す
pub fn dense_graph_has_edge %impure fn &DenseGraph impure fn i32 impure fn i32 Result bool Diag \g\from\to:
    let matrix %&AdjacencyMatrix field::get_ref g "matrix"
    am::contains matrix from to

//: dense_graph_add_undirected: 無向辺 `(u, v)` を追加する
//:
//: ### [注意/ちゅうい]
//: - 更新 API なので `DenseGraph` owner を消費し、成功時に更新後 owner を返します。
//: - 範囲外頂点は `DenseGraphUpdateError` として owner を戻します。
pub fn dense_graph_add_undirected %impure fn DenseGraph impure fn i32 impure fn i32 Result DenseGraph DenseGraphUpdateError \g\u\vtx:
    let matrix %AdjacencyMatrix field::get g "matrix"
    match am::insert matrix u vtx:
        Result::Ok matrix_uv:
            match am::insert matrix_uv vtx u:
                Result::Ok matrix_next:
                    ok DenseGraph matrix_next
                Result::Err e:
                    dense_graph_matrix_error e
        Result::Err e:
            dense_graph_matrix_error e

//: dense_graph_read_undirected_1indexed: 1-index 入力の無向グラフを読む
//:
//: ### [入力形式/にゅうりょくけいしき]
//: - `n m`
//: - `u1 v1`
//: - ...
//: - `um vm`
//:
//: ### [計算量/けいさんりょう]
//: - O(n^2 + m)
pub fn dense_graph_read_undirected_1indexed %impure fn &StreamScanner Result DenseGraph Diag \sc:
    let n %i32 read sc
    let m %i32 read sc
    if:
        or lt n 1 lt m 0
        then:
            diag_err<DenseGraph> dense_graph_diag_input
        else:
            match dense_graph_new n:
                Result::Err d:
                    err d
                Result::Ok initial:
                    let mut graph %DenseGraph initial
                    let mut i %i32 0
                    let mut failed %bool false
                    while and lt i m not failed:
                        do:
                            let u1 %i32 read sc
                            let v1 %i32 read sc
                            let u %i32 sub u1 1
                            let vtx %i32 sub v1 1
                            match dense_graph_add_undirected graph u vtx:
                                Result::Ok next:
                                    set graph next
                                    set i add i 1
                                Result::Err e:
                                    set graph dense_graph_update_error_graph e
                                    set failed true
                    if:
                        failed
                        then:
                            dense_graph_free graph
                            diag_err<DenseGraph> dense_graph_diag_vertex
                        else:
                            ok graph

//: dense_graph_bfs_dist: 開始頂点からの最短距離配列を返す
//:
//: ### [目的/もくてき]
//: - 辺重み 1 のグラフで、開始頂点 `start` から各頂点への最短距離を計算します。
//:
//: ### [実装/じっそう]
//: - 配列キューを `Vec<i32>` で持つ通常の BFS です。
//: - 未訪問は `-1` で表現し、最初の訪問時に距離を確定します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n^2)（密行列の隣接走査）
pub fn dense_graph_bfs_dist %impure fn &DenseGraph impure fn i32 Result Vec i32 Diag \g\start:
    let n %i32 dense_graph_len g
    if:
        not and le 0 start lt start n
        then:
            diag_err<Vec<i32>> dense_graph_diag_vertex
        else:
            let unvisited %i32 sub 0 1
            match v::filled<i32> n unvisited:
                Result::Err e:
                    let d %Diag dense_graph_diag_std_error e
                    err d
                Result::Ok dist:
                    match v::filled<i32> n 0:
                        Result::Err e:
                            v::free<i32> dist
                            let d %Diag dense_graph_diag_std_error e
                            err d
                        Result::Ok queue:
                            v::replace<i32> &dist start 0
                            v::replace<i32> &queue 0 start
                            let mut head %i32 0
                            let mut tail %i32 1
                            let mut failed %bool false
                            while and lt head tail not failed:
                                do:
                                    match v::get<i32> &queue head:
                                        Option::Some node:
                                            set head add head 1
                                            match v::get<i32> &dist node:
                                                Option::Some node_dist:
                                                    let mut to %i32 0
                                                    while and lt to n not failed:
                                                        do:
                                                            match dense_graph_has_edge g node to:
                                                                Result::Ok has_edge:
                                                                    if:
                                                                        has_edge
                                                                        then:
                                                                            match v::get<i32> &dist to:
                                                                                Option::Some current:
                                                                                    if:
                                                                                        eq current unvisited
                                                                                        then:
                                                                                            v::replace<i32> &dist to add node_dist 1
                                                                                            if:
                                                                                                lt tail n
                                                                                                then:
                                                                                                    v::replace<i32> &queue tail to
                                                                                                    set tail add tail 1
                                                                                                else:
                                                                                                    set failed true
                                                                                        else:
                                                                                            unit
                                                                                Option::None:
                                                                                    set failed true
                                                                        else:
                                                                            unit
                                                                Result::Err _d:
                                                                    set failed true
                                                            set to add to 1
                                                Option::None:
                                                    set failed true
                                        Option::None:
                                            set failed true
                            v::free<i32> queue
                            if:
                                failed
                                then:
                                    v::free<i32> dist
                                    diag_err<Vec<i32>> dense_graph_diag_storage
                                else:
                                    ok dist
