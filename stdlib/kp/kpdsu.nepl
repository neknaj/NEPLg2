#indent 4
#target std

#import "alloc/collections/disjoint_set" as uf
#import "alloc/diag/error" as *
#import "core/result" as *

pub #import "alloc/collections/disjoint_set/types" as @merge

//: # kpdsu
//: [競技/きょうぎ]プログラミング向け Union-Find（Disjoint Set Union）
//:
//: ### [目的/もくてき]
//: - [要素/ようそ]の[属/ぞく]する[集合/しゅうごう]の[代表元/だいひょうげん]、[同一/どういつ]集合判定、集合併合、集合サイズ取得を提供します。
//: - KP 用の関数名を保ちつつ、実装は `alloc/collections/disjoint_set` の型付き owner API に委譲します。
//:
//: ### [設計/せっけい]
//: - `DisjointSet` は parent 配列と size 配列を所有する owner 型です。
//: - `dsu_unite` は owner を消費し、成功時に更新後 owner を返します。
//: - [範囲外/はんいがい] index では `DisjointSetUpdateError` に元 owner を戻すため、caller は cleanup できます。
//:
//: ### [注意/ちゅうい]
//: - 古い raw `i32` ハンドル API は提供しません。
//: - `dsu_find` / `dsu_same` / `dsu_size` は `&DisjointSet` を読み取る query です。
//: - [公開/こうかい] API の頂点番号は 0-index です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: "1 0 3\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "kp/kpdsu" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "std/stdio" as *
//: fn main %impure fn () () \():
//:     let d0 %DisjointSet unwrap_ok<DisjointSet, Diag> dsu_new 5;
//:     let d1 %DisjointSet unwrap_ok<DisjointSet, DisjointSetUpdateError> dsu_unite d0 0 1;
//:     let d2 %DisjointSet unwrap_ok<DisjointSet, DisjointSetUpdateError> dsu_unite d1 1 2;
//:     let same02 %bool unwrap_ok<bool, Diag> dsu_same &d2 0 2;
//:     let same03 %bool unwrap_ok<bool, Diag> dsu_same &d2 0 3;
//:     let sz %i32 unwrap_ok<i32, Diag> dsu_size &d2 0;
//:     print_i32 if same02 then 1 else 0;
//:     print " ";
//:     print_i32 if same03 then 1 else 0;
//:     print " ";
//:     println_i32 sz;
//:     dsu_free d2
//: ```

//: dsu_new: `n` [要素/ようそ]の DSU owner を[作/つく]る
//:
//: ### [失敗/しっぱい]
//: - `n < 0` や[確保/かくほ]失敗は `Diag` として返します。
pub fn dsu_new %impure fn i32 Result DisjointSet Diag \n:
    uf::new n

//: dsu_free: DSU owner を[解放/かいほう]する
pub fn dsu_free %impure fn DisjointSet () \dsu:
    uf::free dsu

//: dsu_find: `x` の[代表元/だいひょうげん]を[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - query として扱うため、path compression による更新は行いません。
pub fn dsu_find %impure fn &DisjointSet impure fn i32 Result i32 Diag \dsu\x:
    uf::find dsu x

//: dsu_same: `a` と `b` が[同/おな]じ[集合/しゅうごう]かを[返/かえ]す
pub fn dsu_same %impure fn &DisjointSet impure fn i32 impure fn i32 Result bool Diag \dsu\a\b:
    uf::same dsu a b

//: dsu_unite: `a` と `b` の[集合/しゅうごう]を[併合/へいごう]した owner を[返/かえ]す
pub fn dsu_unite %impure fn DisjointSet impure fn i32 impure fn i32 Result DisjointSet DisjointSetUpdateError \dsu\a\b:
    uf::union dsu a b

//: dsu_size: `x` が[属/ぞく]する[集合/しゅうごう]の[大/おお]きさを[返/かえ]す
pub fn dsu_size %impure fn &DisjointSet impure fn i32 Result i32 Diag \dsu\x:
    uf::size dsu x
