//: nm/parser: Gloss/Nest Markdown の source view と JSON serializer
//:
//: [目的/もくてき]:
//: - `.n.md` 用の Gloss/Nest Markdown を読み、`Document` と JSON 出力 API を提供します。
//: - `Document` は source view を保持し、JSON/HTML 変換時に direct serializer が再走査します。
//:
//: [実装/じっそう]:
//: - strict move checking に合わせ、`Vec<Inline>` / `Vec<Node>` のような non-Copy AST raw storage を使いません。
//: - block parser は入力文字列を byte index で走査し、section stack は最大 heading level 6 の Copy state として管理します。
//: - inline parser は JSON/HTML 文字列を直接構築し、ruby/gloss/math を必要箇所だけ再帰処理します。
//:
//: [注意/ちゅうい]:
//: - JSON schema は開発中です。selfhost/doc 生成で必要な安定 API は `parse_markdown` / `document_to_json` / `render_document` です。
//: - UTF-8 境界は stdlib/string の slice API に従います。ここでは Markdown marker を ASCII byte として扱います。
//:
//: [計算量/けいさんりょう]:
//: - `parse_markdown` は O(1) です。
//: - `document_to_json` は入力 size と出力 size に対して O(n + m) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "alloc/string" as *
#import "core/math" as *
#import "core/option" as *

//: Document: NM document の source view
//:
//: [目的/もくてき]:
//: - parse 済み document を公開 API の値として運びます。
//:
//: [実装/じっそう]:
//: - 現在は source `str` だけを持つ Copy 可能な view です。
//: - JSON/HTML は `document_to_json` / `render_document` が source を再走査して生成します。
//:
//: [注意/ちゅうい]:
//: - non-Copy AST container を内部に持たないため、strict move checking の raw storage 制約に抵触しません。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub struct Document:
    source <str>

impl Clone for Document:
    fn clone <(&Document)->Document> (doc):
        *doc

impl Copy for Document:
    fn copy_mark <(Document)->Document> (doc):
        doc

//: nm_line_end: 1 行の終端 byte index を探す
//:
//: [目的/もくてき]:
//: - `start` から次の LF 直前、または入力末尾までを 1 行として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(line_length)
fn nm_line_end <(str,i32)->i32> (s, start):
    let n <i32> len s;
    let mut i <i32> start;
    let mut done <bool> false;
    while and lt i n not done:
        do:
            if:
                eq string_byte_at_unchecked s i '\n'
                then set done true
                else set i add i 1
    i

//: nm_next_line_pos: 行終端から次行の開始位置を得る
//:
//: [目的/もくてき]:
//: - `nm_line_end` が返した index から、次に読む byte index を計算します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_next_line_pos <(str,i32)->i32> (s, line_end):
    if:
        lt line_end len s
        then add line_end 1
        else len s

//: trim_cr: CRLF 入力の CR を 1 byte だけ取り除く
//:
//: [目的/もくてき]:
//: - Windows style の `\r\n` 行末を parser 内部で `\n` と同じ扱いにします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn trim_cr <(str)->str> (s):
    let n <i32> len s;
    if:
        and gt n 0 eq string_byte_at_unchecked s sub n 1 '\r'
        then str_slice s 0 sub n 1
        else s

//: nm_read_line: 入力から 1 行を切り出す
//:
//: [目的/もくてき]:
//: - byte index `pos` から LF までを切り出し、末尾 CR を取り除きます。
//:
//: [計算量/けいさんりょう]:
//: - O(line_length)
fn nm_read_line <(str,i32)->str> (s, pos):
    trim_cr str_slice s pos nm_line_end s pos

//: nm_heading_level: ATX heading の level を判定する
//:
//: [目的/もくてき]:
//: - `# ` から `###### ` までを 1..6 として返し、それ以外は 0 を返します。
//:
//: [実装/じっそう]:
//: - 先頭の `#` 個数を数え、直後が空白である場合だけ heading とします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。最大 6 byte だけを確認します。
fn nm_heading_level <(str)->i32> (line):
    let n <i32> len line;
    let mut i <i32> 0;
    while and lt i n and lt i 6 eq string_byte_at_unchecked line i '#':
        do:
            set i add i 1
    if:
        and gt i 0 lt i n
        then:
            if:
                eq string_byte_at_unchecked line i ' '
                then i
                else 0
        else:
            0

//: nm_heading_text: heading marker の後ろの text を返す
//:
//: [目的/もくてき]:
//: - `level` 個の `#` と続く空白を除いた heading 本文を取り出します。
//:
//: [計算量/けいさんりょう]:
//: - O(text_length)
fn nm_heading_text <(str,i32)->str> (line, level):
    str_trim str_slice line add level 1 len line

//: is_fence_start: fenced code block 開始行を判定する
//:
//: [目的/もくてき]:
//: - trim 済み行が triple backtick で始まるか判定します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn is_fence_start <(str)->bool> (line):
    str_starts_with line "```"

//: is_hr: horizontal rule 行を判定する
//:
//: [目的/もくてき]:
//: - Nest では `---` を水平線かつ 1 段 close として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn is_hr <(str)->bool> (line):
    str_eq line "---"

//: is_section_break: section break 行を判定する
//:
//: [目的/もくてき]:
//: - `;;;` を表示なしの 1 段 close として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn is_section_break <(str)->bool> (line):
    str_eq line ";;;"

//: nm_is_block_boundary: paragraph を止める行か判定する
//:
//: [目的/もくてき]:
//: - paragraph lookahead で、空行・heading・fence・horizontal rule・section break を境界として検出します。
//:
//: [計算量/けいさんりょう]:
//: - O(line_length)
fn nm_is_block_boundary <(str)->bool> (trimmed):
    if:
        eq len trimmed 0
        then true
        else:
            if:
                gt nm_heading_level trimmed 0
                then true
                else:
                    if:
                        is_fence_start trimmed
                        then true
                        else:
                            if:
                                is_hr trimmed
                                then true
                                else is_section_break trimmed

//: nm_deepest_level: open section の最深 level を返す
//:
//: [目的/もくてき]:
//: - 最大 6 段の heading stack を Copy bool だけで管理するため、現在の最深 section を計算します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_deepest_level <(bool,bool,bool,bool,bool,bool)->i32> (open1, open2, open3, open4, open5, open6):
    if:
        open6
        then 6
        else:
            if:
                open5
                then 5
                else:
                    if:
                        open4
                        then 4
                        else:
                            if:
                                open3
                                then 3
                                else:
                                    if:
                                        open2
                                        then 2
                                        else:
                                            if:
                                                open1
                                                then 1
                                                else 0

//: json_escape: JSON 文字列用に byte を escape する
//:
//: [目的/もくてき]:
//: - JSON string literal に入る `"` / `\` / control character を escape します。
//:
//: [実装/じっそう]:
//: - char literal の `match` で escape 種別を直接分類します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn json_escape <(str)->str> (s):
    let mut sb <StringBuilder> string_builder_new;
    let n <i32> len s;
    let mut i <i32> 0;
    while lt i n:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            match ch:
                '\\':
                    set sb sb_append sb "\\\\"
                '"':
                    set sb sb_append sb "\\\""
                '\n':
                    set sb sb_append sb "\\n"
                '\r':
                    set sb sb_append sb "\\r"
                '\t':
                    set sb sb_append sb "\\t"
                '\b':
                    set sb sb_append sb "\\b"
                '\f':
                    set sb sb_append sb "\\f"
                _:
                    set sb sb_append sb str_slice s i add i 1;
            set i add i 1;
    sb_build sb

//: nm_find_math_end: math delimiter の閉じ位置を探す
//:
//: [目的/もくてき]:
//: - `$...$` と `$$...$$` の閉じ delimiter 開始位置を返します。見つからなければ -1 です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn nm_find_math_end <(str,i32,i32)->i32> (s, start, delim):
    let n <i32> len s;
    let mut j <i32> start;
    let mut found <i32> -1;
    while and lt j n lt found 0:
        do:
            let c0 <i32> string_byte_at_unchecked s j;
            if:
                eq delim 1
                then:
                    if:
                        eq c0 '$'
                        then set found j
                        else set j add j 1
                else:
                    if:
                        and eq c0 '$' lt add j 1 n
                        then:
                            let c1 <i32> string_byte_at_unchecked s add j 1;
                            if:
                                eq c1 '$'
                                then set found j
                                else set j add j 1
                        else:
                            set j add j 1
    found

//: nm_find_byte: 指定 byte の位置を探す
//:
//: [目的/もくてき]:
//: - `start <= i < end` の範囲で最初に `target` が現れる位置を返します。見つからなければ -1 です。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn nm_find_byte <(str,i32,i32,i32)->i32> (s, start, end, target):
    let mut i <i32> start;
    let mut found <i32> -1;
    while and lt i end lt found 0:
        do:
            if:
                eq string_byte_at_unchecked s i target
                then set found i
                else set i add i 1
    found

//: nm_find_gloss_slash: gloss body の top-level slash を探す
//:
//: [目的/もくてき]:
//: - `{main/sub}` の `/` を探します。`[base/ruby]` 内の slash は無視します。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn nm_find_gloss_slash <(str,i32,i32)->i32> (s, start, end):
    let mut i <i32> start;
    let mut depth <i32> 0;
    let mut found <i32> -1;
    while and lt i end lt found 0:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            match ch:
                '[':
                    set depth add depth 1
                ']':
                    if:
                        gt depth 0
                        then set depth sub depth 1
                        else ()
                '/':
                    if:
                        eq depth 0
                        then set found i
                        else ()
                _:
                    ()
            set i add i 1;
    found

//: nm_inline_to_json: inline markup を JSON array に変換する
//:
//: [目的/もくてき]:
//: - 1 行分の inline markup を `[{...}]` 形式の JSON array へ直接変換します。
//:
//: [実装/じっそう]:
//: - pending text を marker の直前で flush し、ruby/gloss/math を object として追加します。
//: - raw storage に inline AST を置かないため、strict move checking と衝突しません。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
fn nm_inline_to_json <(str)->str> (s):
    let mut sb <StringBuilder> string_builder_new;
    set sb sb_append sb "[";
    let n <i32> len s;
    let mut i <i32> 0;
    let mut text_start <i32> 0;
    let mut has <bool> false;
    while lt i n:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            match ch:
                '$':
                    let mut delim <i32> 1;
                    if:
                        and lt add i 1 n eq string_byte_at_unchecked s add i 1 '$'
                        then set delim 2
                        else ()
                    let math_end <i32> nm_find_math_end s add i delim delim;
                    if:
                        ge math_end 0
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then:
                                    if has then set sb sb_append sb "," else ()
                                    set sb sb_append sb "{\"t\":\"text\",\"s\":\"";
                                    set sb sb_append sb json_escape seg;
                                    set sb sb_append sb "\"}";
                                    set has true
                                else ()
                            let endpos <i32> add math_end delim;
                            let m <str> str_slice s i endpos;
                            if has then set sb sb_append sb "," else ()
                            set sb sb_append sb "{\"t\":\"math\",\"s\":\"";
                            set sb sb_append sb json_escape m;
                            set sb sb_append sb "\"}";
                            set has true;
                            set i endpos;
                            set text_start endpos
                        else:
                            set i add i 1
                '[':
                    let close <i32> nm_find_byte s add i 1 n ']';
                    let slash <i32>:
                        if:
                            ge close 0
                            then nm_find_byte s add i 1 close '/'
                            else -1
                    let mut next_is_paren <bool> false;
                    if:
                        and ge close 0 lt add close 1 n
                        then set next_is_paren eq string_byte_at_unchecked s add close 1 '('
                        else ()
                    if:
                        and ge close 0 and ge slash 0 not next_is_paren
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then:
                                    if has then set sb sb_append sb "," else ()
                                    set sb sb_append sb "{\"t\":\"text\",\"s\":\"";
                                    set sb sb_append sb json_escape seg;
                                    set sb sb_append sb "\"}";
                                    set has true
                                else ()
                            let base <str> str_slice s add i 1 slash;
                            let rub <str> str_slice s add slash 1 close;
                            if has then set sb sb_append sb "," else ()
                            set sb sb_append sb "{\"t\":\"ruby\",\"base\":\"";
                            set sb sb_append sb json_escape base;
                            set sb sb_append sb "\",\"ruby\":\"";
                            set sb sb_append sb json_escape rub;
                            set sb sb_append sb "\"}";
                            set has true;
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                '{':
                    let close <i32> nm_find_byte s add i 1 n '}';
                    let first_slash <i32>:
                        if:
                            ge close 0
                            then nm_find_gloss_slash s add i 1 close
                            else -1
                    if:
                        and ge close 0 ge first_slash 0
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then:
                                    if has then set sb sb_append sb "," else ()
                                    set sb sb_append sb "{\"t\":\"text\",\"s\":\"";
                                    set sb sb_append sb json_escape seg;
                                    set sb sb_append sb "\"}";
                                    set has true
                                else ()
                            let main <str> str_slice s add i 1 first_slash;
                            if has then set sb sb_append sb "," else ()
                            set sb sb_append sb "{\"t\":\"gloss\",\"main\":\"";
                            set sb sb_append sb json_escape main;
                            set sb sb_append sb "\",\"subs\":[";
                            let mut sub_start <i32> add first_slash 1;
                            let mut k <i32> sub_start;
                            let mut sub_has <bool> false;
                            while lt k close:
                                do:
                                    let next_slash <i32> nm_find_gloss_slash s k close;
                                    let part_end <i32>:
                                        if:
                                            ge next_slash 0
                                            then next_slash
                                            else close
                                    let part <str> str_slice s sub_start part_end;
                                    if sub_has then set sb sb_append sb "," else ()
                                    set sb sb_append sb "\"";
                                    set sb sb_append sb json_escape part;
                                    set sb sb_append sb "\"";
                                    set sub_has true;
                                    if:
                                        ge next_slash 0
                                        then:
                                            set sub_start add next_slash 1;
                                            set k sub_start
                                        else:
                                            set k close
                            set sb sb_append sb "]}";
                            set has true;
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                _:
                    set i add i 1
    let tail <str> str_slice s text_start n;
    if:
        gt len tail 0
        then:
            if has then set sb sb_append sb "," else ()
            set sb sb_append sb "{\"t\":\"text\",\"s\":\"";
            set sb sb_append sb json_escape tail;
            set sb sb_append sb "\"}"
        else ()
    set sb sb_append sb "]";
    sb_build sb

//: nm_json_begin_node: 現在 container に JSON node を追加する前処理を行う
//:
//: [目的/もくてき]:
//: - root または現在 section children の comma が必要かどうかを判定します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_json_needs_comma <(i32,bool,bool,bool,bool,bool,bool,bool)->bool> (current_level, root_has, has1, has2, has3, has4, has5, has6):
    match current_level:
        0:
            root_has
        1:
            has1
        2:
            has2
        3:
            has3
        4:
            has4
        5:
            has5
        _:
            has6

//: parse_markdown: 拡張 Markdown 文字列を `Document` source view にする
//:
//: [目的/もくてき]:
//: - nm 系 API の入口として、後段 serializer が再走査できる document 値を返します。
//:
//: [実装/じっそう]:
//: - AST raw storage は作らず、source `str` を Copy view として保持します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser" as *
//: fn main <()*>i32> ():
//:     let d <Document> parse_markdown "# T\n\nx\n";
//:     let j <str> document_to_json d;
//:     if and str_starts_with j "{\"t\":\"doc\"" gt len j 0 0 1
//: ```
pub fn parse_markdown <(str)->Document> (input):
    Document input

//: document_to_json: `Document` を JSON 文字列へ変換する
//:
//: [目的/もくてき]:
//: - Document source を再走査し、block / inline 構造を JSON へ直接出力します。
//:
//: [実装/じっそう]:
//: - section stack は bool と current level で保持し、JSON の children array は section close 時に閉じます。
//: - `Vec<Node>` / `Vec<Inline>` は使わず、StringBuilder だけで出力します。
//:
//: [注意/ちゅうい]:
//: - `---` は `hr` node を出力した後、現在 section を 1 段閉じます。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser" as *
//: fn main <()*>i32> ():
//:     let d <Document> parse_markdown "plain\n";
//:     let j <str> document_to_json d;
//:     if str_starts_with j "{\"t\":\"doc\"" 0 1
//: ```
pub fn document_to_json <(Document)->str> (doc):
    let src <str> get doc "source";
    let mut sb <StringBuilder> string_builder_new;
    set sb sb_append sb "{\"t\":\"doc\",\"nodes\":[";
    let n <i32> len src;
    let mut pos <i32> 0;
    let mut current_level <i32> 0;
    let mut open1 <bool> false;
    let mut open2 <bool> false;
    let mut open3 <bool> false;
    let mut open4 <bool> false;
    let mut open5 <bool> false;
    let mut open6 <bool> false;
    let mut root_has <bool> false;
    let mut has1 <bool> false;
    let mut has2 <bool> false;
    let mut has3 <bool> false;
    let mut has4 <bool> false;
    let mut has5 <bool> false;
    let mut has6 <bool> false;

    while lt pos n:
        do:
            let line_end <i32> nm_line_end src pos;
            let raw <str> trim_cr str_slice src pos line_end;
            let t <str> str_trim raw;
            set pos nm_next_line_pos src line_end;
            if:
                eq len t 0
                then:
                    ()
                else:
                    if:
                        is_section_break t
                        then:
                            if:
                                gt current_level 0
                                then:
                                    set sb sb_append sb "]}";
                                    match current_level:
                                        1:
                                            set open1 false
                                        2:
                                            set open2 false
                                        3:
                                            set open3 false
                                        4:
                                            set open4 false
                                        5:
                                            set open5 false
                                        _:
                                            set open6 false
                                    set current_level nm_deepest_level open1 open2 open3 open4 open5 open6
                                else ()
                        else:
                            if:
                                is_hr t
                                then:
                                    if nm_json_needs_comma current_level root_has has1 has2 has3 has4 has5 has6 then set sb sb_append sb "," else ()
                                    match current_level:
                                        0:
                                            set root_has true
                                        1:
                                            set has1 true
                                        2:
                                            set has2 true
                                        3:
                                            set has3 true
                                        4:
                                            set has4 true
                                        5:
                                            set has5 true
                                        _:
                                            set has6 true
                                    set sb sb_append sb "{\"t\":\"hr\"}";
                                    if:
                                        gt current_level 0
                                        then:
                                            set sb sb_append sb "]}";
                                            match current_level:
                                                1:
                                                    set open1 false
                                                2:
                                                    set open2 false
                                                3:
                                                    set open3 false
                                                4:
                                                    set open4 false
                                                5:
                                                    set open5 false
                                                _:
                                                    set open6 false
                                            set current_level nm_deepest_level open1 open2 open3 open4 open5 open6
                                        else ()
                                else:
                                    if:
                                        is_fence_start t
                                        then:
                                            let info <str> str_trim str_slice t 3 len t;
                                            let mut code_sb <StringBuilder> string_builder_new;
                                            let mut done <bool> false;
                                            while and lt pos n not done:
                                                do:
                                                    let cend <i32> nm_line_end src pos;
                                                    let craw <str> trim_cr str_slice src pos cend;
                                                    let ct <str> str_trim craw;
                                                    set pos nm_next_line_pos src cend;
                                                    if:
                                                        is_fence_start ct
                                                        then set done true
                                                        else:
                                                            set code_sb sb_append code_sb craw;
                                                            set code_sb sb_append code_sb "\n"
                                            if nm_json_needs_comma current_level root_has has1 has2 has3 has4 has5 has6 then set sb sb_append sb "," else ()
                                            match current_level:
                                                0:
                                                    set root_has true
                                                1:
                                                    set has1 true
                                                2:
                                                    set has2 true
                                                3:
                                                    set has3 true
                                                4:
                                                    set has4 true
                                                5:
                                                    set has5 true
                                                _:
                                                    set has6 true
                                            set sb sb_append sb "{\"t\":\"code\",\"info\":\"";
                                            set sb sb_append sb json_escape info;
                                            set sb sb_append sb "\",\"code\":\"";
                                            set sb sb_append sb json_escape sb_build code_sb;
                                            set sb sb_append sb "\"}"
                                        else:
                                            let hlevel <i32> nm_heading_level t;
                                            if:
                                                gt hlevel 0
                                                then:
                                                    while ge current_level hlevel:
                                                        do:
                                                            set sb sb_append sb "]}";
                                                            match current_level:
                                                                1:
                                                                    set open1 false
                                                                2:
                                                                    set open2 false
                                                                3:
                                                                    set open3 false
                                                                4:
                                                                    set open4 false
                                                                5:
                                                                    set open5 false
                                                                _:
                                                                    set open6 false
                                                            set current_level nm_deepest_level open1 open2 open3 open4 open5 open6
                                                    if nm_json_needs_comma current_level root_has has1 has2 has3 has4 has5 has6 then set sb sb_append sb "," else ()
                                                    match current_level:
                                                        0:
                                                            set root_has true
                                                        1:
                                                            set has1 true
                                                        2:
                                                            set has2 true
                                                        3:
                                                            set has3 true
                                                        4:
                                                            set has4 true
                                                        5:
                                                            set has5 true
                                                        _:
                                                            set has6 true
                                                    let htext <str> nm_heading_text t hlevel;
                                                    set sb sb_append sb "{\"t\":\"section\",\"level\":";
                                                    set sb sb_append_i32 sb hlevel;
                                                    set sb sb_append sb ",\"heading\":{\"level\":";
                                                    set sb sb_append_i32 sb hlevel;
                                                    set sb sb_append sb ",\"inl\":";
                                                    set sb sb_append sb nm_inline_to_json htext;
                                                    set sb sb_append sb "},\"children\":[";
                                                    match hlevel:
                                                        1:
                                                            set open1 true; set has1 false
                                                        2:
                                                            set open2 true; set has2 false
                                                        3:
                                                            set open3 true; set has3 false
                                                        4:
                                                            set open4 true; set has4 false
                                                        5:
                                                            set open5 true; set has5 false
                                                        _:
                                                            set open6 true; set has6 false
                                                    set current_level hlevel
                                                else:
                                                    let mut para_sb <StringBuilder> string_builder_new;
                                                    set para_sb sb_append para_sb raw;
                                                    let mut done <bool> false;
                                                    while and lt pos n not done:
                                                        do:
                                                            let pend <i32> nm_line_end src pos;
                                                            let praw <str> trim_cr str_slice src pos pend;
                                                            let pt <str> str_trim praw;
                                                            if:
                                                                nm_is_block_boundary pt
                                                                then set done true
                                                                else:
                                                                    set para_sb sb_append para_sb "\n";
                                                                    set para_sb sb_append para_sb praw;
                                                                    set pos nm_next_line_pos src pend
                                                    if nm_json_needs_comma current_level root_has has1 has2 has3 has4 has5 has6 then set sb sb_append sb "," else ()
                                                    match current_level:
                                                        0:
                                                            set root_has true
                                                        1:
                                                            set has1 true
                                                        2:
                                                            set has2 true
                                                        3:
                                                            set has3 true
                                                        4:
                                                            set has4 true
                                                        5:
                                                            set has5 true
                                                        _:
                                                            set has6 true
                                                    set sb sb_append sb "{\"t\":\"p\",\"inl\":";
                                                    set sb sb_append sb nm_inline_to_json sb_build para_sb;
                                                    set sb sb_append sb "}"

    while gt current_level 0:
        do:
            set sb sb_append sb "]}";
            match current_level:
                1:
                    set open1 false
                2:
                    set open2 false
                3:
                    set open3 false
                4:
                    set open4 false
                5:
                    set open5 false
                _:
                    set open6 false
            set current_level nm_deepest_level open1 open2 open3 open4 open5 open6
    set sb sb_append sb "]}";
    sb_build sb
