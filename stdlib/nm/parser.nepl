//: parser: nm/parser.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "alloc/string" as *
#import "alloc/collections/vec" as v
#import "core/option" as *
#import "core/mem" as *
#import "core/math" as *
#import "alloc/collections/stack" as *
#import "core/field" as *
#import "core/result" as *

// -----------------------------
// AST
// -----------------------------

pub struct Document:
    nodes <Vec<Node>>

pub struct Heading:
    level <i32>
    inlines <Vec<Inline>>

pub struct NestSection:
    level <i32>
    heading <Heading>
    children <Vec<Node>>

pub struct RubyInfo:
    base <str>
    ruby <str>

pub struct GlossInfo:
    main <str>
    subs <Vec<str>>

pub struct CodeBlockInfo:
    info <str>
    code <str>

pub enum Inline:
    Text <str>
    Ruby <RubyInfo>
    Gloss <GlossInfo>
    Math <str>

pub enum Node:
    Section <NestSection>
    Paragraph <Vec<Inline>>
    Hr
    CodeBlock <CodeBlockInfo>

//: NmJsonEscapeKind: NM JSON 出力用の escape 分類
//:
//: [目的/もくてき]:
//: - JSON 文字列に入れる byte のうち、escape が必要なものを分類します。
//:
//: [実装/じっそう]:
//: - `nm_json_escape_kind` で byte を分類し、`json_escape` は match で出力文字列を選びます。
//:
//: [注意/ちゅうい]:
//: - parser の AST JSON 出力で必要な代表的 JSON escape を扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
enum NmJsonEscapeKind:
    Backslash
    Quote
    Newline
    CarriageReturn
    Tab
    Backspace
    FormFeed
    Plain

fn nm_json_escape_kind <(i32)->NmJsonEscapeKind> (ch):
    match ch:
        92:
            NmJsonEscapeKind::Backslash
        34:
            NmJsonEscapeKind::Quote
        10:
            NmJsonEscapeKind::Newline
        13:
            NmJsonEscapeKind::CarriageReturn
        9:
            NmJsonEscapeKind::Tab
        8:
            NmJsonEscapeKind::Backspace
        12:
            NmJsonEscapeKind::FormFeed
        _:
            NmJsonEscapeKind::Plain

// Multi-return helpers (no tuple destructuring)
//: FenceRes: 構造体の概要
//:
//: [目的/もくてき]:
//: - FenceRes の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
struct FenceRes:
    cb <CodeBlockInfo>
    next_i <i32>

//: ParaRes: 構造体の概要
//:
//: [目的/もくてき]:
//: - ParaRes の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
struct ParaRes:
    inlines <Vec<Inline>>
    next_i <i32>

//: InlinePushRes: `Inline` push の結果
//:
//: [目的/もくてき]:
//: - push 後の Vec owner と、push が成功したかを同時に返します。
struct InlinePushRes:
    items <Vec<Inline>>
    ok <bool>

//: StrPushRes: `str` push の結果
//:
//: [目的/もくてき]:
//: - Gloss parts/subs の push 後 Vec owner と、push が成功したかを同時に返します。
struct StrPushRes:
    items <Vec<str>>
    ok <bool>

//: NodePushRes: `Node` push の結果
//:
//: [目的/もくてき]:
//: - block parser の root/children push 後 Vec owner と、push が成功したかを同時に返します。
struct NodePushRes:
    items <Vec<Node>>
    ok <bool>

// -----------------------------
// Small helpers
// -----------------------------

fn nest_stack_len_from_hdr <(MemPtr<u8>)->i32> (hdr):
    load_i32 mem_ptr_addr hdr

fn nest_stack_cap_ptr_from_hdr <(MemPtr<u8>)->MemPtr<i32>> (hdr):
    mem_ptr_wrap add mem_ptr_addr hdr 4

fn nest_stack_data_ptr_ptr_from_hdr <(MemPtr<u8>)->MemPtr<i32>> (hdr):
    mem_ptr_wrap add mem_ptr_addr hdr 8

fn nest_stack_data_from_hdr <(MemPtr<u8>)->MemPtr<NestSection>> (hdr):
    mem_ptr_wrap load_i32 mem_ptr_addr nest_stack_data_ptr_ptr_from_hdr hdr

//: nm_node_empty_vec: 空の `Node` Vec sentinel を作る
//:
//: [目的/もくてき]:
//: - block parser の allocation failure 時に、consumed owner を再利用せず空の失敗値へ切り替えます。
fn nm_node_empty_vec <()->Vec<Node>> ():
    v::Vec<Node> 0 0 mem_ptr_wrap 0

//: nm_push_node: `Node` Vec への push を trap せず結果化する
//:
//: [目的/もくてき]:
//: - `v::push` の grow failure を `unwrap_ok` で trap させず、`ok=false` と空 Vec sentinel へ変換します。
fn nm_push_node <(Vec<Node>, Node)->NodePushRes> (items, item):
    match v::push<Node> items item:
        Result::Ok next:
            NodePushRes next true
        Result::Err _e:
            NodePushRes nm_node_empty_vec false

fn nest_stack_peek_from_hdr <(MemPtr<u8>)->Option<NestSection>> (hdr):
    let len <i32> nest_stack_len_from_hdr hdr;
    if:
        eq len 0
        then none<NestSection>
        else:
            let data <MemPtr<NestSection>> nest_stack_data_from_hdr hdr;
            let off <i32> mul sub len 1 size_of<NestSection>;
            some<NestSection> load<NestSection> add mem_ptr_addr data off

fn nest_stack_pop_from_hdr <(MemPtr<u8>)->Option<NestSection>> (hdr):
    let len <i32> nest_stack_len_from_hdr hdr;
    if:
        eq len 0
        then none<NestSection>
        else:
            let new_len <i32> sub len 1;
            let data <MemPtr<NestSection>> nest_stack_data_from_hdr hdr;
            let off <i32> mul new_len size_of<NestSection>;
            let item <NestSection> load<NestSection> add mem_ptr_addr data off;
            store_i32 mem_ptr_addr hdr new_len;
            some<NestSection> item

fn nest_stack_push_from_hdr_result <(MemPtr<u8>,NestSection)->Result<(),str>> (hdr, item):
    let len_ptr <MemPtr<i32>> mem_ptr_wrap mem_ptr_addr hdr;
    let cap_ptr <MemPtr<i32>> nest_stack_cap_ptr_from_hdr hdr;
    let data_ptr_ptr <MemPtr<i32>> nest_stack_data_ptr_ptr_from_hdr hdr;
    let len <i32> load_i32 mem_ptr_addr len_ptr;
    let cap <i32> load_i32 mem_ptr_addr cap_ptr;
    let data <MemPtr<NestSection>> mem_ptr_wrap load_i32 mem_ptr_addr data_ptr_ptr;
    if:
        eq len cap
        then:
            let new_cap <i32> if eq cap 0 1 mul cap 2;
            match realloc_ptr<NestSection> data mul cap size_of<NestSection> mul new_cap size_of<NestSection>:
                Result::Ok new_data:
                    let off <i32> mul len size_of<NestSection>;
                    store<NestSection> add mem_ptr_addr new_data off item;
                    store_i32 mem_ptr_addr cap_ptr new_cap;
                    store_i32 mem_ptr_addr data_ptr_ptr mem_ptr_addr new_data;
                    store_i32 mem_ptr_addr len_ptr add len 1;
                    Result<(),str>::Ok ()
                Result::Err _e:
                    Result<(),str>::Err "nm.parser nest stack grow failed"
        else:
            let off <i32> mul len size_of<NestSection>;
            store<NestSection> add mem_ptr_addr data off item;
            store_i32 mem_ptr_addr len_ptr add len 1;
            Result<(),str>::Ok ()

//: is_empty_line: 主な用途
//:
//: [目的/もくてき]:
//: - is_empty_line の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn is_empty_line <(str)->bool> (s):
    let t <str> str_trim s;
    eq len t 0

//: is_hr_line: 主な用途
//:
//: [目的/もくてき]:
//: - is_hr_line の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn is_hr_line <(str)->bool> (s):
    let t <str> str_trim s;
    str_eq t "---"

//: is_nest_break_line: 主な用途
//:
//: [目的/もくてき]:
//: - is_nest_break_line の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn is_nest_break_line <(str)->bool> (s):
    let t <str> str_trim s;
    str_eq t ";;;"

//: is_fence_start: 主な用途
//:
//: [目的/もくてき]:
//: - is_fence_start の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn is_fence_start <(str)->bool> (s):
    let t <str> str_trim s;
    str_starts_with t "```"

//: is_heading_start: 主な用途
//:
//: [目的/もくてき]:
//: - is_heading_start の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn is_heading_start <(str)->bool> (s):
    let t <str> str_trim s;
    or str_starts_with t "# " or str_starts_with t "## " or str_starts_with t "### " or str_starts_with t "#### " or str_starts_with t "##### " str_starts_with t "###### "

//: trim_cr: 主な用途
//:
//: [目的/もくてき]:
//: - trim_cr の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn trim_cr <(str)->str> (s):
    let n <i32> len s;
    if:
        le n 0
        then s
        else:
            let last <i32> string_byte_at_unchecked s sub n 1;
            if:
                eq last 13
                then str_slice s 0 sub n 1
                else s

//: safe_line: 主な用途
//:
//: [目的/もくてき]:
//: - safe_line の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn safe_line <(i32, i32)->str> (lines_mem, i):
    let lines <Vec<str>> load<Vec<str>> lines_mem;
    match v::get<str> lines i:
        Option::Some s:
            trim_cr s
        Option::None:
            ""

//: close_one_section: 主な用途
//:
//: [目的/もくてき]:
//: - close_one_section の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn close_one_section <(Stack<NestSection>, Vec<Node>)*>Vec<Node>> (stk, root):
    let hdr <MemPtr<u8>> get stk "hdr";
    match nest_stack_pop_from_hdr hdr:
        Option::Some sec:
            let node <Node> Node::Section sec;
            match nest_stack_peek_from_hdr hdr:
                Option::Some top:
                    let parent_level <i32> get top "level";
                    let parent_heading <Heading> get top "heading";
                    match nest_stack_pop_from_hdr hdr:
                        Option::Some parent:
                            let pushed_kids <NodePushRes> nm_push_node get parent "children" node;
                            let pushed_kids_ok <bool> get pushed_kids "ok";
                            let kids <Vec<Node>> get pushed_kids "items";
                            if:
                                pushed_kids_ok
                                then:
                                    let parent2 <NestSection> NestSection parent_level parent_heading kids;
                                    match nest_stack_push_from_hdr_result hdr parent2:
                                        Result::Ok _:
                                            root
                                        Result::Err _e:
                                            root
                                else:
                                    root
                        Option::None:
                            let pushed_root <NodePushRes> nm_push_node root node;
                            get pushed_root "items"
                Option::None:
                    let pushed_root <NodePushRes> nm_push_node root node;
                    get pushed_root "items"
        Option::None:
            root

//: close_to_level: 主な用途
//:
//: [目的/もくてき]:
//: - close_to_level の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn close_to_level <(Stack<NestSection>, Vec<Node>, i32)*>Vec<Node>> (stk, root, new_level):
    // Close while top.level >= new_level
    let hdr <MemPtr<u8>> get stk "hdr";
    let mut r <Vec<Node>> root;
    let mut done <bool> false;
    while not done:
        do:
            match nest_stack_peek_from_hdr hdr:
                Option::Some top:
                    if:
                        ge get top "level" new_level
                        then:
                            set r close_one_section (Stack hdr) r;
                            ()
                        else:
                            set done true;
                            ()
                Option::None:
                    set done true;
                    ()
    r

//: close_all_sections: 主な用途
//:
//: [目的/もくてき]:
//: - close_all_sections の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn close_all_sections <(Stack<NestSection>, Vec<Node>)*>Vec<Node>> (stk, root):
    let hdr <MemPtr<u8>> get stk "hdr";
    let mut r <Vec<Node>> root;
    let mut done <bool> false;
    while not done:
        do:
            match nest_stack_peek_from_hdr hdr:
                Option::Some _:
                    set r close_one_section (Stack hdr) r;
                    ()
                Option::None:
                    set done true;
                    ()
    r

//: parse_heading: 主な用途
//:
//: [目的/もくてき]:
//: - parse_heading の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn parse_heading <(str)->Option<Heading>> (line):
    let t <str> str_trim line;

    if:
        str_starts_with t "###### "
        then:
            let txt <str> str_slice t 7 len t;
            Option::Some Heading 6 parse_inlines txt
        else:
            if:
                str_starts_with t "##### "
                then:
                    let txt <str> str_slice t 6 len t;
                    Option::Some Heading 5 parse_inlines txt
                else:
                    if:
                        str_starts_with t "#### "
                        then:
                            let txt <str> str_slice t 5 len t;
                            Option::Some Heading 4 parse_inlines txt
                        else:
                            if:
                                str_starts_with t "### "
                                then:
                                    let txt <str> str_slice t 4 len t;
                                    Option::Some Heading 3 parse_inlines txt
                                else:
                                    if:
                                        str_starts_with t "## "
                                        then:
                                            let txt <str> str_slice t 3 len t;
                                            Option::Some Heading 2 parse_inlines txt
                                        else:
                                            if:
                                                str_starts_with t "# "
                                                then:
                                                    let txt <str> str_slice t 2 len t;
                                                    Option::Some Heading 1 parse_inlines txt
                                                else:
                                                    Option::None

//: parse_fence: 主な用途
//:
//: [目的/もくてき]:
//: - parse_fence の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn parse_fence <(i32, i32, i32)->FenceRes> (lines_mem, nlines, i0):
    let t0 <str> str_trim safe_line lines_mem i0;
    let info0 <str> str_slice t0 3 len t0;
    let info <str> str_trim info0;

    let mut sb <StringBuilder> string_builder_new;
    let mut i <i32> add i0 1;

    let mut done <bool> false;
    while not done:
        do:
            if:
                ge i nlines
                then:
                    set done true;
                    ()
                else:
                    let li <str> str_trim safe_line lines_mem i;
                    if:
                        str_starts_with li "```"
                        then:
                            set i add i 1;
                            set done true;
                            ()
                        else:
                            set sb sb_append sb safe_line lines_mem i;
                            set sb sb_append sb "\n";
                            set i add i 1;
                            ()
    let code <str> sb_build sb;
    let cb <CodeBlockInfo> CodeBlockInfo info code;
    FenceRes cb i

//: parse_paragraph: 主な用途
//:
//: [目的/もくてき]:
//: - parse_paragraph の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn parse_paragraph <(i32, i32, i32)->ParaRes> (lines_mem, nlines, i0):
    let mut sb <StringBuilder> string_builder_new;
    let mut i <i32> i0;
    let mut first <bool> true;

    let mut done <bool> false;
    while not done:
        do:
            if:
                ge i nlines
                then:
                    set done true;
                    ()
                else:
                    let raw <str> safe_line lines_mem i;
                    let t <str> str_trim raw;

                    if:
                        eq len t 0
                        then:
                            set done true;
                            ()
                        else:
                            if:
                                or is_heading_start t or is_hr_line t or is_nest_break_line t is_fence_start t
                                then:
                                    set done true;
                                    ()
                                else:
                                    if:
                                        first
                                        then:
                                            set first false;
                                            ()
                                        else:
                                            set sb sb_append sb "\n";
                                    set sb sb_append sb raw;
                                    set i add i 1;
                                    ()
    let text <str> sb_build sb;
    let inl <Vec<Inline>> parse_inlines text;
    ParaRes inl i

// -----------------------------
// Inline parser: Ruby / Gloss / Math
// -----------------------------

//: nm_inline_empty_vec: 空の `Inline` Vec sentinel を作る
//:
//: [目的/もくてき]:
//: - inline parser の allocation failure 時に、consumed owner を再利用せず空の失敗値へ切り替えます。
fn nm_inline_empty_vec <()->Vec<Inline>> ():
    v::Vec<Inline> 0 0 mem_ptr_wrap 0

//: nm_str_empty_vec: 空の `str` Vec sentinel を作る
//:
//: [目的/もくてき]:
//: - Gloss parts / subs の allocation failure 時に、consumed owner を再利用せず空の失敗値へ切り替えます。
fn nm_str_empty_vec <()->Vec<str>> ():
    v::Vec<str> 0 0 mem_ptr_wrap 0

//: nm_push_inline: `Inline` Vec への push を trap せず結果化する
//:
//: [目的/もくてき]:
//: - `v::push` の grow failure を `unwrap_ok` で trap させず、`ok=false` と空 Vec sentinel へ変換します。
fn nm_push_inline <(Vec<Inline>, Inline)->InlinePushRes> (items, item):
    match v::push<Inline> items item:
        Result::Ok next:
            InlinePushRes next true
        Result::Err _e:
            InlinePushRes nm_inline_empty_vec false

//: nm_push_str: `str` Vec への push を trap せず結果化する
//:
//: [目的/もくてき]:
//: - Gloss 分割中の `v::push` grow failure を `unwrap_ok` で trap させず、`ok=false` と空 Vec sentinel へ変換します。
fn nm_push_str <(Vec<str>, str)->StrPushRes> (items, item):
    match v::push<str> items item:
        Result::Ok next:
            StrPushRes next true
        Result::Err _e:
            StrPushRes nm_str_empty_vec false

//: parse_inlines: 1 行分の NM inline markup を AST に変換する
//:
//: [目的/もくてき]:
//: - 通常 text、Ruby `[base/ruby]`、Gloss `{main/sub...}`、Math `$...$` / `$$...$$` を `Inline` の列へ変換します。
//:
//: [実装/じっそう]:
//: - 入力を byte index で 1 度だけ走査し、special marker を見つけた時点で直前の text を flush します。
//: - `Vec` の確保・push 失敗は trap させず、空 Vec sentinel に切り替えて解析を中断します。
//:
//: [注意/ちゅうい]:
//: - 既存 API 互換のため `Result` ではなく `Vec<Inline>` を返します。失敗を区別する API は今後の `parse_markdown_result` 側で扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(n)（n は入力 byte 数）。
fn parse_inlines <(str)->Vec<Inline>> (s):
    let mut out <Vec<Inline>> nm_inline_empty_vec;
    let mut failed <bool> false;
    match v::new<Inline>:
        Result::Ok out0:
            set out out0
        Result::Err _e:
            set failed true;
    let n <i32> len s;
    let mut i <i32> 0;
    let mut text_start <i32> 0;

    while and lt i n not failed:
        do:
            let ch <i32> string_byte_at_unchecked s i;

            // Math ($ or $$): keep delimiters, do not parse inside
            if:
                eq ch 36
                then:
                    // Flush pending text
                    let seg <str> str_slice s text_start i;
                    if:
                        gt len seg 0
                        then:
                            let pushed_text <InlinePushRes> nm_push_inline out Inline::Text seg;
                            let pushed_text_ok <bool> get pushed_text "ok";
                            set out get pushed_text "items";
                            if:
                                pushed_text_ok
                                then ()
                                else set failed true
                        else ()

                    let mut delim <i32> 1;
                    if:
                        lt add i 1 n
                        then:
                            let ch2 <i32> string_byte_at_unchecked s add i 1;
                            if:
                                eq ch2 36
                                then set delim 2
                                else ()
                        else ()

                    let mut j <i32> add i delim;
                    let mut found <bool> false;

                    while and lt j n not found:
                        do:
                            let c0 <i32> string_byte_at_unchecked s j;
                            if:
                                eq delim 1
                                then:
                                    if:
                                        eq c0 36
                                        then set found true
                                        else set j add j 1
                                else:
                                    if:
                                        and eq c0 36 lt add j 1 n
                                        then:
                                            let c1 <i32> string_byte_at_unchecked s add j 1;
                                            if:
                                                eq c1 36
                                                then set found true
                                                else set j add j 1
                                        else:
                                            set j add j 1

                    if:
                        found
                        then:
                            let endpos <i32> add j delim;
                            let m <str> str_slice s i endpos;
                            if:
                                not failed
                                then:
                                    let pushed_math <InlinePushRes> nm_push_inline out Inline::Math m;
                                    let pushed_math_ok <bool> get pushed_math "ok";
                                    set out get pushed_math "items";
                                    if:
                                        pushed_math_ok
                                        then:
                                            set i endpos;
                                            set text_start endpos;
                                            ()
                                        else:
                                            set failed true;
                                            ()
                                else ()
                        else:
                            // No closing delimiter -> treat '$' as normal text
                            set i add i 1;
                            set text_start text_start;
                            ()
                else:
                    // Ruby: [base/ruby] (ignore if looks like markdown link: ]( )
                    if:
                        eq ch 91
                        then:
                            let mut j <i32> add i 1;
                            let mut slash <i32> -1;
                            let mut closed <bool> false;

                            while and lt j n not closed:
                                do:
                                    let cj <i32> string_byte_at_unchecked s j;
                                    if:
                                        eq cj 93
                                        then set closed true
                                        else:
                                            if:
                                                and eq cj 47 lt slash 0
                                                then set slash j
                                                else ()
                                            set j add j 1;
                                            ()
                            if:
                                and closed ge slash 0
                                then:
                                    let mut next_is_paren <bool> false;
                                    if:
                                        lt add j 1 n
                                        then:
                                            let nx <i32> string_byte_at_unchecked s add j 1;
                                            set next_is_paren eq nx 40;
                                            ()
                                        else ()

                                    if:
                                        next_is_paren
                                        then:
                                            set i add i 1;
                                            ()
                                        else:
                                            let seg <str> str_slice s text_start i;
                                            if:
                                                gt len seg 0
                                                then:
                                                    let pushed_text <InlinePushRes> nm_push_inline out Inline::Text seg;
                                                    let pushed_text_ok <bool> get pushed_text "ok";
                                                    set out get pushed_text "items";
                                                    if:
                                                        pushed_text_ok
                                                        then ()
                                                        else set failed true
                                                else ()

                                            if:
                                                not failed
                                                then:
                                                    let base <str> str_slice s add i 1 slash;
                                                    let rub <str> str_slice s add slash 1 j;
                                                    let r <RubyInfo> RubyInfo base rub;
                                                    let pushed_ruby <InlinePushRes> nm_push_inline out Inline::Ruby r;
                                                    let pushed_ruby_ok <bool> get pushed_ruby "ok";
                                                    set out get pushed_ruby "items";
                                                    if:
                                                        pushed_ruby_ok
                                                        then:
                                                            set i add j 1;
                                                            set text_start i;
                                                            ()
                                                        else:
                                                            set failed true;
                                                            ()
                                                else ()
                                else:
                                    set i add i 1;
                                    ()
                        else:
                            // Gloss: {main/sub1/sub2...} (split '/' at top level, ignoring inside [...])
                            if:
                                eq ch 123
                                then:
                                    let mut j <i32> add i 1;
                                    let mut closed <bool> false;
                                    while and lt j n not closed:
                                        do:
                                            let cj <i32> string_byte_at_unchecked s j;
                                            if:
                                                eq cj 125
                                                then set closed true
                                                else set j add j 1
                                    if:
                                        closed
                                        then:
                                            // Flush pending text
                                            let seg <str> str_slice s text_start i;
                                            if:
                                                gt len seg 0
                                                then:
                                                    let pushed_text <InlinePushRes> nm_push_inline out Inline::Text seg;
                                                    let pushed_text_ok <bool> get pushed_text "ok";
                                                    set out get pushed_text "items";
                                                    if:
                                                        pushed_text_ok
                                                        then ()
                                                        else set failed true
                                                else ()

                                            // Collect parts
                                            let mut parts <Vec<str>> nm_str_empty_vec;
                                            match v::new<str>:
                                                Result::Ok parts0:
                                                    set parts parts0
                                                Result::Err _e:
                                                    set failed true;
                                            let mut k <i32> add i 1;
                                            let mut start <i32> k;
                                            let mut depth <i32> 0;

                                            while and lt k j not failed:
                                                do:
                                                    let ck <i32> string_byte_at_unchecked s k;
                                                    if:
                                                        eq ck 91
                                                        then set depth add depth 1
                                                        else:
                                                            if:
                                                                and eq ck 93 gt depth 0
                                                                then set depth sub depth 1
                                                                else ()
                                                    if:
                                                        and eq ck 47 eq depth 0
                                                        then:
                                                            let p <str> str_slice s start k;
                                                            let pushed_part <StrPushRes> nm_push_str parts p;
                                                            let pushed_part_ok <bool> get pushed_part "ok";
                                                            set parts get pushed_part "items";
                                                            if:
                                                                pushed_part_ok
                                                                then:
                                                                    set start add k 1;
                                                                    set k add k 1;
                                                                    ()
                                                                else:
                                                                    set failed true;
                                                                    ()
                                                        else:
                                                            set k add k 1;
                                                            ()
                                            if:
                                                not failed
                                                then:
                                                    let plast <str> str_slice s start j;
                                                    let pushed_last_part <StrPushRes> nm_push_str parts plast;
                                                    let pushed_last_part_ok <bool> get pushed_last_part "ok";
                                                    set parts get pushed_last_part "items";
                                                    if:
                                                        pushed_last_part_ok
                                                        then ()
                                                        else set failed true
                                                else ()

                                            let parts_span <VecDataLen<str>> v::data_len<str> parts;
                                            let parts_len <i32> get parts_span "len";
                                            if:
                                                and not failed ge parts_len 2
                                                then:
                                                    let parts_data <i32> mem_ptr_addr get parts_span "data";
                                                    let main <str> load<str> parts_data;
                                                    let mut subs <Vec<str>> nm_str_empty_vec;
                                                    match v::new<str>:
                                                        Result::Ok subs0:
                                                            set subs subs0
                                                        Result::Err _e:
                                                            set failed true;
                                                    let mut idx <i32> 1;
                                                    while and lt idx parts_len not failed:
                                                        do:
                                                            let p <str> load<str> add parts_data mul idx size_of<str>;
                                                            let pushed_sub <StrPushRes> nm_push_str subs p;
                                                            let pushed_sub_ok <bool> get pushed_sub "ok";
                                                            set subs get pushed_sub "items";
                                                            if:
                                                                pushed_sub_ok
                                                                then set idx add idx 1
                                                                else set failed true
                                                    if:
                                                        not failed
                                                        then:
                                                            let g <GlossInfo> GlossInfo main subs;
                                                            let pushed_gloss <InlinePushRes> nm_push_inline out Inline::Gloss g;
                                                            let pushed_gloss_ok <bool> get pushed_gloss "ok";
                                                            set out get pushed_gloss "items";
                                                            if:
                                                                pushed_gloss_ok
                                                                then:
                                                                    set i add j 1;
                                                                    set text_start i;
                                                                    ()
                                                                else:
                                                                    set failed true;
                                                                    ()
                                                        else ()
                                                else:
                                                    // Not actually gloss -> keep as text
                                                    set i add i 1;
                                                    ()
                                        else:
                                            set i add i 1;
                                            ()
                                else:
                                    set i add i 1;
                                    ()

    // Flush tail text
    let tail <str> str_slice s text_start n;
    if:
        and not failed gt len tail 0
        then:
            let pushed_tail <InlinePushRes> nm_push_inline out Inline::Text tail;
            get pushed_tail "items"
        else out

// -----------------------------
// Main block parser + Nest builder
// -----------------------------

//: parse_markdown: 拡張 Markdown 文字列を `Document` AST に変換する
//:
//: [目的/もくてき]:
//: - 見出し Nest / 段落 / 水平線 / コードフェンスを解析し、後段処理で使える AST を生成します。
//: - nm 系 API の入口として、HTML 変換・JSON 変換の双方から利用します。
//:
//: [実装/じっそう]:
//: - 行単位で走査し、section stack で入れ子構造を管理します。
//: - 行内要素（ruby/gloss/math）は `parse_inlines` に委譲します。
//:
//: [注意/ちゅうい]:
//: - 現状は `Result` ではなく AST を直接返す設計です。診断回復は今後の拡張対象です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)（n は入力サイズ）。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser" as *
//: fn main <()*>i32> ():
//:     let d <Document> parse_markdown "# T\n\nx\n";
//:     let j <str> document_to_json d;
//:     if and str_starts_with j "{\"t\":\"doc\"" gt len j 0 0 1
//: ```
pub fn parse_markdown <(str)->Document> (input):
    let lines <Vec<str>> str_split input "\n";
    let lines_mem <i32> alloc_raw size_of<Vec<str>>;
    store<Vec<str>> lines_mem lines;
    let nlines <i32> get load<Vec<str>> lines_mem "len";

    let mut root <Vec<Node>> nm_node_empty_vec;
    let mut failed <bool> false;
    match v::new<Node>:
        Result::Ok root0:
            set root root0
        Result::Err _e:
            set failed true;
    let mut i <i32> 0;

    while and lt i nlines not failed:
        do:
            let line <str> safe_line lines_mem i;
            let t <str> str_trim line;

            if:
                eq len t 0
                then set i add i 1
                else:
                    if:
                        is_nest_break_line t
                        then:
                            set i add i 1;
                            ()
                        else:
                            if:
                                is_hr_line t
                                then:
                                    let pushed_root <NodePushRes> nm_push_node root Node::Hr;
                                    let pushed_root_ok <bool> get pushed_root "ok";
                                    set root get pushed_root "items";
                                    if:
                                        pushed_root_ok
                                        then:
                                            set i add i 1;
                                            ()
                                        else:
                                            set failed true;
                                            ()
                                else:
                                    if:
                                        is_fence_start t
                                        then:
                                            let fr <FenceRes> parse_fence lines_mem nlines i;
                                            let fr_next_i <i32> get fr "next_i";
                                            let fr_cb <CodeBlockInfo> get fr "cb";
                                            let node <Node> Node::CodeBlock fr_cb;
                                            let pushed_root <NodePushRes> nm_push_node root node;
                                            let pushed_root_ok <bool> get pushed_root "ok";
                                            set root get pushed_root "items";
                                            if:
                                                pushed_root_ok
                                                then:
                                                    set i fr_next_i;
                                                    ()
                                                else:
                                                    set failed true;
                                                    ()
                                        else:
                                            match parse_heading t:
                                                Option::Some h:
                                                    let mut kids <Vec<Node>> nm_node_empty_vec;
                                                    match v::new<Node>:
                                                        Result::Ok kids0:
                                                            set kids kids0
                                                        Result::Err _e:
                                                            set failed true;
                                                    let mut j <i32> add i 1;
                                                    let mut done <bool> false;
                                                    while and not done not failed:
                                                        do:
                                                            if:
                                                                ge j nlines
                                                                then:
                                                                    set done true;
                                                                    ()
                                                                else:
                                                                    let li <str> safe_line lines_mem j;
                                                                    let tj <str> str_trim li;
                                                                    if:
                                                                        eq len tj 0
                                                                        then:
                                                                            set j add j 1;
                                                                            ()
                                                                        else:
                                                                            if:
                                                                                or is_heading_start tj or is_nest_break_line tj or is_hr_line tj is_fence_start tj
                                                                                then:
                                                                                    set done true;
                                                                                    ()
                                                                                else:
                                                                                    let pr <ParaRes> parse_paragraph lines_mem nlines j;
                                                                                    let pr_mem <i32> alloc_raw size_of<ParaRes>;
                                                                                    store<ParaRes> pr_mem pr;
                                                                                    let pr_inlines <Vec<Inline>> get load<ParaRes> pr_mem "inlines";
                                                                                    let pr_next_i <i32> get load<ParaRes> pr_mem "next_i";
                                                                                    let pushed_kids <NodePushRes> nm_push_node kids Node::Paragraph pr_inlines;
                                                                                    let pushed_kids_ok <bool> get pushed_kids "ok";
                                                                                    set kids get pushed_kids "items";
                                                                                    if:
                                                                                        pushed_kids_ok
                                                                                        then:
                                                                                            set j pr_next_i;
                                                                                            ()
                                                                                        else:
                                                                                            set failed true;
                                                                                            ()
                                                    let sec <NestSection> NestSection get h "level" h kids;
                                                    if:
                                                        not failed
                                                        then:
                                                            let pushed_root <NodePushRes> nm_push_node root Node::Section sec;
                                                            let pushed_root_ok <bool> get pushed_root "ok";
                                                            set root get pushed_root "items";
                                                            if:
                                                                pushed_root_ok
                                                                then:
                                                                    set i j;
                                                                    ()
                                                                else:
                                                                    set failed true;
                                                                    ()
                                                        else ()
                                                Option::None:
                                                    // Paragraph
                                                    let pr <ParaRes> parse_paragraph lines_mem nlines i;
                                                    let pr_mem <i32> alloc_raw size_of<ParaRes>;
                                                    store<ParaRes> pr_mem pr;
                                                    let pr_inlines <Vec<Inline>> get load<ParaRes> pr_mem "inlines";
                                                    let pr_next_i <i32> get load<ParaRes> pr_mem "next_i";
                                                    let pnode <Node> Node::Paragraph pr_inlines;
                                                    let pushed_root <NodePushRes> nm_push_node root pnode;
                                                    let pushed_root_ok <bool> get pushed_root "ok";
                                                    set root get pushed_root "items";
                                                    if:
                                                        pushed_root_ok
                                                        then:
                                                            set i pr_next_i;
                                                            ()
                                                        else:
                                                            set failed true;
                                                            ()

    Document root

// -----------------------------
// AST -> JSON (simple)
// -----------------------------

//: json_escape: 主な用途
//:
//: [目的/もくてき]:
//: - json_escape の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn json_escape <(str)->str> (s):
    let mut sb <StringBuilder> string_builder_new;
    let n <i32> len s;
    let mut i <i32> 0;
    while lt i n:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            match nm_json_escape_kind ch:
                NmJsonEscapeKind::Backslash:
                    set sb sb_append sb "\\\\"
                NmJsonEscapeKind::Quote:
                    set sb sb_append sb "\\\""
                NmJsonEscapeKind::Newline:
                    set sb sb_append sb "\\n"
                NmJsonEscapeKind::CarriageReturn:
                    set sb sb_append sb "\\r"
                NmJsonEscapeKind::Tab:
                    set sb sb_append sb "\\t"
                NmJsonEscapeKind::Backspace:
                    set sb sb_append sb "\\b"
                NmJsonEscapeKind::FormFeed:
                    set sb sb_append sb "\\f"
                NmJsonEscapeKind::Plain:
                    set sb sb_append sb str_slice s i add i 1;
            set i add i 1;
    sb_build sb

//: inlines_to_json: 主な用途
//:
//: [目的/もくてき]:
//: - inlines_to_json の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn inlines_to_json <(Vec<Inline>)->str> (v):
    let mut sb <StringBuilder> string_builder_new;
    set sb sb_append sb "[";
    let span <VecDataLen<Inline>> v::data_len<Inline> v;
    let n <i32> get span "len";
    let v_data <i32> mem_ptr_addr get span "data";
    let mut i <i32> 0;
    while lt i n:
        do:
            if:
                gt i 0
                then set sb sb_append sb ","
                else ()
            let it <Inline> load<Inline> add v_data mul i size_of<Inline>;
            match it:
                Inline::Text s:
                    set sb sb_append sb "{\"t\":\"text\",\"s\":\"";
                    set sb sb_append sb json_escape s;
                    set sb sb_append sb "\"}";
                Inline::Math m:
                    set sb sb_append sb "{\"t\":\"math\",\"s\":\"";
                    set sb sb_append sb json_escape m;
                    set sb sb_append sb "\"}";
                Inline::Ruby r:
                    set sb sb_append sb "{\"t\":\"ruby\",\"base\":\"";
                    set sb sb_append sb json_escape get r "base";
                    set sb sb_append sb "\",\"ruby\":\"";
                    set sb sb_append sb json_escape get r "ruby";
                    set sb sb_append sb "\"}";
                Inline::Gloss g:
                    set sb sb_append sb "{\"t\":\"gloss\",\"main\":\"";
                    set sb sb_append sb json_escape get g "main";
                    set sb sb_append sb "\",\"subs\":[";
                    let subs <Vec<str>> get g "subs";
                    let subs_span <VecDataLen<str>> v::data_len<str> subs;
                    let m <i32> get subs_span "len";
                    let subs_data <i32> mem_ptr_addr get subs_span "data";
                    let mut j <i32> 0;
                    while lt j m:
                        do:
                            if:
                                gt j 0
                                then set sb sb_append sb ","
                                else ()
                            let ss <str> load<str> add subs_data mul j size_of<str>;
                            set sb sb_append sb "\"";
                            set sb sb_append sb json_escape ss;
                            set sb sb_append sb "\"";
                            set j add j 1;
                    set sb sb_append sb "]}";
            set i add i 1;
    set sb sb_append sb "]";
    sb_build sb

//: node_to_json: 主な用途
//:
//: [目的/もくてき]:
//: - node_to_json の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn node_to_json <(Node)->str> (node):
    let mut sb <StringBuilder> string_builder_new;
    match node:
        Node::Hr:
            sb_build sb_append sb "{\"t\":\"hr\"}"
        Node::CodeBlock cb:
            let cb_info <str> get cb "info";
            let cb_code <str> get cb "code";
            set sb sb_append sb "{\"t\":\"code\",\"info\":\"";
            set sb sb_append sb json_escape cb_info;
            set sb sb_append sb "\",\"code\":\"";
            set sb sb_append sb json_escape cb_code;
            set sb sb_append sb "\"}";
            sb_build sb
        Node::Paragraph inl:
            set sb sb_append sb "{\"t\":\"p\",\"inl\":";
            set sb sb_append sb inlines_to_json inl;
            set sb sb_append sb "}";
            sb_build sb
        Node::Section sec:
            let sec_mem <i32> alloc_raw size_of<NestSection>;
            store<NestSection> sec_mem sec;
            let sec_level <i32> get load<NestSection> sec_mem "level";
            let sec_heading <Heading> get load<NestSection> sec_mem "heading";
            let sec_children <Vec<Node>> get load<NestSection> sec_mem "children";
            let heading_mem <i32> alloc_raw size_of<Heading>;
            store<Heading> heading_mem sec_heading;
            let heading_level <i32> get load<Heading> heading_mem "level";
            let heading_inlines <Vec<Inline>> get load<Heading> heading_mem "inlines";
            set sb sb_append sb "{\"t\":\"section\",\"level\":";
            set sb sb_append_i32 sb sec_level;
            set sb sb_append sb ",\"heading\":";
            set sb sb_append sb "{\"level\":";
            set sb sb_append_i32 sb heading_level;
            set sb sb_append sb ",\"inl\":";
            set sb sb_append sb inlines_to_json heading_inlines;
            set sb sb_append sb "}";
            set sb sb_append sb ",\"children\":";
            set sb sb_append sb nodes_to_json sec_children;
            set sb sb_append sb "}";
            sb_build sb

//: nodes_to_json: 主な用途
//:
//: [目的/もくてき]:
//: - nodes_to_json の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn nodes_to_json <(Vec<Node>)->str> (nodes):
    let mut sb <StringBuilder> string_builder_new;
    set sb sb_append sb "[";
    let nodes_span <VecDataLen<Node>> v::data_len<Node> nodes;
    let n <i32> get nodes_span "len";
    let nodes_data <i32> mem_ptr_addr get nodes_span "data";
    let mut i <i32> 0;
    while lt i n:
        do:
            if:
                gt i 0
                then set sb sb_append sb ","
                else ()
            let nd <Node> load<Node> add nodes_data mul i size_of<Node>;
            set sb sb_append sb node_to_json nd;
            set i add i 1;
    set sb sb_append sb "]";
    sb_build sb

//: document_to_json: `Document` AST を JSON 文字列へ変換する
//:
//: [目的/もくてき]:
//: - AST の内部構造を機械可読な JSON に変換して、デバッグ・テスト・CLI 出力に利用します。
//:
//: [実装/じっそう]:
//: - ノード種別を `t` フィールドで表現し、子要素は再帰的にシリアライズします。
//: - 文字列は `json_escape` で JSON 文字列用の代表的なエスケープを適用します。
//:
//: [注意/ちゅうい]:
//: - JSON スキーマは開発中であり、将来変更される可能性があります。
//:
//: [計算量/けいさんりょう]:
//: - O(m)（m は出力 JSON バイト数）。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser" as *
//: fn main <()*>i32> ():
//:     let d <Document> parse_markdown "plain\n";
//:     let j <str> document_to_json d;
//:     if str_starts_with j "{\"t\":\"doc\"" 0 1
//: ```
pub fn document_to_json <(Document)->str> (doc):
    let mut sb <StringBuilder> string_builder_new;
    set sb sb_append sb "{\"t\":\"doc\",\"nodes\":";
    set sb sb_append sb nodes_to_json get doc "nodes";
    set sb sb_append sb "}";
    sb_build sb
