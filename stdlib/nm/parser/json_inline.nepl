//: nm/parser/json_inline: NM inline markup の JSON serializer
//:
//: [目的/もくてき]:
//: - 1 行分の inline markup を JSON inline array へ直接変換します。
//: - `parser.nepl` の block serializer から ruby / gloss / math / text marker dispatch を分離します。
//:
//: [実装/じっそう]:
//: - pending text を marker の直前で flush し、ruby/gloss/math を JSON object として追加します。
//: - inline AST raw storage は作らず、`StringBuilder` へ直接出力します。
//: - gloss の sub list は slash delimiter を scanner helper で探しながら逐次 JSON string として出力します。
//:
//: [注意/ちゅうい]:
//: - 閉じていない marker は通常 text として扱い、部分的な JSON object は生成しません。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser/json_inline" as *
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     let j %str nm_inline_to_json "a [b/r] $x$"
//:     if and str_starts_with j "[{\"t\":\"text\"" gt len j 0 0 1
//: ```

#indent 4

#import "alloc/string" as *
#import "alloc/string/byte_index" as *
#import "alloc/string/scanner" as scanner
#import "core/math" as *
#import "core/option" as *
#import "../json_escape" as json
#import "./scanner" as scan

fn nm_json_inline_byte_or_end %fn str fn i32 i32 \s\idx:
    match checked_string_byte_at s idx:
        Option::Some b:
            b
        Option::None:
            -1

//: nm_json_comma_if_needed: 既存要素がある場合だけ comma を追加する
//:
//: [目的/もくてき]:
//: - inline JSON array の要素追加前に必要な `,` を一箇所で扱います。
//: - marker ごとの serializer が comma 条件を重複して持たないようにします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_json_comma_if_needed %fn StringBuilder fn bool StringBuilder \sb\has:
    if has then sb_append sb "," else sb

//: nm_json_append_text_range: 指定範囲の text node を必要なら追加する
//:
//: [目的/もくてき]:
//: - marker の直前までに溜まった通常 text を JSON text object として追加します。
//: - 空範囲では builder をそのまま返し、呼び出し側の `has` 更新と対応させます。
//:
//: [計算量/けいさんりょう]:
//: - 追加する text の長さを k として O(k)
fn nm_json_append_text_range %fn StringBuilder fn str fn i32 fn i32 fn bool StringBuilder \sb\s\start\end\has:
    let seg %str str_slice s start end;
    if:
        gt len seg 0
        then:
            let mut out %StringBuilder nm_json_comma_if_needed sb has;
            set out sb_append out "{\"t\":\"text\",\"s\":\"";
            set out json::json_escape_into out seg;
            sb_append out "\"}"
        else:
            sb

//: nm_json_append_math_range: math node を追加する
//:
//: [目的/もくてき]:
//: - `$...$` / `$$...$$` の範囲を delimiter ごと JSON math object として追加します。
//:
//: [計算量/けいさんりょう]:
//: - math 範囲の長さを k として O(k)
fn nm_json_append_math_range %fn StringBuilder fn str fn i32 fn i32 fn bool StringBuilder \sb\s\start\end\has:
    let m %str str_slice s start end;
    let mut out %StringBuilder nm_json_comma_if_needed sb has;
    set out sb_append out "{\"t\":\"math\",\"s\":\"";
    set out json::json_escape_into out m;
    sb_append out "\"}"

//: nm_json_append_ruby_range: ruby node を追加する
//:
//: [目的/もくてき]:
//: - `[base/ruby]` marker を JSON ruby object として追加します。
//:
//: [計算量/けいさんりょう]:
//: - base と ruby の合計長を k として O(k)
fn nm_json_append_ruby_range %fn StringBuilder fn str fn i32 fn i32 fn i32 fn bool StringBuilder \sb\s\start\slash\close\has:
    let base %str str_slice s add start 1 slash;
    let rub %str str_slice s add slash 1 close;
    let mut out %StringBuilder nm_json_comma_if_needed sb has;
    set out sb_append out "{\"t\":\"ruby\",\"base\":\"";
    set out json::json_escape_into out base;
    set out sb_append out "\",\"ruby\":\"";
    set out json::json_escape_into out rub;
    sb_append out "\"}"

//: nm_json_append_gloss_range: gloss node を追加する
//:
//: [目的/もくてき]:
//: - `{main/sub...}` marker を JSON gloss object として追加します。
//: - sub list の slash 走査を inline dispatch loop から分離し、本文側の状態を小さく保ちます。
//:
//: [計算量/けいさんりょう]:
//: - gloss 範囲の長さを k として O(k)
fn nm_json_append_gloss_range %fn StringBuilder fn str fn i32 fn i32 fn i32 fn bool StringBuilder \sb\s\start\first_slash\close\has:
    let main %str str_slice s add start 1 first_slash;
    let mut out %StringBuilder nm_json_comma_if_needed sb has;
    set out sb_append out "{\"t\":\"gloss\",\"main\":\"";
    set out json::json_escape_into out main;
    set out sb_append out "\",\"subs\":[";
    let mut sub_start %i32 add first_slash 1;
    let mut k %i32 sub_start;
    let mut sub_has %bool false;
    while lt k close:
        do:
            let next_slash %i32 scan::nm_find_gloss_slash s k close;
            let part_end %i32:
                if:
                    ge next_slash 0
                    then next_slash
                    else close
            let part %str str_slice s sub_start part_end;
            if sub_has then set out sb_append out "," else unit;
            set out sb_append out "\"";
            set out json::json_escape_into out part;
            set out sb_append out "\"";
            set sub_has true;
            if:
                ge next_slash 0
                then:
                    set sub_start add next_slash 1;
                    set k sub_start
                else:
                    set k close
    sb_append out "]}"

//: nm_inline_to_json_into: inline markup を JSON array として builder へ追加する
//:
//: [目的/もくてき]:
//: - 1 行分の inline markup を `[{...}]` 形式の JSON array として既存 builder へ追加します。
//:
//: [実装/じっそう]:
//: - pending text を marker の直前で flush し、ruby/gloss/math を object として追加します。
//: - raw storage に inline AST を置かず、返却用の一時 `str` も作らないため、Resource IR の owner 境界が明確です。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
pub fn nm_inline_to_json_into %fn StringBuilder fn str StringBuilder \out\s:
    let mut sb %StringBuilder out;
    set sb sb_append sb "[";
    let n %i32 len s;
    let mut i %i32 0;
    let mut text_start %i32 0;
    let mut has %bool false;
    while lt i n:
        do:
            let ch %i32 nm_json_inline_byte_or_end s i;
            match ch:
                '$':
                    let mut delim %i32 1;
                    if:
                        and lt add i 1 n string_byte_eq s add i 1 '$'
                        then set delim 2
                        else unit
                    let math_end %i32 scan::nm_find_math_end s add i delim delim;
                    if:
                        ge math_end 0
                        then:
                            let had_text %bool gt len str_slice s text_start i 0;
                            set sb nm_json_append_text_range sb s text_start i has;
                            if had_text then set has true else unit;
                            let endpos %i32 add math_end delim;
                            set sb nm_json_append_math_range sb s i endpos has;
                            set has true;
                            set i endpos;
                            set text_start endpos
                        else:
                            set i add i 1
                '[':
                    let close %i32 scanner::str_find_byte_range s add i 1 n ']';
                    let slash %i32:
                        if:
                            ge close 0
                            then scanner::str_find_byte_range s add i 1 close '/'
                            else -1
                    let mut next_is_paren %bool false;
                    if:
                        and ge close 0 lt add close 1 n
                        then set next_is_paren string_byte_eq s add close 1 '('
                        else unit
                    if:
                        and ge close 0 and ge slash 0 not next_is_paren
                        then:
                            let had_text %bool gt len str_slice s text_start i 0;
                            set sb nm_json_append_text_range sb s text_start i has;
                            if had_text then set has true else unit;
                            set sb nm_json_append_ruby_range sb s i slash close has;
                            set has true;
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                '{':
                    let close %i32 scanner::str_find_byte_range s add i 1 n '}';
                    let first_slash %i32:
                        if:
                            ge close 0
                            then scan::nm_find_gloss_slash s add i 1 close
                            else -1
                    if:
                        and ge close 0 ge first_slash 0
                        then:
                            let had_text %bool gt len str_slice s text_start i 0;
                            set sb nm_json_append_text_range sb s text_start i has;
                            if had_text then set has true else unit;
                            set sb nm_json_append_gloss_range sb s i first_slash close has;
                            set has true;
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                _:
                    set i add i 1
    set sb nm_json_append_text_range sb s text_start n has;
    set sb sb_append sb "]";
    sb

//: nm_inline_to_json: inline markup を JSON array に変換する
//:
//: [目的/もくてき]:
//: - 1 行分の inline markup を `[{...}]` 形式の JSON array へ変換します。
//:
//: [実装/じっそう]:
//: - 実処理は `nm_inline_to_json_into` に委譲し、単独 API として必要なときだけ最後に `str` を構築します。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
pub fn nm_inline_to_json %fn str str \s:
    sb_build nm_inline_to_json_into string_builder_new s
