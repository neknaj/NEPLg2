//: nm/parser/scanner: NM parser の line / delimiter scanner helper
//:
//: [目的/もくてき]:
//: - `nm/parser` 本体から、行分類・heading 判定・inline delimiter 探索を分離します。
//: - block / inline JSON serializer は構造の出力に集中し、byte scan の境界条件はこの module でレビューできるようにします。
//:
//: [実装/じっそう]:
//: - 入力は `str` と byte index で扱い、ASCII marker を checked byte API で判定します。
//: - heading level や delimiter のような有限条件は小さい helper に分け、呼び出し側へ magic offset を広げません。
//:
//: [注意/ちゅうい]:
//: - index は byte index です。Unicode scalar index ではありません。
//: - NM の marker は ASCII byte として扱います。UTF-8 境界は `alloc/string` の slice API に従います。
//:
//: [計算量/けいさんりょう]:
//: - line / heading helper は O(line_length) 以下、delimiter 探索は対象 range 長に対して O(n) です。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser/scanner" as *
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     let ok_heading %bool eq nm_heading_level "### title" 3
//:     let ok_hr %bool is_hr "---"
//:     let ok_math %bool eq nm_find_math_end "a $x$ z" 3 1 4
//:     if and ok_heading and ok_hr ok_math 0 1
//: ```

#indent 4

#import "alloc/string" as *
#import "alloc/string/byte_index" as *
#import "alloc/string/scanner" as strscan
#import "core/math" as *
#import "core/option" as *

fn nm_scanner_byte_or_end %fn str fn i32 i32 \s\idx:
    match checked_string_byte_at s idx:
        Option::Some b:
            b
        Option::None:
            -1

//: nm_read_line: 入力から 1 行を切り出す
//:
//: [目的/もくてき]:
//: - byte index `pos` から LF までを切り出し、末尾 CR を取り除きます。
//:
//: [実装/じっそう]:
//: - 行末探索は `alloc/string/scanner::str_line_end` に委譲し、この wrapper は NM parser の CRLF 正規化だけを担当します。
//:
//: [計算量/けいさんりょう]:
//: - O(line_length)
pub fn nm_read_line %fn str fn i32 str \s\pos:
    str_slice_trim_suffix_cr s pos strscan::str_line_end s pos

//: nm_heading_level: ATX heading の level を判定する
//:
//: [目的/もくてき]:
//: - `# ` から `###### ` までを 1..6 として返し、それ以外は 0 を返します。
//:
//: [実装/じっそう]:
//: - 先頭の `#` 個数を数え、直後が空白である場合だけ heading とします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。最大 6 byte だけを確認します。
pub fn nm_heading_level %fn str i32 \line:
    let n %i32 len line;
    let mut i %i32 0;
    while and lt i n and lt i 6 string_byte_eq line i '#':
        do:
            set i add i 1
    if:
        and gt i 0 lt i n
        then:
            if:
                string_byte_eq line i ' '
                then i
                else 0
        else:
            0

//: nm_heading_text: heading marker の後ろの text を返す
//:
//: [目的/もくてき]:
//: - `level` 個の `#` と続く空白を除いた heading 本文を取り出します。
//:
//: [計算量/けいさんりょう]:
//: - O(text_length)
pub fn nm_heading_text %fn str fn i32 str \line\level:
    str_trim str_slice line add level 1 len line

//: is_fence_start: fenced code block 開始行を判定する
//:
//: [目的/もくてき]:
//: - trim 済み行が triple backtick で始まるか判定します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn is_fence_start %fn str bool \line:
    str_starts_with line "```"

//: is_hr: horizontal rule 行を判定する
//:
//: [目的/もくてき]:
//: - Nest では `---` を水平線かつ 1 段 close として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn is_hr %fn str bool \line:
    str_eq line "---"

//: is_section_break: section break 行を判定する
//:
//: [目的/もくてき]:
//: - `;;;` を表示なしの 1 段 close として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn is_section_break %fn str bool \line:
    str_eq line ";;;"

//: nm_is_block_boundary: paragraph を止める行か判定する
//:
//: [目的/もくてき]:
//: - paragraph lookahead で、空行・heading・fence・horizontal rule・section break を境界として検出します。
//:
//: [計算量/けいさんりょう]:
//: - O(line_length)
pub fn nm_is_block_boundary %fn str bool \trimmed:
    if:
        eq len trimmed 0
        then true
        else:
            if:
                gt nm_heading_level trimmed 0
                then true
                else:
                    if:
                        is_fence_start trimmed
                        then true
                        else:
                            if:
                                is_hr trimmed
                                then true
                                else is_section_break trimmed

//: nm_deepest_level: open section の最深 level を返す
//:
//: [目的/もくてき]:
//: - 最大 6 段の heading stack を Copy bool だけで管理するため、現在の最深 section を計算します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn nm_deepest_level %fn bool fn bool fn bool fn bool fn bool fn bool i32 \open1\open2\open3\open4\open5\open6:
    if:
        open6
        then 6
        else:
            if:
                open5
                then 5
                else:
                    if:
                        open4
                        then 4
                        else:
                            if:
                                open3
                                then 3
                                else:
                                    if:
                                        open2
                                        then 2
                                        else:
                                            if:
                                                open1
                                                then 1
                                                else 0

//: nm_find_math_end: math delimiter の閉じ位置を探す
//:
//: [目的/もくてき]:
//: - `$...$` と `$$...$$` の閉じ delimiter 開始位置を返します。見つからなければ -1 です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn nm_find_math_end %fn str fn i32 fn i32 i32 \s\start\delim:
    let n %i32 len s;
    let mut j %i32 start;
    let mut found %i32 -1;
    while and lt j n lt found 0:
        do:
            let c0 %i32 nm_scanner_byte_or_end s j;
            if:
                eq delim 1
                then:
                    if:
                        eq c0 '$'
                        then set found j
                        else set j add j 1
                else:
                    if:
                        and eq c0 '$' lt add j 1 n
                        then:
                            let c1 %i32 nm_scanner_byte_or_end s add j 1;
                            if:
                                eq c1 '$'
                                then set found j
                                else set j add j 1
                        else:
                            set j add j 1
    found

//: nm_find_gloss_slash: gloss body の top-level slash を探す
//:
//: [目的/もくてき]:
//: - `{main/sub}` の `/` を探します。`[base/ruby]` 内の slash は無視します。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
pub fn nm_find_gloss_slash %fn str fn i32 fn i32 i32 \s\start\end:
    let mut i %i32 start;
    let mut depth %i32 0;
    let mut found %i32 -1;
    while and lt i end lt found 0:
        do:
            let ch %i32 nm_scanner_byte_or_end s i;
            match ch:
                '[':
                    set depth add depth 1
                ']':
                    if:
                        gt depth 0
                        then set depth sub depth 1
                        else unit
                '/':
                    if:
                        eq depth 0
                        then set found i
                        else unit
                _:
                    unit
            set i add i 1;
    found
