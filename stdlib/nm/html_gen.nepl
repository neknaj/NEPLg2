//: nm/html_gen: Gloss/Nest Markdown の HTML serializer
//:
//: [目的/もくてき]:
//: - `nm/parser` の `Document` source view を HTML へ変換します。
//:
//: [実装/じっそう]:
//: - parser と同じく source を direct に再走査し、`Vec<Node>` / `Vec<Inline>` の non-Copy AST raw storage を作りません。
//: - section stack は最大 heading level 6 の Copy state で管理し、HTML tag は close 時に直接出力します。
//:
//: [注意/ちゅうい]:
//: - 生成 HTML は最小限の escape を行います。属性値・text の両方で `escape_html` を通します。
//:
//: [計算量/けいさんりょう]:
//: - `render_document` は入力 size と出力 size に対して O(n + m) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "alloc/string" as *
#import "alloc/string/scanner" as scanner
#import "core/math" as *

#import "./html_escape" as html
#import "./parser" as *
#import "./parser/scanner" as scan

//: HtmlHeadingKind: HTML heading tag の分類
//:
//: [目的/もくてき]:
//: - NM heading level を HTML の h1 から h6 に対応させます。
//:
//: [注意/ちゅうい]:
//: - 範囲外 level は h6 として扱います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
enum HtmlHeadingKind:
    H1
    H2
    H3
    H4
    H5
    H6

fn html_heading_kind <(i32)->HtmlHeadingKind> (level):
    match level:
        1:
            HtmlHeadingKind::H1
        2:
            HtmlHeadingKind::H2
        3:
            HtmlHeadingKind::H3
        4:
            HtmlHeadingKind::H4
        5:
            HtmlHeadingKind::H5
        _:
            HtmlHeadingKind::H6

//: nm_append_heading_open: heading 開始 tag を追加する
//:
//: [目的/もくてき]:
//: - level に応じた `<h1>` から `<h6>` を builder へ追加します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_append_heading_open <(StringBuilder,i32)->StringBuilder> (sb, level):
    match html_heading_kind level:
        HtmlHeadingKind::H1:
            sb_append sb "<h1>"
        HtmlHeadingKind::H2:
            sb_append sb "<h2>"
        HtmlHeadingKind::H3:
            sb_append sb "<h3>"
        HtmlHeadingKind::H4:
            sb_append sb "<h4>"
        HtmlHeadingKind::H5:
            sb_append sb "<h5>"
        HtmlHeadingKind::H6:
            sb_append sb "<h6>"

//: nm_append_heading_close: heading 終了 tag を追加する
//:
//: [目的/もくてき]:
//: - level に応じた `</h1>` から `</h6>` を builder へ追加します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn nm_append_heading_close <(StringBuilder,i32)->StringBuilder> (sb, level):
    match html_heading_kind level:
        HtmlHeadingKind::H1:
            sb_append sb "</h1>"
        HtmlHeadingKind::H2:
            sb_append sb "</h2>"
        HtmlHeadingKind::H3:
            sb_append sb "</h3>"
        HtmlHeadingKind::H4:
            sb_append sb "</h4>"
        HtmlHeadingKind::H5:
            sb_append sb "</h5>"
        HtmlHeadingKind::H6:
            sb_append sb "</h6>"

//: nm_inline_to_html: inline markup を HTML fragment に変換する
//:
//: [目的/もくてき]:
//: - 1 行分の inline markup を HTML fragment へ直接変換します。
//: - ruby `[base/ruby]`、gloss `{main/sub...}`、inline math `$...$` / `$$...$$` を HTML へ写します。
//:
//: [実装/じっそう]:
//: - pending text を marker の直前で flush し、ruby/gloss/math を直接 HTML として追加します。
//: - gloss の main/sub は再帰的に inline 変換し、ruby を内側でも使えるようにします。
//:
//: [注意/ちゅうい]:
//: - math segment は元の delimiter を含めて通します。数式 renderer への semantic validation はここでは行いません。
//: - marker が閉じていない場合は通常 text として扱い、部分的な HTML tag は生成しません。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
fn nm_inline_to_html <(str)->str> (s):
    let mut sb <StringBuilder> string_builder_new;
    let n <i32> len s;
    let mut i <i32> 0;
    let mut text_start <i32> 0;
    while lt i n:
        do:
            let ch <i32> string_byte_at_unchecked s i;
            match ch:
                '$':
                    let mut delim <i32> 1;
                    if:
                        and lt add i 1 n eq string_byte_at_unchecked s add i 1 '$'
                        then set delim 2
                        else ()
                    let math_end <i32> scan::nm_find_math_end s add i delim delim;
                    if:
                        ge math_end 0
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then set sb sb_append sb html::escape_html seg
                                else ()
                            let endpos <i32> add math_end delim;
                            set sb sb_append sb str_slice s i endpos;
                            set i endpos;
                            set text_start endpos
                        else:
                            set i add i 1
                '[':
                    let close <i32> scanner::str_find_byte_range s add i 1 n ']';
                    let slash <i32>:
                        if:
                            ge close 0
                            then scanner::str_find_byte_range s add i 1 close '/'
                            else -1
                    let mut next_is_paren <bool> false;
                    if:
                        and ge close 0 lt add close 1 n
                        then set next_is_paren eq string_byte_at_unchecked s add close 1 '('
                        else ()
                    if:
                        and ge close 0 and ge slash 0 not next_is_paren
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then set sb sb_append sb html::escape_html seg
                                else ()
                            let base <str> str_slice s add i 1 slash;
                            let rub <str> str_slice s add slash 1 close;
                            set sb sb_append sb "<ruby class=\"nm-ruby\"><rb>";
                            set sb sb_append sb html::escape_html base;
                            set sb sb_append sb "</rb><rt>";
                            set sb sb_append sb html::escape_html rub;
                            set sb sb_append sb "</rt></ruby>";
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                '{':
                    let close <i32> scanner::str_find_byte_range s add i 1 n '}';
                    let first_slash <i32>:
                        if:
                            ge close 0
                            then scan::nm_find_gloss_slash s add i 1 close
                            else -1
                    if:
                        and ge close 0 ge first_slash 0
                        then:
                            let seg <str> str_slice s text_start i;
                            if:
                                gt len seg 0
                                then set sb sb_append sb html::escape_html seg
                                else ()
                            let main <str> str_slice s add i 1 first_slash;
                            set sb sb_append sb "<ruby class=\"nm-anno\"><rb>";
                            set sb sb_append sb nm_inline_to_html main;
                            set sb sb_append sb "</rb><rt>";
                            let mut sub_start <i32> add first_slash 1;
                            let mut k <i32> sub_start;
                            while lt k close:
                                do:
                                    let next_slash <i32> scan::nm_find_gloss_slash s k close;
                                    let part_end <i32>:
                                        if:
                                            ge next_slash 0
                                            then next_slash
                                            else close
                                    let part <str> str_slice s sub_start part_end;
                                    set sb sb_append sb "<span class=\"nm-anno-note\">";
                                    set sb sb_append sb nm_inline_to_html part;
                                    set sb sb_append sb "</span>";
                                    if:
                                        ge next_slash 0
                                        then:
                                            set sub_start add next_slash 1;
                                            set k sub_start
                                        else:
                                            set k close
                            set sb sb_append sb "</rt></ruby>";
                            set i add close 1;
                            set text_start i
                        else:
                            set i add i 1
                _:
                    set i add i 1
    let tail <str> str_slice s text_start n;
    if:
        gt len tail 0
        then set sb sb_append sb html::escape_html tail
        else ()
    sb_build sb

//: nm_render_source_html: source を HTML fragment に変換する
//:
//: [目的/もくてき]:
//: - Document source を block 単位で走査し、section / heading / paragraph / code fence / horizontal rule を HTML にします。
//: - `Vec<Node>` を構築せず、parser の source view から直接 serializer output を作ります。
//:
//: [実装/じっそう]:
//: - section close は `</section>` を direct に追加し、stack state は Copy bool と current level だけで持ちます。
//: - paragraph は次の block boundary まで複数行を束ね、inline markup は `nm_inline_to_html` で変換します。
//:
//: [注意/ちゅうい]:
//: - heading level 1 から 6 だけを section stack として扱います。より深い heading は parser helper 側で h6 相当に丸めます。
//: - code fence body は inline 変換せず、`escape_html` だけを通します。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
fn nm_render_source_html <(str)->str> (src):
    let mut sb <StringBuilder> string_builder_new;
    let n <i32> len src;
    let mut pos <i32> 0;
    let mut current_level <i32> 0;
    let mut open1 <bool> false;
    let mut open2 <bool> false;
    let mut open3 <bool> false;
    let mut open4 <bool> false;
    let mut open5 <bool> false;
    let mut open6 <bool> false;

    while lt pos n:
        do:
            let line_end <i32> scanner::str_line_end src pos;
            let raw <str> str_slice_trim_suffix_cr src pos line_end;
            let t <str> str_trim raw;
            set pos scanner::str_next_line_pos src line_end;
            if:
                eq len t 0
                then:
                    ()
                else:
                    if:
                        scan::is_section_break t
                        then:
                            if:
                                gt current_level 0
                                then:
                                    set sb sb_append sb "</section>";
                                    match current_level:
                                        1:
                                            set open1 false
                                        2:
                                            set open2 false
                                        3:
                                            set open3 false
                                        4:
                                            set open4 false
                                        5:
                                            set open5 false
                                        _:
                                            set open6 false
                                    set current_level scan::nm_deepest_level open1 open2 open3 open4 open5 open6
                                else ()
                        else:
                            if:
                                scan::is_hr t
                                then:
                                    set sb sb_append sb "<hr/>";
                                    if:
                                        gt current_level 0
                                        then:
                                            set sb sb_append sb "</section>";
                                            match current_level:
                                                1:
                                                    set open1 false
                                                2:
                                                    set open2 false
                                                3:
                                                    set open3 false
                                                4:
                                                    set open4 false
                                                5:
                                                    set open5 false
                                                _:
                                                    set open6 false
                                            set current_level scan::nm_deepest_level open1 open2 open3 open4 open5 open6
                                        else ()
                                else:
                                    if:
                                        scan::is_fence_start t
                                        then:
                                            let info <str> str_trim str_slice t 3 len t;
                                            let mut code_sb <StringBuilder> string_builder_new;
                                            let mut done <bool> false;
                                            while and lt pos n not done:
                                                do:
                                                    let cend <i32> scanner::str_line_end src pos;
                                                    let craw <str> str_slice_trim_suffix_cr src pos cend;
                                                    let ct <str> str_trim craw;
                                                    set pos scanner::str_next_line_pos src cend;
                                                    if:
                                                        scan::is_fence_start ct
                                                        then set done true
                                                        else:
                                                            set code_sb sb_append code_sb craw;
                                                            set code_sb sb_append code_sb "\n"
                                            set sb sb_append sb "<pre><code";
                                            if:
                                                gt len info 0
                                                then:
                                                    set sb sb_append sb " class=\"language-";
                                                    set sb sb_append sb html::escape_html info;
                                                    set sb sb_append sb "\""
                                                else ()
                                            set sb sb_append sb ">";
                                            set sb sb_append sb html::escape_html sb_build code_sb;
                                            set sb sb_append sb "</code></pre>"
                                        else:
                                            let hlevel <i32> scan::nm_heading_level t;
                                            if:
                                                gt hlevel 0
                                                then:
                                                    while ge current_level hlevel:
                                                        do:
                                                            set sb sb_append sb "</section>";
                                                            match current_level:
                                                                1:
                                                                    set open1 false
                                                                2:
                                                                    set open2 false
                                                                3:
                                                                    set open3 false
                                                                4:
                                                                    set open4 false
                                                                5:
                                                                    set open5 false
                                                                _:
                                                                    set open6 false
                                                            set current_level scan::nm_deepest_level open1 open2 open3 open4 open5 open6
                                                    let htext <str> scan::nm_heading_text t hlevel;
                                                    set sb sb_append sb "<section class=\"nm-sec level-";
                                                    set sb sb_append_i32 sb hlevel;
                                                    set sb sb_append sb "\">";
                                                    set sb nm_append_heading_open sb hlevel;
                                                    set sb sb_append sb nm_inline_to_html htext;
                                                    set sb nm_append_heading_close sb hlevel;
                                                    match hlevel:
                                                        1:
                                                            set open1 true
                                                        2:
                                                            set open2 true
                                                        3:
                                                            set open3 true
                                                        4:
                                                            set open4 true
                                                        5:
                                                            set open5 true
                                                        _:
                                                            set open6 true
                                                    set current_level hlevel
                                                else:
                                                    let mut para_sb <StringBuilder> string_builder_new;
                                                    set para_sb sb_append para_sb raw;
                                                    let mut done <bool> false;
                                                    while and lt pos n not done:
                                                        do:
                                                            let pend <i32> scanner::str_line_end src pos;
                                                            let praw <str> str_slice_trim_suffix_cr src pos pend;
                                                            let pt <str> str_trim praw;
                                                            if:
                                                                scan::nm_is_block_boundary pt
                                                                then set done true
                                                                else:
                                                                    set para_sb sb_append para_sb "\n";
                                                                    set para_sb sb_append para_sb praw;
                                                                    set pos scanner::str_next_line_pos src pend
                                                    set sb sb_append sb "<p>";
                                                    set sb sb_append sb nm_inline_to_html sb_build para_sb;
                                                    set sb sb_append sb "</p>"

    while gt current_level 0:
        do:
            set sb sb_append sb "</section>";
            match current_level:
                1:
                    set open1 false
                2:
                    set open2 false
                3:
                    set open3 false
                4:
                    set open4 false
                5:
                    set open5 false
                _:
                    set open6 false
            set current_level scan::nm_deepest_level open1 open2 open3 open4 open5 open6
    sb_build sb

//: render_document: `Document` source view を HTML 文字列へ変換する
//:
//: [目的/もくてき]:
//: - nm/parser が返した Document をブラウザ表示可能な HTML へ変換します。
//: - CLI の `--html` 出力や docs 生成で使用する最終段 API です。
//:
//: [実装/じっそう]:
//: - `Document.source` を `nm_render_source_html` で direct serialize します。
//:
//: [計算量/けいさんりょう]:
//: - O(n + m)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "alloc/string" as *
//:| #import "nm/parser" as *
//:| #import "nm/html_gen" as *
//: fn main <()*>i32> ():
//:     let d <Document> parse_markdown "# T\n\nx\n";
//:     let h <str> render_document d;
//:     if and str_starts_with h "<section" str_ends_with h "</section>" 0 1
//: ```
pub fn render_document <(Document)->str> (doc):
    nm_render_source_html get doc "source"
