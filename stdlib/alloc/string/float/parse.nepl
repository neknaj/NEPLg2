//:     match got:
//:         Result::Ok _:
//:             test_assertion_failed AssertionKind::Bool label "true" "false" "invalid float accepted unexpectedly"
//:         Result::Err _:
//:             assert label true
//:
//: fn main %impure fn () i32 \():
//:     let expected %f64 %f64 cast 125
//:     let report:
//:         test_report_new "string_float_parse_doc"
//:         |> test_report_push assert_f64_ok "parse scientific" (to_f64 "1.25e2") expected
