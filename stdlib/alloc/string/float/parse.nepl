//: # string/float/parse
//: string から f32 / f64 への変換
//:
//: [目的/もくてき]:
//: - 10 進表記の str を f64 / f32 として解析します。
//: - formatting 側の raw allocation boundary と分け、byte scanner と exponent 処理に責務を集中します。
//:
//: [注意/ちゅうい]:
//: - 少なくとも 1 桁の digit が必要です。
//: - nan / inf などの記号名は解析しません。

#indent 4

#import "core/result" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/char" as *
#import "core/option" as *
#import "alloc/string/access" as *
#import "alloc/string/byte_index" as *

fn float_parse_byte_or_invalid %fn str fn i32 i32 \s\idx:
    match checked_string_byte_at s idx:
        Option::Some b:
            b
        Option::None:
            -1

//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_float_parse_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"parse scientific\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"reject dot only\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string/float/parse" as *
