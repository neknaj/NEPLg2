//: integer: string の bool / integer conversion
//:
//: [目的/もくてき]:
//: - bool、i32、i64、u128、i128 と str の相互変換を提供します。
//: - common / format / parse の public facade として、既存の alloc/string import 経路を保ちます。
//:
//: [注意/ちゅうい]:
//: - 実装本体は ./integer/common、./integer/format、./integer/parse が所有します。
//: - root facade へ helper 本体を戻さず、責務ごとの source policy で分割境界を監視します。

#indent 4

pub #import "./integer/common" as *
pub #import "./integer/format" as *
pub #import "./integer/parse" as *

//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_integer_facade_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"format i32\" expected=\"-42\" actual=\"-42\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"parse i32\" expected=\"42\" actual=\"42\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn assert_i32_ok %fn str fn Result i32 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             assert_eq_i32 label expected actual
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected "Err" "integer parse failed unexpectedly"
//:
//: fn main %impure fn unit i32 \unit:
//:     let report:
//:         test_report_new "string_integer_facade_doc"
//:         |> test_report_push assert_str_eq "format i32" "-42" from_i32 -42
//:         |> test_report_push assert_i32_ok "parse i32" (to_i32 "42") 42
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
