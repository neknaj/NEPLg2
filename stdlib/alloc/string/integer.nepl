//: integer: string の bool / integer conversion
//:
//: [目的/もくてき]:
//: - bool、i32、i64、u128、i128 と str の相互変換を提供します。
//: - common / format / parse の public facade として、既存の alloc/string import 経路を保ちます。
//:
//: [注意/ちゅうい]:
//: - 実装本体は ./integer/common、./integer/format、./integer/parse が所有します。
//: - root facade へ helper 本体を戻さず、責務ごとの source policy で分割境界を監視します。

#indent 4

pub #import "./integer/common" as *
pub #import "./integer/format" as *
pub #import "./integer/parse" as *

//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 assert_str_eq "-42" from_i32 -42
//:     let checks2 match to_i32 "42":
//:         Result::Ok v:
//:             checks_push checks1 assert_eq_i32 42 v
//:         Result::Err _:
//:             checks_push checks1 assert_eq_i32 1 0
//:     checks_exit_code checks2
//: ```
