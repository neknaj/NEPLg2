//: storage: string の memory layout と str ownership boundary
//:
//: [目的/もくてき]:
//: - `[len:i32][bytes...]` 形式の string storage を確保・投影・確定します。
//: - raw byte 列から `str` を作る ownership boundary を 1 箇所に集約します。
//:
//: [注意/ちゅうい]:
//: - `string_from_mem_unchecked_result` は UTF-8 検証を行いません。外部入力には `string_from_utf8_mem_result` を使います。
//: - `string_finish` 後は `RegionToken<u8>` の所有権が `str` 側へ移ります。

#indent 4

#import "core/mem" as *
#import "core/result" as *
#import "core/math" as *
#import "core/field" as *
#import "alloc/string/utf8" as *

//: string_alloc_region: 文字列用の領域を確保する
//:
//: [目的/もくてき]:
//: - 先頭 4 バイトの長さヘッダを含む文字列領域を確保します。
//:
//: [実装/じっそう]:
//: - `alloc_region_bytes<u8>` に `4 + byte_len` を渡し、文字列レイアウト専用の `RegionToken<u8>` を返します。
//:
//: [注意/ちゅうい]:
//: - `byte_len` は文字列本文のバイト数です。
//: - 失敗時は `Result::Err` を返します。
//:
//: [計算量/けいさんりょう]:
//: - 確保器に依存します。平均 O(1)、free list 探索時は最悪 O(n) です。
pub fn string_alloc_region <(i32)->Result<RegionToken<u8>,str>> (byte_len):
    if:
        lt byte_len 0
        then:
            Result<RegionToken<u8>,str>::Err "string.alloc invalid length"
        else:
            alloc_region_bytes<u8> add 4 byte_len

//: string_region_len_ptr: 文字列領域ヘッダへの型付きポインタを得る
//:
//: [目的/もくてき]:
//: - 文字列領域の長さヘッダを `MemPtr<i32>` として扱えるようにします。
//:
//: [実装/じっそう]:
//: - `RegionToken` の所有権を動かさず、field reference から基底 `MemPtr<u8>` を copy してヘッダポインタに包み直します。
//:
//: [注意/ちゅうい]:
//: - 文字列領域レイアウトを前提とする内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_region_len_ptr <(&RegionToken<u8>)->MemPtr<i32>> (region):
    mem_ptr_wrap mem_ptr_addr *get_ref region "ptr"

//: string_region_data_ptr: 文字列本文先頭への型付きポインタを得る
//:
//: [目的/もくてき]:
//: - 文字列本文の 1 バイト目を `MemPtr<u8>` として扱えるようにします。
//:
//: [実装/じっそう]:
//: - `RegionToken` の所有権を動かさず、field reference から基底 `MemPtr<u8>` を copy して 4 バイト進めます。
//:
//: [注意/ちゅうい]:
//: - 先頭 4 バイトが長さヘッダであることを前提にしています。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_region_data_ptr <(&RegionToken<u8>)->MemPtr<u8>> (region):
    mem_ptr_add *get_ref region "ptr" 4

//: string_addr: `str` の内部アドレスを低レベル処理用に取り出す
//:
//: [目的/もくてき]:
//: - `str` と `i32` を型として混同せず、文字列レイアウトを扱う内部処理だけが明示的に生アドレスを使えるようにします。
//:
//: [実装/じっそう]:
//: - compiler intrinsic により、WASM 上の `str` 表現である線形メモリアドレスを `i32` として返します。
//:
//: [注意/ちゅうい]:
//: - 文字列実装と OS 境界用の低レベル API です。通常の文字列処理では `len` / `string_data_ptr` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_addr <(str)->i32> (s):
    #intrinsic "str_addr" <> (s)

//: string_data_ptr: 既存文字列の本文先頭を型付きポインタとして扱う
//:
//: [目的/もくてき]:
//: - `str` の内部表現を直接露出せずに、本文領域へアクセスします。
//:
//: [実装/じっそう]:
//: - 長さヘッダの直後を `MemPtr<u8>` として包みます。
//:
//: [注意/ちゅうい]:
//: - 既存の `str` 表現に依存する内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_data_ptr <(str)->MemPtr<u8>> (s):
    mem_ptr_wrap add string_addr s 4

//: string_finish: 文字列領域を `str` として確定する
//:
//: [目的/もくてき]:
//: - 文字列領域へ長さを書き込み、公開型 `str` に変換します。
//:
//: [実装/じっそう]:
//: - ヘッダへ長さを書き込み、領域先頭アドレスを返します。
//:
//: [注意/ちゅうい]:
//: - 確定後は領域の所有権を `str` 側へ移します。
//: - 書き込み不能な領域は内部不整合として `unreachable` 扱いです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_finish <(RegionToken<u8>,i32)->str> (region, byte_len):
    let base <MemPtr<u8>> get region "ptr"
    string_finish_base base byte_len

//: string_from_addr_unchecked: 文字列レイアウト済み領域を `str` として扱う
//:
//: [目的/もくてき]:
//: - 先頭 4 バイトに長さを持つ文字列領域の基底アドレスを、公開型 `str` へ変換します。
//:
//: [実装/じっそう]:
//: - compiler intrinsic により、`i32` の生アドレスを `str` 表現へ明示的に境界変換します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 検証済みで、文字列レイアウトを満たす領域にだけ使ってください。任意の整数を渡すと未定義動作になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_from_addr_unchecked <(i32)->str> (addr):
    #intrinsic "str_from_addr_unchecked" <> (addr)

//: string_finish_base: 文字列先頭ポインタを `str` として確定する
//:
//: [目的/もくてき]:
//: - 文字列領域の先頭ポインタへ長さを書き込み、公開型 `str` に変換します。
//:
//: [実装/じっそう]:
//: - ヘッダ先頭を `MemPtr<i32>` として見なし、長さを書き込んだ後に基底アドレスを返します。
//:
//: [注意/ちゅうい]:
//: - 呼び出し側は、先頭 4 バイトが長さヘッダである文字列レイアウトを守る必要があります。
//: - 領域の所有権は呼び出し側で保持したまま、`str` へ移す前提の内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_finish_base <(MemPtr<u8>,i32)->str> (base, byte_len):
    store_i32 mem_ptr_addr base byte_len
    string_from_addr_unchecked mem_ptr_addr base

//: string_from_mem_unchecked_result: raw byte 列を検証なしで `str` へ複製する
//:
//: [目的/もくてき]:
//: - 既に UTF-8 として検証済み、または byte 列として扱うことが明確な領域を、新しい `str` 領域へ複製します。
//:
//: [実装/じっそう]:
//: - `string_alloc_region` で `[len][bytes...]` layout の領域を確保し、本文へ `mem_copy` します。
//: - 長さヘッダは `string_finish` で raw store し、確保領域の所有権を返却する `str` へ移します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 検証は行いません。外部入力には `string_from_utf8_mem_result` を使ってください。
//: - `byte_len > 0` の場合、`src` は少なくとも `byte_len` byte の有効領域を指している必要があります。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
pub fn string_from_mem_unchecked_result <(MemPtr<u8>,i32)->Result<str,str>> (src, byte_len):
    if:
        lt byte_len 0
        then:
            Result<str,str>::Err "string.from_mem invalid length"
        else:
            match string_alloc_region byte_len:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok region:
                    let out_data <MemPtr<u8>> string_region_data_ptr &region
                    if:
                        gt byte_len 0
                        then:
                            mem_copy mem_ptr_addr out_data mem_ptr_addr src byte_len
                        else:
                            ()
                    Result<str,str>::Ok string_finish region byte_len


//: string_from_utf8_mem_result: UTF-8 検証済みの `str` を構築する
//:
//: [目的/もくてき]:
//: - filesystem / stdin / byte builder など外部由来の raw byte 列を、UTF-8 検証してから `str` にします。
//:
//: [実装/じっそう]:
//: - `string_utf8_validate_mem` に成功した場合だけ、`string_from_mem_unchecked_result` で新しい文字列領域へ複製します。
//:
//: [注意/ちゅうい]:
//: - 入力 byte 領域の所有権は消費しません。必要なら呼び出し側で解放してください。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
pub fn string_from_utf8_mem_result <(MemPtr<u8>,i32)->Result<str,str>> (src, byte_len):
    match string_utf8_validate_mem src byte_len:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok _:
            string_from_mem_unchecked_result src byte_len

