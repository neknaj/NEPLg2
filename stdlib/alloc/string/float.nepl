//: float: string の f32 / f64 conversion
//:
//: [目的/もくてき]:
//: - f64 / f32 と str の相互変換を提供します。
//: - format / parse の public facade として、既存の alloc/string import 経路を保ちます。
//:
//: [注意/ちゅうい]:
//: - 実装本体は ./float/format と ./float/parse が所有します。
//: - root facade へ formatting / parsing 本体を戻さず、source policy で分割境界を監視します。

#indent 4
#import "core/math" as *

pub #import "./float/format" as *
pub #import "./float/parse" as *

//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_float_facade_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"format f64\" expected=\"1.25\" actual=\"1.25\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"parse f64\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "core/cast" as *
//: fn assert_f64_ok %fn str fn Result f64 i32 fn f64 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             assert label eq actual expected
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::Bool label "true" "false" "float parse failed unexpectedly"
//:
//: fn main %impure fn void i32 \void:
//:     let expected %f64 div %f64 cast 5 %f64 cast 4
//:     let report:
//:         test_report_new "string_float_facade_doc"
//:         |> test_report_push assert_str_eq "format f64" "1.25" from_f64 expected
//:         |> test_report_push assert_f64_ok "parse f64" (to_f64 "1.25") expected
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
