//: float: string の f32 / f64 conversion
//:
//: [目的/もくてき]:
//: - f64 / f32 と str の相互変換を提供します。
//: - format / parse の public facade として、既存の alloc/string import 経路を保ちます。
//:
//: [注意/ちゅうい]:
//: - 実装本体は ./float/format と ./float/parse が所有します。
//: - root facade へ formatting / parsing 本体を戻さず、source policy で分割境界を監視します。

#indent 4
#import "core/math" as *

pub #import "./float/format" as *
pub #import "./float/parse" as *

//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 assert_str_eq "1.25" from_f64 div <f64> cast 5 <f64> cast 4
//:     let checks2 match to_f64 "1.25":
//:         Result::Ok v:
//:             checks_push checks1 assert_eq_i32 1 cast eq v div <f64> cast 5 <f64> cast 4
//:         Result::Err _:
//:             checks_push checks1 assert_eq_i32 1 0
//:     checks_exit_code checks2
//: ```
