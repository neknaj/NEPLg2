//:         |> test_report_push assert "negative hex" result_str_eq from_i128_radix neg 16 "-ff"
//:         |> test_report_push assert "large hex" result_str_eq from_i128_radix wide 16 "10000000000000000"
//:         |> test_report_push assert "invalid radix" result_err_i32 from_i128_radix wide 3 1
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn from_i128_radix %fn i128 fn i32 Result str i32 \v\radix:
    let is_negative %bool i128_is_negative v;
    let mag %u128 i128_abs_u128 v;
    match from_u128_radix mag radix:
        Result::Ok body:
            if:
                is_negative
                then:
                    match string_builder_with_capacity_result add 1 len body:
                        Result::Err _e:
                            Result::Err 12
                        Result::Ok sb0:
                            match sb_append_byte_result sb0 '-':
                                Result::Err _e:
                                    Result::Err 12
                                Result::Ok sb1:
                                    match sb_append_result sb1 body:
                                        Result::Err _e:
                                            Result::Err 12
                                        Result::Ok sb2:
                                            match sb_build_result sb2:
                                                Result::Err _e:
                                                    Result::Err 12
                                                Result::Ok text:
                                                    Result::Ok text
                else:
                    Result::Ok body
        Result::Err e:
            Result::Err e
