//: # string/integer/common/bool
//: bool と string の表示・解析 helper
//:
//: [目的/もくてき]:
//: - bool の表示用文字列化と、`"true"` / `"false"` の解析を integer common facade から[分離/ぶんり]します。
//: - 数値 digit / 128-bit arithmetic helper と混ざらない小さな module にして、依存関係を読みやすくします。

#indent 4

#import "core/result" as *
#import "alloc/string/search" as *

//: from_bool: bool を表示用文字列へ変換する
//:
//: [目的/もくてき]:
//: - `true` を `"true"`、`false` を `"false"` として返します。
//: - 診断文やテスト失敗メッセージで論理値をそのまま表示したい時に使います。
//:
//: [実装/じっそう]:
//: - 分岐だけで固定文字列 literal を選びます。
//:
//: [注意/ちゅうい]:
//: - 返す文字列は表示用の表現です。数値変換や bool 解析ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_from_bool_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"format true\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"format false\" expected=\"false\" actual=\"false\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn () i32 \():
//:     let report:
//:         test_report_new "string_from_bool_doc"
//:         |> test_report_push assert_str_eq "format true" "true" from_bool true
//:         |> test_report_push assert_str_eq "format false" "false" from_bool false
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn from_bool %fn bool str \b:
    if:
        b
        then:
            "true"
        else:
            "false"

//: to_bool: 文字列を bool として解析する
//:
//: [目的/もくてき]:
//: - `"true"` または `"false"` の文字列を `bool` として読み取ります。
//: - 設定値や CLI 引数、テスト入力などで論理値を文字列から受け取る時に使います。
//:
//: [実装/じっそう]:
//: - `str_eq` で `"true"`、続いて `"false"` と比較します。
//:
//: [注意/ちゅうい]:
//: - 受理する表記は小文字の `"true"` / `"false"` のみです。
//: - `"True"` や `"0"` / `"1"` は bool として扱いません。
//: - 解析失敗は `Result::Err 1` で返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_to_bool_doc\" count=3 failed=0\nassertion index=0 status=ok kind=bool label=\"parse true\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"parse false\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=2 status=ok kind=bool label=\"reject invalid bool\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//:| #import "core/cast" as *
//: fn assert_bool_ok %fn str fn Result bool i32 fn bool TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             if:
//:                 actual
//:                 then:
//:                     assert label expected
//:                 else:
//:                     assert label not expected
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::Bool label "true" "false" "bool parse failed unexpectedly"
//:
//: fn assert_bool_err %fn str fn Result bool i32 TestAssertion \label\got:
//:     match got:
//:         Result::Ok _:
//:             test_assertion_failed AssertionKind::Bool label "true" "false" "invalid bool accepted unexpectedly"
//:         Result::Err _:
//:             assert label true
//:
//: fn main %impure fn () i32 \():
//:     let report:
//:         test_report_new "string_to_bool_doc"
//:         |> test_report_push assert_bool_ok "parse true" (to_bool "true") true
//:         |> test_report_push assert_bool_ok "parse false" (to_bool "false") false
//:         |> test_report_push assert_bool_err "reject invalid bool" (to_bool "yes")
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn to_bool %fn str Result bool i32 \s:
    if:
        str_eq s "true"
        then:
            Result::Ok<bool,i32> true
        else:
            if:
                str_eq s "false"
                then:
                    Result::Ok<bool,i32> false
                else:
                    Result::Err<bool,i32> 1
