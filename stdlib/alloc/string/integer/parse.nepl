//:         test_report_new "string_integer_parse_doc"
//:         |> test_report_push assert_i32_ok "parse hex i32" (to_i32_radix "2a" 16) 42
//:         |> test_report_push assert_i128_ok_i32 "parse negative hex i128" (to_i128_radix "-2a" 16) -42
