//:| #import "alloc/string/integer/format" as *
//:| #import "core/math" as *
//:| #import "core/cast" as *
//: fn assert_i32_ok %fn str fn Result i32 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             assert_eq_i32 label expected actual
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected "Err" "integer parse failed unexpectedly"
//:
//: fn assert_i32_err_i32 %fn str fn Result i32 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected from_i32 actual "integer parse succeeded unexpectedly"
