//: to_i32: 10 進文字列を i32 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i32` に変換します。
//:
//: [実装/じっそう]:
//: - 10 進専用の軽い parser で直接 i32 範囲を検査します。
//: - 負数は負の accumulator へ累積するため、`-2147483648` を overflow せず受理できます。
//:
//: [注意/ちゅうい]:
//: - 負号は先頭 1 byte の `-` だけを受理します。
//: - 空文字列、無効な digit、表現域外入力はいずれも `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn to_i32 %fn str Result i32 i32 \s:
    let n %i32 len s;
    if:
        eq n 0
        then:
            Result::Err 1
        else:
            let first %i32 integer_parse_byte_or_invalid s 0;
            let has_minus %bool eq first '-';
            let start %i32 if has_minus:
                then 1
                else 0
            parse_i32_decimal_digits_from s start has_minus

//: to_i32_range: 文字列の byte 範囲を 10 進 i32 として解析する
//:
//: [目的/もくてき]:
//: - scanner が `str_slice_result` で token 文字列を確保せず、元の文字列と byte 範囲だけで数値 token を解析できるようにします。
//: - `to_i32` と同じ 10 進 i32 の範囲検査を、`s[start..end]` に対して行います。
//:
//: [実装/じっそう]:
//: - 範囲先頭の `-` だけを負号として扱い、その後の digit 範囲を `parse_i32_decimal_digits_range` へ渡します。
//: - 負数は負の accumulator へ累積するため、`-2147483648` を overflow せず受理できます。
//:
//: [注意/ちゅうい]:
//: - 範囲は byte index です。`start` と `end` は token scanner が持つ境界をそのまま渡します。
//: - 空範囲、`-` だけの範囲、範囲外、無効 digit、表現域外入力はいずれも `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
pub fn to_i32_range %fn str fn i32 fn i32 Result i32 i32 \s\start\end:
    let first %i32 integer_parse_byte_or_invalid s start;
    let has_minus %bool eq first '-';
    let digit_start %i32 if has_minus:
        then add start 1
        else start
    parse_i32_decimal_digits_range s digit_start end has_minus

// to_i32_radix: 指定基数の文字列を i32 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進で書かれた文字列を i32 に変換します。
// - 設定値やリテラル風入力を i32 として読み取りたい時に使います。
//
// 実装(アルゴリズム):
// - まず `to_i64_radix` で共通解析を行います。
// - その後、i32 の範囲に収まるかを確認してから縮小します。
//
// 注意(重要):
// - 接頭辞 `0x` や `0b` は解釈しません。文字列本体だけを渡してください。
// - 解析失敗と範囲外はどちらも `Result::Err` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
pub fn to_i32_radix %fn str fn i32 Result i32 i32 \s\radix:
    match to_i64_radix s radix:
        Result::Ok v64:
            if:
                and ge v64 %i64 cast -2147483648 le v64 %i64 cast 2147483647
                then:
                    Result::Ok %i32 cast v64
                else:
                    Result::Err 1
        Result::Err e:
            Result::Err e

//: to_i64: 10 進文字列を i64 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i64` として読み取ります。
//:
//: [実装/じっそう]:
//: - `to_i64_radix s 10` に委譲し、基数付き解析へ統一します。
//:
//: [注意/ちゅうい]:
//: - 接頭辞は読まず、文字列本体だけを解析します。
//: - 表現域外入力は `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn to_i64 %fn str Result i64 i32 \s:
    to_i64_radix s 10

// i128_fits_i64: i128 が i64 の表現域に収まるかを判定する
//
// 目的:
// - `to_i64_radix` が範囲外の i128 を i64 に切り詰めて受理しないようにします。
//
// 実装(アルゴリズム):
// - 非負 i64 は hi が 0 かつ lo の符号 bit が 0 の時だけ許可します。
// - 負 i64 は hi が -1 かつ lo の符号 bit が 1 の時だけ許可します。
//
// 注意(重要):
// - これは bit pattern の符号拡張検査であり、cast 前に必ず実行します。
//
// 計算量:
// - O(1)
pub fn i128_fits_i64 %fn i128 bool \v:
    let hi %i64 get v "hi";
    let lo %i64 get v "lo";
    if:
        eq hi %i64 cast 0
        then:
            not lt lo %i64 cast 0
        else:
            if:
                eq hi %i64 cast -1
                then:
                    lt lo %i64 cast 0
                else:
                    false

// to_i64_radix: 指定基数の文字列を i64 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進文字列を i64 として解釈します。
// - 数値入力の解析や、基数別テストデータの読み戻しに使います。
//
// 実装(アルゴリズム):
// - `to_i128_radix` で共通解析を行い、最後に `i64` へ縮小します。
// - i128 の上位 word が i64 の符号拡張と一致する時だけ縮小します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - `-ff` のような符号付き文字列は、すべての対応基数で受理します。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
pub fn to_i64_radix %fn str fn i32 Result i64 i32 \s\radix:
    match to_i128_radix s radix:
        Result::Ok v128:
            if:
                i128_fits_i64 v128
                then:
                    Result::Ok %i64 cast v128
                else:
                    Result::Err 1
        Result::Err e:
            Result::Err e

// to_u128: 10 進文字列を u128 に変換する
//
// 目的:
// - 大きな非負整数文字列を `u128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_u128_radix s 10` に委譲します。
//
// 注意(重要):
// - 負号は受理しません。
//
// 計算量:
// - O(n)
pub fn to_u128 %fn str Result u128 i32 \s:
    to_u128_radix s 10

// to_u128_radix: 指定基数の文字列を u128 に変換する
//
// 目的:
// - 非負の 2 / 8 / 10 / 16 進文字列を `u128` に変換します。
//
// 実装(アルゴリズム):
// - 各文字を `digit_from_char` で数値化し、`res = res * radix + digit` を `u128_mul_small` と `u128_add_small` で構築します。
// - 更新前に `u128_max / radix` の商と余りで範囲を確認し、ラップする入力を拒否します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - 負号付き文字列は `Result::Err 1` です。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)
pub fn to_u128_radix %fn str fn i32 Result u128 i32 \s\radix:
    match validate_radix radix:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            parse_u128_radix_digits_from s radix 0

//: parse_u128_radix_digits_from: 途中 index から u128 magnitude を読む
//:
//: [目的/もくてき]:
//: - `to_u128_radix` と `to_i128_radix` が同じ digit loop と overflow 検査を共有できるようにします。
//: - signed parse では先頭 `-` を消すための一時 `str` を作らず、開始 index だけを変えて同じ処理を使います。
//:
//: [実装/じっそう]:
//: - `start` から末尾までを `digit_from_char` で数値化し、`res = res * radix + digit` を構築します。
//: - 更新前に `u128_max / radix` の商と余りで overflow を検査します。
//:
//: [注意/ちゅうい]:
//: - radix は呼び出し元で `validate_radix` 済みであることを前提にします。
//: - `start` が末尾以上、または digit として読めない byte があれば `Result::Err 1` です。
//:
//: [計算量/けいさんりょう]:
//: - O(n - start)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_integer_parse_digit_window_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"positive hex window\" expected=\"255\" actual=\"255\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"negative hex window\" expected=\"-255\" actual=\"-255\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string/integer/parse" as *
//:| #import "alloc/string/integer/format" as *
//:| #import "core/cast" as *
//:
//: fn assert_i128_ok_i32 %fn str fn Result i128 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             assert_eq_i32 label expected %i32 cast actual
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected "Err" "i128 parse failed unexpectedly"
//:
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "string_integer_parse_digit_window_doc"
//:         |> test_report_push assert_i128_ok_i32 "positive hex window" (to_i128_radix "ff" 16) 255
//:         |> test_report_push assert_i128_ok_i32 "negative hex window" (to_i128_radix "-ff" 16) -255
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
fn parse_u128_radix_digits_from %fn str fn i32 fn i32 Result u128 i32 \s\radix\start:
    let n %i32 len s;
    let mut i %i32 start;
    let mut res %u128 u128_zero;
    let mut digits_valid %i32 1;
    let max_qr %U128DivRem u128_divrem_small u128_max radix;
    let max_quotient %u128 get max_qr "quotient";
    let max_remainder %i32 get max_qr "remainder";
    if:
        le n start
        then:
            set digits_valid 0;
        else:
            while lt i n:
                do:
                    let digit_chr %i32 integer_parse_byte_or_invalid s i;
                    match digit_from_char digit_chr:
                        Result::Ok digit:
                            if:
                                ge digit radix
                                then:
                                    set digits_valid 0;
                                    set i n;
                                else:
                                    if:
                                        u128_can_mul_add_small res digit max_quotient max_remainder
                                        then:
                                            set res u128_add_small u128_mul_small res radix digit;
                                            set i add i 1;
                                        else:
                                            set digits_valid 0;
                                            set i n;
                        Result::Err _:
                            set digits_valid 0;
                            set i n;
    if:
        eq digits_valid 1
        then:
            Result::Ok res
        else:
            Result::Err 1

// i128_positive_magnitude_allowed: 非負 i128 として許される大きさかを判定する
//
// 目的:
// - `to_i128_radix` が正の範囲外入力を 2 の補数負値として受理しないようにします。
//
// 実装(アルゴリズム):
// - i128 の正の最大値は上位 bit が 0 の範囲なので、u128 の hi word が負でないことを確認します。
//
// 注意(重要):
// - ここでは magnitude を u128 として受け取り、符号付き値への bitcast 前に検査します。
//
// 計算量:
// - O(1)
pub fn i128_positive_magnitude_allowed %fn u128 bool \mag:
    not lt get mag "hi" %i64 cast 0

// i128_negative_magnitude_allowed: 負 i128 として許される大きさかを判定する
//
// 目的:
// - i128 最小値だけは magnitude が 2^127 でも受理し、それより大きい負入力を拒否します。
//
// 実装(アルゴリズム):
// - 上位 bit が 0 なら通常の負値として安全です。
// - 上位 bit が 1 の場合は、正確に `0x8000...0000` の時だけ最小値として許可します。
//
// 注意(重要):
// - `-170...728` は許可し、`-170...729` は拒否する境界です。
//
// 計算量:
// - O(1)
pub fn i128_negative_magnitude_allowed %fn u128 bool \mag:
    if:
        not lt get mag "hi" %i64 cast 0
        then:
            true
        else:
            let min_hi %i64 shl %i64 cast 1 %i64 cast 63;
            and eq get mag "hi" min_hi eq get mag "lo" %i64 cast 0

// i128_magnitude_allowed: 符号に応じて i128 の magnitude 範囲を判定する
//
// 目的:
// - `to_i128_radix` の符号別境界判定を 1 箇所に集約します。
//
// 実装(アルゴリズム):
// - 負号があれば `i128_negative_magnitude_allowed`、なければ `i128_positive_magnitude_allowed` に委譲します。
//
// 注意(重要):
// - この判定が true の時だけ `i128_from_u128_bits` へ進めます。
//
// 計算量:
// - O(1)
pub fn i128_magnitude_allowed %fn u128 fn bool bool \mag\neg:
    if:
        neg
        then:
            i128_negative_magnitude_allowed mag
        else:
            i128_positive_magnitude_allowed mag

// to_i128: 10 進文字列を i128 に変換する
//
// 目的:
// - 大きな符号付き整数文字列を `i128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_i128_radix s 10` に委譲します。
//
// 注意(重要):
// - 接頭辞は解釈しません。
//
// 計算量:
// - O(n)
pub fn to_i128 %fn str Result i128 i32 \s:
    to_i128_radix s 10

// to_i128_radix: 指定基数の文字列を i128 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進の符号付き文字列を `i128` に変換します。
//
// 実装(アルゴリズム):
// - 先頭の `-` を確認し、読み始める index を切り替えて共通 digit parser に渡します。
// - 符号に応じた i128 の表現域を確認し、範囲外なら `Result::Err` にします。
// - 符号が負なら `i128_neg` で符号反転します。
//
// 注意(重要):
// - 表現域外入力は `Result::Err 1` を返します。
// - 接頭辞 `0x` などは解釈しません。
//
// 計算量:
// - O(n)
pub fn to_i128_radix %fn str fn i32 Result i128 i32 \s\radix:
    match validate_radix radix:
        Result::Err e:
            Result::Err e
        Result::Ok _:
            let n %i32 len s;
            if:
                eq n 0
                then:
                    Result::Err 1
                else:
                    let first %i32 integer_parse_byte_or_invalid s 0;
                    let has_minus %bool eq first '-';
                    let start %i32 if has_minus:
                        then 1
                        else 0
                    match parse_u128_radix_digits_from s radix start:
                        Result::Ok mag:
                            if:
                                i128_magnitude_allowed mag has_minus
                                then:
                                    let base %i128 i128_from_u128_bits mag;
                                    if:
                                        has_minus
                                        then:
                                            Result::Ok i128_neg base
                                        else:
                                            Result::Ok base
                                else:
                                    Result::Err 1
                        Result::Err e:
                            Result::Err e
