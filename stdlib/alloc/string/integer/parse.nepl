//: to_i32: 10 進文字列を i32 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i32` に変換します。
//:
//: [実装/じっそう]:
//: - `to_i32_radix s 10` に委譲し、基数付き実装へ統一します。
//: - `to_i32_radix` は `to_i64_radix` の結果を i32 表現域で検査してから縮小します。
//:
//: [注意/ちゅうい]:
//: - 負号は先頭 1 byte の `-` だけを受理します。
//: - 空文字列、無効な digit、表現域外入力はいずれも `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn to_i32 <(str)->Result<i32,i32>> (s):
    match to_i32_radix s 10:
        Result::Ok v:
            Result::Ok<i32,i32> v
        Result::Err e:
            Result::Err<i32,i32> e

// to_i32_radix: 指定基数の文字列を i32 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進で書かれた文字列を i32 に変換します。
// - 設定値やリテラル風入力を i32 として読み取りたい時に使います。
//
// 実装(アルゴリズム):
// - まず `to_i64_radix` で共通解析を行います。
// - その後、i32 の範囲に収まるかを確認してから縮小します。
//
// 注意(重要):
// - 接頭辞 `0x` や `0b` は解釈しません。文字列本体だけを渡してください。
// - 解析失敗と範囲外はどちらも `Result::Err` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
pub fn to_i32_radix <(str,i32)->Result<i32,i32>> (s, radix):
    match to_i64_radix s radix:
        Result::Ok v64:
            if:
                and ge v64 <i64> cast -2147483648 le v64 <i64> cast 2147483647
                then:
                    Result::Ok<i32,i32> <i32> cast v64
                else:
                    Result::Err<i32,i32> 1
        Result::Err e:
            Result::Err<i32,i32> e

//: to_i64: 10 進文字列を i64 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i64` として読み取ります。
//:
//: [実装/じっそう]:
//: - `to_i64_radix s 10` に委譲し、基数付き解析へ統一します。
//:
//: [注意/ちゅうい]:
//: - 接頭辞は読まず、文字列本体だけを解析します。
//: - 表現域外入力は `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn to_i64 <(str)->Result<i64,i32>> (s):
    to_i64_radix s 10

// i128_fits_i64: i128 が i64 の表現域に収まるかを判定する
//
// 目的:
// - `to_i64_radix` が範囲外の i128 を i64 に切り詰めて受理しないようにします。
//
// 実装(アルゴリズム):
// - 非負 i64 は hi が 0 かつ lo の符号 bit が 0 の時だけ許可します。
// - 負 i64 は hi が -1 かつ lo の符号 bit が 1 の時だけ許可します。
//
// 注意(重要):
// - これは bit pattern の符号拡張検査であり、cast 前に必ず実行します。
//
// 計算量:
// - O(1)
pub fn i128_fits_i64 <(i128)->bool> (v):
    let hi <i64> get v "hi";
    let lo <i64> get v "lo";
    if:
        eq hi <i64> cast 0
        then:
            not lt lo <i64> cast 0
        else:
            if:
                eq hi <i64> cast -1
                then:
                    lt lo <i64> cast 0
                else:
                    false

// to_i64_radix: 指定基数の文字列を i64 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進文字列を i64 として解釈します。
// - 数値入力の解析や、基数別テストデータの読み戻しに使います。
//
// 実装(アルゴリズム):
// - `to_i128_radix` で共通解析を行い、最後に `i64` へ縮小します。
// - i128 の上位 word が i64 の符号拡張と一致する時だけ縮小します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - `-ff` のような符号付き文字列は、すべての対応基数で受理します。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
pub fn to_i64_radix <(str,i32)->Result<i64,i32>> (s, radix):
    match to_i128_radix s radix:
        Result::Ok v128:
            if:
                i128_fits_i64 v128
                then:
                    Result::Ok<i64,i32> <i64> cast v128
                else:
                    Result::Err<i64,i32> 1
        Result::Err e:
            Result::Err<i64,i32> e

// to_u128: 10 進文字列を u128 に変換する
//
// 目的:
// - 大きな非負整数文字列を `u128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_u128_radix s 10` に委譲します。
//
// 注意(重要):
// - 負号は受理しません。
//
// 計算量:
// - O(n)
pub fn to_u128 <(str)->Result<u128,i32>> (s):
    to_u128_radix s 10

// to_u128_radix: 指定基数の文字列を u128 に変換する
//
// 目的:
// - 非負の 2 / 8 / 10 / 16 進文字列を `u128` に変換します。
//
// 実装(アルゴリズム):
// - 各文字を `digit_from_char` で数値化し、`res = res * radix + digit` を `u128_mul_small` と `u128_add_small` で構築します。
// - 更新前に `u128_max / radix` の商と余りで範囲を確認し、ラップする入力を拒否します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - 負号付き文字列は `Result::Err 1` です。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)
pub fn to_u128_radix <(str,i32)->Result<u128,i32>> (s, radix):
    match validate_radix radix:
        Result::Err e:
            Result::Err<u128,i32> e
        Result::Ok _:
            let n <i32> len s;
            let mut i <i32> 0;
            let mut res <u128> u128_zero;
            let mut ok <i32> 1;
            let max_qr <U128DivRem> u128_divrem_small u128_max radix;
            let max_quotient <u128> get max_qr "quotient";
            let max_remainder <i32> get max_qr "remainder";
            if:
                eq n 0
                then:
                    set ok 0;
                else:
                    let first <i32> string_byte_at_unchecked s 0;
                    if:
                        eq first '-'
                        then:
                            set ok 0;
                        else:
                            while lt i n:
                                do:
                                    let digit_chr <i32> string_byte_at_unchecked s i;
                                    match digit_from_char digit_chr:
                                        Result::Ok digit:
                                            if:
                                                ge digit radix
                                                then:
                                                    set ok 0;
                                                    set i n;
                                                else:
                                                    if:
                                                        u128_can_mul_add_small res digit max_quotient max_remainder
                                                        then:
                                                            set res u128_add_small u128_mul_small res radix digit;
                                                            set i add i 1;
                                                        else:
                                                            set ok 0;
                                                            set i n;
                                        Result::Err _:
                                            set ok 0;
                                            set i n;
            if:
                eq ok 1
                then:
                    Result::Ok<u128,i32> res
                else:
                    Result::Err<u128,i32> 1

// i128_positive_magnitude_allowed: 非負 i128 として許される大きさかを判定する
//
// 目的:
// - `to_i128_radix` が正の範囲外入力を 2 の補数負値として受理しないようにします。
//
// 実装(アルゴリズム):
// - i128 の正の最大値は上位 bit が 0 の範囲なので、u128 の hi word が負でないことを確認します。
//
// 注意(重要):
// - ここでは magnitude を u128 として受け取り、符号付き値への bitcast 前に検査します。
//
// 計算量:
// - O(1)
pub fn i128_positive_magnitude_allowed <(u128)->bool> (mag):
    not lt get mag "hi" <i64> cast 0

// i128_negative_magnitude_allowed: 負 i128 として許される大きさかを判定する
//
// 目的:
// - i128 最小値だけは magnitude が 2^127 でも受理し、それより大きい負入力を拒否します。
//
// 実装(アルゴリズム):
// - 上位 bit が 0 なら通常の負値として安全です。
// - 上位 bit が 1 の場合は、正確に `0x8000...0000` の時だけ最小値として許可します。
//
// 注意(重要):
// - `-170...728` は許可し、`-170...729` は拒否する境界です。
//
// 計算量:
// - O(1)
pub fn i128_negative_magnitude_allowed <(u128)->bool> (mag):
    if:
        not lt get mag "hi" <i64> cast 0
        then:
            true
        else:
            let min_hi <i64> shl <i64> cast 1 <i64> cast 63;
            and eq get mag "hi" min_hi eq get mag "lo" <i64> cast 0

// i128_magnitude_allowed: 符号に応じて i128 の magnitude 範囲を判定する
//
// 目的:
// - `to_i128_radix` の符号別境界判定を 1 箇所に集約します。
//
// 実装(アルゴリズム):
// - 負号があれば `i128_negative_magnitude_allowed`、なければ `i128_positive_magnitude_allowed` に委譲します。
//
// 注意(重要):
// - この判定が true の時だけ `i128_from_u128_bits` へ進めます。
//
// 計算量:
// - O(1)
pub fn i128_magnitude_allowed <(u128,bool)->bool> (mag, neg):
    if:
        neg
        then:
            i128_negative_magnitude_allowed mag
        else:
            i128_positive_magnitude_allowed mag

// to_i128: 10 進文字列を i128 に変換する
//
// 目的:
// - 大きな符号付き整数文字列を `i128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_i128_radix s 10` に委譲します。
//
// 注意(重要):
// - 接頭辞は解釈しません。
//
// 計算量:
// - O(n)
pub fn to_i128 <(str)->Result<i128,i32>> (s):
    to_i128_radix s 10

// to_i128_radix: 指定基数の文字列を i128 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進の符号付き文字列を `i128` に変換します。
//
// 実装(アルゴリズム):
// - 先頭の `-` を切り出した後、残りを `to_u128_radix` で非負の大きさとして解析します。
// - 符号に応じた i128 の表現域を確認し、範囲外なら `Result::Err` にします。
// - 符号が負なら `i128_neg` で符号反転します。
//
// 注意(重要):
// - 表現域外入力は `Result::Err 1` を返します。
// - 接頭辞 `0x` などは解釈しません。
//
// 計算量:
// - O(n)
pub fn to_i128_radix <(str,i32)->Result<i128,i32>> (s, radix):
    let n <i32> len s;
    if:
        eq n 0
        then:
            Result::Err<i128,i32> 1
        else:
            let first <i32> string_byte_at_unchecked s 0;
            let neg <bool> eq first '-';
            let body <str> if neg:
                then str_slice s 1 n
                else s
            match to_u128_radix body radix:
                Result::Ok mag:
                    if:
                        i128_magnitude_allowed mag neg
                        then:
                            let base <i128> i128_from_u128_bits mag;
                            if:
                                neg
                                then:
                                    Result::Ok<i128,i32> i128_neg base
                                else:
                                    Result::Ok<i128,i32> base
                        else:
                            Result::Err<i128,i32> 1
                Result::Err e:
                    Result::Err<i128,i32> e
