//: # string/integer/parse
//: string から integer への変換
//:
//: [目的/もくてき]:
//: - str を i32 / i64 / u128 / i128 として解析する API と範囲検査 helper をまとめます。
//: - digit/radix 変換は common に委譲し、parse 側は符号処理、overflow 検査、縮小変換の責務に集中します。
//:
//: [注意/ちゅうい]:
//: - 接頭辞 0x / 0b / 0o は扱いません。入力文字列本体だけを解析します。
//: - 範囲外、無効 digit、空入力はいずれも Result::Err 1 を返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_integer_parse_module_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"parse decimal i32\" expected=\"-17\" actual=\"-17\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"reject empty decimal i32\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string/integer/parse" as *
//:| #import "alloc/string/integer/format" as *
//: fn assert_i32_ok %fn str fn Result i32 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             assert_eq_i32 label expected actual
//:         Result::Err _:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected "Err" "integer parse failed unexpectedly"
//:
//: fn assert_i32_err_i32 %fn str fn Result i32 i32 fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Result::Ok actual:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected from_i32 actual "integer parse succeeded unexpectedly"
//:         Result::Err e:
//:             assert_eq_i32 label expected e
//:
//: fn main %impure fn void i32 \void:
//:     let parsed_decimal to_i32 "-17"
//:     let rejected_empty to_i32 ""
//:     let report:
//:         test_report_new "string_integer_parse_module_doc"
//:         |> test_report_push assert_i32_ok "parse decimal i32" parsed_decimal -17
//:         |> test_report_push assert_i32_err_i32 "reject empty decimal i32" rejected_empty 1
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

#import "core/result" as *
#import "core/math/i32" as *
#import "core/math/bool" as *
#import "core/math/i64" as *
#import "core/cast" as *
#import "core/char" as *
#import "core/field" as *
#import "core/option" as *
#import "alloc/string/access" as *
#import "alloc/string/byte_index" as *
#import "./common" as *

fn integer_parse_byte_or_invalid %fn str fn i32 i32 \s\idx:
    match checked_string_byte_at s idx:
        Option::Some b:
            b
        Option::None:
            -1

//: decimal_digit_from_byte_or_invalid: ASCII 10 進 digit を i32 へ変換する
//:
//: [目的/もくてき]:
//: - `to_i32` の 10 進専用 parser が、基数付き parser の `Result` 分岐を経由せず digit 判定できるようにします。
//:
//: [実装/じっそう]:
//: - byte が `'0'` から `'9'` の範囲なら 0..9 を返します。
//: - それ以外の byte は sentinel として -1 を返し、呼び出し側が `Result::Err` へ変換します。
//:
//: [注意/ちゅうい]:
//: - この helper は 10 進専用です。2 / 8 / 16 進の digit 判定は `digit_from_char` を使います。
fn decimal_digit_from_byte_or_invalid %fn i32 i32 \byte:
    if:
        and ge byte '0' le byte '9'
        then:
            sub byte '0'
        else:
            -1

//: i32_decimal_step_allowed: 次の 10 進 digit を i32 範囲内で追加できるか判定する
//:
//: [目的/もくてき]:
//: - `acc * 10 + digit` または `acc * 10 - digit` が i32 の範囲外へ出る前に拒否します。
//:
//: [実装/じっそう]:
//: - 正数は `2147483647` を上限にします。
//: - 負数は負のまま累積し、`-2147483648` を正しく受理します。
//:
//: [注意/ちゅうい]:
//: - `2147483648` は i32 正数として保持できないため、負数だけを負方向に累積する設計にしています。
fn i32_decimal_step_allowed %fn i32 fn i32 fn bool bool \acc\digit\has_minus:
    if:
        has_minus
        then:
            if:
                gt acc -214748364
                then:
                    true
                else:
                    and eq acc -214748364 le digit 8
        else:
            if:
                lt acc 214748364
                then:
                    true
                else:
                    and eq acc 214748364 le digit 7

//: parse_i32_decimal_digits_range: 10 進 i32 本体を byte 範囲から読む
//:
//: [目的/もくてき]:
//: - 文字列全体を切り出さず、`s[start..end]` の digit だけを i32 として解析します。
//: - scanner が token を範囲として保持できるようにし、slice allocation と UTF-8 boundary proof を不要にします。
//:
//: [実装/じっそう]:
//: - `start` から `end` 未満まで ASCII digit を走査します。
//: - 正数は正の accumulator、負数は負の accumulator へ直接累積します。
//:
//: [注意/ちゅうい]:
//: - 少なくとも 1 digit が必要です。空範囲は `Result::Err 1` です。
//: - 範囲外、逆順範囲、無効 digit、表現域外入力はいずれも `Result::Err 1` です。
//: - この helper は 10 進専用であり、radix 付き API からは呼びません。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn parse_i32_decimal_digits_range %fn str fn i32 fn i32 fn bool Result i32 i32 \s\start\end\has_minus:
    let n %i32 len s;
    let mut i %i32 start;
    let mut acc %i32 0;
    let mut digits_valid %i32 1;
    if:
        or lt start 0 or le end start lt n end
        then:
            set digits_valid 0;
        else:
            while lt i end:
                do:
                    let digit_chr %i32 integer_parse_byte_or_invalid s i;
                    let digit %i32 decimal_digit_from_byte_or_invalid digit_chr;
                    if:
                        lt digit 0
                        then:
                            set digits_valid 0;
                            set i n;
                        else:
                            if:
                                i32_decimal_step_allowed acc digit has_minus
                                then:
                                    if:
                                        has_minus
                                        then:
                                            set acc sub mul acc 10 digit;
                                        else:
                                            set acc add mul acc 10 digit;
                                    set i add i 1;
                                else:
                                    set digits_valid 0;
                                    set i n;
    if:
        eq digits_valid 1
        then:
            Result::Ok acc
        else:
            Result::Err 1

//: parse_i32_decimal_digits_from: 10 進 i32 本体を開始 index から末尾まで読む
//:
//: [目的/もくてき]:
//: - `to_i32` が `to_i128_radix` / `parse_u128_radix_digits_from` の大きい proof graph を経由せず、i32 の範囲だけを検査します。
//:
//: [実装/じっそう]:
//: - 末尾 index を `len s` とし、範囲 parser へ委譲します。
//:
//: [注意/ちゅうい]:
//: - 少なくとも 1 digit が必要です。`""` と `"-"` は `Result::Err 1` です。
//: - この helper は 10 進専用であり、radix 付き API からは呼びません。
//:
//: [計算量/けいさんりょう]:
//: - O(n - start)
fn parse_i32_decimal_digits_from %fn str fn i32 fn bool Result i32 i32 \s\start\has_minus:
    parse_i32_decimal_digits_range s start len s has_minus

//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_integer_parse_doc\" count=6 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"parse hex i32\" expected=\"42\" actual=\"42\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"parse negative hex i128\" expected=\"-42\" actual=\"-42\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"reject bare minus i128\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=3 status=ok kind=eq_i32 label=\"reject invalid radix i128\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=4 status=ok kind=eq_i32 label=\"parse i32 range\" expected=\"-42\" actual=\"-42\" message=\"\"\nassertion index=5 status=ok kind=eq_i32 label=\"reject empty i32 range\" expected=\"1\" actual=\"1\" message=\"\"\n"
