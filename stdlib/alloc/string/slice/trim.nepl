//: # string/slice/trim
//: ASCII trim / CR suffix trim
//:
//: [目的/もくてき]:
//: - byte scanner と parser で使う ASCII trim helper を所有します。
//: - slice construction は `slice/byte` に委譲し、trim 固有の scan だけをこの module に閉じます。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII space/tab/LF/CR のみです。

#indent 4

#import "core/math" as *
#import "alloc/string/access" as *
#import "alloc/string/byte_index" as *
#import "./byte" as *

//: str_trim_suffix_cr: 末尾 CR を 1 byte だけ取り除く
//:
//: [目的/もくてき]:
//: - byte scanner で LF 直前まで切った CRLF 行から、残った CR を取り除きます。
//:
//: [注意/ちゅうい]:
//: - 末尾が CR でない場合は元の `str` を返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_trim_doc\" count=6 failed=0\nassertion index=0 status=ok kind=str_eq label=\"suffix cr removed\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"suffix without cr kept\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=2 status=ok kind=str_eq label=\"slice suffix cr removed\" expected=\"bcd\" actual=\"bcd\" message=\"\"\nassertion index=3 status=ok kind=str_eq label=\"slice clamps low start\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=4 status=ok kind=str_eq label=\"ascii whitespace trimmed\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=5 status=ok kind=str_eq label=\"interior space kept\" expected=\"a b\" actual=\"a b\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/string/slice/trim" as *
//: fn main %impure fn unit i32 \unit:
//:     let report:
//:         test_report_new "string_trim_doc"
//:         |> test_report_push assert_str_eq "suffix cr removed" "abc" str_trim_suffix_cr "abc\r"
//:         |> test_report_push assert_str_eq "suffix without cr kept" "abc" str_trim_suffix_cr "abc"
//:         |> test_report_push assert_str_eq "slice suffix cr removed" "bcd" str_slice_trim_suffix_cr "abcd\r" 1 5
//:         |> test_report_push assert_str_eq "slice clamps low start" "abc" str_slice_trim_suffix_cr "abc\r" -3 4
//:         |> test_report_push assert_str_eq "ascii whitespace trimmed" "abc" str_trim " \tabc\r\n"
//:         |> test_report_push assert_str_eq "interior space kept" "a b" str_trim " a b "
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn str_trim_suffix_cr %fn str str \s:
    let n %i32 len s
    if:
        and gt n 0 string_byte_eq s sub n 1 '\r'
        then str_slice s 0 sub n 1
        else s

//: str_slice_trim_suffix_cr: 範囲切り出しと末尾 CR 除去を 1 回の str 構築にまとめる
//:
//: [目的/もくてき]:
//: - `str_trim_suffix_cr str_slice s start end` と同じ結果を、不要な中間 `str` を作らずに返します。
//:
//: [実装/じっそう]:
//: - `str_slice` と同じ境界丸めを行い、丸め後の末尾 byte が CR なら end を 1 byte 戻してから切り出します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 境界検査と失敗時 fallback は最終的な `str_slice` に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
pub fn str_slice_trim_suffix_cr %fn str fn i32 fn i32 str \s\start\end:
    let n %i32 len s
    let mut s0 %i32 start
    let mut e0 %i32 end
    if:
        lt s0 0
        then set s0 0
        else unit
    if:
        lt e0 s0
        then set e0 s0
        else unit
    if:
        lt n e0
        then set e0 n
        else unit
    if:
        and gt e0 s0 string_byte_eq s sub e0 1 '\r'
        then str_slice s s0 sub e0 1
        else str_slice s s0 e0

//: str_trim: 前後の ASCII 空白を取り除く
//:
//: [目的/もくてき]:
//: - 先頭と末尾の space/tab/LF/CR を除いた文字列を返します。
//:
//: [実装/じっそう]:
//: - 先頭側と末尾側から `string_byte_is_ascii_space` が true の位置を読み飛ばします。
//: - 範囲確認と raw read は `byte_index` module に閉じ、trim 側は範囲外を false とする predicate だけを使います。
//: - 最後に残った byte 範囲を `str_slice` で切り出します。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII のみです。
//: - allocation failure は `str_slice` の fallback に従って空文字列になり得ます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn str_trim %fn str str \s:
    let n %i32 len s;
    let mut start %i32 0;
    let mut end %i32 n;
    let mut done %i32 0;
    while eq done 0:
        do:
            if:
                lt start end
                then:
                    if:
                        string_byte_is_ascii_space s start
                        then set start %i32 add start 1
                        else set done 1
                else:
                    set done 1
    let mut done2 %i32 0;
    while eq done2 0:
        do:
            if:
                lt start end
                then:
                    let idx %i32 sub end 1;
                    if:
                        string_byte_is_ascii_space s idx
                        then set end %i32 sub end 1
                        else set done2 1
                else:
                    set done2 1
    str_slice s start end
