//: # string/slice/trim
//: ASCII trim / CR suffix trim
//:
//: [目的/もくてき]:
//: - byte scanner と parser で使う ASCII trim helper を所有します。
//: - slice construction は `slice/byte` に委譲し、trim 固有の scan だけをこの module に閉じます。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII space/tab/LF/CR のみです。

#indent 4

#import "core/math/i32" as *
#import "core/math/bool" as *
#import "alloc/string/access" as *
#import "alloc/string/byte_index" as *
#import "alloc/string/search/compare" as *
#import "./byte" as *

//: str_trim_suffix_cr: 末尾 CR を 1 byte だけ取り除く
//:
//: [目的/もくてき]:
//: - byte scanner で LF 直前まで切った CRLF 行から、残った CR を取り除きます。
//:
//: [注意/ちゅうい]:
//: - 末尾が CR でない場合は元の `str` を返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_trim_doc\" count=8 failed=0\nassertion index=0 status=ok kind=str_eq label=\"suffix cr removed\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"suffix without cr kept\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=2 status=ok kind=str_eq label=\"slice suffix cr removed\" expected=\"bcd\" actual=\"bcd\" message=\"\"\nassertion index=3 status=ok kind=str_eq label=\"slice clamps low start\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=4 status=ok kind=str_eq label=\"ascii whitespace trimmed\" expected=\"abc\" actual=\"abc\" message=\"\"\nassertion index=5 status=ok kind=str_eq label=\"interior space kept\" expected=\"a b\" actual=\"a b\" message=\"\"\nassertion index=6 status=ok kind=str_eq label=\"empty kept\" expected=\"\" actual=\"\" message=\"\"\nassertion index=7 status=ok kind=str_eq label=\"all ascii whitespace trimmed\" expected=\"\" actual=\"\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/string/slice/trim" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "string_trim_doc"
//:         |> test_report_push assert_str_eq "suffix cr removed" "abc" str_trim_suffix_cr "abc\r"
//:         |> test_report_push assert_str_eq "suffix without cr kept" "abc" str_trim_suffix_cr "abc"
//:         |> test_report_push assert_str_eq "slice suffix cr removed" "bcd" str_slice_trim_suffix_cr "abcd\r" 1 5
//:         |> test_report_push assert_str_eq "slice clamps low start" "abc" str_slice_trim_suffix_cr "abc\r" -3 4
//:         |> test_report_push assert_str_eq "ascii whitespace trimmed" "abc" str_trim " \tabc\r\n"
//:         |> test_report_push assert_str_eq "interior space kept" "a b" str_trim " a b "
//:         |> test_report_push assert_str_eq "empty kept" "" str_trim ""
//:         |> test_report_push assert_str_eq "all ascii whitespace trimmed" "" str_trim " \t\r\n"
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn str_trim_suffix_cr %fn str str \s:
    let n %i32 len s
    if:
        and gt n 0 string_byte_eq s sub n 1 '\r'
        then str_slice s 0 sub n 1
        else s

//: str_slice_trim_suffix_cr: 範囲切り出しと末尾 CR 除去を 1 回の str 構築にまとめる
//:
//: [目的/もくてき]:
//: - `str_trim_suffix_cr str_slice s start end` と同じ結果を、不要な中間 `str` を作らずに返します。
//:
//: [実装/じっそう]:
//: - `str_slice` と同じ境界丸めを行い、丸め後の末尾 byte が CR なら end を 1 byte 戻してから切り出します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 境界検査と失敗時 fallback は最終的な `str_slice` に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
pub fn str_slice_trim_suffix_cr %fn str fn i32 fn i32 str \s\start\end:
    let n %i32 len s
    let mut s0 %i32 start
    let mut e0 %i32 end
    if:
        lt s0 0
        then set s0 0
        else unit
    if:
        lt e0 s0
        then set e0 s0
        else unit
    if:
        lt n e0
        then set e0 n
        else unit
    if:
        and gt e0 s0 string_byte_eq s sub e0 1 '\r'
        then str_slice s s0 sub e0 1
        else str_slice s s0 e0

//: str_trim_left_index: 先頭側の ASCII 空白が終わる byte index を返す
//:
//: [目的/もくてき]:
//: - `str_trim` の先頭側 scan を独立させ、trim 本体が左右の scan と slice construction だけを接続できるようにします。
//:
//: [実装/じっそう]:
//: - `0` から `n` 未満を順に調べ、最初の非 ASCII 空白 byte の位置で停止します。
//: - すべて ASCII 空白であれば `n` を返します。
//:
//: [注意/ちゅうい]:
//: - `n` は通常 `len s` を渡します。範囲外 access の扱いは `str_byte_is_ascii_space_at` に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_trim_left_index %fn str fn i32 i32 \s\n:
    let mut start %i32 0;
    let mut done %i32 0;
    while eq done 0:
        do:
            if:
                lt start n
                then:
                    if:
                        str_byte_is_ascii_space_at s start
                        then set start %i32 add start 1
                        else set done 1
                else:
                    set done 1
    start

//: str_trim_right_index: 末尾側の ASCII 空白が始まる byte index を返す
//:
//: [目的/もくてき]:
//: - `str_trim` の末尾側 scan を独立させ、先頭側 scan で決まった `start` より前へ戻らない `end` を返します。
//:
//: [実装/じっそう]:
//: - `n` から 1 byte ずつ戻り、`start <= end` を保ちながら末尾の ASCII 空白を読み飛ばします。
//: - 残りが空になる場合は `start` を返します。
//:
//: [注意/ちゅうい]:
//: - `start` は通常 `str_trim_left_index s (len s)` の結果です。
//:
//: [計算量/けいさんりょう]:
//: - O(n - start)
fn str_trim_right_index %fn str fn i32 fn i32 i32 \s\start\n:
    let mut end %i32 n;
    let mut done %i32 0;
    while eq done 0:
        do:
            if:
                lt start end
                then:
                    let idx %i32 sub end 1;
                    if:
                        str_byte_is_ascii_space_at s idx
                        then set end %i32 sub end 1
                        else set done 1
                else:
                    set done 1
    end

//: str_trim: 前後の ASCII 空白を取り除く
//:
//: [目的/もくてき]:
//: - 先頭と末尾の space/tab/LF/CR を除いた文字列を返します。
//:
//: [実装/じっそう]:
//: - 先頭側 scan と末尾側 scan は private helper へ分けています。
//: - helper は `str_byte_is_ascii_space_at` が true の位置を読み飛ばし、最後に残った範囲を `str_slice` で切り出します。
//: - 範囲確認と raw read は `byte_index` module に閉じ、trim 側は範囲外を false とする predicate だけを使います。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII のみです。
//: - allocation failure は `str_slice` の fallback に従って空文字列になり得ます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn str_trim %fn str str \s:
    let n %i32 len s;
    let start %i32 str_trim_left_index s n;
    let end %i32 str_trim_right_index s start n;
    str_slice s start end
