//: # string/builder/append
//: StringBuilder の append 系 API
//:
//: [目的/もくてき]:
//: - `str`、`char`、ASCII、byte を builder buffer へ追加する処理を所有します。
//: - 実 storage 操作は `ByteBuilder` へ委譲し、StringBuilder は text API 境界だけを持ちます。
//:
//: [注意/ちゅうい]:
//: - `_result` API は失敗時に入力 builder を閉じて error text を返します。内部 `ByteBuilderError` は明示的に cleanup します。

#indent 4

#import "alloc/diag/error/types" as *
#import "alloc/io/bytebuilder" as *
#import "alloc/string/storage" as *
#import "alloc/string/access" as *
#import "core/mem" as *
#import "core/result" as *
#import "core/math" as *
#import "core/char" as *
#import "./types" as *
#import "./reserve" as *

//: sb_byte_builder_error_text: ByteBuilderError を StringBuilder の error text へ変換する
//:
//: [目的/もくてき]:
//: - ByteBuilder 層から戻った error payload の cleanup と、StringBuilder API が返す `str` error への変換を集約します。
//:
//: [注意/ちゅうい]:
//: - `e` に含まれる builder owner は必ずここで解放します。
fn sb_byte_builder_error_text %fn ByteBuilderError str \e:
    let kind %StdErrorKind byte_builder_error_kind &e
    byte_builder_error_free e
    string_builder_error kind

//: sb_append_non_empty_result: 非空文字列を builder へ追加する
//:
//: [目的/もくてき]:
//: - `sb_append_result` の空文字 fast path と、ByteBuilder へ委譲する非空 append path を分けます。
//: - `s` が非空であることは caller 側で確認済みとし、この関数は storage への append と error cleanup に集中します。
//:
//: [計算量/けいさんりょう]:
//: - O(len(s))。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
fn sb_append_non_empty_result %fn StringBuilder fn str Result StringBuilder str \sb\s:
    match byte_builder_push_str string_builder_into_byte_builder sb s:
        Result::Ok bytes:
            Result::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            Result::Err sb_byte_builder_error_text e

//: sb_append_result: builder に文字列片を追加する
//:
//: [目的/もくてき]:
//: - `s` の byte 列を builder の末尾へ copy し、更新後の builder を返します。
//:
//: [実装/じっそう]:
//: - source `str` の長さと data pointer の対応は `byte_builder_push_str` に閉じ、StringBuilder 側は raw pointer/length pair を直接組み立てません。
//:
//: [注意/ちゅうい]:
//: - `s` は source として参照されるだけで、builder は `str` owner を保持しません。
//: - `sb_append` は失敗時に空 builder fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(s))。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
pub fn sb_append_result %fn StringBuilder fn str Result StringBuilder str \sb\s:
    let s_len %i32 len s
    if:
        eq s_len 0
        then:
            Result::Ok sb
        else:
            sb_append_non_empty_result sb s

//: sb_append_char_result: builder に char を UTF-8 として追加する
//:
//: [目的/もくてき]:
//: - 1 つの `char` を UTF-8 bytes に encode し、builder の末尾へ追加します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
pub fn sb_append_char_result %fn StringBuilder fn char Result StringBuilder str \sb\c:
    match byte_builder_push_char_utf8 string_builder_into_byte_builder sb c:
        Result::Ok bytes:
            Result::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            let kind %StdErrorKind byte_builder_error_kind &e
            byte_builder_error_free e
            Result::Err string_builder_error kind

//: sb_append_ascii_result: builder に ASCII char を 1 byte として追加する
//:
//: [目的/もくてき]:
//: - protocol marker や lexer punctuation のように ASCII として決まっている文字だけを追加します。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `Err` です。入力 builder は失敗時に解放されます。
pub fn sb_append_ascii_result %fn StringBuilder fn char Result StringBuilder str \sb\c:
    if:
        char_is_ascii c
        then:
            match byte_builder_push_ascii string_builder_into_byte_builder sb c:
                Result::Ok bytes:
                    Result::Ok string_builder_from_byte_builder bytes
                Result::Err e:
                    let kind %StdErrorKind byte_builder_error_kind &e
                    byte_builder_error_free e
                    Result::Err string_builder_error kind
        else:
            string_builder_free sb
            Result::Err "string.builder non-ascii char"

//: sb_append_byte_result: builder に検証済みの 1 byte を追加する
//:
//: [目的/もくてき]:
//: - 既存の UTF-8 文字列や byte buffer から読んだ byte を、追加の `str` 確保なしで builder へ追加します。
//:
//: [注意/ちゅうい]:
//: - この関数は byte の UTF-8 妥当性を検証しません。呼び出し側は元の byte 列が UTF-8 として妥当であることを保証してください。
//: - `byte` が 0..255 の範囲外なら入力 builder を解放して `Err` を返します。
pub fn sb_append_byte_result %fn StringBuilder fn i32 Result StringBuilder str \sb\byte:
    if:
        or lt byte 0 gt byte 255
        then:
            string_builder_free sb
            Result::Err "string.builder invalid byte"
        else:
            match byte_builder_push_u8 string_builder_into_byte_builder sb byte:
                Result::Ok bytes:
                    Result::Ok string_builder_from_byte_builder bytes
                Result::Err e:
                    let kind %StdErrorKind byte_builder_error_kind &e
                    byte_builder_error_free e
                    Result::Err string_builder_error kind

//: sb_append_char: builder に char を UTF-8 として追加する互換 API
//:
//: ### [目的/もくてき]
//: - allocation error を扱わない既存 call site 向けに、`char` 追加後の builder を直接返します。
//:
//: ### [契約/けいやく]
//: - `sb` owner を消費し、成功時は `c` を UTF-8 bytes として末尾へ追加した builder owner を返します。
//: - 失敗時は `sb_append_char_result` が入力 owner を閉じ、この helper は allocation を持たない空 builder を返します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `sb_append_char_result` の `Result` を `match` し、`Result::Err` を空 builder fallback に畳みます。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(1) です。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"sb_append_char_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"char append\" expected=\"AZ\" actual=\"AZ\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/string/builder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let text %str:
//:         string_builder_new
//:         |> sb_append_char 'A'
//:         |> sb_append_char 'Z'
//:         |> sb_build
//:     let report:
//:         test_report_new "sb_append_char_doc"
//:         |> test_report_push assert_str_eq "char append" "AZ" text
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn sb_append_char %fn StringBuilder fn char StringBuilder \sb\c:
    match sb_append_char_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

//: sb_append_ascii: builder に ASCII char を 1 byte として追加する互換 API
//:
//: ### [目的/もくてき]
//: - punctuation や protocol marker など、ASCII として決まっている文字を 1 byte で追加します。
//:
//: ### [契約/けいやく]
//: - `sb` owner を消費し、ASCII `c` なら byte 値を末尾へ追加した builder owner を返します。
//: - 非 ASCII または allocation failure では、入力 owner を閉じた上で空 builder fallback を返します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - ASCII 判定と error cleanup は `sb_append_ascii_result` に委譲し、この helper は `Result` を空 builder fallback に畳みます。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(1) です。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"sb_append_ascii_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"ascii char\" expected=\"!\" actual=\"!\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"non ascii fallback\" expected=\"\" actual=\"\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/string/builder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let ok_text %str:
//:         string_builder_new
//:         |> sb_append_ascii '!'
//:         |> sb_build
//:     let rejected %str:
//:         string_builder_new
//:         |> sb_append_ascii 'あ'
//:         |> sb_build
//:     let report:
//:         test_report_new "sb_append_ascii_doc"
//:         |> test_report_push assert_str_eq "ascii char" "!" ok_text
//:         |> test_report_push assert_str_eq "non ascii fallback" "" rejected
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn sb_append_ascii %fn StringBuilder fn char StringBuilder \sb\c:
    match sb_append_ascii_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

//: sb_append_byte: builder に検証済み byte を追加する互換 API
//:
//: ### [目的/もくてき]
//: - 既に UTF-8 として妥当な source から読んだ byte を、一時 `str` を作らず builder へ追加します。
//:
//: ### [契約/けいやく]
//: - `byte` が 0..255 なら 1 byte を末尾へ追加した builder owner を返します。
//: - 範囲外 byte または allocation failure では、入力 owner を閉じた上で空 builder fallback を返します。
//: - UTF-8 妥当性はこの helper では検査しません。最終的な `sb_build` が UTF-8 として検証します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `sb_append_byte_result` の `Result` を `match` し、`Result::Err` を空 builder fallback に畳みます。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(1) です。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"sb_append_byte_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"byte text\" expected=\"AZ\" actual=\"AZ\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"invalid byte fallback\" expected=\"\" actual=\"\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/string/builder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let text %str:
//:         string_builder_new
//:         |> sb_append_byte 65
//:         |> sb_append_byte 90
//:         |> sb_build
//:     let invalid %str:
//:         string_builder_new
//:         |> sb_append_byte 256
//:         |> sb_build
//:     let report:
//:         test_report_new "sb_append_byte_doc"
//:         |> test_report_push assert_str_eq "byte text" "AZ" text
//:         |> test_report_push assert_str_eq "invalid byte fallback" "" invalid
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn sb_append_byte %fn StringBuilder fn i32 StringBuilder \sb\byte:
    match sb_append_byte_result sb byte:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

//: sb_append: builder に str を追加する互換 API
//:
//: ### [目的/もくてき]
//: - allocation error を扱わない既存 call site 向けに、`str` 片を追加した builder を直接返します。
//:
//: ### [契約/けいやく]
//: - `sb` owner を消費し、成功時は `s` の UTF-8 byte 列を末尾へ copy した builder owner を返します。
//: - `s` owner は保持しません。失敗時は `sb_append_result` が入力 builder owner を閉じ、この helper は空 builder fallback を返します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `sb_append_result` の `Result` を `match` し、`Result::Err` を空 builder fallback に畳みます。
//:
//: ### [計算量/けいさんりょう]
//: - O(len(s))。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"sb_append_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"append str\" expected=\"core/gui\" actual=\"core/gui\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/string/builder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let text %str:
//:         string_builder_new
//:         |> sb_append "core"
//:         |> sb_append "/gui"
//:         |> sb_build
//:     let report:
//:         test_report_new "sb_append_doc"
//:         |> test_report_push assert_str_eq "append str" "core/gui" text
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn sb_append %fn StringBuilder fn str StringBuilder \sb\s:
    match sb_append_result sb s:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty
