//: # string/builder/append
//: StringBuilder の append 系 API
//:
//: [目的/もくてき]:
//: - `str`、`char`、ASCII、byte を builder buffer へ追加する処理を所有します。
//: - 実 storage 操作は `ByteBuilder` へ委譲し、StringBuilder は text API 境界だけを持ちます。
//:
//: [注意/ちゅうい]:
//: - `_result` API は失敗時に入力 builder を解放し、owner を残しません。

#indent 4

#import "alloc/io/bytebuilder" as *
#import "alloc/string/storage" as *
#import "alloc/string/access" as *
#import "core/mem" as *
#import "core/result" as *
#import "core/math" as *
#import "core/char" as *
#import "./types" as *
#import "./reserve" as *

//: sb_append_result: builder に文字列片を追加する
//:
//: [目的/もくてき]:
//: - `s` の byte 列を builder の末尾へ copy し、更新後の builder を返します。
//:
//: [実装/じっそう]:
//: - source `str` の data pointer は borrow view として扱い、copy と grow は `byte_builder_push_bytes_ref` に委譲します。
//:
//: [注意/ちゅうい]:
//: - `s` は source として参照されるだけで、builder は `str` owner を保持しません。
//: - `sb_append` は失敗時に空 builder fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(s))。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
pub fn sb_append_result <(StringBuilder,str)->Result<StringBuilder,str>> (sb, s):
    let s_len <i32> len s
    if:
        eq s_len 0
        then:
            Result<StringBuilder,str>::Ok sb
        else:
            let src <MemPtr<u8>> string_data_ptr s
            match byte_builder_push_bytes_ref string_builder_into_byte_builder sb &src s_len:
                Result::Ok bytes:
                    Result<StringBuilder,str>::Ok string_builder_from_byte_builder bytes
                Result::Err e:
                    Result<StringBuilder,str>::Err string_builder_error e

//: sb_append_char_result: builder に char を UTF-8 として追加する
//:
//: [目的/もくてき]:
//: - 1 つの `char` を UTF-8 bytes に encode し、builder の末尾へ追加します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
pub fn sb_append_char_result <(StringBuilder,char)->Result<StringBuilder,str>> (sb, c):
    match byte_builder_push_char_utf8 string_builder_into_byte_builder sb c:
        Result::Ok bytes:
            Result<StringBuilder,str>::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            Result<StringBuilder,str>::Err string_builder_error e

//: sb_append_ascii_result: builder に ASCII char を 1 byte として追加する
//:
//: [目的/もくてき]:
//: - protocol marker や lexer punctuation のように ASCII として決まっている文字だけを追加します。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `Err` です。入力 builder は失敗時に解放されます。
pub fn sb_append_ascii_result <(StringBuilder,char)->Result<StringBuilder,str>> (sb, c):
    if:
        char_is_ascii c
        then:
            match byte_builder_push_ascii string_builder_into_byte_builder sb c:
                Result::Ok bytes:
                    Result<StringBuilder,str>::Ok string_builder_from_byte_builder bytes
                Result::Err e:
                    Result<StringBuilder,str>::Err string_builder_error e
        else:
            string_builder_free sb
            Result<StringBuilder,str>::Err "string.builder non-ascii char"

//: sb_append_byte_result: builder に検証済みの 1 byte を追加する
//:
//: [目的/もくてき]:
//: - 既存の UTF-8 文字列や byte buffer から読んだ byte を、追加の `str` 確保なしで builder へ追加します。
//:
//: [注意/ちゅうい]:
//: - この関数は byte の UTF-8 妥当性を検証しません。呼び出し側は元の byte 列が UTF-8 として妥当であることを保証してください。
//: - `byte` が 0..255 の範囲外なら入力 builder を解放して `Err` を返します。
pub fn sb_append_byte_result <(StringBuilder,i32)->Result<StringBuilder,str>> (sb, byte):
    if:
        or lt byte 0 gt byte 255
        then:
            string_builder_free sb
            Result<StringBuilder,str>::Err "string.builder invalid byte"
        else:
            match byte_builder_push_u8 string_builder_into_byte_builder sb byte:
                Result::Ok bytes:
                    Result<StringBuilder,str>::Ok string_builder_from_byte_builder bytes
                Result::Err e:
                    Result<StringBuilder,str>::Err string_builder_error e

pub fn sb_append_char <(StringBuilder,char)->StringBuilder> (sb, c):
    match sb_append_char_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

pub fn sb_append_ascii <(StringBuilder,char)->StringBuilder> (sb, c):
    match sb_append_ascii_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

pub fn sb_append_byte <(StringBuilder,i32)->StringBuilder> (sb, byte):
    match sb_append_byte_result sb byte:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

pub fn sb_append <(StringBuilder,str)->StringBuilder> (sb, s):
    match sb_append_result sb s:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty
