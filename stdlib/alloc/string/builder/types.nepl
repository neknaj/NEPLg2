//: # string/builder/types
//: StringBuilder の text builder owner 型と基本操作
//:
//: [目的/もくてき]:
//: - `StringBuilder` を UTF-8 文字列構築専用の owner state として定義します。
//: - byte buffer の free obligation は `ByteBuilder` に集約し、StringBuilder 固有の raw `MemPtr` field を持たせません。
//:
//: [注意/ちゅうい]:
//: - StringBuilder は text API の境界です。binary byte列をそのまま扱う場合は `ByteBuilder` / `ByteBuf` を使います。

#indent 4

#import "alloc/io/bytebuilder" as *
#import "core/field" as *

//: StringBuilder: 複数の str 片を byte buffer に追加して最後に 1 つへまとめる
//:
//: [目的/もくてき]:
//: - lexer/parser/diagnostics のように小さな文字列片を段階的に集め、最後に 1 つの `str` として出力します。
//:
//: [実装/じっそう]:
//: - 内部 storage owner は `ByteBuilder` が保持します。
//: - StringBuilder は UTF-8 文字列構築 API としての型境界だけを持ち、raw pointer owner state を重複して持ちません。
//:
//: [注意/ちゅうい]:
//: - builder は `Copy` / `Clone` ではありません。append/build 系 API は builder owner を消費します。
//: - allocation failure を扱う処理では `_result` suffix の API を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - state access は O(1) です。
pub struct StringBuilder:
    bytes <ByteBuilder>

//: string_builder_empty: allocation を持たない空 builder を作る
//:
//: [目的/もくてき]:
//: - allocation failure 時の fallback や、capacity 0 の内部状態として使う空 builder を作ります。
//:
//: [実装/じっそう]:
//: - `ByteBuilder` の空 state をそのまま保持します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_builder_empty <()->StringBuilder> ():
    StringBuilder byte_builder_empty

//: string_builder_from_byte_builder: ByteBuilder owner を text builder 境界へ包む
//:
//: [目的/もくてき]:
//: - byte storage owner は `ByteBuilder` に置いたまま、以後の操作を UTF-8 text builder API として扱います。
//:
//: [注意/ちゅうい]:
//: - `bytes` の内容は最終的に `sb_build_result` で UTF-8 として検証されます。
pub fn string_builder_from_byte_builder <(ByteBuilder)->StringBuilder> (bytes):
    StringBuilder bytes

//: string_builder_len_ref: builder の現在の byte 長を参照から読む
//:
//: [目的/もくてき]:
//: - `StringBuilder` owner を消費せず、syscall や serializer が必要とする byte 長だけを読みます。
//:
//: [注意/ちゅうい]:
//: - 返すのは UTF-8 文字数ではなく、内部 buffer の有効 byte 数です。
pub fn string_builder_len_ref <(&StringBuilder)->i32> (sb):
    let bytes_ref <&ByteBuilder> get_ref sb "bytes"
    *get_ref bytes_ref "len"

//: string_builder_data_ptr_ref: builder の byte buffer 先頭を非所有 pointer view として借りる
//:
//: [目的/もくてき]:
//: - WASI syscall など、`str` owner へ確定せず byte buffer を読む境界へ渡すための pointer view を作ります。
//:
//: [注意/ちゅうい]:
//: - 返る `MemPtr<u8>` は non-owning view です。free obligation は引き続き `StringBuilder` 内の `ByteBuilder` が持ちます。
//: - 呼び出し側は元の builder を解放または build するまで有効な一時 view としてだけ扱ってください。
pub fn string_builder_data_ptr_ref <(&StringBuilder)->MemPtr<u8>> (sb):
    let bytes_ref <&ByteBuilder> get_ref sb "bytes"
    byte_builder_data_ptr_ref bytes_ref

//: string_builder_ptr_ref: 空でない builder の byte buffer pointer view を返す
//:
//: [目的/もくてき]:
//: - empty builder では syscall に渡せる pointer がないため `None` として扱います。
//:
//: [注意/ちゅうい]:
//: - `Some` の中身は non-owning view であり、owner ではありません。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/builder" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match string_builder_new_result ():
//:         Result::Err _e:
//:             1
//:         Result::Ok b0:
//:             match sb_append_result b0 "abc":
//:                 Result::Err _e:
//:                     2
//:                 Result::Ok b1:
//:                     let len0 <i32> string_builder_len_ref &b1
//:                     let has_ptr <bool> match string_builder_ptr_ref &b1:
//:                         Option::Some _ptr:
//:                             true
//:                         Option::None:
//:                             false
//:                     string_builder_free b1
//:                     if and eq len0 3 has_ptr 0 3
//: ```
pub fn string_builder_ptr_ref <(&StringBuilder)->Option<MemPtr<u8>>> (sb):
    let bytes_ref <&ByteBuilder> get_ref sb "bytes"
    byte_builder_ptr_ref bytes_ref

//: string_builder_into_byte_builder: text builder から byte owner を取り出す
//:
//: [目的/もくてき]:
//: - append/build の内部実装が、StringBuilder 固有の raw field ではなく `ByteBuilder` API を使うための境界です。
//:
//: [注意/ちゅうい]:
//: - この関数は StringBuilder owner を消費します。呼び出し後に元の builder を再利用しないでください。
pub fn string_builder_into_byte_builder <(StringBuilder)->ByteBuilder> (sb):
    get sb "bytes"

//: string_builder_free: builder が保持する byte buffer を解放する
//:
//: [目的/もくてき]:
//: - `StringBuilder` owner を消費し、内部 `ByteBuilder` の cleanup 境界へ委譲します。
//:
//: [計算量/けいさんりょう]:
//: - allocator に依存します。
pub fn string_builder_free <(StringBuilder)->()> (sb):
    byte_builder_free string_builder_into_byte_builder sb
