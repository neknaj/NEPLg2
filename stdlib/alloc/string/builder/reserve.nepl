//: # string/builder/reserve
//: StringBuilder の capacity 計算と grow
//:
//: [目的/もくてき]:
//: - StringBuilder の capacity 管理を `ByteBuilder` の owner-preserving grow API へ委譲します。
//: - text builder 側は error を `str` に正規化するだけで、raw storage owner を持ちません。
//:
//: [注意/ちゅうい]:
//: - 現行 StringBuilder result API は失敗時に入力 builder を閉じて error text を返します。内部 `ByteBuilderError` は明示的に cleanup してから `str` error へ変換します。

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io/bytebuilder" as *
#import "core/result" as *
#import "./types" as *

//: string_builder_error: ByteBuilder の標準 error kind を StringBuilder の error text に写す
//:
//: [目的/もくてき]:
//: - StringBuilder の既存 Result API は `str` error を返すため、内部 byte builder の enum error をここで正規化します。
//:
//: [注意/ちゅうい]:
//: - 分岐は `StdErrorKind` の全 variant を明示し、enum 追加時に match の網羅性検査が効く形を維持します。
pub fn string_builder_error %fn StdErrorKind str \kind:
    match kind:
        StdErrorKind::Failure:
            "string.builder failure"
        StdErrorKind::OutOfMemory:
            "string.builder allocation failed"
        StdErrorKind::EmptyCollection:
            "string.builder invalid operation"
        StdErrorKind::IndexOutOfBounds:
            "string.builder invalid operation"
        StdErrorKind::KeyNotFound:
            "string.builder invalid operation"
        StdErrorKind::CapacityExceeded:
            "string.builder capacity exceeded"
        StdErrorKind::InvalidOperation:
            "string.builder invalid operation"
        StdErrorKind::InvalidUtf8:
            "string.builder invalid utf8"
        StdErrorKind::ParseError:
            "string.builder parse error"
        StdErrorKind::IoError:
            "string.builder io error"
        StdErrorKind::Other:
            "string.builder error"

//: string_builder_next_capacity: append に必要な次 capacity を計算する
//:
//: [目的/もくてき]:
//: - 現在 capacity と必要 byte 数から、growth 後の capacity を求めます。
//:
//: [計算量/けいさんりょう]:
//: - O(log needed)
pub fn string_builder_next_capacity %fn i32 fn i32 Result i32 str \cap\needed:
    match byte_builder_next_capacity cap needed:
        Result::Ok next:
            Result::Ok next
        Result::Err e:
            Result::Err string_builder_error e

//: string_builder_with_capacity_result: 指定 capacity の builder を作る
//:
//: [目的/もくてき]:
//: - 呼び出し側が初期 capacity を選べる形で `StringBuilder` を初期化します。
//:
//: [実装/じっそう]:
//: - 確保と owner state は `byte_builder_with_capacity` に委譲します。
//:
//: [注意/ちゅうい]:
//: - capacity は byte 数です。負数は `Result::Err` になります。
pub fn string_builder_with_capacity_result %fn i32 Result StringBuilder str \capacity:
    match byte_builder_with_capacity capacity:
        Result::Ok bytes:
            Result::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            Result::Err string_builder_error e

//: string_builder_reserve_result: append 前に必要 byte capacity を確保する
//:
//: [目的/もくてき]:
//: - 追加予定 byte 数を受け取り、builder buffer が必要 capacity を持つようにします。
//:
//: [実装/じっそう]:
//: - grow と cleanup は `byte_builder_reserve` に委譲します。
pub fn string_builder_reserve_result %fn StringBuilder fn i32 Result StringBuilder str \sb\additional:
    match byte_builder_reserve string_builder_into_byte_builder sb additional:
        Result::Ok bytes:
            Result::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            let kind %StdErrorKind byte_builder_error_kind &e
            byte_builder_error_free e
            Result::Err string_builder_error kind

//: string_builder_new_result: 空の StringBuilder を作る
//:
//: [目的/もくてき]:
//: - 既定 capacity の byte buffer を持つ builder を初期化します。
//:
//: [注意/ちゅうい]:
//: - `string_builder_new` は失敗時に空 builder fallback を返します。
pub fn string_builder_new_result %fn unit Result StringBuilder str \unit:
    match byte_builder_new:
        Result::Ok bytes:
            Result::Ok string_builder_from_byte_builder bytes
        Result::Err e:
            Result::Err string_builder_error e

pub fn string_builder_new %fn unit StringBuilder \unit:
    match string_builder_new_result:
        Result::Ok sb:
            sb
        Result::Err _e:
            string_builder_empty
