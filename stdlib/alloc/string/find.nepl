//: find: string の Option-returning byte search helper
//:
//: [目的/もくてき]:
//: - pattern が最初に現れる byte index を `Option i32` として返します。
//: - numeric sentinel ではなく `Option` で存在有無を表します。
//:
//: [注意/ちゅうい]:
//: - 戻り値は UTF-8 文字数ではなく byte index です。

#indent 4

#import "core/option" as *
#import "core/math" as *
#import "alloc/string/access" as *
#import "alloc/string/search" as *

//: find: 最初に一致した byte index を返す
//:
//: [目的/もくてき]:
//: - `s` の中に `pat` が最初に出る byte index を `Option i32` で返します。
//: - 見つからない場合は `Option::None` を返します。
//:
//: [実装/じっそう]:
//: - 空 pattern は先頭一致として `Some(0)` を返します。
//: - pattern が入力より長い場合は探索せず `None` を返します。
//: - それ以外は開始位置を前から進め、各位置で `str_eq_at` により byte 列を比較します。
//:
//: [注意/ちゅうい]:
//: - 戻り値は UTF-8 文字数ではなく byte index です。
//: - Unicode 正規化や文字境界検査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - n を `s` の byte 長、m を `pat` の byte 長として O((n - m + 1) * m) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"string_find_doc\" count=6 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"empty pattern\" expected=\"0\" actual=\"0\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"prefix\" expected=\"0\" actual=\"0\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"middle\" expected=\"2\" actual=\"2\" message=\"\"\nassertion index=3 status=ok kind=eq_i32 label=\"suffix\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=4 status=ok kind=bool label=\"missing pattern\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=5 status=ok kind=bool label=\"longer pattern\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/option" as *
//:| #import "std/test" as *
//:| #import "core/result" as *
//: fn expect_find_some %impure fn str impure fn Option i32 impure fn i32 TestAssertion \label\got\expected:
//:     match got:
//:         Option::Some actual:
//:             assert_eq_i32 label expected actual
//:         Option::None:
//:             test_assertion_failed AssertionKind::EqI32 label from_i32 expected "None" "expected Some index"
//:
//: fn main %impure fn void i32 \void:
//:     let missing %Option i32 find "abc" "z"
//:     let longer %Option i32 find "ab" "abc"
//:     let report:
//:         test_report_new "string_find_doc"
//:         |> test_report_push expect_find_some "empty pattern" find "abc" "" 0
//:         |> test_report_push expect_find_some "prefix" find "abc" "ab" 0
//:         |> test_report_push expect_find_some "middle" find "abcabc" "ca" 2
//:         |> test_report_push expect_find_some "suffix" find "abc" "bc" 1
//:         |> test_report_push assert "missing pattern" is_none missing
//:         |> test_report_push assert "longer pattern" is_none longer
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn find %fn str fn str Option i32 \s\pat:
    let s_len %i32 len s;
    let pat_len %i32 len pat;
    if:
        eq pat_len 0
        then some 0
        else:
            if:
                lt s_len pat_len
                then none
                else:
                    let last_start %i32 sub s_len pat_len;
                    let mut start %i32 0;
                    let mut out %Option i32 none;
                    let mut searching %bool true;
                    while and searching le start last_start:
                        do:
                            if:
                                str_eq_at s pat start pat_len 0
                                then:
                                    set out some start;
                                    set searching false;
                                else:
                                    set start add start 1;
                    out
