//: # string/byte_index
//: checked byte index witness による string byte access 境界
//:
//: [目的/もくてき]:
//: - `str` の byte index が `0 <= idx < len(s)` を満たすことを、private `StringByteIndex` witness として表します。
//: - raw string layout read は、この witness を受け取る関数だけに閉じます。
//: - root `alloc/string` facade からは再公開せず、通常利用者は `byte_at` を使います。
//:
//: [注意/ちゅうい]:
//: - `StringByteIndex` の constructor は private です。caller は `checked_string_byte_index` の結果を match してだけ witness を得られます。
//: - 任意の `i32` index から byte を読む入口は `Option` を返す checked API に閉じ、範囲外を trap で隠しません。

#indent 4

#import "alloc/string/access" as string_access
#import "core/field" as field
#import "core/math" as *
#import "core/mem/raw" as *
#import "core/option" as *

//: StringByteIndex: `str` の範囲内 byte index であることを表す private witness
//:
//: [目的/もくてき]:
//: - raw layout read に渡す index が、checked factory を通った値であることを型で表します。
//:
//: [注意/ちゅうい]:
//: - public にしません。外部 module は constructor も field も直接使えません。
struct StringByteIndex:
    value %i32

//: checked_string_byte_index: byte index の範囲証明を作る
//:
//: [目的/もくてき]:
//: - `idx` が `0 <= idx < len(s)` を満たす場合だけ `StringByteIndex` witness を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/byte_index" as *
//:| #import "core/option" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     let ok0 %bool match checked_string_byte_index "AZ" 0:
//:         Option::Some proof:
//:             eq string_byte_at_checked "AZ" proof 'A'
//:         Option::None:
//:             false
//:     let ok1 %bool match checked_string_byte_index "AZ" 1:
//:         Option::Some proof:
//:             eq string_byte_at_checked "AZ" proof 'Z'
//:         Option::None:
//:             false
//:     let rejected %bool match checked_string_byte_index "AZ" 2:
//:         Option::Some proof:
//:             false
//:         Option::None:
//:             true
//:     if and ok0 and ok1 rejected 0 1
//: ```
pub fn checked_string_byte_index %fn str fn i32 Option StringByteIndex \s\idx:
    let n %i32 string_access::len s
    if:
        lt idx 0
        then:
            none<StringByteIndex>
        else:
            if:
                le n idx
                then:
                    none<StringByteIndex>
                else:
                    some<StringByteIndex> StringByteIndex idx

//: string_byte_index_value: private witness から byte index を取り出す
//:
//: [目的/もくてき]:
//: - raw read 実装だけが、証明済み index の数値表現を取り出せるようにします。
fn string_byte_index_value %fn StringByteIndex i32 \idx:
    field::get idx "value"

//: string_byte_access_addr: `str` の内部アドレスを byte index module 内部で取り出す
//:
//: [目的/もくてき]:
//: - witness を受け取った byte reader だけが、`str` の基底 raw address を使えるようにします。
fn string_byte_access_addr %fn str i32 \s:
    #intrinsic "str_addr" <> (s)

//: string_byte_at_checked: witness で証明済みの byte index を読む
//:
//: [目的/もくてき]:
//: - `checked_string_byte_index` が返した witness を要求し、任意の `i32` index から raw read できないようにします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn string_byte_at_checked %fn str fn StringByteIndex i32 \s\idx:
    let raw_idx %i32 string_byte_index_value idx
    load_u8 %i32 add string_byte_access_addr s %i32 add 4 raw_idx

//: checked_string_byte_at: 範囲確認済み byte を `Option` で読む
//:
//: [目的/もくてき]:
//: - 任意の `i32` index から byte を読む caller に、範囲証明の成功/失敗を `Option` として扱わせます。
//: - raw layout read は `StringByteIndex` witness を得られた場合だけ行います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/byte_index" as *
//:| #import "core/option" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     match checked_string_byte_at "AZ" 1:
//:         Option::Some b:
//:             if eq b 'Z' 0 1
//:         Option::None:
//:             1
//: ```
pub fn checked_string_byte_at %fn str fn i32 Option i32 \s\idx:
    match checked_string_byte_index s idx:
        Option::Some proof:
            some<i32> string_byte_at_checked s proof
        Option::None:
            none<i32>

//: string_byte_eq: byte index の値が期待 byte と一致するかを checked に判定する
//:
//: [目的/もくてき]:
//: - scanner / parser が `idx` の byte と ASCII marker を比較するとき、範囲外を `false` として扱います。
//: - caller が `StringByteIndex` を捨てて trap helper に戻らないよう、頻出の比較を汎用 checked helper に集約します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/byte_index" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if and string_byte_eq "AZ" 0 'A' not string_byte_eq "AZ" 2 'Z' 0 1
//: ```
pub fn string_byte_eq %fn str fn i32 fn i32 bool \s\idx\expected:
    match checked_string_byte_at s idx:
        Option::Some actual:
            eq actual expected
        Option::None:
            false

//: string_bytes_eq: 2 つの文字列 byte が同じかを checked に判定する
//:
//: [目的/もくてき]:
//: - byte 列比較 loop で両側の範囲証明を個別に扱い、どちらかが範囲外なら一致しないものとして返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/byte_index" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     if and string_bytes_eq "AZ" 0 "A" 0 not string_bytes_eq "AZ" 1 "A" 0 0 1
//: ```
pub fn string_bytes_eq %fn str fn i32 fn str fn i32 bool \a\a_idx\b\b_idx:
    match checked_string_byte_at a a_idx:
        Option::Some ba:
            match checked_string_byte_at b b_idx:
                Option::Some bb:
                    eq ba bb
                Option::None:
                    false
        Option::None:
            false

//: string_bytes_cmp: 2 つの文字列 byte を checked に比較する
//:
//: [目的/もくてき]:
//: - sort や辞書順比較で、両側の byte が存在することを確認した場合だけ `-1` / `0` / `1` を返します。
//: - どちらかが範囲外なら `Option::None` を返し、caller に不変条件違反の処理を明示させます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/byte_index" as *
//:| #import "core/option" as *
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     match string_bytes_cmp "A" 0 "Z" 0:
//:         Option::Some ord:
//:             if lt ord 0 0 1
//:         Option::None:
//:             1
//: ```
pub fn string_bytes_cmp %fn str fn i32 fn str fn i32 Option i32 \a\a_idx\b\b_idx:
    match checked_string_byte_at a a_idx:
        Option::Some ba:
            match checked_string_byte_at b b_idx:
                Option::Some bb:
                    if:
                        lt ba bb
                        then:
                            some<i32> -1
                        else:
                            if:
                                gt ba bb
                                then:
                                    some<i32> 1
                                else:
                                    some<i32> 0
                Option::None:
                    none<i32>
        Option::None:
            none<i32>
