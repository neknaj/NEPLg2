//: slice: string の UTF-8 slice / char traversal / trim helper
//:
//: [目的/もくてき]:
//: - UTF-8 boundary を守った byte slice、char 単位走査、ASCII trim helper を提供します。
//: - search/access/storage/utf8 の上に構成し、root から slice と char traversal の責務を分離します。
//:
//: [注意/ちゅうい]:
//: - `str_slice_result` の index は byte index です。char index ではありません。
//: - char 系 API は UTF-8 scalar value 単位で走査し、表示幅や grapheme cluster は扱いません。

#indent 4

#import "core/mem" as *
#import "core/result" as *
#import "core/math" as *
#import "core/char" as *
#import "core/field" as *
#import "alloc/string/access" as *
#import "alloc/string/search" as *
#import "alloc/string/storage" as *
#import "alloc/string/utf8" as *

//: str_trim_suffix_cr: 末尾 CR を 1 byte だけ取り除く
//:
//: [目的/もくてき]:
//: - byte scanner で LF 直前まで切った CRLF 行から、残った CR を取り除きます。
//:
//: [注意/ちゅうい]:
//: - 末尾が CR でない場合は元の `str` を返します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     if:
//:         str_eq "abc" str_trim_suffix_cr "abc\r"
//:         then:
//:             if:
//:                 str_eq "abc" str_trim_suffix_cr "abc"
//:                 then 0
//:                 else 1
//:         else 1
//: ```
fn str_trim_suffix_cr <(str)->str> (s):
    let n <i32> len s
    if:
        and gt n 0 eq string_byte_at_unchecked s sub n 1 '\r'
        then str_slice s 0 sub n 1
        else s

//: str_slice_trim_suffix_cr: 範囲切り出しと末尾 CR 除去を 1 回の str 構築にまとめる
//:
//: [目的/もくてき]:
//: - `str_trim_suffix_cr str_slice s start end` と同じ結果を、不要な中間 `str` を作らずに返します。
//:
//: [実装/じっそう]:
//: - `str_slice` と同じ境界丸めを行い、丸め後の末尾 byte が CR なら end を 1 byte 戻してから切り出します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 境界検査と失敗時 fallback は最終的な `str_slice` に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn str_slice_trim_suffix_cr <(str,i32,i32)->str> (s, start, end):
    let n <i32> len s
    let mut s0 <i32> start
    let mut e0 <i32> end
    if:
        lt s0 0
        then set s0 0
        else ()
    if:
        lt e0 s0
        then set e0 s0
        else ()
    if:
        lt n e0
        then set e0 n
        else ()
    if:
        and gt e0 s0 eq string_byte_at_unchecked s sub e0 1 '\r'
        then str_slice s s0 sub e0 1
        else str_slice s s0 e0

//: str_slice_result: UTF-8 境界に揃った byte 範囲を新しい str として切り出す
//:
//: [目的/もくてき]:
//: - `s[start..end]` の byte 範囲を copy した新しい `str` を返します。
//:
//: [実装/じっそう]:
//: - `start` は 0 未満なら 0 に、`end` は `start` 未満なら `start` に、`len(s)` より大きければ `len(s)` に丸めます。
//: - 丸め後の start/end が UTF-8 文字境界であることを確認してから、新しい `str` 領域へ copy します。
//:
//: [注意/ちゅうい]:
//: - index は byte index です。ただし `str` の UTF-8 不変条件を守るため、文字境界でない範囲は `Result::Err` にします。
//: - `str_slice` は失敗時に空文字列 fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn str_slice_result <(str,i32,i32)->Result<str,str>> (s, start, end):
    let n <i32> len s;
    let mut s0 <i32> start;
    let mut e0 <i32> end;
    if:
        lt s0 0
        then set s0 0
        else ()
    if:
        lt e0 s0
        then set e0 s0
        else ()
    if:
        lt n e0
        then set e0 n
        else ()
    let out_len <i32> sub e0 s0;
    if:
        and str_utf8_is_boundary s s0 str_utf8_is_boundary s e0
        then:
            string_from_mem_unchecked_result mem_ptr_add string_data_ptr s s0 out_len
        else:
            Result<str,str>::Err "string.slice invalid utf8 boundary"

fn str_slice <(str,i32,i32)->str> (s, start, end):
    match str_slice_result s start end:
        Result::Ok out:
            out
        Result::Err _e:
            ""

fn str_next_char_ok <(char,i32)->Result<CharUtf8Step,str>> (c, next_byte_index):
    Result<CharUtf8Step,str>::Ok char_utf8_step_new c next_byte_index

fn str_decode_char_result <(i32,i32)->Result<CharUtf8Step,str>> (code, next_byte_index):
    match char_from_i32_result code:
        Result::Err _e:
            Result<CharUtf8Step,str>::Err "string.char invalid scalar"
        Result::Ok c:
            str_next_char_ok c next_byte_index

//: str_next_char_result: byte offset から次の char と次 byte offset を読む
//:
//: [目的/もくてき]:
//: - `str` を byte index で保持したまま、UTF-8 の 1 scalar value だけを安全に decode します。
//:
//: [注意/ちゅうい]:
//: - `byte_index` は UTF-8 文字境界でなければなりません。
//: - 戻り値の `CharUtf8Step.value` が `char`、`CharUtf8Step.next` が次の byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn str_next_char_result <(str,i32)->Result<CharUtf8Step,str>> (s, byte_index):
    let n <i32> len s
    if:
        or lt byte_index 0 le n byte_index
        then:
            Result<CharUtf8Step,str>::Err "string.char index out of bounds"
        else:
            if:
                not str_utf8_is_boundary s byte_index
                then:
                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 boundary"
                else:
                    let b0 <i32> string_byte_at_unchecked s byte_index
                    if:
                        le b0 0x7F
                        then:
                            str_decode_char_result b0 add byte_index 1
                        else:
                            match string_utf8_lead_kind b0:
                                StringUtf8LeadKind::Ascii:
                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 leading byte"
                                StringUtf8LeadKind::Two:
                                    if:
                                        le n add byte_index 1
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            if:
                                                string_utf8_is_continuation b1
                                                then:
                                                    let hi <i32> shl and b0 0x1F 6
                                                    let lo <i32> and b1 0x3F
                                                    str_decode_char_result or hi lo add byte_index 2
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 continuation"
                                StringUtf8LeadKind::Three:
                                    if:
                                        le n add byte_index 2
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            let b2 <i32> string_byte_at_unchecked s add byte_index 2
                                            let first_ok <bool>:
                                                if:
                                                    eq b0 0xE0
                                                    then:
                                                        string_utf8_in_range b1 0xA0 0xBF
                                                    else:
                                                        if:
                                                            eq b0 0xED
                                                            then:
                                                                string_utf8_in_range b1 0x80 0x9F
                                                            else:
                                                                string_utf8_is_continuation b1
                                            if:
                                                and first_ok string_utf8_is_continuation b2
                                                then:
                                                    let part0 <i32> shl and b0 0x0F 12
                                                    let part1 <i32> shl and b1 0x3F 6
                                                    let part2 <i32> and b2 0x3F
                                                    str_decode_char_result or part0 or part1 part2 add byte_index 3
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 three-byte sequence"
                                StringUtf8LeadKind::Four:
                                    if:
                                        le n add byte_index 3
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            let b2 <i32> string_byte_at_unchecked s add byte_index 2
                                            let b3 <i32> string_byte_at_unchecked s add byte_index 3
                                            let first_ok <bool>:
                                                if:
                                                    eq b0 0xF0
                                                    then:
                                                        string_utf8_in_range b1 0x90 0xBF
                                                    else:
                                                        if:
                                                            eq b0 0xF4
                                                            then:
                                                                string_utf8_in_range b1 0x80 0x8F
                                                            else:
                                                                string_utf8_is_continuation b1
                                            if:
                                                and first_ok and string_utf8_is_continuation b2 string_utf8_is_continuation b3
                                                then:
                                                    let part0 <i32> shl and b0 0x07 18
                                                    let part1 <i32> shl and b1 0x3F 12
                                                    let part2 <i32> shl and b2 0x3F 6
                                                    let part3 <i32> and b3 0x3F
                                                    str_decode_char_result or part0 or part1 or part2 part3 add byte_index 4
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 four-byte sequence"
                                StringUtf8LeadKind::Invalid:
                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 leading byte"

//: str_char_count: `str` に含まれる Unicode scalar value 数を数える
//:
//: [注意/ちゅうい]:
//: - byte length ではありません。byte length が必要な場合は `str_byte_len` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_count <(str)->i32> (s):
    let n <i32> len s
    let mut byte_i <i32> 0
    let mut char_count <i32> 0
    let mut done <bool> false
    while and lt byte_i n not done:
        do:
            match str_next_char_result s byte_i:
                Result::Err _e:
                    set done true
                Result::Ok item:
                    let next <i32> get item "next";
                    set byte_i next;
                    let next_count <i32> add char_count 1;
                    set char_count next_count
    char_count

//: str_char_byte_index_result: char index を byte offset へ変換する
//:
//: [目的/もくてき]:
//: - char 単位 API の入口で、byte-oriented `str_slice_result` へ渡す offset を求めます。
//:
//: [注意/ちゅうい]:
//: - `char_index == str_char_count s` のときは末尾 byte offset を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_byte_index_result <(str,i32)->Result<i32,str>> (s, char_index):
    if:
        lt char_index 0
        then:
            Result<i32,str>::Err "string.char index out of bounds"
        else:
            let n <i32> len s
            let mut byte_i <i32> 0
            let mut char_i <i32> 0
            let mut failed <bool> false
            while and lt char_i char_index not failed:
                do:
                    if:
                        le n byte_i
                        then:
                            set failed true
                        else:
                            match str_next_char_result s byte_i:
                                Result::Err _e:
                                    set failed true
                                Result::Ok item:
                                    let next <i32> get item "next";
                                    set byte_i next;
                                    let next_char_i <i32> add char_i 1;
                                    set char_i next_char_i
            if:
                failed
                then:
                    Result<i32,str>::Err "string.char index out of bounds"
                else:
                    Result<i32,str>::Ok byte_i

//: str_char_at_result: char index で 1 つの char を読む
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_at_result <(str,i32)->Result<char,str>> (s, char_index):
    match str_char_byte_index_result s char_index:
        Result::Err e:
            Result<char,str>::Err e
        Result::Ok byte_i:
            if:
                le len s byte_i
                then:
                    Result<char,str>::Err "string.char index out of bounds"
                else:
                    match str_next_char_result s byte_i:
                        Result::Err e:
                            Result<char,str>::Err e
                        Result::Ok item:
                            let c <char> get item "value"
                            Result<char,str>::Ok c

//: str_slice_chars_result: char index 範囲を切り出す
//:
//: [目的/もくてき]:
//: - char index の半開区間 `[start_char, end_char)` を byte boundary へ変換し、新しい `str` として返します。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len + slice_byte_len)
fn str_slice_chars_result <(str,i32,i32)->Result<str,str>> (s, start_char, end_char):
    if:
        or lt start_char 0 lt end_char start_char
        then:
            Result<str,str>::Err "string.char invalid slice range"
        else:
            match str_char_byte_index_result s start_char:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok start_byte:
                    match str_char_byte_index_result s end_char:
                        Result::Err e:
                            Result<str,str>::Err e
                        Result::Ok end_byte:
                            str_slice_result s start_byte end_byte

//: str_starts_with_char: `str` が指定 char で始まるか判定する
fn str_starts_with_char <(str,char)->bool> (s, c):
    if:
        eq len s 0
        then:
            false
        else:
            match str_next_char_result s 0:
                Result::Err _e:
                    false
                Result::Ok item:
                    let first <char> get item "value"
                    eq char_to_i32 first char_to_i32 c

//: str_contains_char: `str` が指定 char を含むか char 単位で判定する
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_contains_char <(str,char)->bool> (s, c):
    let target <i32> char_to_i32 c
    let n <i32> len s
    let mut byte_i <i32> 0
    let mut found <bool> false
    let mut done <bool> false
    while and lt byte_i n not done:
        do:
            match str_next_char_result s byte_i:
                Result::Err _e:
                    set done true
                Result::Ok item:
                    let current <char> get item "value"
                    if:
                        eq char_to_i32 current target
                        then:
                            set found true;
                            set done true
                        else:
                            let next <i32> get item "next"
                            set byte_i next
    found

//: str_trim: 前後の ASCII 空白を取り除く
//:
//: [目的/もくてき]:
//: - 先頭と末尾の space/tab/LF/CR を除いた文字列を返します。
//:
//: [実装/じっそう]:
//: - 先頭側と末尾側から `str_is_space` が true の byte を読み飛ばします。
//: - 最後に残った byte 範囲を `str_slice` で切り出します。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII のみです。
//: - allocation failure は `str_slice` の fallback に従って空文字列になり得ます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_trim <(str)->str> (s):
    let n <i32> len s;
    let mut start <i32> 0;
    let mut end <i32> n;
    let mut done <i32> 0;
    while eq done 0:
        do:
            if:
                lt start end
                then:
                    let b <i32> string_byte_at_unchecked s start;
                    if:
                        str_is_space b
                        then set start <i32> add start 1
                        else set done 1
                else:
                    set done 1
    let mut done2 <i32> 0;
    while eq done2 0:
        do:
            if:
                lt start end
                then:
                    let idx <i32> sub end 1;
                    let b <i32> string_byte_at_unchecked s idx;
                    if:
                        str_is_space b
                        then set end <i32> sub end 1
                        else set done2 1
                else:
                    set done2 1
    str_slice s start end
