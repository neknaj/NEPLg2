//: # io/bytebuilder/types
//: ByteBuilder の型と owner-preserving helper
//:
//: [目的/もくてき]:
//: - growable byte builder の public state 型を定義します。
//: - storage owner を取り出して包み直さずに field 全体で移す helper をここへ集約します。
//:
//: [注意/ちゅうい]:
//: - 空 storage は enum の `Empty`、所有 storage は `Owned(region)` として表します。
//: - この module は raw memory operation を直接持ちません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/math" as *
//: fn main %fn void i32 \void:
//:     if eq byte_builder_len byte_builder_empty 0 1 0
//: ```

#indent 4

#import "alloc/diag/error/types" as *
#import "alloc/io/bytebuf" as *
#import "core/field" as *
#import "core/math/i32" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/option" as *

//: ## ByteBuilderStorage
//: `ByteBuilder` の storage owner state
//:
//: ### [目的/もくてき]
//: - allocation を[持/も]たない空 builder と、free obligation を[持/も]つ byte 領域を enum として[分/わ]けます。
//: - 空状態を zero-size `RegionToken` sentinel で[表/あらわ]さず、`match` の[網羅性/もうらせい]で cleanup と pointer projection の有無を[決/き]めます。
//: - `Owned` payload だけが storage owner token を[保持/ほじ]するため、空 builder と owner token の不正な組み合わせを source type で[表現/ひょうげん]できません。
pub enum ByteBuilderStorage:
    Empty
    Owned %RegionToken u8

//: ## ByteBuilder
//: growable な[所有/しょゆう] byte buffer builder
//:
//: ### [目的/もくてき]
//: - WASM binary emitter のように byte を[順番/じゅんばん]に[追加/ついか]する処理を、raw pointer や `Vec` [内部表現/ないぶひょうげん]へ[直接/ちょくせつ][依存/いそん]せずに[書/か]けるようにします。
//: - `finish` で `ByteBuf` を[返/かえ]し、`fs_write_to_bytes` や `stdio_write_bytes_result` へそのまま[渡/わた]せます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuilder` は[所有権/しょゆうけん]を[持/も]つので `Copy` / `Clone` を[実装/じっそう]しません。
//: - `push_*` / `reserve` / `finish` は builder を[消費/しょうひ]し、成功時は[新/あたら]しい builder または `ByteBuf` を[返/かえ]します。
//: - 失敗時は `ByteBuilderError` に builder owner を[戻/もど]し、caller が cleanup や[再試行/さいしこう]を[選/えら]べるようにします。
//: - `storage` は `ByteBuilderStorage::Empty` または `ByteBuilderStorage::Owned(region)` です。payload pointer が必要な処理は `Owned` branch の参照から非所有 view を取り出します。
pub struct ByteBuilder:
    storage %ByteBuilderStorage
    len %i32
    cap %i32

//: ## ByteBuilderError
//: owner-consuming builder API の[失敗/しっぱい] payload
//:
//: ### [目的/もくてき]
//: - `reserve` / `push_*` / `finish` が[消費/しょうひ]した `ByteBuilder` owner を `builder` に[戻/もど]します。
//: - `StdErrorKind` だけを[返/かえ]して内部で builder を[解放/かいほう]すると、failure path の owner transfer が API 型から[読/よ]めないため、この型で[明示/めいじ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/diag/error" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let invalid %i32 sub 0 1
//:     match byte_builder_reserve byte_builder_empty invalid:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err e:
//:             let kind %StdErrorKind byte_builder_error_kind &e
//:             byte_builder_error_free e
//:             match kind:
//:                 StdErrorKind::InvalidOperation:
//:                     0
//:                 StdErrorKind::OutOfMemory:
//:                     1
//:                 StdErrorKind::CapacityExceeded:
//:                     1
//:                 _:
//:                     1
//: ```
pub struct ByteBuilderError:
    builder %ByteBuilder
    error %StdErrorKind

//: ## ByteBuilderByteBufError
//: `ByteBuf` を[消費/しょうひ]する append の[失敗/しっぱい] payload
//:
//: ### [目的/もくてき]
//: - `byte_builder_push_bytebuf` は builder と input `ByteBuf` の 2 つの owner を[受/う]け[取/と]るため、失敗時は両方を error payload に[戻/もど]します。
//: - caller は `byte_builder_bytebuf_error_free` で両 owner を閉じるか、将来の retry API へこの payload を渡せます。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/diag/error" as *
//:| #import "alloc/io/bytebuf" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     // owner-backed error payload は ordinary source から直接構築できない。
//:     let invalid %StdErrorKind StdErrorKind::InvalidOperation
//:     let e %ByteBuilderByteBufError ByteBuilderByteBufError byte_builder_empty io_bytebuf_empty invalid
//:     let kind %StdErrorKind byte_builder_bytebuf_error_kind &e
//:     byte_builder_bytebuf_error_free e
//:     match kind:
//:         StdErrorKind::InvalidOperation:
//:             0
//:         _:
//:             1
//: ```
pub struct ByteBuilderByteBufError:
    builder %ByteBuilder
    bytes %ByteBuf
    error %StdErrorKind

//: byte_builder_error_kind: builder error の kind を借用して読む
//:
//: [目的/もくてき]:
//: - error payload から owner を動かさずに `StdErrorKind` だけを観測します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/diag/error" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let invalid %i32 sub 0 1
//:     match byte_builder_reserve byte_builder_empty invalid:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err e:
//:             let kind %StdErrorKind byte_builder_error_kind &e
//:             byte_builder_error_free e
//:             match kind:
//:                 StdErrorKind::InvalidOperation:
//:                     0
//:                 _:
//:                     1
//: ```
pub fn byte_builder_error_kind %fn &ByteBuilderError StdErrorKind \e:
    *get_ref e "error"

//: byte_builder_error_builder: builder error から owner を取り戻す
//:
//: [目的/もくてき]:
//: - caller が cleanup または retry を選ぶため、失敗 payload が保持している `ByteBuilder` owner を消費して返します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let invalid %i32 sub 0 1
//:     match byte_builder_reserve byte_builder_empty invalid:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err e:
//:             let b %ByteBuilder byte_builder_error_builder e
//:             byte_builder_free b
//:             0
//: ```
pub fn byte_builder_error_builder %fn ByteBuilderError ByteBuilder \e:
    get e "builder"

//: byte_builder_bytebuf_error_kind: bytebuf append error の kind を借用して読む
//:
//: [目的/もくてき]:
//: - builder owner と input `ByteBuf` owner を動かさずに、失敗理由だけを観測します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/diag/error" as *
//:| #import "alloc/io/bytebuf" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     // error payload は `byte_builder_push_bytebuf` の Err branch から得る。
//:     let invalid %StdErrorKind StdErrorKind::InvalidOperation
//:     let e %ByteBuilderByteBufError ByteBuilderByteBufError byte_builder_empty io_bytebuf_empty invalid
//:     let kind %StdErrorKind byte_builder_bytebuf_error_kind &e
//:     byte_builder_bytebuf_error_free e
//:     match kind:
//:         StdErrorKind::InvalidOperation:
//:             0
//:         _:
//:             1
//: ```
pub fn byte_builder_bytebuf_error_kind %fn &ByteBuilderByteBufError StdErrorKind \e:
    *get_ref e "error"

//: byte_builder_empty: storage を持たない空 builder を返す
//:
//: [目的/もくてき]:
//: - `ByteBuilderStorage::Empty` によって「解放責務が無い」空 storage を表します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。
pub fn byte_builder_empty %fn void ByteBuilder \void:
    ByteBuilder ByteBuilderStorage::Empty 0 0

//: byte_builder_from_owned_region: 所有 byte 領域 token を `ByteBuilder` に包む
//:
//: [目的/もくてき]:
//: - `alloc_region_bytes` / builder grow で得た owner token を builder 表現へ集約します。
//:
//: [注意/ちゅうい]:
//: - `cap0` は正でなければなりません。空 builder は `byte_builder_empty` を使ってください。
//: - 呼び出し後、`region` は返った builder が所有します。
pub fn byte_builder_from_owned_region %fn RegionToken u8 fn i32 fn i32 ByteBuilder \region\len0\cap0:
    ByteBuilder (ByteBuilderStorage::Owned region) len0 cap0

//: byte_builder_with_len: builder の storage owner を保ったまま length だけ更新する
//:
//: [目的/もくてき]:
//: - append が書き込みに成功したあと、`RegionToken u8` owner を取り出して包み直さず、field 全体を次の builder へ移します。
//:
//: [注意/ちゅうい]:
//: - `new_len` は `cap` 以下でなければなりません。capacity 確保は呼び出し前に `byte_builder_reserve` で済ませます。
pub fn byte_builder_with_len %fn ByteBuilder fn i32 ByteBuilder \builder\new_len:
    let cap0 %i32 get builder "cap"
    ByteBuilder get builder "storage" new_len cap0

//: byte_builder_data_ptr_ref: builder storage の非所有 pointer view を[得/え]る
//:
//: ### [目的/もくてき]
//: - append / fd write / finalization の内部境界で、`ByteBuilderStorage::Owned(region)` から byte 書き込み先の `MemPtr u8` view を[借/か]ります。
//:
//: ### [契約/けいやく]
//: - `ByteBuilderStorage::Owned(region)` では `region_ptr region` を[返/かえ]します。
//: - `ByteBuilderStorage::Empty` では sentinel view として `mem_ptr_wrap 0` を[返/かえ]します。
//: - 返った `MemPtr` は所有権を[持/も]ちません。解放や grow の責務は builder の `RegionToken` owner に残ります。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `storage` enum を `match` し、`Owned` branch だけで `RegionToken` から pointer view を[射影/しゃえい]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"byte_builder_data_ptr_ref_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"builder ptr projected\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let builder %ByteBuilder byte_builder_empty
//:     let _ptr byte_builder_data_ptr_ref &builder
//:     let report:
//:         test_report_new "byte_builder_data_ptr_ref_doc"
//:         |> test_report_push assert_eq_i32 "builder ptr projected" 1 1
//:     byte_builder_free builder
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn byte_builder_data_ptr_ref %fn &ByteBuilder MemPtr u8 \builder:
    let storage_ref %&ByteBuilderStorage get_ref builder "storage"
    match storage_ref:
        ByteBuilderStorage::Empty:
            mem_ptr_wrap 0
        ByteBuilderStorage::Owned region:
            region_ptr region

//: byte_builder_ptr_ref: capacity を[持/も]つ builder の pointer view を `Option` で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - 空 builder と確保済み builder を型付きに[分/わ]け、caller が raw address の 0 判定へ[依存/いそん]しないようにします。
//:
//: ### [契約/けいやく]
//: - `ByteBuilderStorage::Empty` または `cap <= 0` なら `Option::None` を[返/かえ]します。
//: - `Owned` storage かつ `cap > 0` なら `Option::Some ptr` を[返/かえ]します。
//: - `Some` の pointer は非所有 view です。free obligation は builder owner に残ります。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `cap` と `storage` enum を[確認/かくにん]し、`byte_builder_data_ptr_ref` へ委譲します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"byte_builder_ptr_ref_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"capacity ptr some\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let got_some %i32 match byte_builder_with_capacity 4:
//:         Result::Err _e:
//:             0
//:         Result::Ok builder:
//:             let value %i32 match byte_builder_ptr_ref &builder:
//:                 Option::Some _ptr:
//:                     1
//:                 Option::None:
//:                     0
//:             byte_builder_free builder
//:             value
//:     let report:
//:         test_report_new "byte_builder_ptr_ref_doc"
//:         |> test_report_push assert_eq_i32 "capacity ptr some" 1 got_some
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn byte_builder_ptr_ref %fn &ByteBuilder Option MemPtr u8 \builder:
    let cap0 %i32 *get_ref builder "cap"
    let storage_ref %&ByteBuilderStorage get_ref builder "storage"
    match storage_ref:
        ByteBuilderStorage::Empty:
            none
        ByteBuilderStorage::Owned _region:
            if:
                le cap0 0
                then:
                    none
                else:
                    some byte_builder_data_ptr_ref builder

//: byte_builder_len: builder に現在入っている byte 数を返す
//:
//: [目的/もくてき]:
//: - capacity ではなく、`finish` で有効 payload になる byte 数だけを返します。
//:
//: [注意/ちゅうい]:
//: - builder は by-value で受け取ります。後続でも使う場合は caller 側で所有権の流れを分けてください。
pub fn byte_builder_len %fn ByteBuilder i32 \builder:
    get builder "len"
