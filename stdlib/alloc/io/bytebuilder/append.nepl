//: # io/bytebuilder/append
//: ByteBuilder の append 系 API
//:
//: [目的/もくてき]:
//: - byte、ASCII、UTF-8 char、既存 byte buffer、LEB128 integer を builder 末尾へ追加します。
//: - capacity grow は `storage`、owner state は `types` に委譲します。
//:
//: [注意/ちゅうい]:
//: - 失敗時は `ByteBuilderError` に入力 builder owner を戻し、caller が cleanup や再試行を選べるようにします。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     match byte_builder_new:
//:         Result::Ok b0:
//:             match byte_builder_push_ascii b0 'A':
//:                 Result::Ok b1:
//:                     byte_builder_free b1
//:                     1
//:                 Result::Err e:
//:                     byte_builder_error_free e
//:                     0
//:         Result::Err _:
//:             0
//: ```

#indent 4

#import "alloc/diag/error/types" as *
#import "alloc/io/bytebuf" as *
#import "alloc/string/access" as *
#import "alloc/string/storage" as *
#import "core/char" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *
#import "./types" as *
#import "./storage" as *

//: byte_builder_push_u8: 1 byte を[末尾/まつび]へ[追加/ついか]する
//:
//: [目的/もくてき]:
//: - capacity を確保してから `store_u8` で末尾へ 1 byte 書き込みます。
pub fn byte_builder_push_u8 %fn ByteBuilder fn i32 Result ByteBuilder ByteBuilderError \builder\byte:
    match byte_builder_reserve builder 1:
        Result::Err e:
            Result::Err e
        Result::Ok reserved:
            let len0 %i32 get reserved "len"
            let cap0 %i32 *get_ref &reserved "cap"
            if:
                le cap0 0
                then:
                    Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation
                else:
                    let storage_ref %&ByteBuilderStorage get_ref &reserved "storage"
                    match storage_ref:
                        ByteBuilderStorage::Empty:
                            Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation
                        ByteBuilderStorage::Owned region:
                            let ptr %MemPtr u8 region_ptr region
                            match store_u8 mem_ptr_add ptr len0 byte:
                                Result::Ok _:
                                    Result::Ok byte_builder_with_len reserved add len0 1
                                Result::Err _e:
                                    Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation

//: byte_builder_push_ascii: ASCII char を 1 byte として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - text magic や delimiter など、意味が文字である byte を `char` として受け取ります。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `InvalidOperation` です。失敗時は `ByteBuilderError` に builder owner を戻します。
pub fn byte_builder_push_ascii %fn ByteBuilder fn char Result ByteBuilder ByteBuilderError \builder\c:
    if:
        char_is_ascii c
        then:
            byte_builder_push_u8 builder char_to_i32 c
        else:
            Result::Err ByteBuilderError builder StdErrorKind::InvalidOperation

//: byte_builder_push_utf8_tail: UTF-8 の後続 byte を追加する
//:
//: [目的/もくてき]:
//: - `byte_builder_push_char_utf8` が先頭 byte を書いたあと、文字長に応じて残りの byte を追加します。
//:
//: [注意/ちゅうい]:
//: - `count` は `char_utf8_len` から来る値を想定します。
pub fn byte_builder_push_utf8_tail %fn ByteBuilder fn char fn i32 Result ByteBuilder ByteBuilderError \builder\c\count:
    if:
        eq count 1
        then:
            Result::Ok builder
        else:
            match byte_builder_push_u8 builder char_utf8_byte1 c:
                Result::Err e:
                    Result::Err e
                Result::Ok b1:
                    if:
                        eq count 2
                        then:
                            Result::Ok b1
                        else:
                            match byte_builder_push_u8 b1 char_utf8_byte2 c:
                                Result::Err e:
                                    Result::Err e
                                Result::Ok b2:
                                    if:
                                        eq count 3
                                        then:
                                            Result::Ok b2
                                        else:
                                            byte_builder_push_u8 b2 char_utf8_byte3 c

//: byte_builder_push_char_utf8: char を UTF-8 bytes として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `StringBuilder` ではなく binary `ByteBuilder` に text character を追加したい場合の共通入口です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
pub fn byte_builder_push_char_utf8 %fn ByteBuilder fn char Result ByteBuilder ByteBuilderError \builder\c:
    let count %i32 char_utf8_len c
    match byte_builder_push_u8 builder char_utf8_byte0 c:
        Result::Err e:
            Result::Err e
        Result::Ok b0:
            byte_builder_push_utf8_tail b0 c count

//: byte_builder_push_bytes_ref: 参照 byte [列/れつ]を[末尾/まつび]へ[複製/ふくせい]する内部 helper
//:
//: [目的/もくてき]:
//: - typed public helper が source object から導出した pointer と byte 数を builder に追加します。
//:
//: [注意/ちゅうい]:
//: - source の[所有権/しょゆうけん]は[移動/いどう]しません。
fn byte_builder_push_bytes_ref %fn ByteBuilder fn &MemPtr u8 fn i32 Result ByteBuilder ByteBuilderError \builder\src\data_len:
    if:
        lt data_len 0
        then:
            Result::Err ByteBuilderError builder StdErrorKind::InvalidOperation
        else:
            if:
                eq data_len 0
                then:
                    Result::Ok builder
                else:
                    match byte_builder_reserve builder data_len:
                        Result::Err e:
                            Result::Err e
                        Result::Ok reserved:
                            let len0 %i32 get reserved "len"
                            let cap0 %i32 *get_ref &reserved "cap"
                            if:
                                le cap0 0
                                then:
                                    Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation
                                else:
                                    let storage_ref %&ByteBuilderStorage get_ref &reserved "storage"
                                    match storage_ref:
                                        ByteBuilderStorage::Empty:
                                            Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation
                                        ByteBuilderStorage::Owned region:
                                            let ptr %MemPtr u8 region_ptr region
                                            let dst %MemPtr u8 mem_ptr_add ptr len0
                                            match mem_copy<u8> dst *src data_len:
                                                Result::Ok _:
                                                    Result::Ok byte_builder_with_len reserved add len0 data_len
                                                Result::Err _e:
                                                    Result::Err ByteBuilderError reserved StdErrorKind::InvalidOperation

//: byte_builder_push_str: `str` 全体の byte 表現を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - caller が raw pointer と length を直接組み合わせず、`str` の長さから読み取り範囲を導出して builder に複製します。
//:
//: [注意/ちゅうい]:
//: - `str` の所有権は移動しません。
//: - 失敗時は `ByteBuilderError` に入力 builder owner を戻します。
pub fn byte_builder_push_str %fn ByteBuilder fn str Result ByteBuilder ByteBuilderError \builder\s:
    let s_len %i32 len s
    if:
        eq s_len 0
        then:
            Result::Ok builder
        else:
            let src %MemPtr u8 string_data_ptr s
            byte_builder_push_bytes_ref builder &src s_len

//: byte_builder_push_str_slice: `str` の byte 範囲を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `str` の byte 範囲 `[start, end)` を builder に複製します。
//: - `0 <= start <= end <= len(s)` を確認し、source pointer と copy length を同じ関数内で導出します。
//:
//: [注意/ちゅうい]:
//: - この helper は byte 範囲が UTF-8 文字境界かどうかを検査しません。text API は呼び出し前に `str_utf8_is_boundary` で確認してください。
//: - 範囲が不正な場合は `ByteBuilderError` に入力 builder owner を戻し、`InvalidOperation` を返します。
pub fn byte_builder_push_str_slice %fn ByteBuilder fn str fn i32 fn i32 Result ByteBuilder ByteBuilderError \builder\s\start\end:
    let n %i32 len s
    if:
        or lt start 0 or lt end start gt end n
        then:
            Result::Err ByteBuilderError builder StdErrorKind::InvalidOperation
        else:
            let data_len %i32 sub end start
            if:
                eq data_len 0
                then:
                    Result::Ok builder
                else:
                    let src %MemPtr u8 mem_ptr_add string_data_ptr s start
                    byte_builder_push_bytes_ref builder &src data_len

//: byte_builder_push_bytebuf: `ByteBuf` の[内容/ないよう]を[追加/ついか]して入力 buffer を[解放/かいほう]する
//:
//: [目的/もくてき]:
//: - owned `ByteBuf` の payload を builder へコピーし、入力 buffer の解放責務も閉じます。
pub fn byte_builder_push_bytebuf %fn ByteBuilder fn ByteBuf Result ByteBuilder ByteBuilderByteBufError \builder\bytes:
    let data_len %i32 io_bytebuf_len_ref &bytes
    if:
        le data_len 0
        then:
            io_bytebuf_free bytes
            Result::Ok builder
        else:
            let src %MemPtr u8 io_bytebuf_data_ptr_ref &bytes
            match byte_builder_push_bytes_ref builder &src data_len:
                Result::Ok next:
                    io_bytebuf_free bytes
                    Result::Ok next
                Result::Err e:
                    let kind %StdErrorKind byte_builder_error_kind &e
                    let returned %ByteBuilder byte_builder_error_builder e
                    Result::Err ByteBuilderByteBufError returned bytes kind

//: byte_builder_push_leb_u32: u32 LEB128 を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - WASM binary の section size、index、integer immediate を unsigned LEB128 で[書/か]き[込/こ]みます。
//:
//: [実装/じっそう]:
//: - 下位 7 bit を[出力/しゅつりょく]し、残りを unsigned shift で 7 bit ずつ[進/すす]めます。
pub fn byte_builder_push_leb_u32 %fn ByteBuilder fn i32 Result ByteBuilder ByteBuilderError \builder\value:
    let low %i32 and value 127
    let rest %i32 shr_u value 7
    let out %i32:
        if:
            eq rest 0
            then:
                low
            else:
                or low 128
    match byte_builder_push_u8 builder out:
        Result::Err e:
            Result::Err e
        Result::Ok next:
            if:
                eq rest 0
                then:
                    Result::Ok next
                else:
                    byte_builder_push_leb_u32 next rest
