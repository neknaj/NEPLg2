//: # io/bytebuilder/build
//: ByteBuilder から ByteBuf を確定する API
//: [目的/もくてき]:
//: - growable storage の capacity を隠し、exact-size の `ByteBuf` owner へ移します。
//: - char 1 つを UTF-8 `ByteBuf` へ変換する convenience API もここで提供します。
//: [注意/ちゅうい]:
//: - `finish` は builder を消費します。失敗時は `ByteBuilderError` に builder owner を戻します。
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match byte_builder_finish byte_builder_empty:
//:         Result::Ok _:
//:             1
//:         Result::Err e:
//:             byte_builder_error_free e
//:             0
//: ```

#indent 4

#import "alloc/diag/error/types" as *
#import "alloc/io/bytebuf" as *
#import "core/char" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/mem/allocator" as *
#import "core/math/i32" as *
#import "core/option" as *
#import "core/result" as *
#import "./types" as *
#import "./storage" as *
#import "./append" as *

//: byte_builder_finish: builder を exact-size の `ByteBuf` へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - growable builder の capacity を[隠/かく]し、`ByteBuf.region` が `ByteBuf.len` byte の[所有領域/しょゆうりょういき]だけを[持/も]つ invariant に[戻/もど]します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は caller が `io_bytebuf_free` で[解放/かいほう]してください。
pub fn byte_builder_finish %fn ByteBuilder Result ByteBuf ByteBuilderError \builder:
    let len0 %i32 get builder "len"
    let cap0 %i32 get builder "cap"
    let storage %ByteBuilderStorage get builder "storage"
    if:
        le len0 0
        then:
            match storage:
                ByteBuilderStorage::Empty:
                    Result::Ok io_bytebuf_empty
                ByteBuilderStorage::Owned region:
                    byte_builder_dealloc_owned_region region
                    Result::Ok io_bytebuf_empty
        else:
            match storage:
                ByteBuilderStorage::Empty:
                    Result::Err ByteBuilderError (ByteBuilder ByteBuilderStorage::Empty len0 cap0) StdErrorKind::InvalidOperation
                ByteBuilderStorage::Owned region:
                    if:
                        le cap0 0
                        then:
                            Result::Err ByteBuilderError (ByteBuilder (ByteBuilderStorage::Owned region) len0 cap0) StdErrorKind::InvalidOperation
                        else:
                            if:
                                eq len0 cap0
                                then:
                                    Result::Ok io_bytebuf_finish_region region len0
                                else:
                                    match byte_builder_realloc_region_or_keep region len0:
                                        Result::Ok next_region:
                                            Result::Ok io_bytebuf_finish_region next_region len0
                                        Result::Err e:
                                            let old_region %RegionToken u8 region_realloc_error_region<u8> e
                                            Result::Err ByteBuilderError (ByteBuilder (ByteBuilderStorage::Owned old_region) len0 cap0) StdErrorKind::OutOfMemory

//: io_bytebuf_from_char_utf8_result: char 1 つを UTF-8 `ByteBuf` へ encode する
//:
//: [目的/もくてき]:
//: - `char` を I/O や `std/text` の byte 境界へ渡すため、所有権付き `ByteBuf` として返します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は呼び出し側が `io_bytebuf_free` で解放してください。
pub fn io_bytebuf_from_char_utf8_result %fn char Result ByteBuf StdErrorKind \c:
    match byte_builder_with_capacity char_utf8_len c:
        Result::Err e:
            Result::Err e
        Result::Ok builder:
            match byte_builder_push_char_utf8 builder c:
                Result::Err e:
                    let kind %StdErrorKind byte_builder_error_kind &e
                    byte_builder_error_free e
                    Result::Err kind
                Result::Ok out:
                    match byte_builder_finish out:
                        Result::Ok bytes:
                            Result::Ok bytes
                        Result::Err e:
                            let kind %StdErrorKind byte_builder_error_kind &e
                            byte_builder_error_free e
                            Result::Err kind
