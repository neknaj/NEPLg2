//: # io/bytebuilder/storage
//: ByteBuilder の capacity 管理と storage 解放境界
//:
//: [目的/もくてき]:
//: - `ByteBuilder` の確保、再確保、解放を所有します。
//: - raw memory operation はこの module と append/build module に閉じ込めます。
//:
//: [注意/ちゅうい]:
//: - 失敗時は入力 builder の storage を解放し、所有権が残らない `Result::Err` を返します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match byte_builder_new:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err _:
//:             0
//: ```

#indent 4

#import "alloc/diag/error" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/allocator" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *
#import "./types" as *

//: byte_builder_with_capacity: 指定 capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - [見積/みつ]もり[済/ず]みの byte [数/すう]がある emitter で、最初の realloc を[避/さ]けます。
//:
//: [注意/ちゅうい]:
//: - capacity が 0 の[場合/ばあい]は[確保/かくほ]せず空 builder を[返/かえ]します。
pub fn byte_builder_with_capacity <(i32)->Result<ByteBuilder, StdErrorKind>> (capacity):
    if:
        lt capacity 0
        then:
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq capacity 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_empty
                else:
                    match alloc_region_bytes<u8> capacity:
                        Result::Ok region:
                            Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_region region 0 capacity
                        Result::Err _e:
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_new: default capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - 小さな byte列構築で最初の append ごとの確保を避けます。
pub fn byte_builder_new <()->Result<ByteBuilder, StdErrorKind>> ():
    byte_builder_with_capacity 64

//: byte_builder_dealloc_owned_region: builder が所有する byte 領域 token を解放する
//:
//: [目的/もくてき]:
//: - `ByteBuilder` が持つ `RegionToken<u8>` の解放責務をここに集約します。
//:
//: [注意/ちゅうい]:
//: - token は必ず `dealloc_region` へ渡し、compiler が token owner の消費を直接追跡できる形にします。
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     let checks match alloc_region_bytes<u8> 4:
//:         Result::Ok region:
//:             byte_builder_dealloc_owned_region region
//:             checks_push checks0 assert_eq_i32 1 1
//:         Result::Err _e:
//:             checks_push checks0 assert_eq_i32 1 0
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
pub fn byte_builder_dealloc_owned_region <(RegionToken<u8>)->()> (region):
    match dealloc_region<u8> region:
        Result::Ok _:
            ()
        Result::Err _:
            ()

//: byte_builder_realloc_region_or_free: storage token を grow し失敗時に旧 token を閉じる
//:
//: [目的/もくてき]:
//: - `ByteBuilder` の grow で、旧 `RegionToken<u8>` の free obligation を新しい token へ移す処理を集約します。
//:
//: [注意/ちゅうい]:
//: - 成功時は返った `RegionToken<u8>` が storage owner です。
//: - 失敗時は旧 token を `dealloc_region` へ渡し、caller へは `OutOfMemory` を返します。
pub fn byte_builder_realloc_region_or_free <(RegionToken<u8>,i32)->Result<RegionToken<u8>, StdErrorKind>> (region, new_cap):
    match realloc_region_bytes_keep<u8> region new_cap:
        Result::Ok next_region:
            Result<RegionToken<u8>, StdErrorKind>::Ok next_region
        Result::Err e:
            let old_region <RegionToken<u8>> region_realloc_error_region<u8> e
            match dealloc_region<u8> old_region:
                Result::Ok _:
                    Result<RegionToken<u8>, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Err _free:
                    Result<RegionToken<u8>, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_free: builder が保持する storage を解放する
//:
//: [目的/もくてき]:
//: - builder の `RegionToken<u8>` を取り出し、token の size に従って owned storage を解放します。
pub fn byte_builder_free <(ByteBuilder)->()> (builder):
    match get builder "storage":
        ByteBuilderStorage::Empty:
            ()
        ByteBuilderStorage::Owned region:
            byte_builder_dealloc_owned_region region

//: byte_builder_next_capacity: 必要 byte 数を満たす次 capacity を計算する
//:
//: [目的/もくてき]:
//: - 現在 capacity を 2 倍しながら `needed` 以上の値を探します。
//:
//: [注意/ちゅうい]:
//: - overflow または増加しない値になった場合は `CapacityExceeded` を返します。
pub fn byte_builder_next_capacity <(i32,i32)->Result<i32, StdErrorKind>> (cap, needed):
    let mut next <i32>:
        if:
            le cap 0
            then:
                8
            else:
                cap
    let mut failed <i32> 0
    while and lt next needed eq failed 0:
        do:
            let doubled <i32> mul next 2
            if:
                le doubled next
                then:
                    set failed 1
                else:
                    set next doubled
    if:
        eq failed 1
        then:
            Result<i32, StdErrorKind>::Err StdErrorKind::CapacityExceeded
        else:
            Result<i32, StdErrorKind>::Ok next

//: byte_builder_reserve: 追加 byte [数/すう]ぶんの capacity を[確保/かくほ]する
//:
//: [目的/もくてき]:
//: - 以後の append が少なくとも additional byte ぶん成功するように、必要なら capacity を 2 [倍/ばい]ずつ[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - 失敗時は builder を[解放/かいほう]します。
pub fn byte_builder_reserve <(ByteBuilder,i32)->Result<ByteBuilder, StdErrorKind>> (builder, additional):
    let len0 <i32> get builder "len"
    let cap0 <i32> get builder "cap"
    if:
        lt additional 0
        then:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            let needed <i32> add len0 additional
            if:
                or lt needed len0 le needed cap0
                then:
                    if:
                        lt needed len0
                        then:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::CapacityExceeded
                        else:
                            Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    match byte_builder_next_capacity cap0 needed:
                        Result::Err e:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err e
                        Result::Ok next_cap:
                            match get builder "storage":
                                ByteBuilderStorage::Empty:
                                    if:
                                        or gt len0 0 gt cap0 0
                                        then:
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                        else:
                                            match alloc_region_bytes<u8> next_cap:
                                                Result::Ok region:
                                                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_region region len0 next_cap
                                                Result::Err _e:
                                                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory
                                ByteBuilderStorage::Owned region:
                                    if:
                                        le cap0 0
                                        then:
                                            byte_builder_dealloc_owned_region region
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                        else:
                                            match byte_builder_realloc_region_or_free region next_cap:
                                                Result::Ok next_region:
                                                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_region next_region len0 next_cap
                                                Result::Err e:
                                                    Result<ByteBuilder, StdErrorKind>::Err e
