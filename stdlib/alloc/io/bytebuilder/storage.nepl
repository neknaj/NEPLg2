//: # io/bytebuilder/storage
//: ByteBuilder の capacity 管理と storage 解放境界
//:
//: [目的/もくてき]:
//: - `ByteBuilder` の確保、再確保、解放を所有します。
//: - raw memory operation はこの module と append/build module に閉じ込めます。
//:
//: [注意/ちゅうい]:
//: - owner-consuming grow API の失敗は `ByteBuilderError` に builder owner を戻します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     match byte_builder_new:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err _:
//:             0
//: ```

#indent 4

#import "alloc/diag/error/types" as *
#import "alloc/io/bytebuf" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/allocator" as *
#import "core/mem/raw" as *
#import "core/option" as *
#import "core/result" as *
#import "core/math/i32" as *
#import "core/math/bool" as *
#import "./types" as *

//: byte_builder_with_capacity: 指定 capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - [見積/みつ]もり[済/ず]みの byte [数/すう]がある emitter で、最初の realloc を[避/さ]けます。
//:
//: [注意/ちゅうい]:
//: - capacity が 0 の[場合/ばあい]は[確保/かくほ]せず空 builder を[返/かえ]します。
pub fn byte_builder_with_capacity %fn i32 Result ByteBuilder StdErrorKind \capacity:
    if:
        lt capacity 0
        then:
            Result::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq capacity 0
                then:
                    Result::Ok byte_builder_empty
                else:
                    match alloc_region_bytes<u8> capacity:
                        Result::Ok region:
                            Result::Ok byte_builder_from_owned_region region 0 capacity
                        Result::Err _e:
                            Result::Err StdErrorKind::OutOfMemory

//: byte_builder_new: default capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - 小さな byte列構築で最初の append ごとの確保を避けます。
pub fn byte_builder_new %fn void Result ByteBuilder StdErrorKind \void:
    byte_builder_with_capacity 64

//: byte_builder_dealloc_owned_region: builder が所有する byte 領域 token を解放する
//:
//: [目的/もくてき]:
//: - `ByteBuilder` が持つ `RegionToken u8` の解放責務をここに集約します。
//:
//: [注意/ちゅうい]:
//: - token は必ず `dealloc_region` へ渡し、compiler が token owner の消費を直接追跡できる形にします。
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     let checks match alloc_region_bytes<u8> 4:
//:         Result::Ok region:
//:             byte_builder_dealloc_owned_region region
//:             checks_push checks0 assert_eq_i32 1 1
//:         Result::Err _e:
//:             checks_push checks0 assert_eq_i32 1 0
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
pub fn byte_builder_dealloc_owned_region %fn RegionToken u8 unit \region:
    match dealloc_region<u8> region:
        Result::Ok _:
            unit
        Result::Err _:
            unit

//: byte_builder_realloc_region_or_keep: storage token を grow し失敗時に旧 token を戻す
//:
//: [目的/もくてき]:
//: - `ByteBuilder` の grow で、旧 `RegionToken u8` の free obligation を新しい token へ移す処理を集約します。
//:
//: [注意/ちゅうい]:
//: - 成功時は返った `RegionToken u8` が storage owner です。
//: - 失敗時は旧 token を `RegionReallocError` に戻し、caller が builder error payload へ包み直します。
pub fn byte_builder_realloc_region_or_keep %fn RegionToken u8 fn i32 Result RegionToken u8 RegionReallocError u8 \region\new_cap:
    realloc_region_bytes_keep<u8> region new_cap

//: byte_builder_free: builder が保持する storage を解放する
//:
//: [目的/もくてき]:
//: - builder の `RegionToken u8` を取り出し、token の size に従って owned storage を解放します。
pub fn byte_builder_free %fn ByteBuilder unit \builder:
    match get builder "storage":
        ByteBuilderStorage::Empty:
            unit
        ByteBuilderStorage::Owned region:
            byte_builder_dealloc_owned_region region

//: byte_builder_error_free: `ByteBuilderError` が戻した builder owner を閉じる
//:
//: [目的/もくてき]:
//: - caller が retry せず error を破棄する場合も、error payload 内の storage owner を必ず `byte_builder_free` へ渡せるようにします。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let invalid %i32 sub 0 1
//:     match byte_builder_reserve byte_builder_empty invalid:
//:         Result::Ok b:
//:             byte_builder_free b
//:             1
//:         Result::Err e:
//:             byte_builder_error_free e
//:             0
//: ```
pub fn byte_builder_error_free %fn ByteBuilderError unit \e:
    byte_builder_free byte_builder_error_builder e

//: byte_builder_bytebuf_error_free: `ByteBuilderByteBufError` の 2 owner を閉じる
//:
//: [目的/もくてき]:
//: - `byte_builder_push_bytebuf` の失敗 payload に戻った builder と input bytes を同じ cleanup 境界で閉じます。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/diag/error" as *
//:| #import "alloc/io/bytebuf" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let invalid %StdErrorKind StdErrorKind::InvalidOperation
//:     let e %ByteBuilderByteBufError ByteBuilderByteBufError byte_builder_empty io_bytebuf_empty invalid
//:     byte_builder_bytebuf_error_free e
//:     0
//: ```
pub fn byte_builder_bytebuf_error_free %fn ByteBuilderByteBufError unit \e:
    let builder %ByteBuilder get e "builder"
    let bytes %ByteBuf get e "bytes"
    byte_builder_free builder
    io_bytebuf_free bytes

//: byte_builder_next_capacity: 必要 byte 数を満たす次 capacity を計算する
//:
//: [目的/もくてき]:
//: - 現在 capacity を 2 倍しながら `needed` 以上の値を探します。
//:
//: [注意/ちゅうい]:
//: - overflow または増加しない値になった場合は `CapacityExceeded` を返します。
pub fn byte_builder_next_capacity %fn i32 fn i32 Result i32 StdErrorKind \cap\needed:
    let mut next %i32:
        if:
            le cap 0
            then:
                8
            else:
                cap
    let mut failed %i32 0
    while and lt next needed eq failed 0:
        do:
            let doubled %i32 mul next 2
            if:
                le doubled next
                then:
                    set failed 1
                else:
                    set next doubled
    if:
        eq failed 1
        then:
            Result::Err StdErrorKind::CapacityExceeded
        else:
            Result::Ok next

//: byte_builder_reserve_empty_storage: 空 storage を必要 capacity へ grow する
//:
//: [目的/もくてき]:
//: - `ByteBuilderStorage::Empty` branch の不変条件確認と新規確保を、reserve 本体から分離します。
//: - 空 storage なのに `len` または `cap` が正である状態は表現不整合として拒否し、失敗時も builder owner を `ByteBuilderError` に戻します。
//:
//: [注意/ちゅうい]:
//: - `next_cap` は `byte_builder_next_capacity` で計算済みの正の capacity であることを想定します。
fn byte_builder_reserve_empty_storage %fn i32 fn i32 fn i32 Result ByteBuilder ByteBuilderError \len0\cap0\next_cap:
    if:
        or gt len0 0 gt cap0 0
        then:
            Result::Err ByteBuilderError (ByteBuilder ByteBuilderStorage::Empty len0 cap0) StdErrorKind::InvalidOperation
        else:
            if:
                not alloc_payload_fits next_cap
                then:
                    Result::Err ByteBuilderError (ByteBuilder ByteBuilderStorage::Empty len0 cap0) StdErrorKind::CapacityExceeded
                else:
                    match alloc_region_bytes<u8> next_cap:
                        Result::Ok region:
                            Result::Ok byte_builder_from_owned_region region len0 next_cap
                        Result::Err _e:
                            Result::Err ByteBuilderError (ByteBuilder ByteBuilderStorage::Empty len0 cap0) StdErrorKind::OutOfMemory

//: byte_builder_reserve_owned_storage: 所有 storage を必要 capacity へ grow する
//:
//: [目的/もくてき]:
//: - `ByteBuilderStorage::Owned` branch の capacity 検査、payload 上限検査、realloc 失敗時の旧 owner recovery を集約します。
//: - 成功時は新しい `RegionToken u8` を持つ builder を返し、失敗時は旧 token を包み直して `ByteBuilderError` に戻します。
//:
//: [注意/ちゅうい]:
//: - `region` はこの関数が消費します。realloc 失敗時には `RegionReallocError` から旧 token を取り戻して返します。
fn byte_builder_reserve_owned_storage %fn RegionToken u8 fn i32 fn i32 fn i32 Result ByteBuilder ByteBuilderError \region\len0\cap0\next_cap:
    if:
        le cap0 0
        then:
            Result::Err ByteBuilderError (ByteBuilder (ByteBuilderStorage::Owned region) len0 cap0) StdErrorKind::InvalidOperation
        else:
            if:
                not alloc_payload_fits next_cap
                then:
                    Result::Err ByteBuilderError (ByteBuilder (ByteBuilderStorage::Owned region) len0 cap0) StdErrorKind::CapacityExceeded
                else:
                    match byte_builder_realloc_region_or_keep region next_cap:
                        Result::Ok next_region:
                            Result::Ok byte_builder_from_owned_region next_region len0 next_cap
                        Result::Err e:
                            let old_region %RegionToken u8 region_realloc_error_region<u8> e
                            Result::Err ByteBuilderError (ByteBuilder (ByteBuilderStorage::Owned old_region) len0 cap0) StdErrorKind::OutOfMemory

//: byte_builder_reserve: 追加 byte [数/すう]ぶんの capacity を[確保/かくほ]する
//:
//: [目的/もくてき]:
//: - 以後の append が少なくとも additional byte ぶん成功するように、必要なら capacity を 2 [倍/ばい]ずつ[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - 失敗時は `ByteBuilderError` に builder owner を[戻/もど]します。
pub fn byte_builder_reserve %fn ByteBuilder fn i32 Result ByteBuilder ByteBuilderError \builder\additional:
    let len0 %i32 get builder "len"
    let cap0 %i32 get builder "cap"
    if:
        lt additional 0
        then:
            Result::Err ByteBuilderError builder StdErrorKind::InvalidOperation
        else:
            let needed %i32 add len0 additional
            if:
                or lt needed len0 le needed cap0
                then:
                    if:
                        lt needed len0
                        then:
                            Result::Err ByteBuilderError builder StdErrorKind::CapacityExceeded
                        else:
                            Result::Ok builder
                else:
                    match byte_builder_next_capacity cap0 needed:
                        Result::Err e:
                            Result::Err ByteBuilderError builder e
                        Result::Ok next_cap:
                            match get builder "storage":
                                ByteBuilderStorage::Empty:
                                    byte_builder_reserve_empty_storage len0 cap0 next_cap
                                ByteBuilderStorage::Owned region:
                                    byte_builder_reserve_owned_storage region len0 cap0 next_cap
