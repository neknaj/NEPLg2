//: # io/bytebuilder
//: growable な所有 byte buffer builder
//:
//: [目的/もくてき]:
//: - WASM binary emitter や UTF-8 encoder が byte 列を順次構築するための builder をまとめます。
//: - `finish` により exact-size の `ByteBuf` へ所有権を移します。
//:
//: [注意/ちゅうい]:
//: - `push_*` / `reserve` / `finish` は builder を消費し、成功時は新しい owner を返します。
//: - raw memory capability は builder storage の grow/shrink 境界だけに必要です。

#indent 4

#import "alloc/diag/error" as *
#import "alloc/io/bytebuf" as *
#import "core/char" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *

//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuf" as *
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match byte_builder_new:
//:         Result::Ok b0:
//:             match byte_builder_push_ascii b0 'A':
//:                 Result::Ok b1:
//:                     match byte_builder_push_ascii b1 'B':
//:                         Result::Ok b2:
//:                             match byte_builder_finish b2:
//:                                 Result::Ok bytes:
//:                                     match io_bytebuf_to_str_result bytes:
//:                                         Result::Ok text:
//:                                             checks_exit_code checks_push checks0 assert_str_eq "AB" text
//:                                         Result::Err _e:
//:                                             checks_exit_code checks_push checks0 assert_eq_i32 1 0
//:                                 Result::Err _e:
//:                                     checks_exit_code checks_push checks0 assert_eq_i32 1 0
//:                         Result::Err _e:
//:                             checks_exit_code checks_push checks0 assert_eq_i32 1 0
//:                 Result::Err _e:
//:                     checks_exit_code checks_push checks0 assert_eq_i32 1 0
//:         Result::Err _e:
//:             checks_exit_code checks_push checks0 assert_eq_i32 1 0
//: ```

//: ## ByteBuilder
//: growable な[所有/しょゆう] byte buffer builder
//:
//: ### [目的/もくてき]
//: - WASM binary emitter のように byte を[順番/じゅんばん]に[追加/ついか]する処理を、raw pointer や `Vec` [内部表現/ないぶひょうげん]へ[直接/ちょくせつ][依存/いそん]せずに[書/か]けるようにします。
//: - `finish` で `ByteBuf` を[返/かえ]し、`fs_write_to_bytes` や `stdio_write_bytes_result` へそのまま[渡/わた]せます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuilder` は[所有権/しょゆうけん]を[持/も]つので `Copy` / `Clone` を[実装/じっそう]しません。
//: - `push_*` / `reserve` / `finish` は builder を[消費/しょうひ]し、成功時は[新/あたら]しい builder または `ByteBuf` を[返/かえ]します。
//: - 失敗時は builder 内部 buffer を[解放/かいほう]してから `Err` を[返/かえ]します。
struct ByteBuilder:
    ptr <Option<MemPtr<u8>>>
    len <i32>
    cap <i32>

fn byte_builder_empty <()->ByteBuilder> ():
    ByteBuilder none<MemPtr<u8>> 0 0

//: byte_builder_from_owned_ptr: 所有 byte 領域を `ByteBuilder` に包む
//:
//: [目的/もくてき]:
//: - `alloc_ptr` / `realloc_ptr` で得た所有 pointer を、空/非空が型に現れる builder 表現へ集約します。
//:
//: [注意/ちゅうい]:
//: - `cap0` は正でなければなりません。空 builder は `byte_builder_empty` を使ってください。
//: - 呼び出し後、`ptr` は返った builder が所有します。
fn byte_builder_from_owned_ptr <(MemPtr<u8>,i32,i32)->ByteBuilder> (ptr, len0, cap0):
    ByteBuilder some<MemPtr<u8>> ptr len0 cap0

//: byte_builder_with_len: builder の storage owner を保ったまま length だけ更新する
//:
//: [目的/もくてき]:
//: - append が書き込みに成功したあと、`ptr` field の owner を取り出して包み直さず、`Option<MemPtr<u8>>` field 全体を次の builder へ移します。
//:
//: [注意/ちゅうい]:
//: - `new_len` は `cap` 以下でなければなりません。capacity 確保は呼び出し前に `byte_builder_reserve` で済ませます。
fn byte_builder_with_len <(ByteBuilder,i32)->ByteBuilder> (builder, new_len):
    let cap0 <i32> get builder "cap"
    ByteBuilder get builder "ptr" new_len cap0

//: byte_builder_with_capacity: 指定 capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - [見積/みつ]もり[済/ず]みの byte [数/すう]がある emitter で、最初の realloc を[避/さ]けます。
//:
//: [注意/ちゅうい]:
//: - capacity が 0 の[場合/ばあい]は[確保/かくほ]せず空 builder を[返/かえ]します。
fn byte_builder_with_capacity <(i32)->Result<ByteBuilder, StdErrorKind>> (capacity):
    if:
        lt capacity 0
        then:
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq capacity 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_empty
                else:
                    match alloc_ptr<u8> capacity:
                        Result::Ok ptr:
                            Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_ptr ptr 0 capacity
                        Result::Err _e:
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_new: default capacity の builder を[作/つく]る
fn byte_builder_new <()->Result<ByteBuilder, StdErrorKind>> ():
    byte_builder_with_capacity 64

fn byte_builder_len <(ByteBuilder)->i32> (builder):
    get builder "len"

//: byte_builder_dealloc_owned_u8: builder が所有する byte 領域を解放する
//:
//: [目的/もくてき]:
//: - `ByteBuilder` / `ByteBuf` から取り出した所有 pointer の解放責務をここに集約します。
//:
//: [注意/ちゅうい]:
//: - 所有 pointer と size は builder invariant から来るため、この raw-memory-boundary 内で storage-only dealloc へ直接下げます。
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/io/bytebuilder" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match alloc_ptr<u8> 4:
//:         Result::Ok ptr:
//:             byte_builder_dealloc_owned_u8 ptr 4
//:             checks_exit_code checks_push checks0 assert_eq_i32 1 1
//:         Result::Err _e:
//:             checks_exit_code checks_push checks0 assert_eq_i32 1 0
//: ```
fn byte_builder_dealloc_owned_u8 <(MemPtr<u8>,i32)->()> (ptr, size):
    dealloc_raw mem_ptr_addr ptr size

fn byte_builder_free <(ByteBuilder)->()> (builder):
    let cap <i32> get builder "cap"
    match get builder "ptr":
        Option::Some ptr:
            byte_builder_dealloc_owned_u8 ptr cap
        Option::None:
            ()

fn byte_builder_next_capacity <(i32,i32)->Result<i32, StdErrorKind>> (cap, needed):
    let mut next <i32>:
        if:
            le cap 0
            then:
                8
            else:
                cap
    let mut failed <i32> 0
    while and lt next needed eq failed 0:
        do:
            let doubled <i32> mul next 2
            if:
                le doubled next
                then:
                    set failed 1
                else:
                    set next doubled
    if:
        eq failed 1
        then:
            Result<i32, StdErrorKind>::Err StdErrorKind::CapacityExceeded
        else:
            Result<i32, StdErrorKind>::Ok next

//: byte_builder_reserve: 追加 byte [数/すう]ぶんの capacity を[確保/かくほ]する
//:
//: [目的/もくてき]:
//: - 以後の append が少なくとも additional byte ぶん成功するように、必要なら capacity を 2 [倍/ばい]ずつ[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - 失敗時は builder を[解放/かいほう]します。
fn byte_builder_reserve <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, additional):
    let len0 <i32> get builder "len"
    let cap0 <i32> get builder "cap"
    if:
        lt additional 0
        then:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            let needed <i32> add len0 additional
            if:
                or lt needed len0 le needed cap0
                then:
                    if:
                        lt needed len0
                        then:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::CapacityExceeded
                        else:
                            Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    match byte_builder_next_capacity cap0 needed:
                        Result::Err e:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err e
                        Result::Ok next_cap:
                            if:
                                le cap0 0
                                then:
                                    match get builder "ptr":
                                        Option::Some ptr:
                                            byte_builder_dealloc_owned_u8 ptr 0
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                        Option::None:
                                            match alloc_ptr<u8> next_cap:
                                                Result::Ok ptr:
                                                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_ptr ptr len0 next_cap
                                                Result::Err _e:
                                                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory
                                else:
                                    match get builder "ptr":
                                        Option::None:
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                        Option::Some old:
                                            match realloc_ptr<u8> old cap0 next_cap:
                                                Result::Ok ptr:
                                                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_from_owned_ptr ptr len0 next_cap
                                                Result::Err _e:
                                                    byte_builder_dealloc_owned_u8 old cap0
                                                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_push_u8: 1 byte を[末尾/まつび]へ[追加/ついか]する
fn byte_builder_push_u8 <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, byte):
    match byte_builder_reserve builder 1:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok reserved:
            let len0 <i32> get reserved "len"
            match *get_ref &reserved "ptr":
                Option::None:
                    byte_builder_free reserved
                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                Option::Some ptr:
                    match store_u8 mem_ptr_add ptr len0 byte:
                        Result::Ok _:
                            Result<ByteBuilder, StdErrorKind>::Ok byte_builder_with_len reserved add len0 1
                        Result::Err _e:
                            byte_builder_free reserved
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

//: byte_builder_push_ascii: ASCII char を 1 byte として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - text magic や delimiter など、意味が文字である byte を `char` として受け取ります。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `InvalidOperation` です。失敗時は builder を[解放/かいほう]します。
fn byte_builder_push_ascii <(ByteBuilder,char)*>Result<ByteBuilder, StdErrorKind>> (builder, c):
    if:
        char_is_ascii c
        then:
            byte_builder_push_u8 builder char_to_i32 c
        else:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

fn byte_builder_push_utf8_tail <(ByteBuilder,char,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, c, count):
    if:
        eq count 1
        then:
            Result<ByteBuilder, StdErrorKind>::Ok builder
        else:
            match byte_builder_push_u8 builder char_utf8_byte1 c:
                Result::Err e:
                    Result<ByteBuilder, StdErrorKind>::Err e
                Result::Ok b1:
                    if:
                        eq count 2
                        then:
                            Result<ByteBuilder, StdErrorKind>::Ok b1
                        else:
                            match byte_builder_push_u8 b1 char_utf8_byte2 c:
                                Result::Err e:
                                    Result<ByteBuilder, StdErrorKind>::Err e
                                Result::Ok b2:
                                    if:
                                        eq count 3
                                        then:
                                            Result<ByteBuilder, StdErrorKind>::Ok b2
                                        else:
                                            byte_builder_push_u8 b2 char_utf8_byte3 c

//: byte_builder_push_char_utf8: char を UTF-8 bytes として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `StringBuilder` ではなく binary `ByteBuilder` に text character を追加したい場合の共通入口です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
fn byte_builder_push_char_utf8 <(ByteBuilder,char)*>Result<ByteBuilder, StdErrorKind>> (builder, c):
    let count <i32> char_utf8_len c
    match byte_builder_push_u8 builder char_utf8_byte0 c:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok b0:
            byte_builder_push_utf8_tail b0 c count

//: byte_builder_push_bytes_ref: 参照 byte [列/れつ]を[末尾/まつび]へ[複製/ふくせい]する
//:
//: [目的/もくてき]:
//: - 既存 buffer の slice や固定 header を builder に[追加/ついか]します。
//:
//: [注意/ちゅうい]:
//: - source の[所有権/しょゆうけん]は[移動/いどう]しません。
fn byte_builder_push_bytes_ref <(ByteBuilder,&MemPtr<u8>,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, src, data_len):
    if:
        lt data_len 0
        then:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq data_len 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    match byte_builder_reserve builder data_len:
                        Result::Err e:
                            Result<ByteBuilder, StdErrorKind>::Err e
                        Result::Ok reserved:
                            let len0 <i32> get reserved "len"
                            match *get_ref &reserved "ptr":
                                Option::None:
                                    byte_builder_free reserved
                                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
                                Option::Some ptr:
                                    let dst <MemPtr<u8>> mem_ptr_add ptr len0
                                    match mem_copy<u8> dst *src data_len:
                                        Result::Ok _:
                                            Result<ByteBuilder, StdErrorKind>::Ok byte_builder_with_len reserved add len0 data_len
                                        Result::Err _e:
                                            byte_builder_free reserved
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

//: byte_builder_push_bytebuf: `ByteBuf` の[内容/ないよう]を[追加/ついか]して入力 buffer を[解放/かいほう]する
fn byte_builder_push_bytebuf <(ByteBuilder,ByteBuf)*>Result<ByteBuilder, StdErrorKind>> (builder, bytes):
    let data_len <i32> get bytes "len"
    match get bytes "ptr":
        Option::None:
            if:
                eq data_len 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    byte_builder_free builder
                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        Option::Some src:
            let res <Result<ByteBuilder, StdErrorKind>> byte_builder_push_bytes_ref builder &src data_len
            byte_builder_dealloc_owned_u8 src io_bytebuf_storage_size data_len
            res

//: byte_builder_push_leb_u32: u32 LEB128 を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - WASM binary の section size、index、integer immediate を unsigned LEB128 で[書/か]き[込/こ]みます。
//:
//: [実装/じっそう]:
//: - 下位 7 bit を[出力/しゅつりょく]し、残りを unsigned shift で 7 bit ずつ[進/すす]めます。
fn byte_builder_push_leb_u32 <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, value):
    let low <i32> and value 127
    let rest <i32> shr_u value 7
    let out <i32>:
        if:
            eq rest 0
            then:
                low
            else:
                or low 128
    match byte_builder_push_u8 builder out:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok next:
            if:
                eq rest 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok next
                else:
                    byte_builder_push_leb_u32 next rest

//: byte_builder_finish: builder を exact-size の `ByteBuf` へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - growable builder の capacity を[隠/かく]し、`ByteBuf.ptr` が `Some` の場合だけ `ByteBuf.len` byte の[所有領域/しょゆうりょういき]を[指/さ]す invariant に[戻/もど]します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は caller が `io_bytebuf_free` で[解放/かいほう]してください。
fn byte_builder_finish <(ByteBuilder)*>Result<ByteBuf, StdErrorKind>> (builder):
    let len0 <i32> get builder "len"
    let cap0 <i32> get builder "cap"
    if:
        le len0 0
        then:
            byte_builder_free builder
            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_empty
        else:
            if:
                eq len0 cap0
                then:
                    match get builder "ptr":
                        Option::Some ptr:
                            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr ptr len0
                        Option::None:
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::InvalidOperation
                else:
                    match get builder "ptr":
                        Option::None:
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::InvalidOperation
                        Option::Some old:
                            match realloc_ptr<u8> old cap0 len0:
                                Result::Ok ptr:
                                    Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr ptr len0
                                Result::Err _e:
                                    byte_builder_dealloc_owned_u8 old cap0
                                    Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: io_bytebuf_from_char_utf8_result: char 1 つを UTF-8 `ByteBuf` へ encode する
//:
//: [目的/もくてき]:
//: - `char` を I/O や `std/text` の byte 境界へ渡すため、所有権付き `ByteBuf` として返します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は呼び出し側が `io_bytebuf_free` で解放してください。
fn io_bytebuf_from_char_utf8_result <(char)*>Result<ByteBuf, StdErrorKind>> (c):
    match byte_builder_with_capacity char_utf8_len c:
        Result::Err e:
            Result<ByteBuf, StdErrorKind>::Err e
        Result::Ok builder:
            match byte_builder_push_char_utf8 builder c:
                Result::Err e:
                    Result<ByteBuf, StdErrorKind>::Err e
                Result::Ok filled:
                    byte_builder_finish filled
