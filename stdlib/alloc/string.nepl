//: string: alloc/string.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "core/mem" as *
#import "core/result" as *
#import "core/option" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/char" as *
#import "alloc/collections/vec" as v
#import "core/field" as *

// string: 文字列操作（長さ付きUTF-8）
//
// 目的:
// - [len:i32][bytes...] 形式の UTF-8 文字列を扱う関数群を提供します。
//
// 実装(アルゴリズム):
// - 文字列はヒープに確保し、先頭 4 バイトに長さを格納します。
//
// 注意(重要):
// - 文字列は NUL 終端ではありません。
// - 変換関数は i32/i64/f32/f64 の主要経路を提供します。
//
// 計算量:
// - 連結や変換は O(n)

//: string_alloc_region: 文字列用の領域を確保する
//:
//: [目的/もくてき]:
//: - 先頭 4 バイトの長さヘッダを含む文字列領域を確保します。
//:
//: [実装/じっそう]:
//: - `alloc_region_bytes<u8>` に `4 + byte_len` を渡し、文字列レイアウト専用の `RegionToken<u8>` を返します。
//:
//: [注意/ちゅうい]:
//: - `byte_len` は文字列本文のバイト数です。
//: - 失敗時は `Result::Err` を返します。
//:
//: [計算量/けいさんりょう]:
//: - 確保器に依存します。平均 O(1)、free list 探索時は最悪 O(n) です。
fn string_alloc_region <(i32)->Result<RegionToken<u8>,str>> (byte_len):
    if:
        lt byte_len 0
        then:
            Result<RegionToken<u8>,str>::Err "string.alloc invalid length"
        else:
            alloc_region_bytes<u8> add 4 byte_len

//: string_region_len_ptr: 文字列領域ヘッダへの型付きポインタを得る
//:
//: [目的/もくてき]:
//: - 文字列領域の長さヘッダを `MemPtr<i32>` として扱えるようにします。
//:
//: [実装/じっそう]:
//: - `RegionToken` の所有権を動かさず、field reference から基底 `MemPtr<u8>` を copy してヘッダポインタに包み直します。
//:
//: [注意/ちゅうい]:
//: - 文字列領域レイアウトを前提とする内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_region_len_ptr <(&RegionToken<u8>)->MemPtr<i32>> (region):
    mem_ptr_wrap mem_ptr_addr *get_ref region "ptr"

//: string_region_data_ptr: 文字列本文先頭への型付きポインタを得る
//:
//: [目的/もくてき]:
//: - 文字列本文の 1 バイト目を `MemPtr<u8>` として扱えるようにします。
//:
//: [実装/じっそう]:
//: - `RegionToken` の所有権を動かさず、field reference から基底 `MemPtr<u8>` を copy して 4 バイト進めます。
//:
//: [注意/ちゅうい]:
//: - 先頭 4 バイトが長さヘッダであることを前提にしています。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_region_data_ptr <(&RegionToken<u8>)->MemPtr<u8>> (region):
    mem_ptr_add *get_ref region "ptr" 4

//: string_addr: `str` の内部アドレスを低レベル処理用に取り出す
//:
//: [目的/もくてき]:
//: - `str` と `i32` を型として混同せず、文字列レイアウトを扱う内部処理だけが明示的に生アドレスを使えるようにします。
//:
//: [実装/じっそう]:
//: - compiler intrinsic により、WASM 上の `str` 表現である線形メモリアドレスを `i32` として返します。
//:
//: [注意/ちゅうい]:
//: - 文字列実装と OS 境界用の低レベル API です。通常の文字列処理では `len` / `string_data_ptr` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_addr <(str)->i32> (s):
    #intrinsic "str_addr" <> (s)

//: string_data_ptr: 既存文字列の本文先頭を型付きポインタとして扱う
//:
//: [目的/もくてき]:
//: - `str` の内部表現を直接露出せずに、本文領域へアクセスします。
//:
//: [実装/じっそう]:
//: - 長さヘッダの直後を `MemPtr<u8>` として包みます。
//:
//: [注意/ちゅうい]:
//: - 既存の `str` 表現に依存する内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_data_ptr <(str)->MemPtr<u8>> (s):
    mem_ptr_wrap add string_addr s 4

//: string_finish: 文字列領域を `str` として確定する
//:
//: [目的/もくてき]:
//: - 文字列領域へ長さを書き込み、公開型 `str` に変換します。
//:
//: [実装/じっそう]:
//: - ヘッダへ長さを書き込み、領域先頭アドレスを返します。
//:
//: [注意/ちゅうい]:
//: - 確定後は領域の所有権を `str` 側へ移します。
//: - 書き込み不能な領域は内部不整合として `unreachable` 扱いです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_finish <(RegionToken<u8>,i32)->str> (region, byte_len):
    let base <MemPtr<u8>> get region "ptr"
    string_finish_base base byte_len

//: string_from_addr_unchecked: 文字列レイアウト済み領域を `str` として扱う
//:
//: [目的/もくてき]:
//: - 先頭 4 バイトに長さを持つ文字列領域の基底アドレスを、公開型 `str` へ変換します。
//:
//: [実装/じっそう]:
//: - compiler intrinsic により、`i32` の生アドレスを `str` 表現へ明示的に境界変換します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 検証済みで、文字列レイアウトを満たす領域にだけ使ってください。任意の整数を渡すと未定義動作になります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_from_addr_unchecked <(i32)->str> (addr):
    #intrinsic "str_from_addr_unchecked" <> (addr)

//: string_finish_base: 文字列先頭ポインタを `str` として確定する
//:
//: [目的/もくてき]:
//: - 文字列領域の先頭ポインタへ長さを書き込み、公開型 `str` に変換します。
//:
//: [実装/じっそう]:
//: - ヘッダ先頭を `MemPtr<i32>` として見なし、長さを書き込んだ後に基底アドレスを返します。
//:
//: [注意/ちゅうい]:
//: - 呼び出し側は、先頭 4 バイトが長さヘッダである文字列レイアウトを守る必要があります。
//: - 領域の所有権は呼び出し側で保持したまま、`str` へ移す前提の内部ヘルパです。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_finish_base <(MemPtr<u8>,i32)->str> (base, byte_len):
    store_i32 mem_ptr_addr base byte_len
    string_from_addr_unchecked mem_ptr_addr base

//: string_from_mem_unchecked_result: raw byte 列を検証なしで `str` へ複製する
//:
//: [目的/もくてき]:
//: - 既に UTF-8 として検証済み、または byte 列として扱うことが明確な領域を、新しい `str` 領域へ複製します。
//:
//: [実装/じっそう]:
//: - `string_alloc_region` で `[len][bytes...]` layout の領域を確保し、本文へ `mem_copy` します。
//: - 長さヘッダは `string_finish` で raw store し、確保領域の所有権を返却する `str` へ移します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 検証は行いません。外部入力には `string_from_utf8_mem_result` を使ってください。
//: - `byte_len > 0` の場合、`src` は少なくとも `byte_len` byte の有効領域を指している必要があります。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn string_from_mem_unchecked_result <(MemPtr<u8>,i32)->Result<str,str>> (src, byte_len):
    if:
        lt byte_len 0
        then:
            Result<str,str>::Err "string.from_mem invalid length"
        else:
            match string_alloc_region byte_len:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok region:
                    let out_data <MemPtr<u8>> string_region_data_ptr &region
                    if:
                        gt byte_len 0
                        then:
                            mem_copy mem_ptr_addr out_data mem_ptr_addr src byte_len
                        else:
                            ()
                    Result<str,str>::Ok string_finish region byte_len

//: StringUtf8LeadKind: UTF-8 leading byte の分類
//:
//: [目的/もくてき]:
//: - UTF-8 検証の分岐を enum と `match` にし、if の深いネストに戻らないようにします。
enum StringUtf8LeadKind:
    Ascii
    Two
    Three
    Four
    Invalid

fn string_utf8_in_range <(i32,i32,i32)->bool> (b, lo, hi):
    and ge b lo le b hi

fn string_utf8_is_continuation <(i32)->bool> (b):
    string_utf8_in_range b 128 191

fn string_utf8_lead_kind <(i32)->StringUtf8LeadKind> (b):
    if:
        le b 127
        then:
            StringUtf8LeadKind::Ascii
        else:
            if:
                string_utf8_in_range b 194 223
                then:
                    StringUtf8LeadKind::Two
                else:
                    if:
                        string_utf8_in_range b 224 239
                        then:
                            StringUtf8LeadKind::Three
                        else:
                            if:
                                string_utf8_in_range b 240 244
                                then:
                                    StringUtf8LeadKind::Four
                                else:
                                    StringUtf8LeadKind::Invalid

fn string_utf8_byte_at <(MemPtr<u8>,i32)->Result<i32,str>> (data, idx):
    match load_u8 mem_ptr_add data idx:
        Option::Some b:
            Result<i32,str>::Ok b
        Option::None:
            Result<i32,str>::Err "string.utf8 invalid pointer"

fn string_utf8_validate_two <(MemPtr<u8>,i32,i32)->Result<(),str>> (data, i, byte_len):
    if:
        gt add i 2 byte_len
        then:
            Result<(),str>::Err "string.utf8 truncated sequence"
        else:
            match string_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(),str>::Err e
                Result::Ok b1:
                    if:
                        string_utf8_is_continuation b1
                        then:
                            Result<(),str>::Ok ()
                        else:
                            Result<(),str>::Err "string.utf8 invalid continuation"

fn string_utf8_validate_three <(MemPtr<u8>,i32,i32,i32)->Result<(),str>> (data, i, byte_len, b0):
    if:
        gt add i 3 byte_len
        then:
            Result<(),str>::Err "string.utf8 truncated sequence"
        else:
            match string_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(),str>::Err e
                Result::Ok b1:
                    match string_utf8_byte_at data add i 2:
                        Result::Err e:
                            Result<(),str>::Err e
                        Result::Ok b2:
                            let first_ok <bool>:
                                if:
                                    eq b0 224
                                    then:
                                        string_utf8_in_range b1 160 191
                                    else:
                                        if:
                                            eq b0 237
                                            then:
                                                string_utf8_in_range b1 128 159
                                            else:
                                                string_utf8_is_continuation b1
                            if:
                                and first_ok string_utf8_is_continuation b2
                                then:
                                    Result<(),str>::Ok ()
                                else:
                                    Result<(),str>::Err "string.utf8 invalid three-byte sequence"

fn string_utf8_validate_four <(MemPtr<u8>,i32,i32,i32)->Result<(),str>> (data, i, byte_len, b0):
    if:
        gt add i 4 byte_len
        then:
            Result<(),str>::Err "string.utf8 truncated sequence"
        else:
            match string_utf8_byte_at data add i 1:
                Result::Err e:
                    Result<(),str>::Err e
                Result::Ok b1:
                    match string_utf8_byte_at data add i 2:
                        Result::Err e:
                            Result<(),str>::Err e
                        Result::Ok b2:
                            match string_utf8_byte_at data add i 3:
                                Result::Err e:
                                    Result<(),str>::Err e
                                Result::Ok b3:
                                    let first_ok <bool>:
                                        if:
                                            eq b0 240
                                            then:
                                                string_utf8_in_range b1 144 191
                                            else:
                                                if:
                                                    eq b0 244
                                                    then:
                                                        string_utf8_in_range b1 128 143
                                                    else:
                                                        string_utf8_is_continuation b1
                                    if:
                                        and first_ok and string_utf8_is_continuation b2 string_utf8_is_continuation b3
                                        then:
                                            Result<(),str>::Ok ()
                                        else:
                                            Result<(),str>::Err "string.utf8 invalid four-byte sequence"

//: string_utf8_validate_mem: raw byte 列が UTF-8 として妥当か検証する
//:
//: [目的/もくてき]:
//: - `str` を構築する前に、外部由来の byte 列が UTF-8 scalar value の制約を満たすことを確認します。
//:
//: [実装/じっそう]:
//: - leading byte を `StringUtf8LeadKind` に分類し、sequence 長ごとの検査関数を `match` で呼び分けます。
//:
//: [注意/ちゅうい]:
//: - overlong sequence、surrogate range、U+10FFFF 超過につながる先頭 byte は拒否します。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn string_utf8_validate_mem <(MemPtr<u8>,i32)->Result<(),str>> (data, byte_len):
    if:
        lt byte_len 0
        then:
            Result<(),str>::Err "string.utf8 invalid length"
        else:
            let mut i <i32> 0
            let mut done <i32> 0
            let mut res <Result<(),str>> Result<(),str>::Ok ()
            while eq done 0:
                do:
                    if:
                        ge i byte_len
                        then:
                            set done 1
                        else:
                            match string_utf8_byte_at data i:
                                Result::Err e:
                                    set res Result<(),str>::Err e
                                    set done 1
                                Result::Ok b0:
                                    match string_utf8_lead_kind b0:
                                        StringUtf8LeadKind::Ascii:
                                            set i add i 1
                                        StringUtf8LeadKind::Two:
                                            match string_utf8_validate_two data i byte_len:
                                                Result::Ok _:
                                                    set i add i 2
                                                Result::Err e:
                                                    set res Result<(),str>::Err e
                                                    set done 1
                                        StringUtf8LeadKind::Three:
                                            match string_utf8_validate_three data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 3
                                                Result::Err e:
                                                    set res Result<(),str>::Err e
                                                    set done 1
                                        StringUtf8LeadKind::Four:
                                            match string_utf8_validate_four data i byte_len b0:
                                                Result::Ok _:
                                                    set i add i 4
                                                Result::Err e:
                                                    set res Result<(),str>::Err e
                                                    set done 1
                                        StringUtf8LeadKind::Invalid:
                                            set res Result<(),str>::Err "string.utf8 invalid leading byte"
                                            set done 1
            res

//: string_from_utf8_mem_result: UTF-8 検証済みの `str` を構築する
//:
//: [目的/もくてき]:
//: - filesystem / stdin / byte builder など外部由来の raw byte 列を、UTF-8 検証してから `str` にします。
//:
//: [実装/じっそう]:
//: - `string_utf8_validate_mem` に成功した場合だけ、`string_from_mem_unchecked_result` で新しい文字列領域へ複製します。
//:
//: [注意/ちゅうい]:
//: - 入力 byte 領域の所有権は消費しません。必要なら呼び出し側で解放してください。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn string_from_utf8_mem_result <(MemPtr<u8>,i32)->Result<str,str>> (src, byte_len):
    match string_utf8_validate_mem src byte_len:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok _:
            string_from_mem_unchecked_result src byte_len

//: len: 文字列の byte 長を返す
//:
//: [目的/もくてき]:
//: - `str` の本文 byte 数を返します。
//: - lexer や parser が byte index で走査するときの上限として使います。
//:
//: [実装/じっそう]:
//: - `str` layout の先頭 4 byte に格納された長さ header を読みます。
//:
//: [注意/ちゅうい]:
//: - UTF-8 の byte 長であり、Unicode scalar count や表示幅ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn len <(str)->i32> (s):
    load_i32 string_addr s

//: str_byte_len: `str` の byte 長を明示名で返す
//:
//: [目的/もくてき]:
//: - `len` が Unicode scalar count ではなく byte length であることを、呼び出し側の名前で明確にします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn str_byte_len <(str)->i32> (s):
    len s

//: byte_at: 文字列の指定 byte を読む
//:
//: [目的/もくてき]:
//: - `str` の UTF-8 byte 列から、指定した byte index の値を `Option<i32>` として返します。
//: - VM や tokenizer のように ASCII byte を直接見たい処理で、呼び出し側が raw pointer を扱わずに済むようにします。
//:
//: [実装/じっそう]:
//: - `len` で範囲を確認し、本文先頭 pointer に index を足して `load_u8` します。
//:
//: [注意/ちゅうい]:
//: - index は byte index です。Unicode の文字単位ではありません。
//: - 範囲外では `Option::None` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> match byte_at "AZ" 0:
//:         Option::Some b:
//:             eq b 'A'
//:         Option::None:
//:             false
//:     let ok1 <bool> match byte_at "AZ" 1:
//:         Option::Some b:
//:             eq b 'Z'
//:         Option::None:
//:             false
//:     if and ok0 and ok1 is_none<i32> byte_at "AZ" 2 0 1
//: ```
fn byte_at <(str,i32)->Option<i32>> (s, idx):
    let n <i32> len s
    if:
        lt idx 0
        then:
            none<i32>
        else:
            if:
                le n idx
                then:
                    none<i32>
                else:
                    some<i32> string_byte_at_unchecked s idx

//: string_byte_at_unchecked: 範囲確認なしで `str` の本文 1 バイトを読む
//:
//: [目的/もくてき]:
//: - ループ内部で範囲確認済みの byte index から高速に 1 バイトを読みます。
//:
//: [実装/じっそう]:
//: - `string_addr` で文字列ヘッダの生アドレスを明示的に取り出し、4 バイトの長さヘッダを飛ばして `load_u8` します。
//:
//: [注意/ちゅうい]:
//: - idx が範囲外の場合は未定義動作です。公開 API では `byte_at` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_byte_at_unchecked <(str,i32)->i32> (s, idx):
    load_u8 <i32> add string_addr s <i32> add 4 idx

//: concat_result: 2 つの文字列を確保付きで連結する
//:
//: [目的/もくてき]:
//: - `a` と `b` の byte 列を連結した新しい `str` を返します。
//: - allocation failure を呼び出し側で扱う必要がある処理では、この Result 版を使います。
//:
//: [実装/じっそう]:
//: - 両方の byte 長を合計し、`string_alloc_region` で出力領域を 1 回だけ確保します。
//: - 確保した本文領域へ `a`、`b` の順に byte copy し、最後に長さ header を確定します。
//:
//: [注意/ちゅうい]:
//: - 入力文字列は UTF-8 不変条件を満たす前提で、追加の validation は行いません。
//: - `concat` は失敗時に空文字列へ落とす互換 API です。新規コードでは `concat_result` を優先してください。
//:
//: [計算量/けいさんりょう]:
//: - O(len(a) + len(b))
fn concat_result <(str,str)->Result<str,str>> (a,b):
    let la <i32> len a;
    let lb <i32> len b;
    let total <i32> add la lb;
    match string_alloc_region total:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok out_region:
            let out_data <MemPtr<u8>> string_region_data_ptr &out_region;
            mem_copy mem_ptr_addr out_data mem_ptr_addr string_data_ptr a la;
            mem_copy add mem_ptr_addr out_data la mem_ptr_addr string_data_ptr b lb;
            Result<str,str>::Ok string_finish out_region total

fn concat <(str,str)->str> (a,b):
    match concat_result a b:
        Result::Ok s:
            s
        Result::Err _e:
            ""

//: concat3: 3 つの文字列を順に連結する
//:
//: [目的/もくてき]:
//: - `a`、`b`、`c` をこの順に連結した `str` を返します。
//: - 小さい診断文など、3 片だけを簡潔に組み立てたい場合の補助です。
//:
//: [実装/じっそう]:
//: - `concat a b` の結果に `c` を再度 `concat` します。
//:
//: [注意/ちゅうい]:
//: - 中間文字列を 1 つ確保します。多数の片を結合する場合は `StringBuilder` を使ってください。
//: - allocation failure は `concat` と同じく空文字列 fallback に吸収されます。
//:
//: [計算量/けいさんりょう]:
//: - O(len(a) + len(b) + len(c)) ですが、中間 copy が 1 回追加で発生します。
fn concat3 <(str,str,str)->str> (a,b,c):
    let ab <str> concat a b;
    concat ab c

//: StringBuilder: 複数の str 片を byte buffer に追加して最後に 1 つへまとめる
//:
//: [目的/もくてき]:
//: - lexer/parser/diagnostics のように小さな文字列片を段階的に集め、最後に 1 つの `str` として出力します。
//:
//: [実装/じっそう]:
//: - 内部では所有権を持つ `u8` buffer を 2 倍 growth し、append 時点で入力 `str` の byte 列を copy します。
//: - `sb_build_result` は確定用の `str` 領域を確保し、builder buffer の byte 列を 1 回 copy して `str` に変換します。
//:
//: [注意/ちゅうい]:
//: - builder は `Copy` / `Clone` ではありません。`sb_append_result` / `sb_build_result` は builder owner を消費します。
//: - raw storage には `u8` だけを置き、`str` のような non-Copy payload を置きません。
//: - allocation failure を扱う処理では `_result` suffix の API を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - append はならし O(len(s))、build は O(total_bytes) です。
struct StringBuilder:
    data <Option<MemPtr<u8>>>
    len <i32>
    cap <i32>

//: string_builder_empty: allocation を持たない空 builder を作る
//:
//: [目的/もくてき]:
//: - allocation failure 時の fallback や、capacity 0 の内部状態として使う空 builder を作ります。
//:
//: [実装/じっそう]:
//: - data は `None`、len/cap は 0 にします。
//:
//: [注意/ちゅうい]:
//: - この builder に append する場合は `string_builder_reserve_result` が初回 allocation を行います。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_builder_empty <()->StringBuilder> ():
    StringBuilder none<MemPtr<u8>> 0 0

//: string_builder_from_owned_ptr: 所有 byte 領域を `StringBuilder` に包む
//:
//: [目的/もくてき]:
//: - builder 本文 buffer の所有権を `Option<MemPtr<u8>>` field に集約し、空 builder と所有 builder を型で区別します。
//:
//: [注意/ちゅうい]:
//: - `cap0` は正でなければなりません。空 builder は `string_builder_empty` を使ってください。
//: - `data` は返った builder が所有します。
fn string_builder_from_owned_ptr <(MemPtr<u8>,i32,i32)->StringBuilder> (data, len0, cap0):
    StringBuilder some<MemPtr<u8>> data len0 cap0

//: string_builder_with_len: builder の storage owner を保ったまま length だけ更新する
//:
//: [目的/もくてき]:
//: - append が本文 byte の書き込みに成功したあと、`data` field の owner を取り出して包み直さず、`Option<MemPtr<u8>>` field 全体を次の builder へ移します。
//:
//: [注意/ちゅうい]:
//: - `new_len` は `cap` 以下でなければなりません。capacity 確保は呼び出し前に `string_builder_reserve_result` で済ませます。
fn string_builder_with_len <(StringBuilder,i32)->StringBuilder> (sb, new_len):
    let cap0 <i32> get sb "cap";
    StringBuilder get sb "data" new_len cap0

//: string_builder_free: builder が保持する byte buffer を解放する
//:
//: [目的/もくてき]:
//: - `StringBuilder` owner を消費し、内部 buffer があれば allocator へ返します。
//:
//: [実装/じっそう]:
//: - data が `Some` の場合だけ `dealloc_ptr<u8>` を呼びます。
//:
//: [注意/ちゅうい]:
//: - cleanup 用 helper なので、dealloc failure は戻り値にせず破棄します。
//: - 呼び出し後の builder は再利用しません。
//:
//: [計算量/けいさんりょう]:
//: - allocator に依存します。
fn string_builder_free <(StringBuilder)->()> (sb):
    let cap0 <i32> get sb "cap";
    match get sb "data":
        Option::Some data:
            match dealloc_ptr<u8> data cap0:
                Result::Ok _:
                    ()
                Result::Err _e:
                    ()
        Option::None:
            ()

//: string_builder_next_capacity: append に必要な次 capacity を計算する
//:
//: [目的/もくてき]:
//: - 現在 capacity と必要 byte 数から、2 倍 growth 後の capacity を求めます。
//:
//: [実装/じっそう]:
//: - 最小 capacity を 64 とし、needed 以上になるまで倍増します。
//: - overflow で値が増えなくなった場合は `Result::Err` を返します。
//:
//: [注意/ちゅうい]:
//: - byte 数を扱う helper であり、UTF-8 境界の検証は行いません。
//:
//: [計算量/けいさんりょう]:
//: - O(log needed)
fn string_builder_next_capacity <(i32,i32)->Result<i32,str>> (cap, needed):
    let mut next <i32>:
        if:
            le cap 0
            then 64
            else cap
    let mut failed <bool> false;
    while and lt next needed not failed:
        do:
            let doubled <i32> mul next 2;
            if:
                le doubled next
                then set failed true
                else set next doubled
    if:
        failed
        then Result<i32,str>::Err "string.builder capacity exceeded"
        else Result<i32,str>::Ok next

//: string_builder_with_capacity_result: 指定 capacity の builder を作る
//:
//: [目的/もくてき]:
//: - 呼び出し側が初期 capacity を選べる形で `StringBuilder` を初期化します。
//:
//: [実装/じっそう]:
//: - capacity が 0 の場合は allocation しない空 builder を返します。
//: - 正の capacity では `alloc_ptr<u8>` で byte buffer を確保します。
//:
//: [注意/ちゅうい]:
//: - capacity は byte 数です。負数は `Result::Err` になります。
//:
//: [計算量/けいさんりょう]:
//: - allocator に依存します。
fn string_builder_with_capacity_result <(i32)->Result<StringBuilder,str>> (capacity):
    if:
        lt capacity 0
        then:
            Result<StringBuilder,str>::Err "string.builder invalid capacity"
        else:
            if:
                eq capacity 0
                then:
                    Result<StringBuilder,str>::Ok string_builder_empty
                else:
                    match alloc_ptr<u8> capacity:
                        Result::Ok data:
                            Result<StringBuilder,str>::Ok string_builder_from_owned_ptr data 0 capacity
                        Result::Err _e:
                            Result<StringBuilder,str>::Err "string.builder allocation failed"

//: string_builder_reserve_result: append 前に必要 byte capacity を確保する
//:
//: [目的/もくてき]:
//: - 追加予定 byte 数を受け取り、builder buffer が `len + additional` 以上の capacity を持つようにします。
//:
//: [実装/じっそう]:
//: - capacity が足りていれば builder をそのまま返します。
//: - 不足時は `string_builder_next_capacity` で次 capacity を計算し、未確保なら `alloc_ptr<u8>`、既存 buffer があれば `realloc_ptr<u8>` を使います。
//:
//: [注意/ちゅうい]:
//: - error を返す場合、保持済み buffer は可能な範囲で解放して owner を残しません。
//: - この helper は byte buffer の確保だけを行い、内容の copy は `sb_append_result` が行います。
//:
//: [計算量/けいさんりょう]:
//: - grow なしなら O(1)、grow ありなら allocator / realloc に依存します。
fn string_builder_reserve_result <(StringBuilder,i32)->Result<StringBuilder,str>> (sb, additional):
    let len0 <i32> get sb "len";
    let cap0 <i32> get sb "cap";
    if:
        lt additional 0
        then:
            string_builder_free sb;
            Result<StringBuilder,str>::Err "string.builder invalid reserve"
        else:
            let needed <i32> add len0 additional;
            if:
                lt needed len0
                then:
                    string_builder_free sb;
                    Result<StringBuilder,str>::Err "string.builder capacity exceeded"
                else:
                    if:
                        le needed cap0
                        then:
                            Result<StringBuilder,str>::Ok sb
                        else:
                            match string_builder_next_capacity cap0 needed:
                                Result::Err e:
                                    string_builder_free sb;
                                    Result<StringBuilder,str>::Err e
                                Result::Ok next_cap:
                                    if:
                                        le cap0 0
                                        then:
                                            match get sb "data":
                                                Option::Some data:
                                                    match dealloc_ptr<u8> data 0:
                                                        Result::Ok _:
                                                            ()
                                                        Result::Err _free:
                                                            ()
                                                    Result<StringBuilder,str>::Err "string.builder invalid reserve"
                                                Option::None:
                                                    match alloc_ptr<u8> next_cap:
                                                        Result::Ok data:
                                                            Result<StringBuilder,str>::Ok string_builder_from_owned_ptr data len0 next_cap
                                                        Result::Err _e:
                                                            Result<StringBuilder,str>::Err "string.builder allocation failed"
                                        else:
                                            match get sb "data":
                                                Option::None:
                                                    Result<StringBuilder,str>::Err "string.builder invalid reserve"
                                                Option::Some old:
                                                    match realloc_ptr<u8> old cap0 next_cap:
                                                        Result::Ok data:
                                                            Result<StringBuilder,str>::Ok string_builder_from_owned_ptr data len0 next_cap
                                                        Result::Err _e:
                                                            match dealloc_ptr<u8> old cap0:
                                                                Result::Ok _:
                                                                    ()
                                                                Result::Err _free:
                                                                    ()
                                                            Result<StringBuilder,str>::Err "string.builder allocation failed"

//: string_builder_new_result: 空の StringBuilder を作る
//:
//: [目的/もくてき]:
//: - 既定 capacity の byte buffer を持つ builder を初期化します。
//:
//: [実装/じっそう]:
//: - `string_builder_with_capacity_result 64` を呼び、最初の小さな append で realloc しないようにします。
//:
//: [注意/ちゅうい]:
//: - `string_builder_new` は失敗時に空 builder fallback を返します。
//: - allocation failure を診断として伝えたい場合は `string_builder_new_result` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn string_builder_new_result <()->Result<StringBuilder,str>> ():
    string_builder_with_capacity_result 64

fn string_builder_new <()->StringBuilder> ():
    match string_builder_new_result:
        Result::Ok sb:
            sb
        Result::Err _e:
            string_builder_empty

//: sb_append_result: builder に文字列片を追加する
//:
//: [目的/もくてき]:
//: - `s` の byte 列を builder の末尾へ copy し、更新後の builder を返します。
//:
//: [実装/じっそう]:
//: - `string_builder_reserve_result` で capacity を確保し、`mem_copy<u8>` で本文 byte を追加します。
//:
//: [注意/ちゅうい]:
//: - `s` は source として参照されるだけで、builder は `str` owner を保持しません。
//: - `sb_append` は失敗時に空 builder fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(s))。grow が発生した場合は既存 byte 数に応じた再確保 cost が加わります。
fn sb_append_result <(StringBuilder,str)->Result<StringBuilder,str>> (sb, s):
    let s_len <i32> len s;
    if:
        eq s_len 0
        then:
            Result<StringBuilder,str>::Ok sb
        else:
            match string_builder_reserve_result sb s_len:
                Result::Err e:
                    Result<StringBuilder,str>::Err e
                Result::Ok reserved:
                    let len0 <i32> get reserved "len";
                    match *get_ref &reserved "data":
                        Option::None:
                            string_builder_free reserved;
                            Result<StringBuilder,str>::Err "string.builder append invalid storage"
                        Option::Some data:
                            let dst <MemPtr<u8>> mem_ptr_add data len0;
                            match mem_copy<u8> dst string_data_ptr s s_len:
                                Result::Ok _:
                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 s_len
                                Result::Err _e:
                                    string_builder_free reserved;
                                    Result<StringBuilder,str>::Err "string.builder append copy failed"

fn sb_finish_char_append <(StringBuilder,i32)->Result<StringBuilder,str>> (reserved, count):
    let len0 <i32> get reserved "len"
    match *get_ref &reserved "data":
        Option::Some _data:
            Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 count
        Option::None:
            string_builder_free reserved
            Result<StringBuilder,str>::Err "string.builder append invalid storage"

//: sb_append_char_result: builder に char を UTF-8 として追加する
//:
//: [目的/もくてき]:
//: - 1 つの `char` を UTF-8 bytes に encode し、builder の末尾へ追加します。
//:
//: [注意/ちゅうい]:
//: - 失敗時は入力 builder の内部 buffer を解放します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
fn sb_append_char_result <(StringBuilder,char)->Result<StringBuilder,str>> (sb, c):
    let count <i32> char_utf8_len c
    match string_builder_reserve_result sb count:
        Result::Err e:
            Result<StringBuilder,str>::Err e
        Result::Ok reserved:
            let len0 <i32> get reserved "len"
            match *get_ref &reserved "data":
                Option::None:
                    string_builder_free reserved
                    Result<StringBuilder,str>::Err "string.builder append invalid storage"
                Option::Some data:
                    let dst <MemPtr<u8>> mem_ptr_add data len0
                    match store_u8 dst char_utf8_byte0 c:
                        Result::Err _e:
                            string_builder_free reserved
                            Result<StringBuilder,str>::Err "string.builder append char failed"
                        Result::Ok _:
                            if:
                                eq count 1
                                then:
                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 count
                                else:
                                    match store_u8 mem_ptr_add dst 1 char_utf8_byte1 c:
                                        Result::Err _e:
                                            string_builder_free reserved
                                            Result<StringBuilder,str>::Err "string.builder append char failed"
                                        Result::Ok _:
                                            if:
                                                eq count 2
                                                then:
                                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 count
                                                else:
                                                    match store_u8 mem_ptr_add dst 2 char_utf8_byte2 c:
                                                        Result::Err _e:
                                                            string_builder_free reserved
                                                            Result<StringBuilder,str>::Err "string.builder append char failed"
                                                        Result::Ok _:
                                                            if:
                                                                eq count 3
                                                                then:
                                                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 count
                                                                else:
                                                                    match store_u8 mem_ptr_add dst 3 char_utf8_byte3 c:
                                                                        Result::Err _e:
                                                                            string_builder_free reserved
                                                                            Result<StringBuilder,str>::Err "string.builder append char failed"
                                                                        Result::Ok _:
                                                                            Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 count

//: sb_append_ascii_result: builder に ASCII char を 1 byte として追加する
//:
//: [目的/もくてき]:
//: - protocol marker や lexer punctuation のように ASCII として決まっている文字だけを追加します。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `Err` です。入力 builder は失敗時に解放されます。
fn sb_append_ascii_result <(StringBuilder,char)->Result<StringBuilder,str>> (sb, c):
    if:
        char_is_ascii c
        then:
            match string_builder_reserve_result sb 1:
                Result::Err e:
                    Result<StringBuilder,str>::Err e
                Result::Ok reserved:
                    let len0 <i32> get reserved "len"
                    match *get_ref &reserved "data":
                        Option::None:
                            string_builder_free reserved
                            Result<StringBuilder,str>::Err "string.builder append invalid storage"
                        Option::Some data:
                            let dst <MemPtr<u8>> mem_ptr_add data len0
                            match store_u8 dst char_to_i32 c:
                                Result::Ok _:
                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 1
                                Result::Err _e:
                                    string_builder_free reserved
                                    Result<StringBuilder,str>::Err "string.builder append ascii failed"
        else:
            string_builder_free sb
            Result<StringBuilder,str>::Err "string.builder non-ascii char"

//: sb_append_byte_result: builder に検証済みの 1 byte を追加する
//:
//: [目的/もくてき]:
//: - 既存の UTF-8 文字列や byte buffer から読んだ byte を、追加の `str` 確保なしで builder へ追加します。
//:
//: [注意/ちゅうい]:
//: - この関数は byte の UTF-8 妥当性を検証しません。呼び出し側は元の byte 列が UTF-8 として妥当であることを保証してください。
//: - `byte` が 0..255 の範囲外なら入力 builder を解放して `Err` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
fn sb_append_byte_result <(StringBuilder,i32)->Result<StringBuilder,str>> (sb, byte):
    if:
        or lt byte 0 gt byte 255
        then:
            string_builder_free sb
            Result<StringBuilder,str>::Err "string.builder invalid byte"
        else:
            match string_builder_reserve_result sb 1:
                Result::Err e:
                    Result<StringBuilder,str>::Err e
                Result::Ok reserved:
                    let len0 <i32> get reserved "len"
                    match *get_ref &reserved "data":
                        Option::None:
                            string_builder_free reserved
                            Result<StringBuilder,str>::Err "string.builder append invalid storage"
                        Option::Some data:
                            let dst <MemPtr<u8>> mem_ptr_add data len0
                            match store_u8 dst byte:
                                Result::Ok _:
                                    Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 1
                                Result::Err _e:
                                    string_builder_free reserved
                                    Result<StringBuilder,str>::Err "string.builder append byte failed"

fn sb_append_char <(StringBuilder,char)->StringBuilder> (sb, c):
    match sb_append_char_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

fn sb_append_ascii <(StringBuilder,char)->StringBuilder> (sb, c):
    match sb_append_ascii_result sb c:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

fn sb_append_byte <(StringBuilder,i32)->StringBuilder> (sb, byte):
    match sb_append_byte_result sb byte:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

fn sb_append <(StringBuilder,str)->StringBuilder> (sb, s):
    match sb_append_result sb s:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

//: sb_append_i32_result: i32 を 10 進文字列化して builder に追加する
//:
//: [目的/もくてき]:
//: - 診断やログで整数値を builder に混ぜるため、`v` を `from_i32_radix v 10` で文字列化して追加します。
//:
//: [実装/じっそう]:
//: - 変換に成功した文字列を `sb_append_result` へ渡します。
//:
//: [注意/ちゅうい]:
//: - 数値変換または builder grow の失敗は `Result::Err` として返します。
//: - `sb_append_i32` は失敗時に空 builder fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(d) + builder append の cost です。`d` は 10 進桁数です。
fn sb_append_i32_result <(StringBuilder,i32)->Result<StringBuilder,str>> (sb, v):
    match from_i32_radix v 10:
        Result::Ok text:
            sb_append_result sb text
        Result::Err _e:
            Result<StringBuilder,str>::Err "string.builder append_i32 conversion failed"

fn sb_append_i32 <(StringBuilder,i32)->StringBuilder> (sb, v):
    match sb_append_i32_result sb v:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty

//: sb_build_result: builder の全 part を 1 つの str にまとめる
//:
//: [目的/もくてき]:
//: - builder に蓄積した part を、連続した byte 列を持つ新しい `str` として返します。
//:
//: [実装/じっそう]:
//: - builder の byte 長で出力領域を 1 回確保し、buffer 全体を copy して `str` として確定します。
//:
//: [注意/ちゅうい]:
//: - 出力は新規確保された文字列です。build 後、builder buffer は解放されます。
//: - `sb_build` は失敗時に空文字列 fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(total_bytes)
fn sb_build_result <(StringBuilder)->Result<str,str>> (sb):
    let len0 <i32> get sb "len";
    let cap0 <i32> get sb "cap";
    if:
        le len0 0
        then:
            string_builder_free sb;
            Result<str,str>::Ok ""
        else:
            match get sb "data":
                Option::None:
                    Result<str,str>::Err "string.builder build invalid storage"
                Option::Some data:
                    match string_alloc_region len0:
                        Result::Err e:
                            match dealloc_ptr<u8> data cap0:
                                Result::Ok _:
                                    ()
                                Result::Err _free:
                                    ()
                            Result<str,str>::Err e
                        Result::Ok out_region:
                            let out_data <MemPtr<u8>> string_region_data_ptr &out_region;
                            match mem_copy<u8> out_data data len0:
                                Result::Ok _:
                                    match dealloc_ptr<u8> data cap0:
                                        Result::Ok _:
                                            ()
                                        Result::Err _free:
                                            ()
                                    Result<str,str>::Ok string_finish out_region len0
                                Result::Err _e:
                                    match dealloc_ptr<u8> data cap0:
                                        Result::Ok _:
                                            ()
                                        Result::Err _free:
                                            ()
                                    match dealloc_region<u8> out_region:
                                        Result::Ok _:
                                            ()
                                        Result::Err _free_out:
                                            ()
                                    Result<str,str>::Err "string.builder build copy failed"

fn sb_build <(StringBuilder)->str> (sb):
    match sb_build_result sb:
        Result::Ok out:
            out
        Result::Err _e:
            ""

//: str_eq: 2 つの文字列が byte 列として等しいか判定する
//:
//: [目的/もくてき]:
//: - `a` と `b` の内容が完全に同じなら `true` を返します。
//:
//: [実装/じっそう]:
//: - 先に byte 長を比較し、一致した場合だけ本文を先頭から 1 byte ずつ比較します。
//:
//: [注意/ちゅうい]:
//: - 大文字小文字の正規化、Unicode 正規化、locale 依存比較は行いません。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_eq <(str,str)->bool> (a,b):
    let la <i32> len a;
    let lb <i32> len b;
    if:
        eq la lb
        then str_eq_loop a b la 0
        else false

//: str_eq_loop: 先頭から n byte を比較する内部ループ
//:
//: [目的/もくてき]:
//: - `str_eq`、prefix/suffix 判定、検索補助から使う共通の byte 比較処理です。
//:
//: [実装/じっそう]:
//: - index `i` から `n` まで 1 byte ずつ読み、一致しない byte を見つけた時点で `false` を返します。
//:
//: [注意/ちゅうい]:
//: - 呼び出し側が `a` と `b` の対象範囲を保証する内部 helper です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_eq_loop <(str,str,i32,i32)->bool> (a,b,n,i):
    if:
        eq i n
        then:
            true
        else:
            let ba <i32> string_byte_at_unchecked a i;
            let bb <i32> string_byte_at_unchecked b i;
            if:
                eq ba bb
                then str_eq_loop a b n <i32> add i 1
                else false

//: str_is_space: ASCII 空白 byte か判定する
//:
//: [目的/もくてき]:
//: - trim や簡易 scanner で使う ASCII 空白判定を提供します。
//:
//: [実装/じっそう]:
//: - space、tab、LF、CR の byte 値だけを char literal の match で分類します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 の空白文字全般は扱いません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn str_is_space <(i32)->bool> (b):
    match b:
        ' ':
            true
        '\t':
            true
        '\n':
            true
        '\r':
            true
        _:
            false

//: str_starts_with: 先頭 byte 列が prefix と一致するか判定する
//:
//: [目的/もくてき]:
//: - `s` が `prefix` で始まるかを調べます。
//:
//: [実装/じっそう]:
//: - `prefix` が `s` より長い場合は即座に `false` を返し、それ以外は前方 byte を比較します。
//:
//: [注意/ちゅうい]:
//: - 比較は UTF-8 文字単位ではなく byte 列単位です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(prefix))
fn str_starts_with <(str,str)->bool> (s, prefix):
    let ls <i32> len s;
    let lp <i32> len prefix;
    if:
        lt ls lp
        then false
        else str_eq_loop s prefix lp 0

//: str_eq_at: 指定 byte 位置から pat と一致するか判定する
//:
//: [目的/もくてき]:
//: - `s[start..start+n]` と `pat[0..n]` の byte 列一致を調べます。
//:
//: [実装/じっそう]:
//: - `i` を増やしながら `s` と `pat` の対応 byte を比較します。
//:
//: [注意/ちゅうい]:
//: - 呼び出し側が `start + n <= len(s)` と `n <= len(pat)` を保証する内部 helper です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_eq_at <(str,str,i32,i32,i32)->bool> (s, pat, start, n, i):
    if:
        eq i n
        then true
        else:
            let s_off <i32> add start i;
            let bs <i32> string_byte_at_unchecked s s_off;
            let bp <i32> string_byte_at_unchecked pat i;
            if:
                eq bs bp
                then str_eq_at s pat start n <i32> add i 1
                else false

//: str_starts_with_at: 指定 byte 位置から prefix が始まるか判定する
//:
//: [目的/もくてき]:
//: - scanner や parser が `s[start..]` の先頭を literal prefix と比較するときの安全な入口です。
//: - 呼び出し側に `prefix` の長さや内部 loop index を渡させず、範囲確認をこの関数に閉じ込めます。
//:
//: [実装/じっそう]:
//: - `start` が負、または `s` の末尾を越える場合は `false` を返します。
//: - `prefix` が残り byte 数より長い場合は `false`、それ以外は `str_eq_at` で byte 比較します。
//:
//: [注意/ちゅうい]:
//: - 比較は UTF-8 文字単位ではなく byte 列単位です。
//: - `prefix` が空文字列なら、`0 <= start <= len(s)` のとき `true` です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(prefix))
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push assert str_starts_with_at "abc" 0 "ab"
//:         |> checks_push assert str_starts_with_at "abc" 1 "bc"
//:         |> checks_push assert str_starts_with_at "abc" 3 ""
//:         |> checks_push assert not str_starts_with_at "abc" -1 "a"
//:         |> checks_push assert not str_starts_with_at "abc" 2 "bc"
//:         |> checks_push assert not str_starts_with_at "abc" 4 ""
//:     checks_exit_code checks
//: ```
fn str_starts_with_at <(str,i32,str)->bool> (s, start, prefix):
    let ls <i32> len s;
    let lp <i32> len prefix;
    if:
        lt start 0
        then:
            false
        else:
            if:
                gt start ls
                then:
                    false
                else:
                    if:
                        lt sub ls start lp
                        then:
                            false
                        else:
                            str_eq_at s prefix start lp 0

//: str_trim_suffix_cr: 末尾 CR を 1 byte だけ取り除く
//:
//: [目的/もくてき]:
//: - byte scanner で LF 直前まで切った CRLF 行から、残った CR を取り除きます。
//:
//: [注意/ちゅうい]:
//: - 末尾が CR でない場合は元の `str` を返します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     if:
//:         str_eq "abc" str_trim_suffix_cr "abc\r"
//:         then:
//:             if:
//:                 str_eq "abc" str_trim_suffix_cr "abc"
//:                 then 0
//:                 else 1
//:         else 1
//: ```
fn str_trim_suffix_cr <(str)->str> (s):
    let n <i32> len s
    if:
        and gt n 0 eq string_byte_at_unchecked s sub n 1 '\r'
        then str_slice s 0 sub n 1
        else s

//: str_slice_trim_suffix_cr: 範囲切り出しと末尾 CR 除去を 1 回の str 構築にまとめる
//:
//: [目的/もくてき]:
//: - `str_trim_suffix_cr str_slice s start end` と同じ結果を、不要な中間 `str` を作らずに返します。
//:
//: [実装/じっそう]:
//: - `str_slice` と同じ境界丸めを行い、丸め後の末尾 byte が CR なら end を 1 byte 戻してから切り出します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 境界検査と失敗時 fallback は最終的な `str_slice` に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn str_slice_trim_suffix_cr <(str,i32,i32)->str> (s, start, end):
    let n <i32> len s
    let mut s0 <i32> start
    let mut e0 <i32> end
    if:
        lt s0 0
        then set s0 0
        else ()
    if:
        lt e0 s0
        then set e0 s0
        else ()
    if:
        lt n e0
        then set e0 n
        else ()
    if:
        and gt e0 s0 eq string_byte_at_unchecked s sub e0 1 '\r'
        then str_slice s s0 sub e0 1
        else str_slice s s0 e0

//: str_ends_with: 末尾 byte 列が suffix と一致するか判定する
//:
//: [目的/もくてき]:
//: - `s` が `suffix` で終わるかを調べます。
//:
//: [実装/じっそう]:
//: - `suffix` が `s` より長い場合は `false`、それ以外は末尾開始位置から byte 比較します。
//:
//: [注意/ちゅうい]:
//: - 比較は byte 列単位です。
//:
//: [計算量/けいさんりょう]:
//: - O(len(suffix))
fn str_ends_with <(str,str)->bool> (s, suffix):
    let ls <i32> len s;
    let lp <i32> len suffix;
    if:
        lt ls lp
        then false
        else:
            let start <i32> sub ls lp;
            str_eq_at s suffix start lp 0

//: str_utf8_is_boundary: byte index が UTF-8 文字境界か判定する
//:
//: [目的/もくてき]:
//: - `str_slice_result` が valid UTF-8 の途中 byte から新しい `str` を作らないようにします。
//:
//: [実装/じっそう]:
//: - 0 と `len(s)` は常に境界として扱います。
//: - それ以外の位置では、その byte が UTF-8 continuation byte でなければ境界です。
//:
//: [注意/ちゅうい]:
//: - `s` 自体は valid UTF-8 である前提です。
//: - 範囲外 index は `false` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn str_utf8_is_boundary <(str,i32)->bool> (s, idx):
    let n <i32> len s;
    if:
        lt idx 0
        then:
            false
        else:
            if:
                eq idx 0
                then:
                    true
                else:
                    if:
                        eq idx n
                        then:
                            true
                        else:
                            if:
                                lt n idx
                                then:
                                    false
                                else:
                                    not string_utf8_is_continuation string_byte_at_unchecked s idx

//: str_slice_result: UTF-8 境界に揃った byte 範囲を新しい str として切り出す
//:
//: [目的/もくてき]:
//: - `s[start..end]` の byte 範囲を copy した新しい `str` を返します。
//:
//: [実装/じっそう]:
//: - `start` は 0 未満なら 0 に、`end` は `start` 未満なら `start` に、`len(s)` より大きければ `len(s)` に丸めます。
//: - 丸め後の start/end が UTF-8 文字境界であることを確認してから、新しい `str` 領域へ copy します。
//:
//: [注意/ちゅうい]:
//: - index は byte index です。ただし `str` の UTF-8 不変条件を守るため、文字境界でない範囲は `Result::Err` にします。
//: - `str_slice` は失敗時に空文字列 fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn str_slice_result <(str,i32,i32)->Result<str,str>> (s, start, end):
    let n <i32> len s;
    let mut s0 <i32> start;
    let mut e0 <i32> end;
    if:
        lt s0 0
        then set s0 0
        else ()
    if:
        lt e0 s0
        then set e0 s0
        else ()
    if:
        lt n e0
        then set e0 n
        else ()
    let out_len <i32> sub e0 s0;
    if:
        and str_utf8_is_boundary s s0 str_utf8_is_boundary s e0
        then:
            string_from_mem_unchecked_result mem_ptr_add string_data_ptr s s0 out_len
        else:
            Result<str,str>::Err "string.slice invalid utf8 boundary"

fn str_slice <(str,i32,i32)->str> (s, start, end):
    match str_slice_result s start end:
        Result::Ok out:
            out
        Result::Err _e:
            ""

fn str_next_char_ok <(char,i32)->Result<CharUtf8Step,str>> (c, next_byte_index):
    Result<CharUtf8Step,str>::Ok char_utf8_step_new c next_byte_index

fn str_decode_char_result <(i32,i32)->Result<CharUtf8Step,str>> (code, next_byte_index):
    match char_from_i32_result code:
        Result::Err _e:
            Result<CharUtf8Step,str>::Err "string.char invalid scalar"
        Result::Ok c:
            str_next_char_ok c next_byte_index

//: str_next_char_result: byte offset から次の char と次 byte offset を読む
//:
//: [目的/もくてき]:
//: - `str` を byte index で保持したまま、UTF-8 の 1 scalar value だけを安全に decode します。
//:
//: [注意/ちゅうい]:
//: - `byte_index` は UTF-8 文字境界でなければなりません。
//: - 戻り値の `CharUtf8Step.value` が `char`、`CharUtf8Step.next` が次の byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn str_next_char_result <(str,i32)->Result<CharUtf8Step,str>> (s, byte_index):
    let n <i32> len s
    if:
        or lt byte_index 0 le n byte_index
        then:
            Result<CharUtf8Step,str>::Err "string.char index out of bounds"
        else:
            if:
                not str_utf8_is_boundary s byte_index
                then:
                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 boundary"
                else:
                    let b0 <i32> string_byte_at_unchecked s byte_index
                    if:
                        le b0 0x7F
                        then:
                            str_decode_char_result b0 add byte_index 1
                        else:
                            match string_utf8_lead_kind b0:
                                StringUtf8LeadKind::Ascii:
                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 leading byte"
                                StringUtf8LeadKind::Two:
                                    if:
                                        le n add byte_index 1
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            if:
                                                string_utf8_is_continuation b1
                                                then:
                                                    let hi <i32> shl and b0 0x1F 6
                                                    let lo <i32> and b1 0x3F
                                                    str_decode_char_result or hi lo add byte_index 2
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 continuation"
                                StringUtf8LeadKind::Three:
                                    if:
                                        le n add byte_index 2
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            let b2 <i32> string_byte_at_unchecked s add byte_index 2
                                            let first_ok <bool>:
                                                if:
                                                    eq b0 0xE0
                                                    then:
                                                        string_utf8_in_range b1 0xA0 0xBF
                                                    else:
                                                        if:
                                                            eq b0 0xED
                                                            then:
                                                                string_utf8_in_range b1 0x80 0x9F
                                                            else:
                                                                string_utf8_is_continuation b1
                                            if:
                                                and first_ok string_utf8_is_continuation b2
                                                then:
                                                    let part0 <i32> shl and b0 0x0F 12
                                                    let part1 <i32> shl and b1 0x3F 6
                                                    let part2 <i32> and b2 0x3F
                                                    str_decode_char_result or part0 or part1 part2 add byte_index 3
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 three-byte sequence"
                                StringUtf8LeadKind::Four:
                                    if:
                                        le n add byte_index 3
                                        then:
                                            Result<CharUtf8Step,str>::Err "string.char truncated utf8"
                                        else:
                                            let b1 <i32> string_byte_at_unchecked s add byte_index 1
                                            let b2 <i32> string_byte_at_unchecked s add byte_index 2
                                            let b3 <i32> string_byte_at_unchecked s add byte_index 3
                                            let first_ok <bool>:
                                                if:
                                                    eq b0 0xF0
                                                    then:
                                                        string_utf8_in_range b1 0x90 0xBF
                                                    else:
                                                        if:
                                                            eq b0 0xF4
                                                            then:
                                                                string_utf8_in_range b1 0x80 0x8F
                                                            else:
                                                                string_utf8_is_continuation b1
                                            if:
                                                and first_ok and string_utf8_is_continuation b2 string_utf8_is_continuation b3
                                                then:
                                                    let part0 <i32> shl and b0 0x07 18
                                                    let part1 <i32> shl and b1 0x3F 12
                                                    let part2 <i32> shl and b2 0x3F 6
                                                    let part3 <i32> and b3 0x3F
                                                    str_decode_char_result or part0 or part1 or part2 part3 add byte_index 4
                                                else:
                                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 four-byte sequence"
                                StringUtf8LeadKind::Invalid:
                                    Result<CharUtf8Step,str>::Err "string.char invalid utf8 leading byte"

//: str_char_count: `str` に含まれる Unicode scalar value 数を数える
//:
//: [注意/ちゅうい]:
//: - byte length ではありません。byte length が必要な場合は `str_byte_len` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_count <(str)->i32> (s):
    let n <i32> len s
    let mut byte_i <i32> 0
    let mut char_count <i32> 0
    let mut done <bool> false
    while and lt byte_i n not done:
        do:
            match str_next_char_result s byte_i:
                Result::Err _e:
                    set done true
                Result::Ok item:
                    let next <i32> get item "next";
                    set byte_i next;
                    let next_count <i32> add char_count 1;
                    set char_count next_count
    char_count

//: str_char_byte_index_result: char index を byte offset へ変換する
//:
//: [目的/もくてき]:
//: - char 単位 API の入口で、byte-oriented `str_slice_result` へ渡す offset を求めます。
//:
//: [注意/ちゅうい]:
//: - `char_index == str_char_count s` のときは末尾 byte offset を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_byte_index_result <(str,i32)->Result<i32,str>> (s, char_index):
    if:
        lt char_index 0
        then:
            Result<i32,str>::Err "string.char index out of bounds"
        else:
            let n <i32> len s
            let mut byte_i <i32> 0
            let mut char_i <i32> 0
            let mut failed <bool> false
            while and lt char_i char_index not failed:
                do:
                    if:
                        le n byte_i
                        then:
                            set failed true
                        else:
                            match str_next_char_result s byte_i:
                                Result::Err _e:
                                    set failed true
                                Result::Ok item:
                                    let next <i32> get item "next";
                                    set byte_i next;
                                    let next_char_i <i32> add char_i 1;
                                    set char_i next_char_i
            if:
                failed
                then:
                    Result<i32,str>::Err "string.char index out of bounds"
                else:
                    Result<i32,str>::Ok byte_i

//: str_char_at_result: char index で 1 つの char を読む
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_char_at_result <(str,i32)->Result<char,str>> (s, char_index):
    match str_char_byte_index_result s char_index:
        Result::Err e:
            Result<char,str>::Err e
        Result::Ok byte_i:
            if:
                le len s byte_i
                then:
                    Result<char,str>::Err "string.char index out of bounds"
                else:
                    match str_next_char_result s byte_i:
                        Result::Err e:
                            Result<char,str>::Err e
                        Result::Ok item:
                            let c <char> get item "value"
                            Result<char,str>::Ok c

//: str_slice_chars_result: char index 範囲を切り出す
//:
//: [目的/もくてき]:
//: - char index の半開区間 `[start_char, end_char)` を byte boundary へ変換し、新しい `str` として返します。
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len + slice_byte_len)
fn str_slice_chars_result <(str,i32,i32)->Result<str,str>> (s, start_char, end_char):
    if:
        or lt start_char 0 lt end_char start_char
        then:
            Result<str,str>::Err "string.char invalid slice range"
        else:
            match str_char_byte_index_result s start_char:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok start_byte:
                    match str_char_byte_index_result s end_char:
                        Result::Err e:
                            Result<str,str>::Err e
                        Result::Ok end_byte:
                            str_slice_result s start_byte end_byte

//: str_starts_with_char: `str` が指定 char で始まるか判定する
fn str_starts_with_char <(str,char)->bool> (s, c):
    if:
        eq len s 0
        then:
            false
        else:
            match str_next_char_result s 0:
                Result::Err _e:
                    false
                Result::Ok item:
                    let first <char> get item "value"
                    eq char_to_i32 first char_to_i32 c

//: str_contains_char: `str` が指定 char を含むか char 単位で判定する
//:
//: [計算量/けいさんりょう]:
//: - O(byte_len)
fn str_contains_char <(str,char)->bool> (s, c):
    let target <i32> char_to_i32 c
    let n <i32> len s
    let mut byte_i <i32> 0
    let mut found <bool> false
    let mut done <bool> false
    while and lt byte_i n not done:
        do:
            match str_next_char_result s byte_i:
                Result::Err _e:
                    set done true
                Result::Ok item:
                    let current <char> get item "value"
                    if:
                        eq char_to_i32 current target
                        then:
                            set found true;
                            set done true
                        else:
                            let next <i32> get item "next"
                            set byte_i next
    found

//: str_trim: 前後の ASCII 空白を取り除く
//:
//: [目的/もくてき]:
//: - 先頭と末尾の space/tab/LF/CR を除いた文字列を返します。
//:
//: [実装/じっそう]:
//: - 先頭側と末尾側から `str_is_space` が true の byte を読み飛ばします。
//: - 最後に残った byte 範囲を `str_slice` で切り出します。
//:
//: [注意/ちゅうい]:
//: - 空白判定は ASCII のみです。
//: - allocation failure は `str_slice` の fallback に従って空文字列になり得ます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_trim <(str)->str> (s):
    let n <i32> len s;
    let mut start <i32> 0;
    let mut end <i32> n;
    let mut done <i32> 0;
    while eq done 0:
        do:
            if:
                lt start end
                then:
                    let b <i32> string_byte_at_unchecked s start;
                    if:
                        str_is_space b
                        then set start <i32> add start 1
                        else set done 1
                else:
                    set done 1
    let mut done2 <i32> 0;
    while eq done2 0:
        do:
            if:
                lt start end
                then:
                    let idx <i32> sub end 1;
                    let b <i32> string_byte_at_unchecked s idx;
                    if:
                        str_is_space b
                        then set end <i32> sub end 1
                        else set done2 1
                else:
                    set done2 1
    str_slice s start end

//: str_match_at: split/search 用の位置一致判定
//:
//: [目的/もくてき]:
//: - `s` の `pos` から `sep` が始まるかを byte 列で判定します。
//:
//: [実装/じっそう]:
//: - `sep_len` byte 分を先頭から順に比較し、不一致があれば loop を止めます。
//:
//: [注意/ちゅうい]:
//: - 呼び出し側が `pos + sep_len <= len(s)` を保証する内部 helper です。
//:
//: [計算量/けいさんりょう]:
//: - O(sep_len)
fn str_match_at <(str,str,i32,i32)->bool> (s, sep, pos, sep_len):
    let mut i <i32> 0;
    let mut ok <i32> 1;
    while lt i sep_len:
        do:
            let rd_off <i32> add pos i;
            let bs <i32> string_byte_at_unchecked s rd_off;
            let bp <i32> string_byte_at_unchecked sep i;
            if:
                eq bs bp
                then set i <i32> add i 1
                else:
                    set ok 0
                    set i sep_len
    eq ok 1

//: str_split_result: 区切り文字列で byte 走査して分割する
//:
//: [目的/もくてき]:
//: - `s` を `sep` の出現位置で分割し、各 part を `Vec<str>` として返します。
//:
//: [実装/じっそう]:
//: - 先に分割数を数えて `Vec<str>` の容量を確保します。
//: - その後、同じ byte 走査で各 part を `str_slice_result` し、確保済み storage に直接格納します。
//:
//: [注意/ちゅうい]:
//: - `sep` が空文字列の場合は `s` だけを含む `Vec` を返します。
//: - split point は byte index で扱います。UTF-8 文字境界の検査は行いません。
//: - `str_split` は失敗時に空 `Vec` fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - n を `s` の byte 長、m を `sep` の byte 長として O(n * m + total_part_bytes) です。
fn str_split_count <(str,str,i32,i32)->i32> (s, sep, s_len, sep_len):
    if:
        eq sep_len 0
        then:
            1
        else:
            let mut part_total <i32> 1
            let mut i <i32> 0
            let mut scan_end <i32> sep_len
            while le scan_end s_len:
                do:
                    if:
                        str_match_at s sep i sep_len
                        then:
                            set part_total add part_total 1;
                            set i add i sep_len;
                            set scan_end add i sep_len;
                        else:
                            set i add i 1;
                            set scan_end add i sep_len;
            part_total

fn str_split_result <(str,str)->Result<Vec<str>,str>> (s, sep):
    let sep_len <i32> len sep;
    let s_len <i32> len s;
    let part_count <i32> str_split_count s sep s_len sep_len;
    match v::with_capacity<str> part_count:
        Result::Err _e:
            Result<Vec<str>,str>::Err "string.split allocation failed"
        Result::Ok storage:
            let data <MemPtr<str>> get storage "data"
            let data_raw <i32> mem_ptr_addr data
            let cap0 <i32> get storage "cap"
            let mut out_len <i32> 0
            let mut ok <i32> 1
            let mut err_msg <str> ""
            let mut i <i32> 0;
            let mut start <i32> 0;
            let mut scan_end <i32> add i sep_len;
            if:
                eq sep_len 0
                then:
                    store<str> data_raw s
                    set out_len 1
                else:
                    while and eq ok 1 le scan_end s_len:
                        do:
                            if:
                                str_match_at s sep i sep_len
                                then:
                                    match str_slice_result s start i:
                                        Result::Ok part:
                                            store<str> add data_raw mul out_len size_of<str> part
                                            set out_len add out_len 1
                                            set i <i32> add i sep_len
                                            set start i
                                            set scan_end <i32> add i sep_len
                                        Result::Err e:
                                            set err_msg e
                                            set ok 0
                                else:
                                    set i <i32> add i 1;
                                    set scan_end <i32> add i sep_len;
                    if:
                        eq ok 1
                        then:
                            match str_slice_result s start s_len:
                                Result::Ok tail:
                                    store<str> add data_raw mul out_len size_of<str> tail
                                    set out_len add out_len 1
                                Result::Err e:
                                    set err_msg e
                                    set ok 0
                        else:
                            ()
            if:
                eq ok 1
                then:
                    Result<Vec<str>,str>::Ok v::Vec<str> out_len cap0 data
                else:
                    dealloc_raw data_raw mul cap0 size_of<str>;
                    Result<Vec<str>,str>::Err err_msg

fn str_split <(str,str)->Vec<str>> (s, sep):
    match str_split_result s sep:
        Result::Ok parts:
            parts
        Result::Err _e:
            v::Vec<str> 0 0 mem_ptr_wrap 0

//: from_bool: bool を表示用文字列へ変換する
//:
//: [目的/もくてき]:
//: - `true` を `"true"`、`false` を `"false"` として返します。
//: - 診断文やテスト失敗メッセージで論理値をそのまま表示したい時に使います。
//:
//: [実装/じっそう]:
//: - 分岐だけで固定文字列 literal を選びます。
//:
//: [注意/ちゅうい]:
//: - 返す文字列は表示用の表現です。数値変換や bool 解析ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> str_eq from_bool true "true";
//:     let ok1 <bool> str_eq from_bool false "false";
//:     let ok <bool> and ok0 ok1;
//:     if ok 1 0
//: ```
fn from_bool <(bool)->str> (b):
    if:
        b
        then:
            "true"
        else:
            "false"

//: to_bool: 文字列を bool として解析する
//:
//: [目的/もくてき]:
//: - `"true"` または `"false"` の文字列を `bool` として読み取ります。
//: - 設定値や CLI 引数、テスト入力などで論理値を文字列から受け取る時に使います。
//:
//: [実装/じっそう]:
//: - `str_eq` で `"true"`、続いて `"false"` と比較します。
//:
//: [注意/ちゅうい]:
//: - 受理する表記は小文字の `"true"` / `"false"` のみです。
//: - `"True"` や `"0"` / `"1"` は bool として扱いません。
//: - 解析失敗は `Result::Err 1` で返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     let checks1 match to_bool "true":
//:         Result::Ok v:
//:             checks_push checks0 assert_eq_i32 1 cast v
//:         Result::Err _:
//:             checks_push checks0 assert_eq_i32 1 0
//:     let checks2 match to_bool "false":
//:         Result::Ok v:
//:             checks_push checks1 assert_eq_i32 0 cast v
//:         Result::Err _:
//:             checks_push checks1 assert_eq_i32 1 0
//:     checks_exit_code checks2
//: ```
fn to_bool <(str)->Result<bool,i32>> (s):
    if:
        str_eq s "true"
        then:
            Result::Ok<bool,i32> true
        else:
            if:
                str_eq s "false"
                then:
                    Result::Ok<bool,i32> false
                else:
                    Result::Err<bool,i32> 1

// digit_to_char_lower: 0..15 の数値を小文字 16 進数字へ変換する
//
// 目的:
// - 基数変換で得た 1 桁分の値を、`0-9` または `a-f` の 1 文字へ変換します。
//
// 実装(アルゴリズム):
// - `v < 10` のときは `'0' + v` を返します。
// - それ以外は `'a' + (v - 10)` を返します。
//
// 注意(重要):
// - 呼び出し側は `0 <= v < 16` を満たす値だけを渡す必要があります。
// - 16 以上の値を渡した場合の挙動は未定義です。
//
// 計算量:
// - O(1)
fn digit_to_char_lower <(i32)->i32> (v):
    if:
        lt v 10
        then:
            add '0' v
        else:
            add 'a' sub v 10

// digit_from_char: 1 文字を数値へ変換する
//
// 目的:
// - `0-9`、`a-f`、`A-F` を数値 0..15 へ変換します。
// - 基数付きの文字列解析で各文字の意味を判定する時に使います。
//
// 実装(アルゴリズム):
// - ASCII 範囲を順に判定し、対応する値へ写像します。
// - 数字でも英字でもない場合は `Result::Err 1` を返します。
//
// 注意(重要):
// - 返る値が基数未満かどうかの判定は、この関数ではなく呼び出し側が行います。
// - 英字は大小どちらも受理します。
//
// 計算量:
// - O(1)
fn digit_from_char <(i32)->Result<i32,i32>> (ch):
    if:
        and ge ch '0' le ch '9'
        then:
            Result::Ok<i32,i32> sub ch '0'
        else:
            if:
                and ge ch 'a' le ch 'f'
                then:
                    Result::Ok<i32,i32> add 10 sub ch 'a'
                else:
                    if:
                        and ge ch 'A' le ch 'F'
                        then:
                            Result::Ok<i32,i32> add 10 sub ch 'A'
                        else:
                            Result::Err<i32,i32> 1

// validate_radix: 文字列変換で使える基数かを判定する
//
// 目的:
// - 2 / 8 / 10 / 16 のみを受理し、それ以外の基数を早期に弾きます。
//
// 実装(アルゴリズム):
// - 許可された 4 値との等値比較だけで判定します。
//
// 注意(重要):
// - 現在の文字列変換 API は NEPLg2 の標準的な整数リテラル系に合わせ、2 / 8 / 10 / 16 に限定します。
// - それ以外の基数を使いたい場合は、この関数と対応する doctest を拡張してください。
//
// 計算量:
// - O(1)
fn validate_radix <(i32)->Result<i32,i32>> (radix):
    if:
        or or eq radix 2 eq radix 8 or eq radix 10 eq radix 16
        then:
            Result::Ok<i32,i32> radix
        else:
            Result::Err<i32,i32> 1

//: U128DivRem: u128 の小基数除算の結果
struct U128DivRem:
    quotient <u128>
    remainder <i32>

// u128_zero: 0 の u128 値を返す
//
// 目的:
// - u128 補助関数群で共通して使う 0 値を作ります。
//
// 実装(アルゴリズム):
// - hi / lo の両方を 0 にした `u128` を直接構築します。
//
// 注意(重要):
// - これは補助関数であり、公開 API の型変換ではありません。
//
// 計算量:
// - O(1)
fn u128_zero <()->u128> ():
    u128 <i64> cast 0 <i64> cast 0

// u128_max: u128 の最大値を返す
//
// 目的:
// - 文字列解析で `res * radix + digit` が表現域を超えないかを調べる上限値として使います。
//
// 実装(アルゴリズム):
// - hi / lo の両方を全ビット 1 にした `u128` を直接構築します。
//
// 注意(重要):
// - `i64` フィールド上では -1 と見えますが、ここでは符号なし 64-bit word として扱います。
//
// 計算量:
// - O(1)
fn u128_max <()->u128> ():
    u128 <i64> cast -1 <i64> cast -1

// u128_is_zero: u128 が 0 かを判定する
//
// 目的:
// - 桁生成や解析で `u128` の終了条件を判定します。
//
// 実装(アルゴリズム):
// - hi / lo の両方が 0 かを確認します。
//
// 注意(重要):
// - `u128` は `i64` 2 ワード表現なので、単純なフィールド比較で判定できます。
//
// 計算量:
// - O(1)
fn u128_is_zero <(u128)->bool> (v):
    and eq get v "hi" <i64> cast 0 eq get v "lo" <i64> cast 0

// u128_from_i128_bits: i128 のビット列をそのまま u128 として見る
//
// 目的:
// - 符号付き i128 の内部表現を、同じ 128-bit 幅の符号なし値として扱います。
//
// 実装(アルゴリズム):
// - hi / lo をそのまま `u128` へ詰め替えます。
//
// 注意(重要):
// - 数値変換ではなくビット列の再解釈です。
//
// 計算量:
// - O(1)
fn u128_from_i128_bits <(i128)->u128> (v):
    u128 get v "hi" get v "lo"

// i128_from_u128_bits: u128 のビット列をそのまま i128 として見る
//
// 目的:
// - 符号なし u128 の内部表現を、同じ 128-bit 幅の符号付き値として扱います。
//
// 実装(アルゴリズム):
// - hi / lo をそのまま `i128` へ詰め替えます。
//
// 注意(重要):
// - 数値変換ではなくビット列の再解釈です。
//
// 計算量:
// - O(1)
fn i128_from_u128_bits <(u128)->i128> (v):
    i128 get v "hi" get v "lo"

// i128_is_negative: i128 が負数かを判定する
//
// 目的:
// - 文字列表現で負号を付けるべきかを判定します。
//
// 実装(アルゴリズム):
// - 上位 64-bit の符号だけを見ます。
//
// 注意(重要):
// - `i128` は 2 の補数表現を前提にしています。
//
// 計算量:
// - O(1)
fn i128_is_negative <(i128)->bool> (v):
    lt get v "hi" <i64> cast 0

// i128_neg: i128 の符号を反転する
//
// 目的:
// - 符号付き文字列化で絶対値を求める前段として使います。
//
// 実装(アルゴリズム):
// - `0 - v` を `i128` 演算で行います。
//
// 注意(重要):
// - 最小値も 2 の補数 mod 2^128 で反転します。ビット列としてはそのまま絶対値の大きさに使えます。
//
// 計算量:
// - O(1)
fn i128_neg <(i128)->i128> (v):
    sub <i128> cast 0 v

// i128_abs_u128: i128 の絶対値を u128 として返す
//
// 目的:
// - 符号付き整数の文字列表現生成を、符号処理と magnitude 処理に分離します。
//
// 実装(アルゴリズム):
// - 非負ならそのまま、負なら `i128_neg` したビット列を `u128` として返します。
//
// 注意(重要):
// - `i128` 最小値でも `u128` の大きさとして正しく扱えます。
//
// 計算量:
// - O(1)
fn i128_abs_u128 <(i128)->u128> (v):
    if:
        i128_is_negative v
        then:
            u128_from_i128_bits i128_neg v
        else:
            u128_from_i128_bits v

// u128_get_bit: u128 の指定ビットを取り出す
//
// 目的:
// - 小基数除算の long division で、上位ビットから順に 1bit ずつ読むために使います。
//
// 実装(アルゴリズム):
// - idx が 64 以上か未満かで hi / lo を切り替え、右シフト後の最下位ビットを読みます。
//
// 注意(重要):
// - `0 <= idx < 128` を呼び出し側が守る前提です。
//
// 計算量:
// - O(1)
fn u128_get_bit <(u128,i32)->i32> (v, idx):
    if:
        ge idx 64
        then:
            let shifted <i64> shr_u get v "hi" <i64> cast sub idx 64;
            let bit64 <i64> and shifted <i64> cast 1;
            <i32> cast bit64
        else:
            let shifted <i64> shr_u get v "lo" <i64> cast idx;
            let bit64 <i64> and shifted <i64> cast 1;
            <i32> cast bit64

// u128_set_bit: u128 の指定ビットを 1 にする
//
// 目的:
// - 小基数除算で求めた商のビットを立てます。
//
// 実装(アルゴリズム):
// - idx に対応する mask を作り、hi または lo に `or` します。
//
// 注意(重要):
// - 既に 1 のビットを再度立てても問題ありません。
//
// 計算量:
// - O(1)
fn u128_set_bit <(u128,i32)->u128> (v, idx):
    if:
        ge idx 64
        then:
            let mask <i64> shl <i64> cast 1 <i64> cast sub idx 64;
            u128 or get v "hi" mask get v "lo"
        else:
            let mask <i64> shl <i64> cast 1 <i64> cast idx;
            u128 get v "hi" or get v "lo" mask

// u128_add_small: u128 に小さい非負整数を加える
//
// 目的:
// - 基数付き解析で `res = res * radix + digit` を構成する末尾加算に使います。
//
// 実装(アルゴリズム):
// - `digit` を `u128` に持ち上げて通常の `u128 add` に渡します。
//
// 注意(重要):
// - `digit` は 0..15 の範囲を前提にしています。
//
// 計算量:
// - O(1)
fn u128_add_small <(u128,i32)->u128> (v, digit):
    add v to_u128 <i64> cast digit

// u128_mul_small: u128 に小さい非負整数を掛ける
//
// 目的:
// - 文字列解析で基数倍を行うための補助です。
//
// 実装(アルゴリズム):
// - 二進法の繰り返し加算で `v * factor` を作ります。
// - factor は 2 / 8 / 10 / 16 のいずれかなので、回数は定数で抑えられます。
//
// 注意(重要):
// - この関数自体は `u128` 演算に従ってラップします。
// - 解析用途では呼び出し前に `u128_can_mul_add_small` で上限確認してください。
//
// 計算量:
// - O(log factor) だが factor は固定小定数なので実質 O(1)
fn u128_mul_small <(u128,i32)->u128> (v, factor):
    let mut out <u128> u128_zero;
    let mut base <u128> v;
    let mut n <i32> factor;
    while gt n 0:
        do:
            if:
                ne and n 1 0
                then:
                    set out add out base;
                else:
                    ();
            set base add base base;
            set n shr_u n 1;
    out

// u128_divrem_small: u128 を小さい正基数で割った商と余りを返す
//
// 目的:
// - `u128` の文字列表現生成で、下位 1 桁ずつを取り出します。
//
// 実装(アルゴリズム):
// - 128bit の long division を上位ビットから順に行います。
// - 余りは `i32` に収まるので、各段階では `rem = rem * 2 + bit` を更新します。
//
// 注意(重要):
// - radix は 2 / 8 / 10 / 16 を前提にしています。
// - 商は `u128`、余りは 0..radix-1 の `i32` です。
//
// 計算量:
// - O(128) = O(1)
fn u128_divrem_small <(u128,i32)->U128DivRem> (v, radix):
    let mut q <u128> u128_zero;
    let mut rem <i32> 0;
    let mut idx <i32> 127;
    while ge idx 0:
        do:
            let bit <i32> u128_get_bit v idx;
            let shifted_rem <i32> shl rem 1;
            set rem add shifted_rem bit;
            if:
                ge rem radix
                then:
                    set rem sub rem radix;
                    set q u128_set_bit q idx;
                else:
                    ();
            set idx sub idx 1;
    U128DivRem q rem

// u128_can_mul_add_small: `v * radix + digit` が u128 に収まるかを判定する
//
// 目的:
// - 数値文字列の解析で、演算がラップする前に範囲外入力を `Result::Err` へ変換します。
//
// 実装(アルゴリズム):
// - 事前に計算した `u128_max / radix` の商と余りに対して、現在値 v を比較します。
// - `v < quotient` なら次の桁は必ず安全です。
// - `v > quotient` なら必ず overflow します。
// - `v == quotient` の場合だけ、digit が最大余り以下かを確認します。
//
// 注意(重要):
// - radix は `validate_radix` 済みで、digit は radix 未満であることを前提にします。
// - 実際の乗算と加算はこの判定が true の時だけ行ってください。
//
// 計算量:
// - O(1)
fn u128_can_mul_add_small <(u128,i32,u128,i32)->bool> (v, digit, max_quotient, max_remainder):
    if:
        lt v max_quotient
        then:
            true
        else:
            if:
                lt max_quotient v
                then:
                    false
                else:
                    le digit max_remainder

//: from_i32: i32 を符号付き 10 進文字列へ変換する
//:
//: [目的/もくてき]:
//: - `i32` を `"-42"` のような表示用文字列へ変換します。
//: - 診断文やログで、負数を含む整数をそのまま表示したい時に使います。
//:
//: [実装/じっそう]:
//: - `from_i32_radix x 10` に委譲し、基数付き整数文字列化の実装へ統一します。
//: - 桁生成と負号処理は `i64` / `i128` の共通経路で扱います。
//:
//: [注意/ちゅうい]:
//: - 返値は新規確保された文字列です。
//: - allocation failure または内部変換失敗時は `"0"` fallback を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(d)  (d は 10 進桁数)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> str_eq from_i32 42 "42";
//:     let ok1 <bool> str_eq from_i32 -42 "-42";
//:     let ok <bool> and ok0 ok1;
//:     if ok 1 0
//: ```
fn from_i32 <(i32)->str> (x):
    match from_i32_radix x 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

//: to_i32: 10 進文字列を i32 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i32` に変換します。
//:
//: [実装/じっそう]:
//: - `to_i32_radix s 10` に委譲し、基数付き実装へ統一します。
//: - `to_i32_radix` は `to_i64_radix` の結果を i32 表現域で検査してから縮小します。
//:
//: [注意/ちゅうい]:
//: - 負号は先頭 1 byte の `-` だけを受理します。
//: - 空文字列、無効な digit、表現域外入力はいずれも `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn to_i32 <(str)->Result<i32,i32>> (s):
    match to_i32_radix s 10:
        Result::Ok v:
            Result::Ok<i32,i32> v
        Result::Err e:
            Result::Err<i32,i32> e

// from_i32_radix: i32 を指定した基数の文字列へ変換する
//
// 目的:
// - i32 を 2 / 8 / 10 / 16 進の文字列へ変換します。
// - ログ、テスト、シリアライズで基数を明示した文字列表現が必要な場面に使います。
//
// 実装(アルゴリズム):
// - `i32` を `i64` に符号拡張してから `from_i64_radix` に委譲します。
// - 桁列生成の本体は i64 共通実装に集約します。
//
// 注意(重要):
// - 対応基数は 2 / 8 / 10 / 16 のみです。
// - 結果は小文字英字を使うため、16 進では `ff` のような表記になります。
//
// 計算量:
// - O(d)  (d は指定基数での桁数)
fn from_i32_radix <(i32,i32)->Result<str,i32>> (x, radix):
    from_i64_radix <i64> cast x radix

// to_i32_radix: 指定基数の文字列を i32 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進で書かれた文字列を i32 に変換します。
// - 設定値やリテラル風入力を i32 として読み取りたい時に使います。
//
// 実装(アルゴリズム):
// - まず `to_i64_radix` で共通解析を行います。
// - その後、i32 の範囲に収まるかを確認してから縮小します。
//
// 注意(重要):
// - 接頭辞 `0x` や `0b` は解釈しません。文字列本体だけを渡してください。
// - 解析失敗と範囲外はどちらも `Result::Err` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
fn to_i32_radix <(str,i32)->Result<i32,i32>> (s, radix):
    match to_i64_radix s radix:
        Result::Ok v64:
            if:
                and ge v64 <i64> cast -2147483648 le v64 <i64> cast 2147483647
                then:
                    Result::Ok<i32,i32> <i32> cast v64
                else:
                    Result::Err<i32,i32> 1
        Result::Err e:
            Result::Err<i32,i32> e

//: from_i64: i64 を符号付き 10 進文字列へ変換する
//:
//: [目的/もくてき]:
//: - `i64` を `"-42"` のような表示用文字列へ変換します。
//:
//: [実装/じっそう]:
//: - `from_i64_radix x 10` に委譲し、基数付き実装へ統一します。
//:
//: [注意/ちゅうい]:
//: - `i64` 最小値も `i128` 経由で magnitude を扱うため、符号反転 overflow に依存しません。
//: - 失敗時は `"0"` fallback を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(d)
fn from_i64 <(i64)->str> (x):
    match from_i64_radix x 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_i64_radix: i64 を指定した基数の文字列へ変換する
//
// 目的:
// - i64 を 2 / 8 / 10 / 16 進文字列へ変換します。
// - 整数の可視化や、基数を固定したテストデータ生成に使います。
//
// 実装(アルゴリズム):
// - `i64` を `i128` に持ち上げ、符号と magnitude の処理を `from_i128_radix` に統一します。
//
// 注意(重要):
// - すべての基数で負数は `-ff` のような符号付き文字列として返します。
// - 16 進の英字は小文字です。
// - 基数が不正な場合は `Result::Err 1` を返します。
//
// 計算量:
// - O(d)  (d は指定基数での桁数)
fn from_i64_radix <(i64,i32)->Result<str,i32>> (x, radix):
    from_i128_radix <i128> cast x radix

//: to_i64: 10 進文字列を i64 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i64` として読み取ります。
//:
//: [実装/じっそう]:
//: - `to_i64_radix s 10` に委譲し、基数付き解析へ統一します。
//:
//: [注意/ちゅうい]:
//: - 接頭辞は読まず、文字列本体だけを解析します。
//: - 表現域外入力は `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn to_i64 <(str)->Result<i64,i32>> (s):
    to_i64_radix s 10

// i128_fits_i64: i128 が i64 の表現域に収まるかを判定する
//
// 目的:
// - `to_i64_radix` が範囲外の i128 を i64 に切り詰めて受理しないようにします。
//
// 実装(アルゴリズム):
// - 非負 i64 は hi が 0 かつ lo の符号 bit が 0 の時だけ許可します。
// - 負 i64 は hi が -1 かつ lo の符号 bit が 1 の時だけ許可します。
//
// 注意(重要):
// - これは bit pattern の符号拡張検査であり、cast 前に必ず実行します。
//
// 計算量:
// - O(1)
fn i128_fits_i64 <(i128)->bool> (v):
    let hi <i64> get v "hi";
    let lo <i64> get v "lo";
    if:
        eq hi <i64> cast 0
        then:
            not lt lo <i64> cast 0
        else:
            if:
                eq hi <i64> cast -1
                then:
                    lt lo <i64> cast 0
                else:
                    false

// to_i64_radix: 指定基数の文字列を i64 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進文字列を i64 として解釈します。
// - 数値入力の解析や、基数別テストデータの読み戻しに使います。
//
// 実装(アルゴリズム):
// - `to_i128_radix` で共通解析を行い、最後に `i64` へ縮小します。
// - i128 の上位 word が i64 の符号拡張と一致する時だけ縮小します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - `-ff` のような符号付き文字列は、すべての対応基数で受理します。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
fn to_i64_radix <(str,i32)->Result<i64,i32>> (s, radix):
    match to_i128_radix s radix:
        Result::Ok v128:
            if:
                i128_fits_i64 v128
                then:
                    Result::Ok<i64,i32> <i64> cast v128
                else:
                    Result::Err<i64,i32> 1
        Result::Err e:
            Result::Err<i64,i32> e

// from_u128: u128 を 10 進文字列へ変換する
//
// 目的:
// - `u128` の大きな値を 10 進文字列として可視化します。
//
// 実装(アルゴリズム):
// - `from_u128_radix v 10` に委譲します。
//
// 注意(重要):
// - 返る文字列は常に非負で、負号は付きません。
//
// 計算量:
// - O(d)
fn from_u128 <(u128)->str> (v):
    match from_u128_radix v 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_u128_radix: u128 を指定基数の文字列へ変換する
//
// 目的:
// - `u128` を 2 / 8 / 10 / 16 進文字列へ変換します。
//
// 実装(アルゴリズム):
// - 小さい基数での `u128_divrem_small` を繰り返し、まず必要な桁数を数えます。
// - 確保した出力領域を末尾から埋めることで、一時 raw buffer を使わずに確定文字列を作ります。
//
// 注意(重要):
// - 英字桁は小文字です。
// - 基数が不正な場合は `Result::Err 1` を返します。
//
// 計算量:
// - O(128 * d) だが 128 は固定幅なので、桁数 d に対して実質 O(d)
fn from_u128_radix <(u128,i32)->Result<str,i32>> (v, radix):
    match validate_radix radix:
        Result::Err e:
            Result::Err<str,i32> e
        Result::Ok _:
            if:
                u128_is_zero v
                then:
                    Result::Ok<str,i32> "0"
                else:
                    let mut digit_count <i32> 0;
                    let mut count_n <u128> v;
                    while not u128_is_zero count_n:
                        do:
                            let qr_count <U128DivRem> u128_divrem_small count_n radix;
                            set digit_count add digit_count 1;
                            set count_n get qr_count "quotient";
                    match string_alloc_region digit_count:
                        Result::Err _e:
                            Result::Err<str,i32> 12
                        Result::Ok out_region:
                            let out_data <MemPtr<u8>> string_region_data_ptr &out_region;
                            let out_raw <i32> mem_ptr_addr out_data;
                            let mut pos <i32> digit_count;
                            let mut write_n <u128> v;
                            while not u128_is_zero write_n:
                                do:
                                    let qr_write <U128DivRem> u128_divrem_small write_n radix;
                                    set pos sub pos 1;
                                    store_u8 add out_raw pos digit_to_char_lower get qr_write "remainder";
                                    set write_n get qr_write "quotient";
                            Result::Ok<str,i32> string_finish out_region digit_count

// to_u128: 10 進文字列を u128 に変換する
//
// 目的:
// - 大きな非負整数文字列を `u128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_u128_radix s 10` に委譲します。
//
// 注意(重要):
// - 負号は受理しません。
//
// 計算量:
// - O(n)
fn to_u128 <(str)->Result<u128,i32>> (s):
    to_u128_radix s 10

// to_u128_radix: 指定基数の文字列を u128 に変換する
//
// 目的:
// - 非負の 2 / 8 / 10 / 16 進文字列を `u128` に変換します。
//
// 実装(アルゴリズム):
// - 各文字を `digit_from_char` で数値化し、`res = res * radix + digit` を `u128_mul_small` と `u128_add_small` で構築します。
// - 更新前に `u128_max / radix` の商と余りで範囲を確認し、ラップする入力を拒否します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - 負号付き文字列は `Result::Err 1` です。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)
fn to_u128_radix <(str,i32)->Result<u128,i32>> (s, radix):
    match validate_radix radix:
        Result::Err e:
            Result::Err<u128,i32> e
        Result::Ok _:
            let n <i32> len s;
            let mut i <i32> 0;
            let mut res <u128> u128_zero;
            let mut ok <i32> 1;
            let max_qr <U128DivRem> u128_divrem_small u128_max radix;
            let max_quotient <u128> get max_qr "quotient";
            let max_remainder <i32> get max_qr "remainder";
            if:
                eq n 0
                then:
                    set ok 0;
                else:
                    let first <i32> string_byte_at_unchecked s 0;
                    if:
                        eq first '-'
                        then:
                            set ok 0;
                        else:
                            while lt i n:
                                do:
                                    let digit_chr <i32> string_byte_at_unchecked s i;
                                    match digit_from_char digit_chr:
                                        Result::Ok digit:
                                            if:
                                                ge digit radix
                                                then:
                                                    set ok 0;
                                                    set i n;
                                                else:
                                                    if:
                                                        u128_can_mul_add_small res digit max_quotient max_remainder
                                                        then:
                                                            set res u128_add_small u128_mul_small res radix digit;
                                                            set i add i 1;
                                                        else:
                                                            set ok 0;
                                                            set i n;
                                        Result::Err _:
                                            set ok 0;
                                            set i n;
            if:
                eq ok 1
                then:
                    Result::Ok<u128,i32> res
                else:
                    Result::Err<u128,i32> 1

// from_i128: i128 を 10 進文字列へ変換する
//
// 目的:
// - `i128` を 10 進の符号付き文字列へ変換します。
//
// 実装(アルゴリズム):
// - `from_i128_radix v 10` に委譲します。
//
// 注意(重要):
// - 大きさの処理は `u128` の桁生成へ寄せています。
//
// 計算量:
// - O(d)
fn from_i128 <(i128)->str> (v):
    match from_i128_radix v 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_i128_radix: i128 を指定基数の文字列へ変換する
//
// 目的:
// - `i128` を 2 / 8 / 10 / 16 進の符号付き文字列へ変換します。
//
// 実装(アルゴリズム):
// - 負号の有無だけを `i128` 側で判定し、大きさは `i128_abs_u128` を通して `from_u128_radix` に渡します。
//
// 注意(重要):
// - すべての基数で負数は `-...` の形に統一します。
// - 16 進英字は小文字です。
//
// 計算量:
// - O(d)
fn from_i128_radix <(i128,i32)->Result<str,i32>> (v, radix):
    let neg <bool> i128_is_negative v;
    let mag <u128> i128_abs_u128 v;
    match from_u128_radix mag radix:
        Result::Ok body:
            if:
                neg
                then:
                    match concat_result "-" body:
                        Result::Ok text:
                            Result::Ok<str,i32> text
                        Result::Err _e:
                            Result::Err<str,i32> 12
                else:
                    Result::Ok<str,i32> body
        Result::Err e:
            Result::Err<str,i32> e

// i128_positive_magnitude_allowed: 非負 i128 として許される大きさかを判定する
//
// 目的:
// - `to_i128_radix` が正の範囲外入力を 2 の補数負値として受理しないようにします。
//
// 実装(アルゴリズム):
// - i128 の正の最大値は上位 bit が 0 の範囲なので、u128 の hi word が負でないことを確認します。
//
// 注意(重要):
// - ここでは magnitude を u128 として受け取り、符号付き値への bitcast 前に検査します。
//
// 計算量:
// - O(1)
fn i128_positive_magnitude_allowed <(u128)->bool> (mag):
    not lt get mag "hi" <i64> cast 0

// i128_negative_magnitude_allowed: 負 i128 として許される大きさかを判定する
//
// 目的:
// - i128 最小値だけは magnitude が 2^127 でも受理し、それより大きい負入力を拒否します。
//
// 実装(アルゴリズム):
// - 上位 bit が 0 なら通常の負値として安全です。
// - 上位 bit が 1 の場合は、正確に `0x8000...0000` の時だけ最小値として許可します。
//
// 注意(重要):
// - `-170...728` は許可し、`-170...729` は拒否する境界です。
//
// 計算量:
// - O(1)
fn i128_negative_magnitude_allowed <(u128)->bool> (mag):
    if:
        not lt get mag "hi" <i64> cast 0
        then:
            true
        else:
            let min_hi <i64> shl <i64> cast 1 <i64> cast 63;
            and eq get mag "hi" min_hi eq get mag "lo" <i64> cast 0

// i128_magnitude_allowed: 符号に応じて i128 の magnitude 範囲を判定する
//
// 目的:
// - `to_i128_radix` の符号別境界判定を 1 箇所に集約します。
//
// 実装(アルゴリズム):
// - 負号があれば `i128_negative_magnitude_allowed`、なければ `i128_positive_magnitude_allowed` に委譲します。
//
// 注意(重要):
// - この判定が true の時だけ `i128_from_u128_bits` へ進めます。
//
// 計算量:
// - O(1)
fn i128_magnitude_allowed <(u128,bool)->bool> (mag, neg):
    if:
        neg
        then:
            i128_negative_magnitude_allowed mag
        else:
            i128_positive_magnitude_allowed mag

// to_i128: 10 進文字列を i128 に変換する
//
// 目的:
// - 大きな符号付き整数文字列を `i128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_i128_radix s 10` に委譲します。
//
// 注意(重要):
// - 接頭辞は解釈しません。
//
// 計算量:
// - O(n)
fn to_i128 <(str)->Result<i128,i32>> (s):
    to_i128_radix s 10

// to_i128_radix: 指定基数の文字列を i128 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進の符号付き文字列を `i128` に変換します。
//
// 実装(アルゴリズム):
// - 先頭の `-` を切り出した後、残りを `to_u128_radix` で非負の大きさとして解析します。
// - 符号に応じた i128 の表現域を確認し、範囲外なら `Result::Err` にします。
// - 符号が負なら `i128_neg` で符号反転します。
//
// 注意(重要):
// - 表現域外入力は `Result::Err 1` を返します。
// - 接頭辞 `0x` などは解釈しません。
//
// 計算量:
// - O(n)
fn to_i128_radix <(str,i32)->Result<i128,i32>> (s, radix):
    let n <i32> len s;
    if:
        eq n 0
        then:
            Result::Err<i128,i32> 1
        else:
            let first <i32> string_byte_at_unchecked s 0;
            let neg <bool> eq first '-';
            let body <str> if neg:
                then str_slice s 1 n
                else s
            match to_u128_radix body radix:
                Result::Ok mag:
                    if:
                        i128_magnitude_allowed mag neg
                        then:
                            let base <i128> i128_from_u128_bits mag;
                            if:
                                neg
                                then:
                                    Result::Ok<i128,i32> i128_neg base
                                else:
                                    Result::Ok<i128,i32> base
                        else:
                            Result::Err<i128,i32> 1
                Result::Err e:
                    Result::Err<i128,i32> e

//: from_f64_result: f64 を有限値だけ文字列化する
//:
//: [目的/もくてき]:
//: - `f64` を固定小数の表示用 `str` に変換します。
//: - 失敗を呼び出し側で扱えるように `Result` で返します。
//:
//: [実装/じっそう]:
//: - 整数部は `from_i64_radix` で 10 進文字列化します。
//: - 小数部は scratch buffer に最大 6 桁生成し、末尾の `0` を削ってから連結します。
//:
//: [注意/ちゅうい]:
//: - `NaN` は `"nan"` を返します。
//: - 現在は指数表記を生成せず、小数部は最大 6 桁です。
//: - `from_f64` は失敗時に `"0"` fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - 整数部の桁数を `d` として O(d)
fn from_f64_result <(f64)->Result<str,i32>> (x):
    if:
        ne x x
        then:
            Result::Ok<str,i32> "nan"
        else:
            let neg <bool> lt x <f64> cast 0;
            let absx <f64> if neg:
                then sub <f64> cast 0 x
                else x
            let int_part <i64> cast absx;
            let int_f <f64> cast int_part;
            let mut frac <f64> sub absx int_f;
            match from_i64_radix int_part 10:
                Result::Err e:
                    Result::Err<str,i32> e
                Result::Ok int_s:
                    match alloc_ptr<u8> 6:
                        Result::Err _e:
                            Result::Err<str,i32> 12
                        Result::Ok scratch:
                            let scratch_raw <i32> mem_ptr_addr scratch;
                            let mut k <i32> 0;
                            while lt k 6:
                                do:
                                    set frac mul frac <f64> cast 10;
                                    let d <i32> cast frac;
                                    store_u8 add scratch_raw k add '0' d;
                                    set frac sub frac <f64> cast d;
                                    set k add k 1;

                            let mut trim <i32> 6;
                            let mut done_trim <i32> 0;
                            while eq done_trim 0:
                                do:
                                    if:
                                        lt 0 trim
                                        then:
                                            let idx <i32> sub trim 1;
                                            let b <i32> load_u8 add scratch_raw idx;
                                            if:
                                                eq b '0'
                                                then:
                                                    set trim sub trim 1;
                                                else:
                                                    set done_trim 1;
                                        else:
                                            set done_trim 1;

                            let signed_int <Result<str,i32>> if:
                                neg
                                then:
                                    match concat_result "-" int_s:
                                        Result::Ok text:
                                            Result::Ok<str,i32> text
                                        Result::Err _e:
                                            Result::Err<str,i32> 12
                                else:
                                    Result::Ok<str,i32> int_s

                            let out_result <Result<str,i32>> if:
                                gt trim 0
                                then:
                                    match signed_int:
                                        Result::Err e:
                                            Result::Err<str,i32> e
                                        Result::Ok body:
                                            match string_from_mem_unchecked_result scratch trim:
                                                Result::Err _e:
                                                    Result::Err<str,i32> 12
                                                Result::Ok frac_s:
                                                    match concat_result "." frac_s:
                                                        Result::Err _e:
                                                            Result::Err<str,i32> 12
                                                        Result::Ok dot_frac:
                                                            match concat_result body dot_frac:
                                                                Result::Ok out:
                                                                    Result::Ok<str,i32> out
                                                                Result::Err _e:
                                                                    Result::Err<str,i32> 12
                                else:
                                    signed_int
                            dealloc_raw scratch_raw 6
                            out_result

fn from_f64 <(f64)->str> (x):
    match from_f64_result x:
        Result::Ok text:
            text
        Result::Err _e:
            "0"

//: to_f64: 10 進浮動小数文字列を f64 として解析する
//:
//: [目的/もくてき]:
//: - `123`、`-1.5`、`1e3` のような文字列を `f64` に変換します。
//:
//: [実装/じっそう]:
//: - 符号、整数部、小数部、指数部を byte 走査で読み取り、10 倍/10 分の 1 を繰り返して値を組み立てます。
//:
//: [注意/ちゅうい]:
//: - 少なくとも 1 桁の digit が必要です。
//: - `nan` / `inf` などの記号名は解析しません。
//: - overflow / underflow は backend の `f64` 演算に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(n + |exponent|)
fn to_f64 <(str)->Result<f64,i32>> (s):
    let n <i32> len s;
    let mut i <i32> 0;
    let mut ok <i32> 1;
    let mut neg <i32> 0;
    let mut int_part <f64> cast 0;
    let mut frac_part <f64> cast 0;
    let mut frac_scale <f64> cast 1;
    let mut has_digit <i32> 0;
    let ten <f64> cast 10;
    let mut out_res <Result<f64,i32>> Result::Err<f64,i32> 1;

    if:
        eq n 0
        then:
            set ok 0;
        else:
            let first <i32> string_byte_at_unchecked s 0;
            if:
                eq first '-'
                then:
                    set neg 1;
                    set i 1;
                else:
                    if:
                        eq first '+'
                        then:
                            set i 1;
                        else:
                            ();

            let mut done_int <i32> 0;
            while and eq ok 1 eq done_int 0:
                do:
                    if:
                        lt i n
                        then:
                            let b <i32> string_byte_at_unchecked s i;
                            let d <i32> sub b '0';
                            if:
                                and ge d 0 le d 9
                                then:
                                    set has_digit 1;
                                    let scaled <f64> mul int_part ten;
                                    let dv <f64> cast d;
                                    let next_int <f64> add scaled dv;
                                    set int_part next_int;
                                    set i add i 1;
                                else:
                                    set done_int 1;
                        else:
                            set done_int 1;

            let mut has_dot <i32> 0;
            if:
                and eq ok 1 lt i n
                then:
                    let dot <i32> string_byte_at_unchecked s i;
                    if:
                        eq dot '.'
                        then:
                            set has_dot 1;
                        else:
                            ();
                else:
                    ();

            if:
                eq has_dot 1
                then:
                    set i add i 1;
                    let mut done_frac <i32> 0;
                    while and eq ok 1 eq done_frac 0:
                        do:
                            if:
                                lt i n
                                then:
                                    let b <i32> string_byte_at_unchecked s i;
                                    let d <i32> sub b '0';
                                    if:
                                        and ge d 0 le d 9
                                        then:
                                            set has_digit 1;
                                            let next_scale <f64> div frac_scale ten;
                                            set frac_scale next_scale;
                                            let dv <f64> cast d;
                                            let addv <f64> mul dv frac_scale;
                                            let next_frac <f64> add frac_part addv;
                                            set frac_part next_frac;
                                            set i add i 1;
                                        else:
                                            set done_frac 1;
                                else:
                                    set done_frac 1;
                else:
                    ();

            let mut exp_val <i32> 0;
            let mut exp_neg <i32> 0;
            let mut has_exp <i32> 0;
            if:
                and eq ok 1 lt i n
                then:
                    let eb <i32> string_byte_at_unchecked s i;
                    if:
                        or eq eb 'e' eq eb 'E'
                        then:
                            set has_exp 1;
                        else:
                            ();
                else:
                    ();

            if:
                eq has_exp 1
                then:
                    set i add i 1;
                    if:
                        lt i n
                        then:
                            let sb <i32> string_byte_at_unchecked s i;
                            if:
                                eq sb '-'
                                then:
                                    set exp_neg 1;
                                    set i add i 1;
                                else:
                                    if:
                                        eq sb '+'
                                        then:
                                            set i add i 1;
                                        else:
                                            ();
                        else:
                            set ok 0;

                    let mut exp_digits <i32> 0;
                    let mut done_exp <i32> 0;
                    while and eq ok 1 eq done_exp 0:
                        do:
                            if:
                                lt i n
                                then:
                                    let b <i32> string_byte_at_unchecked s i;
                                    let d <i32> sub b '0';
                                    if:
                                        and ge d 0 le d 9
                                        then:
                                            set exp_digits 1;
                                            set exp_val <i32> add <i32> mul exp_val 10 d;
                                            set i add i 1;
                                        else:
                                            set done_exp 1;
                                else:
                                    set done_exp 1;
                    if:
                        eq exp_digits 0
                        then:
                            set ok 0;
                        else:
                            ();
                else:
                    ();

            if:
                ne i n
                then:
                    set ok 0;
                else:
                    ();

            if:
                eq has_digit 0
                then:
                    set ok 0;
                else:
                    ();

            let mut out <f64> add int_part frac_part;
            let mut k <i32> 0;
            while and eq ok 1 lt k exp_val:
                do:
                    if:
                        eq exp_neg 1
                        then:
                            let next_out <f64> div out ten;
                            set out next_out;
                        else:
                            let next_out <f64> mul out ten;
                            set out next_out;
                    set k add k 1;

            if:
                eq ok 1
                then:
                    if:
                        eq neg 1
                        then:
                            let zero <f64> cast 0;
                            let signed_out <f64> sub zero out;
                            set out_res Result::Ok<f64,i32> signed_out;
                        else:
                            set out_res Result::Ok<f64,i32> out;
                else:
                    set out_res Result::Err<f64,i32> 1;

    out_res

//: from_f32: f32 を f64 共通経路で文字列化する
//:
//: [目的/もくてき]:
//: - `f32` 値を表示用 `str` へ変換します。
//:
//: [実装/じっそう]:
//: - `f32` を `f64` に拡張し、`from_f64` の formatting に統一します。
//:
//: [注意/ちゅうい]:
//: - 小数桁数や fallback は `from_f64` と同じです。
//:
//: [計算量/けいさんりょう]:
//: - `from_f64` に従います。
fn from_f32 <(f32)->str> (x):
    from_f64 <f64> cast x

//: to_f32: 10 進浮動小数文字列を f32 として解析する
//:
//: [目的/もくてき]:
//: - `to_f64` と同じ表記を受理し、結果を `f32` に縮小します。
//:
//: [実装/じっそう]:
//: - `to_f64` による解析結果を `f32` に cast します。
//:
//: [注意/ちゅうい]:
//: - `f32` への丸めや overflow は backend の cast に従います。
//:
//: [計算量/けいさんりょう]:
//: - `to_f64` に従います。
fn to_f32 <(str)->Result<f32,i32>> (s):
    match to_f64 s:
        Result::Ok v64:
            Result::Ok<f32,i32> <f32> cast v64
        Result::Err e:
            Result::Err<f32,i32> e

//: find: 最初に一致した byte index を返す
//:
//: [目的/もくてき]:
//: - `s` の中に `pat` が最初に出る byte index を `Option<i32>` で返します。
//: - 見つからない場合は `Option::None` を返します。
//:
//: [実装/じっそう]:
//: - 空 pattern は先頭一致として `Some(0)` を返します。
//: - pattern が入力より長い場合は探索せず `None` を返します。
//: - それ以外は開始位置を前から進め、各位置で `str_eq_at` により byte 列を比較します。
//:
//: [注意/ちゅうい]:
//: - 戻り値は UTF-8 文字数ではなく byte index です。
//: - Unicode 正規化や文字境界検査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - n を `s` の byte 長、m を `pat` の byte 長として O((n - m + 1) * m) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/option" as *
//:| #import "std/test" as *
//: fn expect_find_some <(str,Option<i32>,i32)*>Result<(),str>> (label, got, expected):
//:     match got:
//:         Option::Some actual:
//:             check_eq_i32 expected actual
//:         Option::None:
//:             Result<(),str>::Err label
//:
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push expect_find_some "empty" find "abc" "" 0
//:         |> checks_push expect_find_some "prefix" find "abc" "ab" 0
//:         |> checks_push expect_find_some "middle" find "abcabc" "ca" 2
//:         |> checks_push expect_find_some "suffix" find "abc" "bc" 1
//:         |> checks_push assert is_none<i32> find "abc" "z"
//:         |> checks_push assert is_none<i32> find "ab" "abc"
//:     checks_exit_code checks
//: ```
fn find <(str,str)->Option<i32>> (s, pat):
    let s_len <i32> len s;
    let pat_len <i32> len pat;
    if:
        eq pat_len 0
        then some<i32> 0
        else:
            if:
                lt s_len pat_len
                then none<i32>
                else:
                    let last_start <i32> sub s_len pat_len;
                    let mut start <i32> 0;
                    let mut out <Option<i32>> none<i32>;
                    let mut searching <bool> true;
                    while and searching le start last_start:
                        do:
                            if:
                                str_eq_at s pat start pat_len 0
                                then:
                                    set out some<i32> start;
                                    set searching false;
                                else:
                                    set start add start 1;
                    out
