//: string: alloc/string.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #entry main
//:| #target std
//:| fn main <()*>i32> ():
//:     ()
//:     0
//: ```

#indent 4

#import "core/mem" as *
#import "core/result" as *
#import "core/option" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/char" as *
pub #import "./string/utf8" as *
pub #import "./string/storage" as *
pub #import "./string/access" as *
pub #import "./string/builder" as *
pub #import "./string/search" as *
pub #import "./string/slice" as *
pub #import "./string/split" as *
#import "alloc/collections/vec" as v
#import "core/field" as *

// string: 文字列操作（長さ付きUTF-8）
//
// 目的:
// - [len:i32][bytes...] 形式の UTF-8 文字列を扱う関数群を提供します。
//
// 実装(アルゴリズム):
// - 文字列はヒープに確保し、先頭 4 バイトに長さを格納します。
//
// 注意(重要):
// - 文字列は NUL 終端ではありません。
// - 変換関数は i32/i64/f32/f64 の主要経路を提供します。
//
// 計算量:
// - 連結や変換は O(n)


//: concat_result: 2 つの文字列を確保付きで連結する
//:
//: [目的/もくてき]:
//: - `a` と `b` の byte 列を連結した新しい `str` を返します。
//: - allocation failure を呼び出し側で扱う必要がある処理では、この Result 版を使います。
//:
//: [実装/じっそう]:
//: - 両方の byte 長を合計し、`string_alloc_region` で出力領域を 1 回だけ確保します。
//: - 確保した本文領域へ `a`、`b` の順に byte copy し、最後に長さ header を確定します。
//:
//: [注意/ちゅうい]:
//: - 入力文字列は UTF-8 不変条件を満たす前提で、追加の validation は行いません。
//: - `concat` は失敗時に空文字列へ落とす互換 API です。新規コードでは `concat_result` を優先してください。
//:
//: [計算量/けいさんりょう]:
//: - O(len(a) + len(b))
fn concat_result <(str,str)->Result<str,str>> (a,b):
    let la <i32> len a;
    let lb <i32> len b;
    let total <i32> add la lb;
    match string_alloc_region total:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok out_region:
            let out_data <MemPtr<u8>> string_region_data_ptr &out_region;
            mem_copy mem_ptr_addr out_data mem_ptr_addr string_data_ptr a la;
            mem_copy add mem_ptr_addr out_data la mem_ptr_addr string_data_ptr b lb;
            Result<str,str>::Ok string_finish out_region total

fn concat <(str,str)->str> (a,b):
    match concat_result a b:
        Result::Ok s:
            s
        Result::Err _e:
            ""

//: concat3: 3 つの文字列を順に連結する
//:
//: [目的/もくてき]:
//: - `a`、`b`、`c` をこの順に連結した `str` を返します。
//: - 小さい診断文など、3 片だけを簡潔に組み立てたい場合の補助です。
//:
//: [実装/じっそう]:
//: - `concat a b` の結果に `c` を再度 `concat` します。
//:
//: [注意/ちゅうい]:
//: - 中間文字列を 1 つ確保します。多数の片を結合する場合は `StringBuilder` を使ってください。
//: - allocation failure は `concat` と同じく空文字列 fallback に吸収されます。
//:
//: [計算量/けいさんりょう]:
//: - O(len(a) + len(b) + len(c)) ですが、中間 copy が 1 回追加で発生します。
fn concat3 <(str,str,str)->str> (a,b,c):
    let ab <str> concat a b;
    concat ab c

//: sb_append_slice_result: 文字列の byte 範囲を builder に直接追加する
//:
//: [目的/もくてき]:
//: - `s[start..end]` を一時 `str` として確保せず、builder の末尾へ直接 copy します。
//: - path scanner や parser のように、元文字列の範囲を何度も組み立て直す処理で owned substring collection を作らずに済ませます。
//:
//: [実装/じっそう]:
//: - `str_slice_result` と同じ丸め規則で start/end を正規化し、UTF-8 境界を確認します。
//: - builder capacity を確保してから、元文字列の data pointer + start から `out_len` byte を `mem_copy` します。
//:
//: [注意/ちゅうい]:
//: - 失敗時は入力 builder を解放して `Err` を返します。
//: - index は byte index です。文字境界でない範囲は `Err` になります。
//:
//: [計算量/けいさんりょう]:
//: - O(end - start)
fn sb_append_slice_result <(StringBuilder,str,i32,i32)->Result<StringBuilder,str>> (sb, s, start, end):
    let n <i32> len s
    let mut s0 <i32> start
    let mut e0 <i32> end
    if:
        lt s0 0
        then set s0 0
        else ()
    if:
        lt e0 s0
        then set e0 s0
        else ()
    if:
        lt n e0
        then set e0 n
        else ()
    if:
        and str_utf8_is_boundary s s0 str_utf8_is_boundary s e0
        then:
            let out_len <i32> sub e0 s0
            if:
                eq out_len 0
                then:
                    Result<StringBuilder,str>::Ok sb
                else:
                    match string_builder_reserve_result sb out_len:
                        Result::Err e:
                            Result<StringBuilder,str>::Err e
                        Result::Ok reserved:
                            let len0 <i32> get reserved "len"
                            match *get_ref &reserved "data":
                                Option::None:
                                    string_builder_free reserved
                                    Result<StringBuilder,str>::Err "string.builder append slice invalid storage"
                                Option::Some data:
                                    let dst <MemPtr<u8>> mem_ptr_add data len0
                                    let src <MemPtr<u8>> mem_ptr_add string_data_ptr s s0
                                    match mem_copy<u8> dst src out_len:
                                        Result::Ok _:
                                            Result<StringBuilder,str>::Ok string_builder_with_len reserved add len0 out_len
                                        Result::Err _e:
                                            string_builder_free reserved
                                            Result<StringBuilder,str>::Err "string.builder append slice copy failed"
        else:
            string_builder_free sb
            Result<StringBuilder,str>::Err "string.builder append slice invalid utf8 boundary"

//: sb_append_i32_result: i32 を 10 進文字列化して builder に追加する
//:
//: [目的/もくてき]:
//: - 診断やログで整数値を builder に混ぜるため、`v` を `from_i32_radix v 10` で文字列化して追加します。
//:
//: [実装/じっそう]:
//: - 変換に成功した文字列を `sb_append_result` へ渡します。
//:
//: [注意/ちゅうい]:
//: - 数値変換または builder grow の失敗は `Result::Err` として返します。
//: - `sb_append_i32` は失敗時に空 builder fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - O(d) + builder append の cost です。`d` は 10 進桁数です。
fn sb_append_i32_result <(StringBuilder,i32)->Result<StringBuilder,str>> (sb, v):
    match from_i32_radix v 10:
        Result::Ok text:
            sb_append_result sb text
        Result::Err _e:
            Result<StringBuilder,str>::Err "string.builder append_i32 conversion failed"

fn sb_append_i32 <(StringBuilder,i32)->StringBuilder> (sb, v):
    match sb_append_i32_result sb v:
        Result::Ok next:
            next
        Result::Err _e:
            string_builder_empty
//: from_bool: bool を表示用文字列へ変換する
//:
//: [目的/もくてき]:
//: - `true` を `"true"`、`false` を `"false"` として返します。
//: - 診断文やテスト失敗メッセージで論理値をそのまま表示したい時に使います。
//:
//: [実装/じっそう]:
//: - 分岐だけで固定文字列 literal を選びます。
//:
//: [注意/ちゅうい]:
//: - 返す文字列は表示用の表現です。数値変換や bool 解析ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> str_eq from_bool true "true";
//:     let ok1 <bool> str_eq from_bool false "false";
//:     let ok <bool> and ok0 ok1;
//:     if ok 1 0
//: ```
fn from_bool <(bool)->str> (b):
    if:
        b
        then:
            "true"
        else:
            "false"

//: to_bool: 文字列を bool として解析する
//:
//: [目的/もくてき]:
//: - `"true"` または `"false"` の文字列を `bool` として読み取ります。
//: - 設定値や CLI 引数、テスト入力などで論理値を文字列から受け取る時に使います。
//:
//: [実装/じっそう]:
//: - `str_eq` で `"true"`、続いて `"false"` と比較します。
//:
//: [注意/ちゅうい]:
//: - 受理する表記は小文字の `"true"` / `"false"` のみです。
//: - `"True"` や `"0"` / `"1"` は bool として扱いません。
//: - 解析失敗は `Result::Err 1` で返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/string" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     let checks1 match to_bool "true":
//:         Result::Ok v:
//:             checks_push checks0 assert_eq_i32 1 cast v
//:         Result::Err _:
//:             checks_push checks0 assert_eq_i32 1 0
//:     let checks2 match to_bool "false":
//:         Result::Ok v:
//:             checks_push checks1 assert_eq_i32 0 cast v
//:         Result::Err _:
//:             checks_push checks1 assert_eq_i32 1 0
//:     checks_exit_code checks2
//: ```
fn to_bool <(str)->Result<bool,i32>> (s):
    if:
        str_eq s "true"
        then:
            Result::Ok<bool,i32> true
        else:
            if:
                str_eq s "false"
                then:
                    Result::Ok<bool,i32> false
                else:
                    Result::Err<bool,i32> 1

// digit_to_char_lower: 0..15 の数値を小文字 16 進数字へ変換する
//
// 目的:
// - 基数変換で得た 1 桁分の値を、`0-9` または `a-f` の 1 文字へ変換します。
//
// 実装(アルゴリズム):
// - `v < 10` のときは `'0' + v` を返します。
// - それ以外は `'a' + (v - 10)` を返します。
//
// 注意(重要):
// - 呼び出し側は `0 <= v < 16` を満たす値だけを渡す必要があります。
// - 16 以上の値を渡した場合の挙動は未定義です。
//
// 計算量:
// - O(1)
fn digit_to_char_lower <(i32)->i32> (v):
    if:
        lt v 10
        then:
            add '0' v
        else:
            add 'a' sub v 10

// digit_from_char: 1 文字を数値へ変換する
//
// 目的:
// - `0-9`、`a-f`、`A-F` を数値 0..15 へ変換します。
// - 基数付きの文字列解析で各文字の意味を判定する時に使います。
//
// 実装(アルゴリズム):
// - ASCII 範囲を順に判定し、対応する値へ写像します。
// - 数字でも英字でもない場合は `Result::Err 1` を返します。
//
// 注意(重要):
// - 返る値が基数未満かどうかの判定は、この関数ではなく呼び出し側が行います。
// - 英字は大小どちらも受理します。
//
// 計算量:
// - O(1)
fn digit_from_char <(i32)->Result<i32,i32>> (ch):
    if:
        and ge ch '0' le ch '9'
        then:
            Result::Ok<i32,i32> sub ch '0'
        else:
            if:
                and ge ch 'a' le ch 'f'
                then:
                    Result::Ok<i32,i32> add 10 sub ch 'a'
                else:
                    if:
                        and ge ch 'A' le ch 'F'
                        then:
                            Result::Ok<i32,i32> add 10 sub ch 'A'
                        else:
                            Result::Err<i32,i32> 1

// validate_radix: 文字列変換で使える基数かを判定する
//
// 目的:
// - 2 / 8 / 10 / 16 のみを受理し、それ以外の基数を早期に弾きます。
//
// 実装(アルゴリズム):
// - 許可された 4 値との等値比較だけで判定します。
//
// 注意(重要):
// - 現在の文字列変換 API は NEPLg2 の標準的な整数リテラル系に合わせ、2 / 8 / 10 / 16 に限定します。
// - それ以外の基数を使いたい場合は、この関数と対応する doctest を拡張してください。
//
// 計算量:
// - O(1)
fn validate_radix <(i32)->Result<i32,i32>> (radix):
    if:
        or or eq radix 2 eq radix 8 or eq radix 10 eq radix 16
        then:
            Result::Ok<i32,i32> radix
        else:
            Result::Err<i32,i32> 1

//: U128DivRem: u128 の小基数除算の結果
struct U128DivRem:
    quotient <u128>
    remainder <i32>

// u128_zero: 0 の u128 値を返す
//
// 目的:
// - u128 補助関数群で共通して使う 0 値を作ります。
//
// 実装(アルゴリズム):
// - hi / lo の両方を 0 にした `u128` を直接構築します。
//
// 注意(重要):
// - これは補助関数であり、公開 API の型変換ではありません。
//
// 計算量:
// - O(1)
fn u128_zero <()->u128> ():
    u128 <i64> cast 0 <i64> cast 0

// u128_max: u128 の最大値を返す
//
// 目的:
// - 文字列解析で `res * radix + digit` が表現域を超えないかを調べる上限値として使います。
//
// 実装(アルゴリズム):
// - hi / lo の両方を全ビット 1 にした `u128` を直接構築します。
//
// 注意(重要):
// - `i64` フィールド上では -1 と見えますが、ここでは符号なし 64-bit word として扱います。
//
// 計算量:
// - O(1)
fn u128_max <()->u128> ():
    u128 <i64> cast -1 <i64> cast -1

// u128_is_zero: u128 が 0 かを判定する
//
// 目的:
// - 桁生成や解析で `u128` の終了条件を判定します。
//
// 実装(アルゴリズム):
// - hi / lo の両方が 0 かを確認します。
//
// 注意(重要):
// - `u128` は `i64` 2 ワード表現なので、単純なフィールド比較で判定できます。
//
// 計算量:
// - O(1)
fn u128_is_zero <(u128)->bool> (v):
    and eq get v "hi" <i64> cast 0 eq get v "lo" <i64> cast 0

// u128_from_i128_bits: i128 のビット列をそのまま u128 として見る
//
// 目的:
// - 符号付き i128 の内部表現を、同じ 128-bit 幅の符号なし値として扱います。
//
// 実装(アルゴリズム):
// - hi / lo をそのまま `u128` へ詰め替えます。
//
// 注意(重要):
// - 数値変換ではなくビット列の再解釈です。
//
// 計算量:
// - O(1)
fn u128_from_i128_bits <(i128)->u128> (v):
    u128 get v "hi" get v "lo"

// i128_from_u128_bits: u128 のビット列をそのまま i128 として見る
//
// 目的:
// - 符号なし u128 の内部表現を、同じ 128-bit 幅の符号付き値として扱います。
//
// 実装(アルゴリズム):
// - hi / lo をそのまま `i128` へ詰め替えます。
//
// 注意(重要):
// - 数値変換ではなくビット列の再解釈です。
//
// 計算量:
// - O(1)
fn i128_from_u128_bits <(u128)->i128> (v):
    i128 get v "hi" get v "lo"

// i128_is_negative: i128 が負数かを判定する
//
// 目的:
// - 文字列表現で負号を付けるべきかを判定します。
//
// 実装(アルゴリズム):
// - 上位 64-bit の符号だけを見ます。
//
// 注意(重要):
// - `i128` は 2 の補数表現を前提にしています。
//
// 計算量:
// - O(1)
fn i128_is_negative <(i128)->bool> (v):
    lt get v "hi" <i64> cast 0

// i128_neg: i128 の符号を反転する
//
// 目的:
// - 符号付き文字列化で絶対値を求める前段として使います。
//
// 実装(アルゴリズム):
// - `0 - v` を `i128` 演算で行います。
//
// 注意(重要):
// - 最小値も 2 の補数 mod 2^128 で反転します。ビット列としてはそのまま絶対値の大きさに使えます。
//
// 計算量:
// - O(1)
fn i128_neg <(i128)->i128> (v):
    sub <i128> cast 0 v

// i128_abs_u128: i128 の絶対値を u128 として返す
//
// 目的:
// - 符号付き整数の文字列表現生成を、符号処理と magnitude 処理に分離します。
//
// 実装(アルゴリズム):
// - 非負ならそのまま、負なら `i128_neg` したビット列を `u128` として返します。
//
// 注意(重要):
// - `i128` 最小値でも `u128` の大きさとして正しく扱えます。
//
// 計算量:
// - O(1)
fn i128_abs_u128 <(i128)->u128> (v):
    if:
        i128_is_negative v
        then:
            u128_from_i128_bits i128_neg v
        else:
            u128_from_i128_bits v

// u128_get_bit: u128 の指定ビットを取り出す
//
// 目的:
// - 小基数除算の long division で、上位ビットから順に 1bit ずつ読むために使います。
//
// 実装(アルゴリズム):
// - idx が 64 以上か未満かで hi / lo を切り替え、右シフト後の最下位ビットを読みます。
//
// 注意(重要):
// - `0 <= idx < 128` を呼び出し側が守る前提です。
//
// 計算量:
// - O(1)
fn u128_get_bit <(u128,i32)->i32> (v, idx):
    if:
        ge idx 64
        then:
            let shifted <i64> shr_u get v "hi" <i64> cast sub idx 64;
            let bit64 <i64> and shifted <i64> cast 1;
            <i32> cast bit64
        else:
            let shifted <i64> shr_u get v "lo" <i64> cast idx;
            let bit64 <i64> and shifted <i64> cast 1;
            <i32> cast bit64

// u128_set_bit: u128 の指定ビットを 1 にする
//
// 目的:
// - 小基数除算で求めた商のビットを立てます。
//
// 実装(アルゴリズム):
// - idx に対応する mask を作り、hi または lo に `or` します。
//
// 注意(重要):
// - 既に 1 のビットを再度立てても問題ありません。
//
// 計算量:
// - O(1)
fn u128_set_bit <(u128,i32)->u128> (v, idx):
    if:
        ge idx 64
        then:
            let mask <i64> shl <i64> cast 1 <i64> cast sub idx 64;
            u128 or get v "hi" mask get v "lo"
        else:
            let mask <i64> shl <i64> cast 1 <i64> cast idx;
            u128 get v "hi" or get v "lo" mask

// u128_add_small: u128 に小さい非負整数を加える
//
// 目的:
// - 基数付き解析で `res = res * radix + digit` を構成する末尾加算に使います。
//
// 実装(アルゴリズム):
// - `digit` を `u128` に持ち上げて通常の `u128 add` に渡します。
//
// 注意(重要):
// - `digit` は 0..15 の範囲を前提にしています。
//
// 計算量:
// - O(1)
fn u128_add_small <(u128,i32)->u128> (v, digit):
    add v to_u128 <i64> cast digit

// u128_mul_small: u128 に小さい非負整数を掛ける
//
// 目的:
// - 文字列解析で基数倍を行うための補助です。
//
// 実装(アルゴリズム):
// - 二進法の繰り返し加算で `v * factor` を作ります。
// - factor は 2 / 8 / 10 / 16 のいずれかなので、回数は定数で抑えられます。
//
// 注意(重要):
// - この関数自体は `u128` 演算に従ってラップします。
// - 解析用途では呼び出し前に `u128_can_mul_add_small` で上限確認してください。
//
// 計算量:
// - O(log factor) だが factor は固定小定数なので実質 O(1)
fn u128_mul_small <(u128,i32)->u128> (v, factor):
    let mut out <u128> u128_zero;
    let mut base <u128> v;
    let mut n <i32> factor;
    while gt n 0:
        do:
            if:
                ne and n 1 0
                then:
                    set out add out base;
                else:
                    ();
            set base add base base;
            set n shr_u n 1;
    out

// u128_divrem_small: u128 を小さい正基数で割った商と余りを返す
//
// 目的:
// - `u128` の文字列表現生成で、下位 1 桁ずつを取り出します。
//
// 実装(アルゴリズム):
// - 128bit の long division を上位ビットから順に行います。
// - 余りは `i32` に収まるので、各段階では `rem = rem * 2 + bit` を更新します。
//
// 注意(重要):
// - radix は 2 / 8 / 10 / 16 を前提にしています。
// - 商は `u128`、余りは 0..radix-1 の `i32` です。
//
// 計算量:
// - O(128) = O(1)
fn u128_divrem_small <(u128,i32)->U128DivRem> (v, radix):
    let mut q <u128> u128_zero;
    let mut rem <i32> 0;
    let mut idx <i32> 127;
    while ge idx 0:
        do:
            let bit <i32> u128_get_bit v idx;
            let shifted_rem <i32> shl rem 1;
            set rem add shifted_rem bit;
            if:
                ge rem radix
                then:
                    set rem sub rem radix;
                    set q u128_set_bit q idx;
                else:
                    ();
            set idx sub idx 1;
    U128DivRem q rem

// u128_can_mul_add_small: `v * radix + digit` が u128 に収まるかを判定する
//
// 目的:
// - 数値文字列の解析で、演算がラップする前に範囲外入力を `Result::Err` へ変換します。
//
// 実装(アルゴリズム):
// - 事前に計算した `u128_max / radix` の商と余りに対して、現在値 v を比較します。
// - `v < quotient` なら次の桁は必ず安全です。
// - `v > quotient` なら必ず overflow します。
// - `v == quotient` の場合だけ、digit が最大余り以下かを確認します。
//
// 注意(重要):
// - radix は `validate_radix` 済みで、digit は radix 未満であることを前提にします。
// - 実際の乗算と加算はこの判定が true の時だけ行ってください。
//
// 計算量:
// - O(1)
fn u128_can_mul_add_small <(u128,i32,u128,i32)->bool> (v, digit, max_quotient, max_remainder):
    if:
        lt v max_quotient
        then:
            true
        else:
            if:
                lt max_quotient v
                then:
                    false
                else:
                    le digit max_remainder

//: from_i32: i32 を符号付き 10 進文字列へ変換する
//:
//: [目的/もくてき]:
//: - `i32` を `"-42"` のような表示用文字列へ変換します。
//: - 診断文やログで、負数を含む整数をそのまま表示したい時に使います。
//:
//: [実装/じっそう]:
//: - `from_i32_radix x 10` に委譲し、基数付き整数文字列化の実装へ統一します。
//: - 桁生成と負号処理は `i64` / `i128` の共通経路で扱います。
//:
//: [注意/ちゅうい]:
//: - 返値は新規確保された文字列です。
//: - allocation failure または内部変換失敗時は `"0"` fallback を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(d)  (d は 10 進桁数)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let ok0 <bool> str_eq from_i32 42 "42";
//:     let ok1 <bool> str_eq from_i32 -42 "-42";
//:     let ok <bool> and ok0 ok1;
//:     if ok 1 0
//: ```
fn from_i32 <(i32)->str> (x):
    match from_i32_radix x 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

//: to_i32: 10 進文字列を i32 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i32` に変換します。
//:
//: [実装/じっそう]:
//: - `to_i32_radix s 10` に委譲し、基数付き実装へ統一します。
//: - `to_i32_radix` は `to_i64_radix` の結果を i32 表現域で検査してから縮小します。
//:
//: [注意/ちゅうい]:
//: - 負号は先頭 1 byte の `-` だけを受理します。
//: - 空文字列、無効な digit、表現域外入力はいずれも `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn to_i32 <(str)->Result<i32,i32>> (s):
    match to_i32_radix s 10:
        Result::Ok v:
            Result::Ok<i32,i32> v
        Result::Err e:
            Result::Err<i32,i32> e

// from_i32_radix: i32 を指定した基数の文字列へ変換する
//
// 目的:
// - i32 を 2 / 8 / 10 / 16 進の文字列へ変換します。
// - ログ、テスト、シリアライズで基数を明示した文字列表現が必要な場面に使います。
//
// 実装(アルゴリズム):
// - `i32` を `i64` に符号拡張してから `from_i64_radix` に委譲します。
// - 桁列生成の本体は i64 共通実装に集約します。
//
// 注意(重要):
// - 対応基数は 2 / 8 / 10 / 16 のみです。
// - 結果は小文字英字を使うため、16 進では `ff` のような表記になります。
//
// 計算量:
// - O(d)  (d は指定基数での桁数)
fn from_i32_radix <(i32,i32)->Result<str,i32>> (x, radix):
    from_i64_radix <i64> cast x radix

// to_i32_radix: 指定基数の文字列を i32 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進で書かれた文字列を i32 に変換します。
// - 設定値やリテラル風入力を i32 として読み取りたい時に使います。
//
// 実装(アルゴリズム):
// - まず `to_i64_radix` で共通解析を行います。
// - その後、i32 の範囲に収まるかを確認してから縮小します。
//
// 注意(重要):
// - 接頭辞 `0x` や `0b` は解釈しません。文字列本体だけを渡してください。
// - 解析失敗と範囲外はどちらも `Result::Err` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
fn to_i32_radix <(str,i32)->Result<i32,i32>> (s, radix):
    match to_i64_radix s radix:
        Result::Ok v64:
            if:
                and ge v64 <i64> cast -2147483648 le v64 <i64> cast 2147483647
                then:
                    Result::Ok<i32,i32> <i32> cast v64
                else:
                    Result::Err<i32,i32> 1
        Result::Err e:
            Result::Err<i32,i32> e

//: from_i64: i64 を符号付き 10 進文字列へ変換する
//:
//: [目的/もくてき]:
//: - `i64` を `"-42"` のような表示用文字列へ変換します。
//:
//: [実装/じっそう]:
//: - `from_i64_radix x 10` に委譲し、基数付き実装へ統一します。
//:
//: [注意/ちゅうい]:
//: - `i64` 最小値も `i128` 経由で magnitude を扱うため、符号反転 overflow に依存しません。
//: - 失敗時は `"0"` fallback を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(d)
fn from_i64 <(i64)->str> (x):
    match from_i64_radix x 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_i64_radix: i64 を指定した基数の文字列へ変換する
//
// 目的:
// - i64 を 2 / 8 / 10 / 16 進文字列へ変換します。
// - 整数の可視化や、基数を固定したテストデータ生成に使います。
//
// 実装(アルゴリズム):
// - `i64` を `i128` に持ち上げ、符号と magnitude の処理を `from_i128_radix` に統一します。
//
// 注意(重要):
// - すべての基数で負数は `-ff` のような符号付き文字列として返します。
// - 16 進の英字は小文字です。
// - 基数が不正な場合は `Result::Err 1` を返します。
//
// 計算量:
// - O(d)  (d は指定基数での桁数)
fn from_i64_radix <(i64,i32)->Result<str,i32>> (x, radix):
    from_i128_radix <i128> cast x radix

//: to_i64: 10 進文字列を i64 として解析する
//:
//: [目的/もくてき]:
//: - 符号付き 10 進文字列を `i64` として読み取ります。
//:
//: [実装/じっそう]:
//: - `to_i64_radix s 10` に委譲し、基数付き解析へ統一します。
//:
//: [注意/ちゅうい]:
//: - 接頭辞は読まず、文字列本体だけを解析します。
//: - 表現域外入力は `Result::Err 1` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn to_i64 <(str)->Result<i64,i32>> (s):
    to_i64_radix s 10

// i128_fits_i64: i128 が i64 の表現域に収まるかを判定する
//
// 目的:
// - `to_i64_radix` が範囲外の i128 を i64 に切り詰めて受理しないようにします。
//
// 実装(アルゴリズム):
// - 非負 i64 は hi が 0 かつ lo の符号 bit が 0 の時だけ許可します。
// - 負 i64 は hi が -1 かつ lo の符号 bit が 1 の時だけ許可します。
//
// 注意(重要):
// - これは bit pattern の符号拡張検査であり、cast 前に必ず実行します。
//
// 計算量:
// - O(1)
fn i128_fits_i64 <(i128)->bool> (v):
    let hi <i64> get v "hi";
    let lo <i64> get v "lo";
    if:
        eq hi <i64> cast 0
        then:
            not lt lo <i64> cast 0
        else:
            if:
                eq hi <i64> cast -1
                then:
                    lt lo <i64> cast 0
                else:
                    false

// to_i64_radix: 指定基数の文字列を i64 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進文字列を i64 として解釈します。
// - 数値入力の解析や、基数別テストデータの読み戻しに使います。
//
// 実装(アルゴリズム):
// - `to_i128_radix` で共通解析を行い、最後に `i64` へ縮小します。
// - i128 の上位 word が i64 の符号拡張と一致する時だけ縮小します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - `-ff` のような符号付き文字列は、すべての対応基数で受理します。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)  (n は入力文字列長)
fn to_i64_radix <(str,i32)->Result<i64,i32>> (s, radix):
    match to_i128_radix s radix:
        Result::Ok v128:
            if:
                i128_fits_i64 v128
                then:
                    Result::Ok<i64,i32> <i64> cast v128
                else:
                    Result::Err<i64,i32> 1
        Result::Err e:
            Result::Err<i64,i32> e

// from_u128: u128 を 10 進文字列へ変換する
//
// 目的:
// - `u128` の大きな値を 10 進文字列として可視化します。
//
// 実装(アルゴリズム):
// - `from_u128_radix v 10` に委譲します。
//
// 注意(重要):
// - 返る文字列は常に非負で、負号は付きません。
//
// 計算量:
// - O(d)
fn from_u128 <(u128)->str> (v):
    match from_u128_radix v 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_u128_radix: u128 を指定基数の文字列へ変換する
//
// 目的:
// - `u128` を 2 / 8 / 10 / 16 進文字列へ変換します。
//
// 実装(アルゴリズム):
// - 小さい基数での `u128_divrem_small` を繰り返し、まず必要な桁数を数えます。
// - 確保した出力領域を末尾から埋めることで、一時 raw buffer を使わずに確定文字列を作ります。
//
// 注意(重要):
// - 英字桁は小文字です。
// - 基数が不正な場合は `Result::Err 1` を返します。
//
// 計算量:
// - O(128 * d) だが 128 は固定幅なので、桁数 d に対して実質 O(d)
fn from_u128_radix <(u128,i32)->Result<str,i32>> (v, radix):
    match validate_radix radix:
        Result::Err e:
            Result::Err<str,i32> e
        Result::Ok _:
            if:
                u128_is_zero v
                then:
                    Result::Ok<str,i32> "0"
                else:
                    let mut digit_count <i32> 0;
                    let mut count_n <u128> v;
                    while not u128_is_zero count_n:
                        do:
                            let qr_count <U128DivRem> u128_divrem_small count_n radix;
                            set digit_count add digit_count 1;
                            set count_n get qr_count "quotient";
                    match string_alloc_region digit_count:
                        Result::Err _e:
                            Result::Err<str,i32> 12
                        Result::Ok out_region:
                            let out_data <MemPtr<u8>> string_region_data_ptr &out_region;
                            let out_raw <i32> mem_ptr_addr out_data;
                            let mut pos <i32> digit_count;
                            let mut write_n <u128> v;
                            while not u128_is_zero write_n:
                                do:
                                    let qr_write <U128DivRem> u128_divrem_small write_n radix;
                                    set pos sub pos 1;
                                    store_u8 add out_raw pos digit_to_char_lower get qr_write "remainder";
                                    set write_n get qr_write "quotient";
                            Result::Ok<str,i32> string_finish out_region digit_count

// to_u128: 10 進文字列を u128 に変換する
//
// 目的:
// - 大きな非負整数文字列を `u128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_u128_radix s 10` に委譲します。
//
// 注意(重要):
// - 負号は受理しません。
//
// 計算量:
// - O(n)
fn to_u128 <(str)->Result<u128,i32>> (s):
    to_u128_radix s 10

// to_u128_radix: 指定基数の文字列を u128 に変換する
//
// 目的:
// - 非負の 2 / 8 / 10 / 16 進文字列を `u128` に変換します。
//
// 実装(アルゴリズム):
// - 各文字を `digit_from_char` で数値化し、`res = res * radix + digit` を `u128_mul_small` と `u128_add_small` で構築します。
// - 更新前に `u128_max / radix` の商と余りで範囲を確認し、ラップする入力を拒否します。
//
// 注意(重要):
// - 接頭辞 `0b` / `0o` / `0x` は解釈しません。
// - 負号付き文字列は `Result::Err 1` です。
// - 表現域外入力は `Result::Err 1` を返します。
//
// 計算量:
// - O(n)
fn to_u128_radix <(str,i32)->Result<u128,i32>> (s, radix):
    match validate_radix radix:
        Result::Err e:
            Result::Err<u128,i32> e
        Result::Ok _:
            let n <i32> len s;
            let mut i <i32> 0;
            let mut res <u128> u128_zero;
            let mut ok <i32> 1;
            let max_qr <U128DivRem> u128_divrem_small u128_max radix;
            let max_quotient <u128> get max_qr "quotient";
            let max_remainder <i32> get max_qr "remainder";
            if:
                eq n 0
                then:
                    set ok 0;
                else:
                    let first <i32> string_byte_at_unchecked s 0;
                    if:
                        eq first '-'
                        then:
                            set ok 0;
                        else:
                            while lt i n:
                                do:
                                    let digit_chr <i32> string_byte_at_unchecked s i;
                                    match digit_from_char digit_chr:
                                        Result::Ok digit:
                                            if:
                                                ge digit radix
                                                then:
                                                    set ok 0;
                                                    set i n;
                                                else:
                                                    if:
                                                        u128_can_mul_add_small res digit max_quotient max_remainder
                                                        then:
                                                            set res u128_add_small u128_mul_small res radix digit;
                                                            set i add i 1;
                                                        else:
                                                            set ok 0;
                                                            set i n;
                                        Result::Err _:
                                            set ok 0;
                                            set i n;
            if:
                eq ok 1
                then:
                    Result::Ok<u128,i32> res
                else:
                    Result::Err<u128,i32> 1

// from_i128: i128 を 10 進文字列へ変換する
//
// 目的:
// - `i128` を 10 進の符号付き文字列へ変換します。
//
// 実装(アルゴリズム):
// - `from_i128_radix v 10` に委譲します。
//
// 注意(重要):
// - 大きさの処理は `u128` の桁生成へ寄せています。
//
// 計算量:
// - O(d)
fn from_i128 <(i128)->str> (v):
    match from_i128_radix v 10:
        Result::Ok s:
            s
        Result::Err _:
            "0"

// from_i128_radix: i128 を指定基数の文字列へ変換する
//
// 目的:
// - `i128` を 2 / 8 / 10 / 16 進の符号付き文字列へ変換します。
//
// 実装(アルゴリズム):
// - 負号の有無だけを `i128` 側で判定し、大きさは `i128_abs_u128` を通して `from_u128_radix` に渡します。
//
// 注意(重要):
// - すべての基数で負数は `-...` の形に統一します。
// - 16 進英字は小文字です。
//
// 計算量:
// - O(d)
fn from_i128_radix <(i128,i32)->Result<str,i32>> (v, radix):
    let neg <bool> i128_is_negative v;
    let mag <u128> i128_abs_u128 v;
    match from_u128_radix mag radix:
        Result::Ok body:
            if:
                neg
                then:
                    match concat_result "-" body:
                        Result::Ok text:
                            Result::Ok<str,i32> text
                        Result::Err _e:
                            Result::Err<str,i32> 12
                else:
                    Result::Ok<str,i32> body
        Result::Err e:
            Result::Err<str,i32> e

// i128_positive_magnitude_allowed: 非負 i128 として許される大きさかを判定する
//
// 目的:
// - `to_i128_radix` が正の範囲外入力を 2 の補数負値として受理しないようにします。
//
// 実装(アルゴリズム):
// - i128 の正の最大値は上位 bit が 0 の範囲なので、u128 の hi word が負でないことを確認します。
//
// 注意(重要):
// - ここでは magnitude を u128 として受け取り、符号付き値への bitcast 前に検査します。
//
// 計算量:
// - O(1)
fn i128_positive_magnitude_allowed <(u128)->bool> (mag):
    not lt get mag "hi" <i64> cast 0

// i128_negative_magnitude_allowed: 負 i128 として許される大きさかを判定する
//
// 目的:
// - i128 最小値だけは magnitude が 2^127 でも受理し、それより大きい負入力を拒否します。
//
// 実装(アルゴリズム):
// - 上位 bit が 0 なら通常の負値として安全です。
// - 上位 bit が 1 の場合は、正確に `0x8000...0000` の時だけ最小値として許可します。
//
// 注意(重要):
// - `-170...728` は許可し、`-170...729` は拒否する境界です。
//
// 計算量:
// - O(1)
fn i128_negative_magnitude_allowed <(u128)->bool> (mag):
    if:
        not lt get mag "hi" <i64> cast 0
        then:
            true
        else:
            let min_hi <i64> shl <i64> cast 1 <i64> cast 63;
            and eq get mag "hi" min_hi eq get mag "lo" <i64> cast 0

// i128_magnitude_allowed: 符号に応じて i128 の magnitude 範囲を判定する
//
// 目的:
// - `to_i128_radix` の符号別境界判定を 1 箇所に集約します。
//
// 実装(アルゴリズム):
// - 負号があれば `i128_negative_magnitude_allowed`、なければ `i128_positive_magnitude_allowed` に委譲します。
//
// 注意(重要):
// - この判定が true の時だけ `i128_from_u128_bits` へ進めます。
//
// 計算量:
// - O(1)
fn i128_magnitude_allowed <(u128,bool)->bool> (mag, neg):
    if:
        neg
        then:
            i128_negative_magnitude_allowed mag
        else:
            i128_positive_magnitude_allowed mag

// to_i128: 10 進文字列を i128 に変換する
//
// 目的:
// - 大きな符号付き整数文字列を `i128` として読み取ります。
//
// 実装(アルゴリズム):
// - `to_i128_radix s 10` に委譲します。
//
// 注意(重要):
// - 接頭辞は解釈しません。
//
// 計算量:
// - O(n)
fn to_i128 <(str)->Result<i128,i32>> (s):
    to_i128_radix s 10

// to_i128_radix: 指定基数の文字列を i128 に変換する
//
// 目的:
// - 2 / 8 / 10 / 16 進の符号付き文字列を `i128` に変換します。
//
// 実装(アルゴリズム):
// - 先頭の `-` を切り出した後、残りを `to_u128_radix` で非負の大きさとして解析します。
// - 符号に応じた i128 の表現域を確認し、範囲外なら `Result::Err` にします。
// - 符号が負なら `i128_neg` で符号反転します。
//
// 注意(重要):
// - 表現域外入力は `Result::Err 1` を返します。
// - 接頭辞 `0x` などは解釈しません。
//
// 計算量:
// - O(n)
fn to_i128_radix <(str,i32)->Result<i128,i32>> (s, radix):
    let n <i32> len s;
    if:
        eq n 0
        then:
            Result::Err<i128,i32> 1
        else:
            let first <i32> string_byte_at_unchecked s 0;
            let neg <bool> eq first '-';
            let body <str> if neg:
                then str_slice s 1 n
                else s
            match to_u128_radix body radix:
                Result::Ok mag:
                    if:
                        i128_magnitude_allowed mag neg
                        then:
                            let base <i128> i128_from_u128_bits mag;
                            if:
                                neg
                                then:
                                    Result::Ok<i128,i32> i128_neg base
                                else:
                                    Result::Ok<i128,i32> base
                        else:
                            Result::Err<i128,i32> 1
                Result::Err e:
                    Result::Err<i128,i32> e

//: from_f64_fraction_trim_len: 固定 6 桁の小数 digit から出力桁数を決める
//:
//: [目的/もくてき]:
//: - `from_f64_result` が生成した 6 個の小数 digit について、末尾の `0` を除いた有効桁数を返します。
//:
//: [実装/じっそう]:
//: - 最後の digit から先頭へ向かって非 0 を探し、見つかった位置に応じた長さを返します。
//: - すべて 0 の場合は小数点自体を出力しないため `0` を返します。
//:
//: [注意/ちゅうい]:
//: - digit は `0..9` の範囲で渡される前提です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn from_f64_fraction_trim_len <(i32,i32,i32,i32,i32,i32)->i32> (d0, d1, d2, d3, d4, d5):
    if:
        ne d5 0
        then:
            6
        else:
            if:
                ne d4 0
                then:
                    5
                else:
                    if:
                        ne d3 0
                        then:
                            4
                        else:
                            if:
                                ne d2 0
                                then:
                                    3
                                else:
                                    if:
                                        ne d1 0
                                        then:
                                            2
                                        else:
                                            if:
                                                ne d0 0
                                                then:
                                                    1
                                                else:
                                                    0

//: from_f64_append_fraction_digit_result: 必要な場合だけ小数 digit を builder に追加する
//:
//: [目的/もくてき]:
//: - trim 後に残る digit だけを `StringBuilder` に追加します。
//:
//: [実装/じっそう]:
//: - `index < trim` の digit だけ ASCII 数字 byte として追加し、それ以外は builder をそのまま返します。
//: - 追加には `sb_append_byte_result` を使い、raw memory を直接扱いません。
//:
//: [注意/ちゅうい]:
//: - digit は `0..9` の範囲で渡される前提です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn from_f64_append_fraction_digit_result <(StringBuilder,i32,i32,i32)->Result<StringBuilder,str>> (sb, trim, index, digit):
    if:
        lt index trim
        then:
            sb_append_byte_result sb add '0' digit
        else:
            Result<StringBuilder,str>::Ok sb

//: from_f64_append_fraction_result: 小数点と小数 digit を builder に追加する
//:
//: [目的/もくてき]:
//: - `from_f64_result` の小数部を、trim 済みの固定小数表記として builder へ追加します。
//:
//: [実装/じっそう]:
//: - trim が 0 の場合は小数点を出力しません。
//: - trim が 1 以上なら `.` を追加し、続けて必要な digit だけを順番に追加します。
//:
//: [注意/ちゅうい]:
//: - builder owner は各 `_result` API で消費され、失敗時には内部 buffer が解放されます。
//:
//: [計算量/けいさんりょう]:
//: - O(trim)。ただし trim は最大 6 です。
fn from_f64_append_fraction_result <(StringBuilder,i32,i32,i32,i32,i32,i32,i32)->Result<StringBuilder,str>> (sb, trim, d0, d1, d2, d3, d4, d5):
    if:
        le trim 0
        then:
            Result<StringBuilder,str>::Ok sb
        else:
            match sb_append_byte_result sb '.':
                Result::Err e:
                    Result<StringBuilder,str>::Err e
                Result::Ok sb_dot:
                    match from_f64_append_fraction_digit_result sb_dot trim 0 d0:
                        Result::Err e:
                            Result<StringBuilder,str>::Err e
                        Result::Ok sb0:
                            match from_f64_append_fraction_digit_result sb0 trim 1 d1:
                                Result::Err e:
                                    Result<StringBuilder,str>::Err e
                                Result::Ok sb1:
                                    match from_f64_append_fraction_digit_result sb1 trim 2 d2:
                                        Result::Err e:
                                            Result<StringBuilder,str>::Err e
                                        Result::Ok sb2:
                                            match from_f64_append_fraction_digit_result sb2 trim 3 d3:
                                                Result::Err e:
                                                    Result<StringBuilder,str>::Err e
                                                Result::Ok sb3:
                                                    match from_f64_append_fraction_digit_result sb3 trim 4 d4:
                                                        Result::Err e:
                                                            Result<StringBuilder,str>::Err e
                                                        Result::Ok sb4:
                                                            from_f64_append_fraction_digit_result sb4 trim 5 d5

//: from_f64_build_fixed_result: 符号、整数部、小数部を 1 つの文字列へ組み立てる
//:
//: [目的/もくてき]:
//: - `from_f64_result` で計算済みの各部品を、所有権が明確な `StringBuilder` 経由で `str` にします。
//:
//: [実装/じっそう]:
//: - 必要 byte 数を先に計算し、その capacity で builder を作ります。
//: - 符号、整数部、小数部を順に追加し、最後に `sb_build_result` で出力文字列へ copy します。
//:
//: [注意/ちゅうい]:
//: - fractional digit の一時領域を raw buffer として確保しないため、Resource IR の moved-cell 解析に乗る所有権境界だけを通ります。
//:
//: [計算量/けいさんりょう]:
//: - O(len(int_s) + trim)
fn from_f64_build_fixed_result <(bool,str,i32,i32,i32,i32,i32,i32,i32)->Result<str,str>> (neg, int_s, trim, d0, d1, d2, d3, d4, d5):
    let sign_len <i32> if neg:
        then 1
        else 0
    let frac_len <i32> if:
        gt trim 0
        then:
            add 1 trim
        else:
            0
    let total <i32> add add sign_len len int_s frac_len
    match string_builder_with_capacity_result total:
        Result::Err e:
            Result<str,str>::Err e
        Result::Ok sb0:
            let signed <Result<StringBuilder,str>> if neg:
                then:
                    sb_append_byte_result sb0 '-'
                else:
                    Result<StringBuilder,str>::Ok sb0
            match signed:
                Result::Err e:
                    Result<str,str>::Err e
                Result::Ok sb1:
                    match sb_append_result sb1 int_s:
                        Result::Err e:
                            Result<str,str>::Err e
                        Result::Ok sb2:
                            match from_f64_append_fraction_result sb2 trim d0 d1 d2 d3 d4 d5:
                                Result::Err e:
                                    Result<str,str>::Err e
                                Result::Ok sb3:
                                    sb_build_result sb3

//: from_f64_result: f64 を有限値だけ文字列化する
//:
//: [目的/もくてき]:
//: - `f64` を固定小数の表示用 `str` に変換します。
//: - 失敗を呼び出し側で扱えるように `Result` で返します。
//:
//: [実装/じっそう]:
//: - 整数部は `from_i64_radix` で 10 進文字列化します。
//: - 小数部は局所 `i32` digit へ最大 6 桁だけ展開し、末尾の `0` を削ってから `StringBuilder` で連結します。
//:
//: [注意/ちゅうい]:
//: - `NaN` は `"nan"` を返します。
//: - 現在は指数表記を生成せず、小数部は最大 6 桁です。
//: - `from_f64` は失敗時に `"0"` fallback を返す互換 API です。
//:
//: [計算量/けいさんりょう]:
//: - 整数部の桁数を `d` として O(d)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let one <f64> <f64> cast 1
//:     let quartered <f64> div <f64> cast 5 <f64> cast 4
//:     let neg_half <f64> div <f64> cast -1 <f64> cast 2
//:     let ok0 <bool> str_eq from_f64 one "1"
//:     let ok1 <bool> str_eq from_f64 quartered "1.25"
//:     let ok2 <bool> str_eq from_f64 neg_half "-0.5"
//:     if and ok0 and ok1 ok2 1 0
//: ```
fn from_f64_result <(f64)->Result<str,i32>> (x):
    if:
        ne x x
        then:
            Result::Ok<str,i32> "nan"
        else:
            let neg <bool> lt x <f64> cast 0;
            let absx <f64> if neg:
                then sub <f64> cast 0 x
                else x
            let int_part <i64> cast absx;
            let int_f <f64> cast int_part;
            let mut frac <f64> sub absx int_f;
            match from_i64_radix int_part 10:
                Result::Err e:
                    Result::Err<str,i32> e
                Result::Ok int_s:
                    set frac mul frac <f64> cast 10
                    let d0 <i32> cast frac
                    set frac sub frac <f64> cast d0
                    set frac mul frac <f64> cast 10
                    let d1 <i32> cast frac
                    set frac sub frac <f64> cast d1
                    set frac mul frac <f64> cast 10
                    let d2 <i32> cast frac
                    set frac sub frac <f64> cast d2
                    set frac mul frac <f64> cast 10
                    let d3 <i32> cast frac
                    set frac sub frac <f64> cast d3
                    set frac mul frac <f64> cast 10
                    let d4 <i32> cast frac
                    set frac sub frac <f64> cast d4
                    set frac mul frac <f64> cast 10
                    let d5 <i32> cast frac
                    let trim <i32> from_f64_fraction_trim_len d0 d1 d2 d3 d4 d5
                    match from_f64_build_fixed_result neg int_s trim d0 d1 d2 d3 d4 d5:
                        Result::Ok out:
                            Result::Ok<str,i32> out
                        Result::Err _e:
                            Result::Err<str,i32> 12

fn from_f64 <(f64)->str> (x):
    match from_f64_result x:
        Result::Ok text:
            text
        Result::Err _e:
            "0"

//: to_f64: 10 進浮動小数文字列を f64 として解析する
//:
//: [目的/もくてき]:
//: - `123`、`-1.5`、`1e3` のような文字列を `f64` に変換します。
//:
//: [実装/じっそう]:
//: - 符号、整数部、小数部、指数部を byte 走査で読み取り、10 倍/10 分の 1 を繰り返して値を組み立てます。
//:
//: [注意/ちゅうい]:
//: - 少なくとも 1 桁の digit が必要です。
//: - `nan` / `inf` などの記号名は解析しません。
//: - overflow / underflow は backend の `f64` 演算に従います。
//:
//: [計算量/けいさんりょう]:
//: - O(n + |exponent|)
fn to_f64 <(str)->Result<f64,i32>> (s):
    let n <i32> len s;
    let mut i <i32> 0;
    let mut ok <i32> 1;
    let mut neg <i32> 0;
    let mut int_part <f64> cast 0;
    let mut frac_part <f64> cast 0;
    let mut frac_scale <f64> cast 1;
    let mut has_digit <i32> 0;
    let ten <f64> cast 10;
    let mut out_res <Result<f64,i32>> Result::Err<f64,i32> 1;

    if:
        eq n 0
        then:
            set ok 0;
        else:
            let first <i32> string_byte_at_unchecked s 0;
            if:
                eq first '-'
                then:
                    set neg 1;
                    set i 1;
                else:
                    if:
                        eq first '+'
                        then:
                            set i 1;
                        else:
                            ();

            let mut done_int <i32> 0;
            while and eq ok 1 eq done_int 0:
                do:
                    if:
                        lt i n
                        then:
                            let b <i32> string_byte_at_unchecked s i;
                            let d <i32> sub b '0';
                            if:
                                and ge d 0 le d 9
                                then:
                                    set has_digit 1;
                                    let scaled <f64> mul int_part ten;
                                    let dv <f64> cast d;
                                    let next_int <f64> add scaled dv;
                                    set int_part next_int;
                                    set i add i 1;
                                else:
                                    set done_int 1;
                        else:
                            set done_int 1;

            let mut has_dot <i32> 0;
            if:
                and eq ok 1 lt i n
                then:
                    let dot <i32> string_byte_at_unchecked s i;
                    if:
                        eq dot '.'
                        then:
                            set has_dot 1;
                        else:
                            ();
                else:
                    ();

            if:
                eq has_dot 1
                then:
                    set i add i 1;
                    let mut done_frac <i32> 0;
                    while and eq ok 1 eq done_frac 0:
                        do:
                            if:
                                lt i n
                                then:
                                    let b <i32> string_byte_at_unchecked s i;
                                    let d <i32> sub b '0';
                                    if:
                                        and ge d 0 le d 9
                                        then:
                                            set has_digit 1;
                                            let next_scale <f64> div frac_scale ten;
                                            set frac_scale next_scale;
                                            let dv <f64> cast d;
                                            let addv <f64> mul dv frac_scale;
                                            let next_frac <f64> add frac_part addv;
                                            set frac_part next_frac;
                                            set i add i 1;
                                        else:
                                            set done_frac 1;
                                else:
                                    set done_frac 1;
                else:
                    ();

            let mut exp_val <i32> 0;
            let mut exp_neg <i32> 0;
            let mut has_exp <i32> 0;
            if:
                and eq ok 1 lt i n
                then:
                    let eb <i32> string_byte_at_unchecked s i;
                    if:
                        or eq eb 'e' eq eb 'E'
                        then:
                            set has_exp 1;
                        else:
                            ();
                else:
                    ();

            if:
                eq has_exp 1
                then:
                    set i add i 1;
                    if:
                        lt i n
                        then:
                            let sb <i32> string_byte_at_unchecked s i;
                            if:
                                eq sb '-'
                                then:
                                    set exp_neg 1;
                                    set i add i 1;
                                else:
                                    if:
                                        eq sb '+'
                                        then:
                                            set i add i 1;
                                        else:
                                            ();
                        else:
                            set ok 0;

                    let mut exp_digits <i32> 0;
                    let mut done_exp <i32> 0;
                    while and eq ok 1 eq done_exp 0:
                        do:
                            if:
                                lt i n
                                then:
                                    let b <i32> string_byte_at_unchecked s i;
                                    let d <i32> sub b '0';
                                    if:
                                        and ge d 0 le d 9
                                        then:
                                            set exp_digits 1;
                                            set exp_val <i32> add <i32> mul exp_val 10 d;
                                            set i add i 1;
                                        else:
                                            set done_exp 1;
                                else:
                                    set done_exp 1;
                    if:
                        eq exp_digits 0
                        then:
                            set ok 0;
                        else:
                            ();
                else:
                    ();

            if:
                ne i n
                then:
                    set ok 0;
                else:
                    ();

            if:
                eq has_digit 0
                then:
                    set ok 0;
                else:
                    ();

            let mut out <f64> add int_part frac_part;
            let mut k <i32> 0;
            while and eq ok 1 lt k exp_val:
                do:
                    if:
                        eq exp_neg 1
                        then:
                            let next_out <f64> div out ten;
                            set out next_out;
                        else:
                            let next_out <f64> mul out ten;
                            set out next_out;
                    set k add k 1;

            if:
                eq ok 1
                then:
                    if:
                        eq neg 1
                        then:
                            let zero <f64> cast 0;
                            let signed_out <f64> sub zero out;
                            set out_res Result::Ok<f64,i32> signed_out;
                        else:
                            set out_res Result::Ok<f64,i32> out;
                else:
                    set out_res Result::Err<f64,i32> 1;

    out_res

//: from_f32: f32 を f64 共通経路で文字列化する
//:
//: [目的/もくてき]:
//: - `f32` 値を表示用 `str` へ変換します。
//:
//: [実装/じっそう]:
//: - `f32` を `f64` に拡張し、`from_f64` の formatting に統一します。
//:
//: [注意/ちゅうい]:
//: - 小数桁数や fallback は `from_f64` と同じです。
//:
//: [計算量/けいさんりょう]:
//: - `from_f64` に従います。
fn from_f32 <(f32)->str> (x):
    from_f64 <f64> cast x

//: to_f32: 10 進浮動小数文字列を f32 として解析する
//:
//: [目的/もくてき]:
//: - `to_f64` と同じ表記を受理し、結果を `f32` に縮小します。
//:
//: [実装/じっそう]:
//: - `to_f64` による解析結果を `f32` に cast します。
//:
//: [注意/ちゅうい]:
//: - `f32` への丸めや overflow は backend の cast に従います。
//:
//: [計算量/けいさんりょう]:
//: - `to_f64` に従います。
fn to_f32 <(str)->Result<f32,i32>> (s):
    match to_f64 s:
        Result::Ok v64:
            Result::Ok<f32,i32> <f32> cast v64
        Result::Err e:
            Result::Err<f32,i32> e

//: find: 最初に一致した byte index を返す
//:
//: [目的/もくてき]:
//: - `s` の中に `pat` が最初に出る byte index を `Option<i32>` で返します。
//: - 見つからない場合は `Option::None` を返します。
//:
//: [実装/じっそう]:
//: - 空 pattern は先頭一致として `Some(0)` を返します。
//: - pattern が入力より長い場合は探索せず `None` を返します。
//: - それ以外は開始位置を前から進め、各位置で `str_eq_at` により byte 列を比較します。
//:
//: [注意/ちゅうい]:
//: - 戻り値は UTF-8 文字数ではなく byte index です。
//: - Unicode 正規化や文字境界検査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - n を `s` の byte 長、m を `pat` の byte 長として O((n - m + 1) * m) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string" as *
//:| #import "core/option" as *
//:| #import "std/test" as *
//: fn expect_find_some <(str,Option<i32>,i32)*>Result<(),str>> (label, got, expected):
//:     match got:
//:         Option::Some actual:
//:             check_eq_i32 expected actual
//:         Option::None:
//:             Result<(),str>::Err label
//:
//: fn main <()*>i32> ():
//:     let checks:
//:         checks_new
//:         |> checks_push expect_find_some "empty" find "abc" "" 0
//:         |> checks_push expect_find_some "prefix" find "abc" "ab" 0
//:         |> checks_push expect_find_some "middle" find "abcabc" "ca" 2
//:         |> checks_push expect_find_some "suffix" find "abc" "bc" 1
//:         |> checks_push assert is_none<i32> find "abc" "z"
//:         |> checks_push assert is_none<i32> find "ab" "abc"
//:     checks_exit_code checks
//: ```
fn find <(str,str)->Option<i32>> (s, pat):
    let s_len <i32> len s;
    let pat_len <i32> len pat;
    if:
        eq pat_len 0
        then some<i32> 0
        else:
            if:
                lt s_len pat_len
                then none<i32>
                else:
                    let last_start <i32> sub s_len pat_len;
                    let mut start <i32> 0;
                    let mut out <Option<i32>> none<i32>;
                    let mut searching <bool> true;
                    while and searching le start last_start:
                        do:
                            if:
                                str_eq_at s pat start pat_len 0
                                then:
                                    set out some<i32> start;
                                    set searching false;
                                else:
                                    set start add start 1;
                    out
