//: # alloc/gui/app/types
//: GUI / TUI 共通 application model の軽量 data 型
//:
//: ### [目的/もくてき]
//: - widget identity、action identity、view description、host effect、update result を値として表します。
//: - callback-heavy widget を避け、`Model + GuiEvent -> Update Model` の data flow を静的検査しやすい形にします。
//:
//: ### [契約/けいやく]
//: - `WidgetId` と `ActionId` は `core/gui` の event 境界で定義される識別子です。
//: - `GuiEffect` は実行そのものではなく、`std/gui/runtime` が解釈する要求値です。
//: - この module は DOM、ANSI、OS window handle、clipboard API を直接呼びません。
//:
//: ### [現状/げんじょう]
//: - 最初の checkpoint では `Empty` / `Label` / `Button` と、redraw / title だけを持つ小さな surface に留めています。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```

#indent 4

#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: widget_id: raw integer から WidgetId を作る
//:
//: [目的/もくてき]:
//: - test や小さな application が stable id を明示できるようにします。
pub fn widget_id %fn i32 WidgetId \value:
    widget_id_new value

//: widget_id_value: WidgetId の比較用 raw value を読む
pub fn widget_id_value %fn WidgetId i32 \id:
    widget_id_raw &id

//: action_id: raw integer から ActionId を作る
pub fn action_id %fn i32 ActionId \value:
    action_id_new value

//: action_id_value: ActionId の比較用 raw value を読む
pub fn action_id_value %fn ActionId i32 \id:
    action_id_raw &id

//: ButtonConfig: action を持つ button view の設定
//:
//: [目的/もくてき]:
//: - button が closure を持たず、id、表示 text、action id だけで application logic と接続できるようにします。
//:
//: [注意/ちゅうい]:
//: - style と layout hint は後続 checkpoint で別 struct として追加します。
pub struct ButtonConfig:
    id %WidgetId
    text %str
    action %ActionId

impl Clone for ButtonConfig:
    fn clone %fn &ButtonConfig ButtonConfig \config:
        *config

impl Copy for ButtonConfig:
    fn copy_mark %fn ButtonConfig ButtonConfig \config:
        config

//: button_config: ButtonConfig を作る
pub fn button_config %fn WidgetId fn str fn ActionId ButtonConfig \id\text\action:
    ButtonConfig id text action

//: button_config_id: ButtonConfig の widget id を[読/よ]む
pub fn button_config_id %fn &ButtonConfig WidgetId \config:
    *field::get_ref config "id"

//: button_config_text: ButtonConfig の表示 text を[読/よ]む
pub fn button_config_text %fn &ButtonConfig str \config:
    *field::get_ref config "text"

//: button_config_action: ButtonConfig の action id を[読/よ]む
pub fn button_config_action %fn &ButtonConfig ActionId \config:
    *field::get_ref config "action"

//: ViewNode: retained view tree の最小 node
//:
//: [目的/もくてき]:
//: - GUI と TUI が共有する view description を enum として表します。
//:
//: [現状/げんじょう]:
//: - 最初の checkpoint では leaf node だけを持ちます。container、layout、accessibility は後続 checkpoint で追加します。
pub enum ViewNode:
    Empty
    Label %str
    Button %ButtonConfig

impl Clone for ViewNode:
    fn clone %fn &ViewNode ViewNode \node:
        *node

impl Copy for ViewNode:
    fn copy_mark %fn ViewNode ViewNode \node:
        node

//: empty_view: 空 view node を返す
pub fn empty_view %fn void ViewNode \void:
    ViewNode::Empty

//: label: text label view node を返す
pub fn label %fn str ViewNode \text:
    ViewNode::Label text

//: button: ButtonConfig から button view node を返す
pub fn button %fn ButtonConfig ViewNode \config:
    ViewNode::Button config

//: RequestRedrawEffect: redraw request の payload
pub struct RequestRedrawEffect:
    target %i32

impl Clone for RequestRedrawEffect:
    fn clone %fn &RequestRedrawEffect RequestRedrawEffect \effect:
        *effect

impl Copy for RequestRedrawEffect:
    fn copy_mark %fn RequestRedrawEffect RequestRedrawEffect \effect:
        effect

//: SetTitleEffect: title 変更 request の payload
pub struct SetTitleEffect:
    target %i32
    title %str

impl Clone for SetTitleEffect:
    fn clone %fn &SetTitleEffect SetTitleEffect \effect:
        *effect

impl Copy for SetTitleEffect:
    fn copy_mark %fn SetTitleEffect SetTitleEffect \effect:
        effect

//: PresentSurfaceEffect: pixel surface present request の payload
//:
//: [目的/もくてき]:
//: - application が platform host を直接呼ばず、pixel frame の present request を data として返せるようにします。
//:
//: [契約/けいやく]:
//: - `surface` と `frame` は platform handle ではなく、runtime が checked constructor に渡す request id です。
//: - geometry、stride、format は `std/gui/runtime` が checked `GuiSurfacePresentCommand` へ変換するときに検査します。
//: - この型は `std/gui/surface` の型を持ちません。`alloc/gui` から `std/gui` へ依存しないためです。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub struct PresentSurfaceEffect:
    surface %i32
    frame %i32
    width %i32
    height %i32
    stride_bytes %i32
    format %ColorFormat
    dirty %DirtyRegion

impl Clone for PresentSurfaceEffect:
    fn clone %fn &PresentSurfaceEffect PresentSurfaceEffect \effect:
        *effect

impl Copy for PresentSurfaceEffect:
    fn copy_mark %fn PresentSurfaceEffect PresentSurfaceEffect \effect:
        effect

//: GuiEffect: runtime が解釈する host effect request
//:
//: [目的/もくてき]:
//: - `update` が window や clipboard を直接操作せず、要求値を返せるようにします。
//:
pub enum GuiEffect:
    None
    RequestRedraw %RequestRedrawEffect
    SetTitle %SetTitleEffect
    PresentSurface %PresentSurfaceEffect

impl Clone for GuiEffect:
    fn clone %fn &GuiEffect GuiEffect \effect:
        *effect

impl Copy for GuiEffect:
    fn copy_mark %fn GuiEffect GuiEffect \effect:
        effect

//: GuiEffectBatch: update が返す effect 群
//:
//: [目的/もくてき]:
//: - redraw と title 変更のような複数 effect を、host API を直接呼ばず data としてまとめます。
//:
//: [現状/げんじょう]:
//: - 初期 checkpoint では capacity 2 の bounded batch です。capacity を[超/こ]える追加は `GuiError::ResourceExhausted` を[返/かえ]します。
pub struct GuiEffectBatch:
    first %GuiEffect
    second %GuiEffect
    count %i32

impl Clone for GuiEffectBatch:
    fn clone %fn &GuiEffectBatch GuiEffectBatch \batch:
        *batch

impl Copy for GuiEffectBatch:
    fn copy_mark %fn GuiEffectBatch GuiEffectBatch \batch:
        batch

//: gui_effect_none: effect なしを返す
pub fn gui_effect_none %fn void GuiEffect \void:
    GuiEffect::None

//: request_redraw: redraw request effect を作る
pub fn request_redraw %fn i32 GuiEffect \target:
    GuiEffect::RequestRedraw RequestRedrawEffect target

//: set_title: title request effect を作る
pub fn set_title %fn i32 fn str GuiEffect \target\title:
    GuiEffect::SetTitle SetTitleEffect target title

//: present_surface: pixel surface present request effect を[作/つく]る
//:
//: [目的/もくてき]:
//: - app-facing layer では platform host や Web stdout helper を呼ばず、present request を data として返します。
//:
//: [契約/けいやく]:
//: - raw id と buffer shape の検査は `std/gui/runtime` の責務です。
//: - 不正値は runtime 解釈時に `GuiError` として返ります。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface %fn i32 fn i32 fn i32 fn i32 fn i32 fn ColorFormat fn DirtyRegion GuiEffect \surface\frame\width\height\stride_bytes\format\dirty:
    GuiEffect::PresentSurface PresentSurfaceEffect surface frame width height stride_bytes format dirty

//: present_surface_effect_surface: present request の surface request id を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_surface %fn &PresentSurfaceEffect i32 \effect:
    *field::get_ref effect "surface"

//: present_surface_effect_frame: present request の frame request id を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_frame %fn &PresentSurfaceEffect i32 \effect:
    *field::get_ref effect "frame"

//: present_surface_effect_width: present request の width を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_width %fn &PresentSurfaceEffect i32 \effect:
    *field::get_ref effect "width"

//: present_surface_effect_height: present request の height を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_height %fn &PresentSurfaceEffect i32 \effect:
    *field::get_ref effect "height"

//: present_surface_effect_stride_bytes: present request の stride bytes を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_stride_bytes %fn &PresentSurfaceEffect i32 \effect:
    *field::get_ref effect "stride_bytes"

//: present_surface_effect_format: present request の color format を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_format %fn &PresentSurfaceEffect ColorFormat \effect:
    *field::get_ref effect "format"

//: present_surface_effect_dirty: present request の dirty region を[読/よ]む
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/app/types" as *
//: ```
pub fn present_surface_effect_dirty %fn &PresentSurfaceEffect DirtyRegion \effect:
    *field::get_ref effect "dirty"

//: gui_effect_batch_empty: 空 effect batch を[作/つく]る
pub fn gui_effect_batch_empty %fn void GuiEffectBatch \void:
    GuiEffectBatch GuiEffect::None GuiEffect::None 0

//: gui_effect_batch_one: effect 1 個の batch を[作/つく]る
pub fn gui_effect_batch_one %fn GuiEffect GuiEffectBatch \effect:
    match effect:
        GuiEffect::None:
            gui_effect_batch_empty
        _:
            GuiEffectBatch effect GuiEffect::None 1

//: gui_effect_batch_count: batch 内の effect 数を[読/よ]む
pub fn gui_effect_batch_count %fn &GuiEffectBatch i32 \batch:
    *field::get_ref batch "count"

//: gui_effect_batch_first: 1 個目の effect を Option で[読/よ]む
pub fn gui_effect_batch_first %fn &GuiEffectBatch Option GuiEffect \batch:
    let count %i32 gui_effect_batch_count batch
    if eq count 0:
        then none
        else:
            let first %GuiEffect *field::get_ref batch "first"
            some first

//: gui_effect_batch_second: 2 個目の effect を Option で[読/よ]む
pub fn gui_effect_batch_second %fn &GuiEffectBatch Option GuiEffect \batch:
    let count %i32 gui_effect_batch_count batch
    if lt count 2:
        then none
        else:
            let second %GuiEffect *field::get_ref batch "second"
            some second

//: gui_effect_batch_push: bounded batch に effect を[追加/ついか]する
pub fn gui_effect_batch_push %fn GuiEffectBatch fn GuiEffect Result GuiEffectBatch GuiError \batch\effect:
    match effect:
        GuiEffect::None:
            Result::Ok batch
        _:
            let count %i32 gui_effect_batch_count &batch
            if eq count 0:
                then Result::Ok GuiEffectBatch effect GuiEffect::None 1
                else:
                    if eq count 1:
                        then:
                            let first %GuiEffect *field::get_ref &batch "first"
                            Result::Ok GuiEffectBatch first effect 2
                        else Result::Err GuiError::ResourceExhausted

//: Update: application update result
//:
//: [目的/もくてき]:
//: - 新しい model と、runtime が実行する effect request 群をまとめます。
//:
//: [注意/ちゅうい]:
//: - `.Model` は application が所有します。stdlib は model の field や lifecycle を解釈しません。
pub struct Update<.Model>:
    model %.Model
    effects %GuiEffectBatch

//: update_result: model と effect から Update を作る
pub fn update_result <.Model> %fn .Model fn GuiEffect Update .Model \model\effect:
    let effects %GuiEffectBatch gui_effect_batch_one effect
    Update model effects

//: update_result_batch: model と effect batch から Update を[作/つく]る
pub fn update_result_batch <.Model> %fn .Model fn GuiEffectBatch Update .Model \model\effects:
    Update model effects

//: update_model: Update から model を取り出す
pub fn update_model <.Model> %fn Update .Model .Model \update:
    field::get update "model"

//: update_effects: Update から effect batch を[取/と]り[出/だ]す
pub fn update_effects <.Model> %fn Update .Model GuiEffectBatch \update:
    field::get update "effects"

//: update_effect: Update から最初の effect を取り出す
//:
//: [注意/ちゅうい]:
//: - 互換 helper です。複数 effect を解釈する runtime は `update_effects` を使います。
pub fn update_effect <.Model> %fn Update .Model GuiEffect \update:
    let effects %GuiEffectBatch update_effects update
    match gui_effect_batch_first &effects:
        Option::Some effect:
            effect
        Option::None:
            GuiEffect::None
