        Result::Err kind:
            Result::Err kind
        Result::Ok _:
            match gui_rgba8888_row_tile_rle_packet_validate_cursor_completion encoded:
                Result::Err kind:
                    Result::Err kind
                Result::Ok _:
                    match gui_rgba8888_row_tile_rle_encoded_tile_descriptor_checked encoded:
                        Result::Err payload_kind:
                            Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PayloadDescriptorInvalid payload_kind
                        Result::Ok tile_descriptor:
                            match gui_rgba8888_row_tile_rle_packet_validate_descriptor_byte_count encoded &tile_descriptor:
                                Result::Err kind:
                                    Result::Err kind
                                Result::Ok _:
                                    match gui_rgba8888_row_tile_rle_encoded_tile_plan_metadata_checked encoded:
                                        Result::Err payload_kind:
                                            Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PayloadDescriptorInvalid payload_kind
                                        Result::Ok plan:
                                            match gui_rgba8888_row_tile_rle_packet_validate_plan_shape &plan &tile_descriptor:
                                                Result::Err kind:
                                                    Result::Err kind
                                                Result::Ok _:
                                                    match gui_rgba8888_row_tile_rle_packet_validate_tile_metadata &plan &tile_descriptor:
                                                        Result::Err kind:
                                                            Result::Err kind
                                                        Result::Ok _:
                                                            Result::Ok gui_rgba8888_row_tile_rle_packet_descriptor_from_metadata encoded &plan &tile_descriptor

