    let pixel_count %i32 gui_rgba8888_row_tile_rle_encoded_cursor_pixel_count encoded
    let total_run_count %i32 gui_rgba8888_row_tile_rle_encoded_total_run_count encoded
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_encoded_byte_count encoded
    gui_rgba8888_row_tile_rle_packet_descriptor_new frame_id batch_index tile_index plan_row_start plan_row_count row_start row_count width height stride_bytes tile_rows tile_count pixel_count total_run_count encoded_byte_count

fn gui_rgba8888_row_tile_rle_packet_validate %fn &GuiRgba8888RowTileRleEncodedOwner Result GuiRgba8888RowTileRlePacketDescriptor GuiRgba8888RowTileRlePacketPrepareErrorKind \encoded:
