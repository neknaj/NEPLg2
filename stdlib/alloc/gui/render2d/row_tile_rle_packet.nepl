    GuiRgba8888RowTileRlePacketOwner encoded descriptor

fn gui_rgba8888_row_tile_rle_packet_prepare_error_category %fn GuiRgba8888RowTileRlePacketPrepareErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowTileRlePacketPrepareErrorKind::EncodedByteCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::TotalRunCountInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowTileRlePacketPrepareErrorKind::EncodedByteCountOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::PixelByteCountOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::StrideOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::TileByteCountOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::RowExtentOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRlePacketPrepareErrorKind::TileCountOverflow:
            Option::Some GuiError::InvalidGeometry
        _:
            Option::Some GuiError::InvalidCommand

fn gui_rgba8888_row_tile_rle_packet_prepare_error %fn GuiRgba8888RowTileRlePacketPrepareErrorKind fn GuiRgba8888RowTileRleEncodedOwner GuiRgba8888RowTileRlePacketPrepareError \kind\encoded:
    let category %Option GuiError gui_rgba8888_row_tile_rle_packet_prepare_error_category kind
    GuiRgba8888RowTileRlePacketPrepareError kind category encoded

fn gui_rgba8888_row_tile_rle_packet_checked_mul %fn i32 fn i32 fn GuiRgba8888RowTileRlePacketPrepareErrorKind Result i32 GuiRgba8888RowTileRlePacketPrepareErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

fn gui_rgba8888_row_tile_rle_packet_checked_add %fn i32 fn i32 fn GuiRgba8888RowTileRlePacketPrepareErrorKind Result i32 GuiRgba8888RowTileRlePacketPrepareErrorKind \base\delta\overflow_kind:
    if or lt base 0 lt delta 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 2147483647
            let max_base %i32 sub max_i32 delta
            if gt base max_base:
                then Result::Err overflow_kind
                else Result::Ok add base delta

fn gui_rgba8888_row_tile_rle_packet_tile_count_checked %fn i32 fn i32 Result i32 GuiRgba8888RowTileRlePacketPrepareErrorKind \row_count\tile_rows:
    if le row_count 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PlanRowCountInvalid
        else:
            if le tile_rows 0:
                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileRowsInvalid
                else:
                    let quotient %i32 div_s row_count tile_rows
                    let remainder %i32 rem_s row_count tile_rows
                    let tile_count %i32 if eq remainder 0 quotient add quotient 1
                    if le tile_count 0:
                        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileCountOverflow
                        else Result::Ok tile_count

fn gui_rgba8888_row_tile_rle_packet_validate_encoded_counts %fn &GuiRgba8888RowTileRleEncodedOwner Result unit GuiRgba8888RowTileRlePacketPrepareErrorKind \encoded:
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_encoded_byte_count encoded
    if le encoded_byte_count 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::EncodedByteCountInvalid
        else:
            let total_run_count %i32 gui_rgba8888_row_tile_rle_encoded_total_run_count encoded
            if le total_run_count 0:
                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TotalRunCountInvalid
                else:
                    match gui_rgba8888_row_tile_rle_packet_checked_mul total_run_count 12 GuiRgba8888RowTileRlePacketPrepareErrorKind::EncodedByteCountOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok expected_byte_count:
                            if ne expected_byte_count encoded_byte_count:
                                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::EncodedByteCountMismatch
                                else Result::Ok unit

fn gui_rgba8888_row_tile_rle_packet_validate_cursor_completion %fn &GuiRgba8888RowTileRleEncodedOwner Result unit GuiRgba8888RowTileRlePacketPrepareErrorKind \encoded:
    let pixel_count %i32 gui_rgba8888_row_tile_rle_encoded_cursor_pixel_count encoded
    if le pixel_count 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::CursorPixelCountInvalid
        else:
            let next_pixel_index %i32 gui_rgba8888_row_tile_rle_encoded_cursor_next_pixel_index encoded
            if ne next_pixel_index pixel_count:
                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::CursorNextPixelIndexMismatch
                else Result::Ok unit

fn gui_rgba8888_row_tile_rle_packet_validate_descriptor_byte_count %fn &GuiRgba8888RowTileRleEncodedOwner fn &GuiRgba8888RowTileDescriptor Result unit GuiRgba8888RowTileRlePacketPrepareErrorKind \encoded\descriptor:
    let row_count %i32 gui_rgba8888_row_tile_descriptor_row_count descriptor
    if le row_count 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::DescriptorRowCountInvalid
        else:
            let byte_count %i32 gui_rgba8888_row_tile_descriptor_byte_count descriptor
            if le byte_count 0:
                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::DescriptorByteCountInvalid
                else:
                    let pixel_count %i32 gui_rgba8888_row_tile_rle_encoded_cursor_pixel_count encoded
                    match gui_rgba8888_row_tile_rle_packet_checked_mul pixel_count 4 GuiRgba8888RowTileRlePacketPrepareErrorKind::PixelByteCountOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok expected_byte_count:
                            if ne expected_byte_count byte_count:
                                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PixelByteCountMismatch
                                else Result::Ok unit

fn gui_rgba8888_row_tile_rle_packet_validate_plan_shape %fn &GuiRgba8888RowTilePlan fn &GuiRgba8888RowTileDescriptor Result unit GuiRgba8888RowTileRlePacketPrepareErrorKind \plan\descriptor:
    let width %i32 gui_rgba8888_row_tile_plan_width plan
    if le width 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PlanWidthInvalid
        else:
            let height %i32 gui_rgba8888_row_tile_plan_height plan
            if le height 0:
                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::PlanHeightInvalid
                else:
                    match gui_rgba8888_row_tile_rle_packet_checked_mul width 4 GuiRgba8888RowTileRlePacketPrepareErrorKind::StrideOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok expected_stride:
                            let stride_bytes %i32 gui_rgba8888_row_tile_plan_stride_bytes plan
                            if ne expected_stride stride_bytes:
                                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::StrideMismatch
                                else:
                                    let row_count %i32 gui_rgba8888_row_tile_descriptor_row_count descriptor
                                    let descriptor_byte_count %i32 gui_rgba8888_row_tile_descriptor_byte_count descriptor
                                    match gui_rgba8888_row_tile_rle_packet_checked_mul row_count stride_bytes GuiRgba8888RowTileRlePacketPrepareErrorKind::TileByteCountOverflow:
                                        Result::Err kind:
                                            Result::Err kind
                                        Result::Ok expected_tile_byte_count:
                                            if ne expected_tile_byte_count descriptor_byte_count:
                                                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileByteCountMismatch
                                                else:
                                                    let row_start %i32 gui_rgba8888_row_tile_descriptor_row_start descriptor
                                                    if lt row_start 0:
                                                        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::DescriptorRowStartInvalid
                                                        else:
                                                            match gui_rgba8888_row_tile_rle_packet_checked_add row_start row_count GuiRgba8888RowTileRlePacketPrepareErrorKind::RowExtentOverflow:
                                                                Result::Err kind:
                                                                    Result::Err kind
                                                                Result::Ok row_bottom:
                                                                    if gt row_bottom height:
                                                                        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::RowExtentOutOfBounds
                                                                        else Result::Ok unit

fn gui_rgba8888_row_tile_rle_packet_validate_tile_metadata %fn &GuiRgba8888RowTilePlan fn &GuiRgba8888RowTileDescriptor Result unit GuiRgba8888RowTileRlePacketPrepareErrorKind \plan\descriptor:
    let tile_index %i32 gui_rgba8888_row_tile_descriptor_tile_index descriptor
    if lt tile_index 0:
        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileIndexNegative
        else:
            let plan_row_count %i32 gui_rgba8888_row_tile_plan_row_count plan
            let tile_rows %i32 gui_rgba8888_row_tile_plan_tile_rows plan
            match gui_rgba8888_row_tile_rle_packet_tile_count_checked plan_row_count tile_rows:
                Result::Err kind:
                    Result::Err kind
                Result::Ok expected_tile_count:
                    let actual_tile_count %i32 gui_rgba8888_row_tile_plan_tile_count plan
                    if ne expected_tile_count actual_tile_count:
                        then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileCountMismatch
                        else:
                            if ge tile_index actual_tile_count:
                                then Result::Err GuiRgba8888RowTileRlePacketPrepareErrorKind::TileIndexOutOfBounds
                                else Result::Ok unit

fn gui_rgba8888_row_tile_rle_packet_descriptor_from_metadata %fn &GuiRgba8888RowTileRleEncodedOwner fn &GuiRgba8888RowTilePlan fn &GuiRgba8888RowTileDescriptor GuiRgba8888RowTileRlePacketDescriptor \encoded\plan\tile_descriptor:
