    PixelByteCountOverflow
    PixelByteCountMismatch
    PlanWidthInvalid
    PlanHeightInvalid
    StrideOverflow
    StrideMismatch
    TileByteCountOverflow
    TileByteCountMismatch
    RowExtentOverflow
    RowExtentOutOfBounds
    TileIndexNegative
    TileIndexOutOfBounds
    PlanRowCountInvalid
    TileRowsInvalid
    TileCountOverflow
    TileCountMismatch

impl Clone for GuiRgba8888RowTileRlePacketPrepareErrorKind:
    fn clone %fn &GuiRgba8888RowTileRlePacketPrepareErrorKind GuiRgba8888RowTileRlePacketPrepareErrorKind \kind:
