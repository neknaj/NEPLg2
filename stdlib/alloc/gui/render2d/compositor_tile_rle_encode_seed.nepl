pub fn gui_rgba8888_compositor_tile_rle_encode_seed_owner_free %fn GuiRgba8888CompositorTileRleEncodeSeedOwner Result unit GuiRgba8888CompositorTilePayloadFreeErrorKind \owner:
    let payload %GuiRgba8888CompositorTilePayloadOwner gui_rgba8888_compositor_tile_rle_encode_seed_owner_finish_payload owner
    gui_rgba8888_compositor_tile_payload_owner_free payload

//: gui_rgba8888_compositor_tile_rle_encode_seed_error_free: seed error の completed owner を[破棄/はき]する
//:
//: error から completed owner を[取/と]り[出/だ]し、F5mh completed owner free に[委譲/いじょう]します。
