pub fn gui_rgba8888_compositor_tile_rle_encode_seed_error_finish_entry %fn GuiRgba8888CompositorTileRleEncodeSeedError Result GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorTileRleCountFinishError \error:
    let completed %GuiRgba8888CompositorTileRleCountCompletedOwner gui_rgba8888_compositor_tile_rle_encode_seed_error_finish_completed_owner error
    gui_rgba8888_compositor_tile_rle_count_completed_owner_finish_entry completed

//: gui_rgba8888_compositor_tile_rle_encode_seed_owner_free: seed owner を[閉/と]じて payload owner まで[破棄/はき]する
//:
//: F5me payload owner free に[戻/もど]してから[委譲/いじょう]します。
