#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

pub enum GuiRgba8888RowTileRleWriterPlanErrorKind:
    TotalRunCountInvalid
    EncodedByteCountOverflow

impl Clone for GuiRgba8888RowTileRleWriterPlanErrorKind:
    fn clone %fn &GuiRgba8888RowTileRleWriterPlanErrorKind GuiRgba8888RowTileRleWriterPlanErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRleWriterPlanErrorKind:
    fn copy_mark %fn GuiRgba8888RowTileRleWriterPlanErrorKind GuiRgba8888RowTileRleWriterPlanErrorKind \kind:
        kind

pub struct GuiRgba8888RowTileRleWriterPlanOwner:
    cursor %GuiRgba8888RowTileRleCursorOwner
    total_run_count %i32
    encoded_byte_count %i32

pub struct GuiRgba8888RowTileRleWriterPlanError:
    kind %GuiRgba8888RowTileRleWriterPlanErrorKind
    category %Option GuiError
    ready %GuiRgba8888RowTileRleEncodeCursorOwner
    total_run_count %i32

fn gui_rgba8888_row_tile_rle_writer_plan_owner_new %fn GuiRgba8888RowTileRleCursorOwner fn i32 fn i32 GuiRgba8888RowTileRleWriterPlanOwner \cursor\total_run_count\encoded_byte_count:
    GuiRgba8888RowTileRleWriterPlanOwner cursor total_run_count encoded_byte_count

fn gui_rgba8888_row_tile_rle_writer_plan_error_category %fn GuiRgba8888RowTileRleWriterPlanErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowTileRleWriterPlanErrorKind::TotalRunCountInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowTileRleWriterPlanErrorKind::EncodedByteCountOverflow:
            Option::Some GuiError::InvalidGeometry

fn gui_rgba8888_row_tile_rle_writer_plan_error %fn GuiRgba8888RowTileRleWriterPlanErrorKind fn GuiRgba8888RowTileRleEncodeCursorOwner fn i32 GuiRgba8888RowTileRleWriterPlanError \kind\ready\total_run_count:
    let category %Option GuiError gui_rgba8888_row_tile_rle_writer_plan_error_category kind
    GuiRgba8888RowTileRleWriterPlanError kind category ready total_run_count

fn gui_rgba8888_row_tile_rle_writer_plan_checked_mul_nonnegative %fn i32 fn i32 fn GuiRgba8888RowTileRleWriterPlanErrorKind Result i32 GuiRgba8888RowTileRleWriterPlanErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_total_run_count %fn &GuiRgba8888RowTileRleWriterPlanOwner i32 \owner:
    *field::get_ref owner "total_run_count"

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_encoded_byte_count %fn &GuiRgba8888RowTileRleWriterPlanOwner i32 \owner:
    *field::get_ref owner "encoded_byte_count"

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_cursor_next_pixel_index %fn &GuiRgba8888RowTileRleWriterPlanOwner i32 \owner:
    let cursor %&GuiRgba8888RowTileRleCursorOwner field::get_ref owner "cursor"
    gui_rgba8888_row_tile_rle_cursor_next_pixel_index cursor

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_cursor_pixel_count %fn &GuiRgba8888RowTileRleWriterPlanOwner i32 \owner:
    let cursor %&GuiRgba8888RowTileRleCursorOwner field::get_ref owner "cursor"
    gui_rgba8888_row_tile_rle_cursor_pixel_count cursor

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_finish_cursor %fn GuiRgba8888RowTileRleWriterPlanOwner GuiRgba8888RowTileRleCursorOwner \owner:
    field::get owner "cursor"

