pub fn gui_rgba8888_row_tile_rle_writer_plan_error_total_run_count %fn &GuiRgba8888RowTileRleWriterPlanError i32 \error:
    *field::get_ref error "total_run_count"

pub fn gui_rgba8888_row_tile_rle_writer_plan_error_cursor_next_pixel_index %fn &GuiRgba8888RowTileRleWriterPlanError i32 \error:
    let ready %&GuiRgba8888RowTileRleEncodeCursorOwner field::get_ref error "ready"
    gui_rgba8888_row_tile_rle_encode_cursor_owner_cursor_next_pixel_index ready

pub fn gui_rgba8888_row_tile_rle_writer_plan_error_cursor_pixel_count %fn &GuiRgba8888RowTileRleWriterPlanError i32 \error:
    let ready %&GuiRgba8888RowTileRleEncodeCursorOwner field::get_ref error "ready"
    gui_rgba8888_row_tile_rle_encode_cursor_owner_cursor_pixel_count ready

pub fn gui_rgba8888_row_tile_rle_writer_plan_error_finish_ready_owner %fn GuiRgba8888RowTileRleWriterPlanError GuiRgba8888RowTileRleEncodeCursorOwner \error:
    field::get error "ready"

//: gui_rgba8888_row_tile_rle_writer_plan_prepare: ready cursor から encoded byte capacity を[作/つく]る
//:
//: [契約/けいやく]:
//: - transport capacity boundary として total run count を[再検査/さいけんさ]し、forged owner を fail-closed にします。
//: - encoded byte count は 1 run 12 bytes として checked multiplication で[計算/けいさん]します。
//: - 成功時だけ ready cursor owner を[閉/と]じ、cursor owner を writer plan owner へ[渡/わた]します。
pub fn gui_rgba8888_row_tile_rle_writer_plan_prepare %fn GuiRgba8888RowTileRleEncodeCursorOwner Result GuiRgba8888RowTileRleWriterPlanOwner GuiRgba8888RowTileRleWriterPlanError \ready:
    let total_run_count %i32 gui_rgba8888_row_tile_rle_encode_cursor_owner_total_run_count &ready
    if le total_run_count 0:
        then Result::Err gui_rgba8888_row_tile_rle_writer_plan_error GuiRgba8888RowTileRleWriterPlanErrorKind::TotalRunCountInvalid ready total_run_count
        else:
            match gui_rgba8888_row_tile_rle_writer_plan_checked_mul_nonnegative total_run_count 12 GuiRgba8888RowTileRleWriterPlanErrorKind::EncodedByteCountOverflow:
                Result::Err kind:
                    Result::Err gui_rgba8888_row_tile_rle_writer_plan_error kind ready total_run_count
                Result::Ok encoded_byte_count:
                    let cursor %GuiRgba8888RowTileRleCursorOwner gui_rgba8888_row_tile_rle_encode_cursor_owner_finish_cursor ready
                    Result::Ok gui_rgba8888_row_tile_rle_writer_plan_owner_new cursor total_run_count encoded_byte_count

pub fn gui_rgba8888_row_tile_rle_writer_plan_owner_free %fn GuiRgba8888RowTileRleWriterPlanOwner Result unit GuiRgba8888RowByteStorageFinishErrorKind \owner:
    let cursor %GuiRgba8888RowTileRleCursorOwner gui_rgba8888_row_tile_rle_writer_plan_owner_finish_cursor owner
    gui_rgba8888_row_tile_rle_cursor_free cursor

pub fn gui_rgba8888_row_tile_rle_writer_plan_error_free %fn GuiRgba8888RowTileRleWriterPlanError Result unit GuiRgba8888RowByteStorageFinishErrorKind \error:
    let ready %GuiRgba8888RowTileRleEncodeCursorOwner gui_rgba8888_row_tile_rle_writer_plan_error_finish_ready_owner error
    gui_rgba8888_row_tile_rle_encode_cursor_owner_free ready
