pub enum GuiRgba8888RowTileRleStoragePrepareErrorKind:
    EncodedByteCountInvalid
    TotalRunCountInvalid
    EncodedByteCountOverflow
    EncodedByteCountMismatch
    AllocationFailed

impl Clone for GuiRgba8888RowTileRleStoragePrepareErrorKind:
    fn clone %fn &GuiRgba8888RowTileRleStoragePrepareErrorKind GuiRgba8888RowTileRleStoragePrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRleStoragePrepareErrorKind:
    fn copy_mark %fn GuiRgba8888RowTileRleStoragePrepareErrorKind GuiRgba8888RowTileRleStoragePrepareErrorKind \kind:
        kind

pub enum GuiRgba8888RowTileRleStorageFinishErrorKind:
    StorageDeallocFailed
    CursorFreeFailed %GuiRgba8888RowByteStorageFinishErrorKind

impl Clone for GuiRgba8888RowTileRleStorageFinishErrorKind:
    fn clone %fn &GuiRgba8888RowTileRleStorageFinishErrorKind GuiRgba8888RowTileRleStorageFinishErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRleStorageFinishErrorKind:
    fn copy_mark %fn GuiRgba8888RowTileRleStorageFinishErrorKind GuiRgba8888RowTileRleStorageFinishErrorKind \kind:
        kind

pub struct GuiRgba8888RowTileRleStorageOwner:
    cursor %GuiRgba8888RowTileRleCursorOwner
    total_run_count %i32
    encoded_byte_count %i32
    storage %RegionToken u8

pub struct GuiRgba8888RowTileRleStoragePrepareError:
    kind %GuiRgba8888RowTileRleStoragePrepareErrorKind
    category %Option GuiError
    plan %GuiRgba8888RowTileRleWriterPlanOwner

pub struct GuiRgba8888RowTileRleStorageFinishError:
    kind %GuiRgba8888RowTileRleStorageFinishErrorKind
    cursor %GuiRgba8888RowTileRleCursorOwner

fn gui_rgba8888_row_tile_rle_storage_owner_new %fn GuiRgba8888RowTileRleCursorOwner fn i32 fn i32 fn RegionToken u8 GuiRgba8888RowTileRleStorageOwner \cursor\total_run_count\encoded_byte_count\storage:
    GuiRgba8888RowTileRleStorageOwner cursor total_run_count encoded_byte_count storage

fn gui_rgba8888_row_tile_rle_storage_prepare_error_category %fn GuiRgba8888RowTileRleStoragePrepareErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRleStoragePrepareErrorKind::TotalRunCountInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowTileRleStoragePrepareErrorKind::AllocationFailed:
            Option::Some GuiError::ResourceExhausted

fn gui_rgba8888_row_tile_rle_storage_prepare_error %fn GuiRgba8888RowTileRleStoragePrepareErrorKind fn GuiRgba8888RowTileRleWriterPlanOwner GuiRgba8888RowTileRleStoragePrepareError \kind\plan:
    let category %Option GuiError gui_rgba8888_row_tile_rle_storage_prepare_error_category kind
    GuiRgba8888RowTileRleStoragePrepareError kind category plan

fn gui_rgba8888_row_tile_rle_storage_finish_error %fn GuiRgba8888RowTileRleStorageFinishErrorKind fn GuiRgba8888RowTileRleCursorOwner GuiRgba8888RowTileRleStorageFinishError \kind\cursor:
    GuiRgba8888RowTileRleStorageFinishError kind cursor

fn gui_rgba8888_row_tile_rle_storage_checked_mul_nonnegative %fn i32 fn i32 fn GuiRgba8888RowTileRleStoragePrepareErrorKind Result i32 GuiRgba8888RowTileRleStoragePrepareErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

