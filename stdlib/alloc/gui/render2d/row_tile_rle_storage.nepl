    field::get error "plan"

//: gui_rgba8888_row_tile_rle_storage_prepare: writer plan から exact encoded byte storage を[確保/かくほ]する
//:
//: [契約/けいやく]:
//: - encoded byte count、total run count、recomputed byte count の[順/じゅん]で capacity evidence を[再検査/さいけんさ]します。
//: - allocation [失敗/しっぱい]を[含/ふく]む失敗 path は writer plan owner を[消費/しょうひ]せず、owner-bearing error で[返/かえ]します。
//: - allocation [成功/せいこう]後にだけ writer plan owner を[閉/と]じ、cursor owner と storage を storage owner に[移/うつ]します。
pub fn gui_rgba8888_row_tile_rle_storage_prepare %fn GuiRgba8888RowTileRleWriterPlanOwner Result GuiRgba8888RowTileRleStorageOwner GuiRgba8888RowTileRleStoragePrepareError \plan:
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_writer_plan_owner_encoded_byte_count &plan
    if le encoded_byte_count 0:
        then Result::Err gui_rgba8888_row_tile_rle_storage_prepare_error GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountInvalid plan
        else:
            let total_run_count %i32 gui_rgba8888_row_tile_rle_writer_plan_owner_total_run_count &plan
            if le total_run_count 0:
                then Result::Err gui_rgba8888_row_tile_rle_storage_prepare_error GuiRgba8888RowTileRleStoragePrepareErrorKind::TotalRunCountInvalid plan
                else:
                    match gui_rgba8888_row_tile_rle_storage_checked_mul_nonnegative total_run_count 12 GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountOverflow:
                        Result::Err kind:
                            Result::Err gui_rgba8888_row_tile_rle_storage_prepare_error kind plan
                        Result::Ok recomputed_byte_count:
                            if ne recomputed_byte_count encoded_byte_count:
                                then Result::Err gui_rgba8888_row_tile_rle_storage_prepare_error GuiRgba8888RowTileRleStoragePrepareErrorKind::EncodedByteCountMismatch plan
                                else:
                                    match alloc_region_bytes<u8> encoded_byte_count:
                                        Result::Err _:
                                            Result::Err gui_rgba8888_row_tile_rle_storage_prepare_error GuiRgba8888RowTileRleStoragePrepareErrorKind::AllocationFailed plan
                                        Result::Ok storage:
                                            let cursor %GuiRgba8888RowTileRleCursorOwner gui_rgba8888_row_tile_rle_writer_plan_owner_finish_cursor plan
                                            Result::Ok gui_rgba8888_row_tile_rle_storage_owner_new cursor total_run_count encoded_byte_count storage

pub fn gui_rgba8888_row_tile_rle_storage_prepare_error_free %fn GuiRgba8888RowTileRleStoragePrepareError Result unit GuiRgba8888RowByteStorageFinishErrorKind \error:
    let plan %GuiRgba8888RowTileRleWriterPlanOwner gui_rgba8888_row_tile_rle_storage_prepare_error_finish_plan error
    gui_rgba8888_row_tile_rle_writer_plan_owner_free plan

pub fn gui_rgba8888_row_tile_rle_storage_finish_error_kind %fn &GuiRgba8888RowTileRleStorageFinishError GuiRgba8888RowTileRleStorageFinishErrorKind \error:
    *field::get_ref error "kind"

pub fn gui_rgba8888_row_tile_rle_storage_finish_error_cursor %fn GuiRgba8888RowTileRleStorageFinishError GuiRgba8888RowTileRleCursorOwner \error:
    field::get error "cursor"

//: gui_rgba8888_row_tile_rle_storage_finish_cursor: encoded storage を[破棄/はき]して continuation cursor を[返/かえ]す
pub fn gui_rgba8888_row_tile_rle_storage_finish_cursor %fn GuiRgba8888RowTileRleStorageOwner Result GuiRgba8888RowTileRleCursorOwner GuiRgba8888RowTileRleStorageFinishError \owner:
    let cursor %GuiRgba8888RowTileRleCursorOwner field::get owner "cursor"
    let storage %RegionToken u8 field::get owner "storage"
    match dealloc_region<u8> storage:
        Result::Err _:
            Result::Err gui_rgba8888_row_tile_rle_storage_finish_error GuiRgba8888RowTileRleStorageFinishErrorKind::StorageDeallocFailed cursor
        Result::Ok _:
            Result::Ok cursor

pub fn gui_rgba8888_row_tile_rle_storage_owner_free %fn GuiRgba8888RowTileRleStorageOwner Result unit GuiRgba8888RowTileRleStorageFinishErrorKind \owner:
    match gui_rgba8888_row_tile_rle_storage_finish_cursor owner:
        Result::Err error:
            let kind %GuiRgba8888RowTileRleStorageFinishErrorKind gui_rgba8888_row_tile_rle_storage_finish_error_kind &error
            let cursor %GuiRgba8888RowTileRleCursorOwner gui_rgba8888_row_tile_rle_storage_finish_error_cursor error
            match gui_rgba8888_row_tile_rle_cursor_free cursor:
                Result::Err _:
                    Result::Err kind
                Result::Ok _:
                    Result::Err kind
        Result::Ok cursor:
            match gui_rgba8888_row_tile_rle_cursor_free cursor:
                Result::Err kind:
                    Result::Err GuiRgba8888RowTileRleStorageFinishErrorKind::CursorFreeFailed kind
                Result::Ok _:
                    Result::Ok unit
