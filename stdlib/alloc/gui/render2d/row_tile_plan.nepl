pub fn gui_rgba8888_row_tile_plan_prepare %fn GuiRgba8888RowByteStorageOwner fn GuiRgba8888RowTilePlanConfig Result GuiRgba8888RowTilePlanOwner GuiRgba8888RowTilePlanPrepareError \storage\config:
