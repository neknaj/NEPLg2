        then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::FrameIdMismatch
        else:
            if ne gui_rgba8888_row_tile_plan_batch_index plan gui_rgba8888_row_batch_range_batch_index range:
                then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::BatchIndexMismatch
                else:
                    if ne gui_rgba8888_row_tile_plan_row_start plan gui_rgba8888_row_batch_range_row_start range:
                        then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::RowStartMismatch
                        else:
