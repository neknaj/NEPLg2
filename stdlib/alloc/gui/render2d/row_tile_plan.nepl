                                                else:
                                                    if ne gui_rgba8888_row_tile_plan_stride_bytes plan gui_rgba8888_row_batch_range_stride_bytes range:
                                                        then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::StrideMismatch
                                                        else:
                                                            if ne gui_rgba8888_row_tile_plan_byte_count plan gui_rgba8888_row_batch_range_byte_count range:
                                                                then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::ByteCountMismatch
                                                                else Result::Ok unit

fn gui_rgba8888_row_tile_plan_validate_shape_metadata %fn &GuiRgba8888RowTilePlan Result unit GuiRgba8888RowTilePlanInvariantErrorKind \plan:
    let width %i32 gui_rgba8888_row_tile_plan_width plan
    match gui_rgba8888_row_tile_plan_checked_mul_invariant width 4 GuiRgba8888RowTilePlanInvariantErrorKind::ExpectedStrideOverflow:
        Result::Err kind:
            Result::Err kind
        Result::Ok expected_stride:
            let stride_bytes %i32 gui_rgba8888_row_tile_plan_stride_bytes plan
            if ne stride_bytes expected_stride:
                then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::StrideMismatch
                else:
                    let row_start %i32 gui_rgba8888_row_tile_plan_row_start plan
                    let row_count %i32 gui_rgba8888_row_tile_plan_row_count plan
                    match gui_rgba8888_row_tile_plan_checked_add_invariant row_start row_count GuiRgba8888RowTilePlanInvariantErrorKind::RowExtentOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok row_bottom:
                            let height %i32 gui_rgba8888_row_tile_plan_height plan
                            if gt row_bottom height:
                                then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::RowExtentOutOfBounds
                                else:
                                    match gui_rgba8888_row_tile_plan_checked_mul_invariant row_count stride_bytes GuiRgba8888RowTilePlanInvariantErrorKind::ExpectedByteCountOverflow:
                                        Result::Err kind:
                                            Result::Err kind
                                        Result::Ok expected_byte_count:
                                            if ne gui_rgba8888_row_tile_plan_byte_count plan expected_byte_count:
                                                then Result::Err GuiRgba8888RowTilePlanInvariantErrorKind::ByteCountMismatch
                                                else Result::Ok unit

fn gui_rgba8888_row_tile_plan_validate_tile_metadata %fn &GuiRgba8888RowTilePlan Result unit GuiRgba8888RowTilePlanInvariantErrorKind \plan:
    let row_count %i32 gui_rgba8888_row_tile_plan_row_count plan
