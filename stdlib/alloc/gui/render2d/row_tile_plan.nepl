//: - descriptor 計算前に plan invariant を[再検証/さいけんしょう]します。
pub fn gui_rgba8888_row_tile_plan_descriptor_at %fn &GuiRgba8888RowTilePlanOwner fn i32 Result GuiRgba8888RowTileDescriptor GuiRgba8888RowTilePlanDescriptorErrorKind \owner\tile_index:
