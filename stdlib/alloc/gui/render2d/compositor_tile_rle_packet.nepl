fn gui_rgba8888_compositor_tile_rle_packet_prepare_error_new %fn GuiRgba8888CompositorTileRlePacketPrepareErrorKind fn Option GuiError fn GuiRgba8888CompositorTileRleEncodedOwner GuiRgba8888CompositorTileRlePacketPrepareError \kind\category\encoded:
    GuiRgba8888CompositorTileRlePacketPrepareError kind category encoded

//: gui_rgba8888_compositor_tile_rle_packet_prepare_error_from_lower: lower prepare error を compositor encoded error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから lower encoded owner を[回収/かいしゅう]し、metadata [付/つ]き encoded owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_packet" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_packet_prepare_error_from_lower %fn GuiRgba8888RowTileRlePacketPrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRlePacketPrepareError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRlePacketPrepareErrorKind gui_rgba8888_row_tile_rle_packet_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_packet_prepare_error_category_value &lower
    let lower_encoded %GuiRgba8888RowTileRleEncodedOwner gui_rgba8888_row_tile_rle_packet_prepare_error_finish_encoded lower
    let encoded %GuiRgba8888CompositorTileRleEncodedOwner GuiRgba8888CompositorTileRleEncodedOwner lower_encoded metadata
    let kind %GuiRgba8888CompositorTileRlePacketPrepareErrorKind GuiRgba8888CompositorTileRlePacketPrepareErrorKind::PacketPrepareFailed lower_kind
    gui_rgba8888_compositor_tile_rle_packet_prepare_error_new kind category encoded

//: gui_rgba8888_compositor_tile_rle_packet_prepare: compositor encoded owner を packet owner に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower encoded owner を[取/と]り[出/だ]します。
//: - lower packet prepare を 1 [回/かい]だけ[呼/よ]び、success では packet owner と metadata を[束/たば]ねます。
//: - error では lower encoded owner を metadata [付/つ]き encoded owner に[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_packet" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_packet_prepare %fn GuiRgba8888CompositorTileRleEncodedOwner Result GuiRgba8888CompositorTileRlePacketOwner GuiRgba8888CompositorTileRlePacketPrepareError \encoded:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_encoded_owner_metadata &encoded
    let lower_encoded %GuiRgba8888RowTileRleEncodedOwner field::get encoded "encoded"
    match gui_rgba8888_row_tile_rle_packet_prepare lower_encoded:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_packet_prepare_error_from_lower lower metadata
        Result::Ok packet:
            Result::Ok gui_rgba8888_compositor_tile_rle_packet_owner_new packet metadata

