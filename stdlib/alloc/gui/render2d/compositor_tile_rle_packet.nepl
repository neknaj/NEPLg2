#import "core/traits/copy" as *

//: GuiRgba8888CompositorTileRlePacketPrepareErrorKind: packet bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower packet prepare error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_packet" as *
//: ```
pub enum GuiRgba8888CompositorTileRlePacketPrepareErrorKind:
    PacketPrepareFailed %GuiRgba8888RowTileRlePacketPrepareErrorKind

impl Clone for GuiRgba8888CompositorTileRlePacketPrepareErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRlePacketPrepareErrorKind GuiRgba8888CompositorTileRlePacketPrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRlePacketPrepareErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRlePacketPrepareErrorKind GuiRgba8888CompositorTileRlePacketPrepareErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRlePacketOwner: lower packet owner と compositor metadata の owner
