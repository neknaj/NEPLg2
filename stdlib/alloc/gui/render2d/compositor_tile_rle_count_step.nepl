//: lower count step error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_step" as *
//: ```
pub enum GuiRgba8888CompositorTileRleCountStepErrorKind:
    CountStepFailed %GuiRgba8888RowTileRleCountErrorKind

impl Clone for GuiRgba8888CompositorTileRleCountStepErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleCountStepErrorKind GuiRgba8888CompositorTileRleCountStepErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleCountStepErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleCountStepErrorKind GuiRgba8888CompositorTileRleCountStepErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleCountStep: lower step status と compositor count owner の terminal
//:
//: lower step が[返/かえ]した Pending / Completed status と、metadata [付/つ]き next count owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
