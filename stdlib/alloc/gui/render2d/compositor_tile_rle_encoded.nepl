//: gui_rgba8888_compositor_tile_rle_encoded_seal: compositor write cursor owner を sealed encoded owner に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower write cursor owner を[取/と]り[出/だ]します。
//: - lower encoded seal を 1 [回/かい]だけ[呼/よ]び、success では sealed encoded owner と metadata を[束/たば]ねます。
//: - error では lower write cursor owner を metadata [付/つ]き write cursor owner に[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encoded" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_encoded_seal %fn GuiRgba8888CompositorTileRleWriteCursorOwner Result GuiRgba8888CompositorTileRleEncodedOwner GuiRgba8888CompositorTileRleEncodedSealError \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_write_cursor_owner_metadata &owner
    let lower_owner %GuiRgba8888RowTileRleWriteCursorOwner field::get owner "writer"
    match gui_rgba8888_row_tile_rle_encoded_seal lower_owner:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_encoded_seal_error_from_lower lower metadata
        Result::Ok encoded:
            Result::Ok gui_rgba8888_compositor_tile_rle_encoded_owner_new encoded metadata

