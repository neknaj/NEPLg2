//: GuiRgba8888CompositorTileRleEncodeCursorErrorKind: encode cursor bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower encode cursor error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
//: ```
pub enum GuiRgba8888CompositorTileRleEncodeCursorErrorKind:
    CursorStartFailed %GuiRgba8888RowTileRleEncodeCursorErrorKind

impl Clone for GuiRgba8888CompositorTileRleEncodeCursorErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleEncodeCursorErrorKind GuiRgba8888CompositorTileRleEncodeCursorErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleEncodeCursorErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleEncodeCursorErrorKind GuiRgba8888CompositorTileRleEncodeCursorErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleEncodeCursorOwner: lower ready cursor owner と compositor metadata の owner
//:
//: lower ready cursor owner と copied frame metadata を 1 つの owner payload に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
//: ```
pub struct GuiRgba8888CompositorTileRleEncodeCursorOwner:
    ready %GuiRgba8888RowTileRleEncodeCursorOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTileRleEncodeCursorError: payload owner を[回収/かいしゅう]できる cursor error
//:
//: lower kind / category / total / start kind と、metadata [付/つ]き payload owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
//: ```
pub struct GuiRgba8888CompositorTileRleEncodeCursorError:
    kind %GuiRgba8888CompositorTileRleEncodeCursorErrorKind
    category %Option GuiError
    total_run_count %i32
    start_kind %GuiRgba8888RowTileRleStartErrorKind
    payload %GuiRgba8888CompositorTilePayloadOwner

//: gui_rgba8888_compositor_tile_rle_encode_cursor_owner_new: ready cursor owner と metadata を[束/たば]ねる
//:
//: lower encode cursor start が[成功/せいこう]した後だけ呼ぶ module-private constructor です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
