fn gui_rgba8888_compositor_tile_rle_encode_cursor_error_new %fn GuiRgba8888CompositorTileRleEncodeCursorErrorKind fn Option GuiError fn i32 fn GuiRgba8888RowTileRleStartErrorKind fn GuiRgba8888CompositorTilePayloadOwner GuiRgba8888CompositorTileRleEncodeCursorError \kind\category\total_run_count\start_kind\payload:
    GuiRgba8888CompositorTileRleEncodeCursorError kind category total_run_count start_kind payload

//: gui_rgba8888_compositor_tile_rle_encode_cursor_error_from_lower: lower cursor error を compositor payload error へ[写/うつ]す
//:
//: lower kind / category / total / start kind を[読/よ]んでから lower start error の payload owner を[回収/かいしゅう]し、metadata [付/つ]き payload owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_encode_cursor_error_from_lower %fn GuiRgba8888RowTileRleEncodeCursorError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleEncodeCursorError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRleEncodeCursorErrorKind gui_rgba8888_row_tile_rle_encode_cursor_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_encode_cursor_error_category_value &lower
    let total_run_count %i32 gui_rgba8888_row_tile_rle_encode_cursor_error_total_run_count &lower
    let start_kind %GuiRgba8888RowTileRleStartErrorKind gui_rgba8888_row_tile_rle_encode_cursor_error_start_kind &lower
    let start_error %GuiRgba8888RowTileRleStartError gui_rgba8888_row_tile_rle_encode_cursor_error_finish_start_error lower
    let lower_payload %GuiRgba8888RowTilePayloadOwner gui_rgba8888_row_tile_rle_start_error_payload start_error
    let payload %GuiRgba8888CompositorTilePayloadOwner GuiRgba8888CompositorTilePayloadOwner lower_payload metadata
    let kind %GuiRgba8888CompositorTileRleEncodeCursorErrorKind GuiRgba8888CompositorTileRleEncodeCursorErrorKind::CursorStartFailed lower_kind
    gui_rgba8888_compositor_tile_rle_encode_cursor_error_new kind category total_run_count start_kind payload

//: gui_rgba8888_compositor_tile_rle_encode_cursor_start: seed owner から ready cursor を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower seed owner を[取/と]り[出/だ]します。
//: - lower cursor start を 1 [回/かい]だけ[呼/よ]び、success では ready cursor owner と metadata を[束/たば]ねます。
//: - error では lower start error payload を metadata [付/つ]き payload owner に[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_encode_cursor_start %fn GuiRgba8888CompositorTileRleEncodeSeedOwner Result GuiRgba8888CompositorTileRleEncodeCursorOwner GuiRgba8888CompositorTileRleEncodeCursorError \seed:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_encode_seed_owner_metadata &seed
    let lower_seed %GuiRgba8888RowTileRleEncodeSeedOwner field::get seed "seed"
    match gui_rgba8888_row_tile_rle_encode_cursor_start lower_seed:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_encode_cursor_error_from_lower lower metadata
        Result::Ok ready:
            Result::Ok gui_rgba8888_compositor_tile_rle_encode_cursor_owner_new ready metadata

