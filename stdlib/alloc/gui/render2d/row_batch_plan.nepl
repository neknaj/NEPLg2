pub struct GuiRgba8888RowBatchPlanPrepareError:
    kind %GuiRgba8888RowBatchPlanPrepareErrorKind
    category %Option GuiError
    frame %GuiRgba8888BitmapFrameOwner

struct GuiRgba8888RowBatchDirtyRectSpan:
