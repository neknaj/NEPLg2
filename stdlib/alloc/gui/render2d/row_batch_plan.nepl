fn gui_rgba8888_row_batch_i32_min %fn i32 fn i32 i32 \a\b:
    if lt a b a b

fn gui_rgba8888_row_batch_i32_max %fn i32 fn i32 i32 \a\b:
    if gt a b a b

fn gui_rgba8888_row_batch_rect_equal %fn GuiRect fn GuiRect bool \left\right:
    let origin_matches %bool and eq gui_rect_x &left gui_rect_x &right eq gui_rect_y &left gui_rect_y &right
    let size_matches %bool and eq gui_rect_width &left gui_rect_width &right eq gui_rect_height &left gui_rect_height &right
    and origin_matches size_matches

fn gui_rgba8888_row_batch_dirty_set_equal %fn DirtyRegionSet fn DirtyRegionSet bool \left\right:
    let left_state %DirtyRegionSetState dirty_regions_state &left
    let right_state %DirtyRegionSetState dirty_regions_state &right
    match left_state:
        DirtyRegionSetState::Empty:
            match right_state:
                DirtyRegionSetState::Empty:
                    true
                _:
                    false
        DirtyRegionSetState::Full:
            match right_state:
                DirtyRegionSetState::Full:
                    true
                _:
                    false
        DirtyRegionSetState::One:
            match right_state:
                DirtyRegionSetState::One:
                    let left_first %GuiRect dirty_regions_first &left
                    let right_first %GuiRect dirty_regions_first &right
                    gui_rgba8888_row_batch_rect_equal left_first right_first
                _:
                    false
        DirtyRegionSetState::Two:
            match right_state:
                DirtyRegionSetState::Two:
                    let left_first %GuiRect dirty_regions_first &left
                    let right_first %GuiRect dirty_regions_first &right
                    let left_second %GuiRect dirty_regions_second &left
                    let right_second %GuiRect dirty_regions_second &right
                    and gui_rgba8888_row_batch_rect_equal left_first right_first gui_rgba8888_row_batch_rect_equal left_second right_second
                _:
                    false

fn gui_rgba8888_row_batch_plan_invariant_error_from_prepare %fn GuiRgba8888RowBatchPlanPrepareErrorKind GuiRgba8888RowBatchPlanInvariantErrorKind \kind:
    match kind:
        GuiRgba8888RowBatchPlanPrepareErrorKind::MaxRowsPerBatchInvalid:
            GuiRgba8888RowBatchPlanInvariantErrorKind::MaxRowsPerBatchInvalid
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameIdInvalid:
            GuiRgba8888RowBatchPlanInvariantErrorKind::FrameIdInvalid
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameInvalidGeometry:
            GuiRgba8888RowBatchPlanInvariantErrorKind::FrameInvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameStrideMismatch:
            GuiRgba8888RowBatchPlanInvariantErrorKind::FrameStrideMismatch
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameByteLengthMismatch:
            GuiRgba8888RowBatchPlanInvariantErrorKind::FrameByteLengthMismatch
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidOrigin:
            GuiRgba8888RowBatchPlanInvariantErrorKind::DirtyRectInvalidOrigin
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidSize:
            GuiRgba8888RowBatchPlanInvariantErrorKind::DirtyRectInvalidSize
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectRightOverflow:
            GuiRgba8888RowBatchPlanInvariantErrorKind::DirtyRectRightOverflow
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectBottomOverflow:
            GuiRgba8888RowBatchPlanInvariantErrorKind::DirtyRectBottomOverflow
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectOutOfBounds:
            GuiRgba8888RowBatchPlanInvariantErrorKind::DirtyRectOutOfBounds
        GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid:
            GuiRgba8888RowBatchPlanInvariantErrorKind::RowSpanInvalid

//: gui_rgba8888_row_batch_plan_config_checked: positive row batch size を[持/も]つ config を[作/つく]る
