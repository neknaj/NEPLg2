pub struct GuiRgba8888RowBatchPlanOwner:
    frame %GuiRgba8888BitmapFrameOwner
    frame_id %i32
    width %i32
    height %i32
    stride_bytes %i32
    byte_len %i32
    dirty %DirtyRegionSet
    row_start %i32
    row_count %i32
