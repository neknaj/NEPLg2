pub fn gui_rgba8888_row_batch_plan_prepare_error_frame %fn GuiRgba8888RowBatchPlanPrepareError GuiRgba8888BitmapFrameOwner \error:
    field::get error "frame"

fn gui_rgba8888_row_batch_plan_checked_extent %fn i32 fn i32 fn GuiRgba8888RowBatchPlanPrepareErrorKind Result i32 GuiRgba8888RowBatchPlanPrepareErrorKind \origin\extent\overflow_kind:
    let max_i32 %i32 2147483647
    let max_origin %i32 sub max_i32 extent
    if gt origin max_origin:
        then Result::Err overflow_kind
        else Result::Ok add origin extent

fn gui_rgba8888_row_batch_plan_validate_frame_shape %fn &GuiRgba8888BitmapFrameOwner Result GuiRgba8888SoftwareSurfaceShape GuiRgba8888RowBatchPlanPrepareErrorKind \frame:
    let width %i32 gui_rgba8888_bitmap_frame_width frame
    let height %i32 gui_rgba8888_bitmap_frame_height frame
    match gui_rgba8888_software_surface_shape width height:
        Result::Err _shape_kind:
            Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::FrameInvalidGeometry
        Result::Ok shape:
            let expected_stride %i32 gui_rgba8888_software_surface_shape_stride_bytes &shape
            let actual_stride %i32 gui_rgba8888_bitmap_frame_stride_bytes frame
            if ne actual_stride expected_stride:
                then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::FrameStrideMismatch
                else:
                    let expected_byte_len %i32 gui_rgba8888_software_surface_shape_byte_len &shape
                    let actual_byte_len %i32 gui_rgba8888_bitmap_frame_byte_len frame
                    if ne actual_byte_len expected_byte_len:
                        then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::FrameByteLengthMismatch
                        else Result::Ok shape

fn gui_rgba8888_row_batch_plan_dirty_rect_span_checked %fn &GuiRect fn i32 fn i32 Result GuiRgba8888RowBatchDirtyRectSpan GuiRgba8888RowBatchPlanPrepareErrorKind \rect\frame_width\frame_height:
    let x %i32 gui_rect_x rect
    let y %i32 gui_rect_y rect
    let width %i32 gui_rect_width rect
    let height %i32 gui_rect_height rect
    if or lt x 0 lt y 0:
        then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidOrigin
        else:
            if or lt width 0 lt height 0:
                then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidSize
                else:
                    match gui_rgba8888_row_batch_plan_checked_extent x width GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectRightOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok right:
                            match gui_rgba8888_row_batch_plan_checked_extent y height GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectBottomOverflow:
                                Result::Err kind:
                                    Result::Err kind
                                Result::Ok bottom:
                                    if or gt right frame_width gt bottom frame_height:
                                        then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectOutOfBounds
                                        else Result::Ok gui_rgba8888_row_batch_dirty_rect_span_new y bottom

fn gui_rgba8888_row_batch_plan_validate_dirty_set %fn DirtyRegionSet fn i32 fn i32 Result unit GuiRgba8888RowBatchPlanPrepareErrorKind \dirty\frame_width\frame_height:
    match dirty_regions_state &dirty:
        DirtyRegionSetState::Empty:
            Result::Ok unit
        DirtyRegionSetState::Full:
            Result::Ok unit
        DirtyRegionSetState::One:
            let first %GuiRect dirty_regions_first &dirty
            match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &first frame_width frame_height:
                Result::Err kind:
                    Result::Err kind
                Result::Ok _span:
                    Result::Ok unit
        DirtyRegionSetState::Two:
            let first %GuiRect dirty_regions_first &dirty
            match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &first frame_width frame_height:
                Result::Err kind:
                    Result::Err kind
                Result::Ok _first_span:
                    let second %GuiRect dirty_regions_second &dirty
                    match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &second frame_width frame_height:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok _second_span:
                            Result::Ok unit

fn gui_rgba8888_row_batch_span_from_bounds %fn i32 fn i32 fn i32 Result GuiRgba8888RowBatchSpan GuiRgba8888RowBatchPlanPrepareErrorKind \row_start\row_bottom\frame_height:
    if:
        or lt row_start 0 or lt row_bottom row_start gt row_bottom frame_height
        then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid
        else:
            let row_count %i32 sub row_bottom row_start
            Result::Ok gui_rgba8888_row_batch_span_new row_start row_count

fn gui_rgba8888_row_batch_plan_dirty_row_span %fn DirtyRegionSet fn i32 fn i32 Result GuiRgba8888RowBatchSpan GuiRgba8888RowBatchPlanPrepareErrorKind \dirty\frame_width\frame_height:
    match dirty_regions_state &dirty:
        DirtyRegionSetState::Empty:
            Result::Ok gui_rgba8888_row_batch_span_new 0 0
        DirtyRegionSetState::Full:
            Result::Ok gui_rgba8888_row_batch_span_new 0 frame_height
        DirtyRegionSetState::One:
            let first %GuiRect dirty_regions_first &dirty
            match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &first frame_width frame_height:
                Result::Err kind:
                    Result::Err kind
                Result::Ok first_span:
                    let y %i32 gui_rgba8888_row_batch_dirty_rect_span_y &first_span
                    let bottom %i32 gui_rgba8888_row_batch_dirty_rect_span_bottom &first_span
                    gui_rgba8888_row_batch_span_from_bounds y bottom frame_height
        DirtyRegionSetState::Two:
            let first %GuiRect dirty_regions_first &dirty
            match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &first frame_width frame_height:
                Result::Err kind:
                    Result::Err kind
                Result::Ok first_span:
                    let second %GuiRect dirty_regions_second &dirty
                    match gui_rgba8888_row_batch_plan_dirty_rect_span_checked &second frame_width frame_height:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok second_span:
                            let first_y %i32 gui_rgba8888_row_batch_dirty_rect_span_y &first_span
                            let second_y %i32 gui_rgba8888_row_batch_dirty_rect_span_y &second_span
                            let first_bottom %i32 gui_rgba8888_row_batch_dirty_rect_span_bottom &first_span
                            let second_bottom %i32 gui_rgba8888_row_batch_dirty_rect_span_bottom &second_span
                            let row_start %i32 gui_rgba8888_row_batch_i32_min first_y second_y
                            let row_bottom %i32 gui_rgba8888_row_batch_i32_max first_bottom second_bottom
                            gui_rgba8888_row_batch_span_from_bounds row_start row_bottom frame_height

fn gui_rgba8888_row_batch_plan_batch_count_checked %fn i32 fn i32 Result i32 GuiRgba8888RowBatchPlanPrepareErrorKind \row_count\max_rows_per_batch:
    if lt row_count 0:
        then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid
        else:
            if le max_rows_per_batch 0:
                then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::MaxRowsPerBatchInvalid
                else:
                    if eq row_count 0:
                        then Result::Ok 0
                        else:
                            let quotient %i32 div_s row_count max_rows_per_batch
                            let remainder %i32 rem_s row_count max_rows_per_batch
                            let batch_count %i32 if eq remainder 0 quotient add quotient 1
                            if lt batch_count 0:
                                then Result::Err GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid
                                else Result::Ok batch_count

fn gui_rgba8888_row_batch_plan_validate_stored_row_span %fn &GuiRgba8888RowBatchPlanOwner fn i32 Result unit GuiRgba8888RowBatchPlanInvariantErrorKind \plan\frame_height:
    let row_start %i32 gui_rgba8888_row_batch_plan_row_start plan
    let row_count %i32 gui_rgba8888_row_batch_plan_row_count plan
    if or lt row_start 0 lt row_count 0:
        then Result::Err GuiRgba8888RowBatchPlanInvariantErrorKind::RowSpanInvalid
        else:
            match gui_rgba8888_row_batch_plan_checked_extent row_start row_count GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid:
                Result::Err _kind:
                    Result::Err GuiRgba8888RowBatchPlanInvariantErrorKind::RowSpanInvalid
                Result::Ok row_bottom:
                    if gt row_bottom frame_height:
                        then Result::Err GuiRgba8888RowBatchPlanInvariantErrorKind::RowSpanInvalid
                        else Result::Ok unit

fn gui_rgba8888_row_batch_plan_validate_identity_shape %fn &GuiRgba8888RowBatchPlanOwner Result GuiRgba8888SoftwareSurfaceShape GuiRgba8888RowBatchPlanInvariantErrorKind \plan:
