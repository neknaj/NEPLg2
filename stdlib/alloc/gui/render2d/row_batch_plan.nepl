pub enum GuiRgba8888RowBatchPlanPrepareErrorKind:
    MaxRowsPerBatchInvalid
    FrameIdInvalid
    FrameInvalidGeometry
    FrameStrideMismatch
    FrameByteLengthMismatch
    DirtyRectInvalidOrigin
    DirtyRectInvalidSize
    DirtyRectRightOverflow
    DirtyRectBottomOverflow
    DirtyRectOutOfBounds
    RowSpanInvalid

pub enum GuiRgba8888RowBatchPlanInvariantErrorKind:
    MaxRowsPerBatchInvalid
    FrameIdInvalid
    FrameIdMismatch
    FrameInvalidGeometry
    FrameWidthMismatch
    FrameHeightMismatch
    FrameStrideMismatch
    FrameByteLengthMismatch
    DirtySetMismatch
    DirtyRectInvalidOrigin
    DirtyRectInvalidSize
    DirtyRectRightOverflow
    DirtyRectBottomOverflow
    DirtyRectOutOfBounds
    RowSpanInvalid
    DirtySpanMismatch
    BatchCountMismatch

impl Clone for GuiRgba8888RowBatchPlanPrepareErrorKind:
    fn clone %fn &GuiRgba8888RowBatchPlanPrepareErrorKind GuiRgba8888RowBatchPlanPrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowBatchPlanPrepareErrorKind:
    fn copy_mark %fn GuiRgba8888RowBatchPlanPrepareErrorKind GuiRgba8888RowBatchPlanPrepareErrorKind \kind:
        kind

impl Clone for GuiRgba8888RowBatchPlanInvariantErrorKind:
    fn clone %fn &GuiRgba8888RowBatchPlanInvariantErrorKind GuiRgba8888RowBatchPlanInvariantErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowBatchPlanInvariantErrorKind:
    fn copy_mark %fn GuiRgba8888RowBatchPlanInvariantErrorKind GuiRgba8888RowBatchPlanInvariantErrorKind \kind:
        kind

pub struct GuiRgba8888RowBatchPlanConfig:
