    row_count %i32

fn gui_rgba8888_row_batch_plan_prepare_error_category %fn GuiRgba8888RowBatchPlanPrepareErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowBatchPlanPrepareErrorKind::MaxRowsPerBatchInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameIdInvalid:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameInvalidGeometry:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameStrideMismatch:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowBatchPlanPrepareErrorKind::FrameByteLengthMismatch:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidOrigin:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectInvalidSize:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectRightOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectBottomOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::DirtyRectOutOfBounds:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchPlanPrepareErrorKind::RowSpanInvalid:
            Option::Some GuiError::InvalidCommand

fn gui_rgba8888_row_batch_plan_prepare_error %fn GuiRgba8888RowBatchPlanPrepareErrorKind fn GuiRgba8888BitmapFrameOwner GuiRgba8888RowBatchPlanPrepareError \kind\frame:
    let category %Option GuiError gui_rgba8888_row_batch_plan_prepare_error_category kind
    GuiRgba8888RowBatchPlanPrepareError kind category frame

fn gui_rgba8888_row_batch_plan_owner_new %fn GuiRgba8888BitmapFrameOwner fn i32 fn i32 fn i32 fn i32 fn i32 fn DirtyRegionSet fn i32 fn i32 fn i32 fn i32 GuiRgba8888RowBatchPlanOwner \frame\frame_id\width\height\stride_bytes\byte_len\dirty\row_start\row_count\batch_count\max_rows_per_batch:
    GuiRgba8888RowBatchPlanOwner frame frame_id width height stride_bytes byte_len dirty row_start row_count batch_count max_rows_per_batch

fn gui_rgba8888_row_batch_dirty_rect_span_new %fn i32 fn i32 GuiRgba8888RowBatchDirtyRectSpan \y\bottom:
