//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub struct GuiRgba8888CompositorTilePayloadPrepareError:
    kind %GuiRgba8888CompositorTilePayloadPrepareErrorKind
    category %Option GuiError
    plan %GuiRgba8888CompositorTilePlanOwner

//: GuiRgba8888CompositorTilePayloadFinishError: entry owner を[回収/かいしゅう]できる finish error
