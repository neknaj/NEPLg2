    match gui_rgba8888_compositor_tile_payload_owner_descriptor_checked owner:
        Result::Err kind:
            Result::Err kind
        Result::Ok descriptor:
            Result::Ok gui_rgba8888_row_tile_descriptor_byte_count &descriptor

