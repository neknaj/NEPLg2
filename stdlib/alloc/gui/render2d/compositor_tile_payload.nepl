fn gui_rgba8888_compositor_tile_payload_finish_error_new %fn GuiRgba8888CompositorTilePayloadFinishErrorKind fn Option GuiError fn GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorTilePayloadFinishError \kind\category\entry:
    GuiRgba8888CompositorTilePayloadFinishError kind category entry

//: gui_rgba8888_compositor_tile_payload_prepare_error_from_lower: lower prepare error を compositor plan error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから lower owner を[消費/しょうひ]し、metadata [付/つ]き tile plan owner を[復元/ふくげん]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
fn gui_rgba8888_compositor_tile_payload_prepare_error_from_lower %fn GuiRgba8888RowTilePayloadPrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTilePayloadPrepareError \lower\metadata:
    let lower_kind %GuiRgba8888RowTilePayloadPrepareErrorKind gui_rgba8888_row_tile_payload_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_payload_prepare_error_category_value &lower
    let lower_plan %GuiRgba8888RowTilePlanOwner gui_rgba8888_row_tile_payload_prepare_error_plan lower
    let plan %GuiRgba8888CompositorTilePlanOwner GuiRgba8888CompositorTilePlanOwner lower_plan metadata
    let kind %GuiRgba8888CompositorTilePayloadPrepareErrorKind GuiRgba8888CompositorTilePayloadPrepareErrorKind::RowTilePayloadPrepareFailed lower_kind
    gui_rgba8888_compositor_tile_payload_prepare_error_new kind category plan

//: gui_rgba8888_compositor_tile_payload_finish_error_from_lower: lower finish error を compositor entry error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから entry owner を[取/と]り[出/だ]し、tile payload finish error に[包/つつ]みます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
fn gui_rgba8888_compositor_tile_payload_finish_error_from_lower %fn GuiRgba8888CompositorTilePlanFinishError GuiRgba8888CompositorTilePayloadFinishError \lower:
    let lower_kind %GuiRgba8888CompositorTilePlanFinishErrorKind gui_rgba8888_compositor_tile_plan_finish_error_kind &lower
    let category %Option GuiError gui_rgba8888_compositor_tile_plan_finish_error_category_value &lower
    let entry %GuiRgba8888CompositorFrameEntryOwner gui_rgba8888_compositor_tile_plan_finish_error_finish_entry lower
    let kind %GuiRgba8888CompositorTilePayloadFinishErrorKind GuiRgba8888CompositorTilePayloadFinishErrorKind::TilePlanFinishFailed lower_kind
    gui_rgba8888_compositor_tile_payload_finish_error_new kind category entry

