//: # alloc/gui/render2d/compositor_tile_payload
//: RGBA8888 compositor row tile payload bridge boundary
//:
//: ### [目的/もくてき]
//: - F5md の `GuiRgba8888CompositorTilePlanOwner` を F5cb の row tile payload view boundary へ[渡/わた]します。
//: - compositor frame metadata を tile payload owner と[束/たば]ね、payload view [破棄/はき]後も frame entry owner へ[戻/もど]せるようにします。
//:
//: ### [契約/けいやく]
//: - tile plan owner を lower row tile payload へ[渡/わた]す[前/まえ]に metadata を Copy value として[読/よ]みます。
//: - lower `gui_rgba8888_row_tile_payload_prepare` を 1 [回/かい]だけ[呼/よ]びます。
//: - descriptor / plan metadata は lower checked helper に[委譲/いじょう]し、raw storage は[公開/こうかい]しません。
//:
//: ### [注意/ちゅうい]
//: - この module は tile-scoped byte payload view までで[止/と]まります。RLE、std present、host / platform API、video memory、Canvas / DOM / minifb、fallback / silent no-op には[進/すす]みません。
//: - byte read は lower payload view の checked reader に[委譲/いじょう]します。row byte storage や storage ref はこの layer から直接[公開/こうかい]しません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```

#indent 4

#import "alloc/gui/render2d/compositor_frame_entry" as *
#import "alloc/gui/render2d/compositor_tile_plan" as *
#import "alloc/gui/render2d/row_tile_payload" as *
#import "alloc/gui/render2d/row_tile_plan" as *
#import "alloc/gui/render2d/software_surface" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorTilePayloadPrepareErrorKind: compositor tile payload prepare の[失敗/しっぱい][段階/だんかい]
//:
//: lower row tile payload prepare の kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub enum GuiRgba8888CompositorTilePayloadPrepareErrorKind:
    RowTilePayloadPrepareFailed %GuiRgba8888RowTilePayloadPrepareErrorKind

impl Clone for GuiRgba8888CompositorTilePayloadPrepareErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePayloadPrepareErrorKind GuiRgba8888CompositorTilePayloadPrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePayloadPrepareErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePayloadPrepareErrorKind GuiRgba8888CompositorTilePayloadPrepareErrorKind \kind:
        kind

//: GuiRgba8888CompositorTilePayloadFinishErrorKind: tile payload から entry へ[戻/もど]す[失敗/しっぱい]
//:
//: compositor tile plan finish failure を tile payload boundary の typed error として[包/つつ]みます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub enum GuiRgba8888CompositorTilePayloadFinishErrorKind:
    TilePlanFinishFailed %GuiRgba8888CompositorTilePlanFinishErrorKind

impl Clone for GuiRgba8888CompositorTilePayloadFinishErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePayloadFinishErrorKind GuiRgba8888CompositorTilePayloadFinishErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePayloadFinishErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePayloadFinishErrorKind GuiRgba8888CompositorTilePayloadFinishErrorKind \kind:
        kind

//: GuiRgba8888CompositorTilePayloadFreeErrorKind: compositor tile payload free の[失敗/しっぱい][段階/だんかい]
//:
//: tile payload finish failure と、finish 成功後の entry free failure を[分/わ]けて[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub enum GuiRgba8888CompositorTilePayloadFreeErrorKind:
    FinishFailed %GuiRgba8888CompositorTilePayloadFinishErrorKind
    EntryFreeFailed %GuiRgba8888SoftwareSurfaceErrorKind

impl Clone for GuiRgba8888CompositorTilePayloadFreeErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePayloadFreeErrorKind GuiRgba8888CompositorTilePayloadFreeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePayloadFreeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePayloadFreeErrorKind GuiRgba8888CompositorTilePayloadFreeErrorKind \kind:
        kind

//: GuiRgba8888CompositorTilePayloadOwner: lower tile payload owner と compositor metadata の owner
//:
//: lower row tile payload owner と frame metadata を 1 つの owner payload に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub struct GuiRgba8888CompositorTilePayloadOwner:
    payload %GuiRgba8888RowTilePayloadOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTilePayloadPrepareError: tile plan owner を[回収/かいしゅう]できる prepare error
//:
//: lower kind / category と、metadata [付/つ]き compositor tile plan owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
