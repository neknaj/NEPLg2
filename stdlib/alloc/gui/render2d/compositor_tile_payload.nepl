//: gui_rgba8888_compositor_tile_payload_prepare: compositor tile plan owner から payload view owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower tile plan owner を[取/と]り[出/だ]します。
//: - lower row tile payload prepare のみを[呼/よ]び、RLE / present へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_payload" as *
//: ```
pub fn gui_rgba8888_compositor_tile_payload_prepare %fn GuiRgba8888CompositorTilePlanOwner fn i32 Result GuiRgba8888CompositorTilePayloadOwner GuiRgba8888CompositorTilePayloadPrepareError \plan_owner\tile_index:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_plan_owner_metadata &plan_owner
    let lower_plan %GuiRgba8888RowTilePlanOwner field::get plan_owner "plan"
    match gui_rgba8888_row_tile_payload_prepare lower_plan tile_index:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_payload_prepare_error_from_lower lower metadata
        Result::Ok payload:
            Result::Ok gui_rgba8888_compositor_tile_payload_owner_new payload metadata

