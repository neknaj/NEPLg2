//: gui_rgba8888_compositor_tile_rle_storage_owner_finish_payload: storage owner を payload owner へ[戻/もど]す
//:
//: metadata を Copy してから lower storage owner を[消費/しょうひ]し、storage deallocation 後の cursor payload を metadata [付/つ]き payload owner へ[復元/ふくげん]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_storage" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_storage_owner_finish_payload %fn GuiRgba8888CompositorTileRleStorageOwner Result GuiRgba8888CompositorTilePayloadOwner GuiRgba8888CompositorTileRleStorageFinishError \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_storage_owner_metadata &owner
    let storage %GuiRgba8888RowTileRleStorageOwner field::get owner "storage"
    match gui_rgba8888_row_tile_rle_storage_finish_cursor storage:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_storage_finish_error_from_lower lower metadata
        Result::Ok lower_cursor:
            let lower_payload %GuiRgba8888RowTilePayloadOwner gui_rgba8888_row_tile_rle_cursor_finish_payload lower_cursor
            Result::Ok GuiRgba8888CompositorTilePayloadOwner lower_payload metadata

