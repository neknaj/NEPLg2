    GuiRgba8888CompositorTileRleStorageFinishError kind payload

//: gui_rgba8888_compositor_tile_rle_storage_prepare_error_from_lower: lower storage prepare error を compositor writer plan error へ[写/うつ]す
//:
//: lower kind / category / count evidence を[読/よ]んでから lower writer plan owner を[回収/かいしゅう]し、metadata [付/つ]き writer plan owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_storage" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_storage_prepare_error_from_lower %fn GuiRgba8888RowTileRleStoragePrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleStoragePrepareError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRleStoragePrepareErrorKind gui_rgba8888_row_tile_rle_storage_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_storage_prepare_error_category_value &lower
    let total_run_count %i32 gui_rgba8888_row_tile_rle_storage_prepare_error_plan_total_run_count &lower
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_storage_prepare_error_plan_encoded_byte_count &lower
    let lower_plan %GuiRgba8888RowTileRleWriterPlanOwner gui_rgba8888_row_tile_rle_storage_prepare_error_finish_plan lower
    let plan %GuiRgba8888CompositorTileRleWriterPlanOwner GuiRgba8888CompositorTileRleWriterPlanOwner lower_plan metadata
    let kind %GuiRgba8888CompositorTileRleStoragePrepareErrorKind GuiRgba8888CompositorTileRleStoragePrepareErrorKind::StoragePrepareFailed lower_kind
    gui_rgba8888_compositor_tile_rle_storage_prepare_error_new kind category total_run_count encoded_byte_count plan

//: gui_rgba8888_compositor_tile_rle_storage_finish_error_from_lower: lower storage finish error を payload recovery error へ[写/うつ]す
//:
//: lower finish kind を[読/よ]んでから lower cursor を[回収/かいしゅう]し、metadata [付/つ]き payload owner に[戻/もど]します。
