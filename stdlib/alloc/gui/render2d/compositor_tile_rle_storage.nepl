    kind %GuiRgba8888CompositorTileRleStoragePrepareErrorKind
    category %Option GuiError
    total_run_count %i32
    encoded_byte_count %i32
    plan %GuiRgba8888CompositorTileRleWriterPlanOwner

//: GuiRgba8888CompositorTileRleStorageFinishError: payload owner を[回収/かいしゅう]できる storage finish error
