#import "alloc/gui/render2d/row_tile_rle" as *
#import "alloc/gui/render2d/row_tile_rle_storage" as *
#import "alloc/gui/render2d/row_tile_rle_writer_plan" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorTileRleStoragePrepareErrorKind: storage allocation bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower storage prepare error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_storage" as *
//: ```
pub enum GuiRgba8888CompositorTileRleStoragePrepareErrorKind:
    StoragePrepareFailed %GuiRgba8888RowTileRleStoragePrepareErrorKind

impl Clone for GuiRgba8888CompositorTileRleStoragePrepareErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleStoragePrepareErrorKind GuiRgba8888CompositorTileRleStoragePrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleStoragePrepareErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleStoragePrepareErrorKind GuiRgba8888CompositorTileRleStoragePrepareErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleStorageFinishErrorKind: storage owner close の[失敗/しっぱい][段階/だんかい]
//:
//: lower storage finish / free の kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
