impl Clone for GuiRgba8888CompositorTileRleStorageFinishErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleStorageFinishErrorKind GuiRgba8888CompositorTileRleStorageFinishErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleStorageFinishErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleStorageFinishErrorKind GuiRgba8888CompositorTileRleStorageFinishErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleStorageOwner: lower storage owner と compositor metadata の owner
//:
//: exact encoded storage authority と copied frame metadata を 1 つの owner payload に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_storage" as *
//: ```
pub struct GuiRgba8888CompositorTileRleStorageOwner:
    storage %GuiRgba8888RowTileRleStorageOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTileRleStoragePrepareError: writer plan owner を[回収/かいしゅう]できる storage prepare error
//:
//: lower storage prepare error の kind / category / counts と、metadata [付/つ]き writer plan owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_storage" as *
//: ```
