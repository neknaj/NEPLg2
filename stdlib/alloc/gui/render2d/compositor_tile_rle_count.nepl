//: gui_rgba8888_compositor_tile_rle_count_start: compositor tile payload owner から RLE count owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower payload owner を[取/と]り[出/だ]します。
//: - lower RLE cursor start と count start のみを[呼/よ]び、drain / encode / present へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_count_start %fn GuiRgba8888CompositorTilePayloadOwner Result GuiRgba8888CompositorTileRleCountOwner GuiRgba8888CompositorTileRleCountStartError \payload_owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_payload_owner_metadata &payload_owner
    let lower_payload %GuiRgba8888RowTilePayloadOwner field::get payload_owner "payload"
    match gui_rgba8888_row_tile_rle_cursor_start lower_payload:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_count_start_error_from_cursor_start lower metadata
        Result::Ok cursor:
            match gui_rgba8888_row_tile_rle_count_start cursor:
                Result::Err lower:
                    Result::Err gui_rgba8888_compositor_tile_rle_count_start_error_from_count_start lower metadata
                Result::Ok count:
                    Result::Ok gui_rgba8888_compositor_tile_rle_count_owner_new count metadata

