    fn clone %fn &GuiRgba8888CompositorTileRleCountStartErrorKind GuiRgba8888CompositorTileRleCountStartErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleCountStartErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleCountStartErrorKind GuiRgba8888CompositorTileRleCountStartErrorKind \kind:
        kind

