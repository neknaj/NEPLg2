    *field::get_ref metadata "row_start"

pub fn gui_rgba8888_compositor_frame_entry_metadata_row_count %fn &GuiRgba8888CompositorFrameEntryMetadata i32 \metadata:
    *field::get_ref metadata "row_count"

pub fn gui_rgba8888_compositor_frame_entry_metadata_batch_count %fn &GuiRgba8888CompositorFrameEntryMetadata i32 \metadata:
    *field::get_ref metadata "batch_count"

pub fn gui_rgba8888_compositor_frame_entry_metadata_max_rows_per_batch %fn &GuiRgba8888CompositorFrameEntryMetadata i32 \metadata:
    *field::get_ref metadata "max_rows_per_batch"

pub fn gui_rgba8888_compositor_frame_entry_prepare_error_kind %fn &GuiRgba8888CompositorFrameEntryPrepareError GuiRgba8888CompositorFrameEntryPrepareErrorKind \error:
    *field::get_ref error "kind"

pub fn gui_rgba8888_compositor_frame_entry_prepare_error_category_value %fn &GuiRgba8888CompositorFrameEntryPrepareError Option GuiError \error:
    *field::get_ref error "category"

pub fn gui_rgba8888_compositor_frame_entry_prepare_error_owner %fn GuiRgba8888CompositorFrameEntryPrepareError GuiRgba8888SoftwareSurfaceDirtyOwner \error:
    field::get error "owner"

//: gui_rgba8888_compositor_frame_entry_prepare: dirty owner を compositor frame entry owner へ[正規化/せいきか]する
//:
//: [契約/けいやく]:
//: - `frame_id` と `max_rows_per_batch` は lower config aggregate として[渡/わた]し、lower prepare が owner-bearing error を[返/かえ]します。
//: - row batch cursor start の[前/まえ]に plan metadata を Copy value として[保存/ほぞん]します。
pub fn gui_rgba8888_compositor_frame_entry_prepare %fn GuiRgba8888SoftwareSurfaceDirtyOwner fn GuiRgba8888CompositorFrameEntryConfig Result GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorFrameEntryPrepareError \owner\config:
    let frame_id %i32 gui_rgba8888_compositor_frame_entry_config_frame_id &config
    let frame_config %GuiRgba8888BitmapFrameConfig GuiRgba8888BitmapFrameConfig frame_id
    match gui_rgba8888_bitmap_frame_prepare owner frame_config:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_frame_entry_bitmap_frame_prepare_error_new lower
        Result::Ok frame:
            let max_rows_per_batch %i32 gui_rgba8888_compositor_frame_entry_config_max_rows_per_batch &config
            let plan_config %GuiRgba8888RowBatchPlanConfig GuiRgba8888RowBatchPlanConfig max_rows_per_batch
            match gui_rgba8888_row_batch_plan_prepare frame plan_config:
                Result::Err lower:
                    Result::Err gui_rgba8888_compositor_frame_entry_row_batch_plan_prepare_error_new lower
                Result::Ok plan:
                    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_frame_entry_metadata_from_plan &plan
                    match gui_rgba8888_row_batch_cursor_start plan:
                        Result::Err lower:
                            Result::Err gui_rgba8888_compositor_frame_entry_row_batch_cursor_start_error_new lower
                        Result::Ok cursor:
                            Result::Ok gui_rgba8888_compositor_frame_entry_owner_new cursor metadata

pub fn gui_rgba8888_compositor_frame_entry_finish_cursor %fn GuiRgba8888CompositorFrameEntryOwner GuiRgba8888RowBatchCursorOwner \owner:
    field::get owner "cursor"

pub fn gui_rgba8888_compositor_frame_entry_owner_free %fn GuiRgba8888CompositorFrameEntryOwner Result unit GuiRgba8888SoftwareSurfaceErrorKind \owner:
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_compositor_frame_entry_finish_cursor owner
    gui_rgba8888_row_batch_cursor_free cursor

pub fn gui_rgba8888_compositor_frame_entry_prepare_error_free %fn GuiRgba8888CompositorFrameEntryPrepareError Result unit GuiRgba8888SoftwareSurfaceErrorKind \error:
    let owner %GuiRgba8888SoftwareSurfaceDirtyOwner gui_rgba8888_compositor_frame_entry_prepare_error_owner error
    gui_rgba8888_software_surface_dirty_owner_free owner
