    let kind %GuiRgba8888CompositorFrameEntryPrepareErrorKind GuiRgba8888CompositorFrameEntryPrepareErrorKind::RowBatchPlanPrepareFailed lower_kind
    gui_rgba8888_compositor_frame_entry_prepare_error_new kind category owner

