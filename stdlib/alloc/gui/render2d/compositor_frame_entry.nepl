        *config

impl Copy for GuiRgba8888CompositorFrameEntryConfig:
    fn copy_mark %fn GuiRgba8888CompositorFrameEntryConfig GuiRgba8888CompositorFrameEntryConfig \config:
        config

//: GuiRgba8888CompositorFrameEntryMetadata: compositor frame entry の[固定/こてい]metadata
//:
