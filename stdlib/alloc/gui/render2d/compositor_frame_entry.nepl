    *field::get_ref owner "metadata"

pub fn gui_rgba8888_compositor_frame_entry_metadata_frame_id %fn &GuiRgba8888CompositorFrameEntryMetadata i32 \metadata:
    *field::get_ref metadata "frame_id"

