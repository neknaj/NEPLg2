//: gui_rgba8888_row_batch_range_owner_validate_authority: range owner の metadata が embedded plan 由来であることを owner を[消費/しょうひ]せずに[再検証/さいけんしょう]する
//:
//: [契約/けいやく]:
//: - batch descriptor authority、descriptor 由来の range metadata、continuation cursor status をすべて[検査/けんさ]します。
//: - stored range が再計算した range と 1 field でも[異/こと]なる場合は `RangeMetadataMismatch` を[返/かえ]します。
//: - この helper は byte copy や cursor recovery の[前/まえ]に使うため、range owner を[消費/しょうひ]しません。
pub fn gui_rgba8888_row_batch_range_owner_validate_authority %fn &GuiRgba8888RowBatchRangeOwner Result unit GuiRgba8888RowBatchRangePrepareErrorKind \owner:
    let batch %&GuiRgba8888RowBatchCursorBatchOwner field::get_ref owner "batch"
    match gui_rgba8888_row_batch_cursor_batch_validate_descriptor_authority batch:
        Result::Err cursor_kind:
            Result::Err GuiRgba8888RowBatchRangePrepareErrorKind::BatchAuthorityInvalid cursor_kind
        Result::Ok _:
            let descriptor %GuiRgba8888RowBatchDescriptor gui_rgba8888_row_batch_cursor_batch_descriptor batch
            match gui_rgba8888_row_batch_range_validate_descriptor &descriptor:
                Result::Err kind:
                    Result::Err kind
                Result::Ok expected_range:
                    let stored_range %GuiRgba8888RowBatchRange gui_rgba8888_row_batch_range_owner_range owner
                    if not gui_rgba8888_row_batch_range_equal &stored_range &expected_range:
                        then Result::Err GuiRgba8888RowBatchRangePrepareErrorKind::RangeMetadataMismatch
                        else:
                            gui_rgba8888_row_batch_range_validate_continuation batch &descriptor

//: gui_rgba8888_row_batch_range_prepare: validated batch owner から row range metadata owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - まず cursor 側の authority helper で、descriptor と embedded plan の一致を[検査/けんさ]します。
//: - 続けて descriptor の row / byte range と continuation cursor を[検査/けんさ]します。
//: - 失敗時は元の batch owner を error 内に保持し、caller が回収または free できます。
pub fn gui_rgba8888_row_batch_range_prepare %fn GuiRgba8888RowBatchCursorBatchOwner Result GuiRgba8888RowBatchRangeOwner GuiRgba8888RowBatchRangePrepareError \batch:
    match gui_rgba8888_row_batch_cursor_batch_validate_descriptor_authority &batch:
        Result::Err cursor_kind:
            Result::Err gui_rgba8888_row_batch_range_prepare_error GuiRgba8888RowBatchRangePrepareErrorKind::BatchAuthorityInvalid cursor_kind batch
        Result::Ok _:
            let descriptor %GuiRgba8888RowBatchDescriptor gui_rgba8888_row_batch_cursor_batch_descriptor &batch
            match gui_rgba8888_row_batch_range_validate_descriptor &descriptor:
                Result::Err kind:
                    Result::Err gui_rgba8888_row_batch_range_prepare_error kind batch
                Result::Ok range:
                    match gui_rgba8888_row_batch_range_validate_continuation &batch &descriptor:
                        Result::Err kind:
                            Result::Err gui_rgba8888_row_batch_range_prepare_error kind batch
                        Result::Ok _:
                            Result::Ok gui_rgba8888_row_batch_range_owner_new batch range

