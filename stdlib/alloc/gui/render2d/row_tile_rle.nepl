fn gui_rgba8888_row_tile_rle_cursor_owner_new %fn GuiRgba8888RowTilePayloadOwner fn i32 fn i32 GuiRgba8888RowTileRleCursorOwner \payload\pixel_count\next_pixel_index:
    GuiRgba8888RowTileRleCursorOwner payload pixel_count next_pixel_index

fn gui_rgba8888_row_tile_rle_run_new %fn i32 fn i32 fn Rgba8888 GuiRgba8888RowTileRleRun \pixel_offset\pixel_count\color:
