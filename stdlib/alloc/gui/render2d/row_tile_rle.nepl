//: gui_rgba8888_row_tile_rle_cursor_start: tile payload を pixel run cursor に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - payload byte count が 4 byte pixel に[整列/せいれつ]していない場合は start error に payload owner を[保持/ほじ]します。
//: - start は cursor を先頭 pixel に[置/お]き、pixel payload をまだ[走査/そうさ]しません。
pub fn gui_rgba8888_row_tile_rle_cursor_start %fn GuiRgba8888RowTilePayloadOwner Result GuiRgba8888RowTileRleCursorOwner GuiRgba8888RowTileRleStartError \payload:
    let byte_count %i32 gui_rgba8888_row_tile_payload_byte_count &payload
    if le byte_count 0:
        then Result::Err gui_rgba8888_row_tile_rle_start_error GuiRgba8888RowTileRleStartErrorKind::PayloadByteCountInvalid payload
        else:
            let remainder %i32 rem_s byte_count 4
            if ne remainder 0:
                then Result::Err gui_rgba8888_row_tile_rle_start_error GuiRgba8888RowTileRleStartErrorKind::PayloadByteCountNotRgbaAligned payload
                else:
                    let pixel_count %i32 div_s byte_count 4
                    Result::Ok gui_rgba8888_row_tile_rle_cursor_owner_new payload pixel_count 0

//: gui_rgba8888_row_tile_rle_cursor_status: cursor の現在位置を pixel run stream status として[読/よ]む
//:
//: [契約/けいやく]:
//: - `next_pixel_index == pixel_count` だけが `Complete` です。
//: - index が負または終端を[越/こ]えている場合は typed error です。
pub fn gui_rgba8888_row_tile_rle_cursor_status %fn &GuiRgba8888RowTileRleCursorOwner Result GuiRgba8888RowTileRleCursorStatus GuiRgba8888RowTileRleStepErrorKind \cursor:
    let next_pixel_index %i32 gui_rgba8888_row_tile_rle_cursor_next_pixel_index cursor
    let pixel_count %i32 gui_rgba8888_row_tile_rle_cursor_pixel_count cursor
    if lt next_pixel_index 0:
        then Result::Err GuiRgba8888RowTileRleStepErrorKind::CursorIndexNegative
        else:
            if gt next_pixel_index pixel_count:
                then Result::Err GuiRgba8888RowTileRleStepErrorKind::CursorIndexPastEnd
                else:
                    if eq next_pixel_index pixel_count:
                        then Result::Ok GuiRgba8888RowTileRleCursorStatus::Complete
                        else Result::Ok GuiRgba8888RowTileRleCursorStatus::Ready

fn gui_rgba8888_row_tile_rle_scan_run %fn &GuiRgba8888RowTilePayloadOwner fn i32 fn i32 fn Rgba8888 Result i32 GuiRgba8888RowTileRleStepErrorKind \payload\start_pixel_index\pixel_count\color:
    let mut scan_index %i32 add start_pixel_index 1
    let mut run_count %i32 1
    let mut done %bool false
    let mut failed %bool false
    let mut failure_kind %GuiRgba8888RowTileRleStepErrorKind GuiRgba8888RowTileRleStepErrorKind::CursorComplete
    while not done:
        do:
            if ge scan_index pixel_count:
                then:
                    set done true
                else:
                    match gui_rgba8888_row_tile_rle_read_pixel payload scan_index:
                        Result::Err kind:
                            set failed true
                            set failure_kind kind
                            set done true
                        Result::Ok next_color:
                            if gui_rgba8888_row_tile_rle_color_equal &color &next_color:
                                then:
                                    match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta scan_index 1 GuiRgba8888RowTileRleStepErrorKind::NextPixelIndexOverflow:
                                        Result::Err kind:
                                            set failed true
                                            set failure_kind kind
                                            set done true
                                        Result::Ok next_scan_index:
                                            match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta run_count 1 GuiRgba8888RowTileRleStepErrorKind::RunLengthOverflow:
                                                Result::Err kind:
                                                    set failed true
                                                    set failure_kind kind
                                                    set done true
                                                Result::Ok next_run_count:
                                                    set scan_index next_scan_index
                                                    set run_count next_run_count
                                else:
                                    set done true
    if failed:
        then Result::Err failure_kind
        else Result::Ok run_count

fn gui_rgba8888_row_tile_rle_peek_run_at %fn &GuiRgba8888RowTilePayloadOwner fn i32 fn i32 Result GuiRgba8888RowTileRleRun GuiRgba8888RowTileRleStepErrorKind \payload\start_pixel_index\pixel_count:
    match gui_rgba8888_row_tile_rle_read_pixel payload start_pixel_index:
        Result::Err kind:
            Result::Err kind
        Result::Ok color:
            match gui_rgba8888_row_tile_rle_scan_run payload start_pixel_index pixel_count color:
                Result::Err kind:
                    Result::Err kind
                Result::Ok run_count:
                    Result::Ok gui_rgba8888_row_tile_rle_run_new start_pixel_index run_count color

//: gui_rgba8888_row_tile_rle_cursor_peek_run: cursor を[進/すす]めずに次の pixel run を[読/よ]む
//:
//: [契約/けいやく]:
//: - cursor owner を[消費/しょうひ]せず、payload owner も[外/そと]へ[出/だ]しません。
//: - Complete cursor は `CursorComplete` を[返/かえ]します。
//: - writer はこの関数で run を[借用/しゃくよう]読みにし、storage write が成功した後でだけ `advance_by_run` を[呼/よ]びます。
pub fn gui_rgba8888_row_tile_rle_cursor_peek_run %fn &GuiRgba8888RowTileRleCursorOwner Result GuiRgba8888RowTileRleRun GuiRgba8888RowTileRleStepErrorKind \cursor:
    match gui_rgba8888_row_tile_rle_cursor_status cursor:
        Result::Err kind:
            Result::Err kind
        Result::Ok status:
            match status:
                GuiRgba8888RowTileRleCursorStatus::Complete:
                    Result::Err GuiRgba8888RowTileRleStepErrorKind::CursorComplete
                GuiRgba8888RowTileRleCursorStatus::Ready:
                    let pixel_count %i32 gui_rgba8888_row_tile_rle_cursor_pixel_count cursor
                    let start_pixel_index %i32 gui_rgba8888_row_tile_rle_cursor_next_pixel_index cursor
                    let payload %&GuiRgba8888RowTilePayloadOwner field::get_ref cursor "payload"
                    gui_rgba8888_row_tile_rle_peek_run_at payload start_pixel_index pixel_count

fn gui_rgba8888_row_tile_rle_run_advance_index %fn &GuiRgba8888RowTileRleCursorOwner fn &GuiRgba8888RowTileRleRun Result i32 GuiRgba8888RowTileRleStepErrorKind \cursor\run:
    match gui_rgba8888_row_tile_rle_cursor_status cursor:
        Result::Err kind:
            Result::Err kind
        Result::Ok status:
            match status:
                GuiRgba8888RowTileRleCursorStatus::Complete:
                    Result::Err GuiRgba8888RowTileRleStepErrorKind::CursorComplete
                GuiRgba8888RowTileRleCursorStatus::Ready:
                    let start_pixel_index %i32 gui_rgba8888_row_tile_rle_cursor_next_pixel_index cursor
                    let run_pixel_offset %i32 gui_rgba8888_row_tile_rle_run_pixel_offset run
                    if ne run_pixel_offset start_pixel_index:
                        then Result::Err GuiRgba8888RowTileRleStepErrorKind::RunPixelOffsetMismatch
                        else:
                            let run_pixel_count %i32 gui_rgba8888_row_tile_rle_run_pixel_count run
                            if le run_pixel_count 0:
                                then Result::Err GuiRgba8888RowTileRleStepErrorKind::RunPixelCountInvalid
                                else:
                                    match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta start_pixel_index run_pixel_count GuiRgba8888RowTileRleStepErrorKind::NextPixelIndexOverflow:
                                        Result::Err kind:
                                            Result::Err kind
                                        Result::Ok next_pixel_index:
                                            let pixel_count %i32 gui_rgba8888_row_tile_rle_cursor_pixel_count cursor
                                            if gt next_pixel_index pixel_count:
                                                then Result::Err GuiRgba8888RowTileRleStepErrorKind::RunEndOutOfBounds
                                                else Result::Ok next_pixel_index

//: gui_rgba8888_row_tile_rle_cursor_advance_by_run: peek 済み run で cursor を 1 run [進/すす]める
//:
//: [契約/けいやく]:
//: - run の `pixel_offset` が cursor の現在位置と一致し、`pixel_count` が正で、終端を[越/こ]えないことを[検査/けんさ]します。
//: - 失敗時は original cursor owner を error に[保持/ほじ]します。
//: - payload の再読込は行わず、storage write 成功後の continuation 生成だけを[担当/たんとう]します。
pub fn gui_rgba8888_row_tile_rle_cursor_advance_by_run %fn GuiRgba8888RowTileRleCursorOwner fn &GuiRgba8888RowTileRleRun Result GuiRgba8888RowTileRleCursorOwner GuiRgba8888RowTileRleStepError \cursor\run:
    match gui_rgba8888_row_tile_rle_run_advance_index &cursor run:
        Result::Err kind:
            Result::Err gui_rgba8888_row_tile_rle_step_error kind cursor
        Result::Ok next_pixel_index:
            let pixel_count %i32 gui_rgba8888_row_tile_rle_cursor_pixel_count &cursor
            let payload %GuiRgba8888RowTilePayloadOwner field::get cursor "payload"
            Result::Ok gui_rgba8888_row_tile_rle_cursor_owner_new payload pixel_count next_pixel_index

//: gui_rgba8888_row_tile_rle_cursor_next_run: cursor を 1 pixel run [進/すす]める
//:
//: [契約/けいやく]:
//: - Ready cursor では現在 pixel の color を[読/よ]み、同色の連続 run を[数/かぞ]えます。
//: - Complete cursor は `CursorComplete` error として cursor owner を[返/かえ]します。
//: - 成功時は continuation cursor owner と Copy run metadata を[返/かえ]します。
pub fn gui_rgba8888_row_tile_rle_cursor_next_run %fn GuiRgba8888RowTileRleCursorOwner Result GuiRgba8888RowTileRleStep GuiRgba8888RowTileRleStepError \cursor:
    match gui_rgba8888_row_tile_rle_cursor_status &cursor:
