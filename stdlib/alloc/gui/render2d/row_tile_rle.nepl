fn gui_rgba8888_row_tile_rle_step_new %fn GuiRgba8888RowTileRleCursorOwner fn GuiRgba8888RowTileRleRun GuiRgba8888RowTileRleStep \cursor\run:
    GuiRgba8888RowTileRleStep cursor run

fn gui_rgba8888_row_tile_rle_start_error_category %fn GuiRgba8888RowTileRleStartErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowTileRleStartErrorKind::PayloadByteCountInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRleStartErrorKind::PayloadByteCountNotRgbaAligned:
            Option::Some GuiError::InvalidGeometry

fn gui_rgba8888_row_tile_rle_step_error_category %fn GuiRgba8888RowTileRleStepErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowTileRleStepErrorKind::PixelByteOffsetOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRleStepErrorKind::PixelByteChannelOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowTileRleStepErrorKind::PayloadReadFailed _:
            Option::Some GuiError::InvalidCommand
        _:
            Option::Some GuiError::InvalidCommand

fn gui_rgba8888_row_tile_rle_start_error %fn GuiRgba8888RowTileRleStartErrorKind fn GuiRgba8888RowTilePayloadOwner GuiRgba8888RowTileRleStartError \kind\payload:
    let category %Option GuiError gui_rgba8888_row_tile_rle_start_error_category kind
    GuiRgba8888RowTileRleStartError kind category payload

fn gui_rgba8888_row_tile_rle_step_error %fn GuiRgba8888RowTileRleStepErrorKind fn GuiRgba8888RowTileRleCursorOwner GuiRgba8888RowTileRleStepError \kind\cursor:
    let category %Option GuiError gui_rgba8888_row_tile_rle_step_error_category kind
    GuiRgba8888RowTileRleStepError kind category cursor

fn gui_rgba8888_row_tile_rle_checked_mul_nonnegative %fn i32 fn i32 fn GuiRgba8888RowTileRleStepErrorKind Result i32 GuiRgba8888RowTileRleStepErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

fn gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta %fn i32 fn i32 fn GuiRgba8888RowTileRleStepErrorKind Result i32 GuiRgba8888RowTileRleStepErrorKind \base\delta\overflow_kind:
    if lt delta 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 2147483647
            let max_base %i32 sub max_i32 delta
            if gt base max_base:
                then Result::Err overflow_kind
                else Result::Ok add base delta

fn gui_rgba8888_row_tile_rle_payload_byte_at %fn &GuiRgba8888RowTilePayloadOwner fn i32 Result i32 GuiRgba8888RowTileRleStepErrorKind \payload\index:
    match gui_rgba8888_row_tile_payload_byte_at payload index:
        Result::Err kind:
            Result::Err GuiRgba8888RowTileRleStepErrorKind::PayloadReadFailed kind
        Result::Ok value:
            Result::Ok value

fn gui_rgba8888_row_tile_rle_pixel_byte_offset %fn i32 Result i32 GuiRgba8888RowTileRleStepErrorKind \pixel_index:
    gui_rgba8888_row_tile_rle_checked_mul_nonnegative pixel_index 4 GuiRgba8888RowTileRleStepErrorKind::PixelByteOffsetOverflow

fn gui_rgba8888_row_tile_rle_read_pixel %fn &GuiRgba8888RowTilePayloadOwner fn i32 Result Rgba8888 GuiRgba8888RowTileRleStepErrorKind \payload\pixel_index:
    match gui_rgba8888_row_tile_rle_pixel_byte_offset pixel_index:
        Result::Err kind:
            Result::Err kind
        Result::Ok byte_offset:
            match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta byte_offset 1 GuiRgba8888RowTileRleStepErrorKind::PixelByteChannelOverflow:
                Result::Err kind:
                    Result::Err kind
                Result::Ok g_offset:
                    match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta byte_offset 2 GuiRgba8888RowTileRleStepErrorKind::PixelByteChannelOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok b_offset:
                            match gui_rgba8888_row_tile_rle_checked_add_nonnegative_delta byte_offset 3 GuiRgba8888RowTileRleStepErrorKind::PixelByteChannelOverflow:
                                Result::Err kind:
                                    Result::Err kind
                                Result::Ok a_offset:
                                    match gui_rgba8888_row_tile_rle_payload_byte_at payload byte_offset:
                                        Result::Err kind:
                                            Result::Err kind
                                        Result::Ok r:
                                            match gui_rgba8888_row_tile_rle_payload_byte_at payload g_offset:
                                                Result::Err kind:
                                                    Result::Err kind
                                                Result::Ok g:
                                                    match gui_rgba8888_row_tile_rle_payload_byte_at payload b_offset:
                                                        Result::Err kind:
                                                            Result::Err kind
                                                        Result::Ok b:
                                                            match gui_rgba8888_row_tile_rle_payload_byte_at payload a_offset:
                                                                Result::Err kind:
                                                                    Result::Err kind
                                                                Result::Ok a:
                                                                    let r_channel %u8 cast r
                                                                    let g_channel %u8 cast g
                                                                    let b_channel %u8 cast b
                                                                    let a_channel %u8 cast a
                                                                    Result::Ok rgba8888_new r_channel g_channel b_channel a_channel

fn gui_rgba8888_row_tile_rle_color_equal %fn &Rgba8888 fn &Rgba8888 bool \left\right:
    and:
        eq rgba8888_r left rgba8888_r right
        and:
            eq rgba8888_g left rgba8888_g right
            and:
                eq rgba8888_b left rgba8888_b right
                eq rgba8888_a left rgba8888_a right

