impl Clone for GuiRgba8888RowTileRleCursorStatus:
    fn clone %fn &GuiRgba8888RowTileRleCursorStatus GuiRgba8888RowTileRleCursorStatus \status:
        *status

impl Copy for GuiRgba8888RowTileRleCursorStatus:
    fn copy_mark %fn GuiRgba8888RowTileRleCursorStatus GuiRgba8888RowTileRleCursorStatus \status:
