impl Copy for GuiRgba8888RowTileRleStartErrorKind:
    fn copy_mark %fn GuiRgba8888RowTileRleStartErrorKind GuiRgba8888RowTileRleStartErrorKind \kind:
        kind

pub enum GuiRgba8888RowTileRleStepErrorKind:
    CursorIndexNegative
    CursorIndexPastEnd
    CursorComplete
    PixelByteOffsetOverflow
    PixelByteChannelOverflow
    PayloadReadFailed %GuiRgba8888RowTilePayloadReadErrorKind
    NextPixelIndexOverflow
    RunLengthOverflow
    RunPixelOffsetMismatch
    RunPixelCountInvalid
    RunEndOutOfBounds

impl Clone for GuiRgba8888RowTileRleStepErrorKind:
    fn clone %fn &GuiRgba8888RowTileRleStepErrorKind GuiRgba8888RowTileRleStepErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowTileRleStepErrorKind:
    fn copy_mark %fn GuiRgba8888RowTileRleStepErrorKind GuiRgba8888RowTileRleStepErrorKind \kind:
        kind

pub enum GuiRgba8888RowTileRleCursorStatus:
