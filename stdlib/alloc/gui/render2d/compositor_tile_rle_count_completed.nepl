#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorTileRleCountCompletedErrorKind: completed count bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower completed prepare error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
pub enum GuiRgba8888CompositorTileRleCountCompletedErrorKind:
    CompletedPrepareFailed %GuiRgba8888RowTileRleCountCompletedErrorKind

impl Clone for GuiRgba8888CompositorTileRleCountCompletedErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleCountCompletedErrorKind GuiRgba8888CompositorTileRleCountCompletedErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleCountCompletedErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleCountCompletedErrorKind GuiRgba8888CompositorTileRleCountCompletedErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleCountCompletedOwner: lower completed owner と compositor metadata の owner
//:
//: lower completed count evidence と copied frame metadata を 1 つの owner payload に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
pub struct GuiRgba8888CompositorTileRleCountCompletedOwner:
    completed %GuiRgba8888RowTileRleCountCompletedOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTileRleCountCompletedError: count owner を[回収/かいしゅう]できる completed error
//:
//: lower kind / category / progress と、metadata [付/つ]き compositor count owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
pub struct GuiRgba8888CompositorTileRleCountCompletedError:
    kind %GuiRgba8888CompositorTileRleCountCompletedErrorKind
    category %Option GuiError
    total_run_count %i32
    cursor_next_pixel_index %i32
    count %GuiRgba8888CompositorTileRleCountOwner

//: gui_rgba8888_compositor_tile_rle_count_completed_owner_new: completed owner と metadata を[束/たば]ねる
//:
//: lower completed prepare が[成功/せいこう]した後だけ呼ぶ module-private constructor です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_count_completed_owner_new %fn GuiRgba8888RowTileRleCountCompletedOwner fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleCountCompletedOwner \completed\metadata:
    GuiRgba8888CompositorTileRleCountCompletedOwner completed metadata

//: gui_rgba8888_compositor_tile_rle_count_completed_error_new: completed error payload を[作/つく]る
//:
//: lower kind、category、progress、回収用 count owner を 1 つの owner-bearing error にまとめます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_count_completed_error_new %fn GuiRgba8888CompositorTileRleCountCompletedErrorKind fn Option GuiError fn i32 fn i32 fn GuiRgba8888CompositorTileRleCountOwner GuiRgba8888CompositorTileRleCountCompletedError \kind\category\total_run_count\cursor_next_pixel_index\count:
    GuiRgba8888CompositorTileRleCountCompletedError kind category total_run_count cursor_next_pixel_index count

//: gui_rgba8888_compositor_tile_rle_count_completed_error_from_lower: lower completed error を compositor count error へ[写/うつ]す
//:
//: lower kind / category / progress を[読/よ]んでから lower count owner を[回収/かいしゅう]し、metadata [付/つ]き count owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_count_completed_error_from_lower %fn GuiRgba8888RowTileRleCountCompletedError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleCountCompletedError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRleCountCompletedErrorKind gui_rgba8888_row_tile_rle_count_completed_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_count_completed_error_category_value &lower
    let total_run_count %i32 gui_rgba8888_row_tile_rle_count_completed_error_total_run_count &lower
    let cursor_next_pixel_index %i32 gui_rgba8888_row_tile_rle_count_completed_error_cursor_next_pixel_index &lower
    let lower_count %GuiRgba8888RowTileRleCountOwner gui_rgba8888_row_tile_rle_count_completed_error_finish_count_owner lower
    let count %GuiRgba8888CompositorTileRleCountOwner GuiRgba8888CompositorTileRleCountOwner lower_count metadata
    let kind %GuiRgba8888CompositorTileRleCountCompletedErrorKind GuiRgba8888CompositorTileRleCountCompletedErrorKind::CompletedPrepareFailed lower_kind
    gui_rgba8888_compositor_tile_rle_count_completed_error_new kind category total_run_count cursor_next_pixel_index count

//: gui_rgba8888_compositor_tile_rle_count_completed_prepare: compositor count owner を completed evidence に[昇格/しょうかく]する
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower count owner を[取/と]り[出/だ]します。
//: - lower completed prepare を 1 [回/かい]だけ[呼/よ]び、success では completed owner と metadata を[束/たば]ねます。
//: - error では original lower count owner を metadata [付/つ]き compositor count owner に[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_count_completed_prepare %fn GuiRgba8888CompositorTileRleCountOwner Result GuiRgba8888CompositorTileRleCountCompletedOwner GuiRgba8888CompositorTileRleCountCompletedError \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_count_owner_metadata &owner
    let lower_count %GuiRgba8888RowTileRleCountOwner field::get owner "count"
    match gui_rgba8888_row_tile_rle_count_completed_prepare lower_count:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_count_completed_error_from_lower lower metadata
        Result::Ok completed:
            Result::Ok gui_rgba8888_compositor_tile_rle_count_completed_owner_new completed metadata

