//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_plan" as *
//: ```
pub enum GuiRgba8888CompositorTilePlanFreeErrorKind:
    FinishFailed %GuiRgba8888CompositorTilePlanFinishErrorKind
    EntryFreeFailed %GuiRgba8888SoftwareSurfaceErrorKind

impl Clone for GuiRgba8888CompositorTilePlanFreeErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePlanFreeErrorKind GuiRgba8888CompositorTilePlanFreeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePlanFreeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePlanFreeErrorKind GuiRgba8888CompositorTilePlanFreeErrorKind \kind:
        kind

