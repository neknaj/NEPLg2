impl Clone for GuiRgba8888CompositorTilePlanFinishErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePlanFinishErrorKind GuiRgba8888CompositorTilePlanFinishErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePlanFinishErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePlanFinishErrorKind GuiRgba8888CompositorTilePlanFinishErrorKind \kind:
        kind

//: GuiRgba8888CompositorTilePlanFreeErrorKind: compositor tile plan free の[失敗/しっぱい][段階/だんかい]
//:
//: tile plan finish failure と、finish 成功後の entry free failure を[分/わ]けて[返/かえ]します。
