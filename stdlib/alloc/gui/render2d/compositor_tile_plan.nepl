//: gui_rgba8888_compositor_tile_plan_prepare: compositor byte storage owner から tile plan owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower storage owner を[取/と]り[出/だ]します。
//: - lower row tile plan prepare のみを[呼/よ]び、payload / RLE / present へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_plan" as *
//: ```
pub fn gui_rgba8888_compositor_tile_plan_prepare %fn GuiRgba8888CompositorByteStorageOwner fn GuiRgba8888RowTilePlanConfig Result GuiRgba8888CompositorTilePlanOwner GuiRgba8888CompositorTilePlanPrepareError \storage_owner\config:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_byte_storage_owner_metadata &storage_owner
    let lower_storage %GuiRgba8888RowByteStorageOwner field::get storage_owner "storage"
    match gui_rgba8888_row_tile_plan_prepare lower_storage config:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_plan_prepare_error_from_lower lower metadata
        Result::Ok plan:
            Result::Ok gui_rgba8888_compositor_tile_plan_owner_new plan metadata

