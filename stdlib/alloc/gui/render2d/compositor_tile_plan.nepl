#import "alloc/gui/render2d/software_surface" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorTilePlanPrepareErrorKind: compositor tile plan prepare の[失敗/しっぱい][段階/だんかい]
//:
//: lower row tile plan prepare の kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_plan" as *
//: ```
pub enum GuiRgba8888CompositorTilePlanPrepareErrorKind:
    RowTilePlanPrepareFailed %GuiRgba8888RowTilePlanPrepareErrorKind

impl Clone for GuiRgba8888CompositorTilePlanPrepareErrorKind:
    fn clone %fn &GuiRgba8888CompositorTilePlanPrepareErrorKind GuiRgba8888CompositorTilePlanPrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTilePlanPrepareErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTilePlanPrepareErrorKind GuiRgba8888CompositorTilePlanPrepareErrorKind \kind:
        kind

//: GuiRgba8888CompositorTilePlanFinishErrorKind: tile plan から entry へ[戻/もど]す[失敗/しっぱい]
//:
//: compositor byte storage finish failure を tile plan boundary の typed error として[包/つつ]みます。
//:
//: neplg2:test[skip]
