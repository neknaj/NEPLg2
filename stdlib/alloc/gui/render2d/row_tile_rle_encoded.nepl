fn gui_rgba8888_row_tile_rle_encoded_checked_mul_nonnegative %fn i32 fn i32 fn GuiRgba8888RowTileRleEncodedSealErrorKind Result i32 GuiRgba8888RowTileRleEncodedSealErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

fn gui_rgba8888_row_tile_rle_encoded_validate_counts %fn &GuiRgba8888RowTileRleWriteCursorOwner Result unit GuiRgba8888RowTileRleEncodedSealErrorKind \owner:
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_write_cursor_owner_encoded_byte_count owner
    if le encoded_byte_count 0:
        then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::EncodedByteCountInvalid
        else:
            let total_run_count %i32 gui_rgba8888_row_tile_rle_write_cursor_owner_total_run_count owner
            if le total_run_count 0:
                then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::TotalRunCountInvalid
                else:
                    match gui_rgba8888_row_tile_rle_encoded_checked_mul_nonnegative total_run_count 12 GuiRgba8888RowTileRleEncodedSealErrorKind::EncodedByteCountOverflow:
                        Result::Err kind:
                            Result::Err kind
                        Result::Ok expected_byte_count:
                            if ne expected_byte_count encoded_byte_count:
                                then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::EncodedByteCountMismatch
                                else:
                                    let written_run_count %i32 gui_rgba8888_row_tile_rle_write_cursor_owner_written_run_count owner
                                    if or lt written_run_count 0 gt written_run_count total_run_count:
                                        then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::WrittenRunCountInvalid
                                        else:
                                            let written_byte_count %i32 gui_rgba8888_row_tile_rle_write_cursor_owner_written_byte_count owner
                                            if or lt written_byte_count 0 gt written_byte_count encoded_byte_count:
                                                then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::WrittenByteCountInvalid
                                                else:
                                                    match gui_rgba8888_row_tile_rle_encoded_checked_mul_nonnegative written_run_count 12 GuiRgba8888RowTileRleEncodedSealErrorKind::WrittenByteCountMismatch:
                                                        Result::Err kind:
                                                            Result::Err kind
                                                        Result::Ok expected_written_byte_count:
                                                            if ne expected_written_byte_count written_byte_count:
                                                                then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::WrittenByteCountMismatch
                                                                else:
                                                                    if ne written_run_count total_run_count:
                                                                        then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::WriterNotComplete
                                                                        else:
                                                                            if ne written_byte_count encoded_byte_count:
                                                                                then Result::Err GuiRgba8888RowTileRleEncodedSealErrorKind::WriterNotComplete
                                                                                else Result::Ok unit

fn gui_rgba8888_row_tile_rle_encoded_validate_cursor_complete %fn &GuiRgba8888RowTileRleWriteCursorOwner Result unit GuiRgba8888RowTileRleEncodedSealErrorKind \owner:
