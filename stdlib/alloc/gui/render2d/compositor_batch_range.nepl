#import "core/traits/copy" as *

pub enum GuiRgba8888CompositorBatchRangeErrorKind:
    CursorNextBatchFailed %GuiRgba8888RowBatchCursorErrorKind
    RowBatchRangePrepareFailed %GuiRgba8888RowBatchRangePrepareErrorKind

impl Clone for GuiRgba8888CompositorBatchRangeErrorKind:
    fn clone %fn &GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorBatchRangeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind \kind:
        kind

pub struct GuiRgba8888CompositorBatchRangeOwner:
    range %GuiRgba8888RowBatchRangeOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

pub struct GuiRgba8888CompositorBatchRangeError:
    kind %GuiRgba8888CompositorBatchRangeErrorKind
    category %Option GuiError
    entry %GuiRgba8888CompositorFrameEntryOwner

fn gui_rgba8888_compositor_batch_range_owner_new %fn GuiRgba8888RowBatchRangeOwner fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeOwner \range\metadata:
    GuiRgba8888CompositorBatchRangeOwner range metadata

fn gui_rgba8888_compositor_batch_range_error_new %fn GuiRgba8888CompositorBatchRangeErrorKind fn Option GuiError fn GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorBatchRangeError \kind\category\entry:
    GuiRgba8888CompositorBatchRangeError kind category entry

fn gui_rgba8888_compositor_batch_range_cursor_error_new %fn GuiRgba8888RowBatchCursorStepError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeError \lower\metadata:
    let lower_kind %GuiRgba8888RowBatchCursorErrorKind gui_rgba8888_row_batch_cursor_step_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_batch_cursor_step_error_category_value &lower
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_row_batch_cursor_step_error_cursor lower
    let entry %GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorFrameEntryOwner cursor metadata
    let kind %GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind::CursorNextBatchFailed lower_kind
    gui_rgba8888_compositor_batch_range_error_new kind category entry

fn gui_rgba8888_compositor_batch_range_prepare_error_new %fn GuiRgba8888RowBatchRangePrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeError \lower\metadata:
    let lower_kind %GuiRgba8888RowBatchRangePrepareErrorKind gui_rgba8888_row_batch_range_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_batch_range_prepare_error_category_value &lower
    let batch %GuiRgba8888RowBatchCursorBatchOwner gui_rgba8888_row_batch_range_prepare_error_batch lower
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_row_batch_cursor_batch_finish_cursor batch
    let entry %GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorFrameEntryOwner cursor metadata
    let kind %GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind::RowBatchRangePrepareFailed lower_kind
    gui_rgba8888_compositor_batch_range_error_new kind category entry

