//: gui_rgba8888_compositor_batch_range_prepare: compositor entry から 1 batch の range metadata を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - metadata を entry から Copy してから cursor を[取/と]り[出/だ]します。
//: - next batch と range prepare の lower boundary だけを[順番/じゅんばん]に[呼/よ]び、payload transport へは[進/すす]みません。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_batch_range_prepare %fn GuiRgba8888CompositorFrameEntryOwner Result GuiRgba8888CompositorBatchRangeOwner GuiRgba8888CompositorBatchRangeError \entry:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_frame_entry_metadata &entry
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_compositor_frame_entry_finish_cursor entry
    match gui_rgba8888_row_batch_cursor_next_batch cursor:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_batch_range_cursor_error_new lower metadata
        Result::Ok batch:
            match gui_rgba8888_row_batch_range_prepare batch:
                Result::Err lower:
                    Result::Err gui_rgba8888_compositor_batch_range_prepare_error_new lower metadata
                Result::Ok range:
                    Result::Ok gui_rgba8888_compositor_batch_range_owner_new range metadata

//: gui_rgba8888_compositor_batch_range_owner_finish_entry: range owner から compositor entry owner を[再構成/さいこうせい]する
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower range owner を cursor owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_batch_range_owner_finish_entry %fn GuiRgba8888CompositorBatchRangeOwner GuiRgba8888CompositorFrameEntryOwner \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_batch_range_owner_metadata &owner
    let range %GuiRgba8888RowBatchRangeOwner field::get owner "range"
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_row_batch_range_owner_finish_cursor range
    GuiRgba8888CompositorFrameEntryOwner cursor metadata

//: gui_rgba8888_compositor_batch_range_error_finish_entry: error owner から compositor entry owner を[取/と]り[出/だ]す
//:
//: caller が error recovery を[選/えら]んだとき、error payload 内に[保持/ほじ]した entry owner を[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_batch_range_error_finish_entry %fn GuiRgba8888CompositorBatchRangeError GuiRgba8888CompositorFrameEntryOwner \error:
    field::get error "entry"

//: gui_rgba8888_compositor_batch_range_owner_free: range owner 内の lower range owner を[閉/と]じる
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_batch_range_owner_free %fn GuiRgba8888CompositorBatchRangeOwner Result unit GuiRgba8888SoftwareSurfaceErrorKind \owner:
    let range %GuiRgba8888RowBatchRangeOwner field::get owner "range"
    gui_rgba8888_row_batch_range_owner_free range

//: gui_rgba8888_compositor_batch_range_error_free: error owner 内の entry owner を[閉/と]じる
//:
//: neplg2:test[skip]
pub fn gui_rgba8888_compositor_batch_range_error_free %fn GuiRgba8888CompositorBatchRangeError Result unit GuiRgba8888SoftwareSurfaceErrorKind \error:
    let entry %GuiRgba8888CompositorFrameEntryOwner gui_rgba8888_compositor_batch_range_error_finish_entry error
    gui_rgba8888_compositor_frame_entry_owner_free entry
