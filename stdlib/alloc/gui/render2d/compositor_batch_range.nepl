//: # alloc/gui/render2d/compositor_batch_range
//: RGBA8888 compositor row batch range bridge boundary
//:
//: ### [目的/もくてき]
//: - F5lz の `GuiRgba8888CompositorFrameEntryOwner` から 1 batch [分/ぶん]の row range metadata を[取/と]り[出/だ]します。
//: - compositor frame metadata を row batch range owner と[束/たば]ね、後続の row byte storage / tile transport が frame continuation として[戻/もど]せるようにします。
//:
//: ### [契約/けいやく]
//: - entry owner を cursor へ[分解/ぶんかい]する[前/まえ]に metadata を Copy value として[読/よ]みます。
//: - lower `gui_rgba8888_row_batch_cursor_next_batch` と `gui_rgba8888_row_batch_range_prepare` をそれぞれ 1 [回/かい]だけ[呼/よ]びます。
//: - lower error は kind / category を[読/よ]んでから entry owner へ[正規化/せいきか]し、caller が recovery / free を[選/えら]べるようにします。
//:
//: ### [注意/ちゅうい]
//: - complete cursor は lower `CursorIndexPastEnd` error として entry owner に[戻/もど]します。
//: - この module は range metadata までで[止/と]まります。row byte storage、tile / RLE、std present、host / platform API、video memory、Canvas / DOM / minifb、fallback / silent no-op には[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_batch_range" as *
//: ```

#indent 4

#import "alloc/gui/render2d/compositor_frame_entry" as *
#import "alloc/gui/render2d/row_batch_cursor" as *
#import "alloc/gui/render2d/row_batch_range" as *
#import "alloc/gui/render2d/software_surface" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorBatchRangeErrorKind: compositor batch range prepare の[失敗/しっぱい][段階/だんかい]
//:
//: lower row batch cursor の next batch 取得と row batch range prepare のどちらで[止/と]まったかを typed kind として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub enum GuiRgba8888CompositorBatchRangeErrorKind:
    CursorNextBatchFailed %GuiRgba8888RowBatchCursorErrorKind
    RowBatchRangePrepareFailed %GuiRgba8888RowBatchRangePrepareErrorKind

impl Clone for GuiRgba8888CompositorBatchRangeErrorKind:
    fn clone %fn &GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorBatchRangeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind \kind:
        kind

//: GuiRgba8888CompositorBatchRangeOwner: range owner と frame metadata を[束/たば]ねる owner
//:
//: row batch range owner を[保持/ほじ]しながら、後続の byte storage / tile transport が compositor frame entry metadata を[参照/さんしょう]できるようにします。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorBatchRangeOwner:
    range %GuiRgba8888RowBatchRangeOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorBatchRangeError: range prepare 失敗時に entry owner を[回収/かいしゅう]する error
//:
//: lower error kind / category と、caller へ[戻/もど]す compositor frame entry owner を 1 payload に[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub struct GuiRgba8888CompositorBatchRangeError:
    kind %GuiRgba8888CompositorBatchRangeErrorKind
    category %Option GuiError
    entry %GuiRgba8888CompositorFrameEntryOwner

//: gui_rgba8888_compositor_batch_range_owner_new: range owner と metadata を owner payload に[束/たば]ねる
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_batch_range_owner_new %fn GuiRgba8888RowBatchRangeOwner fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeOwner \range\metadata:
    GuiRgba8888CompositorBatchRangeOwner range metadata

//: gui_rgba8888_compositor_batch_range_error_new: range prepare error payload を[作/つく]る
//:
//: lower error から[読/よ]んだ kind / category と、再構成済み entry owner を owner-bearing error に[束/たば]ねます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_batch_range_error_new %fn GuiRgba8888CompositorBatchRangeErrorKind fn Option GuiError fn GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorBatchRangeError \kind\category\entry:
    GuiRgba8888CompositorBatchRangeError kind category entry

//: gui_rgba8888_compositor_batch_range_cursor_error_new: cursor step error を compositor range error へ[写/うつ]す
//:
//: lower cursor error から kind / category と cursor owner を[取/と]り[出/だ]し、metadata と[一緒/いっしょ]に entry owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_batch_range_cursor_error_new %fn GuiRgba8888RowBatchCursorStepError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeError \lower\metadata:
    let lower_kind %GuiRgba8888RowBatchCursorErrorKind gui_rgba8888_row_batch_cursor_step_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_batch_cursor_step_error_category_value &lower
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_row_batch_cursor_step_error_cursor lower
    let entry %GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorFrameEntryOwner cursor metadata
    let kind %GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind::CursorNextBatchFailed lower_kind
    gui_rgba8888_compositor_batch_range_error_new kind category entry

//: gui_rgba8888_compositor_batch_range_prepare_error_new: lower range prepare error を compositor range error へ[写/うつ]す
//:
//: lower batch owner を cursor owner へ[戻/もど]し、metadata と[一緒/いっしょ]に entry owner を[再構成/さいこうせい]して caller の recovery 境界を[保/たも]ちます。
//:
//: neplg2:test[skip]
fn gui_rgba8888_compositor_batch_range_prepare_error_new %fn GuiRgba8888RowBatchRangePrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorBatchRangeError \lower\metadata:
    let lower_kind %GuiRgba8888RowBatchRangePrepareErrorKind gui_rgba8888_row_batch_range_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_batch_range_prepare_error_category_value &lower
    let batch %GuiRgba8888RowBatchCursorBatchOwner gui_rgba8888_row_batch_range_prepare_error_batch lower
    let cursor %GuiRgba8888RowBatchCursorOwner gui_rgba8888_row_batch_cursor_batch_finish_cursor batch
    let entry %GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorFrameEntryOwner cursor metadata
    let kind %GuiRgba8888CompositorBatchRangeErrorKind GuiRgba8888CompositorBatchRangeErrorKind::RowBatchRangePrepareFailed lower_kind
    gui_rgba8888_compositor_batch_range_error_new kind category entry

//: gui_rgba8888_compositor_batch_range_owner_metadata: owner に[保持/ほじ]した frame metadata を[返/かえ]す
