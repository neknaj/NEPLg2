fn gui_rgba8888_row_batch_cursor_owner_new %fn GuiRgba8888RowBatchPlanOwner fn i32 GuiRgba8888RowBatchCursorOwner \plan\batch_index:
    GuiRgba8888RowBatchCursorOwner plan batch_index

fn gui_rgba8888_row_batch_descriptor_new %fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 GuiRgba8888RowBatchDescriptor \frame_id\batch_index\row_start\row_count\width\height\stride_bytes\byte_len:
    GuiRgba8888RowBatchDescriptor frame_id batch_index row_start row_count width height stride_bytes byte_len

fn gui_rgba8888_row_batch_cursor_batch_owner_new %fn GuiRgba8888RowBatchCursorOwner fn GuiRgba8888RowBatchDescriptor GuiRgba8888RowBatchCursorBatchOwner \cursor\descriptor:
    GuiRgba8888RowBatchCursorBatchOwner cursor descriptor

fn gui_rgba8888_row_batch_cursor_error_category %fn GuiRgba8888RowBatchCursorErrorKind Option GuiError \kind:
    match kind:
        GuiRgba8888RowBatchCursorErrorKind::PlanInvariant _:
            Option::Some GuiError::InvalidCommand
        GuiRgba8888RowBatchCursorErrorKind::BatchOffsetOverflow:
            Option::Some GuiError::InvalidGeometry
        GuiRgba8888RowBatchCursorErrorKind::BatchBoundsInvalid:
            Option::Some GuiError::InvalidGeometry
        _:
            Option::Some GuiError::InvalidCommand

fn gui_rgba8888_row_batch_cursor_start_error %fn GuiRgba8888RowBatchCursorErrorKind fn GuiRgba8888RowBatchPlanOwner GuiRgba8888RowBatchCursorStartError \kind\plan:
    let category %Option GuiError gui_rgba8888_row_batch_cursor_error_category kind
    GuiRgba8888RowBatchCursorStartError kind category plan

fn gui_rgba8888_row_batch_cursor_step_error %fn GuiRgba8888RowBatchCursorErrorKind fn GuiRgba8888RowBatchCursorOwner GuiRgba8888RowBatchCursorStepError \kind\cursor:
    let category %Option GuiError gui_rgba8888_row_batch_cursor_error_category kind
