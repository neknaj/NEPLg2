pub enum GuiRgba8888RowBatchCursorErrorKind:
    PlanInvariant %GuiRgba8888RowBatchPlanInvariantErrorKind
    CursorIndexNegative
    CursorIndexPastEnd
    BatchOffsetOverflow
    BatchBoundsInvalid
    NextCursorIndexOverflow

impl Clone for GuiRgba8888RowBatchCursorErrorKind:
    fn clone %fn &GuiRgba8888RowBatchCursorErrorKind GuiRgba8888RowBatchCursorErrorKind \kind:
        *kind

impl Copy for GuiRgba8888RowBatchCursorErrorKind:
    fn copy_mark %fn GuiRgba8888RowBatchCursorErrorKind GuiRgba8888RowBatchCursorErrorKind \kind:
        kind

pub enum GuiRgba8888RowBatchCursorStatus:
    Ready
    Complete

impl Clone for GuiRgba8888RowBatchCursorStatus:
    fn clone %fn &GuiRgba8888RowBatchCursorStatus GuiRgba8888RowBatchCursorStatus \status:
        *status

impl Copy for GuiRgba8888RowBatchCursorStatus:
    fn copy_mark %fn GuiRgba8888RowBatchCursorStatus GuiRgba8888RowBatchCursorStatus \status:
        status

pub struct GuiRgba8888RowBatchDescriptor:
    frame_id %i32
    batch_index %i32
    row_start %i32
    row_count %i32
    width %i32
    height %i32
    stride_bytes %i32
    byte_len %i32

impl Clone for GuiRgba8888RowBatchDescriptor:
    fn clone %fn &GuiRgba8888RowBatchDescriptor GuiRgba8888RowBatchDescriptor \descriptor:
        *descriptor

impl Copy for GuiRgba8888RowBatchDescriptor:
    fn copy_mark %fn GuiRgba8888RowBatchDescriptor GuiRgba8888RowBatchDescriptor \descriptor:
        descriptor

pub struct GuiRgba8888RowBatchCursorOwner:
    plan %GuiRgba8888RowBatchPlanOwner
    batch_index %i32

pub struct GuiRgba8888RowBatchCursorStartError:
    kind %GuiRgba8888RowBatchCursorErrorKind
    category %Option GuiError
