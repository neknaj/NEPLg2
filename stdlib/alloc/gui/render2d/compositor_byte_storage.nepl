fn gui_rgba8888_compositor_byte_storage_prepare_error_from_lower %fn GuiRgba8888RowByteStoragePrepareError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorByteStoragePrepareError \lower\metadata:
    let lower_kind %GuiRgba8888RowByteStoragePrepareErrorKind gui_rgba8888_row_byte_storage_prepare_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_byte_storage_prepare_error_category_value &lower
    let lower_range %GuiRgba8888RowBatchRangeOwner gui_rgba8888_row_byte_storage_prepare_error_owner lower
    let range %GuiRgba8888CompositorBatchRangeOwner GuiRgba8888CompositorBatchRangeOwner lower_range metadata
    let kind %GuiRgba8888CompositorByteStoragePrepareErrorKind GuiRgba8888CompositorByteStoragePrepareErrorKind::RowByteStoragePrepareFailed lower_kind
    gui_rgba8888_compositor_byte_storage_prepare_error_new kind category range

//: gui_rgba8888_compositor_byte_storage_finish_error_from_lower: lower finish error を compositor entry error へ[写/うつ]す
//:
//: lower kind を[読/よ]んでから cursor を[取/と]り[出/だ]し、metadata [付/つ]き entry owner を[復元/ふくげん]します。
