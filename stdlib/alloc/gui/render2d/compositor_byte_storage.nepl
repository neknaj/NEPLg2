//: gui_rgba8888_compositor_byte_storage_prepare: compositor range owner から copied byte storage owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower range owner を[取/と]り[出/だ]します。
//: - lower row byte storage prepare のみを[呼/よ]び、tile / RLE / present へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub fn gui_rgba8888_compositor_byte_storage_prepare %fn GuiRgba8888CompositorBatchRangeOwner Result GuiRgba8888CompositorByteStorageOwner GuiRgba8888CompositorByteStoragePrepareError \range_owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_batch_range_owner_metadata &range_owner
    let lower_range %GuiRgba8888RowBatchRangeOwner field::get range_owner "range"
    match gui_rgba8888_row_byte_storage_prepare lower_range:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_byte_storage_prepare_error_from_lower lower metadata
        Result::Ok storage:
            Result::Ok gui_rgba8888_compositor_byte_storage_owner_new storage metadata

