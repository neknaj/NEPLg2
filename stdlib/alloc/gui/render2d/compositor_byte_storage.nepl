    field::get error "entry"

//: gui_rgba8888_compositor_byte_storage_owner_finish_entry: copied bytes を[破棄/はき]して compositor entry owner を[返/かえ]す
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower storage owner を[消費/しょうひ]します。
//: - lower finish failure でも recovered cursor と metadata から entry owner を[再構成/さいこうせい]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub fn gui_rgba8888_compositor_byte_storage_owner_finish_entry %fn GuiRgba8888CompositorByteStorageOwner Result GuiRgba8888CompositorFrameEntryOwner GuiRgba8888CompositorByteStorageFinishError \owner:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_byte_storage_owner_metadata &owner
    let storage %GuiRgba8888RowByteStorageOwner field::get owner "storage"
    match gui_rgba8888_row_byte_storage_finish_cursor storage:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_byte_storage_finish_error_from_lower lower metadata
        Result::Ok cursor:
            Result::Ok GuiRgba8888CompositorFrameEntryOwner cursor metadata

//: gui_rgba8888_compositor_byte_storage_prepare_error_free: prepare error の range owner を[破棄/はき]する
//:
//: error から range owner を[取/と]り[出/だ]し、既存の compositor batch range free に[委譲/いじょう]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub fn gui_rgba8888_compositor_byte_storage_prepare_error_free %fn GuiRgba8888CompositorByteStoragePrepareError Result unit GuiRgba8888SoftwareSurfaceErrorKind \error:
    let range %GuiRgba8888CompositorBatchRangeOwner gui_rgba8888_compositor_byte_storage_prepare_error_range error
    gui_rgba8888_compositor_batch_range_owner_free range

//: gui_rgba8888_compositor_byte_storage_finish_error_free: finish error の entry owner を[破棄/はき]する
//:
//: error から entry owner を[取/と]り[出/だ]し、既存の compositor frame entry free に[委譲/いじょう]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub fn gui_rgba8888_compositor_byte_storage_finish_error_free %fn GuiRgba8888CompositorByteStorageFinishError Result unit GuiRgba8888SoftwareSurfaceErrorKind \error:
    let entry %GuiRgba8888CompositorFrameEntryOwner gui_rgba8888_compositor_byte_storage_finish_error_finish_entry error
    gui_rgba8888_compositor_frame_entry_owner_free entry

//: gui_rgba8888_compositor_byte_storage_owner_free: byte storage owner を[閉/と]じて entry owner まで[破棄/はき]する
//:
//: finish failure と finish 成功後の entry free failure を[区別/くべつ]して[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub fn gui_rgba8888_compositor_byte_storage_owner_free %fn GuiRgba8888CompositorByteStorageOwner Result unit GuiRgba8888CompositorByteStorageFreeErrorKind \owner:
    match gui_rgba8888_compositor_byte_storage_owner_finish_entry owner:
        Result::Err error:
            let kind %GuiRgba8888CompositorByteStorageFinishErrorKind gui_rgba8888_compositor_byte_storage_finish_error_kind &error
            let entry %GuiRgba8888CompositorFrameEntryOwner gui_rgba8888_compositor_byte_storage_finish_error_finish_entry error
            match gui_rgba8888_compositor_frame_entry_owner_free entry:
                Result::Err _:
                    Result::Err GuiRgba8888CompositorByteStorageFreeErrorKind::FinishFailed kind
                Result::Ok _:
                    Result::Err GuiRgba8888CompositorByteStorageFreeErrorKind::FinishFailed kind
        Result::Ok entry:
            match gui_rgba8888_compositor_frame_entry_owner_free entry:
                Result::Err kind:
                    Result::Err GuiRgba8888CompositorByteStorageFreeErrorKind::EntryFreeFailed kind
                Result::Ok _:
                    Result::Ok unit
