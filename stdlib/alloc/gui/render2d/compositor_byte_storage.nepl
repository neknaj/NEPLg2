#import "alloc/gui/render2d/row_batch_range" as *
#import "alloc/gui/render2d/row_byte_storage" as *
#import "alloc/gui/render2d/software_surface" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorByteStoragePrepareErrorKind: compositor byte storage prepare の[失敗/しっぱい][段階/だんかい]
//:
//: lower row byte storage prepare の kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub enum GuiRgba8888CompositorByteStoragePrepareErrorKind:
    RowByteStoragePrepareFailed %GuiRgba8888RowByteStoragePrepareErrorKind

impl Clone for GuiRgba8888CompositorByteStoragePrepareErrorKind:
    fn clone %fn &GuiRgba8888CompositorByteStoragePrepareErrorKind GuiRgba8888CompositorByteStoragePrepareErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorByteStoragePrepareErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorByteStoragePrepareErrorKind GuiRgba8888CompositorByteStoragePrepareErrorKind \kind:
        kind

//: GuiRgba8888CompositorByteStorageFinishErrorKind: byte storage から entry へ[戻/もど]す[失敗/しっぱい]
//:
//: lower storage dealloc / cursor free failure を compositor boundary の typed error として[包/つつ]みます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub enum GuiRgba8888CompositorByteStorageFinishErrorKind:
    RowByteStorageFinishFailed %GuiRgba8888RowByteStorageFinishErrorKind

impl Clone for GuiRgba8888CompositorByteStorageFinishErrorKind:
    fn clone %fn &GuiRgba8888CompositorByteStorageFinishErrorKind GuiRgba8888CompositorByteStorageFinishErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorByteStorageFinishErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorByteStorageFinishErrorKind GuiRgba8888CompositorByteStorageFinishErrorKind \kind:
        kind

//: GuiRgba8888CompositorByteStorageFreeErrorKind: compositor byte storage free の[失敗/しっぱい][段階/だんかい]
//:
//: byte storage finish failure と、finish 成功後の entry free failure を[分/わ]けて[返/かえ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_byte_storage" as *
//: ```
pub enum GuiRgba8888CompositorByteStorageFreeErrorKind:
    FinishFailed %GuiRgba8888CompositorByteStorageFinishErrorKind
    EntryFreeFailed %GuiRgba8888SoftwareSurfaceErrorKind

impl Clone for GuiRgba8888CompositorByteStorageFreeErrorKind:
    fn clone %fn &GuiRgba8888CompositorByteStorageFreeErrorKind GuiRgba8888CompositorByteStorageFreeErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorByteStorageFreeErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorByteStorageFreeErrorKind GuiRgba8888CompositorByteStorageFreeErrorKind \kind:
        kind

