    GuiRgba8888CompositorTileRleWriteStepError kind category owner

//: gui_rgba8888_compositor_tile_rle_write_step_error_from_lower: lower write step error を compositor write cursor error へ[写/うつ]す
//:
//: lower kind / category を[読/よ]んでから lower write cursor owner を[回収/かいしゅう]し、metadata [付/つ]き write cursor owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_write_step" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_write_step_error_from_lower %fn GuiRgba8888RowTileRleWriteStepError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleWriteStepError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRleWriteStepErrorKind gui_rgba8888_row_tile_rle_write_step_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_write_step_error_category_value &lower
    let lower_owner %GuiRgba8888RowTileRleWriteCursorOwner gui_rgba8888_row_tile_rle_write_step_error_finish_owner lower
    let owner %GuiRgba8888CompositorTileRleWriteCursorOwner GuiRgba8888CompositorTileRleWriteCursorOwner lower_owner metadata
    let kind %GuiRgba8888CompositorTileRleWriteStepErrorKind GuiRgba8888CompositorTileRleWriteStepErrorKind::WriteStepFailed lower_kind
    gui_rgba8888_compositor_tile_rle_write_step_error_new kind category owner

