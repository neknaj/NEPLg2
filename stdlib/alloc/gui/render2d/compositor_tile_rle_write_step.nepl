//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_write_step" as *
//: ```
pub enum GuiRgba8888CompositorTileRleWriteStepErrorKind:
    WriteStepFailed %GuiRgba8888RowTileRleWriteStepErrorKind

impl Clone for GuiRgba8888CompositorTileRleWriteStepErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleWriteStepErrorKind GuiRgba8888CompositorTileRleWriteStepErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleWriteStepErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleWriteStepErrorKind GuiRgba8888CompositorTileRleWriteStepErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleWriteStep: lower step status と compositor write cursor owner の terminal
