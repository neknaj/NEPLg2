//: # alloc/gui/render2d/compositor_tile_rle_writer_plan
//: RGBA8888 compositor tile RLE writer capacity plan bridge boundary
//:
//: ### [目的/もくてき]
//: - F5mj の `GuiRgba8888CompositorTileRleEncodeCursorOwner` を lower writer capacity plan へ[渡/わた]します。
//: - lower writer plan owner と compositor metadata を[束/たば]ね、後続 storage / writer boundary が exact encoded byte count を[失/うしな]わないようにします。
//:
//: ### [契約/けいやく]
//: - ready cursor owner を lower ready owner へ[分解/ぶんかい]する[前/まえ]に metadata を Copy value として[読/よ]みます。
//: - lower `gui_rgba8888_row_tile_rle_writer_plan_prepare` を 1 [回/かい]だけ[呼/よ]びます。
//: - lower writer plan error では lower kind / category / total run count を[読/よ]んでから lower ready owner を metadata [付/つ]き compositor ready cursor owner へ[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - storage allocation、write step、encoded seal、packet、std present、host / platform API、video memory、Canvas / DOM / minifb、raw byte access、fallback / silent no-op は[含/ふく]めません。
//: - encoded storage と present continuation は後続 boundary で[扱/あつか]います。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```

#indent 4

#import "alloc/gui/render2d/compositor_frame_entry" as *
#import "alloc/gui/render2d/compositor_tile_payload" as *
#import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
#import "alloc/gui/render2d/row_tile_payload" as *
#import "alloc/gui/render2d/row_tile_rle" as *
#import "alloc/gui/render2d/row_tile_rle_encode_cursor" as *
#import "alloc/gui/render2d/row_tile_rle_writer_plan" as *
#import "core/field" as field
#import "core/gui/error" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiRgba8888CompositorTileRleWriterPlanErrorKind: writer capacity bridge の[失敗/しっぱい][段階/だんかい]
//:
//: lower writer plan error kind を Copy value として[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
pub enum GuiRgba8888CompositorTileRleWriterPlanErrorKind:
    WriterPlanPrepareFailed %GuiRgba8888RowTileRleWriterPlanErrorKind

impl Clone for GuiRgba8888CompositorTileRleWriterPlanErrorKind:
    fn clone %fn &GuiRgba8888CompositorTileRleWriterPlanErrorKind GuiRgba8888CompositorTileRleWriterPlanErrorKind \kind:
        *kind

impl Copy for GuiRgba8888CompositorTileRleWriterPlanErrorKind:
    fn copy_mark %fn GuiRgba8888CompositorTileRleWriterPlanErrorKind GuiRgba8888CompositorTileRleWriterPlanErrorKind \kind:
        kind

//: GuiRgba8888CompositorTileRleWriterPlanOwner: lower writer plan owner と compositor metadata の owner
//:
//: encoded byte capacity evidence と copied frame metadata を 1 つの owner payload に[束/たば]ねます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
pub struct GuiRgba8888CompositorTileRleWriterPlanOwner:
    plan %GuiRgba8888RowTileRleWriterPlanOwner
    metadata %GuiRgba8888CompositorFrameEntryMetadata

//: GuiRgba8888CompositorTileRleWriterPlanError: ready cursor owner を[回収/かいしゅう]できる writer plan error
//:
//: lower writer plan error の kind / category / total run count と、metadata [付/つ]き ready cursor owner を[保持/ほじ]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
pub struct GuiRgba8888CompositorTileRleWriterPlanError:
    kind %GuiRgba8888CompositorTileRleWriterPlanErrorKind
    category %Option GuiError
    total_run_count %i32
    ready %GuiRgba8888CompositorTileRleEncodeCursorOwner

//: gui_rgba8888_compositor_tile_rle_writer_plan_owner_new: writer plan owner と metadata を[束/たば]ねる
//:
//: lower writer plan prepare が[成功/せいこう]した後だけ呼ぶ module-private constructor です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_writer_plan_owner_new %fn GuiRgba8888RowTileRleWriterPlanOwner fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleWriterPlanOwner \plan\metadata:
    GuiRgba8888CompositorTileRleWriterPlanOwner plan metadata

//: gui_rgba8888_compositor_tile_rle_writer_plan_error_new: writer plan error payload を[作/つく]る
//:
//: lower kind、category、total run count、回収用 ready cursor owner を 1 つの owner-bearing error にまとめます。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_writer_plan_error_new %fn GuiRgba8888CompositorTileRleWriterPlanErrorKind fn Option GuiError fn i32 fn GuiRgba8888CompositorTileRleEncodeCursorOwner GuiRgba8888CompositorTileRleWriterPlanError \kind\category\total_run_count\ready:
    GuiRgba8888CompositorTileRleWriterPlanError kind category total_run_count ready

//: gui_rgba8888_compositor_tile_rle_writer_plan_error_from_lower: lower writer plan error を compositor ready cursor error へ[写/うつ]す
//:
//: lower kind / category / total run count を[読/よ]んでから lower ready cursor owner を[回収/かいしゅう]し、metadata [付/つ]き ready cursor owner へ[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
fn gui_rgba8888_compositor_tile_rle_writer_plan_error_from_lower %fn GuiRgba8888RowTileRleWriterPlanError fn GuiRgba8888CompositorFrameEntryMetadata GuiRgba8888CompositorTileRleWriterPlanError \lower\metadata:
    let lower_kind %GuiRgba8888RowTileRleWriterPlanErrorKind gui_rgba8888_row_tile_rle_writer_plan_error_kind &lower
    let category %Option GuiError gui_rgba8888_row_tile_rle_writer_plan_error_category_value &lower
    let total_run_count %i32 gui_rgba8888_row_tile_rle_writer_plan_error_total_run_count &lower
    let lower_ready %GuiRgba8888RowTileRleEncodeCursorOwner gui_rgba8888_row_tile_rle_writer_plan_error_finish_ready_owner lower
    let ready %GuiRgba8888CompositorTileRleEncodeCursorOwner GuiRgba8888CompositorTileRleEncodeCursorOwner lower_ready metadata
    let kind %GuiRgba8888CompositorTileRleWriterPlanErrorKind GuiRgba8888CompositorTileRleWriterPlanErrorKind::WriterPlanPrepareFailed lower_kind
    gui_rgba8888_compositor_tile_rle_writer_plan_error_new kind category total_run_count ready

//: gui_rgba8888_compositor_tile_rle_writer_plan_prepare: ready cursor から encoded byte capacity を[作/つく]る
//:
//: [契約/けいやく]:
//: - metadata を Copy してから lower ready cursor owner を[取/と]り[出/だ]します。
//: - lower writer plan prepare を 1 [回/かい]だけ[呼/よ]び、success では writer plan owner と metadata を[束/たば]ねます。
//: - error では lower ready cursor owner を metadata [付/つ]き ready cursor owner に[戻/もど]します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
//: ```
pub fn gui_rgba8888_compositor_tile_rle_writer_plan_prepare %fn GuiRgba8888CompositorTileRleEncodeCursorOwner Result GuiRgba8888CompositorTileRleWriterPlanOwner GuiRgba8888CompositorTileRleWriterPlanError \ready:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_encode_cursor_owner_metadata &ready
    let lower_ready %GuiRgba8888RowTileRleEncodeCursorOwner field::get ready "ready"
    match gui_rgba8888_row_tile_rle_writer_plan_prepare lower_ready:
        Result::Err lower:
            Result::Err gui_rgba8888_compositor_tile_rle_writer_plan_error_from_lower lower metadata
        Result::Ok plan:
            Result::Ok gui_rgba8888_compositor_tile_rle_writer_plan_owner_new plan metadata

