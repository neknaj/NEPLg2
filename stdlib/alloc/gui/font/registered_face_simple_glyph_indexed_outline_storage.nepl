    let completed %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner field::get owner "completed"
    let storage %GuiSfntSimpleGlyphOutlineStorage field::get owner "storage"
    match gui_sfnt_simple_glyph_outline_storage_push_contour_endpoint storage cursor endpoint previous_endpoint:
        Result::Ok lower_push:
            let next_cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor gui_sfnt_simple_glyph_contour_endpoint_push_cursor &lower_push
            let next_previous_endpoint %i32 gui_sfnt_simple_glyph_contour_endpoint_push_previous_endpoint &lower_push
            let next_storage %GuiSfntSimpleGlyphOutlineStorage gui_sfnt_simple_glyph_contour_endpoint_push_storage lower_push
            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner gui_font_registered_face_simple_glyph_indexed_outline_storage_owner completed next_storage
            let pushed %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPush gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push next_owner next_cursor next_previous_endpoint
            Result::Ok pushed
        Result::Err lower_error:
            let kind %GuiSfntSimpleGlyphContourEndpointPushErrorKind gui_sfnt_simple_glyph_contour_endpoint_push_error_kind &lower_error
            let rejected_endpoint %GuiSfntSimpleGlyphContourEndpointSlot gui_sfnt_simple_glyph_contour_endpoint_push_error_endpoint &lower_error
            let rejected_previous_endpoint %Option i32 gui_sfnt_simple_glyph_contour_endpoint_push_error_previous_endpoint &lower_error
            let region_error_kind %Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind gui_sfnt_simple_glyph_contour_endpoint_push_error_region_error_kind &lower_error
            let storage_push_error_kind %Option StdErrorKind gui_sfnt_simple_glyph_contour_endpoint_push_error_push_error_kind &lower_error
            let returned_storage %GuiSfntSimpleGlyphOutlineStorage gui_sfnt_simple_glyph_contour_endpoint_push_error_storage lower_error
            let returned_owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner gui_font_registered_face_simple_glyph_indexed_outline_storage_owner completed returned_storage
            let error %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPushError gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push_error returned_owner cursor rejected_endpoint rejected_previous_endpoint kind region_error_kind storage_push_error_kind
            Result::Err error

