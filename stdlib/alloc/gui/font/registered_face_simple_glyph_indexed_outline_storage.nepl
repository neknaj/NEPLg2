//: # alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage
//: registered indexed completed authority と empty outline storage を分離不能に所有する
//:
//: ### [目的/もくてき]
//: - F5nxb の checked completed owner から canonical capacity を読み、対応する empty outline storage を一度だけ確保します。
//: - allocation 成功時も失敗時も registered indexed authority を失わず、成功 owner または recoverable error の一方へ移します。
//: - 後続 phase が信頼する capacity、apply state、terminal status、storage metadata を borrowed Copy projection として公開します。
//:
//: ### [契約/けいやく]
//: - public start の入力は completed owner と borrowed storage limit だけです。caller supplied capacity や raw collection は受けません。
//: - success owner は completed authority と storage を nested ownership で保持し、どちらか一方を取り出す public API を持ちません。
//: - allocation error metadata は completed owner を回収する前に読みます。error から completed owner を取り出せるのは一度だけです。
//: - invariant check は capacity shape、6 field、scalar slot count、empty len、exact cap の順に fail-closed で検査します。
//: - owner free は storage、completed authority の順にそれぞれ一度だけ解放します。
//:
//: ### [現状/げんじょう]
//: - この F5nxc module は allocation と metadata validation に加え、F5nxd が outer authority を分割せず利用する borrowed span forwarding と consuming endpoint push 境界を提供します。
//: - endpoint cursor と population state は F5nxd が所有します。command、stroke、raster、platform presentation には進みません。
//:
//: ### [計算量/けいさんりょう]
//: metadata と invariant の検査は O(1)、lower allocator call は1回です。storage は c + 5p 個の i32 slot capacity を確保し、wrapper 自体の追加領域は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
//:| #import "std/test" as *
//:
//: fn main %fn void i32 \void:
//:     let typed %bool match GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::StorageNotEmpty:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck::Invalid kind:
//:             match kind:
//:                 GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::StorageNotEmpty: true
//:                 _: false
//:         _: false
//:     test_assertion_exit_code assert "registered outline storage invariant is typed" typed
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_outline_storage_owner
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_take_storage
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.cell.moved
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn take_completed_twice %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError unit \error:
//:     let first %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error_take_completed_owner error
//:     let second %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error_take_completed_owner error
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_free first
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_free second
//:
//: fn main %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError i32 \error:
//:     take_completed_twice error
//:     0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn observe_and_free %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner bool \owner:
//:     let valid %bool match gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_invariant_check &owner:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck::Valid: true
//:         GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck::Invalid _kind: false
//:     gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_free owner
//:     valid
//:
//: fn recover_and_free %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError unit \error:
//:     let _kind %GuiSfntSimpleGlyphOutlineStorageAllocErrorKind gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error_kind &error
//:     let completed %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error_take_completed_owner error
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_free completed
//:
//: fn main %fn void i32 \void:
//:     0
//: ```

#indent 4

#import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind: full invariant の最初の不一致
//:
//: [契約/けいやく]: variant の順序は検査 precedence と同じです。
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind:
    CanonicalCapacityShapeInvalid
    GlyphMismatch
    ContourCountMismatch
    PointCountMismatch
    EdgeCountMismatch
    PathCommandPairCountMismatch
    PathCommandCountMismatch
    ScalarSlotCountOverflow
    ScalarSlotCountMismatch
    StorageNotEmpty
    StorageSlotCapacityMismatch

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind \kind:
        kind

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck: owner の typed full invariant 結果
//:
//: [戻/もど]り[値/ち]: `Valid` は全検査成功、`Invalid kind` は固定順で最初に見つかった不一致です。
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck:
    Valid
    Invalid %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck \check:
        *check

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck \check:
        check

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner: completed authority と allocated storage の owner
//:
//: [注意/ちゅうい]: owning resource を保持するため `Clone` / `Copy` は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner:
    completed %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner
    storage %GuiSfntSimpleGlyphOutlineStorage

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError: lower allocation metadata と recoverable completed owner
//:
//: [注意/ちゅうい]: completed owner を保持するため `Clone` / `Copy` は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError:
    completed %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner
    lower %GuiSfntSimpleGlyphOutlineStorageAllocError

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPush: contour endpoint commit後のouter ownerと進行metadata
//:
//: [契約/けいやく]: completed authorityと更新済みstorageを再結合したownerを唯一のresourceとして保持します。
//: ownerを保持するため`Clone` / `Copy`は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPush:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor
    previous_endpoint %i32

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPushError: contour endpoint commit失敗時のrecoverable outer error
//:
//: [契約/けいやく]: same outer ownerとlower F5e metadataを保持し、raw completed authorityとstorageを公開しません。
//: ownerを保持するため`Clone` / `Copy`は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPushError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor
    endpoint %GuiSfntSimpleGlyphContourEndpointSlot
    previous_endpoint %Option i32
    kind %GuiSfntSimpleGlyphContourEndpointPushErrorKind
    region_error_kind %Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind
    storage_push_error_kind %Option StdErrorKind

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPush: PointX commit後のouter ownerとcursor
//:
//: [契約/けいやく]: completed authorityと更新済みstorageを分離せず保持します。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPush:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor

//: GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPushError: PointX commit失敗時のrecoverable outer error
//:
//: [契約/けいやく]: lower metadataとsame outer ownerを保持し、raw storageを公開しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPushError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor
    point %GuiSfntSimpleGlyphPointXSlot
    kind %GuiSfntSimpleGlyphPointXPushErrorKind
    region_error_kind %Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind
    storage_push_error_kind %Option StdErrorKind

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_owner: completed authority と storage を success owner に束ねる
//:
//: [契約/けいやく]: allocation finalizer だけが呼び、nested resource の分離不能な所有権を作ります。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner fn GuiSfntSimpleGlyphOutlineStorage GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner \completed\storage:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner completed storage

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error: completed authority と lower error を recoverable error に束ねる
//:
//: [契約/けいやく]: allocation finalizer だけが呼び、失敗後の retry authority を保持します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner fn GuiSfntSimpleGlyphOutlineStorageAllocError GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError \completed\lower:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError completed lower

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push: successful lower pushをouter ownerへ再結合する
//:
//: [契約/けいやく]: owner-bearing success payloadを構築できる場所をこのprivate constructorへ限定します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner fn GuiSfntSimpleGlyphOutlineScalarRegionCursor fn i32 GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPush \owner\cursor\previous_endpoint:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPush owner cursor previous_endpoint

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push_error: failed lower pushをrecoverable outer errorへ再結合する
//:
//: [契約/けいやく]: lower metadataをCopyした後にだけ呼び、same authorityを持つownerをerrorへ移します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_contour_endpoint_push_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner fn GuiSfntSimpleGlyphOutlineScalarRegionCursor fn GuiSfntSimpleGlyphContourEndpointSlot fn Option i32 fn GuiSfntSimpleGlyphContourEndpointPushErrorKind fn Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind fn Option StdErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPushError \owner\cursor\endpoint\previous_endpoint\kind\region_error_kind\storage_push_error_kind:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageContourEndpointPushError owner cursor endpoint previous_endpoint kind region_error_kind storage_push_error_kind

//: [目的/もくてき]: successful PointX pushをouter ownerへ再結合します。
//: [計算量/けいさんりょう]: O(1)です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_point_x_push %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner fn GuiSfntSimpleGlyphOutlineScalarRegionCursor GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPush \owner\cursor:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPush owner cursor

//: [目的/もくてき]: failed PointX pushをsame outer ownerへ再結合します。
//: [契約/けいやく]: lower metadataを全て読んだ後にだけ呼びます。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_point_x_push_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner fn GuiSfntSimpleGlyphOutlineScalarRegionCursor fn GuiSfntSimpleGlyphPointXSlot fn GuiSfntSimpleGlyphPointXPushErrorKind fn Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind fn Option StdErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPushError \owner\cursor\point\kind\region_error_kind\storage_push_error_kind:
    GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStoragePointXPushError owner cursor point kind region_error_kind storage_push_error_kind

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_finalize_alloc_result: lower allocation result を唯一の public outcome へ変換する
//:
//: [契約/けいやく]: success/error constructor の呼び出しを一元化し、completed authority を必ず一方の outcome へ移します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_finalize_alloc_result %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner impure fn Result GuiSfntSimpleGlyphOutlineStorage GuiSfntSimpleGlyphOutlineStorageAllocError Result GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError \completed\allocation:
    match allocation:
        Result::Ok storage:
            Result::Ok gui_font_registered_face_simple_glyph_indexed_outline_storage_owner completed storage
        Result::Err lower:
            Result::Err gui_font_registered_face_simple_glyph_indexed_outline_storage_alloc_error completed lower

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_start: completed authority から empty storage allocation を開始する
//:
//: [契約/けいやく]: canonical capacity を completed owner から先に Copy し、lower allocator と private finalizer をそれぞれ一度だけ呼びます。
//:
//: [戻/もど]り[値/ち]: 成功時は nested owner、失敗時は lower metadata と同じ completed owner を持つ recoverable error です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_outline_storage_start %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner impure fn &GuiSfntSimpleGlyphOutlineStorageLimit Result GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError \completed\limit:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_capacity &completed
    let allocation %Result GuiSfntSimpleGlyphOutlineStorage GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc &capacity limit
    gui_font_registered_face_simple_glyph_indexed_outline_storage_finalize_alloc_result completed allocation

#test
//: gui_font_registered_face_simple_glyph_indexed_outline_storage_test_force_scalar_slot_storage_alloc_failed: deterministic な lower allocation failure を作る
//:
//: [契約/けいやく]: test mode だけで公開され、canonical capacity から exact limit を作り、production start と同じ finalizer を通して owner recovery を検査します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_outline_storage_test_force_scalar_slot_storage_alloc_failed %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryCompletedOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageAllocError \completed:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_capacity &completed
    let limit %GuiSfntSimpleGlyphOutlineStorageLimit gui_sfnt_simple_glyph_outline_storage_limit gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity gui_sfnt_simple_glyph_outline_storage_capacity_edge_count &capacity gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count &capacity
    let capacity_check %GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck::Fits capacity
    let some_capacity_check %Option GuiSfntSimpleGlyphOutlineCapacityCheck some capacity_check
    let lower %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::ScalarSlotStorageAllocFailed capacity limit some_capacity_check
    let allocation %Result GuiSfntSimpleGlyphOutlineStorage GuiSfntSimpleGlyphOutlineStorageAllocError Result::Err lower
    gui_font_registered_face_simple_glyph_indexed_outline_storage_finalize_alloc_result completed allocation

