//: gui_font_registered_face_simple_glyph_indexed_outline_storage_glyph_same: canonical と stored capacity の glyph identity を比較する
//:
//: [計算量/けいさんりょう]: Copy projection と整数比較だけを行うため O(1) です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_glyph_same %fn &GuiSfntSimpleGlyphOutlineStorageCapacity fn &GuiSfntSimpleGlyphOutlineStorageCapacity bool \canonical\stored:
    let canonical_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph canonical
    let stored_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph stored
    eq gui_glyph_id_raw &canonical_glyph gui_glyph_id_raw &stored_glyph

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_invalid_if: bool mismatch を typed invalid candidate へ変換する
//:
//: [戻/もど]り[値/ち]: mismatch の場合だけ `Some kind`、それ以外は `None` です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_invalid_if %fn bool fn GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind \invalid\kind:
    if invalid:
        then some kind
        else Option::None

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_first_invalid: precedence 順で先の invalid candidate を保持する
//:
//: [契約/けいやく]: earlier が `Some` なら later を採用せず、固定された fail-closed 順序を保存します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_first_invalid %fn Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind fn Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind \earlier\later:
    match earlier:
        Option::Some kind: some kind
        Option::None: later

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_scalar_count_invalid: scalar count overflow と stored count mismatch を分離する
//:
//: [戻/もど]り[値/ち]: checked count が overflow なら overflow、fits なら実 storage count との不一致だけを返します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_outline_storage_scalar_count_invalid %fn &GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner fn &GuiSfntSimpleGlyphOutlineStorageCapacity Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind \owner\canonical:
    match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check canonical:
        GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _capacity:
            some GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::ScalarSlotCountOverflow
        GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits expected_scalar_slot_count:
            let actual_scalar_slot_count %i32 gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_scalar_slot_count owner
            let mismatch %bool ne actual_scalar_slot_count expected_scalar_slot_count
            gui_font_registered_face_simple_glyph_indexed_outline_storage_invalid_if mismatch GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::ScalarSlotCountMismatch

//: gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_invariant_check: nested authority と storage の full invariant を検査する
//:
//: [契約/けいやく]: 11種類の invalid kind を宣言順に検査し、wildcard success、panic、silent repair を行いません。
//:
//: [戻/もど]り[値/ち]: 最初の不一致を `Invalid` で返し、全項目が一致する場合だけ `Valid` を返します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageOwner GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantCheck \owner:
    let canonical %GuiSfntSimpleGlyphOutlineStorageCapacity gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_capacity owner
    let stored %GuiSfntSimpleGlyphOutlineStorageCapacity gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_storage_capacity owner
    let canonical_shape_valid %bool gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &canonical
    let glyph_same %bool gui_font_registered_face_simple_glyph_indexed_outline_storage_glyph_same &canonical &stored
    let contour_mismatch %bool ne gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &canonical gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &stored
    let point_mismatch %bool ne gui_sfnt_simple_glyph_outline_storage_capacity_point_count &canonical gui_sfnt_simple_glyph_outline_storage_capacity_point_count &stored
    let edge_mismatch %bool ne gui_sfnt_simple_glyph_outline_storage_capacity_edge_count &canonical gui_sfnt_simple_glyph_outline_storage_capacity_edge_count &stored
    let command_pair_mismatch %bool ne gui_sfnt_simple_glyph_outline_storage_capacity_path_command_pair_count &canonical gui_sfnt_simple_glyph_outline_storage_capacity_path_command_pair_count &stored
    let command_mismatch %bool ne gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count &canonical gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count &stored
    let scalar_slots_len %i32 gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_scalar_slots_len owner
    let scalar_slots_cap %i32 gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_scalar_slots_cap owner
    let scalar_slot_count %i32 gui_font_registered_face_simple_glyph_indexed_outline_storage_owner_scalar_slot_count owner
    let shape_invalid %Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind gui_font_registered_face_simple_glyph_indexed_outline_storage_invalid_if not canonical_shape_valid GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::CanonicalCapacityShapeInvalid
    let glyph_invalid %Option GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind gui_font_registered_face_simple_glyph_indexed_outline_storage_invalid_if not glyph_same GuiFontRegisteredFaceSimpleGlyphIndexedOutlineStorageInvariantInvalidKind::GlyphMismatch
