//: # alloc/gui/font/registered_face_simple_glyph_indexed_action_summary
//: registered indexed action と pure apply state を同じ authority に封印する
//:
//: ### [目的/もくてき]
//: - registered indexed owner から canonical capacity を取得し、F5nxa action owner と zero apply state を一度だけ開始します。
//: - `Primary` と `Tail` の各 action を shared pure apply helper へ一度だけ渡し、集計と full-path progress を同じ owner に保持します。
//: - completed authority と rejected diagnostics を checked seal により異なる terminal owner へ分けます。
//:
//: ### [契約/けいやく]
//: - public start が受ける authority は registered indexed owner と borrowed sink policy だけです。途中の action owner、caller supplied state / capacity、raw collection は受けません。
//: - private phase は `Running Option status`、`Rejected reason`、`Completed status` のいずれかであり、terminal metadata を別 field に分離しません。
//: - `Reject` は parse failure ではなく domain terminal です。更新済み count と status を commit した後、同じ sink step の Tail と後続 path を消費しません。
//: - completion は F5nxa の full-path progress だけを authority とします。contour-local close、`NoAction`、packet payload から推測しません。
//: - budget は terminal、remaining steps が 0 以下、最大一 action の順に判定し、常に唯一の owner と Copy status を返します。
//: - lower failure metadata は action owner を回収する前にすべて読みます。fallback、panic、unreachable は使いません。
//:
//: ### [計算量/けいさんりょう]
//: action 数 a に対する完了までの時間は O(a)、summary が追加する storage は O(1) です。F5nxc の outline allocation はこの module では行いません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:| #import "std/test" as *
//:
//: fn main %fn void i32 \void:
//:     let typed %bool match GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryProgressKind::Running:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryProgressKind::Running:
//:             match GuiFontRegisteredFaceSimpleGlyphIndexedActionSummarySealTargetKind::Completed:
//:                 GuiFontRegisteredFaceSimpleGlyphIndexedActionSummarySealTargetKind::Completed: true
//:                 _: false
//:         _: false
//:     test_assertion_exit_code assert "summary progress and seal target are typed" typed
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_owner
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn main %fn void i32 \void:
//:     GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Running
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.cell.moved
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn take_budget_owner_twice %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStep unit \step:
//:     let first %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step_take_owner step
//:     let second %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step_take_owner step
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_owner_free first
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_owner_free second
//:
//: fn main %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStep i32 \step:
//:     take_budget_owner_twice step
//:     0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.cell.moved
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn take_seal_error_owner_twice %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummarySealError unit \error:
//:     let first %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_seal_error_take_owner error
//:     let second %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_seal_error_take_owner error
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_owner_free first
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_owner_free second
//:
//: fn main %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummarySealError i32 \error:
//:     take_seal_error_owner_twice error
//:     0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action_summary" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_summary_completed_owner_take_action
//: ```

