//: gui_font_registered_face_simple_glyph_indexed_action_summary_step_applied: non-reject apply後のfull-path phaseを確定する
//:
//: [契約/けいやく]: apply statusのvariantはcallerが網羅し、このhelperはF5nxa progressだけからRunning / Completedを選びます。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_summary_step_applied %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn GuiSfntSimpleGlyphOutlineStorageCapacity fn GuiSfntSimpleGlyphPathSinkActionApplyState fn GuiSfntSimpleGlyphPathSinkActionApplyStatus Result GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStep GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryError \action\capacity\apply_state\apply_status:
    let next_phase %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase match gui_font_registered_face_simple_glyph_indexed_action_progress_kind &action:
        GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Active:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Running some apply_status
        GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Completed:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Completed apply_status
    let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_owner action capacity apply_state next_phase
    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_step_value next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStepStatus::Applied apply_status

//: gui_font_registered_face_simple_glyph_indexed_action_summary_step_running: Running owner を最大一 action 適用する
//:
//: [契約/けいやく]: lower error metadata は action owner take より先に読み、successful packet は shared apply helper へ exactly once 渡します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_summary_step_running %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn GuiSfntSimpleGlyphOutlineStorageCapacity fn GuiSfntSimpleGlyphPathSinkActionApplyState fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase Result GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStep GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryError \action\capacity\apply_state\phase:
    match gui_font_registered_face_simple_glyph_indexed_action_step action:
        Result::Err action_error:
            let action_error_kind %GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind gui_font_registered_face_simple_glyph_indexed_action_error_kind &action_error
            let path_error_kind %Option GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind gui_font_registered_face_simple_glyph_indexed_action_error_path_error_kind &action_error
            let lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError gui_font_registered_face_simple_glyph_indexed_action_error_lookup_error &action_error
            let contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError gui_font_registered_face_simple_glyph_indexed_action_error_contour_step_error &action_error
            let recovered_action %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_error_take_owner action_error
            let recovered_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_owner recovered_action capacity apply_state phase
            Result::Err gui_font_registered_face_simple_glyph_indexed_action_summary_error recovered_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryErrorKind::LowerActionFailed some action_error_kind path_error_kind lookup_error contour_step_error
        Result::Ok action_step:
            let packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket gui_font_registered_face_simple_glyph_indexed_action_step_packet &action_step
            let packet_action %GuiSfntSimpleGlyphPathSinkAction gui_font_registered_face_simple_glyph_indexed_action_packet_action &packet
            let apply_step %GuiSfntSimpleGlyphPathSinkActionApplyStep gui_sfnt_simple_glyph_path_sink_action_apply_state_apply_action apply_state packet_action
            let next_apply_state %GuiSfntSimpleGlyphPathSinkActionApplyState gui_sfnt_simple_glyph_path_sink_action_apply_step_state &apply_step
            let apply_status %GuiSfntSimpleGlyphPathSinkActionApplyStatus gui_sfnt_simple_glyph_path_sink_action_apply_step_status &apply_step
            let next_action %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_step_take_owner action_step
            match apply_status:
                GuiSfntSimpleGlyphPathSinkActionApplyStatus::EmittedEvent event:
                    gui_font_registered_face_simple_glyph_indexed_action_summary_step_applied next_action capacity next_apply_state GuiSfntSimpleGlyphPathSinkActionApplyStatus::EmittedEvent event
                GuiSfntSimpleGlyphPathSinkActionApplyStatus::Rejected reason:
                    let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_owner next_action capacity next_apply_state GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Rejected reason
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_step_value next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStepStatus::Rejected reason
                GuiSfntSimpleGlyphPathSinkActionApplyStatus::ClosedContour close:
                    gui_font_registered_face_simple_glyph_indexed_action_summary_step_applied next_action capacity next_apply_state GuiSfntSimpleGlyphPathSinkActionApplyStatus::ClosedContour close
                GuiSfntSimpleGlyphPathSinkActionApplyStatus::NoAction:
                    gui_font_registered_face_simple_glyph_indexed_action_summary_step_applied next_action capacity next_apply_state GuiSfntSimpleGlyphPathSinkActionApplyStatus::NoAction

//: gui_font_registered_face_simple_glyph_indexed_action_summary_step: summary を最大一 action 進める
//:
//: [契約/けいやく]: terminal direct step は owner を失う silent success にせず、same owner を持つ typed error にします。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_summary_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStep GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryError \owner:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity *field::get_ref &owner "capacity"
    let apply_state %GuiSfntSimpleGlyphPathSinkActionApplyState *field::get_ref &owner "apply_state"
    let phase %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase *field::get_ref &owner "phase"
    let action %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner field::get owner "action"
    match phase:
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Running _last_status:
            gui_font_registered_face_simple_glyph_indexed_action_summary_step_running action capacity apply_state phase
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Rejected _reason:
            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_owner action capacity apply_state phase
            Result::Err gui_font_registered_face_simple_glyph_indexed_action_summary_error recovered GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryErrorKind::AlreadyRejected none none none none
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Completed _last_status:
            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_owner action capacity apply_state phase
            Result::Err gui_font_registered_face_simple_glyph_indexed_action_summary_error recovered GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryErrorKind::AlreadyCompleted none none none none

//: gui_font_registered_face_simple_glyph_indexed_action_summary_drain_budget: terminal-before-budget で最大一 action 適用する
//:
//: [契約/けいやく]: Running nonpositive budget は lower call、apply、counter update を行いません。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_summary_drain_budget %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStep GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryError \owner\remaining_steps:
    let phase %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase *field::get_ref &owner "phase"
    match phase:
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Rejected reason:
            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStatus::Rejected reason
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Completed _last_status:
            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStatus::Completed
        GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryPhase::Running _last_status:
            if le remaining_steps 0:
                then:
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStatus::StepBudgetExhausted
                else:
                    match gui_font_registered_face_simple_glyph_indexed_action_summary_step owner:
                        Result::Err error:
                            Result::Err error
                        Result::Ok step:
                            let status %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStepStatus gui_font_registered_face_simple_glyph_indexed_action_summary_step_status &step
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryOwner gui_font_registered_face_simple_glyph_indexed_action_summary_step_take_owner step
                            match status:
                                GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStepStatus::Applied apply_status:
                                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStatus::Applied apply_status
                                GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryStepStatus::Rejected reason:
                                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_summary_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionSummaryBudgetStatus::Rejected reason

