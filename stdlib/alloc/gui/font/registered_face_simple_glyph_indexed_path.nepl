//: # alloc/gui/font/registered_face_simple_glyph_indexed_path
//: registered indexed glyph owner を policy 適用済み contour sink-step stream へ接続する
//:
//: ### [目的/もくてき]
//: - registered evidence、span index、private traversal state を同じ owner に保持します。
//: - contour ごとに span index lookup を一度だけ行い、同じ span を contour 終了まで再利用します。
//: - event を既存 pure sink-step projection へ渡し、off-curve と closure policy を明示的に適用します。
//:
//: ### [契約/けいやく]
//: - raw cursor、raw collection、lower indexed owner を public API の引数にしません。
//: - budget 0 は span lookup、collection read、contour step を行いません。
//: - step / lookup failure は owner を回収可能な typed error として返し、fallback しません。
//:
//: ### [計算量/けいさんりょう]
//: contour 数 c、sink step 数 a に対して全 traversal は O(c + a)、追加 allocation は O(1) です。
//:
//: ### [典型例/てんけいれい]
//: registered index build 済み owner を受け取った scheduler は、status を読んでから唯一の owner を回収します。実フォントから indexed owner を作る前段は `tests/stdlib/gui_font_registered_face.n.md` で実行検査します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_path" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//:
//: fn run_one_slice %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner unit \owner:
//:     match gui_font_registered_face_simple_glyph_indexed_path_drain_budget owner 1:
//:         Result::Err error:
//:             gui_font_registered_face_simple_glyph_indexed_path_error_free error
//:         Result::Ok budget_step:
//:             let status %GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus gui_font_registered_face_simple_glyph_indexed_path_budget_step_status &budget_step
//:             match status:
//:                 GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::Emitted _sink_step:
//:                     gui_font_registered_face_simple_glyph_indexed_path_owner_free gui_font_registered_face_simple_glyph_indexed_path_budget_step_take_owner budget_step
//:                 GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::Completed:
//:                     gui_font_registered_face_simple_glyph_indexed_path_owner_free gui_font_registered_face_simple_glyph_indexed_path_budget_step_take_owner budget_step
//:                 GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::StepBudgetExhausted:
//:                     gui_font_registered_face_simple_glyph_indexed_path_owner_free gui_font_registered_face_simple_glyph_indexed_path_budget_step_take_owner budget_step
//:
//: fn main %fn void i32 \void:
//:     let completed %bool match GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::Completed:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::Completed: true
//:         _: false
//:     test_assertion_exit_code assert "registered indexed path completion is typed" completed
//: ```

#indent 4

#import "alloc/gui/font/registered_face_simple_glyph_collection" as *
#import "alloc/gui/font/registered_face_simple_glyph_lookup" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind: public diagnostics 用 traversal state 分類
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind:
    PendingContour
    ActiveContour
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind \kind:
        kind

//: GuiFontRegisteredFaceSimpleGlyphIndexedPathActive: contour中に再利用するchecked spanとcursor
//:
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPathActive:
    span %GuiSfntSimpleGlyphContourSpan
    cursor %GuiSfntSimpleGlyphPathContourCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPathActive:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathActive GuiFontRegisteredFaceSimpleGlyphIndexedPathActive \active:
        *active

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPathActive:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathActive GuiFontRegisteredFaceSimpleGlyphIndexedPathActive \active:
        active

//: GuiFontRegisteredFaceSimpleGlyphIndexedPathState: lookup前、contour処理中、完了を分離する内部状態
//:
//: neplg2:test[skip]
enum GuiFontRegisteredFaceSimpleGlyphIndexedPathState:
    PendingContour %i32
    ActiveContour %GuiFontRegisteredFaceSimpleGlyphIndexedPathActive
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPathState:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathState GuiFontRegisteredFaceSimpleGlyphIndexedPathState \state:
        *state

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPathState:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathState GuiFontRegisteredFaceSimpleGlyphIndexedPathState \state:
        state

//: GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner: registered index、policy、private traversal state の owner
//:
//: [注意/ちゅうい]: indexed owner を所有するため `Clone` / `Copy` は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner:
    indexed %GuiFontRegisteredFaceSimpleGlyphIndexedOwner
    policy %GuiSfntSimpleGlyphPathSinkPolicy
    state %GuiFontRegisteredFaceSimpleGlyphIndexedPathState

//: gui_font_registered_face_simple_glyph_indexed_path_active: 同一contourで再利用するspanとcursorを束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_active %fn GuiSfntSimpleGlyphContourSpan fn GuiSfntSimpleGlyphPathContourCursor GuiFontRegisteredFaceSimpleGlyphIndexedPathActive \span\cursor:
    GuiFontRegisteredFaceSimpleGlyphIndexedPathActive span cursor

//: gui_font_registered_face_simple_glyph_indexed_path_owner: index、policy、継続状態を分離不能なownerへ束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedOwner fn GuiSfntSimpleGlyphPathSinkPolicy fn GuiFontRegisteredFaceSimpleGlyphIndexedPathState GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner \indexed\policy\state:
    GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner indexed policy state

//: gui_font_registered_face_simple_glyph_indexed_path_owner_span_count: path authority が保持する indexed contour 数を読む
//:
//: [目的/もくてき]: F5nxd 以降が raw indexed owner を取り出さず、path owner の authority 境界を保ったまま contour budget を確認できるようにします。
//:
//: [契約/けいやく]: immediate nested indexed owner を借用し、`gui_font_registered_face_simple_glyph_indexed_owner_span_count` を exactly once 呼びます。owner と内部 state は変更しません。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_span_count %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner i32 \owner:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_span_count indexed

//: gui_font_registered_face_simple_glyph_indexed_path_owner_span_lookup: path authority から checked contour span を O(1) で読む
//:
//: [目的/もくてき]: endpoint population が traversal state や raw collection を露出せず、registered index の checked span と typed lookup error を取得できるようにします。
//:
//: [契約/けいやく]: immediate nested indexed owner を借用し、`gui_font_registered_face_simple_glyph_indexed_owner_span_lookup` を exactly once 呼びます。成功と失敗のどちらでも同じ path owner を caller が保持します。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_span_lookup %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn i32 Result GuiSfntSimpleGlyphContourSpan GuiSfntSimpleGlyphContourSpanIndexLookupError \owner\contour_index:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_span_lookup indexed contour_index

//: path authority から取得済みchecked span内のedgeをO(1)で読みます。
//:
//: [契約/けいやく]: immediate nested indexed ownerへexactly once委譲し、raw collectionを公開しません。
//:
//: [計算量/けいさんりょう]: O(1)です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_contour_edge_checked_span %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiSfntSimpleGlyphContourSpan fn i32 Result GuiSfntSimpleGlyphContourEdge GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError \owner\span\edge_index:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_contour_edge_checked_span indexed span edge_index

//: path authority から checked span 内の sink event を exactly once forwarding します。
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_path_sink_event_at_checked_span %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiSfntSimpleGlyphContourSpan fn i32 fn GuiSfntSimpleGlyphPathSinkEventSlot Result GuiSfntSimpleGlyphPathSinkEvent GuiSfntSimpleGlyphOutlinePointStreamItemCollectionCurveSegmentError \owner\span\edge_index\slot:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_path_sink_event_at_checked_span indexed span edge_index slot

//: gui_font_registered_face_simple_glyph_indexed_path_owner_item_read: path authority から classified point item を借用して読む
//:
//: [目的/もくてき]: 後続 phase が traversal state や raw collection を露出せず、path owner に封印された registered point item を typed result のまま参照できるようにします。
//:
//: [契約/けいやく]: immediate nested indexed owner を借用し、`gui_font_registered_face_simple_glyph_indexed_owner_item_read` を exactly once 呼びます。owner と内部 state は変更しません。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_item_read %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn i32 Result GuiSfntSimpleGlyphOutlinePointStreamItem GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError \owner\item_index:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_item_read indexed item_index

//: path authority が保持する classified item 数を読みます。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_owner_item_count %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner i32 \owner:
    let indexed %&GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get_ref owner "indexed"
    gui_font_registered_face_simple_glyph_indexed_owner_item_count indexed

