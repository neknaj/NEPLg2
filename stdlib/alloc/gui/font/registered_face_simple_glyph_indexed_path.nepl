pub fn gui_font_registered_face_simple_glyph_indexed_path_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedOwner fn &GuiSfntSimpleGlyphPathSinkPolicy GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner \indexed\policy:
    gui_font_registered_face_simple_glyph_indexed_path_owner indexed *policy GuiFontRegisteredFaceSimpleGlyphIndexedPathState::PendingContour 0

//: gui_font_registered_face_simple_glyph_indexed_path_progress_kind: raw cursorを公開せず現在stateを読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_progress_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind \owner:
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPathState field::get_ref owner "state"
    match *state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::PendingContour _contour_index:
            GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::PendingContour
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::ActiveContour _active:
            GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::ActiveContour
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::Completed:
            GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::Completed

