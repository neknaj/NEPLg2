fn gui_font_registered_face_simple_glyph_indexed_path_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind fn Option GuiSfntSimpleGlyphContourSpanIndexLookupError fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError GuiFontRegisteredFaceSimpleGlyphIndexedPathError \owner\kind\lookup_error\contour_step_error:
    GuiFontRegisteredFaceSimpleGlyphIndexedPathError owner kind lookup_error contour_step_error

