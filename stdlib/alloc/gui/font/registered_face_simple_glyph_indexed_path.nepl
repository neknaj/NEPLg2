//: gui_font_registered_face_simple_glyph_indexed_path_next_state: contour step後のactive、pending、completedを決定する
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_next_state %fn &GuiFontRegisteredFaceSimpleGlyphIndexedOwner fn GuiSfntSimpleGlyphContourSpan fn i32 fn &GuiSfntSimpleGlyphPathContourStep GuiFontRegisteredFaceSimpleGlyphIndexedPathState \indexed\span\contour_index\contour_step:
    match gui_sfnt_simple_glyph_path_contour_step_next contour_step:
        GuiSfntSimpleGlyphPathContourNext::Continue next_cursor:
            GuiFontRegisteredFaceSimpleGlyphIndexedPathState::ActiveContour gui_font_registered_face_simple_glyph_indexed_path_active span next_cursor
        GuiSfntSimpleGlyphPathContourNext::EndContour:
            if lt add contour_index 1 gui_font_registered_face_simple_glyph_indexed_owner_span_count indexed:
                then:
                    GuiFontRegisteredFaceSimpleGlyphIndexedPathState::PendingContour add contour_index 1
                else:
                    GuiFontRegisteredFaceSimpleGlyphIndexedPathState::Completed

//: gui_font_registered_face_simple_glyph_indexed_path_step_with_span: 保存済みchecked spanで1 sink stepだけ進める
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_step_with_span %fn GuiFontRegisteredFaceSimpleGlyphIndexedOwner fn GuiSfntSimpleGlyphPathSinkPolicy fn GuiFontRegisteredFaceSimpleGlyphIndexedPathState fn GuiSfntSimpleGlyphContourSpan fn GuiSfntSimpleGlyphPathContourCursor Result GuiFontRegisteredFaceSimpleGlyphIndexedPathStep GuiFontRegisteredFaceSimpleGlyphIndexedPathError \indexed\policy\state\span\cursor:
    let collection %&GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_font_registered_face_simple_glyph_indexed_owner_collection_ref &indexed
    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_contour_step_checked_span collection span cursor:
        Result::Err contour_error:
            let owner %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_owner indexed policy state
            Result::Err gui_font_registered_face_simple_glyph_indexed_path_error owner GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind::ContourStepFailed none some contour_error
        Result::Ok contour_step:
            let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index &cursor
            let sink_step %GuiSfntSimpleGlyphPathSinkStep gui_sfnt_simple_glyph_path_sink_step_from_contour_step &policy &contour_step
            let next_state %GuiFontRegisteredFaceSimpleGlyphIndexedPathState gui_font_registered_face_simple_glyph_indexed_path_next_state &indexed span contour_index &contour_step
            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_owner indexed policy next_state
            Result::Ok gui_font_registered_face_simple_glyph_indexed_path_step_value sink_step next_owner

//: gui_font_registered_face_simple_glyph_indexed_path_step: registered traversalを1 sink step進める
//:
//: [契約/けいやく]: `PendingContour`だけがspan lookupを1回呼び、`ActiveContour`は保存済みspanを使います。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedPathStep GuiFontRegisteredFaceSimpleGlyphIndexedPathError \owner:
    let policy %GuiSfntSimpleGlyphPathSinkPolicy *field::get_ref &owner "policy"
    let state %GuiFontRegisteredFaceSimpleGlyphIndexedPathState *field::get_ref &owner "state"
    let indexed %GuiFontRegisteredFaceSimpleGlyphIndexedOwner field::get owner "indexed"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::PendingContour contour_index:
            match gui_font_registered_face_simple_glyph_indexed_owner_span_lookup &indexed contour_index:
                Result::Err lookup_error:
                    let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_owner indexed policy state
                    Result::Err gui_font_registered_face_simple_glyph_indexed_path_error recovered GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind::SpanIndexLookupFailed some lookup_error none
                Result::Ok span:
                    let span_glyph %GuiGlyphId gui_sfnt_simple_glyph_contour_span_glyph &span
                    let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor span_glyph contour_index 0 GuiSfntSimpleGlyphPathSinkEventSlot::First
                    gui_font_registered_face_simple_glyph_indexed_path_step_with_span indexed policy state span cursor
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::ActiveContour active:
            let span %GuiSfntSimpleGlyphContourSpan *field::get_ref &active "span"
            let cursor %GuiSfntSimpleGlyphPathContourCursor *field::get_ref &active "cursor"
            gui_font_registered_face_simple_glyph_indexed_path_step_with_span indexed policy state span cursor
        GuiFontRegisteredFaceSimpleGlyphIndexedPathState::Completed:
            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_owner indexed policy state
            Result::Err gui_font_registered_face_simple_glyph_indexed_path_error recovered GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind::AlreadyCompleted none none

//: gui_font_registered_face_simple_glyph_indexed_path_drain_budget: terminal-before-budgetで最大1 sink step進める
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_drain_budget %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStep GuiFontRegisteredFaceSimpleGlyphIndexedPathError \owner\remaining_steps:
    match gui_font_registered_face_simple_glyph_indexed_path_progress_kind &owner:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::Completed:
            Result::Ok gui_font_registered_face_simple_glyph_indexed_path_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::Completed
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::PendingContour:
            if le remaining_steps 0:
                then:
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_path_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::StepBudgetExhausted
                else:
                    match gui_font_registered_face_simple_glyph_indexed_path_step owner:
                        Result::Err error:
                            Result::Err error
                        Result::Ok step:
                            let sink_step %GuiSfntSimpleGlyphPathSinkStep gui_font_registered_face_simple_glyph_indexed_path_step_sink_step &step
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_step_take_owner step
                            Result::Ok gui_font_registered_face_simple_glyph_indexed_path_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::Emitted sink_step
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::ActiveContour:
            if le remaining_steps 0:
                then:
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_path_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::StepBudgetExhausted
                else:
                    match gui_font_registered_face_simple_glyph_indexed_path_step owner:
                        Result::Err error:
                            Result::Err error
                        Result::Ok step:
                            let sink_step %GuiSfntSimpleGlyphPathSinkStep gui_font_registered_face_simple_glyph_indexed_path_step_sink_step &step
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_step_take_owner step
                            Result::Ok gui_font_registered_face_simple_glyph_indexed_path_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus::Emitted sink_step

