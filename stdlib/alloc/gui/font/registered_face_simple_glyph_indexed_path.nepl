fn gui_font_registered_face_simple_glyph_indexed_path_budget_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStep \owner\status:
    GuiFontRegisteredFaceSimpleGlyphIndexedPathBudgetStep owner status

