//: GuiFontRegisteredFaceSimpleGlyphCollectionTerminal: 1 point commit 後の継続または完了 owner
//:
//: [注意/ちゅうい]: owner を保持するため `Clone` / `Copy` は実装しません。
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphCollectionTerminal:
    Collecting %GuiFontRegisteredFaceSimpleGlyphCollectionOwner
    Completed %GuiFontRegisteredFaceSimpleGlyphCollectedOwner

//: gui_font_registered_face_simple_glyph_collection_terminal_free: terminal が保持する owner を branch ごとに閉じる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_collection_terminal_free %impure fn GuiFontRegisteredFaceSimpleGlyphCollectionTerminal unit \terminal:
    match terminal:
        GuiFontRegisteredFaceSimpleGlyphCollectionTerminal::Collecting owner:
            gui_font_registered_face_simple_glyph_collection_owner_free owner
        GuiFontRegisteredFaceSimpleGlyphCollectionTerminal::Completed owner:
            gui_font_registered_face_simple_glyph_collected_owner_free owner

//: gui_font_registered_face_simple_glyph_collection_completion_is_valid: End cursor と collection を source topologyへ照合する
//:
//: [計算量/けいさんりょう]: 固定個数の field だけを比較するため O(1) です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_collection_completion_is_valid %fn &GuiFontRegisteredFaceSimpleGlyphCollectionOwner fn &GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor bool \owner\end_cursor:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_sequential_reader_cursor_evidence end_cursor
    let stream %GuiSfntSimpleGlyphPointStream gui_font_registered_face_simple_glyph_point_stream_stream &evidence
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let expected_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
    let expected_contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
    let expected_point_count %i32 gui_font_registered_face_simple_glyph_collection_owner_expected_point_count owner
    let collection %&GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_font_registered_face_simple_glyph_collection_owner_collection_ref owner
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity collection
    let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
    let lower %GuiSfntSimpleGlyphSequentialPointCursor gui_font_registered_face_simple_glyph_sequential_reader_cursor_lower end_cursor
    and gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity and eq gui_glyph_id_raw &capacity_glyph gui_glyph_id_raw &expected_glyph and eq gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity expected_contour_count and eq gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity expected_point_count and eq gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count collection expected_point_count and eq gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_len collection expected_point_count and eq gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_cap collection expected_point_count and eq gui_sfnt_simple_glyph_sequential_point_cursor_logical_index &lower expected_point_count and eq gui_sfnt_simple_glyph_sequential_point_cursor_contour_index &lower sub expected_contour_count 1 eq gui_sfnt_simple_glyph_sequential_point_cursor_contour_endpoint &lower sub expected_point_count 1

//: gui_font_registered_face_simple_glyph_collection_step: reader を 1 回だけ進め、最大 1 point を collection へ commit する
//:
//: [契約/けいやく]: push failure は pre-step cursor と回収済み collection を返すため、retry で point を飛ばしません。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_collection_step %impure fn &GuiFontRegisteredFaceTableEntry impure fn GuiFontRegisteredFaceSimpleGlyphCollectionOwner Result GuiFontRegisteredFaceSimpleGlyphCollectionTerminal GuiFontRegisteredFaceSimpleGlyphCollectionStepError \entry\owner:
    let pre_step_cursor %GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor gui_font_registered_face_simple_glyph_collection_owner_cursor &owner
    let expected_point_count %i32 gui_font_registered_face_simple_glyph_collection_owner_expected_point_count &owner
    let actual_point_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count gui_font_registered_face_simple_glyph_collection_owner_collection_ref &owner
    match gui_font_registered_face_simple_glyph_sequential_reader_step entry pre_step_cursor:
        Result::Err reader_error:
            Result::Err gui_font_registered_face_simple_glyph_collection_step_error owner GuiFontRegisteredFaceSimpleGlyphCollectionStepErrorKind::ReaderStepFailed some reader_error none none none expected_point_count actual_point_count
        Result::Ok reader_terminal:
            match reader_terminal:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal::End end_cursor:
                    if:
                        lt actual_point_count expected_point_count
                        then:
                            Result::Err gui_font_registered_face_simple_glyph_collection_step_error owner GuiFontRegisteredFaceSimpleGlyphCollectionStepErrorKind::PrematureEnd none none none none expected_point_count actual_point_count
                        else:
                            if:
                                not gui_font_registered_face_simple_glyph_collection_completion_is_valid &owner &end_cursor
                                then:
                                    Result::Err gui_font_registered_face_simple_glyph_collection_step_error owner GuiFontRegisteredFaceSimpleGlyphCollectionStepErrorKind::CollectionInvariantInvalid none none none none expected_point_count actual_point_count
                                else:
                                    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_sequential_reader_cursor_evidence &end_cursor
                                    let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                                    Result::Ok GuiFontRegisteredFaceSimpleGlyphCollectionTerminal::Completed gui_font_registered_face_simple_glyph_collected_owner evidence collection
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal::Point reader_step:
                    let point %GuiSfntSimpleGlyphPoint gui_font_registered_face_simple_glyph_sequential_reader_step_point &reader_step
                    let next_cursor %GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor gui_font_registered_face_simple_glyph_sequential_reader_step_next_cursor &reader_step
                    let item %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item point
                    let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push collection item:
                        Result::Ok next_collection:
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphCollectionOwner gui_font_registered_face_simple_glyph_collection_owner next_cursor next_collection expected_point_count
                            Result::Ok GuiFontRegisteredFaceSimpleGlyphCollectionTerminal::Collecting next_owner
                        Result::Err push_error:
                            let push_kind %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_kind &push_error
                            let rejected_item %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_item &push_error
                            let storage_error %Option StdErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_storage_error &push_error
                            let recovered_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection push_error
                            let recovered_owner %GuiFontRegisteredFaceSimpleGlyphCollectionOwner gui_font_registered_face_simple_glyph_collection_owner pre_step_cursor recovered_collection expected_point_count
                            Result::Err gui_font_registered_face_simple_glyph_collection_step_error recovered_owner GuiFontRegisteredFaceSimpleGlyphCollectionStepErrorKind::CollectionPushFailed none some push_kind some rejected_item storage_error expected_point_count actual_point_count

