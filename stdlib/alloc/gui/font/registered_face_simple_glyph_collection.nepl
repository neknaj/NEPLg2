fn gui_font_registered_face_simple_glyph_collection_step_error %fn GuiFontRegisteredFaceSimpleGlyphCollectionOwner fn GuiFontRegisteredFaceSimpleGlyphCollectionStepErrorKind fn Option GuiFontRegisteredFaceSimpleGlyphSequentialReaderError fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind fn Option GuiSfntSimpleGlyphOutlinePointStreamItem fn Option StdErrorKind fn i32 fn i32 GuiFontRegisteredFaceSimpleGlyphCollectionStepError \owner\kind\reader_error\push_kind\rejected_item\storage_error\expected_point_count\actual_point_count:
    GuiFontRegisteredFaceSimpleGlyphCollectionStepError owner kind reader_error push_kind rejected_item storage_error expected_point_count actual_point_count

