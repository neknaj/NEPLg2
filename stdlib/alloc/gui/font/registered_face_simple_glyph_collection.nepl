//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphCollectionOwner:
    cursor %GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor
    collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection
    expected_point_count %i32

