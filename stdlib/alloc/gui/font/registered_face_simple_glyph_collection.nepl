//: gui_font_registered_face_simple_glyph_collected_owner_matches_provenance: collection shapeを検証済みsource topologyへ照合する
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_collected_owner_matches_provenance %fn &GuiFontRegisteredFaceSimpleGlyphCollectedOwner fn &GuiFontRegisteredFaceSimpleGlyphProvenance bool \owner\provenance:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_provenance_evidence provenance
    let stream %GuiSfntSimpleGlyphPointStream gui_font_registered_face_simple_glyph_point_stream_stream &evidence
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let expected_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
    let expected_contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
    let expected_point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let collection %&GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_font_registered_face_simple_glyph_collected_owner_collection_ref owner
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity collection
    let actual_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
    let glyph_ok %bool eq gui_glyph_id_raw &expected_glyph gui_glyph_id_raw &actual_glyph
    let contour_ok %bool eq expected_contour_count gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let point_ok %bool eq expected_point_count gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let item_count_ok %bool eq expected_point_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count collection
    let len_ok %bool eq expected_point_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_len collection
    let cap_ok %bool eq expected_point_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_cap collection
    and glyph_ok and contour_ok and point_ok and item_count_ok and len_ok cap_ok

