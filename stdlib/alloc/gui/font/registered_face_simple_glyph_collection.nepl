//: gui_font_registered_face_simple_glyph_span_index_start: completed registered collectionをsingle-pass index builderへ移す
//:
//: [契約/けいやく]: shared provenanceとcollection shapeを検証した後だけlower allocationを行います。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_span_index_start %impure fn &GuiFontRegisteredFaceTableEntry impure fn GuiFontRegisteredFaceSimpleGlyphCollectedOwner impure fn &GuiSfntSimpleGlyphContourSpanIndexLimit Result GuiFontRegisteredFaceSimpleGlyphSpanIndexBuilderOwner GuiFontRegisteredFaceSimpleGlyphSpanIndexStartError \entry\owner\limit:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_collected_owner_evidence &owner
    match gui_font_registered_face_simple_glyph_provenance_validate entry &evidence:
        Result::Err provenance_error:
            Result::Err gui_font_registered_face_simple_glyph_span_index_start_error owner GuiFontRegisteredFaceSimpleGlyphSpanIndexStartErrorKind::ProvenanceRejected *limit some provenance_error none none
        Result::Ok provenance:
            if not gui_font_registered_face_simple_glyph_collected_owner_matches_provenance &owner &provenance:
                then:
                    Result::Err gui_font_registered_face_simple_glyph_span_index_start_error owner GuiFontRegisteredFaceSimpleGlyphSpanIndexStartErrorKind::CollectionInvariantInvalid *limit none none none
                else:
                    let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                    match gui_sfnt_simple_glyph_contour_span_index_start collection limit:
                        Result::Ok lower:
                            Result::Ok gui_font_registered_face_simple_glyph_span_index_builder_owner evidence lower
                        Result::Err lower_error:
                            let lower_kind %GuiSfntSimpleGlyphContourSpanIndexStartErrorKind gui_sfnt_simple_glyph_contour_span_index_start_error_kind &lower_error
                            let storage_error %Option StdErrorKind gui_sfnt_simple_glyph_contour_span_index_start_error_storage_error &lower_error
                            let recovered_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_contour_span_index_start_error_take_collection lower_error
                            let recovered_owner %GuiFontRegisteredFaceSimpleGlyphCollectedOwner gui_font_registered_face_simple_glyph_collected_owner evidence recovered_collection
                            Result::Err gui_font_registered_face_simple_glyph_span_index_start_error recovered_owner GuiFontRegisteredFaceSimpleGlyphSpanIndexStartErrorKind::LowerStartRejected *limit none some lower_kind storage_error

