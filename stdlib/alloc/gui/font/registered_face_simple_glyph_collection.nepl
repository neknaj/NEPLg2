//: # alloc/gui/font/registered_face_simple_glyph_collection
//: registered face simple glyph reader を classified point collection へ線形に接続する owner 境界
//:
//: ### [目的/もくてき]
//: - F5nt の registered sequential reader を 1 point ずつ進め、既存の classified point collection へ追加します。
//: - reader cursor と collection を同じ owner に束ね、中断、再開、失敗回収で未確定 point を失わないようにします。
//:
//: ### [契約/けいやく]
//: - start は entry / evidence provenance を検証してから exact point capacity を確保します。
//: - push 失敗時は pre-step cursor と回収した collection を再結合し、再試行時に同じ point を読み直します。
//: - owner、completed owner、owner-bearing terminal / error は `Clone` / `Copy` を実装しません。
//: - 旧 random-access reader、path、raster、render2d、platform API、fallback は使いません。
//:
//: ### [計算量/けいさんりょう]
//: - 1 step は償却 O(1)、成功する全 point / contour 収集は O(p + c)、storage は O(p) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/registered_face_simple_glyph_collection" as *
//: ```

#indent 4

#import "alloc/gui/font/registered_face_simple_glyph_lookup" as *
#import "alloc/gui/font/registered_face_simple_glyph_provenance" as *
#import "alloc/gui/font/registered_face_simple_glyph_reader" as *
#import "alloc/gui/font/registered_face_table" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

