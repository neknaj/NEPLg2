//: gui_font_registered_face_simple_glyph_collection_start: provenance 検証後に exact capacity collection を確保する
//:
//: [契約/けいやく]: reader start を collection allocation より先に行うため、foreign evidence では storage を確保しません。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_collection_start %impure fn &GuiFontRegisteredFaceTableEntry impure fn &GuiFontRegisteredFaceSimpleGlyphPointStream impure fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollectionLimit Result GuiFontRegisteredFaceSimpleGlyphCollectionOwner GuiFontRegisteredFaceSimpleGlyphCollectionStartError \entry\evidence_ref\limit:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream *evidence_ref
    match gui_font_registered_face_simple_glyph_sequential_reader_start entry evidence_ref:
        Result::Err reader_error:
            Result::Err gui_font_registered_face_simple_glyph_collection_start_error GuiFontRegisteredFaceSimpleGlyphCollectionStartErrorKind::ReaderStartFailed evidence *limit some reader_error none none
        Result::Ok cursor:
            let stream %GuiSfntSimpleGlyphPointStream gui_font_registered_face_simple_glyph_point_stream_stream evidence_ref
            let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
            let capacity_check %GuiSfntSimpleGlyphOutlineCapacityCheck gui_sfnt_simple_glyph_outline_storage_capacity_from_topology &topology
            match capacity_check:
                GuiSfntSimpleGlyphOutlineCapacityCheck::InvalidTopology _topology:
                    Result::Err gui_font_registered_face_simple_glyph_collection_start_error GuiFontRegisteredFaceSimpleGlyphCollectionStartErrorKind::InvalidTopology evidence *limit none some capacity_check none
                GuiSfntSimpleGlyphOutlineCapacityCheck::CommandCountOverflow _topology:
                    Result::Err gui_font_registered_face_simple_glyph_collection_start_error GuiFontRegisteredFaceSimpleGlyphCollectionStartErrorKind::CommandCountOverflow evidence *limit none some capacity_check none
                GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected _rejected:
                    Result::Err gui_font_registered_face_simple_glyph_collection_start_error GuiFontRegisteredFaceSimpleGlyphCollectionStartErrorKind::CapacityRejected evidence *limit none some capacity_check none
                GuiSfntSimpleGlyphOutlineCapacityCheck::Fits capacity:
                    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_alloc &capacity limit:
                        Result::Err alloc_error:
                            Result::Err gui_font_registered_face_simple_glyph_collection_start_error GuiFontRegisteredFaceSimpleGlyphCollectionStartErrorKind::CollectionAllocFailed evidence *limit none some capacity_check some alloc_error
                        Result::Ok collection:
                            let expected_point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
                            Result::Ok gui_font_registered_face_simple_glyph_collection_owner cursor collection expected_point_count

