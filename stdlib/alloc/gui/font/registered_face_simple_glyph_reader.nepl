pub fn gui_font_registered_face_simple_glyph_sequential_reader_step_next_cursor %fn &GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor \step:
    *field::get_ref step "next_cursor"

//: GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal: registered reader の point / end terminal
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal:
    Point %GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep
    End %GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal \terminal:
        *terminal

impl Copy for GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal \terminal:
        terminal

//: gui_font_registered_face_simple_glyph_sequential_reader_start: F5ns evidence から registered cursor を[始/はじ]める
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_sequential_reader_start %fn &GuiFontRegisteredFaceTableEntry fn &GuiFontRegisteredFaceSimpleGlyphPointStream Result GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor GuiFontRegisteredFaceSimpleGlyphSequentialReaderError \entry\evidence_ref:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream *evidence_ref
    match gui_font_registered_face_simple_glyph_sequential_validate entry evidence none:
        Result::Err error:
            Result::Err error
        Result::Ok validation:
            let source %GuiSfntSimpleGlyphPointStreamSource *field::get_ref &validation "source"
            let face_ref %&GuiFontRegisteredFace gui_font_registered_face_table_entry_face_ref entry
            let resource_ref %&GuiFontResourceBytes gui_font_registered_face_resource_ref face_ref
            let bytes %&ByteBuf gui_font_resource_bytes_ref resource_ref
            match gui_sfnt_simple_glyph_sequential_point_start bytes source:
                Result::Err lower_error:
                    let parse_error %GuiSfntParseError gui_sfnt_simple_glyph_sequential_point_error_parse_error &lower_error
                    let record %GuiFontRegisteredFaceRecord *field::get_ref &validation "record"
                    Result::Err gui_font_registered_face_simple_glyph_sequential_reader_error GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStartFailed record evidence none none some parse_error
                Result::Ok lower_cursor:
                    Result::Ok gui_font_registered_face_simple_glyph_sequential_reader_cursor evidence lower_cursor

//: gui_font_registered_face_simple_glyph_sequential_reader_step: registered cursor を 1 point [進/すす]める
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_sequential_reader_step %fn &GuiFontRegisteredFaceTableEntry fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor Result GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal GuiFontRegisteredFaceSimpleGlyphSequentialReaderError \entry\cursor:
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_sequential_reader_cursor_evidence &cursor
    match gui_font_registered_face_simple_glyph_sequential_validate entry evidence some cursor:
        Result::Err error:
            Result::Err error
        Result::Ok validation:
            let face_ref %&GuiFontRegisteredFace gui_font_registered_face_table_entry_face_ref entry
            let resource_ref %&GuiFontResourceBytes gui_font_registered_face_resource_ref face_ref
            let bytes %&ByteBuf gui_font_resource_bytes_ref resource_ref
            let lower_cursor %GuiSfntSimpleGlyphSequentialPointCursor gui_font_registered_face_simple_glyph_sequential_reader_cursor_lower &cursor
            match gui_sfnt_simple_glyph_sequential_point_step bytes lower_cursor:
                Result::Err lower_error:
                    let parse_error %GuiSfntParseError gui_sfnt_simple_glyph_sequential_point_error_parse_error &lower_error
                    let record %GuiFontRegisteredFaceRecord *field::get_ref &validation "record"
                    Result::Err gui_font_registered_face_simple_glyph_sequential_reader_error GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStepFailed record evidence some cursor none some parse_error
                Result::Ok terminal:
                    match terminal:
                        GuiSfntSimpleGlyphSequentialPointTerminal::End end_cursor:
                            Result::Ok GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal::End gui_font_registered_face_simple_glyph_sequential_reader_cursor evidence end_cursor
                        GuiSfntSimpleGlyphSequentialPointTerminal::Point lower_step:
                            let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_sequential_point_step_point &lower_step
                            let next_lower %GuiSfntSimpleGlyphSequentialPointCursor gui_sfnt_simple_glyph_sequential_point_step_next_cursor &lower_step
                            let next_cursor %GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor gui_font_registered_face_simple_glyph_sequential_reader_cursor evidence next_lower
                            Result::Ok GuiFontRegisteredFaceSimpleGlyphSequentialReaderTerminal::Point gui_font_registered_face_simple_glyph_sequential_reader_step_value point next_cursor
