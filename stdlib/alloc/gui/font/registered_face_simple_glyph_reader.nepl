    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep \step:
        step

//: gui_font_registered_face_simple_glyph_sequential_reader_step_value: decoded point と next cursor を束ねる内部constructor
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_reader_step_value %fn GuiSfntSimpleGlyphPoint fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep \point\next_cursor:
    GuiFontRegisteredFaceSimpleGlyphSequentialReaderStep point next_cursor

