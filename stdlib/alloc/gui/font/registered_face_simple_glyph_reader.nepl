//: GuiFontRegisteredFaceSimpleGlyphSequentialValidation: bytes read 前に確定した canonical provenance の内部結果
//:
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphSequentialValidation:
    record %GuiFontRegisteredFaceRecord
    evidence %GuiFontRegisteredFaceSimpleGlyphPointStream
    source %GuiSfntSimpleGlyphPointStreamSource

//: gui_font_registered_face_simple_glyph_sequential_validation: canonical record、evidence、source を束ねる内部constructor
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_validation %fn GuiFontRegisteredFaceRecord fn GuiFontRegisteredFaceSimpleGlyphPointStream fn GuiSfntSimpleGlyphPointStreamSource GuiFontRegisteredFaceSimpleGlyphSequentialValidation \record\evidence\source:
    GuiFontRegisteredFaceSimpleGlyphSequentialValidation record evidence source

//: gui_font_registered_face_simple_glyph_sequential_reader_error_from_provenance: shared provenance error を reader domain へ写す
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_reader_error_from_provenance %fn GuiFontRegisteredFaceSimpleGlyphProvenanceError fn Option GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor GuiFontRegisteredFaceSimpleGlyphSequentialReaderError \provenance_error\cursor:
    let shared_kind %GuiFontRegisteredFaceSimpleGlyphProvenanceErrorKind gui_font_registered_face_simple_glyph_provenance_error_kind &provenance_error
    let kind %GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind match shared_kind:
        GuiFontRegisteredFaceSimpleGlyphProvenanceErrorKind::EntryValidationFailed:
            GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EntryValidationFailed
        GuiFontRegisteredFaceSimpleGlyphProvenanceErrorKind::EvidenceRecordMismatch:
            GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EvidenceRecordMismatch
        GuiFontRegisteredFaceSimpleGlyphProvenanceErrorKind::SourceTableMismatch:
            GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceTableMismatch
        GuiFontRegisteredFaceSimpleGlyphProvenanceErrorKind::SourceGlyphMismatch:
            GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceGlyphMismatch
    let record %GuiFontRegisteredFaceRecord gui_font_registered_face_simple_glyph_provenance_error_record &provenance_error
    let evidence %GuiFontRegisteredFaceSimpleGlyphPointStream gui_font_registered_face_simple_glyph_provenance_error_evidence &provenance_error
    let validation_error %Option GuiFontRegisteredFaceTableEntryValidationError gui_font_registered_face_simple_glyph_provenance_error_validation_error &provenance_error
    gui_font_registered_face_simple_glyph_sequential_reader_error kind record evidence cursor validation_error none

//: gui_font_registered_face_simple_glyph_sequential_validate: owner、record、source identity を bytes read 前に検証する
//:
//: [計算量/けいさんりょう]: 固定個数のCopy field比較だけを行うためO(1)です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_validate %fn &GuiFontRegisteredFaceTableEntry fn GuiFontRegisteredFaceSimpleGlyphPointStream fn Option GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor Result GuiFontRegisteredFaceSimpleGlyphSequentialValidation GuiFontRegisteredFaceSimpleGlyphSequentialReaderError \entry\evidence\cursor:
    match gui_font_registered_face_simple_glyph_provenance_validate entry &evidence:
        Result::Err provenance_error:
            Result::Err gui_font_registered_face_simple_glyph_sequential_reader_error_from_provenance provenance_error cursor
        Result::Ok provenance:
            let canonical_record %GuiFontRegisteredFaceRecord gui_font_registered_face_simple_glyph_provenance_record &provenance
            let source %GuiSfntSimpleGlyphPointStreamSource gui_font_registered_face_simple_glyph_provenance_source &provenance
            let cursor_source_matches %bool match cursor:
                Option::None:
                    true
                Option::Some reader_cursor:
                    let lower_cursor %GuiSfntSimpleGlyphSequentialPointCursor gui_font_registered_face_simple_glyph_sequential_reader_cursor_lower &reader_cursor
                    let lower_source %GuiSfntSimpleGlyphPointStreamSource gui_sfnt_simple_glyph_sequential_point_cursor_source &lower_cursor
                    gui_sfnt_simple_glyph_point_stream_source_eq &source &lower_source
            if not cursor_source_matches:
                then:
                    Result::Err gui_font_registered_face_simple_glyph_sequential_reader_error GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceIdentityMismatch canonical_record evidence cursor none none
                else:
                    Result::Ok gui_font_registered_face_simple_glyph_sequential_validation canonical_record evidence source

