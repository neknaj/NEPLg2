//: gui_font_registered_face_simple_glyph_sequential_reader_error: failure stage と回収可能な evidence を束ねる内部constructor
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_reader_error %fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind fn GuiFontRegisteredFaceRecord fn GuiFontRegisteredFaceSimpleGlyphPointStream fn Option GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor fn Option GuiFontRegisteredFaceTableEntryValidationError fn Option GuiSfntParseError GuiFontRegisteredFaceSimpleGlyphSequentialReaderError \kind\record\evidence\cursor\validation_error\parse_error:
    GuiFontRegisteredFaceSimpleGlyphSequentialReaderError kind record evidence cursor validation_error parse_error

//: gui_font_registered_face_simple_glyph_sequential_reader_error_kind_eq: error kind を[比/くら]べる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_sequential_reader_error_kind_eq %fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind bool \left\right:
    match left:
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EntryValidationFailed:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EntryValidationFailed:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EvidenceRecordMismatch:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::EvidenceRecordMismatch:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceTableMismatch:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceTableMismatch:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceIdentityMismatch:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceIdentityMismatch:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceGlyphMismatch:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SourceGlyphMismatch:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStartFailed:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStartFailed:
                    true
                _:
                    false
        GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStepFailed:
            match right:
                GuiFontRegisteredFaceSimpleGlyphSequentialReaderErrorKind::SequentialStepFailed:
                    true
                _:
                    false

