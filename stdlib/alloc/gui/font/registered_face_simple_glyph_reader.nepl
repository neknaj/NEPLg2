        *cursor

impl Copy for GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor \cursor:
        cursor

//: gui_font_registered_face_simple_glyph_sequential_reader_cursor: provenance と lower cursor を束ねる内部constructor
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_sequential_reader_cursor %fn GuiFontRegisteredFaceSimpleGlyphPointStream fn GuiSfntSimpleGlyphSequentialPointCursor GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor \evidence\lower:
    GuiFontRegisteredFaceSimpleGlyphSequentialReaderCursor evidence lower

