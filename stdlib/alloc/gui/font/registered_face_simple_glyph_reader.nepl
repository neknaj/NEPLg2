//: # alloc/gui/font/registered_face_simple_glyph_reader
//: registered face simple glyph source を逐次 point decoder へ[接続/せつぞく]する境界
//:
//: ### [目的/もくてき]
//: - F5ns evidence と同じ registered face entry を再検証し、source-bound cursor で glyph point を先頭から一度ずつ[読/よ]みます。
//: - registered cursor に evidence と lower cursor を[束/たば]ね、step 時の source [差/さ]し[替/か]えを API shape で[防/ふせ]ぎます。
//:
//: ### [契約/けいやく]
//: - entry、evidence、cursor は消費しません。bytes owner は entry に[残/のこ]ります。
//: - entry record、face-owned metadata の `glyf` record、mapping glyph、source identity を bytes read より前に[照合/しょうごう]します。
//: - 旧 random-access point / outline drain、path、raster、render2d、platform API、fallback は使いません。
//:
//: ### [計算量/けいさんりょう]
//: - 1 step は償却 O(1)、全 point / contour は O(p + c)、追加 storage は O(1) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/registered_face_simple_glyph_reader" as *
//: ```

#indent 4

#import "alloc/gui/font/registered_face" as *
#import "alloc/gui/font/registered_face_glyph_lookup" as *
#import "alloc/gui/font/registered_face_simple_glyph_lookup" as *
#import "alloc/gui/font/registered_face_simple_glyph_provenance" as *
#import "alloc/gui/font/registered_face_table" as *
#import "alloc/gui/font/resource" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

