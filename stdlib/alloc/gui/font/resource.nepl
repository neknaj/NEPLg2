    expected_hash %Option GuiResourceHash
    decode_policy %GuiFontDecodePolicy

impl Clone for GuiFontResourceRequest:
    fn clone %fn &GuiFontResourceRequest GuiFontResourceRequest \request:
        *request

impl Copy for GuiFontResourceRequest:
    fn copy_mark %fn GuiFontResourceRequest GuiFontResourceRequest \request:
        request

//: GuiFontResourceBytes: provider から[取得/しゅとく]した font resource bytes owner
//:
//: `ByteBuf` owner を[保持/ほじ]するため、この型は Copy / Clone にしません。
//:
//: neplg2:test[skip]
pub struct GuiFontResourceBytes:
    request %GuiFontResourceRequest
    source %GuiFontResourceSource
    byte_len %i32
    actual_hash %GuiResourceHash
    decode_policy %GuiFontDecodePolicy
    bytes %ByteBuf

