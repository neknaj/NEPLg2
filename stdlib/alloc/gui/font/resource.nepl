impl Copy for GuiFontResourcePath:
    fn copy_mark %fn GuiFontResourcePath GuiFontResourcePath \path:
        path

//: GuiFontResourcePathErrorKind: font resource path validation の[失敗/しっぱい][分類/ぶんるい]
//:
//: public resource path は leading slash を[持/も]たない canonical path です。Web VFS の内部 file path とは[分/わ]けて[扱/あつか]います。
//:
//: neplg2:test[skip]
pub enum GuiFontResourcePathErrorKind:
    Empty
    Absolute
    Backslash
    EmptySegment
    DotSegment
    ParentSegment

impl Clone for GuiFontResourcePathErrorKind:
    fn clone %fn &GuiFontResourcePathErrorKind GuiFontResourcePathErrorKind \kind:
        *kind

impl Copy for GuiFontResourcePathErrorKind:
    fn copy_mark %fn GuiFontResourcePathErrorKind GuiFontResourcePathErrorKind \kind:
        kind

//: GuiFontResourceProviderErrorKind: font bytes provider の[失敗/しっぱい][分類/ぶんるい]
//:
//: resource provider は path、payload kind、hash、decode policy を typed error として[返/かえ]します。
//:
//: neplg2:test[skip]
pub enum GuiFontResourceProviderErrorKind:
    InvalidPath
    MissingResource
    PayloadNotBinary
    HashMismatch
    UnsupportedDecodePolicy
    UnsupportedProvider
    OutOfMemory
    BackendFailure
    ResourceExhausted

impl Clone for GuiFontResourceProviderErrorKind:
    fn clone %fn &GuiFontResourceProviderErrorKind GuiFontResourceProviderErrorKind \kind:
        *kind

impl Copy for GuiFontResourceProviderErrorKind:
    fn copy_mark %fn GuiFontResourceProviderErrorKind GuiFontResourceProviderErrorKind \kind:
        kind

