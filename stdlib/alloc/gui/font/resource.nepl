//: gui_font_resource_bytebuf_fnv1a32_loop: ByteBuf payload を FNV-1a state へ[混/ま]ぜる
//:
//: `ByteBuf` owner は借用し、out-of-range は sentinel byte にせず現在の state で停止します。
//:
//: neplg2:test[skip]
fn gui_font_resource_bytebuf_fnv1a32_loop %fn &ByteBuf fn i32 fn i32 fn Fnv1a32 Fnv1a32 \bytes\n\idx\h:
    if:
        ge idx n
        then:
            h
        else:
            match io_bytebuf_byte_at bytes idx:
                Option::Some b:
                    gui_font_resource_bytebuf_fnv1a32_loop bytes n add idx 1 fnv1a32_update h b
                Option::None:
                    h

//: gui_font_resource_bytes_hash: font resource bytes の stable hash を[計算/けいさん]する
//:
//: [目的/もくてき]:
//: - provider が[返/かえ]した byte payload を、platform API に[依存/いそん]しない FNV-1a 32-bit bit pattern へ[写/うつ]します。
//:
//: neplg2:test[skip]
pub fn gui_font_resource_bytes_hash %fn &ByteBuf GuiResourceHash \bytes:
    let n %i32 io_bytebuf_len_ref bytes
    let h0 %Fnv1a32 new_fnv1a32
    let h1 %Fnv1a32 gui_font_resource_bytebuf_fnv1a32_loop bytes n 0 h0
    gui_resource_hash fnv1a32_finalize h1

//: gui_font_resource_validate_bytes_hash: optional expected hash を provider bytes と[照合/しょうごう]する
//:
//: `None` は hash pinning なし、`Some` は `GuiResourceHash` raw bit pattern の完全一致です。
//:
//: neplg2:test[skip]
pub fn gui_font_resource_validate_bytes_hash %fn &ByteBuf fn Option GuiResourceHash Result unit GuiFontResourceProviderErrorKind \bytes\expected:
    match expected:
        Option::None:
            Result::Ok unit
        Option::Some expected_hash:
            let actual %GuiResourceHash gui_font_resource_bytes_hash bytes
            if eq gui_resource_hash_raw &actual gui_resource_hash_raw &expected_hash:
                then Result::Ok unit
                else Result::Err GuiFontResourceProviderErrorKind::HashMismatch

//: gui_font_resource_validate_request_bytes_hash: request の expected hash と provider bytes を[照合/しょうごう]する
//:
//: request が hash pinning を[持/も]たない[場合/ばあい]は成功とし、持つ場合は payload hash と完全一致させます。
//:
//: neplg2:test[skip]
pub fn gui_font_resource_validate_request_bytes_hash %fn &GuiFontResourceRequest fn &ByteBuf Result unit GuiFontResourceProviderErrorKind \request\bytes:
    let expected %Option GuiResourceHash gui_font_resource_request_expected_hash request
    gui_font_resource_validate_bytes_hash bytes expected

//: gui_font_resource_bytes_new: provider result bytes owner を[作/つく]る
//:
//: neplg2:test[skip]
pub fn gui_font_resource_bytes_new %fn GuiFontResourceRequest fn GuiFontResourceSource fn ByteBuf GuiFontResourceBytes \request\source\bytes:
    let byte_len %i32 io_bytebuf_len_ref &bytes
    let actual_hash %GuiResourceHash gui_font_resource_bytes_hash &bytes
    let decode_policy %GuiFontDecodePolicy gui_font_resource_request_decode_policy &request
    GuiFontResourceBytes request source byte_len actual_hash decode_policy bytes

//: gui_font_resource_bytes_request: bytes owner の request を[読/よ]む
//:
//: neplg2:test[skip]
pub fn gui_font_resource_bytes_request %fn &GuiFontResourceBytes GuiFontResourceRequest \resource:
    *field::get_ref resource "request"

//: gui_font_resource_bytes_source: bytes owner の provider source を[読/よ]む
//:
//: neplg2:test[skip]
pub fn gui_font_resource_bytes_source %fn &GuiFontResourceBytes GuiFontResourceSource \resource:
    *field::get_ref resource "source"

//: gui_font_resource_bytes_len: bytes owner の payload 長を[読/よ]む
