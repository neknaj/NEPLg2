//: # registered resumed Run schedule test adapter
//: actual RunRecordを既存InFrame drainへ一度だけ反映します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_resumed_run_record_test" as fixture with tests
#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_resumed_run_schedule" as *
#import "core/math" as *
#import "core/result" as *
#import "std/gui/compositor_tile_present_dispatch" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
#import "std/gui/compositor_tile_present_schedule" as *
#import "std/gui/compositor_tile_present_virtual_drain" as *

fn resumed_run_schedule_state_evidence %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState i32 \state:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    let drain %GuiRgba8888CompositorTileRlePresentVirtualDrain gui_rgba8888_compositor_tile_rle_present_schedule_state_drain &schedule
    let evidence1 %i32 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 1 then 1 else 0
    let evidence2 %i32 add evidence1 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 16 then 2 else 0
    let evidence3 %i32 add evidence2 if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_run_count &drain 1 then 4 else 0
    add evidence3 if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_pixel_count &drain 16 then 8 else 0

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_test_owner %impure fn unit Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunScheduleOwner i32 \_unit:
    match gui_rgba8888_compositor_tile_rle_present_schedule_policy 2 32:
        Result::Err _: Result::Err sub 0 1
        Result::Ok policy:
            match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_test_owner _unit:
                Result::Err evidence: Result::Err evidence
                Result::Ok record_owner:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_into_schedule &policy record_owner:
                        Result::Err error:
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_error_free error:
                                Result::Err _: Result::Err sub 0 1
                                Result::Ok _: Result::Err 0
                        Result::Ok owner: Result::Ok owner

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_test_contract %impure fn unit i32 \_unit:
    match gui_rgba8888_compositor_tile_rle_present_schedule_policy 2 32:
        Result::Err _: sub 0 1
        Result::Ok policy:
            match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_test_owner _unit:
                Result::Err evidence: evidence
                Result::Ok record_owner:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_into_schedule &policy record_owner:
                        Result::Err error:
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_error_free error:
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        Result::Ok owner:
                            let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_state &owner
                            let phase %GuiRgba8888CompositorTileRlePresentSchedulePhase gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_phase &owner
                            let evidence1 %i32 resumed_run_schedule_state_evidence &state
                            let evidence2 %i32 add evidence1 match phase:
                                GuiRgba8888CompositorTileRlePresentSchedulePhase::Continue: 16
                                _: 0
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_free owner:
                                Result::Err _: sub 0 1
                                Result::Ok _: add evidence2 32
