//: # registered stroke compositor tile RLE BeginFrame dispatch loop
//: F5nzhのsuccessful F5my stepをF5nc one-shot pendingへ接続します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_dispatch" as *
#import "core/field" as field
#import "core/result" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *

//: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner: F5nzh continuation authorityとF5nc pendingを保持する
//:
//: 後続bridgeが両authorityを一括移送するためCopy / Cloneを実装しません。
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner:
    dispatch_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchOwner
    pending %GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest

//: F5nzh ownerを消費し、successful F5my stepをF5ncへ一度だけ引き継ぐ
//:
//: lower record/schedule/request/dispatchを再実行せず、completion、F5mz action、host executionへ進みません。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_owner_into_loop %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner \owner:
    let dispatch_step %GuiRgba8888CompositorTileRlePresentDispatchStep gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_owner_step &owner
    let pending %GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest gui_rgba8888_compositor_tile_rle_present_dispatch_loop_adopt_initial_dispatch_pending dispatch_step
    GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner owner pending

//: owner内のF5nc pendingを借用する
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_loop_owner_pending %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner &GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest \owner:
    field::get_ref owner "pending"

//: abort時にsuccess ownerから元F5nzh continuation authorityを回収する
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_loop_owner_take_dispatch_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchOwner \owner:
    field::get owner "dispatch_owner"

//: abort時にregistered continuation authorityを閉じる
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_loop_owner_free %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchLoopOwner Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_owner_free gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_loop_owner_take_dispatch_owner owner
