//: # registered stroke compositor tile RLE storage bridge
//: F5nyl writer capacity plan authorityをF5ml encoded storageへ接続します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_writer_plan" as writer_plan_bridge
#import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
#import "alloc/gui/render2d/compositor_tile_rle_count_step" as *
#import "alloc/gui/render2d/compositor_tile_rle_encode_seed" as *
#import "alloc/gui/render2d/compositor_tile_rle_encode_cursor" as *
#import "alloc/gui/render2d/compositor_tile_rle_writer_plan" as *
#import "alloc/gui/render2d/compositor_tile_rle_storage" as *
#import "core/result" as *

//: registered completionからchecked writer planとencoded storageを各1回だけ進める
//:
//: nested Resultはstart、step、completed、seed、cursor、writer plan、storageの各error authorityを保持します。
//: writer plan successだけをF5mlへ渡し、write cursor、encoded seal、packet、presentへは進みません。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_packed_mask_resource_software_drain_completed_owner_into_compositor_tile_rle_storage_budget %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskResourceSoftwareDrainCompletedOwner impure fn GuiRgba8888CompositorFrameEntryConfig impure fn GuiRgba8888RowTilePlanConfig impure fn i32 impure fn i32 Result Result Result Result Result Result Result GuiRgba8888CompositorTileRleStorageOwner GuiRgba8888CompositorTileRleStoragePrepareError GuiRgba8888CompositorTileRleWriterPlanError GuiRgba8888CompositorTileRleEncodeCursorError GuiRgba8888CompositorTileRleEncodeSeedError GuiRgba8888CompositorTileRleCountCompletedError GuiRgba8888CompositorTileRleCountStepError GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskResourceSoftwareDrainCompositorTileRleCountStartBridgeError \completed\frame_config\tile_config\tile_index\remaining_steps:
    match writer_plan_bridge::gui_font_registered_face_simple_glyph_indexed_stroke_packed_mask_resource_software_drain_completed_owner_into_compositor_tile_rle_writer_plan_budget completed frame_config tile_config tile_index remaining_steps:
        Result::Err lower: Result::Err lower
        Result::Ok step_result:
            match step_result:
                Result::Err lower: Result::Ok Result::Err lower
                Result::Ok completed_result:
                    match completed_result:
                        Result::Err lower: Result::Ok Result::Ok Result::Err lower
                        Result::Ok seed_result:
                            match seed_result:
                                Result::Err lower: Result::Ok Result::Ok Result::Ok Result::Err lower
                                Result::Ok cursor_result:
                                    match cursor_result:
                                        Result::Err lower: Result::Ok Result::Ok Result::Ok Result::Ok Result::Err lower
                                        Result::Ok plan_result:
                                            match plan_result:
                                                Result::Err lower: Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok Result::Err lower
                                                Result::Ok plan:
                                                    match gui_rgba8888_compositor_tile_rle_storage_prepare plan:
                                                        Result::Err lower: Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok Result::Err lower
                                                        Result::Ok storage: Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok Result::Ok storage
