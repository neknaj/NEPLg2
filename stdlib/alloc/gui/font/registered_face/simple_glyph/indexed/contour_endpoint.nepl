//: # alloc/gui/font/registered_face/simple_glyph/indexed/contour_endpoint
//: registered contour span index から outline storage の contour endpoint region を順次構築する
//:
//: ### [契約/けいやく]
//: - start は F5nxc owner の empty invariant を一度だけ検査し、以後はこの phase 固有 invariant を使います。
//: - step は span lookup と owner-bound endpoint push をそれぞれ一度だけ行います。
//: - terminal、budget zero、step の順で判定し、失敗を別経路の成功へ置換しません。
//: - owner を保持する型は `Clone` / `Copy` を実装しません。
//:
//: ### [計算量/けいさんりょう]
//: start、invariant、step は定数時間、全 drain は contour 数に比例し、追加 metadata は定数領域です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/contour_endpoint" as *
//:| #import "std/test" as *
//:
//: fn main %fn void i32 \void:
//:     let status %GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointBudgetStatus::StepBudgetExhausted
//:     let typed %bool match status:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointBudgetStatus::StepBudgetExhausted: true
//:         _: false
//:     test_assertion_exit_code assert "contour endpoint budget status is typed" typed
//: ```

#indent 4

#import "alloc/gui/font/registered_face_simple_glyph_indexed_outline_storage" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

