//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_contour_endpoint_first_invalid %fn Option GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind fn Option GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind Option GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind \earlier\later:
    match earlier:
        Option::Some kind: some kind
        Option::None: later

//: [目的/もくてき]: canonical capacity と stored capacity の[一致/いっち]を[検査/けんさ]します。
//: [アルゴリズム]: glyph と[全/すべ]ての count field を[比較/ひかく]します。
//: [契約/けいやく]: [一項目/いちこうもく]でも[異/こと]なれば false を[返/かえ]します。
//: [計算量/けいさんりょう]: [時間/じかん]と[追加領域/ついかりょういき]は[定数/ていすう]です。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_contour_endpoint_capacity_same %fn &GuiSfntSimpleGlyphOutlineStorageCapacity fn &GuiSfntSimpleGlyphOutlineStorageCapacity bool \canonical\stored:
    let canonical_glyph gui_sfnt_simple_glyph_outline_storage_capacity_glyph canonical
    let stored_glyph gui_sfnt_simple_glyph_outline_storage_capacity_glyph stored
    let glyph_same eq gui_glyph_id_raw &canonical_glyph gui_glyph_id_raw &stored_glyph
    let contour_same eq gui_sfnt_simple_glyph_outline_storage_capacity_contour_count canonical gui_sfnt_simple_glyph_outline_storage_capacity_contour_count stored
    let point_same eq gui_sfnt_simple_glyph_outline_storage_capacity_point_count canonical gui_sfnt_simple_glyph_outline_storage_capacity_point_count stored
    let edge_same eq gui_sfnt_simple_glyph_outline_storage_capacity_edge_count canonical gui_sfnt_simple_glyph_outline_storage_capacity_edge_count stored
    let pair_same eq gui_sfnt_simple_glyph_outline_storage_capacity_path_command_pair_count canonical gui_sfnt_simple_glyph_outline_storage_capacity_path_command_pair_count stored
    let command_same eq gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count canonical gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count stored
    let first and glyph_same contour_same
    let second and first point_same
    let third and second edge_same
    let fourth and third pair_same
    and fourth command_same

