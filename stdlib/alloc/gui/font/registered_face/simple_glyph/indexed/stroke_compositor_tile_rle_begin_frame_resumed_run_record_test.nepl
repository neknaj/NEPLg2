//: # registered BeginFrame resumed Run record test adapter
//: actual F5nzn Run stepのF5mu projectionとreset済stateを検証します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_resumed_next_command_test" as fixture with tests
#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_resumed_run_record" as *
#import "core/cast" as *
#import "core/math" as *
#import "core/result" as *
#import "core/gui/color" as *
#import "alloc/gui/render2d/row_tile_rle" as *
#import "std/gui/compositor_tile_present_command_cursor" as *
#import "std/gui/compositor_tile_present_dispatch" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
#import "std/gui/compositor_tile_present_host_command" as *
#import "std/gui/compositor_tile_present_schedule" as *

fn resumed_run_record_reset_slice_counts %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState bool \state:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    and eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 0 eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 0

fn run_record_evidence %fn GuiRgba8888CompositorTileRlePresentHostCommandStepResult i32 \result:
    match result:
        GuiRgba8888CompositorTileRlePresentHostCommandStepResult::Completed: 0
        GuiRgba8888CompositorTileRlePresentHostCommandStepResult::Record record:
            match record:
                GuiRgba8888CompositorTileRlePresentHostCommandRecord::BeginFrame _: 0
                GuiRgba8888CompositorTileRlePresentHostCommandRecord::EndFrame _: 0
                GuiRgba8888CompositorTileRlePresentHostCommandRecord::RunRecord run_record:
                    let run %GuiRgba8888RowTileRleRun gui_rgba8888_compositor_tile_rle_present_host_command_run_record_run &run_record
                    let color %Rgba8888 gui_rgba8888_row_tile_rle_run_color &run
                    let expected_r %u8 cast 11
                    let expected_g %u8 cast 22
                    let expected_b %u8 cast 33
                    let expected_a %u8 cast 44
                    let evidence1 %i32 2
                    let evidence2 %i32 add evidence1 if eq gui_rgba8888_row_tile_rle_run_pixel_offset &run 0 then 4 else 0
                    let evidence3 %i32 add evidence2 if eq gui_rgba8888_row_tile_rle_run_pixel_count &run 16 then 8 else 0
                    add evidence3 if and and and eq rgba8888_r &color expected_r eq rgba8888_g &color expected_g eq rgba8888_b &color expected_b eq rgba8888_a &color expected_a then 16 else 0

fn step_is_run %fn GuiRgba8888CompositorTileRlePresentCommandCursorStepResult bool \result:
    match result:
        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Completed: false
        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
            match command:
                GuiRgba8888CompositorTileRlePresentCommand::Run _: true
                _: false

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_test_owner %impure fn unit Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunRecordOwner i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_next_command_test_owner _unit:
        Result::Err evidence: Result::Err evidence
        Result::Ok next_owner: Result::Ok gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_next_command_owner_into_run_record next_owner

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_test_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_next_command_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok next_owner:
            let owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunRecordOwner gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_next_command_owner_into_run_record next_owner
            let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_state &owner
            let result %GuiRgba8888CompositorTileRlePresentHostCommandStepResult gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_result &owner
            let step_result %GuiRgba8888CompositorTileRlePresentCommandCursorStepResult gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_step_result &owner
            let evidence1 %i32 if resumed_run_record_reset_slice_counts &state then 1 else 0
            let evidence2 %i32 add evidence1 run_record_evidence result
            let evidence3 %i32 add evidence2 if step_is_run step_result then 32 else 0
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_free owner:
                Result::Err _: sub 0 1
                Result::Ok _: add evidence3 64
