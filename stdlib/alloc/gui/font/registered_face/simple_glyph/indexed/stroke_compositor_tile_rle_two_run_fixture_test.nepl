//: # registered stroke compositor tile RLE two-run fixture
//: completed surface の1画素をproduction writerで変更し、production count bridgeが2 runを得ることを検証します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_count_step" as *
#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_count_start" as *
