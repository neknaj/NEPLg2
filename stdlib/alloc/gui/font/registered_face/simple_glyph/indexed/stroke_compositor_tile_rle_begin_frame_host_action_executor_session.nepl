    UnexpectedCompleted %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionUnexpectedCompleted

//: F5nzj ownerの両authorityを分離せずF5nh executor requestへ一度だけ進める
//:
//: executor outcomeを作らず、completion、actual host execution、platform presentationへ進みません。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_execution_driver_owner_into_host_action_executor_session_request %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostExecutionDriverOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult \owner:
    let dispatch_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchOwner field::get owner "dispatch_owner"
    let driver_pending %GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending field::get owner "driver_pending"
    let state %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionState gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_start driver_pending
    match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_request state:
        GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionRequestResult::Completed:
            let unexpected %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionUnexpectedCompleted GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionUnexpectedCompleted dispatch_owner
            GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::UnexpectedCompleted unexpected
        GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionRequestResult::Action session_pending:
            let next %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionOwner dispatch_owner session_pending
            GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::Action next

