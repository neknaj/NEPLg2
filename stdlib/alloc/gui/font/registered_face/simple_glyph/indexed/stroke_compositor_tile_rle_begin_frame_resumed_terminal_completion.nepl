//: terminal stepをexactly once解放し、成功時だけretained stateをCompletedへ写す
//:
//: request、executor outcome、pending completionを生成せず、cleanup failureはstateとlower kindを保持します。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_parts_complete %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCommandOwnerParts Result GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCompletionError \parts:
    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState field::get parts "state"
    match gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free field::get parts "step":
        Result::Err lower_kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCompletionError state lower_kind
        Result::Ok _: Result::Ok GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion::Completed state

pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_completion_error_state %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCompletionError GuiRgba8888CompositorTileRlePresentDispatchLoopState \error:
    *field::get_ref error "state"

pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_completion_error_lower_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCompletionError GuiRgba8888CompositorTileRleEncodedFinishErrorKind \error:
