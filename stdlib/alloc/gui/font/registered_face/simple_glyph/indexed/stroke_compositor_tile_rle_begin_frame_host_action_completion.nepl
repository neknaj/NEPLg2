    let session_pending %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionPending field::get owner "session_pending"
    match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_complete support session_pending outcome:
        Result::Ok completion:
            let completed %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionCompletionOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionCompletionOwner dispatch_owner completion
            Result::Ok completed
        Result::Err lower:
            let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_complete_error_category_value &lower
            let failure %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionCompletionError GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionCompletionError dispatch_owner category lower
            Result::Err failure

