fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_counts %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState fn i32 fn i32 bool \state\commands\pixels:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    and eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule commands eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule pixels

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok schedule_owner:
            let host %GuiHost gui_host_new (gui_capabilities_offscreen_pixel 64 64) none
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_into_host_request &host schedule_owner:
                Result::Err error:
                    let evidence %i32 if gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_is_run_record_expected &error then sub 0 2 else sub 0 3
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_free error:
                        Result::Err _: sub 0 1
                        Result::Ok _: evidence
                Result::Ok owner:
                    let pending %&GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_owner_pending &owner
                    let previous %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_previous pending
                    let next %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_next pending
                    let request %GuiRgba8888CompositorTileRlePresentHostImportRequest gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_request pending
                    let previous_ok %bool gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_counts &previous 0 0
                    let next_ok %bool gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_counts &next 1 16
                    let request_ok %bool match gui_rgba8888_compositor_tile_rle_present_host_import_request_record &request:
                        GuiRgba8888CompositorTileRlePresentHostCommandRecord::RunRecord _: true
                        _: false
                    let phase_ok %bool match gui_rgba8888_compositor_tile_rle_present_dispatch_loop_pending_post_phase pending:
                        GuiRgba8888CompositorTileRlePresentDispatchPostPhase::Continue: true
                        _: false
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _:
                            let evidence1 %i32 if previous_ok then 1 else 0
                            let evidence2 %i32 add evidence1 if next_ok then 2 else 0
                            let evidence3 %i32 add evidence2 if request_ok then 4 else 0
                            add evidence3 if phase_ok then 8 else 0

#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_failure_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok schedule_owner:
            let host %GuiHost gui_host_new gui_capabilities_headless none
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_into_host_request &host schedule_owner:
                Result::Ok owner:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Err error:
                    let previous %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_previous_state &error
                    let next %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_state &error
                    let previous_ok %bool gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_counts &previous 0 0
                    let next_ok %bool gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_test_counts &next 1 16
                    let host_ok %bool match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_host_error_value &error:
                        Option::Some lower:
                            match lower:
                                GuiError::Unsupported: true
                                _: false
                        _: false
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_free error:
                        Result::Err _: sub 0 1
                        Result::Ok _:
                            let evidence1 %i32 if previous_ok then 1 else 0
                            let evidence2 %i32 add evidence1 if next_ok then 2 else 0
                            let evidence3 %i32 add evidence2 if host_ok then 4 else 0
                            add evidence3 8
