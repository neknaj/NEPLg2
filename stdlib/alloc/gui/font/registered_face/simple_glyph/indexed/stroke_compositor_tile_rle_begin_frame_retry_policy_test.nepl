                    let category %Option GuiError field::get parts "category"
                    let diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic field::get parts "diagnostic"
                    let pending %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionPending field::get parts "session_pending"
                    let support %GuiRgba8888CompositorTileRlePresentHostExecutorSupport field::get parts "support"
                    let spent_budget %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget field::get parts "spent_budget"
                    let support_evidence %i32 match support:
                        GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen: 8
                        _: 0
                    let spent_evidence %i32 match spent_budget:
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget::Exhausted: 32
                        _: 0
                    let evidence %i32 add add add add gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_retry_policy_test_category_evidence category gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_retry_policy_test_diagnostic_evidence diagnostic gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_retry_policy_test_action_evidence &pending support_evidence spent_evidence
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_owner_free dispatch_owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: add evidence 16

