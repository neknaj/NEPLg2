                    let owner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagOwner edge GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagState::PendingContour pending
                    let invariant gui_font_registered_face_simple_glyph_indexed_path_command_tag_owner_phase_invariant_check &owner
