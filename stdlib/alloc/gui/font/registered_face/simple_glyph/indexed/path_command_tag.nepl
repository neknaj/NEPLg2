//: gui_font_registered_face_simple_glyph_indexed_path_command_tag_owner_phase_invariant_check: 処理の契約を一つの入口に固定します
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_command_tag_owner_phase_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck \owner:
    let edge %&GuiFontRegisteredFaceSimpleGlyphIndexedEdgeCompletedOwner field::get_ref owner "edge"
    match gui_font_registered_face_simple_glyph_indexed_edge_completed_owner_continuation_authority_check edge:
        GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid _kind: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::EdgeCompletionInvalid
        GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid:
            let cursor gui_font_registered_face_simple_glyph_indexed_path_command_tag_cursor owner
            let capacity gui_font_registered_face_simple_glyph_indexed_edge_completed_owner_capacity edge
            if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::CursorInvalid
                else:
                    let region_ok match gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor:
                        GuiSfntSimpleGlyphOutlineScalarRegion::PathCommandTag: true
                        _: false
                    if not region_ok:
                        then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::CursorRegionMismatch
                        else:
                            match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::PathCommandTag:
                                Result::Err _error: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::CursorCapacityMismatch
                                Result::Ok expected:
                                    let same_bounds and eq gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &expected eq gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &expected
                                    if not same_bounds:
                                        then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::CursorCapacityMismatch
                                        else:
                                            if ne gui_font_registered_face_simple_glyph_indexed_edge_completed_owner_storage_len edge gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor:
                                                then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::StorageProgressMismatch
                                                else:
                                                    let logical sub gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
                                                    let contour_count gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                                                    let point_count gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                                                    let state_valid %bool match field::get_ref owner "state":
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagState::PendingContour pending:
                                                            let contour *field::get_ref pending "contour_index"
                                                            let expected_start *field::get_ref pending "expected_start"
                                                            and ge contour 0 and lt contour contour_count and ge expected_start 0 and lt expected_start point_count eq logical mul expected_start 2
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagState::ActiveContour active:
                                                            let span *field::get_ref active "span"
                                                            let expected_start *field::get_ref active "expected_start"
                                                            let contour gui_sfnt_simple_glyph_contour_span_index &span
                                                            let count gui_sfnt_simple_glyph_contour_span_point_count &span
                                                            let span_start gui_sfnt_simple_glyph_contour_span_start_point_index &span
                                                            let span_end gui_sfnt_simple_glyph_contour_span_end_point_index &span
                                                            let glyph gui_sfnt_simple_glyph_contour_span_glyph &span
                                                            let edge_index div_s logical 2
                                                            and ge gui_glyph_id_raw &glyph 0 and ge contour 0 and lt contour contour_count and eq expected_start span_start and gt count 0 and eq span_end sub add span_start count 1 and le add span_start count point_count and ge edge_index span_start lt edge_index add span_start count
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagState::Completed completed:
                                                            eq gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index completed gui_sfnt_simple_glyph_outline_scalar_region_cursor_end completed
                                                    if state_valid then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid else GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantInvalidKind::StateProgressMismatch

