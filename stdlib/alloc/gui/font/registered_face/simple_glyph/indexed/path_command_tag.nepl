//: # registered-face simple glyph indexed PathCommandTag population
//: completed Edge authorityからchecked sink eventを読み、stable command tag scalarを構築します。
//:
//: PendingContourだけがspan lookupを行い、ActiveContourは保存済みspanを再利用します。全体はO(command + contour)、追加領域O(1)です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/path_command_tag" as *
//: fn main %fn void i32 \void:
//:|      let value %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagProgressKind::PendingContour
//:|      match value:
//:|          GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagProgressKind::PendingContour: 0
//:|          _: 1
//: ```

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/edge" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui/font" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

