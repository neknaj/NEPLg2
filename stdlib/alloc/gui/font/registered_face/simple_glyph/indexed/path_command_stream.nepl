pub fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_summary %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamPrepareSummary \owner: *field::get_ref owner "summary"

//: path_command_stream_error: 証拠なしのtyped failureを同一ownerから構築します
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamErrorKind fn i32 fn i32 fn Option GuiSfntSimpleGlyphPathCommandTag fn Option GuiSfntSimpleGlyphPathCommandTag GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamError \owner\kind\path_command_index\edge_index\stored_tag\source_tag:
    let invariant gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_phase_invariant_check &owner
    GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamError owner kind path_command_index edge_index stored_tag source_tag none none none none none none invariant

//: path_command_stream_error_evidence: lower failure証拠と回収ownerをtyped errorへ束ねます
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_error_evidence %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamErrorKind fn i32 fn i32 fn Option GuiSfntSimpleGlyphPathCommandTag fn Option GuiSfntSimpleGlyphPathCommandTag fn Option GuiSfntSimpleGlyphContourSpanIndexLookupError fn Option GuiSfntSimpleGlyphOutlinePathCommandTagReadError fn Option GuiSfntSimpleGlyphOutlineEdgeOwnerReadError fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionCurveSegmentError fn Option GuiSfntSimpleGlyphOutlineEdgeOwnerMarker fn Option GuiSfntSimpleGlyphContourSpan GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamError \owner\kind\path_command_index\edge_index\stored_tag\source_tag\span_error\tag_read_error\edge_read_error\event_error\marker\span:
    let invariant gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_phase_invariant_check &owner
    GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamError owner kind path_command_index edge_index stored_tag source_tag span_error tag_read_error edge_read_error event_error marker span invariant

//: summary_increment: command種別に対応するcounterとlast indexを1件進めます
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_summary_increment %fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamPrepareSummary fn i32 fn GuiSfntSimpleGlyphPathCommand GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamPrepareSummary \summary\index\command:
    let total add gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_total_count summary 1
    let move gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_move_to_count summary
    let line gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_line_to_count summary
    let quadratic gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_quadratic_to_count summary
    let skip gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_skip_no_segment_count summary
    match command:
        GuiSfntSimpleGlyphPathCommand::MoveTo _value: gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary total (add move 1) line quadratic skip index
        GuiSfntSimpleGlyphPathCommand::LineTo _value: gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary total move (add line 1) quadratic skip index
        GuiSfntSimpleGlyphPathCommand::QuadraticTo _value: gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary total move line (add quadratic 1) skip index
        GuiSfntSimpleGlyphPathCommand::SkipNoSegment _value: gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary total move line quadratic (add skip 1) index

//: path_command_stream_activate: pending contourを1回のspan lookupでactiveへ遷移します
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_activate %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamError \owner:
    match field::get_ref &owner "state":
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::PendingContour pending:
            let contour *field::get_ref pending "contour_index"
            let expected_start *field::get_ref pending "expected_start"
            let cursor *field::get_ref pending "cursor"
            let index gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_stream_cursor_next_index &cursor
            let tag_ref %&GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagCompletedOwner field::get_ref &owner "tag"
            match gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_contour_span_lookup tag_ref contour:
                Result::Err error: Result::Err gui_font_registered_face_simple_glyph_indexed_path_command_stream_error_evidence owner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamErrorKind::SpanLookupFailed index -1 none none (some error) none none none none none
                Result::Ok span:
                    let capacity gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_capacity tag_ref
                    let capacity_glyph gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
                    let span_glyph gui_sfnt_simple_glyph_contour_span_glyph &span
