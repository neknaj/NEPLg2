//: owner_cursor: 進行stateから共通のtyped command cursorを返します
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_cursor %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandStreamCursor \owner:
    match field::get_ref owner "state":
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::PendingContour pending: *field::get_ref pending "cursor"
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::ActiveContour active: *field::get_ref active "cursor"
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::Completed cursor: *cursor

//: owner_phase_invariant_check: lower authority、summary、進行cursorの整合を検査します
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_phase_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck \owner:
    let tag_ref %&GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagCompletedOwner field::get_ref owner "tag"
    match gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_continuation_authority_check tag_ref:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid _kind: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::LowerAuthorityInvalid
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid:
            let summary %&GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamPrepareSummary field::get_ref owner "summary"
            let capacity gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_capacity tag_ref
            let command_count gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count &capacity
            let cursor gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_cursor owner
            let cursor_next gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_stream_cursor_next_index &cursor
            let cursor_end gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_stream_cursor_end_index &cursor
            if or or lt cursor_next 0 gt cursor_next cursor_end ne cursor_end command_count:
                then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::CursorInvalid
                else:
                    let total gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_total_count summary
                    let move_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_move_to_count summary
                    let line_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_line_to_count summary
                    let quadratic_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_quadratic_to_count summary
                    let skip_count gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_skip_no_segment_count summary
                    let kind_total add add move_count line_count add quadratic_count skip_count
                    if or or or or lt total 0 lt move_count 0 lt line_count 0 lt quadratic_count 0 or lt skip_count 0 ne total kind_total:
                        then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::SummaryCountInvalid
                        else:
                            let last gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_last_path_command_index summary
                            if ne last sub total 1:
                                then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::SummaryLastIndexInvalid
                                else:
                                    let state_ok %bool match field::get_ref owner "state":
                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::PendingContour pending:
                                            let contour *field::get_ref pending "contour_index"
                                            let expected_start *field::get_ref pending "expected_start"
                                            and eq cursor_next total and eq cursor_next mul expected_start 2 and ge contour 0 lt cursor_next command_count
                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::ActiveContour active:
                                            let span *field::get_ref active "span"
                                            let expected_start *field::get_ref active "expected_start"
                                            let edge_index div_s cursor_next 2
                                            let progress_ok and eq cursor_next total eq expected_start gui_sfnt_simple_glyph_contour_span_start_point_index &span
                                            let edge_ok and ge edge_index expected_start le edge_index gui_sfnt_simple_glyph_contour_span_end_point_index &span
                                            and progress_ok and edge_ok lt cursor_next command_count
                                        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::Completed _cursor: and eq cursor_next total eq cursor_next command_count
                                    if state_ok:
                                        then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Valid
                                        else GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::StateProgressInvalid

//: path_command_stream_start: completed tag authorityから初期stream ownerを構築します
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagCompletedOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartError \tag:
    let lower_invariant gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_continuation_authority_check &tag
    match lower_invariant:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Invalid _kind:
            let invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::LowerAuthorityInvalid
            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartError tag GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartErrorKind::CompletionInvariantInvalid lower_invariant none invariant
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid:
            let capacity gui_font_registered_face_simple_glyph_indexed_path_command_tag_completed_owner_capacity &tag
            let command_count gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count &capacity
            if lt command_count 0:
                then:
                    let invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::CursorInvalid
                    let lower_invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid
                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartError tag GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartErrorKind::CursorConstructionFailed lower_invariant none invariant
                else:
                    let cursor gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_stream_cursor 0 command_count
                    let pending GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPending 0 0 cursor
                    let state %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState if eq command_count 0 then GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::Completed cursor else GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::PendingContour pending
                    let summary gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary 0 0 0 0 0 -1
                    let zero_summary_ok and eq 0 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_total_count &summary eq -1 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_last_path_command_index &summary
                    if not zero_summary_ok:
                        then:
                            let invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantInvalidKind::SummaryCountInvalid
                            let lower_invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartError tag GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartErrorKind::ZeroSummaryInvalid lower_invariant (some cursor) invariant
                        else:
                            let owner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner tag state summary
                            let invariant gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_phase_invariant_check &owner
                            match invariant:
                                GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPhaseInvariantCheck::Valid: Result::Ok owner
                                _:
                                    let lower_invariant GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagPhaseInvariantCheck::Valid
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartError (field::get owner "tag") GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamStartErrorKind::PhaseInvariantInvalid lower_invariant (some cursor) invariant

//: owner_progress_kind: 内部stateを公開progress kindへ射影します
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_command_stream_owner_progress_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind \owner:
    match field::get_ref owner "state":
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::PendingContour _value: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind::PendingContour
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::ActiveContour _value: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind::ActiveContour
        GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState::Completed _value: GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind::Completed

