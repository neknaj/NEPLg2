//: # registered-face simple glyph indexed path command stream preparation
//: completed PathCommandTag authorityからcommand valueを1件ずつ再構築し、prepare summaryを更新します。
//:
//: PendingContourだけがspan lookupを行い、ActiveContourは保存済みspanを再利用します。
//: Pendingからspan取得後の失敗はActiveContourとして返し、retry時にも同じchecked spanを再利用します。
//: 各stepは高々1 commandを処理し、全体の計算量はO(command + contour)、追加領域はO(1)です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/path_command_stream" as *
//: fn main %fn void i32 \void:
//:|      let value %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind::PendingContour
//:|      match value:
//:|          GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind::PendingContour: 0
//:|          _: 1
//: ```

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/path_command_tag" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui/font" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: PathCommandStreamProgressKind: command stream準備の現在phaseを表します
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind:
    PendingContour
    ActiveContour
    Completed
impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind \value: *value
impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamProgressKind \value: value

//: PathCommandStreamPending: 未展開contourのindexと期待開始位置を保持します
//:
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPending:
    contour_index %i32
    expected_start %i32
    cursor %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandStreamCursor
//: PathCommandStreamActive: 一度検査したspanを同一contour内で再利用します
//:
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamActive:
    span %GuiSfntSimpleGlyphContourSpan
    expected_start %i32
    cursor %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandStreamCursor
//: PathCommandStreamState: pending、active、completedの排他的な進行状態を所有します
//:
//: neplg2:test[skip]
enum GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState:
    PendingContour %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamPending
    ActiveContour %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamActive
    Completed %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandStreamCursor

//: PathCommandStreamOwner: completed tag authorityと準備summaryを同一ownerに束ねます
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner:
    tag %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandTagCompletedOwner
    state %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamState
    summary %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamPrepareSummary
//: PathCommandStreamCompletedOwner: 全command value準備済みの線形authorityです
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamCompletedOwner:
    running %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandStreamOwner

