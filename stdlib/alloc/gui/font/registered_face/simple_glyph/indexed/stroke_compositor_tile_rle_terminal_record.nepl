//: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner: terminal stepとtyped projectionを同じauthorityに保持する
//:
//: terminal command stepを所有するためCopy / Cloneを実装しません。
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner:
    step %GuiRgba8888CompositorTileRlePresentCommandCursorStep
    result %GuiRgba8888CompositorTileRlePresentHostCommandStepResult

fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner %fn GuiRgba8888CompositorTileRlePresentCommandCursorStep fn GuiRgba8888CompositorTileRlePresentHostCommandStepResult GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner \step\result:
    GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner step result

//: terminal Completed stepをF5mu projection付きmove-only ownerへ移す
//:
//: command cursor stepをborrowでF5muへ一度だけ渡してから、stepとCopy projectionを同じauthorityへ保持します。
//: 呼び出し側はF5mt terminal Completed stepだけを渡し、host executionやvirtual drainへは進みません。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner_from_step %fn GuiRgba8888CompositorTileRlePresentCommandCursorStep GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner \step:
    let record_result %GuiRgba8888CompositorTileRlePresentHostCommandStepResult gui_rgba8888_compositor_tile_rle_present_host_command_step_result &step
    gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner step record_result

//: typed F5mu projection resultをCopy valueとして読む
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner_result %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner GuiRgba8888CompositorTileRlePresentHostCommandStepResult \owner:
    *field::get_ref owner "result"

//: terminal command stepの所有権を回収する
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner_take_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner GuiRgba8888CompositorTileRlePresentCommandCursorStep \owner:
    field::get owner "step"

//: terminal stepを閉じる
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner_free %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleTerminalRecordOwner Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    let step %GuiRgba8888CompositorTileRlePresentCommandCursorStep gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_terminal_record_owner_take_step owner
    gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free step

