//: test_completed_force_push_failure_ok: completed registered sourceを保持してcleanup-only push failureを検査する
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_path_command_sink_test_completed_force_push_failure_ok %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandSinkCompletedOwner bool \completed:
    let source field::get completed "source"
    gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_free field::get completed "writer"
    match gui_font_registered_face_simple_glyph_indexed_path_command_sink_plan_start source:
        Result::Err error:
            gui_font_registered_face_simple_glyph_indexed_path_command_sink_plan_error_free error
            false
        Result::Ok planned:
            match gui_font_registered_face_simple_glyph_indexed_path_command_sink_allocate planned:
                Result::Err error:
                    gui_font_registered_face_simple_glyph_indexed_path_command_sink_alloc_error_free error
                    false
                Result::Ok allocated:
                    match gui_font_registered_face_simple_glyph_indexed_path_command_sink_writer_start allocated:
                        Result::Err error:
                            gui_font_registered_face_simple_glyph_indexed_path_command_sink_start_error_free error
                            false
                        Result::Ok writer:
                            let error gui_font_registered_face_simple_glyph_indexed_path_command_sink_test_force_push_failure writer
                            let kind_ok %bool match gui_font_registered_face_simple_glyph_indexed_path_command_sink_step_error_kind &error:
                                GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandSinkStepErrorKind::WriterPushFailed: true
                                _: false
                            let push_ok %bool match gui_font_registered_face_simple_glyph_indexed_path_command_sink_step_error_push_kind &error:
                                Option::Some kind:
                                    match kind:
                                        GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkWriterPushErrorKind::CommandIndexOutOfOrder: true
                                        _: false
                                Option::None: false
                            let index_ok eq 1 gui_font_registered_face_simple_glyph_indexed_path_command_sink_step_error_next_index &error
                            match gui_font_registered_face_simple_glyph_indexed_path_command_sink_step_error_retry error:
                                Option::Some retry:
                                    gui_font_registered_face_simple_glyph_indexed_path_command_sink_writing_owner_free retry
                                    false
                                Option::None: and kind_ok and push_ok index_ok
