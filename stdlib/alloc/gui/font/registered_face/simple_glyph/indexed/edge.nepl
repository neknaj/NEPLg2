//: # alloc/gui/font/registered_face/simple_glyph/indexed/edge
//: checked PointY authorityからcontourごとのedge owner scalarを構築する
//:
//: PendingContourだけがindexed spanを一度読み、ActiveContourは保存したspanを再利用します。
//: したがって全drainはO(point + contour)、追加領域はO(1)です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/edge" as *
//:| #import "std/test" as *
//: fn main %fn void i32 \void:
//:|      let kind %GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::PendingContour
//:|      let pending %bool match kind:
//:|          GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::PendingContour: true
//:|          _: false
//:|      test_assertion_exit_code assert "Edge progress kind is typed" pending
//: ```

#indent 4

