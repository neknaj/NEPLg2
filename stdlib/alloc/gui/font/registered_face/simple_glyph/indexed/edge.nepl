pub fn gui_font_registered_face_simple_glyph_indexed_edge_owner_phase_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck \owner:
    let point_y %&GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get_ref owner "point_y"
    let lower gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_continuation_authority_check point_y
    match lower:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Invalid _kind: GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::PointYCompletionInvariantInvalid
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Valid:
            let capacity gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_capacity point_y
            let contour_count gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
            let point_count gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
            let storage_len gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_storage_len point_y
            let state %&GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState field::get_ref owner "state"
            let cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor match state:
                GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::PendingContour pending: *field::get_ref pending "cursor"
                GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::ActiveContour active: *field::get_ref active "cursor"
                GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::Completed completed: *completed
            let start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
            let end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor
            let next gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
            if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CursorInvalid
                else:
                    let region_matches match gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor:
                        GuiSfntSimpleGlyphOutlineScalarRegion::Edge: true
                        _: false
                    if not region_matches:
                        then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CursorRegionMismatch
                        else:
                            match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::Edge:
                                Result::Err _error: GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CursorCapacityMismatch
                                Result::Ok expected:
                                    if or ne start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &expected ne end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &expected:
                                        then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CursorCapacityMismatch
                                        else:
                                            if ne storage_len next:
                                                then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CursorCapacityMismatch
                                                else:
                                                    match state:
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::PendingContour pending:
                                                            let contour_index %i32 *field::get_ref pending "contour_index"
                                                            let expected_start %i32 *field::get_ref pending "expected_start"
                                                            if or lt contour_index 0 or ge contour_index contour_count or lt expected_start 0 gt expected_start point_count:
                                                                then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::PendingContourInvalid
                                                                else GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::ActiveContour active:
                                                            let span %GuiSfntSimpleGlyphContourSpan *field::get_ref active "span"
                                                            let expected_start %i32 *field::get_ref active "expected_start"
                                                            let local %i32 sub next start
                                                            let count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
                                                            if or ne expected_start gui_sfnt_simple_glyph_contour_span_start_point_index &span or le count 0 or lt local expected_start ge local add expected_start count:
                                                                then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::ActiveContourInvalid
                                                                else GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid
                                                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::Completed _completed:
                                                            if ne next end:
                                                                then GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantInvalidKind::CompletedCursorNotAtEnd
                                                                else GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid

pub fn gui_font_registered_face_simple_glyph_indexed_edge_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartError \point_y:
    let invariant gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_phase_invariant_check &point_y
    match invariant:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Invalid _kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartError point_y GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartErrorKind::PointYCompletionInvariantInvalid invariant none GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Valid:
            let capacity gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_capacity &point_y
            match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::Edge:
                Result::Err error: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartError point_y GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartErrorKind::CursorStartFailed invariant (some error) GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid
                Result::Ok cursor:
                    let pending %GuiFontRegisteredFaceSimpleGlyphIndexedEdgePending GuiFontRegisteredFaceSimpleGlyphIndexedEdgePending 0 0 cursor
                    let owner gui_font_registered_face_simple_glyph_indexed_edge_owner point_y GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::PendingContour pending
                    let phase gui_font_registered_face_simple_glyph_indexed_edge_owner_phase_invariant_check &owner
                    match phase:
                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Valid: Result::Ok owner
                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck::Invalid _kind:
                            let returned %GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get owner "point_y"
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartError returned GuiFontRegisteredFaceSimpleGlyphIndexedEdgeStartErrorKind::PhaseInvariantInvalid invariant none phase

pub fn gui_font_registered_face_simple_glyph_indexed_edge_owner_progress_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind \owner:
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState field::get_ref owner "state"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::PendingContour _pending: GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::PendingContour
        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::ActiveContour _active: GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::ActiveContour
        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::Completed _cursor: GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::Completed

fn gui_font_registered_face_simple_glyph_indexed_edge_activate %fn GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeError \owner:
    match gui_font_registered_face_simple_glyph_indexed_edge_owner_pending &owner:
        Option::Some pending:
            let contour_index %i32 *field::get_ref &pending "contour_index"
            let expected_start %i32 *field::get_ref &pending "expected_start"
            let cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor *field::get_ref &pending "cursor"
            let point_y_ref %&GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get_ref &owner "point_y"
            match gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_contour_span_lookup point_y_ref contour_index:
                Result::Err error: Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::SpanLookupFailed (some error) none none none none none none none
                Result::Ok span:
                    let valid %bool and eq gui_sfnt_simple_glyph_contour_span_index &span contour_index and eq gui_sfnt_simple_glyph_contour_span_start_point_index &span expected_start gt gui_sfnt_simple_glyph_contour_span_point_count &span 0
                    if not valid:
                        then Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::SpanInvariantInvalid none none none none none none none none
                        else:
                            let point_y %GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get owner "point_y"
                            let active %GuiFontRegisteredFaceSimpleGlyphIndexedEdgeActive GuiFontRegisteredFaceSimpleGlyphIndexedEdgeActive span expected_start cursor
                            Result::Ok gui_font_registered_face_simple_glyph_indexed_edge_owner point_y GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::ActiveContour active
        Option::None: Result::Ok owner

pub fn gui_font_registered_face_simple_glyph_indexed_edge_step %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedEdgeBudgetStep GuiFontRegisteredFaceSimpleGlyphIndexedEdgeError \input:
    match gui_font_registered_face_simple_glyph_indexed_edge_activate input:
        Result::Err error: Result::Err error
        Result::Ok owner:
            match gui_font_registered_face_simple_glyph_indexed_edge_owner_active &owner:
                Option::None:
                    match gui_font_registered_face_simple_glyph_indexed_edge_owner_progress_kind &owner:
                        GuiFontRegisteredFaceSimpleGlyphIndexedEdgeProgressKind::Completed: Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::AlreadyCompleted none none none none none none none none
                        _: Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::SpanInvariantInvalid none none none none none none none none
                Option::Some active:
                    let span %GuiSfntSimpleGlyphContourSpan *field::get_ref &active "span"
                    let expected_start %i32 *field::get_ref &active "expected_start"
                    let cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor *field::get_ref &active "cursor"
                    let original_state %GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState::ActiveContour GuiFontRegisteredFaceSimpleGlyphIndexedEdgeActive span expected_start cursor
                    let local %i32 sub gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
                    let point_y_ref %&GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get_ref &owner "point_y"
                    match gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_contour_edge_checked_span point_y_ref span sub local expected_start:
                        Result::Err error: Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::EdgeReadFailed none (some error) none none none none none none
                        Result::Ok edge:
                            let contour %i32 gui_sfnt_simple_glyph_contour_span_index &span
                            let contour_local %i32 sub local expected_start
                            let point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
                            let expected_next %i32 if lt add contour_local 1 point_count then add contour_local 1 else 0
                            let edge_start %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_start &edge
                            let edge_end %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_end &edge
                            let start_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &edge_start
                            let end_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &edge_end
                            let start_span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_point_span &edge_start
                            let end_span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_point_span &edge_end
                            let expected_end_absolute %i32 add expected_start expected_next
                            let glyph gui_sfnt_simple_glyph_contour_span_glyph &span
                            let glyph_raw gui_glyph_id_raw &glyph
                            let span_end gui_sfnt_simple_glyph_contour_span_end_point_index &span
                            let start_span_glyph gui_sfnt_simple_glyph_contour_span_glyph &start_span
                            let end_span_glyph gui_sfnt_simple_glyph_contour_span_glyph &end_span
                            let start_point_glyph gui_sfnt_simple_glyph_point_glyph &start_point
                            let end_point_glyph gui_sfnt_simple_glyph_point_glyph &end_point
                            let start_span_identity %bool and eq glyph_raw gui_glyph_id_raw &start_span_glyph and eq contour gui_sfnt_simple_glyph_contour_span_index &start_span and eq expected_start gui_sfnt_simple_glyph_contour_span_start_point_index &start_span and eq span_end gui_sfnt_simple_glyph_contour_span_end_point_index &start_span eq point_count gui_sfnt_simple_glyph_contour_span_point_count &start_span
                            let end_span_identity %bool and eq glyph_raw gui_glyph_id_raw &end_span_glyph and eq contour gui_sfnt_simple_glyph_contour_span_index &end_span and eq expected_start gui_sfnt_simple_glyph_contour_span_start_point_index &end_span and eq span_end gui_sfnt_simple_glyph_contour_span_end_point_index &end_span eq point_count gui_sfnt_simple_glyph_contour_span_point_count &end_span
                            let point_identity %bool and eq glyph_raw gui_glyph_id_raw &start_point_glyph and eq glyph_raw gui_glyph_id_raw &end_point_glyph and eq local gui_sfnt_simple_glyph_point_index &start_point eq expected_end_absolute gui_sfnt_simple_glyph_point_index &end_point
                            let edge_valid %bool and start_span_identity and end_span_identity and point_identity and eq contour_local gui_sfnt_simple_glyph_contour_edge_index &edge and eq expected_next gui_sfnt_simple_glyph_contour_edge_next_local_index &edge and eq contour_local gui_sfnt_simple_glyph_contour_point_local_index &edge_start eq expected_next gui_sfnt_simple_glyph_contour_point_local_index &edge_end
                            if not edge_valid:
                                then Result::Err gui_font_registered_face_simple_glyph_indexed_edge_error owner GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind::EdgeInvariantInvalid none none none none none none none none
                                else:
                                    let slot gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_slot local contour contour_local expected_next
                                    let point_y %GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner field::get owner "point_y"
                                    match gui_font_registered_face_simple_glyph_indexed_point_y_completed_owner_push_edge point_y cursor slot:
                                        Result::Err lower:
                                            let rejected_cursor gui_font_registered_face_simple_glyph_indexed_point_y_edge_push_error_cursor &lower
