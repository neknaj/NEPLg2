fn gui_font_registered_face_simple_glyph_indexed_edge_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedEdgeState GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner \point_y\state:
    GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner point_y state

fn gui_font_registered_face_simple_glyph_indexed_edge_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedEdgeOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedEdgeErrorKind fn Option GuiSfntSimpleGlyphContourSpanIndexLookupError fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError fn Option GuiSfntSimpleGlyphOutlineScalarRegionCursor fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeSlot fn Option i32 fn Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind fn Option StdErrorKind fn Option GuiFontRegisteredFaceSimpleGlyphIndexedEdgePhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedEdgeError \owner\kind\span_error\edge_read_error\cursor\edge\scalar\region\storage\recovered:
