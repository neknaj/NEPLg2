//: # registered stroke compositor tile RLE encode seed bridge
//: F5nyi completed count evidenceをF5mi encode seedへ接続します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_count_completed" as completed_bridge
#import "alloc/gui/render2d/compositor_tile_rle_count_completed" as *
#import "alloc/gui/render2d/compositor_tile_rle_count_step" as *
#import "alloc/gui/render2d/compositor_tile_rle_encode_seed" as *
#import "core/result" as *

//: registered completionからcompleted countとencode seed準備を各1回だけ進める
//:
//: nested Resultはstart、step、completed、seedの各error authorityを保持します。
//: completed successだけをF5miへ渡し、encode cursor、writer、storage、packet、presentへは進みません。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_packed_mask_resource_software_drain_completed_owner_into_compositor_tile_rle_encode_seed_budget %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskResourceSoftwareDrainCompletedOwner impure fn GuiRgba8888CompositorFrameEntryConfig impure fn GuiRgba8888RowTilePlanConfig impure fn i32 impure fn i32 Result Result Result Result GuiRgba8888CompositorTileRleEncodeSeedOwner GuiRgba8888CompositorTileRleEncodeSeedError GuiRgba8888CompositorTileRleCountCompletedError GuiRgba8888CompositorTileRleCountStepError GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskResourceSoftwareDrainCompositorTileRleCountStartBridgeError \completed\frame_config\tile_config\tile_index\remaining_steps:
    match completed_bridge::gui_font_registered_face_simple_glyph_indexed_stroke_packed_mask_resource_software_drain_completed_owner_into_compositor_tile_rle_count_completed_budget completed frame_config tile_config tile_index remaining_steps:
        Result::Err lower: Result::Err lower
        Result::Ok step_result:
            match step_result:
                Result::Err lower: Result::Ok Result::Err lower
                Result::Ok completed_result:
                    match completed_result:
                        Result::Err lower: Result::Ok Result::Ok Result::Err lower
                        Result::Ok count_completed:
                            match gui_rgba8888_compositor_tile_rle_encode_seed_prepare count_completed:
                                Result::Err lower: Result::Ok Result::Ok Result::Ok Result::Err lower
                                Result::Ok seed: Result::Ok Result::Ok Result::Ok Result::Ok seed
