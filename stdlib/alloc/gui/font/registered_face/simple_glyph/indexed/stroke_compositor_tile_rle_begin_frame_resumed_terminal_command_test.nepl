    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_schedule_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok scheduled:
            let schedule_phase %GuiRgba8888CompositorTileRlePresentSchedulePhase gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_schedule_owner_phase &scheduled
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_schedule_owner_into_terminal_command scheduled:
                Result::Err error:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_command_error_free error:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Ok terminal:
                    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_command_owner_state &terminal
                    let evidence0 %i32 resumed_terminal_command_state_evidence &state
                    let evidence1 %i32 add evidence0 match schedule_phase:
                        GuiRgba8888CompositorTileRlePresentSchedulePhase::Completed: 32
                        _: 0
                    let parts %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedTerminalCommandOwnerParts gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_command_owner_into_parts terminal
                    let step %&GuiRgba8888CompositorTileRlePresentCommandCursorStep field::get_ref &parts "step"
                    let descriptor %GuiRgba8888CompositorTileRlePresentFrameDescriptor gui_rgba8888_compositor_tile_rle_present_command_cursor_step_descriptor step
                    let evidence2 %i32 add evidence1 match gui_rgba8888_compositor_tile_rle_present_command_cursor_step_result step:
                        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Completed: 64
                        _: 0
                    let evidence3 %i32 add evidence2 if resumed_terminal_command_descriptor_is_canonical &descriptor then 128 else 0
                    let evidence4 %i32 add evidence3 match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_record_result step:
                        GuiRgba8888CompositorTileRlePresentHostCommandStepResult::Completed: 1024
                        _: 0
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_terminal_parts_complete parts:
