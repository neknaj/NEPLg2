//: Continueだけが保持中Run stepからcursorを回収し、次のcommandを一度だけ進める
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_step_end_frame %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunScheduleOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError \owner:
    let parts %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunScheduleOwnerParts gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_into_parts owner
    let scheduled %GuiRgba8888CompositorTileRlePresentDispatchLoopScheduleOnlyStep field::get parts "scheduled"
    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_schedule_only_step_state &scheduled
    let phase %GuiRgba8888CompositorTileRlePresentSchedulePhase gui_rgba8888_compositor_tile_rle_present_dispatch_loop_schedule_only_step_phase &scheduled
    let run_step %GuiRgba8888CompositorTileRlePresentCommandCursorStep field::get parts "step"
    match phase:
        GuiRgba8888CompositorTileRlePresentSchedulePhase::Yield:
            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError state GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameRecovery::Step run_step GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameErrorKind::ContinueExpected phase Option::None
        GuiRgba8888CompositorTileRlePresentSchedulePhase::Completed:
            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError state GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameRecovery::Step run_step GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameErrorKind::ContinueExpected phase Option::None
        GuiRgba8888CompositorTileRlePresentSchedulePhase::Continue:
            let cursor %GuiRgba8888CompositorTileRlePresentCommandCursorOwner gui_rgba8888_compositor_tile_rle_present_command_cursor_step_finish_owner run_step
            match gui_rgba8888_compositor_tile_rle_present_command_cursor_step cursor:
                Result::Err lower:
                    let kind %GuiRgba8888CompositorTileRlePresentCommandCursorStepErrorKind gui_rgba8888_compositor_tile_rle_present_command_cursor_step_error_kind &lower
                    let category %Option GuiError gui_rgba8888_compositor_tile_rle_present_command_cursor_step_error_category_value &lower
                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError state GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameRecovery::Lower lower GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameErrorKind::CursorStepFailed kind category
                Result::Ok step:
                    match gui_rgba8888_compositor_tile_rle_present_command_cursor_step_result &step:
                        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Completed:
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError state GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameRecovery::Step step GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameErrorKind::EndFrameExpected Option::None
                        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
                            match command:
                                GuiRgba8888CompositorTileRlePresentCommand::EndFrame descriptor:
                                    Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameOwner state step descriptor
                                _:
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameError state GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameRecovery::Step step GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedEndFrameErrorKind::EndFrameExpected Option::None

