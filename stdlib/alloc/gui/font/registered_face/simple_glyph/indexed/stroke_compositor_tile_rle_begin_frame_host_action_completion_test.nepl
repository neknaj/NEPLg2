//: caller-supplied success outcomeがregistered continuation付きcompletionになることを検証する
#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_test_success_contract %impure fn unit i32 \_unit:
    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok completed:
            let completion %&GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionCompletion gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_owner_completion &completed
            let completion_evidence %i32 match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_completion_dispatch_loop_completion completion:
                GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion::Yield _state: 1
                _: 0
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_owner_free completed:
                Result::Err _: sub 0 1
                Result::Ok _: add completion_evidence 2

//: unsupported support preflight failureからcontinuation、詳細診断、retry pendingを消費handoffで回収する
#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_test_unsupported_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok owner:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_complete GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Window owner Result::Ok unit:
                Result::Ok completed:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_owner_free completed:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Err error:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_error_recover error:
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RecoveredState recovered:
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_recovered_state_owner_free recovered:
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RetryPending retry:
                            let parts %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryPendingOwnerParts gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_retry_pending_owner_into_parts retry
                            let dispatch_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameDispatchOwner field::get parts "dispatch_owner"
                            let category %Option GuiError field::get parts "category"
                            let diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic field::get parts "diagnostic"
                            let session_pending %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionPending field::get parts "session_pending"
                            let category_evidence %i32 match category:
                                Option::Some category:
                                    match category:
                                        GuiError::Unsupported: 4
                                        _: 0
                                _: 0
                            let diagnostic_evidence %i32 match diagnostic:
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic::SinkRejected sink_error:
                                    match gui_rgba8888_compositor_tile_rle_present_host_action_sink_error_kind &sink_error:
                                        GuiRgba8888CompositorTileRlePresentHostActionSinkErrorKind::UnsupportedAction _: 16
                                        _: 0
                                _: 0
                            let action_evidence %i32 match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_pending_expected_action &session_pending:
                                GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenBegin _: 8
                                _: 0
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_dispatch_owner_free dispatch_owner:
                                Result::Err _: sub 0 1
                                Result::Ok _: add add add category_evidence action_evidence diagnostic_evidence 32

//: supported actionへcaller failure outcomeを返し、actual DriverCompletionFailed recovered stateを作る
#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_test_recovered_state_owner %impure fn unit Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRecoveredStateOwner i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_owner _unit:
        Result::Err evidence: Result::Err evidence
        Result::Ok owner:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_complete GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen owner Result::Err GuiError::InvalidCommand:
                Result::Ok completed:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_owner_free completed:
                        Result::Err _: Result::Err sub 0 1
                        Result::Ok _: Result::Err 0
                Result::Err error:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_error_recover error:
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RetryPending retry:
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_retry_pending_owner_free retry:
                                Result::Err _: Result::Err sub 0 1
                                Result::Ok _: Result::Err 0
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RecoveredState recovered:
                            Result::Ok recovered
