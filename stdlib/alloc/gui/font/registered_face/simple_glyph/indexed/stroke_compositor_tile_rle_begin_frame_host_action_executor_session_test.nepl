//: F5nh pendingが保持したactual BeginFrame descriptor metadataを検証する
fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_descriptor_evidence %fn &GuiRgba8888CompositorTileRlePresentFrameDescriptor i32 \descriptor:
    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_descriptor_metadata descriptor
    let surface %SurfaceId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_surface descriptor
    let frame %FrameId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_frame descriptor
    let metadata_ok %bool and and and eq gui_rgba8888_compositor_frame_entry_metadata_frame_id &metadata 263 eq gui_rgba8888_compositor_frame_entry_metadata_width &metadata 16 eq gui_rgba8888_compositor_frame_entry_metadata_row_start &metadata 3 eq gui_rgba8888_compositor_frame_entry_metadata_row_count &metadata 1
    let evidence0 %i32 if metadata_ok then 2 else 0
    let evidence1 %i32 add evidence0 (if eq (surface_id_raw &surface) 7 then 4 else 0)
    let evidence2 %i32 add evidence1 (if eq (frame_id_raw &frame) 263 then 8 else 0)
    let evidence3 %i32 add evidence2 (if eq (gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_run_count descriptor) 1 then 16 else 0)
    add evidence3 (if eq (gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_pixel_count descriptor) 16 then 32 else 0)

//: actual F5nzk Action ownerを後続registered fixtureへ渡す
#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_owner %impure fn unit Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionOwner i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_execution_driver_test_owner _unit:
        Result::Err evidence: Result::Err evidence
        Result::Ok driver_owner:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_execution_driver_owner_into_host_action_executor_session_request driver_owner:
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::UnexpectedCompleted unexpected:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_unexpected_completed_free unexpected:
                        Result::Err _: Result::Err sub 0 1
                        Result::Ok _: Result::Err 0
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::Action owner:
                    Result::Ok owner

//: actual F5nzj ownerをF5nh executor request pendingへ一度だけ接続する
#test
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_success_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_execution_driver_test_owner _unit:
        Result::Err evidence: evidence
        Result::Ok driver_owner:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_execution_driver_owner_into_host_action_executor_session_request driver_owner:
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::UnexpectedCompleted unexpected:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_unexpected_completed_free unexpected:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionExecutorSessionRequestResult::Action owner:
                    let action %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_owner_expected_action &owner
                    let action_evidence %i32 match action:
                        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenBegin descriptor:
                            add 1 gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_test_descriptor_evidence &descriptor
                        _: 0
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: add 128 add action_evidence 64
