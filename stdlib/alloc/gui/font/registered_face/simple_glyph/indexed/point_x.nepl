    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPointXState field::get_ref owner "state"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Active active: *field::get_ref active "cursor"
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Completed completed: *field::get_ref completed "cursor"

//: neplg2:test[skip]
