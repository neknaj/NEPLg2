//: # alloc/gui/font/registered_face/simple_glyph/indexed/point_x
//: F5nxd completed authority から PointX region を順次構築する
//:
//: ### [契約/けいやく]
//: - start は F5nxd checked completed owner だけを受け取ります。
//: - logical item index は cursor の next と start の差だけから導出します。
//: - item read、identity validation、PointX push を順番に行い、失敗を成功へ置換しません。
//: - terminal、budget zero、step の順で判定し、PointY cursor は開始しません。
//: - owner を保持する型は `Clone` / `Copy` を実装しません。
//:
//: ### [計算量/けいさんりょう]
//: start、invariant、step は定数時間、全 drain は point 数に比例し、追加 metadata は定数領域です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/point_x" as *
//:| #import "std/test" as *
//:
//: fn main %fn void i32 \void:
//:     let status %GuiFontRegisteredFaceSimpleGlyphIndexedPointXBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedPointXBudgetStatus::StepBudgetExhausted
//:     let typed %bool match status:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedPointXBudgetStatus::StepBudgetExhausted: true
//:         _: false
//:     test_assertion_exit_code assert "PointX budget status is typed" typed
//: ```

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/contour_endpoint" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: PointX population の実行中または完了を表す Copy 状態です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind:
    Active
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind \value:
        value

//: PointX owner invariant の固定優先順位を持つ invalid reason です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind:
    CanonicalCapacityShapeInvalid
    EndpointCompletionInvariantInvalid
    StorageCapacityMismatch
    StorageShapeMismatch
    CollectionItemCountMismatch
    CursorInvalid
    CursorRegionMismatch
    CursorCapacityMismatch
    StorageLengthMismatch
    ActiveCursorAtEnd
    CompletedCursorNotAtEnd

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind \value:
        value

//: PointX owner invariant の成功または最初の invalid reason を保持します。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck:
    Valid
    Invalid %GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck \value:
        value

//: 未処理の PointX slot を指す checked cursor metadata です。
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive:
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive \value:
        value

//: 全 PointX slot の commit を終えた cursor metadata です。
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted:
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted \value:
        value

//: PointX cursor を active と completed の排他的な状態として保持します。
