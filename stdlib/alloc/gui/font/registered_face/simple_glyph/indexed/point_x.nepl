    gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_storage_len endpoint

//: F5nxe 固有 invariant を契約上の優先順位で検査します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_point_x_owner_phase_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXOwner GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck \owner:
    let endpoint %&GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointCompletedOwner field::get_ref owner "endpoint"
    let capacity gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_capacity endpoint
    let contour_count gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let point_count gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let cursor gui_font_registered_face_simple_glyph_indexed_point_x_owner_cursor owner
    let start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
    let end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor
    let next gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
    let logical sub next start
    let len gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_storage_len endpoint
    let shape_invalid gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CanonicalCapacityShapeInvalid
    let endpoint_check gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_continuation_authority_check endpoint
    let endpoint_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind::StorageCapacityMismatch: none
                GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind::StorageShapeMismatch: none
                _: some GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::EndpointCompletionInvariantInvalid
    let storage_capacity_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind::StorageCapacityMismatch: some GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageCapacityMismatch
                _: none
    let storage_shape_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantInvalidKind::StorageShapeMismatch: some GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageShapeMismatch
                _: none
    let actual_item_count gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_item_count endpoint
    let item_count_invalid gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if ne actual_item_count point_count GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CollectionItemCountMismatch
    let cursor_invalid gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CursorInvalid
    let region_matches match gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor:
        GuiSfntSimpleGlyphOutlineScalarRegion::PointX: true
        _: false
    let region_invalid gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if not region_matches GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CursorRegionMismatch
    let capacity_invalid match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::PointX:
        Result::Err _error: some GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CursorCapacityMismatch
        Result::Ok expected: gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if or ne start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &expected ne end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &expected GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CursorCapacityMismatch
    let len_invalid gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if ne len add contour_count logical GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageLengthMismatch
    let common1 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid shape_invalid endpoint_invalid
    let common2 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common1 storage_capacity_invalid
    let common3 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common2 storage_shape_invalid
    let common4 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common3 item_count_invalid
    let common5 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common4 cursor_invalid
    let common6 gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common5 region_invalid
    let common gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common6 capacity_invalid
    let common gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common len_invalid
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPointXState field::get_ref owner "state"
    let phase match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Active _active: gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if ge next end GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::ActiveCursorAtEnd
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Completed _completed: gui_font_registered_face_simple_glyph_indexed_point_x_invalid_if or ne next end ne sub end start point_count GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::CompletedCursorNotAtEnd
    match gui_font_registered_face_simple_glyph_indexed_point_x_first_invalid common phase:
        Option::Some kind: GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Invalid kind
        Option::None: GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid

//: start metadata と未分解の入力ownerを一つのtyped errorに束ねます。
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_point_x_start_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointCompletedOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartErrorKind fn GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck fn i32 fn i32 fn Option StdErrorKind fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartError \owner\kind\endpoint_invariant\expected\actual\cursor_error\phase:
    GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartError owner kind endpoint_invariant expected actual cursor_error phase

//: F5nxd completion、item count、PointX cursor、F5nxe invariant の順で開始を検査します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_point_x_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointCompletedOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedPointXOwner GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartError \endpoint:
    let endpoint_invariant gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_phase_invariant_check &endpoint
    match endpoint_invariant:
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Invalid _kind: Result::Err gui_font_registered_face_simple_glyph_indexed_point_x_start_error endpoint GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartErrorKind::EndpointCompletionInvariantInvalid endpoint_invariant 0 0 none GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid
        GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointPhaseInvariantCheck::Valid:
            let capacity gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_capacity &endpoint
            let expected gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
            let actual gui_font_registered_face_simple_glyph_indexed_contour_endpoint_completed_owner_item_count &endpoint
            if ne expected actual:
                then Result::Err gui_font_registered_face_simple_glyph_indexed_point_x_start_error endpoint GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartErrorKind::CollectionItemCountMismatch endpoint_invariant expected actual none GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid
                else match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::PointX:
                    Result::Err cursor_error: Result::Err gui_font_registered_face_simple_glyph_indexed_point_x_start_error endpoint GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartErrorKind::CursorStartFailed endpoint_invariant expected actual some cursor_error GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid
                    Result::Ok cursor:
                        let next gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
                        let end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor
                        let active gui_font_registered_face_simple_glyph_indexed_point_x_active cursor
                        let completed gui_font_registered_face_simple_glyph_indexed_point_x_completed cursor
                        let state if eq next end then GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Completed completed else GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Active active
                        let owner gui_font_registered_face_simple_glyph_indexed_point_x_owner endpoint state
                        let phase gui_font_registered_face_simple_glyph_indexed_point_x_owner_phase_invariant_check &owner
                        match phase:
                            GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid: Result::Ok owner
                            GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Invalid _kind:
                                let returned field::get owner "endpoint"
                                Result::Err gui_font_registered_face_simple_glyph_indexed_point_x_start_error returned GuiFontRegisteredFaceSimpleGlyphIndexedPointXStartErrorKind::PhaseInvariantInvalid endpoint_invariant expected actual none phase

//: step metadata と進捗未変更のownerを一つのtyped errorに束ねます。
