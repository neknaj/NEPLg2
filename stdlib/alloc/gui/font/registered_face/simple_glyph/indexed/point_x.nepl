pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointXOwner:
    endpoint %GuiFontRegisteredFaceSimpleGlyphIndexedContourEndpointCompletedOwner
    state %GuiFontRegisteredFaceSimpleGlyphIndexedPointXState

//: checked completion 後の running owner 全体を保持する F5nxf authority です。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner:
    running %GuiFontRegisteredFaceSimpleGlyphIndexedPointXOwner

