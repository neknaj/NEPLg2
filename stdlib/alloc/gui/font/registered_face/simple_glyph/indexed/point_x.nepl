pub fn gui_font_registered_face_simple_glyph_indexed_point_x_owner_progress_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointXOwner GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind \owner:
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPointXState field::get_ref owner "state"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Active _active: GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind::Active
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXState::Completed _completed: GuiFontRegisteredFaceSimpleGlyphIndexedPointXProgressKind::Completed

//: neplg2:test[skip]
