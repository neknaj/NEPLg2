enum GuiFontRegisteredFaceSimpleGlyphIndexedPointXState:
    Active %GuiFontRegisteredFaceSimpleGlyphIndexedPointXActive
    Completed %GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompleted

//: F5nxd authority と PointX phase state を分離せず保持する owner です。
