fn resumed_end_frame_record_state_evidence %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState i32 \state:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    let drain %GuiRgba8888CompositorTileRlePresentVirtualDrain gui_rgba8888_compositor_tile_rle_present_schedule_state_drain &schedule
    let a %i32 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 1 then 1 else 0
    let b %i32 add a if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 16 then 2 else 0
    let c %i32 add b if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_run_count &drain 1 then 4 else 0
    add c if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_pixel_count &drain 16 then 8 else 0

fn resumed_end_frame_record_evidence %fn GuiRgba8888CompositorTileRlePresentHostCommandStepResult i32 \result:
    match result:
        GuiRgba8888CompositorTileRlePresentHostCommandStepResult::Completed: 0
        GuiRgba8888CompositorTileRlePresentHostCommandStepResult::Record record:
            match record:
                GuiRgba8888CompositorTileRlePresentHostCommandRecord::EndFrame descriptor:
                    let surface %SurfaceId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_surface &descriptor
                    let frame %FrameId gui_rgba8888_compositor_tile_rle_present_frame_descriptor_frame &descriptor
                    let metadata %GuiRgba8888CompositorFrameEntryMetadata gui_rgba8888_compositor_tile_rle_present_frame_descriptor_metadata &descriptor
                    if and and and and and and and eq surface_id_raw &surface 7 eq frame_id_raw &frame 263 eq gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_run_count &descriptor 1 eq gui_rgba8888_compositor_tile_rle_present_frame_descriptor_expected_pixel_count &descriptor 16 eq gui_rgba8888_compositor_frame_entry_metadata_frame_id &metadata 263 eq gui_rgba8888_compositor_frame_entry_metadata_width &metadata 16 eq gui_rgba8888_compositor_frame_entry_metadata_row_start &metadata 3 eq gui_rgba8888_compositor_frame_entry_metadata_row_count &metadata 1 then 16 else 0
                _: 0

