            let diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic::AttemptActionMismatch GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionMismatchDiagnostic expected attempted mismatch_category
            let driver %GuiRgba8888CompositorTileRlePresentHostExecutionDriverPending gui_rgba8888_compositor_tile_rle_present_host_action_attempt_mismatch_driver mismatch
            let session_pending %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionPending gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_pending_recover_driver driver
            GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RetryPending GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryPendingOwner dispatch_owner category diagnostic session_pending
        GuiRgba8888CompositorTileRlePresentHostActionAttemptDriverError::SinkDriverFailed sink_failure:
            match gui_rgba8888_compositor_tile_rle_present_host_action_attempt_sink_driver_failed_lower sink_failure:
                GuiRgba8888CompositorTileRlePresentHostActionSinkDriverError::SinkRejected rejection:
                    let sink_error %GuiRgba8888CompositorTileRlePresentHostActionSinkError gui_rgba8888_compositor_tile_rle_present_host_action_sink_driver_rejected_sink_error &rejection
