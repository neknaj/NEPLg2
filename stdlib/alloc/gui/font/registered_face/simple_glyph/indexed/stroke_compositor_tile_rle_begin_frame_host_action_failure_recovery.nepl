    let lower %GuiRgba8888CompositorTileRlePresentHostActionAttemptDriverError gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_complete_error_lower field::get parts "lower"
    match lower:
        GuiRgba8888CompositorTileRlePresentHostActionAttemptDriverError::AttemptActionMismatch mismatch:
            let expected %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_action_attempt_mismatch_expected &mismatch
