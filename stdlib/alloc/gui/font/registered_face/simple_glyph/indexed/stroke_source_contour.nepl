        Option::None: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::SourceSlotMissing none
        Option::Some join:
            let from_index %i32 gui_sfnt_simple_glyph_render_stroke_join_closure_record_from_side_edge_index &join
            let to_index %i32 gui_sfnt_simple_glyph_render_stroke_join_closure_record_to_side_edge_index &join
            match gui_font_registered_face_simple_glyph_indexed_stroke_join_geometry_read_edge source from_index:
                Option::None: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::SourceSlotMissing none
                Option::Some from_edge:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_join_geometry_read_edge source to_index:
                        Option::None: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::SourceSlotMissing none
                        Option::Some to_edge:
                            match gui_sfnt_simple_glyph_render_stroke_join_geometry_projection_from_side_edges index &join &from_edge &to_edge:
                                Result::Err kind: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::ProjectionFailed kind) none
                                Result::Ok rejected: GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::StorageFailed StdErrorKind::CapacityExceeded) (some rejected)

