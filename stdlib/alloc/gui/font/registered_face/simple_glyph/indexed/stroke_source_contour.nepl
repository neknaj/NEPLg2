//: completed F5nxp source/geometries/countの一致を再検査する
fn gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_source_invariants %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryCompletedOwner bool \owner:
    let source %&GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometrySourceOwner field::get_ref owner "source"
    let join_count %i32 *field::get_ref owner "join_count"
    let bevel_count %i32 *field::get_ref owner "bevel_count"
    let miter_count %i32 *field::get_ref owner "miter_count"
    let round_count %i32 *field::get_ref owner "round_count"
    let geometries %&Vec GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord field::get_ref owner "geometries"
    let bevel_within %bool and ge bevel_count 0 le bevel_count join_count
    let after_bevel %i32 if bevel_within then sub join_count bevel_count else 0
    let miter_within %bool and ge miter_count 0 le miter_count after_bevel
    let remaining %i32 if miter_within then sub after_bevel miter_count else 0
    and gui_font_registered_face_simple_glyph_indexed_stroke_join_geometry_source_invariants source and ge join_count 0 and bevel_within and miter_within and eq round_count remaining and eq vec::len geometries join_count eq vec::cap geometries join_count

//: gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_start: F5nxq writerを開始する
//:
//: [契約/けいやく]:
//: - shape validationとF5nxp invariantをowner消費前に検査します。
//: - shape cell countと同じcapacityを一度だけ確保し、失敗時はF5nxp owner全体を返します。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_start %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryCompletedOwner impure fn GuiSfntSimpleGlyphRasterCoverageConfig Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError \join_geometry\config:
    match gui_sfnt_simple_glyph_raster_coverage_shape_from_config &config:
        Result::Err kind:
            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError join_geometry config (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartErrorKind::ShapeRejected kind)
        Result::Ok shape:
            if not gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_source_invariants &join_geometry:
                then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError join_geometry config GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartErrorKind::SourceInvariantInvalid
                else:
                    let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
                    match vec::with_capacity<i32> cell_count:
                        Result::Err kind:
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError join_geometry config (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartErrorKind::StorageFailed kind)
                        Result::Ok cells:
                            if ne vec::len &cells 0:
                                then:
                                    vec::free cells
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError join_geometry config GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartErrorKind::StorageInitialLenMismatch
                                else if ne vec::cap &cells cell_count:
                                    then:
                                        vec::free cells
                                        Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartError join_geometry config GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellStartErrorKind::StorageCapacityMismatch
                                    else Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner join_geometry shape cells 0

//: gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_push: coverage cellを一件積む
//:
//: [契約/けいやく]:
//: - written count、Vec len/cap、coverage range、full状態をpush前に検査します。
//: - push失敗ではreturned Vecとpre-push countからownerを復元し、拒否値を保持します。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_push %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner impure fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError \owner\coverage_value:
    let written %i32 *field::get_ref &owner "written_cell_count"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape *field::get_ref &owner "shape"
    let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
    let cells_ref %&Vec i32 field::get_ref &owner "cells"
    if or lt written 0 ne vec::len cells_ref written:
        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError owner coverage_value GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::ProgressInvariantInvalid
        else if ne vec::cap cells_ref cell_count:
            then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError owner coverage_value GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::StorageCapacityMismatch
            else if ge written cell_count:
                then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError owner coverage_value GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::MaskFull
                else if lt coverage_value 0:
                    then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError owner coverage_value GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::CoverageNegative
                    else if gt coverage_value gui_sfnt_simple_glyph_raster_coverage_shape_coverage_max &shape:
                        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError owner coverage_value GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::CoverageExceedsMax
                        else:
                            let join_geometry %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryCompletedOwner field::get owner "join_geometry"
                            let cells %Vec i32 field::get owner "cells"
                            match vec::push cells coverage_value:
                                Result::Err push_error:
                                    let kind %StdErrorKind vec::vec_push_error_kind &push_error
                                    let returned %Vec i32 vec::vec_push_error_vec push_error
                                    let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner join_geometry shape returned written
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushError recovered coverage_value (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellPushErrorKind::StorageFailed kind)
                                Result::Ok next:
                                    Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner join_geometry shape next (add written 1)

//: gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_complete: exact full writerだけをcompleted ownerへ進める
//:
//: [契約/けいやく]:
//: - lenとwritten count、capとcell countを再検査します。
//: - 未充填ownerをcompletedと偽装せず、owner-bearing errorとして返します。
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_writer_complete %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellWriterOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionError \owner:
    let written %i32 *field::get_ref &owner "written_cell_count"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape *field::get_ref &owner "shape"
    let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
    let cells_ref %&Vec i32 field::get_ref &owner "cells"
    if or lt written 0 ne vec::len cells_ref written:
        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionErrorKind::ProgressInvariantInvalid
        else if ne vec::cap cells_ref cell_count:
            then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionErrorKind::StorageCapacityMismatch
            else if ne written cell_count:
                then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellCompletionErrorKind::MaskIncomplete
                else Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellOwner (field::get owner "join_geometry") shape (field::get owner "cells") written

