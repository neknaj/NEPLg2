                Result::Err kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStartError offset (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::StorageFailed kind)
                Result::Ok edges: Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner offset edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left 0 0 0 0 0 0

