//: side_edge_start: metric_count * 2 の exact capacity を一度だけ確保します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStartError \offset:
    let metric_count %i32 gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_owner_metric_count &offset
    if or lt metric_count 0 gt metric_count 1073741823:
        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStartError offset GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::CapacityInvalid
        else:
            let capacity %i32 mul metric_count 2
            match vec::with_capacity<GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection> capacity:
                Result::Err kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStartError offset (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::StorageFailed kind)
                Result::Ok edges: Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner offset edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left 0 0 0 0 0 0

