//: side_edge_push_pending: pending をauthorityとして1 budgetで1 edgeだけpushします。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_push_pending %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError \owner:
    let geometry %GuiSfntSimpleGlyphRenderOffsetGeometryProjection unwrap *field::get_ref &owner "pending"
    let side %GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide *field::get_ref &owner "side"
    let edge %GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection gui_sfnt_simple_glyph_render_stroke_side_edge_projection &geometry side
    let geometry_count %i32 *field::get_ref &owner "geometry_count"
    let side_edge_count %i32 *field::get_ref &owner "side_edge_count"
    let line_count %i32 *field::get_ref &owner "line_side_edge_count"
    let quadratic_count %i32 *field::get_ref &owner "quadratic_side_edge_count"
    let left_count %i32 *field::get_ref &owner "left_side_edge_count"
    let right_count %i32 *field::get_ref &owner "right_side_edge_count"
    let offset %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionOwner field::get owner "offset"
    let edges %Vec GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection field::get owner "edges"
    match vec::push edges edge:
        Result::Err push_error:
            let kind %StdErrorKind vec::vec_push_error_kind &push_error
            let returned %Vec GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection vec::vec_push_error_vec push_error
            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner offset returned (some geometry) side geometry_count side_edge_count line_count quadratic_count left_count right_count
            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::StorageFailed kind) (some edge)
        Result::Ok next_edges:
            let next_side_edge_count %i32 add side_edge_count 1
            let is_line %bool match geometry:
                GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Line _line: true
                GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Quadratic _quadratic: false
            match side:
                GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left:
                    let next_line %i32 if is_line then add line_count 1 else line_count
                    let next_quadratic %i32 if is_line then quadratic_count else add quadratic_count 1
                    let next %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner offset next_edges (some geometry) GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Right geometry_count next_side_edge_count next_line next_quadratic (add left_count 1) right_count
                    Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::Progress (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeProgress next GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStatusKind::EdgePushed (some edge))
                GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Right:
                    let next_line %i32 if is_line then add line_count 1 else line_count
                    let next_quadratic %i32 if is_line then quadratic_count else add quadratic_count 1
                    let next %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner offset next_edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left (add geometry_count 1) next_side_edge_count next_line next_quadratic left_count (add right_count 1)
                    Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::Progress (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeProgress next GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStatusKind::EdgePushed (some edge))

//: side_edge_step: lower projection進行とpending確定をpushより前に行い、1 budgetで1 edgeだけ進めます。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_step %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner impure fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError \owner\budget:
    if le budget 0:
        then Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::Progress (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeProgress owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStatusKind::StepBudgetExhausted none)
        else:
            match *field::get_ref &owner "pending":
                Option::Some _geometry: gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_push_pending owner
                Option::None:
                    let edges %Vec GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection field::get owner "edges"
                    let geometry_count %i32 field::get owner "geometry_count"
                    let side_edge_count %i32 field::get owner "side_edge_count"
                    let line_count %i32 field::get owner "line_side_edge_count"
                    let quadratic_count %i32 field::get owner "quadratic_side_edge_count"
                    let left_count %i32 field::get owner "left_side_edge_count"
                    let right_count %i32 field::get owner "right_side_edge_count"
                    let offset %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionOwner field::get owner "offset"
                    match gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step offset 1:
                        Result::Err lower:
                            let kind gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_error_kind &lower
                            let returned gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_error_owner lower
                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::OffsetProjectionFailed kind) none
                        Result::Ok lower_step:
                            let status gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_status &lower_step
                            let geometry gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_geometry &lower_step
                            let returned gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_owner lower_step
                            match status:
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::Projected:
                                    match geometry:
                                        Option::None:
                                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none
                                        Option::Some value:
                                            let pending %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges (some value) GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_push_pending pending
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::Completed:
                                    let expected %i32 mul gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_owner_metric_count &returned 2
                                    if and eq side_edge_count expected eq vec::len &edges vec::cap &edges:
                                        then:
                                            let completed %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeCompletedOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeCompletedOwner returned edges geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::CompletedValue completed
                                        else:
                                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::StepBudgetExhausted:
                                    let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none

