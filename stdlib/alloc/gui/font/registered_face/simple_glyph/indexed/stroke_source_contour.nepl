                else if eq index total:
                    then Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStep::CompletedValue (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryCompletedOwner (field::get owner "source") (field::get owner "geometries") total bevel_count miter_count round_count)
                    else:
