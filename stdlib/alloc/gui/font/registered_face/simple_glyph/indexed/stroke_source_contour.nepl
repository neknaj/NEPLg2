    let coverage_owner %&GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCoverageCellOwner field::get_ref owner "coverage_owner"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_owner_shape coverage_owner
