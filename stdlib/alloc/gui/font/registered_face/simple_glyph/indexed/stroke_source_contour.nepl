                                            Option::None: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::SourceSlotMissing none
                                            Option::Some to_edge:
                                                match gui_sfnt_simple_glyph_render_stroke_join_geometry_projection_from_side_edges index &join &from_edge &to_edge:
                                                    Result::Err kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::ProjectionFailed kind) none
                                                    Result::Ok geometry:
                                                        let source_value field::get owner "source"
                                                        let geometries field::get owner "geometries"
                                                        match vec::push geometries geometry:
                                                            Result::Err push_error:
