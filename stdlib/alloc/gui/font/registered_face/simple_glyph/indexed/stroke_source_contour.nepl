#test
//: side_edge_test_edge_matches: Line/QuadraticとLeft/Rightのdirected endpointを元geometryと照合します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_test_edge_matches %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection fn i32 bool \edge\edge_index:
    let geometry gui_sfnt_simple_glyph_render_stroke_side_edge_projection_geometry edge
    let is_left %bool or eq edge_index 0 or eq edge_index 2 eq edge_index 4
    let source_forward %bool gui_sfnt_simple_glyph_render_stroke_side_edge_projection_is_source_forward edge
    let direction_ok %bool if is_left then source_forward else not source_forward
    let start_x %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_projection_start_x2 edge
    let start_y %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_projection_start_y2 edge
    let end_x %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_projection_end_x2 edge
    let end_y %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_projection_end_y2 edge
    match geometry:
        GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Line line:
            let expected_start_x %f32 if is_left then gui_sfnt_simple_glyph_render_offset_line_geometry_projection_left_start_x2 &line else gui_sfnt_simple_glyph_render_offset_line_geometry_projection_right_end_x2 &line
            let expected_start_y %f32 if is_left then gui_sfnt_simple_glyph_render_offset_line_geometry_projection_left_start_y2 &line else gui_sfnt_simple_glyph_render_offset_line_geometry_projection_right_end_y2 &line
            let expected_end_x %f32 if is_left then gui_sfnt_simple_glyph_render_offset_line_geometry_projection_left_end_x2 &line else gui_sfnt_simple_glyph_render_offset_line_geometry_projection_right_start_x2 &line
            let expected_end_y %f32 if is_left then gui_sfnt_simple_glyph_render_offset_line_geometry_projection_left_end_y2 &line else gui_sfnt_simple_glyph_render_offset_line_geometry_projection_right_start_y2 &line
            let variant_ok %bool or eq edge_index 0 or eq edge_index 1 or eq edge_index 4 eq edge_index 5
            and variant_ok (and direction_ok (and eq start_x expected_start_x (and eq start_y expected_start_y (and eq end_x expected_end_x eq end_y expected_end_y))))

        GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Quadratic quadratic:
            let expected_start_x %f32 if is_left then gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_left_start_x2 &quadratic else gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_right_end_x2 &quadratic
            let expected_start_y %f32 if is_left then gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_left_start_y2 &quadratic else gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_right_end_y2 &quadratic
            let expected_end_x %f32 if is_left then gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_left_end_x2 &quadratic else gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_right_start_x2 &quadratic
            let expected_end_y %f32 if is_left then gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_left_end_y2 &quadratic else gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_right_start_y2 &quadratic
            let variant_ok %bool or eq edge_index 2 eq edge_index 3
            and variant_ok (and direction_ok (and eq start_x expected_start_x (and eq start_y expected_start_y (and eq end_x expected_end_x eq end_y expected_end_y))))

