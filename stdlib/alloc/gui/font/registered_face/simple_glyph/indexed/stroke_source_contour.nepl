//: command_from_span: commandとindexed spanのidentityを一か所で検査します
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_stroke_source_contour_command_from_span %fn GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandValue fn GuiSfntSimpleGlyphContourSpan Result unit GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourReadErrorKind \value\span:
    let contour gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_value_contour_index &value
    let edge gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_value_edge_index &value
    let local gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_value_contour_edge_index &value
    let start gui_sfnt_simple_glyph_contour_span_start_point_index &span
    let end gui_sfnt_simple_glyph_contour_span_end_point_index &span
    let span_count gui_sfnt_simple_glyph_contour_span_point_count &span
    let contour_ok eq contour gui_sfnt_simple_glyph_contour_span_index &span
    let local_ok eq local sub edge start
    let edge_ok and ge edge start le edge end
    let count_ok eq span_count add sub end start 1
    let identity_ok and contour_ok and local_ok and edge_ok count_ok
    if not identity_ok:
        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourReadErrorKind::SpanIdentityMismatch
        else Result::Ok unit

fn gui_font_registered_face_simple_glyph_indexed_stroke_source_contour_span_identity_eq %fn &GuiSfntSimpleGlyphContourSpan fn &GuiSfntSimpleGlyphContourSpan bool \left\right:
    let left_glyph gui_sfnt_simple_glyph_contour_span_glyph left
    let right_glyph gui_sfnt_simple_glyph_contour_span_glyph right
    and eq gui_glyph_id_raw &left_glyph gui_glyph_id_raw &right_glyph and eq gui_sfnt_simple_glyph_contour_span_index left gui_sfnt_simple_glyph_contour_span_index right and eq gui_sfnt_simple_glyph_contour_span_start_point_index left gui_sfnt_simple_glyph_contour_span_start_point_index right and eq gui_sfnt_simple_glyph_contour_span_end_point_index left gui_sfnt_simple_glyph_contour_span_end_point_index right eq gui_sfnt_simple_glyph_contour_span_point_count left gui_sfnt_simple_glyph_contour_span_point_count right

