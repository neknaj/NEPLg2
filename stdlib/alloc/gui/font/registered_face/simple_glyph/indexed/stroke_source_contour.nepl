                else if ne gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_owner_cells_len &coverage_owner count:
                    then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartError coverage_owner config GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartErrorKind::RawCellStorageLenMismatch
                    else if ne gui_font_registered_face_simple_glyph_indexed_stroke_coverage_cell_owner_cells_cap &coverage_owner count:
                        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartError coverage_owner config GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartErrorKind::RawCellStorageCapacityMismatch
                        else if gt coverage_max div_s 2147483647 alpha_max:
