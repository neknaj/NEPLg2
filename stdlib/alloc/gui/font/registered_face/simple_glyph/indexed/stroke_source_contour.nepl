        then Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::Progress (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeProgress owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStatusKind::StepBudgetExhausted none)
        else:
            match *field::get_ref &owner "pending":
                Option::Some _geometry: gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_push_pending owner
                Option::None:
                    let edges %Vec GuiSfntSimpleGlyphRenderStrokeSideEdgeProjection field::get owner "edges"
                    let geometry_count %i32 field::get owner "geometry_count"
                    let side_edge_count %i32 field::get owner "side_edge_count"
                    let line_count %i32 field::get owner "line_side_edge_count"
                    let quadratic_count %i32 field::get owner "quadratic_side_edge_count"
                    let left_count %i32 field::get owner "left_side_edge_count"
                    let right_count %i32 field::get owner "right_side_edge_count"
                    let offset %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionOwner field::get owner "offset"
                    match gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step offset 1:
                        Result::Err lower:
                            let kind gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_error_kind &lower
                            let returned gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_error_owner lower
                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered (GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::OffsetProjectionFailed kind) none
                        Result::Ok lower_step:
                            let status gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_status &lower_step
                            let geometry gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_geometry &lower_step
                            let returned gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_step_owner lower_step
                            match status:
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::Projected:
                                    match geometry:
                                        Option::None:
                                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none
                                        Option::Some value:
                                            let pending %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges (some value) GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            gui_font_registered_face_simple_glyph_indexed_stroke_side_edge_push_pending pending
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::Completed:
                                    let expected %i32 mul gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_owner_metric_count &returned 2
                                    if and eq side_edge_count expected eq vec::len &edges vec::cap &edges:
                                        then:
                                            let completed %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeCompletedOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeCompletedOwner returned edges geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStep::CompletedValue completed
                                        else:
                                            let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                            Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none
                                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeOffsetProjectionStatusKind::StepBudgetExhausted:
                                    let recovered %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeOwner returned edges none GuiSfntSimpleGlyphRenderStrokeSideEdgeProjectionSide::Left geometry_count side_edge_count line_count quadratic_count left_count right_count
                                    Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeStepError recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSideEdgeErrorKind::ProgressInvariantInvalid none

