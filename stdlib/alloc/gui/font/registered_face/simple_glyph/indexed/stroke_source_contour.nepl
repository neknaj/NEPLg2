//: projection_test_geometry_matches: runtime fixture が公開 Copy geometry の代表値を照合します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_stroke_offset_projection_test_geometry_matches %fn &GuiSfntSimpleGlyphRenderOffsetGeometryProjection fn i32 bool \geometry\metric_index:
    match geometry:
        GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Line line:
            let expected_command %i32 if eq metric_index 0 then 1 else 7
            let expected_left_y %f32 if eq metric_index 0 then 4.0 else -4.0
            let expected_right_y %f32 if eq metric_index 0 then -4.0 else 4.0
            and ne metric_index 1 and eq metric_index gui_sfnt_simple_glyph_render_offset_line_geometry_projection_metric_index line and eq expected_command gui_sfnt_simple_glyph_render_offset_line_geometry_projection_path_command_index line and eq expected_left_y gui_sfnt_simple_glyph_render_offset_line_geometry_projection_left_start_y2 line eq expected_right_y gui_sfnt_simple_glyph_render_offset_line_geometry_projection_right_start_y2 line
        GuiSfntSimpleGlyphRenderOffsetGeometryProjection::Quadratic quadratic:
            let start_source_ok %bool match gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_start_tangent_source quadratic:
                GuiSfntSimpleGlyphRenderStrokeOffsetQuadraticTangentSource::StartControl: true
                _: false
            let end_source_ok %bool match gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_end_tangent_source quadratic:
                GuiSfntSimpleGlyphRenderStrokeOffsetQuadraticTangentSource::ControlEnd: true
                _: false
            and eq metric_index 1 and eq 1 gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_metric_index quadratic and eq 3 gui_sfnt_simple_glyph_render_offset_quadratic_geometry_projection_path_command_index quadratic and start_source_ok end_source_ok

