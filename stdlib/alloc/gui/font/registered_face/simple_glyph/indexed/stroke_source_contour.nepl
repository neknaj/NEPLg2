                                                Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartError coverage_owner config GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskStartErrorKind::AlphaStorageCapacityMismatch
                                            else Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskPackOwner coverage_owner alpha_cells config 0

