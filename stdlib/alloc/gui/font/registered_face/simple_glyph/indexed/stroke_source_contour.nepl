                                    then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokePackedMaskErrorKind::AlphaScaleOverflow
                                    else:
