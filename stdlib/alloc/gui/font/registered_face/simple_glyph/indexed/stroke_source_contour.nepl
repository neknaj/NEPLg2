//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourOwner:
    sink %GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandSinkCompletedOwner

