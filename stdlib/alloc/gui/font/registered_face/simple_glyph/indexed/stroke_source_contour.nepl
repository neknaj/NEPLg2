                            Option::None: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeJoinGeometryErrorKind::SourceSlotMissing none
                            Option::Some join:
                                let from_index %i32 gui_sfnt_simple_glyph_render_stroke_join_closure_record_from_side_edge_index &join
                                let to_index %i32 gui_sfnt_simple_glyph_render_stroke_join_closure_record_to_side_edge_index &join
