                                                                    GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Miter _: add miter_count 1
                                                                    GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Round _: miter_count
                                                                let next_round %i32 match geometry:
                                                                    GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Bevel _: round_count
                                                                    GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Miter _: round_count
                                                                    GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Round _: add round_count 1
