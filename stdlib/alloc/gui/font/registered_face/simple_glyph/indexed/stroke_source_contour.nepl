    provenance %Vec GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance
    actual %GuiFontRegisteredFaceSimpleGlyphIndexedMetricCheckpointOwner
    command_count %i32
    metric_count %i32
    line_count %i32
    quadratic_count %i32
    next_metric_index %i32
    origin %GuiPoint
    stroke_width %i32

