//: # registered-face simple glyph indexed stroke source contour
//: F5nxj completed authorityを保持し、commandごとのcontour provenanceをindexed spanから再構築します。
//:
//: full command stream scanやprovenance Vecを作らず、checked commandとindexed spanを照合します。checked-span curve再照合は後続sliceで追加します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_source_contour" as *
//: fn main %fn void i32 \void:
//:|      let value %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourReadErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourReadErrorKind::SpanIdentityMismatch
//:|      match value:
//:|          GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourReadErrorKind::SpanIdentityMismatch: 0
//:|          _: 1
//: ```

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/path_command_sink" as *
#import "alloc/gui/font/registered_face/simple_glyph/indexed/path_command_stream" as *
#import "alloc/gui/font/sfnt" as *
#import "alloc/collections/vec" as vec
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *

