pub fn gui_font_registered_face_simple_glyph_indexed_stroke_metric_provenance_command %fn &GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourCommand \value: *field::get_ref value "command"

fn gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourOwner fn Vec GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricDrainOwner \source\provenance\next\expected_command\expected_move\expected_line\expected_quadratic\expected_skip\move\line\quadratic\skip:
    GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricDrainOwner source provenance next expected_command expected_move expected_line expected_quadratic expected_skip move line quadratic skip

pub fn gui_font_registered_face_simple_glyph_indexed_stroke_metric_start %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricDrainOwner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartError \source:
    let sink %&GuiFontRegisteredFaceSimpleGlyphIndexedPathCommandSinkCompletedOwner field::get_ref &source "sink"
    let summary gui_font_registered_face_simple_glyph_indexed_path_command_sink_completed_owner_summary sink
    let total gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_total_count &summary
    let move gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_move_to_count &summary
    let line gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_line_to_count &summary
    let quadratic gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_quadratic_to_count &summary
    let skip gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_prepare_summary_skip_no_segment_count &summary
    let draw add line quadratic
    if or lt total 0 or lt move 0 or lt line 0 or lt quadratic 0 lt skip 0:
        then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartError source GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartErrorKind::InvalidSummary
        else if ne total add add move draw skip:
            then Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartError source GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartErrorKind::InvalidSummary
            else:
                match vec::with_capacity<GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance> draw:
                    Result::Err error: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartError source GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStartErrorKind::AllocationFailed error
                    Result::Ok provenance: Result::Ok gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner source provenance 0 total move line quadratic skip 0 0 0 0

pub fn gui_font_registered_face_simple_glyph_indexed_stroke_metric_step_budget %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricDrainOwner impure fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStepError \owner\budget:
    let next %i32 *field::get_ref &owner "next_command_index"
    let end %i32 *field::get_ref &owner "expected_command_count"
    if ge next end:
        then Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStatusKind::Completed
        else if le budget 0:
            then Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStatusKind::StepBudgetExhausted
            else:
                let borrowed_source %&GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourOwner field::get_ref &owner "source"
                match gui_font_registered_face_simple_glyph_indexed_stroke_source_contour_read_at borrowed_source next:
                    Result::Err kind: Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStepError owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStepErrorKind::SourceReadFailed kind
                    Result::Ok command:
                        let event gui_font_registered_face_simple_glyph_indexed_stroke_source_contour_command_event &command
                        let kind gui_sfnt_simple_glyph_path_sink_event_kind &event
                        let source %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeSourceContourOwner field::get owner "source"
                        let provenance %Vec GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance field::get owner "provenance"
                        let expected_move %i32 *field::get_ref &owner "expected_move_count"
                        let expected_line %i32 *field::get_ref &owner "expected_line_count"
                        let expected_quadratic %i32 *field::get_ref &owner "expected_quadratic_count"
                        let expected_skip %i32 *field::get_ref &owner "expected_skip_count"
                        let move %i32 *field::get_ref &owner "move_count"
                        let line %i32 *field::get_ref &owner "line_count"
                        let quadratic %i32 *field::get_ref &owner "quadratic_count"
                        let skip %i32 *field::get_ref &owner "skip_count"
                        match kind:
                            GuiSfntSimpleGlyphPathSinkEventKind::MoveTo:
                                Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep (gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner source provenance add next 1 end expected_move expected_line expected_quadratic expected_skip add move 1 line quadratic skip) GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStatusKind::Progressed
                            GuiSfntSimpleGlyphPathSinkEventKind::SkipNoSegment _reason:
                                Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep (gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner source provenance add next 1 end expected_move expected_line expected_quadratic expected_skip move line quadratic add skip 1) GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStatusKind::Progressed
                            GuiSfntSimpleGlyphPathSinkEventKind::LineTo:
                                let metric_index %i32 add line quadratic
                                let item %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance metric_index command
                                match vec::push provenance item:
                                    Result::Err error:
                                        let storage_kind %StdErrorKind vec::vec_push_error_kind &error
                                        let recovered %Vec GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricProvenance vec::vec_push_error_vec error
                                        let recovered_owner gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner source recovered next end expected_move expected_line expected_quadratic expected_skip move line quadratic skip
                                        Result::Err GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStepError recovered_owner GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricStepErrorKind::StoragePushFailed storage_kind
                                    Result::Ok pushed: Result::Ok GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStep (gui_font_registered_face_simple_glyph_indexed_stroke_metric_drain_owner source pushed add next 1 end expected_move expected_line expected_quadratic expected_skip move add line 1 quadratic skip) GuiFontRegisteredFaceSimpleGlyphIndexedStrokeMetricBudgetStatusKind::Progressed
