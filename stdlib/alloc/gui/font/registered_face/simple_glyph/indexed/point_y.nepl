    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus \value:
        value

//: bounded drain の status と継続可能な同じ owner を束ねます。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStep:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner
    status %GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus

//: premature または invariant-invalid seal から owner を回収できる error です。
