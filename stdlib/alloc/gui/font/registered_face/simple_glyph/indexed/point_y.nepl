    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Active _active: GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind::Active
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Completed _completed: GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind::Completed

//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_point_y_owner_cursor %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner GuiSfntSimpleGlyphOutlineScalarRegionCursor \owner:
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPointYState field::get_ref owner "state"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Active active: *field::get_ref active "cursor"
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Completed completed: *field::get_ref completed "cursor"

