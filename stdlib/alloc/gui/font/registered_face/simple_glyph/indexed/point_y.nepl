pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYSealError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner
    actual %GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind
    invariant %GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck

