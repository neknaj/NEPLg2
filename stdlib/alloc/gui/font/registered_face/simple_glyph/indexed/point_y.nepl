        value

//: step failure metadata と進捗未変更の同じ PointY owner を保持する error です。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYStepError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner
    kind %GuiFontRegisteredFaceSimpleGlyphIndexedPointYStepErrorKind
