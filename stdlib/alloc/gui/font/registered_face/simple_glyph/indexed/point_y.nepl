fn gui_font_registered_face_simple_glyph_indexed_point_y_start_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck fn i32 fn i32 fn Option StdErrorKind fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartError \owner\kind\point_x_invariant\expected\actual\cursor_error\phase:
    GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartError owner kind point_x_invariant expected actual cursor_error phase

//: F5nxe completion、item count、PointY cursor、F5nxf invariant の順で開始を検査します。
//:
//: neplg2:test[skip]
