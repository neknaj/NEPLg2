//: F5nxf 固有 invariant を契約上の優先順位で検査します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_point_y_owner_phase_invariant_check %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck \owner:
    let point_x %&GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner field::get_ref owner "point_x"
    let capacity gui_font_registered_face_simple_glyph_indexed_point_x_completed_owner_capacity point_x
    let contour_count gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let point_count gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let cursor gui_font_registered_face_simple_glyph_indexed_point_y_owner_cursor owner
    let start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
    let end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor
    let next gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
    let logical sub next start
    let len gui_font_registered_face_simple_glyph_indexed_point_x_completed_owner_storage_len point_x
    let shape_invalid gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CanonicalCapacityShapeInvalid
    let endpoint_check gui_font_registered_face_simple_glyph_indexed_point_x_completed_owner_continuation_authority_check point_x
    let endpoint_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageCapacityMismatch: none
                GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageShapeMismatch: none
                _: some GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::PointXCompletionInvariantInvalid
    let storage_capacity_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageCapacityMismatch: some GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::StorageCapacityMismatch
                _: none
    let storage_shape_invalid match endpoint_check:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Valid: none
        GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck::Invalid kind:
            match kind:
                GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantInvalidKind::StorageShapeMismatch: some GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::StorageShapeMismatch
                _: none
    let actual_item_count gui_font_registered_face_simple_glyph_indexed_point_x_completed_owner_item_count point_x
    let item_count_invalid gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if ne actual_item_count point_count GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CollectionItemCountMismatch
    let cursor_invalid gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CursorInvalid
    let region_matches match gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor:
        GuiSfntSimpleGlyphOutlineScalarRegion::PointY: true
        _: false
    let region_invalid gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if not region_matches GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CursorRegionMismatch
    let capacity_invalid match gui_sfnt_simple_glyph_outline_scalar_region_cursor_try_from_capacity &capacity GuiSfntSimpleGlyphOutlineScalarRegion::PointY:
        Result::Err _error: some GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CursorCapacityMismatch
        Result::Ok expected: gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if or ne start gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &expected ne end gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &expected GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CursorCapacityMismatch
    let len_invalid gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if ne len add add contour_count point_count logical GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::StorageLengthMismatch
    let common1 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid shape_invalid endpoint_invalid
    let common2 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common1 storage_capacity_invalid
    let common3 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common2 storage_shape_invalid
    let common4 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common3 item_count_invalid
    let common5 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common4 cursor_invalid
    let common6 gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common5 region_invalid
    let common gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common6 capacity_invalid
    let common gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common len_invalid
    let state %&GuiFontRegisteredFaceSimpleGlyphIndexedPointYState field::get_ref owner "state"
    let phase match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Active _active: gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if ge next end GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::ActiveCursorAtEnd
        GuiFontRegisteredFaceSimpleGlyphIndexedPointYState::Completed _completed: gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if or ne next end ne sub end start point_count GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind::CompletedCursorNotAtEnd
    match gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid common phase:
        Option::Some kind: GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Invalid kind
        Option::None: GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck::Valid

//: start metadata と未分解の入力ownerを一つのtyped errorに束ねます。
