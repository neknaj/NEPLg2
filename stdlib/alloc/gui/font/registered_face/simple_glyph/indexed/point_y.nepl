//: # alloc/gui/font/registered_face/simple_glyph/indexed/point_y
//: F5nxe completed authority から PointY region を順次構築する
//:
//: ### [契約/けいやく]
//: - start は F5nxe checked completed owner だけを受け取ります。
//: - logical item index は cursor の next と start の差だけから導出します。
//: - item read、identity validation、PointY push を順番に行い、失敗を成功へ置換しません。
//: - terminal、budget zero、step の順で判定し、Edge cursor は開始しません。
//: - owner を保持する型は `Clone` / `Copy` を実装しません。
//:
//: ### [計算量/けいさんりょう]
//: start、invariant、step は定数時間、全 drain は point 数に比例し、追加 metadata は定数領域です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face/simple_glyph/indexed/point_y" as *
//:| #import "std/test" as *
//:
//: fn main %fn void i32 \void:
//:     let status %GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus::StepBudgetExhausted
//:     let typed %bool match status:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus::StepBudgetExhausted: true
//:         _: false
//:     test_assertion_exit_code assert "PointY budget status is typed" typed
//: ```

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/point_x" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: PointY population の実行中または完了を表す Copy 状態です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind:
    Active
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedPointYProgressKind \value:
        value

//: PointY owner invariant の固定優先順位を持つ invalid reason です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind:
    CanonicalCapacityShapeInvalid
    PointXCompletionInvariantInvalid
    StorageCapacityMismatch
    StorageShapeMismatch
    CollectionItemCountMismatch
    CursorInvalid
    CursorRegionMismatch
    CursorCapacityMismatch
    StorageLengthMismatch
    ActiveCursorAtEnd
    CompletedCursorNotAtEnd

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind \value:
        value

//: PointY owner invariant の成功または最初の invalid reason を保持します。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck:
    Valid
    Invalid %GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck \value:
        value

//: 未処理の PointY slot を指す checked cursor metadata です。
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive:
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive \value:
        value

//: 全 PointY slot の commit を終えた cursor metadata です。
//: neplg2:test[skip]
struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted:
    cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted \value:
        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted \value:
        value

//: PointY cursor を active と completed の排他的な状態として保持します。
//: neplg2:test[skip]
enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYState:
    Active %GuiFontRegisteredFaceSimpleGlyphIndexedPointYActive
    Completed %GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompleted

//: F5nxe completed authority と F5nxf PointY phase state を分離せず保持する owner です。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner:
    point_x %GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner
    state %GuiFontRegisteredFaceSimpleGlyphIndexedPointYState

//: checked completion 後の running owner 全体を保持する F5nxf authority です。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYCompletedOwner:
    running %GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner

//: start の検査段階を固定優先順位で識別する reason です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind:
    PointXCompletionInvariantInvalid
    CollectionItemCountMismatch
    CursorStartFailed
    PhaseInvariantInvalid

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind:
