    item %Option GuiSfntSimpleGlyphOutlinePointStreamItem
    read_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError
    point %Option GuiSfntSimpleGlyphPointYSlot
    push_kind %Option GuiSfntSimpleGlyphPointYPushErrorKind
    region_error_kind %Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind
    storage_push_error_kind %Option StdErrorKind
    recovered_invariant %Option GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck

//: 一回の bounded drain が commit、完了、budget枯渇のどれかを表します。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYBudgetStatus:
    Pushed %GuiSfntSimpleGlyphPointYSlot
    Completed
    StepBudgetExhausted

