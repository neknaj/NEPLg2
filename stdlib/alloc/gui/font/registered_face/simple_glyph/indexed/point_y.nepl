        *value

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind \value:
        value

//: start failure metadata と同じ F5nxe owner を保持する回収可能な error です。
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner
    kind %GuiFontRegisteredFaceSimpleGlyphIndexedPointYStartErrorKind
    point_x_invariant %GuiFontRegisteredFaceSimpleGlyphIndexedPointXPhaseInvariantCheck
    expected_item_count %i32
    actual_item_count %i32
    cursor_error %Option StdErrorKind
    phase_invariant %GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantCheck

//: 一つの PointY commit が失敗した段階を識別する reason です。
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedPointYStepErrorKind:
    AlreadyCompleted
    ItemReadFailed
    ItemGlyphMismatch
    ItemIndexMismatch
    ItemKindMismatch
    PointYPushFailed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedPointYStepErrorKind:
