fn gui_font_registered_face_simple_glyph_indexed_point_y_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedPointXCompletedOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYState GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner \point_x\state:
    GuiFontRegisteredFaceSimpleGlyphIndexedPointYOwner point_x state

//: predicate が成立した場合だけ typed invalid reason を候補にします。
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_point_y_invalid_if %fn bool fn GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind Option GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind \condition\kind:
    if condition then some kind else none

//: earlierを優先し、固定されたerror precedenceを保って候補を合成します。
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_point_y_first_invalid %fn Option GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind fn Option GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind Option GuiFontRegisteredFaceSimpleGlyphIndexedPointYPhaseInvariantInvalidKind \earlier\later:
    match earlier:
        Option::Some kind: some kind
        Option::None: later

//: owner の phase と cursor を Copy metadata として読みます。
//:
