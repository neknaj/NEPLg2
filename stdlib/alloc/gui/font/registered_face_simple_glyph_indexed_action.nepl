//: gui_font_registered_face_simple_glyph_indexed_action_step_need_sink_step: lower path を一度進めて Primary packet を作る
//:
//: [契約/けいやく]: lower error metadata は path owner を take する前にすべて Copy します。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_step_need_sink_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedActionStep GuiFontRegisteredFaceSimpleGlyphIndexedActionError \path:
    match gui_font_registered_face_simple_glyph_indexed_path_step path:
        Result::Err path_error:
            let path_error_kind %GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind gui_font_registered_face_simple_glyph_indexed_path_error_kind &path_error
            let lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError gui_font_registered_face_simple_glyph_indexed_path_error_lookup_error &path_error
            let contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError gui_font_registered_face_simple_glyph_indexed_path_error_contour_step_error &path_error
            let recovered_path %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_error_take_owner path_error
            let recovered_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_owner recovered_path GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep
            Result::Err gui_font_registered_face_simple_glyph_indexed_action_error recovered_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind::PathStepFailed some path_error_kind lookup_error contour_step_error
        Result::Ok path_step:
            let sink_step %GuiSfntSimpleGlyphPathSinkStep gui_font_registered_face_simple_glyph_indexed_path_step_sink_step &path_step
            let action %GuiSfntSimpleGlyphPathSinkAction gui_sfnt_simple_glyph_path_sink_step_action_at &sink_step GuiSfntSimpleGlyphPathSinkActionSlot::Primary
            let packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket gui_font_registered_face_simple_glyph_indexed_action_packet sink_step GuiSfntSimpleGlyphPathSinkActionSlot::Primary action
            let next_path %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_step_take_owner path_step
            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_owner next_path GuiFontRegisteredFaceSimpleGlyphIndexedActionState::TailPending sink_step
            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_step_value packet next_owner

//: gui_font_registered_face_simple_glyph_indexed_action_step_tail_pending: 保存済み sink step の Tail packet を作る
//:
//: [契約/けいやく]: lower step、lookup、collection read は行わず、full-path progress だけで次状態を決めます。
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_step_tail_pending %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiSfntSimpleGlyphPathSinkStep Result GuiFontRegisteredFaceSimpleGlyphIndexedActionStep GuiFontRegisteredFaceSimpleGlyphIndexedActionError \path\sink_step:
    let action %GuiSfntSimpleGlyphPathSinkAction gui_sfnt_simple_glyph_path_sink_step_action_at &sink_step GuiSfntSimpleGlyphPathSinkActionSlot::Tail
    let packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket gui_font_registered_face_simple_glyph_indexed_action_packet sink_step GuiSfntSimpleGlyphPathSinkActionSlot::Tail action
    let next_state %GuiFontRegisteredFaceSimpleGlyphIndexedActionState match gui_font_registered_face_simple_glyph_indexed_path_progress_kind &path:
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::Completed:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionState::Completed
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::PendingContour:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep
        GuiFontRegisteredFaceSimpleGlyphIndexedPathProgressKind::ActiveContour:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep
    let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_owner path next_state
    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_step_value packet next_owner

//: gui_font_registered_face_simple_glyph_indexed_action_step: action stream を最大一 operation 進める
//:
//: [契約/けいやく]: completed direct step は silent success にせず、同じ owner を持つ `AlreadyCompleted` を返します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner Result GuiFontRegisteredFaceSimpleGlyphIndexedActionStep GuiFontRegisteredFaceSimpleGlyphIndexedActionError \owner:
    let state %GuiFontRegisteredFaceSimpleGlyphIndexedActionState *field::get_ref &owner "state"
    let path %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner field::get owner "path"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep:
            gui_font_registered_face_simple_glyph_indexed_action_step_need_sink_step path
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::TailPending sink_step:
            gui_font_registered_face_simple_glyph_indexed_action_step_tail_pending path sink_step
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::Completed:
            let recovered_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_owner path state
            Result::Err gui_font_registered_face_simple_glyph_indexed_action_error recovered_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind::AlreadyCompleted none none none

//: gui_font_registered_face_simple_glyph_indexed_action_drain_budget: terminal-before-budget で最大一 action 進める
//:
//: [契約/けいやく]: nonterminal budget 0 は lower call と action emit を行いません。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_drain_budget %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn i32 Result GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep GuiFontRegisteredFaceSimpleGlyphIndexedActionError \owner\remaining_steps:
    let state %GuiFontRegisteredFaceSimpleGlyphIndexedActionState *field::get_ref &owner "state"
    match state:
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::Completed:
            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::Completed
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep:
            if le remaining_steps 0:
                then:
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::StepBudgetExhausted
                else:
                    match gui_font_registered_face_simple_glyph_indexed_action_step owner:
                        Result::Err error:
                            Result::Err error
                        Result::Ok step:
                            let packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket gui_font_registered_face_simple_glyph_indexed_action_step_packet &step
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_step_take_owner step
                            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::Emitted packet
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::TailPending _sink_step:
            if le remaining_steps 0:
                then:
                    Result::Ok gui_font_registered_face_simple_glyph_indexed_action_budget_step owner GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::StepBudgetExhausted
                else:
                    match gui_font_registered_face_simple_glyph_indexed_action_step owner:
                        Result::Err error:
                            Result::Err error
                        Result::Ok step:
                            let packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket gui_font_registered_face_simple_glyph_indexed_action_step_packet &step
                            let next_owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_step_take_owner step
                            Result::Ok gui_font_registered_face_simple_glyph_indexed_action_budget_step next_owner GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::Emitted packet

