//: # alloc/gui/font/registered_face_simple_glyph_indexed_action
//: registered indexed glyph の sink step を順序付き action stream へ射影する
//:
//: ### [目的/もくてき]
//: - registered indexed owner から始まる F5nw path authority を action 完了まで同じ owner に保持します。
//: - 各 sink step を `Primary`、`Tail` の順に一度ずつ公開し、`NoAction` も明示的な operation として数えます。
//: - lower path failure では metadata を先に読み、回収した path owner を action state と再結合します。
//:
//: ### [契約/けいやく]
//: - raw collection、cursor、path owner を分離する public API は提供しません。
//: - `NeedSinkStep` だけが lower path step を一度呼び、`TailPending` は保存済み sink step だけを読みます。
//: - private state は公開せず、進捗は `NeedSinkStep` / `TailPending` を `Active`、`Completed` を `Completed` とする Copy projection だけで公開します。
//: - budget は terminal、budget 0、最大一 action の順に判定し、常に owner と Copy status を返します。
//: - action summary、storage、command、stroke state は所有しません。
//:
//: ### [計算量/けいさんりょう]
//: sink step 数 s に対して全 action 射影は O(s)、追加 allocation は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//:
//: fn run_one_action %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner unit \owner:
//:     match gui_font_registered_face_simple_glyph_indexed_action_drain_budget owner 1:
//:         Result::Err error:
//:             gui_font_registered_face_simple_glyph_indexed_action_error_free error
//:         Result::Ok budget_step:
//:             gui_font_registered_face_simple_glyph_indexed_action_budget_step_free budget_step
//:
//: fn read_progress %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind \owner:
//:     gui_font_registered_face_simple_glyph_indexed_action_progress_kind owner
//:
//: fn main %fn void i32 \void:
//:     let active %bool match GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Active:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Active: true
//:         _: false
//:     let completed %bool match GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::Completed:
//:         GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus::Completed: true
//:         _: false
//:     test_assertion_exit_code assert "registered indexed action progress is typed" and active completed
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn forge_action_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner \path:
//:     gui_font_registered_face_simple_glyph_indexed_action_owner path GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep
//:
//: fn main %fn void i32 \void:
//:     0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn main %fn void i32 \void:
//:     match GuiFontRegisteredFaceSimpleGlyphIndexedActionState::Completed:
//:         _: 0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resource.cell.moved
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn take_budget_owner_twice %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep unit \step:
//:     let first %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_budget_step_take_owner step
//:     let second %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner gui_font_registered_face_simple_glyph_indexed_action_budget_step_take_owner step
//:     gui_font_registered_face_simple_glyph_indexed_action_owner_free first
//:     gui_font_registered_face_simple_glyph_indexed_action_owner_free second
//:
//: fn main %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep i32 \step:
//:     take_budget_owner_twice step
//:     0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_packet
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_step_value
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_error
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/registered_face_simple_glyph_indexed_action" as *
//:
//: fn main %fn void i32 \void:
//:     gui_font_registered_face_simple_glyph_indexed_action_budget_step
//: ```

#import "alloc/gui/font/registered_face_simple_glyph_collection" as *
#import "alloc/gui/font/registered_face_simple_glyph_indexed_path" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind: private action state を隠した公開進捗分類
//:
//: [目的/もくてき]: 後続の summary owner が raw state や sink step を取り出さず、action stream 全体の完了だけを判定できるようにします。
//:
//: [契約/けいやく]: `NeedSinkStep` と `TailPending` は `Active`、`Completed` だけは `Completed` に射影します。final Primary 後の `TailPending` は、final Tail が公開されるまで `Active` のままです。
//:
//: [計算量/けいさんりょう]: 判定は O(1) で、allocation、lower step、lookup、collection read を行いません。
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind:
    Active
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind \kind:
        kind

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionState: lower step 待ち、tail 待ち、完了を分ける内部状態
//:
//: neplg2:test[skip]
enum GuiFontRegisteredFaceSimpleGlyphIndexedActionState:
    NeedSinkStep
    TailPending %GuiSfntSimpleGlyphPathSinkStep
    Completed

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedActionState:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionState GuiFontRegisteredFaceSimpleGlyphIndexedActionState \state:
        *state

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedActionState:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionState GuiFontRegisteredFaceSimpleGlyphIndexedActionState \state:
        state

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner: F5nw path authority と action 継続状態の owner
//:
//: [注意/ちゅうい]: path owner を所有するため `Clone` / `Copy` は実装しません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner:
    path %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner
    state %GuiFontRegisteredFaceSimpleGlyphIndexedActionState

//: gui_font_registered_face_simple_glyph_indexed_action_owner: path authority と private state を分離不能に束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedActionState GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner \path\state:
    GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner path state

//: gui_font_registered_face_simple_glyph_indexed_action_progress_kind: action owner の公開進捗を読む
//:
//: [目的/もくてき]: owner を消費せず、後続処理が継続中か全 action 完了かを Copy 値として判定できるようにします。
//:
//: [契約/けいやく]: raw state と保存済み sink step は公開しません。`NeedSinkStep` / `TailPending` は `Active`、`Completed` は `Completed` を返します。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域で、lower path の状態や contour-local event から完了を再導出しません。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_progress_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind \owner:
    match *field::get_ref owner "state":
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Active
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::TailPending _sink_step:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Active
        GuiFontRegisteredFaceSimpleGlyphIndexedActionState::Completed:
            GuiFontRegisteredFaceSimpleGlyphIndexedActionProgressKind::Completed

//: gui_font_registered_face_simple_glyph_indexed_action_owner_span_count: action authority が保持する indexed contour 数を読む
//:
//: [目的/もくてき]: 上位 phase が raw path owner を取り出さず、action owner に束ねた registered authority の contour budget を確認できるようにします。
//:
//: [契約/けいやく]: immediate nested path owner を借用し、`gui_font_registered_face_simple_glyph_indexed_path_owner_span_count` を exactly once 呼びます。action state は変更しません。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_owner_span_count %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner i32 \owner:
    let path %&GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner field::get_ref owner "path"
    gui_font_registered_face_simple_glyph_indexed_path_owner_span_count path

//: gui_font_registered_face_simple_glyph_indexed_action_owner_span_lookup: action authority から checked contour span を O(1) で読む
//:
//: [目的/もくてき]: endpoint population が action continuation と registered index を分離せず、typed result のまま contour span を参照できるようにします。
//:
//: [契約/けいやく]: immediate nested path owner を借用し、`gui_font_registered_face_simple_glyph_indexed_path_owner_span_lookup` を exactly once 呼びます。成功と失敗のどちらでも同じ action owner を caller が保持します。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_owner_span_lookup %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn i32 Result GuiSfntSimpleGlyphContourSpan GuiSfntSimpleGlyphContourSpanIndexLookupError \owner\contour_index:
    let path %&GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner field::get_ref owner "path"
    gui_font_registered_face_simple_glyph_indexed_path_owner_span_lookup path contour_index

//: gui_font_registered_face_simple_glyph_indexed_action_owner_item_read: action authority から classified point item を借用して読む
//:
//: [目的/もくてき]: endpoint population が action continuation と registered collection authority を分離せず、point item と typed read error を取得できるようにします。
//:
//: [契約/けいやく]: immediate nested path owner を借用し、`gui_font_registered_face_simple_glyph_indexed_path_owner_item_read` を exactly once 呼びます。action state は変更しません。
//:
//: [計算量/けいさんりょう]: O(1) 時間、O(1) 追加領域です。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_owner_item_read %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn i32 Result GuiSfntSimpleGlyphOutlinePointStreamItem GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError \owner\item_index:
    let path %&GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner field::get_ref owner "path"
    gui_font_registered_face_simple_glyph_indexed_path_owner_item_read path item_index

//: action authority が保持する classified item 数を読みます。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_owner_item_count %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner i32 \owner:
    let path %&GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner field::get_ref owner "path"
    gui_font_registered_face_simple_glyph_indexed_path_owner_item_count path

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket: 一 action と由来 sink step を運ぶ Copy packet
//:
//: [契約/けいやく]: slot は `Primary` または `Tail` であり、action は同じ sink step の pure projection です。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket:
    sink_step %GuiSfntSimpleGlyphPathSinkStep
    slot %GuiSfntSimpleGlyphPathSinkActionSlot
    action %GuiSfntSimpleGlyphPathSinkAction

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket \packet:
        *packet

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket \packet:
        packet

//: gui_font_registered_face_simple_glyph_indexed_action_packet: sink step、slot、action を一つの packet に束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_packet %fn GuiSfntSimpleGlyphPathSinkStep fn GuiSfntSimpleGlyphPathSinkActionSlot fn GuiSfntSimpleGlyphPathSinkAction GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket \sink_step\slot\action:
    GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket sink_step slot action

//: gui_font_registered_face_simple_glyph_indexed_action_packet_sink_step: action の由来 sink step を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_packet_sink_step %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket GuiSfntSimpleGlyphPathSinkStep \packet:
    *field::get_ref packet "sink_step"

//: gui_font_registered_face_simple_glyph_indexed_action_packet_slot: packet の action slot を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_packet_slot %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket GuiSfntSimpleGlyphPathSinkActionSlot \packet:
    *field::get_ref packet "slot"

//: gui_font_registered_face_simple_glyph_indexed_action_packet_action: packet の typed action を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_packet_action %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket GuiSfntSimpleGlyphPathSinkAction \packet:
    *field::get_ref packet "action"

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionStep: emitted packet と唯一の継続 owner
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedActionStep:
    packet %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner

//: gui_font_registered_face_simple_glyph_indexed_action_step_value: packet と継続 owner を束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_step_value %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner GuiFontRegisteredFaceSimpleGlyphIndexedActionStep \packet\owner:
    GuiFontRegisteredFaceSimpleGlyphIndexedActionStep packet owner

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind: action traversal failure の分類
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind:
    PathStepFailed
    AlreadyCompleted

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind \kind:
        kind

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionError: lower metadata と回収可能 action owner
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedActionError:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner
    kind %GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind
    path_error_kind %Option GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind
    lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError
    contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError

//: gui_font_registered_face_simple_glyph_indexed_action_error: failure metadata と owner を一体化する
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_error %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind fn Option GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind fn Option GuiSfntSimpleGlyphContourSpanIndexLookupError fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError GuiFontRegisteredFaceSimpleGlyphIndexedActionError \owner\kind\path_error_kind\lookup_error\contour_step_error:
    GuiFontRegisteredFaceSimpleGlyphIndexedActionError owner kind path_error_kind lookup_error contour_step_error

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus: one-action budget の Copy status
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus:
    Emitted %GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket
    Completed
    StepBudgetExhausted

impl Clone for GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus:
    fn clone %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus \status:
        *status

impl Copy for GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus:
    fn copy_mark %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus \status:
        status

//: GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep: 常に一つの owner と Copy status を返す budget 結果
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep:
    owner %GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner
    status %GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus

//: gui_font_registered_face_simple_glyph_indexed_action_budget_step: owner-bearing terminal を作らず budget 結果を束ねる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_simple_glyph_indexed_action_budget_step %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner fn GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStatus GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep \owner\status:
    GuiFontRegisteredFaceSimpleGlyphIndexedActionBudgetStep owner status

//: gui_font_registered_face_simple_glyph_indexed_action_start: registered indexed owner から sealed action owner を開始する
//:
//: [契約/けいやく]: borrowed policy を同じ call で F5nw start に渡し、lower path owner を一度だけ作ります。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_start %fn GuiFontRegisteredFaceSimpleGlyphIndexedOwner fn &GuiSfntSimpleGlyphPathSinkPolicy GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner \indexed\policy:
    let path %GuiFontRegisteredFaceSimpleGlyphIndexedPathOwner gui_font_registered_face_simple_glyph_indexed_path_start indexed policy
    gui_font_registered_face_simple_glyph_indexed_action_owner path GuiFontRegisteredFaceSimpleGlyphIndexedActionState::NeedSinkStep

//: gui_font_registered_face_simple_glyph_indexed_action_step_packet: emitted action packet を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_step_packet %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionStep GuiFontRegisteredFaceSimpleGlyphIndexedActionPacket \step:
    *field::get_ref step "packet"

//: gui_font_registered_face_simple_glyph_indexed_action_step_take_owner: step から唯一の継続 owner を回収する
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_step_take_owner %fn GuiFontRegisteredFaceSimpleGlyphIndexedActionStep GuiFontRegisteredFaceSimpleGlyphIndexedActionOwner \step:
    field::get step "owner"

//: gui_font_registered_face_simple_glyph_indexed_action_step_free: emitted packet と継続 owner を閉じる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_step_free %impure fn GuiFontRegisteredFaceSimpleGlyphIndexedActionStep unit \step:
    gui_font_registered_face_simple_glyph_indexed_action_owner_free field::get step "owner"

//: gui_font_registered_face_simple_glyph_indexed_action_error_kind: outer failure kind を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_error_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionError GuiFontRegisteredFaceSimpleGlyphIndexedActionErrorKind \error:
    *field::get_ref error "kind"

//: gui_font_registered_face_simple_glyph_indexed_action_error_path_error_kind: lower path failure kind を読む
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_simple_glyph_indexed_action_error_path_error_kind %fn &GuiFontRegisteredFaceSimpleGlyphIndexedActionError Option GuiFontRegisteredFaceSimpleGlyphIndexedPathErrorKind \error:
    *field::get_ref error "path_error_kind"

//: gui_font_registered_face_simple_glyph_indexed_action_error_lookup_error: lower span lookup metadata を読む
//:
