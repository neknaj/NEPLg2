//: # alloc/gui/font/registered_face_table
//: registered face owner を metadata table membership へ[上/あ]げる境界
//:
//: ### [目的/もくてき]
//: - `GuiFontRegisteredFace` を[消費/しょうひ]し、lookup 用の Copy metadata record だけを table に[登録/とうろく]します。
//: - 実際の `GuiFontResourceBytes` owner は registered face owner 側に[残/のこ]し、table だけが dangling id を[持/も]つ状態を[防/ふせ]ぎます。
//:
//: ### [契約/けいやく]
//: - table は `GuiFontRegisteredFaceRecord` の `Vec` だけを[持/も]ちます。
//: - success は table と registered face entry owner を同時に[返/かえ]します。
//: - duplicate / push failure では table と rejected face owner を error に[保持/ほじ]します。
//: - layout、glyph lookup、rasterization、render2d、platform font API、browser `FontFace`、Canvas へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/registered_face_table" as *
//: ```

#indent 4

#import "alloc/collections/vec" as vec
#import "alloc/gui/font/registered_face" as *
#import "alloc/gui/font/resource" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiFontRegisteredFaceRecord: table に[保持/ほじ]する Copy metadata
//:
//: bytes owner や platform handle は[含/ふく]めず、lookup と後続 boundary の検証に[必要/ひつよう]な typed metadata だけを[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceRecord:
    resource_id %GuiFontResourceId
    face_id %GuiFontFaceId
    selected_face_index %i32
    face_count %i32
    units_per_em %i32
    glyph_count %i32
    byte_len %i32
    actual_hash %GuiResourceHash
    source %GuiFontResourceSource
    decode_policy %GuiFontDecodePolicy

impl Clone for GuiFontRegisteredFaceRecord:
    fn clone %fn &GuiFontRegisteredFaceRecord GuiFontRegisteredFaceRecord \record:
        *record

impl Copy for GuiFontRegisteredFaceRecord:
    fn copy_mark %fn GuiFontRegisteredFaceRecord GuiFontRegisteredFaceRecord \record:
        record

//: GuiFontRegisteredFaceTable: registered face metadata table owner
//:
//: `Vec` を[所有/しょゆう]するため、この型は Copy / Clone にしません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTable:
    records %Vec GuiFontRegisteredFaceRecord

//: GuiFontRegisteredFaceTableEntry: table 登録済み face owner
//:
//: registered face owner と同じ record を[保持/ほじ]し、table record だけが dangling reference になることを[防/ふせ]ぎます。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTableEntry:
    face %GuiFontRegisteredFace
    record %GuiFontRegisteredFaceRecord

//: GuiFontRegisteredFaceTableEntryValidationErrorKind: entry 再検査の[失敗/しっぱい][分類/ぶんるい]
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceTableEntryValidationErrorKind:
    InvalidFaceProjection
    RecordMismatch

impl Clone for GuiFontRegisteredFaceTableEntryValidationErrorKind:
    fn clone %fn &GuiFontRegisteredFaceTableEntryValidationErrorKind GuiFontRegisteredFaceTableEntryValidationErrorKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceTableEntryValidationErrorKind:
    fn copy_mark %fn GuiFontRegisteredFaceTableEntryValidationErrorKind GuiFontRegisteredFaceTableEntryValidationErrorKind \kind:
        kind

//: GuiFontRegisteredFaceTableEntryValidationError: entry owner を消費しない Copy validation evidence
//:
//: [目的/もくてき]:
//: - invalid face projection と保存 record の mismatch を区別し、後続 lookup が同じ table authority を共有できるようにします。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTableEntryValidationError:
    kind %GuiFontRegisteredFaceTableEntryValidationErrorKind
    record %GuiFontRegisteredFaceRecord
    table_error %Option GuiFontRegisteredFaceTableRegisterErrorKind

impl Clone for GuiFontRegisteredFaceTableEntryValidationError:
    fn clone %fn &GuiFontRegisteredFaceTableEntryValidationError GuiFontRegisteredFaceTableEntryValidationError \error:
        *error

impl Copy for GuiFontRegisteredFaceTableEntryValidationError:
    fn copy_mark %fn GuiFontRegisteredFaceTableEntryValidationError GuiFontRegisteredFaceTableEntryValidationError \error:
        error

//: GuiFontRegisteredFaceTableRegistration: table と entry の同時 owner
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTableRegistration:
    table %GuiFontRegisteredFaceTable
    entry %GuiFontRegisteredFaceTableEntry

//: GuiFontRegisteredFaceTableRegisterErrorKind: table 登録の[失敗/しっぱい][分類/ぶんるい]
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceTableRegisterErrorKind:
    InvalidResourceId
    InvalidFaceId
    UnsupportedDecodePolicy
    ByteLenInvalid
    SelectedFaceIndexMismatch
    SelectedFaceIndexOutOfRange
    FaceCountInvalid
    UnitsPerEmInvalid
    GlyphCountInvalid
    DuplicateResourceId
    DuplicateFaceId
    TablePushFailed

impl Clone for GuiFontRegisteredFaceTableRegisterErrorKind:
    fn clone %fn &GuiFontRegisteredFaceTableRegisterErrorKind GuiFontRegisteredFaceTableRegisterErrorKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceTableRegisterErrorKind:
    fn copy_mark %fn GuiFontRegisteredFaceTableRegisterErrorKind GuiFontRegisteredFaceTableRegisterErrorKind \kind:
        kind

//: GuiFontRegisteredFaceTableRegisterError: 登録失敗時に table と face owner を[返/かえ]す error
//:
//: `table` と `face` を[所有/しょゆう]するため、この型は Copy / Clone にしません。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTableRegisterError:
    kind %GuiFontRegisteredFaceTableRegisterErrorKind
    table %GuiFontRegisteredFaceTable
    face %GuiFontRegisteredFace
    storage_error %Option StdErrorKind

//: GuiFontRegisteredFaceTableRegisterRejected: rejected callback 用 owner pair
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceTableRegisterRejected:
    table %GuiFontRegisteredFaceTable
    face %GuiFontRegisteredFace

//: gui_font_registered_face_table_owner: records Vec を table owner に[包/つつ]む
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_owner %fn Vec GuiFontRegisteredFaceRecord GuiFontRegisteredFaceTable \records:
    GuiFontRegisteredFaceTable records

//: gui_font_registered_face_table_entry: face owner と record を entry に[包/つつ]む
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_entry %fn GuiFontRegisteredFace fn GuiFontRegisteredFaceRecord GuiFontRegisteredFaceTableEntry \face\record:
    GuiFontRegisteredFaceTableEntry face record

//: gui_font_registered_face_table_registration: table と entry を同時 owner に[包/つつ]む
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_registration %fn GuiFontRegisteredFaceTable fn GuiFontRegisteredFaceTableEntry GuiFontRegisteredFaceTableRegistration \table\entry:
    GuiFontRegisteredFaceTableRegistration table entry

//: gui_font_registered_face_table_register_error: owner 回収付き登録 error を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_register_error %fn GuiFontRegisteredFaceTableRegisterErrorKind fn GuiFontRegisteredFaceTable fn GuiFontRegisteredFace fn Option StdErrorKind GuiFontRegisteredFaceTableRegisterError \kind\table\face\storage_error:
    GuiFontRegisteredFaceTableRegisterError kind table face storage_error

//: gui_font_registered_face_table_register_error_simple: storage error なしの登録 error を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_register_error_simple %fn GuiFontRegisteredFaceTableRegisterErrorKind fn GuiFontRegisteredFaceTable fn GuiFontRegisteredFace GuiFontRegisteredFaceTableRegisterError \kind\table\face:
    gui_font_registered_face_table_register_error kind table face none

//: gui_font_registered_face_table_register_error_push_failed: Vec push failure を table 登録 error に[写/うつ]す
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_register_error_push_failed %fn GuiFontRegisteredFaceTable fn GuiFontRegisteredFace fn StdErrorKind GuiFontRegisteredFaceTableRegisterError \table\face\storage_error_value:
    gui_font_registered_face_table_register_error GuiFontRegisteredFaceTableRegisterErrorKind::TablePushFailed table face some storage_error_value

//: gui_font_registered_face_table_record: metadata record を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_record %fn GuiFontResourceId fn GuiFontFaceId fn i32 fn i32 fn i32 fn i32 fn i32 fn GuiResourceHash fn GuiFontResourceSource fn GuiFontDecodePolicy GuiFontRegisteredFaceRecord \resource_id\face_id\selected_face_index\face_count\units_per_em\glyph_count\byte_len\actual_hash\source\decode_policy:
    GuiFontRegisteredFaceRecord resource_id face_id selected_face_index face_count units_per_em glyph_count byte_len actual_hash source decode_policy

