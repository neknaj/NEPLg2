fn gui_font_registered_face_table_entry_validation_error %fn GuiFontRegisteredFaceTableEntryValidationErrorKind fn GuiFontRegisteredFaceRecord fn Option GuiFontRegisteredFaceTableRegisterErrorKind GuiFontRegisteredFaceTableEntryValidationError \kind\record\table_error:
    GuiFontRegisteredFaceTableEntryValidationError kind record table_error

//: gui_font_registered_face_table_decode_policy_supported: table 登録済み face として[扱/あつか]える decode policy か[返/かえ]す
//:
//: neplg2:test[skip]
fn gui_font_registered_face_table_decode_policy_supported %fn GuiFontDecodePolicy bool \policy:
    match policy:
        GuiFontDecodePolicy::SfntOnly:
            true
        GuiFontDecodePolicy::SfntAndWoff:
            false
        GuiFontDecodePolicy::AllSupportedContainers:
            false

