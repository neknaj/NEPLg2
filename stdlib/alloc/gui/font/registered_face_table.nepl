//: gui_font_registered_face_record_eq: registered face record の全 field を[比/くら]べる
//:
//: [目的/もくてき]:
//: - table membership の equality authority を一か所に置き、glyph / metric / outline lookup ごとの比較漏れを防ぎます。
//:
//: [計算量/けいさんりょう]: O(1)
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_record_eq %fn &GuiFontRegisteredFaceRecord fn &GuiFontRegisteredFaceRecord bool \left\right:
    let left_hash %GuiResourceHash gui_font_registered_face_record_actual_hash left
    let right_hash %GuiResourceHash gui_font_registered_face_record_actual_hash right
    let left_source %GuiFontResourceSource gui_font_registered_face_record_source left
    let right_source %GuiFontResourceSource gui_font_registered_face_record_source right
    let left_policy %GuiFontDecodePolicy gui_font_registered_face_record_decode_policy left
    let right_policy %GuiFontDecodePolicy gui_font_registered_face_record_decode_policy right
    and eq gui_font_registered_face_record_resource_raw left gui_font_registered_face_record_resource_raw right and eq gui_font_registered_face_record_face_raw left gui_font_registered_face_record_face_raw right and eq gui_font_registered_face_record_selected_face_index left gui_font_registered_face_record_selected_face_index right and eq gui_font_registered_face_record_face_count left gui_font_registered_face_record_face_count right and eq gui_font_registered_face_record_units_per_em left gui_font_registered_face_record_units_per_em right and eq gui_font_registered_face_record_glyph_count left gui_font_registered_face_record_glyph_count right and eq gui_font_registered_face_record_byte_len left gui_font_registered_face_record_byte_len right and eq gui_resource_hash_raw &left_hash gui_resource_hash_raw &right_hash and gui_font_registered_face_record_source_eq left_source right_source gui_font_registered_face_record_decode_policy_eq left_policy right_policy

