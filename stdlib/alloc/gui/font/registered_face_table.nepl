//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_new %fn i32 Result GuiFontRegisteredFaceTable StdErrorKind \capacity:
    let records_result %Result Vec GuiFontRegisteredFaceRecord StdErrorKind vec::with_capacity capacity
