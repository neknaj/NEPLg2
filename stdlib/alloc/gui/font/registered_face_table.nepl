pub fn gui_font_registered_face_table_entry_validation_error_kind_eq %fn GuiFontRegisteredFaceTableEntryValidationErrorKind fn GuiFontRegisteredFaceTableEntryValidationErrorKind bool \a\b:
    match a:
        GuiFontRegisteredFaceTableEntryValidationErrorKind::InvalidFaceProjection:
