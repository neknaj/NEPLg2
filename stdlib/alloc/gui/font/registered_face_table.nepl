pub fn gui_font_registered_face_table_registration_free %impure fn GuiFontRegisteredFaceTableRegistration unit \registration:
    let table %GuiFontRegisteredFaceTable field::get registration "table"
    let entry %GuiFontRegisteredFaceTableEntry field::get registration "entry"
    gui_font_registered_face_table_free table
    gui_font_registered_face_table_entry_free entry

