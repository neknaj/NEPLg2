//: gui_font_registered_face_table_contains_resource_id: resource id が table に[登録/とうろく]済みか linear scan で[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_contains_resource_id %fn &GuiFontRegisteredFaceTable fn GuiFontResourceId bool \table\resource_id:
    let records %&Vec GuiFontRegisteredFaceRecord field::get_ref table "records"
    let record_count %i32 vec::len records
    let mut index %i32 0
    let mut found %bool false
    let mut done %bool false
    while not done:
        do:
            if ge index record_count:
                then:
                    set done true
                else:
                    match vec::get records index:
                        Option::Some record:
                            let record_resource_id %GuiFontResourceId gui_font_registered_face_record_resource_id &record
                            if gui_font_registered_face_resource_id_eq record_resource_id resource_id:
                                then:
                                    set found true
                                    set done true
                                else:
                                    set index add index 1
                        Option::None:
                            set done true
    found

//: gui_font_registered_face_table_contains_face_id: face id が table に[登録/とうろく]済みか linear scan で[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_contains_face_id %fn &GuiFontRegisteredFaceTable fn GuiFontFaceId bool \table\face_id:
    let records %&Vec GuiFontRegisteredFaceRecord field::get_ref table "records"
    let record_count %i32 vec::len records
    let mut index %i32 0
    let mut found %bool false
    let mut done %bool false
    while not done:
        do:
            if ge index record_count:
                then:
                    set done true
                else:
                    match vec::get records index:
                        Option::Some record:
                            let record_face_id %GuiFontFaceId gui_font_registered_face_record_face_id &record
                            if gui_font_registered_face_face_id_eq record_face_id face_id:
                                then:
                                    set found true
                                    set done true
                                else:
                                    set index add index 1
                        Option::None:
                            set done true
    found

//: gui_font_registered_face_table_lookup_resource_id: resource id に対応する metadata record を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_lookup_resource_id %fn &GuiFontRegisteredFaceTable fn GuiFontResourceId Option GuiFontRegisteredFaceRecord \table\resource_id:
    let records %&Vec GuiFontRegisteredFaceRecord field::get_ref table "records"
    let record_count %i32 vec::len records
    let mut index %i32 0
    let mut output %Option GuiFontRegisteredFaceRecord none
    let mut done %bool false
    while not done:
        do:
            if ge index record_count:
                then:
                    set done true
                else:
                    match vec::get records index:
                        Option::Some record:
                            let record_resource_id %GuiFontResourceId gui_font_registered_face_record_resource_id &record
                            if gui_font_registered_face_resource_id_eq record_resource_id resource_id:
                                then:
                                    set output some record
                                    set done true
                                else:
                                    set index add index 1
                        Option::None:
                            set done true
    output

//: gui_font_registered_face_table_lookup_face_id: face id に対応する metadata record を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_lookup_face_id %fn &GuiFontRegisteredFaceTable fn GuiFontFaceId Option GuiFontRegisteredFaceRecord \table\face_id:
    let records %&Vec GuiFontRegisteredFaceRecord field::get_ref table "records"
    let record_count %i32 vec::len records
    let mut index %i32 0
    let mut output %Option GuiFontRegisteredFaceRecord none
    let mut done %bool false
    while not done:
        do:
            if ge index record_count:
                then:
                    set done true
                else:
                    match vec::get records index:
                        Option::Some record:
                            let record_face_id %GuiFontFaceId gui_font_registered_face_record_face_id &record
                            if gui_font_registered_face_face_id_eq record_face_id face_id:
                                then:
                                    set output some record
                                    set done true
                                else:
                                    set index add index 1
                        Option::None:
                            set done true
    output

//: gui_font_registered_face_table_record_from_face: registered face owner を再検証して table record を[作/つく]る
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_record_from_face %fn &GuiFontRegisteredFace Result GuiFontRegisteredFaceRecord GuiFontRegisteredFaceTableRegisterErrorKind \face:
    let resource_id %GuiFontResourceId gui_font_registered_face_resource_id face
    let resource_raw %i32 gui_font_resource_id_raw &resource_id
    if le resource_raw 0:
        then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::InvalidResourceId
        else:
            let face_id %GuiFontFaceId gui_font_registered_face_face_id face
            let face_raw %i32 gui_font_face_id_raw &face_id
            if le face_raw 0:
                then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::InvalidFaceId
                else:
                    let resource %&GuiFontResourceBytes gui_font_registered_face_resource_ref face
                    let decode_policy %GuiFontDecodePolicy gui_font_resource_bytes_decode_policy resource
                    if not gui_font_registered_face_table_decode_policy_supported decode_policy:
                        then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::UnsupportedDecodePolicy
                        else:
                            let byte_len %i32 gui_font_resource_bytes_len resource
                            if le byte_len 0:
                                then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::ByteLenInvalid
                                else:
                                    let selected_face_index %i32 gui_font_registered_face_selected_face_index face
                                    let metadata %GuiSfntMetadata gui_font_registered_face_metadata face
                                    let metadata_face_index %i32 gui_sfnt_metadata_face_index &metadata
                                    if ne selected_face_index metadata_face_index:
                                        then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::SelectedFaceIndexMismatch
                                        else:
                                            let face_count %i32 gui_sfnt_metadata_face_count &metadata
                                            if le face_count 0:
                                                then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::FaceCountInvalid
                                                else:
                                                    if or lt selected_face_index 0 ge selected_face_index face_count:
                                                        then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::SelectedFaceIndexOutOfRange
                                                        else:
                                                            let metrics %GuiSfntMetrics gui_sfnt_metadata_metrics &metadata
                                                            let units_per_em %i32 gui_sfnt_metrics_units_per_em &metrics
                                                            if le units_per_em 0:
                                                                then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::UnitsPerEmInvalid
                                                                else:
                                                                    let glyph_count %i32 gui_sfnt_metrics_num_glyphs &metrics
                                                                    if lt glyph_count 0:
                                                                        then Result::Err GuiFontRegisteredFaceTableRegisterErrorKind::GlyphCountInvalid
                                                                        else:
                                                                            let actual_hash %GuiResourceHash gui_font_resource_bytes_actual_hash resource
                                                                            let source %GuiFontResourceSource gui_font_resource_bytes_source resource
                                                                            Result::Ok gui_font_registered_face_table_record resource_id face_id selected_face_index face_count units_per_em glyph_count byte_len actual_hash source decode_policy

//: gui_font_registered_face_table_register: face owner を metadata table に[登録/とうろく]する
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_register %impure fn GuiFontRegisteredFaceTable impure fn GuiFontRegisteredFace Result GuiFontRegisteredFaceTableRegistration GuiFontRegisteredFaceTableRegisterError \table\face:
    match gui_font_registered_face_table_record_from_face &face:
        Result::Err kind:
            Result::Err gui_font_registered_face_table_register_error_simple kind table face
        Result::Ok record:
            let resource_id %GuiFontResourceId gui_font_registered_face_record_resource_id &record
            if gui_font_registered_face_table_contains_resource_id &table resource_id:
                then Result::Err gui_font_registered_face_table_register_error_simple GuiFontRegisteredFaceTableRegisterErrorKind::DuplicateResourceId table face
                else:
                    let face_id %GuiFontFaceId gui_font_registered_face_record_face_id &record
                    if gui_font_registered_face_table_contains_face_id &table face_id:
                        then Result::Err gui_font_registered_face_table_register_error_simple GuiFontRegisteredFaceTableRegisterErrorKind::DuplicateFaceId table face
                        else:
                            let records %Vec GuiFontRegisteredFaceRecord field::get table "records"
                            match vec::push records record:
                                Result::Ok next_records:
                                    let next_table %GuiFontRegisteredFaceTable gui_font_registered_face_table_owner next_records
                                    let entry %GuiFontRegisteredFaceTableEntry gui_font_registered_face_table_entry face record
                                    Result::Ok gui_font_registered_face_table_registration next_table entry
                                Result::Err push_error:
                                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &push_error
                                    let returned_records %Vec GuiFontRegisteredFaceRecord vec::vec_push_error_vec push_error
                                    let returned_table %GuiFontRegisteredFaceTable gui_font_registered_face_table_owner returned_records
                                    Result::Err gui_font_registered_face_table_register_error_push_failed returned_table face storage_error_value

//: gui_font_registered_face_table_entry_record: entry の metadata record を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_entry_record %fn &GuiFontRegisteredFaceTableEntry GuiFontRegisteredFaceRecord \entry:
    *field::get_ref entry "record"

//: gui_font_registered_face_table_entry_face_ref: entry が[保持/ほじ]する registered face owner を[借/か]りる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_entry_face_ref %fn &GuiFontRegisteredFaceTableEntry &GuiFontRegisteredFace \entry:
    field::get_ref entry "face"

//: gui_font_registered_face_table_entry_validate: entry record と face owner 由来 record を再検査する
//:
//: [契約/けいやく]:
//: - entry は借用し、owner を消費しません。
//: - success は face owner から再導出した canonical record です。
//: - 比較対象は `GuiFontRegisteredFaceRecord` の全 field です。
//:
//: [計算量/けいさんりょう]: O(1)
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_entry_validate %fn &GuiFontRegisteredFaceTableEntry Result GuiFontRegisteredFaceRecord GuiFontRegisteredFaceTableEntryValidationError \entry:
    let record %GuiFontRegisteredFaceRecord gui_font_registered_face_table_entry_record entry
    let face_ref %&GuiFontRegisteredFace gui_font_registered_face_table_entry_face_ref entry
    match gui_font_registered_face_table_record_from_face face_ref:
        Result::Err table_error:
            Result::Err gui_font_registered_face_table_entry_validation_error GuiFontRegisteredFaceTableEntryValidationErrorKind::InvalidFaceProjection record some table_error
        Result::Ok derived_record:
            if:
                gui_font_registered_face_record_eq &record &derived_record
                then:
                    Result::Ok derived_record
                else:
                    Result::Err gui_font_registered_face_table_entry_validation_error GuiFontRegisteredFaceTableEntryValidationErrorKind::RecordMismatch record none

//: gui_font_registered_face_table_entry_finish_face: entry から registered face owner を[取/と]り[出/だ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_entry_finish_face %fn GuiFontRegisteredFaceTableEntry GuiFontRegisteredFace \entry:
    field::get entry "face"

//: gui_font_registered_face_table_entry_free: entry が[保持/ほじ]する face owner を[閉/と]じる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_entry_free %fn GuiFontRegisteredFaceTableEntry unit \entry:
    gui_font_registered_face_free gui_font_registered_face_table_entry_finish_face entry

//: gui_font_registered_face_table_registration_record: registration 内の entry record を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_registration_record %fn &GuiFontRegisteredFaceTableRegistration GuiFontRegisteredFaceRecord \registration:
    let entry %&GuiFontRegisteredFaceTableEntry field::get_ref registration "entry"
    gui_font_registered_face_table_entry_record entry

//: gui_font_registered_face_table_registration_with: table と entry を callback へ同時に[渡/わた]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_table_registration_with <.R> %impure fn GuiFontRegisteredFaceTableRegistration impure fn impure fn GuiFontRegisteredFaceTable impure fn GuiFontRegisteredFaceTableEntry .R .R \registration\callback:
    let table %GuiFontRegisteredFaceTable field::get registration "table"
    let entry %GuiFontRegisteredFaceTableEntry field::get registration "entry"
    callback table entry

//: gui_font_registered_face_table_registration_free: table と entry owner を[閉/と]じる
