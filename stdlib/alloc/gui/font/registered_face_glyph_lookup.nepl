//: # alloc/gui/font/registered_face_glyph_lookup
//: registered face table entry から glyph id を[解決/かいけつ]する境界
//:
//: ### [目的/もくてき]
//: - table 登録済み face owner を authority として、SFNT `cmap` から 1 code point の glyph id を[引/ひ]きます。
//: - glyph mapping は Copy evidence として[返/かえ]し、bytes owner は caller が[保持/ほじ]する entry 側に[残/のこ]します。
//:
//: ### [契約/けいやく]
//: - `GuiFontRegisteredFaceTableEntry` は[借用/しゃくよう]し、消費しません。
//: - lookup 前に entry record と face owner から再導出した record を[照合/しょうごう]し、record だけを glyph lookup authority にしません。
//: - `GuiFontRegisteredFaceRecord` の selected face index を lookup の face selection authority とし、resource request や display name を再 authority にしません。
//: - text shaping、layout、hmtx / glyf lookup、rasterization、render2d、platform font API、browser `FontFace`、Canvas へは[進/すす]みません。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/registered_face_glyph_lookup" as *
//: ```

#indent 4

#import "alloc/gui/font/registered_face" as *
#import "alloc/gui/font/registered_face_table" as *
#import "alloc/gui/font/resource" as *
#import "alloc/gui/font/sfnt" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiFontRegisteredFaceGlyphMapping: table record と code point と glyph id の Copy evidence
//:
//: bytes owner は[含/ふく]めず、どの table membership から得た mapping かを Copy metadata として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceGlyphMapping:
    record %GuiFontRegisteredFaceRecord
    code_point %i32
    glyph %GuiGlyphId

impl Clone for GuiFontRegisteredFaceGlyphMapping:
    fn clone %fn &GuiFontRegisteredFaceGlyphMapping GuiFontRegisteredFaceGlyphMapping \mapping:
        *mapping

impl Copy for GuiFontRegisteredFaceGlyphMapping:
    fn copy_mark %fn GuiFontRegisteredFaceGlyphMapping GuiFontRegisteredFaceGlyphMapping \mapping:
        mapping

//: GuiFontRegisteredFaceGlyphLookupErrorKind: glyph lookup 境界の[失敗/しっぱい][分類/ぶんるい]
//:
//: neplg2:test[skip]
pub enum GuiFontRegisteredFaceGlyphLookupErrorKind:
    TableRecordInvalid
    TableRecordMismatch
    MalformedFontResource
    UnsupportedFontContainer
    MissingRequiredTable
    InvalidFaceIndex
    FaceIndexRequired
    UnsupportedFontFeature
    MissingFontData
    MissingGlyphMapping

impl Clone for GuiFontRegisteredFaceGlyphLookupErrorKind:
    fn clone %fn &GuiFontRegisteredFaceGlyphLookupErrorKind GuiFontRegisteredFaceGlyphLookupErrorKind \kind:
        *kind

impl Copy for GuiFontRegisteredFaceGlyphLookupErrorKind:
    fn copy_mark %fn GuiFontRegisteredFaceGlyphLookupErrorKind GuiFontRegisteredFaceGlyphLookupErrorKind \kind:
        kind

//: GuiFontRegisteredFaceGlyphLookupError: lookup 失敗時の Copy evidence error
//:
//: entry owner は[保持/ほじ]せず、失敗した record、code point、lower parser / table validation error を Copy evidence として[返/かえ]します。
//:
//: neplg2:test[skip]
pub struct GuiFontRegisteredFaceGlyphLookupError:
    kind %GuiFontRegisteredFaceGlyphLookupErrorKind
    record %GuiFontRegisteredFaceRecord
    parse_error %Option GuiSfntParseError
    validation_error %Option GuiFontRegisteredFaceTableEntryValidationError
    code_point %i32

impl Clone for GuiFontRegisteredFaceGlyphLookupError:
    fn clone %fn &GuiFontRegisteredFaceGlyphLookupError GuiFontRegisteredFaceGlyphLookupError \error:
        *error

impl Copy for GuiFontRegisteredFaceGlyphLookupError:
    fn copy_mark %fn GuiFontRegisteredFaceGlyphLookupError GuiFontRegisteredFaceGlyphLookupError \error:
        error

//: gui_font_registered_face_glyph_mapping: Copy mapping evidence を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_mapping %fn GuiFontRegisteredFaceRecord fn i32 fn GuiGlyphId GuiFontRegisteredFaceGlyphMapping \record\code_point\glyph:
    GuiFontRegisteredFaceGlyphMapping record code_point glyph

//: gui_font_registered_face_glyph_lookup_error: Copy evidence error を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_lookup_error %fn GuiFontRegisteredFaceGlyphLookupErrorKind fn GuiFontRegisteredFaceRecord fn Option GuiSfntParseError fn Option GuiFontRegisteredFaceTableEntryValidationError fn i32 GuiFontRegisteredFaceGlyphLookupError \kind\record\parse_error\validation_error\code_point:
    GuiFontRegisteredFaceGlyphLookupError kind record parse_error validation_error code_point

//: gui_font_registered_face_glyph_lookup_error_from_parse: SFNT parse error を lookup error に[写/うつ]す
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_lookup_error_from_parse %fn GuiFontRegisteredFaceRecord fn i32 fn GuiSfntParseError GuiFontRegisteredFaceGlyphLookupError \record\code_point\parse_error:
    let kind %GuiFontRegisteredFaceGlyphLookupErrorKind gui_font_registered_face_glyph_lookup_error_kind_from_sfnt_parse &parse_error
    gui_font_registered_face_glyph_lookup_error kind record some parse_error none code_point

//: gui_font_registered_face_glyph_lookup_error_from_validation: table entry validation error を lookup error に[写/うつ]す
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_lookup_error_from_validation %fn i32 fn GuiFontRegisteredFaceTableEntryValidationError GuiFontRegisteredFaceGlyphLookupError \code_point\validation_error:
    let record %GuiFontRegisteredFaceRecord gui_font_registered_face_table_entry_validation_error_record &validation_error
    let kind %GuiFontRegisteredFaceGlyphLookupErrorKind match gui_font_registered_face_table_entry_validation_error_kind &validation_error:
        GuiFontRegisteredFaceTableEntryValidationErrorKind::InvalidFaceProjection:
            GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordInvalid
        GuiFontRegisteredFaceTableEntryValidationErrorKind::RecordMismatch:
            GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordMismatch
    gui_font_registered_face_glyph_lookup_error kind record none some validation_error code_point

//: gui_font_registered_face_glyph_lookup_error_kind_from_sfnt_parse: parser error を public lookup kind へ[分類/ぶんるい]する
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_lookup_error_kind_from_sfnt_parse %fn &GuiSfntParseError GuiFontRegisteredFaceGlyphLookupErrorKind \parse_error:
    match gui_sfnt_parse_error_kind parse_error:
        GuiSfntParseErrorKind::UnexpectedEof:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::UnsupportedContainer:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontContainer
        GuiSfntParseErrorKind::InvalidTableDirectory:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::InvalidTableOffset:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::MissingTable:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MissingRequiredTable
        GuiSfntParseErrorKind::InvalidFaceIndex:
            GuiFontRegisteredFaceGlyphLookupErrorKind::InvalidFaceIndex
        GuiSfntParseErrorKind::FaceIndexRequired:
            GuiFontRegisteredFaceGlyphLookupErrorKind::FaceIndexRequired
        GuiSfntParseErrorKind::UnsupportedNameTableFormat:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::MalformedNameRecord:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::UnsupportedNameEncoding:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::UnsupportedNameCharacter:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::UnsupportedCmapEncoding:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::UnsupportedCmapTableFormat:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::MalformedCmapRecord:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::MissingGlyphMapping:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MissingGlyphMapping
        GuiSfntParseErrorKind::MalformedHmtxRecord:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::MissingGlyphMetric:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MissingFontData
        GuiSfntParseErrorKind::UnsupportedLocaFormat:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature
        GuiSfntParseErrorKind::MalformedGlyfRecord:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource
        GuiSfntParseErrorKind::MissingGlyphOutline:
            GuiFontRegisteredFaceGlyphLookupErrorKind::MissingFontData
        GuiSfntParseErrorKind::UnsupportedGlyphOutlineFormat:
            GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature

//: gui_font_registered_face_glyph_lookup_error_kind_eq: lookup error kind を[比/くら]べる
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_glyph_lookup_error_kind_eq %fn GuiFontRegisteredFaceGlyphLookupErrorKind fn GuiFontRegisteredFaceGlyphLookupErrorKind bool \a\b:
    match a:
        GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordInvalid:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordInvalid:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordMismatch:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::TableRecordMismatch:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::MalformedFontResource:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontContainer:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontContainer:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::MissingRequiredTable:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::MissingRequiredTable:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::InvalidFaceIndex:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::InvalidFaceIndex:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::FaceIndexRequired:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::FaceIndexRequired:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::UnsupportedFontFeature:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::MissingFontData:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::MissingFontData:
                    true
                _:
                    false
        GuiFontRegisteredFaceGlyphLookupErrorKind::MissingGlyphMapping:
            match b:
                GuiFontRegisteredFaceGlyphLookupErrorKind::MissingGlyphMapping:
                    true
                _:
                    false

