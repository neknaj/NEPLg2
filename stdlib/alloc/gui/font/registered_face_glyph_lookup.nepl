//: gui_font_registered_face_glyph_lookup_error_code_point: 失敗した code point を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_glyph_lookup_error_code_point %fn &GuiFontRegisteredFaceGlyphLookupError i32 \error:
    *field::get_ref error "code_point"

//: gui_font_registered_face_glyph_lookup: table entry から code point の glyph id を[引/ひ]く
//:
//: [契約/けいやく]:
//: - lookup は `GuiFontRegisteredFaceTableEntry` を[借用/しゃくよう]し、owner を[閉/と]じません。
//: - lookup 前に entry record と face owner 由来 record の一致を[検査/けんさ]します。
//: - 成功時は glyph mapping だけを返し、entry owner は caller が[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub fn gui_font_registered_face_glyph_lookup %fn &GuiFontRegisteredFaceTableEntry fn i32 Result GuiFontRegisteredFaceGlyphMapping GuiFontRegisteredFaceGlyphLookupError \entry\code_point:
    match gui_font_registered_face_table_entry_validate entry:
        Result::Err validation_error:
            Result::Err gui_font_registered_face_glyph_lookup_error_from_validation code_point validation_error
        Result::Ok record:
            let face_ref %&GuiFontRegisteredFace gui_font_registered_face_table_entry_face_ref entry
            let selected_face_index %i32 gui_font_registered_face_record_selected_face_index &record
            let resource_ref %&GuiFontResourceBytes gui_font_registered_face_resource_ref face_ref
            let bytes %&ByteBuf gui_font_resource_bytes_ref resource_ref
            match gui_sfnt_lookup_glyph_id bytes some selected_face_index code_point:
                Result::Err parse_error:
                    Result::Err gui_font_registered_face_glyph_lookup_error_from_parse record code_point parse_error
                Result::Ok glyph:
                    Result::Ok gui_font_registered_face_glyph_mapping record code_point glyph
