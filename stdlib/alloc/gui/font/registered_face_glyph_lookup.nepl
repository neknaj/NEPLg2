            match b:
                GuiFontResourceSource::Vfs:
                    true
                _:
                    false
        GuiFontResourceSource::FileSystem:
            match b:
                GuiFontResourceSource::FileSystem:
                    true
                _:
                    false
        GuiFontResourceSource::EmbeddedBlob:
            match b:
                GuiFontResourceSource::EmbeddedBlob:
                    true
                _:
                    false

//: gui_font_registered_face_glyph_lookup_decode_policy_eq: decode policy を[比/くら]べる
//:
//: neplg2:test[skip]
fn gui_font_registered_face_glyph_lookup_decode_policy_eq %fn GuiFontDecodePolicy fn GuiFontDecodePolicy bool \a\b:
    match a:
        GuiFontDecodePolicy::SfntOnly:
            match b:
                GuiFontDecodePolicy::SfntOnly:
                    true
                _:
                    false
        GuiFontDecodePolicy::SfntAndWoff:
            match b:
                GuiFontDecodePolicy::SfntAndWoff:
