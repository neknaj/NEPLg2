fn gui_sfnt_simple_glyph_outline_storage_push_point_y_commit %impure fn GuiSfntSimpleGlyphOutlineStorage impure fn GuiSfntSimpleGlyphOutlineScalarRegionCursor impure fn GuiSfntSimpleGlyphPointYSlot impure fn i32 Result GuiSfntSimpleGlyphPointYPush GuiSfntSimpleGlyphPointYPushError \storage\cursor\point\y:
    match gui_sfnt_simple_glyph_outline_storage_push_region_scalar storage cursor y:
        Result::Ok pushed:
            let next_cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor gui_sfnt_simple_glyph_outline_region_push_cursor &pushed
            let next_storage %GuiSfntSimpleGlyphOutlineStorage gui_sfnt_simple_glyph_outline_region_push_storage pushed
            let point_y_push %GuiSfntSimpleGlyphPointYPush gui_sfnt_simple_glyph_point_y_push next_storage next_cursor
            Result::Ok point_y_push
        Result::Err region_error:
            let region_error_kind_value %GuiSfntSimpleGlyphOutlineRegionPushErrorKind gui_sfnt_simple_glyph_outline_region_push_error_kind &region_error
            let region_error_kind %Option GuiSfntSimpleGlyphOutlineRegionPushErrorKind some region_error_kind_value
            let push_error_kind %Option StdErrorKind gui_sfnt_simple_glyph_outline_region_push_error_push_error_kind &region_error
            let returned_storage %GuiSfntSimpleGlyphOutlineStorage gui_sfnt_simple_glyph_outline_region_push_error_storage region_error
            let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error returned_storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::RegionPushFailed region_error_kind push_error_kind
            Result::Err error

//: gui_sfnt_simple_glyph_outline_storage_push_point_y: y coordinate を PointY region storage へ[追加/ついか]する
//:
//: [契約/けいやく]:
//: - capacity shape と scalar slot count を[検査/けんさ]してから point_count を[使/つか]います。
//: - cursor/capacity boundary が一致するまで、cursor index を logical point index として[使/つか]いません。
//: - logical point index は `cursor.next_index - cursor.start` であり、scalar storage index そのものではありません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_push_point_y %impure fn GuiSfntSimpleGlyphOutlineStorage impure fn GuiSfntSimpleGlyphOutlineScalarRegionCursor impure fn GuiSfntSimpleGlyphPointYSlot Result GuiSfntSimpleGlyphPointYPush GuiSfntSimpleGlyphPointYPushError \storage\cursor\point:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity &storage
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::StorageCapacityInvalid
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check &capacity:
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits _scalar_slot_count:
                    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                        then:
                            let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::CursorInvalid
                            Result::Err error
                        else:
                            let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor
                            let is_point_y_region %bool match region:
                                GuiSfntSimpleGlyphOutlineScalarRegion::PointY:
                                    true
                                _:
                                    false
                            if not is_point_y_region:
                                then:
                                    let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::CursorRegionMismatch
                                    Result::Err error
                                else:
                                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_matches_valid_capacity &cursor &capacity:
                                        then:
                                            let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::CursorRegionMismatch
                                            Result::Err error
                                        else:
                                            let point_index %i32 gui_sfnt_simple_glyph_point_y_slot_point_index &point
                                            let y %i32 gui_sfnt_simple_glyph_point_y_slot_y &point
                                            let start %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
                                            let next_index %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
                                            let logical_point_index %i32 sub next_index start
                                            if ne point_index logical_point_index:
                                                then:
                                                    let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::PointIndexMismatch
                                                    Result::Err error
                                                else:
                                                    if or lt point_index 0 ge point_index point_count:
                                                        then:
                                                            let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::PointIndexOutOfRange
                                                            Result::Err error
                                                        else:
                                                            gui_sfnt_simple_glyph_outline_storage_push_point_y_commit storage cursor point y
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _overflow_capacity:
                    let error %GuiSfntSimpleGlyphPointYPushError gui_sfnt_simple_glyph_point_y_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointYPushErrorKind::StorageCapacityInvalid
                    Result::Err error

