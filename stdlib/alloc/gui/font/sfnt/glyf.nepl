    let items_cap %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_cap collection
    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_span collection contour_index:
        Result::Err span_error_value:
            let span %Option GuiSfntSimpleGlyphContourSpan none
            let span_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourSpanError some span_error_value
            let read_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError none
            let item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point_error GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointErrorKind::ContourSpanFailed contour_index contour_point_index -1 capacity span span_error read_error item item_count items_len items_cap
            Result::Err error
