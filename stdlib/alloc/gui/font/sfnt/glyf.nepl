//: gui_sfnt_simple_glyph_outline_storage_read_edge_owner: storage から Edge owner marker を[読/よ]む
//:
//: [契約/けいやく]:
//: - storage は borrow し、owner を[消費/しょうひ]しません。
//: - Edge region が required edge slot まで population 済みで、stored contour index が capacity 内にある[場合/ばあい]だけ marker を[返/かえ]します。
//: - byte lookup、curve segment、path/raster/render、platform / host API へは[進/すす]みません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_read_edge_owner %fn &GuiSfntSimpleGlyphOutlineStorage fn i32 Result GuiSfntSimpleGlyphOutlineEdgeOwnerMarker GuiSfntSimpleGlyphOutlineEdgeOwnerReadError \storage\edge_index:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity storage
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::StorageCapacityInvalid edge_index
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check &capacity:
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _overflow_capacity:
                    let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::StorageCapacityInvalid edge_index
                    Result::Err error
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits expected_scalar_slot_count:
                    let scalar_slot_count %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slot_count storage
                    if ne scalar_slot_count expected_scalar_slot_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::ScalarSlotCountMismatch edge_index
                            Result::Err error
                        else:
                            let scalar_slots_cap %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_cap storage
                            if ne scalar_slots_cap scalar_slot_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::ScalarStorageCapacityMismatch edge_index
                                    Result::Err error
                                else:
                                    let edge_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_edge_count &capacity
                                    if or lt edge_index 0 ge edge_index edge_count:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::EdgeIndexOutOfRange edge_index
                                            Result::Err error
                                        else:
                                            let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                                            let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                                            let edge_slot_index %i32 add add contour_count point_count add point_count edge_index
                                            let scalar_slots_len %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_len storage
                                            if le scalar_slots_len edge_slot_index:
                                                then:
                                                    let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::EdgeOwnerNotReady edge_index
                                                    Result::Err error
                                                else:
                                                    match gui_sfnt_simple_glyph_outline_storage_scalar_slot_get storage edge_slot_index:
                                                        Option::None:
                                                            let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::EdgeOwnerSlotMissing edge_index
                                                            Result::Err error
                                                        Option::Some contour_index:
                                                            if or lt contour_index 0 ge contour_index contour_count:
                                                                then:
                                                                    let error %GuiSfntSimpleGlyphOutlineEdgeOwnerReadError gui_sfnt_simple_glyph_outline_edge_owner_read_error_from_storage storage GuiSfntSimpleGlyphOutlineEdgeOwnerReadErrorKind::EdgeOwnerContourOutOfRange edge_index
                                                                    Result::Err error
                                                                else:
                                                                    let glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
                                                                    let marker %GuiSfntSimpleGlyphOutlineEdgeOwnerMarker gui_sfnt_simple_glyph_outline_edge_owner_marker glyph edge_index contour_index
                                                                    Result::Ok marker

