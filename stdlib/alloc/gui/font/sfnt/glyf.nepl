                                                                                                                            let expected_join %GuiStrokeJoin gui_stroke_join &stroke
                                                                                                                            let join_policy %GuiStrokeJoin *field::get_ref owner "join_policy"
                                                                                                                            if not gui_sfnt_simple_glyph_render_stroke_coverage_mask_join_eq expected_join join_policy:
                                                                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeCoverageMaskClosureErrorKind::JoinPolicyMismatch
                                                                                                                                else:
                                                                                                                                    let expected_miter_limit %f32 gui_stroke_miter_limit &stroke
                                                                                                                                    let miter_limit %f32 *field::get_ref owner "miter_limit"
                                                                                                                                    if ne expected_miter_limit miter_limit:
                                                                                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeCoverageMaskClosureErrorKind::MiterLimitMismatch
                                                                                                                                        else Result::Ok unit

//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_start: F5la cell writer owner を開始する
//:
//: [目的/もくてき]:
//: - completed F5lc join geometry owner と shared shape value を authority にし、cell Vec の所有権を段階的に運びます。
//: - written count と cell_count を検査し、未完了と完了を typed Result で分けます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_start %impure fn GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwner impure fn GuiSfntSimpleGlyphRasterCoverageConfig Result GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner GuiSfntSimpleGlyphRenderStrokeCoverageMaskStartError \join_geometry_owner\config:
    match gui_sfnt_simple_glyph_raster_coverage_shape_from_config &config:
        Result::Err shape_error:
            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_start_error_shape_failed join_geometry_owner config shape_error
        Result::Ok shape:
            match gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_invariants_for_stroke_coverage &join_geometry_owner:
                Result::Err join_geometry_error:
                    Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_start_error_join_geometry_failed join_geometry_owner config shape join_geometry_error
                Result::Ok _:
                    let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
                    let cells_result %Result Vec i32 StdErrorKind vec::with_capacity cell_count
                    match cells_result:
                        Result::Err storage_error:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_start_error_storage_failed join_geometry_owner config shape storage_error
                        Result::Ok cells:
                            let cells_len %i32 vec::len &cells
                            if ne cells_len 0:
                                then:
                                    vec::free cells
                                    Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_start_error_storage_shape GuiSfntSimpleGlyphRenderStrokeCoverageMaskStartErrorKind::CellStorageInitialLenMismatch join_geometry_owner config shape
                                else:
                                    let cells_cap %i32 vec::cap &cells
                                    if ne cells_cap cell_count:
                                        then:
                                            vec::free cells
                                            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_start_error_storage_shape GuiSfntSimpleGlyphRenderStrokeCoverageMaskStartErrorKind::CellStorageCapacityMismatch join_geometry_owner config shape
                                        else:
                                            let owner %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner join_geometry_owner shape cells 0
                                            Result::Ok owner

//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_push_cell: coverage cell を writer owner に積む
//:
//: [目的/もくてき]:
//: - completed F5kz owner と shared shape value を authority にし、cell Vec の所有権を段階的に運びます。
//: - written count と cell_count を検査し、未完了と完了を typed Result で分けます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_push_cell %impure fn GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner impure fn i32 Result GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushError \owner\coverage_value:
    let written_cell_count %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_written_cell_count &owner
    let cells_len %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_cells_len &owner
    if ne cells_len written_cell_count:
        then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_simple owner coverage_value GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind::CellStorageLenMismatch
        else:
            let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_shape &owner
            let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
            let cells_cap %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_cells_cap &owner
            if ne cells_cap cell_count:
                then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_simple owner coverage_value GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind::CellStorageCapacityMismatch
                else:
                    if ge written_cell_count cell_count:
                        then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_simple owner coverage_value GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind::MaskFull
                        else:
                            if lt coverage_value 0:
                                then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_simple owner coverage_value GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind::CoverageNegative
                                else:
                                    let coverage_max %i32 gui_sfnt_simple_glyph_raster_coverage_shape_coverage_max &shape
                                    if gt coverage_value coverage_max:
                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_simple owner coverage_value GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind::CoverageExceedsMax
                                        else:
                                            let join_geometry_owner %GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwner field::get owner "join_geometry_owner"
                                            let shape_value %GuiSfntSimpleGlyphRasterCoverageShape field::get owner "shape"
                                            let cells %Vec i32 field::get owner "cells"
                                            match vec::push cells coverage_value:
                                                Result::Ok next_cells:
                                                    let next_written_cell_count %i32 add written_cell_count 1
                                                    let next_owner %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner join_geometry_owner shape_value next_cells next_written_cell_count
                                                    Result::Ok next_owner
                                                Result::Err push_error:
                                                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &push_error
                                                    let returned_cells %Vec i32 vec::vec_push_error_vec push_error
                                                    let returned_owner %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner join_geometry_owner shape_value returned_cells written_cell_count
                                                    Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_storage_failed returned_owner coverage_value storage_error_value

//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_complete: writer owner を completed owner へ進める
//:
//: [目的/もくてき]:
//: - completed F5kz owner と shared shape value を authority にし、cell Vec の所有権を段階的に運びます。
//: - written count と cell_count を検査し、未完了と完了を typed Result で分けます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_complete %fn GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner Result GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionTerminal GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionError \owner:
    let written_cell_count %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_written_cell_count &owner
    let cells_len %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_cells_len &owner
    if ne cells_len written_cell_count:
        then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_completion_error owner GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionErrorKind::CellStorageLenMismatch
        else:
            let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_shape &owner
            let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
            let cells_cap %i32 gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_cells_cap &owner
            if ne cells_cap cell_count:
                then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_mask_completion_error owner GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionErrorKind::CellStorageCapacityMismatch
                else:
                    if eq written_cell_count cell_count:
                        then:
                            let join_geometry_owner %GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwner field::get owner "join_geometry_owner"
                            let shape_value %GuiSfntSimpleGlyphRasterCoverageShape field::get owner "shape"
                            let cells %Vec i32 field::get owner "cells"
                            let completed %GuiSfntSimpleGlyphRenderStrokeCoverageMaskOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_owner join_geometry_owner shape_value cells written_cell_count
                            Result::Ok GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionTerminal::CoverageMaskCompleted completed
                        else Result::Ok GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionTerminal::CoverageMaskIncomplete owner

