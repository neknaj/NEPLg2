//: gui_sfnt_simple_glyph_outline_point_stream_item_kind_from_point: point を stream item kind に[分類/ぶんるい]する
//:
//: [契約/けいやく]:
//: - `end_of_contour` を先に[見/み]て、endpoint は `EndOnCurve` / `EndOffCurve` として[返/かえ]します。
//: - endpoint でない point だけを `OnCurve` / `OffCurve` に[分類/ぶんるい]します。
//: - byte lookup、storage access、drain traversal、path/raster/render/platform API は[使/つか]いません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_point_stream_item_kind_from_point %fn &GuiSfntSimpleGlyphPoint GuiSfntSimpleGlyphOutlinePointStreamItemKind \point:
    let on_curve %bool gui_sfnt_simple_glyph_point_on_curve point
    let end_of_contour %bool gui_sfnt_simple_glyph_point_end_of_contour point
    match end_of_contour:
        true:
            match on_curve:
                true:
                    GuiSfntSimpleGlyphOutlinePointStreamItemKind::EndOnCurve
                false:
                    GuiSfntSimpleGlyphOutlinePointStreamItemKind::EndOffCurve
        false:
            match on_curve:
                true:
                    GuiSfntSimpleGlyphOutlinePointStreamItemKind::OnCurve
                false:
                    GuiSfntSimpleGlyphOutlinePointStreamItemKind::OffCurve

