//: gui_sfnt_simple_glyph_render_stroke_source_contour_line_metric_matches_source_segment: line metric と collection segment 座標が一致するか[返/かえ]す
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_source_contour_line_metric_matches_source_segment %fn &GuiSfntSimpleGlyphRenderStrokeSourceSegmentLineMetric fn &GuiSfntSimpleGlyphLineSegment bool \metric\segment:
    let metric_start_x2 %i32 *field::get_ref metric "start_x2"
    let metric_start_y2 %i32 *field::get_ref metric "start_y2"
    let metric_end_x2 %i32 *field::get_ref metric "end_x2"
    let metric_end_y2 %i32 *field::get_ref metric "end_y2"
    let source_start_x2 %i32 gui_sfnt_simple_glyph_line_segment_start_x2 segment
    let source_start_y2 %i32 gui_sfnt_simple_glyph_line_segment_start_y2 segment
    let source_end_x2 %i32 gui_sfnt_simple_glyph_line_segment_end_x2 segment
    let source_end_y2 %i32 gui_sfnt_simple_glyph_line_segment_end_y2 segment
    let start_x_ok %bool eq metric_start_x2 source_start_x2
    let start_y_ok %bool eq metric_start_y2 source_start_y2
    let end_x_ok %bool eq metric_end_x2 source_end_x2
    let end_y_ok %bool eq metric_end_y2 source_end_y2
    let start_ok %bool and start_x_ok start_y_ok
    let end_ok %bool and end_x_ok end_y_ok
    and start_ok end_ok

