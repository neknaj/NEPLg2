//: - `1..4` だけを現在の storage format として[受/う]け[入/い]れます。
//: - unknown scalar は[代替/だいたい]値へ[変換/へんかん]せず `Option::None` として[返/かえ]し、caller が typed error へ[変換/へんかん]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_command_tag_from_scalar_value %fn i32 Option GuiSfntSimpleGlyphPathCommandTag \value:
    if eq value 1:
        then:
            some GuiSfntSimpleGlyphPathCommandTag::MoveTo
        else:
            if eq value 2:
                then:
                    some GuiSfntSimpleGlyphPathCommandTag::LineTo
                else:
                    if eq value 3:
                        then:
                            some GuiSfntSimpleGlyphPathCommandTag::QuadraticTo
                        else:
                            if eq value 4:
                                then:
                                    some GuiSfntSimpleGlyphPathCommandTag::SkipNoSegment
                                else:
                                    none

