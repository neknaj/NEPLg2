        kind

fn gui_sfnt_simple_glyph_raster_coverage_shape_count_checked_mul %fn i32 fn i32 fn GuiSfntSimpleGlyphRasterCoverageStartErrorKind Result i32 GuiSfntSimpleGlyphRasterCoverageStartErrorKind \left\right\overflow_kind:
    let max_i32 %i32 2147483647
    let max_left %i32 div_s max_i32 right
    if gt left max_left:
        then Result::Err overflow_kind
        else Result::Ok mul left right

fn gui_sfnt_simple_glyph_raster_coverage_shape_from_config %fn &GuiSfntSimpleGlyphRasterCoverageConfig Result GuiSfntSimpleGlyphRasterCoverageShape GuiSfntSimpleGlyphRasterCoverageStartErrorKind \config:
    let width_px %i32 gui_sfnt_simple_glyph_raster_coverage_config_width_px config
    if le width_px 0:
        then Result::Err GuiSfntSimpleGlyphRasterCoverageStartErrorKind::InvalidWidth
        else:
            let height_px %i32 gui_sfnt_simple_glyph_raster_coverage_config_height_px config
            if le height_px 0:
                then Result::Err GuiSfntSimpleGlyphRasterCoverageStartErrorKind::InvalidHeight
                else:
                    let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_config_sample_scale config
                    if le sample_scale 0:
                        then Result::Err GuiSfntSimpleGlyphRasterCoverageStartErrorKind::InvalidSampleScale
                        else:
                            let max_cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_config_max_cell_count config
                            if le max_cell_count 0:
                                then Result::Err GuiSfntSimpleGlyphRasterCoverageStartErrorKind::InvalidMaxCellCount
                                else:
                                    match gui_sfnt_simple_glyph_raster_coverage_shape_count_checked_mul sample_scale sample_scale GuiSfntSimpleGlyphRasterCoverageStartErrorKind::CoverageMaxOverflow:
                                        Result::Err error_kind:
                                            Result::Err error_kind
                                        Result::Ok coverage_max:
                                            match gui_sfnt_simple_glyph_raster_coverage_shape_count_checked_mul width_px height_px GuiSfntSimpleGlyphRasterCoverageStartErrorKind::CellCountOverflow:
                                                Result::Err error_kind:
                                                    Result::Err error_kind
                                                Result::Ok cell_count:
                                                    if gt cell_count max_cell_count:
                                                        then Result::Err GuiSfntSimpleGlyphRasterCoverageStartErrorKind::CellCountLimitExceeded
                                                        else:
                                                            let origin_x2 %i32 gui_sfnt_simple_glyph_raster_coverage_config_origin_x2 config
                                                            let origin_y2 %i32 gui_sfnt_simple_glyph_raster_coverage_config_origin_y2 config
                                                            let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_shape origin_x2 origin_y2 width_px height_px sample_scale coverage_max cell_count
                                                            Result::Ok shape

