    blend %GuiBlendMode
    path_command_count %i32
    move_to_count %i32
    line_to_count %i32
    quadratic_to_count %i32
    skip_no_segment_count %i32
    draw_segment_count %i32
    path_sink_scalar_count %i32
    stroke_width %i32

