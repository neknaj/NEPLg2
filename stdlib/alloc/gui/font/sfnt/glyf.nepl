            let capacity_glyph_raw %i32 gui_glyph_id_raw &capacity_glyph
            let capacity_point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
            let span_glyph %GuiGlyphId gui_sfnt_simple_glyph_contour_span_glyph &span
            let span_glyph_raw %i32 gui_glyph_id_raw &span_glyph
            let span_index %i32 gui_sfnt_simple_glyph_contour_span_index &span
            let span_start_point_index %i32 gui_sfnt_simple_glyph_contour_span_start_point_index &span
            let span_end_point_index %i32 gui_sfnt_simple_glyph_contour_span_end_point_index &span
            let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
            let expected_span_point_count %i32 add sub span_end_point_index span_start_point_index 1
            let span_glyph_ok %bool eq span_glyph_raw capacity_glyph_raw
            let span_index_ok %bool eq span_index contour_index
            let span_start_ok %bool not lt span_start_point_index 0
            let span_end_order_ok %bool not lt span_end_point_index span_start_point_index
            let span_end_capacity_ok %bool lt span_end_point_index capacity_point_count
            let span_point_count_ok %bool eq span_point_count expected_span_point_count
            let span_identity_ok %bool and span_glyph_ok span_index_ok
            let span_range_left_ok %bool and span_start_ok span_end_order_ok
            let span_range_right_ok %bool and span_end_capacity_ok span_point_count_ok
            let span_shape_ok %bool and span_identity_ok and span_range_left_ok span_range_right_ok
            if not span_shape_ok:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point_error_with_span_empty GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointErrorKind::ContourPointInvariantInvalid contour_index contour_point_index -1 capacity span item_count items_len items_cap
                    Result::Err error
                else:
