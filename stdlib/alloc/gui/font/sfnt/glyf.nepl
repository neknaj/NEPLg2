//: gui_sfnt_simple_glyph_outline_point_stream_item_step_from_point_step: F5o step を classified item step に[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - `Point` は `point = Some` かつ `next_cursor = cursor + 1` の[場合/ばあい]だけ `Item` へ進めます。
//: - `End` は `point = None` かつ cursor が進まない[場合/ばあい]だけ `End` へ進めます。
//: - item kind の導出は F5q constructor に委譲し、この helper では分類を再実装しません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_point_stream_item_step_from_point_step %fn &GuiSfntSimpleGlyphOutlinePointReadStep Result GuiSfntSimpleGlyphOutlinePointStreamItemStep GuiSfntSimpleGlyphOutlinePointStreamItemStepError \step:
    let status %GuiSfntSimpleGlyphOutlinePointReadStepStatus gui_sfnt_simple_glyph_outline_point_read_step_status step
    let cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_step_cursor step
    let next_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_step_next_cursor step
    let cursor_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &cursor
    let next_cursor_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &next_cursor
    match status:
        GuiSfntSimpleGlyphOutlinePointReadStepStatus::Point:
            match gui_sfnt_simple_glyph_outline_point_read_step_point step:
                Option::None:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemStepError gui_sfnt_simple_glyph_outline_point_stream_item_step_error GuiSfntSimpleGlyphOutlinePointStreamItemStepErrorKind::PointStepInvariantInvalid *step
                    Result::Err error
                Option::Some point:
                    let expected_next_index %i32 add cursor_index 1
                    if ne next_cursor_index expected_next_index:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemStepError gui_sfnt_simple_glyph_outline_point_stream_item_step_error GuiSfntSimpleGlyphOutlinePointStreamItemStepErrorKind::PointStepInvariantInvalid *step
                            Result::Err error
                        else:
                            let item_value %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item point
                            let item %Option GuiSfntSimpleGlyphOutlinePointStreamItem some item_value
                            let converted %GuiSfntSimpleGlyphOutlinePointStreamItemStep gui_sfnt_simple_glyph_outline_point_stream_item_step GuiSfntSimpleGlyphOutlinePointStreamItemStepStatus::Item cursor next_cursor item
                            Result::Ok converted
        GuiSfntSimpleGlyphOutlinePointReadStepStatus::End:
            match gui_sfnt_simple_glyph_outline_point_read_step_point step:
                Option::Some _point:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemStepError gui_sfnt_simple_glyph_outline_point_stream_item_step_error GuiSfntSimpleGlyphOutlinePointStreamItemStepErrorKind::PointStepInvariantInvalid *step
                    Result::Err error
                Option::None:
                    if ne next_cursor_index cursor_index:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemStepError gui_sfnt_simple_glyph_outline_point_stream_item_step_error GuiSfntSimpleGlyphOutlinePointStreamItemStepErrorKind::PointStepInvariantInvalid *step
                            Result::Err error
                        else:
                            let item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
                            let converted %GuiSfntSimpleGlyphOutlinePointStreamItemStep gui_sfnt_simple_glyph_outline_point_stream_item_step GuiSfntSimpleGlyphOutlinePointStreamItemStepStatus::End cursor next_cursor item
                            Result::Ok converted

