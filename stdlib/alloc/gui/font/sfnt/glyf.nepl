                    if ne scalar_slot_count expected_scalar_slot_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointCoordinateReadError gui_sfnt_simple_glyph_outline_point_coordinate_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointCoordinateReadErrorKind::ScalarSlotCountMismatch point_index
                            Result::Err error
                        else:
                            let scalar_slots_cap %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_cap storage
                            if ne scalar_slots_cap scalar_slot_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointCoordinateReadError gui_sfnt_simple_glyph_outline_point_coordinate_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointCoordinateReadErrorKind::ScalarStorageCapacityMismatch point_index
                                    Result::Err error
                                else:
