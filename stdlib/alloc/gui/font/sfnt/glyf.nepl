//: gui_sfnt_simple_glyph_outline_storage_read_point_step: full point を cursor で 1 step [読/よ]む
//:
//: [契約/けいやく]:
//: - storage / stream の shared precondition を終端判定より[前/まえ]に[検査/けんさ]します。
//: - `cursor.next_point_index == point_count` は `End` として[成功/せいこう]を[返/かえ]します。
//: - 実際の point read は F5n `gui_sfnt_simple_glyph_outline_storage_read_point` にだけ[委譲/いじょう]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_read_point_step %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn &GuiSfntSimpleGlyphOutlineStorage fn GuiSfntSimpleGlyphOutlinePointReadCursor Result GuiSfntSimpleGlyphOutlinePointReadStep GuiSfntSimpleGlyphOutlinePointReadStepError \bytes\glyf\stream\storage\cursor:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity storage
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_empty GuiSfntSimpleGlyphOutlinePointReadStepErrorKind::StorageCapacityInvalid cursor capacity topology
            Result::Err error
        else:
            let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
            let topology_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
            if not gui_sfnt_simple_glyph_outline_point_read_glyphs_match &capacity_glyph &topology_glyph:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_empty GuiSfntSimpleGlyphOutlinePointReadStepErrorKind::StorageStreamGlyphMismatch cursor capacity topology
                    Result::Err error
                else:
                    let capacity_contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                    let topology_contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
                    if ne capacity_contour_count topology_contour_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_empty GuiSfntSimpleGlyphOutlinePointReadStepErrorKind::StorageStreamContourCountMismatch cursor capacity topology
                            Result::Err error
                        else:
                            let shared_point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                            let topology_point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
                            if ne shared_point_count topology_point_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_empty GuiSfntSimpleGlyphOutlinePointReadStepErrorKind::StorageStreamPointCountMismatch cursor capacity topology
                                    Result::Err error
                                else:
                                    let point_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &cursor
                                    if or lt point_index 0 gt point_index shared_point_count:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_empty GuiSfntSimpleGlyphOutlinePointReadStepErrorKind::CursorOutOfRange cursor capacity topology
                                            Result::Err error
                                        else:
                                            if eq point_index shared_point_count:
                                                then:
                                                    let terminal_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_cursor shared_point_count
                                                    let point %Option GuiSfntSimpleGlyphPoint none
                                                    let step %GuiSfntSimpleGlyphOutlinePointReadStep gui_sfnt_simple_glyph_outline_point_read_step GuiSfntSimpleGlyphOutlinePointReadStepStatus::End terminal_cursor terminal_cursor point
                                                    Result::Ok step
                                                else:
                                                    match gui_sfnt_simple_glyph_outline_storage_read_point bytes glyf stream storage point_index:
                                                        Result::Err point_error_value:
                                                            let error %GuiSfntSimpleGlyphOutlinePointReadStepError gui_sfnt_simple_glyph_outline_point_read_step_error_point_failed cursor capacity topology point_error_value
                                                            Result::Err error
                                                        Result::Ok point_value:
                                                            let next_point_index %i32 add point_index 1
                                                            let next_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_cursor next_point_index
                                                            let point %Option GuiSfntSimpleGlyphPoint some point_value
                                                            let step %GuiSfntSimpleGlyphOutlinePointReadStep gui_sfnt_simple_glyph_outline_point_read_step GuiSfntSimpleGlyphOutlinePointReadStepStatus::Point cursor next_cursor point
                                                            Result::Ok step

