//: gui_sfnt_glyf_simple_contour_point_with_tables: metadata 済み table から contour-local point を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_simple_contour_point_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId fn i32 fn i32 Result GuiSfntSimpleGlyphContourPoint GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph\contour_index\contour_point_index:
    match gui_sfnt_glyf_simple_contour_span_with_tables bytes head loca glyf metrics glyph contour_index:
        Result::Err error:
            Result::Err error
        Result::Ok span:
            let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
            if:
                or lt contour_point_index 0 ge contour_point_index span_point_count
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf gui_sfnt_simple_glyph_contour_span_start_point_index &span
                else:
                    let absolute_point_index %i32 add gui_sfnt_simple_glyph_contour_span_start_point_index &span contour_point_index
                    match gui_sfnt_glyf_simple_point_with_tables bytes head loca glyf metrics glyph absolute_point_index:
                        Result::Err error:
                            Result::Err error
                        Result::Ok point:
                            Result::Ok gui_sfnt_simple_glyph_contour_point span contour_point_index point

//: gui_sfnt_glyf_simple_contour_edge_with_tables: metadata 済み table から contour edge を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_simple_contour_edge_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId fn i32 fn i32 Result GuiSfntSimpleGlyphContourEdge GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph\contour_index\edge_index:
    match gui_sfnt_glyf_simple_contour_span_with_tables bytes head loca glyf metrics glyph contour_index:
        Result::Err error:
            Result::Err error
        Result::Ok span:
            let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
            if:
                or lt edge_index 0 ge edge_index span_point_count
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf gui_sfnt_simple_glyph_contour_span_start_point_index &span
                else:
                    let next_contour_point_index %i32 if:
                        eq add edge_index 1 span_point_count
                        then:
                            0
                        else:
                            add edge_index 1
                    match gui_sfnt_glyf_simple_contour_point_with_tables bytes head loca glyf metrics glyph contour_index edge_index:
                        Result::Err error:
                            Result::Err error
                        Result::Ok start:
                            match gui_sfnt_glyf_simple_contour_point_with_tables bytes head loca glyf metrics glyph contour_index next_contour_point_index:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok end:
                                    Result::Ok gui_sfnt_simple_glyph_contour_edge start end edge_index next_contour_point_index

//: gui_sfnt_glyf_simple_curve_segment_with_tables: metadata 済み table から curve segment 分類を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_simple_curve_segment_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId fn i32 fn i32 Result GuiSfntSimpleGlyphCurveSegment GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph\contour_index\edge_index:
    match gui_sfnt_glyf_simple_contour_edge_with_tables bytes head loca glyf metrics glyph contour_index edge_index:
        Result::Err error:
            Result::Err error
        Result::Ok edge:
            let start %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_start &edge
            let end %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_end &edge
            let start_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &start
            let end_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &end
            let start_on_curve %bool gui_sfnt_simple_glyph_point_on_curve &start_point
            let end_on_curve %bool gui_sfnt_simple_glyph_point_on_curve &end_point
            let needs_lookahead %bool if:
                start_on_curve
                then:
                    not end_on_curve
                else:
                    false
            if:
                needs_lookahead
                then:
                    let span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_point_span &start
                    let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
                    let next_contour_point_index %i32 gui_sfnt_simple_glyph_contour_edge_next_local_index &edge
                    let lookahead_contour_point_index %i32 if:
                        eq add next_contour_point_index 1 span_point_count
                        then:
                            0
                        else:
                            add next_contour_point_index 1
                    match gui_sfnt_glyf_simple_contour_point_with_tables bytes head loca glyf metrics glyph contour_index lookahead_contour_point_index:
                        Result::Err error:
                            Result::Err error
                        Result::Ok lookahead:
                            Result::Ok gui_sfnt_classify_simple_glyph_curve_segment edge Option::Some lookahead
                else:
                    Result::Ok gui_sfnt_classify_simple_glyph_curve_segment edge Option::None

//: gui_sfnt_lookup_glyph_bounds: SFNT glyf から glyph header bounds を[読/よ]む
//:
//: [目的/もくてき]:
//: - `cmap` などで得た checked `GuiGlyphId` に対し、font bytes 内の glyph header bounds を O(1) で[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - この関数は full outline decode ではありません。contour / composite / CFF / rasterization は後続 phase で扱います。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_lookup_glyph_bounds %fn &ByteBuf fn Option i32 fn GuiGlyphId Result GuiSfntGlyphBounds GuiSfntParseError \bytes\face_index\glyph:
    match gui_sfnt_parse_metadata bytes face_index:
        Result::Err error:
            Result::Err error
        Result::Ok metadata:
            let directory %GuiSfntDirectory gui_sfnt_metadata_directory &metadata
            let metrics %GuiSfntMetrics gui_sfnt_metadata_metrics &metadata
            match gui_sfnt_directory_head &directory:
                Option::None:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                Option::Some head:
                    match gui_sfnt_directory_loca &directory:
                        Option::None:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                        Option::Some loca:
                            match gui_sfnt_directory_glyf &directory:
                                Option::None:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                                Option::Some glyf:
                                    gui_sfnt_glyf_lookup_with_tables bytes head loca glyf metrics glyph

//: gui_sfnt_lookup_simple_glyph_topology: SFNT glyf から simple glyph topology を[読/よ]む
//:
//: [目的/もくてき]:
//: - full point decode 前に、contour endpoint array、instruction length、point data range を typed value として[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - `point_data_offset` は `glyf` table-relative offset です。
//: - composite glyph、flags、coordinate delta、CFF / CFF2 は後続 phase で扱います。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_lookup_simple_glyph_topology %fn &ByteBuf fn Option i32 fn GuiGlyphId Result GuiSfntSimpleGlyphTopology GuiSfntParseError \bytes\face_index\glyph:
    match gui_sfnt_parse_metadata bytes face_index:
        Result::Err error:
            Result::Err error
        Result::Ok metadata:
            let directory %GuiSfntDirectory gui_sfnt_metadata_directory &metadata
            let metrics %GuiSfntMetrics gui_sfnt_metadata_metrics &metadata
            match gui_sfnt_directory_head &directory:
                Option::None:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                Option::Some head:
                    match gui_sfnt_directory_loca &directory:
                        Option::None:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                        Option::Some loca:
                            match gui_sfnt_directory_glyf &directory:
                                Option::None:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                                Option::Some glyf:
                                    gui_sfnt_glyf_simple_topology_with_tables bytes head loca glyf metrics glyph

