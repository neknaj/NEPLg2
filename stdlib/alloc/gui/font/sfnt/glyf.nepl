                                                            if ne quadratic_metric_count plan_quadratic_to_count:
                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::QuadraticMetricCountMismatch
                                                                else:
                                                                    let metrics_len %i32 gui_sfnt_simple_glyph_render_stroke_source_segment_metric_owner_metrics_len metric_owner
                                                                    if ne metrics_len draw_segment_count:
                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::MetricStorageLenMismatch
                                                                        else:
                                                                            let metrics_cap %i32 gui_sfnt_simple_glyph_render_stroke_source_segment_metric_owner_metrics_cap metric_owner
                                                                            if ne metrics_cap draw_segment_count:
                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::MetricStorageCapacityMismatch
                                                                                else Result::Ok unit

