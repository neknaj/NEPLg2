            let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error returned_storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::RegionPushFailed region_error_kind push_error_kind
            Result::Err error

//: gui_sfnt_simple_glyph_outline_storage_push_point_x: x coordinate を PointX region storage へ[追加/ついか]する
//:
//: [契約/けいやく]:
//: - capacity shape と scalar slot count を[検査/けんさ]してから point_count を[使/つか]います。
//: - cursor/capacity boundary が一致するまで、cursor index を logical point index として[使/つか]いません。
//: - logical point index は `cursor.next_index - cursor.start` であり、scalar storage index そのものではありません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_push_point_x %impure fn GuiSfntSimpleGlyphOutlineStorage impure fn GuiSfntSimpleGlyphOutlineScalarRegionCursor impure fn GuiSfntSimpleGlyphPointXSlot Result GuiSfntSimpleGlyphPointXPush GuiSfntSimpleGlyphPointXPushError \storage\cursor\point:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity &storage
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::StorageCapacityInvalid
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check &capacity:
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits _scalar_slot_count:
                    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                        then:
                            let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::CursorInvalid
                            Result::Err error
                        else:
                            let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor
                            let is_point_x_region %bool match region:
                                GuiSfntSimpleGlyphOutlineScalarRegion::PointX:
                                    true
                                _:
                                    false
                            if not is_point_x_region:
                                then:
                                    let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::CursorRegionMismatch
                                    Result::Err error
                                else:
                                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_matches_valid_capacity &cursor &capacity:
                                        then:
                                            let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::CursorRegionMismatch
                                            Result::Err error
                                        else:
                                            let point_index %i32 gui_sfnt_simple_glyph_point_x_slot_point_index &point
                                            let x %i32 gui_sfnt_simple_glyph_point_x_slot_x &point
                                            let start %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &cursor
                                            let next_index %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
                                            let logical_point_index %i32 sub next_index start
                                            if ne point_index logical_point_index:
                                                then:
                                                    let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::PointIndexMismatch
                                                    Result::Err error
                                                else:
                                                    if or lt point_index 0 ge point_index point_count:
                                                        then:
                                                            let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::PointIndexOutOfRange
                                                            Result::Err error
                                                        else:
                                                            gui_sfnt_simple_glyph_outline_storage_push_point_x_commit storage cursor point x
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _overflow_capacity:
                    let error %GuiSfntSimpleGlyphPointXPushError gui_sfnt_simple_glyph_point_x_push_error_no_region storage cursor point GuiSfntSimpleGlyphPointXPushErrorKind::StorageCapacityInvalid
                    Result::Err error

