//: gui_sfnt_simple_glyph_curve_segment_move_to_command: segment start を path command に[写/うつ]す
//:
//: [契約/けいやく]:
//: - line / quadratic は segment start の `MoveTo` を[返/かえ]します。
//: - no-segment は `SkipNoSegment` を[返/かえ]し、silent no-op にはしません。
//: - command index、`Option`、`Result` を使わず、caller が move phase を明示的に[選/えら]びます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_curve_segment_move_to_command %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphPathCommand \segment:
    match *segment:
        GuiSfntSimpleGlyphCurveSegment::NoSegment no_segment:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_curve_no_segment_edge &no_segment
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let reason %GuiSfntSimpleGlyphCurveNoSegmentReason gui_sfnt_simple_glyph_curve_no_segment_reason &no_segment
            let skip %GuiSfntSimpleGlyphPathSkipNoSegment gui_sfnt_simple_glyph_path_skip_no_segment contour_index edge_index reason
            GuiSfntSimpleGlyphPathCommand::SkipNoSegment skip
        GuiSfntSimpleGlyphCurveSegment::Line line:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_line_segment_edge &line
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let start_x2 %i32 gui_sfnt_simple_glyph_line_segment_start_x2 &line
            let start_y2 %i32 gui_sfnt_simple_glyph_line_segment_start_y2 &line
            let move_to %GuiSfntSimpleGlyphPathMoveTo gui_sfnt_simple_glyph_path_move_to contour_index edge_index start_x2 start_y2
            GuiSfntSimpleGlyphPathCommand::MoveTo move_to
        GuiSfntSimpleGlyphCurveSegment::Quadratic quadratic:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_quadratic_segment_edge &quadratic
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let start_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_start_x2 &quadratic
            let start_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_start_y2 &quadratic
            let move_to %GuiSfntSimpleGlyphPathMoveTo gui_sfnt_simple_glyph_path_move_to contour_index edge_index start_x2 start_y2
            GuiSfntSimpleGlyphPathCommand::MoveTo move_to

//: gui_sfnt_simple_glyph_curve_segment_draw_command: segment draw を path command に[写/うつ]す
//:
//: [契約/けいやく]:
//: - line は `LineTo`、quadratic は `QuadraticTo` を[返/かえ]します。
//: - no-segment は `SkipNoSegment` を[返/かえ]し、silent no-op にはしません。
//: - この関数は renderer command を[作/つく]らず、path sink 用の typed command だけを[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_curve_segment_draw_command %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphPathCommand \segment:
    match *segment:
        GuiSfntSimpleGlyphCurveSegment::NoSegment no_segment:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_curve_no_segment_edge &no_segment
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let reason %GuiSfntSimpleGlyphCurveNoSegmentReason gui_sfnt_simple_glyph_curve_no_segment_reason &no_segment
            let skip %GuiSfntSimpleGlyphPathSkipNoSegment gui_sfnt_simple_glyph_path_skip_no_segment contour_index edge_index reason
            GuiSfntSimpleGlyphPathCommand::SkipNoSegment skip
        GuiSfntSimpleGlyphCurveSegment::Line line:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_line_segment_edge &line
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let end_x2 %i32 gui_sfnt_simple_glyph_line_segment_end_x2 &line
            let end_y2 %i32 gui_sfnt_simple_glyph_line_segment_end_y2 &line
            let line_to %GuiSfntSimpleGlyphPathLineTo gui_sfnt_simple_glyph_path_line_to contour_index edge_index end_x2 end_y2
            GuiSfntSimpleGlyphPathCommand::LineTo line_to
        GuiSfntSimpleGlyphCurveSegment::Quadratic quadratic:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_quadratic_segment_edge &quadratic
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let control_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_control_x2 &quadratic
            let control_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_control_y2 &quadratic
            let end_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_end_x2 &quadratic
            let end_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_end_y2 &quadratic
            let end_is_implied %bool gui_sfnt_simple_glyph_quadratic_segment_end_is_implied &quadratic
            let quadratic_to %GuiSfntSimpleGlyphPathQuadraticTo gui_sfnt_simple_glyph_path_quadratic_to contour_index edge_index control_x2 control_y2 end_x2 end_y2 end_is_implied
            GuiSfntSimpleGlyphPathCommand::QuadraticTo quadratic_to

