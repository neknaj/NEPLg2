//: gui_sfnt_simple_glyph_render_stroke_side_edge_records_share_contour_for_closure: 2 つの side edge が同じ contour 由来か判定する
//:
//: [目的/もくてき]:
//: - match と Result を使って分岐を明示し、bool や count の意味を局所化します。
//: - closure の direction / contour / gap 判定を 1 箇所に寄せ、呼び出し側の分岐を浅くします。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_side_edge_records_share_contour_for_closure %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord bool \left\right:
    let left_contour_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_index_for_closure left
    let right_contour_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_index_for_closure right
    let left_start %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_start_edge_index_for_closure left
    let right_start %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_start_edge_index_for_closure right
    let left_end %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_end_edge_index_for_closure left
    let right_end %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_end_edge_index_for_closure right
    let left_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_edge_count_for_closure left
    let right_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_edge_count_for_closure right
    and eq left_contour_index right_contour_index and eq left_start right_start and eq left_end right_end eq left_count right_count

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_candidate_matches: successor candidate の contour / side 条件を判定する
//:
//: [目的/もくてき]:
//: - match と Result を使って分岐を明示し、bool や count の意味を局所化します。
//: - closure の direction / contour / gap 判定を 1 箇所に寄せ、呼び出し側の分岐を浅くします。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_candidate_matches %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord bool \current\candidate:
    let current_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure current
    let candidate_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure candidate
    let same_side %bool gui_sfnt_simple_glyph_render_stroke_edge_closure_side_eq current_side candidate_side
    and same_side gui_sfnt_simple_glyph_render_stroke_side_edge_records_share_contour_for_closure current candidate

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_style_from_side_edge_owner: completed owner chain から stroke style を読む
//:
//: [目的/もくてき]:
//: - completed owner chain に保存された stroke request を読み、cap/join/miter policy を閉じ込めます。
//: - 上流 drain を再実行せず、既に検査済みの owner chain だけを参照します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_style_from_side_edge_owner %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner GuiStroke \side_edge_owner:
    let geometry_owner %&GuiSfntSimpleGlyphRenderStrokeOffsetGeometryOwner field::get_ref side_edge_owner "geometry_owner"
    let source_owner %&GuiSfntSimpleGlyphRenderStrokeSourceContourOwner field::get_ref geometry_owner "source_owner"
    let metric_owner %&GuiSfntSimpleGlyphRenderStrokeSourceSegmentMetricOwner field::get_ref source_owner "metric_owner"
    let plan_owner %&GuiSfntSimpleGlyphRenderStrokeSegmentPlanOwner field::get_ref metric_owner "plan_owner"
    gui_sfnt_simple_glyph_render_stroke_segment_plan_owner_stroke plan_owner

//: gui_sfnt_simple_glyph_render_stroke_side_edge_owner_invariants_for_closure: F5kz closure invariant を検査する
//:
//: [目的/もくてき]:
//: - count、Vec len/cap、left/right の分解、progress index の整合を Result で返します。
//: - 不整合は typed error kind に閉じ込め、owner の状態を暗黙に補正しません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_side_edge_owner_invariants_for_closure %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner Result unit GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \side_edge_owner:
    let geometry_owner %&GuiSfntSimpleGlyphRenderStrokeOffsetGeometryOwner field::get_ref side_edge_owner "geometry_owner"
    match gui_sfnt_simple_glyph_render_stroke_offset_geometry_owner_invariants_for_side_edge geometry_owner:
        Result::Err _error_kind:
            Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeOwnerInvariantFailed
        Result::Ok _:
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
            if lt side_edge_count 0:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeCountNegative
                else:
                    let line_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_line_side_edge_count side_edge_owner
                    if lt line_side_edge_count 0:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceLineSideEdgeCountNegative
                        else:
                            let quadratic_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_quadratic_side_edge_count side_edge_owner
                            if lt quadratic_side_edge_count 0:
                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceQuadraticSideEdgeCountNegative
                                else:
                                    let left_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_left_side_edge_count side_edge_owner
                                    if lt left_side_edge_count 0:
                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceLeftSideEdgeCountNegative
                                        else:
                                            let right_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_right_side_edge_count side_edge_owner
                                            if lt right_side_edge_count 0:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceRightSideEdgeCountNegative
                                                else:
                                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add line_side_edge_count quadratic_side_edge_count:
                                                        Result::Err error_kind:
                                                            Result::Err error_kind
                                                        Result::Ok counted_kind_edges:
                                                            if ne counted_kind_edges side_edge_count:
                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceLineQuadraticSideEdgeCountMismatch
                                                                else:
                                                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add left_side_edge_count right_side_edge_count:
                                                                        Result::Err error_kind:
                                                                            Result::Err error_kind
                                                                        Result::Ok counted_side_edges:
                                                                            if ne counted_side_edges side_edge_count:
                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceLeftRightSideEdgeCountMismatch
                                                                                else:
                                                                                    let geometry_count %i32 gui_sfnt_simple_glyph_render_stroke_offset_geometry_owner_geometry_count geometry_owner
                                                                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add geometry_count geometry_count:
                                                                                        Result::Err error_kind:
                                                                                            Result::Err error_kind
                                                                                        Result::Ok expected_side_edge_count:
                                                                                            if ne side_edge_count expected_side_edge_count:
                                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeCountMismatch
                                                                                                else:
                                                                                                    if ne left_side_edge_count geometry_count:
                                                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceLeftSideEdgeCountMismatch
                                                                                                        else:
                                                                                                            if ne right_side_edge_count geometry_count:
                                                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceRightSideEdgeCountMismatch
                                                                                                                else:
                                                                                                                    let edges_len %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_edges_len side_edge_owner
                                                                                                                    if ne edges_len side_edge_count:
                                                                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeStorageLenMismatch
                                                                                                                        else:
                                                                                                                            let edges_cap %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_edges_cap side_edge_owner
                                                                                                                            if ne edges_cap side_edge_count:
                                                                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeStorageCapacityMismatch
                                                                                                                                else Result::Ok unit

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_local_invariants: F5kz closure invariant を検査する
//:
//: [目的/もくてき]:
//: - count、Vec len/cap、left/right の分解、progress index の整合を Result で返します。
//: - 不整合は typed error kind に閉じ込め、owner の状態を暗黙に補正しません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_local_invariants %fn &GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner Result unit GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \owner:
    let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref owner "side_edge_owner"
    match gui_sfnt_simple_glyph_render_stroke_side_edge_owner_invariants_for_closure side_edge_owner:
        Result::Err error_kind:
            Result::Err error_kind
        Result::Ok _:
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
            let side_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_side_edge_index owner
            if lt side_edge_index 0:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexNegative
                else:
                    if gt side_edge_index side_edge_count:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexOutOfRange
                        else:
                            let join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_join_count owner
                            if lt join_count 0:
                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinCountNegative
                                else:
                                    let left_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_left_join_count owner
                                    if lt left_join_count 0:
                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::LeftJoinCountNegative
                                        else:
                                            let right_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_right_join_count owner
                                            if lt right_join_count 0:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::RightJoinCountNegative
                                                else:
                                                    if ne join_count side_edge_index:
                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinCountMismatch
                                                        else:
                                                            match gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add left_join_count right_join_count:
                                                                Result::Err error_kind:
                                                                    Result::Err error_kind
                                                                Result::Ok counted_side_joins:
                                                                    if ne counted_side_joins join_count:
                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::LeftRightJoinCountMismatch
                                                                        else:
                                                                            let left_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_left_side_edge_count side_edge_owner
                                                                            if gt left_join_count left_side_edge_count:
                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::LeftJoinCountExceeded
                                                                                else:
                                                                                    let right_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_right_side_edge_count side_edge_owner
                                                                                    if gt right_join_count right_side_edge_count:
                                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::RightJoinCountExceeded
                                                                                        else:
                                                                                            let joins_len %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_joins_len owner
                                                                                            if ne joins_len join_count:
                                                                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinStorageLenMismatch
                                                                                                else:
                                                                                                    let joins_cap %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_joins_cap owner
                                                                                                    if ne joins_cap side_edge_count:
                                                                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinStorageCapacityMismatch
                                                                                                        else Result::Ok unit

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_completion_invariants: F5kz closure invariant を検査する
//:
//: [目的/もくてき]:
//: - count、Vec len/cap、left/right の分解、progress index の整合を Result で返します。
//: - 不整合は typed error kind に閉じ込め、owner の状態を暗黙に補正しません。
