        action

//: gui_sfnt_simple_glyph_path_sink_action_slot_is_primary: slot が primary かを[調/しら]べる
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_action_slot_is_primary %fn GuiSfntSimpleGlyphPathSinkActionSlot bool \slot:
    match slot:
        GuiSfntSimpleGlyphPathSinkActionSlot::Primary:
            true
        GuiSfntSimpleGlyphPathSinkActionSlot::Tail:
            false

//: gui_sfnt_simple_glyph_path_sink_action_slot_is_tail: slot が tail かを[調/しら]べる
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_action_slot_is_tail %fn GuiSfntSimpleGlyphPathSinkActionSlot bool \slot:
    match slot:
        GuiSfntSimpleGlyphPathSinkActionSlot::Primary:
            false
        GuiSfntSimpleGlyphPathSinkActionSlot::Tail:
            true

//: gui_sfnt_simple_glyph_path_sink_primary_action_as_action: primary action を統一 action に[写/うつ]す
//:
//: [契約/けいやく]:
//: - primary action は必ず `EmitEvent` または `Reject` へ写します。
//: - `NoAction` は tail action 専用であり、この関数は[返/かえ]しません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_primary_action_as_action %fn &GuiSfntSimpleGlyphPathSinkPrimaryAction GuiSfntSimpleGlyphPathSinkAction \action:
    match *action:
        GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event:
            GuiSfntSimpleGlyphPathSinkAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkPrimaryAction::Reject reason:
            GuiSfntSimpleGlyphPathSinkAction::Reject reason

//: gui_sfnt_simple_glyph_path_sink_tail_action_as_action: tail action を統一 action に[写/うつ]す
//:
//: [契約/けいやく]:
//: - `NoTailAction` は明示的な `NoAction` に写します。
//: - `CloseContour` は renderer command ではなく、future sink 用の close marker として保持します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_tail_action_as_action %fn &GuiSfntSimpleGlyphPathSinkTailAction GuiSfntSimpleGlyphPathSinkAction \action:
    match *action:
        GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction:
            GuiSfntSimpleGlyphPathSinkAction::NoAction
        GuiSfntSimpleGlyphPathSinkTailAction::CloseContour close:
            GuiSfntSimpleGlyphPathSinkAction::CloseContour close

//: gui_sfnt_simple_glyph_path_sink_step_action_at: sink step の action を slot で[選/えら]ぶ
//:
//: [契約/けいやく]:
//: - `Primary` は primary action を、`Tail` は tail action を[返/かえ]します。
//: - `Option`、`Result`、数値 index、既定 branch は使いません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_step_action_at %fn &GuiSfntSimpleGlyphPathSinkStep fn GuiSfntSimpleGlyphPathSinkActionSlot GuiSfntSimpleGlyphPathSinkAction \step\slot:
    match slot:
        GuiSfntSimpleGlyphPathSinkActionSlot::Primary:
            let primary_action %GuiSfntSimpleGlyphPathSinkPrimaryAction gui_sfnt_simple_glyph_path_sink_step_primary_action step
            gui_sfnt_simple_glyph_path_sink_primary_action_as_action &primary_action
        GuiSfntSimpleGlyphPathSinkActionSlot::Tail:
            let tail_action %GuiSfntSimpleGlyphPathSinkTailAction gui_sfnt_simple_glyph_path_sink_step_tail_action step
            gui_sfnt_simple_glyph_path_sink_tail_action_as_action &tail_action

