                                                    if ne edges_cap edge_capacity:
                                                        then Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_with_shape GuiSfntSimpleGlyphRasterCoverageStartErrorKind::EdgeStorageCapacityMismatch edge_owner config shape
                                                        else:
                                                            let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
                                                            let cells_result %Result Vec i32 StdErrorKind vec::with_capacity cell_count
                                                            match cells_result:
                                                                Result::Err storage_error:
                                                                    Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_storage_failed edge_owner config shape storage_error
                                                                Result::Ok cells:
                                                                    let owner %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner edge_owner shape cells 0
