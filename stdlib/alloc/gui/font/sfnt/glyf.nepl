                    if ne items_cap point_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::CollectionCapacityMismatch none_storage_error
                            Result::Err error
                        else:
                            if ge item_count point_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::CollectionFull none_storage_error
                                    Result::Err error
                                else:
                                    let item_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_outline_point_stream_item_point &item
                                    let item_glyph %GuiGlyphId gui_sfnt_simple_glyph_point_glyph &item_point
                                    let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
                                    let item_glyph_raw %i32 gui_glyph_id_raw &item_glyph
                                    let capacity_glyph_raw %i32 gui_glyph_id_raw &capacity_glyph
                                    if ne item_glyph_raw capacity_glyph_raw:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::ItemGlyphMismatch none_storage_error
                                            Result::Err error
                                        else:
                                            let point_index %i32 gui_sfnt_simple_glyph_point_index &item_point
                                            if ne point_index item_count:
                                                then:
                                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::ItemIndexMismatch none_storage_error
                                                    Result::Err error
                                                else:
                                                    if not gui_sfnt_simple_glyph_outline_point_stream_item_kind_matches_point &item:
                                                        then:
                                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::ItemKindMismatch none_storage_error
                                                            Result::Err error
                                                        else:
                                                            let items %Vec GuiSfntSimpleGlyphOutlinePointStreamItem field::get collection "items"
                                                            match vec::push items item:
                                                                Result::Ok next_items:
                                                                    let next_count %i32 add item_count 1
                                                                    Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemCollection capacity next_items next_count
                                                                Result::Err e:
                                                                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &e
                                                                    let returned_items %Vec GuiSfntSimpleGlyphOutlinePointStreamItem vec::vec_push_error_vec e
                                                                    let returned_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection GuiSfntSimpleGlyphOutlinePointStreamItemCollection capacity returned_items item_count
                                                                    let storage_error %Option StdErrorKind some storage_error_value
