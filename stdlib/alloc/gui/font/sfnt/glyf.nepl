fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_position %fn &GuiSfntSimpleGlyphRenderFillAlphaMaskResourceRecord fn i32 Result GuiPoint GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \record\cell_index:
    let rect %GuiRect gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_rect record
    let origin_x %i32 gui_rect_x &rect
    let origin_y %i32 gui_rect_y &rect
    let width_px %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_width_px record
    let local_y %i32 div_s cell_index width_px
    let local_x %i32 sub cell_index mul local_y width_px
    match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_checked_position origin_x local_x GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::PositionXOverflow:
        Result::Err kind:
            Result::Err kind
        Result::Ok x:
            match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_checked_position origin_y local_y GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::PositionYOverflow:
                Result::Err kind:
                    Result::Err kind
                Result::Ok y:
                    Result::Ok gui_point_new x y

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_dirty_region %fn &GuiSfntSimpleGlyphRenderFillAlphaMaskResourceRecord Result DirtyRegion GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \record:
    let rect %GuiRect gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_rect record
    match dirty_region_rect_checked rect:
        Result::Err _error:
            Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::DirtyRegionInvalid
