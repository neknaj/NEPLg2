//: gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step: F4s step から primary action を[決/き]める
//:
//: [契約/けいやく]:
//: - `RejectUnsupported` は `SkipNoSegment OffCurveStart` だけを reject にします。
//: - 他の `SkipNoSegment` reason と draw event は typed event のまま emit します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep GuiSfntSimpleGlyphPathSinkPrimaryAction \policy\step:
    let event %GuiSfntSimpleGlyphPathSinkEvent gui_sfnt_simple_glyph_path_contour_step_event step
    let kind %GuiSfntSimpleGlyphPathSinkEventKind gui_sfnt_simple_glyph_path_contour_step_kind step
    match kind:
        GuiSfntSimpleGlyphPathSinkEventKind::MoveTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::LineTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::QuadraticTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::SkipNoSegment reason:
            match reason:
                GuiSfntSimpleGlyphCurveNoSegmentReason::SinglePointContour:
                    GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
                GuiSfntSimpleGlyphCurveNoSegmentReason::OffCurveStart:
                    let off_curve_start_policy %GuiSfntSimpleGlyphPathOffCurveStartPolicy gui_sfnt_simple_glyph_path_sink_policy_off_curve_start_policy policy
                    match off_curve_start_policy:
                        GuiSfntSimpleGlyphPathOffCurveStartPolicy::KeepTypedSkip:
                            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
                        GuiSfntSimpleGlyphPathOffCurveStartPolicy::RejectUnsupported:
                            GuiSfntSimpleGlyphPathSinkPrimaryAction::Reject GuiSfntSimpleGlyphPathSinkRejectReason::UnsupportedOffCurveStart
                GuiSfntSimpleGlyphCurveNoSegmentReason::MissingLookahead:
                    GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event

//: gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step: F4s step から tail action を[決/き]める
//:
//: [契約/けいやく]:
//: - primary action が reject の場合は close policy に関係なく `NoTailAction` です。
//: - close marker は primary が emit で、かつ `step.next = EndContour` の場合だけ[候補/こうほ]になります。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep fn &GuiSfntSimpleGlyphPathSinkPrimaryAction GuiSfntSimpleGlyphPathSinkTailAction \policy\step\primary_action:
    match *primary_action:
        GuiSfntSimpleGlyphPathSinkPrimaryAction::Reject reason:
            GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
        GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event:
            let next %GuiSfntSimpleGlyphPathContourNext gui_sfnt_simple_glyph_path_contour_step_next step
            match next:
                GuiSfntSimpleGlyphPathContourNext::Continue cursor:
                    GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
                GuiSfntSimpleGlyphPathContourNext::EndContour:
                    let closure_policy %GuiSfntSimpleGlyphPathClosurePolicy gui_sfnt_simple_glyph_path_sink_policy_closure_policy policy
                    match closure_policy:
                        GuiSfntSimpleGlyphPathClosurePolicy::KeepOpen:
                            GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
                        GuiSfntSimpleGlyphPathClosurePolicy::EmitCloseAfterFinalEvent:
                            let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_step_cursor step
                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_path_contour_cursor_glyph &cursor
                            let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index &cursor
                            let close %GuiSfntSimpleGlyphPathContourClose gui_sfnt_simple_glyph_path_contour_close glyph contour_index
                            GuiSfntSimpleGlyphPathSinkTailAction::CloseContour close

//: gui_sfnt_simple_glyph_path_sink_step_from_contour_step: F4s step を sink step に[写/うつ]す
//:
//: [契約/けいやく]:
//: - policy reject は `Result::Err` ではなく `primary_action = Reject` として[返/かえ]します。
//: - reject step の tail は必ず `NoTailAction` です。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_step_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep GuiSfntSimpleGlyphPathSinkStep \policy\step:
    let primary_action %GuiSfntSimpleGlyphPathSinkPrimaryAction gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step policy step
    let tail_action %GuiSfntSimpleGlyphPathSinkTailAction gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step policy step &primary_action
    let source_step %GuiSfntSimpleGlyphPathContourStep *step
    gui_sfnt_simple_glyph_path_sink_step source_step primary_action tail_action

//: gui_sfnt_simple_glyph_path_contour_next_from_cursor: 検証済み cursor の次状態を[計算/けいさん]する
//:
//: [契約/けいやく]:
//: - caller は `span_point_count > 0` かつ `0 <= cursor.edge_index < span_point_count` を検証してから呼びます。
//: - `First` は同じ edge の `Second` へ進み、`Second` は次 edge の `First` または `EndContour` へ進みます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_path_contour_next_from_cursor %fn &GuiSfntSimpleGlyphPathContourCursor fn i32 GuiSfntSimpleGlyphPathContourNext \cursor\span_point_count:
    let glyph %GuiGlyphId gui_sfnt_simple_glyph_path_contour_cursor_glyph cursor
    let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index cursor
    let edge_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_edge_index cursor
    let slot %GuiSfntSimpleGlyphPathSinkEventSlot gui_sfnt_simple_glyph_path_contour_cursor_slot cursor
    match slot:
        GuiSfntSimpleGlyphPathSinkEventSlot::First:
            let next_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor glyph contour_index edge_index GuiSfntSimpleGlyphPathSinkEventSlot::Second
            GuiSfntSimpleGlyphPathContourNext::Continue next_cursor
        GuiSfntSimpleGlyphPathSinkEventSlot::Second:
            if:
                eq add edge_index 1 span_point_count
                then:
                    GuiSfntSimpleGlyphPathContourNext::EndContour
                else:
                    let next_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor glyph contour_index add edge_index 1 GuiSfntSimpleGlyphPathSinkEventSlot::First
                    GuiSfntSimpleGlyphPathContourNext::Continue next_cursor

