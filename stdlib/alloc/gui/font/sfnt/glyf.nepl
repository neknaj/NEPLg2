                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits _scalar_slot_count:
                    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                        then:
                            let error %GuiSfntSimpleGlyphContourEndpointPushError gui_sfnt_simple_glyph_contour_endpoint_push_error_no_region storage cursor endpoint previous_endpoint GuiSfntSimpleGlyphContourEndpointPushErrorKind::CursorInvalid
                            Result::Err error
                        else:
                            let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor
                            let is_contour_region %bool match region:
                                GuiSfntSimpleGlyphOutlineScalarRegion::ContourEndpoint:
                                    true
