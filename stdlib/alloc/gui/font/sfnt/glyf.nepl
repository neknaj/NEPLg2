//: - `contour_index` が glyph の contour 数外なら `MissingGlyphOutline` です。
//: - endpoint byte の破損は `MalformedGlyfRecord` です。
//: - point stream decode、coordinate decode、full outline allocation はこの関数の責務ではありません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_lookup_simple_glyph_contour_span %fn &ByteBuf fn Option i32 fn GuiGlyphId fn i32 Result GuiSfntSimpleGlyphContourSpan GuiSfntParseError \bytes\face_index\glyph\contour_index:
    match gui_sfnt_parse_metadata bytes face_index:
        Result::Err error:
            Result::Err error
        Result::Ok metadata:
            let directory %GuiSfntDirectory gui_sfnt_metadata_directory &metadata
            let metrics %GuiSfntMetrics gui_sfnt_metadata_metrics &metadata
            match gui_sfnt_directory_head &directory:
                Option::None:
