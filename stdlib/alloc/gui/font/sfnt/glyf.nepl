fn gui_sfnt_simple_glyph_render_glyph_paint_start_error_packed_owner %fn GuiSfntSimpleGlyphRenderGlyphPaintStartError GuiSfntSimpleGlyphRasterPackedMaskOwner \error:
    field::get error "packed_owner"

fn gui_sfnt_simple_glyph_render_glyph_paint_owner_start %impure fn GuiSfntSimpleGlyphRasterPackedMaskOwner impure fn GuiSfntSimpleGlyphRenderGlyphPaintConfig Result GuiSfntSimpleGlyphRenderFillAlphaMaskOwner GuiSfntSimpleGlyphRenderGlyphPaintStartError \packed_owner\config:
    let paint %GuiGlyphPaint gui_sfnt_simple_glyph_render_glyph_paint_config_paint &config
    let stroke %Option GuiStroke gui_glyph_paint_stroke &paint
    match stroke:
        Option::Some _stroke:
            Result::Err gui_sfnt_simple_glyph_render_glyph_paint_start_error_simple GuiSfntSimpleGlyphRenderGlyphPaintStartErrorKind::UnsupportedStrokePaint packed_owner config
        Option::None:
            let shadows %GuiShadowRef gui_glyph_paint_shadows &paint
            match shadows:
                GuiShadowRef::SingleShadow _shadow:
                    Result::Err gui_sfnt_simple_glyph_render_glyph_paint_start_error_simple GuiSfntSimpleGlyphRenderGlyphPaintStartErrorKind::UnsupportedShadowPaint packed_owner config
                GuiShadowRef::ShadowRun _id:
                    Result::Err gui_sfnt_simple_glyph_render_glyph_paint_start_error_simple GuiSfntSimpleGlyphRenderGlyphPaintStartErrorKind::UnsupportedShadowPaint packed_owner config
                GuiShadowRef::NoShadow:
                    let fill %Option GuiPaint gui_glyph_paint_fill &paint
                    match fill:
                        Option::None:
                            Result::Err gui_sfnt_simple_glyph_render_glyph_paint_start_error_simple GuiSfntSimpleGlyphRenderGlyphPaintStartErrorKind::MissingFillPaint packed_owner config
                        Option::Some fill_paint:
                            let origin %GuiPoint gui_sfnt_simple_glyph_render_glyph_paint_config_origin &config
                            let blend %GuiBlendMode gui_glyph_paint_blend &paint
                            let fill_config %GuiSfntSimpleGlyphRenderFillAlphaMaskConfig gui_sfnt_simple_glyph_render_fill_alpha_mask_config origin fill_paint blend
                            match gui_sfnt_simple_glyph_render_fill_alpha_mask_owner_start packed_owner fill_config:
                                Result::Ok render_owner:
                                    Result::Ok render_owner
                                Result::Err lower_error:
                                    let lower_kind %GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind gui_sfnt_simple_glyph_render_fill_alpha_mask_start_error_kind &lower_error
                                    let recovered_owner %GuiSfntSimpleGlyphRasterPackedMaskOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_start_error_packed_owner lower_error
                                    Result::Err gui_sfnt_simple_glyph_render_glyph_paint_start_error_with_lower GuiSfntSimpleGlyphRenderGlyphPaintStartErrorKind::FillAlphaMaskStartFailed recovered_owner config lower_kind

fn gui_sfnt_simple_glyph_render_glyph_paint_start_error_free %impure fn GuiSfntSimpleGlyphRenderGlyphPaintStartError unit \error:
    let packed_owner %GuiSfntSimpleGlyphRasterPackedMaskOwner field::get error "packed_owner"
    gui_sfnt_simple_glyph_raster_packed_mask_owner_free packed_owner

