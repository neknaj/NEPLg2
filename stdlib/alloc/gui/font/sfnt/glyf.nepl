    let mut current_items_read %i32 0
    let mut current_last_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
    let mut current_remaining_steps %i32 remaining_steps
    let mut done %bool false
    let initial_summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary cursor 0 current_last_item
    let initial_drain %GuiSfntSimpleGlyphOutlinePointStreamItemDrain GuiSfntSimpleGlyphOutlinePointStreamItemDrain::StepBudgetExhausted initial_summary
    let mut output %Result GuiSfntSimpleGlyphOutlinePointStreamItemDrain GuiSfntSimpleGlyphOutlinePointStreamItemDrainError Result::Ok initial_drain
    while not done:
        do:
            match gui_sfnt_simple_glyph_outline_point_read_cursor_validate storage stream current_cursor:
                Result::Err reject:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_from_cursor_validation_reject reject
                    set output Result::Err error
                    set done true
                Result::Ok validation:
                    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity *field::get_ref &validation "capacity"
                    let topology %GuiSfntSimpleGlyphTopology *field::get_ref &validation "topology"
                    let point_index %i32 *field::get_ref &validation "point_index"
                    let shared_point_count %i32 *field::get_ref &validation "shared_point_count"
                    if eq point_index shared_point_count:
                        then:
                            let terminal_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_cursor shared_point_count
                            let summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary terminal_cursor current_items_read current_last_item
                            set output Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemDrain::End summary
                            set done true
                        else:
                            if le current_remaining_steps 0:
                                then:
                                    let summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary current_cursor current_items_read current_last_item
                                    set output Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemDrain::StepBudgetExhausted summary
                                    set done true
                                else:
                                    match gui_sfnt_simple_glyph_outline_storage_read_point_step bytes glyf stream storage current_cursor:
                                        Result::Err step_error_value:
                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_point_step_failed current_cursor capacity topology step_error_value
                                            set output Result::Err error
                                            set done true
                                        Result::Ok point_step:
                                            match gui_sfnt_simple_glyph_outline_point_stream_item_step_from_point_step &point_step:
                                                Result::Err item_step_error_value:
