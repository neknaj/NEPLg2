        else:
            gui_sfnt_glyf_read_i16_be bytes add gui_sfnt_table_record_offset &glyf offset GuiSfntParseErrorKind::MalformedGlyfRecord

//: gui_sfnt_glyf_decode_x_delta: flag と x cursor から x delta を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_decode_x_delta %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 Result GuiSfntSimpleGlyphCoordinateDelta GuiSfntParseError \bytes\glyf\stream\flag\x_cursor:
    let x_start %i32 gui_sfnt_simple_glyph_point_stream_x_data_offset &stream
    let x_length %i32 gui_sfnt_simple_glyph_point_stream_x_data_length &stream
    if:
        gui_sfnt_glyf_flag_has_bit flag 2
        then:
            match gui_sfnt_glyf_read_u8_in_stream_range bytes glyf x_start x_length x_cursor:
                Result::Err error:
                    Result::Err error
                Result::Ok byte:
                    if:
                        gui_sfnt_glyf_flag_has_bit flag 16
                        then:
                            Result::Ok gui_sfnt_simple_glyph_coordinate_delta byte 1
                        else:
                            Result::Ok gui_sfnt_simple_glyph_coordinate_delta sub 0 byte 1
        else:
            if:
                gui_sfnt_glyf_flag_has_bit flag 16
                then:
                    Result::Ok gui_sfnt_simple_glyph_coordinate_delta 0 0
                else:
                    match gui_sfnt_glyf_read_i16_in_stream_range bytes glyf x_start x_length x_cursor:
                        Result::Err error:
                            Result::Err error
                        Result::Ok value:
                            Result::Ok gui_sfnt_simple_glyph_coordinate_delta value 2

