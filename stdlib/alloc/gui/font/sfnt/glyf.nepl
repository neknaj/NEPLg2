                                                    let next_owner %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner edge_owner shape_value next_cells next_written_cell_count
                                                    Result::Ok next_owner
                                                Result::Err e:
                                                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &e
                                                    let returned_cells %Vec i32 vec::vec_push_error_vec e
                                                    let returned_owner %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner edge_owner shape_value returned_cells written_cell_count
                                                    Result::Err gui_sfnt_simple_glyph_raster_coverage_push_error_storage_failed returned_owner coverage_value storage_error_value

