    let local_index %i32 gui_sfnt_simple_glyph_contour_point_local_index contour_point
    let glyph_ok %bool eq point_span_glyph_raw span_glyph_raw
    let index_ok %bool eq point_span_index span_index
    let start_ok %bool eq point_span_start span_start
    let end_ok %bool eq point_span_end span_end
    let count_ok %bool eq point_span_count span_count
