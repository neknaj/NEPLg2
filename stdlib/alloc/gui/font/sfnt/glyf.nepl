//: gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_drain_to_path_command_tag_start_budget: collection source から Edge region を[埋/う]め、完了時だけ PathCommandTag cursor を[開始/かいし]する
//:
//: [契約/けいやく]:
//: - EdgeStartOwner は public constructor を[持/も]つため、summary capacity、owner storage capacity、cursor、collection capacity をこの順で[検査/けんさ]してから処理します。
//: - cursor は partial drain 再開を[許/ゆる]すため、Edge region の start/end が summary capacity と[一致/いっち]し、next_index が範囲内であればよい。region start へ固定してはいけません。
//: - Edge source は collection-backed contour span / contour edge と owner storage endpoint marker のみで、curve segment、byte-backed lookup、path sink traversal、renderer、platform API、font の代替解決へは[進/すす]みません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_drain_to_path_command_tag_start_budget %impure fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollection impure fn GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeStartOwner impure fn i32 Result GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainTerminal GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError \collection\owner\remaining_steps:
    let summary %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_summary &owner
    let summary_capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_drain_summary_capacity &summary
    let storage_capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_storage_capacity &owner
    if not gui_sfnt_simple_glyph_outline_storage_capacity_matches &summary_capacity &storage_capacity:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_drain_error_empty owner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainErrorKind::StorageSummaryCapacityMismatch -1
            Result::Err error
        else:
            let cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_cursor &owner
            if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_drain_error_empty owner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainErrorKind::CursorInvalid -1
                    Result::Err error
                else:
                    let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &cursor
                    let is_edge_region %bool match region:
                        GuiSfntSimpleGlyphOutlineScalarRegion::Edge:
                            true
                        _:
                            false
                    if not is_edge_region:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_drain_error_empty owner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainErrorKind::CursorRegionMismatch -1
                            Result::Err error
                        else:
                            if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_matches_valid_capacity &cursor &summary_capacity:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_drain_error_empty owner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainErrorKind::CursorCapacityMismatch -1
                                    Result::Err error
                                else:
                                    let collection_capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity collection
                                    if not gui_sfnt_simple_glyph_outline_storage_capacity_matches &collection_capacity &summary_capacity:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_drain_error_empty owner GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionEdgeDrainErrorKind::CollectionSummaryCapacityMismatch -1
                                            Result::Err error
                                        else:
                                            gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_edge_start_owner_drain_to_path_command_tag_start_budget_trusted collection owner remaining_steps

