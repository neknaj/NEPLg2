        Result::Err reject:
            Result::Err gui_sfnt_simple_glyph_outline_point_read_drain_error_from_cursor_validation_reject reject
        Result::Ok validation:
            let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity *field::get_ref &validation "capacity"
            let topology %GuiSfntSimpleGlyphTopology *field::get_ref &validation "topology"
            let point_index %i32 *field::get_ref &validation "point_index"
            let shared_point_count %i32 *field::get_ref &validation "shared_point_count"
            Result::Ok gui_sfnt_simple_glyph_outline_point_read_drain_validation capacity topology point_index shared_point_count

//: gui_sfnt_simple_glyph_outline_storage_read_point_drain_budget: point read step を budget 内で[進/すす]める
//:
//: [契約/けいやく]:
//: - terminal 判定は budget 判定より[前/まえ]に[行/おこな]います。
//: - non-terminal で `remaining_steps <= 0` の[場合/ばあい]、F5o を[呼/よ]ばず `StepBudgetExhausted` を[返/かえ]します。
//: - F5o の不可能な成功形、または cursor が前進しない成功形は `StepInvariantInvalid` として fail-closed にします。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_read_point_drain_budget %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn &GuiSfntSimpleGlyphOutlineStorage fn GuiSfntSimpleGlyphOutlinePointReadCursor fn i32 Result GuiSfntSimpleGlyphOutlinePointReadDrain GuiSfntSimpleGlyphOutlinePointReadDrainError \bytes\glyf\stream\storage\cursor\remaining_steps:
    let mut current_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor cursor
    let mut current_points_read %i32 0
    let mut current_last_point %Option GuiSfntSimpleGlyphPoint none
    let mut current_remaining_steps %i32 remaining_steps
    let mut done %bool false
    let initial_summary %GuiSfntSimpleGlyphOutlinePointReadDrainSummary gui_sfnt_simple_glyph_outline_point_read_drain_summary cursor 0 current_last_point
    let initial_drain %GuiSfntSimpleGlyphOutlinePointReadDrain GuiSfntSimpleGlyphOutlinePointReadDrain::StepBudgetExhausted initial_summary
    let mut output %Result GuiSfntSimpleGlyphOutlinePointReadDrain GuiSfntSimpleGlyphOutlinePointReadDrainError Result::Ok initial_drain
    while not done:
        do:
            match gui_sfnt_simple_glyph_outline_point_read_drain_validate storage stream current_cursor:
                Result::Err error:
                    set output Result::Err error
                    set done true
                Result::Ok validation:
                    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity *field::get_ref &validation "capacity"
                    let topology %GuiSfntSimpleGlyphTopology *field::get_ref &validation "topology"
                    let point_index %i32 *field::get_ref &validation "point_index"
                    let shared_point_count %i32 *field::get_ref &validation "shared_point_count"
                    if eq point_index shared_point_count:
                        then:
                            let terminal_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_cursor shared_point_count
                            let summary %GuiSfntSimpleGlyphOutlinePointReadDrainSummary gui_sfnt_simple_glyph_outline_point_read_drain_summary terminal_cursor current_points_read current_last_point
                            set output Result::Ok GuiSfntSimpleGlyphOutlinePointReadDrain::End summary
                            set done true
                        else:
                            if le current_remaining_steps 0:
                                then:
                                    let summary %GuiSfntSimpleGlyphOutlinePointReadDrainSummary gui_sfnt_simple_glyph_outline_point_read_drain_summary current_cursor current_points_read current_last_point
                                    set output Result::Ok GuiSfntSimpleGlyphOutlinePointReadDrain::StepBudgetExhausted summary
                                    set done true
                                else:
                                    match gui_sfnt_simple_glyph_outline_storage_read_point_step bytes glyf stream storage current_cursor:
                                        Result::Err step_error_value:
                                            let error %GuiSfntSimpleGlyphOutlinePointReadDrainError gui_sfnt_simple_glyph_outline_point_read_drain_error_step_failed current_cursor capacity topology step_error_value
                                            set output Result::Err error
                                            set done true
                                        Result::Ok step:
                                            match gui_sfnt_simple_glyph_outline_point_read_step_status &step:
                                                GuiSfntSimpleGlyphOutlinePointReadStepStatus::Point:
                                                    match gui_sfnt_simple_glyph_outline_point_read_step_point &step:
                                                        Option::None:
                                                            let error %GuiSfntSimpleGlyphOutlinePointReadDrainError gui_sfnt_simple_glyph_outline_point_read_drain_error_step_invariant current_cursor capacity topology step
                                                            set output Result::Err error
                                                            set done true
                                                        Option::Some point:
                                                            let next_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_step_next_cursor &step
                                                            let next_point_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &next_cursor
                                                            let expected_next_point_index %i32 add point_index 1
                                                            if ne next_point_index expected_next_point_index:
                                                                then:
                                                                    let error %GuiSfntSimpleGlyphOutlinePointReadDrainError gui_sfnt_simple_glyph_outline_point_read_drain_error_step_invariant current_cursor capacity topology step
                                                                    set output Result::Err error
                                                                    set done true
                                                                else:
                                                                    set current_cursor next_cursor
                                                                    set current_points_read add current_points_read 1
                                                                    set current_last_point some point
                                                                    set current_remaining_steps sub current_remaining_steps 1
                                                GuiSfntSimpleGlyphOutlinePointReadStepStatus::End:
                                                    let error %GuiSfntSimpleGlyphOutlinePointReadDrainError gui_sfnt_simple_glyph_outline_point_read_drain_error_step_invariant current_cursor capacity topology step
                                                    set output Result::Err error
                                                    set done true
    output

