            let edge_capacity %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity_raster_edge_capacity &capacity
            let edge_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_raster_edge_owner_edge_count &edge_owner
            if ne edge_count edge_capacity:
                then Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_with_shape GuiSfntSimpleGlyphRasterCoverageStartErrorKind::EdgeCountMismatch edge_owner config shape
                else:
                    let plan %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkPlan gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_plan sink_owner
                    let line_edge_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_raster_edge_owner_line_edge_count &edge_owner
                    let plan_line_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_line_to_count &plan
                    if ne line_edge_count plan_line_to_count:
                        then Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_with_shape GuiSfntSimpleGlyphRasterCoverageStartErrorKind::LineEdgeCountMismatch edge_owner config shape
                        else:
                            let quadratic_edge_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_raster_edge_owner_quadratic_edge_count &edge_owner
                            let plan_quadratic_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_quadratic_to_count &plan
                            if ne quadratic_edge_count plan_quadratic_to_count:
                                then Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_with_shape GuiSfntSimpleGlyphRasterCoverageStartErrorKind::QuadraticEdgeCountMismatch edge_owner config shape
                                else:
