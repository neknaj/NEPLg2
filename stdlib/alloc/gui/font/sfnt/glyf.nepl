//: GuiSfntSimpleGlyphCurveSegment: topology edge から分類した drawable / non-drawable segment
//:
//: [目的/もくてき]:
//: - line、quadratic、no-segment を enum payload として[分/わ]け、caller が `match` で網羅的に扱えるようにします。
//: - implied midpoint は doubled coordinate contract で表し、整数除算による丸めを行いません。
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphCurveSegment:
    NoSegment %GuiSfntSimpleGlyphCurveNoSegment
    Line %GuiSfntSimpleGlyphLineSegment
    Quadratic %GuiSfntSimpleGlyphQuadraticSegment

impl Clone for GuiSfntSimpleGlyphCurveSegment:
    fn clone %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphCurveSegment \segment:
        *segment

impl Copy for GuiSfntSimpleGlyphCurveSegment:
    fn copy_mark %fn GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphCurveSegment \segment:
        segment

//: gui_sfnt_classify_simple_glyph_curve_segment: contour edge を line / quadratic / no-segment に[分類/ぶんるい]する
//:
//: [目的/もくてき]:
//: - 既に復元済みの contour edge を、TrueType simple glyph の on-curve / off-curve 規則で 1 segment へ[分類/ぶんるい]します。
//: - `edge.end` が off-curve の場合、caller は次の contour point を `lookahead` として渡します。
//:
//: [注意/ちゅうい]:
//: - `lookahead` が必要なのに `Option::None` の場合は `MissingLookahead` の `NoSegment` になります。
//: - implied midpoint は doubled coordinate として保持し、除算で丸めません。
//: - この関数は allocation、outline builder、rasterizer、platform font API を使いません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_classify_simple_glyph_curve_segment %fn GuiSfntSimpleGlyphContourEdge fn Option GuiSfntSimpleGlyphContourPoint GuiSfntSimpleGlyphCurveSegment \edge\lookahead:
    let start %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_start &edge
    let end %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_end &edge
    let span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_point_span &start
    let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
    let start_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &start
    let end_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &end
    let start_x %i32 gui_sfnt_simple_glyph_point_x &start_point
    let start_y %i32 gui_sfnt_simple_glyph_point_y &start_point
    let end_x %i32 gui_sfnt_simple_glyph_point_x &end_point
    let end_y %i32 gui_sfnt_simple_glyph_point_y &end_point
    let start_x2 %i32 mul start_x 2
    let start_y2 %i32 mul start_y 2
    let end_x2_from_edge %i32 mul end_x 2
    let end_y2_from_edge %i32 mul end_y 2
    let start_on_curve %bool gui_sfnt_simple_glyph_point_on_curve &start_point
    let end_on_curve %bool gui_sfnt_simple_glyph_point_on_curve &end_point
    if:
        eq span_point_count 1
        then:
            GuiSfntSimpleGlyphCurveSegment::NoSegment gui_sfnt_simple_glyph_curve_no_segment edge GuiSfntSimpleGlyphCurveNoSegmentReason::SinglePointContour
        else:
            if:
                not start_on_curve
                then:
                    GuiSfntSimpleGlyphCurveSegment::NoSegment gui_sfnt_simple_glyph_curve_no_segment edge GuiSfntSimpleGlyphCurveNoSegmentReason::OffCurveStart
                else:
                    if:
                        end_on_curve
                        then:
                            let line %GuiSfntSimpleGlyphLineSegment gui_sfnt_simple_glyph_line_segment edge start_x2 start_y2 end_x2_from_edge end_y2_from_edge
                            GuiSfntSimpleGlyphCurveSegment::Line line
                        else:
                            match lookahead:
                                Option::None:
                                    GuiSfntSimpleGlyphCurveSegment::NoSegment gui_sfnt_simple_glyph_curve_no_segment edge GuiSfntSimpleGlyphCurveNoSegmentReason::MissingLookahead
                                Option::Some curve_end:
                                    let lookahead_point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_contour_point_point &curve_end
                                    let end_is_implied %bool not gui_sfnt_simple_glyph_point_on_curve &lookahead_point
                                    let lookahead_x %i32 gui_sfnt_simple_glyph_point_x &lookahead_point
                                    let lookahead_y %i32 gui_sfnt_simple_glyph_point_y &lookahead_point
                                    let end_x2 %i32 if:
                                        end_is_implied
                                        then:
                                            add end_x lookahead_x
                                        else:
                                            mul lookahead_x 2
                                    let end_y2 %i32 if:
                                        end_is_implied
                                        then:
                                            add end_y lookahead_y
                                        else:
                                            mul lookahead_y 2
                                    let quadratic %GuiSfntSimpleGlyphQuadraticSegment gui_sfnt_simple_glyph_quadratic_segment edge curve_end start_x2 start_y2 end_x2_from_edge end_y2_from_edge end_x2 end_y2 end_is_implied
                                    GuiSfntSimpleGlyphCurveSegment::Quadratic quadratic

