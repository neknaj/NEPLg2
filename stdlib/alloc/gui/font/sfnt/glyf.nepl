pub fn gui_sfnt_lookup_simple_glyph_point %fn &ByteBuf fn Option i32 fn GuiGlyphId fn i32 Result GuiSfntSimpleGlyphPoint GuiSfntParseError \bytes\face_index\glyph\point_index:
