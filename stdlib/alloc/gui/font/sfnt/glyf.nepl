//: gui_sfnt_simple_glyph_outline_storage_read_point: storage と stream から full point を[読/よ]む
//:
//: [契約/けいやく]:
//: - storage capacity と stream topology の shared precondition を component read より[前/まえ]に[検査/けんさ]します。
//: - F5k coordinate、F5l endpoint marker、F5m flag marker をそれぞれ 1 回だけ[呼/よ]びます。
//: - edge/path/raster/render/platform/host API へは[進/すす]みません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_read_point %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn &GuiSfntSimpleGlyphOutlineStorage fn i32 Result GuiSfntSimpleGlyphPoint GuiSfntSimpleGlyphOutlinePointReadError \bytes\glyf\stream\storage\point_index:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity storage
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::StorageCapacityInvalid point_index capacity topology
            Result::Err error
        else:
            let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
            let topology_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
            if not gui_sfnt_simple_glyph_outline_point_read_glyphs_match &capacity_glyph &topology_glyph:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::StorageStreamGlyphMismatch point_index capacity topology
                    Result::Err error
                else:
                    let capacity_contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                    let topology_contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
                    if ne capacity_contour_count topology_contour_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::StorageStreamContourCountMismatch point_index capacity topology
                            Result::Err error
                        else:
                            let shared_point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                            let topology_point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
                            if ne shared_point_count topology_point_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::StorageStreamPointCountMismatch point_index capacity topology
                                    Result::Err error
                                else:
                                    if or lt point_index 0 ge point_index shared_point_count:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::PointIndexOutOfRange point_index capacity topology
                                            Result::Err error
                                        else:
                                            match gui_sfnt_simple_glyph_outline_storage_read_point_coordinate storage point_index:
                                                Result::Err coordinate_error_value:
                                                    let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_coordinate_failed point_index capacity topology coordinate_error_value
                                                    Result::Err error
                                                Result::Ok coordinate:
                                                    match gui_sfnt_simple_glyph_outline_storage_read_point_endpoint_marker storage point_index:
                                                        Result::Err endpoint_error_value:
                                                            let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_endpoint_failed point_index capacity topology endpoint_error_value
                                                            Result::Err error
                                                        Result::Ok endpoint_marker:
                                                            match gui_sfnt_glyf_read_point_flag_from_stream bytes glyf stream point_index:
                                                                Result::Err flag_error_value:
                                                                    let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_flag_failed point_index capacity topology flag_error_value
                                                                    Result::Err error
                                                                Result::Ok flag_marker:
                                                                    let point_glyph %GuiGlyphId capacity_glyph
                                                                    let coordinate_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_point_coordinate_glyph &coordinate
                                                                    let endpoint_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_point_endpoint_marker_glyph &endpoint_marker
                                                                    let flag_glyph %GuiGlyphId gui_sfnt_simple_glyph_point_flag_marker_glyph &flag_marker
                                                                    let coordinate_glyph_ok %bool gui_sfnt_simple_glyph_outline_point_read_glyphs_match &coordinate_glyph &point_glyph
                                                                    let endpoint_glyph_ok %bool gui_sfnt_simple_glyph_outline_point_read_glyphs_match &endpoint_glyph &point_glyph
                                                                    let flag_glyph_ok %bool gui_sfnt_simple_glyph_outline_point_read_glyphs_match &flag_glyph &point_glyph
                                                                    let glyphs_ok %bool and coordinate_glyph_ok and endpoint_glyph_ok flag_glyph_ok
                                                                    if not glyphs_ok:
                                                                        then:
                                                                            let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::ComponentGlyphMismatch point_index capacity topology
                                                                            Result::Err error
                                                                        else:
                                                                            let coordinate_index_ok %bool eq point_index gui_sfnt_simple_glyph_outline_point_coordinate_index &coordinate
                                                                            let endpoint_index_ok %bool eq point_index gui_sfnt_simple_glyph_outline_point_endpoint_marker_index &endpoint_marker
                                                                            let flag_index_ok %bool eq point_index gui_sfnt_simple_glyph_point_flag_marker_index &flag_marker
                                                                            let indexes_ok %bool and coordinate_index_ok and endpoint_index_ok flag_index_ok
                                                                            if not indexes_ok:
                                                                                then:
                                                                                    let error %GuiSfntSimpleGlyphOutlinePointReadError gui_sfnt_simple_glyph_outline_point_read_error_empty GuiSfntSimpleGlyphOutlinePointReadErrorKind::ComponentPointIndexMismatch point_index capacity topology
                                                                                    Result::Err error
                                                                                else:
                                                                                    let x %i32 gui_sfnt_simple_glyph_outline_point_coordinate_x &coordinate
                                                                                    let y %i32 gui_sfnt_simple_glyph_outline_point_coordinate_y &coordinate
                                                                                    let on_curve %bool gui_sfnt_simple_glyph_point_flag_marker_on_curve &flag_marker
                                                                                    let end_of_contour %bool gui_sfnt_simple_glyph_outline_point_endpoint_marker_end_of_contour &endpoint_marker
                                                                                    let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_point point_glyph point_index x y on_curve end_of_contour
                                                                                    Result::Ok point

