fn gui_sfnt_simple_glyph_render_stroke_request_stroke_width_is_valid %fn &GuiStroke bool \stroke:
    let width %i32 gui_stroke_width stroke
    gt width 0

fn gui_sfnt_simple_glyph_render_stroke_request_blend_is_supported %fn GuiBlendMode bool \blend:
    match blend:
        GuiBlendMode::SourceOver:
            true
        GuiBlendMode::Copy:
            false
        GuiBlendMode::Multiply:
            false
        GuiBlendMode::Screen:
            false

fn gui_sfnt_simple_glyph_render_stroke_request_owner_start %fn GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkWriterOwner fn GuiSfntSimpleGlyphRenderStrokeRequestConfig Result GuiSfntSimpleGlyphRenderStrokeRequestOwner GuiSfntSimpleGlyphRenderStrokeRequestStartError \writer\config:
    let paint %GuiGlyphPaint gui_sfnt_simple_glyph_render_stroke_request_config_paint &config
    let stroke_option %Option GuiStroke gui_glyph_paint_stroke &paint
    match stroke_option:
        Option::None:
            Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_simple GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::MissingStrokePaint writer config
        Option::Some stroke:
            if not gui_sfnt_simple_glyph_render_stroke_request_stroke_width_is_valid &stroke:
                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_simple GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::StrokeWidthInvalid writer config
                else:
                    let shadows %GuiShadowRef gui_glyph_paint_shadows &paint
                    match shadows:
                        GuiShadowRef::SingleShadow _shadow:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_simple GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::UnsupportedShadowPaint writer config
                        GuiShadowRef::ShadowRun _id:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_simple GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::UnsupportedShadowPaint writer config
                        GuiShadowRef::NoShadow:
                            let blend %GuiBlendMode gui_glyph_paint_blend &paint
                            if not gui_sfnt_simple_glyph_render_stroke_request_blend_is_supported blend:
                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_simple GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::UnsupportedBlendMode writer config
                                else:
                                    let owner %&GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkOwner field::get_ref &writer "owner"
                                    let plan %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkPlan gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_plan owner
                                    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity_from_plan &plan:
                                        Result::Err capacity_error:
                                            Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_capacity_failed writer config capacity_error
                                        Result::Ok derived_capacity:
                                            let stored_capacity %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkOwnerCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity owner
                                            if not gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity_matches &stored_capacity &derived_capacity:
                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::StoredCapacityMismatch writer config derived_capacity
                                                else:
                                                    let path_sink_scalar_capacity %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity_path_sink_scalar_capacity &derived_capacity
                                                    let path_sink_scalars_cap %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_path_sink_scalars_cap owner
                                                    if ne path_sink_scalars_cap path_sink_scalar_capacity:
                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::PathSinkScalarCapacityMismatch writer config derived_capacity
                                                        else:
                                                            let raster_mask_scalar_capacity %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_capacity_raster_mask_scalar_capacity &derived_capacity
                                                            let raster_mask_scalars_cap %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_raster_mask_scalars_cap owner
                                                            if ne raster_mask_scalars_cap raster_mask_scalar_capacity:
                                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::RasterMaskScalarCapacityMismatch writer config derived_capacity
                                                                else:
                                                                    let path_sink_scalars_len %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_path_sink_scalars_len owner
                                                                    if ne path_sink_scalars_len path_sink_scalar_capacity:
                                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::PathSinkScalarLenMismatch writer config derived_capacity
                                                                        else:
                                                                            let raster_mask_scalars_len %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_owner_raster_mask_scalars_len owner
                                                                            if ne raster_mask_scalars_len 0:
                                                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::RasterMaskScalarLenNotZero writer config derived_capacity
                                                                                else:
                                                                                    let total_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_total_count &plan
                                                                                    let inner_written_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_written_count &writer
                                                                                    if ne inner_written_count total_count:
                                                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerWrittenCountMismatch writer config derived_capacity
                                                                                        else:
                                                                                            let inner_path_sink_scalar_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_path_sink_scalar_count &writer
                                                                                            if ne inner_path_sink_scalar_count path_sink_scalar_capacity:
                                                                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerPathSinkScalarCountMismatch writer config derived_capacity
                                                                                                else:
                                                                                                    let inner_move_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_move_to_count &writer
                                                                                                    let plan_move_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_move_to_count &plan
                                                                                                    if ne inner_move_to_count plan_move_to_count:
                                                                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerMoveToCountMismatch writer config derived_capacity
                                                                                                        else:
                                                                                                            let inner_line_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_line_to_count &writer
                                                                                                            let plan_line_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_line_to_count &plan
                                                                                                            if ne inner_line_to_count plan_line_to_count:
                                                                                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerLineToCountMismatch writer config derived_capacity
                                                                                                                else:
                                                                                                                    let inner_quadratic_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_quadratic_to_count &writer
                                                                                                                    let plan_quadratic_to_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_quadratic_to_count &plan
                                                                                                                    if ne inner_quadratic_to_count plan_quadratic_to_count:
                                                                                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerQuadraticToCountMismatch writer config derived_capacity
                                                                                                                        else:
                                                                                                                            let inner_skip_no_segment_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_skip_no_segment_count &writer
                                                                                                                            let plan_skip_no_segment_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_skip_no_segment_count &plan
                                                                                                                            if ne inner_skip_no_segment_count plan_skip_no_segment_count:
                                                                                                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerSkipNoSegmentCountMismatch writer config derived_capacity
                                                                                                                                else:
                                                                                                                                    let inner_last_path_command_index %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_last_path_command_index &writer
                                                                                                                                    let plan_last_path_command_index %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_plan_last_path_command_index &plan
                                                                                                                                    if ne inner_last_path_command_index plan_last_path_command_index:
                                                                                                                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_request_start_error_with_capacity GuiSfntSimpleGlyphRenderStrokeRequestStartErrorKind::InnerLastPathCommandIndexMismatch writer config derived_capacity
                                                                                                                                        else:
                                                                                                                                            let origin %GuiPoint gui_sfnt_simple_glyph_render_stroke_request_config_origin &config
                                                                                                                                            let fill %Option GuiPaint gui_glyph_paint_fill &paint
                                                                                                                                            let request_owner %GuiSfntSimpleGlyphRenderStrokeRequestOwner gui_sfnt_simple_glyph_render_stroke_request_owner writer origin fill stroke blend
                                                                                                                                            Result::Ok request_owner

fn gui_sfnt_simple_glyph_render_stroke_request_owner_free %impure fn GuiSfntSimpleGlyphRenderStrokeRequestOwner unit \owner:
    let writer %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathCommandStreamSinkWriterOwner field::get owner "writer"
    gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_command_stream_sink_writer_owner_free writer

fn gui_sfnt_simple_glyph_render_stroke_request_start_error_free %impure fn GuiSfntSimpleGlyphRenderStrokeRequestStartError unit \error:
