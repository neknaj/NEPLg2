fn gui_sfnt_glyf_read_i16_in_stream_range %fn &ByteBuf fn GuiSfntTableRecord fn i32 fn i32 fn i32 Result i32 GuiSfntParseError \bytes\glyf\start\length\offset:
    if:
        not gui_sfnt_glyf_stream_relative_range_is_valid start length offset 2
        then:
