//: gui_sfnt_simple_glyph_path_sink_action_next_from_step: action slot から次 cursor を[決/き]める
//:
//: [契約/けいやく]:
//: - `Primary` は action payload に関係なく、同じ contour cursor の `Tail` へ進みます。
//: - `Tail` は action payload に関係なく、F4s source step の next state に従います。
//: - `Continue next_cursor` は next cursor の `Primary` へ進みます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_action_next_from_step %fn &GuiSfntSimpleGlyphPathSinkStep fn GuiSfntSimpleGlyphPathSinkActionSlot GuiSfntSimpleGlyphPathSinkActionNext \sink_step\action_slot:
    let source_step %GuiSfntSimpleGlyphPathContourStep gui_sfnt_simple_glyph_path_sink_step_source_step sink_step
    match action_slot:
        GuiSfntSimpleGlyphPathSinkActionSlot::Primary:
            let contour_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_step_cursor &source_step
            let next_action_cursor %GuiSfntSimpleGlyphPathSinkActionCursor gui_sfnt_simple_glyph_path_sink_action_cursor contour_cursor GuiSfntSimpleGlyphPathSinkActionSlot::Tail
            GuiSfntSimpleGlyphPathSinkActionNext::Continue next_action_cursor
        GuiSfntSimpleGlyphPathSinkActionSlot::Tail:
            let contour_next %GuiSfntSimpleGlyphPathContourNext gui_sfnt_simple_glyph_path_contour_step_next &source_step
            match contour_next:
                GuiSfntSimpleGlyphPathContourNext::Continue next_cursor:
                    let next_action_cursor %GuiSfntSimpleGlyphPathSinkActionCursor gui_sfnt_simple_glyph_path_sink_action_cursor next_cursor GuiSfntSimpleGlyphPathSinkActionSlot::Primary
                    GuiSfntSimpleGlyphPathSinkActionNext::Continue next_action_cursor
                GuiSfntSimpleGlyphPathContourNext::EndContour:
                    GuiSfntSimpleGlyphPathSinkActionNext::EndContour

//: gui_sfnt_simple_glyph_path_sink_action_step_from_sink_step: sink step から action step を[作/つく]る
//:
//: [契約/けいやく]:
//: - action は F4u の `gui_sfnt_simple_glyph_path_sink_step_action_at` で[選/えら]びます。
//: - next は action payload を見ず、slot と F4s source step next だけで[決/き]めます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_action_step_from_sink_step %fn &GuiSfntSimpleGlyphPathSinkStep fn GuiSfntSimpleGlyphPathSinkActionSlot GuiSfntSimpleGlyphPathSinkActionStep \sink_step\action_slot:
    let source_step %GuiSfntSimpleGlyphPathContourStep gui_sfnt_simple_glyph_path_sink_step_source_step sink_step
    let contour_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_step_cursor &source_step
    let cursor %GuiSfntSimpleGlyphPathSinkActionCursor gui_sfnt_simple_glyph_path_sink_action_cursor contour_cursor action_slot
    let action %GuiSfntSimpleGlyphPathSinkAction gui_sfnt_simple_glyph_path_sink_step_action_at sink_step action_slot
    let next %GuiSfntSimpleGlyphPathSinkActionNext gui_sfnt_simple_glyph_path_sink_action_next_from_step sink_step action_slot
    let stored_sink_step %GuiSfntSimpleGlyphPathSinkStep *sink_step
    gui_sfnt_simple_glyph_path_sink_action_step cursor stored_sink_step action next

//: gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step: F4s step から primary action を[決/き]める
//:
//: [契約/けいやく]:
//: - `RejectUnsupported` は `SkipNoSegment OffCurveStart` だけを reject にします。
//: - 他の `SkipNoSegment` reason と draw event は typed event のまま emit します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep GuiSfntSimpleGlyphPathSinkPrimaryAction \policy\step:
    let event %GuiSfntSimpleGlyphPathSinkEvent gui_sfnt_simple_glyph_path_contour_step_event step
    let kind %GuiSfntSimpleGlyphPathSinkEventKind gui_sfnt_simple_glyph_path_contour_step_kind step
    match kind:
        GuiSfntSimpleGlyphPathSinkEventKind::MoveTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::LineTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::QuadraticTo:
            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
        GuiSfntSimpleGlyphPathSinkEventKind::SkipNoSegment reason:
            match reason:
                GuiSfntSimpleGlyphCurveNoSegmentReason::SinglePointContour:
                    GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
                GuiSfntSimpleGlyphCurveNoSegmentReason::OffCurveStart:
                    let off_curve_start_policy %GuiSfntSimpleGlyphPathOffCurveStartPolicy gui_sfnt_simple_glyph_path_sink_policy_off_curve_start_policy policy
                    match off_curve_start_policy:
                        GuiSfntSimpleGlyphPathOffCurveStartPolicy::KeepTypedSkip:
                            GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event
                        GuiSfntSimpleGlyphPathOffCurveStartPolicy::RejectUnsupported:
                            GuiSfntSimpleGlyphPathSinkPrimaryAction::Reject GuiSfntSimpleGlyphPathSinkRejectReason::UnsupportedOffCurveStart
                GuiSfntSimpleGlyphCurveNoSegmentReason::MissingLookahead:
                    GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event

//: gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step: F4s step から tail action を[決/き]める
//:
//: [契約/けいやく]:
//: - primary action が reject の場合は close policy に関係なく `NoTailAction` です。
//: - close marker は primary が emit で、かつ `step.next = EndContour` の場合だけ[候補/こうほ]になります。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep fn &GuiSfntSimpleGlyphPathSinkPrimaryAction GuiSfntSimpleGlyphPathSinkTailAction \policy\step\primary_action:
    match *primary_action:
        GuiSfntSimpleGlyphPathSinkPrimaryAction::Reject reason:
            GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
        GuiSfntSimpleGlyphPathSinkPrimaryAction::EmitEvent event:
            let next %GuiSfntSimpleGlyphPathContourNext gui_sfnt_simple_glyph_path_contour_step_next step
            match next:
                GuiSfntSimpleGlyphPathContourNext::Continue cursor:
                    GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
                GuiSfntSimpleGlyphPathContourNext::EndContour:
                    let closure_policy %GuiSfntSimpleGlyphPathClosurePolicy gui_sfnt_simple_glyph_path_sink_policy_closure_policy policy
                    match closure_policy:
                        GuiSfntSimpleGlyphPathClosurePolicy::KeepOpen:
                            GuiSfntSimpleGlyphPathSinkTailAction::NoTailAction
                        GuiSfntSimpleGlyphPathClosurePolicy::EmitCloseAfterFinalEvent:
                            let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_step_cursor step
                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_path_contour_cursor_glyph &cursor
                            let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index &cursor
                            let close %GuiSfntSimpleGlyphPathContourClose gui_sfnt_simple_glyph_path_contour_close glyph contour_index
                            GuiSfntSimpleGlyphPathSinkTailAction::CloseContour close

//: gui_sfnt_simple_glyph_path_sink_step_from_contour_step: F4s step を sink step に[写/うつ]す
//:
//: [契約/けいやく]:
//: - policy reject は `Result::Err` ではなく `primary_action = Reject` として[返/かえ]します。
//: - reject step の tail は必ず `NoTailAction` です。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_path_sink_step_from_contour_step %fn &GuiSfntSimpleGlyphPathSinkPolicy fn &GuiSfntSimpleGlyphPathContourStep GuiSfntSimpleGlyphPathSinkStep \policy\step:
    let primary_action %GuiSfntSimpleGlyphPathSinkPrimaryAction gui_sfnt_simple_glyph_path_sink_primary_action_from_contour_step policy step
    let tail_action %GuiSfntSimpleGlyphPathSinkTailAction gui_sfnt_simple_glyph_path_sink_tail_action_from_contour_step policy step &primary_action
    let source_step %GuiSfntSimpleGlyphPathContourStep *step
    gui_sfnt_simple_glyph_path_sink_step source_step primary_action tail_action

//: gui_sfnt_simple_glyph_path_contour_next_from_cursor: 検証済み cursor の次状態を[計算/けいさん]する
//:
//: [契約/けいやく]:
//: - caller は `span_point_count > 0` かつ `0 <= cursor.edge_index < span_point_count` を検証してから呼びます。
//: - `First` は同じ edge の `Second` へ進み、`Second` は次 edge の `First` または `EndContour` へ進みます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_path_contour_next_from_cursor %fn &GuiSfntSimpleGlyphPathContourCursor fn i32 GuiSfntSimpleGlyphPathContourNext \cursor\span_point_count:
    let glyph %GuiGlyphId gui_sfnt_simple_glyph_path_contour_cursor_glyph cursor
    let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index cursor
    let edge_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_edge_index cursor
    let slot %GuiSfntSimpleGlyphPathSinkEventSlot gui_sfnt_simple_glyph_path_contour_cursor_slot cursor
    match slot:
        GuiSfntSimpleGlyphPathSinkEventSlot::First:
            let next_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor glyph contour_index edge_index GuiSfntSimpleGlyphPathSinkEventSlot::Second
            GuiSfntSimpleGlyphPathContourNext::Continue next_cursor
        GuiSfntSimpleGlyphPathSinkEventSlot::Second:
            if:
                eq add edge_index 1 span_point_count
                then:
                    GuiSfntSimpleGlyphPathContourNext::EndContour
                else:
                    let next_cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor glyph contour_index add edge_index 1 GuiSfntSimpleGlyphPathSinkEventSlot::First
                    GuiSfntSimpleGlyphPathContourNext::Continue next_cursor

//: gui_sfnt_simple_glyph_contour_edge_source_contour_index: edge が[属/ぞく]する contour index を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_contour_edge_source_contour_index %fn &GuiSfntSimpleGlyphContourEdge i32 \edge:
    let start %GuiSfntSimpleGlyphContourPoint gui_sfnt_simple_glyph_contour_edge_start edge
    let span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_point_span &start
    gui_sfnt_simple_glyph_contour_span_index &span

//: gui_sfnt_simple_glyph_curve_segment_move_to_command: segment start を path command に[写/うつ]す
//:
//: [契約/けいやく]:
//: - line / quadratic は segment start の `MoveTo` を[返/かえ]します。
//: - no-segment は `SkipNoSegment` を[返/かえ]し、silent no-op にはしません。
//: - command index、`Option`、`Result` を使わず、caller が move phase を明示的に[選/えら]びます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_curve_segment_move_to_command %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphPathCommand \segment:
    match *segment:
        GuiSfntSimpleGlyphCurveSegment::NoSegment no_segment:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_curve_no_segment_edge &no_segment
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let reason %GuiSfntSimpleGlyphCurveNoSegmentReason gui_sfnt_simple_glyph_curve_no_segment_reason &no_segment
            let skip %GuiSfntSimpleGlyphPathSkipNoSegment gui_sfnt_simple_glyph_path_skip_no_segment contour_index edge_index reason
            GuiSfntSimpleGlyphPathCommand::SkipNoSegment skip
        GuiSfntSimpleGlyphCurveSegment::Line line:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_line_segment_edge &line
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let start_x2 %i32 gui_sfnt_simple_glyph_line_segment_start_x2 &line
            let start_y2 %i32 gui_sfnt_simple_glyph_line_segment_start_y2 &line
            let move_to %GuiSfntSimpleGlyphPathMoveTo gui_sfnt_simple_glyph_path_move_to contour_index edge_index start_x2 start_y2
            GuiSfntSimpleGlyphPathCommand::MoveTo move_to
        GuiSfntSimpleGlyphCurveSegment::Quadratic quadratic:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_quadratic_segment_edge &quadratic
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let start_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_start_x2 &quadratic
            let start_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_start_y2 &quadratic
            let move_to %GuiSfntSimpleGlyphPathMoveTo gui_sfnt_simple_glyph_path_move_to contour_index edge_index start_x2 start_y2
            GuiSfntSimpleGlyphPathCommand::MoveTo move_to

//: gui_sfnt_simple_glyph_curve_segment_draw_command: segment draw を path command に[写/うつ]す
//:
//: [契約/けいやく]:
//: - line は `LineTo`、quadratic は `QuadraticTo` を[返/かえ]します。
//: - no-segment は `SkipNoSegment` を[返/かえ]し、silent no-op にはしません。
//: - この関数は renderer command を[作/つく]らず、path sink 用の typed command だけを[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_curve_segment_draw_command %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphPathCommand \segment:
    match *segment:
        GuiSfntSimpleGlyphCurveSegment::NoSegment no_segment:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_curve_no_segment_edge &no_segment
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let reason %GuiSfntSimpleGlyphCurveNoSegmentReason gui_sfnt_simple_glyph_curve_no_segment_reason &no_segment
            let skip %GuiSfntSimpleGlyphPathSkipNoSegment gui_sfnt_simple_glyph_path_skip_no_segment contour_index edge_index reason
            GuiSfntSimpleGlyphPathCommand::SkipNoSegment skip
        GuiSfntSimpleGlyphCurveSegment::Line line:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_line_segment_edge &line
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let end_x2 %i32 gui_sfnt_simple_glyph_line_segment_end_x2 &line
            let end_y2 %i32 gui_sfnt_simple_glyph_line_segment_end_y2 &line
            let line_to %GuiSfntSimpleGlyphPathLineTo gui_sfnt_simple_glyph_path_line_to contour_index edge_index end_x2 end_y2
            GuiSfntSimpleGlyphPathCommand::LineTo line_to
        GuiSfntSimpleGlyphCurveSegment::Quadratic quadratic:
            let edge %GuiSfntSimpleGlyphContourEdge gui_sfnt_simple_glyph_quadratic_segment_edge &quadratic
            let contour_index %i32 gui_sfnt_simple_glyph_contour_edge_source_contour_index &edge
            let edge_index %i32 gui_sfnt_simple_glyph_contour_edge_index &edge
            let control_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_control_x2 &quadratic
            let control_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_control_y2 &quadratic
            let end_x2 %i32 gui_sfnt_simple_glyph_quadratic_segment_end_x2 &quadratic
            let end_y2 %i32 gui_sfnt_simple_glyph_quadratic_segment_end_y2 &quadratic
            let end_is_implied %bool gui_sfnt_simple_glyph_quadratic_segment_end_is_implied &quadratic
            let quadratic_to %GuiSfntSimpleGlyphPathQuadraticTo gui_sfnt_simple_glyph_path_quadratic_to contour_index edge_index control_x2 control_y2 end_x2 end_y2 end_is_implied
            GuiSfntSimpleGlyphPathCommand::QuadraticTo quadratic_to

//: gui_sfnt_simple_glyph_curve_segment_path_command_pair: segment を move / draw pair に[写/うつ]す
//:
//: [契約/けいやく]:
//: - 同じ segment に F4m の move projection と draw projection を 1 回ずつ[適用/てきよう]します。
//: - pair は command list ではなく、`NoSegment` も両 command で `SkipNoSegment` として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_curve_segment_path_command_pair %fn &GuiSfntSimpleGlyphCurveSegment GuiSfntSimpleGlyphPathCommandPair \segment:
    let move_command %GuiSfntSimpleGlyphPathCommand gui_sfnt_simple_glyph_curve_segment_move_to_command segment
    let draw_command %GuiSfntSimpleGlyphPathCommand gui_sfnt_simple_glyph_curve_segment_draw_command segment
    gui_sfnt_simple_glyph_path_command_pair move_command draw_command

