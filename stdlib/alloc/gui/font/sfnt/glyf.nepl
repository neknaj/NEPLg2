        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_metric_failed metric_owner error_kind
        Result::Ok _:
            match gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_tag_complete_owner_path_command_stream_cursor collection path_command_tag_owner 0:
                Result::Err cursor_error:
                    Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_cursor_failed metric_owner cursor_error
                Result::Ok cursor:
                    let plan_owner %&GuiSfntSimpleGlyphRenderStrokeSegmentPlanOwner field::get_ref &metric_owner "plan_owner"
                    let path_command_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_stream_cursor_end_index &cursor
                    let plan_path_command_count %i32 *field::get_ref plan_owner "path_command_count"
                    if ne path_command_count plan_path_command_count:
                        then Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeSourceContourOwnerStartErrorKind::PathCommandCountMismatch metric_owner
                        else:
                            let draw_segment_count %i32 gui_sfnt_simple_glyph_render_stroke_segment_plan_owner_draw_segment_count plan_owner
                            let provenance_result %Result Vec GuiSfntSimpleGlyphRenderStrokeSourceMetricProvenance StdErrorKind vec::with_capacity draw_segment_count
                            match provenance_result:
                                Result::Err storage_error:
                                    Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_storage_failed metric_owner storage_error
                                Result::Ok provenance:
                                    let provenance_len %i32 vec::len &provenance
                                    if ne provenance_len 0:
                                        then:
                                            vec::free provenance
                                            Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeSourceContourOwnerStartErrorKind::ProvenanceStorageInitialLenMismatch metric_owner
                                        else:
                                            let provenance_cap %i32 vec::cap &provenance
                                            if ne provenance_cap draw_segment_count:
                                                then:
                                                    vec::free provenance
                                                    Result::Err gui_sfnt_simple_glyph_render_stroke_source_contour_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeSourceContourOwnerStartErrorKind::ProvenanceStorageCapacityMismatch metric_owner
                                                else:
                                                    let owner %GuiSfntSimpleGlyphRenderStrokeSourceContourDrainOwner gui_sfnt_simple_glyph_render_stroke_source_contour_drain_owner metric_owner cursor provenance path_command_count 0 0 0 0 0
                                                    Result::Ok owner

