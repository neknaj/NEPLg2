//: gui_sfnt_simple_glyph_render_stroke_coverage_scan_line_crosses_scaled: sample ray と scaled line の crossing を判定する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_scan_line_crosses_scaled %fn f32 fn f32 fn f32 fn f32 fn f32 fn f32 fn GuiSfntSimpleGlyphRenderStrokeCoverageScanErrorKind Result bool GuiSfntSimpleGlyphRenderStrokeCoverageScanErrorKind \sample_x\sample_y\x0\y0\x1\y1\coordinate_error_kind:
    if not gui_sfnt_simple_glyph_render_stroke_coverage_scan_f32_line_coords_valid x0 y0 x1 y1:
        then Result::Err coordinate_error_kind
        else:
            let y0_above %bool gt y0 sample_y
            let y1_above %bool gt y1 sample_y
            let same_side %bool if y0_above:
                then y1_above
                else not y1_above
            if same_side:
                then Result::Ok false
                else:
                    let dy %f32 sub y1 y0
                    if eq dy 0.0:
                        then Result::Ok false
                        else:
                            let left %f32 mul sub sample_x x0 dy
                            let right %f32 mul sub x1 x0 sub sample_y y0
                            if gt dy 0.0:
                                then Result::Ok lt left right
                                else Result::Ok gt left right

