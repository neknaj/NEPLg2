                                Result::Err error_kind:
                                    Result::Err error_kind
                                Result::Ok from_line:
                                    match gui_sfnt_simple_glyph_render_stroke_join_geometry_line_from_side_edge to_edge:
                                        Result::Err error_kind:
                                            Result::Err error_kind
                                        Result::Ok to_line:
                                            gui_sfnt_simple_glyph_render_stroke_join_geometry_miter_from_lines join_index edge_closure_owner join &from_line &to_line
        GuiStrokeJoin::Round:
            Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::UnsupportedRoundJoinPolicy

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_push: 生成済み geometry を drain owner に push する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_push %impure fn GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner impure fn GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord Result GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainError \owner\join:
    match gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_invariants &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_error_simple error_kind owner
        Result::Ok _:
            let join_index %i32 field::get owner "join_index"
            let bevel_join_count %i32 field::get owner "bevel_join_count"
            let miter_join_count %i32 field::get owner "miter_join_count"
            let edge_closure_owner %GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwner field::get owner "edge_closure_owner"
            let next_bevel_join_count %i32 match join:
                GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Bevel _:
                    add bevel_join_count 1
                GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Miter _:
                    bevel_join_count
            let next_miter_join_count %i32 match join:
                GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Bevel _:
                    miter_join_count
                GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Miter _:
                    add miter_join_count 1
            let joins %Vec GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord field::get owner "joins"
            match vec::push joins join:
                Result::Ok next_joins:
                    let next_join_index %i32 add join_index 1
                    let next_owner %GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner edge_closure_owner next_joins next_join_index next_bevel_join_count next_miter_join_count
                    Result::Ok next_owner
                Result::Err push_error:
                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &push_error
                    let returned_joins %Vec GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord vec::vec_push_error_vec push_error
                    let returned_owner %GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner edge_closure_owner returned_joins join_index bevel_join_count miter_join_count
                    Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_error_push_failed returned_owner join storage_error_value

