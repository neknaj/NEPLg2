                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushError gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error collection item GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind::CollectionLengthMismatch none_storage_error
