pub fn gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed %fn &GuiSfntSimpleGlyphOutlineScalarRegionCursor bool \cursor:
    let start %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_start cursor
    let end %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_end cursor
    let next_index %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index cursor
    and and le 0 start le start next_index le next_index end

fn gui_sfnt_simple_glyph_outline_scalar_region_cursor_matches_valid_capacity %fn &GuiSfntSimpleGlyphOutlineScalarRegionCursor fn &GuiSfntSimpleGlyphOutlineStorageCapacity bool \cursor\capacity:
    let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region cursor
    let expected %GuiSfntSimpleGlyphOutlineScalarRegionCursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_from_valid_capacity capacity region
    let start_ok %bool eq gui_sfnt_simple_glyph_outline_scalar_region_cursor_start cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_start &expected
    let end_ok %bool eq gui_sfnt_simple_glyph_outline_scalar_region_cursor_end cursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &expected
    let expected_region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region &expected
    let region_ok %bool match region:
        GuiSfntSimpleGlyphOutlineScalarRegion::ContourEndpoint:
            match expected_region:
                GuiSfntSimpleGlyphOutlineScalarRegion::ContourEndpoint:
                    true
                _:
                    false
        GuiSfntSimpleGlyphOutlineScalarRegion::PointX:
            match expected_region:
                GuiSfntSimpleGlyphOutlineScalarRegion::PointX:
                    true
                _:
                    false
        GuiSfntSimpleGlyphOutlineScalarRegion::PointY:
            match expected_region:
                GuiSfntSimpleGlyphOutlineScalarRegion::PointY:
                    true
                _:
                    false
        GuiSfntSimpleGlyphOutlineScalarRegion::Edge:
            match expected_region:
                GuiSfntSimpleGlyphOutlineScalarRegion::Edge:
                    true
                _:
                    false
        GuiSfntSimpleGlyphOutlineScalarRegion::PathCommandTag:
            match expected_region:
                GuiSfntSimpleGlyphOutlineScalarRegion::PathCommandTag:
                    true
                _:
                    false
    and region_ok and start_ok end_ok

fn gui_sfnt_simple_glyph_outline_scalar_region_cursor_advance_after_push %fn &GuiSfntSimpleGlyphOutlineScalarRegionCursor GuiSfntSimpleGlyphOutlineScalarRegionCursor \cursor:
    let region %GuiSfntSimpleGlyphOutlineScalarRegion gui_sfnt_simple_glyph_outline_scalar_region_cursor_region cursor
    let start %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_start cursor
    let end %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_end cursor
    let next_index %i32 add gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index cursor 1
    gui_sfnt_simple_glyph_outline_scalar_region_cursor region start end next_index

