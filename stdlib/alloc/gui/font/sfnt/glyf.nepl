//: gui_sfnt_simple_glyph_render_stroke_join_geometry_count_checked_add: join geometry progress count を checked add する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_count_checked_add %fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind \left\right:
    let max_i32 %i32 2147483647
    if or lt left 0 lt right 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::ProgressInvariantInvalid
        else:
            let remaining %i32 sub max_i32 left
            if gt right remaining:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::ProgressInvariantInvalid
                else Result::Ok add left right

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_join_is_round: stroke join policy が round か判定する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_join_is_round %fn GuiStrokeJoin bool \join:
    match join:
        GuiStrokeJoin::Miter:
            false
        GuiStrokeJoin::Bevel:
            false
        GuiStrokeJoin::Round:
            true

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite: join geometry 座標が finite か判定する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite %fn f32 bool \value:
    let bits %i32 bitcast_f32_to_i32 value
    let abs_bits %i32 and bits 0x7fffffff
    lt abs_bits 0x7f800000

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_guard: 非 finite 座標を typed error に変換する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_guard %fn f32 fn GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind Result f32 GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind \value\error_kind:
    if gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite value:
        then Result::Ok value
        else Result::Err error_kind

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start: closure owner から join geometry drain を開始する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start %impure fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwner Result GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwnerStartError \edge_closure_owner:
    match gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_invariants_for_stroke_coverage &edge_closure_owner:
        Result::Err source_error:
            Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_source_failed edge_closure_owner source_error
        Result::Ok _:
            let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref &edge_closure_owner "side_edge_owner"
            let quadratic_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_quadratic_side_edge_count side_edge_owner
            if ne quadratic_side_edge_count 0:
                then Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwnerStartErrorKind::UnsupportedQuadraticSideEdges edge_closure_owner
                else:
                    let join_policy %GuiStrokeJoin *field::get_ref &edge_closure_owner "join_policy"
                    if gui_sfnt_simple_glyph_render_stroke_join_geometry_join_is_round join_policy:
                        then Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwnerStartErrorKind::UnsupportedRoundJoinPolicy edge_closure_owner
                        else:
                            let join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_join_count &edge_closure_owner
                            let joins_result %Result Vec GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord StdErrorKind vec::with_capacity join_count
                            match joins_result:
                                Result::Err storage_error:
                                    Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_storage_failed edge_closure_owner storage_error
                                Result::Ok joins:
                                    let joins_len %i32 vec::len &joins
                                    if ne joins_len 0:
                                        then:
                                            vec::free joins
                                            Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwnerStartErrorKind::JoinGeometryStorageInitialLenMismatch edge_closure_owner
                                        else:
                                            let joins_cap %i32 vec::cap &joins
                                            if ne joins_cap join_count:
                                                then:
                                                    vec::free joins
                                                    Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwnerStartErrorKind::JoinGeometryStorageCapacityMismatch edge_closure_owner
                                                else:
                                                    let owner %GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner edge_closure_owner joins 0 0 0
                                                    Result::Ok owner

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_invariants: drain owner の progress と storage 不変条件を検査する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_invariants %fn &GuiSfntSimpleGlyphRenderStrokeJoinGeometryDrainOwner Result unit GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind \owner:
    let join_index %i32 gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_owner_join_index owner
    if lt join_index 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::JoinIndexNegative
