                    if lt quadratic_metric_count 0:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::QuadraticMetricCountNegative
                        else:
                            match gui_sfnt_simple_glyph_render_stroke_source_contour_count_checked_add line_metric_count quadratic_metric_count:
                                Result::Err error_kind:
