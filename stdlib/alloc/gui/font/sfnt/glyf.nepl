fn gui_sfnt_glyf_decode_y_delta %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 Result GuiSfntSimpleGlyphCoordinateDelta GuiSfntParseError \bytes\glyf\stream\flag\y_cursor:
    let y_start %i32 gui_sfnt_simple_glyph_point_stream_y_data_offset &stream
    let y_length %i32 gui_sfnt_simple_glyph_point_stream_y_data_length &stream
    if:
        gui_sfnt_glyf_flag_has_bit flag 4
