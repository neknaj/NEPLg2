            let lookahead_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError none
            let edge %Option GuiSfntSimpleGlyphContourEdge none
            let lookahead %Option GuiSfntSimpleGlyphContourPoint none
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionCurveSegmentError gui_sfnt_simple_glyph_outline_point_stream_item_collection_curve_segment_error GuiSfntSimpleGlyphOutlinePointStreamItemCollectionCurveSegmentErrorKind::ContourEdgeFailed contour_index edge_index -1 -1 capacity edge_error lookahead_error edge lookahead item_count items_len items_cap
            Result::Err error
