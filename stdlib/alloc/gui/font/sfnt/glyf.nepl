        _:
            Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::UnsupportedBlendMode

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_command_scale_alpha %fn i32 fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind \alpha\alpha_max\paint_alpha:
    if le alpha_max 0:
        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::InvalidAlphaMax
        else:
            if lt alpha 0:
                then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::AlphaNegative
                else:
                    if gt alpha alpha_max:
                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::AlphaExceedsMax
                        else:
                            if or eq alpha 0 eq paint_alpha 0:
                                then Result::Ok 0
                                else:
                                    let max_i32 %i32 2147483647
                                    let max_alpha %i32 div_s max_i32 paint_alpha
                                    if gt alpha max_alpha:
                                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::PaintAlphaMultiplyOverflow
                                        else:
                                            let scaled_alpha %i32 div_s mul alpha paint_alpha alpha_max
                                            if or lt scaled_alpha 0 gt scaled_alpha 255:
                                                then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind::ScaledAlphaOutOfRange
                                                else Result::Ok scaled_alpha

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_command_paint %fn &GuiSfntSimpleGlyphRenderFillAlphaMaskSample Result GuiPaint GuiSfntSimpleGlyphRenderFillAlphaMaskSampleCommandErrorKind \sample:
    match gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_command_validate_blend sample:
        Result::Err error_kind:
            Result::Err error_kind
        Result::Ok _:
            let fill_paint %GuiPaint gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_fill_paint sample
            let base_color %Rgba8888 gui_paint_color &fill_paint
            let paint_alpha %i32 cast rgba8888_a &base_color
            let sample_alpha %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_alpha sample
            let alpha_max %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_alpha_max sample
            match gui_sfnt_simple_glyph_render_fill_alpha_mask_sample_command_scale_alpha sample_alpha alpha_max paint_alpha:
                Result::Err error_kind:
                    Result::Err error_kind
                Result::Ok scaled_alpha:
                    let scaled_alpha_u8 %u8 cast scaled_alpha
                    let command_color %Rgba8888 rgba8888_new:
                        rgba8888_r &base_color
                        rgba8888_g &base_color
                        rgba8888_b &base_color
                        scaled_alpha_u8
                    Result::Ok gui_paint_solid command_color

