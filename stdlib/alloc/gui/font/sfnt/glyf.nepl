//: gui_sfnt_simple_glyph_outline_storage_read_point_stream_item_drain_budget: classified item step を budget 内で[進/すす]める
//:
//: [契約/けいやく]:
//: - terminal 判定は budget 判定より[前/まえ]に[行/おこな]います。
//: - non-terminal で `remaining_steps <= 0` の[場合/ばあい]、F5o/F5r を[呼/よ]ばず `StepBudgetExhausted` を[返/かえ]します。
//: - F5o read failure、F5r conversion failure、F5r の成功値を再検査した defensive invariant failure は別々の error kind として保持します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_read_point_stream_item_drain_budget %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn &GuiSfntSimpleGlyphOutlineStorage fn GuiSfntSimpleGlyphOutlinePointReadCursor fn i32 Result GuiSfntSimpleGlyphOutlinePointStreamItemDrain GuiSfntSimpleGlyphOutlinePointStreamItemDrainError \bytes\glyf\stream\storage\cursor\remaining_steps:
    let mut current_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor cursor
    let mut current_items_read %i32 0
    let mut current_last_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
    let mut current_remaining_steps %i32 remaining_steps
    let mut done %bool false
    let initial_summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary cursor 0 current_last_item
    let initial_drain %GuiSfntSimpleGlyphOutlinePointStreamItemDrain GuiSfntSimpleGlyphOutlinePointStreamItemDrain::StepBudgetExhausted initial_summary
    let mut output %Result GuiSfntSimpleGlyphOutlinePointStreamItemDrain GuiSfntSimpleGlyphOutlinePointStreamItemDrainError Result::Ok initial_drain
    while not done:
        do:
            match gui_sfnt_simple_glyph_outline_point_read_cursor_validate storage stream current_cursor:
                Result::Err reject:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_from_cursor_validation_reject reject
                    set output Result::Err error
                    set done true
                Result::Ok validation:
                    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity *field::get_ref &validation "capacity"
                    let topology %GuiSfntSimpleGlyphTopology *field::get_ref &validation "topology"
                    let point_index %i32 *field::get_ref &validation "point_index"
                    let shared_point_count %i32 *field::get_ref &validation "shared_point_count"
                    if eq point_index shared_point_count:
                        then:
                            let terminal_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_read_cursor shared_point_count
                            let summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary terminal_cursor current_items_read current_last_item
                            set output Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemDrain::End summary
                            set done true
                        else:
                            if le current_remaining_steps 0:
                                then:
                                    let summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary current_cursor current_items_read current_last_item
                                    set output Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemDrain::StepBudgetExhausted summary
                                    set done true
                                else:
                                    match gui_sfnt_simple_glyph_outline_storage_read_point_step bytes glyf stream storage current_cursor:
                                        Result::Err step_error_value:
                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_point_step_failed current_cursor capacity topology step_error_value
                                            set output Result::Err error
                                            set done true
                                        Result::Ok point_step:
                                            match gui_sfnt_simple_glyph_outline_point_stream_item_step_from_point_step &point_step:
                                                Result::Err item_step_error_value:
                                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_item_step_convert_failed current_cursor capacity topology point_step item_step_error_value
                                                    set output Result::Err error
                                                    set done true
                                                Result::Ok item_step:
                                                    match gui_sfnt_simple_glyph_outline_point_stream_item_step_status &item_step:
                                                        GuiSfntSimpleGlyphOutlinePointStreamItemStepStatus::Item:
                                                            match gui_sfnt_simple_glyph_outline_point_stream_item_step_item &item_step:
                                                                Option::None:
                                                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_item_step_invariant current_cursor capacity topology point_step item_step
                                                                    set output Result::Err error
                                                                    set done true
                                                                Option::Some item:
                                                                    let item_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_stream_item_step_cursor &item_step
                                                                    let item_cursor_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &item_cursor
                                                                    let next_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_stream_item_step_next_cursor &item_step
                                                                    let next_point_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &next_cursor
                                                                    let expected_next_point_index %i32 add point_index 1
                                                                    if or ne item_cursor_index point_index ne next_point_index expected_next_point_index:
                                                                        then:
                                                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_item_step_invariant current_cursor capacity topology point_step item_step
                                                                            set output Result::Err error
                                                                            set done true
                                                                        else:
                                                                            set current_cursor next_cursor
                                                                            set current_items_read add current_items_read 1
                                                                            set current_last_item some item
                                                                            set current_remaining_steps sub current_remaining_steps 1
                                                        GuiSfntSimpleGlyphOutlinePointStreamItemStepStatus::End:
                                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemDrainError gui_sfnt_simple_glyph_outline_point_stream_item_drain_error_item_step_invariant current_cursor capacity topology point_step item_step
                                                            set output Result::Err error
                                                            set done true
    output

