                                            if ne edges_len edge_count:
                                                then Result::Err gui_sfnt_simple_glyph_raster_coverage_start_error_with_shape GuiSfntSimpleGlyphRasterCoverageStartErrorKind::EdgeStorageLenMismatch edge_owner config shape
                                                else:
