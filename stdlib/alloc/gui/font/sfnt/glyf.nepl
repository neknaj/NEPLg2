                                                    let completed %GuiSfntSimpleGlyphRenderStrokeJoinGeometryOwner gui_sfnt_simple_glyph_render_stroke_join_geometry_owner edge_closure_owner joins source_join_count bevel_join_count miter_join_count
                                                    Result::Ok completed

