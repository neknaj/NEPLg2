                            let absolute_start_ok %bool not lt absolute_point_index span_start_point_index
                            let absolute_end_ok %bool not gt absolute_point_index span_end_point_index
                            let absolute_capacity_ok %bool lt absolute_point_index capacity_point_count
                            let absolute_shape_ok %bool and absolute_start_ok and absolute_end_ok absolute_capacity_ok
                            if not absolute_shape_ok:
