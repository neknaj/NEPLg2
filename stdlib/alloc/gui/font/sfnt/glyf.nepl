                                        Result::Ok geometry_join_count:
                                            if ne geometry_join_count source_join_count:
                                                then Result::Err gui_sfnt_simple_glyph_render_stroke_join_geometry_drain_error_simple GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::CompletionJoinCountMismatch owner
                                                else:
