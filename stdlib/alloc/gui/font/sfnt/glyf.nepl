                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::StorageCapacityInvalid point_index
                    Result::Err error
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits expected_scalar_slot_count:
                    let scalar_slot_count %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slot_count storage
                    if ne scalar_slot_count expected_scalar_slot_count:
                        then:
