        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::MiterLimitInvalid
        else:
            let stroke_width_f %f32 gui_sfnt_simple_glyph_render_stroke_offset_geometry_i32_to_f32 stroke_width
            let threshold %f32 mul stroke_width_f miter_limit
            gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_guard threshold GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::MiterLimitInvalid

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_miter_from_lines: 2 本の line edge から miter connector を計算する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_miter_from_lines %fn i32 fn &GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwner fn &GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord fn &GuiSfntSimpleGlyphRenderStrokeLineSideEdgeRecord fn &GuiSfntSimpleGlyphRenderStrokeLineSideEdgeRecord Result GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind \join_index\edge_closure_owner\join\from_line\to_line:
    let from_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide *field::get_ref from_line "side"
    let to_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide *field::get_ref to_line "side"
    if not gui_sfnt_simple_glyph_render_stroke_edge_closure_side_eq from_side to_side:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::JoinSideMismatch
        else:
            let from_start_x2 %f32 *field::get_ref from_line "start_x2"
            let from_start_y2 %f32 *field::get_ref from_line "start_y2"
            let from_end_x2 %f32 *field::get_ref from_line "end_x2"
            let from_end_y2 %f32 *field::get_ref from_line "end_y2"
            let to_start_x2 %f32 *field::get_ref to_line "start_x2"
            let to_start_y2 %f32 *field::get_ref to_line "start_y2"
            let to_end_x2 %f32 *field::get_ref to_line "end_x2"
            let to_end_y2 %f32 *field::get_ref to_line "end_y2"
            if not and gui_sfnt_simple_glyph_render_stroke_join_geometry_line_coords_valid from_start_x2 from_start_y2 from_end_x2 from_end_y2 gui_sfnt_simple_glyph_render_stroke_join_geometry_line_coords_valid to_start_x2 to_start_y2 to_end_x2 to_end_y2:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::LineCoordinateInvalid
                else:
                    let r_x %f32 sub from_end_x2 from_start_x2
                    let r_y %f32 sub from_end_y2 from_start_y2
                    let s_x %f32 sub to_end_x2 to_start_x2
                    let s_y %f32 sub to_end_y2 to_start_y2
                    let denom %f32 sub mul r_x s_y mul r_y s_x
                    if eq denom 0.0:
                        then gui_sfnt_simple_glyph_render_stroke_join_geometry_bevel_from_join join_index join true
                        else:
                            match gui_sfnt_simple_glyph_render_stroke_join_geometry_miter_threshold edge_closure_owner join:
                                Result::Err error_kind:
                                    Result::Err error_kind
                                Result::Ok threshold:
                                    let qmp_x %f32 sub to_start_x2 from_start_x2
                                    let qmp_y %f32 sub to_start_y2 from_start_y2
                                    let t_num %f32 sub mul qmp_x s_y mul qmp_y s_x
                                    let t %f32 div t_num denom
                                    let miter_x2 %f32 add from_start_x2 mul t r_x
                                    let miter_y2 %f32 add from_start_y2 mul t r_y
                                    if not gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite miter_x2:
                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::MiterCoordinateInvalid
                                        else:
                                            if not gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite miter_y2:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::MiterCoordinateInvalid
                                                else:
                                                    let from_dx %f32 sub miter_x2 from_end_x2
                                                    let from_dy %f32 sub miter_y2 from_end_y2
                                                    let to_dx %f32 sub miter_x2 to_start_x2
                                                    let to_dy %f32 sub miter_y2 to_start_y2
                                                    let from_distance %f32 sqrt add mul from_dx from_dx mul from_dy from_dy
                                                    let to_distance %f32 sqrt add mul to_dx to_dx mul to_dy to_dy
                                                    if not and gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite from_distance gui_sfnt_simple_glyph_render_stroke_join_geometry_f32_is_finite to_distance:
                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind::MiterCoordinateInvalid
                                                        else:
                                                            if or gt from_distance threshold gt to_distance threshold:
                                                                then gui_sfnt_simple_glyph_render_stroke_join_geometry_bevel_from_join join_index join true
                                                                else:
                                                                    let from_side_edge_index %i32 *field::get_ref join "from_side_edge_index"
                                                                    let to_side_edge_index %i32 *field::get_ref join "to_side_edge_index"
                                                                    let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref edge_closure_owner "side_edge_owner"
                                                                    let stroke %GuiStroke gui_sfnt_simple_glyph_render_stroke_edge_closure_style_from_side_edge_owner side_edge_owner
                                                                    let stroke_width %i32 gui_stroke_width &stroke
                                                                    let miter_limit %f32 *field::get_ref join "miter_limit"
                                                                    let side %GuiSfntSimpleGlyphRenderStrokeEdgeSide *field::get_ref join "side"
                                                                    let miter %GuiSfntSimpleGlyphRenderStrokeJoinMiterGeometryRecord gui_sfnt_simple_glyph_render_stroke_join_miter_geometry_record join_index from_side_edge_index to_side_edge_index side stroke_width miter_limit from_end_x2 from_end_y2 miter_x2 miter_y2 to_start_x2 to_start_y2
                                                                    Result::Ok GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord::Miter miter

//: gui_sfnt_simple_glyph_render_stroke_join_geometry_record_from_join: closure join と policy から scan-ready geometry を選ぶ
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_geometry_record_from_join %fn &GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwner fn i32 fn &GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord Result GuiSfntSimpleGlyphRenderStrokeJoinGeometryRecord GuiSfntSimpleGlyphRenderStrokeJoinGeometryErrorKind \edge_closure_owner\join_index\join:
