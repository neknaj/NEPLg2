//: GuiSfntSimpleGlyphOutlineCapacityCheck: outline storage capacity planning の[結果/けっか]
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphOutlineCapacityCheck:
    Fits %GuiSfntSimpleGlyphOutlineStorageCapacity
    InvalidTopology %GuiSfntSimpleGlyphTopology
    CommandCountOverflow %GuiSfntSimpleGlyphTopology
    Rejected %GuiSfntSimpleGlyphOutlineCapacityRejected

impl Clone for GuiSfntSimpleGlyphOutlineCapacityCheck:
    fn clone %fn &GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck \check:
        *check

impl Copy for GuiSfntSimpleGlyphOutlineCapacityCheck:
    fn copy_mark %fn GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck \check:
        check

//: gui_sfnt_simple_glyph_outline_storage_capacity_from_topology: topology から outline storage capacity を[計算/けいさん]する
//:
//: [目的/もくてき]:
//: - allocation の[前/まえ]に、simple glyph の contour / point count から command capacity を[求/もと]めます。
//: - topology が forged value として[不正/ふせい]な[場合/ばあい]も panic せず enum branch で[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_capacity_from_topology %fn &GuiSfntSimpleGlyphTopology GuiSfntSimpleGlyphOutlineCapacityCheck \topology:
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count topology
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count topology
    if or or le contour_count 0 le point_count 0 gt contour_count point_count:
        then GuiSfntSimpleGlyphOutlineCapacityCheck::InvalidTopology *topology
        else:
            if gt point_count 1073741823:
                then GuiSfntSimpleGlyphOutlineCapacityCheck::CommandCountOverflow *topology
                else:
                    let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph topology
                    let edge_count %i32 point_count
                    let path_command_pair_count %i32 point_count
                    let path_command_count %i32 mul point_count 2
                    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity glyph contour_count point_count edge_count path_command_pair_count path_command_count
                    GuiSfntSimpleGlyphOutlineCapacityCheck::Fits capacity

//: gui_sfnt_simple_glyph_outline_storage_capacity_check_limit: capacity が caller limit に[収/おさ]まるか[調/しら]べる
//:
//: [目的/もくてき]:
//: - contour、point、edge、path command の[順/じゅん]で[最初/さいしょ]の[超過/ちょうか]を enum branch として[返/かえ]します。
//: - limit の 0 [以下/いか]は unlimited ではなく、明示的な[超過/ちょうか]として[扱/あつか]います。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_capacity_check_limit %fn &GuiSfntSimpleGlyphOutlineStorageCapacity fn &GuiSfntSimpleGlyphOutlineStorageLimit GuiSfntSimpleGlyphOutlineCapacityCheck \capacity\limit:
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count capacity
    let max_contours %i32 gui_sfnt_simple_glyph_outline_storage_limit_max_contours limit
    if or le max_contours 0 gt contour_count max_contours:
        then:
            let rejected %GuiSfntSimpleGlyphOutlineCapacityRejected gui_sfnt_simple_glyph_outline_capacity_rejected GuiSfntSimpleGlyphOutlineCapacityRejectReason::ContourCapacityExceeded *capacity *limit
            GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected
        else:
            let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count capacity
            let max_points %i32 gui_sfnt_simple_glyph_outline_storage_limit_max_points limit
            if or le max_points 0 gt point_count max_points:
                then:
                    let rejected %GuiSfntSimpleGlyphOutlineCapacityRejected gui_sfnt_simple_glyph_outline_capacity_rejected GuiSfntSimpleGlyphOutlineCapacityRejectReason::PointCapacityExceeded *capacity *limit
                    GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected
                else:
                    let edge_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_edge_count capacity
                    let max_edges %i32 gui_sfnt_simple_glyph_outline_storage_limit_max_edges limit
                    if or le max_edges 0 gt edge_count max_edges:
                        then:
                            let rejected %GuiSfntSimpleGlyphOutlineCapacityRejected gui_sfnt_simple_glyph_outline_capacity_rejected GuiSfntSimpleGlyphOutlineCapacityRejectReason::EdgeCapacityExceeded *capacity *limit
                            GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected
                        else:
                            let path_command_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count capacity
                            let max_path_commands %i32 gui_sfnt_simple_glyph_outline_storage_limit_max_path_commands limit
                            if or le max_path_commands 0 gt path_command_count max_path_commands:
                                then:
                                    let rejected %GuiSfntSimpleGlyphOutlineCapacityRejected gui_sfnt_simple_glyph_outline_capacity_rejected GuiSfntSimpleGlyphOutlineCapacityRejectReason::CommandCapacityExceeded *capacity *limit
                                    GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected
                                else:
                                    GuiSfntSimpleGlyphOutlineCapacityCheck::Fits *capacity

//: GuiSfntSimpleGlyphOutlineStorage: simple glyph outline builder [用/よう]の scalar slot storage owner
//:
//: [目的/もくてき]:
//: - F5a の trusted capacity から、後続 builder が contour endpoint、x/y coordinate、edge、path command tag を[入/い]れる[空/から] storage を[確保/かくほ]します。
//: - この owner はまだ point decode、path command push、rasterize、render command 生成を[行/おこな]いません。
//:
//: [注意/ちゅうい]:
//: - `scalar_slots` は `len == 0` で始まり、`cap == scalar_slot_count` です。
//: - owner なので `Clone` / `Copy` は[実装/じっそう]しません。
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphOutlineStorage:
    capacity %GuiSfntSimpleGlyphOutlineStorageCapacity
    scalar_slots %Vec i32
    scalar_slot_count %i32

//: GuiSfntSimpleGlyphOutlineStorageAllocErrorKind: outline storage allocation の[失敗/しっぱい][分類/ぶんるい]
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphOutlineStorageAllocErrorKind:
    InvalidCapacity
    CapacityRejected
    ScalarSlotCountOverflow
    ScalarSlotStorageAllocFailed

impl Clone for GuiSfntSimpleGlyphOutlineStorageAllocErrorKind:
    fn clone %fn &GuiSfntSimpleGlyphOutlineStorageAllocErrorKind GuiSfntSimpleGlyphOutlineStorageAllocErrorKind \kind:
        *kind

impl Copy for GuiSfntSimpleGlyphOutlineStorageAllocErrorKind:
