//: gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_budget: F5s item stream を collection owner へ budget 内で commit する
//:
//: [契約/けいやく]:
//: - F5s へ渡す step budget は 0 または 1 だけです。caller の `remaining_steps` を F5s へ直接渡しません。
//: - F5s が 1 item を返した場合だけ、F5t collection push を 1 回だけ[呼/よ]びます。
//: - push failure では kind、storage error、rejected item を[読/よ]んでから push error owner を[回収/かいしゅう]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_budget %impure fn &ByteBuf impure fn GuiSfntTableRecord impure fn GuiSfntSimpleGlyphPointStream impure fn &GuiSfntSimpleGlyphOutlineStorage impure fn GuiSfntSimpleGlyphOutlinePointStreamItemCollection impure fn GuiSfntSimpleGlyphOutlinePointReadCursor impure fn i32 Result GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrain GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainError \bytes\glyf\stream\storage\collection\cursor\remaining_steps:
    let mut current_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection collection
    let mut current_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor cursor
    let mut current_items_read %i32 0
    let mut current_last_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
    let mut current_remaining_steps %i32 remaining_steps
    let mut done %bool false
    let mut final_is_error %bool false
    let mut final_is_end %bool false
    let mut final_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor cursor
    let mut final_error_kind %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
    let mut final_item_drain_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemDrainError none
    let mut final_item_drain_result %Option GuiSfntSimpleGlyphOutlinePointStreamItemDrain none
    let mut final_push_error_kind %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind none
    let mut final_push_storage_error %Option StdErrorKind none
    let mut final_rejected_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
    while not done:
        do:
            let collection_item_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count &current_collection
            let cursor_point_index %i32 gui_sfnt_simple_glyph_outline_point_read_cursor_next_point_index &current_cursor
            if ne collection_item_count cursor_point_index:
                then:
                    set final_is_error true
                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::CollectionCursorMismatch
                    set final_item_drain_error none
                    set final_item_drain_result none
                    set final_push_error_kind none
                    set final_push_storage_error none
                    set final_rejected_item none
                    set final_cursor current_cursor
                    set done true
                else:
                    let mut step_budget %i32 1
                    if le current_remaining_steps 0:
                        then:
                            set step_budget 0
                        else:
                            set step_budget 1
                    match gui_sfnt_simple_glyph_outline_storage_read_point_stream_item_drain_budget bytes glyf stream storage current_cursor step_budget:
                        Result::Err lower_error:
                            set final_is_error true
                            set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainFailed
                            set final_item_drain_error some lower_error
                            set final_item_drain_result none
                            set final_push_error_kind none
                            set final_push_storage_error none
                            set final_rejected_item none
                            set final_cursor current_cursor
                            set done true
                        Result::Ok drain:
                            let mut step_is_end %bool false
                            let empty_last_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
                            let mut step_summary %GuiSfntSimpleGlyphOutlinePointStreamItemDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary current_cursor 0 empty_last_item
                            match drain:
                                GuiSfntSimpleGlyphOutlinePointStreamItemDrain::End summary:
                                    set step_is_end true
                                    set step_summary summary
                                GuiSfntSimpleGlyphOutlinePointStreamItemDrain::StepBudgetExhausted summary:
                                    set step_is_end false
                                    set step_summary summary
                            let step_items_read %i32 gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary_items_read &step_summary
                            let step_cursor %GuiSfntSimpleGlyphOutlinePointReadCursor gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary_cursor &step_summary
                            if or lt step_items_read 0 gt step_items_read 1:
                                then:
                                    set final_is_error true
                                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
                                    set final_item_drain_error none
                                    set final_item_drain_result some drain
                                    set final_push_error_kind none
                                    set final_push_storage_error none
                                    set final_rejected_item none
                                    set final_cursor current_cursor
                                    set done true
                                else:
                                    if eq step_items_read 0:
                                        then:
                                            set final_is_error false
                                            set final_is_end step_is_end
                                            set final_cursor step_cursor
                                            set done true
                                        else:
                                            if ne step_budget 1:
                                                then:
                                                    set final_is_error true
                                                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
                                                    set final_item_drain_error none
                                                    set final_item_drain_result some drain
                                                    set final_push_error_kind none
                                                    set final_push_storage_error none
                                                    set final_rejected_item none
                                                    set final_cursor current_cursor
                                                    set done true
                                                else:
                                                    match gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary_last_item &step_summary:
                                                        Option::None:
                                                            set final_is_error true
                                                            set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
                                                            set final_item_drain_error none
                                                            set final_item_drain_result some drain
                                                            set final_push_error_kind none
                                                            set final_push_storage_error none
                                                            set final_rejected_item none
                                                            set final_cursor current_cursor
                                                            set done true
                                                        Option::Some item:
                                                            match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push current_collection item:
                                                                Result::Ok next_collection:
                                                                    set current_collection next_collection
                                                                    set current_cursor step_cursor
                                                                    set current_items_read add current_items_read 1
                                                                    set current_last_item some item
                                                                    set current_remaining_steps sub current_remaining_steps 1
                                                                    if step_is_end:
                                                                        then:
                                                                            set final_is_error false
                                                                            set final_is_end true
                                                                            set final_cursor current_cursor
                                                                            set done true
                                                                        else:
                                                                            if le current_remaining_steps 0:
                                                                                then:
                                                                                    set final_is_error false
                                                                                    set final_is_end false
                                                                                    set final_cursor current_cursor
                                                                                    set done true
                                                                                else:
                                                                                    set done false
                                                                Result::Err push_error:
                                                                    let push_kind %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_kind &push_error
                                                                    let push_storage %Option StdErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_storage_error &push_error
                                                                    let rejected_item_value %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_item &push_error
                                                                    let recovered_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection push_error
                                                                    set current_collection recovered_collection
                                                                    set final_is_error true
                                                                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::CollectionPushFailed
                                                                    set final_item_drain_error none
                                                                    set final_item_drain_result some drain
                                                                    set final_push_error_kind some push_kind
                                                                    set final_push_storage_error push_storage
                                                                    set final_rejected_item some rejected_item_value
                                                                    set final_cursor current_cursor
                                                                    set done true
    if final_is_error:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_error current_collection final_cursor current_items_read current_last_item final_error_kind final_item_drain_error final_item_drain_result final_push_error_kind final_push_storage_error final_rejected_item
            Result::Err error
        else:
            let summary %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_summary current_collection final_cursor current_items_read current_last_item
            if final_is_end:
                then:
                    Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrain::End summary
                else:
                    Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrain::StepBudgetExhausted summary

