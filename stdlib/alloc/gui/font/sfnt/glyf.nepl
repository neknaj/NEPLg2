        else:
            if:
                gui_sfnt_glyf_flag_has_bit flag 32
                then:
                    Result::Ok gui_sfnt_simple_glyph_coordinate_delta 0 0
                else:
                    match gui_sfnt_glyf_read_i16_in_stream_range bytes glyf y_start y_length y_cursor:
                        Result::Err error:
                            Result::Err error
                        Result::Ok value:
                            Result::Ok gui_sfnt_simple_glyph_coordinate_delta value 2

//: gui_sfnt_glyf_decode_flag_run_state: 同じ flag の repeated logical points を累積する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_decode_flag_run_state %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 fn GuiSfntSimpleGlyphPointDecodeState Result GuiSfntSimpleGlyphPointDecodeState GuiSfntParseError \bytes\glyf\stream\flag\remaining\state:
    if:
        le remaining 0
        then:
            Result::Ok state
        else:
            let x_cursor %i32 gui_sfnt_simple_glyph_point_decode_state_x_cursor &state
            let y_cursor %i32 gui_sfnt_simple_glyph_point_decode_state_y_cursor &state
            let current_x %i32 gui_sfnt_simple_glyph_point_decode_state_x &state
            let current_y %i32 gui_sfnt_simple_glyph_point_decode_state_y &state
            match gui_sfnt_glyf_decode_x_delta bytes glyf stream flag x_cursor:
                Result::Err error:
                    Result::Err error
                Result::Ok x_delta:
                    match gui_sfnt_glyf_decode_y_delta bytes glyf stream flag y_cursor:
                        Result::Err error:
                            Result::Err error
                        Result::Ok y_delta:
                            let next_x_cursor %i32 add x_cursor gui_sfnt_simple_glyph_coordinate_delta_byte_length &x_delta
                            let next_y_cursor %i32 add y_cursor gui_sfnt_simple_glyph_coordinate_delta_byte_length &y_delta
                            let next_x %i32 add current_x gui_sfnt_simple_glyph_coordinate_delta_value &x_delta
                            let next_y %i32 add current_y gui_sfnt_simple_glyph_coordinate_delta_value &y_delta
                            let next_logical_index %i32 add gui_sfnt_simple_glyph_point_decode_state_logical_index &state 1
                            let next_state %GuiSfntSimpleGlyphPointDecodeState gui_sfnt_simple_glyph_point_decode_state next_logical_index flag next_x_cursor next_y_cursor next_x next_y
                            gui_sfnt_glyf_decode_flag_run_state bytes glyf stream flag sub remaining 1 next_state

//: gui_sfnt_glyf_decode_point_state_from_flag_run: target と flag run の位置関係を[分/わ]ける
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_decode_point_state_from_flag_run %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 fn i32 fn i32 fn GuiSfntSimpleGlyphPointDecodeState Result GuiSfntSimpleGlyphPointDecodeState GuiSfntParseError \bytes\glyf\stream\target_index\flag\run_count\next_flag_cursor\state:
    if:
        le run_count 0
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf next_flag_cursor
        else:
            let logical_index %i32 gui_sfnt_simple_glyph_point_decode_state_logical_index &state
            let run_end_next %i32 add logical_index run_count
            if:
                lt target_index run_end_next
                then:
                    let target_count %i32 add sub target_index logical_index 1
                    gui_sfnt_glyf_decode_flag_run_state bytes glyf stream flag target_count state
                else:
                    match gui_sfnt_glyf_decode_flag_run_state bytes glyf stream flag run_count state:
                        Result::Err error:
                            Result::Err error
                        Result::Ok next_state:
                            gui_sfnt_glyf_decode_point_state_from_stream bytes glyf stream target_index next_flag_cursor next_state

//: gui_sfnt_glyf_decode_point_state_from_stream: target point まで flag stream を[進/すす]める
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_decode_point_state_from_stream %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 fn GuiSfntSimpleGlyphPointDecodeState Result GuiSfntSimpleGlyphPointDecodeState GuiSfntParseError \bytes\glyf\stream\target_index\flag_cursor\state:
    let flag_start %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
    let flag_length %i32 gui_sfnt_simple_glyph_point_stream_flag_data_length &stream
    match gui_sfnt_glyf_read_u8_in_stream_range bytes glyf flag_start flag_length flag_cursor:
        Result::Err error:
            Result::Err error
        Result::Ok flag:
            if:
                gui_sfnt_glyf_flag_has_bit flag 8
                then:
                    let repeat_count_offset %i32 add flag_cursor 1
                    match gui_sfnt_glyf_read_u8_in_stream_range bytes glyf flag_start flag_length repeat_count_offset:
                        Result::Err error:
                            Result::Err error
                        Result::Ok repeat_count:
                            let run_count %i32 add repeat_count 1
                            gui_sfnt_glyf_decode_point_state_from_flag_run bytes glyf stream target_index flag run_count add flag_cursor 2 state
                else:
                    gui_sfnt_glyf_decode_point_state_from_flag_run bytes glyf stream target_index flag 1 add flag_cursor 1 state

//: gui_sfnt_glyf_topology_endpoint_array_offset: topology から endpoint array offset を[復元/ふくげん]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_topology_endpoint_array_offset %fn &GuiSfntSimpleGlyphTopology i32 \topology:
    let point_data_offset %i32 gui_sfnt_simple_glyph_topology_point_data_offset topology
    let instruction_length %i32 gui_sfnt_simple_glyph_topology_instruction_length topology
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count topology
    let endpoint_array_length %i32 mul contour_count 2
    let after_endpoint_array %i32 sub point_data_offset instruction_length
    let endpoint_array_end %i32 sub after_endpoint_array 2
    sub endpoint_array_end endpoint_array_length

//: gui_sfnt_glyf_point_is_contour_end_loop: endpoint array と point index を[照合/しょうごう]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_point_is_contour_end_loop %fn &ByteBuf fn GuiSfntTableRecord fn i32 fn i32 fn i32 fn i32 Result bool GuiSfntParseError \bytes\glyf\endpoint_array_offset\contour_count\index\point_index:
    if:
        ge index contour_count
        then:
            Result::Ok false
        else:
            let endpoint_offset %i32 add endpoint_array_offset mul index 2
            if:
                not gui_sfnt_glyf_table_relative_range_is_valid glyf endpoint_offset 2
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_offset
                else:
                    match gui_sfnt_glyf_read_u16_be bytes add gui_sfnt_table_record_offset &glyf endpoint_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                        Result::Err error:
                            Result::Err error
                        Result::Ok endpoint:
                            if:
                                eq endpoint point_index
                                then:
                                    Result::Ok true
                                else:
                                    if:
                                        gt endpoint point_index
                                        then:
                                            Result::Ok false
                                        else:
                                            gui_sfnt_glyf_point_is_contour_end_loop bytes glyf endpoint_array_offset contour_count add index 1 point_index

//: gui_sfnt_glyf_point_is_contour_end: point index が contour endpoint か[判定/はんてい]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_point_is_contour_end %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphTopology fn i32 Result bool GuiSfntParseError \bytes\glyf\topology\point_index:
    let endpoint_array_offset %i32 gui_sfnt_glyf_topology_endpoint_array_offset &topology
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
    gui_sfnt_glyf_point_is_contour_end_loop bytes glyf endpoint_array_offset contour_count 0 point_index

//: gui_sfnt_glyf_read_contour_endpoint: topology-derived endpoint array から endpoint を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_contour_endpoint %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphTopology fn i32 Result i32 GuiSfntParseError \bytes\glyf\topology\contour_index:
    let endpoint_array_offset %i32 gui_sfnt_glyf_topology_endpoint_array_offset &topology
    let endpoint_offset %i32 add endpoint_array_offset mul contour_index 2
    if:
        not gui_sfnt_glyf_table_relative_range_is_valid glyf endpoint_offset 2
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_offset
        else:
            gui_sfnt_glyf_read_u16_be bytes add gui_sfnt_table_record_offset &glyf endpoint_offset GuiSfntParseErrorKind::MalformedGlyfRecord

//: gui_sfnt_glyf_contour_span_from_topology: checked topology から 1 contour span を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_contour_span_from_topology %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphTopology fn i32 Result GuiSfntSimpleGlyphContourSpan GuiSfntParseError \bytes\glyf\topology\contour_index:
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
    let endpoint_array_offset %i32 gui_sfnt_glyf_topology_endpoint_array_offset &topology
    if:
        or lt contour_index 0 ge contour_index contour_count
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf endpoint_array_offset
        else:
            match gui_sfnt_glyf_read_contour_endpoint bytes glyf topology contour_index:
                Result::Err error:
                    Result::Err error
                Result::Ok end_point_index:
                    let previous_contour_index %i32 sub contour_index 1
                    let previous_endpoint_result %Result i32 GuiSfntParseError if:
                        eq contour_index 0
                        then:
                            Result::Ok -1
                        else:
                            gui_sfnt_glyf_read_contour_endpoint bytes glyf topology previous_contour_index
                    match previous_endpoint_result:
                        Result::Err error:
                            Result::Err error
                        Result::Ok previous_endpoint:
                            let start_point_index %i32 add previous_endpoint 1
                            let point_count %i32 add sub end_point_index start_point_index 1
                            if:
                                le point_count 0
                                then:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_array_offset
                                else:
                                    let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
                                    Result::Ok gui_sfnt_simple_glyph_contour_span glyph contour_index start_point_index end_point_index point_count

//: gui_sfnt_glyf_decode_point_from_stream: checked stream から 1 logical point を[復元/ふくげん]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_decode_point_from_stream %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 Result GuiSfntSimpleGlyphPoint GuiSfntParseError \bytes\glyf\stream\point_index:
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let flag_data_offset %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
    if:
        or lt point_index 0 ge point_index point_count
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf flag_data_offset
        else:
            let initial_state %GuiSfntSimpleGlyphPointDecodeState gui_sfnt_simple_glyph_point_decode_state 0 0 gui_sfnt_simple_glyph_point_stream_x_data_offset &stream gui_sfnt_simple_glyph_point_stream_y_data_offset &stream 0 0
            match gui_sfnt_glyf_decode_point_state_from_stream bytes glyf stream point_index flag_data_offset initial_state:
                Result::Err error:
                    Result::Err error
                Result::Ok state:
                    match gui_sfnt_glyf_point_is_contour_end bytes glyf topology point_index:
                        Result::Err error:
                            Result::Err error
                        Result::Ok end_of_contour:
                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
                            let x %i32 gui_sfnt_simple_glyph_point_decode_state_x &state
                            let y %i32 gui_sfnt_simple_glyph_point_decode_state_y &state
                            let flag %i32 gui_sfnt_simple_glyph_point_decode_state_flag &state
                            let on_curve %bool gui_sfnt_glyf_flag_has_bit flag 1
                            Result::Ok gui_sfnt_simple_glyph_point glyph point_index x y on_curve end_of_contour

//: gui_sfnt_glyf_simple_point_stream_with_tables: metadata 済み table から simple point stream を[引/ひ]く
//:
