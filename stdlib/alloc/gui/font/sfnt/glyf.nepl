    let max_i32 %i32 2147483647
    let max_left %i32 div_s max_i32 right
    if gt left max_left:
        then Result::Err overflow_kind
        else Result::Ok mul left right

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_validate_shape %fn &GuiSfntSimpleGlyphRasterCoverageShape Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind \shape:
    let width_px %i32 gui_sfnt_simple_glyph_raster_coverage_shape_width_px shape
    if le width_px 0:
        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeInvalidWidth
        else:
            let height_px %i32 gui_sfnt_simple_glyph_raster_coverage_shape_height_px shape
            if le height_px 0:
                then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeInvalidHeight
                else:
                    let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_shape_sample_scale shape
                    if le sample_scale 0:
                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeInvalidSampleScale
                        else:
                            match gui_sfnt_simple_glyph_render_fill_alpha_mask_start_count_checked_mul sample_scale sample_scale GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeCoverageMaxMismatch:
                                Result::Err error_kind:
                                    Result::Err error_kind
                                Result::Ok expected_coverage_max:
                                    let coverage_max %i32 gui_sfnt_simple_glyph_raster_coverage_shape_coverage_max shape
                                    if ne coverage_max expected_coverage_max:
                                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeCoverageMaxMismatch
                                        else:
                                            match gui_sfnt_simple_glyph_render_fill_alpha_mask_start_count_checked_mul width_px height_px GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeCellCountMismatch:
                                                Result::Err error_kind:
                                                    Result::Err error_kind
                                                Result::Ok expected_cell_count:
                                                    let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count shape
                                                    if ne cell_count expected_cell_count:
                                                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::ShapeCellCountMismatch
                                                        else Result::Ok unit

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_packed_owner_invariants %fn &GuiSfntSimpleGlyphRasterPackedMaskOwner Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind \packed_owner:
    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_packed_mask_owner_shape packed_owner
    match gui_sfnt_simple_glyph_render_fill_alpha_mask_validate_shape &shape:
        Result::Err error_kind:
            Result::Err error_kind
        Result::Ok _:
            let alpha_max %i32 gui_sfnt_simple_glyph_raster_packed_mask_owner_alpha_max packed_owner
            if le alpha_max 0:
                then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::InvalidAlphaMax
                else:
                    let shape_cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
                    let owner_cell_count %i32 gui_sfnt_simple_glyph_raster_packed_mask_owner_cell_count packed_owner
                    if ne owner_cell_count shape_cell_count:
                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::AlphaCellCountMismatch
                        else:
                            let alpha_cells_len %i32 gui_sfnt_simple_glyph_raster_packed_mask_owner_alpha_cells_len packed_owner
                            if ne alpha_cells_len shape_cell_count:
                                then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::AlphaStorageLenMismatch
                                else:
                                    let alpha_cells_cap %i32 gui_sfnt_simple_glyph_raster_packed_mask_owner_alpha_cells_cap packed_owner
                                    if ne alpha_cells_cap shape_cell_count:
                                        then Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskStartErrorKind::AlphaStorageCapacityMismatch
                                        else Result::Ok unit

