    StepBudgetExhausted %GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner

//: gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_drain_to_complete_budget: budget 内で coverage scan を完了まで進める
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_drain_to_complete_budget %impure fn GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner impure fn i32 Result GuiSfntSimpleGlyphRenderStrokeCoverageScanTerminal GuiSfntSimpleGlyphRenderStrokeCoverageScanError \owner\remaining_steps:
    match gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_index_bounds &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_simple owner error_kind
        Result::Ok _:
            let writer_ref %&GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner field::get_ref &owner "writer"
            let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_shape writer_ref
            let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
            let cell_index %i32 gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_index &owner
            if eq cell_index cell_count:
                then:
                    let writer %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner field::get owner "writer"
                    match gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_complete writer:
                        Result::Err completion_error:
                            let completion_kind %GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionErrorKind gui_sfnt_simple_glyph_render_stroke_coverage_mask_completion_error_kind &completion_error
                            let returned_writer %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_completion_error_owner completion_error
                            let returned_owner %GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner returned_writer cell_index
                            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_with_completion returned_owner completion_kind
                        Result::Ok terminal:
                            match terminal:
                                GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionTerminal::CoverageMaskCompleted completed:
                                    Result::Ok GuiSfntSimpleGlyphRenderStrokeCoverageScanTerminal::CoverageScanCompleted completed
                                GuiSfntSimpleGlyphRenderStrokeCoverageMaskCompletionTerminal::CoverageMaskIncomplete incomplete_writer:
                                    let returned_owner %GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner incomplete_writer cell_index
                                    Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_simple returned_owner GuiSfntSimpleGlyphRenderStrokeCoverageScanErrorKind::CompletionIncomplete
                else:
                    if le remaining_steps 0:
                        then Result::Ok GuiSfntSimpleGlyphRenderStrokeCoverageScanTerminal::StepBudgetExhausted owner
                        else:
                            let old_cell_index %i32 gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_index &owner
                            let old_written_cell_count %i32 gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_writer_written_cell_count &owner
                            match gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_step owner:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok next_owner:
                                    let next_cell_index %i32 gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_index &next_owner
                                    let required_cell_index %i32 add old_cell_index 1
                                    let next_written_cell_count %i32 gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_writer_written_cell_count &next_owner
                                    let required_written_cell_count %i32 add old_written_cell_count 1
                                    if or ne next_cell_index required_cell_index ne next_written_cell_count required_written_cell_count:
                                        then Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_simple next_owner GuiSfntSimpleGlyphRenderStrokeCoverageScanErrorKind::ProgressInvariantInvalid
                                        else:
                                            let next_remaining_steps %i32 sub remaining_steps 1
                                            gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_drain_to_complete_budget next_owner next_remaining_steps

