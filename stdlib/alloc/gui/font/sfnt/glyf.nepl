//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_count_checked_add: left/right count の加算を検査する
//:
//: [目的/もくてき]:
//: - count と policy evidence の比較を 1 箇所に閉じ込めます。
//: - match と Result を使い、判定失敗を F5la の typed error へ変換します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_count_checked_add %fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRenderStrokeCoverageMaskClosureErrorKind \left\right:
    let max_i32 %i32 2147483647
    if or lt left 0 lt right 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeCoverageMaskClosureErrorKind::ProgressInvariantInvalid
        else:
            let remaining %i32 sub max_i32 left
            if gt right remaining:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeCoverageMaskClosureErrorKind::ProgressInvariantInvalid
                else Result::Ok add left right

//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_cap_eq: cap policy の一致を判定する
//:
//: [目的/もくてき]:
//: - count と policy evidence の比較を 1 箇所に閉じ込めます。
//: - match と Result を使い、判定失敗を F5la の typed error へ変換します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_cap_eq %fn GuiStrokeCap fn GuiStrokeCap bool \left\right:
    match left:
        GuiStrokeCap::Butt:
            match right:
                GuiStrokeCap::Butt:
                    true
                GuiStrokeCap::Square:
                    false
                GuiStrokeCap::Round:
                    false
        GuiStrokeCap::Square:
            match right:
                GuiStrokeCap::Butt:
                    false
                GuiStrokeCap::Square:
                    true
                GuiStrokeCap::Round:
                    false
        GuiStrokeCap::Round:
            match right:
                GuiStrokeCap::Butt:
                    false
                GuiStrokeCap::Square:
                    false
                GuiStrokeCap::Round:
                    true

//: gui_sfnt_simple_glyph_render_stroke_coverage_mask_join_eq: join policy の一致を判定する
//:
//: [目的/もくてき]:
//: - count と policy evidence の比較を 1 箇所に閉じ込めます。
//: - match と Result を使い、判定失敗を F5la の typed error へ変換します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_mask_join_eq %fn GuiStrokeJoin fn GuiStrokeJoin bool \left\right:
    match left:
        GuiStrokeJoin::Miter:
            match right:
                GuiStrokeJoin::Miter:
                    true
                GuiStrokeJoin::Bevel:
                    false
                GuiStrokeJoin::Round:
                    false
        GuiStrokeJoin::Bevel:
            match right:
                GuiStrokeJoin::Miter:
                    false
                GuiStrokeJoin::Bevel:
                    true
                GuiStrokeJoin::Round:
                    false
        GuiStrokeJoin::Round:
            match right:
                GuiStrokeJoin::Miter:
                    false
                GuiStrokeJoin::Bevel:
                    false
                GuiStrokeJoin::Round:
                    true

