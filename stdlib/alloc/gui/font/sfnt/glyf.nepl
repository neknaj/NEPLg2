//: gui_sfnt_simple_glyph_outline_storage_alloc: F5a capacity から empty outline storage owner を[確保/かくほ]する
//:
//: [目的/もくてき]:
//: - capacity shape、caller limit、scalar slot count、Vec allocation を typed Result で[分離/ぶんり]します。
//: - `InvalidCapacity` は limit check より[前/まえ]に[返/かえ]し、forged capacity を trusted rejected payload に[変換/へんかん]しません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_alloc %impure fn &GuiSfntSimpleGlyphOutlineStorageCapacity impure fn &GuiSfntSimpleGlyphOutlineStorageLimit Result GuiSfntSimpleGlyphOutlineStorage GuiSfntSimpleGlyphOutlineStorageAllocError \capacity\limit:
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid capacity:
        then:
            let none_check %Option GuiSfntSimpleGlyphOutlineCapacityCheck none
            let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::InvalidCapacity *capacity *limit none_check
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_capacity_check_limit capacity limit:
                GuiSfntSimpleGlyphOutlineCapacityCheck::Fits checked_capacity:
                    let checked %GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck::Fits checked_capacity
                    let some_checked %Option GuiSfntSimpleGlyphOutlineCapacityCheck some checked
                    match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check &checked_capacity:
                        GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits scalar_slot_count:
                            let slots_result %Result Vec i32 StdErrorKind vec::with_capacity scalar_slot_count
                            match slots_result:
                                Result::Ok slots:
                                    Result::Ok GuiSfntSimpleGlyphOutlineStorage *capacity slots scalar_slot_count
                                Result::Err _e:
                                    let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::ScalarSlotStorageAllocFailed checked_capacity *limit some_checked
                                    Result::Err error
                        GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow overflow_capacity:
                            let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::ScalarSlotCountOverflow overflow_capacity *limit some_checked
                            Result::Err error
                GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected:
                    let checked %GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck::Rejected rejected
                    let some_checked %Option GuiSfntSimpleGlyphOutlineCapacityCheck some checked
                    let rejected_capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_capacity_rejected_capacity &rejected
                    let rejected_limit %GuiSfntSimpleGlyphOutlineStorageLimit gui_sfnt_simple_glyph_outline_capacity_rejected_limit &rejected
                    let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::CapacityRejected rejected_capacity rejected_limit some_checked
                    Result::Err error
                GuiSfntSimpleGlyphOutlineCapacityCheck::InvalidTopology topology:
                    let checked %GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck::InvalidTopology topology
                    let some_checked %Option GuiSfntSimpleGlyphOutlineCapacityCheck some checked
                    let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::InvalidCapacity *capacity *limit some_checked
                    Result::Err error
                GuiSfntSimpleGlyphOutlineCapacityCheck::CommandCountOverflow topology:
                    let checked %GuiSfntSimpleGlyphOutlineCapacityCheck GuiSfntSimpleGlyphOutlineCapacityCheck::CommandCountOverflow topology
                    let some_checked %Option GuiSfntSimpleGlyphOutlineCapacityCheck some checked
                    let error %GuiSfntSimpleGlyphOutlineStorageAllocError gui_sfnt_simple_glyph_outline_storage_alloc_error GuiSfntSimpleGlyphOutlineStorageAllocErrorKind::InvalidCapacity *capacity *limit some_checked
                    Result::Err error

