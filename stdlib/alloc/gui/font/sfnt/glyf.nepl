//: gui_sfnt_simple_glyph_render_stroke_source_contour_count_checked_add: contour count 加算を i32 範囲で[検査/けんさ]する
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_source_contour_count_checked_add %fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind \left\right:
    let max_i32 %i32 2147483647
    if or lt left 0 lt right 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::ProgressInvariantInvalid
        else:
            let remaining %i32 sub max_i32 left
            if gt right remaining:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::ProgressInvariantInvalid
                else Result::Ok add left right

