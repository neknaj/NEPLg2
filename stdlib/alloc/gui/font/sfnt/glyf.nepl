fn gui_sfnt_simple_glyph_outline_storage_read_point_endpoint_marker_loop %fn &GuiSfntSimpleGlyphOutlineStorage fn &GuiSfntSimpleGlyphOutlineStorageCapacity fn i32 fn i32 fn i32 fn bool fn i32 fn bool Result GuiSfntSimpleGlyphOutlinePointEndpointMarker GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError \storage\capacity\point_index\contour_index\previous_endpoint\found\found_contour_index\found_end_of_contour:
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count capacity
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count capacity
    if ge contour_index contour_count:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointTopologyInvalid point_index
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_scalar_slot_get storage contour_index:
                Option::None:
                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointSlotMissing point_index
                    Result::Err error
                Option::Some endpoint:
                    if or lt endpoint 0 ge endpoint point_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointTopologyInvalid point_index
                            Result::Err error
                        else:
                            if le endpoint previous_endpoint:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointTopologyInvalid point_index
                                    Result::Err error
                                else:
                                    let contains_point %bool le point_index endpoint
                                    let next_found %bool if:
                                        found
                                        then:
                                            true
                                        else:
                                            contains_point
                                    let next_found_contour_index %i32 if:
                                        found
                                        then:
                                            found_contour_index
                                        else:
                                            if:
                                                contains_point
                                                then:
                                                    contour_index
                                                else:
                                                    found_contour_index
                                    let next_found_end_of_contour %bool if:
                                        found
                                        then:
                                            found_end_of_contour
                                        else:
                                            if:
                                                contains_point
                                                then:
                                                    eq point_index endpoint
                                                else:
                                                    found_end_of_contour
                                    if eq add contour_index 1 contour_count:
                                        then:
                                            let last_point_index %i32 sub point_count 1
                                            if ne endpoint last_point_index:
                                                then:
                                                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointTopologyInvalid point_index
                                                    Result::Err error
                                                else:
                                                    if not next_found:
                                                        then:
                                                            let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointTopologyInvalid point_index
                                                            Result::Err error
                                                        else:
                                                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph capacity
                                                            let marker %GuiSfntSimpleGlyphOutlinePointEndpointMarker gui_sfnt_simple_glyph_outline_point_endpoint_marker glyph point_index next_found_contour_index next_found_end_of_contour
                                                            Result::Ok marker
                                        else:
                                            gui_sfnt_simple_glyph_outline_storage_read_point_endpoint_marker_loop storage capacity point_index add contour_index 1 endpoint next_found next_found_contour_index next_found_end_of_contour

//: gui_sfnt_simple_glyph_outline_storage_read_point_endpoint_marker: storage から contour marker を[読/よ]む
