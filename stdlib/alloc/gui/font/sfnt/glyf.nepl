                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _overflow_capacity:
                    let error %GuiSfntSimpleGlyphOutlinePointCoordinateReadError gui_sfnt_simple_glyph_outline_point_coordinate_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointCoordinateReadErrorKind::StorageCapacityInvalid point_index
