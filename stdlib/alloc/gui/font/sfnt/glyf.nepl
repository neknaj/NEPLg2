//: GuiSfntGlyphSpan: `glyf` table-relative glyph byte range
//:
//: neplg2:test[skip]
struct GuiSfntGlyphSpan:
    start %i32
    end %i32

impl Clone for GuiSfntGlyphSpan:
    fn clone %fn &GuiSfntGlyphSpan GuiSfntGlyphSpan \span:
        *span

impl Copy for GuiSfntGlyphSpan:
    fn copy_mark %fn GuiSfntGlyphSpan GuiSfntGlyphSpan \span:
        span

//: gui_sfnt_glyph_span: glyph span value を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_sfnt_glyph_span %fn i32 fn i32 GuiSfntGlyphSpan \start\end:
    GuiSfntGlyphSpan start end

//: gui_sfnt_glyph_span_start: span start を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyph_span_start %fn &GuiSfntGlyphSpan i32 \span:
