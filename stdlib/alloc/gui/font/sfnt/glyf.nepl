                            Result::Err error
                        else:
                            let scalar_slots_cap %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_cap storage
                            if ne scalar_slots_cap scalar_slot_count:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::ScalarStorageCapacityMismatch point_index
                                    Result::Err error
                                else:
                                    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
                                    if or lt point_index 0 ge point_index point_count:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::PointIndexOutOfRange point_index
                                            Result::Err error
                                        else:
                                            let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                                            let scalar_slots_len %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_len storage
                                            if lt scalar_slots_len contour_count:
                                                then:
                                                    let error %GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadError gui_sfnt_simple_glyph_outline_point_endpoint_marker_read_error_from_storage storage GuiSfntSimpleGlyphOutlinePointEndpointMarkerReadErrorKind::EndpointNotReady point_index
                                                    Result::Err error
                                                else:
                                                    gui_sfnt_simple_glyph_outline_storage_read_point_endpoint_marker_loop storage &capacity point_index 0 -1 false -1 false

