                                    if ne metric_count counted_metric_count:
                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::MetricCountMismatch
                                        else:
                                            let plan_owner %&GuiSfntSimpleGlyphRenderStrokeSegmentPlanOwner field::get_ref metric_owner "plan_owner"
                                            let draw_segment_count %i32 gui_sfnt_simple_glyph_render_stroke_segment_plan_owner_draw_segment_count plan_owner
                                            if ne metric_count draw_segment_count:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::MetricCountExceeded
                                                else:
                                                    let plan_line_to_count %i32 *field::get_ref plan_owner "line_to_count"
                                                    if ne line_metric_count plan_line_to_count:
                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::LineMetricCountMismatch
                                                        else:
