                            Result::Err error
                        Result::Ok completed:
                            Result::Ok GuiSfntSimpleGlyphRasterPackedMaskPackTerminal::PackedMaskCompleted completed
                else:
                    if le remaining_steps 0:
                        then Result::Ok GuiSfntSimpleGlyphRasterPackedMaskPackTerminal::StepBudgetExhausted owner
                        else:
                            let old_cell_index %i32 gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_cell_index &owner
                            let old_alpha_cells_len %i32 gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_alpha_cells_len &owner
                            match gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_step owner:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok next_owner:
                                    let next_cell_index %i32 gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_cell_index &next_owner
                                    let required_cell_index %i32 add old_cell_index 1
                                    let next_alpha_cells_len %i32 gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_alpha_cells_len &next_owner
                                    let required_alpha_cells_len %i32 add old_alpha_cells_len 1
                                    if or ne next_cell_index required_cell_index ne next_alpha_cells_len required_alpha_cells_len:
                                        then Result::Err gui_sfnt_simple_glyph_raster_packed_mask_error_simple next_owner GuiSfntSimpleGlyphRasterPackedMaskErrorKind::ProgressInvariantInvalid
                                        else:
                                            let next_remaining_steps %i32 sub remaining_steps 1
                                            gui_sfnt_simple_glyph_raster_packed_mask_pack_owner_drain_to_complete_budget next_owner next_remaining_steps

