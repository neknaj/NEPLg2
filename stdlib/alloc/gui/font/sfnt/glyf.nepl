                                then:
                                    let error %GuiSfntSimpleGlyphContourEndpointPushError gui_sfnt_simple_glyph_contour_endpoint_push_error_no_region storage cursor endpoint previous_endpoint GuiSfntSimpleGlyphContourEndpointPushErrorKind::CursorRegionMismatch
