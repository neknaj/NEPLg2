//: gui_sfnt_glyf_checked_range: file byte range を overflow なしで[検査/けんさ]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_checked_range %fn &ByteBuf fn i32 fn i32 fn GuiSfntParseErrorKind Result unit GuiSfntParseError \bytes\offset\size\kind:
    let total %i32 io_bytebuf_len_ref bytes
    if:
        or lt offset 0 lt size 0
        then:
            Result::Err gui_sfnt_parse_error kind offset
        else:
            if:
                gt offset total
                then:
                    Result::Err gui_sfnt_parse_error kind offset
                else:
                    if:
                        gt size sub total offset
                        then:
                            Result::Err gui_sfnt_parse_error kind offset
                        else:
                            Result::Ok unit

//: gui_sfnt_glyf_read_u8: 1 byte を typed range error 付きで[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_u8 %fn &ByteBuf fn i32 fn GuiSfntParseErrorKind Result i32 GuiSfntParseError \bytes\offset\kind:
    match gui_sfnt_glyf_checked_range bytes offset 1 kind:
        Result::Err error:
            Result::Err error
        Result::Ok _:
            match io_bytebuf_byte_at bytes offset:
                Option::Some byte:
                    Result::Ok byte
                Option::None:
                    Result::Err gui_sfnt_parse_error kind offset

//: gui_sfnt_glyf_read_u16_be: big-endian u16 を i32 として[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_u16_be %fn &ByteBuf fn i32 fn GuiSfntParseErrorKind Result i32 GuiSfntParseError \bytes\offset\kind:
    match gui_sfnt_glyf_read_u8 bytes offset kind:
        Result::Err error:
            Result::Err error
        Result::Ok hi:
            match gui_sfnt_glyf_read_u8 bytes add offset 1 kind:
                Result::Err error:
                    Result::Err error
                Result::Ok lo:
                    Result::Ok add shl hi 8 lo

//: gui_sfnt_glyf_read_i16_be: big-endian i16 を符号拡張して[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_i16_be %fn &ByteBuf fn i32 fn GuiSfntParseErrorKind Result i32 GuiSfntParseError \bytes\offset\kind:
    match gui_sfnt_glyf_read_u16_be bytes offset kind:
        Result::Err error:
            Result::Err error
        Result::Ok raw:
            if:
                ge raw 32768
                then:
                    Result::Ok sub raw 65536
                else:
                    Result::Ok raw

//: gui_sfnt_glyf_read_u32_i32_be: long loca offset 用 u32 を i32 範囲内で[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_u32_i32_be %fn &ByteBuf fn i32 fn GuiSfntParseErrorKind Result i32 GuiSfntParseError \bytes\offset\kind:
    match gui_sfnt_glyf_read_u8 bytes offset kind:
        Result::Err error:
            Result::Err error
        Result::Ok b0:
            let high_byte_limit %i32 add 64 64
            if:
                ge b0 high_byte_limit
                then:
                    Result::Err gui_sfnt_parse_error kind offset
                else:
                    match gui_sfnt_glyf_read_u8 bytes add offset 1 kind:
                        Result::Err error:
                            Result::Err error
                        Result::Ok b1:
                            match gui_sfnt_glyf_read_u8 bytes add offset 2 kind:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok b2:
                                    match gui_sfnt_glyf_read_u8 bytes add offset 3 kind:
                                        Result::Err error:
                                            Result::Err error
                                        Result::Ok b3:
                                            Result::Ok or or or shl b0 24 shl b1 16 shl b2 8 b3

//: gui_sfnt_glyf_table_relative_range_is_valid: declared table length 内の相対 range か[判定/はんてい]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_table_relative_range_is_valid %fn GuiSfntTableRecord fn i32 fn i32 bool \table\offset\size:
    let table_length %i32 gui_sfnt_table_record_length &table
    if:
        or lt offset 0 lt size 0
        then:
            false
        else:
            if:
                gt offset table_length
                then:
                    false
                else:
                    le size sub table_length offset

//: gui_sfnt_glyf_glyph_relative_range_is_valid: selected glyph 内の相対 range か[判定/はんてい]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_glyph_relative_range_is_valid %fn i32 fn i32 fn i32 fn i32 bool \start\end\offset\size:
    if:
        or lt offset start lt size 0
        then:
            false
        else:
            if:
                gt offset end
                then:
                    false
                else:
                    le size sub end offset

//: gui_sfnt_glyf_stream_relative_range_is_valid: F4g stream 内の range か[判定/はんてい]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_stream_relative_range_is_valid %fn i32 fn i32 fn i32 fn i32 bool \start\length\offset\size:
    if:
        or lt length 0 lt size 0
        then:
            false
        else:
            if:
                lt offset start
                then:
                    false
                else:
                    let end %i32 add start length
                    if:
                        gt offset end
                        then:
                            false
                        else:
                            le size sub end offset

//: gui_sfnt_glyf_read_index_to_loc_format: `head.indexToLocFormat` を[読/よ]む
//:
//: [目的/もくてき]:
//: - F4a metadata の `head.length >= 20` とは分け、glyph bounds lookup だけで offset 50 を[要求/ようきゅう]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_index_to_loc_format %fn &ByteBuf fn GuiSfntTableRecord Result i32 GuiSfntParseError \bytes\head:
    if:
        lt gui_sfnt_table_record_length &head 52
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord gui_sfnt_table_record_offset &head
        else:
            gui_sfnt_glyf_read_i16_be bytes add gui_sfnt_table_record_offset &head 50 GuiSfntParseErrorKind::MalformedGlyfRecord

//: gui_sfnt_glyf_loca_required_length_is_valid: `loca` の declared length を[検査/けんさ]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_loca_required_length_is_valid %fn GuiSfntTableRecord fn i32 fn i32 bool \loca\format\num_glyphs:
    let entry_count %i32 add num_glyphs 1
    if:
        eq format 0
        then:
            le mul entry_count 2 gui_sfnt_table_record_length &loca
        else:
            if:
                eq format 1
                then:
                    le mul entry_count 4 gui_sfnt_table_record_length &loca
                else:
                    false

//: gui_sfnt_glyf_checked_glyph_raw: outline lookup 用の glyph raw range を[検査/けんさ]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_checked_glyph_raw %fn GuiGlyphId fn i32 Result i32 GuiSfntParseError \glyph\num_glyphs:
    let raw %i32 gui_glyph_id_raw &glyph
    if:
        or le raw 0 ge raw num_glyphs
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline raw
        else:
            Result::Ok raw

//: gui_sfnt_glyf_read_loca_offset: `loca` entry から glyph relative offset を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_loca_offset %fn &ByteBuf fn GuiSfntTableRecord fn i32 fn i32 Result i32 GuiSfntParseError \bytes\loca\format\index:
    if:
        eq format 0
        then:
            let relative_offset %i32 mul index 2
            if:
                not gui_sfnt_glyf_table_relative_range_is_valid loca relative_offset 2
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &loca relative_offset
                else:
                    match gui_sfnt_glyf_read_u16_be bytes add gui_sfnt_table_record_offset &loca relative_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                        Result::Err error:
                            Result::Err error
                        Result::Ok short_offset:
                            Result::Ok mul short_offset 2
        else:
            if:
                eq format 1
                then:
                    let relative_offset %i32 mul index 4
                    if:
                        not gui_sfnt_glyf_table_relative_range_is_valid loca relative_offset 4
                        then:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &loca relative_offset
                        else:
                            gui_sfnt_glyf_read_u32_i32_be bytes add gui_sfnt_table_record_offset &loca relative_offset GuiSfntParseErrorKind::MalformedGlyfRecord
                else:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::UnsupportedLocaFormat gui_sfnt_table_record_offset &loca

//: gui_sfnt_glyf_validate_offsets: glyph range が declared glyf table 内か[検査/けんさ]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_validate_offsets %fn GuiSfntTableRecord fn i32 fn i32 Result unit GuiSfntParseError \glyf\start\end:
    if:
        gt start end
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf start
        else:
            if:
                gt end gui_sfnt_table_record_length &glyf
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf end
                else:
                    if:
                        eq start end
                        then:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf start
                        else:
                            if:
                                lt sub end start 10
                                then:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf start
                                else:
                                    Result::Ok unit

//: gui_sfnt_glyf_lookup_span_with_tables: metadata 済み table から glyph byte span を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_lookup_span_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId Result GuiSfntGlyphSpan GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph:
    match gui_sfnt_glyf_read_index_to_loc_format bytes head:
        Result::Err error:
            Result::Err error
        Result::Ok format:
            if:
                not or eq format 0 eq format 1
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::UnsupportedLocaFormat add gui_sfnt_table_record_offset &head 50
                else:
                    let num_glyphs %i32 gui_sfnt_metrics_num_glyphs &metrics
                    if:
                        not gui_sfnt_glyf_loca_required_length_is_valid loca format num_glyphs
                        then:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord gui_sfnt_table_record_offset &loca
                        else:
                            match gui_sfnt_glyf_checked_glyph_raw glyph num_glyphs:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok glyph_raw:
                                    match gui_sfnt_glyf_read_loca_offset bytes loca format glyph_raw:
                                        Result::Err error:
                                            Result::Err error
                                        Result::Ok start:
                                            match gui_sfnt_glyf_read_loca_offset bytes loca format add glyph_raw 1:
                                                Result::Err error:
                                                    Result::Err error
                                                Result::Ok end:
                                                    match gui_sfnt_glyf_validate_offsets glyf start end:
                                                        Result::Err error:
                                                            Result::Err error
                                                        Result::Ok _:
                                                            Result::Ok gui_sfnt_glyph_span start end

//: gui_sfnt_glyf_bounds_from_header: glyf header 10 byte から bounds を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_bounds_from_header %fn &ByteBuf fn GuiSfntTableRecord fn GuiGlyphId fn i32 fn i32 Result GuiSfntGlyphBounds GuiSfntParseError \bytes\glyf\glyph\start\end:
    match gui_sfnt_glyf_validate_offsets glyf start end:
        Result::Err error:
            Result::Err error
        Result::Ok _:
            let file_offset %i32 add gui_sfnt_table_record_offset &glyf start
            match gui_sfnt_glyf_read_i16_be bytes file_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                Result::Err error:
                    Result::Err error
                Result::Ok _contours:
                    match gui_sfnt_glyf_read_i16_be bytes add file_offset 2 GuiSfntParseErrorKind::MalformedGlyfRecord:
                        Result::Err error:
                            Result::Err error
                        Result::Ok x_min:
                            match gui_sfnt_glyf_read_i16_be bytes add file_offset 4 GuiSfntParseErrorKind::MalformedGlyfRecord:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok y_min:
                                    match gui_sfnt_glyf_read_i16_be bytes add file_offset 6 GuiSfntParseErrorKind::MalformedGlyfRecord:
                                        Result::Err error:
                                            Result::Err error
                                        Result::Ok x_max:
                                            match gui_sfnt_glyf_read_i16_be bytes add file_offset 8 GuiSfntParseErrorKind::MalformedGlyfRecord:
                                                Result::Err error:
                                                    Result::Err error
                                                Result::Ok y_max:
                                                    if:
                                                        or gt x_min x_max gt y_min y_max
                                                        then:
                                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord file_offset
                                                        else:
                                                            Result::Ok gui_sfnt_glyph_bounds glyph x_min y_min x_max y_max

//: gui_sfnt_glyf_lookup_with_tables: metadata 済み table から glyph bounds を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_lookup_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId Result GuiSfntGlyphBounds GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph:
    match gui_sfnt_glyf_lookup_span_with_tables bytes head loca glyf metrics glyph:
        Result::Err error:
            Result::Err error
        Result::Ok span:
            gui_sfnt_glyf_bounds_from_header bytes glyf glyph gui_sfnt_glyph_span_start &span gui_sfnt_glyph_span_end &span

//: gui_sfnt_glyf_read_last_endpoint: simple glyph endpoint array を strict increasing として[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_read_last_endpoint %fn &ByteBuf fn GuiSfntTableRecord fn i32 fn i32 fn i32 fn i32 fn i32 Result i32 GuiSfntParseError \bytes\glyf\start\end\index\contour_count\previous_endpoint:
    if:
        ge index contour_count
        then:
            Result::Ok previous_endpoint
        else:
            let endpoint_offset %i32 add add start 10 mul index 2
            if:
                not gui_sfnt_glyf_glyph_relative_range_is_valid start end endpoint_offset 2
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_offset
                else:
                    match gui_sfnt_glyf_read_u16_be bytes add gui_sfnt_table_record_offset &glyf endpoint_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                        Result::Err error:
                            Result::Err error
                        Result::Ok endpoint:
                            if:
                                le endpoint previous_endpoint
                                then:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_offset
                                else:
                                    gui_sfnt_glyf_read_last_endpoint bytes glyf start end add index 1 contour_count endpoint

//: gui_sfnt_glyf_topology_from_span: checked glyph span から simple topology を[読/よ]む
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_topology_from_span %fn &ByteBuf fn GuiSfntTableRecord fn GuiGlyphId fn GuiSfntGlyphSpan Result GuiSfntSimpleGlyphTopology GuiSfntParseError \bytes\glyf\glyph\span:
    let start %i32 gui_sfnt_glyph_span_start &span
    let end %i32 gui_sfnt_glyph_span_end &span
    let file_offset %i32 add gui_sfnt_table_record_offset &glyf start
    match gui_sfnt_glyf_bounds_from_header bytes glyf glyph start end:
        Result::Err error:
            Result::Err error
        Result::Ok bounds:
            match gui_sfnt_glyf_read_i16_be bytes file_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                Result::Err error:
                    Result::Err error
                Result::Ok contour_count:
                    if:
                        lt contour_count 0
                        then:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::UnsupportedGlyphOutlineFormat file_offset
                        else:
                            if:
                                eq contour_count 0
                                then:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline file_offset
                                else:
                                    let endpoint_array_offset %i32 add start 10
                                    let endpoint_array_length %i32 mul contour_count 2
                                    if:
                                        not gui_sfnt_glyf_glyph_relative_range_is_valid start end endpoint_array_offset endpoint_array_length
                                        then:
                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_array_offset
                                        else:
                                            let initial_endpoint %i32 -1
                                            match gui_sfnt_glyf_read_last_endpoint bytes glyf start end 0 contour_count initial_endpoint:
                                                Result::Err error:
                                                    Result::Err error
                                                Result::Ok last_endpoint:
                                                    let point_count %i32 add last_endpoint 1
                                                    if:
                                                        le point_count 0
                                                        then:
                                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf endpoint_array_offset
                                                        else:
                                                            let instruction_length_offset %i32 add endpoint_array_offset endpoint_array_length
                                                            if:
                                                                not gui_sfnt_glyf_glyph_relative_range_is_valid start end instruction_length_offset 2
                                                                then:
                                                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf instruction_length_offset
                                                                else:
                                                                    match gui_sfnt_glyf_read_u16_be bytes add gui_sfnt_table_record_offset &glyf instruction_length_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                                                                        Result::Err error:
                                                                            Result::Err error
                                                                        Result::Ok instruction_length:
                                                                            let instruction_start %i32 add instruction_length_offset 2
                                                                            if:
                                                                                not gui_sfnt_glyf_glyph_relative_range_is_valid start end instruction_start instruction_length
                                                                                then:
                                                                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf instruction_start
                                                                                else:
                                                                                    let point_data_offset %i32 add instruction_start instruction_length
                                                                                    let point_data_length %i32 sub end point_data_offset
                                                                                    if:
                                                                                        le point_data_length 0
                                                                                        then:
                                                                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf point_data_offset
                                                                                        else:
                                                                                            Result::Ok gui_sfnt_simple_glyph_topology glyph bounds contour_count point_count instruction_length point_data_offset point_data_length

//: gui_sfnt_glyf_simple_topology_with_tables: metadata 済み table から simple topology を[引/ひ]く
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_simple_topology_with_tables %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntTableRecord fn GuiSfntMetrics fn GuiGlyphId Result GuiSfntSimpleGlyphTopology GuiSfntParseError \bytes\head\loca\glyf\metrics\glyph:
    match gui_sfnt_glyf_lookup_span_with_tables bytes head loca glyf metrics glyph:
        Result::Err error:
            Result::Err error
        Result::Ok span:
            gui_sfnt_glyf_topology_from_span bytes glyf glyph span

//: gui_sfnt_glyf_flag_has_bit: flag bit が[立/た]っているか[判定/はんてい]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_flag_has_bit %fn i32 fn i32 bool \flag\mask:
    not eq and flag mask 0

//: gui_sfnt_glyf_flag_x_byte_length: flag から x coordinate byte length を[求/もと]める
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_flag_x_byte_length %fn i32 i32 \flag:
    if:
        gui_sfnt_glyf_flag_has_bit flag 2
        then:
            1
        else:
            if:
                gui_sfnt_glyf_flag_has_bit flag 16
                then:
                    0
                else:
                    2

//: gui_sfnt_glyf_flag_y_byte_length: flag から y coordinate byte length を[求/もと]める
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_flag_y_byte_length %fn i32 i32 \flag:
    if:
        gui_sfnt_glyf_flag_has_bit flag 4
        then:
            1
        else:
            if:
                gui_sfnt_glyf_flag_has_bit flag 32
                then:
                    0
                else:
                    2

//: gui_sfnt_glyf_scan_flag_stream: raw flag stream を point_count まで[走査/そうさ]する
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_scan_flag_stream %fn &ByteBuf fn GuiSfntTableRecord fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 Result GuiSfntSimpleGlyphFlagScan GuiSfntParseError \bytes\glyf\flag_start\point_data_end\point_count\logical_count\cursor\x_data_length\y_data_length:
    if:
        eq logical_count point_count
        then:
            Result::Ok gui_sfnt_simple_glyph_flag_scan logical_count sub cursor flag_start x_data_length y_data_length
        else:
            if:
                not gui_sfnt_glyf_glyph_relative_range_is_valid flag_start point_data_end cursor 1
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf cursor
                else:
                    match gui_sfnt_glyf_read_u8 bytes add gui_sfnt_table_record_offset &glyf cursor GuiSfntParseErrorKind::MalformedGlyfRecord:
                        Result::Err error:
                            Result::Err error
                        Result::Ok flag:
                            let x_delta_length %i32 gui_sfnt_glyf_flag_x_byte_length flag
                            let y_delta_length %i32 gui_sfnt_glyf_flag_y_byte_length flag
                            if:
                                gui_sfnt_glyf_flag_has_bit flag 8
                                then:
                                    let repeat_count_offset %i32 add cursor 1
                                    if:
                                        not gui_sfnt_glyf_glyph_relative_range_is_valid flag_start point_data_end repeat_count_offset 1
                                        then:
                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf repeat_count_offset
                                        else:
                                            match gui_sfnt_glyf_read_u8 bytes add gui_sfnt_table_record_offset &glyf repeat_count_offset GuiSfntParseErrorKind::MalformedGlyfRecord:
                                                Result::Err error:
                                                    Result::Err error
                                                Result::Ok repeat_count:
                                                    let run_count %i32 add repeat_count 1
                                                    let next_logical_count %i32 add logical_count run_count
                                                    if:
                                                        gt next_logical_count point_count
                                                        then:
                                                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf cursor
                                                        else:
                                                            let next_x_length %i32 add x_data_length mul x_delta_length run_count
                                                            let next_y_length %i32 add y_data_length mul y_delta_length run_count
                                                            gui_sfnt_glyf_scan_flag_stream bytes glyf flag_start point_data_end point_count next_logical_count add cursor 2 next_x_length next_y_length
                                else:
                                    let next_logical_count %i32 add logical_count 1
                                    let next_x_length %i32 add x_data_length x_delta_length
                                    let next_y_length %i32 add y_data_length y_delta_length
                                    gui_sfnt_glyf_scan_flag_stream bytes glyf flag_start point_data_end point_count next_logical_count add cursor 1 next_x_length next_y_length

//: gui_sfnt_glyf_point_stream_from_topology: topology から raw point stream ranges を[作/つく]る
//:
//: neplg2:test[skip]
fn gui_sfnt_glyf_point_stream_from_topology %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphTopology Result GuiSfntSimpleGlyphPointStream GuiSfntParseError \bytes\glyf\topology:
    let flag_data_offset %i32 gui_sfnt_simple_glyph_topology_point_data_offset &topology
    let point_data_length %i32 gui_sfnt_simple_glyph_topology_point_data_length &topology
    let point_data_end %i32 add flag_data_offset point_data_length
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    match gui_sfnt_glyf_scan_flag_stream bytes glyf flag_data_offset point_data_end point_count 0 flag_data_offset 0 0:
        Result::Err error:
            Result::Err error
        Result::Ok scan:
            let flag_data_length %i32 gui_sfnt_simple_glyph_flag_scan_raw_length &scan
            if:
                le flag_data_length 0
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf flag_data_offset
                else:
                    let x_data_offset %i32 add flag_data_offset flag_data_length
                    let x_data_length %i32 gui_sfnt_simple_glyph_flag_scan_x_data_length &scan
                    let y_data_offset %i32 add x_data_offset x_data_length
                    let y_data_length %i32 gui_sfnt_simple_glyph_flag_scan_y_data_length &scan
                    let trailing_data_offset %i32 add y_data_offset y_data_length
                    let trailing_data_length %i32 sub point_data_end trailing_data_offset
                    if:
                        lt trailing_data_length 0
                        then:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf trailing_data_offset
                        else:
                            Result::Ok gui_sfnt_simple_glyph_point_stream topology flag_data_offset flag_data_length x_data_offset x_data_length y_data_offset y_data_length trailing_data_offset trailing_data_length

