            let render_owner %GuiSfntSimpleGlyphRenderFillAlphaMaskOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_owner edge_owner shape alpha_cells cell_count alpha_max origin fill_paint blend
            Result::Ok render_owner

