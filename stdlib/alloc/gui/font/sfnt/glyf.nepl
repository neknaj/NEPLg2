//: gui_sfnt_simple_glyph_render_stroke_source_metric_provenance_from_value_with_span: command value と contour span から provenance を[作/つく]る
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_source_metric_provenance_from_value_with_span %fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollection fn i32 fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandValue fn GuiSfntSimpleGlyphPathCommandTag Result GuiSfntSimpleGlyphRenderStrokeSourceMetricProvenance GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind \collection\metric_index\value\command_tag:
    let path_command_index %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_sink_action_path_command_value_path_command_index value
    let edge_index %i32 *field::get_ref value "edge_index"
    let contour_index %i32 *field::get_ref value "contour_index"
    let contour_edge_index %i32 *field::get_ref value "contour_edge_index"
    let event_slot %GuiSfntSimpleGlyphPathSinkEventSlot *field::get_ref value "event_slot"
    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_span collection contour_index:
        Result::Err _span_error:
            Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::ContourSpanSourceFailed
        Result::Ok span:
            let span_index %i32 gui_sfnt_simple_glyph_contour_span_index &span
            let span_start_edge_index %i32 gui_sfnt_simple_glyph_contour_span_start_point_index &span
            let span_end_edge_index %i32 gui_sfnt_simple_glyph_contour_span_end_point_index &span
            let span_edge_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
            let expected_edge_count %i32 add sub span_end_edge_index span_start_edge_index 1
            let expected_contour_edge_index %i32 sub edge_index span_start_edge_index
            let span_index_ok %bool eq span_index contour_index
            let span_count_ok %bool eq span_edge_count expected_edge_count
            let edge_lower_ok %bool not lt edge_index span_start_edge_index
            let edge_upper_ok %bool not gt edge_index span_end_edge_index
            let contour_edge_ok %bool eq contour_edge_index expected_contour_edge_index
            let span_edge_ok %bool and edge_lower_ok edge_upper_ok
            let span_shape_ok %bool and span_index_ok and span_count_ok and span_edge_ok contour_edge_ok
            if not span_shape_ok:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeSourceContourErrorKind::ContourSpanInvariantMismatch
                else:
                    let provenance %GuiSfntSimpleGlyphRenderStrokeSourceMetricProvenance gui_sfnt_simple_glyph_render_stroke_source_metric_provenance metric_index path_command_index edge_index contour_index contour_edge_index span_start_edge_index span_end_edge_index span_edge_count event_slot command_tag
                    Result::Ok provenance

//: gui_sfnt_simple_glyph_render_stroke_source_contour_drain_owner_start: metric owner と command stream から contour drain owner を[開始/かいし]する
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_source_contour_drain_owner_start %impure fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollection impure fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathSinkActionPathCommandTagCompleteOwner impure fn GuiSfntSimpleGlyphRenderStrokeSourceSegmentMetricOwner Result GuiSfntSimpleGlyphRenderStrokeSourceContourDrainOwner GuiSfntSimpleGlyphRenderStrokeSourceContourOwnerStartError \collection\path_command_tag_owner\metric_owner:
