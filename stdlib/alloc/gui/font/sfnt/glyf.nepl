//: gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_step: coverage scan を 1 cell 進めて writer に push する
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_step %impure fn GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner Result GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner GuiSfntSimpleGlyphRenderStrokeCoverageScanError \owner:
    match gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_index_bounds &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_simple owner error_kind
        Result::Ok _:
            match gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner_cell_coverage &owner:
                Result::Err error_kind:
                    Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_simple owner error_kind
                Result::Ok coverage:
                    let cell_index %i32 field::get owner "cell_index"
                    let writer %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner field::get owner "writer"
                    match gui_sfnt_simple_glyph_render_stroke_coverage_mask_writer_owner_push_cell writer coverage:
                        Result::Err push_error:
                            let push_kind %GuiSfntSimpleGlyphRenderStrokeCoverageMaskPushErrorKind gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_kind &push_error
                            let returned_writer %GuiSfntSimpleGlyphRenderStrokeCoverageMaskWriterOwner gui_sfnt_simple_glyph_render_stroke_coverage_mask_push_error_owner push_error
                            let returned_owner %GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner returned_writer cell_index
                            Result::Err gui_sfnt_simple_glyph_render_stroke_coverage_scan_error_with_push returned_owner push_kind
                        Result::Ok next_writer:
                            let next_cell_index %i32 add cell_index 1
                            let next_owner %GuiSfntSimpleGlyphRenderStrokeCoverageScanOwner gui_sfnt_simple_glyph_render_stroke_coverage_scan_owner next_writer next_cell_index
                            Result::Ok next_owner

