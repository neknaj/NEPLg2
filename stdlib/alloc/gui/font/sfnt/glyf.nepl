                                    let edges %&Vec GuiSfntSimpleGlyphRasterEdge field::get_ref edge_owner "edges"
                                    match vec::get edges edge_index:
                                        Option::Some edge:
                                            Result::Ok edge
                                        Option::None:
                                            Result::Err GuiSfntSimpleGlyphRasterCoverageScanErrorKind::EdgeSlotMissing

fn gui_sfnt_simple_glyph_raster_coverage_scan_sample_coordinate %fn i32 fn i32 fn i32 fn i32 i64 \origin_x2\cell_axis_index\sample_axis_index\sample_scale:
    let two %i64 cast 2
    let origin %i64 cast origin_x2
    let cell %i64 cast cell_axis_index
    let sample %i64 cast sample_axis_index
    let scale %i64 cast sample_scale
    let cell_offset %i64 mul cell two
    let base_x2 %i64 add origin cell_offset
    let base_scaled %i64 mul base_x2 scale
    let sample_offset %i64 add mul sample two %i64 cast 1
    add base_scaled sample_offset

fn gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate %fn i32 fn i32 i64 \coordinate_x2\sample_scale:
    mul %i64 cast coordinate_x2 %i64 cast sample_scale

fn gui_sfnt_simple_glyph_raster_coverage_scan_line_crosses_scaled %fn i64 fn i64 fn i64 fn i64 fn i64 fn i64 bool \sample_x\sample_y\x0\y0\x1\y1:
    let y0_above %bool gt y0 sample_y
    let y1_above %bool gt y1 sample_y
    let same_side %bool if y0_above:
        then y1_above
        else not y1_above
    if same_side:
        then false
        else:
            let dy %i64 sub y1 y0
            if eq dy %i64 cast 0:
                then false
                else:
                    let left %i64 mul sub sample_x x0 dy
                    let right %i64 mul sub x1 x0 sub sample_y y0
                    if gt dy %i64 cast 0:
                        then lt left right
                        else gt left right

fn gui_sfnt_simple_glyph_raster_coverage_scan_line_edge_crosses %fn &GuiSfntSimpleGlyphRasterLineEdge fn &GuiSfntSimpleGlyphRasterCoverageShape fn i64 fn i64 bool \edge\shape\sample_x\sample_y:
    let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_shape_sample_scale shape
    let start_x2 %i32 *field::get_ref edge "start_x2"
    let start_y2 %i32 *field::get_ref edge "start_y2"
    let end_x2 %i32 *field::get_ref edge "end_x2"
    let end_y2 %i32 *field::get_ref edge "end_y2"
    let x0 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate start_x2 sample_scale
    let y0 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate start_y2 sample_scale
    let x1 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate end_x2 sample_scale
    let y1 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate end_y2 sample_scale
    gui_sfnt_simple_glyph_raster_coverage_scan_line_crosses_scaled sample_x sample_y x0 y0 x1 y1

fn gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_point_scaled %fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 i64 \p0_x2\p1_x2\p2_x2\segment_index\segment_count\sample_scale:
    let n %i64 cast segment_count
    let t %i64 cast segment_index
    let inv %i64 sub n t
    let inv2 %i64 mul inv inv
    let t2 %i64 mul t t
    let two %i64 cast 2
    let p0 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate p0_x2 sample_scale
    let p1 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate p1_x2 sample_scale
    let p2 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_scaled_edge_coordinate p2_x2 sample_scale
    let term0 %i64 mul inv2 p0
    let term1 %i64 mul mul mul two inv t p1
    let term2 %i64 mul t2 p2
    let numerator %i64 add add term0 term1 term2
    let denominator %i64 mul n n
    div_s numerator denominator

fn gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_edge_crossing_count %fn &GuiSfntSimpleGlyphRasterQuadraticEdge fn &GuiSfntSimpleGlyphRasterCoverageShape fn &GuiSfntSimpleGlyphRasterCoverageScanConfig fn i64 fn i64 fn i32 fn i32 i32 \edge\shape\config\sample_x\sample_y\segment_index\crossing_count:
    let segment_count %i32 gui_sfnt_simple_glyph_raster_coverage_scan_config_quadratic_segment_count config
    if ge segment_index segment_count:
        then crossing_count
        else:
            let start_x2 %i32 *field::get_ref edge "start_x2"
            let start_y2 %i32 *field::get_ref edge "start_y2"
            let control_x2 %i32 *field::get_ref edge "control_x2"
            let control_y2 %i32 *field::get_ref edge "control_y2"
            let end_x2 %i32 *field::get_ref edge "end_x2"
            let end_y2 %i32 *field::get_ref edge "end_y2"
            let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_shape_sample_scale shape
            let next_segment_index %i32 add segment_index 1
            let x0 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_point_scaled start_x2 control_x2 end_x2 segment_index segment_count sample_scale
            let y0 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_point_scaled start_y2 control_y2 end_y2 segment_index segment_count sample_scale
            let x1 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_point_scaled start_x2 control_x2 end_x2 next_segment_index segment_count sample_scale
            let y1 %i64 gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_point_scaled start_y2 control_y2 end_y2 next_segment_index segment_count sample_scale
            let crosses %bool gui_sfnt_simple_glyph_raster_coverage_scan_line_crosses_scaled sample_x sample_y x0 y0 x1 y1
            let next_crossing_count %i32 if crosses:
                then add crossing_count 1
                else crossing_count
            gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_edge_crossing_count edge shape config sample_x sample_y next_segment_index next_crossing_count

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_edge_crossing_count %fn &GuiSfntSimpleGlyphRasterCoverageScanOwner fn i64 fn i64 fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRasterCoverageScanErrorKind \owner\sample_x\sample_y\edge_index\crossing_count:
    let writer %&GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get_ref owner "writer"
    let edge_owner %&GuiSfntSimpleGlyphOutlinePointStreamItemCollectionRasterEdgeOwner field::get_ref writer "edge_owner"
    let edge_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_raster_edge_owner_edge_count edge_owner
    if ge edge_index edge_count:
        then Result::Ok crossing_count
        else:
            match gui_sfnt_simple_glyph_raster_coverage_scan_owner_read_edge owner edge_index:
                Result::Err error_kind:
                    Result::Err error_kind
                Result::Ok edge:
                    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_shape writer
                    let config %&GuiSfntSimpleGlyphRasterCoverageScanConfig field::get_ref owner "config"
                    match edge:
                        GuiSfntSimpleGlyphRasterEdge::Line line_edge:
                            let crosses %bool gui_sfnt_simple_glyph_raster_coverage_scan_line_edge_crosses &line_edge &shape sample_x sample_y
                            let next_crossing_count %i32 if crosses:
                                then add crossing_count 1
                                else crossing_count
                            gui_sfnt_simple_glyph_raster_coverage_scan_owner_edge_crossing_count owner sample_x sample_y add edge_index 1 next_crossing_count
                        GuiSfntSimpleGlyphRasterEdge::Quadratic quadratic_edge:
                            let added_crossing_count %i32 gui_sfnt_simple_glyph_raster_coverage_scan_quadratic_edge_crossing_count &quadratic_edge &shape config sample_x sample_y 0 0
                            let next_crossing_count %i32 add crossing_count added_crossing_count
                            gui_sfnt_simple_glyph_raster_coverage_scan_owner_edge_crossing_count owner sample_x sample_y add edge_index 1 next_crossing_count

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_sample_inside %fn &GuiSfntSimpleGlyphRasterCoverageScanOwner fn i64 fn i64 Result bool GuiSfntSimpleGlyphRasterCoverageScanErrorKind \owner\sample_x\sample_y:
    match gui_sfnt_simple_glyph_raster_coverage_scan_owner_edge_crossing_count owner sample_x sample_y 0 0:
        Result::Err error_kind:
            Result::Err error_kind
        Result::Ok crossing_count:
            Result::Ok eq rem_s crossing_count 2 1

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_x_loop %fn &GuiSfntSimpleGlyphRasterCoverageScanOwner fn i32 fn i32 fn i32 fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRasterCoverageScanErrorKind \owner\cell_x\cell_y\sample_y_index\sample_x_index\coverage:
    let writer %&GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get_ref owner "writer"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_shape writer
    let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_shape_sample_scale &shape
    if ge sample_x_index sample_scale:
        then Result::Ok coverage
        else:
            let origin_x2 %i32 gui_sfnt_simple_glyph_raster_coverage_shape_origin_x2 &shape
            let origin_y2 %i32 gui_sfnt_simple_glyph_raster_coverage_shape_origin_y2 &shape
            let sample_x %i64 gui_sfnt_simple_glyph_raster_coverage_scan_sample_coordinate origin_x2 cell_x sample_x_index sample_scale
            let sample_y %i64 gui_sfnt_simple_glyph_raster_coverage_scan_sample_coordinate origin_y2 cell_y sample_y_index sample_scale
            match gui_sfnt_simple_glyph_raster_coverage_scan_owner_sample_inside owner sample_x sample_y:
                Result::Err error_kind:
                    Result::Err error_kind
                Result::Ok inside:
                    let next_coverage %i32 if inside:
                        then add coverage 1
                        else coverage
                    gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_x_loop owner cell_x cell_y sample_y_index add sample_x_index 1 next_coverage

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_y_loop %fn &GuiSfntSimpleGlyphRasterCoverageScanOwner fn i32 fn i32 fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRasterCoverageScanErrorKind \owner\cell_x\cell_y\sample_y_index\coverage:
    let writer %&GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get_ref owner "writer"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_shape writer
    let sample_scale %i32 gui_sfnt_simple_glyph_raster_coverage_shape_sample_scale &shape
    if ge sample_y_index sample_scale:
        then Result::Ok coverage
        else:
            match gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_x_loop owner cell_x cell_y sample_y_index 0 coverage:
                Result::Err error_kind:
                    Result::Err error_kind
                Result::Ok row_coverage:
                    gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_y_loop owner cell_x cell_y add sample_y_index 1 row_coverage

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_coverage %fn &GuiSfntSimpleGlyphRasterCoverageScanOwner Result i32 GuiSfntSimpleGlyphRasterCoverageScanErrorKind \owner:
    let cell_index %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index owner
    let writer %&GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get_ref owner "writer"
    let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_shape writer
    let width_px %i32 gui_sfnt_simple_glyph_raster_coverage_shape_width_px &shape
    let cell_x %i32 rem_s cell_index width_px
    let cell_y %i32 div_s cell_index width_px
    gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_sample_y_loop owner cell_x cell_y 0 0

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_step %impure fn GuiSfntSimpleGlyphRasterCoverageScanOwner Result GuiSfntSimpleGlyphRasterCoverageScanOwner GuiSfntSimpleGlyphRasterCoverageScanError \owner:
    match gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index_bounds &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_simple owner error_kind
        Result::Ok _:
            match gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_coverage &owner:
                Result::Err error_kind:
                    Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_simple owner error_kind
                Result::Ok coverage:
                    let cell_index %i32 field::get owner "cell_index"
                    let config %GuiSfntSimpleGlyphRasterCoverageScanConfig field::get owner "config"
                    let writer %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get owner "writer"
                    match gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_push_cell writer coverage:
                        Result::Err push_error:
                            let push_kind %GuiSfntSimpleGlyphRasterCoveragePushErrorKind *field::get_ref &push_error "kind"
                            let returned_writer %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner gui_sfnt_simple_glyph_raster_coverage_push_error_owner push_error
                            let returned_owner %GuiSfntSimpleGlyphRasterCoverageScanOwner gui_sfnt_simple_glyph_raster_coverage_scan_owner returned_writer config cell_index
                            Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_with_push returned_owner push_kind
                        Result::Ok next_writer:
                            let next_cell_index %i32 add cell_index 1
                            let next_owner %GuiSfntSimpleGlyphRasterCoverageScanOwner gui_sfnt_simple_glyph_raster_coverage_scan_owner next_writer config next_cell_index
                            Result::Ok next_owner

//: GuiSfntSimpleGlyphRasterCoverageScanTerminal: bounded scan drain terminal
//:
//: neplg2:test[skip]
enum GuiSfntSimpleGlyphRasterCoverageScanTerminal:
    CoverageScanCompleted %GuiSfntSimpleGlyphRasterCoverageMaskOwner
    StepBudgetExhausted %GuiSfntSimpleGlyphRasterCoverageScanOwner

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_drain_to_complete_budget %impure fn GuiSfntSimpleGlyphRasterCoverageScanOwner impure fn i32 Result GuiSfntSimpleGlyphRasterCoverageScanTerminal GuiSfntSimpleGlyphRasterCoverageScanError \owner\remaining_steps:
    match gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index_bounds &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_simple owner error_kind
        Result::Ok _:
            let writer_ref %&GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get_ref &owner "writer"
            let shape %GuiSfntSimpleGlyphRasterCoverageShape gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_shape writer_ref
            let cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_shape_cell_count &shape
            let cell_index %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index &owner
            if eq cell_index cell_count:
                then:
                    let config %GuiSfntSimpleGlyphRasterCoverageScanConfig field::get owner "config"
                    let writer %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get owner "writer"
                    match gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_complete writer:
                        Result::Err completion_error:
                            let completion_kind %GuiSfntSimpleGlyphRasterCoverageCompletionErrorKind *field::get_ref &completion_error "kind"
                            let returned_writer %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner gui_sfnt_simple_glyph_raster_coverage_completion_error_owner completion_error
                            let returned_owner %GuiSfntSimpleGlyphRasterCoverageScanOwner gui_sfnt_simple_glyph_raster_coverage_scan_owner returned_writer config cell_index
                            Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_with_completion returned_owner completion_kind
                        Result::Ok terminal:
                            match terminal:
                                GuiSfntSimpleGlyphRasterCoverageCompletionTerminal::CoverageMaskCompleted completed:
                                    Result::Ok GuiSfntSimpleGlyphRasterCoverageScanTerminal::CoverageScanCompleted completed
                                GuiSfntSimpleGlyphRasterCoverageCompletionTerminal::CoverageMaskIncomplete incomplete_writer:
                                    let returned_owner %GuiSfntSimpleGlyphRasterCoverageScanOwner gui_sfnt_simple_glyph_raster_coverage_scan_owner incomplete_writer config cell_index
                                    Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_simple returned_owner GuiSfntSimpleGlyphRasterCoverageScanErrorKind::CompletionIncomplete
                else:
                    if le remaining_steps 0:
                        then Result::Ok GuiSfntSimpleGlyphRasterCoverageScanTerminal::StepBudgetExhausted owner
                        else:
                            let old_cell_index %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index &owner
                            let old_written_cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_writer_written_cell_count &owner
                            match gui_sfnt_simple_glyph_raster_coverage_scan_owner_step owner:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok next_owner:
                                    let next_cell_index %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_cell_index &next_owner
                                    let required_cell_index %i32 add old_cell_index 1
                                    let next_written_cell_count %i32 gui_sfnt_simple_glyph_raster_coverage_scan_owner_writer_written_cell_count &next_owner
                                    let required_written_cell_count %i32 add old_written_cell_count 1
                                    if or ne next_cell_index required_cell_index ne next_written_cell_count required_written_cell_count:
                                        then Result::Err gui_sfnt_simple_glyph_raster_coverage_scan_error_simple next_owner GuiSfntSimpleGlyphRasterCoverageScanErrorKind::ProgressInvariantInvalid
                                        else:
                                            let next_remaining_steps %i32 sub remaining_steps 1
                                            gui_sfnt_simple_glyph_raster_coverage_scan_owner_drain_to_complete_budget next_owner next_remaining_steps

fn gui_sfnt_simple_glyph_raster_coverage_scan_owner_free %impure fn GuiSfntSimpleGlyphRasterCoverageScanOwner unit \owner:
    let writer %GuiSfntSimpleGlyphRasterCoverageMaskWriterOwner field::get owner "writer"
    gui_sfnt_simple_glyph_raster_coverage_mask_writer_owner_free writer

fn gui_sfnt_simple_glyph_raster_coverage_scan_terminal_free %impure fn GuiSfntSimpleGlyphRasterCoverageScanTerminal unit \terminal:
    match terminal:
        GuiSfntSimpleGlyphRasterCoverageScanTerminal::CoverageScanCompleted completed:
            gui_sfnt_simple_glyph_raster_coverage_mask_owner_free completed
        GuiSfntSimpleGlyphRasterCoverageScanTerminal::StepBudgetExhausted owner:
            gui_sfnt_simple_glyph_raster_coverage_scan_owner_free owner

