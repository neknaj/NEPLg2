//: neplg2:test[skip]
pub fn gui_sfnt_lookup_simple_glyph_point_stream %fn &ByteBuf fn Option i32 fn GuiGlyphId Result GuiSfntSimpleGlyphPointStream GuiSfntParseError \bytes\face_index\glyph:
    match gui_sfnt_parse_metadata bytes face_index:
