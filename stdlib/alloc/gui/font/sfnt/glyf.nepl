                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point_error_with_span_empty GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointErrorKind::ContourPointInvariantInvalid contour_index contour_point_index absolute_point_index capacity span item_count items_len items_cap
                                    Result::Err error
