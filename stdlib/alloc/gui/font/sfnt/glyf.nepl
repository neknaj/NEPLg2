//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_completion_invariants %fn &GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner Result unit GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \owner:
    match gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_local_invariants owner:
        Result::Err error_kind:
            Result::Err error_kind
        Result::Ok _:
            let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref owner "side_edge_owner"
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
            let side_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_side_edge_index owner
            if ne side_edge_index side_edge_count:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionSideEdgeIndexMismatch
                else:
                    let join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_join_count owner
                    if ne join_count side_edge_count:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionJoinCountMismatch
                        else:
                            let left_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_left_join_count owner
                            let left_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_left_side_edge_count side_edge_owner
                            if ne left_join_count left_side_edge_count:
                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionLeftJoinCountMismatch
                                else:
                                    let right_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_right_join_count owner
                                    let right_side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_right_side_edge_count side_edge_owner
                                    if ne right_join_count right_side_edge_count:
                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionRightJoinCountMismatch
                                        else:
                                            let joins_len %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_joins_len owner
                                            if ne joins_len side_edge_count:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionStorageLenMismatch
                                                else:
                                                    let joins_cap %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_joins_cap owner
                                                    if ne joins_cap side_edge_count:
                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::CompletionStorageCapacityMismatch
                                                        else Result::Ok unit

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_start: F5kz closure drain を開始する
//:
//: [目的/もくてき]:
//: - completed F5ky owner を唯一の authority とし、1 side edge につき 1 join record だけを進めます。
//: - Vec の所有権と progress count を Result で運び、失敗時も復旧用 owner を保持します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_start %impure fn GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwnerStartError \side_edge_owner:
    match gui_sfnt_simple_glyph_render_stroke_side_edge_owner_invariants_for_closure &side_edge_owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_start_error_source_failed side_edge_owner error_kind
        Result::Ok _:
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count &side_edge_owner
            let joins_result %Result Vec GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord StdErrorKind vec::with_capacity side_edge_count
            match joins_result:
                Result::Err storage_error_value:
                    Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_start_error_storage_failed side_edge_owner storage_error_value
                Result::Ok joins:
                    let joins_len %i32 vec::len &joins
                    if ne joins_len 0:
                        then:
                            vec::free joins
                            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwnerStartErrorKind::JoinStorageInitialLenMismatch side_edge_owner
                        else:
                            let joins_cap %i32 vec::cap &joins
                            if ne joins_cap side_edge_count:
                                then:
                                    vec::free joins
                                    Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_owner_start_error_simple GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwnerStartErrorKind::JoinStorageCapacityMismatch side_edge_owner
                                else:
                                    let stroke %GuiStroke gui_sfnt_simple_glyph_render_stroke_edge_closure_style_from_side_edge_owner &side_edge_owner
                                    let cap_policy %GuiStrokeCap gui_stroke_cap &stroke
                                    let cap_resolution %GuiSfntSimpleGlyphRenderStrokeCapResolution GuiSfntSimpleGlyphRenderStrokeCapResolution::ClosedContourNoCap
                                    let join_policy %GuiStrokeJoin gui_stroke_join &stroke
                                    let miter_limit %f32 gui_stroke_miter_limit &stroke
                                    let owner %GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner side_edge_owner joins 0 0 0 0 cap_policy cap_resolution join_policy miter_limit
                                    Result::Ok owner

//: gui_sfnt_simple_glyph_render_stroke_side_edge_owner_read_edge_for_closure: F5ky side edge record を closure 用に読む
//:
//: [目的/もくてき]:
//: - F5kz closure owner boundary の小さな helper として責務を局所化します。
//: - typed value を返し、暗黙の補正や別 authority への遡りを行いません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_side_edge_owner_read_edge_for_closure %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner fn i32 Result GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \side_edge_owner\side_edge_index:
    if lt side_edge_index 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexNegative
        else:
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
            if ge side_edge_index side_edge_count:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexOutOfRange
                else:
                    let edges_len %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_edges_len side_edge_owner
                    if ne edges_len side_edge_count:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeStorageLenMismatch
                        else:
                            let edges_cap %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_edges_cap side_edge_owner
                            if ne edges_cap side_edge_count:
                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SourceSideEdgeStorageCapacityMismatch
                                else:
                                    let edges %&Vec GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord field::get_ref side_edge_owner "edges"
                                    match vec::get edges side_edge_index:
                                        Option::Some edge:
                                            Result::Ok edge
                                        Option::None:
                                            Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeSlotMissing

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_find_next_side_edge_index: join の接続先 side edge index を探す
//:
//: [目的/もくてき]:
//: - 同じ contour / side の候補だけを走査し、Left は次、Right は前の edge_index を優先します。
//: - 直接隣接が無い場合だけ contour wrap 候補を使い、endpoint 座標一致では復元しません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_find_next_side_edge_index %fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord Result i32 GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \side_edge_owner\current_edge:
    let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
    let current_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure current_edge
    let current_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_edge_index_for_closure current_edge
    let mut scan_index %i32 0
    let mut primary_found %bool false
    let mut primary_side_edge_index %i32 -1
    let mut primary_edge_index %i32 0
    let mut wrap_found %bool false
    let mut wrap_side_edge_index %i32 -1
    let mut wrap_edge_index %i32 0
    let mut failed %bool false
    let mut final_error_kind %GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSuccessorMissing
    let mut done %bool false
    while not done:
        do:
            if ge scan_index side_edge_count:
                then:
                    set done true
                else:
                    match gui_sfnt_simple_glyph_render_stroke_side_edge_owner_read_edge_for_closure side_edge_owner scan_index:
                        Result::Err error_kind:
                            set failed true
                            set final_error_kind error_kind
                            set done true
                        Result::Ok candidate:
                            if gui_sfnt_simple_glyph_render_stroke_edge_closure_candidate_matches current_edge &candidate:
                                then:
                                    let candidate_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_edge_index_for_closure &candidate
                                    match current_side:
                                        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
                                            if gt candidate_edge_index current_edge_index:
                                                then:
                                                    if or not primary_found lt candidate_edge_index primary_edge_index:
                                                        then:
                                                            set primary_found true
                                                            set primary_side_edge_index scan_index
                                                            set primary_edge_index candidate_edge_index
                                                        else unit
                                                else:
                                                    if or not wrap_found lt candidate_edge_index wrap_edge_index:
                                                        then:
                                                            set wrap_found true
                                                            set wrap_side_edge_index scan_index
                                                            set wrap_edge_index candidate_edge_index
                                                        else unit
                                        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
                                            if lt candidate_edge_index current_edge_index:
                                                then:
                                                    if or not primary_found gt candidate_edge_index primary_edge_index:
                                                        then:
                                                            set primary_found true
                                                            set primary_side_edge_index scan_index
                                                            set primary_edge_index candidate_edge_index
                                                        else unit
                                                else:
                                                    if or not wrap_found gt candidate_edge_index wrap_edge_index:
                                                        then:
                                                            set wrap_found true
                                                            set wrap_side_edge_index scan_index
                                                            set wrap_edge_index candidate_edge_index
                                                        else unit
                                else unit
                            set scan_index add scan_index 1
    if failed:
        then Result::Err final_error_kind
        else:
            if primary_found:
                then Result::Ok primary_side_edge_index
                else:
                    if wrap_found:
                        then Result::Ok wrap_side_edge_index
                        else Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSuccessorMissing

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_from_edges: source edge order から adjacency evidence を作る
//:
//: [目的/もくてき]:
//: - contour 内 edge_index の距離から Direct / Skipped / Wrap / SelfTarget と gap 数を決めます。
//: - gap 数が負にならないことを Result で検査し、曖昧な join を作りません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_from_edges %fn GuiSfntSimpleGlyphRenderStrokeEdgeSide fn i32 fn i32 fn i32 fn i32 fn i32 Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacencyEvidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \side\from_edge_index\to_edge_index\contour_start_edge_index\contour_end_edge_index\contour_edge_count:
    if lt contour_edge_count 1:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourSpanMismatch
        else:
            if or lt from_edge_index contour_start_edge_index gt from_edge_index contour_end_edge_index:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourSpanMismatch
                else:
                    if or lt to_edge_index contour_start_edge_index gt to_edge_index contour_end_edge_index:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourSpanMismatch
                        else:
                            if eq from_edge_index to_edge_index:
                                then:
                                    let source_edge_gap_count %i32 sub contour_edge_count 1
                                    gui_sfnt_simple_glyph_render_stroke_edge_closure_gap_evidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget source_edge_gap_count
                                else:
                                    match side:
                                        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
                                            if gt to_edge_index from_edge_index:
                                                then:
                                                    let distance %i32 sub to_edge_index from_edge_index
                                                    gui_sfnt_simple_glyph_render_stroke_edge_closure_non_wrap_evidence distance
                                                else:
                                                    let from_to_end %i32 sub contour_end_edge_index from_edge_index
                                                    let start_to_to %i32 sub to_edge_index contour_start_edge_index
                                                    let distance %i32 add add from_to_end start_to_to 1
                                                    gui_sfnt_simple_glyph_render_stroke_edge_closure_wrap_evidence distance
                                        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
                                            if lt to_edge_index from_edge_index:
                                                then:
                                                    let distance %i32 sub from_edge_index to_edge_index
                                                    gui_sfnt_simple_glyph_render_stroke_edge_closure_non_wrap_evidence distance
                                                else:
                                                    let start_to_from %i32 sub from_edge_index contour_start_edge_index
                                                    let to_to_end %i32 sub contour_end_edge_index to_edge_index
                                                    let distance %i32 add add start_to_from to_to_end 1
                                                    gui_sfnt_simple_glyph_render_stroke_edge_closure_wrap_evidence distance

//: gui_sfnt_simple_glyph_render_stroke_join_closure_record_from_edges: side edge 2 つから join closure record を作る
//:
//: [目的/もくてき]:
//: - from/to side edge の metric、edge、contour、endpoint、join/miter policy を 1 record に束ねます。
//: - 形状化は行わず、次 boundary が同じ根拠を再検査できる evidence だけを残します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_closure_record_from_edges %fn i32 fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord fn i32 fn &GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord fn GuiStrokeJoin fn f32 Result GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \from_side_edge_index\from_edge\to_side_edge_index\to_edge\join_policy\miter_limit:
    let from_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure from_edge
    let to_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure to_edge
    if not gui_sfnt_simple_glyph_render_stroke_edge_closure_side_eq from_side to_side:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSideMismatch
        else:
            if not gui_sfnt_simple_glyph_render_stroke_side_edge_records_share_contour_for_closure from_edge to_edge:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourMismatch
                else:
                    let contour_start_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_start_edge_index_for_closure from_edge
                    let contour_end_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_end_edge_index_for_closure from_edge
                    let contour_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_edge_count_for_closure from_edge
                    let expected_edge_count %i32 add sub contour_end_edge_index contour_start_edge_index 1
                    if ne contour_edge_count expected_edge_count:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourSpanMismatch
                        else:
                            let from_metric_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_metric_index_for_closure from_edge
                            let to_metric_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_metric_index_for_closure to_edge
                            let from_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_edge_index_for_closure from_edge
                            let to_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_edge_index_for_closure to_edge
                            let contour_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_index_for_closure from_edge
                            let from_contour_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_edge_index_for_closure from_edge
                            let to_contour_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_contour_edge_index_for_closure to_edge
                            let from_end_x2 %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_end_x2_for_closure from_edge
                            let from_end_y2 %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_end_y2_for_closure from_edge
                            let to_start_x2 %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_start_x2_for_closure to_edge
                            let to_start_y2 %f32 gui_sfnt_simple_glyph_render_stroke_side_edge_record_start_y2_for_closure to_edge
                            match gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_from_edges from_side from_edge_index to_edge_index contour_start_edge_index contour_end_edge_index contour_edge_count:
                                Result::Err error_kind:
                                    Result::Err error_kind
                                Result::Ok adjacency_evidence:
                                    let adjacency %GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency field::get adjacency_evidence "adjacency"
                                    let source_edge_gap_count %i32 field::get adjacency_evidence "source_edge_gap_count"
                                    let record %GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord gui_sfnt_simple_glyph_render_stroke_join_closure_record from_side_edge_index to_side_edge_index from_metric_index to_metric_index from_edge_index to_edge_index contour_index from_contour_edge_index to_contour_edge_index contour_start_edge_index contour_end_edge_index contour_edge_count adjacency source_edge_gap_count from_side join_policy miter_limit from_end_x2 from_end_y2 to_start_x2 to_start_y2
                                    Result::Ok record

//: gui_sfnt_simple_glyph_render_stroke_join_closure_record_invariants: F5kz closure invariant を検査する
//:
//: [目的/もくてき]:
//: - count、Vec len/cap、left/right の分解、progress index の整合を Result で返します。
//: - 不整合は typed error kind に閉じ込め、owner の状態を暗黙に補正しません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_join_closure_record_invariants %fn &GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord fn i32 Result unit GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \record\side_edge_count:
    let from_side_edge_index %i32 *field::get_ref record "from_side_edge_index"
    if or lt from_side_edge_index 0 ge from_side_edge_index side_edge_count:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexOutOfRange
        else:
            let to_side_edge_index %i32 *field::get_ref record "to_side_edge_index"
            if or lt to_side_edge_index 0 ge to_side_edge_index side_edge_count:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::SideEdgeIndexOutOfRange
                else:
                    let contour_start_edge_index %i32 *field::get_ref record "contour_start_edge_index"
                    let contour_end_edge_index %i32 *field::get_ref record "contour_end_edge_index"
                    let contour_edge_count %i32 *field::get_ref record "contour_edge_count"
                    let expected_edge_count %i32 add sub contour_end_edge_index contour_start_edge_index 1
                    if ne contour_edge_count expected_edge_count:
                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinContourSpanMismatch
                        else:
                            let source_edge_gap_count %i32 *field::get_ref record "source_edge_gap_count"
                            if lt source_edge_gap_count 0:
                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSourceEdgeGapNegative
                                else:
                                    let side %GuiSfntSimpleGlyphRenderStrokeEdgeSide *field::get_ref record "side"
                                    let from_edge_index %i32 *field::get_ref record "from_edge_index"
                                    let to_edge_index %i32 *field::get_ref record "to_edge_index"
                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_from_edges side from_edge_index to_edge_index contour_start_edge_index contour_end_edge_index contour_edge_count:
                                        Result::Err error_kind:
                                            Result::Err error_kind
                                        Result::Ok expected_evidence:
                                            let expected_adjacency %GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency field::get expected_evidence "adjacency"
                                            let expected_gap_count %i32 field::get expected_evidence "source_edge_gap_count"
                                            let adjacency %GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency *field::get_ref record "adjacency"
                                            if not gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_eq expected_adjacency adjacency:
                                                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinAdjacencyMismatch
                                                else:
                                                    if ne expected_gap_count source_edge_gap_count:
                                                        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSourceEdgeGapMismatch
                                                        else Result::Ok unit

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_join: join closure record を drain owner に積む
//:
//: [目的/もくてき]:
//: - completed F5ky owner を唯一の authority とし、1 side edge につき 1 join record だけを進めます。
//: - Vec の所有権と progress count を Result で運び、失敗時も復旧用 owner を保持します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_join %impure fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner impure fn GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord impure fn i32 impure fn i32 impure fn i32 impure fn i32 Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainError \owner\join\next_side_edge_index\next_join_count\next_left_join_count\next_right_join_count:
    let previous_side_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_side_edge_index &owner
    let previous_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_join_count &owner
    let previous_left_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_left_join_count &owner
    let previous_right_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_right_join_count &owner
    let side_edge_owner_ref %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref &owner "side_edge_owner"
    let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner_ref
    match gui_sfnt_simple_glyph_render_stroke_join_closure_record_invariants &join side_edge_count:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_with_side_edge error_kind owner previous_side_edge_index
        Result::Ok _:
            let side_edge_owner %GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get owner "side_edge_owner"
            let joins %Vec GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord field::get owner "joins"
            let cap_policy %GuiStrokeCap field::get owner "cap_policy"
            let cap_resolution %GuiSfntSimpleGlyphRenderStrokeCapResolution field::get owner "cap_resolution"
            let join_policy %GuiStrokeJoin field::get owner "join_policy"
            let miter_limit %f32 field::get owner "miter_limit"
            match vec::push joins join:
                Result::Ok next_joins:
                    let next_owner %GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner side_edge_owner next_joins next_side_edge_index next_join_count next_left_join_count next_right_join_count cap_policy cap_resolution join_policy miter_limit
                    Result::Ok next_owner
                Result::Err push_error:
                    let storage_error_value %StdErrorKind vec::vec_push_error_kind &push_error
                    let returned_joins %Vec GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord vec::vec_push_error_vec push_error
                    let returned_owner %GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner side_edge_owner returned_joins previous_side_edge_index previous_join_count previous_left_join_count previous_right_join_count cap_policy cap_resolution join_policy miter_limit
                    Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_push_failed returned_owner join storage_error_value

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_current: 現在の side edge から join を 1 つ積む
//:
//: [目的/もくてき]:
//: - completed F5ky owner を唯一の authority とし、1 side edge につき 1 join record だけを進めます。
//: - Vec の所有権と progress count を Result で運び、失敗時も復旧用 owner を保持します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_current %impure fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner impure fn GuiSfntSimpleGlyphRenderStrokeSideEdgeRecord Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainTerminal GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainError \owner\from_edge:
    let side_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_side_edge_index &owner
    let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref &owner "side_edge_owner"
    match gui_sfnt_simple_glyph_render_stroke_edge_closure_find_next_side_edge_index side_edge_owner &from_edge:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_with_side_edge error_kind owner side_edge_index
        Result::Ok to_side_edge_index:
            match gui_sfnt_simple_glyph_render_stroke_side_edge_owner_read_edge_for_closure side_edge_owner to_side_edge_index:
                Result::Err _error_kind:
                    Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_with_side_edge GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSuccessorReadFailed owner side_edge_index
                Result::Ok to_edge:
                    let join_policy %GuiStrokeJoin *field::get_ref &owner "join_policy"
                    let miter_limit %f32 *field::get_ref &owner "miter_limit"
                    match gui_sfnt_simple_glyph_render_stroke_join_closure_record_from_edges side_edge_index &from_edge to_side_edge_index &to_edge join_policy miter_limit:
                        Result::Err error_kind:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_with_side_edge error_kind owner side_edge_index
                        Result::Ok join:
                            let join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_join_count &owner
                            let left_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_left_join_count &owner
                            let right_join_count %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_right_join_count &owner
                            let next_side_edge_index %i32 add side_edge_index 1
                            let next_join_count %i32 add join_count 1
                            let from_side %GuiSfntSimpleGlyphRenderStrokeEdgeSide gui_sfnt_simple_glyph_render_stroke_side_edge_record_side_for_closure &from_edge
                            match from_side:
                                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
                                    let next_left_join_count %i32 add left_join_count 1
                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_join owner join next_side_edge_index next_join_count next_left_join_count right_join_count:
                                        Result::Err error:
                                            Result::Err error
                                        Result::Ok next_owner:
                                            Result::Ok GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainTerminal::JoinPushed next_owner
                                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
                                    let next_right_join_count %i32 add right_join_count 1
                                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_join owner join next_side_edge_index next_join_count left_join_count next_right_join_count:
                                        Result::Err error:
                                            Result::Err error
                                        Result::Ok next_owner:
                                            Result::Ok GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainTerminal::JoinPushed next_owner

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_step: F5kz closure drain を 1 step 進める
//:
//: [目的/もくてき]:
//: - completed F5ky owner を唯一の authority とし、1 side edge につき 1 join record だけを進めます。
//: - Vec の所有権と progress count を Result で運び、失敗時も復旧用 owner を保持します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_step %impure fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainOwner Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainTerminal GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainError \owner:
    match gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_local_invariants &owner:
        Result::Err error_kind:
            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_simple error_kind owner
        Result::Ok _:
            let side_edge_index %i32 gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_side_edge_index &owner
            let side_edge_owner %&GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get_ref &owner "side_edge_owner"
            let side_edge_count %i32 gui_sfnt_simple_glyph_render_stroke_side_edge_owner_side_edge_count side_edge_owner
            if eq side_edge_index side_edge_count:
                then:
                    match gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_completion_invariants &owner:
                        Result::Err error_kind:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_simple error_kind owner
                        Result::Ok _:
                            let side_edge_owner_value %GuiSfntSimpleGlyphRenderStrokeSideEdgeOwner field::get owner "side_edge_owner"
                            let joins %Vec GuiSfntSimpleGlyphRenderStrokeJoinClosureRecord field::get owner "joins"
                            let join_count %i32 field::get owner "join_count"
                            let left_join_count %i32 field::get owner "left_join_count"
                            let right_join_count %i32 field::get owner "right_join_count"
                            let cap_policy %GuiStrokeCap field::get owner "cap_policy"
                            let cap_resolution %GuiSfntSimpleGlyphRenderStrokeCapResolution field::get owner "cap_resolution"
                            let join_policy %GuiStrokeJoin field::get owner "join_policy"
                            let miter_limit %f32 field::get owner "miter_limit"
                            let completed_owner %GuiSfntSimpleGlyphRenderStrokeEdgeClosureOwner gui_sfnt_simple_glyph_render_stroke_edge_closure_owner side_edge_owner_value joins side_edge_count join_count left_join_count right_join_count cap_policy cap_resolution join_policy miter_limit
                            Result::Ok GuiSfntSimpleGlyphRenderStrokeEdgeClosureDrainTerminal::Completed completed_owner
                else:
                    match gui_sfnt_simple_glyph_render_stroke_side_edge_owner_read_edge_for_closure side_edge_owner side_edge_index:
                        Result::Err error_kind:
                            Result::Err gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_error_with_side_edge error_kind owner side_edge_index
                        Result::Ok from_edge:
                            gui_sfnt_simple_glyph_render_stroke_edge_closure_drain_owner_push_current owner from_edge

