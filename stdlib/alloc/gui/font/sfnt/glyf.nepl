    GuiSfntSimpleGlyphRenderStrokeSegmentPlanOwner request_owner origin fill stroke blend path_command_count move_to_count line_to_count quadratic_to_count skip_no_segment_count draw_segment_count path_sink_scalar_count stroke_width

