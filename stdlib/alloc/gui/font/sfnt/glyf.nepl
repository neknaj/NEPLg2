//: gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid: F5a capacity shape が[信頼/しんらい]できるか[調/しら]べる
//:
//: [目的/もくてき]:
//: - public constructor で forged capacity が[作/つく]られても、capacity exceeded として[包装/ほうそう]する[前/まえ]に[不正/ふせい]を[検出/けんしゅつ]します。
//: - `point_count * 2` を[計算/けいさん]する[前/まえ]に `point_count <= 1073741823` を[確認/かくにん]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid %fn &GuiSfntSimpleGlyphOutlineStorageCapacity bool \capacity:
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count capacity
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count capacity
    if or or le contour_count 0 le point_count 0 gt contour_count point_count:
        then false
        else:
            if gt point_count 1073741823:
                then false
                else:
                    let edge_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_edge_count capacity
                    let path_command_pair_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_path_command_pair_count capacity
                    let path_command_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count capacity
                    let expected_path_command_count %i32 mul point_count 2
                    let edge_ok %bool eq edge_count point_count
                    let pair_ok %bool eq path_command_pair_count point_count
                    let command_ok %bool eq path_command_count expected_path_command_count
                    and edge_ok and pair_ok command_ok

//: gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check: scalar slot count が i32 に[収/おさ]まるか[調/しら]べる
//:
//: [目的/もくてき]:
//: - contour endpoint、x、y、edge、path command tag の slot 数を staged residual guard で[検査/けんさ]します。
//: - overflow する[場合/ばあい]は allocation を[試/ため]さず enum branch を[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check %fn &GuiSfntSimpleGlyphOutlineStorageCapacity GuiSfntSimpleGlyphOutlineScalarSlotCountCheck \capacity:
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count capacity
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count capacity
    let edge_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_edge_count capacity
    let path_command_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_path_command_count capacity
    let max_i32 %i32 2147483647
    if gt contour_count max_i32:
        then GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow *capacity
        else:
            let remaining_after_contours %i32 sub max_i32 contour_count
            if gt point_count remaining_after_contours:
                then GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow *capacity
                else:
                    let remaining_after_x %i32 sub remaining_after_contours point_count
                    if gt point_count remaining_after_x:
                        then GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow *capacity
                        else:
                            let remaining_after_y %i32 sub remaining_after_x point_count
                            if gt edge_count remaining_after_y:
                                then GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow *capacity
                                else:
                                    let remaining_after_edges %i32 sub remaining_after_y edge_count
                                    if gt path_command_count remaining_after_edges:
                                        then GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow *capacity
                                        else:
                                            let scalar_slot_count %i32 add contour_count add point_count add point_count add edge_count path_command_count
                                            GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits scalar_slot_count

