//: gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge: collection から contour-local edge を[読/よ]む
//:
//: [契約/けいやく]:
//: - F5v contour span lookup を exactly once [呼/よ]び、span invariant を[再検査/さいけんさ]してから edge index を[判定/はんてい]します。
//: - edge index が[範囲外/はんいがい]の[場合/ばあい]、start/end point は[読/よ]みません。
//: - start/end は F5w contour point lookup だけで[読/よ]み、成功後に span、local index、absolute point index を[再検査/さいけんさ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge %fn &GuiSfntSimpleGlyphOutlinePointStreamItemCollection fn i32 fn i32 Result GuiSfntSimpleGlyphContourEdge GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError \collection\contour_index\edge_index:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity collection
    let item_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count collection
    let items_len %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_len collection
    let items_cap %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_cap collection
    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_span collection contour_index:
        Result::Err span_error_value:
            let span %Option GuiSfntSimpleGlyphContourSpan none
            let span_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourSpanError some span_error_value
            let start_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError none
            let end_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError none
            let start %Option GuiSfntSimpleGlyphContourPoint none
            let end %Option GuiSfntSimpleGlyphContourPoint none
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge_error GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeErrorKind::ContourSpanFailed contour_index edge_index -1 capacity span span_error start_error end_error start end item_count items_len items_cap
            Result::Err error
        Result::Ok span:
            let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
            let capacity_glyph_raw %i32 gui_glyph_id_raw &capacity_glyph
            let capacity_point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
            let span_glyph %GuiGlyphId gui_sfnt_simple_glyph_contour_span_glyph &span
            let span_glyph_raw %i32 gui_glyph_id_raw &span_glyph
            let span_index %i32 gui_sfnt_simple_glyph_contour_span_index &span
            let span_start_point_index %i32 gui_sfnt_simple_glyph_contour_span_start_point_index &span
            let span_end_point_index %i32 gui_sfnt_simple_glyph_contour_span_end_point_index &span
            let span_point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
            let expected_span_point_count %i32 add sub span_end_point_index span_start_point_index 1
            let span_glyph_ok %bool eq span_glyph_raw capacity_glyph_raw
            let span_index_ok %bool eq span_index contour_index
            let span_start_ok %bool not lt span_start_point_index 0
            let span_end_order_ok %bool not lt span_end_point_index span_start_point_index
            let span_end_capacity_ok %bool lt span_end_point_index capacity_point_count
            let span_point_count_ok %bool eq span_point_count expected_span_point_count
            let span_identity_ok %bool and span_glyph_ok span_index_ok
            let span_range_left_ok %bool and span_start_ok span_end_order_ok
            let span_range_right_ok %bool and span_end_capacity_ok span_point_count_ok
            let span_shape_ok %bool and span_identity_ok and span_range_left_ok span_range_right_ok
            if not span_shape_ok:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge_error_with_span_empty GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeErrorKind::ContourEdgeInvariantInvalid contour_index edge_index -1 capacity span item_count items_len items_cap
                    Result::Err error
                else:
                    if or lt edge_index 0 ge edge_index span_point_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge_error_with_span_empty GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeErrorKind::EdgeIndexOutOfRange contour_index edge_index -1 capacity span item_count items_len items_cap
                            Result::Err error
                        else:
                            let next_contour_point_index %i32 if:
                                eq add edge_index 1 span_point_count
                                then:
                                    0
                                else:
                                    add edge_index 1
                            match gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point collection contour_index edge_index:
                                Result::Err start_error_value:
                                    let span_option %Option GuiSfntSimpleGlyphContourSpan some span
                                    let span_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourSpanError none
                                    let start_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError some start_error_value
                                    let end_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError none
                                    let start %Option GuiSfntSimpleGlyphContourPoint none
                                    let end %Option GuiSfntSimpleGlyphContourPoint none
                                    let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_edge_error GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourEdgeErrorKind::StartPointFailed contour_index edge_index next_contour_point_index capacity span_option span_error start_error end_error start end item_count items_len items_cap
                                    Result::Err error
                                Result::Ok start:
                                    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point collection contour_index next_contour_point_index:
                                        Result::Err end_error_value:
                                            let span_option %Option GuiSfntSimpleGlyphContourSpan some span
                                            let span_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourSpanError none
                                            let start_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError none
                                            let end_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError some end_error_value
                                            let start_option %Option GuiSfntSimpleGlyphContourPoint some start
