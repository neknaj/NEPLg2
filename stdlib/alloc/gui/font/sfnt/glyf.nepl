    if:
        not gui_sfnt_glyf_stream_relative_range_is_valid start length offset 1
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf offset
        else:
            gui_sfnt_glyf_read_u8 bytes add gui_sfnt_table_record_offset &glyf offset GuiSfntParseErrorKind::MalformedGlyfRecord

