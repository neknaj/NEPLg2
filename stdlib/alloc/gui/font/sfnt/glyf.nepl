//: gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add: closure count の加算を検査する
//:
//: [目的/もくてき]:
//: - match と Result を使って分岐を明示し、bool や count の意味を局所化します。
//: - closure の direction / contour / gap 判定を 1 箇所に寄せ、呼び出し側の分岐を浅くします。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_count_checked_add %fn i32 fn i32 Result i32 GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \left\right:
    let max_i32 %i32 2147483647
    if or lt left 0 lt right 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::ProgressInvariantInvalid
        else:
            let remaining %i32 sub max_i32 left
            if gt right remaining:
                then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::ProgressInvariantInvalid
                else Result::Ok add left right

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_side_eq: stroke side enum の一致を判定する
//:
//: [目的/もくてき]:
//: - match と Result を使って分岐を明示し、bool や count の意味を局所化します。
//: - closure の direction / contour / gap 判定を 1 箇所に寄せ、呼び出し側の分岐を浅くします。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_side_eq %fn GuiSfntSimpleGlyphRenderStrokeEdgeSide fn GuiSfntSimpleGlyphRenderStrokeEdgeSide bool \left\right:
    match left:
        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
                    true
                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
                    false
        GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Left:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeSide::Right:
                    true

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_eq: adjacency enum の一致を判定する
//:
//: [目的/もくてき]:
//: - match と Result を使って分岐を明示し、bool や count の意味を局所化します。
//: - closure の direction / contour / gap 判定を 1 箇所に寄せ、呼び出し側の分岐を浅くします。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_eq %fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency bool \left\right:
    match left:
        GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor:
                    true
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::ContourWrap:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget:
                    false
        GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange:
                    true
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::ContourWrap:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget:
                    false
        GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::ContourWrap:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::ContourWrap:
                    true
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget:
                    false
        GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget:
            match right:
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::ContourWrap:
                    false
                GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SelfTarget:
                    true

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_gap_evidence: adjacency と gap count を束ねる
//:
//: [目的/もくてき]:
//: - contour 内 edge_index の距離から Direct / Skipped / Wrap / SelfTarget と gap 数を決めます。
//: - gap 数が負にならないことを Result で検査し、曖昧な join を作りません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_gap_evidence %fn GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency fn i32 Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacencyEvidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \adjacency\source_edge_gap_count:
    if lt source_edge_gap_count 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinSourceEdgeGapNegative
        else Result::Ok gui_sfnt_simple_glyph_render_stroke_edge_closure_adjacency_evidence adjacency source_edge_gap_count

//: gui_sfnt_simple_glyph_render_stroke_edge_closure_non_wrap_evidence: wrap しない source edge gap evidence を作る
//:
//: [目的/もくてき]:
//: - contour 内 edge_index の距離から Direct / Skipped / Wrap / SelfTarget と gap 数を決めます。
//: - gap 数が負にならないことを Result で検査し、曖昧な join を作りません。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_render_stroke_edge_closure_non_wrap_evidence %fn i32 Result GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacencyEvidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind \distance:
    if le distance 0:
        then Result::Err GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind::JoinDirectionMismatch
        else:
            if eq distance 1:
                then gui_sfnt_simple_glyph_render_stroke_edge_closure_gap_evidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::DirectNeighbor 0
                else:
                    let source_edge_gap_count %i32 sub distance 1
                    gui_sfnt_simple_glyph_render_stroke_edge_closure_gap_evidence GuiSfntSimpleGlyphRenderStrokeEdgeClosureAdjacency::SkippedNoSegmentRange source_edge_gap_count

