                                            let read_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError some read_error_value
                                            let item %Option GuiSfntSimpleGlyphOutlinePointStreamItem none
                                            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointError gui_sfnt_simple_glyph_outline_point_stream_item_collection_contour_point_error GuiSfntSimpleGlyphOutlinePointStreamItemCollectionContourPointErrorKind::ItemReadFailed contour_index contour_point_index absolute_point_index capacity span_option span_error read_error item item_count items_len items_cap
                                            Result::Err error
                                        Result::Ok item_value:
