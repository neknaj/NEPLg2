//: gui_sfnt_simple_glyph_outline_storage_push_region_scalar: typed region cursor に scalar value を 1 件[追加/ついか]する
//:
//: [契約/けいやく]:
//: - capacity shape、scalar slot count、storage Vec cap、cursor shape、storage/cursor sync を[検査/けんさ]してから F5c push helper を 1 回だけ[呼/よ]びます。
//: - storage `len` と cursor `next_index` の[同期/どうき]を[確認/かくにん]してから `RegionFull` を[判定/はんてい]するため、forged full cursor over empty storage を full と[誤分類/ごぶんるい]しません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_outline_storage_push_region_scalar %impure fn GuiSfntSimpleGlyphOutlineStorage impure fn GuiSfntSimpleGlyphOutlineScalarRegionCursor impure fn i32 Result GuiSfntSimpleGlyphOutlineRegionPush GuiSfntSimpleGlyphOutlineRegionPushError \storage\cursor\value:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity &storage
    let scalar_slot_count %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slot_count &storage
    let scalar_slots_len %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_len &storage
    let scalar_slots_cap %i32 gui_sfnt_simple_glyph_outline_storage_scalar_slots_cap &storage
    let none_push_error %Option StdErrorKind none
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::StorageCapacityInvalid none_push_error
            Result::Err error
        else:
            match gui_sfnt_simple_glyph_outline_storage_scalar_slot_count_check &capacity:
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Fits expected_scalar_slot_count:
                    if or ne scalar_slot_count expected_scalar_slot_count ne scalar_slots_cap scalar_slot_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::StorageCapacityInvalid none_push_error
                            Result::Err error
                        else:
                            if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_is_well_formed &cursor:
                                then:
                                    let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::CursorInvalid none_push_error
                                    Result::Err error
                                else:
                                    if not gui_sfnt_simple_glyph_outline_scalar_region_cursor_matches_valid_capacity &cursor &capacity:
                                        then:
                                            let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::CursorRegionMismatch none_push_error
                                            Result::Err error
                                        else:
                                            let next_index %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_next_index &cursor
                                            if ne scalar_slots_len next_index:
                                                then:
                                                    let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::StorageCursorMismatch none_push_error
                                                    Result::Err error
                                                else:
                                                    let end %i32 gui_sfnt_simple_glyph_outline_scalar_region_cursor_end &cursor
                                                    if ge next_index end:
                                                        then:
                                                            let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::RegionFull none_push_error
                                                            Result::Err error
                                                        else:
                                                            match gui_sfnt_simple_glyph_outline_storage_push_scalar_slot storage value:
                                                                Result::Ok next_storage:
                                                                    let next_cursor %GuiSfntSimpleGlyphOutlineScalarRegionCursor gui_sfnt_simple_glyph_outline_scalar_region_cursor_advance_after_push &cursor
                                                                    let pushed %GuiSfntSimpleGlyphOutlineRegionPush gui_sfnt_simple_glyph_outline_region_push next_storage next_cursor
                                                                    Result::Ok pushed
                                                                Result::Err push_error:
                                                                    let push_error_kind_value %StdErrorKind gui_sfnt_simple_glyph_outline_storage_push_error_kind &push_error
                                                                    let returned_storage %GuiSfntSimpleGlyphOutlineStorage gui_sfnt_simple_glyph_outline_storage_push_error_storage push_error
                                                                    let push_error_kind %Option StdErrorKind some push_error_kind_value
                                                                    let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error returned_storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::StoragePushFailed push_error_kind
                                                                    Result::Err error
                GuiSfntSimpleGlyphOutlineScalarSlotCountCheck::Overflow _overflow_capacity:
                    let error %GuiSfntSimpleGlyphOutlineRegionPushError gui_sfnt_simple_glyph_outline_region_push_error storage cursor value GuiSfntSimpleGlyphOutlineRegionPushErrorKind::StorageCapacityInvalid none_push_error
                    Result::Err error

