            let directory %GuiSfntDirectory gui_sfnt_metadata_directory &metadata
            let metrics %GuiSfntMetrics gui_sfnt_metadata_metrics &metadata
            match gui_sfnt_directory_head &directory:
                Option::None:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                Option::Some head:
                    match gui_sfnt_directory_loca &directory:
                        Option::None:
                            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                        Option::Some loca:
                            match gui_sfnt_directory_glyf &directory:
                                Option::None:
                                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
                                Option::Some glyf:
                                    gui_sfnt_glyf_simple_point_with_tables bytes head loca glyf metrics glyph point_index

//: gui_sfnt_lookup_simple_glyph_contour_span: SFNT glyf から simple glyph の contour span を[読/よ]む
//:
//: [目的/もくてき]:
//: - F4f の checked topology を通して、指定 contour が参照する inclusive point range を[返/かえ]します。
