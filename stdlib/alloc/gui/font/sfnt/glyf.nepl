                                            set final_is_end step_is_end
                                            set final_cursor step_cursor
                                            set done true
                                        else:
                                            if ne step_budget 1:
                                                then:
                                                    set final_is_error true
                                                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
                                                    set final_item_drain_error none
                                                    set final_item_drain_result some drain
                                                    set final_push_error_kind none
                                                    set final_push_storage_error none
                                                    set final_rejected_item none
                                                    set final_cursor current_cursor
                                                    set done true
                                                else:
                                                    match gui_sfnt_simple_glyph_outline_point_stream_item_drain_summary_last_item &step_summary:
                                                        Option::None:
                                                            set final_is_error true
                                                            set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::ItemDrainInvariantInvalid
                                                            set final_item_drain_error none
                                                            set final_item_drain_result some drain
                                                            set final_push_error_kind none
                                                            set final_push_storage_error none
                                                            set final_rejected_item none
                                                            set final_cursor current_cursor
                                                            set done true
                                                        Option::Some item:
                                                            match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push current_collection item:
                                                                Result::Ok next_collection:
                                                                    set current_collection next_collection
                                                                    set current_cursor step_cursor
                                                                    set current_items_read add current_items_read 1
                                                                    set current_last_item some item
                                                                    set current_remaining_steps sub current_remaining_steps 1
                                                                    if step_is_end:
                                                                        then:
                                                                            set final_is_error false
                                                                            set final_is_end true
                                                                            set final_cursor current_cursor
                                                                            set done true
                                                                        else:
                                                                            if le current_remaining_steps 0:
                                                                                then:
                                                                                    set final_is_error false
                                                                                    set final_is_end false
                                                                                    set final_cursor current_cursor
                                                                                    set done true
                                                                                else:
                                                                                    set done false
                                                                Result::Err push_error:
                                                                    let push_kind %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPushErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_kind &push_error
                                                                    let push_storage %Option StdErrorKind gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_storage_error &push_error
                                                                    let rejected_item_value %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_item &push_error
                                                                    let recovered_collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection push_error
                                                                    set current_collection recovered_collection
                                                                    set final_is_error true
                                                                    set final_error_kind GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainErrorKind::CollectionPushFailed
                                                                    set final_item_drain_error none
                                                                    set final_item_drain_result some drain
                                                                    set final_push_error_kind some push_kind
                                                                    set final_push_storage_error push_storage
                                                                    set final_rejected_item some rejected_item_value
                                                                    set final_cursor current_cursor
                                                                    set done true
    if final_is_error:
        then:
            let error %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainError gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_error current_collection final_cursor current_items_read current_last_item final_error_kind final_item_drain_error final_item_drain_result final_push_error_kind final_push_storage_error final_rejected_item
            Result::Err error
        else:
            let summary %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrainSummary gui_sfnt_simple_glyph_outline_point_stream_item_collection_drain_summary current_collection final_cursor current_items_read current_last_item
            if final_is_end:
                then:
                    Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrain::End summary
                else:
                    Result::Ok GuiSfntSimpleGlyphOutlinePointStreamItemCollectionDrain::StepBudgetExhausted summary

