//: GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind: stroke closure failure reason
//:
//: neplg2:test[skip]
enum GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind:
    SourceSideEdgeOwnerInvariantFailed
    SourceSideEdgeCountNegative
    SourceLineSideEdgeCountNegative
    SourceQuadraticSideEdgeCountNegative
    SourceLeftSideEdgeCountNegative
    SourceRightSideEdgeCountNegative
    SourceSideEdgeCountMismatch
    SourceLineQuadraticSideEdgeCountMismatch
    SourceLeftRightSideEdgeCountMismatch
    SourceLeftSideEdgeCountMismatch
    SourceRightSideEdgeCountMismatch
    SourceSideEdgeStorageLenMismatch
    SourceSideEdgeStorageCapacityMismatch
    JoinStorageInitialLenMismatch
    JoinStorageCapacityMismatch
    SideEdgeIndexNegative
    SideEdgeIndexOutOfRange
    SideEdgeSlotMissing
    JoinCountNegative
    LeftJoinCountNegative
    RightJoinCountNegative
    JoinCountMismatch
    LeftRightJoinCountMismatch
    LeftJoinCountExceeded
    RightJoinCountExceeded
    JoinStorageLenMismatch
    JoinStorageCapacityMismatch
    JoinSuccessorMissing
    JoinSuccessorReadFailed
    JoinContourMismatch
    JoinSideMismatch
    JoinContourSpanMismatch
    JoinDirectionMismatch
    JoinAdjacencyMismatch
    JoinSourceEdgeGapMismatch
    JoinSourceEdgeGapNegative
    JoinPushFailed
    CompletionSideEdgeIndexMismatch
    CompletionJoinCountMismatch
    CompletionLeftJoinCountMismatch
    CompletionRightJoinCountMismatch
    CompletionStorageLenMismatch
    CompletionStorageCapacityMismatch
    ProgressInvariantInvalid

impl Clone for GuiSfntSimpleGlyphRenderStrokeEdgeClosureErrorKind:
