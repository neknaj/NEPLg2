fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_step_once %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner Result GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainStepError \owner:
    let prepared_ref %&GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get_ref &owner "prepared"
    let surface_ref %&GuiRgba8888SoftwareSurfaceOwner field::get_ref &owner "surface"
    match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_validate_start prepared_ref surface_ref:
        Result::Err kind:
            Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
        Result::Ok _:
            match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_rederive_record prepared_ref:
                Result::Err kind:
                    Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
                Result::Ok record:
                    let cell_index %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_cell_index &owner
                    if lt cell_index 0:
                        then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::CellIndexNegative owner
                        else:
                            let cell_count %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_cell_count &record
                            if ge cell_index cell_count:
                                then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::CellIndexOutOfRange owner
                                else:
                                    match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_read_alpha &owner cell_index:
                                        Result::Err kind:
                                            Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
                                        Result::Ok alpha:
                                            match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_position &record cell_index:
                                                Result::Err kind:
                                                    Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
                                                Result::Ok position:
                                                    let x %i32 gui_point_x &position
                                                    let y %i32 gui_point_y &position
                                                    match gui_rgba8888_software_surface_read_pixel surface_ref x y:
                                                        Result::Err surface_kind:
                                                            Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error:
                                                                GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::SurfaceReadFailed surface_kind
                                                                owner
                                                        Result::Ok dest_color:
                                                            let paint %GuiPaint gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_paint &record
                                                            let source_color %Rgba8888 gui_paint_color &paint
                                                            let alpha_max %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_alpha_max &record
                                                            match gui_rgba8888_source_over_alpha_mask &source_color alpha alpha_max &dest_color:
                                                                Result::Err composite_kind:
                                                                    Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error:
                                                                        GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::SourceOverFailed composite_kind
                                                                        owner
                                                                Result::Ok out_color:
                                                                    let prepared %GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get owner "prepared"
                                                                    let surface %GuiRgba8888SoftwareSurfaceOwner field::get owner "surface"
                                                                    match gui_rgba8888_software_surface_write_pixel surface x y out_color:
                                                                        Result::Err write_error:
                                                                            let surface_kind %GuiRgba8888SoftwareSurfaceErrorKind gui_rgba8888_software_surface_write_error_kind &write_error
                                                                            let recovered_surface %GuiRgba8888SoftwareSurfaceOwner gui_rgba8888_software_surface_write_error_surface write_error
                                                                            let recovered_owner %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner prepared recovered_surface cell_index
                                                                            Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error:
                                                                                GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::SurfaceWriteFailed surface_kind
                                                                                recovered_owner
                                                                        Result::Ok next_surface:
                                                                            let next_cell_index %i32 add cell_index 1
                                                                            let next_owner %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner prepared next_surface next_cell_index
                                                                            Result::Ok next_owner

