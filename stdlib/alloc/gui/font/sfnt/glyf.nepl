        then:
            let error %GuiSfntSimpleGlyphOutlinePointReadCursorValidationReject gui_sfnt_simple_glyph_outline_point_read_cursor_validation_reject GuiSfntSimpleGlyphOutlinePointReadCursorValidationRejectKind::StorageCapacityInvalid cursor capacity topology
            Result::Err error
        else:
            let capacity_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
            let topology_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
            if not gui_sfnt_simple_glyph_outline_point_read_glyphs_match &capacity_glyph &topology_glyph:
                then:
                    let error %GuiSfntSimpleGlyphOutlinePointReadCursorValidationReject gui_sfnt_simple_glyph_outline_point_read_cursor_validation_reject GuiSfntSimpleGlyphOutlinePointReadCursorValidationRejectKind::StorageStreamGlyphMismatch cursor capacity topology
                    Result::Err error
                else:
                    let capacity_contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
                    let topology_contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
                    if ne capacity_contour_count topology_contour_count:
                        then:
                            let error %GuiSfntSimpleGlyphOutlinePointReadCursorValidationReject gui_sfnt_simple_glyph_outline_point_read_cursor_validation_reject GuiSfntSimpleGlyphOutlinePointReadCursorValidationRejectKind::StorageStreamContourCountMismatch cursor capacity topology
                            Result::Err error
