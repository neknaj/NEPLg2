fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_to_complete_budget %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner impure fn i32 Result GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainStepError \owner\remaining_steps:
    let prepared_ref %&GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get_ref &owner "prepared"
    let surface_ref %&GuiRgba8888SoftwareSurfaceOwner field::get_ref &owner "surface"
    match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_validate_start prepared_ref surface_ref:
        Result::Err kind:
            Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
        Result::Ok _:
            match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_rederive_record prepared_ref:
                Result::Err kind:
                    Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
                Result::Ok record:
                    let cell_index %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_cell_index &owner
                    if lt cell_index 0:
                        then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::CellIndexNegative owner
                        else:
                            let cell_count %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_record_cell_count &record
                            if gt cell_index cell_count:
                                then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::CellIndexOutOfRange owner
                                else:
                                    if eq cell_index cell_count:
                                        then:
                                            match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_dirty_region &record:
                                                Result::Err kind:
                                                    Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error kind owner
                                                Result::Ok dirty:
                                                    let prepared %GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get owner "prepared"
                                                    let surface %GuiRgba8888SoftwareSurfaceOwner field::get owner "surface"
                                                    let completed %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainCompletedOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_completed_owner prepared surface dirty
                                                    Result::Ok GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal::Completed completed
                                        else:
                                            if le remaining_steps 0:
                                                then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::InvalidBudget owner
                                                else:
                                                    match gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_step_once owner:
                                                        Result::Err error:
                                                            Result::Err error
                                                        Result::Ok next_owner:
                                                            let next_cell_index %i32 gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_cell_index &next_owner
                                                            let expected_next_cell_index %i32 add cell_index 1
                                                            if ne next_cell_index expected_next_cell_index:
                                                                then Result::Err gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::ProgressInvariantInvalid next_owner
                                                                else:
                                                                    let next_remaining_steps %i32 sub remaining_steps 1
                                                                    if eq next_cell_index cell_count:
                                                                        then gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_to_complete_budget next_owner next_remaining_steps
                                                                        else:
                                                                            if eq next_remaining_steps 0:
                                                                                then Result::Ok GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal::StepBudgetExhausted next_owner
                                                                                else gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_to_complete_budget next_owner next_remaining_steps

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_free %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \owner:
    let prepared %GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get owner "prepared"
    let surface %GuiRgba8888SoftwareSurfaceOwner field::get owner "surface"
    gui_sfnt_simple_glyph_render_fill_alpha_mask_resource_prepared_command_owner_free prepared
    match gui_rgba8888_software_surface_free surface:
        Result::Err _surface_kind:
            Result::Err GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind::SurfaceFreeFailed
        Result::Ok _:
            Result::Ok unit

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_start_error_free %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainStartError Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \error:
    let rejected %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainRejected gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_start_error_rejected error
    let prepared %GuiSfntSimpleGlyphRenderFillAlphaMaskResourcePreparedCommandOwner field::get rejected "prepared"
    let surface %GuiRgba8888SoftwareSurfaceOwner field::get rejected "surface"
    let owner %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner prepared surface 0
    gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_free owner

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error_free %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainStepError Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \error:
    let owner %GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainOwner gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_step_error_owner error
    gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_free owner

fn gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_terminal_free %impure fn GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal Result unit GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainErrorKind \terminal:
    match terminal:
        GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal::Completed completed:
            gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_completed_owner_free completed
        GuiSfntSimpleGlyphRenderFillAlphaMaskSoftwareDrainTerminal::StepBudgetExhausted owner:
            gui_sfnt_simple_glyph_render_fill_alpha_mask_software_drain_owner_free owner

