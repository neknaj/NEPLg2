fn gui_sfnt_glyf_read_point_flag_run_or_continue %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 fn i32 fn i32 fn i32 Result GuiSfntSimpleGlyphPointFlagMarker GuiSfntParseError \bytes\glyf\stream\point_index\logical_index\flag_cursor\flag\run_count:
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let run_end_next %i32 add logical_index run_count
    if:
        le run_count 0
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf flag_cursor
        else:
            if:
                gt run_end_next point_count
                then:
                    Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf flag_cursor
                else:
                    if:
                        lt point_index run_end_next
                        then:
                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
                            let on_curve %bool gui_sfnt_glyf_flag_has_bit flag 1
                            let marker %GuiSfntSimpleGlyphPointFlagMarker gui_sfnt_simple_glyph_point_flag_marker glyph point_index flag on_curve
                            Result::Ok marker
                        else:
                            let next_flag_cursor %i32 if:
                                gui_sfnt_glyf_flag_has_bit flag 8
                                then:
                                    add flag_cursor 2
                                else:
                                    add flag_cursor 1
                            gui_sfnt_glyf_read_point_flag_from_stream_loop bytes glyf stream point_index run_end_next next_flag_cursor

fn gui_sfnt_glyf_read_point_flag_from_stream_loop %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 fn i32 fn i32 Result GuiSfntSimpleGlyphPointFlagMarker GuiSfntParseError \bytes\glyf\stream\point_index\logical_index\flag_cursor:
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let flag_start %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
    let flag_length %i32 gui_sfnt_simple_glyph_point_stream_flag_data_length &stream
    if:
        ge logical_index point_count
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset &glyf flag_cursor
        else:
            match gui_sfnt_glyf_read_u8_in_stream_range bytes glyf flag_start flag_length flag_cursor:
                Result::Err error:
                    Result::Err error
                Result::Ok flag:
                    if:
                        gui_sfnt_glyf_flag_has_bit flag 8
                        then:
                            let repeat_count_offset %i32 add flag_cursor 1
                            match gui_sfnt_glyf_read_u8_in_stream_range bytes glyf flag_start flag_length repeat_count_offset:
                                Result::Err error:
                                    Result::Err error
                                Result::Ok repeat_count:
                                    let run_count %i32 add repeat_count 1
                                    gui_sfnt_glyf_read_point_flag_run_or_continue bytes glyf stream point_index logical_index flag_cursor flag run_count
                        else:
                            gui_sfnt_glyf_read_point_flag_run_or_continue bytes glyf stream point_index logical_index flag_cursor flag 1

//: gui_sfnt_glyf_read_point_flag_from_stream: checked point stream の flag marker を[読/よ]む
//:
//: [契約/けいやく]:
//: - stream の flag range だけを[読/よ]み、x/y coordinate decode、endpoint、full point decode へは[進/すす]みません。
//: - repeat run が point_count を[越/こ]える[場合/ばあい]は、target がその run 内にあっても `MalformedGlyfRecord` を[返/かえ]します。
//: - storage owner を[持/も]たない byte-backed read なので、失敗は `GuiSfntParseError` として[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_glyf_read_point_flag_from_stream %fn &ByteBuf fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream fn i32 Result GuiSfntSimpleGlyphPointFlagMarker GuiSfntParseError \bytes\glyf\stream\point_index:
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let flag_data_offset %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
    if:
        or lt point_index 0 ge point_index point_count
        then:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingGlyphOutline add gui_sfnt_table_record_offset &glyf flag_data_offset
        else:
            gui_sfnt_glyf_read_point_flag_from_stream_loop bytes glyf stream point_index 0 flag_data_offset

