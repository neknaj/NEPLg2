//: gui_sfnt_simple_glyph_contour_span_index_step: exactly 1 item を検査して builder を進める
//:
//: [契約/けいやく]:
//: - pointが残る場合だけexactly 1 itemを読み、index、glyph、kindの順に検証し、endpointの場合だけ1 spanを追加します。
//: - completion可能なprogressではitemを読まず`CompletionInvariantInvalid`を返し、completion専用APIとの責務を混ぜません。
//: - `CollectionReadFailed`、payload mismatch、contour超過、span range、storage push failureをtyped kindで返します。
//: - `Err`はpre-step progressのbuilderを所有するため、metadataを読んだ後に`step_error_take_owner`で再開するか`step_error_free`で閉じます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_step %impure fn GuiSfntSimpleGlyphContourSpanIndexBuilderOwner Result GuiSfntSimpleGlyphContourSpanIndexBuilderOwner GuiSfntSimpleGlyphContourSpanIndexStepError \owner:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity gui_sfnt_simple_glyph_contour_span_index_builder_collection_ref &owner
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let next_point_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_next_point_index &owner
    let next_contour_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_next_contour_index &owner
    let contour_start_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_contour_start_index &owner
    let span_count %i32 gui_sfnt_simple_glyph_contour_span_index_builder_span_count &owner
    if ge next_point_index point_count:
        then:
            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_failure owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::CompletionInvariantInvalid point_count next_point_index
        else:
            match gui_sfnt_simple_glyph_outline_point_stream_item_collection_read_item gui_sfnt_simple_glyph_contour_span_index_builder_collection_ref &owner next_point_index:
                        Result::Err read_error:
                            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::CollectionReadFailed some read_error none none none next_point_index next_point_index
                        Result::Ok item:
                            let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_outline_point_stream_item_point &item
                            let point_index %i32 gui_sfnt_simple_glyph_point_index &point
                            if ne point_index next_point_index:
                                then:
                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::PointIndexMismatch none some item none none next_point_index point_index
                                else:
                                    let expected_glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
                                    let actual_glyph %GuiGlyphId gui_sfnt_simple_glyph_point_glyph &point
                                    let expected_glyph_raw %i32 gui_glyph_id_raw &expected_glyph
                                    let actual_glyph_raw %i32 gui_glyph_id_raw &actual_glyph
                                    if ne expected_glyph_raw actual_glyph_raw:
                                        then:
                                            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::ItemGlyphMismatch none some item none none expected_glyph_raw actual_glyph_raw
                                        else:
                                            if not gui_sfnt_simple_glyph_outline_point_stream_item_kind_matches_point &item:
                                                then:
                                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::ItemKindMismatch none some item none none next_point_index point_index
                                                else:
                                                    let endpoint %bool gui_sfnt_simple_glyph_point_end_of_contour &point
                                                    if not endpoint:
                                                        then:
                                                            let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                                                            let spans %Vec GuiSfntSimpleGlyphContourSpan field::get owner "spans"
                                                            let next_owner %GuiSfntSimpleGlyphContourSpanIndexBuilderOwner gui_sfnt_simple_glyph_contour_span_index_builder_owner collection spans add next_point_index 1 next_contour_index contour_start_index
                                                            Result::Ok next_owner
                                                        else:
                                                            if ge next_contour_index contour_count:
                                                                then:
                                                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::ContourCountExceeded none some item none none contour_count add next_contour_index 1
                                                                else:
                                                                    let span_point_count %i32 add sub next_point_index contour_start_index 1
                                                                    let span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_contour_span expected_glyph next_contour_index contour_start_index next_point_index span_point_count
                                                                    if or le span_point_count 0 gt contour_start_index next_point_index:
                                                                        then:
                                                                            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::InvalidSpanRange none some item some span none 1 span_point_count
                                                                        else:
                                                                            let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                                                                            let spans %Vec GuiSfntSimpleGlyphContourSpan field::get owner "spans"
                                                                            match vec::push spans span:
                                                                                Result::Ok next_spans:
                                                                                    let next_owner %GuiSfntSimpleGlyphContourSpanIndexBuilderOwner gui_sfnt_simple_glyph_contour_span_index_builder_owner collection next_spans add next_point_index 1 add next_contour_index 1 add next_point_index 1
                                                                                    Result::Ok next_owner
                                                                                Result::Err push_error:
                                                                                    let storage_error %StdErrorKind vec::vec_push_error_kind &push_error
                                                                                    let returned_spans %Vec GuiSfntSimpleGlyphContourSpan vec::vec_push_error_vec push_error
                                                                                    let returned_owner %GuiSfntSimpleGlyphContourSpanIndexBuilderOwner gui_sfnt_simple_glyph_contour_span_index_builder_owner collection returned_spans next_point_index next_contour_index contour_start_index
                                                                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_error returned_owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::SpanStoragePushFailed none some item some span some storage_error span_count span_count

//: gui_sfnt_simple_glyph_contour_span_index_complete: point build 完了を検証して indexed owner へ移す
//:
//: [契約/けいやく]:
//: - collection item read と span push は行わず、exact terminal progress だけを検証します。
//: - pointが残る場合は`CompletionInvariantInvalid`、final endpoint欠落は`MissingFinalEndpoint`、contour不足は`ContourCountMismatch`を返します。
//: - span連続性はprivate constructorとendpoint transitionで構築時に保証し、ここでは再走査しません。
//: - `Err`はbuilderを所有するため回収またはfreeでき、`Ok`だけがsealed indexed ownerへownershipを移します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_complete %impure fn GuiSfntSimpleGlyphContourSpanIndexBuilderOwner Result GuiSfntSimpleGlyphContourSpanIndexedCollectionOwner GuiSfntSimpleGlyphContourSpanIndexStepError \owner:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity gui_sfnt_simple_glyph_contour_span_index_builder_collection_ref &owner
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let next_point_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_next_point_index &owner
    let next_contour_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_next_contour_index &owner
    let contour_start_index %i32 gui_sfnt_simple_glyph_contour_span_index_builder_contour_start_index &owner
    let span_count %i32 gui_sfnt_simple_glyph_contour_span_index_builder_span_count &owner
    if ne next_point_index point_count:
        then:
            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_failure owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::CompletionInvariantInvalid point_count next_point_index
        else:
            if ne contour_start_index point_count:
                then:
                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_failure owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::MissingFinalEndpoint point_count contour_start_index
                else:
                    if ne next_contour_index contour_count:
                        then:
                            Result::Err gui_sfnt_simple_glyph_contour_span_index_step_failure owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::ContourCountMismatch contour_count next_contour_index
                        else:
                            let spans %&Vec GuiSfntSimpleGlyphContourSpan field::get_ref &owner "spans"
                            if or ne span_count contour_count ne vec::cap spans contour_count:
                                then:
                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_step_failure owner GuiSfntSimpleGlyphContourSpanIndexStepErrorKind::CompletionInvariantInvalid contour_count span_count
                                else:
                                    let collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection field::get owner "collection"
                                    let completed_spans %Vec GuiSfntSimpleGlyphContourSpan field::get owner "spans"
                                    Result::Ok gui_sfnt_simple_glyph_contour_span_indexed_collection_owner collection completed_spans
