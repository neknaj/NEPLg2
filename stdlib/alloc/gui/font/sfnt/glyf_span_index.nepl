//: # alloc/gui/font/sfnt/glyf_span_index
//: completed simple glyph point collection から contour span index を線形構築する owner 境界
//:
//: ### [目的/もくてき]
//: - classified point collection を一度だけ順次検査し、contour span を O(1) で参照できる index を作ります。
//: - collection と index を同じ owner に束ね、異なる glyph や collection の index を組み合わせられないようにします。
//:
//: ### [契約/けいやく]
//: - point step は exactly 1 item を読み、endpoint のときだけ最大 1 span を追加します。
//: - completion step は item read と span push を行いません。
//: - owner を保持する型は `Clone` / `Copy` を実装せず、失敗時も回収または明示的な free を要求します。
//:
//: ### [計算量/けいさんりょう]
//: - p point と c contour に対する全 build は O(p + c)、追加 storage は O(c)、indexed lookup は O(1) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/sfnt/glyf_span_index" as *
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/sfnt" as *
//:| #import "core/gui/font" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let glyph %GuiGlyphId unwrap_ok gui_glyph_id_result 41
//:     let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity glyph 1 1 1 1 2
//:     let collection_limit %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionLimit gui_sfnt_simple_glyph_outline_point_stream_item_collection_limit 1
//:     match gui_sfnt_simple_glyph_outline_point_stream_item_collection_alloc &capacity &collection_limit:
//:         Result::Err _error:
//:             1
//:         Result::Ok empty:
//:             let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_point glyph 0 10 20 true true
//:             let item %GuiSfntSimpleGlyphOutlinePointStreamItem gui_sfnt_simple_glyph_outline_point_stream_item point
//:             match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push empty item:
//:                 Result::Err push_error:
//:                     gui_sfnt_simple_glyph_outline_point_stream_item_collection_free gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection push_error
//:                     2
//:                 Result::Ok collection:
//:                     let limit %GuiSfntSimpleGlyphContourSpanIndexLimit gui_sfnt_simple_glyph_contour_span_index_limit 1
//:                     match gui_sfnt_simple_glyph_contour_span_index_start collection &limit:
//:                         Result::Err error:
//:                             gui_sfnt_simple_glyph_contour_span_index_start_error_free error
//:                             3
//:                         Result::Ok owner:
//:                             match gui_sfnt_simple_glyph_contour_span_index_step owner:
//:                                 Result::Err error:
//:                                     gui_sfnt_simple_glyph_contour_span_index_step_error_free error
//:                                     4
//:                                 Result::Ok ready:
//:                                     match gui_sfnt_simple_glyph_contour_span_index_complete ready:
//:                                         Result::Err error:
//:                                             gui_sfnt_simple_glyph_contour_span_index_step_error_free error
//:                                             5
//:                                         Result::Ok completed:
//:                                             let ok %bool match gui_sfnt_simple_glyph_contour_span_index_lookup &completed 0:
//:                                                 Result::Err _error: false
//:                                                 Result::Ok span: eq 1 gui_sfnt_simple_glyph_contour_span_point_count &span
//:                                             gui_sfnt_simple_glyph_contour_span_indexed_collection_free completed
//:                                             if ok:
//:                                                 then: 0
//:                                                 else: 6
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/sfnt" as *
//:| #import "core/gui/font" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn push_point %impure fn GuiSfntSimpleGlyphOutlinePointStreamItemCollection impure fn GuiGlyphId impure fn i32 impure fn bool Result GuiSfntSimpleGlyphOutlinePointStreamItemCollection i32 \collection\glyph\index\endpoint:
//:     let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_point glyph index index index true endpoint
//:     match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push collection gui_sfnt_simple_glyph_outline_point_stream_item point:
//:         Result::Ok next: Result::Ok next
//:         Result::Err error:
//:             gui_sfnt_simple_glyph_outline_point_stream_item_collection_free gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection error
//:             Result::Err 1
//: fn main %impure fn void i32 \void:
//:     let glyph %GuiGlyphId unwrap_ok gui_glyph_id_result 42
//:     let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity glyph 2 2 2 2 4
//:     let collection_limit %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionLimit gui_sfnt_simple_glyph_outline_point_stream_item_collection_limit 2
//:     match gui_sfnt_simple_glyph_outline_point_stream_item_collection_alloc &capacity &collection_limit:
//:         Result::Err _error: 2
//:         Result::Ok empty:
//:             match push_point empty glyph 0 true:
//:                 Result::Err code: code
//:                 Result::Ok one:
//:                     match push_point one glyph 1 true:
//:                         Result::Err code: code
//:                         Result::Ok collection:
//:                             let limit %GuiSfntSimpleGlyphContourSpanIndexLimit gui_sfnt_simple_glyph_contour_span_index_limit 2
//:                             match gui_sfnt_simple_glyph_contour_span_index_start collection &limit:
//:                                 Result::Err error:
//:                                     gui_sfnt_simple_glyph_contour_span_index_start_error_free error
//:                                     3
//:                                 Result::Ok owner0:
//:                                     match gui_sfnt_simple_glyph_contour_span_index_step owner0:
//:                                         Result::Err error:
//:                                             gui_sfnt_simple_glyph_contour_span_index_step_error_free error
//:                                             4
//:                                         Result::Ok owner1:
//:                                             match gui_sfnt_simple_glyph_contour_span_index_step owner1:
//:                                                 Result::Err error:
//:                                                     gui_sfnt_simple_glyph_contour_span_index_step_error_free error
//:                                                     5
//:                                                 Result::Ok ready:
//:                                                     match gui_sfnt_simple_glyph_contour_span_index_complete ready:
//:                                                         Result::Err error:
//:                                                             gui_sfnt_simple_glyph_contour_span_index_step_error_free error
//:                                                             6
//:                                                         Result::Ok completed:
//:                                                             let ok %bool eq 2 gui_sfnt_simple_glyph_contour_span_indexed_collection_span_count &completed
//:                                                             gui_sfnt_simple_glyph_contour_span_indexed_collection_free completed
//:                                                             if ok:
//:                                                                 then: 0
//:                                                                 else: 7
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/gui/font/sfnt" as *
//:| #import "core/gui/font" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let glyph %GuiGlyphId unwrap_ok gui_glyph_id_result 43
//:     let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_storage_capacity glyph 1 1 1 1 2
//:     let collection_limit %GuiSfntSimpleGlyphOutlinePointStreamItemCollectionLimit gui_sfnt_simple_glyph_outline_point_stream_item_collection_limit 1
//:     match gui_sfnt_simple_glyph_outline_point_stream_item_collection_alloc &capacity &collection_limit:
//:         Result::Err _error: 1
//:         Result::Ok empty:
//:             let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_point glyph 0 0 0 true true
//:             match gui_sfnt_simple_glyph_outline_point_stream_item_collection_push empty gui_sfnt_simple_glyph_outline_point_stream_item point:
//:                 Result::Err push_error:
//:                     gui_sfnt_simple_glyph_outline_point_stream_item_collection_free gui_sfnt_simple_glyph_outline_point_stream_item_collection_push_error_collection push_error
//:                     2
//:                 Result::Ok collection:
//:                     let invalid_limit %GuiSfntSimpleGlyphContourSpanIndexLimit gui_sfnt_simple_glyph_contour_span_index_limit 0
//:                     match gui_sfnt_simple_glyph_contour_span_index_start collection &invalid_limit:
//:                         Result::Ok owner:
//:                             gui_sfnt_simple_glyph_contour_span_index_builder_free owner
//:                             3
//:                         Result::Err error:
//:                             let recovered %GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_contour_span_index_start_error_take_collection error
//:                             let readable %bool match gui_sfnt_simple_glyph_outline_point_stream_item_collection_read_item &recovered 0:
//:                                 Result::Ok _item: true
//:                                 Result::Err _read_error: false
//:                             gui_sfnt_simple_glyph_outline_point_stream_item_collection_free recovered
//:                             if readable:
//:                                 then: 0
//:                                 else: 4
//: ```

#indent 4

