//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_start_error_storage_error %fn &GuiSfntSimpleGlyphContourSpanIndexStartError Option StdErrorKind \error:
    *field::get_ref error "storage_error"

//: gui_sfnt_simple_glyph_contour_span_index_start_error_take_collection: 元 collection owner を回収する
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_start_error_take_collection %fn GuiSfntSimpleGlyphContourSpanIndexStartError GuiSfntSimpleGlyphOutlinePointStreamItemCollection \error:
    field::get error "collection"

//: gui_sfnt_simple_glyph_contour_span_index_start_error_free: recovery しない start failure を閉じる
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_start_error_free %impure fn GuiSfntSimpleGlyphContourSpanIndexStartError unit \error:
    gui_sfnt_simple_glyph_outline_point_stream_item_collection_free field::get error "collection"

//: gui_sfnt_simple_glyph_contour_span_index_start: complete collection を検証して span storage を確保する
//:
//: [契約/けいやく]:
//: - collection shape と caller limit を allocation より先に検査します。
//: - capacity、item count、Vec shape、limit、allocation の失敗を個別の `GuiSfntSimpleGlyphContourSpanIndexStartErrorKind` で返します。
//: - `Err` は元 collection を所有するため、metadata を読んだ後に `start_error_take_collection` で回収するか `start_error_free` で閉じます。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_start %impure fn GuiSfntSimpleGlyphOutlinePointStreamItemCollection impure fn &GuiSfntSimpleGlyphContourSpanIndexLimit Result GuiSfntSimpleGlyphContourSpanIndexBuilderOwner GuiSfntSimpleGlyphContourSpanIndexStartError \collection\limit:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_outline_point_stream_item_collection_capacity &collection
    let item_count %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_item_count &collection
    let items_len %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_len &collection
    let items_cap %i32 gui_sfnt_simple_glyph_outline_point_stream_item_collection_items_cap &collection
    let point_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_point_count &capacity
    let contour_count %i32 gui_sfnt_simple_glyph_outline_storage_capacity_contour_count &capacity
    let max_contours %i32 gui_sfnt_simple_glyph_contour_span_index_limit_max_contours limit
    let no_storage_error %Option StdErrorKind none
    if not gui_sfnt_simple_glyph_outline_storage_capacity_shape_is_valid &capacity:
        then:
            Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::InvalidCapacity no_storage_error
        else:
            if or le contour_count 0 le point_count 0:
                then:
                    Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::InvalidCapacity no_storage_error
                else:
                    if ne item_count point_count:
                        then:
                            Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::CollectionCountMismatch no_storage_error
                        else:
                            if or ne items_len point_count ne items_cap point_count:
                                then:
                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::CollectionStorageMismatch no_storage_error
                                else:
                                    if le max_contours 0:
                                        then:
                                            Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::InvalidLimit no_storage_error
                                        else:
                                            if gt contour_count max_contours:
                                                then:
                                                    Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::CapacityRejected no_storage_error
                                                else:
                                                    let spans_result %Result Vec GuiSfntSimpleGlyphContourSpan StdErrorKind vec::with_capacity contour_count
                                                    match spans_result:
                                                        Result::Ok spans:
                                                            Result::Ok gui_sfnt_simple_glyph_contour_span_index_builder_owner collection spans 0 0 0
                                                        Result::Err storage_error:
                                                            Result::Err gui_sfnt_simple_glyph_contour_span_index_start_error collection *limit GuiSfntSimpleGlyphContourSpanIndexStartErrorKind::SpanStorageAllocFailed some storage_error

//: GuiSfntSimpleGlyphContourSpanIndexStepErrorKind: point または completion step failure の分類
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphContourSpanIndexStepErrorKind:
    CollectionReadFailed
    PointIndexMismatch
    ItemGlyphMismatch
    ItemKindMismatch
    ContourCountExceeded
    InvalidSpanRange
    SpanStoragePushFailed
    MissingFinalEndpoint
    ContourCountMismatch
    CompletionInvariantInvalid

impl Clone for GuiSfntSimpleGlyphContourSpanIndexStepErrorKind:
    fn clone %fn &GuiSfntSimpleGlyphContourSpanIndexStepErrorKind GuiSfntSimpleGlyphContourSpanIndexStepErrorKind \kind:
        *kind

impl Copy for GuiSfntSimpleGlyphContourSpanIndexStepErrorKind:
    fn copy_mark %fn GuiSfntSimpleGlyphContourSpanIndexStepErrorKind GuiSfntSimpleGlyphContourSpanIndexStepErrorKind \kind:
        kind

//: GuiSfntSimpleGlyphContourSpanIndexStepError: partial index owner を失わない typed failure
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphContourSpanIndexStepError:
    owner %GuiSfntSimpleGlyphContourSpanIndexBuilderOwner
    kind %GuiSfntSimpleGlyphContourSpanIndexStepErrorKind
    read_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError
    rejected_item %Option GuiSfntSimpleGlyphOutlinePointStreamItem
    rejected_span %Option GuiSfntSimpleGlyphContourSpan
    storage_error %Option StdErrorKind
    expected_value %i32
    actual_value %i32

//: gui_sfnt_simple_glyph_contour_span_index_step_error: recoverable builder と typed step metadata を束ねる内部 constructor
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_contour_span_index_step_error %fn GuiSfntSimpleGlyphContourSpanIndexBuilderOwner fn GuiSfntSimpleGlyphContourSpanIndexStepErrorKind fn Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionReadError fn Option GuiSfntSimpleGlyphOutlinePointStreamItem fn Option GuiSfntSimpleGlyphContourSpan fn Option StdErrorKind fn i32 fn i32 GuiSfntSimpleGlyphContourSpanIndexStepError \owner\kind\read_error\rejected_item\rejected_span\storage_error\expected_value\actual_value:
    GuiSfntSimpleGlyphContourSpanIndexStepError owner kind read_error rejected_item rejected_span storage_error expected_value actual_value

//: gui_sfnt_simple_glyph_contour_span_index_step_error_kind: step failure kind を読む
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_step_error_kind %fn &GuiSfntSimpleGlyphContourSpanIndexStepError GuiSfntSimpleGlyphContourSpanIndexStepErrorKind \error:
    *field::get_ref error "kind"

//: gui_sfnt_simple_glyph_contour_span_index_step_error_read_error: collection read failure を読む
