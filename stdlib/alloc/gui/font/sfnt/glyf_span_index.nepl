    fn clone %fn &GuiSfntSimpleGlyphContourSpanIndexLimit GuiSfntSimpleGlyphContourSpanIndexLimit \limit:
        *limit

impl Copy for GuiSfntSimpleGlyphContourSpanIndexLimit:
    fn copy_mark %fn GuiSfntSimpleGlyphContourSpanIndexLimit GuiSfntSimpleGlyphContourSpanIndexLimit \limit:
        limit

