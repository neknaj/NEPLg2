    *field::get_ref error "span_count"

//: gui_sfnt_simple_glyph_contour_span_index_lookup: owner に束ねた span を O(1) で読む
//:
//: [契約/けいやく]:
//: - `vec::get` を exactly once 呼び、collection scan は行いません。
//: - 範囲外 index、欠落 slot、span identity / range 不変条件を別の `GuiSfntSimpleGlyphContourSpanIndexLookupErrorKind` で返します。
//: - owner は借用するため、成功と失敗のどちらでも caller が同じ indexed owner を保持します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_contour_span_index_lookup %fn &GuiSfntSimpleGlyphContourSpanIndexedCollectionOwner fn i32 Result GuiSfntSimpleGlyphContourSpan GuiSfntSimpleGlyphContourSpanIndexLookupError \owner\contour_index:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_contour_span_indexed_collection_capacity owner
    let span_count %i32 gui_sfnt_simple_glyph_contour_span_indexed_collection_span_count owner
    if or lt contour_index 0 ge contour_index span_count:
        then:
            Result::Err gui_sfnt_simple_glyph_contour_span_index_lookup_error GuiSfntSimpleGlyphContourSpanIndexLookupErrorKind::ContourIndexOutOfRange contour_index span_count
        else:
            let spans %&Vec GuiSfntSimpleGlyphContourSpan field::get_ref owner "spans"
            match vec::get spans contour_index:
                Option::None:
                    Result::Err gui_sfnt_simple_glyph_contour_span_index_lookup_error GuiSfntSimpleGlyphContourSpanIndexLookupErrorKind::SpanStorageMissing contour_index span_count
                Option::Some span:
                    let glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
                    let span_glyph %GuiGlyphId gui_sfnt_simple_glyph_contour_span_glyph &span
                    let start_index %i32 gui_sfnt_simple_glyph_contour_span_start_point_index &span
                    let end_index %i32 gui_sfnt_simple_glyph_contour_span_end_point_index &span
                    let point_count %i32 gui_sfnt_simple_glyph_contour_span_point_count &span
                    let expected_count %i32 add sub end_index start_index 1
                    let glyph_matches %bool eq gui_glyph_id_raw &glyph gui_glyph_id_raw &span_glyph
                    let contour_matches %bool eq contour_index gui_sfnt_simple_glyph_contour_span_index &span
                    let start_is_valid %bool ge start_index 0
                    let end_is_valid %bool ge end_index start_index
                    let count_matches %bool eq point_count expected_count
                    let range_is_valid %bool and start_is_valid end_is_valid
                    let identity_is_valid %bool and glyph_matches contour_matches
                    let span_is_valid %bool and identity_is_valid and range_is_valid count_matches
                    if span_is_valid:
                        then:
                            Result::Ok span
                        else:
                            Result::Err gui_sfnt_simple_glyph_contour_span_index_lookup_error GuiSfntSimpleGlyphContourSpanIndexLookupErrorKind::SpanInvariantInvalid contour_index span_count

