//: GuiSfntSimpleGlyphContourSpanIndexStartErrorKind: index build 開始失敗の分類
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphContourSpanIndexStartErrorKind:
    InvalidCapacity
    CollectionCountMismatch
    CollectionStorageMismatch
    InvalidLimit
    CapacityRejected
    SpanStorageAllocFailed

impl Clone for GuiSfntSimpleGlyphContourSpanIndexStartErrorKind:
    fn clone %fn &GuiSfntSimpleGlyphContourSpanIndexStartErrorKind GuiSfntSimpleGlyphContourSpanIndexStartErrorKind \kind:
        *kind

impl Copy for GuiSfntSimpleGlyphContourSpanIndexStartErrorKind:
    fn copy_mark %fn GuiSfntSimpleGlyphContourSpanIndexStartErrorKind GuiSfntSimpleGlyphContourSpanIndexStartErrorKind \kind:
        kind

//: GuiSfntSimpleGlyphContourSpanIndexStartError: collection owner を失わない start failure
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphContourSpanIndexStartError:
    collection %GuiSfntSimpleGlyphOutlinePointStreamItemCollection
    limit %GuiSfntSimpleGlyphContourSpanIndexLimit
    kind %GuiSfntSimpleGlyphContourSpanIndexStartErrorKind
    storage_error %Option StdErrorKind

//: gui_sfnt_simple_glyph_contour_span_index_start_error: start failure metadata と collection owner を束ねる内部 constructor
//:
