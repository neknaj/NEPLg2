//: # alloc/gui/font/sfnt/glyf_sequential
//: SFNT simple glyph point stream の逐次 decoder
//:
//: ### [目的/もくてき]
//: - metadata から得た canonical `glyf` record と checked point stream を source evidence として[束/たば]ねます。
//: - flag repeat run、x / y byte cursor、累積座標、contour endpoint を cursor に[保持/ほじ]し、logical point を[先頭/せんとう]から 1 [回/かい]ずつ[復元/ふくげん]します。
//:
//: ### [契約/けいやく]
//: - source と cursor は Copy value ですが bytes owner ではありません。start / step には同じ font bytes の[借用/しゃくよう]を[渡/わた]します。
//: - cursor constructor は module-private で、step は cursor が[保持/ほじ]する source だけを authority とします。
//: - flag / x / y / endpoint の range [外/がい] read は `MalformedGlyfRecord` として typed error に[保持/ほじ]し、別経路への切替や panic を[行/おこな]いません。
//:
//: ### [計算量/けいさんりょう]
//: - 1 step は[償却/しょうきゃく] O(1)、全 point / contour は O(p + c)、追加 storage は O(1) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/sfnt/glyf_sequential" as *
//: ```

#indent 4

#import "alloc/io" as *
#import "core/field" as field
#import "core/gui/font" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./glyf" as *
#import "./glyf_point_codec" as *
#import "./metadata" as *

//: GuiSfntSimpleGlyphPointStreamSource: canonical `glyf` record と checked stream の source evidence
//:
//: [注意/ちゅうい]:
//: - bytes owner は[保持/ほじ]しません。offset は `glyf` table-relative です。
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphPointStreamSource:
    glyf %GuiSfntTableRecord
    stream %GuiSfntSimpleGlyphPointStream

impl Clone for GuiSfntSimpleGlyphPointStreamSource:
    fn clone %fn &GuiSfntSimpleGlyphPointStreamSource GuiSfntSimpleGlyphPointStreamSource \source:
        *source

impl Copy for GuiSfntSimpleGlyphPointStreamSource:
    fn copy_mark %fn GuiSfntSimpleGlyphPointStreamSource GuiSfntSimpleGlyphPointStreamSource \source:
        source

//: gui_sfnt_simple_glyph_point_stream_source: canonical table record と checked stream を source evidence に[束/たば]ねる
//:
//: [制約/せいやく]: bytes owner は[保持/ほじ]せず、入力値をそのまま O(1) で[格納/かくのう]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_point_stream_source %fn GuiSfntTableRecord fn GuiSfntSimpleGlyphPointStream GuiSfntSimpleGlyphPointStreamSource \glyf\stream:
    GuiSfntSimpleGlyphPointStreamSource glyf stream

//: gui_sfnt_simple_glyph_point_stream_source_glyf: source の canonical `glyf` record を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_point_stream_source_glyf %fn &GuiSfntSimpleGlyphPointStreamSource GuiSfntTableRecord \source:
    *field::get_ref source "glyf"

//: gui_sfnt_simple_glyph_point_stream_source_stream: source の checked point stream を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_point_stream_source_stream %fn &GuiSfntSimpleGlyphPointStreamSource GuiSfntSimpleGlyphPointStream \source:
    *field::get_ref source "stream"

//: gui_sfnt_simple_glyph_topology_eq: 2 つの topology の canonical field を[比較/ひかく]する
//:
//: [制約/せいやく]: glyph、bounds、count、point data range の全 authority field を O(1) で[比較/ひかく]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_topology_eq %fn &GuiSfntSimpleGlyphTopology fn &GuiSfntSimpleGlyphTopology bool \left\right:
    let left_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph left
    let right_glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph right
    let left_bounds %GuiSfntGlyphBounds gui_sfnt_simple_glyph_topology_bounds left
    let right_bounds %GuiSfntGlyphBounds gui_sfnt_simple_glyph_topology_bounds right
    let left_bounds_glyph %GuiGlyphId gui_sfnt_glyph_bounds_glyph &left_bounds
    let right_bounds_glyph %GuiGlyphId gui_sfnt_glyph_bounds_glyph &right_bounds
    and eq gui_glyph_id_raw &left_glyph gui_glyph_id_raw &right_glyph and eq gui_glyph_id_raw &left_bounds_glyph gui_glyph_id_raw &right_bounds_glyph and eq gui_sfnt_glyph_bounds_x_min &left_bounds gui_sfnt_glyph_bounds_x_min &right_bounds and eq gui_sfnt_glyph_bounds_y_min &left_bounds gui_sfnt_glyph_bounds_y_min &right_bounds and eq gui_sfnt_glyph_bounds_x_max &left_bounds gui_sfnt_glyph_bounds_x_max &right_bounds and eq gui_sfnt_glyph_bounds_y_max &left_bounds gui_sfnt_glyph_bounds_y_max &right_bounds and eq gui_sfnt_simple_glyph_topology_contour_count left gui_sfnt_simple_glyph_topology_contour_count right and eq gui_sfnt_simple_glyph_topology_point_count left gui_sfnt_simple_glyph_topology_point_count right and eq gui_sfnt_simple_glyph_topology_instruction_length left gui_sfnt_simple_glyph_topology_instruction_length right and eq gui_sfnt_simple_glyph_topology_point_data_offset left gui_sfnt_simple_glyph_topology_point_data_offset right eq gui_sfnt_simple_glyph_topology_point_data_length left gui_sfnt_simple_glyph_topology_point_data_length right

//: gui_sfnt_simple_glyph_point_stream_eq: 2 つの checked point stream の全 range を[比較/ひかく]する
//:
//: [制約/せいやく]: topology と flag / x / y / trailing range を O(1) で[比較/ひかく]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_point_stream_eq %fn &GuiSfntSimpleGlyphPointStream fn &GuiSfntSimpleGlyphPointStream bool \left\right:
    let left_topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology left
    let right_topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology right
    and gui_sfnt_simple_glyph_topology_eq &left_topology &right_topology and eq gui_sfnt_simple_glyph_point_stream_flag_data_offset left gui_sfnt_simple_glyph_point_stream_flag_data_offset right and eq gui_sfnt_simple_glyph_point_stream_flag_data_length left gui_sfnt_simple_glyph_point_stream_flag_data_length right and eq gui_sfnt_simple_glyph_point_stream_x_data_offset left gui_sfnt_simple_glyph_point_stream_x_data_offset right and eq gui_sfnt_simple_glyph_point_stream_x_data_length left gui_sfnt_simple_glyph_point_stream_x_data_length right and eq gui_sfnt_simple_glyph_point_stream_y_data_offset left gui_sfnt_simple_glyph_point_stream_y_data_offset right and eq gui_sfnt_simple_glyph_point_stream_y_data_length left gui_sfnt_simple_glyph_point_stream_y_data_length right and eq gui_sfnt_simple_glyph_point_stream_trailing_data_offset left gui_sfnt_simple_glyph_point_stream_trailing_data_offset right eq gui_sfnt_simple_glyph_point_stream_trailing_data_length left gui_sfnt_simple_glyph_point_stream_trailing_data_length right

//: gui_sfnt_simple_glyph_point_stream_source_eq: source の全 field を[比/くら]べる
//:
//: [目的/もくてき]:
//: - table record、topology、bounds、全 stream range の比較を 1 [箇所/かしょ]に[固定/こてい]します。
//:
//: [計算量/けいさんりょう]: O(1)
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_point_stream_source_eq %fn &GuiSfntSimpleGlyphPointStreamSource fn &GuiSfntSimpleGlyphPointStreamSource bool \left\right:
    let left_glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf left
    let right_glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf right
    let left_stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream left
    let right_stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream right
    and eq gui_sfnt_table_record_tag &left_glyf gui_sfnt_table_record_tag &right_glyf and eq gui_sfnt_table_record_offset &left_glyf gui_sfnt_table_record_offset &right_glyf and eq gui_sfnt_table_record_length &left_glyf gui_sfnt_table_record_length &right_glyf gui_sfnt_simple_glyph_point_stream_eq &left_stream &right_stream

//: gui_sfnt_simple_glyph_point_stream_source_from_metadata: metadata から canonical source を[解決/かいけつ]する
//:
//: [契約/けいやく]:
//: - `metadata.directory.glyf` と metadata-backed point stream lookup だけを authority とします。
//: - `glyf` 欠落は `MissingTable`、lower parse failure は同じ `GuiSfntParseError` を[返/かえ]します。
//:
//: [計算量/けいさんりょう]: point 数 p に対して O(p)
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_point_stream_source_from_metadata %fn &ByteBuf fn &GuiSfntMetadata fn GuiGlyphId Result GuiSfntSimpleGlyphPointStreamSource GuiSfntParseError \bytes\metadata\glyph:
    let directory %GuiSfntDirectory gui_sfnt_metadata_directory metadata
    match gui_sfnt_directory_glyf &directory:
        Option::None:
            Result::Err gui_sfnt_parse_error GuiSfntParseErrorKind::MissingTable 0
        Option::Some glyf:
            match gui_sfnt_lookup_simple_glyph_point_stream_from_metadata bytes metadata glyph:
                Result::Err error:
                    Result::Err error
                Result::Ok stream:
                    Result::Ok gui_sfnt_simple_glyph_point_stream_source glyf stream

//: GuiSfntSimpleGlyphSequentialPointCursor: source-bound logical point cursor
//:
//: [目的/もくてき]:
//: - 次の logical index と raw stream progress を[同時/どうじ]に[保持/ほじ]し、先頭からの再走査を[防/ふせ]ぎます。
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphSequentialPointCursor:
    source %GuiSfntSimpleGlyphPointStreamSource
    logical_index %i32
    flag_cursor %i32
    active_flag %i32
    active_repeat_remaining %i32
    x_cursor %i32
    y_cursor %i32
    x %i32
    y %i32
    contour_index %i32
    contour_endpoint %i32

impl Clone for GuiSfntSimpleGlyphSequentialPointCursor:
    fn clone %fn &GuiSfntSimpleGlyphSequentialPointCursor GuiSfntSimpleGlyphSequentialPointCursor \cursor:
        *cursor

impl Copy for GuiSfntSimpleGlyphSequentialPointCursor:
    fn copy_mark %fn GuiSfntSimpleGlyphSequentialPointCursor GuiSfntSimpleGlyphSequentialPointCursor \cursor:
        cursor

//: gui_sfnt_simple_glyph_sequential_point_cursor: source-bound cursor の全 progress を[構築/こうちく]する
//:
//: [制約/せいやく]: 検査済みの内部経路だけから呼び、各 field をそのまま O(1) で[格納/かくのう]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_point_cursor %fn GuiSfntSimpleGlyphPointStreamSource fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 GuiSfntSimpleGlyphSequentialPointCursor \source\logical_index\flag_cursor\active_flag\active_repeat_remaining\x_cursor\y_cursor\x\y\contour_index\contour_endpoint:
    GuiSfntSimpleGlyphSequentialPointCursor source logical_index flag_cursor active_flag active_repeat_remaining x_cursor y_cursor x y contour_index contour_endpoint

//: gui_sfnt_simple_glyph_sequential_point_cursor_source: cursor-bound source を[返/かえ]す
