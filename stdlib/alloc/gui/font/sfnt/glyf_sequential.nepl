fn gui_sfnt_simple_glyph_sequential_decode_y_delta %fn &ByteBuf fn &GuiSfntTableRecord fn &GuiSfntSimpleGlyphPointStream fn i32 fn i32 Result i32 GuiSfntParseError \bytes\glyf\stream\flag\cursor:
    let start %i32 gui_sfnt_simple_glyph_point_stream_y_data_offset stream
    let length %i32 gui_sfnt_simple_glyph_point_stream_y_data_length stream
    match gui_sfnt_simple_glyph_point_decode_y_delta bytes glyf start length cursor flag:
