//: GuiSfntSimpleGlyphSequentialPointError: 逐次 decode の typed failure evidence
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphSequentialPointError:
    source %GuiSfntSimpleGlyphPointStreamSource
    cursor %GuiSfntSimpleGlyphSequentialPointCursor
    parse_error %GuiSfntParseError

impl Clone for GuiSfntSimpleGlyphSequentialPointError:
    fn clone %fn &GuiSfntSimpleGlyphSequentialPointError GuiSfntSimpleGlyphSequentialPointError \error:
        *error

impl Copy for GuiSfntSimpleGlyphSequentialPointError:
    fn copy_mark %fn GuiSfntSimpleGlyphSequentialPointError GuiSfntSimpleGlyphSequentialPointError \error:
        error

//: gui_sfnt_simple_glyph_sequential_point_error: failure 時の source、cursor、parse error を[束/たば]ねる
//:
//: [制約/せいやく]: failure 発生地点の evidence を失わず、O(1) で typed error を[構築/こうちく]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_point_error %fn GuiSfntSimpleGlyphPointStreamSource fn GuiSfntSimpleGlyphSequentialPointCursor fn GuiSfntParseError GuiSfntSimpleGlyphSequentialPointError \source\cursor\parse_error:
    GuiSfntSimpleGlyphSequentialPointError source cursor parse_error

