//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_sequential_point_error_parse_error %fn &GuiSfntSimpleGlyphSequentialPointError GuiSfntParseError \error:
    *field::get_ref error "parse_error"

//: GuiSfntSimpleGlyphSequentialPointStep: 復元 point と next cursor
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphSequentialPointStep:
    point %GuiSfntSimpleGlyphPoint
    next_cursor %GuiSfntSimpleGlyphSequentialPointCursor

impl Clone for GuiSfntSimpleGlyphSequentialPointStep:
    fn clone %fn &GuiSfntSimpleGlyphSequentialPointStep GuiSfntSimpleGlyphSequentialPointStep \step:
        *step

impl Copy for GuiSfntSimpleGlyphSequentialPointStep:
    fn copy_mark %fn GuiSfntSimpleGlyphSequentialPointStep GuiSfntSimpleGlyphSequentialPointStep \step:
        step

//: gui_sfnt_simple_glyph_sequential_point_step_value: 復元 point と次 cursor を 1 step の値に[束/たば]ねる
//:
//: [制約/せいやく]: point と cursor の対応を保ったまま O(1) で[構築/こうちく]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_point_step_value %fn GuiSfntSimpleGlyphPoint fn GuiSfntSimpleGlyphSequentialPointCursor GuiSfntSimpleGlyphSequentialPointStep \point\next_cursor:
    GuiSfntSimpleGlyphSequentialPointStep point next_cursor

//: gui_sfnt_simple_glyph_sequential_point_step_point: 復元した point を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_sequential_point_step_point %fn &GuiSfntSimpleGlyphSequentialPointStep GuiSfntSimpleGlyphPoint \step:
    *field::get_ref step "point"

//: gui_sfnt_simple_glyph_sequential_point_step_next_cursor: 次の source-bound cursor を[返/かえ]す
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_sequential_point_step_next_cursor %fn &GuiSfntSimpleGlyphSequentialPointStep GuiSfntSimpleGlyphSequentialPointCursor \step:
    *field::get_ref step "next_cursor"

//: GuiSfntSimpleGlyphSequentialPointTerminal: 1 point または idempotent end
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphSequentialPointTerminal:
    Point %GuiSfntSimpleGlyphSequentialPointStep
    End %GuiSfntSimpleGlyphSequentialPointCursor

impl Clone for GuiSfntSimpleGlyphSequentialPointTerminal:
    fn clone %fn &GuiSfntSimpleGlyphSequentialPointTerminal GuiSfntSimpleGlyphSequentialPointTerminal \terminal:
        *terminal

impl Copy for GuiSfntSimpleGlyphSequentialPointTerminal:
    fn copy_mark %fn GuiSfntSimpleGlyphSequentialPointTerminal GuiSfntSimpleGlyphSequentialPointTerminal \terminal:
        terminal

//: gui_sfnt_simple_glyph_sequential_range_is_valid: 指定 range 内に byte 区間が[収/おさ]まるかを[検査/けんさ]する
//:
//: [制約/せいやく]: 負値と終端超過を拒否し、追加 read を行わず O(1) で判定します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_range_is_valid %fn i32 fn i32 fn i32 fn i32 bool \start\length\offset\size:
    if:
        or lt start 0 or lt length 0 or lt offset start lt size 0
        then:
            false
        else:
            if:
                gt offset add start length
                then:
                    false
                else:
                    le size sub add start length offset

//: gui_sfnt_simple_glyph_sequential_table_range_is_valid: `glyf` record 内の相対 byte 区間を[検査/けんさ]する
//:
//: [制約/せいやく]: table-relative offset と table length だけを authority とし、O(1) で判定します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_table_range_is_valid %fn &GuiSfntTableRecord fn i32 fn i32 bool \glyf\offset\size:
    gui_sfnt_simple_glyph_sequential_range_is_valid 0 gui_sfnt_table_record_length glyf offset size

//: gui_sfnt_simple_glyph_sequential_malformed: table-relative failure offset を typed parse error に[変換/へんかん]する
//:
//: [制約/せいやく]: `glyf` の absolute offset を O(1) で算出し、error kind を `MalformedGlyfRecord` に[固定/こてい]します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_malformed %fn &GuiSfntTableRecord fn i32 GuiSfntParseError \glyf\relative_offset:
    gui_sfnt_parse_error GuiSfntParseErrorKind::MalformedGlyfRecord add gui_sfnt_table_record_offset glyf relative_offset

//: gui_sfnt_simple_glyph_sequential_read_u8: checked stream range から 1 byte を[読/よ]む
//:
//: [制約/せいやく]: range 外または bytes 欠落を typed malformed error とし、O(1) で 1 byte だけ読みます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_read_u8 %fn &ByteBuf fn &GuiSfntTableRecord fn i32 fn i32 fn i32 Result i32 GuiSfntParseError \bytes\glyf\start\length\offset:
    if:
        not gui_sfnt_simple_glyph_sequential_range_is_valid start length offset 1
        then:
            Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf offset
        else:
            match io_bytebuf_byte_at bytes add gui_sfnt_table_record_offset glyf offset:
                Option::None:
                    Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf offset
                Option::Some byte:
                    Result::Ok byte

//: gui_sfnt_simple_glyph_sequential_flag_has_bit: simple glyph flag の指定 bit を[検査/けんさ]する
//:
//: [制約/せいやく]: mask との bitwise and だけを用い、O(1) で判定します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_flag_has_bit %fn i32 fn i32 bool \flag\mask:
    gui_sfnt_simple_glyph_point_flag_has_bit flag mask

//: gui_sfnt_simple_glyph_sequential_endpoint_array_offset: contour endpoint 配列の table-relative 先頭を[求/もと]める
//:
//: [制約/せいやく]: topology の point data、instruction length、contour count から O(1) で逆算します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_endpoint_array_offset %fn &GuiSfntSimpleGlyphTopology i32 \topology:
    let point_data_offset %i32 gui_sfnt_simple_glyph_topology_point_data_offset topology
    let instruction_length %i32 gui_sfnt_simple_glyph_topology_instruction_length topology
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count topology
    sub sub sub point_data_offset instruction_length 2 mul contour_count 2

//: gui_sfnt_simple_glyph_sequential_read_endpoint: 指定 contour の endpoint index を[読/よ]む
//:
//: [制約/せいやく]: contour index と table range を先に検査し、O(1) で big-endian u16 を読みます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_read_endpoint %fn &ByteBuf fn &GuiSfntTableRecord fn &GuiSfntSimpleGlyphTopology fn i32 Result i32 GuiSfntParseError \bytes\glyf\topology\contour_index:
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count topology
    let endpoint_array_offset %i32 gui_sfnt_simple_glyph_sequential_endpoint_array_offset topology
    let endpoint_offset %i32 add endpoint_array_offset mul contour_index 2
    if:
        or lt contour_index 0 ge contour_index contour_count
        then:
            Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf endpoint_offset
        else:
            if:
                not gui_sfnt_simple_glyph_sequential_table_range_is_valid glyf endpoint_offset 2
                then:
                    Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf endpoint_offset
                else:
                    match io_bytebuf_byte_at bytes add gui_sfnt_table_record_offset glyf endpoint_offset:
                        Option::None:
                            Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf endpoint_offset
                        Option::Some hi:
                            match io_bytebuf_byte_at bytes add add gui_sfnt_table_record_offset glyf endpoint_offset 1:
                                Option::None:
                                    Result::Err gui_sfnt_simple_glyph_sequential_malformed glyf add endpoint_offset 1
                                Option::Some lo:
                                    Result::Ok add shl hi 8 lo

//: gui_sfnt_simple_glyph_sequential_source_shape_is_valid: source 内の topology と stream range の整合性を[検査/けんさ]する
//:
//: [制約/せいやく]: glyph identity、正の count、連続する全 byte range を authority field 数に対して O(1) で判定します。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_source_shape_is_valid %fn &GuiSfntSimpleGlyphPointStreamSource bool \source:
    let glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf source
    let stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream source
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let bounds %GuiSfntGlyphBounds gui_sfnt_simple_glyph_topology_bounds &topology
    let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
    let bounds_glyph %GuiGlyphId gui_sfnt_glyph_bounds_glyph &bounds
    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    let point_data_offset %i32 gui_sfnt_simple_glyph_topology_point_data_offset &topology
    let point_data_length %i32 gui_sfnt_simple_glyph_topology_point_data_length &topology
    let flag_offset %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
    let flag_length %i32 gui_sfnt_simple_glyph_point_stream_flag_data_length &stream
    let x_offset %i32 gui_sfnt_simple_glyph_point_stream_x_data_offset &stream
    let x_length %i32 gui_sfnt_simple_glyph_point_stream_x_data_length &stream
    let y_offset %i32 gui_sfnt_simple_glyph_point_stream_y_data_offset &stream
    let y_length %i32 gui_sfnt_simple_glyph_point_stream_y_data_length &stream
    let trailing_offset %i32 gui_sfnt_simple_glyph_point_stream_trailing_data_offset &stream
    let trailing_length %i32 gui_sfnt_simple_glyph_point_stream_trailing_data_length &stream
    and ge gui_sfnt_table_record_offset &glyf 0 and ge gui_sfnt_table_record_length &glyf 0 and eq gui_glyph_id_raw &glyph gui_glyph_id_raw &bounds_glyph and gt contour_count 0 and gt point_count 0 and le contour_count point_count and ge gui_sfnt_simple_glyph_topology_instruction_length &topology 0 and gui_sfnt_simple_glyph_sequential_table_range_is_valid &glyf point_data_offset point_data_length and eq flag_offset point_data_offset and gui_sfnt_simple_glyph_sequential_table_range_is_valid &glyf flag_offset flag_length and eq x_offset add flag_offset flag_length and gui_sfnt_simple_glyph_sequential_table_range_is_valid &glyf x_offset x_length and eq y_offset add x_offset x_length and gui_sfnt_simple_glyph_sequential_table_range_is_valid &glyf y_offset y_length and eq trailing_offset add y_offset y_length and gui_sfnt_simple_glyph_sequential_table_range_is_valid &glyf trailing_offset trailing_length eq add trailing_offset trailing_length add point_data_offset point_data_length

//: gui_sfnt_simple_glyph_sequential_error_from_cursor: cursor-bound source を補って typed error を[構築/こうちく]する
//:
//: [制約/せいやく]: cursor が[保持/ほじ]する source だけを authority とし、O(1) で evidence を[束/たば]ねます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_error_from_cursor %fn &GuiSfntSimpleGlyphSequentialPointCursor fn GuiSfntParseError GuiSfntSimpleGlyphSequentialPointError \cursor\parse_error:
    let source %GuiSfntSimpleGlyphPointStreamSource gui_sfnt_simple_glyph_sequential_point_cursor_source cursor
    gui_sfnt_simple_glyph_sequential_point_error source *cursor parse_error

//: gui_sfnt_simple_glyph_sequential_point_start: checked source の逐次 cursor を[開始/かいし]する
//:
//: [契約/けいやく]:
//: - source shape と最初の contour endpoint を[検査/けんさ]し、raw cursor constructor は[公開/こうかい]しません。
//: - bytes は[借用/しゃくよう]し、source / cursor は bytes owner を[保持/ほじ]しません。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_sequential_point_start %fn &ByteBuf fn GuiSfntSimpleGlyphPointStreamSource Result GuiSfntSimpleGlyphSequentialPointCursor GuiSfntSimpleGlyphSequentialPointError \bytes\source:
    let glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf &source
    let stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream &source
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let initial_cursor %GuiSfntSimpleGlyphSequentialPointCursor gui_sfnt_simple_glyph_sequential_point_cursor source 0 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream 0 0 gui_sfnt_simple_glyph_point_stream_x_data_offset &stream gui_sfnt_simple_glyph_point_stream_y_data_offset &stream 0 0 0 0
    if:
        not gui_sfnt_simple_glyph_sequential_source_shape_is_valid &source
        then:
            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &initial_cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_topology_point_data_offset &topology
        else:
            match gui_sfnt_simple_glyph_sequential_read_endpoint bytes &glyf &topology 0:
                Result::Err parse_error:
                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &initial_cursor parse_error
                Result::Ok endpoint:
                    if:
                        or lt endpoint 0 ge endpoint gui_sfnt_simple_glyph_topology_point_count &topology
                        then:
                            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &initial_cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_sequential_endpoint_array_offset &topology
                        else:
                            Result::Ok gui_sfnt_simple_glyph_sequential_point_cursor source 0 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream 0 0 gui_sfnt_simple_glyph_point_stream_x_data_offset &stream gui_sfnt_simple_glyph_point_stream_y_data_offset &stream 0 0 0 endpoint

//: gui_sfnt_simple_glyph_sequential_decode_x_delta: flag に従って次の x delta を[復元/ふくげん]する
//:
//: [制約/せいやく]: x stream だけを読み、short / same bit の組合せを O(1) で解釈します。
