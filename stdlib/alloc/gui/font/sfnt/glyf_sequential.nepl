//: gui_sfnt_simple_glyph_sequential_step_with_flag: active flag から 1 logical point と次 cursor を[復元/ふくげん]する
//:
//: [制約/せいやく]: x / y を各 1 回だけ decode し、endpoint 遷移時だけ次 endpoint を読みます。1 step は O(1) です。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_step_with_flag %fn &ByteBuf fn &GuiSfntSimpleGlyphSequentialPointCursor fn i32 fn i32 fn i32 Result GuiSfntSimpleGlyphSequentialPointTerminal GuiSfntSimpleGlyphSequentialPointError \bytes\cursor\flag\next_flag_cursor\next_repeat_remaining:
    let source %GuiSfntSimpleGlyphPointStreamSource gui_sfnt_simple_glyph_sequential_point_cursor_source cursor
    let glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf &source
    let stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream &source
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let logical_index %i32 gui_sfnt_simple_glyph_sequential_point_cursor_logical_index cursor
    let x_cursor %i32 gui_sfnt_simple_glyph_sequential_point_cursor_x_cursor cursor
    let y_cursor %i32 gui_sfnt_simple_glyph_sequential_point_cursor_y_cursor cursor
    match gui_sfnt_simple_glyph_sequential_decode_x_delta bytes &glyf &stream flag x_cursor:
        Result::Err parse_error:
            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor parse_error
        Result::Ok x_delta:
            match gui_sfnt_simple_glyph_sequential_decode_y_delta bytes &glyf &stream flag y_cursor:
                Result::Err parse_error:
                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor parse_error
                Result::Ok y_delta:
                    let next_x_cursor %i32 add x_cursor gui_sfnt_simple_glyph_sequential_x_byte_length flag
                    let next_y_cursor %i32 add y_cursor gui_sfnt_simple_glyph_sequential_y_byte_length flag
                    let next_x %i32 add gui_sfnt_simple_glyph_sequential_point_cursor_x cursor x_delta
                    let next_y %i32 add gui_sfnt_simple_glyph_sequential_point_cursor_y cursor y_delta
                    let endpoint %i32 gui_sfnt_simple_glyph_sequential_point_cursor_contour_endpoint cursor
                    let contour_index %i32 gui_sfnt_simple_glyph_sequential_point_cursor_contour_index cursor
                    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
                    let contour_count %i32 gui_sfnt_simple_glyph_topology_contour_count &topology
                    let end_of_contour %bool eq logical_index endpoint
                    if:
                        gt logical_index endpoint
                        then:
                            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_sequential_endpoint_array_offset &topology
                        else:
                            let next_logical_index %i32 add logical_index 1
                            let glyph %GuiGlyphId gui_sfnt_simple_glyph_topology_glyph &topology
                            let point %GuiSfntSimpleGlyphPoint gui_sfnt_simple_glyph_point glyph logical_index next_x next_y gui_sfnt_simple_glyph_sequential_flag_has_bit flag 1 end_of_contour
                            if:
                                and end_of_contour lt next_logical_index point_count
                                then:
                                    let next_contour_index %i32 add contour_index 1
                                    match gui_sfnt_simple_glyph_sequential_read_endpoint bytes &glyf &topology next_contour_index:
                                        Result::Err parse_error:
                                            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor parse_error
                                        Result::Ok next_endpoint:
                                            if:
                                                or le next_endpoint endpoint ge next_endpoint point_count
                                                then:
                                                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_sequential_endpoint_array_offset &topology
                                                else:
                                                    let next_cursor %GuiSfntSimpleGlyphSequentialPointCursor gui_sfnt_simple_glyph_sequential_point_cursor source next_logical_index next_flag_cursor flag next_repeat_remaining next_x_cursor next_y_cursor next_x next_y next_contour_index next_endpoint
                                                    Result::Ok GuiSfntSimpleGlyphSequentialPointTerminal::Point gui_sfnt_simple_glyph_sequential_point_step_value point next_cursor
                                else:
                                    if:
                                        and eq next_logical_index point_count not and end_of_contour eq add contour_index 1 contour_count
                                        then:
                                            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_sequential_endpoint_array_offset &topology
                                        else:
                                            let next_cursor %GuiSfntSimpleGlyphSequentialPointCursor gui_sfnt_simple_glyph_sequential_point_cursor source next_logical_index next_flag_cursor flag next_repeat_remaining next_x_cursor next_y_cursor next_x next_y contour_index endpoint
                                            Result::Ok GuiSfntSimpleGlyphSequentialPointTerminal::Point gui_sfnt_simple_glyph_sequential_point_step_value point next_cursor

//: gui_sfnt_simple_glyph_sequential_point_step: source-bound cursor を 1 logical point [進/すす]める
//:
//: [契約/けいやく]:
//: - 別 source は[受/う]け[取/と]らず、cursor 内 source と bytes の[借用/しゃくよう]だけを使います。
//: - repeat flag は raw flag / repeat byte を 1 [回/かい]だけ[読/よ]み、active run を cursor に[残/のこ]します。
//: - `End` を再度 step すると同じ cursor の `End` を[返/かえ]します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_sequential_point_step %fn &ByteBuf fn GuiSfntSimpleGlyphSequentialPointCursor Result GuiSfntSimpleGlyphSequentialPointTerminal GuiSfntSimpleGlyphSequentialPointError \bytes\cursor:
    let source %GuiSfntSimpleGlyphPointStreamSource gui_sfnt_simple_glyph_sequential_point_cursor_source &cursor
    let glyf %GuiSfntTableRecord gui_sfnt_simple_glyph_point_stream_source_glyf &source
    let stream %GuiSfntSimpleGlyphPointStream gui_sfnt_simple_glyph_point_stream_source_stream &source
    let topology %GuiSfntSimpleGlyphTopology gui_sfnt_simple_glyph_point_stream_topology &stream
    let logical_index %i32 gui_sfnt_simple_glyph_sequential_point_cursor_logical_index &cursor
    let point_count %i32 gui_sfnt_simple_glyph_topology_point_count &topology
    if:
        eq logical_index point_count
        then:
            Result::Ok GuiSfntSimpleGlyphSequentialPointTerminal::End cursor
        else:
            if:
                or lt logical_index 0 gt logical_index point_count
                then:
                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &cursor gui_sfnt_simple_glyph_sequential_malformed &glyf gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
                else:
                    let repeat_remaining %i32 gui_sfnt_simple_glyph_sequential_point_cursor_active_repeat_remaining &cursor
                    if:
                        gt repeat_remaining 0
                        then:
                            gui_sfnt_simple_glyph_sequential_step_with_flag bytes &cursor gui_sfnt_simple_glyph_sequential_point_cursor_active_flag &cursor gui_sfnt_simple_glyph_sequential_point_cursor_flag_cursor &cursor sub repeat_remaining 1
                        else:
                            let flag_cursor %i32 gui_sfnt_simple_glyph_sequential_point_cursor_flag_cursor &cursor
                            let flag_start %i32 gui_sfnt_simple_glyph_point_stream_flag_data_offset &stream
                            let flag_length %i32 gui_sfnt_simple_glyph_point_stream_flag_data_length &stream
                            match gui_sfnt_simple_glyph_sequential_read_u8 bytes &glyf flag_start flag_length flag_cursor:
                                Result::Err parse_error:
                                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &cursor parse_error
                                Result::Ok flag:
                                    if:
                                        gui_sfnt_simple_glyph_sequential_flag_has_bit flag 8
                                        then:
                                            match gui_sfnt_simple_glyph_sequential_read_u8 bytes &glyf flag_start flag_length add flag_cursor 1:
                                                Result::Err parse_error:
                                                    Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &cursor parse_error
                                                Result::Ok repeat_count:
                                                    if:
                                                        gt repeat_count sub sub point_count logical_index 1
                                                        then:
                                                            Result::Err gui_sfnt_simple_glyph_sequential_error_from_cursor &cursor gui_sfnt_simple_glyph_sequential_malformed &glyf add flag_cursor 1
                                                        else:
                                                            gui_sfnt_simple_glyph_sequential_step_with_flag bytes &cursor flag add flag_cursor 2 repeat_count
                                        else:
                                            gui_sfnt_simple_glyph_sequential_step_with_flag bytes &cursor flag add flag_cursor 1 0
