//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_sequential_decode_x_delta %fn &ByteBuf fn &GuiSfntTableRecord fn &GuiSfntSimpleGlyphPointStream fn i32 fn i32 Result i32 GuiSfntParseError \bytes\glyf\stream\flag\cursor:
    let start %i32 gui_sfnt_simple_glyph_point_stream_x_data_offset stream
    let length %i32 gui_sfnt_simple_glyph_point_stream_x_data_length stream
    match gui_sfnt_simple_glyph_point_decode_x_delta bytes glyf start length cursor flag:
        Result::Err error:
            Result::Err error
        Result::Ok delta:
            Result::Ok gui_sfnt_simple_glyph_coordinate_delta_value &delta

