    fn copy_mark %fn GuiSfntSimpleGlyphIndexedPathContourStepErrorKind GuiSfntSimpleGlyphIndexedPathContourStepErrorKind \kind:
        kind

//: GuiSfntSimpleGlyphIndexedPathContourStepError: state と typed lower error を保持する failure context
//:
//: neplg2:test[skip]
pub struct GuiSfntSimpleGlyphIndexedPathContourStepError:
    kind %GuiSfntSimpleGlyphIndexedPathContourStepErrorKind
    state %GuiSfntSimpleGlyphIndexedPathContourState
    lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError
    contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError

