//: GuiSfntSimpleGlyphIndexedPathContourState: indexed contour traversal の明示的状態
//:
//: neplg2:test[skip]
pub enum GuiSfntSimpleGlyphIndexedPathContourState:
    PendingContour %GuiSfntSimpleGlyphPathContourCursor
    ActiveContour %GuiSfntSimpleGlyphIndexedPathActiveContour
    Completed %GuiSfntSimpleGlyphIndexedPathContourCompleted

impl Clone for GuiSfntSimpleGlyphIndexedPathContourState:
    fn clone %fn &GuiSfntSimpleGlyphIndexedPathContourState GuiSfntSimpleGlyphIndexedPathContourState \state:
        *state

impl Copy for GuiSfntSimpleGlyphIndexedPathContourState:
    fn copy_mark %fn GuiSfntSimpleGlyphIndexedPathContourState GuiSfntSimpleGlyphIndexedPathContourState \state:
        state

//: gui_sfnt_simple_glyph_indexed_path_contour_start: lookup 前の pending contour を[作/つく]る
//:
//: [契約/けいやく]:
//: - indexed owner は借用し、capacity glyph から first event cursor を作ります。
//: - span lookup と collection item read は行いません。contour index の検査は最初の step が typed lookup error として返します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_indexed_path_contour_start %fn &GuiSfntSimpleGlyphContourSpanIndexedCollectionOwner fn i32 GuiSfntSimpleGlyphIndexedPathContourState \owner\contour_index:
    let capacity %GuiSfntSimpleGlyphOutlineStorageCapacity gui_sfnt_simple_glyph_contour_span_indexed_collection_capacity owner
    let glyph %GuiGlyphId gui_sfnt_simple_glyph_outline_storage_capacity_glyph &capacity
    let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_cursor glyph contour_index 0 GuiSfntSimpleGlyphPathSinkEventSlot::First
    GuiSfntSimpleGlyphIndexedPathContourState::PendingContour cursor

