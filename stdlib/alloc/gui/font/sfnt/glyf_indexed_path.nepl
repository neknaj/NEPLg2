pub fn gui_sfnt_simple_glyph_indexed_path_contour_step_error_contour_step_error %fn &GuiSfntSimpleGlyphIndexedPathContourStepError Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError \error:
    *field::get_ref error "contour_step_error"

//: gui_sfnt_simple_glyph_indexed_path_contour_next_state: contour step の next を active / completed state へ写す
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_indexed_path_contour_next_state %fn GuiSfntSimpleGlyphContourSpan fn &GuiSfntSimpleGlyphPathContourStep GuiSfntSimpleGlyphIndexedPathContourState \span\step:
    let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_path_contour_step_cursor step
    let glyph %GuiGlyphId gui_sfnt_simple_glyph_path_contour_cursor_glyph &cursor
    let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index &cursor
    match gui_sfnt_simple_glyph_path_contour_step_next step:
        GuiSfntSimpleGlyphPathContourNext::Continue next_cursor:
            GuiSfntSimpleGlyphIndexedPathContourState::ActiveContour gui_sfnt_simple_glyph_indexed_path_active_contour span next_cursor
        GuiSfntSimpleGlyphPathContourNext::EndContour:
            GuiSfntSimpleGlyphIndexedPathContourState::Completed gui_sfnt_simple_glyph_indexed_path_contour_completed glyph contour_index

//: gui_sfnt_simple_glyph_indexed_path_contour_step_checked_span: 保存済み span で1 eventを進める
//:
//: [契約/けいやく]:
//: - span index lookup を行わず、`glyf`のchecked-span contour stepだけを呼びます。
//:
//: neplg2:test[skip]
fn gui_sfnt_simple_glyph_indexed_path_contour_step_checked_span %fn &GuiSfntSimpleGlyphContourSpanIndexedCollectionOwner fn GuiSfntSimpleGlyphContourSpan fn GuiSfntSimpleGlyphIndexedPathContourState fn GuiSfntSimpleGlyphPathContourCursor Result GuiSfntSimpleGlyphIndexedPathContourStepResult GuiSfntSimpleGlyphIndexedPathContourStepError \owner\span\state\cursor:
    let collection %&GuiSfntSimpleGlyphOutlinePointStreamItemCollection gui_sfnt_simple_glyph_contour_span_indexed_collection_ref owner
    match gui_sfnt_simple_glyph_outline_point_stream_item_collection_path_contour_step_checked_span collection span cursor:
        Result::Err contour_step_error_value:
            let lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError none
            let contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError some contour_step_error_value
            Result::Err gui_sfnt_simple_glyph_indexed_path_contour_step_error GuiSfntSimpleGlyphIndexedPathContourStepErrorKind::ContourStepFailed state lookup_error contour_step_error
        Result::Ok step:
            let next_state %GuiSfntSimpleGlyphIndexedPathContourState gui_sfnt_simple_glyph_indexed_path_contour_next_state span &step
            Result::Ok gui_sfnt_simple_glyph_indexed_path_contour_step_result step next_state

//: gui_sfnt_simple_glyph_indexed_path_contour_step: indexed state を1 eventだけ[進/すす]める
//:
//: [契約/けいやく]:
//: - `PendingContour`だけがspan index lookupをexactly once呼び、成功したspanを`ActiveContour`へ保存します。
//: - `ActiveContour`は保存済みspanだけを使い、span index lookupを呼びません。
//: - `Completed`はsilent successにせず`AlreadyCompleted`を返します。
//: - lookup errorは旧full-scan errorへ変換せず、`GuiSfntSimpleGlyphContourSpanIndexLookupError`のまま保持します。
//:
//: neplg2:test[skip]
pub fn gui_sfnt_simple_glyph_indexed_path_contour_step %fn &GuiSfntSimpleGlyphContourSpanIndexedCollectionOwner fn GuiSfntSimpleGlyphIndexedPathContourState Result GuiSfntSimpleGlyphIndexedPathContourStepResult GuiSfntSimpleGlyphIndexedPathContourStepError \owner\state:
    match state:
        GuiSfntSimpleGlyphIndexedPathContourState::PendingContour cursor:
            let contour_index %i32 gui_sfnt_simple_glyph_path_contour_cursor_contour_index &cursor
            match gui_sfnt_simple_glyph_contour_span_index_lookup owner contour_index:
                Result::Err lookup_error_value:
                    let lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError some lookup_error_value
                    let contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError none
                    Result::Err gui_sfnt_simple_glyph_indexed_path_contour_step_error GuiSfntSimpleGlyphIndexedPathContourStepErrorKind::SpanIndexLookupFailed state lookup_error contour_step_error
                Result::Ok span:
                    gui_sfnt_simple_glyph_indexed_path_contour_step_checked_span owner span state cursor
        GuiSfntSimpleGlyphIndexedPathContourState::ActiveContour active:
            let span %GuiSfntSimpleGlyphContourSpan gui_sfnt_simple_glyph_indexed_path_active_contour_span &active
            let cursor %GuiSfntSimpleGlyphPathContourCursor gui_sfnt_simple_glyph_indexed_path_active_contour_cursor &active
            gui_sfnt_simple_glyph_indexed_path_contour_step_checked_span owner span state cursor
        GuiSfntSimpleGlyphIndexedPathContourState::Completed _completed:
            let lookup_error %Option GuiSfntSimpleGlyphContourSpanIndexLookupError none
            let contour_step_error %Option GuiSfntSimpleGlyphOutlinePointStreamItemCollectionPathContourStepError none
            Result::Err gui_sfnt_simple_glyph_indexed_path_contour_step_error GuiSfntSimpleGlyphIndexedPathContourStepErrorKind::AlreadyCompleted state lookup_error contour_step_error
