//: # alloc/gui/font/sfnt
//: SFNT font container の metadata parser
//:
//: ### [目的/もくてき]
//: - TTF / OTF / TTC / OTC が共有する SFNT table directory を[読/よ]み、layout engine が必要とする基本 metrics を typed value として[取/と]り[出/だ]します。
//: - parser は `ByteBuf` の借用 view だけを[読/よ]み、font resource の所有権や platform handle を[保持/ほじ]しません。
//:
//: ### [契約/けいやく]
//: - single-face SFNT は face index 未指定または 0 だけを[受/う]け[入/い]れます。
//: - collection SFNT は face index を必須にし、範囲外 index は `InvalidFaceIndex` です。
//: - `head`、`hhea`、`maxp` の必須 table がない場合は代替成功させず `MissingTable` を[返/かえ]します。
//: - byte 範囲が不足した場合、panic ではなく `UnexpectedEof` を[返/かえ]します。
//:
//: ### [現状/げんじょう]
//: - Phase F4 は table directory と基本 metrics の parser です。glyph outline、CFF/CFF2 charstring、GSUB/GPOS、variable font axis、ruby / vertical layout は後続 phase で追加します。
//:
//: ### [計算量/けいさんりょう]
//: - table directory scan は table 数 `n` に対して O(n) です。metrics table の読み取りは O(1) です。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/font/sfnt" as *
//: ```

#indent 4

#import "alloc/io" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: GuiSfntContainerKind: SFNT container の[分類/ぶんるい]
//:
//: [目的/もくてき]:
//: - standalone TrueType / OpenType と collection TrueType / OpenType を、magic number の raw integer ではなく enum として[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub enum GuiSfntContainerKind:
    TrueTypeSfnt
    OpenTypeSfnt
    TrueTypeCollection
    OpenTypeCollection

impl Clone for GuiSfntContainerKind:
    fn clone %fn &GuiSfntContainerKind GuiSfntContainerKind \kind:
        *kind

impl Copy for GuiSfntContainerKind:
    fn copy_mark %fn GuiSfntContainerKind GuiSfntContainerKind \kind:
        kind

//: GuiSfntParseErrorKind: SFNT parser 固有の[失敗/しっぱい][分類/ぶんるい]
//:
//: [目的/もくてき]:
//: - invalid binary、unsupported container、face selection error、table 欠落を文字列ではなく enum として[扱/あつか]います。
//:
//: neplg2:test[skip]
pub enum GuiSfntParseErrorKind:
    UnexpectedEof
    UnsupportedContainer
    InvalidTableDirectory
    InvalidTableOffset
    MissingTable
    InvalidFaceIndex
    FaceIndexRequired
    UnsupportedNameTableFormat
    MalformedNameRecord
    UnsupportedNameEncoding
    UnsupportedNameCharacter

impl Clone for GuiSfntParseErrorKind:
    fn clone %fn &GuiSfntParseErrorKind GuiSfntParseErrorKind \kind:
        *kind

impl Copy for GuiSfntParseErrorKind:
    fn copy_mark %fn GuiSfntParseErrorKind GuiSfntParseErrorKind \kind:
        kind

//: GuiSfntParseError: SFNT parser error の typed payload
//:
//: [目的/もくてき]:
//: - kind と byte offset を[分/わ]け、表示文字列を parser から[分離/ぶんり]します。
//:
//: neplg2:test[skip]
pub struct GuiSfntParseError:
    kind %GuiSfntParseErrorKind
    offset %i32

impl Clone for GuiSfntParseError:
    fn clone %fn &GuiSfntParseError GuiSfntParseError \error:
        *error

impl Copy for GuiSfntParseError:
    fn copy_mark %fn GuiSfntParseError GuiSfntParseError \error:
        error

//: GuiSfntTableRecord: SFNT table directory entry
//:
//: [目的/もくてき]:
//: - tag、offset、length だけを parser の authority として[保持/ほじ]します。checksum は現 phase の metrics 判定には使いません。
//:
//: neplg2:test[skip]
pub struct GuiSfntTableRecord:
    tag %i32
    offset %i32
    length %i32

impl Clone for GuiSfntTableRecord:
    fn clone %fn &GuiSfntTableRecord GuiSfntTableRecord \record:
        *record

impl Copy for GuiSfntTableRecord:
    fn copy_mark %fn GuiSfntTableRecord GuiSfntTableRecord \record:
        record

//: GuiSfntDirectory: face の table directory summary
//:
//: [目的/もくてき]:
//: - parser が layout metrics に必要な table を discovery した結果を[保持/ほじ]します。
//:
//: neplg2:test[skip]
pub struct GuiSfntDirectory:
    sfnt_version %i32
    table_count %i32
    head %Option GuiSfntTableRecord
    hhea %Option GuiSfntTableRecord
    maxp %Option GuiSfntTableRecord
    name %Option GuiSfntTableRecord

impl Clone for GuiSfntDirectory:
    fn clone %fn &GuiSfntDirectory GuiSfntDirectory \directory:
        *directory

impl Copy for GuiSfntDirectory:
    fn copy_mark %fn GuiSfntDirectory GuiSfntDirectory \directory:
        directory

//: GuiSfntMetrics: layout engine が最初に必要とする font-wide metrics
//:
//: [目的/もくてき]:
//: - `head.unitsPerEm`、`hhea` line metrics、`maxp.numGlyphs` をまとめます。
//:
//: neplg2:test[skip]
pub struct GuiSfntMetrics:
    units_per_em %i32
    ascent %i32
    descent %i32
    line_gap %i32
    num_glyphs %i32

impl Clone for GuiSfntMetrics:
    fn clone %fn &GuiSfntMetrics GuiSfntMetrics \metrics:
        *metrics

impl Copy for GuiSfntMetrics:
    fn copy_mark %fn GuiSfntMetrics GuiSfntMetrics \metrics:
        metrics

//: GuiSfntMetadata: face selection と metrics を含む parse 結果
//:
//: [目的/もくてき]:
//: - collection 内の face index、face count、table directory、basic metrics を 1 つの value にまとめます。
//:
//: neplg2:test[skip]
pub struct GuiSfntMetadata:
    container_kind %GuiSfntContainerKind
    face_index %i32
    face_count %i32
    directory %GuiSfntDirectory
    metrics %GuiSfntMetrics

impl Clone for GuiSfntMetadata:
    fn clone %fn &GuiSfntMetadata GuiSfntMetadata \metadata:
        *metadata

impl Copy for GuiSfntMetadata:
    fn copy_mark %fn GuiSfntMetadata GuiSfntMetadata \metadata:
        metadata

