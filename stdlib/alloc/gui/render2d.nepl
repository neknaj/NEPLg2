//: # alloc/gui/render2d
//: 2D software rendering の alloc layer facade
//:
//: ### [目的/もくてき]
//: - GUI/TUI 共通 substrate のうち、pixel buffer や software compositor が共有する所有 storage API を公開します。
//: - font rasterizer、widget renderer、offscreen screenshot が同じ surface owner contract を使えるようにします。
//:
//: ### [実装/じっそう]
//: - 現 checkpoint では RGBA8888 software surface owner、dirty surface owner、bitmap frame owner、row batch plan / cursor / drain / range / byte storage owner、SourceOver alpha-mask 合成 helper を公開します。
//: - platform surface、window、DrawTarget、RenderTarget への接続は含めません。
//:
//: ### [注意/ちゅうい]
//: - ここは `alloc/gui/font` の実装詳細ではなく、render2d 共通の pixel memory boundary です。
//: - backend への present は `std/gui` と `platforms/gui/*` が担当します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui/render2d" as *
//: ```

#indent 4

pub #import "./render2d/software_surface" as *
pub #import "./render2d/dirty_surface" as *
pub #import "./render2d/bitmap_frame" as *
pub #import "./render2d/row_batch_plan" as *
pub #import "./render2d/row_batch_cursor" as *
pub #import "./render2d/row_batch_drain" as *
pub #import "./render2d/row_batch_range" as *
pub #import "./render2d/row_byte_storage" as *
pub #import "./render2d/composite" as *
