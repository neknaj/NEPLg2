//:| #import "core/gui" as *
//: fn main %fn void i32 \void:
//:     let hint %LayoutHint layout_hint_fixed 4 2
//:     let min_size %GuiSize layout_hint_min_size &hint
//:     gui_size_width &min_size
//: ```

#indent 4

pub #import "alloc/gui/widget/types" as *
