//: sha256_ch: SHA-256 の choose [関数/かんすう]
//:
//: [実装/じっそう]:
//: - `(x & y) ^ (~x & z)` を i32 word 上で[計算/けいさん]します。
fn sha256_ch <(i32,i32,i32)->i32> (x, y, z):
    let not_x <i32> xor x -1
    xor and x y and not_x z

//: sha256_maj: SHA-256 の majority [関数/かんすう]
//:
//: [実装/じっそう]:
//: - `(x & y) ^ (x & z) ^ (y & z)` を i32 word 上で[計算/けいさん]します。
fn sha256_maj <(i32,i32,i32)->i32> (x, y, z):
    let xy <i32> and x y
    let xz <i32> and x z
    let yz <i32> and y z
    xor xor xy xz yz

//: sha256_big_sigma0: compression 用の大文字 Sigma0
fn sha256_big_sigma0 <(i32)->i32> (x):
    let a <i32> rotr x 2
    let b <i32> rotr x 13
    let c <i32> rotr x 22
    xor xor a b c

//: sha256_big_sigma1: compression 用の大文字 Sigma1
fn sha256_big_sigma1 <(i32)->i32> (x):
    let a <i32> rotr x 6
    let b <i32> rotr x 11
    let c <i32> rotr x 25
    xor xor a b c

//: sha256_small_sigma0: message schedule 用の小文字 sigma0
fn sha256_small_sigma0 <(i32)->i32> (x):
    let a <i32> rotr x 7
    let b <i32> rotr x 18
    let c <i32> shr_u x 3
    xor xor a b c

//: sha256_small_sigma1: message schedule 用の小文字 sigma1
fn sha256_small_sigma1 <(i32)->i32> (x):
    let a <i32> rotr x 17
    let b <i32> rotr x 19
    let c <i32> shr_u x 10
    xor xor a b c

//: sha256_total_len: padding [後/ご]の byte [数/すう]を[返/かえ]す
//:
//: [実装/じっそう]:
//: - 入力長 + `0x80` + 64-bit length field が 64 byte block 境界に[乗/の]るように[切/き]り[上/あ]げます。
fn sha256_total_len <(i32)->i32> (msg_len):
    let base <i32> add msg_len 9
    let rem <i32> rem_u base 64
    if:
        eq rem 0
        then:
            base
        else:
            add base sub 64 rem

//: sha256_length_shift: 64-bit length field の byte offset から shift 量を[返/かえ]す
//:
//: [実装/じっそう]:
//: - SHA-256 の length field は big-endian なので offset 0 が 56 bit shift です。
fn sha256_length_shift <(i32)->Result<i64, StdErrorKind>> (offset):
    match offset:
        0:
            Result<i64, StdErrorKind>::Ok <i64> cast 56
        1:
            Result<i64, StdErrorKind>::Ok <i64> cast 48
        2:
            Result<i64, StdErrorKind>::Ok <i64> cast 40
        3:
            Result<i64, StdErrorKind>::Ok <i64> cast 32
        4:
            Result<i64, StdErrorKind>::Ok <i64> cast 24
        5:
            Result<i64, StdErrorKind>::Ok <i64> cast 16
        6:
            Result<i64, StdErrorKind>::Ok <i64> cast 8
        7:
            Result<i64, StdErrorKind>::Ok <i64> cast 0
        _:
            Result<i64, StdErrorKind>::Err StdErrorKind::InvalidOperation

//: sha256_length_byte: 入力 bit 長の big-endian byte を[返/かえ]す
//:
//: [実装/じっそう]:
//: - `msg_len * 8` を i64 で[計算/けいさん]し、offset に[対応/たいおう]する 1 byte を[取/と]り[出/だ]します。
fn sha256_length_byte <(i32,i32)->Result<i32, StdErrorKind>> (msg_len, offset):
    match sha256_length_shift offset:
        Result::Ok shift:
            let n64 <i64> cast msg_len
            let bits <i64> mul n64 <i64> cast 8
            let shifted <i64> shr_u bits shift
            let masked <i64> and shifted <i64> cast 255
            Result<i32, StdErrorKind>::Ok cast masked
        Result::Err e:
            Result<i32, StdErrorKind>::Err e

//: sha256_padded_byte_at: padding [後/ご]の仮想 byte を[返/かえ]す
//:
//: [実装/じっそう]:
//: - 元の入力、`0x80`、zero padding、64-bit length field を index から[判定/はんてい]します。
fn sha256_padded_byte_at <(&Vec<i32>,i32,i32,i32)->Result<i32, StdErrorKind>> (buf, msg_len, total_len, idx):
    if:
        lt idx msg_len
        then:
            match get<i32> buf idx:
                Option::Some b:
                    Result<i32, StdErrorKind>::Ok and b 255
                Option::None:
                    Result<i32, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
        else:
            if:
                eq idx msg_len
                then:
                    Result<i32, StdErrorKind>::Ok 128
                else:
                    let length_start <i32> sub total_len 8
                    if:
                        lt idx length_start
                        then:
                            Result<i32, StdErrorKind>::Ok 0
                        else:
                            sha256_length_byte msg_len sub idx length_start

//: sha256_word_at: padding [後/ご]の block から 32-bit big-endian word を[読/よ]む
//:
//: [実装/じっそう]:
//: - 4 byte を big-endian に[結合/けつごう]して message schedule の先頭 16 word を[作/つく]ります。
fn sha256_word_at <(&Vec<i32>,i32,i32,i32,i32)->Result<i32, StdErrorKind>> (buf, msg_len, total_len, block_start, j):
    let base <i32> add block_start mul j 4
    match sha256_padded_byte_at buf msg_len total_len base:
        Result::Err e:
            Result<i32, StdErrorKind>::Err e
        Result::Ok b0:
            match sha256_padded_byte_at buf msg_len total_len add base 1:
                Result::Err e:
                    Result<i32, StdErrorKind>::Err e
                Result::Ok b1:
                    match sha256_padded_byte_at buf msg_len total_len add base 2:
                        Result::Err e:
                            Result<i32, StdErrorKind>::Err e
                        Result::Ok b2:
                            match sha256_padded_byte_at buf msg_len total_len add base 3:
                                Result::Err e:
                                    Result<i32, StdErrorKind>::Err e
                                Result::Ok b3:
                                    let w0 <i32> shl b0 24
                                    let w1 <i32> shl b1 16
                                    let w2 <i32> shl b2 8
                                    let hi <i32> or w0 w1
                                    let lo <i32> or w2 b3
                                    Result<i32, StdErrorKind>::Ok or hi lo

//: sha256_schedule_word: 16 word 以降の schedule word を[計算/けいさん]する
//:
//: [実装/じっそう]:
//: - `w[i-16] + sigma0(w[i-15]) + w[i-7] + sigma1(w[i-2])` を 32-bit word として[加算/かさん]します。
fn sha256_schedule_word <(&Vec<i32>,i32)->Result<i32, StdErrorKind>> (w, i):
    match get<i32> w sub i 2:
        Option::None:
            Result<i32, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
        Option::Some w2:
            match get<i32> w sub i 7:
                Option::None:
                    Result<i32, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
                Option::Some w7:
                    match get<i32> w sub i 15:
                        Option::None:
                            Result<i32, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
                        Option::Some w15:
                            match get<i32> w sub i 16:
                                Option::None:
                                    Result<i32, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
                                Option::Some w16:
                                    let s0 <i32> sha256_small_sigma0 w15
                                    let s1 <i32> sha256_small_sigma1 w2
                                    let a <i32> add w16 s0
                                    let b <i32> add a w7
                                    Result<i32, StdErrorKind>::Ok add b s1

//: sha256_build_schedule_loop: 1 block の 64 word schedule を[作/つく]る
//:
//: [実装/じっそう]:
//: - 先頭 16 word は padded block から[読/よ]み、残りは schedule recurrence で[追加/ついか]します。
fn sha256_build_schedule_loop <(&Vec<i32>,i32,i32,i32,i32,Vec<i32>)*>Result<Vec<i32>, StdErrorKind>> (buf, msg_len, total_len, block_start, i, w):
    if:
        ge i 64
        then:
            Result<Vec<i32>, StdErrorKind>::Ok w
        else:
            let word_result <Result<i32, StdErrorKind>>:
                if:
                    lt i 16
                    then:
                        sha256_word_at buf msg_len total_len block_start i
                    else:
                        sha256_schedule_word &w i
            match word_result:
                Result::Err e:
                    free<i32> w
                    Result<Vec<i32>, StdErrorKind>::Err e
                Result::Ok word:
                    match push<i32> w word:
                        Result::Err e:
                            Result<Vec<i32>, StdErrorKind>::Err e
                        Result::Ok next_w:
                            sha256_build_schedule_loop buf msg_len total_len block_start add i 1 next_w

//: sha256_build_schedule: 1 block の message schedule を[初期化/しょきか]する
//:
//: [注意/ちゅうい]:
//: - [返/かえ]った `Vec<i32>` は block compression [後/ご]に `free` してください。
fn sha256_build_schedule <(&Vec<i32>,i32,i32,i32)*>Result<Vec<i32>, StdErrorKind>> (buf, msg_len, total_len, block_start):
    match with_capacity<i32> 64:
        Result::Err e:
            Result<Vec<i32>, StdErrorKind>::Err e
        Result::Ok w0:
            sha256_build_schedule_loop buf msg_len total_len block_start 0 w0

//: sha256_rounds_loop: SHA-256 の 64 round を[実行/じっこう]する
//:
//: [実装/じっそう]:
//: - working variables `a`..`h` を[再帰/さいき]で[更新/こうしん]し、64 round [後/ご]の値を `Sha256State` として[返/かえ]します。
fn sha256_rounds_loop <(&Vec<i32>,i32,i32,i32,i32,i32,i32,i32,i32,i32)*>Result<Sha256State, StdErrorKind>> (w, i, a, b, c, d, e, f, g, h):
    if:
        ge i 64
        then:
            Result<Sha256State, StdErrorKind>::Ok Sha256State a b c d e f g h
        else:
            match get<i32> w i:
                Option::None:
                    Result<Sha256State, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
                Option::Some wi:
                    match sha256_k i:
                        Result::Err e:
                            Result<Sha256State, StdErrorKind>::Err e
                        Result::Ok k:
                            let t1a <i32> add h sha256_big_sigma1 e
                            let t1b <i32> add t1a sha256_ch e f g
                            let t1c <i32> add t1b k
                            let t1 <i32> add t1c wi
                            let t2 <i32> add sha256_big_sigma0 a sha256_maj a b c
                            let next_a <i32> add t1 t2
                            let next_e <i32> add d t1
                            sha256_rounds_loop w add i 1 next_a a b c next_e e f g

//: sha256_compress_block: 1 [個/こ]の 512-bit block を compression する
//:
//: [実装/じっそう]:
//: - schedule を[作成/さくせい]し、64 round の working variables を state に[加算/かさん]します。
fn sha256_compress_block <(&Vec<i32>,i32,i32,i32,Sha256State)*>Result<Sha256State, StdErrorKind>> (buf, msg_len, total_len, block_start, state):
    match sha256_build_schedule buf msg_len total_len block_start:
        Result::Err e:
            Result<Sha256State, StdErrorKind>::Err e
        Result::Ok w:
            let h0 <i32> field::get state "h0"
            let h1 <i32> field::get state "h1"
            let h2 <i32> field::get state "h2"
            let h3 <i32> field::get state "h3"
            let h4 <i32> field::get state "h4"
            let h5 <i32> field::get state "h5"
            let h6 <i32> field::get state "h6"
            let h7 <i32> field::get state "h7"
            match sha256_rounds_loop &w 0 h0 h1 h2 h3 h4 h5 h6 h7:
                Result::Err e:
                    free<i32> w
                    Result<Sha256State, StdErrorKind>::Err e
                Result::Ok rounds:
                    free<i32> w
                    let r0 <i32> field::get rounds "h0"
                    let r1 <i32> field::get rounds "h1"
                    let r2 <i32> field::get rounds "h2"
                    let r3 <i32> field::get rounds "h3"
                    let r4 <i32> field::get rounds "h4"
                    let r5 <i32> field::get rounds "h5"
                    let r6 <i32> field::get rounds "h6"
                    let r7 <i32> field::get rounds "h7"
                    Result<Sha256State, StdErrorKind>::Ok Sha256State add h0 r0 add h1 r1 add h2 r2 add h3 r3 add h4 r4 add h5 r5 add h6 r6 add h7 r7

//: sha256_process_blocks: padding [後/ご]の block [列/れつ]を[順/じゅん]に compression する
//:
//: [実装/じっそう]:
//: - `block_start` を 64 byte ずつ[進/すす]め、全 block を[処理/しょり]した state を[返/かえ]します。
fn sha256_process_blocks <(&Vec<i32>,i32,i32,i32,Sha256State)*>Result<Sha256State, StdErrorKind>> (buf, msg_len, total_len, block_start, state):
    if:
        ge block_start total_len
        then:
            Result<Sha256State, StdErrorKind>::Ok state
        else:
            match sha256_compress_block buf msg_len total_len block_start state:
                Result::Err e:
                    Result<Sha256State, StdErrorKind>::Err e
                Result::Ok next:
                    sha256_process_blocks buf msg_len total_len add block_start 64 next

//: sha256_push_byte: digest output に 1 byte を[追加/ついか]する
//:
//: [実装/じっそう]:
//: - `byte` の lower 8 bit を push し、[確保/かくほ][失敗/しっぱい]は `StdErrorKind::OutOfMemory` として[返/かえ]します。
fn sha256_push_byte <(Vec<i32>,i32)*>Result<Vec<i32>, StdErrorKind>> (out, byte):
    push<i32> out and byte 255

//: sha256_push_word_be: 32-bit word を big-endian byte として digest output に[追加/ついか]する
fn sha256_push_word_be <(Vec<i32>,i32)*>Result<Vec<i32>, StdErrorKind>> (out, word):
    let b0 <i32> and shr_u word 24 255
    let b1 <i32> and shr_u word 16 255
    let b2 <i32> and shr_u word 8 255
    let b3 <i32> and word 255
    match sha256_push_byte out b0:
        Result::Err e:
            Result<Vec<i32>, StdErrorKind>::Err e
        Result::Ok out1:
            match sha256_push_byte out1 b1:
                Result::Err e:
                    Result<Vec<i32>, StdErrorKind>::Err e
                Result::Ok out2:
                    match sha256_push_byte out2 b2:
                        Result::Err e:
                            Result<Vec<i32>, StdErrorKind>::Err e
                        Result::Ok out3:
                            sha256_push_byte out3 b3

//: sha256_state_to_digest: final state を 32 byte digest へ[変換/へんかん]する
//:
//: [実装/じっそう]:
//: - `h0`..`h7` を big-endian で[連結/れんけつ]します。
fn sha256_state_to_digest <(Sha256State)*>Result<Vec<i32>, StdErrorKind>> (state):
    match with_capacity<i32> 32:
        Result::Err e:
            Result<Vec<i32>, StdErrorKind>::Err e
        Result::Ok out0:
            match sha256_push_word_be out0 field::get state "h0":
                Result::Err e:
                    Result<Vec<i32>, StdErrorKind>::Err e
                Result::Ok out1:
                    match sha256_push_word_be out1 field::get state "h1":
                        Result::Err e:
                            Result<Vec<i32>, StdErrorKind>::Err e
                        Result::Ok out2:
                            match sha256_push_word_be out2 field::get state "h2":
                                Result::Err e:
                                    Result<Vec<i32>, StdErrorKind>::Err e
                                Result::Ok out3:
                                    match sha256_push_word_be out3 field::get state "h3":
                                        Result::Err e:
                                            Result<Vec<i32>, StdErrorKind>::Err e
                                        Result::Ok out4:
                                            match sha256_push_word_be out4 field::get state "h4":
                                                Result::Err e:
                                                    Result<Vec<i32>, StdErrorKind>::Err e
                                                Result::Ok out5:
                                                    match sha256_push_word_be out5 field::get state "h5":
                                                        Result::Err e:
                                                            Result<Vec<i32>, StdErrorKind>::Err e
                                                        Result::Ok out6:
                                                            match sha256_push_word_be out6 field::get state "h6":
                                                                Result::Err e:
                                                                    Result<Vec<i32>, StdErrorKind>::Err e
                                                                Result::Ok out7:
                                                                    sha256_push_word_be out7 field::get state "h7"

//: new_sha256: [空/から]の SHA-256 state を[作/つく]る
//:
//: [実装/じっそう]:
//: - 入力 byte buffer として empty `Vec<i32>` を[確保/かくほ]します。
fn new_sha256 <()*>Result<Sha256, StdErrorKind>> ():
    match new<i32>:
        Result::Err e:
            Result<Sha256, StdErrorKind>::Err e
        Result::Ok buf:
            Result<Sha256, StdErrorKind>::Ok Sha256 buf

//: sha256_update: state に byte を 1 [個/こ][追加/ついか]する
//:
//: [実装/じっそう]:
//: - 入力を 0..255 に[正規化/せいきか]し、内部 buffer へ[追加/ついか]します。
//:
//: [注意/ちゅうい]:
//: - 返された state を[使/つか]って[次/つぎ]の update / finalize を[呼/よ]んでください。
fn sha256_update <(Sha256, i32)*>Result<Sha256, StdErrorKind>> (ctx, byte):
    match push<i32> ctx.buffer and byte 255:
        Result::Err e:
            Result<Sha256, StdErrorKind>::Err e
        Result::Ok new_vec:
            Result<Sha256, StdErrorKind>::Ok Sha256 new_vec

//: sha256_finalize: 32 byte SHA-256 digest を[返/かえ]す
//:
//: [実装/じっそう]:
//: - 入力 buffer を borrow して padding / compression を[行/おこな]い、digest を[作成/さくせい]します。
//: - digest 作成後、state が[保持/ほじ]していた入力 buffer を[解放/かいほう]します。
fn sha256_finalize <(Sha256)*>Result<Vec<i32>, StdErrorKind>> (ctx):
    let buf <Vec<i32>> ctx.buffer
    let msg_len <i32> len<i32> &buf
    let total_len <i32> sha256_total_len msg_len
    match sha256_process_blocks &buf msg_len total_len 0 sha256_initial_state:
        Result::Err e:
            free<i32> buf
            Result<Vec<i32>, StdErrorKind>::Err e
        Result::Ok final_state:
            match sha256_state_to_digest final_state:
                Result::Err e:
                    free<i32> buf
                    Result<Vec<i32>, StdErrorKind>::Err e
                Result::Ok digest:
                    free<i32> buf
                    Result<Vec<i32>, StdErrorKind>::Ok digest
