//: # sha256
//: SHA-256 digest を[計算/けいさん]する incremental hash API
//:
//: ### [目的/もくてき]
//: - byte [列/れつ]を `sha256_update` で[順/じゅん]に[与/あた]え、`sha256_finalize` で 32 byte digest を[得/え]ます。
//: - self-host compiler が source / artifact fingerprint を[扱/あつか]うとき、stdlib [内/ない]の[標準/ひょうじゅん] crypto hash として[再利用/さいりよう]できるようにします。
//:
//: ### [実装/じっそう]
//: - `Sha256` は入力 byte を `Vec<i32>` として[保持/ほじ]します。
//: - finalize 時に SHA-256 padding を[仮想的/かそうてき]に[読/よ]み、512-bit block ごとに message schedule と compression を[実行/じっこう]します。
//: - digest は big-endian の byte [列/れつ]を `Vec<i32>`（各要素 0..255）として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `sha256_update` の `byte` は lower 8 bit だけを[使用/しよう]します。
//: - `new_sha256` / `sha256_update` / `sha256_finalize` は buffer [確保/かくほ][失敗/しっぱい]を `StdErrorKind::OutOfMemory` として[返/かえ]します。
//: - `sha256_finalize` は state を[消費/しょうひ]し、内部 buffer を[解放/かいほう]してから digest を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `sha256_update` は `Vec` push に[従/したが]い[償却/しょうきゃく] O(1) です。
//: - `sha256_finalize` は入力長を n として O(n) 時間、block ごとの 64 word schedule に O(1) 追加領域を[使/つか]います。

#indent 4

#import "alloc/collections/vec" as *
#import "core/cast" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: Sha256: SHA-256 の incremental state
//:
//: [目的/もくてき]:
//: - finalize までの入力 byte を[蓄積/ちくせき]します。
//:
//: [注意/ちゅうい]:
//: - digest state ではなく入力 buffer です。これは現在の stdlib に mutable byte buffer がないための所有権上の設計です。
//: - `sha256_finalize` 後に state は[再利用/さいりよう]できません。
struct Sha256:
    buffer <Vec<i32>>

//: Sha256State: SHA-256 compression の 8 word state
//:
//: [目的/もくてき]:
//: - `h0`..`h7` の 32-bit word をまとめ、block compression の入力と出力を[明示/めいじ]します。
//:
//: [注意/ちゅうい]:
//: - すべて `i32` の word なので `Copy` として[扱/あつか]えます。
struct Sha256State:
    h0 <i32>
    h1 <i32>
    h2 <i32>
    h3 <i32>
    h4 <i32>
    h5 <i32>
    h6 <i32>
    h7 <i32>

impl Clone for Sha256State:
    fn clone <(&Sha256State)->Sha256State> (self):
        *self

impl Copy for Sha256State:
    fn copy_mark <(Sha256State)->Sha256State> (self):
        self

//: sha256_initial_state: SHA-256 の[初期/しょき] hash value を[返/かえ]す
//:
//: [実装/じっそう]:
//: - SHA-256 [仕様/しよう]で[定/さだ]められた 8 word の IV を signed i32 literal として[保持/ほじ]します。
fn sha256_initial_state <()->Sha256State> ():
    Sha256State 1779033703 -1150833019 1013904242 -1521486534 1359893119 -1694144372 528734635 1541459225

//: sha256_k: round constant を[返/かえ]す
//:
//: [実装/じっそう]:
//: - round index を `match` し、SHA-256 の 64 [個/こ]の K constant を[返/かえ]します。
//: - constant は 32-bit word として signed i32 literal に[変換/へんかん]しています。
fn sha256_k <(i32)->Result<i32, StdErrorKind>> (i):
    match i:
        0:
            Result<i32, StdErrorKind>::Ok 1116352408
        1:
            Result<i32, StdErrorKind>::Ok 1899447441
        2:
            Result<i32, StdErrorKind>::Ok -1245643825
        3:
            Result<i32, StdErrorKind>::Ok -373957723
        4:
            Result<i32, StdErrorKind>::Ok 961987163
        5:
            Result<i32, StdErrorKind>::Ok 1508970993
