//: # sha256/round
//: SHA-256 round constant と word 演算
//:
//: ### [目的/もくてき]
//: - compression round が使う K constant、choose/majority、Sigma 関数を集めます。
//: - padding や digest 出力から独立した 32-bit word 演算だけを扱います。

#indent 4

#import "core/math" as *
#import "core/result" as *

//: sha256_k: round constant を[返/かえ]す
//:
//: [実装/じっそう]:
//: - round index を `match` し、SHA-256 の 64 [個/こ]の K constant を[返/かえ]します。
//: - constant は 32-bit word として signed i32 literal に[変換/へんかん]しています。
pub fn sha256_k %fn i32 Result i32 StdErrorKind \i:
