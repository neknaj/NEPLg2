//: # sha256/compress
//: SHA-256 block compression pipeline
//:
//: ### [目的/もくてき]
//: - 64 round の working variable 更新と block 列の逐次 compression を所有します。
//: - schedule builder と digest output から compression の責務を分離します。

#indent 4

#import "alloc/collections/vec" as *
#import "alloc/hash/sha256/round" as *
#import "alloc/hash/sha256/schedule" as *
#import "alloc/hash/sha256/types" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as *

//: sha256_rounds_loop: SHA-256 の 64 round を[実行/じっこう]する
//:
//: [実装/じっそう]:
//: - working variables `a`..`h` を[再帰/さいき]で[更新/こうしん]し、64 round [後/ご]の値を `Sha256State` として[返/かえ]します。
pub fn sha256_rounds_loop <(&Vec<i32>,i32,i32,i32,i32,i32,i32,i32,i32,i32)*>Result<Sha256State, StdErrorKind>> (w, i, a, b, c, d, e, f, g, h):
    if:
        ge i 64
        then:
            Result<Sha256State, StdErrorKind>::Ok Sha256State a b c d e f g h
        else:
            match get<i32> w i:
                Option::None:
                    Result<Sha256State, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds
                Option::Some wi:
                    match sha256_k i:
                        Result::Err err:
                            Result<Sha256State, StdErrorKind>::Err err
                        Result::Ok k:
                            let t1a <i32> add h sha256_big_sigma1 e
                            let t1b <i32> add t1a sha256_ch e f g
                            let t1c <i32> add t1b k
                            let t1 <i32> add t1c wi
                            let t2 <i32> add sha256_big_sigma0 a sha256_maj a b c
                            let next_a <i32> add t1 t2
                            let next_e <i32> add d t1
                            sha256_rounds_loop w add i 1 next_a a b c next_e e f g

//: sha256_compress_block: 1 [個/こ]の 512-bit block を compression する
//:
//: [実装/じっそう]:
//: - schedule を[作成/さくせい]し、64 round の working variables を state に[加算/かさん]します。
pub fn sha256_compress_block <(&Vec<i32>,i32,i32,i32,Sha256State)*>Result<Sha256State, StdErrorKind>> (buf, msg_len, total_len, block_start, state):
    match sha256_build_schedule buf msg_len total_len block_start:
        Result::Err e:
            Result<Sha256State, StdErrorKind>::Err e
        Result::Ok w:
            let h0 <i32> field::get state "h0"
            let h1 <i32> field::get state "h1"
            let h2 <i32> field::get state "h2"
            let h3 <i32> field::get state "h3"
            let h4 <i32> field::get state "h4"
            let h5 <i32> field::get state "h5"
            let h6 <i32> field::get state "h6"
            let h7 <i32> field::get state "h7"
            match sha256_rounds_loop &w 0 h0 h1 h2 h3 h4 h5 h6 h7:
                Result::Err e:
                    free<i32> w
                    Result<Sha256State, StdErrorKind>::Err e
                Result::Ok rounds:
                    free<i32> w
                    let r0 <i32> field::get rounds "h0"
                    let r1 <i32> field::get rounds "h1"
                    let r2 <i32> field::get rounds "h2"
                    let r3 <i32> field::get rounds "h3"
                    let r4 <i32> field::get rounds "h4"
                    let r5 <i32> field::get rounds "h5"
                    let r6 <i32> field::get rounds "h6"
                    let r7 <i32> field::get rounds "h7"
                    Result<Sha256State, StdErrorKind>::Ok Sha256State add h0 r0 add h1 r1 add h2 r2 add h3 r3 add h4 r4 add h5 r5 add h6 r6 add h7 r7

//: sha256_process_blocks: padding [後/ご]の block [列/れつ]を[順/じゅん]に compression する
//:
//: [実装/じっそう]:
//: - `block_start` を 64 byte ずつ[進/すす]め、全 block を[処理/しょり]した state を[返/かえ]します。
pub fn sha256_process_blocks <(&Vec<i32>,i32,i32,i32,Sha256State)*>Result<Sha256State, StdErrorKind>> (buf, msg_len, total_len, block_start, state):
    if:
        ge block_start total_len
        then:
            Result<Sha256State, StdErrorKind>::Ok state
        else:
            match sha256_compress_block buf msg_len total_len block_start state:
                Result::Err e:
                    Result<Sha256State, StdErrorKind>::Err e
                Result::Ok next:
                    sha256_process_blocks buf msg_len total_len add block_start 64 next
