//: # hash32
//: 32-bit [非暗号/ひあんごう]ハッシュの bare overload
//:
//: ### [目的/もくてき]
//: - bare overload `hash32` で primitive / `str` の 32-bit [非暗号/ひあんごう]ハッシュを[得/え]られるようにします。
//: - `HashMap` / `HashSet` が[受/う]け[取/と]る hash function value の default [候補/こうほ]として[再利用/さいりよう]できるようにします。
//:
//: ### [契約/けいやく]
//: - 同じ入力には同じ `i32` bit pattern を[返/かえ]します。
//: - 返り値は signed `i32` ですが、hash としては 32-bit bit pattern として[扱/あつか]います。
//: - [暗号用途/あんごうようと]、DoS [耐性/たいせい]、protocol fingerprint、永続化された識別子には[使/つか]えません。
//: - `str` overload は文字数ではなく UTF-8 byte [列/れつ]を[順/じゅん]に[読/よ]みます。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - primitive key は fixed seed と XOR してから `mix` の avalanche [混合/こんごう]を[行/おこな]います。
//: - `str` は FNV-1a 32-bit state に各 byte を[混/ま]ぜ、最後に `mix` を[通/とお]します。
//:
//: ### [計算量/けいさんりょう]
//: - `i32` / `bool` / `u8` / `i64` は O(1)、`str` は byte 長を n として O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_module_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"same input stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"different input likely differs\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let h1 %i32 hash32 123456
//:     let h2 %i32 hash32 123456
//:     let h3 %i32 hash32 123457
//:     let report:
//:         test_report_new "hash32_module_doc"
//:         |> test_report_push assert "same input stable" eq h1 h2
//:         |> test_report_push assert "different input likely differs" ne h1 h3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

#import "core/math" as *
#import "core/cast" as *
#import "core/option" as *
#import "alloc/string/access" as string
#import "alloc/string/byte_index" as string_byte_index
#import "alloc/hash/fnv1a32" as *

//: mix: 32-bit [値/あたい]を avalanche [混合/こんごう]する
//:
//: ### [目的/もくてき]
//: - hash の[下位/かい] bit まで[偏/かたよ]りを[散/ちら]し、bucket [選択/せんたく]での[偏在/へんざい]を[減/へ]らします。
//:
//: ### [契約/けいやく]
//: - 同じ入力には同じ `i32` bit pattern を[返/かえ]します。
//: - 入力と出力はどちらも 32-bit bit pattern として[扱/あつか]い、失敗値や sentinel は[持/も]ちません。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `xor`、unsigned shift、wraparound multiplication を 2 round [組/く]み[合/あ]わせます。
//: - 定数は MurmurHash3 系の finalizer に近い avalanche constant です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_mix_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"mix stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"mix changes nearby input\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let a %i32 mix 42
//:     let b %i32 mix 42
//:     let c %i32 mix 43
//:     let report:
//:         test_report_new "hash32_mix_doc"
//:         |> test_report_push assert "mix stable" eq a b
//:         |> test_report_push assert "mix changes nearby input" ne a c
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn mix %fn i32 i32 \x:
    let x_s16 %i32 shr_u x 16
    let h1 %i32 xor x x_s16
    let h2 %i32 mul h1 -2048144789
    let h2_s13 %i32 shr_u h2 13
    let h3 %i32 xor h2 h2_s13
    let h4 %i32 mul h3 -1028477387
    let h4_s16 %i32 shr_u h4 16
    xor h4 h4_s16

//: hash_bytes_loop: `str` の UTF-8 byte [列/れつ]を FNV-1a state へ[混/ま]ぜる
//:
//: ### [目的/もくてき]
//: - `hash32 str` overload の byte 走査を 1 [箇所/かしょ]へ[集約/しゅうやく]します。
//:
//: ### [契約/けいやく]
//: - `idx >= n` なら現在の `Fnv1a32` state をそのまま[返/かえ]します。
//: - `checked_string_byte_at s idx` が `Option::Some b` なら byte `b` を `fnv1a32_update` へ[渡/わた]して次 index へ[進/すす]みます。
//: - `Option::None` なら out-of-range を sentinel byte に[変換/へんかん]せず、現在の state を[返/かえ]して停止します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - 再帰で `idx` を 1 ずつ[進/すす]めます。
//: - byte 読み取りは `alloc/string/byte_index` の checked API に[委譲/いじょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - `max 0 (n - idx)` byte を[読/よ]むため O(n - idx) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_hash_bytes_loop_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"some branch updates byte\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"end branch keeps state\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/fnv1a32" as *
//:| #import "alloc/hash/hash32" as *
//:| #import "alloc/string/access" as string
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let h_loop0 %Fnv1a32 new_fnv1a32
//:     let h_manual0 %Fnv1a32 new_fnv1a32
//:     let looped %Fnv1a32 hash_bytes_loop "A" string::len "A" 0 h_loop0
//:     let manual %Fnv1a32 fnv1a32_update h_manual0 65
//:     let some_ok %bool eq fnv1a32_finalize looped fnv1a32_finalize manual
//:     let h_stop0 %Fnv1a32 new_fnv1a32
//:     let h_stop_expected %Fnv1a32 new_fnv1a32
//:     let stopped %Fnv1a32 hash_bytes_loop "A" 1 1 h_stop0
//:     let stop_ok %bool eq fnv1a32_finalize stopped fnv1a32_finalize h_stop_expected
//:     let report:
//:         test_report_new "hash32_hash_bytes_loop_doc"
//:         |> test_report_push assert "some branch updates byte" some_ok
//:         |> test_report_push assert "end branch keeps state" stop_ok
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash_bytes_loop %fn str fn i32 fn i32 fn Fnv1a32 Fnv1a32 \s\n\idx\h:
    if:
        ge idx n
        then h
        else:
            match string_byte_index::checked_string_byte_at s idx:
                Option::Some b:
                    let next_idx %i32 add idx 1
                    let next_h %Fnv1a32 fnv1a32_update h b
                    hash_bytes_loop s n next_idx next_h
                Option::None:
                    h

//: hash32: `bool` を 32-bit hash へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `false` / `true` の[小/ちい]さな[離散/りさん]キーを hash table [向/む]けに[混合/こんごう]します。
//:
//: ### [契約/けいやく]
//: - 同じ `bool` には同じ hash を[返/かえ]します。
//: - `false` と `true` は異なる `i32` bit pattern を[返/かえ]すように[混合/こんごう]します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `bool` を `0` / `1` の `i32` へ cast し、seed と XOR して `mix` へ[渡/わた]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_bool_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"bool stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"bool values differ\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let h_true %i32 hash32 true
//:     let h_true_again %i32 hash32 true
//:     let h_false %i32 hash32 false
//:     let report:
//:         test_report_new "hash32_bool_doc"
//:         |> test_report_push assert "bool stable" eq h_true h_true_again
//:         |> test_report_push assert "bool values differ" ne h_true h_false
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash32 %fn bool i32 \key:
    let k %i32 cast key
    mix xor k -1640531527

//: hash32: `i32` を 32-bit hash へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - 32-bit integer key をそのまま hash table [向/む]けの[分布/ぶんぷ]へ[変換/へんかん]します。
//:
//: ### [契約/けいやく]
//: - 同じ `i32` bit pattern には同じ hash を[返/かえ]します。
//: - 失敗条件はなく、sentinel 値を[返/かえ]しません。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - key と seed を XOR し、`mix` の avalanche [混合/こんごう]を[通/とお]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_i32_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"i32 stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"i32 nearby differs\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let h1 %i32 hash32 123456
//:     let h2 %i32 hash32 123456
//:     let h3 %i32 hash32 123457
//:     let report:
//:         test_report_new "hash32_i32_doc"
//:         |> test_report_push assert "i32 stable" eq h1 h2
//:         |> test_report_push assert "i32 nearby differs" ne h1 h3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash32 %fn i32 i32 \key:
    mix xor key -1640531527

//: hash32: `u8` を 32-bit hash へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - byte key や[小/ちい]さな[分類値/ぶんるいち]を hash table [向/む]けに[混合/こんごう]します。
//:
//: ### [契約/けいやく]
//: - `u8` の 0..255 の値を `i32` bit pattern へ[広/ひろ]げてから hash します。
//: - 同じ byte には同じ hash を[返/かえ]します。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `u8` を `i32` へ cast し、seed と XOR して `mix` へ[渡/わた]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_u8_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"u8 stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"u8 nearby differs\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let key %u8 cast 42
//:     let same %u8 cast 42
//:     let other %u8 cast 43
//:     let h1 %i32 hash32 key
//:     let h2 %i32 hash32 same
//:     let h3 %i32 hash32 other
//:     let report:
//:         test_report_new "hash32_u8_doc"
//:         |> test_report_push assert "u8 stable" eq h1 h2
//:         |> test_report_push assert "u8 nearby differs" ne h1 h3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash32 %fn u8 i32 \key:
    let k %i32 cast key
    mix xor k -1640531527

//: hash32: `i64` を 32-bit hash へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - 64-bit integer key を 32-bit hash table [向/む]けの[分布/ぶんぷ]へ[折/お]りたたみます。
//:
//: ### [契約/けいやく]
//: - 同じ `i64` bit pattern には同じ hash を[返/かえ]します。
//: - 64-bit から 32-bit への[折/お]りたたみなので[衝突/しょうとつ]はありえます。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - [下位/かい] 32-bit と[上位/じょうい] 32-bit を XOR し、その folded value を seed と XOR して `mix` へ[渡/わた]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_i64_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"i64 stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"i64 folded implementation\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/cast" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let key %i64 cast 123
//:     let h1 %i32 hash32 key
//:     let h2 %i32 hash32 %i64 cast 123
//:     let high %i64 mul %i64 cast 65536 %i64 cast 65536
//:     let wide %i64 add high %i64 cast 123
//:     let folded_same %bool eq hash32 wide hash32 122
//:     let report:
//:         test_report_new "hash32_i64_doc"
//:         |> test_report_push assert "i64 stable" eq h1 h2
//:         |> test_report_push assert "i64 folded implementation" folded_same
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash32 %fn i64 i32 \key:
    let lo %i32 cast key
    let hi64 %i64 shr_u key %i64 cast 32
    let hi %i32 cast hi64
    let folded %i32 xor lo hi
    mix xor folded -1640531527

//: hash32: `str` を 32-bit hash へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - UTF-8 `str` を `HashMap` / `HashSet` の string key として[扱/あつか]えるようにします。
//:
//: ### [契約/けいやく]
//: - 同じ byte [列/れつ]には同じ hash を[返/かえ]します。
//: - Unicode scalar 数ではなく UTF-8 byte [列/れつ]を hash 対象にします。
//: - invalid string は `str` 型の外側の問題であり、この overload は `str` として[渡/わた]された byte [列/れつ]だけを[読/よ]みます。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `string::len` で byte 長を[得/え]て、`hash_bytes_loop` で FNV-1a state を[更新/こうしん]し、最後に `mix` へ[渡/わた]します。
//:
//: ### [計算量/けいさんりょう]
//: - byte 長を n として O(n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hash32_str_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"str stable\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"str differs by byte\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/hash/hash32" as *
//:| #import "core/math" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let h1 %i32 hash32 "abc"
//:     let h2 %i32 hash32 "abc"
//:     let h3 %i32 hash32 "abd"
//:     let report:
//:         test_report_new "hash32_str_doc"
//:         |> test_report_push assert "str stable" eq h1 h2
//:         |> test_report_push assert "str differs by byte" ne h1 h3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hash32 %fn str i32 \s:
    let n %i32 string::len s
    let h0 %Fnv1a32 new_fnv1a32
    let h1 %Fnv1a32 hash_bytes_loop s n 0 h0
    mix fnv1a32_finalize h1
