//: # fenwick/storage
//: `Fenwick` の typed `Vec<i32>` storage 操作
//:
//: ### [目的/もくてき]
//: - 1-indexed `bit` cell の読み書き、allocation、cleanup を集約します。
//: - public API が raw pointer や raw i32 load/store を扱わない構成を保ちます。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

pub fn fenwick_load_owned %fn &Vec i32 fn i32 Option i32 \bit\idx:
    vec::get<i32> bit idx

pub fn fenwick_store_owned %impure fn &Vec i32 impure fn i32 impure fn i32 unit \bit\idx\value:
    vec::replace<i32> bit idx value

pub fn fenwick_alloc_bit %impure fn i32 Result Vec i32 Diag \bit_len:
    match vec::filled<i32> bit_len 0:
        Result::Err _e:
            diag_err<Vec<i32>> diag_out_of_memory
        Result::Ok bit:
            ok<Vec<i32>, Diag> bit

pub fn fenwick_free_bit %fn Vec i32 unit \bit:
    vec::free<i32> bit
