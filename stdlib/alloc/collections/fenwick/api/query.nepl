//: # fenwick/api/query
//: `Fenwick` の借用 query API
//:
//: ### [目的/もくてき]
//: - `sum_prefix` / `sum_range` を `Fenwick` owner を消費しない read-only API として提供します。
//: - range validation を API boundary に置き、prefix traversal は `query` module に委譲します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../query" as *
#import "./diagnostic" as *
#import "core/field" as *

//: ## sum_prefix
//: [区間/くかん] `[0, r)` の[和/わ]を[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - `r` は 0 以上 `len` 以下でなければなりません。
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick>:
//:         unwrap_ok<Fenwick, Diag> new 5
//:         |> add 0 1 |> uwok
//:         |> add 1 2 |> uwok
//:         |> add 2 3 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_prefix &fw 3;
//:     free fw
//:     if eq total 6 1 0
//: ```
pub fn sum_prefix <(&Fenwick,i32)*>Result<i32, Diag>> (fw, r):
    let n <i32> *field::get_ref fw "n"
    if:
        and le 0 r le r n
        then:
            let bit <&Vec<i32>> field::get_ref fw "bit"
            match fenwick_sum_prefix_storage bit r:
                Option::Some acc:
                    ok<i32, Diag> acc
                Option::None:
                    diag_err<i32> fenwick_diag_index
        else:
            let d <Diag> fenwick_diag_index
            err<i32, Diag> d

//: ## sum_range
//: [区間/くかん] `[l, r)` の[和/わ]を[返/かえ]す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick>:
//:         unwrap_ok<Fenwick, Diag> new 5
//:         |> add 0 1 |> uwok
//:         |> add 1 2 |> uwok
//:         |> add 2 3 |> uwok
//:         |> add 3 4 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &fw 1 4;
//:     free fw
//:     if eq total 9 1 0
//: ```
pub fn sum_range <(&Fenwick,i32,i32)*>Result<i32, Diag>> (fw, l, r):
    let n <i32> *field::get_ref fw "n"
    if:
        and and le 0 l le l r le r n
        then:
            let bit <&Vec<i32>> field::get_ref fw "bit"
            match fenwick_sum_prefix_storage bit r:
                Option::Some sr:
                    match fenwick_sum_prefix_storage bit l:
                        Option::Some sl:
                            ok<i32, Diag> sub sr sl
                        Option::None:
                            diag_err<i32> fenwick_diag_range
                Option::None:
                    diag_err<i32> fenwick_diag_range
        else:
            let d <Diag> fenwick_diag_range
            err<i32, Diag> d
