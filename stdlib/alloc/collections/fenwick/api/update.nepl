//: # fenwick/api/update
//: `Fenwick` の owner-consuming update API
//:
//: ### [目的/もくてき]
//: - `add` の index validation、storage update、owner-preserving error 生成を集約します。
//: - update 失敗時は `FenwickAddError` に元 owner を入れて返し、caller が cleanup できるようにします。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../mutation" as *
#import "./diagnostic" as *
#import "core/field" as *

//: ## fenwick_add_ok
//: 更新に[成功/せいこう]した `Fenwick` owner を `Result::Ok` へ[包/つつ]む
pub fn fenwick_add_ok %fn Fenwick Result Fenwick FenwickAddError \fw:
    ok fw

//: ## fenwick_add_err
//: update [失敗/しっぱい]を owner-preserving error に[変換/へんかん]する
pub fn fenwick_add_err %fn Fenwick fn Diag Result Fenwick FenwickAddError \fw\d:
    let e %FenwickAddError FenwickAddError fw d
    err e

//: ## add
//: `idx` に `delta` を[加算/かさん]する
//:
//: ### [注意/ちゅうい]
//: - [範囲外/はんいがい] index は `Result::Err FenwickAddError` です。
//: - `Err` には[変更前/へんこうまえ]の `Fenwick` owner が[入/はい]るので、caller は owner を[回収/かいしゅう]して `free` できます。
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let fw %Fenwick:
//:         unwrap_ok new 4
//:         |> add 0 2 |> uwok
//:         |> add 3 5 |> uwok
//:     let total %i32 unwrap_ok sum_range &fw 0 4;
//:     free fw
//:     if eq total 7 1 0
//: ```
pub fn add %impure fn Fenwick impure fn i32 impure fn i32 Result Fenwick FenwickAddError \fw\idx\delta:
    let n %i32 *field::get_ref &fw "n"
    if:
        and le 0 idx lt idx n
        then:
            let result %Result unit Diag block:
                let bit %&Vec i32 field::get_ref &fw "bit"
                if:
                    fenwick_add_storage bit n idx delta
                    then:
                        ok unit
                    else:
                        diag_err fenwick_diag_index
            match result:
                Result::Ok _unit:
                    fenwick_add_ok fw
                Result::Err d:
                    fenwick_add_err fw d
        else:
            let d %Diag fenwick_diag_index
            fenwick_add_err fw d
