//: # fenwick/mutation
//: `Fenwick` の point update traversal
//:
//: ### [目的/もくてき]
//: - `add` の 1-indexed traversal と cell 更新を API から分離します。
//: - storage 欠損は `false` として API 層へ返し、API 層が owner-preserving error へ変換します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "alloc/collections/vec" as vec
#import "./storage" as *

//: ## fenwick_add_storage
//: 1-indexed storage に point update を[適用/てきよう]する
//:
//: ### [契約/けいやく]
//: - `bit` owner は[消費/しょうひ]しません。
//: - public API は `0 <= idx < n` を検査してからこの helper を呼びます。
//: - 更新対象 cell をすべて読めた場合は `true` を返します。
//: - missing cell は storage invariant failure として `false` を返し、API 層で owner-preserving `FenwickAddError` に変換します。
//: - storage invariant failure の rollback は行いません。
//: - 現行実装は `i & -i` の lowbit で index を増やします。
//:
//: ### [計算量/けいさんりょう]
//: - valid Fenwick storage では O(log n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"fenwick_add_storage_doc\" count=3 failed=0\nassertion index=0 status=ok kind=bool label=\"update succeeds\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"cell 2 updated\" expected=\"3\" actual=\"3\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"cell 4 updated\" expected=\"3\" actual=\"3\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick/mutation" as *
//:| #import "alloc/collections/fenwick/storage" as *
//:| #import "alloc/collections/vec/types" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let bit %Vec i32 unwrap_ok fenwick_alloc_bit 5
//:     let ok %bool fenwick_add_storage &bit 4 1 3
//:     let v2 %i32 match fenwick_load_owned &bit 2:
//:         Option::Some v:
//:             v
//:         Option::None:
//:             -1
//:     let v4 %i32 match fenwick_load_owned &bit 4:
//:         Option::Some v:
//:             v
//:         Option::None:
//:             -1
//:     fenwick_free_bit bit
//:     let report:
//:         test_report_new "fenwick_add_storage_doc"
//:         |> test_report_push assert "update succeeds" ok
//:         |> test_report_push assert_eq_i32 "cell 2 updated" 3 v2
//:         |> test_report_push assert_eq_i32 "cell 4 updated" 3 v4
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn fenwick_add_storage %impure fn &Vec i32 impure fn i32 impure fn i32 impure fn i32 bool \bit\n\idx\delta:
    let mut i %i32 add idx 1
    let mut valid %bool true
    while and le i n valid:
        do:
            match fenwick_load_owned bit i:
                Option::Some cur:
                    fenwick_store_owned bit i add cur delta
                    let neg_i %i32 sub 0 i
                    let lb %i32 and i neg_i
                    set i add i lb
                Option::None:
                    set valid false
    valid
