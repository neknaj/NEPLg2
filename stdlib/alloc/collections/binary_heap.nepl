#indent 4

//: # binary_heap
//: `Ord` を[用/もち]いた max-heap priority queue
//:
//: ### [目的/もくてき]
//: - `BinaryHeap<.T>` を[提供/ていきょう]し、[最大値/さいだいち]の push / peek / pop を bare 名で[扱/あつか]えるようにします。
//: - [優先度付き/ゆうせんどつき] queue を `alloc/collections` の[標準/ひょうじゅん]構造として[揃/そろ]え、graph / scheduling / best-first [探索/たんさく]の[土台/どだい]にします。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` / `items` を struct field として[保持/ほじ]します。
//: - `items` は `Vec<Option<T>>` で、live slot は `Some(value)`、inactive slot は `None` です。
//: - [配列/はいれつ]の 0 [番目/ばんめ]を root とする 0-indexed binary max-heap を[採用/さいよう]し、`push` では sift-up、`pop_max` では sift-down を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [順序/じゅんじょ]は `Ord::lt` に[従/したが]います。`ord_lt a b` が true なら `b` の[方/ほう]が[優先/ゆうせん]されます。
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には heap payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `new` / `with_capacity` / `push` は `Result` を[返/かえ]します。
//: - `peek` / `len` / `cap` / `is_empty` は heap を[借用/しゃくよう]して[観測/かんそく]します。観測後の owner は caller が `free` または更新 API で[閉/と]じます。
//: - `pop` は terminal API として heap owner を[消費/しょうひ]し、内部 storage を[閉/と]じて[値/あたい]だけを[返/かえ]します。
//: - `pop_max` は[更新後/こうしんご]の owner と[取/と]り[出/だ]した `Option<T>` を[同時/どうじ]に[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `cap` / `is_empty` / `peek` は O(1) です。
//: - `push` / `pop_max` は O(log n) です。
//: - `new` / `with_capacity` / `free` は O(n) です。storage 全 slot を `None` で[初期化/しょきか]するためです。

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BinaryHeap
//: [最大値/さいだいち]を root に[保/たも]つ priority queue の[所有者/しょゆうしゃ]
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `items.len == cap`
//: - `0 <= i < len` の slot は `Some`
//: - `len <= i < cap` の slot は `None`
struct BinaryHeap<.T>:
    len <i32>
    cap <i32>
    items <Vec<Option<.T>>>

//: ## BinaryHeapPop
//: `pop_max` の[結果/けっか]
struct BinaryHeapPop<.T>:
    heap <BinaryHeap<.T>>
    item <Option<.T>>

fn heap_parent <(i32)->i32> (idx):
    div_s sub idx 1 2

fn heap_left <(i32)->i32> (idx):
    add mul idx 2 1

fn heap_right <(i32)->i32> (idx):
    add mul idx 2 2

fn heap_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

fn heap_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

fn heap_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace<Option<.T>> items idx item

fn heap_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

fn heap_swap_slots <.T: Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, a, b):
    let av <Option<.T>> heap_item_at<.T> items a
    let bv <Option<.T>> heap_item_at<.T> items b
    heap_store_slot<.T> items a bv
    heap_store_slot<.T> items b av

fn heap_sift_up <.T: Ord&Copy> <(&Vec<Option<.T>>,i32)*>()> (items, start):
    let mut idx <i32> start
    let mut done <bool> false
    while and lt 0 idx not done:
        do:
            let parent <i32> heap_parent idx
            match heap_item_at<.T> items parent:
                Option::Some pv:
                    match heap_item_at<.T> items idx:
                        Option::Some cv:
                            if:
                                ord_lt pv cv
                                then:
                                    heap_swap_slots<.T> items parent idx
                                    set idx parent
                                else:
                                    set done true
                        Option::None:
                            set done true
                Option::None:
                    set done true

fn heap_sift_down <.T: Ord&Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, len0, start):
    let mut idx <i32> start
    let mut done <bool> false
    while and lt idx len0 not done:
        do:
            let left <i32> heap_left idx
            if:
                le len0 left
                then:
                    set done true
                else:
                    match heap_item_at<.T> items idx:
                        Option::None:
                            set done true
                        Option::Some current:
                            match heap_item_at<.T> items left:
                                Option::None:
                                    set done true
                                Option::Some left_value:
                                    let right <i32> heap_right idx
                                    if:
                                        lt right len0
                                        then:
                                            match heap_item_at<.T> items right:
                                                Option::Some right_value:
                                                    if:
                                                        ord_lt current left_value
                                                        then:
                                                            if:
                                                                ord_lt left_value right_value
                                                                then:
                                                                    heap_swap_slots<.T> items idx right
                                                                    set idx right
                                                                else:
                                                                    heap_swap_slots<.T> items idx left
                                                                    set idx left
                                                        else:
                                                            if:
                                                                ord_lt current right_value
                                                                then:
                                                                    heap_swap_slots<.T> items idx right
                                                                    set idx right
                                                                else:
                                                                    set done true
                                                Option::None:
                                                    if:
                                                        ord_lt current left_value
                                                        then:
                                                            heap_swap_slots<.T> items idx left
                                                            set idx left
                                                        else:
                                                            set done true
                                        else:
                                            if:
                                                ord_lt current left_value
                                                then:
                                                    heap_swap_slots<.T> items idx left
                                                    set idx left
                                                else:
                                                    set done true

fn heap_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32)*>()> (src, dst, len0):
    let mut i <i32> 0
    while lt i len0:
        do:
            match heap_item_at<.T> src i:
                Option::Some item:
                    heap_store_slot<.T> dst i some<.T> item
                Option::None:
                    heap_store_slot<.T> dst i none<.T>
            set i add i 1

//: ## new
//: [空/から]の heap を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hp <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     let ok <bool> eq len<i32> &hp 0
//:     free<i32> hp
//:     if ok 1 0
//: ```
fn new <.T: Copy> <()*>Result<BinaryHeap<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して heap を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hp0 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> with_capacity<i32> 16;
//:     let ok0 <bool> eq len<i32> &hp0 0;
//:     let ok1 <bool> eq cap<i32> &hp0 16;
//:     free<i32> hp0;
//:     if and ok0 ok1 1 0
//: ```
fn with_capacity <.T: Copy> <(i32)*>Result<BinaryHeap<.T>, Diag>> (cap):
    let cap0 <i32> heap_normalize_capacity cap
    match heap_alloc_slots<.T> cap0:
        Result::Ok items:
            ok<BinaryHeap<.T>, Diag> BinaryHeap<.T> 0 cap0 items
        Result::Err e:
            err<BinaryHeap<.T>, Diag> e

//: ## len
//: heap を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len <.T> <(&BinaryHeap<.T>)->i32> (hp):
    *field::get_ref hp "len"

//: ## cap
//: heap を[移動/いどう]せずに[容量/ようりょう]を[返/かえ]す
fn cap <.T> <(&BinaryHeap<.T>)->i32> (hp):
    *field::get_ref hp "cap"

//: ## is_empty
//: heap を[移動/いどう]せずに[空/から]かどうかを[返/かえ]す
fn is_empty <.T> <(&BinaryHeap<.T>)->bool> (hp):
    eq len<.T> hp 0

//: ## push
//: [要素/ようそ]を[追加/ついか]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hp0 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     let hp1 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp0 2;
//:     let hp2 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp1 7;
//:     let hp3 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp2 5;
//:     let ok <bool> match peek<i32> &hp3:
//:         Option::Some v:
//:             eq v 7
//:         Option::None:
//:             false
//:     free<i32> hp3
//:     if ok 1 0
//: ```
fn push <.T: Ord&Copy> <(BinaryHeap<.T>,.T)*>Result<BinaryHeap<.T>, Diag>> (hp, item):
    let len0 <i32> *field::get_ref &hp "len"
    let cap0 <i32> *field::get_ref &hp "cap"
    let items <Vec<Option<.T>>> field::get hp "items"
    if:
        eq len0 cap0
        then:
            let grown_cap <i32> mul cap0 2
            match heap_alloc_slots<.T> grown_cap:
                Result::Err e:
                    vec::free<Option<.T>> items
                    err<BinaryHeap<.T>, Diag> e
                Result::Ok next_items:
                    heap_copy_live_slots<.T> &items &next_items len0
                    heap_store_slot<.T> &next_items len0 some<.T> item
                    heap_sift_up<.T> &next_items len0
                    vec::free<Option<.T>> items
                    ok<BinaryHeap<.T>, Diag> BinaryHeap<.T> add len0 1 grown_cap next_items
        else:
            heap_store_slot<.T> &items len0 some<.T> item
            heap_sift_up<.T> &items len0
            ok<BinaryHeap<.T>, Diag> BinaryHeap<.T> add len0 1 cap0 items

//: ## peek
//: heap を[移動/いどう]せずに[最大/さいだい][要素/ようそ]を[読/よ]む
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hp0 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     let hp1 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp0 4;
//:     let hp2 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp1 9;
//:     let ok <bool> match peek<i32> &hp2:
//:         Option::Some v:
//:             eq v 9
//:         Option::None:
//:             false
//:     free<i32> hp2
//:     if ok 1 0
//: ```
fn peek <.T: Copy> <(&BinaryHeap<.T>)->Option<.T>> (hp):
    let len0 <i32> *field::get_ref hp "len"
    if:
        eq len0 0
        then none<.T>
        else:
            let items <&Vec<Option<.T>>> field::get_ref hp "items"
            heap_item_at<.T> items 0

//: ## pop_max
//: [最大/さいだい][要素/ようそ]を[取/と]り[出/だ]し、[更新後/こうしんご]の heap と[値/あたい]を[返/かえ]す
fn pop_max <.T: Ord&Copy> <(BinaryHeap<.T>)*>BinaryHeapPop<.T>> (hp):
    let len0 <i32> *field::get_ref &hp "len"
    let cap0 <i32> *field::get_ref &hp "cap"
    let items <Vec<Option<.T>>> field::get hp "items"
    if:
        eq len0 0
        then:
            let next_hp <BinaryHeap<.T>> BinaryHeap<.T> 0 cap0 items
            BinaryHeapPop<.T> next_hp none<.T>
        else:
            let root <Option<.T>> heap_item_at<.T> &items 0
            if:
                eq len0 1
                then:
                    heap_store_slot<.T> &items 0 none<.T>
                    let next_hp <BinaryHeap<.T>> BinaryHeap<.T> 0 cap0 items
                    BinaryHeapPop<.T> next_hp root
                else:
                    let last_idx <i32> sub len0 1
                    let last <Option<.T>> heap_item_at<.T> &items last_idx
                    heap_store_slot<.T> &items last_idx none<.T>
                    match last:
                        Option::Some value:
                            heap_store_slot<.T> &items 0 some<.T> value
                        Option::None:
                            heap_store_slot<.T> &items 0 none<.T>
                    heap_sift_down<.T> &items last_idx 0
                    let next_hp <BinaryHeap<.T>> BinaryHeap<.T> last_idx cap0 items
                    BinaryHeapPop<.T> next_hp root

//: ## pop
//: heap を[消費/しょうひ]して[最大/さいだい][要素/ようそ]だけを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hp0 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     let hp1 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp0 4;
//:     let hp2 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp1 9;
//:     let hp3 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> push<i32> hp2 1;
//:     match pop<i32> hp3:
//:         Option::Some v:
//:             if eq v 9 1 0
//:         Option::None:
//:             0
//: ```
fn pop <.T: Ord&Copy> <(BinaryHeap<.T>)*>Option<.T>> (hp):
    let p <BinaryHeapPop<.T>> pop_max<.T> hp
    let item <Option<.T>> *field::get_ref &p "item"
    free<.T> field::get p "heap"
    item

//: ## free
//: heap が[所有/しょゆう]する backing storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hp <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     free hp;
//:     0
//: ```
fn free <.T> <(BinaryHeap<.T>)->()> (hp):
    vec::free<Option<.T>> field::get hp "items"
