//: # vec/mutation/push
//: `Vec` の grow と末尾[追加/ついか]
//:
//: ### [目的/もくてき]
//: - `push` の allocation / reallocation と owner transfer をこの module に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - この module は typed `alloc_region` / `RegionToken` based grow を[使/つか]い、raw address を free owner として[扱/あつか]いません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/mem/allocator" as *
#import "core/math" as *
#import "core/result" as *
#import "core/field" as field
#import "../types" as *
#import "../invariant" as *
#import "core/field" as *

//: ## push
//: [末尾/まつび]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `item` を[末尾/まつび]へ[追加/ついか]し、[必要/ひつよう]なら[再確保/さいかくほ]した `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` は `&v.buffer` から Copy field として[読/よ]み、`storage` owner は `OwnedBuffer` から[取/と]り[出/だ]して[戻/もど]り[値/ち]または grow cleanup へ[移動/いどう]します。
//: - [容量/ようりょう][不足/ぶそく]なら allocator payload 上限を[確認/かくにん]したうえで 2 [倍/ばい]を[基準/きじゅん]に[拡張/かくちょう]し、typed `RegionToken<.T>` を新しい token へ[移/うつ]します。
//: - [空/から][容量/ようりょう] 0 の `Vec` に対しては 1 [要素分/ようそぶん]から[開始/かいし]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `Result<Vec<.T>, VecPushError<.T>>` です。`Err` の[場合/ばあい]も `Vec` owner が `VecPushError` に[戻/もど]るため、caller が cleanup や再試行を[選/えら]べます。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファ[番地/ばんち]は[変/か]わります。
//: - [現行/げんこう]の `push` は `.T: Copy` に[限定/げんてい]します。`OwnedBuffer<T>` と initialized prefix が[入/はい]るまでは、non-Copy payload の move/drop state を raw storage 上で[証明/しょうめい]できないためです。
//: - [容量/ようりょう][拡張/かくちょう]に[失敗/しっぱい]した[場合/ばあい]、旧 buffer は[解放/かいほう]せず `VecPushError.vec` に[戻/もど]します。`push` の API 型が owner の[行方/ゆくえ]を[表/あらわ]すため、実装 discipline に[依存/いぞん]しません。
//:
//: ### [計算量/けいさんりょう]
//: - [償却/しょうきゃく] O(1)
//: - [最悪/さいあく] O(n)（[再確保/さいかくほ]が[起/お]きる[場合/ばあい]）
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok<Vec<i32>, VecPushError<i32>> push v0 7;
//:     let ok <bool> eq len<i32> &v1 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: struct NonCopyPayload:
//:     value <i32>
//: fn main <()*>i32> ():
//:     let v0 <Vec<NonCopyPayload>> unwrap_ok new<NonCopyPayload>;
//:     let _v1 <Vec<NonCopyPayload>> unwrap_ok push v0 NonCopyPayload 7;
//:     0
//: ```
//:
//: ## vec_push_error_kind
//: `push` [失敗/しっぱい]の error kind を owner を[動/うご]かさず[読/よ]む
pub fn vec_push_error_kind <.T> <(&VecPushError<.T>)->StdErrorKind> (e):
    *field::get_ref e "error"

//: ## vec_push_error_vec
//: `push` [失敗/しっぱい]で[戻/もど]された `Vec` owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 `push` は `.T: Copy` 専用です。non-Copy payload の `VecPushError<T>` は、`OwnedBuffer<T>` の initialized cell / drop traversal が[完成/かんせい]するまで owner [回収/かいしゅう]面へ[出/だ]しません。
pub fn vec_push_error_vec <.T: Copy> <(VecPushError<.T>)->Vec<.T>> (e):
    field::get e "vec"

//: ## VecReallocRegionError
//: grow [失敗/しっぱい]時に旧 `RegionToken` owner を[返/かえ]す内部 payload
pub struct VecReallocRegionError<.T>:
    region <RegionToken<.T>>
    error <StdErrorKind>

//: vec_realloc_region_error_kind: grow [失敗/しっぱい]の error kind を[読/よ]む
pub fn vec_realloc_region_error_kind <.T> <(&VecReallocRegionError<.T>)->StdErrorKind> (e):
    *field::get_ref e "error"

//: vec_realloc_region_error_region: grow [失敗/しっぱい]で[戻/もど]された旧 region owner を[取/と]り[出/だ]す
pub fn vec_realloc_region_error_region <.T: Copy> <(VecReallocRegionError<.T>)->RegionToken<.T>> (e):
    field::get e "region"

//: ## vec_next_capacity
//: `push` に[必要/ひつよう]な次 capacity を allocator payload 上限内で[計算/けいさん]する
//:
//: ### [目的/もくてき]
//: - capacity grow の `cap * 2` が i32 overflow してから allocator に[渡/わた]される経路を[防/ふせ]ぎます。
//: - `.T` の element size と allocator payload 上限から、`cap + 1` を[収/おさ]められる次 capacity を[選/えら]びます。
//:
//: ### [注意/ちゅうい]
//: - `cap < 0` や element size が不正な場合は `InvalidOperation` を[返/かえ]します。
//: - 現在 capacity がすでに最大 count 以上なら `CapacityExceeded` を[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok with_capacity<i32> 1;
//:     let v1 <Vec<i32>> unwrap_ok<Vec<i32>, VecPushError<i32>> push v0 10;
//:     let v2 <Vec<i32>> unwrap_ok<Vec<i32>, VecPushError<i32>> push v1 20;
//:     let ok_len <bool> eq len<i32> &v2 2
//:     let ok_cap <bool> ge cap<i32> &v2 2
//:     let ok <bool> and ok_len ok_cap
//:     free<i32> v2;
//:     if ok 0 1
//: ```
fn vec_next_capacity <.T> <(i32)->Result<i32, StdErrorKind>> (cap0):
    let elem_size <i32> size_of<.T>
    if:
        or lt cap0 0 le elem_size 0
        then:
            Result<i32, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            let max_count <i32> div_s max_alloc_payload_bytes elem_size
            if:
                ge cap0 max_count
                then:
                    Result<i32, StdErrorKind>::Err StdErrorKind::CapacityExceeded
                else:
                    if:
                        eq cap0 0
                        then:
                            Result<i32, StdErrorKind>::Ok 1
                        else:
                            let half_limit <i32> div_s max_count 2
                            if:
                                gt cap0 half_limit
                                then:
                                    Result<i32, StdErrorKind>::Ok max_count
                                else:
                                    Result<i32, StdErrorKind>::Ok mul cap0 2

//: ## vec_realloc_region_or_keep
//: 既存 storage owner token を grow し、失敗時は旧 token を error payload に戻す
//:
//: ### [目的/もくてき]
//: - `Vec` の grow で、old `RegionToken<T>` の free obligation を新しい `RegionToken<T>` へ移す処理を 1 箇所へ[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - 成功時は返った token が storage owner です。失敗時は旧 token が `VecReallocRegionError.region` に[戻/もど]ります。
pub fn vec_realloc_region_or_keep <.T: Copy> <(RegionToken<.T>,i32)->Result<RegionToken<.T>, VecReallocRegionError<.T>>> (region, new_cap):
    let elem_size <i32> size_of<.T>
    if:
        or le new_cap 0 le elem_size 0
        then:
            Result::Err<RegionToken<.T>, VecReallocRegionError<.T>> VecReallocRegionError<.T> region StdErrorKind::InvalidOperation
        else:
            let max_count <i32> div_s max_alloc_payload_bytes elem_size
            if:
                gt new_cap max_count
                then:
                    Result::Err<RegionToken<.T>, VecReallocRegionError<.T>> VecReallocRegionError<.T> region StdErrorKind::CapacityExceeded
                else:
                    let new_bytes <i32> mul new_cap elem_size
                    match realloc_region_bytes_keep<.T> region new_bytes:
                        Result::Ok grown_region:
                            Result::Ok<RegionToken<.T>, VecReallocRegionError<.T>> grown_region
                        Result::Err e:
                            Result::Err<RegionToken<.T>, VecReallocRegionError<.T>> VecReallocRegionError<.T> (region_realloc_error_region<.T> e) StdErrorKind::OutOfMemory

pub fn push <.T: Copy> <(Vec<.T>,.T)->Result<Vec<.T>, VecPushError<.T>>> (v, item):
    let v_buffer_ref <&OwnedBuffer<.T>> field::get_ref &v "buffer"
    let v_len <i32> *field::get_ref v_buffer_ref "len"
    let v_initialized_len <i32> *field::get_ref v_buffer_ref "initialized_len"
    let v_cap <i32> *field::get_ref v_buffer_ref "cap"
    let v_invariant <VecCopyInvariant> vec_buffer_current_copy_invariant<.T> v_buffer_ref
    let v_buffer <OwnedBuffer<.T>> field::get v "buffer"
    let v_storage <VecStorage<.T>> field::get v_buffer "storage"
    match v_invariant:
        VecCopyInvariant::Invalid _reason:
            Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            if:
                eq v_len v_cap
                then:
                    match vec_next_capacity<.T> v_cap:
                        Result::Err grow_error:
                            Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) grow_error
                        Result::Ok grown_cap:
                            match v_storage:
                                VecStorage::Empty:
                                    if:
                                        and eq v_len 0 eq v_cap 0
                                        then:
                                            match alloc_region<.T> grown_cap:
                                                Result::Ok grown_region:
                                                    let next_len <i32> add v_len 1
                                                    let grown_data <MemPtr<.T>> region_ptr &grown_region
                                                    store<.T> add mem_ptr_addr grown_data mul v_len size_of<.T> item
                                                    Result::Ok<Vec<.T>, VecPushError<.T>> Vec<.T> (OwnedBuffer<.T> next_len next_len grown_cap (VecStorage<.T>::Owned grown_region))
                                                Result::Err _e:
                                                    Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) StdErrorKind::OutOfMemory
                                        else:
                                            Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) StdErrorKind::InvalidOperation
                                VecStorage::Owned v_region:
                                    match vec_realloc_region_or_keep<.T> v_region grown_cap:
                                        Result::Ok grown_region:
                                            let next_len <i32> add v_len 1
                                            let grown_data <MemPtr<.T>> region_ptr &grown_region
                                            store<.T> add mem_ptr_addr grown_data mul v_len size_of<.T> item
                                            Result::Ok<Vec<.T>, VecPushError<.T>> Vec<.T> (OwnedBuffer<.T> next_len next_len grown_cap (VecStorage<.T>::Owned grown_region))
                                        Result::Err e:
                                            let error <StdErrorKind> vec_realloc_region_error_kind<.T> &e
                                            let old_region <RegionToken<.T>> vec_realloc_region_error_region<.T> e
                                            Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap (VecStorage<.T>::Owned old_region))) error
                else:
                    match v_storage:
                        VecStorage::Empty:
                            Result::Err<Vec<.T>, VecPushError<.T>> VecPushError<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) StdErrorKind::InvalidOperation
                        VecStorage::Owned v_region:
                            let next_len <i32> add v_len 1
                            let v_data <MemPtr<.T>> region_ptr &v_region
                            store<.T> add mem_ptr_addr v_data mul v_len size_of<.T> item
                            Result::Ok<Vec<.T>, VecPushError<.T>> Vec<.T> (OwnedBuffer<.T> next_len next_len v_cap (VecStorage<.T>::Owned v_region))
