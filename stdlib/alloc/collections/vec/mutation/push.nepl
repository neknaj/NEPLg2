//: # vec/mutation/push
//: `Vec` の grow と末尾[追加/ついか]
//:
//: ### [目的/もくてき]
//: - `push` の allocation / reallocation と owner transfer をこの module に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - この module は typed `alloc_region` / `RegionToken` based grow を[使/つか]い、raw address を free owner として[扱/あつか]いません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/mem/allocator" as *
#import "core/math" as *
#import "core/result" as *
#import "core/field" as field
#import "../types" as *
#import "../invariant" as *
#import "core/field" as *

//: ## vec_push_slot_store_initialized
//: `push` の payload store と slot initialization proof を同じ private 境界で発行する
//:
//: ### [目的/もくてき]
//: - raw `store .T` と `collection_slot_initialize_empty` marker を `push` implementation file 内の private helper に[閉/と]じます。
//: - public `push` 本体は `RegionToken .T` owner と byte offset を渡すだけにし、raw pointer projection と Resource IR marker の対応をこの helper で一貫して[扱/あつか]います。
//:
//: ### [注意/ちゅうい]
//: - この helper は public にしません。`collection_slot_*` marker authority は direct import 可能な public helper として[公開/こうかい]せず、public collection API の内部実装だけが使います。
//: - `byte_off` の bounds / alignment と、`len` / `cap` との対応は caller 側の `VecCopyInvariant` と capacity proof が[担/にな]います。
fn vec_push_slot_store_initialized <.T> %fn &RegionToken .T fn i32 fn .T unit \storage\byte_off\item:
    let data %MemPtr .T region_ptr storage
    let slot %MemPtr .T mem_ptr_add<.T> data byte_off
    let raw %i32 mem_ptr_addr slot
    store<.T> raw item
    #intrinsic "collection_slot_initialize_empty" <.T> (storage, byte_off)

//: ## push
//: [末尾/まつび]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `item` を[末尾/まつび]へ[追加/ついか]し、[必要/ひつよう]なら[再確保/さいかくほ]した `Vec .T` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` は `&v.buffer` から Copy field として[読/よ]み、`storage` owner は `OwnedBuffer` から[取/と]り[出/だ]して[戻/もど]り[値/ち]または grow cleanup へ[移動/いどう]します。
//: - [容量/ようりょう][不足/ぶそく]なら allocator payload 上限を[確認/かくにん]したうえで 2 [倍/ばい]を[基準/きじゅん]に[拡張/かくちょう]し、typed `RegionToken .T` を新しい token へ[移/うつ]します。
//: - [空/から][容量/ようりょう] 0 の `Vec` に対しては 1 [要素分/ようそぶん]から[開始/かいし]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `Result (Vec .T) (VecPushError .T)` です。`Err` の[場合/ばあい]も `Vec` owner と[挿入/そうにゅう]されなかった `item` owner が `VecPushError.rejected` に[戻/もど]るため、caller が cleanup、再試行、item recovery を[選/えら]べます。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファ[番地/ばんち]は[変/か]わります。
//: - `push` は `.T: Copy` と `.T: Drop` の overload を[持/も]ちます。いずれも payload 非依存の `VecStorageInvariant` と private slot initialize helper に[接続/せつぞく]し、Copy raw-access proof へ[依存/いぞん]しません。
//: - [容量/ようりょう][拡張/かくちょう]に[失敗/しっぱい]した[場合/ばあい]、旧 buffer と `item` は[解放/かいほう]せず `VecPushError.rejected` に[戻/もど]します。`push` の API 型が owner の[行方/ゆくえ]を[表/あらわ]すため、実装 discipline に[依存/いぞん]しません。
//:
//: ### [計算量/けいさんりょう]
//: - [償却/しょうきゃく] O(1)
//: - [最悪/さいあく] O(n)（[再確保/さいかくほ]が[起/お]きる[場合/ばあい]）
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new;
//:     let v1 %Vec i32 unwrap_ok push v0 7;
//:     let observed_len %i32 len &v1
//:     let ok %bool eq observed_len 1
//:     free v1;
//:     if ok 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new
//:     let v1 %Vec DropPayload unwrap_ok push v0 (DropPayload 7)
//:     let observed_len %i32 len &v1
//:     let ok %bool eq observed_len 1
//:     free v1
//:     if ok 0 1
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.overload.no_match
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: struct PlainPayload:
//:     value %i32
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec PlainPayload vec_empty<PlainPayload>
//:     let _v1 %Vec PlainPayload unwrap_ok push v0 (PlainPayload 7)
//:     0
//: ```
//:
//: ## vec_push_error_kind
//: `push` [失敗/しっぱい]の error kind を owner を[動/うご]かさず[読/よ]む
pub fn vec_push_error_kind <.T> %fn &VecPushError .T StdErrorKind \e:
    *field::get_ref e "error"

//: ## vec_push_error_rejected
//: `push` [失敗/しっぱい]で[戻/もど]された `Vec` owner と rejected item owner をまとめて[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - non-Copy payload では、失敗時に `Vec` owner だけを[取/と]り[出/だ]すと `item` owner の[行方/ゆくえ]が API 型から[消/き]えます。
//: - この accessor は `VecPushRejected .T` を[返/かえ]し、caller が両 owner を同じ回収単位として[扱/あつか]えるようにします。
pub fn vec_push_error_rejected <.T> %fn VecPushError .T VecPushRejected .T \e:
    field::get e "rejected"

//: ## vec_push_rejected_with
//: `push` [失敗/しっぱい] payload の `Vec` owner と rejected item owner を同じ callback に[渡/わた]す
//:
//: ### [目的/もくてき]
//: - `VecPushRejected .T` は owner-backed aggregate なので、non-Copy payload では利用側が片方の field だけを[取/と]り[出/だ]す設計にはしません。
//: - この eliminator が `vec` と `item` を同時に取り出し、caller が渡した callback へ両 owner を同じ control-flow 上で[渡/わた]します。
//: - cleanup、retry、診断変換など、push failure recovery を rejected item owner を[隠/かく]さず[実装/じっそう]できます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn recover_failed_push %impure fn Vec DropPayload impure fn DropPayload i32 \returned\rejected:
//:     Drop::drop &rejected
//:     free returned
//:     1
//: fn push_or_recover %impure fn Vec DropPayload impure fn DropPayload i32 \items\item:
//:     match push items item:
//:         Result::Ok out:
//:             free out
//:             0
//:         Result::Err e:
//:             let rejected %VecPushRejected DropPayload vec_push_error_rejected e
//:             vec_push_rejected_with rejected @recover_failed_push
//: fn main %impure fn unit i32 \unit:
//:     let items %Vec DropPayload unwrap_ok new
//:     push_or_recover items (DropPayload 7)
//: ```
pub fn vec_push_rejected_with <.T,.R> %impure fn VecPushRejected .T impure fn impure fn Vec .T impure fn .T .R .R \rejected\callback:
    let vec %Vec .T field::get rejected "vec"
    let item %.T field::get rejected "item"
    callback vec item

//: ## vec_push_error_vec
//: `push` [失敗/しっぱい]で[戻/もど]された `Vec` owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - この accessor は `.T: Copy` 専用です。`item` owner を一緒に[返/かえ]さないため、non-Copy payload では `vec_push_error_rejected`（`.T`）と `vec_push_rejected_with`（`.T`, `.R`）を[使/つか]って `Vec` と `item` を同時に[回収/かいしゅう]します。
pub fn vec_push_error_vec <.T: Copy> %fn VecPushError .T Vec .T \e:
    let rejected %VecPushRejected .T vec_push_error_rejected<.T> e
    field::get rejected "vec"

//: ## VecReallocRegionError
//: grow [失敗/しっぱい]時に旧 `RegionToken` owner を[返/かえ]す private payload
//:
//: ### [注意/ちゅうい]
//: - この型は `Vec.push` 実装 file の内部だけで使います。public error recovery surface へは出さず、`VecPushError .T` が public API として返す owner を表します。
//: - payload slot を読まない storage owner 操作なので `.T: Copy` は要求しません。
struct VecReallocRegionError<.T>:
    region %RegionToken .T
    error %StdErrorKind

//: vec_realloc_region_error_kind: grow [失敗/しっぱい]の error kind を[読/よ]む
fn vec_realloc_region_error_kind <.T> %fn &VecReallocRegionError .T StdErrorKind \e:
    *field::get_ref e "error"

//: ## vec_next_capacity
//: `push` に[必要/ひつよう]な次 capacity を allocator payload 上限内で[計算/けいさん]する
//:
//: ### [目的/もくてき]
//: - capacity grow の `cap * 2` が i32 overflow してから allocator に[渡/わた]される経路を[防/ふせ]ぎます。
//: - `.T` の element size と allocator payload 上限から、`cap + 1` を[収/おさ]められる次 capacity を[選/えら]びます。
//:
//: ### [注意/ちゅうい]
//: - `cap < 0` や element size が不正な場合は `InvalidOperation` を[返/かえ]します。
//: - 現在 capacity がすでに最大 count 以上なら `CapacityExceeded` を[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok with_capacity 1;
//:     let v1 %Vec i32 unwrap_ok push v0 10;
//:     let v2 %Vec i32 unwrap_ok push v1 20;
//:     let observed_len %i32 len &v2
//:     let ok_len %bool eq observed_len 2
//:     let ok_cap %bool ge cap &v2 2
//:     let ok %bool and ok_len ok_cap
//:     free v2;
//:     if ok 0 1
//: ```
fn vec_next_capacity <.T> %fn i32 Result i32 StdErrorKind \cap0:
    let elem_size %i32 size_of<.T>
    if:
        or lt cap0 0 le elem_size 0
        then:
            Result::Err StdErrorKind::InvalidOperation
        else:
            let max_count %i32 div_s max_alloc_payload_bytes elem_size
            if:
                ge cap0 max_count
                then:
                    Result::Err StdErrorKind::CapacityExceeded
                else:
                    if:
                        eq cap0 0
                        then:
                            Result::Ok 1
                        else:
                            let half_limit %i32 div_s max_count 2
                            if:
                                gt cap0 half_limit
                                then:
                                    Result::Ok max_count
                                else:
                                    Result::Ok mul cap0 2

//: ## vec_realloc_region_or_keep
//: 既存 storage owner token を grow し、失敗時は旧 token を error payload に戻す
//:
//: ### [目的/もくてき]
//: - `Vec` の grow で、old `RegionToken .T` の free obligation を新しい `RegionToken .T` へ移す処理を 1 箇所へ[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - 成功時は返った token が storage owner です。失敗時は旧 token が `VecReallocRegionError.region` に[戻/もど]ります。
//: - payload の raw load / raw store は行いません。この helper は storage owner の再確保境界だけを扱うため、`.T: Copy` を要求しません。
fn vec_realloc_region_or_keep <.T> %fn RegionToken .T fn i32 Result RegionToken .T VecReallocRegionError .T \region\new_cap:
    let elem_size %i32 size_of<.T>
    if:
        or le new_cap 0 le elem_size 0
        then:
            Result::Err VecReallocRegionError<.T> region StdErrorKind::InvalidOperation
        else:
            let max_count %i32 div_s max_alloc_payload_bytes elem_size
            if:
                gt new_cap max_count
                then:
                    Result::Err VecReallocRegionError<.T> region StdErrorKind::CapacityExceeded
                else:
                    let new_bytes %i32 mul new_cap elem_size
                    match realloc_region_bytes_keep<.T> region new_bytes:
                        Result::Ok grown_region:
                            Result::Ok grown_region
                        Result::Err e:
                            Result::Err VecReallocRegionError<.T> (region_realloc_error_region<.T> e) StdErrorKind::OutOfMemory

//: ## vec_push_storage_checked
//: payload 非依存 storage proof と slot initialize proof で `push` 本体を実行する private helper
//:
//: ### [目的/もくてき]
//: - `Copy` overload と `Drop` overload が同じ owner recovery / grow / slot initialize path を[共有/きょうゆう]できるようにします。
//: - `VecStorageInvariant` は payload を raw read しないため、`push` は Copy raw-access proof ではなく storage metadata / extent proof と item store proof に[分離/ぶんり]されます。
//:
//: ### [注意/ちゅうい]
//: - この helper は public にしません。public overload が型境界を[選/えら]び、この helper が private lifecycle proof boundary を[使/つか]います。
fn vec_push_storage_checked <.T> %fn Vec .T fn .T Result Vec .T VecPushError .T \v\item:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_len %i32 *field::get_ref v_buffer_ref "len"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_invariant %VecStorageInvariant vec_buffer_current_storage_invariant<.T> v_buffer_ref
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_invariant:
        VecStorageInvariant::Invalid _reason:
            Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) item) StdErrorKind::InvalidOperation
        VecStorageInvariant::Valid:
            if:
                eq v_len v_cap
                then:
                    match vec_next_capacity<.T> v_cap:
                        Result::Err grow_error:
                            Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) item) grow_error
                        Result::Ok grown_cap:
                            match v_storage:
                                VecStorage::Empty:
                                    if:
                                        and eq v_len 0 eq v_cap 0
                                        then:
                                            match alloc_region<.T> grown_cap:
                                                Result::Ok grown_region:
                                                    let next_len %i32 add v_len 1
                                                    let byte_off %i32 mul v_len size_of<.T>
                                                    vec_push_slot_store_initialized<.T> &grown_region byte_off item
                                                    Result::Ok Vec<.T> (OwnedBuffer<.T> next_len next_len grown_cap (VecStorage<.T>::Owned grown_region))
                                                Result::Err _e:
                                                    Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) item) StdErrorKind::OutOfMemory
                                        else:
                                            Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) item) StdErrorKind::InvalidOperation
                                VecStorage::Owned v_region:
                                    match vec_realloc_region_or_keep<.T> v_region grown_cap:
                                        Result::Ok grown_region:
                                            let next_len %i32 add v_len 1
                                            let byte_off %i32 mul v_len size_of<.T>
                                            vec_push_slot_store_initialized<.T> &grown_region byte_off item
                                            Result::Ok Vec<.T> (OwnedBuffer<.T> next_len next_len grown_cap (VecStorage<.T>::Owned grown_region))
                                        Result::Err e:
                                            let error %StdErrorKind vec_realloc_region_error_kind<.T> &e
                                            let old_region %RegionToken .T field::get e "region"
                                            Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap (VecStorage<.T>::Owned old_region))) item) error
                else:
                    match v_storage:
                        VecStorage::Empty:
                            Result::Err VecPushError<.T> (VecPushRejected<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap VecStorage<.T>::Empty)) item) StdErrorKind::InvalidOperation
                        VecStorage::Owned v_region:
                            let next_len %i32 add v_len 1
                            let byte_off %i32 mul v_len size_of<.T>
                            vec_push_slot_store_initialized<.T> &v_region byte_off item
                            Result::Ok Vec<.T> (OwnedBuffer<.T> next_len next_len v_cap (VecStorage<.T>::Owned v_region))

pub fn push <.T: Copy> %fn Vec .T fn .T Result Vec .T VecPushError .T \v\item:
    vec_push_storage_checked<.T> v item

pub fn push <.T: Drop> %fn Vec .T fn .T Result Vec .T VecPushError .T \v\item:
    vec_push_storage_checked<.T> v item
