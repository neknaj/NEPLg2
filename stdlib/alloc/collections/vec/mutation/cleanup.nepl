//: # vec/mutation/cleanup
//: `Vec` の clear/free
//:
//: ### [目的/もくてき]
//: - owner cleanup と length reset をまとめ、initialized prefix と storage dealloc の Resource IR lifecycle proof をこの implementation 境界に[閉/と]じます。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/mem/allocator" as allocator
#import "core/field" as field
#import "../types" as *
#import "core/math" as *
#import "core/traits/copy" as *
#import "core/traits/drop" as *

//: ## vec_cleanup_copy_initialized_prefix
//: Copy payload の initialized prefix を Resource IR 上で cleanup 済みにする
//:
//: ### [目的/もくてき]
//: - `clear` / `free` が `OwnedBuffer.initialized_len` で[表/あらわ]す prefix 全体を[走査/そうさ]し、各 slot が cleanup 対象範囲に[含/ふく]まれることを compiler の range proof へ渡します。
//: - `.T: Copy` では destructor 実行が不要なので、raw load による slot witness と `collection_slot_drop_traversal` marker を同じ private helper に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - この helper は public にしません。lifecycle marker authority は collection implementation file 内だけで[扱/あつか]います。
//: - non-Copy payload では Drop 実行の証明が必要なので、この helper は `.T: Copy` に[限定/げんてい]します。
fn vec_cleanup_copy_initialized_prefix <.T: Copy> %fn &RegionToken .T fn i32 unit \storage\initialized_len:
    let data %MemPtr .T region_ptr storage
    let mut i %i32 0
    while lt i initialized_len:
        do:
            let byte_off %i32 mul i size_of<.T>
            let slot %MemPtr .T mem_ptr_add<.T> data byte_off
            let raw %i32 mem_ptr_addr slot
            let _value %.T load<.T> raw
            set i add i 1
    #intrinsic "collection_slot_drop_traversal" <.T> (storage, initialized_len)

//: ## vec_cleanup_drop_initialized_prefix
//: Drop payload の initialized prefix を実際の `Drop::drop` 呼び出しで cleanup する
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の `Vec` が保持する initialized prefix 全体を[走査/そうさ]し、各 slot の loaded value に対する actual Drop proof を Resource IR に[渡/わた]します。
//: - source 上の `load -> Drop::drop -> collection_slot_drop_traversal` を同じ private helper に[閉/と]じ、stdlib module 名の allowlist ではなく compiler の generic full-range certificate で storage release の前提を[証明/しょうめい]します。
//:
//: ### [注意/ちゅうい]
//: - この helper は destructor を[呼/よ]ぶため impure です。
//: - `i = 0` から `initialized_len` 未満まで 1 ずつ進む単純な全範囲走査にし、Resource IR の range certificate が source の loop 形状を[検査/けんさ]できるようにします。
fn vec_cleanup_drop_initialized_prefix <.T: Drop> %impure fn &RegionToken .T impure fn i32 unit \storage\initialized_len:
    let data %MemPtr .T region_ptr storage
    let mut i %i32 0
    while lt i initialized_len:
        do:
            let byte_off %i32 mul i size_of<.T>
            let slot %MemPtr .T mem_ptr_add<.T> data byte_off
            let raw %i32 mem_ptr_addr slot
            let loaded %.T load<.T> raw
            Drop::drop &loaded
            set i add i 1
    #intrinsic "collection_slot_drop_traversal" <.T> (storage, initialized_len)

//: ## vec_cleanup_release_storage
//: `RegionToken` storage の raw release と Resource IR storage dealloc proof を同じ private 境界で発行する
//:
//: ### [目的/もくてき]
//: - token の raw owner identity と size field を[取/と]り[出/だ]し、allocator の raw dealloc を実行した直後に `collection_slot_storage_dealloc` marker を発行します。
//: - storage release proof を direct-import 可能な `vec/storage` 側ではなく、public cleanup API の implementation file に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - caller は事前に initialized prefix cleanup を完了してからこの helper を[呼/よ]びます。
fn vec_cleanup_release_storage <.T> %fn RegionToken .T unit \region:
    let raw %i32 field::get region "raw"
    let total_size %i32 field::get region "size"
    allocator::dealloc_raw raw total_size
    #intrinsic "collection_slot_storage_dealloc" <> (&region)

//: ## clear
//: [要素/ようそ]をすべて[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - `len` を 0 にして、[確保済/かくほず]み[領域/りょういき]を[再利用/さいりよう]できる[空/から]ベクタを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `OwnedBuffer` から `storage` owner と `initialized_len` を[取/と]り[出/だ]し、owned storage では initialized prefix cleanup proof を発行してから `len` と `initialized_len` を 0 にした新しい `OwnedBuffer` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]メモリは[解放/かいほう]しません。
//: - `.T: Copy` では destructor 実行が不要ですが、Resource IR の initialized slot state を閉じるため prefix 走査 proof は実行します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new;
//:     let v1 %Vec i32 unwrap_ok push v0 1;
//:     let v2 clear v1;
//:     let observed_len %i32 len &v2
//:     let ok %bool eq observed_len 0
//:     free v2;
//:     if ok 0 1
//: ```
pub fn clear <.T: Copy> %fn Vec .T Vec .T \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_storage:
        VecStorage::Empty:
            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap VecStorage<.T>::Empty)
        VecStorage::Owned region:
            vec_cleanup_copy_initialized_prefix<.T> &region v_initialized_len
            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap (VecStorage<.T>::Owned region))

//: ## clear
//: Drop payload の[要素/ようそ]をすべて[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の initialized prefix にある各 payload へ `Drop::drop` を[実行/じっこう]し、`len` / `initialized_len` を 0 にした `Vec` owner を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `Owned` storage では private helper `vec_cleanup_drop_initialized_prefix` を[呼/よ]びます。
//: - helper 内の loop と `Drop::drop` 呼び出しが Resource IR の full-range cleanup proof になり、compiler は storage release 前の live slot 残りを generic に[検査/けんさ]します。
//:
//: ### [注意/ちゅうい]
//: - destructor を[呼/よ]ぶため impure です。
//: - storage 自体は[保持/ほじ]し、再利用できる[空/から] `Vec` を[返/かえ]します。
pub fn clear <.T: Drop> %impure fn Vec .T Vec .T \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_storage:
        VecStorage::Empty:
            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap VecStorage<.T>::Empty)
        VecStorage::Owned region:
            vec_cleanup_drop_initialized_prefix<.T> &region v_initialized_len
            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap (VecStorage<.T>::Owned region))

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `Vec .T` が `VecStorage::Owned` payload として[所有/しょゆう]する storage [領域/りょういき]を[明示的/めいじてき]に[解放/かいほう]します。
//:
//: ### [実装/じっそう]
//: - `OwnedBuffer` から `storage` owner と `initialized_len` を[取/と]り[出/だ]します。
//: - `VecStorage::Owned(region)` では initialized prefix cleanup proof を発行してから、raw storage release と `collection_slot_storage_dealloc` proof を同じ private helper で[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - `Vec` [自体/じたい]は[値/あたい]なので[追加/ついか]の[解放/かいほう]は[不要/ふよう]です。
//: - `cap = 0` の[空/から]ベクタでも[呼/よ]べます。
//: - この overload は `.T: Copy` payload 用です。`.T: Drop` payload は actual `Drop::drop` proof を使う別 overload で[扱/あつか]います。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok new;
//:     free v;
//:     0
//: ```
pub fn free <.T: Copy> %fn Vec .T unit \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_storage:
        VecStorage::Empty:
            unit
        VecStorage::Owned region:
            vec_cleanup_copy_initialized_prefix<.T> &region v_initialized_len
            vec_cleanup_release_storage<.T> region

//: ## free
//: Drop payload の[内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の initialized prefix を actual Drop proof で[閉/と]じてから、`VecStorage::Owned` の storage owner を[解放/かいほう]します。
//:
//: ### [実装/じっそう]
//: - `VecStorage::Owned(region)` では `vec_cleanup_drop_initialized_prefix` の full-range cleanup proof と `vec_cleanup_release_storage` の raw dealloc proof を[連続/れんぞく]させます。
//: - `VecStorage::Empty` は owner token も initialized slot も[持/も]たないため何もしません。
//:
//: ### [注意/ちゅうい]
//: - destructor を[呼/よ]ぶため impure です。
//: - payload が `Copy` でも `Drop` でもない型は、この overload でも Copy overload でも[受/う]け[付/つ]けません。
pub fn free <.T: Drop> %impure fn Vec .T unit \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_storage:
        VecStorage::Empty:
            unit
        VecStorage::Owned region:
            vec_cleanup_drop_initialized_prefix<.T> &region v_initialized_len
            vec_cleanup_release_storage<.T> region
