//: # vec/mutation/cleanup
//: `Vec` の clear/free
//:
//: ### [目的/もくてき]
//: - owner cleanup と length reset をまとめ、storage state に[応/おう]じた[解放/かいほう]を `vec/storage` に[委譲/いじょう]します。

#indent 4

#import "core/mem" as *
#import "core/field" as field
#import "../types" as *
#import "../storage/cleanup" as vec_storage
#import "core/field" as *
#import "core/math" as *
#import "core/traits/copy" as *

//: ## clear
//: [要素/ようそ]をすべて[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - `len` を 0 にして、[確保済/かくほず]み[領域/りょういき]を[再利用/さいりよう]できる[空/から]ベクタを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `OwnedBuffer` から `storage` owner を[取/と]り[出/だ]し、`cap` はそのままに `len` と `initialized_len` を 0 にした新しい `OwnedBuffer` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]メモリは[解放/かいほう]しません。
//: - 要素ごとの Drop traversal はまだ[実装/じっそう]されていないため、`.T: Copy` の Vec だけを[対象/たいしょう]にします。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     let v2 clear<i32> v1;
//:     let observed_len <i32> len<i32> &v2
//:     let ok <bool> eq observed_len 0
//:     free<i32> v2;
//:     if ok 0 1
//: ```
pub fn clear <.T: Copy> <(Vec<.T>)->Vec<.T>> (v):
    let v_buffer_ref <&OwnedBuffer<.T>> field::get_ref &v "buffer"
    let v_cap <i32> *field::get_ref v_buffer_ref "cap"
    let v_buffer <OwnedBuffer<.T>> field::get v "buffer"
    let v_storage <VecStorage<.T>> field::get v_buffer "storage"
    Vec<.T> (OwnedBuffer<.T> 0 0 v_cap v_storage)

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` が `VecStorage::Owned` payload として[所有/しょゆう]する storage [領域/りょういき]を[明示的/めいじてき]に[解放/かいほう]します。
//:
//: ### [実装/じっそう]
//: - `OwnedBuffer` から `storage` owner を[取/と]り[出/だ]し、`vec/storage` の cleanup helper へ[移動/いどう]します。
//: - `VecStorage::Empty` は owner payload を[持/も]たず、`VecStorage::Owned(region)` だけが owner-consuming destructor へ[進/すす]みます。
//:
//: ### [注意/ちゅうい]
//: - `Vec` [自体/じたい]は[値/あたい]なので[追加/ついか]の[解放/かいほう]は[不要/ふよう]です。
//: - `cap = 0` の[空/から]ベクタでも[呼/よ]べます。
//: - 現行実装は storage-only dealloc です。`OwnedBuffer<T>` と initialized prefix traversal が[入/はい]るまで、要素 Drop を[必要/ひつよう]としない `.T: Copy` だけを[受/う]け[付/つ]けます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     free<i32> v;
//:     0
//: ```
pub fn free <.T: Copy> <(Vec<.T>)->()> (v):
    let v_buffer <OwnedBuffer<.T>> field::get v "buffer"
    let v_storage <VecStorage<.T>> field::get v_buffer "storage"
    vec_storage::vec_free_storage<.T> v_storage
