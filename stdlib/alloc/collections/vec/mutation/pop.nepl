//: # vec/mutation/pop
//: `Vec` の末尾[取/と]り[出/だ]し
//:
//: ### [目的/もくてき]
//: - owner を[消費/しょうひ]し、要素と次の owner を named struct で[返/かえ]す `pop` を[所有/しょゆう]します。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "../types" as *
#import "../storage" as vec_storage
#import "../raw" as vec_raw
#import "core/field" as *

//: ## pop
//: [末尾/まつび][要素/ようそ]を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - [末尾/まつび][要素/ようそ]を `Option` で[返/かえ]し、[長/なが]さを 1 [減/へ]らした `Vec` を[同時/どうじ]に[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len == 0` なら `Option::None` です。
//: - [要素/ようそ]がある[場合/ばあい]は[最後/さいご]の 1 [件/けん]を typed `load` し、`len - 1` の `Vec` と[組/く]にして[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `VecPop<.T>` です。
//: - [確保/かくほ]も[解放/かいほう]も[行/おこな]わないため O(1) です。
//: - [現行/げんこう]の `pop` は `.T: Copy` に[限定/げんてい]します。`OwnedBuffer<T>` と initialized cell の moved/uninitialized [状態/じょうたい]が[入/はい]るまでは、non-Copy payload を raw `load` で[取/と]り[出/だ]した[後/あと]の storage cell [状態/じょうたい]を[安全/あんぜん]に[表現/ひょうげん]できないためです。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 4;
//:     let p pop<i32> v1;
//:     let next <Vec<i32>> get p "vec";
//:     free<i32> next;
//:     0
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: struct NonCopyPayload:
//:     value <i32>
//: fn main <()*>i32> ():
//:     let v0 <Vec<NonCopyPayload>> unwrap_ok new<NonCopyPayload>;
//:     let p pop<NonCopyPayload> v0;
//:     let _next <Vec<NonCopyPayload>> get p "vec";
//:     0
//: ```
pub fn pop <.T: Copy> <(Vec<.T>)->VecPop<.T>> (v):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    if:
        eq v_len 0
        then:
            VecPop<.T> (Vec<.T> v_len v_cap v_storage v_data) none<.T>
        else:
            match v_storage:
                VecStorageState::Empty:
                    VecPop<.T> vec_storage::vec_empty<.T> none<.T>
                VecStorageState::Owned:
                    let next_len <i32> sub v_len 1
                    let item <.T> vec_raw::vec_read_at<.T> v_data next_len
                    VecPop<.T> (Vec<.T> next_len v_cap VecStorageState::Owned v_data) some<.T> item

//: ## drop_last
//: [末尾/まつび][要素/ようそ]を[捨/す]て、次の `Vec` owner だけを[返/かえ]す
//:
//: ### [目的/もくてき]
//: - stack のように末尾値を使わない caller が、`Vec` の raw `data` field を直接読まずに長さだけを 1 減らした owner を得られるようにします。
//:
//: ### [注意/ちゅうい]
//: - 現行 `Vec` は non-Copy payload の moved/uninitialized cell を表せないため、`.T: Copy` に限定します。
//: - 要素の値は返しません。値も必要な場合は `pop` を使います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:         |> drop_last<i32>
//:     let mut checks checks_new
//:     set checks checks_push checks check_eq_i32 1 len<i32> &v
//:     free<i32> v
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
pub fn drop_last <.T: Copy> <(Vec<.T>)->Vec<.T>> (v):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    let next_len <i32> if eq v_len 0 0 sub v_len 1
    Vec<.T> next_len v_cap v_storage v_data
