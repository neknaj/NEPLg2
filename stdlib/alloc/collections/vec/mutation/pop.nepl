//: # vec/mutation/pop
//: `Vec` の末尾[取/と]り[出/だ]し
//:
//: ### [目的/もくてき]
//: - owner を[消費/しょうひ]し、要素と次の owner を named struct で[返/かえ]す `pop` を[所有/しょゆう]します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/drop" as *
#import "../types" as *
#import "../storage" as vec_storage
#import "../invariant" as *
#import "core/field" as *

//: ## vec_pop_move_out_initialized_slot
//: 末尾 slot を raw load し、Resource IR 上で moved-out にする private helper
//:
//: ### [目的/もくてき]
//: - `pop` は caller に removed payload owner を返すため、removed tail slot を raw load します。
//: - raw load だけでは backing storage 上の initialized slot state が残るため、同じ source boundary で `collection_slot_move_out` marker を[発行/はっこう]します。
//: - public `pop` body は raw pointer operation や lifecycle marker を open-code せず、`VecStorageInvariant` で metadata / extent を[検査/けんさ]してからこの helper に委譲します。
fn vec_pop_move_out_initialized_slot <.T> %fn &RegionToken .T fn i32 .T \storage\byte_off:
    let data %MemPtr .T region_ptr storage
    let slot %MemPtr .T mem_ptr_add<.T> data byte_off
    let raw %i32 mem_ptr_addr slot
    let loaded %.T load<.T> raw
    #intrinsic "collection_slot_move_out" <.T> (storage, byte_off)
    loaded

//: ## vec_pop_storage_checked
//: payload 種別に依存しない `pop` の storage / lifecycle checked implementation
//:
//: ### [目的/もくてき]
//: - `VecStorageInvariant` により `len`、`initialized_len`、`cap`、backing storage extent の相関を確認します。
//: - 要素があるときだけ `vec_pop_move_out_initialized_slot` へ末尾 slot の move-out proof を委譲し、metadata を `next_len` にそろえた `VecPop` を返します。
//: - Copy / Drop の public overload はこの helper を共有し、API 型境界だけを外側で表します。
fn vec_pop_storage_checked <.T> %fn Vec .T VecPop .T \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_len %i32 *field::get_ref v_buffer_ref "len"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_invariant %VecStorageInvariant vec_buffer_current_storage_invariant<.T> v_buffer_ref
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_invariant:
        VecStorageInvariant::Invalid _reason:
            VecPop<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) none
        VecStorageInvariant::Valid:
            if:
                eq v_len 0
                then:
                    VecPop<.T> (Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)) none
                else:
                    let next_len %i32 sub v_len 1
                    match v_storage:
                        VecStorage::Empty:
                            VecPop<.T> vec_storage::vec_empty<.T> none
                        VecStorage::Owned v_region:
                            let byte_off %i32 mul next_len size_of<.T>
                            let item %.T vec_pop_move_out_initialized_slot<.T> &v_region byte_off
                            VecPop<.T> (Vec<.T> (OwnedBuffer<.T> next_len next_len v_cap (VecStorage<.T>::Owned v_region))) some item

//: ## pop
//: [末尾/まつび][要素/ようそ]を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - [末尾/まつび][要素/ようそ]を `Option` で[返/かえ]し、[長/なが]さを 1 [減/へ]らした `Vec` を[同時/どうじ]に[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len == 0` なら `Option::None` です。
//: - [要素/ようそ]がある[場合/ばあい]は[最後/さいご]の 1 [件/けん]を typed `load` し、`len - 1` の `Vec` と[組/く]にして[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `VecPop .T` です。
//: - [確保/かくほ]も[解放/かいほう]も[行/おこな]わないため O(1) です。
//: - `.T: Copy` では `vec_pop_item` / `vec_pop_vec` で従来どおり値を読むことができます。
//: - `.T: Drop` payload では `vec_pop_with` を使い、更新後の `Vec` owner と `Option .T` owner を同じ callback で同時に回収します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new<i32>;
//:     let v1 %Vec i32 unwrap_ok push v0 4;
//:     let p pop<i32> v1;
//:     let next %Vec i32 vec_pop_vec<i32> p;
//:     free<i32> next;
//:     0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn finish %impure fn Vec DropPayload impure fn Option DropPayload i32 \next\item:
//:     let len_ok %bool eq len<DropPayload> &next 0
//:     match item:
//:         Option::Some value:
//:             Drop::drop &value
//:             free<DropPayload> next
//:             if len_ok 0 1
//:         Option::None:
//:             free<DropPayload> next
//:             1
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 4)
//:     let p %VecPop DropPayload pop<DropPayload> v1
//:     vec_pop_with<DropPayload,i32> p @finish
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.overload.no_match
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: struct NonCopyPayload:
//:     value %i32
//: fn ignore_plain %impure fn Vec NonCopyPayload impure fn Option NonCopyPayload i32 \_next\_item:
//:     0
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec NonCopyPayload vec_empty<NonCopyPayload>;
//:     let p pop<NonCopyPayload> v0;
//:     vec_pop_with<NonCopyPayload,i32> p @ignore_plain
//:     0
//: ```
pub fn pop <.T: Copy> %fn Vec .T VecPop .T \v:
    vec_pop_storage_checked<.T> v

//: ## pop
//: Drop payload の[末尾/まつび][要素/ようそ]を owner として[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の removed tail slot を move-out し、caller が `Option .T` owner として受け取れるようにします。
//: - `Drop::drop` は `pop` 内では行いません。caller が `Option::Some value` を match して使うか drop し、更新後の `Vec` owner も同じ control-flow で処理します。
//:
//: ### [注意/ちゅうい]
//: - `vec_pop_vec`（`.T: Copy`）は item owner を捨てる accessor なので、Drop payload では使えません。`vec_pop_with`（`.T`, `.R`）を使います。
pub fn pop <.T: Drop> %fn Vec .T VecPop .T \v:
    vec_pop_storage_checked<.T> v

//: ## vec_drop_last_copy_initialized_slot
//: Copy payload の末尾 slot を Resource IR 上で cleanup 済みにする private helper
//:
//: ### [目的/もくてき]
//: - `.T: Copy` では destructor 実行は不要ですが、`drop_last` が removed tail slot の initialized state を metadata だけで消したことにしないよう、raw load witness と `collection_slot_drop_initialized` marker を同じ private helper に[閉/と]じます。
//: - caller は `VecStorageInvariant` で `len == initialized_len` と backing extent を[確認/かくにん]してから、この helper に末尾 byte offset を[渡/わた]します。
fn vec_drop_last_copy_initialized_slot <.T: Copy> %fn &RegionToken .T fn i32 unit \storage\byte_off:
    let data %MemPtr .T region_ptr storage
    let slot %MemPtr .T mem_ptr_add<.T> data byte_off
    let raw %i32 mem_ptr_addr slot
    let _value %.T load<.T> raw
    #intrinsic "collection_slot_drop_initialized" <.T> (storage, byte_off)

//: ## vec_drop_last_drop_initialized_slot
//: Drop payload の末尾 slot を実際の `Drop::drop` 呼び出しで cleanup する private helper
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の removed tail slot を raw load し、actual `Drop::drop` proof と `collection_slot_drop_initialized` marker を同じ source boundary に[置/お]きます。
//: - stdlib 関数名の allowlist ではなく、Resource IR の raw value-flow proof と Drop proof で single-slot cleanup を[証明/しょうめい]します。
fn vec_drop_last_drop_initialized_slot <.T: Drop> %impure fn &RegionToken .T impure fn i32 unit \storage\byte_off:
    let data %MemPtr .T region_ptr storage
    let slot %MemPtr .T mem_ptr_add<.T> data byte_off
    let raw %i32 mem_ptr_addr slot
    let loaded %.T load<.T> raw
    Drop::drop &loaded
    #intrinsic "collection_slot_drop_initialized" <.T> (storage, byte_off)

//: ## drop_last
//: [末尾/まつび][要素/ようそ]を[捨/す]て、次の `Vec` owner だけを[返/かえ]す
//:
//: ### [目的/もくてき]
//: - stack のように末尾値を使わない caller が、`Vec` の raw `data` field を直接読まずに長さだけを 1 減らした owner を得られるようにします。
//:
//: ### [注意/ちゅうい]
//: - `drop_last` は `.T: Copy` と `.T: Drop` の overload を[持/も]ちます。どちらも removed tail slot を private helper で Resource IR lifecycle proof に[接続/せつぞく]してから `len` / `initialized_len` を[減/へ]らします。
//: - 要素の値は返しません。値も必要な場合は `pop` を使います。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"vec_drop_last_keeps_owner\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"drop_last length\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:         |> drop_last<i32>
//:     let report:
//:         test_report_new "vec_drop_last_keeps_owner"
//:         |> test_report_push assert_eq_i32 "drop_last length" 1 len<i32> &v
//:     free<i32> v
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn drop_last <.T: Copy> %fn Vec .T Vec .T \v:
    vec_drop_last_storage_checked_copy<.T> v

//: ## drop_last
//: Drop payload の[末尾/まつび][要素/ようそ]を[破棄/はき]する
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の末尾 payload に `Drop::drop` を[実行/じっこう]し、removed slot の lifecycle proof を[閉/と]じてから次の `Vec` owner を[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 1)
//:     let v2 %Vec DropPayload unwrap_ok push<DropPayload> v1 (DropPayload 2)
//:     let v3 %Vec DropPayload drop_last<DropPayload> v2
//:     let ok %bool eq len<DropPayload> &v3 1
//:     free<DropPayload> v3
//:     if ok 0 1
//: ```
pub fn drop_last <.T: Drop> %impure fn Vec .T Vec .T \v:
    vec_drop_last_storage_checked_drop<.T> v

//: ## vec_drop_last_storage_checked_copy
//: Copy payload の `drop_last` 本体
fn vec_drop_last_storage_checked_copy <.T: Copy> %fn Vec .T Vec .T \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_len %i32 *field::get_ref v_buffer_ref "len"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_invariant %VecStorageInvariant vec_buffer_current_storage_invariant<.T> v_buffer_ref
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_invariant:
        VecStorageInvariant::Invalid _reason:
            Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)
        VecStorageInvariant::Valid:
            if:
                eq v_len 0
                then:
                    Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)
                else:
                    let next_len %i32 sub v_len 1
                    match v_storage:
                        VecStorage::Empty:
                            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap VecStorage<.T>::Empty)
                        VecStorage::Owned v_region:
                            let byte_off %i32 mul next_len size_of<.T>
                            vec_drop_last_copy_initialized_slot<.T> &v_region byte_off
                            Vec<.T> (OwnedBuffer<.T> next_len next_len v_cap (VecStorage<.T>::Owned v_region))

//: ## vec_drop_last_storage_checked_drop
//: Drop payload の `drop_last` 本体
fn vec_drop_last_storage_checked_drop <.T: Drop> %impure fn Vec .T Vec .T \v:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let v_len %i32 *field::get_ref v_buffer_ref "len"
    let v_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let v_cap %i32 *field::get_ref v_buffer_ref "cap"
    let v_invariant %VecStorageInvariant vec_buffer_current_storage_invariant<.T> v_buffer_ref
    let v_buffer %OwnedBuffer .T field::get v "buffer"
    let v_storage %VecStorage .T field::get v_buffer "storage"
    match v_invariant:
        VecStorageInvariant::Invalid _reason:
            Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)
        VecStorageInvariant::Valid:
            if:
                eq v_len 0
                then:
                    Vec<.T> (OwnedBuffer<.T> v_len v_initialized_len v_cap v_storage)
                else:
                    let next_len %i32 sub v_len 1
                    match v_storage:
                        VecStorage::Empty:
                            Vec<.T> (OwnedBuffer<.T> 0 0 v_cap VecStorage<.T>::Empty)
                        VecStorage::Owned v_region:
                            let byte_off %i32 mul next_len size_of<.T>
                            vec_drop_last_drop_initialized_slot<.T> &v_region byte_off
                            Vec<.T> (OwnedBuffer<.T> next_len next_len v_cap (VecStorage<.T>::Owned v_region))
