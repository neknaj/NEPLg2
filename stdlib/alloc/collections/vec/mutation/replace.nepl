//: # vec/mutation/replace
//: `Vec` の in-place [置換/ちかん]
//:
//: ### [目的/もくてき]
//: - 借用 `Vec` の[範囲/はんい][検査/けんさ]と element write をこの module に[閉/と]じます。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/field" as field
#import "../types" as *
#import "../access/data" as vec_data
#import "../invariant" as vec_invariant
#import "core/field" as *

//: ## replace
//: [要素/ようそ]を[上書/うわが]きする（[範囲外/はんいがい]は[無視/むし]）
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら[指定/してい]した[要素/ようそ]へ[置/お]き[換/か]えます。
//:
//: ### [実装/じっそう]
//: - `idx` を[検査/けんさ]し、[妥当/だとう]な[場合/ばあい]だけ typed `store` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [範囲外/はんいがい]では[失敗/しっぱい]を[返/かえ]さず、[何/なに]も[変更/へんこう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     replace<i32> &v1 0 5;
//:     free<i32> v1;
//:     0
//: ```
pub fn replace <.T: Copy> <(&Vec<.T>,i32,.T)*>()> (v, idx, item):
    let v_buffer <&OwnedBuffer<.T>> field::get_ref v "buffer"
    let v_len <i32> *field::get_ref v_buffer "len"
    let v_storage <&VecStorage<.T>> field::get_ref v_buffer "storage"
    if:
        not vec_invariant::vec_current_copy_invariant<.T> v
        then ()
        else:
            if:
                lt idx 0
                then ()
                else:
                    if:
                        le v_len idx
                        then ()
                        else:
                            match v_storage:
                                VecStorage::Empty:
                                    ()
                                VecStorage::Owned _region:
                                    let v_data <MemPtr<.T>> vec_data::data_mem_ptr<.T> v
                                    store<.T> add mem_ptr_addr v_data mul idx size_of<.T> item
