//: # vec/access/header
//: `Vec` の header observer
//:
//: ### [目的/もくてき]
//: - `Vec` header field だけを[読/よ]む observer を[所有/しょゆう]します。

#indent 4

#import "core/math" as *
#import "core/field" as field
#import "../types" as *
#import "core/field" as *

//: ## len
//: [要素数/ようそすう]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` に[現在/げんざい][何個/なんこ]の[要素/ようそ]が[入/はい]っているかを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `Vec` の `buffer` field を[借用/しゃくよう]し、`OwnedBuffer` の `len` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//: - payload そのものは[読/よ]まず、`OwnedBuffer` の `len` metadata だけを[借用/しゃくよう]して[読/よ]むため `.T: Copy` は[要求/ようきゅう]しません。
//: - non-Copy payload の move-out / drop / storage release は別 API と Resource IR の slot lifecycle proof が[担当/たんとう]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new<i32>;
//:     let v1 %Vec i32 unwrap_ok push v0 3;
//:     let observed_len %i32 len<i32> &v1
//:     let ok %bool eq observed_len 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
pub fn len <.T> %fn &Vec .T i32 \v:
    let buffer %&OwnedBuffer .T field::get_ref v "buffer"
    *field::get_ref buffer "len"

//: ## cap
//: [容量/ようりょう]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - [現在/げんざい][確保/かくほ]されている[要素数/ようそすう]ぶんの[容量/ようりょう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `Vec` の `buffer` field を[借用/しゃくよう]し、`OwnedBuffer` の `cap` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//: - payload ではなく backing storage の capacity metadata を[読/よ]む API なので `.T: Copy` は[要求/ようきゅう]しません。
//: - capacity は storage [解放/かいほう]や initialized slot cleanup の[証明/しょうめい]ではなく、観測用 metadata です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok new<i32>;
//:     let ok %bool gt cap<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
pub fn cap <.T> %fn &Vec .T i32 \v:
    let buffer %&OwnedBuffer .T field::get_ref v "buffer"
    *field::get_ref buffer "cap"

//: ## is_empty
//: [空/から]かどうかを[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `len == 0` なら true を[返/かえ]し、[要素/ようそ]が[存在/そんざい]しないことを[判定/はんてい]します。
//:
//: ### [実装/じっそう]
//: - `len` observer を[通/とお]して header を[読/よ]み、0 と[比較/ひかく]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//: - `len` と同じく header metadata だけを[読/よ]むため `.T: Copy` は[要求/ようきゅう]しません。
//: - non-Copy payload を[取/と]り[出/だ]したり storage を[解放/かいほう]したりする[権限/けんげん]は、この observer からは[発生/はっせい]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok new<i32>;
//:     let ok %bool is_empty<i32> &v
//:     free<i32> v;
//:     if ok 0 1
//: ```
pub fn is_empty <.T> %fn &Vec .T bool \v:
    eq len<.T> v 0
