//: # vec/access/data
//: `Vec` の typed data view observer
//:
//: ### [目的/もくてき]
//: - storage state を `VecStorage` の match 経由に[揃/そろ]え、`Owned` payload の `RegionToken` owner から borrowed data view だけを[取/と]り[出/だ]します。

#indent 4

#import "core/math" as *
#import "core/mem" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../invariant" as *

//: ## VecDataView
//: `Vec` の backing storage view を typed enum として[表/あらわ]す
//:
//: ### [目的/もくてき]
//: - valid empty storage、valid allocated storage、invalid owner aggregate を `match` で[区別/くべつ]できるようにします。
//: - invariant failure を null pointer sentinel に[潰/つぶ]さず、`VecCopyInvariantInvalid` payload として[保持/ほじ]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let empty %Vec i32 unwrap_ok with_capacity<i32> 0;
//:     let empty_ok %bool match data_mem_view<i32> &empty:
//:         VecDataView::Empty:
//:             true
//:         VecDataView::Data _ptr:
//:             false
//:         VecDataView::Invalid _reason:
//:             false
//:     free<i32> empty;
//:     let v %Vec i32 unwrap_ok new<i32>;
//:     let data_ok %bool match data_mem_view<i32> &v:
//:         VecDataView::Empty:
//:             false
//:         VecDataView::Data _ptr:
//:             true
//:         VecDataView::Invalid _reason:
//:             false
//:     free<i32> v;
//:     if and empty_ok data_ok 0 1
//: ```
pub enum VecDataView<.T>:
    Empty
    Data %MemPtr .T
    Invalid %VecCopyInvariantInvalid

//: ## data_mem_view
//: [内部/ないぶ]データ[領域/りょういき]を typed data view として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `alloc/collections` [内部/ないぶ]で `Vec .T` の[要素/ようそ][領域/りょういき]を型付き view として[安全/あんぜん]に[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - `Vec` の `buffer` field を[借用/しゃくよう]し、current Copy-only invariant が[成/な]り[立/た]つことを[確認/かくにん]します。
//: - `OwnedBuffer.storage` が `Owned(region)` のときだけ `VecDataView::Data(region_ptr region)` を[返/かえ]します。
//: - `VecStorage::Empty` は allocation を[持/も]たないため、`VecDataView::Empty` を[返/かえ]します。
//: - invariant が[壊/こわ]れている `Vec` からは raw storage view を[導出/どうしゅつ]せず、`VecDataView::Invalid(reason)` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [主/おも]に stdlib [内部/ないぶ]の[実装/じっそう][補助/ほじょ]を[想定/そうてい]した API です。
//: - public API は typed `VecDataView .T` で止め、raw `i32` address observer は[提供/ていきょう]しません。raw-memory boundary の[実装/じっそう]が番地を必要とする場合だけ、`VecDataView::Data` branch 内で明示的に `mem_ptr_addr` を使います。
//: - [再確保/さいかくほ]が[起/お]きると pointer は[無効化/むこうか]されうるので、[長期/ちょうき][保持/ほじ]は[避/さ]けます。
//: - 現行 raw data observer は `.T: Copy` 専用です。non-Copy payload の borrowed observer は pointer escape ではなく dedicated API として[設計/せっけい]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/mem" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok with_capacity<i32> 0;
//:     let ok %bool match data_mem_view<i32> &v:
//:         VecDataView::Empty:
//:             true
//:         VecDataView::Data _p:
//:             false
//:         VecDataView::Invalid _reason:
//:             false
//:     free<i32> v;
//:     if ok 0 1
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: struct NonCopyPayload:
//:     value %i32
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec NonCopyPayload vec_empty<NonCopyPayload>;
//:     let _view %VecDataView NonCopyPayload data_mem_view<NonCopyPayload> &v;
//:     0
//: ```
pub fn data_mem_view <.T: Copy> %fn &Vec .T VecDataView .T \v:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    let v_storage %&VecStorage .T field::get_ref v_buffer "storage"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid reason:
            VecDataView<.T>::Invalid reason
        VecCopyInvariant::Valid:
            match v_storage:
                VecStorage::Empty:
                    VecDataView<.T>::Empty
                VecStorage::Owned region:
                    VecDataView<.T>::Data region_ptr region
