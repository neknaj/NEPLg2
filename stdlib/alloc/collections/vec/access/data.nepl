//: # vec/access/data
//: `Vec` の typed data view observer
//:
//: ### [目的/もくてき]
//: - storage state を `VecStorageState` の match 経由に[揃/そろ]え、`RegionToken` owner から borrowed data view だけを[取/と]り[出/だ]します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *

//: ## data_mem_ptr
//: [内部/ないぶ]データ[領域/りょういき]を `MemPtr<.T>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `alloc/collections` [内部/ないぶ]で `Vec<.T>` の[要素/ようそ][領域/りょういき]を型付きポインタとして[安全/あんぜん]に[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - field `region` を借用し、`region_ptr` 由来の non-owning `MemPtr` view を[返/かえ]します。
//: - `VecStorageState::Empty` は allocation を[持/も]たないため、0 address の typed view を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [主/おも]に stdlib [内部/ないぶ]の[実装/じっそう][補助/ほじょ]を[想定/そうてい]した API です。
//: - public API は typed `MemPtr<.T>` view で止め、raw `i32` address observer は[提供/ていきょう]しません。raw-memory boundary の[実装/じっそう]が番地を必要とする場合だけ、呼び出し位置で明示的に `mem_ptr_addr` を使います。
//: - [再確保/さいかくほ]が[起/お]きると pointer は[無効化/むこうか]されうるので、[長期/ちょうき][保持/ほじ]は[避/さ]けます。
//: - 現行 raw data observer は `.T: Copy` 専用です。non-Copy payload の borrowed observer は pointer escape ではなく dedicated API として[設計/せっけい]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/mem" as *
//:| #import "core/mem/internal" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> gt mem_ptr_addr data_mem_ptr<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: struct NonCopyPayload:
//:     value <i32>
//: fn main <()*>i32> ():
//:     let v <Vec<NonCopyPayload>> vec_empty<NonCopyPayload>;
//:     let _p <MemPtr<NonCopyPayload>> data_mem_ptr<NonCopyPayload> &v;
//:     0
//: ```
pub fn data_mem_ptr <.T: Copy> <(&Vec<.T>)->MemPtr<.T>> (v):
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_region <&RegionToken<.T>> field::get_ref v "region"
    match v_storage:
        VecStorageState::Empty:
            mem_ptr_wrap 0
        VecStorageState::Owned:
            region_ptr v_region
