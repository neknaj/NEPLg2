//: # vec/invariant
//: `Vec` の storage invariant と current Copy-only raw access invariant
//:
//: ### [目的/もくてき]
//: - `OwnedBuffer` の metadata と storage state が[矛盾/むじゅん]していないことを、payload の `Copy` 性質とは[独立/どくりつ]した storage proof として[確認/かくにん]します。
//: - raw element access の[直前/ちょくぜん]では、storage proof を Copy-only raw access proof に[変換/へんかん]してから `load` / `store` へ[進/すす]みます。
//: - `len`、`initialized_len`、`cap`、`VecStorage` の相関を 1 箇所に[集約/しゅうやく]し、non-Copy lifecycle と Copy raw access が同じ storage 条件を[共有/きょうゆう]できるようにします。
//:
//: ### [注意/ちゅうい]
//: - `VecStorageInvariant` は payload を raw access しません。したがって `.T: Copy` を[要求/ようきゅう]しません。
//: - `VecCopyInvariant` は raw payload access の[前提/ぜんてい]なので、現行の `.T: Copy` 境界を[維持/いじ]します。
//: - non-Copy payload 対応では、storage proof に加えて moved slot / drop traversal の typed state を Resource IR と[接続/せつぞく]します。

#indent 4

#import "core/math" as *
#import "core/mem" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "./types" as *

//: ## VecStorageInvariantInvalid
//: current `Vec` storage invariant が[成立/せいりつ]しない[理由/りゆう]
//:
//: ### [目的/もくてき]
//: - payload を read / write しない storage metadata / extent の refutation を enum として[保持/ほじ]します。
//: - Copy raw access 用の failure reason とは別の型にし、non-Copy lifecycle が Copy proof に[依存/いぞん]しないようにします。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec/invariant" as *
//: fn main %fn unit i32 \unit:
//:     let reason %VecStorageInvariantInvalid VecStorageInvariantInvalid::LengthExceedsCapacity
//:     let ok %bool match reason:
//:         VecStorageInvariantInvalid::NegativeLength:
//:             false
//:         VecStorageInvariantInvalid::InitializedLengthMismatch:
//:             false
//:         VecStorageInvariantInvalid::LengthExceedsCapacity:
//:             true
//:         VecStorageInvariantInvalid::EmptyStorageMetadataMismatch:
//:             false
//:         VecStorageInvariantInvalid::OwnedStorageCapacityMismatch:
//:             false
//:         VecStorageInvariantInvalid::OwnedStorageExtentMismatch:
//:             false
//:     if ok 0 1
//: ```
pub enum VecStorageInvariantInvalid:
    NegativeLength
    InitializedLengthMismatch
    LengthExceedsCapacity
    EmptyStorageMetadataMismatch
    OwnedStorageCapacityMismatch
    OwnedStorageExtentMismatch

//: ## VecStorageInvariant
//: payload 非依存の current `Vec` storage invariant proof
//:
//: ### [目的/もくてき]
//: - `Valid` は `OwnedBuffer` の metadata / storage owner / extent の相関が[証明/しょうめい]されたことを[表/あらわ]します。
//: - `Invalid(reason)` は raw access や lifecycle operation の前提にできない storage 状態で、理由を typed payload として[保持/ほじ]します。
//: - non-Copy payload の lifecycle API は、この proof に Resource IR の initialized / moved / dropped state proof を[組/く]み[合/あ]わせます。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/invariant" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec DropPayload unwrap_ok new
//:     let ok %bool match vec_current_storage_invariant &v:
//:         VecStorageInvariant::Valid:
//:             true
//:         VecStorageInvariant::Invalid _reason:
//:             false
//:     free v
//:     if ok 0 1
//: ```
pub enum VecStorageInvariant:
    Valid
    Invalid %VecStorageInvariantInvalid

//: ## VecCopyInvariantInvalid
//: current Copy-only `Vec` invariant が[成立/せいりつ]しない[理由/りゆう]
//:
//: ### [目的/もくてき]
//: - invariant failure を bool に[潰/つぶ]さず、どの metadata / storage 相関が[壊/こわ]れたかを enum として[残/のこ]します。
//: - 新しい failure case を[追加/ついか]したとき、`match` の[網羅性/もうらせい]で caller / diagnostic / policy の[追従/ついじゅう]漏れを[見/み]つけやすくします。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec/invariant" as *
//: fn main %fn unit i32 \unit:
//:     let reason %VecCopyInvariantInvalid VecCopyInvariantInvalid::LengthExceedsCapacity
//:     let ok %bool match reason:
//:         VecCopyInvariantInvalid::NegativeLength:
//:             false
//:         VecCopyInvariantInvalid::InitializedLengthMismatch:
//:             false
//:         VecCopyInvariantInvalid::LengthExceedsCapacity:
//:             true
//:         VecCopyInvariantInvalid::EmptyStorageMetadataMismatch:
//:             false
//:         VecCopyInvariantInvalid::OwnedStorageCapacityMismatch:
//:             false
//:         VecCopyInvariantInvalid::OwnedStorageExtentMismatch:
//:             false
//:     if ok 0 1
//: ```
pub enum VecCopyInvariantInvalid:
    NegativeLength
    InitializedLengthMismatch
    LengthExceedsCapacity
    EmptyStorageMetadataMismatch
    OwnedStorageCapacityMismatch
    OwnedStorageExtentMismatch

//: ## VecCopyInvariant
//: raw access 前に使う current Copy-only `Vec` invariant proof
//:
//: ### [目的/もくてき]
//: - `Valid` は raw load/store の前提となる `OwnedBuffer` 相関が[証明/しょうめい]されたことを[表/あらわ]します。
//: - `Invalid(reason)` は raw access を[拒否/きょひ]すべき状態で、理由を typed payload として[保持/ほじ]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/invariant" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok new
//:     let valid_ok %bool match vec_current_copy_invariant &v:
//:         VecCopyInvariant::Valid:
//:             true
//:         VecCopyInvariant::Invalid _reason:
//:             false
//:     free v
//:     let invalid %VecCopyInvariant VecCopyInvariant::Invalid VecCopyInvariantInvalid::OwnedStorageExtentMismatch
//:     let invalid_ok %bool match invalid:
//:         VecCopyInvariant::Valid:
//:             false
//:         VecCopyInvariant::Invalid reason:
//:             match reason:
//:                 VecCopyInvariantInvalid::OwnedStorageExtentMismatch:
//:                     true
//:                 VecCopyInvariantInvalid::NegativeLength:
//:                     false
//:                 VecCopyInvariantInvalid::InitializedLengthMismatch:
//:                     false
//:                 VecCopyInvariantInvalid::LengthExceedsCapacity:
//:                     false
//:                 VecCopyInvariantInvalid::EmptyStorageMetadataMismatch:
//:                     false
//:                 VecCopyInvariantInvalid::OwnedStorageCapacityMismatch:
//:                     false
//:     if and valid_ok invalid_ok 0 1
//: ```
pub enum VecCopyInvariant:
    Valid
    Invalid %VecCopyInvariantInvalid

fn vec_storage_invalid_to_copy_invalid %fn VecStorageInvariantInvalid VecCopyInvariantInvalid \reason:
    match reason:
        VecStorageInvariantInvalid::NegativeLength:
            VecCopyInvariantInvalid::NegativeLength
        VecStorageInvariantInvalid::InitializedLengthMismatch:
            VecCopyInvariantInvalid::InitializedLengthMismatch
        VecStorageInvariantInvalid::LengthExceedsCapacity:
            VecCopyInvariantInvalid::LengthExceedsCapacity
        VecStorageInvariantInvalid::EmptyStorageMetadataMismatch:
            VecCopyInvariantInvalid::EmptyStorageMetadataMismatch
        VecStorageInvariantInvalid::OwnedStorageCapacityMismatch:
            VecCopyInvariantInvalid::OwnedStorageCapacityMismatch
        VecStorageInvariantInvalid::OwnedStorageExtentMismatch:
            VecCopyInvariantInvalid::OwnedStorageExtentMismatch

//: ## vec_buffer_current_storage_invariant
//: `OwnedBuffer` が current `Vec` storage として[一貫/いっかん]しているかを enum proof で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `0 <= len == initialized_len <= cap` を[確認/かくにん]します。
//: - `VecStorage::Empty` は `len = initialized_len = cap = 0` の時だけ[妥当/だとう]とします。
//: - `VecStorage::Owned(region)` は `cap > 0` かつ `region_size(region) == cap * size_of .T` の時だけ[妥当/だとう]とします。
//: - payload を raw load / store しないため `.T: Copy` を[要求/ようきゅう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
pub fn vec_buffer_current_storage_invariant <.T> %fn &OwnedBuffer .T VecStorageInvariant \buffer:
    let len0 %i32 *field::get_ref buffer "len"
    let initialized_len0 %i32 *field::get_ref buffer "initialized_len"
    let cap0 %i32 *field::get_ref buffer "cap"
    let storage %&VecStorage .T field::get_ref buffer "storage"
    if:
        lt len0 0
        then VecStorageInvariant::Invalid VecStorageInvariantInvalid::NegativeLength
        else if:
            not eq initialized_len0 len0
            then VecStorageInvariant::Invalid VecStorageInvariantInvalid::InitializedLengthMismatch
            else if:
                gt len0 cap0
                then VecStorageInvariant::Invalid VecStorageInvariantInvalid::LengthExceedsCapacity
                else:
                    match storage:
                        VecStorage::Empty:
                            if:
                                and (eq len0 0) (eq cap0 0)
                                then VecStorageInvariant::Valid
                                else VecStorageInvariant::Invalid VecStorageInvariantInvalid::EmptyStorageMetadataMismatch
                        VecStorage::Owned region:
                            if:
                                gt cap0 0
                                then:
                                    let elem_size %i32 size_of<.T>
                                    if:
                                        le elem_size 0
                                        then VecStorageInvariant::Invalid VecStorageInvariantInvalid::OwnedStorageCapacityMismatch
                                        else:
                                            let max_count %i32 div_s max_alloc_payload_bytes elem_size
                                            if:
                                                gt cap0 max_count
                                                then VecStorageInvariant::Invalid VecStorageInvariantInvalid::OwnedStorageExtentMismatch
                                                else:
                                                    let expected_bytes %i32 mul cap0 elem_size
                                                    if:
                                                        eq region_size<.T> region expected_bytes
                                                        then VecStorageInvariant::Valid
                                                        else VecStorageInvariant::Invalid VecStorageInvariantInvalid::OwnedStorageExtentMismatch
                                else VecStorageInvariant::Invalid VecStorageInvariantInvalid::OwnedStorageCapacityMismatch

//: ## vec_current_storage_invariant
//: `Vec` が current storage invariant を[満/み]たすかを enum proof で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - public `Vec` facade から `OwnedBuffer` を[借用/しゃくよう]し、payload 非依存の storage invariant [検査/けんさ]を[共通化/きょうつうか]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/invariant" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec DropPayload unwrap_ok with_capacity 2
//:     let ok %bool match vec_current_storage_invariant &v:
//:         VecStorageInvariant::Valid:
//:             true
//:         VecStorageInvariant::Invalid _reason:
//:             false
//:     free v
//:     if ok 0 1
//: ```
pub fn vec_current_storage_invariant <.T> %fn &Vec .T VecStorageInvariant \v:
    let buffer %&OwnedBuffer .T field::get_ref v "buffer"
    vec_buffer_current_storage_invariant<.T> buffer

//: ## vec_buffer_current_copy_invariant
//: `OwnedBuffer` が current Copy-only `Vec` として raw access できる状態かを enum proof で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `0 <= len == initialized_len <= cap` を[確認/かくにん]します。
//: - `VecStorage::Empty` は `len = initialized_len = cap = 0` の時だけ[妥当/だとう]とします。
//: - `VecStorage::Owned(region)` は `cap > 0` かつ `region_size(region) == cap * size_of .T` の時だけ[妥当/だとう]とします。
//: - byte 数の[計算/けいさん]は allocator payload 上限から先に[確認/かくにん]し、overflow した capacity を raw access の[前提/ぜんてい]として[認/みと]めません。
//: - [結果/けっか]は bool ではなく `VecCopyInvariant` にし、caller は `match` により `Valid` / `Invalid` を[明示/めいじ]します。
//: - 実際の metadata / extent 検査は `VecStorageInvariant` に[委譲/いじょう]し、Copy-only raw access proof は payload read/write の境界だけを[表/あらわ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/invariant" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32 unwrap_ok new;
//:     let ok %bool match vec_current_copy_invariant &v:
//:         VecCopyInvariant::Valid:
//:             true
//:         VecCopyInvariant::Invalid _reason:
//:             false
//:     free v;
//:     if ok 0 1
//: ```
pub fn vec_buffer_current_copy_invariant <.T: Copy> %fn &OwnedBuffer .T VecCopyInvariant \buffer:
    match vec_buffer_current_storage_invariant<.T> buffer:
        VecStorageInvariant::Valid:
            VecCopyInvariant::Valid
        VecStorageInvariant::Invalid reason:
            VecCopyInvariant::Invalid (vec_storage_invalid_to_copy_invalid reason)

//: ## vec_current_copy_invariant
//: `Vec` が current Copy-only raw access invariant を[満/み]たすかを enum proof で[返/かえ]す
//:
//: ### [目的/もくてき]
//: - public `Vec` facade から `OwnedBuffer` を[借用/しゃくよう]し、raw element access 前の invariant [検査/けんさ]を[共通化/きょうつうか]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/invariant" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new
//:     let v1 %Vec i32 unwrap_ok push v0 1
//:     let ok %bool match vec_current_copy_invariant &v1:
//:         VecCopyInvariant::Valid:
//:             true
//:         VecCopyInvariant::Invalid _reason:
//:             false
//:     free v1
//:     if ok 0 1
//: ```
pub fn vec_current_copy_invariant <.T: Copy> %fn &Vec .T VecCopyInvariant \v:
    let buffer %&OwnedBuffer .T field::get_ref v "buffer"
    vec_buffer_current_copy_invariant<.T> buffer
