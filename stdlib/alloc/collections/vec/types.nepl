//: # vec/types
//: `Vec` の型定義
//:
//: ### [目的/もくてき]
//: - `VecStorageState`、`Vec`、`VecPop`、`VecPartition` を root 実装から[分離/ぶんり]します。
//: - storage owner state を enum として[保持/ほじ]し、null pointer sentinel を public owner state に[戻/もど]さないための型境界を[明確/めいかく]にします。
//:
//: ### [注意/ちゅうい]
//: - `Vec<T>` は backing storage owner です。shallow copy せず、owner を move して[扱/あつか]います。
//: - backing storage の free obligation は `RegionToken<T>` に[集約/しゅうやく]し、`MemPtr<T>` は参照から得る data view としてだけ[扱/あつか]います。

#indent 4

#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *

//: ## VecStorageState
//: `Vec` の backing storage owner state
//:
//: ### [目的/もくてき]
//: - `cap = 0` の empty storage と、実際に[確保/かくほ]された buffer owner を enum として[分/わ]けます。
//: - `mem_ptr_wrap 0` を owner sentinel として[使/つか]わず、`match` の[網羅性/もうらせい]で storage state を[扱/あつか]います。
//: - backing owner は `Vec.region` field に[保持/ほじ]し、Resource IR が free obligation owner と pointer view を[分離/ぶんり]して[追跡/ついせき]できる[形/かたち]を[保/たも]ちます。
pub enum VecStorageState:
    Empty
    Owned

impl Clone for VecStorageState:
    fn clone <(&VecStorageState)->VecStorageState> (storage):
        *storage

impl Copy for VecStorageState:
    fn copy_mark <(VecStorageState)->VecStorageState> (storage):
        storage

//: ## Vec
//: [可変長/かへんちょう][配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [要素数/ようそすう]・[容量/ようりょう]・storage owner state を[保持/ほじ]し、`alloc/collections` の[他/ほか] API から[共通/きょうつう]に[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - `len` と `cap` は `i32`、`storage` は `VecStorageState`、`region` は `RegionToken<.T>` で[保持/ほじ]します。
//: - [実体/じったい]の[配列/はいれつ]はヒープ[上/じょう]の[連続/れんぞく][領域/りょういき]です。
//:
//: ### [注意/ちゅうい]
//: - `Vec<.T>` [自体/じたい]は `region` [領域/りょういき]の[所有権/しょゆうけん]を[持/も]ちます。
//: - `Vec<.T>` は shallow copy できません。値を[渡/わた]すと[所有権/しょゆうけん]が[移動/いどう]します。
//: - [再確保/さいかくほ]により `region` から得た data view の[番地/ばんち]が[変/か]わるため、[生/なま]アドレスを[長期/ちょうき]に[保持/ほじ]してはいけません。
//:
//: ### [計算量/けいさんりょう]
//: - struct [自体/じたい]の[読/よ]み[書/か]きは O(1) です。
//:
//: neplg2:test[compile_fail]
//: diag_codes: resource.cell.moved, resource.cell.uninit
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let moved <Vec<i32>> v;
//:     free<i32> v;
//:     free<i32> moved;
//:     0
//: ```
pub struct Vec<.T>:
    len <i32>
    cap <i32>
    storage <VecStorageState>
    region <RegionToken<.T>>

//: ## VecPushError
//: `push` の[失敗/しっぱい]時に `Vec` owner を[返/かえ]す error payload
//:
//: ### [目的/もくてき]
//: - 現行 `push` は `.T: Copy` に[限定/げんてい]しているため、[失敗/しっぱい]時に caller が[回収/かいしゅう]すべき linear owner は collection の `Vec<.T>` です。
//: - 将来 non-Copy payload を[扱/あつか]う場合は、`OwnedBuffer<T>` / initialized prefix / item owner の[状態/じょうたい]を[別/べつ]の owner-preserving API として[設計/せっけい]します。
//: - [診断/しんだん]用の error kind は Copy な `StdErrorKind` として[分離/ぶんり]し、owner [回収/かいしゅう]と error [確認/かくにん]を別操作にします。
pub struct VecPushError<.T>:
    vec <Vec<.T>>
    error <StdErrorKind>

//: ## VecPop
//: `pop` の結果を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `.Pair` の数値 field ではなく、`vec` と `item` を名前付き field として Resource IR に渡します。
//: - 返却された `vec` owner を呼び出し側が明示的に回収できます。
pub struct VecPop<.T>:
    vec <Vec<.T>>
    item <Option<.T>>

//: ## VecPartition
//: `partition` の 2 本の結果 `Vec` を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `matched` は predicate が true の[要素/ようそ]、`rest` は false の[要素/ようそ]を[保持/ほじ]します。
//: - `.Pair` の位置番号ではなく名前付き field にして、owner の[解放/かいほう]漏れを静的検査で[見/み]える形にします。
pub struct VecPartition<.T>:
    matched <Vec<.T>>
    rest <Vec<.T>>
