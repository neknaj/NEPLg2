//: # vec/types
//: `Vec` の型定義
//:
//: ### [目的/もくてき]
//: - `VecStorage`、`OwnedBuffer`、`Vec`、`VecPop`、`VecPartition` を root 実装から[分離/ぶんり]します。
//: - storage owner state と backing allocation owner を同じ enum に[保持/ほじ]し、null pointer sentinel や分離 owner field を public owner state に[戻/もど]さないための型境界を[明確/めいかく]にします。
//:
//: ### [注意/ちゅうい]
//: - `OwnedBuffer<T>` は backing storage owner と len/cap metadata を[束/たば]ねます。shallow copy せず、owner を move して[扱/あつか]います。
//: - `Vec<T>` は public collection facade で、storage owner は `OwnedBuffer<T>` field に[委譲/いじょう]します。
//: - backing storage の free obligation は `VecStorage<T>::Owned(RegionToken<T>)` に[集約/しゅうやく]し、`MemPtr<T>` は参照から得る data view としてだけ[扱/あつか]います。

#indent 4

#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "core/field" as field

//: ## VecStorage
//: `Vec` の backing storage owner state
//:
//: ### [目的/もくてき]
//: - `cap = 0` の empty storage と、実際に[確保/かくほ]された buffer owner を enum として[分/わ]けます。
//: - `mem_ptr_wrap 0` を owner sentinel として[使/つか]わず、`match` の[網羅性/もうらせい]で storage state を[扱/あつか]います。
//: - backing owner は `Owned` variant の payload として[保持/ほじ]し、`Empty` と owner token の不正な組み合わせを source type で[表現/ひょうげん]できないようにします。
pub enum VecStorage<.T>:
    Empty
    Owned <RegionToken<.T>>

//: ## OwnedBuffer
//: `Vec` の backing storage owner と initialized prefix metadata
//:
//: ### [目的/もくてき]
//: - storage owner state、[長/なが]さ、[容量/ようりょう]を 1 つの owner aggregate に[束/たば]ねます。
//: - `Vec<.T>` facade が storage の内部表現を直接[保持/ほじ]せず、buffer owner に[委譲/いじょう]するための境界です。
//:
//: ### [実装/じっそう]
//: - `len` は[初期化済/しょきかず]み prefix の[長/なが]さ、`cap` は backing storage の[容量/ようりょう]です。
//: - `storage` は `VecStorage<.T>` で、allocation がない `Empty` と free obligation を持つ `Owned(region)` を enum として[分/わ]けます。
//:
//: ### [注意/ちゅうい]
//: - 現段階では initialized prefix / moved slot / drop traversal は Resource IR 上で完全な typed cell API になっていません。そのため public `Vec` mutation は引き続き `.T: Copy` に[限定/げんてい]します。
//: - non-Copy payload を[扱/あつか]う最終 API では、`OwnedBuffer` に move-out / replace / drop state をさらに[接続/せつぞく]します。
pub struct OwnedBuffer<.T>:
    len <i32>
    cap <i32>
    storage <VecStorage<.T>>

//: ## Vec
//: [可変長/かへんちょう][配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - `OwnedBuffer<.T>` を[保持/ほじ]し、`alloc/collections` の[他/ほか] API から[共通/きょうつう]に[扱/あつか]える facade として[振/ふ]る[舞/ま]います。
//:
//: ### [実装/じっそう]
//: - `Vec<.T>` [自体/じたい]は `buffer: OwnedBuffer<.T>` だけを[保持/ほじ]します。
//: - `len`、`cap`、`storage` は `OwnedBuffer<.T>` 内に[閉/と]じます。
//: - [実体/じったい]の[配列/はいれつ]はヒープ[上/じょう]の[連続/れんぞく][領域/りょういき]です。
//:
//: ### [注意/ちゅうい]
//: - `Vec<.T>` [自体/じたい]は `OwnedBuffer<.T>` を通して backing [領域/りょういき]の[所有権/しょゆうけん]を[持/も]ちます。
//: - `Vec<.T>` は shallow copy できません。値を[渡/わた]すと[所有権/しょゆうけん]が[移動/いどう]します。
//: - [再確保/さいかくほ]により `region` から得た data view の[番地/ばんち]が[変/か]わるため、[生/なま]アドレスを[長期/ちょうき]に[保持/ほじ]してはいけません。
//:
//: ### [計算量/けいさんりょう]
//: - struct [自体/じたい]の[読/よ]み[書/か]きは O(1) です。
//:
//: neplg2:test[compile_fail]
//: diag_codes: resource.cell.moved, resource.cell.uninit
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let moved <Vec<i32>> v;
//:     free<i32> v;
//:     free<i32> moved;
//:     0
//: ```
pub struct Vec<.T>:
    buffer <OwnedBuffer<.T>>

//: ## VecPushError
//: `push` の[失敗/しっぱい]時に `Vec` owner を[返/かえ]す error payload
//:
//: ### [目的/もくてき]
//: - 現行 `push` は `.T: Copy` に[限定/げんてい]しているため、[失敗/しっぱい]時に caller が[回収/かいしゅう]すべき linear owner は collection の `Vec<.T>` です。
//: - 将来 non-Copy payload を[扱/あつか]う場合は、`OwnedBuffer<T>` / initialized prefix / item owner の[状態/じょうたい]を[別/べつ]の owner-preserving API として[設計/せっけい]します。
//: - [診断/しんだん]用の error kind は Copy な `StdErrorKind` として[分離/ぶんり]し、owner [回収/かいしゅう]と error [確認/かくにん]を別操作にします。
pub struct VecPushError<.T>:
    vec <Vec<.T>>
    error <StdErrorKind>

//: ## VecTransformError
//: `Vec` の owner-consuming transform が[失敗/しっぱい]したときに、入力 owner を[返/かえ]す error payload
//:
//: ### [目的/もくてき]
//: - `map` / `filter` / `partition` / `take_while` / `drop_while` は入力 `Vec<.T>` を[消費/しょうひ]して新しい collection を[作/つく]ります。
//: - [途中/とちゅう]の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]でも、入力 `Vec<.T>` owner を `Err` payload に[戻/もど]し、caller が cleanup、再試行、診断を[選/えら]べるようにします。
//: - `StdErrorKind` だけを[返/かえ]して内部で入力を[破棄/はき]すると、owner の[行方/ゆくえ]が API 型に[現/あらわ]れないため、この型で明示します。
pub struct VecTransformError<.T>:
    vec <Vec<.T>>
    error <StdErrorKind>

//: ## vec_transform_error_kind
//: transform [失敗/しっぱい]の error kind を owner を[動/うご]かさず[読/よ]む
pub fn vec_transform_error_kind <.T> <(&VecTransformError<.T>)->StdErrorKind> (e):
    *field::get_ref e "error"

//: ## vec_transform_error_vec
//: transform [失敗/しっぱい]で[戻/もど]された入力 `Vec` owner を[取/と]り[出/だ]す
pub fn vec_transform_error_vec <.T> <(VecTransformError<.T>)->Vec<.T>> (e):
    field::get e "vec"

//: ## VecPop
//: `pop` の結果を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `.Pair` の数値 field ではなく、`vec` と `item` を名前付き field として Resource IR に渡します。
//: - 返却された `vec` owner を呼び出し側が明示的に回収できます。
pub struct VecPop<.T>:
    vec <Vec<.T>>
    item <Option<.T>>

//: ## vec_pop_item
//: `pop` の[結果/けっか]から、[取/と]り[出/だ]した[値/あたい]を owner を[動/うご]かさずに[読/よ]む
//:
//: ### [目的/もくてき]
//: - `VecPop` は[更新後/こうしんご]の `Vec` owner を[含/ふく]むため、caller が field を直接 projection しないようにします。
//: - `item` は `Option<T>` として[複製/ふくせい]して[読/よ]むだけなので `.T: Copy` に[限定/げんてい]します。
pub fn vec_pop_item <.T: Copy> <(&VecPop<.T>)->Option<.T>> (p):
    *field::get_ref p "item"

//: ## vec_pop_vec
//: `pop` の[結果/けっか]から、[更新後/こうしんご]の `Vec` owner を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - `VecPop` を[消費/しょうひ]し、次に[使/つか]う `Vec` owner だけを[移動/いどう]します。
//: - owner を[含/ふく]む field projection は `Vec` 実装境界に[閉/と]じます。
pub fn vec_pop_vec <.T> <(VecPop<.T>)->Vec<.T>> (p):
    field::get p "vec"

//: ## VecPartition
//: `partition` の 2 本の結果 `Vec` を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `matched` は predicate が true の[要素/ようそ]、`rest` は false の[要素/ようそ]を[保持/ほじ]します。
//: - `.Pair` の位置番号ではなく名前付き field にして、owner の[解放/かいほう]漏れを静的検査で[見/み]える形にします。
pub struct VecPartition<.T>:
    matched <Vec<.T>>
    rest <Vec<.T>>
