//: # vec/storage/alloc
//: `Vec` storage allocation constructor
//:
//: ### [目的/もくてき]
//: - empty/owned storage allocation helper をこの module に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - この module は typed `alloc_region` を[使/つか]い、free obligation owner を `RegionToken` に[集約/しゅうやく]します。
//: - public constructor は `storage/api` が[所有/しょゆう]し、この helper を[明示的/めいじてき]に[呼/よ]びます。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "../types" as *
#import "./view" as view

//: ## vec_alloc_empty
//: [空/から]の `Vec` 用 owned storage を[確保/かくほ]する
//:
//: ### [目的/もくてき]
//: - `cap > 0` の[空/から] `Vec` に対して、`VecStorageState::Owned` の backing storage owner token を[確保/かくほ]します。
//:
//: ### [実装/じっそう]
//:
//: ### [注意/ちゅうい]
//: - [現行/げんこう]の `Vec` allocation constructor は `.T: Copy` に[限定/げんてい]します。non-Copy payload 用の drop traversal / owner-preserving cleanup がない[状態/じょうたい]で backing storage を[確保/かくほ]すると、解放できない owner を[作/つく]るためです。
pub fn vec_alloc_empty <.T: Copy> <(i32)->Result<Vec<.T>, StdErrorKind>> (requested_cap):
    if:
        le requested_cap 0
        then:
            Result::Ok<Vec<.T>, StdErrorKind> view::vec_empty<.T>
        else:
            match alloc_region<.T> requested_cap:
                Result::Ok region:
                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> 0 requested_cap VecStorageState::Owned region
                Result::Err _e:
                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory
