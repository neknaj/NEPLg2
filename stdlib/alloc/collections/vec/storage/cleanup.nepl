//: # vec/storage/cleanup
//: `Vec` backing storage cleanup
//:
//: ### [目的/もくてき]
//: - storage state に[応/おう]じた backing buffer [解放/かいほう]だけを[所有/しょゆう]します。
//:
//: ### [注意/ちゅうい]
//: - backing buffer の[解放/かいほう]は typed owner-consuming `dealloc_ptr` を[通/とお]します。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "../types" as *

//: ## vec_free_storage
//: storage state に[応/おう]じて backing buffer を[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - empty storage は何もせず、owned storage だけを `dealloc_ptr` へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - この helper は storage-only dealloc であり、要素ごとの Drop は[実行/じっこう]しません。そのため `OwnedBuffer<T>` と initialized prefix traversal が[入/はい]るまでは `.T: Copy` に[限定/げんてい]します。
//: - non-Copy 要素の drop traversal は collection cleanup issue の対象として分けます。
pub fn vec_free_storage <.T: Copy> <(VecStorageState,MemPtr<.T>,i32)->()> (storage, data, cap):
    match storage:
        VecStorageState::Empty:
            ()
        VecStorageState::Owned:
            match dealloc_ptr<.T> data mul cap size_of<.T>:
                Result::Ok _:
                    ()
                Result::Err _:
                    #intrinsic "unreachable" <> ()
