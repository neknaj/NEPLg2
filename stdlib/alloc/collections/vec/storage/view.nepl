//: # vec/storage/view
//: `Vec` empty storage constructor helper
//:
//: ### [目的/もくてき]
//: - allocation を[持/も]たない empty storage の構築を[所有/しょゆう]します。

#indent 4

#import "../types" as *

//: ## vec_empty
//: allocation を[持/も]たない[空/から]の `Vec` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - OOM fallback など追加 allocation を行えない場面でも、null pointer ではなく `VecStorage::Empty` で空 storage を[表/あらわ]します。
//: - `Empty` storage は runtime allocation、`RegionToken<T>` owner、initialized slot をどれも[持/も]たないため、payload の copy / move-out / drop / storage release 権限を[発生/はっせい]させません。
//: - そのため、この constructor だけは non-Copy payload の `Vec<T>` metadata owner を[作/つく]れます。
//:
//: ### [制約/せいやく]
//: - Empty state は runtime allocation も `RegionToken<T>` owner も[持/も]ちません。
//: - `new` / `with_capacity` は `.T: Copy` または `.T: Drop` の capability がある場合だけ allocated storage を[作/つく]れます。
//: - `clear` / `free` は `.T: Copy` では destructor 不要の range proof、`.T: Drop` では actual Drop traversal proof を使います。
//: - `push` / payload access は initialized slot の move-out / replacement / failure recovery が未完成なので Copy-only のままです。
//: - `Copy` でも `Drop` でもない payload に対して許されるのは、空 storage の metadata observation だけです。payload move/drop と storage release は Resource IR proof と compiler-issued owner token / initialized/moved/drop state の証明により別途[扱/あつか]います。
//:
//: ### [使用例/しようれい]
//: non-Copy payload でも、空 storage の metadata は[観測/かんそく]できます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: struct NonCopyPayload:
//:     value %i32
//:
//: fn main %fn () i32 \():
//:     let v %Vec NonCopyPayload vec_empty<NonCopyPayload>
//:     let ok %bool is_empty<NonCopyPayload> &v
//:     if ok 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload () \_self:
//:         ()
//:
//: fn main %impure fn () i32 \():
//:     let v %Vec DropPayload vec_empty<DropPayload>
//:     free<DropPayload> v
//:     0
//: ```
pub fn vec_empty <.T> %fn () Vec .T \():
    Vec<.T> (OwnedBuffer<.T> 0 0 0 VecStorage<.T>::Empty)
