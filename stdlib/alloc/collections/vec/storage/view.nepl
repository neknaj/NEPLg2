//: # vec/storage/view
//: `Vec` storage state の raw-free view helper
//:
//: ### [目的/もくてき]
//: - allocation を[持/も]たない empty storage と typed pointer view の[変換/へんかん]を[所有/しょゆう]します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/traits/copy" as *
#import "../types" as *

//: ## vec_empty_region
//: allocation を[持/も]たない `VecStorageState::Empty` 用の内部 sentinel を[作/つく]る
//:
//: ### [目的/もくてき]
//: - `Vec` の struct layout が `region` field を要求する過渡期間だけ、zero-size `RegionToken` を内部で[組/く]み[立/た]てます。
//: - public API には出さず、caller は `vec_empty` / `with_capacity 0` の typed empty state を[使/つか]います。
fn vec_empty_region <.T> <()->RegionToken<.T>> ():
    let ptr <MemPtr<.T>> mem_ptr_wrap 0
    region_new ptr 0

//: ## vec_empty
//: allocation を[持/も]たない[空/から]の `Vec` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - OOM fallback など追加 allocation を行えない場面でも、null pointer ではなく `VecStorageState::Empty` で空 storage を[表/あらわ]します。
pub fn vec_empty <.T> <()->Vec<.T>> ():
    Vec<.T> 0 0 VecStorageState::Empty vec_empty_region<.T>

//: ## vec_storage_mem_ptr
//: storage state を raw pointer view へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `VecStorageState::Empty` は owner state としては allocation を[持/も]ちませんが、legacy raw pointer observer では 0 address view を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - 現行 raw pointer view は `.T: Copy` 専用です。non-Copy payload の storage identity は `OwnedBuffer<T>` と borrowed element API が[入/はい]るまで[公開/こうかい]しません。
pub fn vec_storage_mem_ptr <.T: Copy> <(VecStorageState,&RegionToken<.T>)->MemPtr<.T>> (storage, region):
    match storage:
        VecStorageState::Empty:
            mem_ptr_wrap 0
        VecStorageState::Owned:
            region_ptr region
