//: # vec/storage/fill
//: `Vec` filled construction
//:
//: ### [目的/もくてき]
//: - 同じ Copy 値で[初期化/しょきか]した `Vec` の allocation と cell initialization を[所有/しょゆう]します。
//:
//: ### [注意/ちゅうい]
//: - この module は typed `alloc_region` / `store` を[使/つか]うため exact raw-memory boundary です。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "../types" as *
#import "./view" as view
#import "core/field" as *

//: ## filled
//: [同/おな]じ Copy [値/あたい]で[満/み]たした `Vec<.T>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - [固定長/こていちょう]の buffer や table を、`with_capacity` + `push` の loop ではなく 1 つの API で[作成/さくせい]します。
//: - [確保/かくほ][失敗/しっぱい]は `Result::Err StdErrorKind::OutOfMemory` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `n <= 0` なら `VecStorage::Empty` の[空/から]の `Vec` を[返/かえ]します。
//: - `n > 0` なら `n` [要素分/ようそぶん]を typed `alloc_region<.T>` で[確保/かくほ]し、先頭から順に `store` で同じ値を書き込みます。
//: - 各 `store` の直後に slot initialization proof を[発行/はっこう]し、書き込み済み範囲が `initialized_len` と一致することを Resource IR の collection slot summary へ[渡/わた]します。
//: - 書き込み完了後は `len = initialized_len = cap = n` の `OwnedBuffer` を[持/も]つ `Vec` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `.T: Copy` に[限定/げんてい]します。同じ値を複数セルへ複製して保持するためです。
//: - [返/かえ]った `Vec` は通常どおり `free` で[解放/かいほう]してください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n)、[追加/ついか]の[空間/くうかん][計算量/けいさんりょう]は O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: fn main %impure fn unit i32 \unit:
//:     match filled<i32> 3 7:
//:         Result::Ok v:
//:             let observed_len %i32 len<i32> &v
//:             let len_ok %bool eq observed_len 3
//:             let mid_ok %bool:
//:                 match get<i32> &v 1:
//:                     Option::Some x:
//:                         eq x 7
//:                     Option::None:
//:                         false
//:             free<i32> v;
//:             if and len_ok mid_ok 0 1
//:         Result::Err _:
//:             1
//: ```
//: ## vec_filled_slot_store_initialized
//: `filled` の payload store と slot initialization proof を同じ private 境界で発行する
//:
//: ### [目的/もくてき]
//: - raw `store<T>` と `collection_slot_initialize_empty` marker を[同/おな]じ helper に[閉/と]じます。
//: - `filled` が `len = initialized_len = cap` の `Vec` を[返/かえ]すため、各 slot が[実際/じっさい]に[初期化/しょきか]されたことを Resource IR の summary に[残/のこ]します。
//:
//: ### [注意/ちゅうい]
//: - `.T: Copy` の値だけを[受/う]け[取/と]ります。同じ `value` を複数 slot に[書/か]き[込/こ]むため、owner payload を複製してはいけません。
//: - この helper は public にしません。collection slot marker は allocation を[実行/じっこう]している implementation boundary の[内部/ないぶ]証明として[扱/あつか]います。
fn vec_filled_slot_store_initialized <.T: Copy> %fn &RegionToken .T fn i32 fn .T unit \storage\byte_off\value:
    let data %MemPtr .T region_ptr storage
    let slot %MemPtr .T mem_ptr_add<.T> data byte_off
    let raw %i32 mem_ptr_addr slot
    store<.T> raw value
    #intrinsic "collection_slot_initialize_empty" <.T> (storage, byte_off)

pub fn filled <.T: Copy> %fn i32 fn .T Result Vec .T StdErrorKind \n\value:
    if:
        le n 0
        then:
            Result::Ok view::vec_empty<.T>
        else:
            match alloc_region<.T> n:
                Result::Ok region:
                    let mut i %i32 0
                    while lt i n:
                        do:
                            let write_off %i32 mul i size_of<.T>
                            vec_filled_slot_store_initialized<.T> &region write_off value
                            set i add i 1
                    Result::Ok Vec<.T> (OwnedBuffer<.T> n n n (VecStorage<.T>::Owned region))
                Result::Err _e:
                    Result::Err StdErrorKind::OutOfMemory
