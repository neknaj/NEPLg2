//: simple: 小規模・教育用の in-place sort algorithms
//:
//: [目的/もくてき]:
//: - insertion / selection / bubble / cocktail / gnome / shell / comb sort をまとめます。
//: - 共通の比較・swap helper は `sort/common` に委譲します。

#indent 4

#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/sort/common" as *
//: sort_insertion: insertion sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 小さい `Vec` やほぼ整列済みの入力を単純な in-place algorithm で昇順にします。
//:
//: [実装/じっそう]:
//: - 左側を整列済み prefix とみなし、現在要素を左へずらしながら挿入位置へ移動します。
//:
//: [注意/ちゅうい]:
//: - 追加 allocation はありません。実装上は equal element を追い越さないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)、ほぼ整列済みでは O(n) に近づきます。
fn sort_insertion <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1
            while lt i n:
                do:
                    let key <.T> sort_get_unchecked<.T> v i;
                    let mut j <i32> sub i 1;

                    let mut done <i32> 0;
                    while eq done 0:
                        do:
                            if:
                                and le 0 j sort_lt<.T> key sort_get_unchecked<.T> v j
                                then:
                                    let x <.T> sort_get_unchecked<.T> v j;
                                    sort_set_unchecked<.T> v add j 1 x;
                                    set j sub j 1;
                                else set done 1
                    sort_set_unchecked<.T> v add j 1 key;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 2) Selection sort
// -----------------------------------------------------------------------------
//: sort_selection: selection sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 未整列 suffix から最小要素を選び、先頭へ交換しながら昇順にします。
//:
//: [実装/じっそう]:
//: - 各位置 `i` について `[i, n)` の最小 index を探し、`i` と交換します。
//:
//: [注意/ちゅうい]:
//: - 交換で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 比較 O(n^2)、追加領域 O(1)
fn sort_selection <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 0
            while lt i n:
                do:
                    let mut min_idx <i32> i;
                    let mut j <i32> add i 1;
                    while lt j n:
                        do:
                            let a <.T> sort_get_unchecked<.T> v j;
                            let b <.T> sort_get_unchecked<.T> v min_idx;
                            if:
                                sort_lt<.T> a b
                                then set min_idx j
                                else ()
                            set j add j 1;
                    sort_swap<.T> v i min_idx;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 3) Bubble sort
// -----------------------------------------------------------------------------
//: sort_bubble: bubble sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 隣接交換だけで大きい要素を右端へ送る単純な sort を提供します。
//:
//: [実装/じっそう]:
//: - `[0, end]` を走査し、右要素が左要素より小さい pair を交換して `end` を縮めます。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - O(n^2)
fn sort_bubble <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut end <i32> sub n 1;
            while lt 0 end:
                do:
                    let mut i <i32> 0;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then sort_swap<.T> v i add i 1
                                else ()
                            set i add i 1;
                    set end sub end 1;
            ()


// -----------------------------------------------------------------------------
// 4) Cocktail shaker sort
// -----------------------------------------------------------------------------
//: sort_cocktail: cocktail shaker sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 左右両方向の bubble pass で、小さい要素と大きい要素を同時に端へ寄せます。
//:
//: [実装/じっそう]:
//: - forward pass で最大側を右へ、backward pass で最小側を左へ送ります。
//: - 交換が起きなければ残り区間は整列済みとして終了します。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)
fn sort_cocktail <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut start <i32> 0;
            let mut end <i32> sub n 1;
            let mut swapped <i32> 1;

            while and eq swapped 1 lt start end:
                do:
                    set swapped 0;

                    // forward pass
                    let mut i <i32> start;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v i add i 1;
                                    set swapped 1;
                                    ()
                                else ()
                            set i add i 1;

                    set end sub end 1;

                    if:
                        eq swapped 0
                        then set start end
                        else:
                            set swapped 0;

                    // backward pass
                    let mut j <i32> end;
                    while lt start j:
                        do:
                            let a <.T> sort_get_unchecked<.T> v sub j 1;
                            let b <.T> sort_get_unchecked<.T> v j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v sub j 1 j;
                                    set swapped 1;
                                    ()
                                else ()
                            set j sub j 1;

                    set start add start 1;
            ()


// -----------------------------------------------------------------------------
// 5) Gnome sort
// -----------------------------------------------------------------------------
//: sort_gnome: gnome sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 隣接要素を見ながら、逆順 pair を交換して左へ戻る単純な insertion 系 sort を提供します。
//:
//: [実装/じっそう]:
//: - 現在位置が正しい順序なら右へ進み、逆順なら隣接交換して左へ 1 つ戻ります。
//:
//: [注意/ちゅうい]:
//: - equal element は `sort_le` で通過するため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)
fn sort_gnome <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1;
            while lt i n:
                do:
                    if:
                        or eq i 0 sort_le<.T> sort_get_unchecked<.T> v sub i 1 sort_get_unchecked<.T> v i
                        then set i add i 1
                        else:
                            sort_swap<.T> v i sub i 1;
                            set i sub i 1;
                    ();
            ()


// -----------------------------------------------------------------------------
// 6) Shell sort
// -----------------------------------------------------------------------------
//: sort_shell: shell sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - gap insertion sort を繰り返し、単純 insertion sort より少ない移動で広い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `n / 2` から始め、各 pass 後に半分へ縮めます。
//: - 各 gap pass は gap ごとの insertion sort として動きます。
//:
//: [注意/ちゅうい]:
//: - gap 越しの移動で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - gap 列に依存します。この実装では最悪 O(n^2)、追加領域 O(1) です。
fn sort_shell <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> div_s n 2;

            while lt 0 gap:
                do:
                    let mut i <i32> gap;
                    while lt i n:
                        do:
                            let temp <.T> sort_get_unchecked<.T> v i;
                            let mut j <i32> i;

                            let mut done <i32> 0;
                            while eq done 0:
                                do:
                                    if:
                                        and le gap j sort_lt<.T> temp sort_get_unchecked<.T> v sub j gap
                                        then:
                                            let x <.T> sort_get_unchecked<.T> v sub j gap;
                                            sort_set_unchecked<.T> v j x;
                                            set j sub j gap;
                                        else set done 1

                            sort_set_unchecked<.T> v j temp;
                            set i add i 1;
                    set gap div_s gap 2;
            ()


// -----------------------------------------------------------------------------
// 7) Comb sort
// -----------------------------------------------------------------------------
//: sort_comb: comb sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - bubble sort の gap を広げた variant として、遠い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `gap * 10 / 13` で縮め、gap 1 で交換がなくなるまで走査します。
//:
//: [注意/ちゅうい]:
//: - gap 越しに交換するため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 平均は bubble sort より改善しますが、最悪 O(n^2) です。
fn sort_comb <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> n;
            let mut sorted <i32> 0;

            while eq sorted 0:
                do:
                    // gap = floor(gap * 10 / 13)
                    let scaled_gap <i32> mul gap 10;
                    let reduced_gap <i32> div_s scaled_gap 13;
                    set gap reduced_gap;
                    if:
                        lt gap 1
                        then set gap 1
                        else ()

                    if:
                        eq gap 1
                        then set sorted 1
                        else ()

                    let mut i <i32> 0;
                    let mut done_scan <i32> 0;
                    while eq done_scan 0:
                        do:
                            let next_i <i32> add i gap;
                            if:
                                lt next_i n
                                then:
                                    let a <.T> sort_get_unchecked<.T> v i;
                                    let b <.T> sort_get_unchecked<.T> v next_i;
                                    if:
                                        sort_lt<.T> b a
                                        then:
                                            sort_swap<.T> v i next_i;
                                            set sorted 0;
                                            ()
                                        else ()
                                    set i add i 1;
                                    ()
                                else set done_scan 1
            ()


// -----------------------------------------------------------------------------
// 8) Quick sort (Lomuto partition)
// -----------------------------------------------------------------------------
