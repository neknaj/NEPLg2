//: selection: selection 系の simple in-place sort algorithm
//:
//: [目的/もくてき]:
//: - 未整列 suffix から選んだ要素を確定位置へ置く selection sort を提供します。
//: - 交換回数が高々 O(n) で済む simple sort を他の隣接交換系から分離します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as *
#import "alloc/collections/vec/sort/common" as *

//: sort_selection: selection sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 未整列 suffix から最小要素を選び、先頭へ交換しながら昇順にします。
//:
//: [実装/じっそう]:
//: - 各位置 `i` について `[i, n)` の最小 index を探し、`i` と交換します。
//:
//: [注意/ちゅうい]:
//: - 交換で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 比較 O(n^2)、追加領域 O(1)
pub fn sort_selection <.T: Ord&Copy> %impure fn &Vec .T unit \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            unit
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            unit
                        VecDataView::Invalid _reason:
                            unit
                        VecDataView::Data data:
                            let mut i %i32 0
                            while lt i n:
                                do:
                                    let mut min_idx %i32 i;
                                    let mut j %i32 add i 1;
                                    while lt j n:
                                        do:
                                            let a %.T load<.T> add mem_ptr_addr data mul j size_of %.T;
                                            let b %.T load<.T> add mem_ptr_addr data mul min_idx size_of %.T;
                                            if:
                                                sort_lt<.T> a b
                                                then set min_idx j
                                                else unit
                                            set j add j 1;
                                    let left %.T load<.T> add mem_ptr_addr data mul i size_of %.T
                                    let right %.T load<.T> add mem_ptr_addr data mul min_idx size_of %.T
                                    store<.T> add mem_ptr_addr data mul i size_of %.T right;
                                    store<.T> add mem_ptr_addr data mul min_idx size_of %.T left;
                                    set i add i 1;
                            unit
