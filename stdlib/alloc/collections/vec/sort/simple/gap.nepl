//: gap: gap を使う simple in-place sort algorithms
//:
//: [目的/もくてき]:
//: - shell / comb sort のように離れた要素の逆転を先に解消する algorithms を提供します。
//: - gap の縮小規則を持つ sort を隣接交換系から分離します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as *
#import "alloc/collections/vec/sort/common" as *

//: sort_shell: shell sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - gap insertion sort を繰り返し、単純 insertion sort より少ない移動で広い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `n / 2` から始め、各 pass 後に半分へ縮めます。
//: - 各 gap pass は gap ごとの insertion sort として動きます。
//:
//: [注意/ちゅうい]:
//: - gap 越しの移動で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - gap 列に依存します。この実装では最悪 O(n^2)、追加領域 O(1) です。
pub fn sort_shell <.T: Ord&Copy> %impure fn &Vec .T unit \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            unit
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            unit
                        VecDataView::Invalid _reason:
                            unit
                        VecDataView::Data data:
                            let mut gap %i32 div_s n 2;

                            while lt 0 gap:
                                do:
                                    let mut i %i32 gap;
                                    while lt i n:
                                        do:
                                            let temp %.T load<.T> add mem_ptr_addr data mul i size_of<.T>;
                                            let mut j %i32 i;

                                            let mut done %i32 0;
                                            while eq done 0:
                                                do:
                                                    if:
                                                        and le gap j sort_lt<.T> temp load<.T> add mem_ptr_addr data mul sub j gap size_of<.T>
                                                        then:
                                                            let src %i32 sub j gap
                                                            let x %.T load<.T> add mem_ptr_addr data mul src size_of<.T>;
                                                            store<.T> add mem_ptr_addr data mul j size_of<.T> x;
                                                            set j sub j gap;
                                                        else set done 1

                                            store<.T> add mem_ptr_addr data mul j size_of<.T> temp;
                                            set i add i 1;
                                    set gap div_s gap 2;
                            unit

//: sort_comb: comb sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - bubble sort の gap を広げた variant として、遠い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `gap * 10 / 13` で縮め、gap 1 で交換がなくなるまで走査します。
//:
//: [注意/ちゅうい]:
//: - gap 越しに交換するため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 平均は bubble sort より改善しますが、最悪 O(n^2) です。
pub fn sort_comb <.T: Ord&Copy> %impure fn &Vec .T unit \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            unit
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            unit
                        VecDataView::Invalid _reason:
                            unit
                        VecDataView::Data data:
                            let mut gap %i32 n;
                            let mut sorted %i32 0;

                            while eq sorted 0:
                                do:
                                    let scaled_gap %i32 mul gap 10;
                                    let reduced_gap %i32 div_s scaled_gap 13;
                                    set gap reduced_gap;
                                    if:
                                        lt gap 1
                                        then set gap 1
                                        else unit

                                    if:
                                        eq gap 1
                                        then set sorted 1
                                        else unit

                                    let mut i %i32 0;
                                    let mut done_scan %i32 0;
                                    while eq done_scan 0:
                                        do:
                                            let next_i %i32 add i gap;
                                            if:
                                                lt next_i n
                                                then:
                                                    let a %.T load<.T> add mem_ptr_addr data mul i size_of<.T>;
                                                    let b %.T load<.T> add mem_ptr_addr data mul next_i size_of<.T>;
                                                    if:
                                                        sort_lt<.T> b a
                                                        then:
                                                            store<.T> add mem_ptr_addr data mul i size_of<.T> b;
                                                            store<.T> add mem_ptr_addr data mul next_i size_of<.T> a;
                                                            set sorted 0;
                                                            unit
                                                        else unit
                                                    set i add i 1;
                                                    unit
                                                else set done_scan 1
                            unit
