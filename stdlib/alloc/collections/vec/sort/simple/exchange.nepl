//: exchange: 隣接交換系の simple in-place sort algorithms
//:
//: [目的/もくてき]:
//: - bubble / cocktail sort のように隣接交換で境界へ要素を送る algorithms を提供します。
//: - 安定性と早期終了の扱いを gap 系 sort から分離します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/result" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as *
#import "alloc/collections/vec/sort/common" as *

//: sort_bubble: bubble sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 隣接交換だけで大きい要素を右端へ送る単純な sort を提供します。
//:
//: [実装/じっそう]:
//: - `[0, end]` を走査し、右要素が左要素より小さい pair を交換して `end` を縮めます。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//: - metadata invariant が壊れている `Vec` は silent no-op にせず、`StdErrorKind::InvalidOperation` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n^2)
pub fn sort_bubble <.T: Ord&Copy> %impure fn &Vec .T Result unit StdErrorKind \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            Result::Err StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then Result::Ok unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Data data:
                            let mut end %i32 sub n 1;
                            while lt 0 end:
                                do:
                                    let mut i %i32 0;
                                    while lt i end:
                                        do:
                                            let next_i %i32 add i 1
                                            let a %.T load<.T> add mem_ptr_addr data mul i size_of %.T;
                                            let b %.T load<.T> add mem_ptr_addr data mul next_i size_of %.T;
                                            if:
                                                sort_lt<.T> b a
                                                then:
                                                    store<.T> add mem_ptr_addr data mul i size_of %.T b;
                                                    store<.T> add mem_ptr_addr data mul next_i size_of %.T a
                                                else unit
                                            set i add i 1;
                                    set end sub end 1;
                            Result::Ok unit

//: sort_cocktail: cocktail shaker sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 左右両方向の bubble pass で、小さい要素と大きい要素を同時に端へ寄せます。
//:
//: [実装/じっそう]:
//: - forward pass で最大側を右へ、backward pass で最小側を左へ送ります。
//: - 交換が起きなければ残り区間は整列済みとして終了します。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//: - metadata invariant が壊れている `Vec` は silent no-op にせず、`StdErrorKind::InvalidOperation` を返します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)
pub fn sort_cocktail <.T: Ord&Copy> %impure fn &Vec .T Result unit StdErrorKind \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            Result::Err StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then Result::Ok unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Data data:
                            let mut start %i32 0;
                            let mut end %i32 sub n 1;
                            let mut swapped %i32 1;

                            while and eq swapped 1 lt start end:
                                do:
                                    set swapped 0;

                                    let mut i %i32 start;
                                    while lt i end:
                                        do:
                                            let next_i %i32 add i 1
                                            let a %.T load<.T> add mem_ptr_addr data mul i size_of %.T;
                                            let b %.T load<.T> add mem_ptr_addr data mul next_i size_of %.T;
                                            if:
                                                sort_lt<.T> b a
                                                then:
                                                    store<.T> add mem_ptr_addr data mul i size_of %.T b;
                                                    store<.T> add mem_ptr_addr data mul next_i size_of %.T a;
                                                    set swapped 1;
                                                    unit
                                                else unit
                                            set i add i 1;

                                    set end sub end 1;

                                    if:
                                        eq swapped 0
                                        then set start end
                                        else:
                                            set swapped 0;

                                    let mut j %i32 end;
                                    while lt start j:
                                        do:
                                            let prev_j %i32 sub j 1
                                            let a %.T load<.T> add mem_ptr_addr data mul prev_j size_of %.T;
                                            let b %.T load<.T> add mem_ptr_addr data mul j size_of %.T;
                                            if:
                                                sort_lt<.T> b a
                                                then:
                                                    store<.T> add mem_ptr_addr data mul prev_j size_of %.T b;
                                                    store<.T> add mem_ptr_addr data mul j size_of %.T a;
                                                    set swapped 1;
                                                    unit
                                                else unit
                                            set j sub j 1;

                                    set start add start 1;
                            Result::Ok unit
