//: raw/quick: quick sort の raw range traversal
//:
//: [目的/もくてき]:
//: - Lomuto partition と raw `MemPtr` 区間 quick sort を implementation boundary に閉じます。
//: - public quick sort API は `sort/quick.nepl` の `Vec` based wrapper だけを使います。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "../common" as *
#import "./access" as *

//: sort_quick_partition_data: Lomuto partition で pivot 位置を決める
//:
//: [目的/もくてき]:
//: - `[lo, hi]` の raw data view を pivot 以下と pivot より大きい側へ分け、pivot の最終 index を返します。
//:
//: [注意/ちゅうい]:
//: - `lo <= hi` と `[lo, hi]` が初期化済み `.T` cell の範囲内であることは caller が保証します。
pub fn sort_quick_partition_data <.T: Ord&Copy> <(MemPtr<.T>,i32,i32)*>i32> (data_ptr, lo, hi):
    let pivot <.T> sort_get_unchecked_data<.T> data_ptr hi
    let mut i <i32> lo;
    let mut j <i32> lo;

    while lt j hi:
        do:
            let x <.T> sort_get_unchecked_data<.T> data_ptr j;
            if:
                sort_le<.T> x pivot
                then:
                    sort_swap_data<.T> data_ptr i j;
                    set i add i 1;
                    ()
                else ()
            set j add j 1;

    sort_swap_data<.T> data_ptr i hi;
    i

//: sort_quick_range_data: raw slice 区間を quick sort する
//:
//: [目的/もくてき]:
//: - raw data view の `[lo, hi]` 閉区間を Lomuto quick sort で in-place 整列します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n)、最悪 O(n^2)、追加領域は再帰 stack です。
pub fn sort_quick_range_data <.T: Ord&Copy> <(MemPtr<.T>,i32,i32)*>()> (data_ptr, lo, hi):
    if:
        lt lo hi
        then:
            let p <i32> sort_quick_partition_data<.T> data_ptr lo hi;
            sort_quick_range_data<.T> data_ptr lo sub p 1;
            sort_quick_range_data<.T> data_ptr add p 1 hi;
            ()
        else ()

//: sort_slice_quick: raw `MemPtr` slice を quick sort する implementation helper
//:
//: [目的/もくてき]:
//: - 先頭 pointer と長さだけを持つ implementation boundary で quick sort を実行します。
//:
//: [注意/ちゅうい]:
//: - canonical `sort` facade からは公開しません。raw data owner と範囲証明を持つ内部 module だけが明示 import します。
pub fn sort_slice_quick <.T: Ord&Copy> <(MemPtr<.T>,i32)*>()> (data_ptr, len):
    if:
        le len 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub len 1;
            ()
