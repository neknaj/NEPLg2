//: raw/access: sort implementation 用の unchecked storage access
//:
//: [目的/もくてき]:
//: - sort algorithm 内部で使う `MemPtr` based load/store/swap helper を raw implementation boundary に閉じます。
//: - canonical `alloc/collections/vec/sort` facade はこの module を再公開しません。
//:
//: [注意/ちゅうい]:
//: - すべての index 境界、initialized cell、上書き時の drop 義務は caller が証明済みである必要があります。
//: - `.T: Copy` 専用です。non-Copy payload の sort は `OwnedBuffer<T>` と move/drop-aware algorithm が入るまで提供しません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "alloc/collections/vec" as *

//: sort_get_unchecked: `Vec` storage から index を検査せずに読む
//:
//: [目的/もくてき]:
//: - sort loop 内で `Vec` の typed data view から `.T` を高速に読み出します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_get_unchecked <.T: Copy> <(&Vec<.T>,i32)->.T> (v, idx):
    let data <MemPtr<.T>> data_mem_ptr<.T> v
    sort_get_unchecked_data<.T> data idx

//: sort_set_unchecked: `Vec` storage へ index を検査せずに書く
//:
//: [目的/もくてき]:
//: - sort loop 内で `.T` を指定 index へ書き戻します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_set_unchecked <.T: Copy> <(&Vec<.T>,i32,.T)*>()> (v, idx, val):
    let data <MemPtr<.T>> data_mem_ptr<.T> v
    sort_set_unchecked_data<.T> data idx val

//: sort_get_unchecked_data: raw data pointer 版の unchecked read
//:
//: [目的/もくてき]:
//: - sort implementation が `Vec` wrapper を経由せず、既に取り出した data view から `.T` を読むための低水準 helper です。
//:
//: [注意/ちゅうい]:
//: - `data_ptr` が `.T` の初期化済み cell を `idx` 位置に持つことは caller の証明済み条件です。
pub fn sort_get_unchecked_data <.T: Copy> <(MemPtr<.T>,i32)->.T> (data_ptr, idx):
    let off <i32> mul idx size_of<.T>
    load<.T> add mem_ptr_addr data_ptr off

//: sort_set_unchecked_data: raw data pointer 版の unchecked write
//:
//: [目的/もくてき]:
//: - sort implementation が `Vec` wrapper を経由せず、既に取り出した data view へ `.T` を書くための低水準 helper です。
//:
//: [注意/ちゅうい]:
//: - 上書きされる cell の drop 義務がないこと、または `.T: Copy` として値破棄が安全であることを caller が保証します。
pub fn sort_set_unchecked_data <.T: Copy> <(MemPtr<.T>,i32,.T)*>()> (data_ptr, idx, val):
    let off <i32> mul idx size_of<.T>
    store<.T> add mem_ptr_addr data_ptr off val;
    ()

//: sort_swap_data: raw data pointer 版の swap
//:
//: [目的/もくてき]:
//: - sort implementation が raw data view 上の 2 要素を入れ替えます。
//:
//: [注意/ちゅうい]:
//: - 両 index が同じなら何もしません。異なる場合は両方の index が有効範囲内である必要があります。
pub fn sort_swap_data <.T: Copy> <(MemPtr<.T>,i32,i32)*>()> (data_ptr, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked_data<.T> data_ptr i
            let b <.T> sort_get_unchecked_data<.T> data_ptr j
            sort_set_unchecked_data<.T> data_ptr i b;
            sort_set_unchecked_data<.T> data_ptr j a;
            ()

//: sort_swap: `Vec` の 2 要素を unchecked に入れ替える
//:
//: [目的/もくてき]:
//: - sort implementation が `Vec` 参照から data view を得て 2 要素を入れ替えます。
//:
//: [注意/ちゅうい]:
//: - public caller 向けの bounds-checked API ではありません。algorithm 側で index 範囲を証明してから使います。
pub fn sort_swap <.T: Copy> <(&Vec<.T>,i32,i32)*>()> (v, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked<.T> v i
            let b <.T> sort_get_unchecked<.T> v j
            sort_set_unchecked<.T> v i b;
            sort_set_unchecked<.T> v j a;
            ()
