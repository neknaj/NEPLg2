//: common: sort algorithms で共有する比較と safe observer
//:
//: [目的/もくてき]:
//: - `Vec` sort family の比較規約と sortedness observer を 1 箇所に集約します。
//: - canonical sort facade から raw `MemPtr` helper を公開しないよう、比較規約と sortedness observer だけをここに置きます。
//:
//: [注意/ちゅうい]:
//: - 現行 sort family は raw load/store による in-place swap を使うため、`OwnedBuffer .T` と move/drop-aware sort が入るまでは `.T: Copy` に限定します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
//: sort_lt: sort 内部の strict less-than predicate
//:
//: [目的/もくてき]:
//: - `Ord` の `<` 判定を sort algorithm から呼びやすい名前で提供します。
//: - quick / heap / insertion などの比較規約を 1 箇所にそろえます。
//:
//: [実装/じっそう]:
//: - `ord_lt` に委譲します。
//:
//: [注意/ちゅうい]:
//: - `Ord` 実装が全順序であることを前提にします。矛盾した比較は sort 結果を不安定にします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_lt <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    ord_lt a b

//: sort_le: sort 内部の less-or-equal predicate
//:
//: [目的/もくてき]:
//: - partition や stable merge で「右より大きくない」ことを判定します。
//:
//: [実装/じっそう]:
//: - `ord_le` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_le <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    ord_le a b

//: sort_gt: sort 内部の greater-than predicate
//:
//: [目的/もくてき]:
//: - 降順側の比較や heap 条件の説明で使える `>` 判定を提供します。
//:
//: [実装/じっそう]:
//: - `ord_gt` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_gt <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    ord_gt a b

//: sort_ge: sort 内部の greater-or-equal predicate
//:
//: [目的/もくてき]:
//: - 境界条件の比較を `Ord` の名前空間へそろえます。
//:
//: [実装/じっそう]:
//: - `ord_ge` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn sort_ge <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    ord_ge a b

//: sort_is_sorted: `Vec` が昇順か確認する
//:
//: [目的/もくてき]:
//: - 隣接要素を左から右へ比較し、昇順に並んでいるかを返します。
//: - sort doctest と caller-side assertion のための軽量 verifier です。
//:
//: [実装/じっそう]:
//: - `right < left` になる隣接 pair が 1 つでもあれば `false` を返します。
//:
//: [注意/ちゅうい]:
//: - equal element は昇順として許可されます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
pub fn sort_is_sorted <.T: Ord&Copy> %fn &Vec .T bool \v:
    let n %i32 len<.T> v
    if:
        le n 1
        then true
        else:
            let mut i %i32 1
            let mut sorted %bool true
            while and sorted lt i n:
                do:
                    match get<.T> v sub i 1:
                        Option::None:
                            set sorted false
                        Option::Some a:
                            match get<.T> v i:
                                Option::None:
                                    set sorted false
                                Option::Some b:
                                    if:
                                        sort_lt<.T> b a
                                        then set sorted false
                                        else unit
                    set i add i 1;
            sorted


