//: merge/api: stable merge sort public API
//:
//: [目的/もくてき]:
//: - `sort_merge` / `sort_merge_ret` の public API と scratch buffer allocation を所有します。
//: - allocation failure は `StdErrorKind::OutOfMemory` として返します。
//:
//: [注意/ちゅうい]:
//: - scratch buffer は `RegionToken` owner として持ち、`MemPtr` は sort 用の non-owning view としてだけ使います。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/result" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as *
#import "core/field" as field
#import "core/field" as *

//: sort_merge_buffer_get: merge sort private buffer から 1 要素を読む
//:
//: `buf` は `sort_merge` / `sort_merge_ret` が確保した scratch buffer の non-owning view です。
//: public API から直接呼ばせると caller 側の範囲証明を迂回できるため、この file 内の private helper に閉じます。
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec/sort/merge/api" as *
//: fn main %impure fn unit i32 \unit:
//:     sort_merge_buffer_get<i32>
//:     0
//: ```
fn sort_merge_buffer_get <.T: Copy> %fn MemPtr .T fn i32 .T \buf\idx:
    let off %i32 mul idx size_of<.T>
    load<.T> add mem_ptr_addr buf off

//: sort_merge_buffer_set: merge sort private buffer へ 1 要素を書き込む
//:
//: 書き込み先の owner は `RegionToken` として public wrapper 側で保持し、ここでは `MemPtr` view だけを使います。
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec/sort/merge/api" as *
//: fn main %impure fn unit i32 \unit:
//:     sort_merge_buffer_set<i32>
//:     0
//: ```
fn sort_merge_buffer_set <.T: Copy> %impure fn MemPtr .T impure fn i32 impure fn .T unit \buf\idx\val:
    let off %i32 mul idx size_of<.T>
    store<.T> add mem_ptr_addr buf off val;
    unit

//: sort_merge_range_data: private raw traversal で `[l, r)` を stable merge sort する
//:
//: `data_ptr` と `buf` は `sort_merge` / `sort_merge_ret` が `Vec` owner と scratch `RegionToken` から作った
//: non-owning view です。ordinary source から直接呼べる module へは出さず、長さと owner の証明を public wrapper に集約します。
//:
//: neplg2:test[compile_fail]
//: diag_code: resolve.identifier.undefined
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec/sort/merge/api" as *
//: fn main %impure fn unit i32 \unit:
//:     sort_merge_range_data<i32>
//:     0
//: ```
fn sort_merge_range_data <.T: Ord&Copy> %impure fn MemPtr .T impure fn MemPtr .T impure fn i32 impure fn i32 unit \data_ptr\buf\l\r:
    let width %i32 sub r l;
    if:
        le width 1
        then unit
        else:
            let lr_sum %i32 add l r;
            let mid %i32 div_s lr_sum 2;
            sort_merge_range_data<.T> data_ptr buf l mid;
            sort_merge_range_data<.T> data_ptr buf mid r;

            let mut i0 %i32 l;
            while lt i0 r:
                do:
                    let x %.T load<.T> add mem_ptr_addr data_ptr mul i0 size_of<.T>;
                    sort_merge_buffer_set<.T> buf i0 x;
                    set i0 add i0 1;

            let mut i %i32 l;
            let mut j %i32 mid;
            let mut k %i32 l;

            let mut done_merge %i32 0;
            while eq done_merge 0:
                do:
                    let left_open %bool lt i mid;
                    let right_open %bool lt j r;
                    if:
                        and left_open right_open
                        then:
                            let a %.T sort_merge_buffer_get<.T> buf i;
                            let b %.T sort_merge_buffer_get<.T> buf j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    store<.T> add mem_ptr_addr data_ptr mul k size_of<.T> b;
                                    set j add j 1;
                                    unit
                                else:
                                    store<.T> add mem_ptr_addr data_ptr mul k size_of<.T> a;
                                    set i add i 1;
                                    unit;
                            set k add k 1;
                            unit
                        else set done_merge 1

            while lt i mid:
                do:
                    let a %.T sort_merge_buffer_get<.T> buf i;
                    store<.T> add mem_ptr_addr data_ptr mul k size_of<.T> a;
                    set i add i 1;
                    set k add k 1;

            while lt j r:
                do:
                    let b %.T sort_merge_buffer_get<.T> buf j;
                    store<.T> add mem_ptr_addr data_ptr mul k size_of<.T> b;
                    set j add j 1;
                    set k add k 1;

            unit

//: ## VecSortMergeError
//: `sort_merge_ret` の[失敗/しっぱい]時に `Vec` owner を[返/かえ]す error payload
//:
//: ### [目的/もくてき]
//: - `sort_merge_ret` は `Vec` owner を[消費/しょうひ]する fallible update なので、[失敗/しっぱい]時も caller が cleanup できるように owner を error payload に[含/ふく]めます。
//: - [診断/しんだん]用の error kind は Copy な `StdErrorKind` として[分離/ぶんり]し、owner の[回収/かいしゅう]と error [確認/かくにん]を別操作にします。
//:
//: ### [注意/ちゅうい]
//: - この payload は `sort_merge_ret` の失敗 branch が返すものです。ordinary source が constructor を直接呼んで owner を捏造する使い方は、owner-backed aggregate constructor restriction により拒否されます。
pub struct VecSortMergeError<.T>:
    vec %Vec .T
    error %StdErrorKind

//: vec_sort_merge_error_kind: `sort_merge_ret` [失敗/しっぱい]の error kind を owner を[動/うご]かさず[読/よ]む
pub fn vec_sort_merge_error_kind <.T> %fn &VecSortMergeError .T StdErrorKind \e:
    *field::get_ref e "error"

//: vec_sort_merge_error_vec: `sort_merge_ret` [失敗/しっぱい]で[戻/もど]された `Vec` owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 merge sort は raw swap / scratch copy を使うため `.T: Ord&Copy` 専用です。error payload から owner を[取/と]り[戻/もど]す面も `.T: Copy` に[揃/そろ]えます。
pub fn vec_sort_merge_error_vec <.T: Copy> %fn VecSortMergeError .T Vec .T \e:
    field::get e "vec"

//: ## sort_merge
//: `Vec .T` を merge sort で破壊的に整列する
//:
//: ### [目的/もくてき]
//: - 安定な O(n log n) sort として `Vec .T` を昇順へ並べ替えます。
//:
//: ### [使用例/しようれい]
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v %Vec i32:
//:         unwrap_ok new
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     match sort_merge &v:
//:         Result::Ok _:
//:             free v
//:             0
//:         Result::Err _:
//:             free v
//:             1
//: ```
//:
//: ### [実装/じっそう]
//: - `Vec` の `data` view と `.T` 配列 1 本分の作業 buffer を使い、buffer owner は `alloc_region .T` / `dealloc_region .T` で閉じます。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(n log n)、追加空間計算量は O(n) です。
pub fn sort_merge <.T: Ord&Copy> %impure fn &Vec .T Result unit StdErrorKind \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            Result::Err StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then Result::Ok unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            Result::Err StdErrorKind::InvalidOperation
                        VecDataView::Data data_ptr:
                            match alloc_region<.T> n:
                                Result::Err _e:
                                    Result::Err StdErrorKind::OutOfMemory
                                Result::Ok buf_region:
                                    let buf %MemPtr .T region_ptr &buf_region
                                    sort_merge_range_data<.T> data_ptr buf 0 n;
                                    match dealloc_region<.T> buf_region:
                                        Result::Ok _:
                                            Result::Ok unit
                                        Result::Err _:
                                            Result::Err StdErrorKind::InvalidOperation

//: ## sort_merge_ret
//: merge sort 後の Vec を Result で返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を `Ok` で返し、後続処理で検証や連結処理をしやすくします。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//: - `Err` の場合も `VecSortMergeError.vec` に入力 `Vec` owner を返します。caller は `vec_sort_merge_error_vec` で[回収/かいしゅう]し、不要なら `free` してください。
//:
//: [計算量/けいさんりょう]:
//: - `sort_merge` と同じです。
pub fn sort_merge_ret <.T: Ord&Copy> %impure fn Vec .T Result Vec .T VecSortMergeError .T \v:
    match vec_current_copy_invariant<.T> &v:
        VecCopyInvariant::Invalid _reason:
            Result::Err VecSortMergeError<.T> v StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let n %i32 len<.T> &v
            if:
                le n 1
                then Result::Ok v
                else:
                    match data_mem_view<.T> &v:
                        VecDataView::Empty:
                            Result::Err VecSortMergeError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            Result::Err VecSortMergeError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Data data_ptr:
                            match alloc_region<.T> n:
                                Result::Err _e:
                                    Result::Err VecSortMergeError<.T> v StdErrorKind::OutOfMemory
                                Result::Ok buf_region:
                                    let buf %MemPtr .T region_ptr &buf_region
                                    sort_merge_range_data<.T> data_ptr buf 0 n;
                                    match dealloc_region<.T> buf_region:
                                        Result::Ok _:
                                            Result::Ok v
                                        Result::Err _:
                                            Result::Err VecSortMergeError<.T> v StdErrorKind::InvalidOperation
