//: merge: stable merge sort facade
//:
//: [目的/もくてき]:
//: - merge sort の public API だけを canonical facade から re-export します。
//: - scratch buffer と range merge の raw `MemPtr` helper は `merge/api` が内部 import し、facade からは公開しません。
//:
//: [注意/ちゅうい]:
//: - stable sort が必要な caller は `sort_merge` または `sort_merge_ret` を使います。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/sort/merge" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok<Vec<i32>, StdErrorKind> new<i32>;
//:     let v1 <Vec<i32>> uwok push v0 2;
//:     let sorted <Vec<i32>> unwrap_ok<Vec<i32>, VecSortMergeError<i32>> sort_merge_ret<i32> v1;
//:     let ok <i32> len<i32> &sorted;
//:     free<i32> sorted;
//:     if eq ok 1 0 1
//: ```

#indent 4

pub #import "./merge/api" as *
