//: quick: quick sort の public `Vec` API
//:
//: [目的/もくてき]:
//: - Lomuto partition による quick sort を `Vec` API として提供します。
//: - raw `MemPtr` range traversal はこの module の `Vec` based wrapper からだけ呼び、direct-import 可能な raw helper module へは出しません。
//:
//: [注意/ちゅうい]:
//: - 平均 O(n log n)、pivot によっては最悪 O(n^2) です。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as *
#import "alloc/collections/vec/sort/common" as *
#import "core/field" as *

//: sort_quick_get_data: quick sort の検査済み range 内で raw data view から Copy 要素を読む
fn sort_quick_get_data <.T: Copy> %fn MemPtr .T fn i32 .T \data_ptr\idx:
    load<.T> add mem_ptr_addr data_ptr mul idx size_of<.T>

//: sort_quick_set_data: quick sort の検査済み range 内で raw data view へ Copy 要素を書く
fn sort_quick_set_data <.T: Copy> %impure fn MemPtr .T impure fn i32 impure fn .T unit \data_ptr\idx\val:
    store<.T> add mem_ptr_addr data_ptr mul idx size_of<.T> val;
    unit

//: sort_quick_swap_data: quick sort の検査済み range 内で 2 要素を入れ替える
fn sort_quick_swap_data <.T: Copy> %impure fn MemPtr .T impure fn i32 impure fn i32 unit \data_ptr\i\j:
    if:
        eq i j
        then unit
        else:
            let a %.T sort_quick_get_data<.T> data_ptr i
            let b %.T sort_quick_get_data<.T> data_ptr j
            sort_quick_set_data<.T> data_ptr i b;
            sort_quick_set_data<.T> data_ptr j a;
            unit

//: sort_quick_partition_data: Lomuto partition で pivot 位置を決める
//:
//: [注意/ちゅうい]:
//: - `lo <= hi` と `[lo, hi]` が初期化済み `.T` cell の範囲内であることは `sort_quick` / `sort_quick_ret` が `Vec.len` から保証します。
fn sort_quick_partition_data <.T: Ord&Copy> %impure fn MemPtr .T impure fn i32 impure fn i32 i32 \data_ptr\lo\hi:
    let pivot %.T sort_quick_get_data<.T> data_ptr hi
    let mut i %i32 lo;
    let mut j %i32 lo;
    while lt j hi:
        do:
            let x %.T sort_quick_get_data<.T> data_ptr j;
            if:
                sort_le<.T> x pivot
                then:
                    sort_quick_swap_data<.T> data_ptr i j;
                    set i add i 1;
                    unit
                else unit
            set j add j 1;
    sort_quick_swap_data<.T> data_ptr i hi;
    i

//: sort_quick_range_data: quick sort public wrapper が作った raw slice 区間を整列する
fn sort_quick_range_data <.T: Ord&Copy> %impure fn MemPtr .T impure fn i32 impure fn i32 unit \data_ptr\lo\hi:
    if:
        lt lo hi
        then:
            let p %i32 sort_quick_partition_data<.T> data_ptr lo hi;
            sort_quick_range_data<.T> data_ptr lo sub p 1;
            let right_lo %i32 add p 1
            sort_quick_range_data<.T> data_ptr right_lo hi;
            unit
        else unit

//: sort_quick: quick sort で `Vec` を in-place 整列する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの既定候補として `Vec` を昇順に並べ替えます。
//:
//: [実装/じっそう]:
//: - `Vec` の `data` と `len` から raw slice 区間を作り、この module 内の range traversal を呼びます。
//:
//: [注意/ちゅうい]:
//: - stable ではありません。
//: - 最悪 O(n^2) と recursion depth の偏りがあるため、入力分布が悪い場合は `sort_heap` や `sort_merge` を検討します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n)、最悪 O(n^2)、追加領域は recursion stack です。
pub fn sort_quick <.T: Ord&Copy> %impure fn &Vec .T unit \v:
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            unit
        VecCopyInvariant::Valid:
            let n %i32 len<.T> v
            if:
                le n 1
                then unit
                else:
                    match data_mem_view<.T> v:
                        VecDataView::Empty:
                            unit
                        VecDataView::Invalid _reason:
                            unit
                        VecDataView::Data data_ptr:
                            sort_quick_range_data<.T> data_ptr 0 sub n 1;
                            unit
//: sort_quick_ret: quick sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - 借用 view で storage を in-place に並べ替えたあと、入力 owner `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
pub fn sort_quick_ret <.T: Ord&Copy> %impure fn Vec .T Vec .T \v:
    match vec_current_copy_invariant<.T> &v:
        VecCopyInvariant::Invalid _reason:
            unit
        VecCopyInvariant::Valid:
            let n %i32 len<.T> &v
            if:
                le n 1
                then unit
                else:
                    match data_mem_view<.T> &v:
                        VecDataView::Empty:
                            unit
                        VecDataView::Invalid _reason:
                            unit
                        VecDataView::Data data_ptr:
                            sort_quick_range_data<.T> data_ptr 0 sub n 1;
                            unit
    v

//: sort: default sort として quick sort を実行する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの一般用途 default として `sort_quick` を呼びます。
//: - 安定性や worst-case bound が必要ない caller に短い API を提供します。
//:
//: [実装/じっそう]:
//: - 現在の default は Lomuto quick sort です。
//:
//: [注意/ちゅうい]:
//: - stable sort が必要なら `sort_merge` を使います。
//: - worst-case O(n log n) を優先するなら `sort_heap` を使います。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
pub fn sort <.T: Ord&Copy> %impure fn &Vec .T unit \v:
    sort_quick<.T> v
