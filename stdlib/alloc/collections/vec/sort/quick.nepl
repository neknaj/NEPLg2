//: quick: quick sort の public `Vec` API
//:
//: [目的/もくてき]:
//: - Lomuto partition による quick sort を `Vec` API として提供します。
//: - raw `MemPtr` range traversal は `sort/raw/quick` に分離し、canonical facade からは公開しません。
//:
//: [注意/ちゅうい]:
//: - 平均 O(n log n)、pivot によっては最悪 O(n^2) です。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/sort/common" as *
#import "alloc/collections/vec/sort/raw/quick" as *
#import "core/field" as *

//: sort_quick: quick sort で `Vec` を in-place 整列する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの既定候補として `Vec` を昇順に並べ替えます。
//:
//: [実装/じっそう]:
//: - `Vec` の `data` と `len` から raw slice 区間を作り、`sort_quick_range_data` を呼びます。
//:
//: [注意/ちゅうい]:
//: - stable ではありません。
//: - 最悪 O(n^2) と recursion depth の偏りがあるため、入力分布が悪い場合は `sort_heap` や `sort_merge` を検討します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n)、最悪 O(n^2)、追加領域は recursion stack です。
pub fn sort_quick <.T: Ord&Copy> <(&Vec<.T>)*>()> (v):
    let n <i32> len<.T> v
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub n 1;
            ()
//: sort_quick_ret: quick sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_quick` を呼んだあと `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
pub fn sort_quick_ret <.T: Ord&Copy> <(Vec<.T>)*>Vec<.T>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let storage <VecStorageState> get v "storage"
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> &v
    let region <RegionToken<.T>> get v "region"
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub n 1;
            ()
    Vec<.T> n cap storage region

//: sort: default sort として quick sort を実行する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの一般用途 default として `sort_quick` を呼びます。
//: - 安定性や worst-case bound が必要ない caller に短い API を提供します。
//:
//: [実装/じっそう]:
//: - 現在の default は Lomuto quick sort です。
//:
//: [注意/ちゅうい]:
//: - stable sort が必要なら `sort_merge` を使います。
//: - worst-case O(n log n) を優先するなら `sort_heap` を使います。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
pub fn sort <.T: Ord&Copy> <(&Vec<.T>)*>()> (v):
    sort_quick<.T> v
