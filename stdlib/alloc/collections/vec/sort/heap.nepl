//: heap: heap sort implementation
//:
//: [目的/もくてき]:
//: - max-heap 構築と sift-down による in-place heap sort を所有します。
//: - 追加領域 O(1) の sort が必要な呼び出し側に提供します。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec/invariant" as vec_invariant
#import "alloc/collections/vec/sort/common" as *
#import "core/field" as *

//: sort_heap_get_data: heap sort の検査済み range 内で raw data view から Copy 要素を読む
fn sort_heap_get_data <.T: Copy> <(MemPtr<.T>,i32)->.T> (data_ptr, idx):
    load<.T> add mem_ptr_addr data_ptr mul idx size_of<.T>

//: sort_heap_set_data: heap sort の検査済み range 内で raw data view へ Copy 要素を書く
fn sort_heap_set_data <.T: Copy> <(MemPtr<.T>,i32,.T)*>()> (data_ptr, idx, val):
    store<.T> add mem_ptr_addr data_ptr mul idx size_of<.T> val;
    ()

//: sort_heap_swap_data: heap sort の検査済み range 内で 2 要素を入れ替える
fn sort_heap_swap_data <.T: Copy> <(MemPtr<.T>,i32,i32)*>()> (data_ptr, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_heap_get_data<.T> data_ptr i
            let b <.T> sort_heap_get_data<.T> data_ptr j
            sort_heap_set_data<.T> data_ptr i b;
            sort_heap_set_data<.T> data_ptr j a;
            ()

//: sort_heap_sift_down_data: max-heap の root を下へ沈める
//:
//: [注意/ちゅうい]:
//: - `start` と `end` は `sort_heap` / `sort_heap_ret` が `Vec.len` から導いた heap range です。
fn sort_heap_sift_down_data <.T: Ord&Copy> <(MemPtr<.T>,i32,i32)*>()> (data_ptr, start, end):
    let mut root <i32> start;
    let mut done <i32> 0;
    while eq done 0:
        do:
            let child <i32> add mul root 2 1;
            if:
                ge child end
                then set done 1
                else:
                    let mut swap_idx <i32> root;
                    let swap_v <.T> sort_heap_get_data<.T> data_ptr swap_idx;
                    let child_v <.T> sort_heap_get_data<.T> data_ptr child;
                    if:
                        sort_lt<.T> swap_v child_v
                        then set swap_idx child
                        else ()
                    let right <i32> add child 1;
                    if:
                        lt right end
                        then:
                            let swap_v2 <.T> sort_heap_get_data<.T> data_ptr swap_idx;
                            let right_v <.T> sort_heap_get_data<.T> data_ptr right;
                            if:
                                sort_lt<.T> swap_v2 right_v
                                then set swap_idx right
                                else ()
                        else ()
                    if:
                        eq swap_idx root
                        then set done 1
                        else:
                            sort_heap_swap_data<.T> data_ptr root swap_idx;
                            set root swap_idx;
                            ()

//: sort_heap: heap sort で `Vec` を in-place 整列する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしで O(n log n) の最悪計算量を持つ昇順 sort を提供します。
//:
//: [実装/じっそう]:
//: - まず max-heap を構築し、最大値を末尾へ交換して heap 範囲を縮めます。
//:
//: [注意/ちゅうい]:
//: - stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(n log n)、追加領域 O(1)
pub fn sort_heap <.T: Ord&Copy> <(&Vec<.T>)*>()> (v):
    if:
        not vec_invariant::vec_current_copy_invariant<.T> v
        then ()
        else:
            let n <i32> len<.T> v
            let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
            if:
                le n 1
                then ()
                else:
                    let n_minus_two <i32> sub n 2;
                    let mut start <i32> div_s n_minus_two 2;
                    let mut done0 <i32> 0;
                    while eq done0 0:
                        do:
                            if:
                                lt start 0
                                then set done0 1
                                else:
                                    sort_heap_sift_down_data<.T> data_ptr start n;
                                    set start sub start 1;
                                    ();
                    let mut end <i32> sub n 1;
                    while lt 0 end:
                        do:
                            sort_heap_swap_data<.T> data_ptr 0 end;
                            sort_heap_sift_down_data<.T> data_ptr 0 end;
                            set end sub end 1;
                    ()

//: sort_heap_ret: heap sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - 借用 view で storage を in-place に並べ替えたあと、入力 owner `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_heap` と同じです。
pub fn sort_heap_ret <.T: Ord&Copy> <(Vec<.T>)*>Vec<.T>> (v):
    if:
        not vec_invariant::vec_current_copy_invariant<.T> &v
        then ()
        else:
            let n <i32> len<.T> &v
            let data_ptr <MemPtr<.T>> data_mem_ptr<.T> &v
            if:
                le n 1
                then ()
                else:
                    let n_minus_two <i32> sub n 2;
                    let mut start <i32> div_s n_minus_two 2;
                    while ge start 0:
                        do:
                            sort_heap_sift_down_data<.T> data_ptr start n;
                            set start sub start 1;

                    let mut end <i32> sub n 1;
                    while gt end 0:
                        do:
                            sort_heap_swap_data<.T> data_ptr 0 end;
                            sort_heap_sift_down_data<.T> data_ptr 0 end;
                            set end sub end 1;
                    ()
    v
