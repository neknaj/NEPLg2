//: # vec/transform/filter/select
//: `Vec.filter` の単一出力 transform
//:
//: ### [目的/もくてき]
//: - `xs |> filter p` の[形/かたち]で、[条件/じょうけん] `p` を[満/み]たす[要素/ようそ]だけを[残/のこ]した[新/あたら]しい `Vec .T` を[返/かえ]します。
//: - `partition` の 2 出力 owner 操作とは分け、単一出力に必要な raw storage boundary だけをこの module に置きます。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で[残/のこ]す[要素数/ようそすう]を[数/かぞ]え、2 [回目/かいめ]の loop で exact capacity の[出力/しゅつりょく]バッファへ[詰/つ]めます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result (Vec .T) (VecTransformError .T)` を[返/かえ]します。
//: - [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]も入力 `Vec .T` は `VecTransformError` に[戻/もど]ります。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn unit i32 \unit:
//:     let ys %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let zs %Vec i32 unwrap_ok filter ys is_even;
//:     let observed_len %i32 len &zs
//:     let ok %bool eq observed_len 2
//:     free zs;
//:     if ok 0 1
//: ```

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/mem/allocator" as allocator
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "core/traits/drop" as *
#import "../../types" as *
#import "../../storage" as vec_storage
#import "../../mutation/cleanup" as vec_cleanup
#import "../../query/get" as vec_get
#import "../../access/data" as *
#import "../../invariant" as *

//: ## vec_filter_borrow_slot_predicate
//: filter の raw drain loop 内で source slot を predicate にだけ借用する private helper
//:
//: ### [目的/もくてき]
//: - non-Copy payload を値渡し predicate に渡さず、`&T` の scoped borrow として観測します。
//: - `collection_slot_borrow_ref` を public API に出さず、filter implementation 内の source evidence として閉じます。
fn vec_filter_borrow_slot_predicate <.T> %fn &RegionToken .T fn i32 fn fn &.T bool bool \storage\byte_off\predicate:
    let slot_ref %&.T:
        #intrinsic "collection_slot_borrow_ref" <.T> (storage, byte_off)
    predicate slot_ref

//: ## vec_filter_drain_to_output
//: source range を borrowed predicate で[選別/せんべつ]し、selected prefix を output storage へ[構築/こうちく]する
//:
//: ### [目的/もくてき]
//: - public `filter` から raw load / store / discard drop / transform marker / source storage release を[分離/ぶんり]し、この private helper に Resource IR certificate boundary を[閉/と]じます。
//: - `source` の initialized prefix は selected branch で output へ[移動/いどう]され、discard branch で `Drop::drop` により[閉/と]じられます。
//:
//: ### [返/かえ]り[値/ち]
//: - source storage は release 済みにし、output storage だけを owner とする `Vec` を[返/かえ]します。
fn vec_filter_drain_to_output <.T: Drop> %impure fn RegionToken .T impure fn RegionToken .T impure fn i32 impure fn i32 impure fn fn &.T bool Vec .T \source\output\src_initialized_len\out_cap\predicate:
    let source_data %MemPtr .T region_ptr &source
    let out_data %MemPtr .T region_ptr &output
    let mut read_i %i32 0
    let mut write_i %i32 0
    while lt read_i src_initialized_len:
        do:
            let source_byte_off %i32 mul read_i size_of %.T
            let keep %bool vec_filter_borrow_slot_predicate<.T> &source source_byte_off predicate
            let source_slot %MemPtr .T mem_ptr_add<.T> source_data source_byte_off
            let source_raw %i32 mem_ptr_addr source_slot
            let loaded %.T load<.T> source_raw
            if:
                keep
                then:
                    let out_byte_off %i32 mul write_i size_of %.T
                    let out_slot %MemPtr .T mem_ptr_add<.T> out_data out_byte_off
                    let out_raw %i32 mem_ptr_addr out_slot
                    store<.T> out_raw loaded
                    set write_i add write_i 1
                else:
                    Drop::drop &loaded
            set read_i add read_i 1
    #intrinsic "collection_slot_transform_range" <.T> (&source, src_initialized_len, &output, write_i)
    vec_filter_release_storage<.T> source
    Vec<.T> (OwnedBuffer<.T> write_i write_i out_cap (VecStorage<.T>::Owned output))

//: ## vec_filter_release_storage
//: transform 済み input storage の raw release proof を発行する private helper
//:
//: ### [目的/もくてき]
//: - `collection_slot_transform_range` により source initialized range を moved-out / dropped 済みにした後、backing storage owner を閉じます。
//: - storage release を `free` に見せかけず、transform 専用の source drain 境界として raw dealloc と marker を並べます。
fn vec_filter_release_storage <.T> %impure fn RegionToken .T unit \region:
    let raw %i32 field::get region "raw"
    let total_size %i32 field::get region "size"
    allocator::dealloc_raw raw total_size
    #intrinsic "collection_slot_storage_dealloc" <.T> (&region)

pub fn filter <.T: Copy> %fn Vec .T fn fn .T bool Result Vec .T VecTransformError .T \v\p:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let src_len %i32 *field::get_ref v_buffer_ref "len"
    match vec_buffer_current_copy_invariant<.T> v_buffer_ref:
        VecCopyInvariant::Invalid _reason:
            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let mut keep_len %i32 0
            let mut i %i32 0
            while lt i src_len:
                do:
                    match vec_get::get<.T> &v i:
                        Option::Some item:
                            if cond p item:
                                then set keep_len add keep_len 1
                                else unit
                        Option::None:
                            unit
                    set i add i 1
            match vec_storage::with_capacity<.T> keep_len:
                Result::Err e:
                    Result::Err VecTransformError<.T> v e
                Result::Ok out0:
                    let out_buffer_ref %&OwnedBuffer .T field::get_ref &out0 "buffer"
                    let out_cap %i32 *field::get_ref out_buffer_ref "cap"
                    match data_mem_view<.T> &out0:
                        VecDataView::Empty:
                            if:
                                eq keep_len 0
                                then:
                                    vec_cleanup::free<.T> v
                                    let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                                    let out_storage %VecStorage .T field::get out_buffer "storage"
                                    Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)
                                else:
                                    vec_cleanup::free<.T> out0
                                    Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            vec_cleanup::free<.T> out0
                            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Data out_data:
                            let mut read_i %i32 0
                            let mut write_i %i32 0
                            while lt read_i src_len:
                                do:
                                    match vec_get::get<.T> &v read_i:
                                        Option::Some item:
                                            if:
                                                cond p item
                                                then:
                                                    store<.T> add mem_ptr_addr out_data mul write_i size_of %.T item
                                                    set write_i add write_i 1
                                                else unit
                                        Option::None:
                                            unit
                                    set read_i add read_i 1
                            vec_cleanup::free<.T> v
                            let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                            let out_storage %VecStorage .T field::get out_buffer "storage"
                            Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)

//: ## filter
//: Drop payload を borrowed predicate で選別し、選ばれた owner だけを新しい Vec へ移す
//:
//: ### [目的/もくてき]
//: - `.T: Drop` の要素を shallow copy せず、source slot から raw load した owner を selected branch では output storage へ移し、discard branch では `Drop::drop` で閉じます。
//: - predicate は `(&T)->bool` とし、観測のために payload owner を消費しません。
//:
//: ### [実装/じっそう]
//: - output capacity は input length と同じにし、`write_i` prefix だけを initialized range として返します。
//: - loop 直後に `collection_slot_transform_range` marker を置き、source range move-out、output prefix initialization、discard drop proof を Resource IR summary に渡します。
//:
//: ### [注意/ちゅうい]
//: - これは non-Copy transform engine の最初の単一出力接続です。`map` と `partition` は別 issue で扱います。
pub fn filter <.T: Drop> %impure fn Vec .T impure fn fn &.T bool Result Vec .T VecTransformError .T \v\p:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let src_len %i32 *field::get_ref v_buffer_ref "len"
    let src_initialized_len %i32 *field::get_ref v_buffer_ref "initialized_len"
    let src_cap %i32 *field::get_ref v_buffer_ref "cap"
    match vec_buffer_current_storage_invariant<.T> v_buffer_ref:
        VecStorageInvariant::Invalid _reason:
            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
        VecStorageInvariant::Valid:
            let v_buffer %OwnedBuffer .T field::get v "buffer"
            let v_storage %VecStorage .T field::get v_buffer "storage"
            match v_storage:
                VecStorage::Empty:
                    Result::Ok Vec<.T> (OwnedBuffer<.T> 0 0 0 VecStorage<.T>::Empty)
                VecStorage::Owned v_region:
                    match vec_storage::with_capacity<.T> src_len:
                        Result::Err e:
                            Result::Err VecTransformError<.T> (Vec<.T> (OwnedBuffer<.T> src_len src_initialized_len src_cap (VecStorage<.T>::Owned v_region))) e
                        Result::Ok out0:
                            let out_buffer_ref %&OwnedBuffer .T field::get_ref &out0 "buffer"
                            let out_cap %i32 *field::get_ref out_buffer_ref "cap"
                            let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                            let out_storage %VecStorage .T field::get out_buffer "storage"
                            match out_storage:
                                VecStorage::Empty:
                                    if:
                                        eq src_len 0
                                        then:
                                            Result::Ok Vec<.T> (OwnedBuffer<.T> 0 0 src_cap (VecStorage<.T>::Owned v_region))
                                        else:
                                            Result::Err VecTransformError<.T> (Vec<.T> (OwnedBuffer<.T> src_len src_initialized_len src_cap (VecStorage<.T>::Owned v_region))) StdErrorKind::InvalidOperation
                                VecStorage::Owned out_region:
                                    let out_vec %Vec .T vec_filter_drain_to_output<.T> v_region out_region src_initialized_len out_cap p
                                    Result::Ok out_vec
