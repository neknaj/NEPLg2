//: # vec/transform/filter/partition/view
//: `VecPartition` observer / cleanup
//:
//: ### [目的/もくてき]
//: - `VecPartition` の `matched` / `rest` を直接 field projection させず、長さ・要素観測・解放を owner-safe API として提供します。
//: - `partition` の raw storage construction から切り離し、observer と cleanup に raw memory boundary capability を持たせません。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../../../types" as *
#import "../../../mutation/cleanup" as vec_cleanup
#import "../../../query/get" as vec_get

//: ## vec_partition_matched_len
//: `partition` の true 側 `Vec` の[長/なが]さを[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `VecPartition` owner を[移動/いどう]せず、`matched` 側の[要素数/ようそすう]だけを[観測/かんそく]します。
//: - owner aggregate field を caller が直接 projection しないための public observer です。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts %VecPartition i32 unwrap_ok partition xs is_even;
//:     let ok %bool eq vec_partition_matched_len &parts 1;
//:     vec_partition_free parts;
//:     if ok 0 1
//: ```
pub fn vec_partition_matched_len <.T> %fn &VecPartition .T i32 \parts:
    let matched %&Vec .T field::get_ref parts "matched"
    let matched_buffer %&OwnedBuffer .T field::get_ref matched "buffer"
    *field::get_ref matched_buffer "len"

//: ## vec_partition_rest_len
//: `partition` の false 側 `Vec` の[長/なが]さを[返/かえ]す
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts %VecPartition i32 unwrap_ok partition xs is_even;
//:     let ok %bool eq vec_partition_rest_len &parts 1;
//:     vec_partition_free parts;
//:     if ok 0 1
//: ```
pub fn vec_partition_rest_len <.T> %fn &VecPartition .T i32 \parts:
    let rest %&Vec .T field::get_ref parts "rest"
    let rest_buffer %&OwnedBuffer .T field::get_ref rest "buffer"
    *field::get_ref rest_buffer "len"

//: ## vec_partition_matched_get
//: `partition` の true 側から index の[要素/ようそ]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `matched` 側の `Vec` を[借用/しゃくよう]し、`Vec.get` と同じ境界規則で `Option .T` を[返/かえ]します。
//: - `.T: Copy` に[限定/げんてい]し、要素 owner の move-out をこの API では[扱/あつか]いません。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts %VecPartition i32 unwrap_ok partition xs is_even;
//:     let item %Option i32 vec_partition_matched_get &parts 0;
//:     vec_partition_free parts;
//:     match item:
//:         Option::Some x:
//:             if eq x 2 0 1
//:         Option::None:
//:             1
//: ```
pub fn vec_partition_matched_get <.T: Copy> %fn &VecPartition .T fn i32 Option .T \parts\idx:
    let matched %&Vec .T field::get_ref parts "matched"
    vec_get::get<.T> matched idx

//: ## vec_partition_rest_get
//: `partition` の false 側から index の[要素/ようそ]を[読/よ]む
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts %VecPartition i32 unwrap_ok partition xs is_even;
//:     let item %Option i32 vec_partition_rest_get &parts 0;
//:     vec_partition_free parts;
//:     match item:
//:         Option::Some x:
//:             if eq x 1 0 1
//:         Option::None:
//:             1
//: ```
pub fn vec_partition_rest_get <.T: Copy> %fn &VecPartition .T fn i32 Option .T \parts\idx:
    let rest %&Vec .T field::get_ref parts "rest"
    vec_get::get<.T> rest idx

//: ## vec_partition_from_parts
//: 2 本の `Vec` owner を `VecPartition` に[束/たば]ねる
//:
//: ### [目的/もくてき]
//: - caller が `VecPartition .T` の direct constructor を[使/つか]わなくても、2 本の `Vec .T` owner を 1 つの named result にまとめられるようにします。
//: - `matched` / `rest` の owner obligation はそのまま `VecPartition .T` に[移/うつ]るため、payload の copy、drop、storage release は行いません。
//: - `vec_partition_with`（`.T`, `.R`）と対になる safe constructor boundary です。field を直接[触/さわ]らず、constructor と eliminator の型で owner flow を表します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/storage/view" as *
//:| #import "alloc/collections/vec/mutation/cleanup" as *
//:| #import "alloc/collections/vec/access/header" as *
//:| #import "alloc/collections/vec/transform/filter/partition/view" as *
//:| #import "core/math" as *
//: fn finish_partition %impure fn Vec i32 impure fn Vec i32 i32 \matched\rest:
//:     let ok %bool and (eq len &matched 0) (eq len &rest 0)
//:     free matched
//:     free rest
//:     if ok 0 1
//: fn main %impure fn void i32 \void:
//:     let matched %Vec i32 vec_empty
//:     let rest %Vec i32 vec_empty
//:     let parts %VecPartition i32 vec_partition_from_parts matched rest
//:     vec_partition_with parts @finish_partition
//: ```
pub fn vec_partition_from_parts <.T> %fn Vec .T fn Vec .T VecPartition .T \matched\rest:
    VecPartition<.T> matched rest

//: ## vec_partition_with
//: `VecPartition` の `matched` owner と `rest` owner を同じ callback に[渡/わた]す
//:
//: ### [目的/もくてき]
//: - `VecPartition .T` は 2 本の `Vec .T` owner を[持/も]つ owner-backed aggregate です。
//: - non-Copy payload の partition を追加するとき、caller が片方の field だけを[取/と]り[出/だ]す設計にはせず、この eliminator で両 owner を同じ control-flow へ[渡/わた]します。
//: - cleanup、再結合、診断変換など、2 本の owner obligation を API 型から[消/け]さずに[実装/じっそう]できます。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn finish_partition %impure fn Vec i32 impure fn Vec i32 i32 \matched\rest:
//:     let ok %bool and (eq len<i32> &matched 0) (eq len<i32> &rest 0)
//:     free<i32> matched
//:     free<i32> rest
//:     if ok 0 1
//: fn main %impure fn void i32 \void:
//:     let matched %Vec i32 vec_empty<i32>
//:     let rest %Vec i32 vec_empty<i32>
//:     // caller は `VecPartition` を直接構築せず、`partition` が返した値をこの eliminator に渡します。
//:     let parts %VecPartition i32 VecPartition<i32> matched rest
//:     vec_partition_with<i32,i32> parts @finish_partition
//: ```
pub fn vec_partition_with <.T,.R> %impure fn VecPartition .T impure fn impure fn Vec .T impure fn Vec .T .R .R \parts\callback:
    let matched %Vec .T field::get parts "matched"
    let rest %Vec .T field::get parts "rest"
    callback matched rest

//: ## vec_partition_free
//: `VecPartition` が[保持/ほじ]する 2 本の `Vec` owner を[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `matched` と `rest` の両方の owner を実装境界内で[取/と]り[出/だ]し、解放漏れを避けます。
//: - caller は owner aggregate field を直接 projection せず、`VecPartition` 全体をこの関数へ[渡/わた]します。
//: - `.T: Copy` の便宜 API として残します。non-Copy payload では `vec_partition_with`（`.T`, `.R`）を使い、callback 内で両 `Vec .T` owner を回収します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts %VecPartition i32 unwrap_ok partition xs is_even;
//:     vec_partition_free parts;
//:     0
//: ```
//:
//: ### [注意/ちゅうい]
//: - matched/rest の 2 つの `Vec` owner を解放するため、`impure fn` です。
pub fn vec_partition_free <.T: Copy> %impure fn VecPartition .T unit \parts:
    let matched %Vec .T field::get parts "matched"
    let rest %Vec .T field::get parts "rest"
    vec_cleanup::free<.T> matched
    vec_cleanup::free<.T> rest
