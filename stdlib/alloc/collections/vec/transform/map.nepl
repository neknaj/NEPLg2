//: # vec/transform/map
//: `Vec` の map transform
//:
//: ### [目的/もくてき]
//: - `map` を transform facade から[分離/ぶんり]し、element type 変換の owner-consuming 処理をこの module に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - 入力要素は `get`（`.T: Copy`）を[通/とお]して読み、raw load の結果を callback に直接[渡/わた]しません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../storage" as vec_storage
#import "../mutation/cleanup" as vec_cleanup
#import "../query/get" as vec_get
#import "../access/data" as *
#import "../invariant" as *
#import "core/field" as *

//: map: [各要素/かくようそ]を[同/おな]じ[規則/きそく]で[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `xs |> map f` の[形/かたち]で、`Vec .T` の[全要素/ぜんようそ]へ[同/おな]じ[純粋/じゅんすい][関数/かんすう]を[適用/てきよう]します。
//: - [元/もと]の[順序/じゅんじょ]を[保/たも]ったまま、[新/あたら]しい `Vec .U` を[作成/さくせい]します。
//:
//: ### [実装/じっそう]
//: - [入力/にゅうりょく]の `len` と[同/おな]じ[容量/ようりょう]を[先/さき]に[確保/かくほ]し、raw loop で[順番/じゅんばん]に[書/か]き[込/こ]みます。
//: - [出力/しゅつりょく] `Vec` の `len` は[最後/さいご]に[確定/かくてい]させ、[途中/とちゅう]で[再確保/さいかくほ]を[発生/はっせい]させません。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result (Vec .U) (VecTransformError .T)` を[返/かえ]します。
//: - [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]も入力 `Vec .T` は `VecTransformError` に[戻/もど]ります。
//: - `f` は `(.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//: - 入力 owner の cleanup と output storage [構築/こうちく]を行うため、`map` 自体は `impure fn` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: fn inc %fn i32 i32 \x:
//:     add x 1
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ys %Vec i32 unwrap_ok map xs inc;
//:     match get &ys 2:
//:         Option::Some x:
//:             free ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free ys;
//:             1
//: ```
pub fn map <.T: Copy,.U: Copy> %impure fn Vec .T impure fn fn .T .U Result Vec .U VecTransformError .T \v\f:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let src_len %i32 *field::get_ref v_buffer_ref "len"
    match vec_buffer_current_copy_invariant<.T> v_buffer_ref:
        VecCopyInvariant::Invalid _reason:
            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            match vec_storage::with_capacity<.U> src_len:
                Result::Err e:
                    Result::Err VecTransformError<.T> v e
                Result::Ok out0:
                    let out_buffer_ref %&OwnedBuffer .U field::get_ref &out0 "buffer"
                    let out_cap %i32 *field::get_ref out_buffer_ref "cap"
                    match data_mem_view<.U> &out0:
                        VecDataView::Empty:
                            if:
                                eq src_len 0
                                then:
                                    vec_cleanup::free<.T> v
                                    let out_buffer %OwnedBuffer .U field::get out0 "buffer"
                                    let out_storage %VecStorage .U field::get out_buffer "storage"
                                    Result::Ok Vec<.U> (OwnedBuffer<.U> src_len src_len out_cap out_storage)
                                else:
                                    vec_cleanup::free<.U> out0
                                    Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            vec_cleanup::free<.U> out0
                            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Data out_data:
                            let mut i %i32 0
                            while lt i src_len:
                                do:
                                    match vec_get::get<.T> &v i:
                                        Option::Some item:
                                            let mapped %.U f item
                                            store<.U> add mem_ptr_addr out_data mul i size_of %.U mapped
                                        Option::None:
                                            unit
                                    set i add i 1
                            vec_cleanup::free<.T> v
                            let out_buffer %OwnedBuffer .U field::get out0 "buffer"
                            let out_storage %VecStorage .U field::get out_buffer "storage"
                            Result::Ok Vec<.U> (OwnedBuffer<.U> src_len src_len out_cap out_storage)
