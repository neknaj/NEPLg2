//: # vec/transform/prefix
//: `Vec` の prefix based transform
//:
//: ### [目的/もくてき]
//: - `take_while` / `drop_while` を transform facade から[分離/ぶんり]し、prefix 境界を[扱/あつか]う owner-consuming 処理をこの module に[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - 入力要素は `get`（`.T: Copy`）を[通/とお]して読み、raw load の結果を callback や出力 storage に直接[渡/わた]しません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../storage" as vec_storage
#import "../mutation/cleanup" as vec_cleanup
#import "../query/get" as vec_get
#import "../access/data" as *
#import "../invariant" as *
#import "core/field" as *

//: vec_take_while_len: borrowed Vec から prefix 境界を[求/もと]める[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - `take_while` / `drop_while` が[共有/きょうゆう]する境界探索を、raw pointer ではなく `get`（`.T: Copy`）経由で[行/おこな]います。
//:
//: ### [実装/じっそう]
//: - `p` が true の間だけ index を[進/すす]め、最初の false または `len` に[到達/とうたつ]した位置を[返/かえ]します。
fn vec_take_while_len <.T: Copy> %fn &Vec .T fn i32 fn fn .T bool i32 \v\len0\p:
    let mut i %i32 0
    let mut active %bool true
    while and active lt i len0:
        do:
            match vec_get::get<.T> v i:
                Option::Some item:
                    if:
                        cond p item
                        then:
                            set i add i 1
                        else:
                            set active false
                Option::None:
                    set active false
    i

//: vec_copy_range_to_raw: borrowed Vec の Copy 要素を出力 raw buffer に[書/か]く[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - prefix / suffix copy を `get`（`.T: Copy`）と private raw write の組み合わせに[限定/げんてい]し、raw load の結果を owner-producing API へ直接[渡/わた]さないようにします。
fn vec_copy_range_to_raw <.T: Copy> %fn &Vec .T fn MemPtr .T fn i32 fn i32 unit \src\out_data\src_from\count:
    let mut i %i32 0
    while lt i count:
        do:
            match vec_get::get<.T> src add src_from i:
                Option::Some item:
                    store<.T> add mem_ptr_addr out_data mul i size_of %.T item
                Option::None:
                    unit
            set i add i 1

//: take_while: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]だけを[取/と]る
//:
//: ### [目的/もくてき]
//: - `xs |> take_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]だけを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [最初/さいしょ]に[打/う]ち[切/き]り[位置/いち]を[求/もと]め、その prefix [長/ちょう]だけ exact capacity を[確保/かくほ]して[順番/じゅんばん]に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - `filter` と[違/ちが]い、[途中/とちゅう]で `p` が false になったら[残/のこ]りは[見/み]ません。
//: - [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]も入力 `Vec .T` は `VecTransformError` に[戻/もど]ります。
//: - 入力 owner の cleanup と output storage [構築/こうちく]を行うため、`take_while` 自体は `impure fn` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(k) ただし k は[最初/さいしょ]に false になるまでの[走査/そうさ]と[複写/ふくしゃ]を[含/ふく]む
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn lt_three %fn i32 bool \x:
//:     lt x 3
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys %Vec i32 unwrap_ok take_while xs lt_three;
//:     let observed_len %i32 len &ys
//:     let ok %bool eq observed_len 2
//:     free ys;
//:     if ok 0 1
//: ```
pub fn take_while <.T: Copy> %impure fn Vec .T impure fn fn .T bool Result Vec .T VecTransformError .T \v\p:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let src_len %i32 *field::get_ref v_buffer_ref "len"
    match vec_buffer_current_copy_invariant<.T> v_buffer_ref:
        VecCopyInvariant::Invalid _reason:
            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let keep_len %i32 vec_take_while_len<.T> &v src_len p
            match vec_storage::with_capacity<.T> keep_len:
                Result::Err e:
                    Result::Err VecTransformError<.T> v e
                Result::Ok out0:
                    let out_buffer_ref %&OwnedBuffer .T field::get_ref &out0 "buffer"
                    let out_cap %i32 *field::get_ref out_buffer_ref "cap"
                    match data_mem_view<.T> &out0:
                        VecDataView::Empty:
                            if:
                                eq keep_len 0
                                then:
                                    vec_cleanup::free<.T> v
                                    let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                                    let out_storage %VecStorage .T field::get out_buffer "storage"
                                    Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)
                                else:
                                    vec_cleanup::free<.T> out0
                                    Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            vec_cleanup::free<.T> out0
                            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Data out_data:
                            vec_copy_range_to_raw<.T> &v out_data 0 keep_len
                            vec_cleanup::free<.T> v
                            let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                            let out_storage %VecStorage .T field::get out_buffer "storage"
                            Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)

//: drop_while: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]を[捨/す]てる
//:
//: ### [目的/もくてき]
//: - `xs |> drop_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]を[飛/と]ばし、その[残/のこ]りを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `take_while` と[同/おな]じ helper で[打/う]ち[切/き]り[位置/いち]を[求/もと]め、そこから[末尾/まつび]までを exact capacity の[新規/しんき] `Vec` に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - [全要素/ぜんようそ]が `p` を[満/み]たす[場合/ばあい]は[空/から] `Vec` を[返/かえ]します。
//: - [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]も入力 `Vec .T` は `VecTransformError` に[戻/もど]ります。
//: - 入力 owner の cleanup と output storage [構築/こうちく]を行うため、`drop_while` 自体は `impure fn` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: fn lt_three %fn i32 bool \x:
//:     lt x 3
//: fn main %impure fn void i32 \void:
//:     let xs %Vec i32:
//:         unwrap_ok new
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys %Vec i32 unwrap_ok drop_while xs lt_three;
//:     match get &ys 0:
//:         Option::Some x:
//:             free ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free ys;
//:             1
//: ```
pub fn drop_while <.T: Copy> %impure fn Vec .T impure fn fn .T bool Result Vec .T VecTransformError .T \v\p:
    let v_buffer_ref %&OwnedBuffer .T field::get_ref &v "buffer"
    let src_len %i32 *field::get_ref v_buffer_ref "len"
    match vec_buffer_current_copy_invariant<.T> v_buffer_ref:
        VecCopyInvariant::Invalid _reason:
            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
        VecCopyInvariant::Valid:
            let drop_len %i32 vec_take_while_len<.T> &v src_len p
            let keep_len %i32 sub src_len drop_len
            match vec_storage::with_capacity<.T> keep_len:
                Result::Err e:
                    Result::Err VecTransformError<.T> v e
                Result::Ok out0:
                    let out_buffer_ref %&OwnedBuffer .T field::get_ref &out0 "buffer"
                    let out_cap %i32 *field::get_ref out_buffer_ref "cap"
                    match data_mem_view<.T> &out0:
                        VecDataView::Empty:
                            if:
                                eq keep_len 0
                                then:
                                    vec_cleanup::free<.T> v
                                    let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                                    let out_storage %VecStorage .T field::get out_buffer "storage"
                                    Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)
                                else:
                                    vec_cleanup::free<.T> out0
                                    Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Invalid _reason:
                            vec_cleanup::free<.T> out0
                            Result::Err VecTransformError<.T> v StdErrorKind::InvalidOperation
                        VecDataView::Data out_data:
                            vec_copy_range_to_raw<.T> &v out_data drop_len keep_len
                            vec_cleanup::free<.T> v
                            let out_buffer %OwnedBuffer .T field::get out0 "buffer"
                            let out_storage %VecStorage .T field::get out_buffer "storage"
                            Result::Ok Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)
