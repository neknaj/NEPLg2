//: # vec/transform/filter
//: predicate based transform facade
//:
//: ### [目的/もくてき]
//: - `filter` と `partition` の public API をまとめて re-export する facade です。
//: - 単一出力の `filter` と 2 出力 owner を扱う `partition` を別 implementation module に分け、raw storage boundary を狭く保ちます。
//:
//: ### [注意/ちゅうい]
//: - この file は public import path を維持するための facade です。実装本体と raw memory operation は submodule に置きます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ys <Vec<i32>> unwrap_ok filter<i32> xs is_even;
//:     let observed_len <i32> len<i32> &ys;
//:     let ok <bool> eq observed_len 1;
//:     free<i32> ys;
//:     if ok 0 1
//: ```

#indent 4

pub #import "./filter/select" as @merge
pub #import "./filter/partition" as @merge
