//: # vec/transform/filter
//: `Vec` の predicate based transform
//:
//: ### [目的/もくてき]
//: - `filter` / `partition` を transform facade から[分離/ぶんり]し、predicate で[要素/ようそ]を[選別/せんべつ]する owner-consuming 処理をこの module に[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - 入力要素は `get<T: Copy>` を[通/とお]して読み、raw load の結果を callback や出力 storage に直接[渡/わた]しません。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../storage" as vec_storage
#import "../mutation/cleanup" as vec_cleanup
#import "../query/get" as vec_get
#import "../access/data" as vec_data
#import "../invariant" as vec_invariant

//: filter: [条件/じょうけん]を[満/み]たす[要素/ようそ]だけを[残/のこ]す
//:
//: ### [目的/もくてき]
//: - `xs |> filter p` の[形/かたち]で、[条件/じょうけん] `p` を[満/み]たす[要素/ようそ]だけを[残/のこ]した[新/あたら]しい `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で[残/のこ]す[要素数/ようそすう]を[数/かぞ]え、2 [回目/かいめ]の loop で exact capacity の[出力/しゅつりょく]バッファへ[詰/つ]めます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result<Vec<.T>, VecTransformError<.T>>` を[返/かえ]します。
//: - [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]も入力 `Vec<.T>` は `VecTransformError` に[戻/もど]ります。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let ys <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let zs <Vec<i32>> unwrap_ok filter<i32> ys is_even;
//:     let ok <bool> eq len<i32> &zs 2
//:     free<i32> zs;
//:     if ok 0 1
//: ```
pub fn filter <.T: Copy> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, VecTransformError<.T>>> (v, p):
    let v_buffer_ref <&OwnedBuffer<.T>> field::get_ref &v "buffer"
    let src_len <i32> *field::get_ref v_buffer_ref "len"
    if:
        not vec_invariant::vec_buffer_current_copy_invariant<.T> v_buffer_ref
        then:
            Result::Err<Vec<.T>, VecTransformError<.T>> VecTransformError<.T> v StdErrorKind::InvalidOperation
        else:
            let mut keep_len <i32> 0
            let mut i <i32> 0
            while lt i src_len:
                do:
                    match vec_get::get<.T> &v i:
                        Option::Some item:
                            if cond p item:
                                then set keep_len add keep_len 1
                                else ()
                        Option::None:
                            ()
                    set i add i 1
            match vec_storage::with_capacity<.T> keep_len:
                Result::Err e:
                    Result::Err<Vec<.T>, VecTransformError<.T>> VecTransformError<.T> v e
                Result::Ok out0:
                    let out_buffer_ref <&OwnedBuffer<.T>> field::get_ref &out0 "buffer"
                    let out_cap <i32> *field::get_ref out_buffer_ref "cap"
                    let out_data <MemPtr<.T>> vec_data::data_mem_ptr<.T> &out0
                    let mut read_i <i32> 0
                    let mut write_i <i32> 0
                    while lt read_i src_len:
                        do:
                            match vec_get::get<.T> &v read_i:
                                Option::Some item:
                                    if:
                                        cond p item
                                        then:
                                            store<.T> add mem_ptr_addr out_data mul write_i size_of<.T> item
                                            set write_i add write_i 1
                                        else ()
                                Option::None:
                                    ()
                            set read_i add read_i 1
                    vec_cleanup::free<.T> v
                    let out_buffer <OwnedBuffer<.T>> field::get out0 "buffer"
                    let out_storage <VecStorage<.T>> field::get out_buffer "storage"
                    Result::Ok<Vec<.T>, VecTransformError<.T>> Vec<.T> (OwnedBuffer<.T> keep_len keep_len out_cap out_storage)

//: partition: [条件/じょうけん]で 2 [群/ぐん]に[分/わ]ける
//:
//: ### [目的/もくてき]
//: - `xs |> partition p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]と、[満/み]たさない[要素/ようそ]へ[分割/ぶんかつ]します。
//: - [返/かえ]り[値/あたい]は `VecPartition` です。`matched` と `rest` は `vec_partition_*` API で[観測/かんそく]し、最後に `vec_partition_free` で[解放/かいほう]してください。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で `matched` の[要素数/ようそすう]だけを[数/かぞ]え、2 [回目/かいめ]で exact capacity の 2 [本/ほん]の `Vec` へ[振/ふ]り[分/わ]けます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[両方/りょうほう]の[出力/しゅつりょく]で[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - 2 [本/ほん]の[新規/しんき] `Vec` を[確保/かくほ]するので `Result<VecPartition<.T>, VecTransformError<.T>>` を[返/かえ]します。
//: - [途中/とちゅう]で[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]、入力 `Vec<.T>` owner は error payload に[戻/もど]ります。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let parts unwrap_ok partition<i32> xs is_even;
//:     let ok <bool> eq vec_partition_matched_len<i32> &parts 1
//:     vec_partition_free<i32> parts;
//:     if ok 0 1
//: ```
pub fn partition <.T: Copy> <(Vec<.T>, (.T)->bool)->Result<VecPartition<.T>, VecTransformError<.T>>> (v, p):
    let v_buffer_ref <&OwnedBuffer<.T>> field::get_ref &v "buffer"
    let src_len <i32> *field::get_ref v_buffer_ref "len"
    if:
        not vec_invariant::vec_buffer_current_copy_invariant<.T> v_buffer_ref
        then:
            Result::Err<VecPartition<.T>, VecTransformError<.T>> VecTransformError<.T> v StdErrorKind::InvalidOperation
        else:
            let mut left_len <i32> 0
            let mut i <i32> 0
            while lt i src_len:
                do:
                    match vec_get::get<.T> &v i:
                        Option::Some item:
                            if cond p item:
                                then set left_len add left_len 1
                                else ()
                        Option::None:
                            ()
                    set i add i 1
            let right_len <i32> sub src_len left_len
            match vec_storage::with_capacity<.T> left_len:
                Result::Err e:
                    Result::Err<VecPartition<.T>, VecTransformError<.T>> VecTransformError<.T> v e
                Result::Ok left0:
                    match vec_storage::with_capacity<.T> right_len:
                        Result::Err e:
                            vec_cleanup::free<.T> left0
                            Result::Err<VecPartition<.T>, VecTransformError<.T>> VecTransformError<.T> v e
                        Result::Ok right0:
                            let left_buffer_ref <&OwnedBuffer<.T>> field::get_ref &left0 "buffer"
                            let left_cap <i32> *field::get_ref left_buffer_ref "cap"
                            let left_data <MemPtr<.T>> vec_data::data_mem_ptr<.T> &left0
                            let right_buffer_ref <&OwnedBuffer<.T>> field::get_ref &right0 "buffer"
                            let right_cap <i32> *field::get_ref right_buffer_ref "cap"
                            let right_data <MemPtr<.T>> vec_data::data_mem_ptr<.T> &right0
                            let mut read_i <i32> 0
                            let mut left_i <i32> 0
                            let mut right_i <i32> 0
                            while lt read_i src_len:
                                do:
                                    match vec_get::get<.T> &v read_i:
                                        Option::Some item:
                                            if:
                                                cond p item
                                                then:
                                                    store<.T> add mem_ptr_addr left_data mul left_i size_of<.T> item
                                                    set left_i add left_i 1
                                                else:
                                                    store<.T> add mem_ptr_addr right_data mul right_i size_of<.T> item
                                                    set right_i add right_i 1
                                        Option::None:
                                            ()
                                    set read_i add read_i 1
                            vec_cleanup::free<.T> v
                            let left_buffer <OwnedBuffer<.T>> field::get left0 "buffer"
                            let left_storage <VecStorage<.T>> field::get left_buffer "storage"
                            let right_buffer <OwnedBuffer<.T>> field::get right0 "buffer"
                            let right_storage <VecStorage<.T>> field::get right_buffer "storage"
                            Result::Ok<VecPartition<.T>, VecTransformError<.T>> VecPartition<.T> (Vec<.T> (OwnedBuffer<.T> left_len left_len left_cap left_storage)) (Vec<.T> (OwnedBuffer<.T> right_len right_len right_cap right_storage))

//: ## vec_partition_matched_len
//: `partition` の true 側 `Vec` の[長/なが]さを[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `VecPartition` owner を[移動/いどう]せず、`matched` 側の[要素数/ようそすう]だけを[観測/かんそく]します。
//: - owner aggregate field を caller が直接 projection しないための public observer です。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts <VecPartition<i32>> unwrap_ok partition<i32> xs is_even;
//:     let ok <bool> eq vec_partition_matched_len<i32> &parts 1;
//:     vec_partition_free<i32> parts;
//:     if ok 0 1
//: ```
pub fn vec_partition_matched_len <.T> <(&VecPartition<.T>)->i32> (parts):
    let matched <&Vec<.T>> field::get_ref parts "matched"
    let matched_buffer <&OwnedBuffer<.T>> field::get_ref matched "buffer"
    *field::get_ref matched_buffer "len"

//: ## vec_partition_rest_len
//: `partition` の false 側 `Vec` の[長/なが]さを[返/かえ]す
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts <VecPartition<i32>> unwrap_ok partition<i32> xs is_even;
//:     let ok <bool> eq vec_partition_rest_len<i32> &parts 1;
//:     vec_partition_free<i32> parts;
//:     if ok 0 1
//: ```
pub fn vec_partition_rest_len <.T> <(&VecPartition<.T>)->i32> (parts):
    let rest <&Vec<.T>> field::get_ref parts "rest"
    let rest_buffer <&OwnedBuffer<.T>> field::get_ref rest "buffer"
    *field::get_ref rest_buffer "len"

//: ## vec_partition_matched_get
//: `partition` の true 側から index の[要素/ようそ]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `matched` 側の `Vec` を[借用/しゃくよう]し、`Vec.get` と同じ境界規則で `Option<T>` を[返/かえ]します。
//: - `.T: Copy` に[限定/げんてい]し、要素 owner の move-out をこの API では[扱/あつか]いません。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts <VecPartition<i32>> unwrap_ok partition<i32> xs is_even;
//:     let item <Option<i32>> vec_partition_matched_get<i32> &parts 0;
//:     vec_partition_free<i32> parts;
//:     match item:
//:         Option::Some x:
//:             if eq x 2 0 1
//:         Option::None:
//:             1
//: ```
pub fn vec_partition_matched_get <.T: Copy> <(&VecPartition<.T>,i32)->Option<.T>> (parts, idx):
    let matched <&Vec<.T>> field::get_ref parts "matched"
    vec_get::get<.T> matched idx

//: ## vec_partition_rest_get
//: `partition` の false 側から index の[要素/ようそ]を[読/よ]む
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts <VecPartition<i32>> unwrap_ok partition<i32> xs is_even;
//:     let item <Option<i32>> vec_partition_rest_get<i32> &parts 0;
//:     vec_partition_free<i32> parts;
//:     match item:
//:         Option::Some x:
//:             if eq x 1 0 1
//:         Option::None:
//:             1
//: ```
pub fn vec_partition_rest_get <.T: Copy> <(&VecPartition<.T>,i32)->Option<.T>> (parts, idx):
    let rest <&Vec<.T>> field::get_ref parts "rest"
    vec_get::get<.T> rest idx

//: ## vec_partition_free
//: `VecPartition` が[保持/ほじ]する 2 本の `Vec` owner を[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `matched` と `rest` の両方の owner を実装境界内で[取/と]り[出/だ]し、解放漏れを避けます。
//: - caller は owner aggregate field を直接 projection せず、`VecPartition` 全体をこの関数へ[渡/わた]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let parts <VecPartition<i32>> unwrap_ok partition<i32> xs is_even;
//:     vec_partition_free<i32> parts;
//:     0
//: ```
pub fn vec_partition_free <.T: Copy> <(VecPartition<.T>)->()> (parts):
    let matched <Vec<.T>> field::get parts "matched"
    let rest <Vec<.T>> field::get parts "rest"
    vec_cleanup::free<.T> matched
    vec_cleanup::free<.T> rest
