//: # vec/query/aggregate
//: `Vec` の aggregate query
//:
//: ### [目的/もくてき]
//: - count/fold/reduce を query facade から[分離/ぶんり]し、borrowed owner から Copy 要素を[読/よ]む[集約/しゅうやく]処理をこの module に[集約/しゅうやく]します。
//: - non-Copy payload を値として[読/よ]まない predicate count は、scoped borrowed observer として同じ module に[置/お]きます。
//:
//: ### [注意/ちゅうい]
//: - 要素の読み取りは `get<T: Copy>` を[通/とお]し、raw load の結果を callback に直接[渡/わた]しません。
//: - `count_ref` は payload を copy-out せず、`BorrowRead` proof を[使/つか]う borrowed predicate API です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../invariant" as *
#import "../access/borrow" as vec_borrow
#import "./get" as vec_get
#import "core/field" as *

//: count: [条件/じょうけん]を[満/み]たす[要素数/ようそすう]を[数/かぞ]える
//:
//: ### [目的/もくてき]
//: - `xs |> count p` の[形/かたち]で、`p` が true になる[要素/ようそ]の[個数/こすう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[末尾/まつび]まで 1 [回/かい]だけ[走査/そうさ]し、true のたびに[加算/かさん]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let ok %bool eq count<i32> &xs is_even 2
//:     free<i32> xs;
//:     if ok 0 1
//: ```
pub fn count <.T: Copy> %fn &Vec .T fn fn .T bool i32 \v\p:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            0
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %i32 0
            let mut i %i32 0
            while lt i src_len:
                do:
                    match vec_get::get<.T> v i:
                        Option::Some item:
                            if cond p item:
                                then set out add out 1
                                else unit
                        Option::None:
                            unit
                    set i add i 1
            out

//: count_ref: 借用 predicate で[条件/じょうけん]を[満/み]たす[要素数/ようそすう]を[数/かぞ]える
//:
//: ### [目的/もくてき]
//: - non-Copy payload を `get<T: Copy>` で[読/よ]み[出/だ]さず、各 slot を `&T` として predicate に[渡/わた]します。
//: - 戻り値は `i32` だけなので、要素 owner は `Vec` の中に[残/のこ]ります。
//:
//: ### [実装/じっそう]
//: - 走査前に `VecStorageInvariant` を[確認/かくにん]し、metadata が不正なら 0 を[返/かえ]します。
//: - 各 index では `borrow_at_predicate_or` を[使/つか]い、範囲外や storage 不整合が起きた場合は predicate false として[扱/あつか]います。
//:
//: ### [注意/ちゅうい]
//: - predicate は `(&T)->bool` です。`T` を値として[返/かえ]す `find` / `reduce` とは[別/べつ]の API です。
//: - borrowed ref は callback の[間/あいだ]だけ[有効/ゆうこう]で、この関数から[返/かえ]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn is_even_payload %fn &DropPayload bool \item:
//:     eq rem_s *field::get_ref item "value" 2 0
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 2)
//:     let v2 %Vec DropPayload unwrap_ok push<DropPayload> v1 (DropPayload 3)
//:     let ok %bool eq count_ref<DropPayload> &v2 @is_even_payload 1
//:     free<DropPayload> v2
//:     if ok 0 1
//: ```
pub fn count_ref <.T> %fn &Vec .T fn fn &.T bool i32 \v\p:
    match vec_current_storage_invariant<.T> v:
        VecStorageInvariant::Invalid _reason:
            0
        VecStorageInvariant::Valid:
            let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %i32 0
            let mut i %i32 0
            while lt i src_len:
                do:
                    if:
                        vec_borrow::borrow_at_predicate_or<.T> v i p false
                        then set out add out 1
                        else unit
                    set i add i 1
            out

//: fold: [左/ひだり]から[順/じゅん]に[畳/たた]み[込/こ]む
//:
//: ### [目的/もくてき]
//: - `xs |> fold init f` の[形/かたち]で、[初期値/しょきち] `init` から[始/はじ]めて[全要素/ぜんようそ]を 1 つの[値/あたい]へ[集約/しゅうやく]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]から `len - 1` まで[順番/じゅんばん]に `f acc item` を[適用/てきよう]し、[更新後/こうしんご]の acc を[次/つぎ]へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `init` をそのまま[返/かえ]します。
//: - `f` は `(.U,.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn add_acc %fn i32 fn i32 i32 \acc\x:
//:     add acc x
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ok %bool eq fold<i32,i32> &xs 10 add_acc 16
//:     free<i32> xs;
//:     if ok 0 1
//: ```
pub fn fold <.T: Copy,.U> %fn &Vec .T fn .U fn fn .U fn .T .U .U \v\acc\f:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            acc
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %.U acc
            let mut i %i32 0
            while lt i src_len:
                do:
                    match vec_get::get<.T> v i:
                        Option::Some item:
                            set out f out item
                        Option::None:
                            unit
                    set i add i 1
            out

//: reduce: [初期値/しょきち]なしで[集約/しゅうやく]する
//:
//: ### [目的/もくてき]
//: - [非空/ひくう] `Vec` なら[先頭/せんとう][要素/ようそ]を[初期値/しょきち]として[残/のこ]りを[畳/たた]み[込/こ]み、[空/から]なら `None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]を[初期値/しょきち]として[読/よ]み[出/だ]し、1 [番目/ばんめ]から[残/のこ]りを[左畳/ひだりたた]み[込/こ]みします。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `Option::None` です。
//: - `f` は `(.T,.T)->.T` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn add_acc %fn i32 fn i32 i32 \acc\x:
//:     add acc x
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     match reduce<i32> &xs add_acc:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 6 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
pub fn reduce <.T: Copy> %fn &Vec .T fn fn .T fn .T .T Option .T \v\f:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            none
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            if:
                eq src_len 0
                then none
                else:
                    match vec_get::get<.T> v 0:
                        Option::None:
                            none
                        Option::Some first:
                            let mut out %.T first
                            let mut i %i32 1
                            while lt i src_len:
                                do:
                                    match vec_get::get<.T> v i:
                                        Option::Some item:
                                            set out f out item
                                        Option::None:
                                            unit
                                    set i add i 1
                            some out
