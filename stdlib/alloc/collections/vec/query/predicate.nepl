//: # vec/query/predicate
//: `Vec` の predicate query
//:
//: ### [目的/もくてき]
//: - find/any/all を query facade から[分離/ぶんり]し、predicate による scan 処理をこの module に[集約/しゅうやく]します。
//: - non-Copy payload を copy-out しない predicate scan は、`&T` を callback scope に[閉/と]じる `*_ref` API として[提供/ていきょう]します。
//:
//: ### [注意/ちゅうい]
//: - 要素の読み取りは `get<T: Copy>` を[通/とお]し、raw load の結果を callback に直接[渡/わた]しません。
//: - `*_ref` API は `get` を[使/つか]わず、`BorrowRead` proof を[発行/はっこう]する borrowed observer boundary を[通/とお]ります。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../invariant" as *
#import "../access/borrow" as vec_borrow
#import "./get" as vec_get
#import "core/field" as *

//: find: [条件/じょうけん]に[合/あ]う[最初/さいしょ]の[要素/ようそ]を[探/さが]す
//:
//: ### [目的/もくてき]
//: - `xs |> find p` の[形/かたち]で、0 [番目/ばんめ]から[順/じゅん]に `p` を[試/ため]し、[最初/さいしょ]に[真/しん]となる[要素/ようそ]を `Some` で[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で[即座/そくざ]に[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [見/み]つからなければ `None` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn gt_two %fn i32 bool \x:
//:     gt x 2
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     match find<i32> &xs gt_two:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 3 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
pub fn find <.T: Copy> %fn &Vec .T fn fn .T bool Option .T \v\p:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            none
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %Option .T none
            let mut active %bool true
            let mut i %i32 0
            while and active lt i src_len:
                do:
                    match vec_get::get<.T> v i:
                        Option::Some item:
                            if:
                                cond p item
                                then:
                                    set out some item
                                    set active false
                                else:
                                    unit
                        Option::None:
                            set active false
                    set i add i 1
            out

//: find_index_ref: 借用 predicate に[合/あ]う[最初/さいしょ]の index を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `find<T: Copy>` のように要素を `Option<T>` として copy-out せず、見つかった[位置/いち]だけを `Option<i32>` で[返/かえ]します。
//: - non-Copy payload の owner は `Vec` の slot に[残/のこ]り、predicate は `&T` を callback scope 内で[観測/かんそく]します。
//:
//: ### [実装/じっそう]
//: - `VecStorageInvariant` を先に[確認/かくにん]し、metadata が不正なら `None` です。
//: - 各 slot は `borrow_at_predicate_or` で[借用/しゃくよう]し、true になった最初の index で[打/う]ち[切/き]ります。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn is_value_9 %fn &DropPayload bool \item:
//:     eq *field::get_ref item "value" 9
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 7)
//:     let v2 %Vec DropPayload unwrap_ok push<DropPayload> v1 (DropPayload 9)
//:     let ok %bool match find_index_ref<DropPayload> &v2 @is_value_9:
//:         Option::Some idx:
//:             eq idx 1
//:         Option::None:
//:             false
//:     free<DropPayload> v2
//:     if ok 0 1
//: ```
pub fn find_index_ref <.T> %fn &Vec .T fn fn &.T bool Option i32 \v\p:
    match vec_current_storage_invariant<.T> v:
        VecStorageInvariant::Invalid _reason:
            none
        VecStorageInvariant::Valid:
            let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %Option i32 none
            let mut active %bool true
            let mut i %i32 0
            while and active lt i src_len:
                do:
                    if:
                        vec_borrow::borrow_at_predicate_or<.T> v i p false
                        then:
                            set out some i
                            set active false
                        else:
                            unit
                    set i add i 1
            out

//: any: [条件/じょうけん]を[満/み]たす[要素/ようそ]が 1 つでもあるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> any p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]が 1 つでもあれば `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で `true` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `false` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn gt_two %fn i32 bool \x:
//:     gt x 2
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     let ok %bool any<i32> &xs gt_two
//:     free<i32> xs;
//:     if ok 0 1
//: ```
pub fn any <.T: Copy> %fn &Vec .T fn fn .T bool bool \v\p:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            false
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %bool false
            let mut i %i32 0
            while and lt i src_len not out:
                do:
                    match vec_get::get<.T> v i:
                        Option::Some item:
                            set out p item
                        Option::None:
                            set out false
                    set i add i 1
            out

//: any_ref: 借用 predicate を[満/み]たす[要素/ようそ]が 1 つでもあるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - non-Copy payload を値として[取/と]り[出/だ]さず、`&T` predicate だけで[存在/そんざい][判定/はんてい]します。
//:
//: ### [実装/じっそう]
//: - `VecStorageInvariant` が invalid なら false です。
//: - true が[見/み]つかった時点で[走査/そうさ]を[終了/しゅうりょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn is_value_5 %fn &DropPayload bool \item:
//:     eq *field::get_ref item "value" 5
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 5)
//:     let ok %bool any_ref<DropPayload> &v1 @is_value_5
//:     free<DropPayload> v1
//:     if ok 0 1
//: ```
pub fn any_ref <.T> %fn &Vec .T fn fn &.T bool bool \v\p:
    match vec_current_storage_invariant<.T> v:
        VecStorageInvariant::Invalid _reason:
            false
        VecStorageInvariant::Valid:
            let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %bool false
            let mut i %i32 0
            while and lt i src_len not out:
                do:
                    set out vec_borrow::borrow_at_predicate_or<.T> v i p false
                    set i add i 1
            out

//: all: [全要素/ぜんようそ]が[条件/じょうけん]を[満/み]たすか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> all p` の[形/かたち]で、[全/すべ]ての[要素/ようそ]が `p` を[満/み]たすときだけ `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、1 [件/けん]でも false が[出/で]たら[即座/そくざ]に[打/う]ち[切/き]ります。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `true` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn is_even %fn i32 bool \x:
//:     eq rem_s x 2 0
//: fn main %impure fn unit i32 \unit:
//:     let xs %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ok %bool all<i32> &xs is_even
//:     free<i32> xs;
//:     if ok 0 1
//: ```
pub fn all <.T: Copy> %fn &Vec .T fn fn .T bool bool \v\p:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    match vec_buffer_current_copy_invariant<.T> v_buffer:
        VecCopyInvariant::Invalid _reason:
            false
        VecCopyInvariant::Valid:
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %bool true
            let mut i %i32 0
            while and lt i src_len out:
                do:
                    match vec_get::get<.T> v i:
                        Option::Some item:
                            set out p item
                        Option::None:
                            set out false
                    set i add i 1
            out

//: all_ref: [全要素/ぜんようそ]が借用 predicate を[満/み]たすか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - non-Copy payload を copy-out せず、各 slot を `&T` として predicate に[渡/わた]します。
//: - [空/から] `Vec` では true です。
//:
//: ### [実装/じっそう]
//: - `VecStorageInvariant` が invalid なら false です。
//: - false が[見/み]つかった時点で[走査/そうさ]を[終了/しゅうりょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/drop" as *
//: struct DropPayload:
//:     value %i32
//: impl Drop for DropPayload:
//:     fn drop %impure fn &DropPayload unit \_self:
//:         unit
//: fn is_positive %fn &DropPayload bool \item:
//:     lt 0 *field::get_ref item "value"
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec DropPayload unwrap_ok new<DropPayload>
//:     let v1 %Vec DropPayload unwrap_ok push<DropPayload> v0 (DropPayload 1)
//:     let v2 %Vec DropPayload unwrap_ok push<DropPayload> v1 (DropPayload 2)
//:     let ok %bool all_ref<DropPayload> &v2 @is_positive
//:     free<DropPayload> v2
//:     if ok 0 1
//: ```
pub fn all_ref <.T> %fn &Vec .T fn fn &.T bool bool \v\p:
    match vec_current_storage_invariant<.T> v:
        VecStorageInvariant::Invalid _reason:
            false
        VecStorageInvariant::Valid:
            let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
            let src_len %i32 *field::get_ref v_buffer "len"
            let mut out %bool true
            let mut i %i32 0
            while and lt i src_len out:
                do:
                    set out vec_borrow::borrow_at_predicate_or<.T> v i p false
                    set i add i 1
            out
