//: # vec/query/get
//: `Vec` の index lookup
//:
//: ### [目的/もくてき]
//: - `get` を query facade から[分離/ぶんり]し、範囲検査と empty storage 判定をこの module に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - raw storage の読み取りは、この module の[範囲/はんい][検査/けんさ]を[通/とお]った分岐の中に[閉/と]じます。

#indent 4

#import "core/mem" as *
#import "core/mem/internal" as *
#import "core/mem/raw" as *
#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../access/data" as *
#import "../invariant" as *
#import "core/field" as *

//: get: [要素/ようそ]を[取得/しゅとく]する
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら `Option::Some`、[範囲外/はんいがい]なら `Option::None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `idx` の[範囲/はんい]を[判定/はんてい]し、[妥当/だとう]な[場合/ばあい]だけ typed `load` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - `idx` が[負/ふ]でも `Option::None` です。
//: - [失敗/しっぱい]を trap ではなく `Option` で[返/かえ]す[設計/せっけい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "core/field" as *
//: fn main %impure fn unit i32 \unit:
//:     let v0 %Vec i32 unwrap_ok new<i32>;
//:     let v1 %Vec i32 unwrap_ok push v0 9;
//:     match get<i32> &v1 0:
//:         Option::Some x:
//:             free<i32> v1;
//:             if eq x 9 0 1
//:         Option::None:
//:             free<i32> v1;
//:             1
//: ```
pub fn get <.T: Copy> %fn &Vec .T fn i32 Option .T \v\idx:
    let v_buffer %&OwnedBuffer .T field::get_ref v "buffer"
    let v_len %i32 *field::get_ref v_buffer "len"
    let v_storage %&VecStorage .T field::get_ref v_buffer "storage"
    match vec_current_copy_invariant<.T> v:
        VecCopyInvariant::Invalid _reason:
            none<.T>
        VecCopyInvariant::Valid:
            if:
                lt idx 0
                then none<.T>
                else:
                    if:
                        le v_len idx
                        then none<.T>
                        else:
                            match v_storage:
                                VecStorage::Empty:
                                    none<.T>
                                VecStorage::Owned _region:
                                    match data_mem_view<.T> v:
                                        VecDataView::Empty:
                                            none<.T>
                                        VecDataView::Invalid _reason:
                                            none<.T>
                                        VecDataView::Data v_data:
                                            some<.T> load<.T> add mem_ptr_addr v_data mul idx size_of<.T>
