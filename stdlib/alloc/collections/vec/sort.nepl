//: sort: `Vec` の in-place sort algorithms
//:
//: [目的/もくてき]:
//: - `Vec` based in-place sort algorithms を再 export する canonical facade です。
//: - 比較・sortedness observer、教育用 simple sort、Lomuto quick sort、heap sort、merge sort を submodule に分けます。
//: - raw `MemPtr` range traversal は各 sort implementation file と merge scratch boundary に閉じ、この facade からは公開しません。
//:
//: [注意/ちゅうい]:
//: - 現行 sort family は raw `load` / `store` による swap と scratch buffer copy を使うため、`.T: Ord&Copy` に限定します。non-Copy payload の sort は `OwnedBuffer .T` と move/drop-aware algorithm が入るまで提供しません。
//: - borrowed in-place sort は `Result unit StdErrorKind`、owner-consuming `*_ret` sort は `Result Vec .T VecSortError .T` を返します。invalid metadata を silent no-op として扱いません。
//: - stable sort が必要なら `sort_merge` を使います。
//: - heap sort は O(n log n)、追加領域 O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main %impure fn void i32 \void:
//:     let unsorted %Vec i32:
//:         unwrap_ok new
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let sorted %Vec i32 unwrap_ok sort_quick_ret unsorted
//:     let ok %bool sort_is_sorted &sorted
//:     free sorted
//:     if ok 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main %impure fn void i32 \void:
//:     let unsorted %Vec i32:
//:         unwrap_ok new
//:         |> push 4 |> uwok
//:         |> push 3 |> uwok
//:         |> push 2 |> uwok
//:         |> push 1 |> uwok
//:     let sorted %Vec i32 unwrap_ok sort_merge_ret unsorted
//:     let ok %bool sort_is_sorted &sorted
//:     free sorted
//:     if ok 0 1
//: ```
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "core/traits/ord" as *
//:| #import "core/result" as *
//:| #import "core/field" as *
//: struct NonCopyOrd:
//:     value %i32
//: impl Ord for NonCopyOrd:
//:     fn lt %fn NonCopyOrd fn NonCopyOrd bool \a\b:
//:         lt get a "value" get b "value"
//: fn main %impure fn void i32 \void:
//:     let v0 %Vec NonCopyOrd unwrap_ok new<NonCopyOrd>;
//:     sort<NonCopyOrd> &v0;
//:     0
//: ```

#indent 4

pub #import "./sort/common" as *
pub #import "./sort/simple" as *
pub #import "./sort/quick" as *
pub #import "./sort/heap" as *
pub #import "./sort/merge" as *
