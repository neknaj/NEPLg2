//: sort: alloc/sort.nepl に関する機能を提供するライブラリ
//:
//: [目的/もくてき]:
//: - このモジュールの公開 API を提供します。
//: - 実装の変更時に最小限の doctest 実行経路を維持します。
//:
//: [注意/ちゅうい]:
//: - 利用時は各関数の「目的」「注意」「計算量」を確認してください。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let sorted <Vec<i32>> sort_quick_ret<i32> unsorted
//:     if sort_is_sorted<i32> sorted 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 4 |> uwok
//:         |> push 3 |> uwok
//:         |> push 2 |> uwok
//:         |> push 1 |> uwok
//:     let sorted <Vec<i32>> unwrap_ok<Vec<i32>, StdErrorKind> sort_merge_ret<i32> unsorted
//:     if sort_is_sorted<i32> sorted 1 0
//: ```

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/result" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/diag/error" as *


// sort: Vec の in-place ソート集
//
// 目的:
// - Vec<.T> を「同じバッファのまま」並べ替える関数群を提供します。
// - 比較は trait Ord の lt (strict less-than) だけに依存します。
//
// 注意(重要):
// - 破壊的(in-place)です。v の要素が並べ替えられます。
// - 比較は昇順のみです(降順が欲しい場合は Ord を反転して実装します)。
// - 安全性のための範囲チェックを省き、v.len と v.data を直接使います。
//   (stdlib/alloc の他モジュール同様、「正しい index で呼ぶ」前提です)
//
// 計算量:
// - 各アルゴリズムごとのコメントを参照してください。


// sort_lt: a < b
//: sort_lt: 主な用途
//:
//: [目的/もくてき]:
//: - sort_lt の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_lt <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_lt a b

// sort_le: a <= b  (not (b < a))
//: sort_le: 主な用途
//:
//: [目的/もくてき]:
//: - sort_le の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_le <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_le a b

// sort_gt: a > b  (b < a)
//: sort_gt: 主な用途
//:
//: [目的/もくてき]:
//: - sort_gt の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_gt <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_gt a b

// sort_ge: a >= b (not (a < b))
//: sort_ge: 主な用途
//:
//: [目的/もくてき]:
//: - sort_ge の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_ge <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_ge a b


// sort_get_unchecked: 範囲チェックなしの要素取得
//
// 注意(重要):
// - 0 <= idx < v.len を満たすこと。
//: sort_get_unchecked: 主な用途
//:
//: [目的/もくてき]:
//: - sort_get_unchecked の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_get_unchecked <.T> <(Vec<.T>,i32)->.T> (v, idx):
    let data <i32> data_ptr<.T> v
    let off <i32> mul idx size_of<.T>
    load<.T> add data off

// sort_set_unchecked: 範囲チェックなしの要素設定
//
// 注意(重要):
// - 0 <= idx < v.len を満たすこと。
//: sort_set_unchecked: 主な用途
//:
//: [目的/もくてき]:
//: - sort_set_unchecked の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_set_unchecked <.T> <(Vec<.T>,i32,.T)->()> (v, idx, val):
    let data <i32> data_ptr<.T> v
    let off <i32> mul idx size_of<.T>
    store<.T> add data off val;
    ()

// sort_get_unchecked_data: data ポインタ版の取得
fn sort_get_unchecked_data <.T> <(i32,i32)->.T> (data_ptr, idx):
    let off <i32> mul idx size_of<.T>
    load<.T> add data_ptr off

// sort_set_unchecked_data: data ポインタ版の設定
fn sort_set_unchecked_data <.T> <(i32,i32,.T)->()> (data_ptr, idx, val):
    let off <i32> mul idx size_of<.T>
    store<.T> add data_ptr off val;
    ()

// sort_swap_data: data ポインタ版の交換
fn sort_swap_data <.T> <(i32,i32,i32)->()> (data_ptr, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked_data<.T> data_ptr i
            let b <.T> sort_get_unchecked_data<.T> data_ptr j
            sort_set_unchecked_data<.T> data_ptr i b;
            sort_set_unchecked_data<.T> data_ptr j a;
            ()


 // sort_swap: v[i] と v[j] を交換
//: sort_swap: 主な用途
//:
//: [目的/もくてき]:
//: - sort_swap の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_swap <.T> <(Vec<.T>,i32,i32)->()> (v, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked<.T> v i
            let b <.T> sort_get_unchecked<.T> v j
            sort_set_unchecked<.T> v i b;
            sort_set_unchecked<.T> v j a;
            ()

// sort_is_sorted: 昇順にソート済みか
//
// 注意(重要):
// - strict lt を使うため、隣り合う要素で「右 < 左」があれば未ソート。
//: sort_is_sorted: 主な用途
//:
//: [目的/もくてき]:
//: - sort_is_sorted の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_is_sorted <.T: Ord> <(Vec<.T>)->bool> (v):
    let n <i32> get v "len"
    let data_ptr <i32> mem_ptr_addr get v "data"
    if:
        le n 1
        then true
        else:
            let mut i <i32> 1
            let mut ok <bool> true
            while and ok lt i n:
                do:
                    let a <.T> sort_get_unchecked_data<.T> data_ptr sub i 1;
                    let b <.T> sort_get_unchecked_data<.T> data_ptr i;
                    if:
                        sort_lt<.T> b a
                        then set ok false
                        else ()
                    set i add i 1;
            ok


// -----------------------------------------------------------------------------
// 1) Insertion sort
// -----------------------------------------------------------------------------
//: sort_insertion: 主な用途
//:
//: [目的/もくてき]:
//: - sort_insertion の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_insertion <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1
            while lt i n:
                do:
                    let key <.T> sort_get_unchecked<.T> v i;
                    let mut j <i32> sub i 1;

                    let mut done <i32> 0;
                    while eq done 0:
                        do:
                            if:
                                and le 0 j sort_lt<.T> key sort_get_unchecked<.T> v j
                                then:
                                    let x <.T> sort_get_unchecked<.T> v j;
                                    sort_set_unchecked<.T> v add j 1 x;
                                    set j sub j 1;
                                else set done 1
                    sort_set_unchecked<.T> v add j 1 key;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 2) Selection sort
// -----------------------------------------------------------------------------
//: sort_selection: 主な用途
//:
//: [目的/もくてき]:
//: - sort_selection の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_selection <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 0
            while lt i n:
                do:
                    let mut min_idx <i32> i;
                    let mut j <i32> add i 1;
                    while lt j n:
                        do:
                            let a <.T> sort_get_unchecked<.T> v j;
                            let b <.T> sort_get_unchecked<.T> v min_idx;
                            if:
                                sort_lt<.T> a b
                                then set min_idx j
                                else ()
                            set j add j 1;
                    sort_swap<.T> v i min_idx;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 3) Bubble sort
// -----------------------------------------------------------------------------
//: sort_bubble: 主な用途
//:
//: [目的/もくてき]:
//: - sort_bubble の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_bubble <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut end <i32> sub n 1;
            while lt 0 end:
                do:
                    let mut i <i32> 0;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then sort_swap<.T> v i add i 1
                                else ()
                            set i add i 1;
                    set end sub end 1;
            ()


// -----------------------------------------------------------------------------
// 4) Cocktail shaker sort
// -----------------------------------------------------------------------------
//: sort_cocktail: 主な用途
//:
//: [目的/もくてき]:
//: - sort_cocktail の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_cocktail <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut start <i32> 0;
            let mut end <i32> sub n 1;
            let mut swapped <i32> 1;

            while and eq swapped 1 lt start end:
                do:
                    set swapped 0;

                    // forward pass
                    let mut i <i32> start;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v i add i 1;
                                    set swapped 1;
                                    ()
                                else ()
                            set i add i 1;

                    set end sub end 1;

                    if:
                        eq swapped 0
                        then set start end
                        else:
                            set swapped 0;

                    // backward pass
                    let mut j <i32> end;
                    while lt start j:
                        do:
                            let a <.T> sort_get_unchecked<.T> v sub j 1;
                            let b <.T> sort_get_unchecked<.T> v j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v sub j 1 j;
                                    set swapped 1;
                                    ()
                                else ()
                            set j sub j 1;

                    set start add start 1;
            ()


// -----------------------------------------------------------------------------
// 5) Gnome sort
// -----------------------------------------------------------------------------
//: sort_gnome: 主な用途
//:
//: [目的/もくてき]:
//: - sort_gnome の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_gnome <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1;
            while lt i n:
                do:
                    if:
                        or eq i 0 sort_le<.T> sort_get_unchecked<.T> v sub i 1 sort_get_unchecked<.T> v i
                        then set i add i 1
                        else:
                            sort_swap<.T> v i sub i 1;
                            set i sub i 1;
                    ();
            ()


// -----------------------------------------------------------------------------
// 6) Shell sort
// -----------------------------------------------------------------------------
//: sort_shell: 主な用途
//:
//: [目的/もくてき]:
//: - sort_shell の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_shell <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> div_s n 2;

            while lt 0 gap:
                do:
                    let mut i <i32> gap;
                    while lt i n:
                        do:
                            let temp <.T> sort_get_unchecked<.T> v i;
                            let mut j <i32> i;

                            let mut done <i32> 0;
                            while eq done 0:
                                do:
                                    if:
                                        and le gap j sort_lt<.T> temp sort_get_unchecked<.T> v sub j gap
                                        then:
                                            let x <.T> sort_get_unchecked<.T> v sub j gap;
                                            sort_set_unchecked<.T> v j x;
                                            set j sub j gap;
                                        else set done 1

                            sort_set_unchecked<.T> v j temp;
                            set i add i 1;
                    set gap div_s gap 2;
            ()


// -----------------------------------------------------------------------------
// 7) Comb sort
// -----------------------------------------------------------------------------
//: sort_comb: 主な用途
//:
//: [目的/もくてき]:
//: - sort_comb の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_comb <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> n;
            let mut sorted <i32> 0;

            while eq sorted 0:
                do:
                    // gap = floor(gap * 10 / 13)
                    let scaled_gap <i32> mul gap 10;
                    let reduced_gap <i32> div_s scaled_gap 13;
                    set gap reduced_gap;
                    if:
                        lt gap 1
                        then set gap 1
                        else ()

                    if:
                        eq gap 1
                        then set sorted 1
                        else ()

                    let mut i <i32> 0;
                    let mut done_scan <i32> 0;
                    while eq done_scan 0:
                        do:
                            let next_i <i32> add i gap;
                            if:
                                lt next_i n
                                then:
                                    let a <.T> sort_get_unchecked<.T> v i;
                                    let b <.T> sort_get_unchecked<.T> v next_i;
                                    if:
                                        sort_lt<.T> b a
                                        then:
                                            sort_swap<.T> v i next_i;
                                            set sorted 0;
                                            ()
                                        else ()
                                    set i add i 1;
                                    ()
                                else set done_scan 1
            ()


// -----------------------------------------------------------------------------
// 8) Quick sort (Lomuto partition)
// -----------------------------------------------------------------------------
//: sort_quick_partition: 主な用途
//:
//: [目的/もくてき]:
//: - sort_quick_partition の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_quick_partition_data <.T: Ord> <(i32,i32,i32)->i32> (data_ptr, lo, hi):
    let pivot <.T> sort_get_unchecked_data<.T> data_ptr hi
    let mut i <i32> lo;
    let mut j <i32> lo;

    while lt j hi:
        do:
            let x <.T> sort_get_unchecked_data<.T> data_ptr j;
            if:
                sort_le<.T> x pivot
                then:
                    sort_swap_data<.T> data_ptr i j;
                    set i add i 1;
                    ()
                else ()
            set j add j 1;

    sort_swap_data<.T> data_ptr i hi;
    i

//: sort_quick_range: 主な用途
//:
//: [目的/もくてき]:
//: - sort_quick_range の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_quick_range_data <.T: Ord> <(i32,i32,i32)->()> (data_ptr, lo, hi):
    if:
        lt lo hi
        then:
            let p <i32> sort_quick_partition_data<.T> data_ptr lo hi;
            sort_quick_range_data<.T> data_ptr lo sub p 1;
            sort_quick_range_data<.T> data_ptr add p 1 hi;
            ()
        else ()

//: sort_quick: 主な用途
//:
//: [目的/もくてき]:
//: - sort_quick の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_quick <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> get v "len"
    let data_ptr <i32> mem_ptr_addr get v "data"
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub n 1;
            ()


// -----------------------------------------------------------------------------
// 9) Heap sort (max-heap)
// -----------------------------------------------------------------------------
//: sort_heap_sift_down: 主な用途
//:
//: [目的/もくてき]:
//: - sort_heap_sift_down の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_heap_sift_down_data <.T: Ord> <(i32,i32,i32)->()> (data_ptr, start, end):
    let mut root <i32> start;
    let mut done <i32> 0;

    while eq done 0:
        do:
            let doubled_root <i32> mul root 2;
            let child <i32> add doubled_root 1;
            if:
                lt child end
                then:
                    let mut swap_idx <i32> root;

                    let swap_v <.T> sort_get_unchecked_data<.T> data_ptr swap_idx;
                    let child_v <.T> sort_get_unchecked_data<.T> data_ptr child;
                    if:
                        sort_lt<.T> swap_v child_v
                        then set swap_idx child
                        else ()

                    let right <i32> add child 1;
                    if:
                        lt right end
                        then:
                            let swap_v2 <.T> sort_get_unchecked_data<.T> data_ptr swap_idx;
                            let right_v <.T> sort_get_unchecked_data<.T> data_ptr right;
                            if:
                                sort_lt<.T> swap_v2 right_v
                                then set swap_idx right
                                else ()
                            ()
                        else ()

                    if:
                        eq swap_idx root
                        then set done 1
                        else:
                            sort_swap_data<.T> data_ptr root swap_idx;
                            set root swap_idx;
                            ();
                    ()
                else set done 1

    ()

//: sort_heap: 主な用途
//:
//: [目的/もくてき]:
//: - sort_heap の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort_heap <.T: Ord> <(Vec<.T>)->()> (v):
    let n <i32> get v "len"
    let data_ptr <i32> mem_ptr_addr get v "data"
    if:
        le n 1
        then ()
        else:
            let n_minus_two <i32> sub n 2;
            let mut start <i32> div_s n_minus_two 2;
            let mut done0 <i32> 0;
            while eq done0 0:
                do:
                    if:
                        lt start 0
                        then set done0 1
                        else:
                            sort_heap_sift_down_data<.T> data_ptr start n;
                            set start sub start 1;
                            ();
            let mut end <i32> sub n 1;
            while lt 0 end:
                do:
                    sort_swap_data<.T> data_ptr 0 end;
                    sort_heap_sift_down_data<.T> data_ptr 0 end;
                    set end sub end 1;
            ()


// -----------------------------------------------------------------------------
// 10) Merge sort (top-down)
// -----------------------------------------------------------------------------
//: ## sort_buf_get
//: merge sort [用/よう]の[作業/さぎょう] buffer から[値/あたい]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `sort_merge_range_data` が[一時/いちじ] buffer に[退避/たいひ]した[要素/ようそ]を、`MemPtr<.T>` [基準/きじゅん]で[取/と]り[出/だ]せるようにします。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` で byte offset を[計算/けいさん]し、buffer [先頭/せんとう]から `load<.T>` します。
//:
//: ### [注意/ちゅうい]
//: - `buf` は `.T` の[配列/はいれつ]として[有効/ゆうこう]である[必要/ひつよう]があります。
//: - `idx` の[境界/きょうかい][確認/かくにん]は[呼/よ]び[出/だ]し[側/がわ]が[担当/たんとう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
fn sort_buf_get <.T> <(MemPtr<.T>,i32)->.T> (buf, idx):
    let off <i32> mul idx size_of<.T>
    load<.T> add mem_ptr_addr buf off

//: ## sort_buf_set
//: merge sort [用/よう]の[作業/さぎょう] buffer へ[値/あたい]を[書/か]く
//:
//: ### [目的/もくてき]
//: - [一時/いちじ] buffer に[現在/げんざい]の[要素/ようそ][列/れつ]を[複写/ふくしゃ]し、merge [中/ちゅう]に[安定/あんてい]した[読/よ]み[取/と]り[元/もと]を[確保/かくほ]します。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` を[求/もと]め、buffer [先頭/せんとう]から `store<.T>` します。
//:
//: ### [注意/ちゅうい]
//: - `buf` は `.T` の[配列/はいれつ]として[有効/ゆうこう]である[必要/ひつよう]があります。
//: - `val` は `store<.T>` によって buffer へ[書/か]き[込/こ]まれます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
fn sort_buf_set <.T> <(MemPtr<.T>,i32,.T)->()> (buf, idx, val):
    let off <i32> mul idx size_of<.T>
    store<.T> add mem_ptr_addr buf off val;
    ()

//: ## sort_merge_range_data
//: merge sort の 1 [区間/くかん]を[再帰的/さいきてき]に[統合/とうごう]する
//:
//: ### [目的/もくてき]
//: - `data_ptr` が[指/さ]す `[l, r)` [区間/くかん]を merge sort で[整列/せいれつ]します。
//: - [比較元/ひかくもと]を[壊/こわ]さないため、`buf` に[現在/げんざい]の[内容/ないよう]を[退避/たいひ]してから[統合/とうごう]します。
//:
//: ### [実装/じっそう]
//: - [中央/ちゅうおう] `mid` で 2 [分割/ぶんかつ]し、[左右/さゆう]を[再帰的/さいきてき]に sort したあと、`buf` に[複写/ふくしゃ]した[要素/ようそ]を 2 [本/ほん]の[読/よ]み[取/と]り[位置/いち]で merge します。
//:
//: ### [注意/ちゅうい]
//: - `data_ptr` と `buf` は `.T` を `r` [個分/こぶん]まで[安全/あんぜん]に[読/よ]み[書/か]きできる[領域/りょういき]である[必要/ひつよう]があります。
//: - [境界/きょうかい][確認/かくにん]は[内部/ないぶ]で[省略/しょうりゃく]しているため、`l <= r` と[十分/じゅうぶん]な[容量/ようりょう]は[呼/よ]び[出/だ]し[側/がわ]の[責任/せきにん]です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n log n)、[追加/ついか][空間/くうかん][計算量/けいさんりょう]は O(n) です。
fn sort_merge_range_data <.T: Ord> <(i32,MemPtr<.T>,i32,i32)->()> (data_ptr, buf, l, r):
    let width <i32> sub r l;
    if:
        le width 1
        then ()
        else:
            let lr_sum <i32> add l r;
            let mid <i32> div_s lr_sum 2;
            sort_merge_range_data<.T> data_ptr buf l mid;
            sort_merge_range_data<.T> data_ptr buf mid r;

            let mut i0 <i32> l;
            while lt i0 r:
                do:
                    let x <.T> sort_get_unchecked_data<.T> data_ptr i0;
                    sort_buf_set<.T> buf i0 x;
                    set i0 add i0 1;

            let mut i <i32> l;
            let mut j <i32> mid;
            let mut k <i32> l;

            let mut done_merge <i32> 0;
            while eq done_merge 0:
                do:
                    let left_open <bool> lt i mid;
                    let right_open <bool> lt j r;
                    if:
                        and left_open right_open
                        then:
                            let a <.T> sort_buf_get<.T> buf i;
                            let b <.T> sort_buf_get<.T> buf j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_set_unchecked_data<.T> data_ptr k b;
                                    set j add j 1;
                                    ()
                                else:
                                    sort_set_unchecked_data<.T> data_ptr k a;
                                    set i add i 1;
                                    ();
                            set k add k 1;
                            ()
                        else set done_merge 1

            while lt i mid:
                do:
                    let a <.T> sort_buf_get<.T> buf i;
                    sort_set_unchecked_data<.T> data_ptr k a;
                    set i add i 1;
                    set k add k 1;

            while lt j r:
                do:
                    let b <.T> sort_buf_get<.T> buf j;
                    sort_set_unchecked_data<.T> data_ptr k b;
                    set j add j 1;
                    set k add k 1;

            ()

//: ## sort_merge
//: `Vec<.T>` を merge sort で[破壊的/はかいてき]に[整列/せいれつ]する
//:
//: ### [目的/もくてき]
//: - [安定/あんてい]な O(n log n) sort として `Vec<.T>` を[昇順/しょうじゅん]へ[並/なら]べ[替/か]えます。
//:
//: ### [使用例/しようれい]
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     match sort_merge<i32> v:
//:         Result::Ok _:
//:             0
//:         Result::Err _:
//:             1
//: ```
//:
//: ### [実装/じっそう]
//: - `Vec` の `data` を raw address へ[下/お]ろし、`.T` [配列/はいれつ] 1 [本分/ほんぶん]の[作業/さぎょう] buffer を `alloc_ptr<.T>` で[確保/かくほ]して `sort_merge_range_data` を[呼/よ]びます。
//:
//: ### [注意/ちゅうい]
//: - [作業/さぎょう] buffer [確保/かくほ]や[解放/かいほう]に[失敗/しっぱい]した[場合/ばあい]は `Err(StdErrorKind)` を[返/かえ]します。
//: - ソートは in-place なので `v` の[並/なら]び[順/じゅん]は[関数/かんすう][呼/よ]び[出/だ]し[後/ご]に[変更/へんこう]されます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n log n)、[追加/ついか][空間/くうかん][計算量/けいさんりょう]は O(n) です。
fn sort_merge <.T: Ord> <(Vec<.T>)*>Result<(), StdErrorKind>> (v):
    let n <i32> get v "len"
    let data_ptr <i32> mem_ptr_addr get v "data"
    if:
        le n 1
        then Result<(), StdErrorKind>::Ok ()
        else:
            match alloc_ptr<.T> mul n size_of<.T>:
                Result::Err _e:
                    Result<(), StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok buf:
                    sort_merge_range_data<.T> data_ptr buf 0 n;
                    match dealloc_ptr<.T> buf mul n size_of<.T>:
                        Result::Err _e:
                            Result<(), StdErrorKind>::Err StdErrorKind::Failure
                        Result::Ok _:
                            Result<(), StdErrorKind>::Ok ()

//: sort_slice_quick: 生ポインタ配列を quick sort で並べ替える
//:
//: [目的/もくてき]:
//: - `data_ptr` から始まる長さ `len` の連続領域を in-place で昇順ソートします。
//:
//: [実装/じっそう]:
//: - `sort_quick_range_data` を直接呼び出す薄いラッパです。
//:
//: [注意/ちゅうい]:
//: - `data_ptr` は `.T` の `len` 要素ぶん有効である必要があります。
//: - メモリ所有権・境界チェックは呼び出し側が管理します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n), 最悪 O(n^2)
fn sort_slice_quick <.T: Ord> <(i32,i32)->()> (data_ptr, len):
    if:
        le len 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub len 1;
            ()

//: sort_i32: `i32` 配列ポインタを in-place で昇順ソートする
//:
//: [目的/もくてき]:
//: - 競技プログラミング向けに `sort_i32(ptr, n)` の薄い API を提供します。
//:
//: [実装/じっそう]:
//: - `sort_slice_quick<i32>` を呼び出します。
//:
//: [注意/ちゅうい]:
//: - `data_ptr` は `n` 個の `i32` が格納された有効な領域である必要があります。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n), 最悪 O(n^2)
fn sort_i32 <(i32,i32)->()> (data_ptr, n):
    sort_slice_quick<i32> data_ptr n

//: sort_quick_ret: quick sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_quick` を呼んだあと `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
fn sort_quick_ret <.T: Ord> <(Vec<.T>)->Vec<.T>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> mem_ptr_addr data_ptr 0 sub n 1;
            ()
    Vec<.T> n cap data_ptr

//: sort_heap_ret: heap sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_heap` を呼んだあと `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_heap` と同じです。
fn sort_heap_ret <.T: Ord> <(Vec<.T>)->Vec<.T>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then ()
        else:
            let n_minus_two <i32> sub n 2;
            let mut start <i32> div_s n_minus_two 2;
            while ge start 0:
                do:
                    sort_heap_sift_down_data<.T> mem_ptr_addr data_ptr start n;
                    set start sub start 1;

            let mut end <i32> sub n 1;
            while gt end 0:
                do:
                    sort_swap_data<.T> mem_ptr_addr data_ptr 0 end;
                    sort_heap_sift_down_data<.T> mem_ptr_addr data_ptr 0 end;
                    set end sub end 1;
            ()
    Vec<.T> n cap data_ptr

//: sort_merge_ret: merge sort 後の Vec を Result で返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を `Ok` で返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_merge` と同じ作業 buffer 確保と `sort_merge_range_data` を使い、確保/解放失敗を `Err(StdErrorKind)` として伝播します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//: - `Err` の場合、入力 `Vec` は関数へ移動済みで呼び出し側へ戻りません。
//:
//: [計算量/けいさんりょう]:
//: - `sort_merge` と同じです。
fn sort_merge_ret <.T: Ord> <(Vec<.T>)*>Result<Vec<.T>, StdErrorKind>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then Result<Vec<.T>, StdErrorKind>::Ok Vec<.T> n cap data_ptr
        else:
            match alloc_ptr<.T> mul n size_of<.T>:
                Result::Err _e:
                    Result<Vec<.T>, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok buf:
                    sort_merge_range_data<.T> mem_ptr_addr data_ptr buf 0 n;
                    match dealloc_ptr<.T> buf mul n size_of<.T>:
                        Result::Err _e:
                            Result<Vec<.T>, StdErrorKind>::Err StdErrorKind::Failure
                        Result::Ok _:
                            Result<Vec<.T>, StdErrorKind>::Ok Vec<.T> n cap data_ptr


// sort: デフォルトは quick sort
//: sort: 主な用途
//:
//: [目的/もくてき]:
//: - sort の主な用途と呼び出し方を示します。
//:
//: [実装/じっそう]:
//: - 定義済み処理をそのまま呼び出す薄いラッパで構成されています。
//:
//: [注意/ちゅうい]:
//: - 引数の値は関数呼び出しで移動するため、再利用時は束縛し直してください。
//:
//: [計算量/けいさんりょう]:
//: - 本体処理に準じます。
fn sort <.T: Ord> <(Vec<.T>)->()> (v):
    sort_quick<.T> v
