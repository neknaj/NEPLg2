//: sort: `Vec` と raw slice の in-place sort algorithms
//:
//: [目的/もくてき]:
//: - `Ord` を持つ `Vec<.T>` を昇順へ並べ替える複数の in-place sort algorithm を提供します。
//: - 小規模・教育用の insertion / selection / bubble 系、汎用の quick / heap、安定 sort が必要な merge を同じ比較規約で扱います。
//:
//: [注意/ちゅうい]:
//: - 多くの内部 helper は raw data pointer と unchecked index を使います。公開 API は `Vec` の `len` から範囲を作り、helper へ渡します。
//: - `sort_quick` / `sort_heap` / `sort` は追加確保なしで in-place に変更します。`sort_merge` は O(n) の作業 buffer を確保します。
//: - 現在の `Vec` raw storage model では、所有権を持つ non-Copy payload の扱いは Resource IR 移行 issue の制約を受けます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let sorted <Vec<i32>> sort_quick_ret<i32> unsorted
//:     let ok <bool> sort_is_sorted<i32> &sorted
//:     free<i32> sorted
//:     if ok 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 4 |> uwok
//:         |> push 3 |> uwok
//:         |> push 2 |> uwok
//:         |> push 1 |> uwok
//:     let sorted <Vec<i32>> unwrap_ok<Vec<i32>, StdErrorKind> sort_merge_ret<i32> unsorted
//:     let ok <bool> sort_is_sorted<i32> &sorted
//:     free<i32> sorted
//:     if ok 1 0
//: ```

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/cast" as *
#import "core/result" as *
#import "core/traits/ord" as *
#import "alloc/collections/vec" as *
#import "alloc/diag/error" as *


//: sort_lt: sort 内部の strict less-than predicate
//:
//: [目的/もくてき]:
//: - `Ord` の `<` 判定を sort algorithm から呼びやすい名前で提供します。
//: - quick / heap / insertion などの比較規約を 1 箇所にそろえます。
//:
//: [実装/じっそう]:
//: - `ord_lt` に委譲します。
//:
//: [注意/ちゅうい]:
//: - `Ord` 実装が全順序であることを前提にします。矛盾した比較は sort 結果を不安定にします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_lt <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_lt a b

//: sort_le: sort 内部の less-or-equal predicate
//:
//: [目的/もくてき]:
//: - partition や stable merge で「右より大きくない」ことを判定します。
//:
//: [実装/じっそう]:
//: - `ord_le` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_le <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_le a b

//: sort_gt: sort 内部の greater-than predicate
//:
//: [目的/もくてき]:
//: - 降順側の比較や heap 条件の説明で使える `>` 判定を提供します。
//:
//: [実装/じっそう]:
//: - `ord_gt` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_gt <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_gt a b

//: sort_ge: sort 内部の greater-or-equal predicate
//:
//: [目的/もくてき]:
//: - 境界条件の比較を `Ord` の名前空間へそろえます。
//:
//: [実装/じっそう]:
//: - `ord_ge` に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_ge <.T: Ord> <(.T,.T)->bool> (a, b):
    ord_ge a b


//: sort_get_unchecked: `Vec` storage から index を検査せずに読む
//:
//: [目的/もくてき]:
//: - sort loop 内で `Vec` の `data` から `.T` を高速に読み出します。
//:
//: [実装/じっそう]:
//: - `data_ptr(v) + idx * size_of<.T>` を typed `load<.T>` します。
//:
//: [注意/ちゅうい]:
//: - `0 <= idx < len(v)` を呼び出し側が保証する内部 helper です。
//: - 所有権を持つ payload の typed load は Resource IR 移行の制約を受けます。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_get_unchecked <.T> <(&Vec<.T>,i32)->.T> (v, idx):
    let data <i32> data_ptr<.T> v
    let off <i32> mul idx size_of<.T>
    load<.T> add data off

//: sort_set_unchecked: `Vec` storage へ index を検査せずに書く
//:
//: [目的/もくてき]:
//: - sort loop 内で `.T` を指定 index へ書き戻します。
//:
//: [実装/じっそう]:
//: - `data_ptr(v) + idx * size_of<.T>` を typed `store<.T>` します。
//:
//: [注意/ちゅうい]:
//: - `0 <= idx < len(v)` と上書き時の drop 義務を呼び出し側が保証する内部 helper です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_set_unchecked <.T> <(&Vec<.T>,i32,.T)->()> (v, idx, val):
    let data <i32> data_ptr<.T> v
    let off <i32> mul idx size_of<.T>
    store<.T> add data off val;
    ()

// sort_get_unchecked_data: data ポインタ版の取得
fn sort_get_unchecked_data <.T> <(MemPtr<.T>,i32)->.T> (data_ptr, idx):
    let off <i32> mul idx size_of<.T>
    load<.T> add mem_ptr_addr data_ptr off

// sort_set_unchecked_data: data ポインタ版の設定
fn sort_set_unchecked_data <.T> <(MemPtr<.T>,i32,.T)->()> (data_ptr, idx, val):
    let off <i32> mul idx size_of<.T>
    store<.T> add mem_ptr_addr data_ptr off val;
    ()

// sort_swap_data: data ポインタ版の交換
fn sort_swap_data <.T> <(MemPtr<.T>,i32,i32)->()> (data_ptr, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked_data<.T> data_ptr i
            let b <.T> sort_get_unchecked_data<.T> data_ptr j
            sort_set_unchecked_data<.T> data_ptr i b;
            sort_set_unchecked_data<.T> data_ptr j a;
            ()


//: sort_swap: `Vec` の 2 要素を入れ替える
//:
//: [目的/もくてき]:
//: - sort algorithm が見つけた 2 つの index の値を交換します。
//:
//: [実装/じっそう]:
//: - 2 要素を unchecked load で読み、逆順に unchecked store します。
//:
//: [注意/ちゅうい]:
//: - `i` と `j` が同じ場合は何もしません。
//: - 両 index は `Vec` の範囲内である必要があります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn sort_swap <.T> <(&Vec<.T>,i32,i32)->()> (v, i, j):
    if:
        eq i j
        then ()
        else:
            let a <.T> sort_get_unchecked<.T> v i
            let b <.T> sort_get_unchecked<.T> v j
            sort_set_unchecked<.T> v i b;
            sort_set_unchecked<.T> v j a;
            ()

//: sort_is_sorted: `Vec` が昇順か確認する
//:
//: [目的/もくてき]:
//: - 隣接要素を左から右へ比較し、昇順に並んでいるかを返します。
//: - sort doctest と caller-side assertion のための軽量 verifier です。
//:
//: [実装/じっそう]:
//: - `right < left` になる隣接 pair が 1 つでもあれば `false` を返します。
//:
//: [注意/ちゅうい]:
//: - equal element は昇順として許可されます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn sort_is_sorted <.T: Ord> <(&Vec<.T>)->bool> (v):
    let n <i32> len<.T> v
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
    if:
        le n 1
        then true
        else:
            let mut i <i32> 1
            let mut ok <bool> true
            while and ok lt i n:
                do:
                    let a <.T> sort_get_unchecked_data<.T> data_ptr sub i 1;
                    let b <.T> sort_get_unchecked_data<.T> data_ptr i;
                    if:
                        sort_lt<.T> b a
                        then set ok false
                        else ()
                    set i add i 1;
            ok


// -----------------------------------------------------------------------------
// 1) Insertion sort
// -----------------------------------------------------------------------------
//: sort_insertion: insertion sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 小さい `Vec` やほぼ整列済みの入力を単純な in-place algorithm で昇順にします。
//:
//: [実装/じっそう]:
//: - 左側を整列済み prefix とみなし、現在要素を左へずらしながら挿入位置へ移動します。
//:
//: [注意/ちゅうい]:
//: - 追加 allocation はありません。実装上は equal element を追い越さないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)、ほぼ整列済みでは O(n) に近づきます。
fn sort_insertion <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1
            while lt i n:
                do:
                    let key <.T> sort_get_unchecked<.T> v i;
                    let mut j <i32> sub i 1;

                    let mut done <i32> 0;
                    while eq done 0:
                        do:
                            if:
                                and le 0 j sort_lt<.T> key sort_get_unchecked<.T> v j
                                then:
                                    let x <.T> sort_get_unchecked<.T> v j;
                                    sort_set_unchecked<.T> v add j 1 x;
                                    set j sub j 1;
                                else set done 1
                    sort_set_unchecked<.T> v add j 1 key;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 2) Selection sort
// -----------------------------------------------------------------------------
//: sort_selection: selection sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 未整列 suffix から最小要素を選び、先頭へ交換しながら昇順にします。
//:
//: [実装/じっそう]:
//: - 各位置 `i` について `[i, n)` の最小 index を探し、`i` と交換します。
//:
//: [注意/ちゅうい]:
//: - 交換で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 比較 O(n^2)、追加領域 O(1)
fn sort_selection <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 0
            while lt i n:
                do:
                    let mut min_idx <i32> i;
                    let mut j <i32> add i 1;
                    while lt j n:
                        do:
                            let a <.T> sort_get_unchecked<.T> v j;
                            let b <.T> sort_get_unchecked<.T> v min_idx;
                            if:
                                sort_lt<.T> a b
                                then set min_idx j
                                else ()
                            set j add j 1;
                    sort_swap<.T> v i min_idx;
                    set i add i 1;
            ()


// -----------------------------------------------------------------------------
// 3) Bubble sort
// -----------------------------------------------------------------------------
//: sort_bubble: bubble sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 隣接交換だけで大きい要素を右端へ送る単純な sort を提供します。
//:
//: [実装/じっそう]:
//: - `[0, end]` を走査し、右要素が左要素より小さい pair を交換して `end` を縮めます。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - O(n^2)
fn sort_bubble <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut end <i32> sub n 1;
            while lt 0 end:
                do:
                    let mut i <i32> 0;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then sort_swap<.T> v i add i 1
                                else ()
                            set i add i 1;
                    set end sub end 1;
            ()


// -----------------------------------------------------------------------------
// 4) Cocktail shaker sort
// -----------------------------------------------------------------------------
//: sort_cocktail: cocktail shaker sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 左右両方向の bubble pass で、小さい要素と大きい要素を同時に端へ寄せます。
//:
//: [実装/じっそう]:
//: - forward pass で最大側を右へ、backward pass で最小側を左へ送ります。
//: - 交換が起きなければ残り区間は整列済みとして終了します。
//:
//: [注意/ちゅうい]:
//: - equal element は交換しないため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)
fn sort_cocktail <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut start <i32> 0;
            let mut end <i32> sub n 1;
            let mut swapped <i32> 1;

            while and eq swapped 1 lt start end:
                do:
                    set swapped 0;

                    // forward pass
                    let mut i <i32> start;
                    while lt i end:
                        do:
                            let a <.T> sort_get_unchecked<.T> v i;
                            let b <.T> sort_get_unchecked<.T> v add i 1;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v i add i 1;
                                    set swapped 1;
                                    ()
                                else ()
                            set i add i 1;

                    set end sub end 1;

                    if:
                        eq swapped 0
                        then set start end
                        else:
                            set swapped 0;

                    // backward pass
                    let mut j <i32> end;
                    while lt start j:
                        do:
                            let a <.T> sort_get_unchecked<.T> v sub j 1;
                            let b <.T> sort_get_unchecked<.T> v j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_swap<.T> v sub j 1 j;
                                    set swapped 1;
                                    ()
                                else ()
                            set j sub j 1;

                    set start add start 1;
            ()


// -----------------------------------------------------------------------------
// 5) Gnome sort
// -----------------------------------------------------------------------------
//: sort_gnome: gnome sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - 隣接要素を見ながら、逆順 pair を交換して左へ戻る単純な insertion 系 sort を提供します。
//:
//: [実装/じっそう]:
//: - 現在位置が正しい順序なら右へ進み、逆順なら隣接交換して左へ 1 つ戻ります。
//:
//: [注意/ちゅうい]:
//: - equal element は `sort_le` で通過するため stable です。
//:
//: [計算量/けいさんりょう]:
//: - 平均 / 最悪 O(n^2)
fn sort_gnome <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut i <i32> 1;
            while lt i n:
                do:
                    if:
                        or eq i 0 sort_le<.T> sort_get_unchecked<.T> v sub i 1 sort_get_unchecked<.T> v i
                        then set i add i 1
                        else:
                            sort_swap<.T> v i sub i 1;
                            set i sub i 1;
                    ();
            ()


// -----------------------------------------------------------------------------
// 6) Shell sort
// -----------------------------------------------------------------------------
//: sort_shell: shell sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - gap insertion sort を繰り返し、単純 insertion sort より少ない移動で広い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `n / 2` から始め、各 pass 後に半分へ縮めます。
//: - 各 gap pass は gap ごとの insertion sort として動きます。
//:
//: [注意/ちゅうい]:
//: - gap 越しの移動で equal element の相対順が崩れるため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - gap 列に依存します。この実装では最悪 O(n^2)、追加領域 O(1) です。
fn sort_shell <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> div_s n 2;

            while lt 0 gap:
                do:
                    let mut i <i32> gap;
                    while lt i n:
                        do:
                            let temp <.T> sort_get_unchecked<.T> v i;
                            let mut j <i32> i;

                            let mut done <i32> 0;
                            while eq done 0:
                                do:
                                    if:
                                        and le gap j sort_lt<.T> temp sort_get_unchecked<.T> v sub j gap
                                        then:
                                            let x <.T> sort_get_unchecked<.T> v sub j gap;
                                            sort_set_unchecked<.T> v j x;
                                            set j sub j gap;
                                        else set done 1

                            sort_set_unchecked<.T> v j temp;
                            set i add i 1;
                    set gap div_s gap 2;
            ()


// -----------------------------------------------------------------------------
// 7) Comb sort
// -----------------------------------------------------------------------------
//: sort_comb: comb sort で in-place 整列する
//:
//: [目的/もくてき]:
//: - bubble sort の gap を広げた variant として、遠い逆転を先に解消します。
//:
//: [実装/じっそう]:
//: - gap を `gap * 10 / 13` で縮め、gap 1 で交換がなくなるまで走査します。
//:
//: [注意/ちゅうい]:
//: - gap 越しに交換するため stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 平均は bubble sort より改善しますが、最悪 O(n^2) です。
fn sort_comb <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    if:
        le n 1
        then ()
        else:
            let mut gap <i32> n;
            let mut sorted <i32> 0;

            while eq sorted 0:
                do:
                    // gap = floor(gap * 10 / 13)
                    let scaled_gap <i32> mul gap 10;
                    let reduced_gap <i32> div_s scaled_gap 13;
                    set gap reduced_gap;
                    if:
                        lt gap 1
                        then set gap 1
                        else ()

                    if:
                        eq gap 1
                        then set sorted 1
                        else ()

                    let mut i <i32> 0;
                    let mut done_scan <i32> 0;
                    while eq done_scan 0:
                        do:
                            let next_i <i32> add i gap;
                            if:
                                lt next_i n
                                then:
                                    let a <.T> sort_get_unchecked<.T> v i;
                                    let b <.T> sort_get_unchecked<.T> v next_i;
                                    if:
                                        sort_lt<.T> b a
                                        then:
                                            sort_swap<.T> v i next_i;
                                            set sorted 0;
                                            ()
                                        else ()
                                    set i add i 1;
                                    ()
                                else set done_scan 1
            ()


// -----------------------------------------------------------------------------
// 8) Quick sort (Lomuto partition)
// -----------------------------------------------------------------------------
//: sort_quick_partition_data: Lomuto partition で pivot 位置を決める
//:
//: [目的/もくてき]:
//: - raw data pointer 上の `[lo, hi]` 区間を pivot 以下 / pivot より大きい要素へ分割します。
//: - partition 後の pivot index を返し、quick sort の再帰境界に使います。
//:
//: [実装/じっそう]:
//: - 末尾 `hi` の値を pivot とし、`sort_le(x, pivot)` を満たす値を左側へ交換します。
//:
//: [注意/ちゅうい]:
//: - `lo <= hi` と区間が有効な raw storage 内にあることを呼び出し側が保証します。
//: - Lomuto partition なので equal element が多い入力では分割が偏ることがあります。
//:
//: [計算量/けいさんりょう]:
//: - O(hi - lo + 1)
fn sort_quick_partition_data <.T: Ord> <(MemPtr<.T>,i32,i32)->i32> (data_ptr, lo, hi):
    let pivot <.T> sort_get_unchecked_data<.T> data_ptr hi
    let mut i <i32> lo;
    let mut j <i32> lo;

    while lt j hi:
        do:
            let x <.T> sort_get_unchecked_data<.T> data_ptr j;
            if:
                sort_le<.T> x pivot
                then:
                    sort_swap_data<.T> data_ptr i j;
                    set i add i 1;
                    ()
                else ()
            set j add j 1;

    sort_swap_data<.T> data_ptr i hi;
    i

//: sort_quick_range_data: raw slice 区間を quick sort する
//:
//: [目的/もくてき]:
//: - raw data pointer 上の `[lo, hi]` 区間を Lomuto quick sort で昇順にします。
//:
//: [実装/じっそう]:
//: - `sort_quick_partition_data` で pivot を確定し、左右区間へ再帰します。
//:
//: [注意/ちゅうい]:
//: - recursion depth は pivot の偏りに依存します。整列済みや equal-heavy な入力では深くなります。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n)、最悪 O(n^2)
fn sort_quick_range_data <.T: Ord> <(MemPtr<.T>,i32,i32)->()> (data_ptr, lo, hi):
    if:
        lt lo hi
        then:
            let p <i32> sort_quick_partition_data<.T> data_ptr lo hi;
            sort_quick_range_data<.T> data_ptr lo sub p 1;
            sort_quick_range_data<.T> data_ptr add p 1 hi;
            ()
        else ()

//: sort_quick: quick sort で `Vec` を in-place 整列する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの既定候補として `Vec` を昇順に並べ替えます。
//:
//: [実装/じっそう]:
//: - `Vec` の `data` と `len` から raw slice 区間を作り、`sort_quick_range_data` を呼びます。
//:
//: [注意/ちゅうい]:
//: - stable ではありません。
//: - 最悪 O(n^2) と recursion depth の偏りがあるため、入力分布が悪い場合は `sort_heap` や `sort_merge` を検討します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n)、最悪 O(n^2)、追加領域は recursion stack です。
fn sort_quick <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub n 1;
            ()


// -----------------------------------------------------------------------------
// 9) Heap sort (max-heap)
// -----------------------------------------------------------------------------
//: sort_heap_sift_down_data: max-heap の root を下へ沈める
//:
//: [目的/もくてき]:
//: - heap sort の heapify と extraction 後の復元で、`start` から `end` までの heap 条件を回復します。
//:
//: [実装/じっそう]:
//: - root と左右 child を比較し、最大 child と交換しながら下へ進みます。
//:
//: [注意/ちゅうい]:
//: - `[0, end)` が有効な raw storage 内にあることを呼び出し側が保証します。
//:
//: [計算量/けいさんりょう]:
//: - O(log n)
fn sort_heap_sift_down_data <.T: Ord> <(MemPtr<.T>,i32,i32)->()> (data_ptr, start, end):
    let mut root <i32> start;
    let mut done <i32> 0;

    while eq done 0:
        do:
            let doubled_root <i32> mul root 2;
            let child <i32> add doubled_root 1;
            if:
                lt child end
                then:
                    let mut swap_idx <i32> root;

                    let swap_v <.T> sort_get_unchecked_data<.T> data_ptr swap_idx;
                    let child_v <.T> sort_get_unchecked_data<.T> data_ptr child;
                    if:
                        sort_lt<.T> swap_v child_v
                        then set swap_idx child
                        else ()

                    let right <i32> add child 1;
                    if:
                        lt right end
                        then:
                            let swap_v2 <.T> sort_get_unchecked_data<.T> data_ptr swap_idx;
                            let right_v <.T> sort_get_unchecked_data<.T> data_ptr right;
                            if:
                                sort_lt<.T> swap_v2 right_v
                                then set swap_idx right
                                else ()
                            ()
                        else ()

                    if:
                        eq swap_idx root
                        then set done 1
                        else:
                            sort_swap_data<.T> data_ptr root swap_idx;
                            set root swap_idx;
                            ();
                    ()
                else set done 1

    ()

//: sort_heap: heap sort で `Vec` を in-place 整列する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしで O(n log n) の最悪計算量を持つ昇順 sort を提供します。
//:
//: [実装/じっそう]:
//: - まず max-heap を構築し、最大値を末尾へ交換して heap 範囲を縮めます。
//:
//: [注意/ちゅうい]:
//: - stable ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(n log n)、追加領域 O(1)
fn sort_heap <.T: Ord> <(&Vec<.T>)->()> (v):
    let n <i32> len<.T> v
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
    if:
        le n 1
        then ()
        else:
            let n_minus_two <i32> sub n 2;
            let mut start <i32> div_s n_minus_two 2;
            let mut done0 <i32> 0;
            while eq done0 0:
                do:
                    if:
                        lt start 0
                        then set done0 1
                        else:
                            sort_heap_sift_down_data<.T> data_ptr start n;
                            set start sub start 1;
                            ();
            let mut end <i32> sub n 1;
            while lt 0 end:
                do:
                    sort_swap_data<.T> data_ptr 0 end;
                    sort_heap_sift_down_data<.T> data_ptr 0 end;
                    set end sub end 1;
            ()


// -----------------------------------------------------------------------------
// 10) Merge sort (top-down)
// -----------------------------------------------------------------------------
//: ## sort_buf_get
//: merge sort [用/よう]の[作業/さぎょう] buffer から[値/あたい]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `sort_merge_range_data` が[一時/いちじ] buffer に[退避/たいひ]した[要素/ようそ]を、`MemPtr<.T>` [基準/きじゅん]で[取/と]り[出/だ]せるようにします。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` で byte offset を[計算/けいさん]し、buffer [先頭/せんとう]から `load<.T>` します。
//:
//: ### [注意/ちゅうい]
//: - `buf` は `.T` の[配列/はいれつ]として[有効/ゆうこう]である[必要/ひつよう]があります。
//: - `idx` の[境界/きょうかい][確認/かくにん]は[呼/よ]び[出/だ]し[側/がわ]が[担当/たんとう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
fn sort_buf_get <.T> <(MemPtr<.T>,i32)->.T> (buf, idx):
    let off <i32> mul idx size_of<.T>
    load<.T> add mem_ptr_addr buf off

//: ## sort_buf_set
//: merge sort [用/よう]の[作業/さぎょう] buffer へ[値/あたい]を[書/か]く
//:
//: ### [目的/もくてき]
//: - [一時/いちじ] buffer に[現在/げんざい]の[要素/ようそ][列/れつ]を[複写/ふくしゃ]し、merge [中/ちゅう]に[安定/あんてい]した[読/よ]み[取/と]り[元/もと]を[確保/かくほ]します。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` を[求/もと]め、buffer [先頭/せんとう]から `store<.T>` します。
//:
//: ### [注意/ちゅうい]
//: - `buf` は `.T` の[配列/はいれつ]として[有効/ゆうこう]である[必要/ひつよう]があります。
//: - `val` は `store<.T>` によって buffer へ[書/か]き[込/こ]まれます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
fn sort_buf_set <.T> <(MemPtr<.T>,i32,.T)->()> (buf, idx, val):
    let off <i32> mul idx size_of<.T>
    store<.T> add mem_ptr_addr buf off val;
    ()

//: ## sort_merge_range_data
//: merge sort の 1 [区間/くかん]を[再帰的/さいきてき]に[統合/とうごう]する
//:
//: ### [目的/もくてき]
//: - `data_ptr` が[指/さ]す `[l, r)` [区間/くかん]を merge sort で[整列/せいれつ]します。
//: - [比較元/ひかくもと]を[壊/こわ]さないため、`buf` に[現在/げんざい]の[内容/ないよう]を[退避/たいひ]してから[統合/とうごう]します。
//:
//: ### [実装/じっそう]
//: - [中央/ちゅうおう] `mid` で 2 [分割/ぶんかつ]し、[左右/さゆう]を[再帰的/さいきてき]に sort したあと、`buf` に[複写/ふくしゃ]した[要素/ようそ]を 2 [本/ほん]の[読/よ]み[取/と]り[位置/いち]で merge します。
//:
//: ### [注意/ちゅうい]
//: - `data_ptr` と `buf` は `.T` を `r` [個分/こぶん]まで[安全/あんぜん]に[読/よ]み[書/か]きできる[領域/りょういき]である[必要/ひつよう]があります。
//: - [境界/きょうかい][確認/かくにん]は[内部/ないぶ]で[省略/しょうりゃく]しているため、`l <= r` と[十分/じゅうぶん]な[容量/ようりょう]は[呼/よ]び[出/だ]し[側/がわ]の[責任/せきにん]です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n log n)、[追加/ついか][空間/くうかん][計算量/けいさんりょう]は O(n) です。
fn sort_merge_range_data <.T: Ord> <(MemPtr<.T>,MemPtr<.T>,i32,i32)->()> (data_ptr, buf, l, r):
    let width <i32> sub r l;
    if:
        le width 1
        then ()
        else:
            let lr_sum <i32> add l r;
            let mid <i32> div_s lr_sum 2;
            sort_merge_range_data<.T> data_ptr buf l mid;
            sort_merge_range_data<.T> data_ptr buf mid r;

            let mut i0 <i32> l;
            while lt i0 r:
                do:
                    let x <.T> sort_get_unchecked_data<.T> data_ptr i0;
                    sort_buf_set<.T> buf i0 x;
                    set i0 add i0 1;

            let mut i <i32> l;
            let mut j <i32> mid;
            let mut k <i32> l;

            let mut done_merge <i32> 0;
            while eq done_merge 0:
                do:
                    let left_open <bool> lt i mid;
                    let right_open <bool> lt j r;
                    if:
                        and left_open right_open
                        then:
                            let a <.T> sort_buf_get<.T> buf i;
                            let b <.T> sort_buf_get<.T> buf j;
                            if:
                                sort_lt<.T> b a
                                then:
                                    sort_set_unchecked_data<.T> data_ptr k b;
                                    set j add j 1;
                                    ()
                                else:
                                    sort_set_unchecked_data<.T> data_ptr k a;
                                    set i add i 1;
                                    ();
                            set k add k 1;
                            ()
                        else set done_merge 1

            while lt i mid:
                do:
                    let a <.T> sort_buf_get<.T> buf i;
                    sort_set_unchecked_data<.T> data_ptr k a;
                    set i add i 1;
                    set k add k 1;

            while lt j r:
                do:
                    let b <.T> sort_buf_get<.T> buf j;
                    sort_set_unchecked_data<.T> data_ptr k b;
                    set j add j 1;
                    set k add k 1;

            ()

//: ## sort_merge
//: `Vec<.T>` を merge sort で[破壊的/はかいてき]に[整列/せいれつ]する
//:
//: ### [目的/もくてき]
//: - [安定/あんてい]な O(n log n) sort として `Vec<.T>` を[昇順/しょうじゅん]へ[並/なら]べ[替/か]えます。
//:
//: ### [使用例/しようれい]
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     match sort_merge<i32> &v:
//:         Result::Ok _:
//:             free<i32> v
//:             0
//:         Result::Err _:
//:             free<i32> v
//:             1
//: ```
//:
//: ### [実装/じっそう]
//: - `Vec` の `data` を raw address へ[下/お]ろし、`.T` [配列/はいれつ] 1 [本分/ほんぶん]の[作業/さぎょう] buffer を `alloc_ptr<.T>` で[確保/かくほ]して `sort_merge_range_data` を[呼/よ]びます。
//:
//: ### [注意/ちゅうい]
//: - [作業/さぎょう] buffer [確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Err(StdErrorKind)` を[返/かえ]します。
//: - [確保済/かくほず]みの[作業/さぎょう] buffer は owner invariant に[基/もと]づいて `dealloc_raw` で[解放/かいほう]します。
//: - ソートは in-place なので `v` の[並/なら]び[順/じゅん]は[関数/かんすう][呼/よ]び[出/だ]し[後/ご]に[変更/へんこう]されます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n log n)、[追加/ついか][空間/くうかん][計算量/けいさんりょう]は O(n) です。
fn sort_merge <.T: Ord> <(&Vec<.T>)*>Result<(), StdErrorKind>> (v):
    let n <i32> len<.T> v
    let data_ptr <MemPtr<.T>> data_mem_ptr<.T> v
    if:
        le n 1
        then Result<(), StdErrorKind>::Ok ()
        else:
            match alloc_ptr<.T> mul n size_of<.T>:
                Result::Err _e:
                    Result<(), StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok buf:
                    sort_merge_range_data<.T> data_ptr buf 0 n;
                    dealloc_raw mem_ptr_addr buf mul n size_of<.T>
                    Result<(), StdErrorKind>::Ok ()

//: sort_slice_quick: `MemPtr` 配列を quick sort で並べ替える
//:
//: [目的/もくてき]:
//: - `data_ptr` から始まる長さ `len` の typed 連続領域を in-place で昇順ソートします。
//:
//: [実装/じっそう]:
//: - `sort_quick_range_data` へ raw slice の開始位置と長さを渡す小さな adapter です。
//:
//: [注意/ちゅうい]:
//: - `data_ptr` は `.T` の `len` 要素ぶん有効である必要があります。
//: - メモリ所有権・境界チェックは呼び出し側が管理します。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n), 最悪 O(n^2)
fn sort_slice_quick <.T: Ord> <(MemPtr<.T>,i32)->()> (data_ptr, len):
    if:
        le len 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub len 1;
            ()

//: sort_i32: `i32` 配列 `MemPtr` を in-place で昇順ソートする
//:
//: [目的/もくてき]:
//: - 競技プログラミング向けに `sort_i32(ptr, n)` の薄い API を提供します。
//:
//: [実装/じっそう]:
//: - `sort_slice_quick<i32>` を呼び出します。
//:
//: [注意/ちゅうい]:
//: - `data_ptr` は `n` 個の `i32` が格納された有効な領域である必要があります。
//:
//: [計算量/けいさんりょう]:
//: - 平均 O(n log n), 最悪 O(n^2)
fn sort_i32 <(MemPtr<i32>,i32)->()> (data_ptr, n):
    sort_slice_quick<i32> data_ptr n

//: sort_quick_ret: quick sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_quick` を呼んだあと `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
fn sort_quick_ret <.T: Ord> <(Vec<.T>)->Vec<.T>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let storage <VecStorageState> get v "storage"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then ()
        else:
            sort_quick_range_data<.T> data_ptr 0 sub n 1;
            ()
    Vec<.T> n cap storage data_ptr

//: sort_heap_ret: heap sort 後の Vec を返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_heap` を呼んだあと `v` をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//:
//: [計算量/けいさんりょう]:
//: - `sort_heap` と同じです。
fn sort_heap_ret <.T: Ord> <(Vec<.T>)->Vec<.T>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let storage <VecStorageState> get v "storage"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then ()
        else:
            let n_minus_two <i32> sub n 2;
            let mut start <i32> div_s n_minus_two 2;
            while ge start 0:
                do:
                    sort_heap_sift_down_data<.T> data_ptr start n;
                    set start sub start 1;

            let mut end <i32> sub n 1;
            while gt end 0:
                do:
                    sort_swap_data<.T> data_ptr 0 end;
                    sort_heap_sift_down_data<.T> data_ptr 0 end;
                    set end sub end 1;
            ()
    Vec<.T> n cap storage data_ptr

//: sort_merge_ret: merge sort 後の Vec を Result で返す
//:
//: [目的/もくてき]:
//: - 破壊的ソートを行った同じ `Vec` を `Ok` で返し、後続処理で検証や連結処理をしやすくします。
//:
//: [実装/じっそう]:
//: - `sort_merge` と同じ作業 buffer 確保と `sort_merge_range_data` を使い、確保失敗を `Err(StdErrorKind)` として伝播します。
//: - [確保済/かくほず]みの[作業/さぎょう] buffer は owner invariant に[基/もと]づいて `dealloc_raw` で[解放/かいほう]します。
//:
//: [注意/ちゅうい]:
//: - ソート自体は in-place です。
//: - `Err` の場合、入力 `Vec` は関数へ移動済みで呼び出し側へ戻りません。
//:
//: [計算量/けいさんりょう]:
//: - `sort_merge` と同じです。
fn sort_merge_ret <.T: Ord> <(Vec<.T>)*>Result<Vec<.T>, StdErrorKind>> (v):
    let n <i32> get v "len"
    let cap <i32> get v "cap"
    let storage <VecStorageState> get v "storage"
    let data_ptr <MemPtr<.T>> get v "data"
    if:
        le n 1
        then Result<Vec<.T>, StdErrorKind>::Ok Vec<.T> n cap storage data_ptr
        else:
            match alloc_ptr<.T> mul n size_of<.T>:
                Result::Err _e:
                    Result<Vec<.T>, StdErrorKind>::Err StdErrorKind::OutOfMemory
                Result::Ok buf:
                    sort_merge_range_data<.T> data_ptr buf 0 n;
                    dealloc_raw mem_ptr_addr buf mul n size_of<.T>
                    Result<Vec<.T>, StdErrorKind>::Ok Vec<.T> n cap storage data_ptr


//: sort: default sort として quick sort を実行する
//:
//: [目的/もくてき]:
//: - 追加 allocation なしの一般用途 default として `sort_quick` を呼びます。
//: - 安定性や worst-case bound が必要ない caller に短い API を提供します。
//:
//: [実装/じっそう]:
//: - 現在の default は Lomuto quick sort です。
//:
//: [注意/ちゅうい]:
//: - stable sort が必要なら `sort_merge` を使います。
//: - worst-case O(n log n) を優先するなら `sort_heap` を使います。
//:
//: [計算量/けいさんりょう]:
//: - `sort_quick` と同じです。
fn sort <.T: Ord> <(&Vec<.T>)->()> (v):
    sort_quick<.T> v
