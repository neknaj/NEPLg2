//: sort: `Vec` と raw slice の in-place sort algorithms
//:
//: [目的/もくてき]:
//: - `Vec` と raw slice の in-place sort algorithms を再 export する facade です。
//: - 比較・raw access 共通処理、教育用 simple sort、Lomuto quick sort、heap sort、merge sort を submodule に分けます。
//:
//: [注意/ちゅうい]:
//: - raw helper は `0 <= idx < len(v)` を呼び出し側が保証する内部境界です。
//: - stable sort が必要なら `sort_merge` を使います。
//: - heap sort は O(n log n)、追加領域 O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 3 |> uwok
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let sorted <Vec<i32>> sort_quick_ret<i32> unsorted
//:     let ok <bool> sort_is_sorted<i32> &sorted
//:     free<i32> sorted
//:     if ok 1 0
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec/sort" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//: fn main <()*>i32> ():
//:     let unsorted <Vec<i32>>:
//:         unwrap_ok<Vec<i32>, StdErrorKind> new<i32>
//:         |> push 4 |> uwok
//:         |> push 3 |> uwok
//:         |> push 2 |> uwok
//:         |> push 1 |> uwok
//:     let sorted <Vec<i32>> unwrap_ok<Vec<i32>, StdErrorKind> sort_merge_ret<i32> unsorted
//:     let ok <bool> sort_is_sorted<i32> &sorted
//:     free<i32> sorted
//:     if ok 1 0
//: ```

#indent 4

pub #import "./sort/common" as *
pub #import "./sort/simple" as *
pub #import "./sort/quick" as *
pub #import "./sort/heap" as *
pub #import "./sort/merge" as *
