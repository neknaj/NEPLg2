//: # vec/raw/aggregate
//: `Vec` raw storage の aggregate helper
//:
//: ### [目的/もくてき]
//: - fold/reduce の raw pointer traversal をこの module に[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - element access は `raw/element` に[委譲/いじょう]します。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "./element" as *

//: vec_fold_impl: `fold` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から[末尾/まつび]まで[左/ひだり]に acc を[進/すす]める `fold` を、raw pointer と index だけで[表現/ひょうげん]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら acc を[返/かえ]し、それ[以外/いがい]は `f acc item` を[計算/けいさん]して `idx + 1` へ[再帰/さいき]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので、`data` と `len` の[整合性/せいごうせい]は[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_fold_impl<i32,i32> p 3 0 0 add_acc 6
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_fold_impl <.T,.U> <(MemPtr<.T>, i32, i32, .U, (.U,.T)->.U)->.U> (data, len, idx, acc, f):
    if:
        eq idx len
        then acc
        else:
            let next_acc <.U> f acc vec_read_at<.T> data idx
            let next_idx <i32> add idx 1
            vec_fold_impl<.T,.U> data len next_idx next_acc f

//: vec_reduce_impl: `reduce` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう][要素/ようそ]を[初期値/しょきち]にした[左畳/ひだりたた]み[込/こ]みを raw pointer + index で[実装/じっそう]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら acc を[返/かえ]し、それ[以外/いがい]は[現在/げんざい][要素/ようそ]を[読/よ]んで `f acc item` を[次/つぎ]の acc にします。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` の[判定/はんてい]は[外側/そとがわ]の `reduce` が[担/にな]います。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_reduce_impl<i32> p 3 1 1 add_acc 6
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_reduce_impl <.T> <(MemPtr<.T>, i32, i32, .T, (.T,.T)->.T)->.T> (data, len, idx, acc, f):
    if:
        eq idx len
        then acc
        else:
            let next_acc <.T> f acc vec_read_at<.T> data idx
            let next_idx <i32> add idx 1
            vec_reduce_impl<.T> data len next_idx next_acc f
