//: # vec/raw/prefix
//: `Vec` raw storage の prefix helper
//:
//: ### [目的/もくてき]
//: - prefix boundary scan と prefix copy をこの module に[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - element access は `raw/element` に[委譲/いじょう]します。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "./element" as *

//: vec_take_while_len_impl: `take_while` / `drop_while` の[境界/きょうかい][位置/いち]を[求/もと]める[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から `p` が true の[間/あいだ]だけ[進/すす]み、prefix の[長/なが]さを `i32` で[返/かえ]します。
//: - `take_while` と `drop_while` が[同/おな]じ[境界/きょうかい][探索/たんさく]を[共有/きょうゆう]できるようにします。
//:
//: ### [実装/じっそう]
//: - `idx` から[末尾/まつび]へ while loop で[進/すす]み、最初に `p (data[i])` が false になった[位置/いち]を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので、`data` と `len` の[整合性/せいごうせい]は[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]する[前提/ぜんてい]です。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]を[想定/そうてい]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(k) ただし k は[先頭/せんとう]から[最初/さいしょ]に false になるまでの[走査/そうさ][長/ちょう]です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_take_while_len_impl<i32> p 3 0 lt_three 2
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_take_while_len_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->i32> (data, len, idx, p):
    let mut i <i32> idx
    let mut active <bool> true
    while and active lt i len:
        do:
            if:
                cond p vec_read_at<.T> data i
                then:
                    set i add i 1
                else:
                    set active false
    i

//: vec_write_prefix_impl: [連続部分/れんぞくぶぶん]を[別/べつ]バッファへ[複写/ふくしゃ]する[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - `take_while` / `drop_while` のように、[入力/にゅうりょく] `Vec` の prefix や suffix を[新規/しんき]バッファへ[順番/じゅんばん]どおり[複写/ふくしゃ]する[共通/きょうつう]処理を[切/き]り[出/だ]します。
//:
//: ### [実装/じっそう]
//: - `src_from` から `count` [件/けん]だけ `vec_read_at` / `vec_write_at` を[繰/く]り[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [呼/よ]び[出/だ]し[側/がわ]が[出力先/しゅつりょくさき]バッファの[十分/じゅうぶん]な[容量/ようりょう]を[確保/かくほ]している[前提/ぜんてい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(count)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let src <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 7 |> uwok
//:         |> push 8 |> uwok
//:         |> push 9 |> uwok
//:     let src_data <MemPtr<i32>> data_mem_ptr<i32> &src
//:     let dst <Vec<i32>> unwrap_ok with_capacity<i32> 2
//:     let dst_data <MemPtr<i32>> data_mem_ptr<i32> &dst
//:     vec_write_prefix_impl<i32> src_data dst_data 1 2;
//:     let ok <bool> eq vec_read_at<i32> dst_data 1 9
//:     free<i32> src;
//:     free<i32> dst;
//:     if ok 0 1
//: ```
fn vec_write_prefix_impl <.T> <(MemPtr<.T>, MemPtr<.T>, i32, i32)->()> (src_data, out_data, src_from, count):
    let mut i <i32> 0
    while lt i count:
        do:
            vec_write_at<.T> out_data i vec_read_at<.T> src_data add src_from i
            set i add i 1
