//: # vec/raw/predicate
//: `Vec` raw storage の predicate helper
//:
//: ### [目的/もくてき]
//: - find の raw pointer traversal をこの module に[集約/しゅうやく]します。
//:
//: ### [注意/ちゅうい]
//: - element access は `raw/element` に[委譲/いじょう]します。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "./element" as *

//: vec_find_impl: `find` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から[順番/じゅんばん]に[条件/じょうけん]を[試/ため]し、[最初/さいしょ]の[一致/いっち]だけを[返/かえ]す処理を raw pointer で[共通化/きょうつうか]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら `none`、それ[以外/いがい]は item を[読/よ]んで `p item` を[判定/はんてい]し、[見/み]つかれば `some`、まだなら[次/つぎ]へ[再帰/さいき]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので[範囲/はんい][検査/けんさ]は `len` に[依存/いそん]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     match vec_find_impl<i32> p 2 0 gt_two:
//:         Option::Some x:
//:             free<i32> v;
//:             if eq x 3 0 1
//:         Option::None:
//:             free<i32> v;
//:             1
//: ```
fn vec_find_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->Option<.T>> (data, len, idx, p):
    if:
        eq idx len
        then none<.T>
        else:
            let item <.T> vec_read_at<.T> data idx
            if:
                cond p item
                then some<.T> item
                else:
                    let next_idx <i32> add idx 1
                    vec_find_impl<.T> data len next_idx p
