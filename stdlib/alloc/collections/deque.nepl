//: # deque
//: `Vec<Option<T>>` backed double-ended queue
//:
//: ### [目的/もくてき]
//: - [前後/ぜんご][両端/りょうたん]での push / pop / peek を[提供/ていきょう]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` / `head` と `items` を struct field として[保持/ほじ]します。
//: - `items` は `cap` [個/こ]の `Option<T>` で、live slot は `Some(value)`、inactive slot は `None` です。
//: - grow 時は head からの[論理順/ろんりじゅん]に新しい storage へ[並/なら]べ[直/なお]し、head を 0 に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には deque payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `cap` / `is_empty` / `peek_front` / `peek_back` / `pop_front` / `pop_back` は `Deque` を[値/あたい]で[消費/しょうひ]し、内部 storage を[閉/と]じます。
//: - owner を[残/のこ]したまま[観測/かんそく]する場合は `len_ref` / `cap_ref` / `is_empty_ref` / `peek_front_ref` / `peek_back_ref` を[使/つか]います。
//:
//: ### [計算量/けいさんりょう]
//: - `len_ref` / `cap_ref` / `is_empty_ref` / `peek_front_ref` / `peek_back_ref` / terminal pop は O(1) です。
//: - `push_front` / `push_back` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Deque
//: [両端/りょうたん] queue の owner
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`
struct Deque<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>

fn deque_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

fn deque_next_index <(i32,i32)->i32> (idx, cap):
    rem_u add idx 1 cap

fn deque_prev_index <(i32,i32)->i32> (idx, cap):
    rem_u add sub idx 1 cap cap

fn deque_tail_index <(i32,i32,i32)->i32> (head, len, cap):
    rem_u add head len cap

fn deque_back_index <(i32,i32,i32)->i32> (head, len, cap):
    rem_u add head sub len 1 cap

//: deque_item_at: slot の `Option<T>` を[読/よ]み[出/だ]す
fn deque_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

//: deque_store_slot: slot state を[更新/こうしん]する
fn deque_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace<Option<.T>> items idx item

fn deque_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

fn deque_clear_slots_loop <.T: Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, cap, i):
    if:
        lt i cap
        then:
            deque_store_slot<.T> items i none<.T>
            deque_clear_slots_loop<.T> items cap add i 1
        else:
            ()

fn deque_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32,i32,i32,i32)*>()> (src, dst, cap, head, len, dst_start):
    let mut i <i32> 0
    while lt i len:
        do:
            let src_idx <i32> rem_u add head i cap
            let dst_idx <i32> add dst_start i
            match deque_item_at<.T> src src_idx:
                Option::Some item:
                    deque_store_slot<.T> dst dst_idx some<.T> item
                Option::None:
                    ()
            set i add i 1

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から] deque を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/deque" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dq <Deque<i32>> unwrap_ok<Deque<i32>, Diag> new<i32>;
//:     if eq len dq 0 1 0
//: ```
fn new <.T: Copy> <()*>Result<Deque<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して deque を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/deque" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dq <Deque<i32>> unwrap_ok<Deque<i32>, Diag> with_capacity<i32> 16;
//:     if eq cap dq 16 1 0
//: ```
fn with_capacity <.T: Copy> <(i32)*>Result<Deque<.T>, Diag>> (cap):
    let cap0 <i32> deque_normalize_capacity cap
    match deque_alloc_slots<.T> cap0:
        Result::Err d:
            err<Deque<.T>, Diag> d
        Result::Ok items:
            ok<Deque<.T>, Diag> Deque<.T> 0 cap0 0 items

//: ## len
//: deque を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
fn len <.T: Copy> <(Deque<.T>)->i32> (dq):
    let n <i32> *field::get_ref &dq "len"
    free<.T> dq
    n

//: ## len_ref
//: `Deque` を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len_ref <.T> <(&Deque<.T>)->i32> (dq):
    *field::get_ref dq "len"

//: ## cap
//: deque を[消費/しょうひ]して[容量/ようりょう]を[返/かえ]す
fn cap <.T: Copy> <(Deque<.T>)->i32> (dq):
    let n <i32> *field::get_ref &dq "cap"
    free<.T> dq
    n

//: ## cap_ref
//: `Deque` を[移動/いどう]せずに[容量/ようりょう]を[返/かえ]す
fn cap_ref <.T> <(&Deque<.T>)->i32> (dq):
    *field::get_ref dq "cap"

//: ## is_empty
//: deque を[消費/しょうひ]して[空/から]かどうかを[返/かえ]す
fn is_empty <.T: Copy> <(Deque<.T>)->bool> (dq):
    let ok <bool> is_empty_ref<.T> &dq
    free<.T> dq
    ok

//: ## is_empty_ref
//: `Deque` を[移動/いどう]せずに[空/から]かどうかを[返/かえ]す
fn is_empty_ref <.T> <(&Deque<.T>)->bool> (dq):
    eq len_ref<.T> dq 0

//: ## push_front
//: [先頭/せんとう]へ[追加/ついか]する
fn push_front <.T: Copy> <(Deque<.T>,.T)*>Result<Deque<.T>, Diag>> (dq, item):
    let len0 <i32> *field::get_ref &dq "len"
    let cap0 <i32> *field::get_ref &dq "cap"
    let head0 <i32> *field::get_ref &dq "head"
    let items <Vec<Option<.T>>> field::get dq "items"
    if:
        eq len0 cap0
        then:
            let new_cap <i32> mul cap0 2
            match deque_alloc_slots<.T> new_cap:
                Result::Err d:
                    vec::free<Option<.T>> items
                    err<Deque<.T>, Diag> d
                Result::Ok new_items:
                    deque_store_slot<.T> &new_items 0 some<.T> item
                    deque_copy_live_slots<.T> &items &new_items cap0 head0 len0 1
                    vec::free<Option<.T>> items
                    ok<Deque<.T>, Diag> Deque<.T> add len0 1 new_cap 0 new_items
        else:
            let head1 <i32> deque_prev_index head0 cap0
            deque_store_slot<.T> &items head1 some<.T> item
            ok<Deque<.T>, Diag> Deque<.T> add len0 1 cap0 head1 items

//: ## push_back
//: [末尾/まつび]へ[追加/ついか]する
fn push_back <.T: Copy> <(Deque<.T>,.T)*>Result<Deque<.T>, Diag>> (dq, item):
    let len0 <i32> *field::get_ref &dq "len"
    let cap0 <i32> *field::get_ref &dq "cap"
    let head0 <i32> *field::get_ref &dq "head"
    let items <Vec<Option<.T>>> field::get dq "items"
    if:
        eq len0 cap0
        then:
            let new_cap <i32> mul cap0 2
            match deque_alloc_slots<.T> new_cap:
                Result::Err d:
                    vec::free<Option<.T>> items
                    err<Deque<.T>, Diag> d
                Result::Ok new_items:
                    deque_copy_live_slots<.T> &items &new_items cap0 head0 len0 0
                    deque_store_slot<.T> &new_items len0 some<.T> item
                    vec::free<Option<.T>> items
                    ok<Deque<.T>, Diag> Deque<.T> add len0 1 new_cap 0 new_items
        else:
            let tail <i32> deque_tail_index head0 len0 cap0
            deque_store_slot<.T> &items tail some<.T> item
            ok<Deque<.T>, Diag> Deque<.T> add len0 1 cap0 head0 items

//: ## pop_front
//: deque を[消費/しょうひ]して[先頭/せんとう]の[値/あたい]だけを[返/かえ]す
fn pop_front <.T: Copy> <(Deque<.T>)*>Option<.T>> (dq):
    let item <Option<.T>> peek_front_ref<.T> &dq
    free<.T> dq
    item

//: ## pop_back
//: deque を[消費/しょうひ]して[末尾/まつび]の[値/あたい]だけを[返/かえ]す
fn pop_back <.T: Copy> <(Deque<.T>)*>Option<.T>> (dq):
    let item <Option<.T>> peek_back_ref<.T> &dq
    free<.T> dq
    item

//: ## peek_front
//: deque を[消費/しょうひ]して[先頭/せんとう]を[読/よ]む
fn peek_front <.T: Copy> <(Deque<.T>)->Option<.T>> (dq):
    let item <Option<.T>> peek_front_ref<.T> &dq
    free<.T> dq
    item

//: ## peek_front_ref
//: `Deque` を[移動/いどう]せずに[先頭/せんとう]を[読/よ]む
fn peek_front_ref <.T: Copy> <(&Deque<.T>)->Option<.T>> (dq):
    let len0 <i32> *field::get_ref dq "len"
    if:
        eq len0 0
        then:
            none<.T>
        else:
            let head0 <i32> *field::get_ref dq "head"
            let items <&Vec<Option<.T>>> field::get_ref dq "items"
            deque_item_at<.T> items head0

//: ## peek_back
//: deque を[消費/しょうひ]して[末尾/まつび]を[読/よ]む
fn peek_back <.T: Copy> <(Deque<.T>)->Option<.T>> (dq):
    let item <Option<.T>> peek_back_ref<.T> &dq
    free<.T> dq
    item

//: ## peek_back_ref
//: `Deque` を[移動/いどう]せずに[末尾/まつび]を[読/よ]む
fn peek_back_ref <.T: Copy> <(&Deque<.T>)->Option<.T>> (dq):
    let len0 <i32> *field::get_ref dq "len"
    if:
        eq len0 0
        then:
            none<.T>
        else:
            let cap0 <i32> *field::get_ref dq "cap"
            let head0 <i32> *field::get_ref dq "head"
            let back <i32> deque_back_index head0 len0 cap0
            let items <&Vec<Option<.T>>> field::get_ref dq "items"
            deque_item_at<.T> items back

//: ## clear
//: [内容/ないよう]を[空/から]にする
fn clear <.T: Copy> <(Deque<.T>)*>Deque<.T>> (dq):
    let cap0 <i32> *field::get_ref &dq "cap"
    let items <Vec<Option<.T>>> field::get dq "items"
    deque_clear_slots_loop<.T> &items cap0 0
    Deque<.T> 0 cap0 0 items

//: ## free
//: deque が[所有/しょゆう]する backing storage を[解放/かいほう]する
fn free <.T: Copy> <(Deque<.T>)->()> (dq):
    vec::free<Option<.T>> field::get dq "items"
