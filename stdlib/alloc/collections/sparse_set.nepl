#indent 4

//: # sparse_set
//: dense/sparse [配列/はいれつ]で[実装/じっそう]した integer set
//:
//: ### [目的/もくてき]
//: - `SparseSet` を[提供/ていきょう]し、`new` / `len` / `universe_len` / `contains` / `insert` / `remove` / `clear` / `free` の bare API で integer set を[扱/あつか]えるようにします。
//: - `len` / `universe_len` / `contains` は `&SparseSet` を[受/う]け[取/と]り、dense/sparse storage owner を[移動/いどう]せずに[観察/かんさつ]します。
//: - `[0, n)` の[範囲/はんい]に[収/おさ]まる整数に[対/たい]して、membership と insert / remove を O(1) で[行/おこな]える set を `alloc/collections` に[揃/そろ]えます。
//:
//: ### [実装/じっそう]
//: - `dense[len]` に[現/げん]在の[要素/ようそ]を[詰/つ]め、`sparse[value]` に dense [上/じょう]の[位置/いち]を[記録/きろく]します。
//: - `contains` は `idx = sparse[value]` を[読/よ]み、`idx < len` かつ `dense[idx] == value` で membership を[判定/はんてい]します。
//: - `remove` は[末尾/まつび]の[要素/ようそ]を[削除位置/さくじょいち]へ[詰/つ]めて O(1) で[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - [扱/あつか]える key は `[0, universe_len)` に[限/かぎ]られます。
//: - `universe_len = 0` は[空/から] domain として[有効/ゆうこう]で、dense/sparse は empty `Vec` storage として[保持/ほじ]します。
//: - `clear` は `len = 0` に[戻/もど]すだけで、`sparse` [配列/はいれつ]の[過去値/かこち]は[消/け]しません。membership [判定/はんてい]は `len` と `dense` の[両方/りょうほう]で[検証/けんしょう]するため[安全/あんぜん]です。
//: - query だけの[処理/しょり]では `contains &s value` のように borrow し、[最後/さいご]に `free s` で owner を[閉/と]じます。
//: - `insert` / `remove` の[範囲外/はんいがい] `Err` は入力 owner を[消費/しょうひ]し、dense/sparse storage を[解放/かいほう]してから `Diag` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `universe_len` / `contains` は O(1) です。
//: - `insert` / `remove` / `clear` は O(1) です。
//: - `new` / `free` は O(n) です。

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## SparseSet
//: dense/sparse [配列/はいれつ]を[所有/しょゆう]する integer set
//:
//: ### [目的/もくてき]
//: - domain [長/なが]さ、active [要素数/ようそすう]、dense/sparse `Vec<i32>` owner を 1 [値/あたい]として[受/う]け[渡/わた]しします。
//:
//: ### [注意/ちゅうい]
//: - `n = 0` のとき dense/sparse は empty `Vec` で、null pointer sentinel を owner state として[使/つか]いません。
//: - [不要/ふよう]になったら `free` で dense / sparse owner を[閉/と]じます。
struct SparseSet:
    n <i32>
    len0 <i32>
    dense <Vec<i32>>
    sparse <Vec<i32>>

fn sparse_set_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid sparse set length"

fn sparse_set_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "sparse set index out of bounds"

fn sparse_set_valid_index <(i32,i32)->bool> (idx, n):
    and le 0 idx lt idx n

fn sparse_set_load_owned <(&Vec<i32>,i32)->i32> (base, idx):
    match vec::get<i32> base idx:
        Option::Some v:
            v
        Option::None:
            0

fn sparse_set_store_owned <(&Vec<i32>,i32,i32)*>()> (base, idx, value):
    vec::replace<i32> base idx value

fn sparse_set_free_arrays <(Vec<i32>,Vec<i32>)->()> (dense, sparse):
    vec::free<i32> dense
    vec::free<i32> sparse

fn sparse_set_alloc_array <(i32)*>Result<Vec<i32>, Diag>> (n):
    match vec::filled<i32> n 0:
        Result::Ok items:
            ok<Vec<i32>, Diag> items
        Result::Err _e:
            diag_err<Vec<i32>> diag_out_of_memory

fn sparse_set_contains_raw <(i32,&Vec<i32>,&Vec<i32>,i32,i32)->bool> (n, dense, sparse, len0, value):
    if:
        not sparse_set_valid_index value n
        then false
        else:
            let idx <i32> sparse_set_load_owned sparse value
            if:
                and le 0 idx lt idx len0
                then eq sparse_set_load_owned dense idx value
                else false

//: ## new
//: domain `[0, n)` の[空/から] set を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     let ok <bool> eq len &s 0;
//:     free s
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<SparseSet, Diag>> (n):
    if:
        lt n 0
        then diag_err<SparseSet> sparse_set_diag_len
        else:
            match sparse_set_alloc_array n:
                Result::Err d:
                    err<SparseSet, Diag> d
                Result::Ok dense:
                    match sparse_set_alloc_array n:
                        Result::Err d:
                            vec::free<i32> dense
                            err<SparseSet, Diag> d
                        Result::Ok sparse:
                            ok<SparseSet, Diag> SparseSet n 0 dense sparse

//: ## len
//: [現/げん]在[入/はい]っている[要素数/ようそすう]を[返/かえ]す
fn len <(&SparseSet)->i32> (s):
    *field::get_ref s "len0"

//: ## universe_len
//: [扱/あつか]える整数 domain の[長/なが]さを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     let ok <bool> eq universe_len &s 8;
//:     free s
//:     if ok 1 0
//: ```
fn universe_len <(&SparseSet)->i32> (s):
    *field::get_ref s "n"

//: ## contains
//: value が[含/ふく]まれているかを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &s 3;
//:     free s
//:     if ok 1 0
//: ```
fn contains <(&SparseSet,i32)*>Result<bool, Diag>> (s, value):
    let n <i32> *field::get_ref s "n"
    let len0 <i32> *field::get_ref s "len0"
    let dense <&Vec<i32>> field::get_ref s "dense"
    let sparse <&Vec<i32>> field::get_ref s "sparse"
    if:
        sparse_set_valid_index value n
        then:
            ok<bool, Diag> sparse_set_contains_raw n dense sparse len0 value
        else:
            let d <Diag> sparse_set_diag_index
            err<bool, Diag> d

//: ## insert
//: value を 1 [個/こ][追加/ついか]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> insert 5 |> uwok
//:     let ok <bool> eq len &s 2;
//:     free s
//:     if ok 1 0
//: ```
fn insert <(SparseSet,i32)*>Result<SparseSet, Diag>> (s, value):
    let n <i32> field::get s "n"
    let len0 <i32> field::get s "len0"
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    if:
        not sparse_set_valid_index value n
        then:
            let d <Diag> sparse_set_diag_index
            sparse_set_free_arrays dense sparse
            err<SparseSet, Diag> d
        else:
            if:
                sparse_set_contains_raw n &dense &sparse len0 value
                then:
                    ok<SparseSet, Diag> SparseSet n len0 dense sparse
                else:
                    sparse_set_store_owned &dense len0 value
                    sparse_set_store_owned &sparse value len0
                    ok<SparseSet, Diag> SparseSet n add len0 1 dense sparse

//: ## remove
//: value を 1 [個/こ][削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> insert 5 |> uwok
//:         |> remove 3 |> uwok
//:     let ok <bool> eq len &s 1;
//:     free s
//:     if ok 1 0
//: ```
fn remove <(SparseSet,i32)*>Result<SparseSet, Diag>> (s, value):
    let n <i32> field::get s "n"
    let len0 <i32> field::get s "len0"
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    if:
        not sparse_set_valid_index value n
        then:
            let d <Diag> sparse_set_diag_index
            sparse_set_free_arrays dense sparse
            err<SparseSet, Diag> d
        else:
            if:
                not sparse_set_contains_raw n &dense &sparse len0 value
                then:
                    ok<SparseSet, Diag> SparseSet n len0 dense sparse
                else:
                    let idx <i32> sparse_set_load_owned &sparse value
                    let last_idx <i32> sub len0 1
                    let last_value <i32> sparse_set_load_owned &dense last_idx
                    sparse_set_store_owned &dense idx last_value
                    sparse_set_store_owned &sparse last_value idx
                    ok<SparseSet, Diag> SparseSet n last_idx dense sparse

//: ## clear
//: [全/すべ]ての[要素/ようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> clear
//:     let ok <bool> eq len &s 0;
//:     free s
//:     if ok 1 0
//: ```
fn clear <(SparseSet)->SparseSet> (s):
    let n <i32> field::get s "n"
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    SparseSet n 0 dense sparse

//: ## free
//: dense/sparse [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [実装/じっそう]
//: - dense/sparse はそれぞれ `Vec<i32>` として `new` が[確保/かくほ]し、`SparseSet` が[所有/しょゆう]します。
//: - owner invariant に[基/もと]づき、内部 cleanup は `vec::free` で[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [解放後/かいほうご]に `s` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     free s
//:     0
//: ```
fn free <(SparseSet)->()> (s):
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    sparse_set_free_arrays dense sparse
