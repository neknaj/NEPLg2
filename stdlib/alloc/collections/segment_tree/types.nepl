//: # segment_tree/types
//: `SegmentTree` の型定義と update error 型
//:
//: ### [目的/もくてき]
//: - Segment Tree の owner と、更新失敗時に owner を返す error 型を定義します。
//: - public error accessor を型定義側に置き、caller が `replace` / `add` 失敗後も owner を安全に回収できるようにします。

#indent 4

#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *
#import "core/math" as *

//: ## SegmentTree
//: [長/なが]さと base と[内部配列/ないぶはいれつ]を[所有/しょゆう]する
//:
//: ### [注意/ちゅうい]
//: - `data` は `2 * base` [個/こ]の `i32` を[保持/ほじ]します。
//: - [不要/ふよう]になったら `free` します。
pub struct SegmentTree:
    n <i32>
    base <i32>
    data <Vec<i32>>

//: ## SegmentTreeUpdateError
//: `replace` / `add` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `replace` / `add` は[更新/こうしん] API なので `SegmentTree` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index では tree storage を[変更/へんこう]せず、caller が cleanup できるように元の `SegmentTree` owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `segment_tree_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`segment_tree_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
pub struct SegmentTreeUpdateError:
    owner <SegmentTree>
    diag <Diag>

//: segment_tree_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
pub fn segment_tree_update_error_diag <(&SegmentTreeUpdateError)->Diag> (e):
    *field::get_ref e "diag"

//: segment_tree_update_error_owner: update [失敗/しっぱい]で[戻/もど]された `SegmentTree` owner を[取/と]り[出/だ]す
pub fn segment_tree_update_error_owner <(SegmentTreeUpdateError)->SegmentTree> (e):
    field::get e "owner"
