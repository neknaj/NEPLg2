//: # segment_tree/storage
//: `SegmentTree` の typed `Vec<i32>` storage 操作
//:
//: ### [目的/もくてき]
//: - tree cell の読み書きと sibling pair sum を `Vec<i32>` API に集約します。
//: - public API と更新/query helper が raw pointer や sentinel を扱わないようにします。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "alloc/collections/vec" as vec

pub fn seg_load_owned <(&Vec<i32>,i32)->Option<i32>> (data, idx):
    match vec::get<i32> data idx:
        Option::Some v:
            some<i32> v
        Option::None:
            none<i32>

pub fn seg_store_owned <(&Vec<i32>,i32,i32)*>()> (data, idx, value):
    vec::replace<i32> data idx value

pub fn seg_pair_sum <(&Vec<i32>,i32,i32)->Option<i32>> (data, left, right):
    match seg_load_owned data left:
        Option::Some lv:
            match seg_load_owned data right:
                Option::Some rv:
                    some<i32> add lv rv
                Option::None:
                    none<i32>
        Option::None:
            none<i32>
