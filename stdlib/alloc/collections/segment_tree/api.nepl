//: # segment_tree/api
//: `SegmentTree` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `replace` / `add` / `sum_range` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./layout" as *
#import "./mutation" as *
#import "./range" as *

fn seg_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid segment tree length"

fn seg_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree index out of bounds"

fn seg_diag_range <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree range out of bounds"

//: ## new
//: [長/なが]さ `n` の[空/から] Segment Tree を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree> unwrap_ok<SegmentTree, Diag> new 5;
//:     let ok <bool> eq len &st 5;
//:     free st
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<SegmentTree, Diag>> (n):
    if:
        lt n 0
        then diag_err<SegmentTree> seg_diag_len
        else:
            let base <i32> seg_next_pow2 if eq n 0 1 n
            let cells <i32> seg_expected_cells base
            match vec::filled<i32> cells 0:
                Result::Err _e:
                    diag_err<SegmentTree> diag_out_of_memory
                Result::Ok data:
                    ok<SegmentTree, Diag> SegmentTree n base data

//: ## len
//: [保持/ほじ]している[長/なが]さを[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `SegmentTree` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `SegmentTree` を[使/つか]い、不要になったら `free` できます。
fn len <(&SegmentTree)->i32> (st):
    *field::get_ref st "n"

//: ## replace
//: `idx` の[値/あたい]を `value` に[置/お]き[換/か]える
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st0 <SegmentTree> unwrap_ok<SegmentTree, Diag> new 4;
//:     let st1 <SegmentTree> unwrap_ok<SegmentTree, SegmentTreeUpdateError> replace st0 1 5;
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st1 0 4;
//:     free st1
//:     if eq total 5 1 0
//: ```
fn replace <(SegmentTree,i32,i32)*>Result<SegmentTree, SegmentTreeUpdateError>> (st, idx, value):
    let n <i32> *field::get_ref &st "n"
    let base <i32> *field::get_ref &st "base"
    if:
        and le 0 idx lt idx n
        then:
            let result <Result<(), Diag>> block:
                let data <&Vec<i32>> field::get_ref &st "data"
                if:
                    not seg_storage_has_expected_len data base
                    then:
                        diag_err<()> seg_diag_index
                    else:
                        if:
                            seg_replace_storage data base idx value
                            then:
                                ok<(), Diag> ()
                            else:
                                diag_err<()> seg_diag_index
            match result:
                Result::Ok _unit:
                    ok<SegmentTree, SegmentTreeUpdateError> st
                Result::Err d:
                    let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
                    err<SegmentTree, SegmentTreeUpdateError> e
        else:
            let d <Diag> seg_diag_index
            let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
            err<SegmentTree, SegmentTreeUpdateError> e

//: ## add
//: `idx` に `delta` を[加算/かさん]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree>:
//:         unwrap_ok<SegmentTree, Diag> new 4
//:         |> add 0 2 |> uwok
//:         |> add 3 5 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st 0 4;
//:     free st
//:     if eq total 7 1 0
//: ```
fn add <(SegmentTree,i32,i32)*>Result<SegmentTree, SegmentTreeUpdateError>> (st, idx, delta):
    let n <i32> *field::get_ref &st "n"
    let base <i32> *field::get_ref &st "base"
    if:
        and le 0 idx lt idx n
        then:
            let result <Result<(), Diag>> block:
                let data <&Vec<i32>> field::get_ref &st "data"
                if:
                    not seg_storage_has_expected_len data base
                    then:
                        diag_err<()> seg_diag_index
                    else:
                        if:
                            seg_add_storage data base idx delta
                            then:
                                ok<(), Diag> ()
                            else:
                                diag_err<()> seg_diag_index
            match result:
                Result::Ok _unit:
                    ok<SegmentTree, SegmentTreeUpdateError> st
                Result::Err d:
                    let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
                    err<SegmentTree, SegmentTreeUpdateError> e
        else:
            let d <Diag> seg_diag_index
            let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
            err<SegmentTree, SegmentTreeUpdateError> e

//: ## sum_range
//: [区間/くかん] `[l, r)` の[和/わ]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree>:
//:         unwrap_ok<SegmentTree, Diag> new 5
//:         |> replace 0 1 |> uwok
//:         |> replace 1 2 |> uwok
//:         |> replace 2 3 |> uwok
//:         |> replace 3 4 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st 1 4;
//:     free st
//:     if eq total 9 1 0
//: ```
fn sum_range <(&SegmentTree,i32,i32)*>Result<i32, Diag>> (st, l, r):
    let n <i32> *field::get_ref st "n"
    let base <i32> *field::get_ref st "base"
    if:
        and and le 0 l le l r le r n
        then:
            let data <&Vec<i32>> field::get_ref st "data"
            if:
                not seg_storage_has_expected_len data base
                then:
                    diag_err<i32> seg_diag_range
                else:
                    match seg_sum_range_storage data base l r:
                        Option::Some total:
                            ok<i32, Diag> total
                        Option::None:
                            diag_err<i32> seg_diag_range
        else:
            let d <Diag> seg_diag_range
            err<i32, Diag> d

//: ## free
//: [内部配列/ないぶはいれつ]を[解放/かいほう]する
//:
//: ### [実装/じっそう]
//: - `data` は `new` が `2 * base` 要素の `Vec<i32>` として[確保/かくほ]し、`SegmentTree` が[単独/たんどく]で[所有/しょゆう]します。
//: - owner invariant に[基/もと]づき、内部 cleanup は `Vec<i32>` owner を[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - [解放後/かいほうご]に `st` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree> unwrap_ok<SegmentTree, Diag> new 3;
//:     free st;
//:     0
//: ```
fn free <(SegmentTree)->()> (st):
    let data <Vec<i32>> field::get st "data"
    vec::free<i32> data
