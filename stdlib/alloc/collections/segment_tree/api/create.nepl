//: # segment_tree/api/create
//: `SegmentTree` の構築 API
//:
//: ### [目的/もくてき]
//: - logical length から base と storage cell count を計算し、初期化済み `Vec<i32>` を確保します。
//: - invalid length / allocation failure は `Diag` として返し、trap にしません。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../layout" as *
#import "./diagnostic" as *

//: ## new
//: [長/なが]さ `n` の[空/から] Segment Tree を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let st %SegmentTree unwrap_ok<SegmentTree, Diag> new 5;
//:     let observed_len %i32 len &st;
//:     let ok %bool eq observed_len 5;
//:     free st
//:     if ok 1 0
//: ```
pub fn new %impure fn i32 Result SegmentTree Diag \n:
    if:
        lt n 0
        then diag_err<SegmentTree> seg_diag_len
        else:
            let base %i32 seg_next_pow2 if eq n 0 1 n
            let cells %i32 seg_expected_cells base
            match vec::filled<i32> cells 0:
                Result::Err _e:
                    diag_err<SegmentTree> diag_out_of_memory
                Result::Ok data:
                    ok<SegmentTree, Diag> SegmentTree n base data
