//: # segment_tree/api/diagnostic
//: `SegmentTree` public API の診断生成
//:
//: ### [目的/もくてき]
//: - 長さ不正、index 範囲外、range 範囲外の `Diag` 生成を 1 箇所に集約します。
//: - update と query が同じ診断 kind/message を返すようにします。

#indent 4

#import "alloc/diag/error" as *
#import "core/result" as *

pub fn seg_diag_len %impure fn () Diag \():
    diag_error StdErrorKind::CapacityExceeded "invalid segment tree length"

pub fn seg_diag_index %impure fn () Diag \():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree index out of bounds"

pub fn seg_diag_range %impure fn () Diag \():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree range out of bounds"
