//: # alloc/collections/hashset/types
//: HashSet の型定義と bucket state enum
//:
//: ### [目的/もくてき]
//: - HashSet の storage / table / probing result 型を 1 module に集約します。
//: - bucket 状態は numeric sentinel ではなく enum として表し、probe logic 側で `match` 網羅性検査を効かせます。

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as *

//: ## HashSetBucketState
//: hash table の 1 bucket の[状態/じょうたい]
//:
//: ### [目的/もくてき]
//: - empty / full / tombstone を enum として[表/あらわ]し、`match` で[分岐/ぶんき]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashset/types" as *
//: fn main %impure fn () i32 \():
//:     match HashSetBucketState::Full:
//:         HashSetBucketState::Empty:
//:             1
//:         HashSetBucketState::Full:
//:             0
//:         HashSetBucketState::Tombstone:
//:             1
//: ```
pub enum HashSetBucketState:
    Empty
    Full
    Tombstone

impl Clone for HashSetBucketState:
    fn clone %fn &HashSetBucketState HashSetBucketState \state:
        *state

impl Copy for HashSetBucketState:
    fn copy_mark %fn HashSetBucketState HashSetBucketState \state:
        state

//: ## HashSetInsertSlotState
//: insertion 先 slot が empty 由来か tombstone 由来かを[表/あらわ]す
//:
//: ### [目的/もくてき]
//: - tombstone を[再利用/さいりよう]した[場合/ばあい]だけ tombstone count を[減/へ]らせるようにします。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashset/types" as *
//: fn main %impure fn () i32 \():
//:     match HashSetInsertSlotState::TombstoneSlot:
//:         HashSetInsertSlotState::EmptySlot:
//:             1
//:         HashSetInsertSlotState::TombstoneSlot:
//:             0
//: ```
pub enum HashSetInsertSlotState:
    EmptySlot
    TombstoneSlot

impl Clone for HashSetInsertSlotState:
    fn clone %fn &HashSetInsertSlotState HashSetInsertSlotState \state:
        *state

impl Copy for HashSetInsertSlotState:
    fn copy_mark %fn HashSetInsertSlotState HashSetInsertSlotState \state:
        state

//: ## HashSetInsertSlot
//: insertion 先の index と[状態/じょうたい]
//:
//: ### [目的/もくてき]
//: - linear probing の[結果/けっか]を index と slot state の組として[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashset/types" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//: fn main %impure fn () i32 \():
//:     let slot %HashSetInsertSlot HashSetInsertSlot 5 HashSetInsertSlotState::TombstoneSlot;
//:     if eq field::get slot "index" 5 0 1
//: ```
pub struct HashSetInsertSlot:
    index %i32
    state %HashSetInsertSlotState

//: ## HashSetStorage
//: HashSet の backing storage
//:
//: ### [目的/もくてき]
//: - 状態配列と key 配列の owner を 1 [値/あたい]にまとめます。
//:
//: ### [注意/ちゅうい]
//: - `states.len == keys.len == cap` を内部不変条件とします。
pub struct HashSetStorage<.T>:
    states %Vec HashSetBucketState
    keys %Vec Option .T

//: ## HashSet
//: hash set [本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [要素数/ようそすう]・[容量/ようりょう]・tombstone 数・storage・hasher をまとめて[保持/ほじ]します。
pub struct HashSet<.T,.H>:
    count %i32
    cap %i32
    tombstones %i32
    storage %HashSetStorage .T
    hasher %.H

//: ## HashSetUpdateError
//: owner-consuming update の[失敗/しっぱい]で[戻/もど]る error payload
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` / rehash が[消費/しょうひ]した `HashSet` owner を caller へ[返/かえ]します。
//: - `Diag` だけを[返/かえ]して owner の cleanup / retry [判断/はんだん]を実装 discipline に[隠/かく]すことを[避/さ]けます。
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashset" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let hs %HashSet i32 DefaultHash32 unwrap_ok<HashSet<i32,DefaultHash32>, Diag> new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashSetUpdateError i32 DefaultHash32 HashSetUpdateError<i32,DefaultHash32> hs d0;
//:     0
//: ```
pub struct HashSetUpdateError<.T,.H>:
    owner %HashSet .T .H
    diag %Diag

//: ## hashset_update_error_diag
//: update [失敗/しっぱい]の `Diag` を owner を[動/うご]かさず[読/よ]む
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashset" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let hs %HashSet i32 DefaultHash32 unwrap_ok<HashSet<i32,DefaultHash32>, Diag> new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashSetUpdateError i32 DefaultHash32 HashSetUpdateError<i32,DefaultHash32> hs d0;
//:     0
//: ```
pub fn hashset_update_error_diag <.T,.H> %fn &HashSetUpdateError .T .H Diag \e:
    *field::get_ref e "diag"

//: ## hashset_update_error_owner
//: update [失敗/しっぱい]で[戻/もど]された `HashSet` owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 HashSet は Copy-only key/hasher contract で storage cleanup を[行/おこな]うため、この accessor も同じ bound に[限定/げんてい]します。
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashset" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let hs %HashSet i32 DefaultHash32 unwrap_ok<HashSet<i32,DefaultHash32>, Diag> new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashSetUpdateError i32 DefaultHash32 HashSetUpdateError<i32,DefaultHash32> hs d0;
//:     0
//: ```
pub fn hashset_update_error_owner <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %fn HashSetUpdateError .T .H HashSet .T .H \e:
    field::get e "owner"
