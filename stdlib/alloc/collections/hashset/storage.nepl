//: # alloc/collections/hashset/storage
//: HashSet typed storage の初期化・slot 読み書き・解放 helper
//:
//: ### [目的/もくてき]
//: - `Vec HashSetBucketState` / `Vec Option .T` の 2 owner を扱う処理を集約します。
//: - raw memory ではなく typed Vec storage を維持し、未初期化 bucket を作らないようにします。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "alloc/collections/hashset/types" as *
#import "core/field" as *

//: hashset_storage_states: storage の state Vec を borrow する
pub fn hashset_storage_states <.T> %fn &HashSetStorage .T &Vec HashSetBucketState \storage:
    field::get_ref storage "states"

//: hashset_storage_keys: storage の key Vec を borrow する
//: 現行 storage view は payload storage 形状を返すため、non-Copy collection drop traversal が入るまで Copy に限定します。
pub fn hashset_storage_keys <.T: Copy> %fn &HashSetStorage .T &Vec Option .T \storage:
    field::get_ref storage "keys"

//: hashset_normalize_capacity: hash set の[実容量/じつようりょう]を[下限/かげん]つきで[決/き]める
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashset/storage" as *
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     if eq hashset_normalize_capacity 2 4 0 1
//: ```
pub fn hashset_normalize_capacity %fn i32 i32 \requested:
    if lt requested 4 4 requested

//: hashset_load_limit: grow / rehash の[閾値/しきいち]を[計算/けいさん]する
//:
//: ### [実装/じっそう]
//: - 75% を[超/こ]える[前/まえ]に rehash するため、`cap * 3 / 4` を[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashset/storage" as *
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     if eq hashset_load_limit 8 6 0 1
//: ```
pub fn hashset_load_limit %fn i32 i32 \cap:
    div_u mul cap 3 4

//: hashset_state_at: bucket state を[読/よ]み[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 呼び出し側は `0 <= idx < cap` を[守/まも]る設計です。`Option::None` は不変条件破れの防護として empty に[倒/たお]します。
pub fn hashset_state_at %fn &Vec HashSetBucketState fn i32 HashSetBucketState \states\idx:
    let slot %Option HashSetBucketState vec::get states idx
    match slot:
        Option::Some state:
            state
        Option::None:
            HashSetBucketState::Empty

//: hashset_key_at: key slot を Option として[読/よ]む
pub fn hashset_key_at <.T: Copy> %fn &Vec Option .T fn i32 Option .T \keys\idx:
    let slot %Option Option .T vec::get keys idx
    match slot:
        Option::Some key_opt:
            key_opt
        Option::None:
            none

//: hashset_store_state: state slot を[書/か]き[換/か]える
pub fn hashset_store_state %impure fn &Vec HashSetBucketState impure fn i32 impure fn HashSetBucketState unit \states\idx\state:
    vec::replace states idx state

//: hashset_store_key: key slot を[書/か]き[換/か]える
pub fn hashset_store_key <.T: Copy> %impure fn &Vec Option .T impure fn i32 impure fn Option .T unit \keys\idx\key:
    vec::replace keys idx key

//: hashset_store_full: slot を Full にして key を[格納/かくのう]する
//:
//: ### [目的/もくてき]
//: - state と key option を同じ slot index で[同時/どうじ]に[更新/こうしん]します。
pub fn hashset_store_full <.T: Copy> %impure fn &HashSetStorage .T impure fn i32 impure fn .T unit \storage\idx\key:
    hashset_store_key hashset_storage_keys storage idx some key
    hashset_store_state hashset_storage_states storage idx HashSetBucketState::Full

//: hashset_store_tombstone: slot を tombstone にして payload を None に[戻/もど]す
pub fn hashset_store_tombstone <.T: Copy> %impure fn &HashSetStorage .T impure fn i32 unit \storage\idx:
    hashset_store_key hashset_storage_keys storage idx none
    hashset_store_state hashset_storage_states storage idx HashSetBucketState::Tombstone

//: hashset_free_storage: backing storage を[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - states / keys の 2 本の Vec owner を[閉/と]じます。
pub fn hashset_free_storage <.T: Copy> %fn HashSetStorage .T unit \storage:
    let states %Vec HashSetBucketState field::get storage "states"
    let keys %Vec Option .T field::get storage "keys"
    vec::free states
    vec::free keys

//: hashset_alloc_storage: empty storage を[作/つく]る
//:
//: ### [目的/もくてき]
//: - 全 slot を初期化済み enum / Option として[確保/かくほ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(cap)
pub fn hashset_alloc_storage <.T: Copy> %impure fn i32 Result HashSetStorage .T Diag \cap:
    let states_result %Result Vec HashSetBucketState StdErrorKind vec::filled cap HashSetBucketState::Empty
    match states_result:
        Result::Err _e:
            diag_err diag_out_of_memory
        Result::Ok states:
            let keys_result %Result Vec Option .T StdErrorKind vec::filled cap none
            match keys_result:
                Result::Err _e:
                    vec::free states
                    diag_err diag_out_of_memory
                Result::Ok keys:
                    ok HashSetStorage<.T> states keys
