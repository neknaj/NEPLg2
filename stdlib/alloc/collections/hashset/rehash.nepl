//: # alloc/collections/hashset/rehash
//: HashSet の grow / rehash と constructor helper
//:
//: ### [目的/もくてき]
//: - table capacity の正規化、live key の再配置、insert 前の grow 判定を API 本体から分離します。
//: - 成功時は旧 storage owner をこの module が閉じ、失敗時は `HashSetUpdateError` で元の set owner を caller へ返します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/hashset/types" as *
#import "alloc/collections/hashset/storage" as *
#import "alloc/collections/hashset/probe" as *
#import "core/field" as *

//: hashset_rehash_to: live key だけを新しい storage へ[再配置/さいはいち]する
//:
//: ### [目的/もくてき]
//: - grow または tombstone cleanup のために新しい capacity の table を[作/つく]り、Full key だけを[移/うつ]します。
//:
//: ### [注意/ちゅうい]
//: - [確保/かくほ][失敗/しっぱい]した[場合/ばあい]、入力 HashSet owner は `HashSetUpdateError` に[入/い]れて[返/かえ]します。
pub fn hashset_rehash_to <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,i32)*>Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>> (hs, requested_cap):
    let count0 <i32> *field::get_ref &hs "count"
    let old_cap <i32> *field::get_ref &hs "cap"
    let tombstones0 <i32> *field::get_ref &hs "tombstones"
    let hasher <.H> *field::get_ref &hs "hasher"
    let old_storage <HashSetStorage<.T>> field::get hs "storage"
    let new_cap <i32> hashset_normalize_capacity requested_cap
    match hashset_alloc_storage<.T> new_cap:
        Result::Err d:
            Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>::Err HashSetUpdateError<.T,.H> (HashSet<.T,.H> count0 old_cap tombstones0 old_storage hasher) d
        Result::Ok new_storage:
            let states <&Vec<HashSetBucketState>> hashset_storage_states<.T> &old_storage
            let keys <&Vec<Option<.T>>> hashset_storage_keys<.T> &old_storage
            let mut i <i32> 0
            while lt i old_cap:
                do:
                    match hashset_state_at states i:
                        HashSetBucketState::Full:
                            match hashset_key_at<.T> keys i:
                                Option::None:
                                    ()
                                Option::Some key:
                                    hashset_insert_entry_into_storage<.T,.H> &new_storage new_cap hasher key
                        HashSetBucketState::Empty:
                            ()
                        HashSetBucketState::Tombstone:
                            ()
                    set i add i 1
            hashset_free_storage<.T> old_storage
            Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>::Ok HashSet<.T,.H> count0 new_cap 0 new_storage hasher

//: hashset_prepare_insert: key [追加/ついか]前に必要な grow / rehash を[行/おこな]う
//:
//: ### [目的/もくてき]
//: - 既存 key では容量を変えません。新規 key では count と tombstone を合わせた occupied 数を見て、必要なら同容量 rehash または 2 倍 grow を選びます。
pub fn hashset_prepare_insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,.T)*>Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>> (hs, key):
    let count0 <i32> *field::get_ref &hs "count"
    let cap0 <i32> *field::get_ref &hs "cap"
    let tombstones0 <i32> *field::get_ref &hs "tombstones"
    let hasher <.H> *field::get_ref &hs "hasher"
    let storage <&HashSetStorage<.T>> field::get_ref &hs "storage"
    let idx <i32> hashset_find_present<.T,.H> storage cap0 hasher key
    if:
        not lt idx 0
        then:
            Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>::Ok hs
        else:
            let limit <i32> hashset_load_limit cap0
            let occupied_after_insert <i32> add add count0 tombstones0 1
            if:
                gt occupied_after_insert limit
                then:
                    let count_after_insert <i32> add count0 1
                    let grow_cap <i32> mul cap0 2
                    let should_grow <bool> gt count_after_insert limit
                    let target_cap <i32> if:
                        should_grow
                        then grow_cap
                        else cap0
                    hashset_rehash_to<.T,.H> hs target_cap
                else:
                    Result<HashSet<.T,.H>, HashSetUpdateError<.T,.H>>::Ok hs

//: hashset_new_with_capacity: `new` と `with_capacity` が[共有/きょうゆう]する constructor
//:
//: ### [目的/もくてき]
//: - 公開 API 名の overload 解決に依存せず、容量正規化と storage 初期化を 1 [箇所/かしょ]に[集約/しゅうやく]します。
pub fn hashset_new_with_capacity <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,i32)*>Result<HashSet<.T,.H>, Diag>> (hasher, requested):
    let cap0 <i32> hashset_normalize_capacity requested
    match hashset_alloc_storage<.T> cap0:
        Result::Err d:
            err<HashSet<.T,.H>, Diag> d
        Result::Ok storage:
            ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> 0 cap0 0 storage hasher
