//: # alloc/collections/hashset/probe
//: HashSet の linear probing と slot search
//:
//: ### [目的/もくてき]
//: - hash bucket の開始位置、probe の進行、既存 key 検索、新規 insert slot 検索を集約します。
//: - bucket state は `HashSetBucketState` の `match` で分岐し、empty / full / tombstone を数値 tag に戻さないようにします。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/hashset/types" as *
#import "alloc/collections/hashset/storage" as *
#import "core/field" as *

//: hashset_bucket_index: hash から bucket index を[計算/けいさん]する
//:
//: ### [実装/じっそう]
//: - hasher の `hash32` を unsigned remainder として capacity に[収/おさ]めます。
pub fn hashset_bucket_index <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %fn i32 fn .H fn .T i32 \cap\hasher\key:
    rem_u hash_with<.T,.H> hasher key cap

//: hashset_next_slot: linear probing の[次/つぎ]の index を[返/かえ]す
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"hashset_next_slot_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"next slot\" expected=\"2\" actual=\"2\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"next slot wraps\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/hashset/probe" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "hashset_next_slot_doc"
//:         |> test_report_push assert_eq_i32 "next slot" 2 hashset_next_slot 1 4
//:         |> test_report_push assert_eq_i32 "next slot wraps" 0 hashset_next_slot 3 4
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn hashset_next_slot %fn i32 fn i32 i32 \idx\cap:
    rem_u add idx 1 cap

//: hashset_find_present: key が[存在/そんざい]する slot を[探/さが]す
//:
//: ### [実装/じっそう]
//: - hash index から linear probing し、`Empty` で chain 終端、`Tombstone` は[通過/つうか]、`Full` は key equality で[判定/はんてい]します。
//: - [見/み]つかった slot は `Some index`、[未登録/みとうろく]または不変条件上 chain が閉じない場合は `None` で[返/かえ]します。
pub fn hashset_find_present <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %fn &HashSetStorage .T fn i32 fn .H fn .T Option i32 \storage\cap\hasher\key:
    let states hashset_storage_states storage
    let keys hashset_storage_keys storage
    let start %i32 hashset_bucket_index<.T,.H> cap hasher key
    let mut cur %i32 start
    let mut found %Option i32 none
    let mut done %bool false
    let mut probes %i32 0
    while and lt probes cap not done:
        do:
            match hashset_state_at states cur:
                HashSetBucketState::Empty:
                    set done true
                HashSetBucketState::Tombstone:
                    set cur hashset_next_slot cur cap
                HashSetBucketState::Full:
                    match hashset_key_at<.T> keys cur:
                        Option::None:
                            set cur hashset_next_slot cur cap
                        Option::Some existing:
                            if:
                                hashkey_eq<.T> existing key
                                then:
                                    set found some cur
                                    set done true
                                else:
                                    set cur hashset_next_slot cur cap
            set probes add probes 1
    found

//: hashset_find_insert_slot: 新規 key の[挿入/そうにゅう]先 slot を[探/さが]す
//:
//: ### [実装/じっそう]
//: - 最初の tombstone を[覚/おぼ]えつつ probe し、empty に[到達/とうたつ]したら tombstone 優先で `Some slot` を[返/かえ]します。
//: - capacity 周回で empty に[到達/とうたつ]できない場合は、slot 0 などの仮値を書かず `None` を[返/かえ]します。
pub fn hashset_find_insert_slot <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %fn &HashSetStorage .T fn i32 fn .H fn .T Option HashSetInsertSlot \storage\cap\hasher\key:
    let states hashset_storage_states storage
    let start %i32 hashset_bucket_index<.T,.H> cap hasher key
    let mut cur %i32 start
    let mut first_tomb %Option i32 none
    let mut result_idx %Option i32 none
    let mut result_state %HashSetInsertSlotState HashSetInsertSlotState::EmptySlot
    let mut done %bool false
    let mut probes %i32 0
    while and lt probes cap not done:
        do:
            match hashset_state_at states cur:
                HashSetBucketState::Empty:
                    match first_tomb:
                        Option::None:
                            set result_idx some cur
                            set result_state HashSetInsertSlotState::EmptySlot
                        Option::Some tomb:
                            set result_idx some tomb
                            set result_state HashSetInsertSlotState::TombstoneSlot
                    set done true
                HashSetBucketState::Tombstone:
                    match first_tomb:
                        Option::None:
                            set first_tomb some cur
                        Option::Some _tomb:
                            unit
                    set cur hashset_next_slot cur cap
                HashSetBucketState::Full:
                    set cur hashset_next_slot cur cap
            set probes add probes 1
    match result_idx:
        Option::Some idx:
            some HashSetInsertSlot idx result_state
        Option::None:
            none

//: hashset_insert_entry_into_storage: rehash [中/ちゅう]の新 table へ key を[移/うつ]す
//:
//: ### [目的/もくてき]
//: - 既存 key を新しい empty storage へ[再配置/さいはいち]します。
//: - insert slot が得られない場合は table 不変条件の破れとして `Diag` を[返/かえ]し、呼び出し側が owner を保った error に変換します。
pub fn hashset_insert_entry_into_storage <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn &HashSetStorage .T impure fn i32 impure fn .H impure fn .T Result unit Diag \storage\cap\hasher\key:
    match hashset_find_insert_slot<.T,.H> storage cap hasher key:
        Option::Some slot:
            let idx %i32 field::get slot "index"
            hashset_store_full<.T> storage idx key
            Result::Ok unit
        Option::None:
            Result::Err diag_capacity_exceeded
