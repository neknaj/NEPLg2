//: # hashmap
//: key trait と hasher [型/がた]に[基/もと]づく generic [連想配列/れんそうはいれつ]
//:
//: ### [目的/もくてき]
//: - `HashMap<.K, .V, .H>` を[提供/ていきょう]し、`new` / `insert` / `get` / `contains` / `remove` / `len` / `free` の bare 名で[操作/そうさ]できるようにします。
//: - key [比較/ひかく]は `HashKey` trait に、hash [計算/けいさん]は hasher value へ[対/たい]する `hash32` overload に[委譲/いじょう]します。
//:
//: ### [実装/じっそう]
//: - open addressing + linear probing の hash table です。
//: - bucket [状態/じょうたい]は `0 = empty`, `1 = full`, `2 = tombstone` で[管理/かんり]し、[削除/さくじょ]で probe chain が[壊/こわ]れないようにします。
//: - `insert` は load factor と tombstone 数を[見/み]て grow / rehash を[行/おこな]います。
//: - `HashMap` は header owner と entries owner を struct field として[保持/ほじ]し、entries の[解放/かいほう][責務/せきむ]を header 内 raw cell に[隠/かく]しません。
//:
//: ### [注意/ちゅうい]
//: - key 型 `.K` は `HashKey` の impl を[持/も]つ[必要/ひつよう]があります。
//: - key 型 `.K` は `HashKey` の impl に加えて標準 `Copy` の impl を[持/も]つ[必要/ひつよう]があります。
//: - value 型 `.V` は標準 `Copy` の impl を[持/も]つ[必要/ひつよう]があります。この map は key/value の deep drop を[行/おこな]わず、Copy payload を raw table に[保存/ほぞん]します。
//: - hasher 型 `.H` は `Hasher<.K>` と標準 `Copy` を impl する[必要/ひつよう]があります。
//: - `get` / `contains` / `len` は `&HashMap` を[受/う]け[取/と]る read API です。読み[取/と]り[後/ご]も owner は[呼/よ]び[出/だ]し[側/がわ]に[残/のこ]るため、最後に `free` で[解放/かいほう]します。
//: - [確保/かくほ][失敗/しっぱい]では `Diag::OutOfMemory` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] `insert` / `get` / `contains` / `remove` は O(1) です。
//: - [最悪/さいあく]は probe が[全体/ぜんたい]を[走査/そうさ]して O(n) です。

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *

//: ## user-defined key と DefaultHash32
//: `HashKey` を[実装/じっそう]したユーザー[定義/ていぎ] struct が、標準 hasher の `DefaultHash32` で `HashMap` の key として[使/つか]えることを[確認/かくにん]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "alloc/diag/error" as *
//:| #import "alloc/string" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/traits/copy" as *
//:| #import "core/traits/hash" as *
//:| #import "core/traits/hash_key" as *
//: struct Point:
//:     x <i32>
//:     y <i32>
//:
//: impl HashKey for Point:
//:     fn eq <(Point,Point)->bool> (a, b):
//:         let ax <i32> field::get a "x"
//:         let ay <i32> field::get a "y"
//:         let bx <i32> field::get b "x"
//:         let by <i32> field::get b "y"
//:         and (eq ax bx) (eq ay by)
//:
//:     fn hash32 <(Point)->i32> (self):
//:         xor field::get self "x" field::get self "y"
//:
//: impl Clone for Point:
//:     fn clone <(&Point)->Point> (self):
//:         *self
//:
//: impl Copy for Point:
//:     fn copy_mark <(Point)->Point> (self):
//:         self
//:
//: fn must_hmp <(Result<HashMap<Point,str,DefaultHash32>, Diag>)*>HashMap<Point,str,DefaultHash32>> (r):
//:     match r:
//:         Result::Ok hm:
//:             hm
//:         Result::Err _d:
//:             #intrinsic "unreachable" <> ()
//:
//: fn main <()*>i32> ():
//:     let map0 <HashMap<Point,str,DefaultHash32>> must_hmp new DefaultHash32;
//:     let map1 <HashMap<Point,str,DefaultHash32>> must_hmp insert map0 (Point 10 20) "Start";
//:     let out <i32> match get &map1 (Point 10 20):
//:         Option::Some name:
//:             if eq 5 len name 0 2
//:         Option::None:
//:             1
//:     free map1;
//:     out
//: ```

//: ## HashMap
//: key/value を[保持/ほじ]する hash table の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [内部/ないぶ] header、entries [領域/りょういき]、hasher [値/あたい]をまとめて[保持/ほじ]し、bare API から[一貫/いっかん]して[扱/あつか]えるようにします。
//:
//: ### [注意/ちゅうい]
//: - `hdr` は [要素数/ようそすう]・[容量/ようりょう]・tombstone 数を[持/も]つ[内部/ないぶ] header への pointer owner です。
//: - `entries` は bucket 配列への pointer owner です。ResourceIR が backing storage の[解放/かいほう][責務/せきむ]を field として[追跡/ついせき]できるように header から[分離/ぶんり]しています。
//: - `hasher` は `insert` / `get` / `remove` の probe [開始位置/かいしいち]を[決/き]めるために[保持/ほじ]されます。
struct HashMap<.K,.V,.H>:
    hdr <MemPtr<u8>>
    entries <MemPtr<u8>>
    hasher <.H>

fn hashmap_entry_size <.K,.V> <()->i32> ():
    add 4 add size_of<.K> size_of<.V>

fn hashmap_bucket_index <.K: HashKey&Copy,.H: Hasher<.K>&Copy> <(i32,.H,.K)->i32> (cap, hasher, key):
    rem_u hash_with hasher key cap

fn hashmap_status_ptr <(i32,i32,i32)->i32> (entries, size, idx):
    add entries mul idx size

fn hashmap_key_ptr <.K,.V> <(i32,i32,i32)->i32> (entries, size, idx):
    add hashmap_status_ptr entries size idx 4

fn hashmap_value_ptr <.K,.V> <(i32,i32,i32)->i32> (entries, size, idx):
    add hashmap_key_ptr<.K,.V> entries size idx size_of<.K>

fn hashmap_next_slot <(i32,i32)->i32> (idx, cap):
    mod_s add idx 1 cap

fn hashmap_slot_matches <.K: HashKey&Copy,.V> <(i32,i32,i32,.K)->bool> (entries, size, idx, key):
    let ptr <i32> hashmap_key_ptr<.K,.V> entries size idx
    let saved <.K> load<.K> ptr
    hashkey_eq saved key

fn hashmap_find_present <.K: HashKey&Copy,.V,.H: Hasher<.K>&Copy> <(i32,i32,i32,.H,.K)->i32> (entries, size, cap, hasher, key):
    let start <i32> hashmap_bucket_index<.K,.H> cap hasher key
    let mut cur <i32> start
    let mut found <i32> -1
    let mut done <bool> false
    while not done:
        do:
            let st_ptr <i32> hashmap_status_ptr entries size cur
            let st <i32> load_i32 st_ptr
            if:
                eq st 0
                then:
                    set done true
                else:
                    let present <bool> eq st 1
                    let same <bool> if present then hashmap_slot_matches<.K,.V> entries size cur key else false
                    if:
                        same
                        then:
                            set found cur
                            set done true
                        else:
                            let nxt <i32> hashmap_next_slot cur cap
                            if:
                                eq nxt start
                                then set done true
                                else set cur nxt
    found

//: hashmap_normalize_capacity: hash map の[実容量/じつようりょう]を[下限/かげん]つきで[決/き]める
//:
//: requested が[小/ちい]さすぎると 75% load limit が[低/ひく]くなりすぎるため、内部 table は最低 4 bucket に[丸/まる]めます。
fn hashmap_normalize_capacity <(i32)->i32> (requested):
    if lt requested 4 then 4 else requested

//: hashmap_load_limit: grow / rehash の[閾値/しきいち]を[計算/けいさん]する
//:
//: open addressing の probe 悪化を[抑/おさ]えるため、full slot と tombstone の合計が容量の 75% を[超/こ]える前に再配置します。
fn hashmap_load_limit <(i32)->i32> (cap):
    div_s mul cap 3 4

//: hashmap_alloc_entries: entries [領域/りょういき]を[確保/かくほ]して status を empty に[初期化/しょきか]する
//:
//: key/value 領域は未初期化のままにし、status が 1 の bucket だけを有効要素として[扱/あつか]います。
fn hashmap_alloc_entries <.K,.V> <(i32)*>Result<MemPtr<u8>, Diag>> (cap):
    let size <i32> hashmap_entry_size<.K,.V>
    let entries <i32> alloc_raw mul cap size
    if:
        eq entries 0
        then:
            diag_err<MemPtr<u8>> diag_out_of_memory "hashmap_alloc_entries"
        else:
            let mut i <i32> 0
            while lt i cap:
                do:
                    let st_ptr <i32> hashmap_status_ptr entries size i
                    store_i32 st_ptr 0
                    set i add i 1
            ok<MemPtr<u8>, Diag> mem_ptr_wrap entries

//: hashmap_insert_rehashed_entry: rehash [中/ちゅう]の新 table へ entry を[移/うつ]す
//:
//: [前提/ぜんてい]として新 table には同じ key がなく、load limit 以下の容量が[確保/かくほ]されています。tombstone は作らず empty slot にだけ配置します。
fn hashmap_insert_rehashed_entry <.K: HashKey&Copy,.V,.H: Hasher<.K>&Copy> <(i32,i32,i32,.H,.K,.V)*>()> (entries, size, cap, hasher, key, value):
    let start <i32> hashmap_bucket_index<.K,.H> cap hasher key
    let mut cur <i32> start
    let mut placed <bool> false
    while not placed:
        do:
            let st_ptr <i32> hashmap_status_ptr entries size cur
            let st <i32> load_i32 st_ptr
            if:
                eq st 0
                then:
                    store_i32 st_ptr 1
                    store<.K> hashmap_key_ptr<.K,.V> entries size cur key
                    store<.V> hashmap_value_ptr<.K,.V> entries size cur value
                    set placed true
                else:
                    set cur hashmap_next_slot cur cap

//: hashmap_rehash_to: live entry だけを新しい entries [領域/りょういき]へ[再配置/さいはいち]する
//:
//: full slot の key/value を新 table に移し、旧 entries を[解放/かいほう]します。tombstone はすべて[捨/す]てるため header の tombstone 数は 0 に戻ります。
fn hashmap_rehash_to <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(HashMap<.K,.V,.H>,i32)*>Result<HashMap<.K,.V,.H>, Diag>> (hm, requested_cap):
    let hdr <MemPtr<u8>> field::get hm "hdr"
    let old_entries_mem <MemPtr<u8>> field::get hm "entries"
    let hasher <.H> field::get hm "hasher"
    let hdr_raw <i32> mem_ptr_addr hdr
    let old_cap <i32> load_i32 add hdr_raw 4
    let old_entries <i32> mem_ptr_addr old_entries_mem
    let new_cap <i32> hashmap_normalize_capacity requested_cap
    let old_size <i32> hashmap_entry_size<.K,.V>
    match hashmap_alloc_entries<.K,.V> new_cap:
        Result::Err d:
            dealloc_raw old_entries mul old_cap old_size
            dealloc_raw hdr_raw 12
            err<HashMap<.K,.V,.H>, Diag> d
        Result::Ok new_entries_mem:
            let new_entries <i32> mem_ptr_addr new_entries_mem
            let new_size <i32> hashmap_entry_size<.K,.V>
            let mut i <i32> 0
            while lt i old_cap:
                do:
                    let st <i32> load_i32 hashmap_status_ptr old_entries old_size i
                    if:
                        eq st 1
                        then:
                            let key <.K> load<.K> hashmap_key_ptr<.K,.V> old_entries old_size i
                            let value <.V> load<.V> hashmap_value_ptr<.K,.V> old_entries old_size i
                            hashmap_insert_rehashed_entry<.K,.V,.H> new_entries new_size new_cap hasher key value
                        else:
                            ()
                    set i add i 1
            dealloc_raw old_entries mul old_cap old_size
            store_i32 add hdr_raw 4 new_cap
            store_i32 add hdr_raw 8 0
            ok<HashMap<.K,.V,.H>, Diag> HashMap hdr new_entries_mem hasher

//: hashmap_prepare_insert: key [追加/ついか]前に必要な grow / rehash を[行/おこな]う
//:
//: 既存 key の更新では容量を変えません。新規 key では count と tombstone を合わせた occupied 数を見て、必要なら同容量 rehash または 2 倍 grow を選びます。
fn hashmap_prepare_insert <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(HashMap<.K,.V,.H>,.K)*>Result<HashMap<.K,.V,.H>, Diag>> (hm, key):
    let hdr <MemPtr<u8>> field::get hm "hdr"
    let entries_mem <MemPtr<u8>> field::get hm "entries"
    let hasher <.H> field::get hm "hasher"
    let hdr_raw <i32> mem_ptr_addr hdr
    let cap <i32> load_i32 add hdr_raw 4
    let entries <i32> mem_ptr_addr entries_mem
    let size <i32> hashmap_entry_size<.K,.V>
    let idx <i32> hashmap_find_present<.K,.V,.H> entries size cap hasher key
    if:
        not lt idx 0
        then:
            ok<HashMap<.K,.V,.H>, Diag> HashMap hdr entries_mem hasher
        else:
            let count <i32> load_i32 hdr_raw
            let tombstones <i32> load_i32 add hdr_raw 8
            let limit <i32> hashmap_load_limit cap
            let occupied_after_insert <i32> add add count tombstones 1
            if:
                gt occupied_after_insert limit
                then:
                    let count_after_insert <i32> add count 1
                    let target_cap <i32> if gt count_after_insert limit then mul cap 2 else cap
                    hashmap_rehash_to<.K,.V,.H> (HashMap hdr entries_mem hasher) target_cap
                else:
                    ok<HashMap<.K,.V,.H>, Diag> HashMap hdr entries_mem hasher

//: hashmap_new_with_capacity: `new` と `with_capacity` が[共有/きょうゆう]する constructor
//:
//: 公開 API 名の overload 解決に依存せず、容量正規化、entries 確保、header 初期化を 1 [箇所/かしょ]に[集約/しゅうやく]します。
fn hashmap_new_with_capacity <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(.H,i32)*>Result<HashMap<.K,.V,.H>, Diag>> (hasher, requested):
    let cap <i32> hashmap_normalize_capacity requested
    match hashmap_alloc_entries<.K,.V> cap:
        Result::Err d:
            err<HashMap<.K,.V,.H>, Diag> d
        Result::Ok entries:
            let hdr <i32> alloc_raw 12
            if:
                eq hdr 0
                then:
                    let entry_bytes <i32> mul cap hashmap_entry_size<.K,.V>
                    dealloc_raw mem_ptr_addr entries entry_bytes
                    diag_err<HashMap<.K,.V,.H>> diag_out_of_memory "hashmap_with_capacity(header)"
                else:
                    store_i32 hdr 0
                    store_i32 add hdr 4 cap
                    store_i32 add hdr 8 0
                    ok<HashMap<.K,.V,.H>, Diag> HashMap (mem_ptr_wrap hdr) entries hasher

//: ## new
//: [空/から]の `HashMap<.K, .V, .H>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - hasher [値/あたい]を[受/う]け[取/と]り、[空/から]の hash map を[初期化/しょきか]します。
//:
//: ### [実装/じっそう]
//: - [初期容量/しょきようりょう] 16 の entries [領域/りょういき]と header を[確保/かくほ]し、status を 0 で[埋/う]めます。
//:
//: ### [注意/ちゅうい]
//: - [確保/かくほ][失敗/しっぱい]では `Diag::OutOfMemory` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(cap)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let out <i32> if eq len &hm 0 1 0
//:     free hm;
//:     out
//: ```
fn new <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(.H)*>Result<HashMap<.K,.V,.H>, Diag>> (hasher):
    hashmap_new_with_capacity<.K,.V,.H> hasher 16

//: ## with_capacity
//: [指定/してい]した[初期容量/しょきようりょう]で `HashMap<.K, .V, .H>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - self-host compiler の symbol table など、要素数の[見積/みつ]もりがある用途で rehash 回数を[減/へ]らします。
//:
//: ### [注意/ちゅうい]
//: - requested が 4 未満の[場合/ばあい]は 4 に[切/き]り[上/あ]げます。
//: - 実際の `insert` は load factor が 75% を[超/こ]える[前/まえ]に grow します。
fn with_capacity <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(.H,i32)*>Result<HashMap<.K,.V,.H>, Diag>> (hasher, requested):
    hashmap_new_with_capacity<.K,.V,.H> hasher requested

//: ## insert
//: key に value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [目的/もくてき]
//: - key が[未登録/みとうろく]なら[追加/ついか]し、[既存/きそん]なら value を[上書/うわが]きします。
//:
//: ### [実装/じっそう]
//: - 必要なら grow / rehash し、linear probing で slot を[探索/たんさく]し、empty か first tombstone に[配置/はいち]します。
//: - [既存/きそん] key を[見/み]つけた[場合/ばあい]は value だけ[更新/こうしん]します。
//:
//: ### [注意/ちゅうい]
//: - grow / rehash の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Diag::OutOfMemory` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] O(1)、[最悪/さいあく] O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 7 70;
//:     let out <i32> match get &hm1 7:
//:         Option::Some x:
//:             if eq x 70 1 0
//:         Option::None:
//:             0
//:     free hm1;
//:     out
//: ```
fn insert <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(HashMap<.K,.V,.H>,.K,.V)*>Result<HashMap<.K,.V,.H>, Diag>> (hm, key, value):
    match hashmap_prepare_insert<.K,.V,.H> hm key:
        Result::Err d:
            err<HashMap<.K,.V,.H>, Diag> d
        Result::Ok ready:
            let hdr <MemPtr<u8>> field::get ready "hdr"
            let entries_mem <MemPtr<u8>> field::get ready "entries"
            let hasher <.H> field::get ready "hasher"
            let hdr_raw <i32> mem_ptr_addr hdr
            let cap <i32> load_i32 add hdr_raw 4
            let entries <i32> mem_ptr_addr entries_mem
            let size <i32> hashmap_entry_size<.K,.V>
            let start <i32> hashmap_bucket_index<.K,.H> cap hasher key
            let mut cur <i32> start
            let mut first_tomb <i32> -1
            let mut placed <bool> false
            while not placed:
                do:
                    let st_ptr <i32> hashmap_status_ptr entries size cur
                    let st <i32> load_i32 st_ptr
                    if:
                        eq st 0
                        then:
                            let slot <i32> if lt first_tomb 0 then cur else first_tomb
                            let slot_status <i32> hashmap_status_ptr entries size slot
                            let old_status <i32> load_i32 slot_status
                            store_i32 slot_status 1
                            store<.K> hashmap_key_ptr<.K,.V> entries size slot key
                            store<.V> hashmap_value_ptr<.K,.V> entries size slot value
                            store_i32 hdr_raw add load_i32 hdr_raw 1
                            if:
                                eq old_status 2
                                then store_i32 add hdr_raw 8 sub load_i32 add hdr_raw 8 1
                                else ()
                            set placed true
                        else:
                            if:
                                eq st 2
                                then:
                                    if:
                                        lt first_tomb 0
                                        then set first_tomb cur
                                        else ()
                                    set cur hashmap_next_slot cur cap
                                else:
                                    let same <bool> hashmap_slot_matches<.K,.V> entries size cur key
                                    if:
                                        same
                                        then:
                                            store<.V> hashmap_value_ptr<.K,.V> entries size cur value
                                            set placed true
                                        else:
                                            set cur hashmap_next_slot cur cap
            ok<HashMap<.K,.V,.H>, Diag> HashMap hdr entries_mem hasher

//: ## get
//: key に[対応/たいおう]する value を[探/さが]す
//:
//: ### [目的/もくてき]
//: - key に[対応/たいおう]する Copy value を `Option` で[返/かえ]します。
//: - map owner は[移動/いどう]せず、`&HashMap` から raw table を[参照/さんしょう]します。
//:
//: ### [実装/じっそう]
//: - `hashmap_find_present` で slot index を[見/み]つけ、[存在/そんざい]する[場合/ばあい]だけ value を `load` します。
//:
//: ### [注意/ちゅうい]
//: - key が[存在/そんざい]しない[場合/ばあい]は `Option::None` です。
//: - `.V` は `Copy` が[必要/ひつよう]です。所有 payload を[返/かえ]したい場合は、remove/take 系 API と deep drop 契約を別に[設計/せっけい]します。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] O(1)、[最悪/さいあく] O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hm_empty <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let missing <bool> is_none<i32> get &hm_empty 4
//:     free hm_empty;
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 3 30;
//:     let out <i32> match get &hm1 3:
//:         Option::Some x:
//:             let value_ok <bool> eq x 30
//:             if and missing value_ok 1 0
//:         Option::None:
//:             0
//:     free hm1;
//:     out
//: ```
fn get <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(&HashMap<.K,.V,.H>,.K)->Option<.V>> (hm, key):
    let hdr <MemPtr<u8>> *field::get_ref hm "hdr"
    let entries_mem <MemPtr<u8>> *field::get_ref hm "entries"
    let hasher <.H> *field::get_ref hm "hasher"
    let hdr_raw <i32> mem_ptr_addr hdr
    let cap <i32> load_i32 add hdr_raw 4
    let entries <i32> mem_ptr_addr entries_mem
    let size <i32> hashmap_entry_size<.K,.V>
    let idx <i32> hashmap_find_present<.K,.V,.H> entries size cap hasher key
    if:
        lt idx 0
        then none<.V>
        else:
            let vp <i32> hashmap_value_ptr<.K,.V> entries size idx
            some<.V> load<.V> vp

//: ## contains
//: key の[存在/そんざい]を[確/たし]かめる
//:
//: ### [目的/もくてき]
//: - map owner を[移動/いどう]せず、key の[存在/そんざい]だけを[判定/はんてい]します。
//:
//: ### [実装/じっそう]
//: - `get` を[呼/よ]んで `Option` の `Some/None` から bool を[作/つく]ります。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] O(1)、[最悪/さいあく] O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 9 90;
//:     let out <i32> if contains &hm1 9 1 0
//:     free hm1;
//:     out
//: ```
fn contains <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(&HashMap<.K,.V,.H>,.K)->bool> (hm, key):
    let got <Option<.V>> get<.K,.V,.H> hm key
    is_some<.V> got

//: ## remove
//: key を[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - key に[対応/たいおう]する[要素/ようそ]を tombstone に[変/か]えて probe chain を[維持/いじ]します。
//:
//: ### [実装/じっそう]
//: - `hashmap_find_present` で index を[求/もと]め、status を 2 に[書/か]き[換/か]えます。
//:
//: ### [注意/ちゅうい]
//: - key が[無/な]い[場合/ばあい]は `Diag::KeyNotFound` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] O(1)、[最悪/さいあく] O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 5 50;
//:     let hm2 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> remove hm1 5;
//:     let out <i32> if is_none<i32> get &hm2 5 1 0
//:     free hm2;
//:     out
//: ```
fn remove <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(HashMap<.K,.V,.H>,.K)*>Result<HashMap<.K,.V,.H>, Diag>> (hm, key):
    let hdr <MemPtr<u8>> field::get hm "hdr"
    let entries_mem <MemPtr<u8>> field::get hm "entries"
    let hasher <.H> field::get hm "hasher"
    let hdr_raw <i32> mem_ptr_addr hdr
    let cap <i32> load_i32 add hdr_raw 4
    let entries <i32> mem_ptr_addr entries_mem
    let size <i32> hashmap_entry_size<.K,.V>
    let idx <i32> hashmap_find_present<.K,.V,.H> entries size cap hasher key
    if:
        lt idx 0
        then:
            dealloc_raw entries mul cap size
            dealloc_raw hdr_raw 12
            diag_err<HashMap<.K,.V,.H>> diag_key_not_found "hashmap_remove"
        else:
            let st_ptr <i32> hashmap_status_ptr entries size idx
            store_i32 st_ptr 2
            store_i32 hdr_raw sub load_i32 hdr_raw 1
            store_i32 add hdr_raw 8 add load_i32 add hdr_raw 8 1
            ok<HashMap<.K,.V,.H>, Diag> HashMap hdr entries_mem hasher

//: ## len
//: [要素数/ようそすう]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - [現在/げんざい][登録/とうろく]されている key/value [組/くみ]の[個数/こすう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - header [先頭/せんとう]の count をそのまま[読/よ]みます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 1 10;
//:     let hm2 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm1 2 20;
//:     let out <i32> if eq len &hm2 2 1 0
//:     free hm2;
//:     out
//: ```
fn len <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(&HashMap<.K,.V,.H>)->i32> (hm):
    let hdr <MemPtr<u8>> *field::get_ref hm "hdr"
    load_i32 mem_ptr_addr hdr

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - entries [領域/りょういき]と header を[順番/じゅんばん]に[解放/かいほう]します。
//:
//: ### [注意/ちゅうい]
//: - key/value [自体/じたい]の[深/ふか]い[解放/かいほう]は[行/おこな]いません。そのため `.K` と `.V` は `Copy` に[限定/げんてい]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm0 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> new DefaultHash32;
//:     let hm1 <HashMap<i32, i32, DefaultHash32>> unwrap_ok<HashMap<i32, i32, DefaultHash32>, Diag> insert hm0 1 10;
//:     free hm1;
//:     0
//: ```
fn free <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> <(HashMap<.K,.V,.H>)*>()> (hm):
    let hdr <MemPtr<u8>> field::get hm "hdr"
    let entries_mem <MemPtr<u8>> field::get hm "entries"
    let hdr_raw <i32> mem_ptr_addr hdr
    let cap <i32> load_i32 add hdr_raw 4
    let entries <i32> mem_ptr_addr entries_mem
    let entry_size <i32> add 4 add size_of<.K> size_of<.V>
    let entry_bytes <i32> mul cap entry_size
    dealloc_raw entries entry_bytes
    dealloc_raw hdr_raw 12
