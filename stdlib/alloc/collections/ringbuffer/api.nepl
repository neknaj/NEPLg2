//: # ringbuffer/api
//: FIFO ring buffer の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `with_capacity` / `len` / `cap` / `is_empty` / `push` / `pop_front` / `pop` / `peek` / `clear` / `free` を[提供/ていきょう]します。
//: - owner を[更新/こうしん]する API と、owner を[借用/しゃくよう]して[観測/かんそく]する API を[分/わ]けます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `cap` / `is_empty` / `peek` / `pop` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./index" as *
#import "./storage" as *
#import "core/field" as *

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から]バッファを[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/ringbuffer" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let rb %RingBuffer i32 unwrap_ok new<i32>;
//:     let ok %bool is_empty<i32> &rb;
//:     free<i32> rb
//:     if ok 1 0
//: ```
pub fn new <.T: Copy> %impure fn unit Result RingBuffer .T Diag \unit:
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して[作成/さくせい]する
pub fn with_capacity <.T: Copy> %impure fn i32 Result RingBuffer .T Diag \initial_cap:
    let cap0 %i32 ringbuffer_normalize_capacity initial_cap
    match ringbuffer_alloc_slots<.T> cap0:
        Result::Err d:
            err d
        Result::Ok items:
            ok RingBuffer<.T> 0 cap0 0 items

//: ## len
//: buffer owner を[消費/しょうひ]せず[要素数/ようそすう]を[返/かえ]す
pub fn len <.T> %fn &RingBuffer .T i32 \rb:
    *field::get_ref rb "len"

//: ## cap
//: buffer owner を[消費/しょうひ]せず[容量/ようりょう]を[返/かえ]す
pub fn cap <.T> %fn &RingBuffer .T i32 \rb:
    *field::get_ref rb "cap"

//: ## is_empty
//: buffer owner を[消費/しょうひ]せず[空/から]かどうかを[返/かえ]す
pub fn is_empty <.T> %fn &RingBuffer .T bool \rb:
    eq len<.T> rb 0

//: ## push
//: [末尾/まつび]へ[追加/ついか]する
pub fn push <.T: Copy> %impure fn RingBuffer .T impure fn .T Result RingBuffer .T RingBufferPushError .T \rb\item:
    let len0 %i32 *field::get_ref &rb "len"
    let cap0 %i32 *field::get_ref &rb "cap"
    let head0 %i32 *field::get_ref &rb "head"
    let items %Vec Option .T field::get rb "items"
    if:
        eq len0 cap0
        then:
            let new_cap %i32 mul cap0 2
            match ringbuffer_alloc_slots<.T> new_cap:
                Result::Err d:
                    Result::Err RingBufferPushError<.T> (RingBuffer<.T> len0 cap0 head0 items) d
                Result::Ok new_items:
                    ringbuffer_copy_live_slots<.T> &items &new_items cap0 head0 len0
                    ringbuffer_store_slot<.T> &new_items len0 some item
                    vec::free<Option<.T>> items
                    Result::Ok RingBuffer<.T> add len0 1 new_cap 0 new_items
        else:
            let tail %i32 ringbuffer_tail_index head0 len0 cap0
            ringbuffer_store_slot<.T> &items tail some item
            Result::Ok RingBuffer<.T> add len0 1 cap0 head0 items

//: ## pop_front
//: [先頭/せんとう]を[取/と]り[出/だ]し、[更新後/こうしんご]の buffer と[値/あたい]を[返/かえ]す
pub fn pop_front <.T: Copy> %impure fn RingBuffer .T RingBufferPop .T \rb:
    let len0 %i32 *field::get_ref &rb "len"
    let cap0 %i32 *field::get_ref &rb "cap"
    let head0 %i32 *field::get_ref &rb "head"
    let items %Vec Option .T field::get rb "items"
    if:
        eq len0 0
        then:
            let next_rb %RingBuffer .T RingBuffer<.T> 0 cap0 head0 items
            RingBufferPop<.T> next_rb none
        else:
            let item %Option .T ringbuffer_item_at<.T> &items head0
            ringbuffer_store_slot<.T> &items head0 none
            let next_len %i32 sub len0 1
            let next_head %i32 ringbuffer_next_index head0 cap0
            let next_rb %RingBuffer .T RingBuffer<.T> next_len cap0 next_head items
            RingBufferPop<.T> next_rb item

//: ## pop
//: buffer を[消費/しょうひ]して[先頭/せんとう]の[値/あたい]だけを[返/かえ]す
pub fn pop <.T: Copy> %impure fn RingBuffer .T Option .T \rb:
    let p %RingBufferPop .T pop_front<.T> rb
    let item %Option .T ringbuffer_pop_item<.T> &p
    free<.T> ringbuffer_pop_buffer<.T> p
    item

//: ## peek
//: buffer owner を[消費/しょうひ]せず[先頭/せんとう]を[読/よ]む
pub fn peek <.T: Copy> %fn &RingBuffer .T Option .T \rb:
    let len0 %i32 *field::get_ref rb "len"
    if:
        eq len0 0
        then:
            none
        else:
            let head0 %i32 *field::get_ref rb "head"
            let items %&Vec Option .T field::get_ref rb "items"
            ringbuffer_item_at<.T> items head0

//: ## clear
//: [内容/ないよう]を[空/から]にする
pub fn clear <.T: Copy> %impure fn RingBuffer .T RingBuffer .T \rb:
    let cap0 %i32 *field::get_ref &rb "cap"
    let items %Vec Option .T field::get rb "items"
    ringbuffer_clear_slots_loop<.T> &items cap0 0
    RingBuffer<.T> 0 cap0 0 items

//: ## free
//: buffer が[所有/しょゆう]する Copy-only backing storage を[解放/かいほう]する
pub fn free <.T: Copy> %fn RingBuffer .T unit \rb:
    vec::free<Option<.T>> field::get rb "items"
