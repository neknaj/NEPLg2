//: # ringbuffer/index
//: circular FIFO buffer の index 計算
//:
//: ### [目的/もくてき]
//: - capacity 正規化、tail、next index を API 本体から[分/わ]けます。
//: - circular storage の境界計算を局所化し、push / pop の所有権処理と混ざらないようにします。

#indent 4

#import "core/math" as *

//: ringbuffer_normalize_capacity: 1 [以上/いじょう]の capacity に[正規化/せいきか]する
pub fn ringbuffer_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

//: ringbuffer_tail_index: `head + len` の circular tail index を[返/かえ]す
pub fn ringbuffer_tail_index <(i32,i32,i32)->i32> (head, len, cap):
    rem_u add head len cap

//: ringbuffer_next_index: circular buffer の[次/つぎ]の index を[返/かえ]す
pub fn ringbuffer_next_index <(i32,i32)->i32> (idx, cap):
    rem_u add idx 1 cap
