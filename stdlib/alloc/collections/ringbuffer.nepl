//: # ringbuffer
//: `Vec<Option<T>>` backed circular FIFO buffer
//:
//: ### [目的/もくてき]
//: - `push` / `pop` / `peek` を[備/そな]えた FIFO [基盤/きばん]を[提供/ていきょう]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` / `head` と `items` を struct field として[保持/ほじ]します。
//: - `items` は `cap` [個/こ]の `Option<T>` で、live slot は `Some(value)`、inactive slot は `None` です。
//: - grow 時は head からの[論理順/ろんりじゅん]に新しい storage へ[並/なら]べ[直/なお]し、head を 0 に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には ringbuffer payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `cap` / `is_empty` / `peek` は owner を borrow して[観測/かんそく]します。
//: - `pop_front` は[更新後/こうしんご] owner と値を[返/かえ]し、`pop` は先頭値だけを返して buffer owner を[閉/と]じる terminal API です。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `cap` / `is_empty` / `peek` / `pop` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## RingBuffer
//: FIFO ring buffer の owner
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`
struct RingBuffer<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>

//: ## RingBufferPop
//: `pop_front` の[結果/けっか]
//:
//: ### [目的/もくてき]
//: - [更新後/こうしんご]の buffer owner と[取/と]り[出/だ]した[値/あたい]を[同時/どうじ]に[返/かえ]します。
struct RingBufferPop<.T>:
    buffer <RingBuffer<.T>>
    item <Option<.T>>

fn ringbuffer_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

fn ringbuffer_tail_index <(i32,i32,i32)->i32> (head, len, cap):
    rem_u add head len cap

fn ringbuffer_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

fn ringbuffer_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace<Option<.T>> items idx item

fn ringbuffer_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

fn ringbuffer_clear_slots_loop <.T: Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, cap, i):
    if:
        lt i cap
        then:
            ringbuffer_store_slot<.T> items i none<.T>
            ringbuffer_clear_slots_loop<.T> items cap add i 1
        else:
            ()

fn ringbuffer_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32,i32,i32)*>()> (src, dst, cap, head, len):
    let mut i <i32> 0
    while lt i len:
        do:
            let src_idx <i32> rem_u add head i cap
            match ringbuffer_item_at<.T> src src_idx:
                Option::Some item:
                    ringbuffer_store_slot<.T> dst i some<.T> item
                Option::None:
                    ()
            set i add i 1

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から]バッファを[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/ringbuffer" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let rb <RingBuffer<i32>> unwrap_ok<RingBuffer<i32>, Diag> new<i32>;
//:     let ok <bool> is_empty<i32> &rb;
//:     free<i32> rb
//:     if ok 1 0
//: ```
fn new <.T: Copy> <()*>Result<RingBuffer<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して[作成/さくせい]する
fn with_capacity <.T: Copy> <(i32)*>Result<RingBuffer<.T>, Diag>> (initial_cap):
    let cap0 <i32> ringbuffer_normalize_capacity initial_cap
    match ringbuffer_alloc_slots<.T> cap0:
        Result::Err d:
            err<RingBuffer<.T>, Diag> d
        Result::Ok items:
            ok<RingBuffer<.T>, Diag> RingBuffer<.T> 0 cap0 0 items

//: ## len
//: buffer owner を[消費/しょうひ]せず[要素数/ようそすう]を[返/かえ]す
fn len <.T> <(&RingBuffer<.T>)->i32> (rb):
    *field::get_ref rb "len"

//: ## cap
//: buffer owner を[消費/しょうひ]せず[容量/ようりょう]を[返/かえ]す
fn cap <.T> <(&RingBuffer<.T>)->i32> (rb):
    *field::get_ref rb "cap"

//: ## is_empty
//: buffer owner を[消費/しょうひ]せず[空/から]かどうかを[返/かえ]す
fn is_empty <.T> <(&RingBuffer<.T>)->bool> (rb):
    eq len<.T> rb 0

//: ## push
//: [末尾/まつび]へ[追加/ついか]する
fn push <.T: Copy> <(RingBuffer<.T>,.T)*>Result<RingBuffer<.T>, Diag>> (rb, item):
    let len0 <i32> *field::get_ref &rb "len"
    let cap0 <i32> *field::get_ref &rb "cap"
    let head0 <i32> *field::get_ref &rb "head"
    let items <Vec<Option<.T>>> field::get rb "items"
    if:
        eq len0 cap0
        then:
            let new_cap <i32> mul cap0 2
            match ringbuffer_alloc_slots<.T> new_cap:
                Result::Err d:
                    vec::free<Option<.T>> items
                    err<RingBuffer<.T>, Diag> d
                Result::Ok new_items:
                    ringbuffer_copy_live_slots<.T> &items &new_items cap0 head0 len0
                    ringbuffer_store_slot<.T> &new_items len0 some<.T> item
                    vec::free<Option<.T>> items
                    ok<RingBuffer<.T>, Diag> RingBuffer<.T> add len0 1 new_cap 0 new_items
        else:
            let tail <i32> ringbuffer_tail_index head0 len0 cap0
            ringbuffer_store_slot<.T> &items tail some<.T> item
            ok<RingBuffer<.T>, Diag> RingBuffer<.T> add len0 1 cap0 head0 items

//: ## pop_front
//: [先頭/せんとう]を[取/と]り[出/だ]し、[更新後/こうしんご]の buffer と[値/あたい]を[返/かえ]す
fn pop_front <.T: Copy> <(RingBuffer<.T>)*>RingBufferPop<.T>> (rb):
    let len0 <i32> *field::get_ref &rb "len"
    let cap0 <i32> *field::get_ref &rb "cap"
    let head0 <i32> *field::get_ref &rb "head"
    let items <Vec<Option<.T>>> field::get rb "items"
    if:
        eq len0 0
        then:
            let next_rb <RingBuffer<.T>> RingBuffer<.T> 0 cap0 head0 items
            RingBufferPop<.T> next_rb none<.T>
        else:
            let item <Option<.T>> ringbuffer_item_at<.T> &items head0
            ringbuffer_store_slot<.T> &items head0 none<.T>
            let next_len <i32> sub len0 1
            let next_head <i32> rem_u add head0 1 cap0
            let next_rb <RingBuffer<.T>> RingBuffer<.T> next_len cap0 next_head items
            RingBufferPop<.T> next_rb item

//: ## pop
//: buffer を[消費/しょうひ]して[先頭/せんとう]の[値/あたい]だけを[返/かえ]す
fn pop <.T: Copy> <(RingBuffer<.T>)*>Option<.T>> (rb):
    let p <RingBufferPop<.T>> pop_front<.T> rb
    let item <Option<.T>> *field::get_ref &p "item"
    free<.T> field::get p "buffer"
    item

//: ## peek
//: buffer owner を[消費/しょうひ]せず[先頭/せんとう]を[読/よ]む
fn peek <.T: Copy> <(&RingBuffer<.T>)->Option<.T>> (rb):
    let len0 <i32> *field::get_ref rb "len"
    if:
        eq len0 0
        then:
            none<.T>
        else:
            let head0 <i32> *field::get_ref rb "head"
            let items <&Vec<Option<.T>>> field::get_ref rb "items"
            ringbuffer_item_at<.T> items head0

//: ## clear
//: [内容/ないよう]を[空/から]にする
fn clear <.T: Copy> <(RingBuffer<.T>)*>RingBuffer<.T>> (rb):
    let cap0 <i32> *field::get_ref &rb "cap"
    let items <Vec<Option<.T>>> field::get rb "items"
    ringbuffer_clear_slots_loop<.T> &items cap0 0
    RingBuffer<.T> 0 cap0 0 items

//: ## free
//: buffer が[所有/しょゆう]する backing storage を[解放/かいほう]する
fn free <.T> <(RingBuffer<.T>)->()> (rb):
    vec::free<Option<.T>> field::get rb "items"
