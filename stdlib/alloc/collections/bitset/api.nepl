//: # bitset/api
//: `BitSet` public 操作の facade
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `contains` / `insert` / `remove` / `clear` / `fill` / `free` の public path を維持します。
//: - 診断生成、構築、借用 observer、owner-consuming update、bulk reset、cleanup を submodule に分けます。
//: - API facade に実装本体を戻さず、所有権を動かす操作と借用で読む操作の境界を見える形に保ちます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"bitset_api_facade_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"length\" expected=\"8\" actual=\"8\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"removed bit absent\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/bitset/types" as *
//:| #import "alloc/collections/bitset/api" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let bs0 %BitSet unwrap_ok new 8
//:     let bs1 %BitSet unwrap_ok insert bs0 2
//:     let bs2 %BitSet unwrap_ok remove bs1 2
//:     let size %i32 len &bs2
//:     let absent %bool not unwrap_ok contains &bs2 2
//:     free bs2
//:     let report:
//:         test_report_new "bitset_api_facade_doc"
//:         |> test_report_push assert_eq_i32 "length" 8 size
//:         |> test_report_push assert "removed bit absent" absent
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

pub #import "./api/diagnostic" as @merge
pub #import "./api/create" as @merge
pub #import "./api/observer" as @merge
pub #import "./api/update" as @merge
pub #import "./api/bulk" as @merge
pub #import "./api/cleanup" as @merge
