//: # bitset/mutation
//: `BitSet` の 1 bit 更新
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` に共通する byte read-modify-write を集約します。
//: - storage 欠損は `false` として API 層へ返し、API 層が owner-preserving error へ変換します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "./storage" as *

pub fn bitset_write_masked %impure fn &Vec u8 impure fn i32 impure fn i32 impure fn bool bool \bits\byte_idx\mask\set_bit:
    match bitset_byte_at bits byte_idx:
        Option::Some cur:
            let set_value %i32 or cur mask
            let clear_mask %i32 xor mask 255
            let clear_value %i32 and cur clear_mask
            let next %i32 if:
                set_bit
                then set_value
                else clear_value
            bitset_store_byte bits byte_idx next
            true
        Option::None:
            false
