//: # bitset/api/create
//: `BitSet` の構築 API
//:
//: ### [目的/もくてき]
//: - bit 長から byte 長を計算し、初期化済み typed byte storage を確保します。
//: - invalid length / allocation failure は `Diag` として返し、trap にしません。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "../types" as *
#import "../layout" as *
#import "../storage" as *
#import "./diagnostic" as *

//: ## new
//: [空/から] bitset を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 64;
//:     let observed_len <i32> len &bs;
//:     let ok <bool> eq observed_len 64;
//:     free bs
//:     if ok 1 0
//: ```
pub fn new <(i32)*>Result<BitSet, Diag>> (nbits):
    if:
        le nbits 0
        then:
            diag_err<BitSet> bitset_invalid_len_diag
        else:
            let nbytes <i32> bitset_byte_len nbits
            match bitset_alloc_bits nbytes 0:
                Result::Err d:
                    err<BitSet, Diag> d
                Result::Ok bits:
                    ok<BitSet, Diag> BitSet nbits nbytes bits
