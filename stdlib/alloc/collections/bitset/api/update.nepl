//: # bitset/api/update
//: `BitSet` の owner-consuming update API
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` の index validation と byte read-modify-write 呼び出しを 1 箇所に集約します。
//: - update 失敗時は `BitSetUpdateError` に元 owner を入れて返し、caller が cleanup できるようにします。

#indent 4

#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../layout" as *
#import "../storage" as *
#import "../mutation" as *
#import "./diagnostic" as *

//: ## bitset_update
//: index validation [後/ご]に bit の on/off を[切/き]り[替/か]える
//:
//: ### [目的/もくてき]
//: - `insert` と `remove` の共通本体です。
//: - storage 欠損や index 範囲外は owner-preserving error に変換します。
pub fn bitset_update <(BitSet,i32,bool)*>Result<BitSet, BitSetUpdateError>> (bs, idx, set_bit):
    let nbits <i32> *field::get_ref &bs "nbits"
    if:
        bitset_valid_index idx nbits
        then:
            let result <Result<(), Diag>> block:
                let bits <&Vec<u8>> field::get_ref &bs "bits"
                let byte_idx <i32> bitset_byte_index idx
                let mask <i32> bitset_mask idx
                if:
                    bitset_write_masked bits byte_idx mask set_bit
                    then:
                        ok<(), Diag> ()
                    else:
                        diag_err<()> bitset_index_diag
            match result:
                Result::Ok _unit:
                    ok<BitSet, BitSetUpdateError> bs
                Result::Err d:
                    let e <BitSetUpdateError> BitSetUpdateError bs d
                    err<BitSet, BitSetUpdateError> e
        else:
            let d <Diag> bitset_index_diag
            let e <BitSetUpdateError> BitSetUpdateError bs d
            err<BitSet, BitSetUpdateError> e

//: ## insert
//: bit を 1 に[設定/せってい]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 16;
//:     let bs1 <BitSet> unwrap_ok<BitSet, BitSetUpdateError> insert bs 3;
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs1 3;
//:     free bs1
//:     if ok 1 0
//: ```
pub fn insert <(BitSet,i32)*>Result<BitSet, BitSetUpdateError>> (bs, idx):
    bitset_update bs idx true

//: ## remove
//: bit を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet>:
//:         unwrap_ok<BitSet, Diag> new 16
//:         |> insert 3 |> uwok
//:         |> remove 3 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs 3;
//:     free bs
//:     if not ok 1 0
//: ```
pub fn remove <(BitSet,i32)*>Result<BitSet, BitSetUpdateError>> (bs, idx):
    bitset_update bs idx false
