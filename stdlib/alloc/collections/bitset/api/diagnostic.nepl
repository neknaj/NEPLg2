//: # bitset/api/diagnostic
//: `BitSet` public API の診断生成
//:
//: ### [目的/もくてき]
//: - 長さ不正と index 範囲外の `Diag` 生成を 1 箇所に集約します。
//: - observer と update が同じ診断 kind/message を返すようにします。

#indent 4

#import "alloc/diag/error" as *
#import "core/result" as *

//: ## bitset_invalid_len_diag
//: `new` の不正な bit [長/ちょう]を[表/あらわ]す診断を[作/つく]る
//:
//: ### [契約/けいやく]
//: - `StdErrorKind::CapacityExceeded` を持つ `Diag` を返します。
//: - 表示文言は caller が match する契約ではありません。静的に扱うべき分類は `StdErrorKind` です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"bitset_invalid_len_diag_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"invalid len kind\" expected=\"CapacityExceeded\" actual=\"CapacityExceeded\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/bitset/api/diagnostic" as *
//:| #import "alloc/diag/error" as *
//: fn main %impure fn void i32 \void:
//:     let d %Diag bitset_invalid_len_diag
//:     let report:
//:         test_report_new "bitset_invalid_len_diag_doc"
//:         |> test_report_push assert_str_eq "invalid len kind" "CapacityExceeded" diag_std_error_kind_str d
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn bitset_invalid_len_diag %impure fn void Diag \void:
    diag_error StdErrorKind::CapacityExceeded "invalid bitset length"

//: ## bitset_index_diag
//: `contains` / `insert` / `remove` の[範囲外/はんいがい] index 診断を[作/つく]る
//:
//: ### [契約/けいやく]
//: - `StdErrorKind::IndexOutOfBounds` を持つ `Diag` を返します。
//: - observer と update は同じ helper を使うため、同じ失敗分類を返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"bitset_index_diag_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"index kind\" expected=\"IndexOutOfBounds\" actual=\"IndexOutOfBounds\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/bitset/api/diagnostic" as *
//:| #import "alloc/diag/error" as *
//: fn main %impure fn void i32 \void:
//:     let d %Diag bitset_index_diag
//:     let report:
//:         test_report_new "bitset_index_diag_doc"
//:         |> test_report_push assert_str_eq "index kind" "IndexOutOfBounds" diag_std_error_kind_str d
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn bitset_index_diag %impure fn void Diag \void:
    diag_error StdErrorKind::IndexOutOfBounds "bitset index out of bounds"
