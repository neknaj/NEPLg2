#indent 4

//: # segment_tree
//: [区間和/くかんわ] query と[点更新/てんこうしん]を[扱/あつか]う Segment Tree
//:
//: ### [目的/もくてき]
//: - `SegmentTree` を[提供/ていきょう]し、`new` / `len` / `replace` / `add` / `sum_range` / `free` の bare API で[点更新/てんこうしん]と[区間和/くかんわ] query を[扱/あつか]えるようにします。
//: - Fenwick では[表現/ひょうげん]しにくい[一般区間/いっぱんくかん] query の[土台/どだい]を `alloc/collections` に[揃/そろ]えます。
//:
//: ### [実装/じっそう]
//: - [内部/ないぶ]は `base` を 2 [冪/べき]に[丸/まる]めた full binary tree を `Vec<i32>` [配列/はいれつ]で[保持/ほじ]する iterative segment tree です。
//: - leaf は `[base, base+n)` に[置/お]き、internal node は[子/こ]の[和/わ]を[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - [現在/げんざい]は `i32` の[加算/かさん] monoid に[固定/こてい]しています。
//: - `new` / `replace` / `add` は `Result` を[返/かえ]します。
//: - [範囲外/はんいがい] index の `replace` / `add` は `Result::Err SegmentTreeUpdateError` で元の owner と[診断/しんだん]を[返/かえ]します。
//: - `sum_range` は `[l, r)` を[返/かえ]し、[不正/ふせい] range は `Result::Err Diag` です。
//: - [読/よ]み[取/と]りだけの[処理/しょり]では `len &st` / `sum_range &st l r` のように borrow して、[最後/さいご]に `free st` で owner を[閉/と]じます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` は O(1)。
//: - `replace` / `add` / `sum_range` は O(log n)。
//: - `new` は O(n)、`free` は O(1)。

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## SegmentTree
//: [長/なが]さと base と[内部配列/ないぶはいれつ]を[所有/しょゆう]する
//:
//: ### [注意/ちゅうい]
//: - `data` は `2 * base` [個/こ]の `i32` を[保持/ほじ]します。
//: - [不要/ふよう]になったら `free` します。
struct SegmentTree:
    n <i32>
    base <i32>
    data <Vec<i32>>

//: ## SegmentTreeUpdateError
//: `replace` / `add` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `replace` / `add` は[更新/こうしん] API なので `SegmentTree` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index では tree storage を[変更/へんこう]せず、caller が cleanup できるように元の `SegmentTree` owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `segment_tree_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`segment_tree_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
struct SegmentTreeUpdateError:
    owner <SegmentTree>
    diag <Diag>

//: segment_tree_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
fn segment_tree_update_error_diag <(&SegmentTreeUpdateError)->Diag> (e):
    *field::get_ref e "diag"

//: segment_tree_update_error_owner: update [失敗/しっぱい]で[戻/もど]された `SegmentTree` owner を[取/と]り[出/だ]す
fn segment_tree_update_error_owner <(SegmentTreeUpdateError)->SegmentTree> (e):
    field::get e "owner"

fn seg_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid segment tree length"

fn seg_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree index out of bounds"

fn seg_diag_range <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "segment tree range out of bounds"

fn seg_load_owned <(&Vec<i32>,i32)->i32> (data, idx):
    match vec::get<i32> data idx:
        Option::Some v:
            v
        Option::None:
            0

fn seg_store_owned <(&Vec<i32>,i32,i32)*>()> (data, idx, value):
    vec::replace<i32> data idx value

fn seg_next_pow2 <(i32)->i32> (n):
    let mut x <i32> 1
    while lt x n:
        do:
            set x mul x 2
    x

//: ## new
//: [長/なが]さ `n` の[空/から] Segment Tree を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree> unwrap_ok<SegmentTree, Diag> new 5;
//:     let ok <bool> eq len &st 5;
//:     free st
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<SegmentTree, Diag>> (n):
    if:
        lt n 0
        then diag_err<SegmentTree> seg_diag_len
        else:
            let base <i32> seg_next_pow2 if eq n 0 1 n
            let cells <i32> mul base 2
            match vec::filled<i32> cells 0:
                Result::Err _e:
                    diag_err<SegmentTree> diag_out_of_memory
                Result::Ok data:
                    ok<SegmentTree, Diag> SegmentTree n base data

//: ## len
//: [保持/ほじ]している[長/なが]さを[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `SegmentTree` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `SegmentTree` を[使/つか]い、不要になったら `free` できます。
fn len <(&SegmentTree)->i32> (st):
    *field::get_ref st "n"

//: ## replace
//: `idx` の[値/あたい]を `value` に[置/お]き[換/か]える
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st0 <SegmentTree> unwrap_ok<SegmentTree, Diag> new 4;
//:     let st1 <SegmentTree> unwrap_ok<SegmentTree, SegmentTreeUpdateError> replace st0 1 5;
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st1 0 4;
//:     free st1
//:     if eq total 5 1 0
//: ```
fn replace <(SegmentTree,i32,i32)*>Result<SegmentTree, SegmentTreeUpdateError>> (st, idx, value):
    let n <i32> *field::get_ref &st "n"
    let base <i32> *field::get_ref &st "base"
    if:
        and le 0 idx lt idx n
        then:
            let data <&Vec<i32>> field::get_ref &st "data"
            let mut pos <i32> add base idx
            seg_store_owned data pos value
            while lt 1 pos:
                do:
                    set pos div_s pos 2
                    let left <i32> mul pos 2
                    let right <i32> add left 1
                    seg_store_owned data pos add seg_load_owned data left seg_load_owned data right
            ok<SegmentTree, SegmentTreeUpdateError> st
        else:
            let d <Diag> seg_diag_index
            let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
            err<SegmentTree, SegmentTreeUpdateError> e

//: ## add
//: `idx` に `delta` を[加算/かさん]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree>:
//:         unwrap_ok<SegmentTree, Diag> new 4
//:         |> add 0 2 |> uwok
//:         |> add 3 5 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st 0 4;
//:     free st
//:     if eq total 7 1 0
//: ```
fn add <(SegmentTree,i32,i32)*>Result<SegmentTree, SegmentTreeUpdateError>> (st, idx, delta):
    let n <i32> *field::get_ref &st "n"
    let base <i32> *field::get_ref &st "base"
    if:
        and le 0 idx lt idx n
        then:
            let data <&Vec<i32>> field::get_ref &st "data"
            let leaf <i32> add base idx
            let cur <i32> seg_load_owned data leaf
            let mut pos <i32> leaf
            seg_store_owned data pos add cur delta
            while lt 1 pos:
                do:
                    set pos div_s pos 2
                    let left <i32> mul pos 2
                    let right <i32> add left 1
                    seg_store_owned data pos add seg_load_owned data left seg_load_owned data right
            ok<SegmentTree, SegmentTreeUpdateError> st
        else:
            let d <Diag> seg_diag_index
            let e <SegmentTreeUpdateError> SegmentTreeUpdateError st d
            err<SegmentTree, SegmentTreeUpdateError> e

//: ## sum_range
//: [区間/くかん] `[l, r)` の[和/わ]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree>:
//:         unwrap_ok<SegmentTree, Diag> new 5
//:         |> replace 0 1 |> uwok
//:         |> replace 1 2 |> uwok
//:         |> replace 2 3 |> uwok
//:         |> replace 3 4 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &st 1 4;
//:     free st
//:     if eq total 9 1 0
//: ```
fn sum_range <(&SegmentTree,i32,i32)*>Result<i32, Diag>> (st, l, r):
    let n <i32> *field::get_ref st "n"
    let base <i32> *field::get_ref st "base"
    if:
        and and le 0 l le l r le r n
        then:
            let data <&Vec<i32>> field::get_ref st "data"
            let mut left <i32> add base l
            let mut right <i32> add base r
            let mut acc_l <i32> 0
            let mut acc_r <i32> 0
            while lt left right:
                do:
                    if:
                        eq rem_s left 2 1
                        then:
                            set acc_l add acc_l seg_load_owned data left
                            set left add left 1
                        else:
                            ()
                    if:
                        eq rem_s right 2 1
                        then:
                            set right sub right 1
                            set acc_r add seg_load_owned data right acc_r
                        else:
                            ()
                    set left div_s left 2
                    set right div_s right 2
            ok<i32, Diag> add acc_l acc_r
        else:
            let d <Diag> seg_diag_range
            err<i32, Diag> d

//: ## free
//: [内部配列/ないぶはいれつ]を[解放/かいほう]する
//:
//: ### [実装/じっそう]
//: - `data` は `new` が `2 * base` 要素の `Vec<i32>` として[確保/かくほ]し、`SegmentTree` が[単独/たんどく]で[所有/しょゆう]します。
//: - owner invariant に[基/もと]づき、内部 cleanup は `Vec<i32>` owner を[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - [解放後/かいほうご]に `st` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/segment_tree" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let st <SegmentTree> unwrap_ok<SegmentTree, Diag> new 3;
//:     free st;
//:     0
//: ```
fn free <(SegmentTree)->()> (st):
    let data <Vec<i32>> field::get st "data"
    vec::free<i32> data
