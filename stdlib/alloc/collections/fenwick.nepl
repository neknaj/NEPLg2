//: # fenwick
//: [累積和/るいせきわ]クエリを[高速/こうそく]に[処理/しょり]する Fenwick Tree
//:
//: ### [目的/もくてき]
//: - `new` / `add` / `sum_prefix` / `sum_range` / `len` / `free` を bare 名で[提供/ていきょう]し、[点更新/てんこうしん]と prefix/range sum を `O(log n)` で[扱/あつか]えるようにします。
//: - `len` / `sum_prefix` / `sum_range` は `&Fenwick` を[受/う]け[取/と]り、internal tree owner を[移動/いどう]せずに[観察/かんさつ]します。
//: - `kpfenwick` の[競技/きょうぎ][向/む]け実装を `alloc/collections` へ[昇格/しょうかく]し、[一般用途/いっぱんようと]の collection として[再利用/さいりよう]できるようにします。
//:
//: ### [実装/じっそう]
//: - [内部/ないぶ]は 1-indexed `bit[1..n]` [配列/はいれつ]を `Vec<i32>` owner として[持/も]つ[古典的/こてんてき] Fenwick Tree です。
//: - [公開/こうかい] API の index は 0-index で[受/う]け、[内部/ないぶ]で 1-index に[変換/へんかん]します。
//:
//: ### [注意/ちゅうい]
//: - `new` と `add` は `Result` を[返/かえ]します。
//: - `sum_prefix` は `[0, r)`、`sum_range` は `[l, r)` を[返/かえ]します。
//: - [範囲外/はんいがい] index の `add` は `Result::Err FenwickAddError` で元の owner と[診断/しんだん]を[返/かえ]します。
//: - [不正/ふせい] query range は owner を[借用/しゃくよう]したまま `Result::Err Diag` を[返/かえ]します。
//: - query だけの[処理/しょり]では `len &fw` / `sum_range &fw l r` のように borrow して、[最後/さいご]に `free fw` で owner を[閉/と]じます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` は O(1)。
//: - `add` / `sum_prefix` / `sum_range` は O(log n)。
//: - `new` は O(n)、`free` は O(1)。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Fenwick
//: [点更新/てんこうしん]と[累積和/るいせきわ]クエリを[保持/ほじ]する[所有者/しょゆうしゃ]
//:
//: ### [目的/もくてき]
//: - [長/なが]さ `n` と internal `bit` [配列/はいれつ]を 1 [値/あたい]として[受/う]け[渡/わた]しできるようにします。
//:
//: ### [注意/ちゅうい]
//: - `bit` は 1-indexed [内部配列/ないぶはいれつ]です。
//: - `Fenwick` は[内部/ないぶ]メモリの[所有権/しょゆうけん]を[持/も]つので、[不要/ふよう]になったら `free` します。
struct Fenwick:
    n <i32>
    bit <Vec<i32>>

//: ## FenwickAddError
//: `add` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `add` は[更新/こうしん] API なので `Fenwick` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index では[内部/ないぶ]配列を[変更/へんこう]せず、caller が cleanup できるように元の `Fenwick` owner を `tree` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `add_error_tree` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`add_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
struct FenwickAddError:
    tree <Fenwick>
    diag <Diag>

//: add_error_diag: `add` [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
fn add_error_diag <(&FenwickAddError)->Diag> (e):
    *field::get_ref e "diag"

//: add_error_tree: `add` [失敗/しっぱい]で[戻/もど]された `Fenwick` owner を[取/と]り[出/だ]す
fn add_error_tree <(FenwickAddError)->Fenwick> (e):
    field::get e "tree"

fn fenwick_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid fenwick length"

fn fenwick_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "fenwick index out of bounds"

fn fenwick_diag_range <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "fenwick range out of bounds"

fn fenwick_load_owned <(&Vec<i32>,i32)->Option<i32>> (bit, idx):
    match vec::get<i32> bit idx:
        Option::Some v:
            some<i32> v
        Option::None:
            none<i32>

fn fenwick_store_owned <(&Vec<i32>,i32,i32)*>()> (bit, idx, value):
    vec::replace<i32> bit idx value

fn fenwick_sum_prefix_storage <(&Vec<i32>,i32)->Option<i32>> (bit, r):
    let mut i <i32> r
    let mut acc <i32> 0
    let mut valid <bool> true
    while and lt 0 i valid:
        do:
            match fenwick_load_owned bit i:
                Option::Some v:
                    set acc add acc v
                    let neg_i <i32> sub 0 i
                    let lb <i32> and i neg_i
                    set i sub i lb
                Option::None:
                    set valid false
    if valid some<i32> acc none<i32>

//: ## new
//: [長/なが]さ `n` の Fenwick Tree を[作/つく]る
//:
//: ### [目的/もくてき]
//: - [全要素/ぜんようそ] 0 の Fenwick Tree を[確保/かくほ]して[返/かえ]します。
//: - `n < 0` は[不正/ふせい]な[長/なが]さとして `Diag` にします。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick> unwrap_ok<Fenwick, Diag> new 5;
//:     let ok <bool> eq len &fw 5;
//:     free fw
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<Fenwick, Diag>> (n):
    if:
        lt n 0
        then:
            diag_err<Fenwick> fenwick_diag_len
        else:
            let bit_len <i32> add n 1
            match vec::filled<i32> bit_len 0:
                Result::Err _e:
                    diag_err<Fenwick> diag_out_of_memory
                Result::Ok bit:
                    ok<Fenwick, Diag> Fenwick n bit

//: ## len
//: [保持/ほじ]している[長/なが]さを[返/かえ]す
fn len <(&Fenwick)->i32> (fw):
    *field::get_ref fw "n"

//: ## add
//: `idx` に `delta` を[加算/かさん]する
//:
//: ### [注意/ちゅうい]
//: - [範囲外/はんいがい] index は `Result::Err FenwickAddError` です。
//: - `Err` には[変更前/へんこうまえ]の `Fenwick` owner が[入/はい]るので、caller は owner を[回収/かいしゅう]して `free` できます。
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick>:
//:         unwrap_ok<Fenwick, Diag> new 4
//:         |> add 0 2 |> uwok
//:         |> add 3 5 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &fw 0 4;
//:     free fw
//:     if eq total 7 1 0
//: ```
fn add <(Fenwick,i32,i32)*>Result<Fenwick, FenwickAddError>> (fw, idx, delta):
    let n <i32> *field::get_ref &fw "n"
    if:
        and le 0 idx lt idx n
        then:
            let result <Result<(), Diag>> block:
                let bit <&Vec<i32>> field::get_ref &fw "bit"
                let mut i <i32> add idx 1
                let mut valid <bool> true
                while and le i n valid:
                    do:
                        match fenwick_load_owned bit i:
                            Option::Some cur:
                                fenwick_store_owned bit i add cur delta
                                let neg_i <i32> sub 0 i
                                let lb <i32> and i neg_i
                                set i add i lb
                            Option::None:
                                set valid false
                if valid ok<(), Diag> () diag_err<()> fenwick_diag_index
            match result:
                Result::Ok _unit:
                    ok<Fenwick, FenwickAddError> fw
                Result::Err d:
                    let e <FenwickAddError> FenwickAddError fw d
                    err<Fenwick, FenwickAddError> e
        else:
            let d <Diag> fenwick_diag_index
            let e <FenwickAddError> FenwickAddError fw d
            err<Fenwick, FenwickAddError> e

//: ## sum_prefix
//: [区間/くかん] `[0, r)` の[和/わ]を[返/かえ]す
//:
//: ### [注意/ちゅうい]
//: - `r` は 0 以上 `len` 以下でなければなりません。
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick>:
//:         unwrap_ok<Fenwick, Diag> new 5
//:         |> add 0 1 |> uwok
//:         |> add 1 2 |> uwok
//:         |> add 2 3 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_prefix &fw 3;
//:     free fw
//:     if eq total 6 1 0
//: ```
fn sum_prefix <(&Fenwick,i32)*>Result<i32, Diag>> (fw, r):
    let n <i32> *field::get_ref fw "n"
    if:
        and le 0 r le r n
        then:
            let bit <&Vec<i32>> field::get_ref fw "bit"
            match fenwick_sum_prefix_storage bit r:
                Option::Some acc:
                    ok<i32, Diag> acc
                Option::None:
                    diag_err<i32> fenwick_diag_index
        else:
            let d <Diag> fenwick_diag_index
            err<i32, Diag> d

//: ## sum_range
//: [区間/くかん] `[l, r)` の[和/わ]を[返/かえ]す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick>:
//:         unwrap_ok<Fenwick, Diag> new 5
//:         |> add 0 1 |> uwok
//:         |> add 1 2 |> uwok
//:         |> add 2 3 |> uwok
//:         |> add 3 4 |> uwok
//:     let total <i32> unwrap_ok<i32, Diag> sum_range &fw 1 4;
//:     free fw
//:     if eq total 9 1 0
//: ```
fn sum_range <(&Fenwick,i32,i32)*>Result<i32, Diag>> (fw, l, r):
    let n <i32> *field::get_ref fw "n"
    if:
        and and le 0 l le l r le r n
        then:
            let bit <&Vec<i32>> field::get_ref fw "bit"
            match fenwick_sum_prefix_storage bit r:
                Option::Some sr:
                    match fenwick_sum_prefix_storage bit l:
                        Option::Some sl:
                            ok<i32, Diag> sub sr sl
                        Option::None:
                            diag_err<i32> fenwick_diag_range
                Option::None:
                    diag_err<i32> fenwick_diag_range
        else:
            let d <Diag> fenwick_diag_range
            err<i32, Diag> d

//: ## free
//: [内部/ないぶ][配列/はいれつ]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `Fenwick` は `new` が[確保/かくほ]した `n + 1` 要素の 1-indexed `bit` `Vec<i32>` を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、`Vec<i32>` owner を[閉/と]じます。
//: - caller は `free` [後/ご]の `Fenwick` を[再利用/さいりよう]してはいけません。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/fenwick" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let fw <Fenwick> unwrap_ok<Fenwick, Diag> new 2;
//:     free fw;
//:     1
//: ```
fn free <(Fenwick)*>()> (fw):
    let bit <Vec<i32>> field::get fw "bit"
    vec::free<i32> bit
