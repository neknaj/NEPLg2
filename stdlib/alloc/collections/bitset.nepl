//: # bitset
//: [整数/せいすう] index に[対/たい]する bitset の public facade
//:
//: ### [目的/もくてき]
//: - `BitSet` と `new` / `len` / `contains` / `insert` / `remove` / `clear` / `fill` / `free` の既存 import path を保ったまま公開します。
//: - 型定義、layout 計算、typed byte storage、bit 更新、public API を submodule に分けます。
//:
//: ### [注意/ちゅうい]
//: - `len` / `contains` は `&BitSet` を[受/う]け[取/と]り、bit storage の owner を[移動/いどう]せずに[観察/かんさつ]します。
//: - `insert` / `remove` の失敗は owner を失わないように `BitSetUpdateError` で元の `BitSet` と `Diag` を返します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"bitset_facade_lifecycle_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"inserted bit is visible\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let bs0 %BitSet unwrap_ok new 8
//:     let bs1 %BitSet unwrap_ok insert bs0 2
//:     let present %bool unwrap_ok contains &bs1 2
//:     free bs1
//:     let report:
//:         test_report_new "bitset_facade_lifecycle_doc"
//:         |> test_report_push assert "inserted bit is visible" present
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

pub #import "./bitset/types" as @merge
pub #import "./bitset/api" as @merge
