#indent 4

//: # bitset
//: [整数/せいすう] index に[対/たい]する bitset
//:
//: ### [目的/もくてき]
//: - `BitSet` を[提供/ていきょう]し、`new` / `len` / `contains` / `insert` / `remove` / `clear` / `fill` / `free` の bare API で bit [集合/しゅうごう]を[扱/あつか]えるようにします。
//: - `len` / `contains` は `&BitSet` を[受/う]け[取/と]り、bit storage の owner を[移動/いどう]せずに[観察/かんさつ]します。
//: - [固定長/こていちょう]の membership structure を `alloc/collections` に[揃/そろ]え、`BloomFilter` と[違/ちが]って false positive のない[正確/せいかく]な[判定/はんてい]を[標準/ひょうじゅん]で[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - [内部/ないぶ]は `nbits` / `nbytes` / `Vec<u8>` bit storage を[持/も]つ owner struct です。
//: - bit [列/れつ]は typed byte `Vec` として[確保/かくほ]し、index から byte offset と mask を[計算/けいさん]して[読書/よみか]きします。
//: - `clear` / `fill` は[全領域/ぜんりょういき]を[線形/せんけい]に[初期化/しょきか]します。
//:
//: ### [注意/ちゅうい]
//: - [有効/ゆうこう] index [範囲/はんい]は `[0, len)` です。
//: - `contains` は[範囲外/はんいがい] index に[対/たい]して owner を[動/うご]かさず `Result::Err Diag` を[返/かえ]します。
//: - `insert` / `remove` は[範囲外/はんいがい] index に[対/たい]して `Result::Err BitSetUpdateError` で元の owner と[診断/しんだん]を[返/かえ]します。
//: - `len` は set bit [数/すう]ではなく、[保持/ほじ]できる bit [長/ちょう]を[返/かえ]します。
//: - [読/よ]み[取/と]りだけの[処理/しょり]では `len &bs` / `contains &bs idx` のように borrow して、[最後/さいご]に `free bs` で owner を[閉/と]じます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `contains` / `insert` / `remove` は O(1) です。
//: - `clear` / `fill` は byte [長/ちょう]を m として O(m) です。

#import "core/cast" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BitSet
//: bit [配列/はいれつ]を[所有/しょゆう]する fixed-length set
//:
//: ### [目的/もくてき]
//: - bit [長/ちょう]と byte [長/ちょう]と typed byte storage owner を 1 [値/あたい]として[受/う]け[渡/わた]せるようにします。
//:
//: ### [注意/ちゅうい]
//: - `free` しないかぎり[内部/ないぶ] `Vec<u8>` の[所有権/しょゆうけん]を[保持/ほじ]します。
struct BitSet:
    nbits <i32>
    nbytes <i32>
    bits <Vec<u8>>

//: ## BitSetUpdateError
//: `insert` / `remove` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` は[更新/こうしん] API なので `BitSet` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index では bit storage を[変更/へんこう]せず、caller が cleanup できるように元の `BitSet` owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `bitset_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`bitset_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
struct BitSetUpdateError:
    owner <BitSet>
    diag <Diag>

//: bitset_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
fn bitset_update_error_diag <(&BitSetUpdateError)->Diag> (e):
    *field::get_ref e "diag"

//: bitset_update_error_owner: update [失敗/しっぱい]で[戻/もど]された `BitSet` owner を[取/と]り[出/だ]す
fn bitset_update_error_owner <(BitSetUpdateError)->BitSet> (e):
    field::get e "owner"

fn bitset_invalid_len_diag <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid bitset length"

fn bitset_index_diag <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "bitset index out of bounds"

fn bitset_byte_index <(i32)->i32> (bit_idx):
    div_s bit_idx 8

fn bitset_mask <(i32)->i32> (bit_idx):
    shl 1 rem_s bit_idx 8

fn bitset_valid_index <(i32,i32)->bool> (idx, nbits):
    and le 0 idx lt idx nbits

fn bitset_byte_at <(&Vec<u8>,i32)->Option<i32>> (bits, byte_idx):
    match vec::get<u8> bits byte_idx:
        Option::Some byte:
            let value <i32> cast byte
            some<i32> value
        Option::None:
            none<i32>

fn bitset_store_byte <(&Vec<u8>,i32,i32)*>()> (bits, byte_idx, byte_value):
    let byte <u8> cast byte_value
    vec::replace<u8> bits byte_idx byte

fn bitset_fill_bytes <(&Vec<u8>,i32,i32)*>()> (bits, nbytes, byte_value):
    let mut i <i32> 0
    while lt i nbytes:
        do:
            bitset_store_byte bits i byte_value
            set i add i 1

fn bitset_alloc_bits <(i32,i32)*>Result<Vec<u8>, Diag>> (nbytes, byte_value):
    let byte <u8> cast byte_value
    match vec::filled<u8> nbytes byte:
        Result::Ok bits:
            ok<Vec<u8>, Diag> bits
        Result::Err _e:
            diag_err<Vec<u8>> diag_out_of_memory

//: ## new
//: [空/から] bitset を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 64;
//:     let ok <bool> eq len &bs 64;
//:     free bs
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<BitSet, Diag>> (nbits):
    if:
        le nbits 0
        then:
            diag_err<BitSet> bitset_invalid_len_diag
        else:
            let nbytes <i32> div_s add nbits 7 8
            match bitset_alloc_bits nbytes 0:
                Result::Err d:
                    err<BitSet, Diag> d
                Result::Ok bits:
                    ok<BitSet, Diag> BitSet nbits nbytes bits

//: ## len
//: [保持可能/ほじかのう]な bit [長/ちょう]を[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `BitSet` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `BitSet` を[使/つか]い、不要になったら `free` できます。
fn len <(&BitSet)->i32> (bs):
    *field::get_ref bs "nbits"

//: ## contains
//: bit が[立/た]っているかを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet>:
//:         unwrap_ok<BitSet, Diag> new 32
//:         |> insert 5 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs 5;
//:     free bs
//:     if ok 1 0
//: ```
fn contains <(&BitSet,i32)*>Result<bool, Diag>> (bs, idx):
    let nbits <i32> *field::get_ref bs "nbits"
    if:
        bitset_valid_index idx nbits
        then:
            let bits <&Vec<u8>> field::get_ref bs "bits"
            let byte_idx <i32> bitset_byte_index idx
            let mask <i32> bitset_mask idx
            match bitset_byte_at bits byte_idx:
                Option::Some cur:
                    ok<bool, Diag> ne and cur mask 0
                Option::None:
                    diag_err<bool> bitset_index_diag
        else:
            diag_err<bool> bitset_index_diag

//: ## insert
//: bit を 1 に[設定/せってい]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 16;
//:     let bs1 <BitSet> unwrap_ok<BitSet, BitSetUpdateError> insert bs 3;
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs1 3;
//:     free bs1
//:     if ok 1 0
//: ```
fn insert <(BitSet,i32)*>Result<BitSet, BitSetUpdateError>> (bs, idx):
    let nbits <i32> *field::get_ref &bs "nbits"
    if:
        bitset_valid_index idx nbits
        then:
            let result <Result<(), Diag>> block:
                let bits <&Vec<u8>> field::get_ref &bs "bits"
                let byte_idx <i32> bitset_byte_index idx
                let mask <i32> bitset_mask idx
                match bitset_byte_at bits byte_idx:
                    Option::Some cur:
                        bitset_store_byte bits byte_idx or cur mask
                        ok<(), Diag> ()
                    Option::None:
                        diag_err<()> bitset_index_diag
            match result:
                Result::Ok _unit:
                    ok<BitSet, BitSetUpdateError> bs
                Result::Err d:
                    let e <BitSetUpdateError> BitSetUpdateError bs d
                    err<BitSet, BitSetUpdateError> e
        else:
            let d <Diag> bitset_index_diag
            let e <BitSetUpdateError> BitSetUpdateError bs d
            err<BitSet, BitSetUpdateError> e

//: ## remove
//: bit を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet>:
//:         unwrap_ok<BitSet, Diag> new 16
//:         |> insert 3 |> uwok
//:         |> remove 3 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs 3;
//:     free bs
//:     if not ok 1 0
//: ```
fn remove <(BitSet,i32)*>Result<BitSet, BitSetUpdateError>> (bs, idx):
    let nbits <i32> *field::get_ref &bs "nbits"
    if:
        bitset_valid_index idx nbits
        then:
            let result <Result<(), Diag>> block:
                let bits <&Vec<u8>> field::get_ref &bs "bits"
                let byte_idx <i32> bitset_byte_index idx
                let mask <i32> bitset_mask idx
                match bitset_byte_at bits byte_idx:
                    Option::Some cur:
                        bitset_store_byte bits byte_idx and cur xor mask 255
                        ok<(), Diag> ()
                    Option::None:
                        diag_err<()> bitset_index_diag
            match result:
                Result::Ok _unit:
                    ok<BitSet, BitSetUpdateError> bs
                Result::Err d:
                    let e <BitSetUpdateError> BitSetUpdateError bs d
                    err<BitSet, BitSetUpdateError> e
        else:
            let d <Diag> bitset_index_diag
            let e <BitSetUpdateError> BitSetUpdateError bs d
            err<BitSet, BitSetUpdateError> e

//: ## clear
//: [全/すべ]ての bit を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet>:
//:         unwrap_ok<BitSet, Diag> new 16
//:         |> insert 2 |> uwok
//:         |> clear
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs 2;
//:     free bs
//:     if not ok 1 0
//: ```
fn clear <(BitSet)*>BitSet> (bs):
    let nbytes <i32> *field::get_ref &bs "nbytes"
    let bits <&Vec<u8>> field::get_ref &bs "bits"
    bitset_fill_bytes bits nbytes 0
    bs

//: ## fill
//: [全/すべ]ての bit を 1 に[設定/せってい]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 10;
//:     let bs1 <BitSet> fill bs;
//:     let ok <bool> unwrap_ok<bool, Diag> contains &bs1 9;
//:     free bs1
//:     if ok 1 0
//: ```
fn fill <(BitSet)*>BitSet> (bs):
    let nbytes <i32> *field::get_ref &bs "nbytes"
    let bits <&Vec<u8>> field::get_ref &bs "bits"
    bitset_fill_bytes bits nbytes 255
    bs

//: ## free
//: [内部/ないぶ] byte [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `BitSet` は `new` が[確保/かくほ]した `Vec<u8>` bit storage を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、`vec::free` で[解放/かいほう]します。
//: - caller は `free` [後/ご]の `BitSet` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bitset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bs <BitSet> unwrap_ok<BitSet, Diag> new 16;
//:     free bs
//:     0
//: ```
fn free <(BitSet)->()> (bs):
    let bits <Vec<u8>> field::get bs "bits"
    vec::free<u8> bits
