//: # btreemap/api
//: `BTreeMap` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `insert` / `get` / `contains` / `remove` / `len` / `clear` / `free` を提供します。
//: - grow error は `Result` として返し、確保失敗を `unwrap_ok` や unreachable にしません。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "./search" as *

//: ## new
//: [空/から]の `BTreeMap<.K, .V>` を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     let ok <bool> eq len<i32, i32> &hm 0
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn new <.K: Copy,.V: Copy> <()*>Result<BTreeMap<.K,.V>, Diag>> ():
    let cap <i32> 8
    match btreemap_alloc_storage<.K,.V> cap:
        Result::Err d:
            err<BTreeMap<.K,.V>, Diag> d
        Result::Ok storage:
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> 0 cap storage

//: ## len
//: map を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 3 30 |> uwok
//:         |> insert 7 70 |> uwok
//:     let ok <bool> eq len<i32, i32> &hm 2
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn len <.K,.V> <(&BTreeMap<.K,.V>)->i32> (hm):
    *field::get_ref hm "len"

//: ## contains
//: map を[移動/いどう]せずに key の[存在/そんざい]を[確/たし]かめる
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     let ok <bool> contains<i32, i32> &hm 7
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn contains <.K: Ord&Copy,.V: Copy> <(&BTreeMap<.K,.V>,.K)->bool> (hm, key):
    let len0 <i32> *field::get_ref hm "len"
    let storage <&BTreeMapStorage<.K,.V>> field::get_ref hm "storage"
    let keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> storage
    let idx <i32> btreemap_lower_bound<.K> keys key 0 len0
    btreemap_is_at<.K> keys len0 idx key

//: ## get
//: map を[移動/いどう]せずに key に[対応/たいおう]する Copy value を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     let ok <bool> match get<i32, i32> &hm 7:
//:         Option::Some v:
//:             eq v 70
//:         Option::None:
//:             false
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn get <.K: Ord&Copy,.V: Copy> <(&BTreeMap<.K,.V>,.K)->Option<.V>> (hm, key):
    let len0 <i32> *field::get_ref hm "len"
    let storage <&BTreeMapStorage<.K,.V>> field::get_ref hm "storage"
    let keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> storage
    let values <&Vec<Option<.V>>> btreemap_storage_values<.K,.V> storage
    let idx <i32> btreemap_lower_bound<.K> keys key 0 len0
    if:
        btreemap_is_at<.K> keys len0 idx key
        then btreemap_value_at<.V> values idx
        else none<.V>

//: ## btreemap_insert_ready
//: [容量/ようりょう]が[足/た]りている `BTreeMap` に key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [目的/もくてき]
//: - public `insert` が grow の[成功/せいこう]を[確認/かくにん]したあと、実際の lower_bound / shift / store を[一箇所/いっかしょ]で[行/おこな]います。
//: - grow [失敗/しっぱい]を `unwrap_ok` で trap にしないため、確保を伴う[準備/じゅんび]と確保後の[挿入/そうにゅう]を[分離/ぶんり]します。
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound は O(log n)、挿入時の shift は O(n) です。
fn btreemap_insert_ready <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm1, key, value):
    let len0 <i32> *field::get_ref &hm1 "len"
    let cap0 <i32> *field::get_ref &hm1 "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm1 "storage"
    let idx <i32> btreemap_lower_bound_storage<.K,.V> &storage key 0 len0
    if:
        btreemap_is_at_storage<.K,.V> &storage len0 idx key
        then:
            btreemap_store_value_slot<.K,.V> &storage idx some<.V> value
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> len0 cap0 storage
        else:
            btreemap_shift_right<.K,.V> &storage idx len0
            btreemap_store_key_slot<.K,.V> &storage idx some<.K> key
            btreemap_store_value_slot<.K,.V> &storage idx some<.V> value
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> add len0 1 cap0 storage

//: ## insert
//: key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [実装/じっそう]
//: - 現在の[容量/ようりょう]が[満杯/まんぱい]なら `btreemap_grow` を[実行/じっこう]し、`Result::Err` はそのまま[返/かえ]します。
//: - 確保に[成功/せいこう]した map、または元から[余裕/よゆう]のある map だけを `btreemap_insert_ready` に[渡/わた]します。
//:
//: ### [失敗/しっぱい]
//: - grow 用 key/value buffer の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Diag::OutOfMemory` を[返/かえ]し、trap しません。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(n)、grow が[起/お]きる[回/かい]は既存要素の copy を含め O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> insert 3 30 |> uwok
//:     let ok <bool> eq len<i32, i32> &hm 2
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn insert <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm, key, value):
    let len_init <i32> *field::get_ref &hm "len"
    let cap_init <i32> *field::get_ref &hm "cap"
    if:
        eq len_init cap_init
        then:
            match btreemap_grow<.K,.V> hm:
                Result::Ok hm1:
                    btreemap_insert_ready<.K,.V> hm1 key value
                Result::Err d:
                    err<BTreeMap<.K,.V>, Diag> d
        else btreemap_insert_ready<.K,.V> hm key value

//: ## remove
//: key を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> remove 7
//:     let ok <bool> eq len<i32, i32> &hm 0
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn remove <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K)*>BTreeMap<.K,.V>> (hm, key):
    let len0 <i32> *field::get_ref &hm "len"
    let cap0 <i32> *field::get_ref &hm "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    let idx <i32> btreemap_lower_bound_storage<.K,.V> &storage key 0 len0
    if:
        not btreemap_is_at_storage<.K,.V> &storage len0 idx key
        then BTreeMap<.K,.V> len0 cap0 storage
        else:
            let last <i32> sub len0 1
            btreemap_shift_left_after_remove<.K,.V> &storage idx len0
            BTreeMap<.K,.V> last cap0 storage

//: ## clear
//: [全要素/ぜんようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> clear
//:     let ok <bool> eq len<i32, i32> &hm 0
//:     free<i32, i32> hm
//:     if ok 1 0
//: ```
fn clear <.K: Copy,.V: Copy> <(BTreeMap<.K,.V>)*>BTreeMap<.K,.V>> (hm):
    let len0 <i32> *field::get_ref &hm "len"
    let cap0 <i32> *field::get_ref &hm "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    btreemap_clear_slots<.K,.V> &storage len0 0
    BTreeMap<.K,.V> 0 cap0 storage

//: ## free
//: [内部/ないぶ] storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     free hm;
//:     0
//: ```
fn free <.K,.V> <(BTreeMap<.K,.V>)->()> (hm):
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    btreemap_free_storage<.K,.V> storage
