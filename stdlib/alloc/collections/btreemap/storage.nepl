//: # btreemap/storage
//: `BTreeMap` の backing storage 操作
//:
//: ### [目的/もくてき]
//: - key/value slot の読み書き、shift、grow、storage 解放を所有します。
//: - public API が key/value storage layout を直接扱わないようにします。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "core/field" as *
#import "core/math" as *

//: 現行 storage view は `Vec Option .K` の payload storage 形状を返すため、non-Copy collection drop traversal が入るまで key 側を Copy に限定します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: struct CleanupPayload:
//:     value %i32
//: fn borrow_keys %fn &BTreeMapStorage CleanupPayload i32 &Vec Option CleanupPayload \storage:
//:     btreemap_storage_keys<CleanupPayload, i32> storage
//: fn main %fn void i32 \void:
//:     0
//: ```
pub fn btreemap_storage_keys <.K: Copy,.V> %fn &BTreeMapStorage .K .V &Vec Option .K \storage:
    field::get_ref storage "keys"

//: 現行 storage view は `Vec Option .V` の payload storage 形状を返すため、non-Copy collection drop traversal が入るまで value 側を Copy に限定します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: struct CleanupPayload:
//:     value %i32
//: fn borrow_values %fn &BTreeMapStorage i32 CleanupPayload &Vec Option CleanupPayload \storage:
//:     btreemap_storage_values<i32, CleanupPayload> storage
//: fn main %fn void i32 \void:
//:     0
//: ```
pub fn btreemap_storage_values <.K,.V: Copy> %fn &BTreeMapStorage .K .V &Vec Option .V \storage:
    field::get_ref storage "values"

//: ## btreemap_key_at
//: key slot storage から key を `Option` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - `keys` owner は[消費/しょうひ]しません。
//: - `idx` が storage 範囲外なら `Option::None` を返します。
//: - 範囲内 slot が empty の場合も `Option::None` を返し、live key は `Option::Some key` です。
//: - 範囲外と empty slot は同じ戻り値に畳まれるため、caller は `len` / `cap` invariant と合わせて意味を判断します。
//:
//: ### [計算量/けいさんりょう]
//: - `Vec.get` に従い O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_key_at_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"reads stored key\" expected=\"12\" actual=\"12\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"empty key slot is none\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 2
//:     btreemap_store_key_slot &storage 0 some 12
//:     let keys %&Vec Option i32 btreemap_storage_keys &storage
//:     let present %i32 match btreemap_key_at keys 0:
//:         Option::Some key:
//:             key
//:         Option::None:
//:             -1
//:     let empty %bool match btreemap_key_at keys 1:
//:         Option::Some _key:
//:             false
//:         Option::None:
//:             true
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_key_at_doc"
//:         |> test_report_push assert_eq_i32 "reads stored key" 12 present
//:         |> test_report_push assert "empty key slot is none" empty
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_key_at <.K: Copy> %fn &Vec Option .K fn i32 Option .K \keys\idx:
    let slot %Option Option .K vec::get keys idx
    match slot:
        Option::Some key_opt:
            key_opt
        Option::None:
            none

//: ## btreemap_value_at
//: value slot storage から value を `Option` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - `values` owner は[消費/しょうひ]しません。
//: - `idx` が storage 範囲外なら `Option::None` を返します。
//: - 範囲内 slot が empty の場合も `Option::None` を返し、live value は `Option::Some value` です。
//: - 範囲外と empty slot は同じ戻り値に畳まれるため、caller は key/value/live prefix invariant と合わせて意味を判断します。
//:
//: ### [計算量/けいさんりょう]
//: - `Vec.get` に従い O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_value_at_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"reads stored value\" expected=\"120\" actual=\"120\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"empty value slot is none\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 2
//:     btreemap_store_value_slot &storage 0 some 120
//:     let values %&Vec Option i32 btreemap_storage_values &storage
//:     let present %i32 match btreemap_value_at values 0:
//:         Option::Some value:
//:             value
//:         Option::None:
//:             -1
//:     let empty %bool match btreemap_value_at values 1:
//:         Option::Some _value:
//:             false
//:         Option::None:
//:             true
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_value_at_doc"
//:         |> test_report_push assert_eq_i32 "reads stored value" 120 present
//:         |> test_report_push assert "empty value slot is none" empty
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_value_at <.V: Copy> %fn &Vec Option .V fn i32 Option .V \values\idx:
    let slot %Option Option .V vec::get values idx
    match slot:
        Option::Some value_opt:
            value_opt
        Option::None:
            none

//: ## btreemap_store_key
//: key storage の 1 slot を[置/お]き[換/か]える
//:
//: ### [契約/けいやく]
//: - `keys` owner は[消費/しょうひ]しません。
//: - `Option::Some key` は live key、`Option::None` は unused slot を表します。
//: - index validation は caller の責務です。public API は `cap` 内の slot だけを渡します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_store_key_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"stores key\" expected=\"14\" actual=\"14\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     let keys %&Vec Option i32 btreemap_storage_keys &storage
//:     btreemap_store_key keys 0 some 14
//:     let value %i32 match btreemap_key_at keys 0:
//:         Option::Some key:
//:             key
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_store_key_doc"
//:         |> test_report_push assert_eq_i32 "stores key" 14 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_store_key <.K: Copy> %impure fn &Vec Option .K impure fn i32 impure fn Option .K unit \keys\idx\key:
    vec::replace keys idx key

//: ## btreemap_store_value
//: value storage の 1 slot を[置/お]き[換/か]える
//:
//: ### [契約/けいやく]
//: - `values` owner は[消費/しょうひ]しません。
//: - `Option::Some value` は live value、`Option::None` は unused slot を表します。
//: - index validation は caller の責務です。public API は `cap` 内の slot だけを渡します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_store_value_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"stores value\" expected=\"140\" actual=\"140\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     let values %&Vec Option i32 btreemap_storage_values &storage
//:     btreemap_store_value values 0 some 140
//:     let value %i32 match btreemap_value_at values 0:
//:         Option::Some saved:
//:             saved
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_store_value_doc"
//:         |> test_report_push assert_eq_i32 "stores value" 140 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_store_value <.V: Copy> %impure fn &Vec Option .V impure fn i32 impure fn Option .V unit \values\idx\value:
    vec::replace values idx value

//: ## btreemap_key_slot
//: storage wrapper の key slot を `Option` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - 戻り値条件は `btreemap_key_at` と同じです。
//: - key/value storage の wrapper を通して読むため `.K` / `.V` は現行 cleanup contract に合わせて `Copy` です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_key_slot_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"reads key slot\" expected=\"21\" actual=\"21\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     btreemap_store_key_slot &storage 0 some 21
//:     let value %i32 match btreemap_key_slot &storage 0:
//:         Option::Some key:
//:             key
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_key_slot_doc"
//:         |> test_report_push assert_eq_i32 "reads key slot" 21 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_key_slot <.K: Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn i32 Option .K \storage\idx:
    btreemap_key_at<.K> btreemap_storage_keys<.K,.V> storage idx

//: ## btreemap_value_slot
//: storage wrapper の value slot を `Option` として[読/よ]む
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - 戻り値条件は `btreemap_value_at` と同じです。
//: - key/value storage の wrapper を通して読むため `.K` / `.V` は現行 cleanup contract に合わせて `Copy` です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_value_slot_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"reads value slot\" expected=\"210\" actual=\"210\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     btreemap_store_value_slot &storage 0 some 210
//:     let value %i32 match btreemap_value_slot &storage 0:
//:         Option::Some saved:
//:             saved
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_value_slot_doc"
//:         |> test_report_push assert_eq_i32 "reads value slot" 210 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_value_slot <.K: Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn i32 Option .V \storage\idx:
    btreemap_value_at<.V> btreemap_storage_values<.K,.V> storage idx

//: ## btreemap_store_key_slot
//: storage wrapper の key slot を[置/お]き[換/か]える
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - 戻り値と slot state の意味は `btreemap_store_key` と同じです。
//: - public API は `Option::Some key` を live prefix へ、`Option::None` を unused suffix へ書きます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_store_key_slot_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"stores key slot\" expected=\"31\" actual=\"31\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     btreemap_store_key_slot &storage 0 some 31
//:     let value %i32 match btreemap_key_slot &storage 0:
//:         Option::Some key:
//:             key
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_store_key_slot_doc"
//:         |> test_report_push assert_eq_i32 "stores key slot" 31 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_store_key_slot <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn Option .K unit \storage\idx\key:
    btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage idx key

//: ## btreemap_store_value_slot
//: storage wrapper の value slot を[置/お]き[換/か]える
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - 戻り値と slot state の意味は `btreemap_store_value` と同じです。
//: - public API は `Option::Some value` を live prefix へ、`Option::None` を unused suffix へ書きます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_store_value_slot_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"stores value slot\" expected=\"310\" actual=\"310\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     btreemap_store_value_slot &storage 0 some 310
//:     let value %i32 match btreemap_value_slot &storage 0:
//:         Option::Some saved:
//:             saved
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_store_value_slot_doc"
//:         |> test_report_push assert_eq_i32 "stores value slot" 310 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_store_value_slot <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn Option .V unit \storage\idx\value:
    btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage idx value

//: ## btreemap_free_storage
//: key/value storage owner を[閉/と]じる
//:
//: ### [契約/けいやく]
//: - `btreemap_alloc_storage` が返した `BTreeMapStorage` owner を[消費/しょうひ]します。
//: - key と value の `Vec Option` owner をそれぞれ `vec::free` で閉じます。
//: - 現行 collection cleanup は element drop traversal を持たないため `.K` / `.V` は `Copy` に限定します。
//: - caller はこの関数の後に同じ storage owner を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_free_storage_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"free completes\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_free_storage_doc"
//:         |> test_report_push assert "free completes" true
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_free_storage <.K: Copy,.V: Copy> %impure fn BTreeMapStorage .K .V unit \storage:
    let keys %Vec Option .K field::get storage "keys"
    let values %Vec Option .V field::get storage "values"
    vec::free keys
    vec::free values

//: ## btreemap_alloc_storage
//: empty key/value slot で[満/み]たした storage owner を[確保/かくほ]する
//:
//: ### [契約/けいやく]
//: - caller は `cap >= 0` を渡します。public `new` と `grow` は正の capacity だけを渡します。
//: - 成功時は key/value とも長さ `cap` の `Vec Option` owner で、全 slot は `Option::None` です。
//: - key storage 確保失敗は `Result::Err Diag` を返します。
//: - value storage 確保失敗時は partial allocation cleanup として先に確保した key storage を free してから `Result::Err Diag` を返します。
//: - storage 詳細の `StdErrorKind` は外へ出さず、`diag_out_of_memory` に正規化します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量と空間計算量は O(cap) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_alloc_storage_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"key slots start empty\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"value slots start empty\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let key_result %Result BTreeMapStorage i32 i32 Diag btreemap_alloc_storage 2
//:     let keys_empty %bool match key_result:
//:         Result::Ok storage:
//:             let key_empty %bool match btreemap_key_slot &storage 0:
//:                 Option::Some _key:
//:                     false
//:                 Option::None:
//:                     true
//:             btreemap_free_storage storage
//:             key_empty
//:         Result::Err _diag:
//:             false
//:     let value_result %Result BTreeMapStorage i32 i32 Diag btreemap_alloc_storage 2
//:     let values_empty %bool match value_result:
//:         Result::Ok storage:
//:             let value_empty %bool match btreemap_value_slot &storage 0:
//:                 Option::Some _value:
//:                     false
//:                 Option::None:
//:                     true
//:             btreemap_free_storage storage
//:             value_empty
//:         Result::Err _diag:
//:             false
//:     let report:
//:         test_report_new "btreemap_alloc_storage_doc"
//:         |> test_report_push assert "key slots start empty" keys_empty
//:         |> test_report_push assert "value slots start empty" values_empty
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_alloc_storage <.K: Copy,.V: Copy> %impure fn i32 Result BTreeMapStorage .K .V Diag \cap:
    let keys_result %Result Vec Option .K StdErrorKind vec::filled cap none
    match keys_result:
        Result::Err _e:
            diag_err diag_out_of_memory
        Result::Ok keys:
            let values_result %Result Vec Option .V StdErrorKind vec::filled cap none
            match values_result:
                Result::Err _e:
                    vec::free keys
                    diag_err diag_out_of_memory
                Result::Ok values:
                    ok BTreeMapStorage<.K,.V> keys values

//: ## btreemap_copy_live_slots
//: live prefix の key/value slot を別 storage へ[複写/ふくしゃ]する
//:
//: ### [契約/けいやく]
//: - `src` と `dst` owner は[消費/しょうひ]しません。
//: - caller は `0 <= len0 <= src.cap` かつ `len0 <= dst.cap` を[保証/ほしょう]します。
//: - `0 <= i < len0` の key/value slot を `src` から読み、同じ index の `dst` へ書きます。
//: - missing key/value slot は storage invariant failure とみなし、該当 slot を書かずに進みます。
//:
//: ### [計算量/けいさんりょう]
//: - O(len0) です。追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_copy_live_slots_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"copied key\" expected=\"4\" actual=\"4\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"copied value\" expected=\"40\" actual=\"40\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let src %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 2
//:     let dst %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 2
//:     btreemap_store_key_slot &src 0 some 4
//:     btreemap_store_value_slot &src 0 some 40
//:     btreemap_copy_live_slots &src &dst 1
//:     let key %i32 match btreemap_key_slot &dst 0:
//:         Option::Some saved_key:
//:             saved_key
//:         Option::None:
//:             -1
//:     let value %i32 match btreemap_value_slot &dst 0:
//:         Option::Some saved_value:
//:             saved_value
//:         Option::None:
//:             -1
//:     btreemap_free_storage src
//:     btreemap_free_storage dst
//:     let report:
//:         test_report_new "btreemap_copy_live_slots_doc"
//:         |> test_report_push assert_eq_i32 "copied key" 4 key
//:         |> test_report_push assert_eq_i32 "copied value" 40 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_copy_live_slots <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn &BTreeMapStorage .K .V impure fn i32 unit \src\dst\len0:
    let src_keys %&Vec Option .K btreemap_storage_keys<.K,.V> src
    let src_values %&Vec Option .V btreemap_storage_values<.K,.V> src
    let dst_keys %&Vec Option .K btreemap_storage_keys<.K,.V> dst
    let dst_values %&Vec Option .V btreemap_storage_values<.K,.V> dst
    let mut i %i32 0
    while lt i len0:
        do:
            match btreemap_key_at<.K> src_keys i:
                Option::Some key:
                    btreemap_store_key<.K> dst_keys i some key
                Option::None:
                    unit
            match btreemap_value_at<.V> src_values i:
                Option::Some value:
                    btreemap_store_value<.V> dst_values i some value
                Option::None:
                    unit
            set i add i 1

//: ## btreemap_clear_slots
//: storage の `[i, end)` slot を unused に[戻/もど]す
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - caller は `0 <= i <= end <= cap` を[保証/ほしょう]します。
//: - key/value の両方を `Option::None` に戻します。
//: - public `clear` は live prefix 全体をこの helper に渡します。
//:
//: ### [計算量/けいさんりょう]
//: - 対象 slot 数を n として O(n) です。再帰深さも O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_clear_slots_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"first slot cleared\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"second slot cleared\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 2
//:     btreemap_store_key_slot &storage 0 some 1
//:     btreemap_store_key_slot &storage 1 some 2
//:     btreemap_clear_slots &storage 2 0
//:     let first %bool match btreemap_key_slot &storage 0:
//:         Option::Some _key:
//:             false
//:         Option::None:
//:             true
//:     let second %bool match btreemap_key_slot &storage 1:
//:         Option::Some _key:
//:             false
//:         Option::None:
//:             true
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_clear_slots_doc"
//:         |> test_report_push assert "first slot cleared" first
//:         |> test_report_push assert "second slot cleared" second
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_clear_slots <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\end\i:
    if:
        lt i end
        then:
            btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage i none
            btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage i none
            btreemap_clear_slots<.K,.V> storage end add i 1
        else:
            unit

//: ## btreemap_shift_right
//: 挿入位置以降の live slot を 1 つ[右/みぎ]へずらす
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - caller は `0 <= idx <= len0 < cap` を[保証/ほしょう]します。
//: - `idx <= i < len0` の slot を `i + 1` へ移します。`idx` slot は後続の insert が上書きします。
//: - missing slot は storage invariant failure として `Option::None` のまま写します。
//:
//: ### [計算量/けいさんりょう]
//: - 移動する slot 数を n として O(n) です。追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_shift_right_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"shifted key\" expected=\"5\" actual=\"5\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"shifted value\" expected=\"50\" actual=\"50\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 3
//:     btreemap_store_key_slot &storage 0 some 1
//:     btreemap_store_value_slot &storage 0 some 10
//:     btreemap_store_key_slot &storage 1 some 5
//:     btreemap_store_value_slot &storage 1 some 50
//:     btreemap_shift_right &storage 1 2
//:     let key %i32 match btreemap_key_slot &storage 2:
//:         Option::Some saved_key:
//:             saved_key
//:         Option::None:
//:             -1
//:     let value %i32 match btreemap_value_slot &storage 2:
//:         Option::Some saved_value:
//:             saved_value
//:         Option::None:
//:             -1
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_shift_right_doc"
//:         |> test_report_push assert_eq_i32 "shifted key" 5 key
//:         |> test_report_push assert_eq_i32 "shifted value" 50 value
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_shift_right <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\idx\len0:
    let mut i %i32 len0
    while gt i idx:
        do:
            let from %i32 sub i 1
            match btreemap_key_slot<.K,.V> storage from:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none
            match btreemap_value_slot<.K,.V> storage from:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none
            set i from

//: ## btreemap_shift_left_after_remove
//: 削除位置より右の live slot を 1 つ[左/ひだり]へずらす
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - caller は `0 <= idx < len0 <= cap` を[保証/ほしょう]します。
//: - `idx + 1 <= i < len0` の slot を `i - 1` へ移し、旧 last slot は key/value とも `Option::None` にします。
//: - missing slot は storage invariant failure として `Option::None` のまま写します。
//:
//: ### [計算量/けいさんりょう]
//: - 移動する slot 数を n として O(n) です。追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_shift_left_after_remove_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"left shifted key\" expected=\"9\" actual=\"9\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"last slot cleared\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeMapStorage i32 i32 unwrap_ok btreemap_alloc_storage 3
//:     btreemap_store_key_slot &storage 0 some 1
//:     btreemap_store_key_slot &storage 1 some 5
//:     btreemap_store_key_slot &storage 2 some 9
//:     btreemap_shift_left_after_remove &storage 1 3
//:     let key %i32 match btreemap_key_slot &storage 1:
//:         Option::Some saved_key:
//:             saved_key
//:         Option::None:
//:             -1
//:     let last_empty %bool match btreemap_key_slot &storage 2:
//:         Option::Some _key:
//:             false
//:         Option::None:
//:             true
//:     btreemap_free_storage storage
//:     let report:
//:         test_report_new "btreemap_shift_left_after_remove_doc"
//:         |> test_report_push assert_eq_i32 "left shifted key" 9 key
//:         |> test_report_push assert "last slot cleared" last_empty
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_shift_left_after_remove <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\idx\len0:
    let last %i32 sub len0 1
    let mut i %i32 idx
    while lt i last:
        do:
            let nxt %i32 add i 1
            match btreemap_key_slot<.K,.V> storage nxt:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none
            match btreemap_value_slot<.K,.V> storage nxt:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none
            set i nxt
    btreemap_store_key_slot<.K,.V> storage last none
    btreemap_store_value_slot<.K,.V> storage last none

//: ## btreemap_grow
//: map storage の capacity を 2 倍にして live slot を[移/うつ]す
//:
//: ### [契約/けいやく]
//: - `hm` owner を[消費/しょうひ]します。
//: - 成功時は `len` を保ち、`cap` を `cap0 * 2` にした新しい `BTreeMap` owner を返します。
//: - 成功時は live prefix を新 storage に copy し、旧 storage owner を free します。
//: - 新 storage 確保に失敗した場合は旧 storage を保持した元 map owner と `Diag` を `BTreeMapInsertError` に入れて返します。
//: - public `insert` からは `len == cap` かつ `cap > 0` の map に対して呼ばれます。
//:
//: ### [計算量/けいさんりょう]
//: - live 要素数を n とすると、成功時は O(n) 時間と O(cap0 * 2) 追加 storage を使います。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_grow_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"grow keeps len\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"grow doubles initial cap\" expected=\"16\" actual=\"16\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"grow keeps value\" expected=\"10\" actual=\"10\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/field" as field
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let hm0 %BTreeMap i32 i32:
//:         unwrap_ok new
//:         |> insert 1 10 |> uwok
//:     let len_after %i32 match btreemap_grow hm0:
//:         Result::Ok grown:
//:             let kept_len %i32 len &grown
//:             free grown
//:             kept_len
//:         Result::Err e:
//:             let recovered %BTreeMap i32 i32 btreemap_insert_error_owner e
//:             free recovered
//:             -1
//:     let hm1 %BTreeMap i32 i32:
//:         unwrap_ok new
//:         |> insert 1 10 |> uwok
//:     let cap_after %i32 match btreemap_grow hm1:
//:         Result::Ok grown:
//:             let cap %i32 *field::get_ref &grown "cap"
//:             free grown
//:             cap
//:         Result::Err e:
//:             let recovered %BTreeMap i32 i32 btreemap_insert_error_owner e
//:             free recovered
//:             -1
//:     let hm2 %BTreeMap i32 i32:
//:         unwrap_ok new
//:         |> insert 1 10 |> uwok
//:     let value_after %i32 match btreemap_grow hm2:
//:         Result::Ok grown:
//:             let observed %i32 match get &grown 1:
//:                 Option::Some value:
//:                     value
//:                 Option::None:
//:                     -1
//:             free grown
//:             observed
//:         Result::Err e:
//:             let recovered %BTreeMap i32 i32 btreemap_insert_error_owner e
//:             free recovered
//:             -1
//:     let report:
//:         test_report_new "btreemap_grow_doc"
//:         |> test_report_push assert_eq_i32 "grow keeps len" 1 len_after
//:         |> test_report_push assert_eq_i32 "grow doubles initial cap" 16 cap_after
//:         |> test_report_push assert_eq_i32 "grow keeps value" 10 value_after
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_grow <.K: Copy,.V: Copy> %impure fn BTreeMap .K .V Result BTreeMap .K .V BTreeMapInsertError .K .V \hm:
    let len0 %i32 *field::get_ref &hm "len"
    let cap0 %i32 *field::get_ref &hm "cap"
    let storage %BTreeMapStorage .K .V field::get hm "storage"
    let cap1 %i32 mul cap0 2
    match btreemap_alloc_storage<.K,.V> cap1:
        Result::Err d:
            Result::Err BTreeMapInsertError<.K,.V> (BTreeMap<.K,.V> len0 cap0 storage) d
        Result::Ok next_storage:
            btreemap_copy_live_slots<.K,.V> &storage &next_storage len0
            btreemap_free_storage<.K,.V> storage
            Result::Ok BTreeMap<.K,.V> len0 cap1 next_storage
