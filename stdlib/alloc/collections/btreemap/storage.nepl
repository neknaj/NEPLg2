//: # btreemap/storage
//: `BTreeMap` の backing storage 操作
//:
//: ### [目的/もくてき]
//: - key/value slot の読み書き、shift、grow、storage 解放を所有します。
//: - public API が key/value storage layout を直接扱わないようにします。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "core/field" as *
#import "core/math" as *

//: 現行 storage view は `Vec<Option<K>>` の payload storage 形状を返すため、non-Copy collection drop traversal が入るまで key 側を Copy に限定します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: struct CleanupPayload:
//:     value %i32
//: fn borrow_keys %fn &BTreeMapStorage CleanupPayload i32 &Vec Option CleanupPayload \storage:
//:     btreemap_storage_keys<CleanupPayload, i32> storage
//: fn main %fn unit i32 \unit:
//:     0
//: ```
pub fn btreemap_storage_keys <.K: Copy,.V> %fn &BTreeMapStorage .K .V &Vec Option .K \storage:
    field::get_ref storage "keys"

//: 現行 storage view は `Vec<Option<V>>` の payload storage 形状を返すため、non-Copy collection drop traversal が入るまで value 側を Copy に限定します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap/storage" as *
//:| #import "alloc/collections/btreemap/types" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: struct CleanupPayload:
//:     value %i32
//: fn borrow_values %fn &BTreeMapStorage i32 CleanupPayload &Vec Option CleanupPayload \storage:
//:     btreemap_storage_values<i32, CleanupPayload> storage
//: fn main %fn unit i32 \unit:
//:     0
//: ```
pub fn btreemap_storage_values <.K,.V: Copy> %fn &BTreeMapStorage .K .V &Vec Option .V \storage:
    field::get_ref storage "values"

pub fn btreemap_key_at <.K: Copy> %fn &Vec Option .K fn i32 Option .K \keys\idx:
    match vec::get<Option<.K>> keys idx:
        Option::Some key_opt:
            key_opt
        Option::None:
            none

pub fn btreemap_value_at <.V: Copy> %fn &Vec Option .V fn i32 Option .V \values\idx:
    match vec::get<Option<.V>> values idx:
        Option::Some value_opt:
            value_opt
        Option::None:
            none

pub fn btreemap_store_key <.K: Copy> %impure fn &Vec Option .K impure fn i32 impure fn Option .K unit \keys\idx\key:
    vec::replace<Option<.K>> keys idx key

pub fn btreemap_store_value <.V: Copy> %impure fn &Vec Option .V impure fn i32 impure fn Option .V unit \values\idx\value:
    vec::replace<Option<.V>> values idx value

pub fn btreemap_key_slot <.K: Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn i32 Option .K \storage\idx:
    btreemap_key_at<.K> btreemap_storage_keys<.K,.V> storage idx

pub fn btreemap_value_slot <.K: Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn i32 Option .V \storage\idx:
    btreemap_value_at<.V> btreemap_storage_values<.K,.V> storage idx

pub fn btreemap_store_key_slot <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn Option .K unit \storage\idx\key:
    btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage idx key

pub fn btreemap_store_value_slot <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn Option .V unit \storage\idx\value:
    btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage idx value

pub fn btreemap_free_storage <.K: Copy,.V: Copy> %fn BTreeMapStorage .K .V unit \storage:
    let keys %Vec Option .K field::get storage "keys"
    let values %Vec Option .V field::get storage "values"
    vec::free<Option<.K>> keys
    vec::free<Option<.V>> values

pub fn btreemap_alloc_storage <.K: Copy,.V: Copy> %impure fn i32 Result BTreeMapStorage .K .V Diag \cap:
    match vec::filled<Option<.K>> cap none:
        Result::Err _e:
            diag_err<BTreeMapStorage<.K,.V>> diag_out_of_memory
        Result::Ok keys:
            match vec::filled<Option<.V>> cap none:
                Result::Err _e:
                    vec::free<Option<.K>> keys
                    diag_err<BTreeMapStorage<.K,.V>> diag_out_of_memory
                Result::Ok values:
                    ok BTreeMapStorage<.K,.V> keys values

pub fn btreemap_copy_live_slots <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn &BTreeMapStorage .K .V impure fn i32 unit \src\dst\len0:
    let src_keys %&Vec Option .K btreemap_storage_keys<.K,.V> src
    let src_values %&Vec Option .V btreemap_storage_values<.K,.V> src
    let dst_keys %&Vec Option .K btreemap_storage_keys<.K,.V> dst
    let dst_values %&Vec Option .V btreemap_storage_values<.K,.V> dst
    let mut i %i32 0
    while lt i len0:
        do:
            match btreemap_key_at<.K> src_keys i:
                Option::Some key:
                    btreemap_store_key<.K> dst_keys i some key
                Option::None:
                    unit
            match btreemap_value_at<.V> src_values i:
                Option::Some value:
                    btreemap_store_value<.V> dst_values i some value
                Option::None:
                    unit
            set i add i 1

pub fn btreemap_clear_slots <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\end\i:
    if:
        lt i end
        then:
            btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage i none
            btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage i none
            btreemap_clear_slots<.K,.V> storage end add i 1
        else:
            unit

pub fn btreemap_shift_right <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\idx\len0:
    let mut i %i32 len0
    while gt i idx:
        do:
            let from %i32 sub i 1
            match btreemap_key_slot<.K,.V> storage from:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none
            match btreemap_value_slot<.K,.V> storage from:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none
            set i from

pub fn btreemap_shift_left_after_remove <.K: Copy,.V: Copy> %impure fn &BTreeMapStorage .K .V impure fn i32 impure fn i32 unit \storage\idx\len0:
    let last %i32 sub len0 1
    let mut i %i32 idx
    while lt i last:
        do:
            let nxt %i32 add i 1
            match btreemap_key_slot<.K,.V> storage nxt:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none
            match btreemap_value_slot<.K,.V> storage nxt:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none
            set i nxt
    btreemap_store_key_slot<.K,.V> storage last none
    btreemap_store_value_slot<.K,.V> storage last none

pub fn btreemap_grow <.K: Copy,.V: Copy> %impure fn BTreeMap .K .V Result BTreeMap .K .V BTreeMapInsertError .K .V \hm:
    let len0 %i32 *field::get_ref &hm "len"
    let cap0 %i32 *field::get_ref &hm "cap"
    let storage %BTreeMapStorage .K .V field::get hm "storage"
    let cap1 %i32 mul cap0 2
    match btreemap_alloc_storage<.K,.V> cap1:
        Result::Err d:
            Result::Err BTreeMapInsertError<.K,.V> (BTreeMap<.K,.V> len0 cap0 storage) d
        Result::Ok next_storage:
            btreemap_copy_live_slots<.K,.V> &storage &next_storage len0
            btreemap_free_storage<.K,.V> storage
            Result::Ok BTreeMap<.K,.V> len0 cap1 next_storage
