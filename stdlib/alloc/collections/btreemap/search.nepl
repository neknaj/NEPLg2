//: # btreemap/search
//: `BTreeMap` の lower_bound / slot 判定
//:
//: ### [目的/もくてき]
//: - `Ord` に基づく key 検索と一致判定を storage 操作から分離します。
//: - public API は検索方針をこの module に委譲し、更新処理だけを組み立てます。

#indent 4

#import "core/option" as *
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/math" as *

//: btreemap_key_eq: Copy key の順序比較から同値性を判定する
//:
//: ### [目的/もくてき]
//: - `a < b` と `b < a` がどちらも false なら、map 上は同じ key とみなします。
//:
//: ### [注意/ちゅうい]
//: - 現行の `Ord` 比較は key を値渡しし、同値判定では `ord_lt` を 2 回呼びます。
//: - borrowed comparison と non-Copy key 用の `OwnedBuffer` / initialized cell 設計が入るまでは、二重消費を避けるため `.K: Copy` に限定します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreemap_key_eq_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"same keys compare equal\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"different keys compare unequal\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap/search" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let same %bool btreemap_key_eq 7 7
//:     let diff %bool btreemap_key_eq 7 9
//:     let report:
//:         test_report_new "btreemap_key_eq_doc"
//:         |> test_report_push assert_eq_i32 "same keys compare equal" 1 if same 1 0
//:         |> test_report_push assert_eq_i32 "different keys compare unequal" 0 if diff 1 0
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreemap_key_eq <.K: Ord&Copy> %fn .K fn .K bool \a\b:
    and not ord_lt a b not ord_lt b a

pub fn btreemap_lower_bound <.K: Ord&Copy> %fn &Vec Option .K fn .K fn i32 fn i32 i32 \keys\key\low\high:
    if:
        lt low high
        then:
            let mid %i32 div_s add low high 2
            match btreemap_key_at<.K> keys mid:
                Option::Some saved:
                    if:
                        ord_lt saved key
                        then btreemap_lower_bound<.K> keys key add mid 1 high
                        else btreemap_lower_bound<.K> keys key low mid
                Option::None:
                    mid
        else low

pub fn btreemap_is_at <.K: Ord&Copy> %fn &Vec Option .K fn i32 fn i32 fn .K bool \keys\len0\idx\key:
    if:
        lt idx len0
        then:
            match btreemap_key_at<.K> keys idx:
                Option::Some saved:
                    btreemap_key_eq<.K> saved key
                Option::None:
                    false
        else false

pub fn btreemap_lower_bound_storage <.K: Ord&Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn .K fn i32 fn i32 i32 \storage\key\low\high:
    btreemap_lower_bound<.K> btreemap_storage_keys<.K,.V> storage key low high

pub fn btreemap_is_at_storage <.K: Ord&Copy,.V: Copy> %fn &BTreeMapStorage .K .V fn i32 fn i32 fn .K bool \storage\len0\idx\key:
    btreemap_is_at<.K> btreemap_storage_keys<.K,.V> storage len0 idx key
