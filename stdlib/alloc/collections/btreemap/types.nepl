//: # btreemap/types
//: `BTreeMap` の型定義
//:
//: ### [目的/もくてき]
//: - public API が共有する map 本体と backing storage の型を定義します。
//: - key/value storage invariant を 1 [箇所/かしょ]で確認できるようにします。

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BTreeMapStorage
//: [順序付き/じゅんじょつき] map の backing storage
//:
//: ### [目的/もくてき]
//: - key 配列と value 配列の owner を 1 [値/あたい]として[保持/ほじ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `keys.len == values.len == cap`
//: - `0 <= i < len` の slot は key/value とも `Some`
//: - `len <= i < cap` の slot は key/value とも `None`
pub struct BTreeMapStorage<.K,.V>:
    keys %Vec Option .K
    values %Vec Option .V

//: ## BTreeMap
//: [順序付き/じゅんじょつき] key/value [配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - key と value の[整列済/せいれつず]み[配列/はいれつ]を 1 [値/あたい]として[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree node [分割/ぶんかつ]は[持/も]たず、lower_bound と shift で[動/うご]く[単純/たんじゅん][実装/じっそう]です。
pub struct BTreeMap<.K,.V>:
    len %i32
    cap %i32
    storage %BTreeMapStorage .K .V

//: ## BTreeMapInsertError
//: `insert` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `insert` は map owner を[消費/しょうひ]する fallible update です。
//: - grow [失敗/しっぱい]時も caller が map owner を[回収/かいしゅう]して cleanup / retry を[選/えら]べるようにします。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `btreemap_insert_error_owner` で owner を[取/と]り[出/だ]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、owner を[動/うご]かさず `btreemap_insert_error_diag` から[確認/かくにん]できます。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let m %BTreeMap i32 i32 unwrap_ok new<i32,i32>;
//:     let _e %BTreeMapInsertError i32 i32 BTreeMapInsertError<i32,i32> m (diag_error StdErrorKind::OutOfMemory "grow");
//:     0
//: ```
pub struct BTreeMapInsertError<.K,.V>:
    owner %BTreeMap .K .V
    diag %Diag

//: btreemap_insert_error_diag: insert [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
pub fn btreemap_insert_error_diag <.K,.V> %fn &BTreeMapInsertError .K .V Diag \e:
    *field::get_ref e "diag"

//: btreemap_insert_error_owner: insert [失敗/しっぱい]で[戻/もど]された `BTreeMap` owner を[取/と]り[出/だ]す
pub fn btreemap_insert_error_owner <.K: Copy,.V: Copy> %fn BTreeMapInsertError .K .V BTreeMap .K .V \e:
    field::get e "owner"
