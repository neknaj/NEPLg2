//: # sparse_set/api
//: `SparseSet` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `universe_len` / `contains` / `insert` / `remove` / `clear` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "./membership" as *
#import "./mutation" as *

fn sparse_set_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid sparse set length"

fn sparse_set_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "sparse set index out of bounds"

//: ## new
//: domain `[0, n)` の[空/から] set を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     let ok <bool> eq len &s 0;
//:     free s
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<SparseSet, Diag>> (n):
    if:
        lt n 0
        then:
            diag_err<SparseSet> sparse_set_diag_len
        else:
            match sparse_set_alloc_array n:
                Result::Err d:
                    err<SparseSet, Diag> d
                Result::Ok dense:
                    match sparse_set_alloc_array n:
                        Result::Err d:
                            vec::free<i32> dense
                            err<SparseSet, Diag> d
                        Result::Ok sparse:
                            ok<SparseSet, Diag> SparseSet n 0 dense sparse

//: ## len
//: [現/げん]在[入/はい]っている[要素数/ようそすう]を[返/かえ]す
fn len <(&SparseSet)->i32> (s):
    *field::get_ref s "len0"

//: ## universe_len
//: [扱/あつか]える整数 domain の[長/なが]さを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     let ok <bool> eq universe_len &s 8;
//:     free s
//:     if ok 1 0
//: ```
fn universe_len <(&SparseSet)->i32> (s):
    *field::get_ref s "n"

//: ## contains
//: value が[含/ふく]まれているかを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &s 3;
//:     free s
//:     if ok 1 0
//: ```
fn contains <(&SparseSet,i32)*>Result<bool, Diag>> (s, value):
    let n <i32> *field::get_ref s "n"
    let len0 <i32> *field::get_ref s "len0"
    let dense <&Vec<i32>> field::get_ref s "dense"
    let sparse <&Vec<i32>> field::get_ref s "sparse"
    if:
        sparse_set_valid_index value n
        then:
            ok<bool, Diag> sparse_set_contains_raw n dense sparse len0 value
        else:
            diag_err<bool> sparse_set_diag_index

//: ## insert
//: value を 1 [個/こ][追加/ついか]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> insert 5 |> uwok
//:     let ok <bool> eq len &s 2;
//:     free s
//:     if ok 1 0
//: ```
fn insert <(SparseSet,i32)*>Result<SparseSet, SparseSetUpdateError>> (s, value):
    let n <i32> *field::get_ref &s "n"
    let len0 <i32> *field::get_ref &s "len0"
    if:
        not sparse_set_valid_index value n
        then:
            let d <Diag> sparse_set_diag_index
            let e <SparseSetUpdateError> SparseSetUpdateError s d
            err<SparseSet, SparseSetUpdateError> e
        else:
            let result <Result<i32, Diag>> block:
                let dense <&Vec<i32>> field::get_ref &s "dense"
                let sparse <&Vec<i32>> field::get_ref &s "sparse"
                match sparse_set_insert_storage n dense sparse len0 value:
                    Option::Some next_len:
                        ok<i32, Diag> next_len
                    Option::None:
                        diag_err<i32> sparse_set_diag_index
            match result:
                Result::Ok next_len:
                    let dense <Vec<i32>> field::get s "dense"
                    let sparse <Vec<i32>> field::get s "sparse"
                    ok<SparseSet, SparseSetUpdateError> SparseSet n next_len dense sparse
                Result::Err d:
                    let e <SparseSetUpdateError> SparseSetUpdateError s d
                    err<SparseSet, SparseSetUpdateError> e

//: ## remove
//: value を 1 [個/こ][削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> insert 5 |> uwok
//:         |> remove 3 |> uwok
//:     let ok <bool> eq len &s 1;
//:     free s
//:     if ok 1 0
//: ```
fn remove <(SparseSet,i32)*>Result<SparseSet, SparseSetUpdateError>> (s, value):
    let n <i32> *field::get_ref &s "n"
    let len0 <i32> *field::get_ref &s "len0"
    if:
        not sparse_set_valid_index value n
        then:
            let d <Diag> sparse_set_diag_index
            let e <SparseSetUpdateError> SparseSetUpdateError s d
            err<SparseSet, SparseSetUpdateError> e
        else:
            let result <Result<i32, Diag>> block:
                let dense <&Vec<i32>> field::get_ref &s "dense"
                let sparse <&Vec<i32>> field::get_ref &s "sparse"
                match sparse_set_remove_storage n dense sparse len0 value:
                    Option::Some next_len:
                        ok<i32, Diag> next_len
                    Option::None:
                        diag_err<i32> sparse_set_diag_index
            match result:
                Result::Ok next_len:
                    let dense <Vec<i32>> field::get s "dense"
                    let sparse <Vec<i32>> field::get s "sparse"
                    ok<SparseSet, SparseSetUpdateError> SparseSet n next_len dense sparse
                Result::Err d:
                    let e <SparseSetUpdateError> SparseSetUpdateError s d
                    err<SparseSet, SparseSetUpdateError> e

//: ## clear
//: [全/すべ]ての[要素/ようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> clear
//:     let ok <bool> eq len &s 0;
//:     free s
//:     if ok 1 0
//: ```
fn clear <(SparseSet)->SparseSet> (s):
    let n <i32> field::get s "n"
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    SparseSet n 0 dense sparse

//: ## free
//: dense/sparse [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [実装/じっそう]
//: - dense/sparse はそれぞれ `Vec<i32>` として `new` が[確保/かくほ]し、`SparseSet` が[所有/しょゆう]します。
//: - owner invariant に[基/もと]づき、内部 cleanup は `vec::free` で[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [解放後/かいほうご]に `s` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet> unwrap_ok<SparseSet, Diag> new 8;
//:     free s
//:     0
//: ```
fn free <(SparseSet)->()> (s):
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    sparse_set_free_arrays dense sparse
