//: # sparse_set/api/bulk
//: `SparseSet` 全体を更新する API
//:
//: ### [目的/もくてき]
//: - `clear` を owner-consuming bulk update として提供します。
//: - dense/sparse storage owner は維持し、active length だけを 0 に戻します。

#indent 4

#import "core/field" as field
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "core/field" as *
#import "core/math" as *

//: ## clear
//: [全/すべ]ての[要素/ようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <SparseSet>:
//:         unwrap_ok<SparseSet, Diag> new 8
//:         |> insert 3 |> uwok
//:         |> clear
//:     let observed_len <i32> len &s;
//:     let ok <bool> eq observed_len 0;
//:     free s
//:     if ok 1 0
//: ```
pub fn clear <(SparseSet)->SparseSet> (s):
    let n <i32> field::get s "n"
    let dense <Vec<i32>> field::get s "dense"
    let sparse <Vec<i32>> field::get s "sparse"
    SparseSet n 0 dense sparse
