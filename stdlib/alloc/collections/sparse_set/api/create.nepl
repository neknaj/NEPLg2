//: # sparse_set/api/create
//: `SparseSet` の構築 API
//:
//: ### [目的/もくてき]
//: - domain 長に応じて dense/sparse の typed storage を 2 本確保します。
//: - 片方の確保に失敗した場合は確保済み owner を閉じてから `Diag` を返します。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../storage" as *
#import "./diagnostic" as *

//: ## new
//: domain `[0, n)` の[空/から] set を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/sparse_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let s %SparseSet unwrap_ok new 8;
//:     let observed_len %i32 len &s;
//:     let ok %bool eq observed_len 0;
//:     free s
//:     if ok 1 0
//: ```
pub fn new %impure fn i32 Result SparseSet Diag \n:
    if:
        lt n 0
        then:
            diag_err sparse_set_diag_len
        else:
            match sparse_set_alloc_array n:
                Result::Err d:
                    err d
                Result::Ok dense:
                    match sparse_set_alloc_array n:
                        Result::Err d:
                            vec::free<i32> dense
                            err d
                        Result::Ok sparse:
                            ok SparseSet n 0 dense sparse
