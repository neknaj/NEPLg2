//: # sparse_set/api/diagnostic
//: `SparseSet` public API の診断生成
//:
//: ### [目的/もくてき]
//: - domain 長の不正と index 範囲外の `Diag` 生成を 1 箇所に集約します。
//: - observer と update が同じ診断 kind/message を返すようにします。

#indent 4

#import "alloc/diag/error" as *

pub fn sparse_set_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid sparse set length"

pub fn sparse_set_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "sparse set index out of bounds"
