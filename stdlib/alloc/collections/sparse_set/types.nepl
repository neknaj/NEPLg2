//: # sparse_set/types
//: `SparseSet` の型定義と update error 型
//:
//: ### [目的/もくてき]
//: - dense/sparse [配列/はいれつ]を[所有/しょゆう]する integer set と、更新失敗時に owner を返す error 型を定義します。

#indent 4

#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

//: ## SparseSet
//: dense/sparse [配列/はいれつ]を[所有/しょゆう]する integer set
//:
//: ### [目的/もくてき]
//: - domain [長/なが]さ、active [要素数/ようそすう]、dense/sparse `Vec<i32>` owner を 1 [値/あたい]として[受/う]け[渡/わた]しします。
//:
//: ### [注意/ちゅうい]
//: - `n = 0` のとき dense/sparse は empty `Vec` で、null pointer sentinel を owner state として[使/つか]いません。
//: - [不要/ふよう]になったら `free` で dense / sparse owner を[閉/と]じます。
pub struct SparseSet:
    n %i32
    len0 %i32
    dense %Vec i32
    sparse %Vec i32

//: ## SparseSetUpdateError
//: `insert` / `remove` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` は[更新/こうしん] API なので `SparseSet` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index や内部 storage invariant の欠損では、caller が cleanup できるように元の owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `sparse_set_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`sparse_set_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
pub struct SparseSetUpdateError:
    owner %SparseSet
    diag %Diag

//: sparse_set_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
pub fn sparse_set_update_error_diag %fn &SparseSetUpdateError Diag \e:
    *field::get_ref e "diag"

//: sparse_set_update_error_owner: update [失敗/しっぱい]で[戻/もど]された owner を[取/と]り[出/だ]す
pub fn sparse_set_update_error_owner %fn SparseSetUpdateError SparseSet \e:
    field::get e "owner"
