//: # stack/api
//: LIFO stack の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `with_capacity` / `push` / `pop_top` / `stack_pop_item` / `stack_pop_stack` / `pop` / `peek` / `get` / `len` / `is_empty` / `clear` / `free` を[提供/ていきょう]します。
//: - owner を[更新/こうしん]する API と、owner を[借用/しゃくよう]して[観測/かんそく]する API を[分/わ]けます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` / `is_empty` / `peek` / `get` / `pop_top` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/field" as *

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から] stack を[作/つく]る
pub fn new <.T: Copy> %impure fn unit Result Stack .T Diag \unit:
    with_capacity<.T> 8

//: ## with_capacity
//: [容量/ようりょう]を[指定/してい]して[空/から] stack を[作/つく]る
pub fn with_capacity <.T: Copy> %impure fn i32 Result Stack .T Diag \cap:
    let cap0 %i32 stack_normalize_capacity cap
    match stack_alloc_slots<.T> cap0:
        Result::Err d:
            err d
        Result::Ok items:
            ok Stack<.T> 0 cap0 items

//: ## push
//: [末尾/まつび]へ[積/つ]む
pub fn push <.T: Copy> %impure fn Stack .T impure fn .T Result Stack .T StackPushError .T \stk\item:
    let len0 %i32 *field::get_ref &stk "len"
    let cap0 %i32 *field::get_ref &stk "cap"
    let items %Vec Option .T field::get stk "items"
    if:
        eq len0 cap0
        then:
            let new_cap %i32 mul cap0 2
            match stack_alloc_slots<.T> new_cap:
                Result::Err d:
                    Result::Err<Stack<.T>, StackPushError<.T>> StackPushError<.T> (Stack<.T> len0 cap0 items) d
                Result::Ok new_items:
                    stack_copy_live_slots<.T> &items &new_items len0
                    stack_store_slot<.T> &new_items len0 some item
                    vec::free items
                    Result::Ok<Stack<.T>, StackPushError<.T>> Stack<.T> add len0 1 new_cap new_items
        else:
            stack_store_slot<.T> &items len0 some item
            Result::Ok<Stack<.T>, StackPushError<.T>> Stack<.T> add len0 1 cap0 items

//: ## pop_top
//: [末尾/まつび]を[取/と]り[出/だ]し、[更新後/こうしんご]の stack と[値/あたい]を[返/かえ]す
pub fn pop_top <.T: Copy> %impure fn Stack .T StackPop .T \stk:
    let len0 %i32 *field::get_ref &stk "len"
    let cap0 %i32 *field::get_ref &stk "cap"
    let items %Vec Option .T field::get stk "items"
    if:
        eq len0 0
        then:
            let next_st %Stack .T Stack<.T> 0 cap0 items
            StackPop<.T> next_st none
        else:
            let next_len %i32 sub len0 1
            let item %Option .T stack_item_at<.T> &items next_len
            stack_store_slot<.T> &items next_len none
            let next_st %Stack .T Stack<.T> next_len cap0 items
            StackPop<.T> next_st item

//: ## stack_pop_item
//: `StackPop` を[借用/しゃくよう]し、[取/と]り[出/だ]した[値/あたい]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `pop_top` の[結果/けっか]から `item` を[取得/しゅとく]します。
//: - `StackPop` は[更新後/こうしんご]の stack owner を[含/ふく]むため、利用側が struct field を直接 projection せず、この API を[通/とお]して[読/よ]みます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/stack" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let st0 %Stack i32 unwrap_ok new<i32>;
//:     let st1 %Stack i32 unwrap_ok push<i32> st0 3;
//:     let p %StackPop i32 pop_top<i32> st1;
//:     let item %Option i32 stack_pop_item &p;
//:     let st2 %Stack i32 stack_pop_stack p;
//:     free st2;
//:     match item:
//:         Option::Some x:
//:             if eq x 3 0 1
//:         Option::None:
//:             1
//: ```
pub fn stack_pop_item <.T: Copy> %fn &StackPop .T Option .T \p:
    *field::get_ref p "item"

//: ## stack_pop_stack
//: `StackPop` を[消費/しょうひ]し、[更新後/こうしんご]の stack owner を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - `pop_top` の[結果/けっか]から、[次/つぎ]に[使/つか]う `Stack` owner を[移動/いどう]します。
//: - owner を[含/ふく]む field projection は stack 実装境界の責務に[閉/と]じ、caller はこの関数で owner flow を[継続/けいぞく]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/stack" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let st0 %Stack i32 unwrap_ok new<i32>;
//:     let st1 %Stack i32 unwrap_ok push<i32> st0 5;
//:     let p %StackPop i32 pop_top<i32> st1;
//:     let st2 %Stack i32 stack_pop_stack p;
//:     let observed_len %i32 len &st2;
//:     let ok %bool eq observed_len 0;
//:     free st2;
//:     if ok 0 1
//: ```
pub fn stack_pop_stack <.T: Copy> %fn StackPop .T Stack .T \p:
    field::get p "stack"

//: ## pop
//: stack を[消費/しょうひ]して[末尾/まつび]の[値/あたい]だけを[返/かえ]す
pub fn pop <.T: Copy> %impure fn Stack .T Option .T \stk:
    let p %StackPop .T pop_top<.T> stk
    let item %Option .T stack_pop_item<.T> &p
    free<.T> stack_pop_stack<.T> p
    item

//: ## peek
//: `Stack` を[移動/いどう]せずに[末尾/まつび]を[読/よ]む
pub fn peek <.T: Copy> %fn &Stack .T Option .T \stk:
    let len0 %i32 *field::get_ref stk "len"
    if:
        eq len0 0
        then:
            none
        else:
            let items %&Vec Option .T field::get_ref stk "items"
            stack_item_at<.T> items sub len0 1

//: ## get
//: `Stack` を[移動/いどう]せずに index の[値/あたい]を[読/よ]む
pub fn get <.T: Copy> %fn &Stack .T fn i32 Option .T \stk\idx:
    let len0 %i32 *field::get_ref stk "len"
    if:
        lt idx 0
        then:
            none
        else:
            if:
                le len0 idx
                then:
                    none
                else:
                    let items %&Vec Option .T field::get_ref stk "items"
                    stack_item_at<.T> items idx

//: ## len
//: `Stack` を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
pub fn len <.T> %fn &Stack .T i32 \stk:
    *field::get_ref stk "len"

//: ## is_empty
//: `Stack` を[移動/いどう]せずに[空/から]かどうかを[返/かえ]す
pub fn is_empty <.T> %fn &Stack .T bool \stk:
    eq len<.T> stk 0

//: ## clear
//: [内容/ないよう]を[空/から]にする
pub fn clear <.T: Copy> %impure fn Stack .T Stack .T \stk:
    let cap0 %i32 *field::get_ref &stk "cap"
    let items %Vec Option .T field::get stk "items"
    stack_clear_slots_loop<.T> &items cap0 0
    Stack<.T> 0 cap0 items

//: ## free
//: stack が[所有/しょゆう]する Copy-only backing storage を[解放/かいほう]する
pub fn free <.T: Copy> %fn Stack .T unit \stk:
    vec::free field::get stk "items"
