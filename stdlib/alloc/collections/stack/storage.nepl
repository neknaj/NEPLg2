//: # stack/storage
//: `Vec Option .T` による stack slot storage 操作
//:
//: ### [目的/もくてき]
//: - capacity 正規化、slot の[読/よ]み[出/だ]し、置換、初期化、clear、grow 時 copy を API 本体から[分/わ]けます。
//: - raw pointer や数値 sentinel ではなく、`Option .T` の `Some` / `None` を slot state として[使/つか]います。
//:
//: ### [注意/ちゅうい]
//: - `.T` は `Copy` です。非 Copy payload の drop traversal は collection-wide drop 設計で扱います。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

//: stack_normalize_capacity: 1 [以上/いじょう]の capacity に[正規化/せいきか]する
pub fn stack_normalize_capacity %fn i32 i32 \cap:
    if lt cap 1 1 cap

//: stack_item_at: slot の `Option .T` を[読/よ]み[出/だ]す
pub fn stack_item_at <.T: Copy> %fn &Vec Option .T fn i32 Option .T \items\idx:
    match vec::get items idx:
        Option::Some item:
            item
        Option::None:
            none

//: stack_store_slot: slot state を[更新/こうしん]する
pub fn stack_store_slot <.T: Copy> %impure fn &Vec Option .T impure fn i32 impure fn Option .T unit \items\idx\item:
    vec::replace items idx item

//: stack_alloc_slots: `None` で[初期化/しょきか]した slot storage を[確保/かくほ]する
pub fn stack_alloc_slots <.T: Copy> %impure fn i32 Result Vec Option .T Diag \cap:
    match vec::filled cap none:
        Result::Ok items:
            ok items
        Result::Err _e:
            diag_err diag_out_of_memory

//: stack_clear_slots_loop: 全 slot を `None` に[戻/もど]す
pub fn stack_clear_slots_loop <.T: Copy> %impure fn &Vec Option .T impure fn i32 impure fn i32 unit \items\cap\i:
    if:
        lt i cap
        then:
            stack_store_slot<.T> items i none
            stack_clear_slots_loop<.T> items cap add i 1
        else:
            unit

//: stack_copy_live_slots: live slot を[同/おな]じ index で[新/あたら]しい storage へ[写/うつ]す
pub fn stack_copy_live_slots <.T: Copy> %impure fn &Vec Option .T impure fn &Vec Option .T impure fn i32 unit \src\dst\len:
    let mut i %i32 0
    while lt i len:
        do:
            match stack_item_at<.T> src i:
                Option::Some item:
                    stack_store_slot<.T> dst i some item
                Option::None:
                    unit
            set i add i 1
