//: # stack/types
//: LIFO stack の owner 型、push error 型、pop 結果型
//:
//: ### [目的/もくてき]
//: - stack state と backing storage owner を struct field として[表/あらわ]します。
//: - owner-consuming push の[失敗/しっぱい]時にも、caller が stack owner を[回収/かいしゅう]できる error payload を[定義/ていぎ]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `items.len == cap`

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Stack
//: LIFO stack の owner
pub struct Stack<.T>:
    len %i32
    cap %i32
    items %Vec Option .T

//: ## StackPushError
//: `push` の grow [失敗/しっぱい]で[戻/もど]る error payload
//:
//: ### [目的/もくてき]
//: - push が[消費/しょうひ]した stack owner を `stack` に[戻/もど]し、caller が cleanup や[再試行/さいしこう]を[選/えら]べるようにします。
//: - `Diag` だけを[返/かえ]して stack owner の[行方/ゆくえ]を実装 discipline に[隠/かく]すことを[避/さ]けます。
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/stack" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let s %Stack i32 unwrap_ok<Stack<i32>, Diag> new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %StackPushError i32 StackPushError<i32> s d0;
//:     0
//: ```
pub struct StackPushError<.T>:
    stack %Stack .T
    diag %Diag

//: ## stack_push_error_diag
//: push [失敗/しっぱい]の `Diag` を owner を[動/うご]かさず[読/よ]む
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/stack" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let s %Stack i32 unwrap_ok<Stack<i32>, Diag> new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %StackPushError i32 StackPushError<i32> s d0;
//:     0
//: ```
pub fn stack_push_error_diag <.T> %fn &StackPushError .T Diag \e:
    *field::get_ref e "diag"

//: ## stack_push_error_stack
//: push [失敗/しっぱい]で[戻/もど]された stack owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 Stack は `Vec<Option<T>>` storage を Copy-only payload に[限定/げんてい]しているため、この accessor も `.T: Copy` に[限定/げんてい]します。
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/stack" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let s %Stack i32 unwrap_ok<Stack<i32>, Diag> new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %StackPushError i32 StackPushError<i32> s d0;
//:     0
//: ```
pub fn stack_push_error_stack <.T: Copy> %fn StackPushError .T Stack .T \e:
    field::get e "stack"

//: ## StackPop
//: `pop_top` の[結果/けっか]
//:
//: ### [注意/ちゅうい]
//: - `StackPop` は stack owner を[含/ふく]む owner-preserving result です。
//: - 利用側は field projection ではなく、`stack_pop_item` / `stack_pop_stack` で[分解/ぶんかい]します。
//:
//: neplg2:test
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/stack" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let st0 %Stack i32 unwrap_ok new<i32>;
//:     let st1 %Stack i32 unwrap_ok push<i32> st0 7;
//:     let p %StackPop i32 pop_top<i32> st1;
//:     let item %Option i32 stack_pop_item<i32> &p;
//:     let st2 %Stack i32 stack_pop_stack<i32> p;
//:     free<i32> st2;
//:     match item:
//:         Option::Some x:
//:             if eq x 7 0 1
//:         Option::None:
//:             1
//: ```
pub struct StackPop<.T>:
    stack %Stack .T
    item %Option .T
