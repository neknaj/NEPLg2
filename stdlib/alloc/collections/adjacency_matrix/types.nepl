//: # adjacency_matrix/types
//: `AdjacencyMatrix` の型定義と update error 型
//:
//: ### [目的/もくてき]
//: - directed graph の fixed-length edge matrix owner と、更新失敗時に owner を返す error 型を定義します。

#indent 4

#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

//: ## AdjacencyMatrix
//: [隣接行列/りんせつぎょうれつ] byte [配列/はいれつ]を[所有/しょゆう]する graph container
//:
//: ### [目的/もくてき]
//: - [頂点数/ちょうてんすう]と byte [長/ちょう]と data pointer を 1 [値/あたい]として[受/う]け[渡/わた]せるようにします。
//:
//: ### [契約/けいやく]
//: - public constructor `new` が作る値では `nverts > 0` です。
//: - `nbytes` は `ceil nverts * nverts / 8` で、`bits` は長さ `nbytes` の `Vec u8` owner です。
//: - edge は row-major layout の `from * nverts + to` に対応する bit として保存します。
//: - 最後の byte にある未使用 bit は `contains` から観測できません。public API は常に `0 <= vertex < nverts` を検査します。
//:
//: ### [注意/ちゅうい]
//: - `free` しないかぎり[内部/ないぶ] `Vec u8` の[所有権/しょゆうけん]を[保持/ほじ]します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_type_invariant_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"vertex length\" expected=\"3\" actual=\"3\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"rounded byte length\" expected=\"2\" actual=\"2\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/field" as field
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix unwrap_ok new 3
//:     let nverts %i32 *field::get_ref &g "nverts"
//:     let nbytes %i32 *field::get_ref &g "nbytes"
//:     free g
//:     let report:
//:         test_report_new "adjacency_matrix_type_invariant_doc"
//:         |> test_report_push assert_eq_i32 "vertex length" 3 nverts
//:         |> test_report_push assert_eq_i32 "rounded byte length" 2 nbytes
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub struct AdjacencyMatrix:
    nverts %i32
    nbytes %i32
    bits %Vec u8

//: ## AdjacencyMatrixUpdateError
//: `insert` / `remove` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` は[更新/こうしん] API なので `AdjacencyMatrix` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] vertex では matrix storage を[変更/へんこう]せず、caller が cleanup できるように元の owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `adjacency_matrix_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`adjacency_matrix_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_update_error_type_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"error kind\" expected=\"IndexOutOfBounds\" actual=\"IndexOutOfBounds\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"recovered len\" expected=\"4\" actual=\"4\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g0 %AdjacencyMatrix unwrap_ok new 4
//:     let kind %str:
//:         match insert g0 4 0:
//:             Result::Ok next:
//:                 free next
//:                 "unexpected"
//:             Result::Err e:
//:                 let name %str diag_std_error_kind_str adjacency_matrix_update_error_diag &e
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 free recovered
//:                 name
//:     let g1 %AdjacencyMatrix unwrap_ok new 4
//:     let recovered_len %i32:
//:         match remove g1 0 4:
//:             Result::Ok next:
//:                 free next
//:                 0
//:             Result::Err e:
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 let size %i32 len &recovered
//:                 free recovered
//:                 size
//:     let report:
//:         test_report_new "adjacency_matrix_update_error_type_doc"
//:         |> test_report_push assert_str_eq "error kind" "IndexOutOfBounds" kind
//:         |> test_report_push assert_eq_i32 "recovered len" 4 recovered_len
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub struct AdjacencyMatrixUpdateError:
    owner %AdjacencyMatrix
    diag %Diag

//: adjacency_matrix_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
//:
//: ### [契約/けいやく]
//: - `AdjacencyMatrixUpdateError` を借用し、`owner` field は消費しません。
//: - caller はこの accessor の後で `adjacency_matrix_update_error_owner` を呼んで owner を回収できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_update_error_diag_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"diag kind\" expected=\"IndexOutOfBounds\" actual=\"IndexOutOfBounds\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix unwrap_ok new 4
//:     let kind %str:
//:         match insert g 4 0:
//:             Result::Ok next:
//:                 free next
//:                 "unexpected"
//:             Result::Err e:
//:                 let name %str diag_std_error_kind_str adjacency_matrix_update_error_diag &e
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 free recovered
//:                 name
//:     let report:
//:         test_report_new "adjacency_matrix_update_error_diag_doc"
//:         |> test_report_push assert_str_eq "diag kind" "IndexOutOfBounds" kind
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_update_error_diag %fn &AdjacencyMatrixUpdateError Diag \e:
    *field::get_ref e "diag"

//: adjacency_matrix_update_error_owner: update [失敗/しっぱい]で[戻/もど]された `AdjacencyMatrix` owner を[取/と]り[出/だ]す
//:
//: ### [契約/けいやく]
//: - `AdjacencyMatrixUpdateError` を消費し、内部の `AdjacencyMatrix` owner を返します。
//: - 回収した owner は通常の `AdjacencyMatrix` と同じく、不要になった時点で `free` します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_update_error_owner_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"owner len\" expected=\"4\" actual=\"4\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix unwrap_ok new 4
//:     let recovered_len %i32:
//:         match insert g 4 0:
//:             Result::Ok next:
//:                 free next
//:                 0
//:             Result::Err e:
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 let size %i32 len &recovered
//:                 free recovered
//:                 size
//:     let report:
//:         test_report_new "adjacency_matrix_update_error_owner_doc"
//:         |> test_report_push assert_eq_i32 "owner len" 4 recovered_len
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_update_error_owner %fn AdjacencyMatrixUpdateError AdjacencyMatrix \e:
    field::get e "owner"
