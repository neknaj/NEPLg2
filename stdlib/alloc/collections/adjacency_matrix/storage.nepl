//: # adjacency_matrix/storage
//: `AdjacencyMatrix` の typed byte storage 操作
//:
//: ### [目的/もくてき]
//: - `Vec<u8>` の byte 読み書き、全 byte 初期化、allocation を集約します。
//: - public API が raw pointer や raw byte load/store を扱わない構成を保ちます。

#indent 4

#import "core/cast" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

pub fn adjacency_matrix_byte_at %fn &Vec u8 fn i32 Option i32 \bits\byte_idx:
    match vec::get<u8> bits byte_idx:
        Option::Some byte:
            let value %i32 cast byte
            some value
        Option::None:
            none

pub fn adjacency_matrix_store_byte %impure fn &Vec u8 impure fn i32 impure fn i32 unit \bits\byte_idx\byte_value:
    let byte %u8 cast byte_value
    vec::replace<u8> bits byte_idx byte

pub fn adjacency_matrix_fill_bytes %impure fn &Vec u8 impure fn i32 impure fn i32 unit \bits\nbytes\byte_value:
    let mut i %i32 0
    while lt i nbytes:
        do:
            adjacency_matrix_store_byte bits i byte_value
            set i add i 1

pub fn adjacency_matrix_alloc_bits %impure fn i32 impure fn i32 Result Vec u8 Diag \nbytes\byte_value:
    let byte %u8 cast byte_value
    match vec::filled<u8> nbytes byte:
        Result::Ok bits:
            ok bits
        Result::Err _e:
            diag_err<Vec<u8>> diag_out_of_memory
