//: # adjacency_matrix/api
//: `AdjacencyMatrix` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `contains` / `insert` / `remove` / `clear` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./layout" as *
#import "./storage" as *
#import "./mutation" as *

fn adjacency_matrix_invalid_len_diag <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid adjacency matrix vertex length"

fn adjacency_matrix_vertex_diag <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "adjacency matrix vertex out of bounds"

//: ## new
//: [空/から]の[隣接行列/りんせつぎょうれつ]を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix> unwrap_ok<AdjacencyMatrix, Diag> new 5;
//:     let ok <bool> eq len &g 5;
//:     free g
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<AdjacencyMatrix, Diag>> (nverts):
    if:
        le nverts 0
        then:
            diag_err<AdjacencyMatrix> adjacency_matrix_invalid_len_diag
        else:
            let nbytes <i32> adjacency_matrix_byte_len nverts
            match adjacency_matrix_alloc_bits nbytes 0:
                Result::Err d:
                    err<AdjacencyMatrix, Diag> d
                Result::Ok bits:
                    ok<AdjacencyMatrix, Diag> AdjacencyMatrix nverts nbytes bits

//: ## len
//: [頂点数/ちょうてんすう]を[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `AdjacencyMatrix` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `AdjacencyMatrix` を[使/つか]い、不要になったら `free` できます。
fn len <(&AdjacencyMatrix)->i32> (g):
    *field::get_ref g "nverts"

//: ## contains
//: edge の[有無/うむ]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix>:
//:         unwrap_ok<AdjacencyMatrix, Diag> new 4
//:         |> insert 1 3 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &g 1 3;
//:     free g
//:     if ok 1 0
//: ```
fn contains <(&AdjacencyMatrix,i32,i32)*>Result<bool, Diag>> (g, from, to):
    let nverts <i32> *field::get_ref g "nverts"
    if:
        adjacency_matrix_valid_edge nverts from to
        then:
            let bits <&Vec<u8>> field::get_ref g "bits"
            let bit_idx <i32> adjacency_matrix_bit_index nverts from to
            let byte_idx <i32> adjacency_matrix_byte_index bit_idx
            let mask <i32> adjacency_matrix_mask bit_idx
            match adjacency_matrix_byte_at bits byte_idx:
                Option::Some cur:
                    ok<bool, Diag> ne and cur mask 0
                Option::None:
                    diag_err<bool> adjacency_matrix_vertex_diag
        else:
            diag_err<bool> adjacency_matrix_vertex_diag

//: ## insert
//: directed edge を 1 に[設定/せってい]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix> unwrap_ok<AdjacencyMatrix, Diag> new 4;
//:     let g1 <AdjacencyMatrix> unwrap_ok<AdjacencyMatrix, AdjacencyMatrixUpdateError> insert g 2 0;
//:     let ok <bool> unwrap_ok<bool, Diag> contains &g1 2 0;
//:     free g1
//:     if ok 1 0
//: ```
fn insert <(AdjacencyMatrix,i32,i32)*>Result<AdjacencyMatrix, AdjacencyMatrixUpdateError>> (g, from, to):
    let nverts <i32> *field::get_ref &g "nverts"
    if:
        adjacency_matrix_valid_edge nverts from to
        then:
            let result <Result<(), Diag>> block:
                let bits <&Vec<u8>> field::get_ref &g "bits"
                let bit_idx <i32> adjacency_matrix_bit_index nverts from to
                let byte_idx <i32> adjacency_matrix_byte_index bit_idx
                let mask <i32> adjacency_matrix_mask bit_idx
                if:
                    adjacency_matrix_write_masked bits byte_idx mask true
                    then:
                        ok<(), Diag> ()
                    else:
                        diag_err<()> adjacency_matrix_vertex_diag
            match result:
                Result::Ok _unit:
                    ok<AdjacencyMatrix, AdjacencyMatrixUpdateError> g
                Result::Err d:
                    let e <AdjacencyMatrixUpdateError> AdjacencyMatrixUpdateError g d
                    err<AdjacencyMatrix, AdjacencyMatrixUpdateError> e
        else:
            let d <Diag> adjacency_matrix_vertex_diag
            let e <AdjacencyMatrixUpdateError> AdjacencyMatrixUpdateError g d
            err<AdjacencyMatrix, AdjacencyMatrixUpdateError> e

//: ## remove
//: directed edge を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix>:
//:         unwrap_ok<AdjacencyMatrix, Diag> new 4
//:         |> insert 2 0 |> uwok
//:         |> remove 2 0 |> uwok
//:     let ok <bool> unwrap_ok<bool, Diag> contains &g 2 0;
//:     free g
//:     if not ok 1 0
//: ```
fn remove <(AdjacencyMatrix,i32,i32)*>Result<AdjacencyMatrix, AdjacencyMatrixUpdateError>> (g, from, to):
    let nverts <i32> *field::get_ref &g "nverts"
    if:
        adjacency_matrix_valid_edge nverts from to
        then:
            let result <Result<(), Diag>> block:
                let bits <&Vec<u8>> field::get_ref &g "bits"
                let bit_idx <i32> adjacency_matrix_bit_index nverts from to
                let byte_idx <i32> adjacency_matrix_byte_index bit_idx
                let mask <i32> adjacency_matrix_mask bit_idx
                if:
                    adjacency_matrix_write_masked bits byte_idx mask false
                    then:
                        ok<(), Diag> ()
                    else:
                        diag_err<()> adjacency_matrix_vertex_diag
            match result:
                Result::Ok _unit:
                    ok<AdjacencyMatrix, AdjacencyMatrixUpdateError> g
                Result::Err d:
                    let e <AdjacencyMatrixUpdateError> AdjacencyMatrixUpdateError g d
                    err<AdjacencyMatrix, AdjacencyMatrixUpdateError> e
        else:
            let d <Diag> adjacency_matrix_vertex_diag
            let e <AdjacencyMatrixUpdateError> AdjacencyMatrixUpdateError g d
            err<AdjacencyMatrix, AdjacencyMatrixUpdateError> e

//: ## clear
//: [全/すべ]ての edge を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix>:
//:         unwrap_ok<AdjacencyMatrix, Diag> new 4
//:         |> insert 0 1 |> uwok
//:         |> clear
//:     let ok <bool> unwrap_ok<bool, Diag> contains &g 0 1;
//:     free g
//:     if not ok 1 0
//: ```
fn clear <(AdjacencyMatrix)*>AdjacencyMatrix> (g):
    let nbytes <i32> *field::get_ref &g "nbytes"
    let bits <&Vec<u8>> field::get_ref &g "bits"
    adjacency_matrix_fill_bytes bits nbytes 0
    g

//: ## free
//: [内部/ないぶ] byte [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `AdjacencyMatrix` は `new` が[確保/かくほ]した `nbytes > 0` の matrix byte `Vec<u8>` を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、`Vec<u8>` owner を[閉/と]じます。
//: - caller は `free` [後/ご]の `AdjacencyMatrix` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix> unwrap_ok<AdjacencyMatrix, Diag> new 3;
//:     free g
//:     0
//: ```
fn free <(AdjacencyMatrix)->()> (g):
    let bits <Vec<u8>> field::get g "bits"
    vec::free<u8> bits
