//: # adjacency_matrix/layout
//: vertex pair から bit / byte offset への変換
//:
//: ### [目的/もくてき]
//: - edge validation と matrix bit layout 計算を 1 箇所に集約します。

#indent 4

#import "core/math" as *

//: adjacency_matrix_bit_index: vertex pair を bit index に[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `nverts x nverts` の row-major bit matrix で、`from -> to` edge が[対応/たいおう]する bit 位置を[返/かえ]します。
//: - この helper は境界検査を行わず、呼び出し側が `adjacency_matrix_valid_edge` などで vertex 範囲を確認した後に使う前提です。
//:
//: ### [契約/けいやく]
//: - `nverts` は matrix の頂点数、`from` と `to` は検査済みの vertex index です。
//: - 返り値は row-major layout の `from * nverts + to` です。
//: - storage は読みません。存在しない edge であっても、位置計算だけを行います。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は `mul from nverts` に `to` を足すだけの算術 helper です。
//: - overflow 検査はこの helper では行わず、public constructor と public API の頂点数制限が担当します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_bit_index_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"row major edge\" expected=\"7\" actual=\"7\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"first edge\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_bit_index_doc"
//:         |> test_report_push assert_eq_i32 "row major edge" 7 adjacency_matrix_bit_index 3 2 1
//:         |> test_report_push assert_eq_i32 "first edge" 0 adjacency_matrix_bit_index 3 0 0
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_bit_index %fn i32 fn i32 fn i32 i32 \nverts\from\to:
    add mul from nverts to

//: adjacency_matrix_byte_index: bit index が[属/ぞく]する byte index を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - bit-packed adjacency matrix の bit index から、`Vec u8` 内で[読/よ]み[書/か]きする byte 位置を[計算/けいさん]します。
//: - `adjacency_matrix_bit_index` の結果を storage layer に渡す前の変換として使います。
//:
//: ### [契約/けいやく]
//: - `bit_idx` は 0 以上であることを呼び出し側が保証します。
//: - 返り値は `bit_idx / 8` の切り捨てです。
//: - 境界検査や storage 長の確認は行いません。vertex 範囲は `adjacency_matrix_valid_edge`、storage 範囲は storage layer が担当します。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は `div_s bit_idx 8` による signed integer division です。
//: - `bit_idx` が負でないという契約により、符号付き除算でも byte index は通常の floor division と一致します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_byte_index_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"first byte\" expected=\"0\" actual=\"0\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"same byte end\" expected=\"0\" actual=\"0\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"next byte\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_byte_index_doc"
//:         |> test_report_push assert_eq_i32 "first byte" 0 adjacency_matrix_byte_index 0
//:         |> test_report_push assert_eq_i32 "same byte end" 0 adjacency_matrix_byte_index 7
//:         |> test_report_push assert_eq_i32 "next byte" 1 adjacency_matrix_byte_index 8
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_byte_index %fn i32 i32 \bit_idx:
    div_s bit_idx 8

//: adjacency_matrix_mask: byte 内の bit 位置に[対応/たいおう]する mask を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - bit-packed adjacency matrix の bit index から、対象 byte に対して OR / AND する bit mask を作ります。
//: - mutation layer はこの mask を使い、edge の有無を 1 bit だけ更新します。
//:
//: ### [契約/けいやく]
//: - `bit_idx` は 0 以上であることを呼び出し側が保証します。
//: - 返り値は `1 << (bit_idx % 8)` です。
//: - byte index は返しません。byte 位置は `adjacency_matrix_byte_index` と組み合わせて求めます。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は `rem_s bit_idx 8` で byte 内 offset を求め、`shl 1 offset` で mask を作ります。
//: - 低位 bit から順に edge を詰める storage 表現であり、この bit numbering は mutation / observer layer と合わせて扱います。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_mask_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"low bit\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"high bit\" expected=\"128\" actual=\"128\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"wrapped bit\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_mask_doc"
//:         |> test_report_push assert_eq_i32 "low bit" 1 adjacency_matrix_mask 0
//:         |> test_report_push assert_eq_i32 "high bit" 128 adjacency_matrix_mask 7
//:         |> test_report_push assert_eq_i32 "wrapped bit" 1 adjacency_matrix_mask 8
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_mask %fn i32 i32 \bit_idx:
    shl 1 rem_s bit_idx 8

//: adjacency_matrix_valid_vertex: vertex index が matrix の[範囲/はんい][内/ない]かを[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - public API が edge を読む前に、単一 vertex index の境界を確認できるようにします。
//: - `0 <= idx < nverts` の条件を layout module に集約し、observer と update で同じ判定を使います。
//:
//: ### [契約/けいやく]
//: - `nverts` は matrix の頂点数です。
//: - `idx` が負数、または `nverts` 以上なら `false` を返します。
//: - この関数は storage を読みません。値だけで決まる純粋な境界判定です。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は `le 0 idx` と `lt idx nverts` を `and` で結合します。
//: - 頂点数そのものの妥当性は public constructor 側で保証し、この helper は与えられた `nverts` に対する index 判定だけを担当します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_valid_vertex_doc\" count=3 failed=0\nassertion index=0 status=ok kind=bool label=\"inside\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=ne_bool label=\"upper bound\" expected=\"different\" actual=\"true vs false\" message=\"\"\nassertion index=2 status=ok kind=ne_bool label=\"above upper bound\" expected=\"different\" actual=\"true vs false\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_valid_vertex_doc"
//:         |> test_report_push assert "inside" adjacency_matrix_valid_vertex 2 3
//:         |> test_report_push assert_ne "upper bound" true adjacency_matrix_valid_vertex 3 3
//:         |> test_report_push assert_ne "above upper bound" true adjacency_matrix_valid_vertex 4 3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_valid_vertex %fn i32 fn i32 bool \idx\nverts:
    and le 0 idx lt idx nverts

//: adjacency_matrix_valid_edge: directed edge の両端 vertex が[有効/ゆうこう]かを[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `from -> to` edge を読む前に、両方の vertex index が matrix 内にあるかをまとめて確認します。
//: - API 層はこの結果が `false` の場合、`adjacency_matrix_vertex_diag` を使って owner-preserving な error を返します。
//:
//: ### [契約/けいやく]
//: - `from` と `to` がどちらも `0 <= index < nverts` を満たすときだけ `true` を返します。
//: - この関数は directed edge の向きだけを受け取り、edge が実際に存在するかは storage を読んで判定しません。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は `adjacency_matrix_valid_vertex` を `from` と `to` に対して 1 回ずつ呼び、その結果を `and` します。
//: - vertex validity の意味を変更する場合は、この関数ではなく `adjacency_matrix_valid_vertex` の契約と実装を更新します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_valid_edge_doc\" count=3 failed=0\nassertion index=0 status=ok kind=bool label=\"inside edge\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=ne_bool label=\"from outside\" expected=\"different\" actual=\"true vs false\" message=\"\"\nassertion index=2 status=ok kind=ne_bool label=\"to outside\" expected=\"different\" actual=\"true vs false\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_valid_edge_doc"
//:         |> test_report_push assert "inside edge" adjacency_matrix_valid_edge 3 2 1
//:         |> test_report_push assert_ne "from outside" true adjacency_matrix_valid_edge 3 3 1
//:         |> test_report_push assert_ne "to outside" true adjacency_matrix_valid_edge 3 1 3
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_valid_edge %fn i32 fn i32 fn i32 bool \nverts\from\to:
    and adjacency_matrix_valid_vertex from nverts adjacency_matrix_valid_vertex to nverts

//: adjacency_matrix_byte_len: `nverts x nverts` bit matrix に[必要/ひつよう]な byte 数を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - bit-packed adjacency matrix の backing storage に必要な `Vec u8` 長を計算します。
//: - allocation layer はこの値を使い、頂点数から storage byte 数を一貫して決めます。
//:
//: ### [契約/けいやく]
//: - 返り値は `ceil((nverts * nverts) / 8)` です。
//: - `nverts` は 0 以上であることを呼び出し側が保証します。
//: - overflow 検査は行いません。public constructor 側で許容頂点数を制限します。
//:
//: ### [現状実装/げんじょうじっそう]
//: - 現在は非負整数向けの `ceil(x / 8)` として、`nverts * nverts + 7` を 8 で割ります。
//: - storage は byte 単位で確保するため、edge 数が 8 の倍数でない場合も最後の byte を確保します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_byte_len_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"empty\" expected=\"0\" actual=\"0\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"three vertices\" expected=\"2\" actual=\"2\" message=\"\"\nassertion index=2 status=ok kind=eq_i32 label=\"four vertices\" expected=\"2\" actual=\"2\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix/layout" as *
//: fn main %impure fn void i32 \void:
//:     let report:
//:         test_report_new "adjacency_matrix_byte_len_doc"
//:         |> test_report_push assert_eq_i32 "empty" 0 adjacency_matrix_byte_len 0
//:         |> test_report_push assert_eq_i32 "three vertices" 2 adjacency_matrix_byte_len 3
//:         |> test_report_push assert_eq_i32 "four vertices" 2 adjacency_matrix_byte_len 4
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_byte_len %fn i32 i32 \nverts:
    div_s add mul nverts nverts 7 8
