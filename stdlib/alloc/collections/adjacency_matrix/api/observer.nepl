//: # adjacency_matrix/api/observer
//: `AdjacencyMatrix` の借用 observer API
//:
//: ### [目的/もくてき]
//: - `len` / `contains` を `AdjacencyMatrix` owner を消費しない read-only API として提供します。
//: - edge validation と typed byte read を通し、raw pointer を public API に漏らしません。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../layout" as *
#import "../storage" as *
#import "./diagnostic" as *
#import "core/field" as *

//: ## len
//: [頂点数/ちょうてんすう]を[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `AdjacencyMatrix` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `AdjacencyMatrix` を[使/つか]い、不要になったら `free` できます。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_len_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"borrowed len keeps owner\" expected=\"5\" actual=\"5\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix unwrap_ok new 5
//:     let size %i32 len &g
//:     free g
//:     let report:
//:         test_report_new "adjacency_matrix_len_doc"
//:         |> test_report_push assert_eq_i32 "borrowed len keeps owner" 5 size
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn len %fn &AdjacencyMatrix i32 \g:
    *field::get_ref g "nverts"

//: ## contains
//: edge の[有無/うむ]を[返/かえ]す
//:
//: ### [契約/けいやく]
//: - `g` owner は[消費/しょうひ]しません。
//: - `from` と `to` がどちらも `0 <= vertex < len g` を満たすとき、edge bit を読んで `Ok bool` を返します。
//: - 範囲外 vertex または storage invariant failure は `StdErrorKind::IndexOutOfBounds` の `Diag` を返します。
//:
//: ### [現状実装/げんじょうじっそう]
//: - `adjacency_matrix_valid_edge`、row-major bit index、byte index、mask を使い、typed byte storage を 1 byte だけ読みます。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_contains_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"inserted edge present\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"invalid vertex kind\" expected=\"IndexOutOfBounds\" actual=\"IndexOutOfBounds\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix:
//:         unwrap_ok new 4
//:         |> insert 1 3 |> uwok
//:     let present %bool unwrap_ok contains &g 1 3
//:     let invalid_kind %str:
//:         match contains &g 4 0:
//:             Result::Ok _value:
//:                 "unexpected"
//:             Result::Err d:
//:                 diag_std_error_kind_str d
//:     free g
//:     let report:
//:         test_report_new "adjacency_matrix_contains_doc"
//:         |> test_report_push assert "inserted edge present" present
//:         |> test_report_push assert_str_eq "invalid vertex kind" "IndexOutOfBounds" invalid_kind
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn contains %impure fn &AdjacencyMatrix impure fn i32 impure fn i32 Result bool Diag \g\from\to:
    let nverts %i32 *field::get_ref g "nverts"
    if:
        adjacency_matrix_valid_edge nverts from to
        then:
            let bits %&Vec u8 field::get_ref g "bits"
            let bit_idx %i32 adjacency_matrix_bit_index nverts from to
            let byte_idx %i32 adjacency_matrix_byte_index bit_idx
            let mask %i32 adjacency_matrix_mask bit_idx
            match adjacency_matrix_byte_at bits byte_idx:
                Option::Some cur:
                    ok ne and cur mask 0
                Option::None:
                    diag_err adjacency_matrix_vertex_diag
        else:
            diag_err adjacency_matrix_vertex_diag
