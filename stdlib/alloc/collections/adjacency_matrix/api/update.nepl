//: # adjacency_matrix/api/update
//: `AdjacencyMatrix` の owner-consuming update API
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` の edge validation と byte read-modify-write 呼び出しを 1 箇所に集約します。
//: - update 失敗時は `AdjacencyMatrixUpdateError` に元 owner を入れて返し、caller が cleanup できるようにします。

#indent 4

#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../layout" as *
#import "../storage" as *
#import "../mutation" as *
#import "./diagnostic" as *
#import "core/field" as *
#import "core/math" as *

//: ## adjacency_matrix_update
//: edge validation [後/ご]に edge bit の on/off を[切/き]り[替/か]える
//:
//: ### [目的/もくてき]
//: - `insert` と `remove` の共通本体です。
//: - storage 欠損や vertex 範囲外は owner-preserving error に変換します。
//:
//: ### [契約/けいやく]
//: - 成功時は edge bit を `set_edge` に従って更新した `AdjacencyMatrix` owner を返します。
//: - `from` / `to` が範囲外、または storage byte が見つからない場合は `AdjacencyMatrixUpdateError` を返します。
//: - 失敗時の error は元の owner と typed `Diag` を保持し、caller は `adjacency_matrix_update_error_owner` で回収できます。
//:
//: ### [現状実装/げんじょうじっそう]
//: - vertex validation 後に row-major bit index、byte index、mask を計算し、`adjacency_matrix_write_masked` へ委譲します。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_update_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"update writes edge\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"error returns owner\" expected=\"4\" actual=\"4\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g0 %AdjacencyMatrix unwrap_ok new 4
//:     let g1 %AdjacencyMatrix unwrap_ok adjacency_matrix_update g0 2 1 true
//:     let wrote %bool unwrap_ok contains &g1 2 1
//:     free g1
//:     let g2 %AdjacencyMatrix unwrap_ok new 4
//:     let recovered_len %i32:
//:         match adjacency_matrix_update g2 4 0 true:
//:             Result::Ok next:
//:                 free next
//:                 0
//:             Result::Err e:
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 let size %i32 len &recovered
//:                 free recovered
//:                 size
//:     let report:
//:         test_report_new "adjacency_matrix_update_doc"
//:         |> test_report_push assert "update writes edge" wrote
//:         |> test_report_push assert_eq_i32 "error returns owner" 4 recovered_len
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn adjacency_matrix_update %impure fn AdjacencyMatrix impure fn i32 impure fn i32 impure fn bool Result AdjacencyMatrix AdjacencyMatrixUpdateError \g\from\to\set_edge:
    let nverts %i32 *field::get_ref &g "nverts"
    if:
        adjacency_matrix_valid_edge nverts from to
        then:
            let result %Result unit Diag block:
                let bits %&Vec u8 field::get_ref &g "bits"
                let bit_idx %i32 adjacency_matrix_bit_index nverts from to
                let byte_idx %i32 adjacency_matrix_byte_index bit_idx
                let mask %i32 adjacency_matrix_mask bit_idx
                if:
                    adjacency_matrix_write_masked bits byte_idx mask set_edge
                    then:
                        ok unit
                    else:
                        diag_err adjacency_matrix_vertex_diag
            match result:
                Result::Ok _unit:
                    ok g
                Result::Err d:
                    let e %AdjacencyMatrixUpdateError AdjacencyMatrixUpdateError g d
                    err e
        else:
            let d %Diag adjacency_matrix_vertex_diag
            let e %AdjacencyMatrixUpdateError AdjacencyMatrixUpdateError g d
            err e

//: ## insert
//: directed edge を 1 に[設定/せってい]する
//:
//: ### [契約/けいやく]
//: - 成功時は `from -> to` edge を 1 にした owner を返します。
//: - 範囲外 vertex では `AdjacencyMatrixUpdateError` を返し、元 owner を失いません。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_insert_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"inserted edge present\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"invalid insert kind\" expected=\"IndexOutOfBounds\" actual=\"IndexOutOfBounds\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix unwrap_ok new 4
//:     let g1 %AdjacencyMatrix unwrap_ok insert g 2 0
//:     let present %bool unwrap_ok contains &g1 2 0
//:     free g1
//:     let g2 %AdjacencyMatrix unwrap_ok new 4
//:     let invalid_kind %str:
//:         match insert g2 4 0:
//:             Result::Ok next:
//:                 free next
//:                 "unexpected"
//:             Result::Err e:
//:                 let name %str diag_std_error_kind_str adjacency_matrix_update_error_diag &e
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 free recovered
//:                 name
//:     let report:
//:         test_report_new "adjacency_matrix_insert_doc"
//:         |> test_report_push assert "inserted edge present" present
//:         |> test_report_push assert_str_eq "invalid insert kind" "IndexOutOfBounds" invalid_kind
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn insert %impure fn AdjacencyMatrix impure fn i32 impure fn i32 Result AdjacencyMatrix AdjacencyMatrixUpdateError \g\from\to:
    adjacency_matrix_update g from to true

//: ## remove
//: directed edge を 0 に[戻/もど]す
//:
//: ### [契約/けいやく]
//: - 成功時は `from -> to` edge を 0 にした owner を返します。
//: - 存在しない edge の remove は成功し、状態を 0 のまま保ちます。
//: - 範囲外 vertex では `AdjacencyMatrixUpdateError` を返し、元 owner を失いません。
//:
//: ### [計算量/けいさんりょう]
//: - 時間計算量は O(1)、追加の空間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_remove_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"removed edge absent\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"invalid remove recovers owner\" expected=\"4\" actual=\"4\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     let g %AdjacencyMatrix:
//:         unwrap_ok new 4
//:         |> insert 2 0 |> uwok
//:         |> remove 2 0 |> uwok
//:     let absent %bool not unwrap_ok contains &g 2 0
//:     free g
//:     let g2 %AdjacencyMatrix unwrap_ok new 4
//:     let recovered_len %i32:
//:         match remove g2 0 4:
//:             Result::Ok next:
//:                 free next
//:                 0
//:             Result::Err e:
//:                 let recovered %AdjacencyMatrix adjacency_matrix_update_error_owner e
//:                 let size %i32 len &recovered
//:                 free recovered
//:                 size
//:     let report:
//:         test_report_new "adjacency_matrix_remove_doc"
//:         |> test_report_push assert "removed edge absent" absent
//:         |> test_report_push assert_eq_i32 "invalid remove recovers owner" 4 recovered_len
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn remove %impure fn AdjacencyMatrix impure fn i32 impure fn i32 Result AdjacencyMatrix AdjacencyMatrixUpdateError \g\from\to:
    adjacency_matrix_update g from to false
