//: # adjacency_matrix/api/bulk
//: `AdjacencyMatrix` 全体を更新する API
//:
//: ### [目的/もくてき]
//: - `clear` に共通する全 byte fill を 1 箇所に集約します。
//: - owner を受け取り、同じ owner を返す bulk update として observer / cleanup から分離します。

#indent 4

#import "core/field" as field
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../storage" as *

//: ## adjacency_matrix_fill_value
//: [内部/ないぶ] byte storage を[指定/してい] byte で[埋/う]める
pub fn adjacency_matrix_fill_value <(AdjacencyMatrix,i32)*>AdjacencyMatrix> (g, byte_value):
    let nbytes <i32> *field::get_ref &g "nbytes"
    let bits <&Vec<u8>> field::get_ref &g "bits"
    adjacency_matrix_fill_bytes bits nbytes byte_value
    g

//: ## clear
//: [全/すべ]ての edge を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let g <AdjacencyMatrix>:
//:         unwrap_ok<AdjacencyMatrix, Diag> new 4
//:         |> insert 0 1 |> uwok
//:         |> clear
//:     let ok <bool> unwrap_ok<bool, Diag> contains &g 0 1;
//:     free g
//:     if not ok 1 0
//: ```
pub fn clear <(AdjacencyMatrix)*>AdjacencyMatrix> (g):
    adjacency_matrix_fill_value g 0
