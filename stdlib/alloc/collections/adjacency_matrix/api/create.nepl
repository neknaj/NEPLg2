//: # adjacency_matrix/api/create
//: `AdjacencyMatrix` の構築 API
//:
//: ### [目的/もくてき]
//: - 頂点数から matrix byte 長を計算し、初期化済み typed byte storage を確保します。
//: - invalid length / allocation failure は `Diag` として返し、trap にしません。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "../types" as *
#import "../layout" as *
#import "../storage" as *
#import "./diagnostic" as *

//: ## new
//: [空/から]の[隣接行列/りんせつぎょうれつ]を[作/つく]る
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"adjacency_matrix_new\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"matrix len\" expected=\"5\" actual=\"5\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/adjacency_matrix" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let g %AdjacencyMatrix unwrap_ok new 5;
//:     let size %i32 len &g;
//:     free g
//:     let report:
//:         test_report_new "adjacency_matrix_new"
//:         |> test_report_push assert_eq_i32 "matrix len" 5 size
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn new %impure fn i32 Result AdjacencyMatrix Diag \nverts:
    if:
        le nverts 0
        then:
            diag_err<AdjacencyMatrix> adjacency_matrix_invalid_len_diag
        else:
            let nbytes %i32 adjacency_matrix_byte_len nverts
            match adjacency_matrix_alloc_bits nbytes 0:
                Result::Err d:
                    err d
                Result::Ok bits:
                    ok AdjacencyMatrix nverts nbytes bits
