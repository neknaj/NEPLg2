//: # bloom_filter/storage
//: `BloomFilter` の typed byte storage 操作
//:
//: ### [目的/もくてき]
//: - `Vec<u8>` の byte 読み書き、全 byte 初期化、allocation、cleanup を集約します。
//: - public API が raw pointer や raw byte load/store を扱わない構成を保ちます。

#indent 4

#import "core/cast" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

fn bloom_byte_at <(&Vec<u8>,i32)->Option<i32>> (bits, byte_idx):
    match vec::get<u8> bits byte_idx:
        Option::Some byte:
            let value <i32> cast byte
            some<i32> value
        Option::None:
            none<i32>

fn bloom_store_byte <(&Vec<u8>,i32,i32)*>()> (bits, byte_idx, byte_value):
    let byte <u8> cast byte_value
    vec::replace<u8> bits byte_idx byte

fn bloom_fill_bytes <(&Vec<u8>,i32,i32)*>()> (bits, nbytes, byte_value):
    let mut i <i32> 0
    while lt i nbytes:
        do:
            bloom_store_byte bits i byte_value
            set i add i 1

fn bloom_alloc_bits <(i32,i32)*>Result<Vec<u8>, Diag>> (nbytes, byte_value):
    let byte <u8> cast byte_value
    match vec::filled<u8> nbytes byte:
        Result::Ok bits:
            ok<Vec<u8>, Diag> bits
        Result::Err _e:
            diag_err<Vec<u8>> diag_out_of_memory

fn bloom_free_bits <(Vec<u8>)->()> (bits):
    vec::free<u8> bits
