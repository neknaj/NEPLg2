//: # bloom_filter/api
//: `BloomFilter` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `insert` / `contains` / `clear` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./hash" as *
#import "./layout" as *
#import "./storage" as *
#import "./mutation" as *

fn bloom_invalid_len_diag <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid bloom filter bit length"

//: ## new
//: [空/から]の Bloom Filter を[作/つく]る
//:
//: ### [計算量/けいさんりょう]
//: - bit [長/ちょう]を n とすると O(n/8) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let ok <bool> eq len &bf 64;
//:     free bf
//:     if ok 1 0
//: ```
fn new <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,i32)*>Result<BloomFilter<.T,.H>, Diag>> (hasher, nbits):
    if:
        le nbits 0
        then:
            diag_err<BloomFilter<.T,.H>> bloom_invalid_len_diag
        else:
            let nbytes <i32> bloom_byte_len nbits
            match bloom_alloc_bits nbytes 0:
                Result::Err d:
                    err<BloomFilter<.T,.H>, Diag> d
                Result::Ok bits:
                    ok<BloomFilter<.T,.H>, Diag> BloomFilter<.T,.H> nbits nbytes bits hasher

//: ## len
//: bit [長/ちょう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 32;
//:     let ok <bool> eq len &bf 32;
//:     free bf
//:     if ok 1 0
//: ```
fn len <.T,.H> <(&BloomFilter<.T,.H>)->i32> (bf):
    *field::get_ref bf "nbits"

//: ## insert
//: [要素/ようそ]を[登録/とうろく]する
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let bf1 <BloomFilter<i32, DefaultHash32>> insert<i32, DefaultHash32> bf0 7;
//:     let ok <bool> contains<i32, DefaultHash32> &bf1 7;
//:     free bf1
//:     if ok 1 0
//: ```
fn insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(BloomFilter<.T,.H>,.T)*>BloomFilter<.T,.H>> (bf, key):
    let nbits <i32> *field::get_ref &bf "nbits"
    let bits <&Vec<u8>> field::get_ref &bf "bits"
    let hasher <.H> *field::get_ref &bf "hasher"
    let h0 <i32> bloom_hash0<.T,.H> hasher key
    let h1 <i32> bloom_hash1<.T,.H> hasher key
    let i0 <i32> rem_u h0 nbits
    let i1 <i32> bloom_probe_index nbits h0 h1
    let i2 <i32> bloom_probe_index nbits i1 h1
    bloom_set_bit bits i0
    bloom_set_bit bits i1
    bloom_set_bit bits i2
    bf

//: ## contains
//: [要素/ようそ]が[登録済/とうろくず]みかを[近似/きんじ][判定/はんてい]する
//:
//: ### [注意/ちゅうい]
//: - true でも[実際/じっさい]には[入/はい]っていない false positive がありえます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let bf1 <BloomFilter<i32, DefaultHash32>> insert<i32, DefaultHash32> bf0 7;
//:     let bf2 <BloomFilter<i32, DefaultHash32>> insert<i32, DefaultHash32> bf1 12;
//:     let ok <bool> contains<i32, DefaultHash32> &bf2 7;
//:     free bf2
//:     if ok 1 0
//: ```
fn contains <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&BloomFilter<.T,.H>,.T)->bool> (bf, key):
    let nbits <i32> *field::get_ref bf "nbits"
    let bits <&Vec<u8>> field::get_ref bf "bits"
    let hasher <.H> *field::get_ref bf "hasher"
    let h0 <i32> bloom_hash0<.T,.H> hasher key
    let h1 <i32> bloom_hash1<.T,.H> hasher key
    let i0 <i32> rem_u h0 nbits
    let i1 <i32> bloom_probe_index nbits h0 h1
    let i2 <i32> bloom_probe_index nbits i1 h1
    let ok0 <bool> bloom_test_bit bits i0
    let ok1 <bool> bloom_test_bit bits i1
    let ok2 <bool> bloom_test_bit bits i2
    and ok0 and ok1 ok2

//: ## clear
//: [全/すべ]ての bit を 0 に[戻/もど]す
//:
//: ### [計算量/けいさんりょう]
//: - byte [長/ちょう]を m として O(m)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let bf1 <BloomFilter<i32, DefaultHash32>> insert<i32, DefaultHash32> bf0 7;
//:     let bf2 <BloomFilter<i32, DefaultHash32>> clear<i32, DefaultHash32> bf1;
//:     let ok <bool> contains<i32, DefaultHash32> &bf2 7;
//:     free bf2
//:     if ok 0 1
//: ```
fn clear <.T,.H> <(BloomFilter<.T,.H>)*>BloomFilter<.T,.H>> (bf):
    let nbytes <i32> *field::get_ref &bf "nbytes"
    let bits <&Vec<u8>> field::get_ref &bf "bits"
    bloom_fill_bytes bits nbytes 0
    bf

//: ## free
//: bitset [領域/りょういき]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `BloomFilter` は `new` が[確保/かくほ]した `nbytes > 0` の `Vec<u8>` bit array を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、`Vec<u8>` owner を[閉/と]じます。
//: - caller は `free` [後/ご]の `BloomFilter` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf <BloomFilter<i32, DefaultHash32>> unwrap_ok<BloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     free bf;
//:     0
//: ```
fn free <.T,.H> <(BloomFilter<.T,.H>)->()> (bf):
    let bits <Vec<u8>> field::get bf "bits"
    bloom_free_bits bits
