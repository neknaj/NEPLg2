//: # binary_heap/api/pop
//: `BinaryHeap` の pop API
//:
//: ### [目的/もくてき]
//: - root removal、last slot relocation、sift-down を伴う owner-consuming pop を所有します。
//: - `pop_max` は更新後 heap owner と値を同時に返し、`pop` は更新後 heap を cleanup して値だけ返します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../storage" as *
#import "../order" as *
#import "./cleanup" as *

//: ## pop_max
//: [最大/さいだい][要素/ようそ]を[取/と]り[出/だ]し、[更新後/こうしんご]の heap と[値/あたい]を[返/かえ]す
pub fn pop_max <.T: Ord&Copy> %impure fn BinaryHeap .T BinaryHeapPop .T \hp:
    let len0 %i32 *field::get_ref &hp "len"
    let cap0 %i32 *field::get_ref &hp "cap"
    let items %Vec Option .T field::get hp "items"
    if:
        eq len0 0
        then:
            let next_hp %BinaryHeap .T BinaryHeap<.T> 0 cap0 items
            BinaryHeapPop<.T> next_hp none
        else:
            let root %Option .T heap_item_at<.T> &items 0
            if:
                eq len0 1
                then:
                    heap_store_slot<.T> &items 0 none
                    let next_hp %BinaryHeap .T BinaryHeap<.T> 0 cap0 items
                    BinaryHeapPop<.T> next_hp root
                else:
                    let last_idx %i32 sub len0 1
                    let last %Option .T heap_item_at<.T> &items last_idx
                    heap_store_slot<.T> &items last_idx none
                    match last:
                        Option::Some value:
                            heap_store_slot<.T> &items 0 some value
                        Option::None:
                            heap_store_slot<.T> &items 0 none
                    heap_sift_down<.T> &items last_idx 0
                    let next_hp %BinaryHeap .T BinaryHeap<.T> last_idx cap0 items
                    BinaryHeapPop<.T> next_hp root

//: ## binary_heap_pop_item
//: `BinaryHeapPop` を[借用/しゃくよう]し、[取/と]り[出/だ]した[値/あたい]を[読/よ]む
//:
//: ### [目的/もくてき]
//: - `pop_max` の[結果/けっか]から `item` を[取得/しゅとく]します。
//: - `BinaryHeapPop` は[更新後/こうしんご]の heap owner を[含/ふく]むため、利用側が struct field を直接 projection せず、この API を[通/とお]して[読/よ]みます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
pub fn binary_heap_pop_item <.T: Copy> %fn &BinaryHeapPop .T Option .T \p:
    *field::get_ref p "item"

//: ## binary_heap_pop_heap
//: `BinaryHeapPop` を[消費/しょうひ]し、[更新後/こうしんご]の heap owner を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - `pop_max` の[結果/けっか]から、[次/つぎ]に[使/つか]う `BinaryHeap` owner を[移動/いどう]します。
//: - owner を[含/ふく]む field projection は binary heap 実装境界の責務に[閉/と]じ、caller はこの関数で owner flow を[継続/けいぞく]します。
//:
//: ### [注意/ちゅうい]
//: - `BinaryHeapPop` には[取/と]り[出/だ]した `Option .T` も[含/ふく]まれます。この accessor はその item を[返/かえ]さないため、現行の drop traversal 未実装段階では `.T: Copy` に[限定/げんてい]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
pub fn binary_heap_pop_heap <.T: Copy> %fn BinaryHeapPop .T BinaryHeap .T \p:
    field::get p "heap"

//: ## pop
//: heap を[消費/しょうひ]して[最大/さいだい][要素/ようそ]だけを[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/option" as *
//: fn main %impure fn unit i32 \unit:
//:     let hp0 %BinaryHeap i32 unwrap_ok new;
//:     let hp1 %BinaryHeap i32 unwrap_ok push hp0 4;
//:     let hp2 %BinaryHeap i32 unwrap_ok push hp1 9;
//:     let hp3 %BinaryHeap i32 unwrap_ok push hp2 1;
//:     match pop hp3:
//:         Option::Some v:
//:             if eq v 9 1 0
//:         Option::None:
//:             0
//: ```
pub fn pop <.T: Ord&Copy> %impure fn BinaryHeap .T Option .T \hp:
    let p %BinaryHeapPop .T pop_max<.T> hp
    let item %Option .T binary_heap_pop_item<.T> &p
    free<.T> binary_heap_pop_heap<.T> p
    item
