//: # binary_heap/api/create
//: `BinaryHeap` の構築 API
//:
//: ### [目的/もくてき]
//: - 初期 capacity を正規化し、`Vec<Option<T>>` の空 slot storage を確保します。
//: - allocation failure は `Diag` として返し、trap にしません。

#indent 4

#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "../types" as *
#import "../storage" as *

//: ## new
//: [空/から]の heap を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hp <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> new<i32>;
//:     let ok <bool> eq len<i32> &hp 0
//:     free<i32> hp
//:     if ok 1 0
//: ```
pub fn new <.T: Copy> <()*>Result<BinaryHeap<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して heap を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hp0 <BinaryHeap<i32>> unwrap_ok<BinaryHeap<i32>, Diag> with_capacity<i32> 16;
//:     let ok0 <bool> eq len<i32> &hp0 0;
//:     let ok1 <bool> eq cap<i32> &hp0 16;
//:     free<i32> hp0;
//:     if and ok0 ok1 1 0
//: ```
pub fn with_capacity <.T: Copy> <(i32)*>Result<BinaryHeap<.T>, Diag>> (cap):
    let cap0 <i32> heap_normalize_capacity cap
    match heap_alloc_slots<.T> cap0:
        Result::Ok items:
            ok<BinaryHeap<.T>, Diag> BinaryHeap<.T> 0 cap0 items
        Result::Err e:
            err<BinaryHeap<.T>, Diag> e
