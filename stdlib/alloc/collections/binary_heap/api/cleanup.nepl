//: # binary_heap/api/cleanup
//: `BinaryHeap` owner の cleanup API
//:
//: ### [目的/もくてき]
//: - heap owner から backing slot storage owner を取り出し、`Vec<Option<T>>` として閉じます。
//: - cleanup を observer / push / pop から分離し、free obligation の境界を明確にします。

#indent 4

#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "core/field" as *

//: ## free
//: heap が[所有/しょゆう]する Copy-only backing storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/binary_heap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let hp %BinaryHeap i32 unwrap_ok new<i32>;
//:     free hp;
//:     0
//: ```
pub fn free <.T: Copy> %fn BinaryHeap .T unit \hp:
    vec::free field::get hp "items"
