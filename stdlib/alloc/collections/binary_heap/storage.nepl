//: # binary_heap/storage
//: `BinaryHeap` の slot storage 操作
//:
//: ### [目的/もくてき]
//: - capacity 正規化、`Vec<Option<T>>` slot 読み書き、確保、live slot copy を所有します。
//: - heap ordering と public API が slot 表現の詳細を重複して持たないようにします。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "core/field" as *

pub fn heap_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

pub fn heap_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

pub fn heap_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace<Option<.T>> items idx item

pub fn heap_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

pub fn heap_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32)*>()> (src, dst, len0):
    let mut i <i32> 0
    while lt i len0:
        do:
            match heap_item_at<.T> src i:
                Option::Some item:
                    heap_store_slot<.T> dst i some<.T> item
                Option::None:
                    heap_store_slot<.T> dst i none<.T>
            set i add i 1
