#indent 4

//: # counting_bloom_filter
//: [削除可能/さくじょかのう]な[近似/きんじ] membership test を[提供/ていきょう]する Counting Bloom Filter
//:
//: ### [目的/もくてき]
//: - `CountingBloomFilter<.T, .H>` を[提供/ていきょう]し、`new` / `len` / `insert` / `remove` / `contains` / `clear` / `free` の bare API で[削除可能/さくじょかのう]な[近似/きんじ][集合/しゅうごう][判定/はんてい]を[扱/あつか]えるようにします。
//: - `len` / `contains` は `&CountingBloomFilter` を[受/う]け[取/と]り、counter array owner を[移動/いどう]せずに[観察/かんさつ]します。
//: - `BloomFilter` と[同/おな]じ hasher [設計/せっけい]を[保/たも]ちながら、[重複/ちょうふく][挿入/そうにゅう]を[数/かぞ]える counter [配列/はいれつ]で delete [操作/そうさ]を[支/ささ]えます。
//:
//: ### [実装/じっそう]
//: - [内部/ないぶ]は `Vec<u8>` counter [配列/はいれつ]と hasher [値/あたい]を[保持/ほじ]します。
//: - [各要素/かくようそ]に[対/たい]して 3 [本/ぼん]の probe index を[生成/せいせい]し、insert では[対応/たいおう] counter を[飽和/ほうわ] 255 まで[加算/かさん]し、remove では 0 まで[減算/げんざん]します。
//: - `contains` は 3 [本/ぼん]すべての counter が 1 [以上/いじょう]なら true を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - false negative は insert/remove の[対応/たいおう]が[崩/くず]れなければ[起/お]きませんが、false positive は[起/お]こりえます。
//: - counter は `u8` なので、[同/おな]じ probe が 255 [回/かい]を[超/こ]えると[飽和/ほうわ]します。
//: - `new` は counter [長/ちょう]が 1 [未満/みまん]なら `Result::Err Diag` を[返/かえ]します。
//: - [読/よ]み[取/と]りだけの[処理/しょり]では `len &bf` / `contains &bf key` のように borrow して、[最後/さいご]に `free bf` で owner を[閉/と]じます。
//:
//: ### [計算量/けいさんりょう]
//: - `len` は O(1) です。
//: - `insert` / `remove` / `contains` は probe [本数/ほんすう]を k=3 として O(1) です。
//: - `clear` は counter [配列/はいれつ][長/ちょう]を m byte として O(m) です。

#import "core/cast" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## CountingBloomFilter
//: counter [配列/はいれつ]と hasher を[保持/ほじ]する[所有者/しょゆうしゃ]
//:
//: ### [目的/もくてき]
//: - counter [長/ちょう]・typed counter owner・hasher を 1 [値/あたい]として[受/う]け[渡/わた]しできるようにします。
//:
//: ### [注意/ちゅうい]
//: - counter [領域/りょういき]の[所有権/しょゆうけん]を[持/も]つので、[不要/ふよう]になったら `free` します。
//: - key 型 `.T` と hasher 型 `.H` は、複数 probe の[計算/けいさん]で[繰/く]り[返/かえ]し[読/よ]むため標準 `Copy` を impl する[必要/ひつよう]があります。
struct CountingBloomFilter<.T,.H>:
    nslots <i32>
    counters <Vec<u8>>
    hasher <.H>

fn counting_bloom_invalid_len_diag <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid counting bloom filter counter length"

fn counting_bloom_hash0 <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,.T)->i32> (hasher, key):
    hash_with hasher key

fn counting_bloom_hash1 <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,.T)->i32> (hasher, key):
    let h0 <i32> counting_bloom_hash0<.T,.H> hasher key
    let hk <i32> hashkey_hash32 key
    let mixed <i32> mix xor h0 hk
    if eq mixed 0 1 mixed

fn counting_bloom_probe_index <(i32,i32,i32)->i32> (nslots, h0, h1):
    rem_u add h0 h1 nslots

fn counting_bloom_counter_at <(&Vec<u8>,i32)->Option<i32>> (counters, idx):
    match vec::get<u8> counters idx:
        Option::Some counter:
            let value <i32> cast counter
            some<i32> value
        Option::None:
            none<i32>

fn counting_bloom_store_counter <(&Vec<u8>,i32,i32)*>()> (counters, idx, value):
    let counter <u8> cast value
    vec::replace<u8> counters idx counter

fn counting_bloom_counter_inc <(&Vec<u8>,i32)*>()> (counters, idx):
    match counting_bloom_counter_at counters idx:
        Option::Some cur:
            if:
                lt cur 255
                then:
                    counting_bloom_store_counter counters idx add cur 1
                else:
                    ()
        Option::None:
            ()

fn counting_bloom_counter_dec <(&Vec<u8>,i32)*>()> (counters, idx):
    match counting_bloom_counter_at counters idx:
        Option::Some cur:
            if:
                lt 0 cur
                then:
                    counting_bloom_store_counter counters idx sub cur 1
                else:
                    ()
        Option::None:
            ()

fn counting_bloom_counter_nonzero <(&Vec<u8>,i32)->bool> (counters, idx):
    match counting_bloom_counter_at counters idx:
        Option::Some cur:
            lt 0 cur
        Option::None:
            false

fn counting_bloom_fill_counters <(&Vec<u8>,i32,i32)*>()> (counters, nslots, value):
    let mut i <i32> 0
    while lt i nslots:
        do:
            counting_bloom_store_counter counters i value
            set i add i 1

fn counting_bloom_alloc_counters <(i32,i32)*>Result<Vec<u8>, Diag>> (nslots, value):
    let counter <u8> cast value
    match vec::filled<u8> nslots counter:
        Result::Ok counters:
            ok<Vec<u8>, Diag> counters
        Result::Err _e:
            diag_err<Vec<u8>> diag_out_of_memory

//: ## new
//: [空/から]の Counting Bloom Filter を[作/つく]る
//:
//: ### [計算量/けいさんりょう]
//: - counter [長/ちょう]を n とすると O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf <CountingBloomFilter<i32, DefaultHash32>> unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let ok <bool> eq len &bf 64;
//:     free bf
//:     if ok 1 0
//: ```
fn new <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,i32)*>Result<CountingBloomFilter<.T,.H>, Diag>> (hasher, nslots):
    if:
        le nslots 0
        then diag_err<CountingBloomFilter<.T,.H>> counting_bloom_invalid_len_diag
        else:
            match counting_bloom_alloc_counters nslots 0:
                Result::Err d:
                    err<CountingBloomFilter<.T,.H>, Diag> d
                Result::Ok counters:
                    ok<CountingBloomFilter<.T,.H>, Diag> CountingBloomFilter<.T,.H> nslots counters hasher

//: ## len
//: counter [長/ちょう]を[返/かえ]す
fn len <.T,.H> <(&CountingBloomFilter<.T,.H>)->i32> (bf):
    *field::get_ref bf "nslots"

//: ## insert
//: [要素/ようそ]の probe counter を[加算/かさん]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <CountingBloomFilter<i32, DefaultHash32>> unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     let bf1 <CountingBloomFilter<i32, DefaultHash32>> insert bf0 7;
//:     let ok <bool> contains &bf1 7;
//:     free bf1
//:     if ok 1 0
//: ```
fn insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(CountingBloomFilter<.T,.H>,.T)*>CountingBloomFilter<.T,.H>> (bf, key):
    let nslots <i32> *field::get_ref &bf "nslots"
    let counters <&Vec<u8>> field::get_ref &bf "counters"
    let hasher <.H> *field::get_ref &bf "hasher"
    let h0 <i32> counting_bloom_hash0<.T,.H> hasher key
    let h1 <i32> counting_bloom_hash1<.T,.H> hasher key
    let i0 <i32> rem_u h0 nslots
    let i1 <i32> counting_bloom_probe_index nslots h0 h1
    let i2 <i32> counting_bloom_probe_index nslots i1 h1
    counting_bloom_counter_inc counters i0
    counting_bloom_counter_inc counters i1
    counting_bloom_counter_inc counters i2
    bf

//: ## remove
//: [要素/ようそ]の probe counter を 0 [未満/みまん]にしないよう[減算/げんざん]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <CountingBloomFilter<i32, DefaultHash32>>:
//:         unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64
//:         |> insert 7
//:         |> remove 7
//:     let ok <bool> contains &bf0 7;
//:     free bf0
//:     if ok 0 1
//: ```
fn remove <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(CountingBloomFilter<.T,.H>,.T)*>CountingBloomFilter<.T,.H>> (bf, key):
    let nslots <i32> *field::get_ref &bf "nslots"
    let counters <&Vec<u8>> field::get_ref &bf "counters"
    let hasher <.H> *field::get_ref &bf "hasher"
    let h0 <i32> counting_bloom_hash0<.T,.H> hasher key
    let h1 <i32> counting_bloom_hash1<.T,.H> hasher key
    let i0 <i32> rem_u h0 nslots
    let i1 <i32> counting_bloom_probe_index nslots h0 h1
    let i2 <i32> counting_bloom_probe_index nslots i1 h1
    counting_bloom_counter_dec counters i0
    counting_bloom_counter_dec counters i1
    counting_bloom_counter_dec counters i2
    bf

//: ## contains
//: [要素/ようそ]が[登録済/とうろくず]みかを[近似/きんじ][判定/はんてい]する
//:
//: ### [注意/ちゅうい]
//: - true でも[実際/じっさい]には[入/はい]っていない false positive がありえます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <CountingBloomFilter<i32, DefaultHash32>>:
//:         unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64
//:         |> insert 7
//:         |> insert 12
//:     let ok <bool> contains &bf0 12;
//:     free bf0
//:     if ok 1 0
//: ```
fn contains <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&CountingBloomFilter<.T,.H>,.T)->bool> (bf, key):
    let nslots <i32> *field::get_ref bf "nslots"
    let counters <&Vec<u8>> field::get_ref bf "counters"
    let hasher <.H> *field::get_ref bf "hasher"
    let h0 <i32> counting_bloom_hash0<.T,.H> hasher key
    let h1 <i32> counting_bloom_hash1<.T,.H> hasher key
    let i0 <i32> rem_u h0 nslots
    let i1 <i32> counting_bloom_probe_index nslots h0 h1
    let i2 <i32> counting_bloom_probe_index nslots i1 h1
    let ok0 <bool> counting_bloom_counter_nonzero counters i0
    let ok1 <bool> counting_bloom_counter_nonzero counters i1
    let ok2 <bool> counting_bloom_counter_nonzero counters i2
    and ok0 and ok1 ok2

//: ## clear
//: [全/すべ]ての counter を 0 に[戻/もど]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf0 <CountingBloomFilter<i32, DefaultHash32>>:
//:         unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64
//:         |> insert 7
//:         |> clear
//:     let ok <bool> contains &bf0 7;
//:     free bf0
//:     if ok 0 1
//: ```
fn clear <.T,.H> <(CountingBloomFilter<.T,.H>)*>CountingBloomFilter<.T,.H>> (bf):
    let nslots <i32> *field::get_ref &bf "nslots"
    let counters <&Vec<u8>> field::get_ref &bf "counters"
    counting_bloom_fill_counters counters nslots 0
    bf

//: ## free
//: counter [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `CountingBloomFilter` は `new` が[確保/かくほ]した counter `Vec<u8>` を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、counter `Vec<u8>` owner を[閉/と]じます。
//: - caller は `free` [後/ご]の `CountingBloomFilter` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "core/traits/hash" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let bf <CountingBloomFilter<i32, DefaultHash32>> unwrap_ok<CountingBloomFilter<i32, DefaultHash32>, Diag> new DefaultHash32 64;
//:     free bf;
//:     0
//: ```
fn free <.T,.H> <(CountingBloomFilter<.T,.H>)->()> (bf):
    let counters <Vec<u8>> field::get bf "counters"
    vec::free<u8> counters
