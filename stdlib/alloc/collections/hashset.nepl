//: # hashset
//: key trait と hasher [型/がた]に[基/もと]づく generic [集合/しゅうごう]
//:
//: ### [目的/もくてき]
//: - `HashSet<.T, .H>` を[提供/ていきょう]し、`new` / `insert` / `contains` / `remove` / `len` / `free` の bare 名で[操作/そうさ]できるようにします。
//: - key [比較/ひかく]は `HashKey` trait に、hash [計算/けいさん]は hasher value へ[対/たい]する `hash32` overload に[委譲/いじょう]します。
//:
//: ### [実装/じっそう]
//: - open addressing + linear probing を[用/もち]いる hash table です。
//: - bucket [状態/じょうたい]は `HashSetBucketState` enum で[管理/かんり]し、numeric sentinel ではなく `match` の[網羅性/もうらせい]を[使/つか]います。
//: - key storage は `Vec<Option<.T>>` とし、全 slot を `None` で初期化します。
//: - `Full` 状態の slot では key が `Some` であることを HashSet の内部不変条件とします。
//:
//: ### [注意/ちゅうい]
//: - key 型 `.T` は `HashKey` と標準 `Copy` の impl を[持/も]つ[必要/ひつよう]があります。
//: - hasher 型 `.H` は `Hasher<.T>` と標準 `Copy` を impl する[必要/ひつよう]があります。
//:
//: ### [計算量/けいさんりょう]
//: - [平均/へいきん] `insert` / `contains` / `remove` は O(1)、[最悪/さいあく]は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## HashSetBucketState
//: hash table の 1 bucket の[状態/じょうたい]
//:
//: ### [目的/もくてき]
//: - empty / full / tombstone を enum として[表/あらわ]し、`match` で[分岐/ぶんき]します。
enum HashSetBucketState:
    Empty
    Full
    Tombstone

impl Clone for HashSetBucketState:
    fn clone <(&HashSetBucketState)->HashSetBucketState> (state):
        *state

impl Copy for HashSetBucketState:
    fn copy_mark <(HashSetBucketState)->HashSetBucketState> (state):
        state

//: ## HashSetInsertSlotState
//: insertion 先 slot が empty 由来か tombstone 由来かを[表/あらわ]す
enum HashSetInsertSlotState:
    EmptySlot
    TombstoneSlot

impl Clone for HashSetInsertSlotState:
    fn clone <(&HashSetInsertSlotState)->HashSetInsertSlotState> (state):
        *state

impl Copy for HashSetInsertSlotState:
    fn copy_mark <(HashSetInsertSlotState)->HashSetInsertSlotState> (state):
        state

//: ## HashSetInsertSlot
//: insertion 先の index と[状態/じょうたい]
struct HashSetInsertSlot:
    index <i32>
    state <HashSetInsertSlotState>

//: ## HashSetStorage
//: HashSet の backing storage
//:
//: ### [注意/ちゅうい]
//: - `states.len == keys.len == cap` を内部不変条件とします。
struct HashSetStorage<.T>:
    states <Vec<HashSetBucketState>>
    keys <Vec<Option<.T>>>

//: ## HashSet
//: hash set [本体/ほんたい]
struct HashSet<.T,.H>:
    count <i32>
    cap <i32>
    tombstones <i32>
    storage <HashSetStorage<.T>>
    hasher <.H>

//: hashset_storage_states: storage の state Vec を borrow する
fn hashset_storage_states <.T> <(&HashSetStorage<.T>)->&Vec<HashSetBucketState>> (storage):
    field::get_ref storage "states"

//: hashset_storage_keys: storage の key Vec を borrow する
fn hashset_storage_keys <.T> <(&HashSetStorage<.T>)->&Vec<Option<.T>>> (storage):
    field::get_ref storage "keys"

//: hashset_bucket_index: hash から bucket index を[計算/けいさん]する
fn hashset_bucket_index <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(i32,.H,.T)->i32> (cap, hasher, key):
    rem_u hash_with<.T,.H> hasher key cap

//: hashset_next_slot: linear probing の[次/つぎ]の index を[返/かえ]す
fn hashset_next_slot <(i32,i32)->i32> (idx, cap):
    rem_u add idx 1 cap

//: hashset_normalize_capacity: hash set の[実容量/じつようりょう]を[下限/かげん]つきで[決/き]める
fn hashset_normalize_capacity <(i32)->i32> (requested):
    if lt requested 4 4 requested

//: hashset_load_limit: grow / rehash の[閾値/しきいち]を[計算/けいさん]する
fn hashset_load_limit <(i32)->i32> (cap):
    div_u mul cap 3 4

//: hashset_state_at: bucket state を[読/よ]み[出/だ]す
fn hashset_state_at <(&Vec<HashSetBucketState>,i32)->HashSetBucketState> (states, idx):
    match vec::get_ref<HashSetBucketState> states idx:
        Option::Some state:
            state
        Option::None:
            HashSetBucketState::Empty

//: hashset_key_at: key slot を Option として[読/よ]む
fn hashset_key_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (keys, idx):
    match vec::get_ref<Option<.T>> keys idx:
        Option::Some key_opt:
            key_opt
        Option::None:
            none<.T>

//: hashset_store_state: state slot を[書/か]き[換/か]える
fn hashset_store_state <(&Vec<HashSetBucketState>,i32,HashSetBucketState)*>()> (states, idx, state):
    vec::replace_ref<HashSetBucketState> states idx state

//: hashset_store_key: key slot を[書/か]き[換/か]える
fn hashset_store_key <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (keys, idx, key):
    vec::replace_ref<Option<.T>> keys idx key

//: hashset_store_full: slot を Full にして key を[格納/かくのう]する
fn hashset_store_full <.T: Copy> <(&HashSetStorage<.T>,i32,.T)*>()> (storage, idx, key):
    hashset_store_key<.T> hashset_storage_keys<.T> storage idx some<.T> key
    hashset_store_state hashset_storage_states<.T> storage idx HashSetBucketState::Full

//: hashset_store_tombstone: slot を tombstone にして payload を None に[戻/もど]す
fn hashset_store_tombstone <.T: Copy> <(&HashSetStorage<.T>,i32)*>()> (storage, idx):
    hashset_store_key<.T> hashset_storage_keys<.T> storage idx none<.T>
    hashset_store_state hashset_storage_states<.T> storage idx HashSetBucketState::Tombstone

//: hashset_free_storage: backing storage を[解放/かいほう]する
fn hashset_free_storage <.T: Copy> <(HashSetStorage<.T>)->()> (storage):
    let states <Vec<HashSetBucketState>> field::get storage "states"
    let keys <Vec<Option<.T>>> field::get storage "keys"
    vec::free<HashSetBucketState> states
    vec::free<Option<.T>> keys

//: hashset_alloc_storage: empty storage を[作/つく]る
fn hashset_alloc_storage <.T: Copy> <(i32)*>Result<HashSetStorage<.T>, Diag>> (cap):
    match vec::filled<HashSetBucketState> cap HashSetBucketState::Empty:
        Result::Err _e:
            diag_err<HashSetStorage<.T>> diag_out_of_memory "hashset_alloc_storage(states)"
        Result::Ok states:
            match vec::filled<Option<.T>> cap none<.T>:
                Result::Err _e:
                    vec::free<HashSetBucketState> states
                    diag_err<HashSetStorage<.T>> diag_out_of_memory "hashset_alloc_storage(keys)"
                Result::Ok keys:
                    ok<HashSetStorage<.T>, Diag> HashSetStorage<.T> states keys

//: hashset_find_present: key が[存在/そんざい]する slot を[探/さが]す
fn hashset_find_present <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&HashSetStorage<.T>,i32,.H,.T)->i32> (storage, cap, hasher, key):
    let states <&Vec<HashSetBucketState>> hashset_storage_states<.T> storage
    let keys <&Vec<Option<.T>>> hashset_storage_keys<.T> storage
    let start <i32> hashset_bucket_index<.T,.H> cap hasher key
    let mut cur <i32> start
    let mut found <i32> -1
    let mut done <bool> false
    while not done:
        do:
            match hashset_state_at states cur:
                HashSetBucketState::Empty:
                    set done true
                HashSetBucketState::Tombstone:
                    set cur hashset_next_slot cur cap
                HashSetBucketState::Full:
                    match hashset_key_at<.T> keys cur:
                        Option::None:
                            set cur hashset_next_slot cur cap
                        Option::Some existing:
                            if:
                                hashkey_eq<.T> existing key
                                then:
                                    set found cur
                                    set done true
                                else:
                                    set cur hashset_next_slot cur cap
    found

//: hashset_find_insert_slot: 新規 key の[挿入/そうにゅう]先 slot を[探/さが]す
fn hashset_find_insert_slot <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&HashSetStorage<.T>,i32,.H,.T)->HashSetInsertSlot> (storage, cap, hasher, key):
    let states <&Vec<HashSetBucketState>> hashset_storage_states<.T> storage
    let start <i32> hashset_bucket_index<.T,.H> cap hasher key
    let mut cur <i32> start
    let mut first_tomb <i32> -1
    let mut result_idx <i32> -1
    let mut result_state <HashSetInsertSlotState> HashSetInsertSlotState::EmptySlot
    while lt result_idx 0:
        do:
            match hashset_state_at states cur:
                HashSetBucketState::Empty:
                    if:
                        lt first_tomb 0
                        then:
                            set result_idx cur
                            set result_state HashSetInsertSlotState::EmptySlot
                        else:
                            set result_idx first_tomb
                            set result_state HashSetInsertSlotState::TombstoneSlot
                HashSetBucketState::Tombstone:
                    if:
                        lt first_tomb 0
                        then set first_tomb cur
                        else ()
                    set cur hashset_next_slot cur cap
                HashSetBucketState::Full:
                    set cur hashset_next_slot cur cap
    HashSetInsertSlot result_idx result_state

//: hashset_insert_entry_into_storage: rehash [中/ちゅう]の新 table へ key を[移/うつ]す
fn hashset_insert_entry_into_storage <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&HashSetStorage<.T>,i32,.H,.T)*>()> (storage, cap, hasher, key):
    let slot <HashSetInsertSlot> hashset_find_insert_slot<.T,.H> storage cap hasher key
    let idx <i32> field::get slot "index"
    hashset_store_full<.T> storage idx key

//: hashset_rehash_to: live key だけを新しい storage へ[再配置/さいはいち]する
fn hashset_rehash_to <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,i32)*>Result<HashSet<.T,.H>, Diag>> (hs, requested_cap):
    let count0 <i32> *field::get_ref &hs "count"
    let old_cap <i32> *field::get_ref &hs "cap"
    let hasher <.H> *field::get_ref &hs "hasher"
    let old_storage <HashSetStorage<.T>> field::get hs "storage"
    let new_cap <i32> hashset_normalize_capacity requested_cap
    match hashset_alloc_storage<.T> new_cap:
        Result::Err d:
            hashset_free_storage<.T> old_storage
            err<HashSet<.T,.H>, Diag> d
        Result::Ok new_storage:
            let states <&Vec<HashSetBucketState>> hashset_storage_states<.T> &old_storage
            let keys <&Vec<Option<.T>>> hashset_storage_keys<.T> &old_storage
            let mut i <i32> 0
            while lt i old_cap:
                do:
                    match hashset_state_at states i:
                        HashSetBucketState::Full:
                            match hashset_key_at<.T> keys i:
                                Option::None:
                                    ()
                                Option::Some key:
                                    hashset_insert_entry_into_storage<.T,.H> &new_storage new_cap hasher key
                        HashSetBucketState::Empty:
                            ()
                        HashSetBucketState::Tombstone:
                            ()
                    set i add i 1
            hashset_free_storage<.T> old_storage
            ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> count0 new_cap 0 new_storage hasher

//: hashset_prepare_insert: key [追加/ついか]前に必要な grow / rehash を[行/おこな]う
fn hashset_prepare_insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,.T)*>Result<HashSet<.T,.H>, Diag>> (hs, key):
    let count0 <i32> *field::get_ref &hs "count"
    let cap0 <i32> *field::get_ref &hs "cap"
    let tombstones0 <i32> *field::get_ref &hs "tombstones"
    let hasher <.H> *field::get_ref &hs "hasher"
    let storage <&HashSetStorage<.T>> field::get_ref &hs "storage"
    let idx <i32> hashset_find_present<.T,.H> storage cap0 hasher key
    if:
        not lt idx 0
        then:
            ok<HashSet<.T,.H>, Diag> hs
        else:
            let limit <i32> hashset_load_limit cap0
            let occupied_after_insert <i32> add add count0 tombstones0 1
            if:
                gt occupied_after_insert limit
                then:
                    let count_after_insert <i32> add count0 1
                    let target_cap <i32> if gt count_after_insert limit then mul cap0 2 else cap0
                    hashset_rehash_to<.T,.H> hs target_cap
                else:
                    ok<HashSet<.T,.H>, Diag> hs

//: hashset_new_with_capacity: `new` と `with_capacity` が[共有/きょうゆう]する constructor
fn hashset_new_with_capacity <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,i32)*>Result<HashSet<.T,.H>, Diag>> (hasher, requested):
    let cap0 <i32> hashset_normalize_capacity requested
    match hashset_alloc_storage<.T> cap0:
        Result::Err d:
            err<HashSet<.T,.H>, Diag> d
        Result::Ok storage:
            ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> 0 cap0 0 storage hasher

//: ## new
//: [空/から]の `HashSet<.T, .H>` を[作/つく]る
fn new <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H)*>Result<HashSet<.T,.H>, Diag>> (hasher):
    hashset_new_with_capacity<.T,.H> hasher 16

//: ## with_capacity
//: [指定/してい]した[初期容量/しょきようりょう]で `HashSet<.T, .H>` を[作/つく]る
fn with_capacity <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,i32)*>Result<HashSet<.T,.H>, Diag>> (hasher, requested):
    hashset_new_with_capacity<.T,.H> hasher requested

//: ## insert
//: [要素/ようそ]を[追加/ついか]する
fn insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,.T)*>Result<HashSet<.T,.H>, Diag>> (hs, key):
    match hashset_prepare_insert<.T,.H> hs key:
        Result::Err d:
            err<HashSet<.T,.H>, Diag> d
        Result::Ok ready:
            let count0 <i32> *field::get_ref &ready "count"
            let cap0 <i32> *field::get_ref &ready "cap"
            let tombstones0 <i32> *field::get_ref &ready "tombstones"
            let hasher <.H> *field::get_ref &ready "hasher"
            let storage <HashSetStorage<.T>> field::get ready "storage"
            let existing <i32> hashset_find_present<.T,.H> &storage cap0 hasher key
            if:
                not lt existing 0
                then:
                    ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> count0 cap0 tombstones0 storage hasher
                else:
                    let slot <HashSetInsertSlot> hashset_find_insert_slot<.T,.H> &storage cap0 hasher key
                    let slot_idx <i32> field::get slot "index"
                    let slot_state <HashSetInsertSlotState> field::get slot "state"
                    hashset_store_full<.T> &storage slot_idx key
                    let next_tombstones <i32>:
                        match slot_state:
                            HashSetInsertSlotState::EmptySlot:
                                tombstones0
                            HashSetInsertSlotState::TombstoneSlot:
                                sub tombstones0 1
                    ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> add count0 1 cap0 next_tombstones storage hasher

//: ## contains
//: [要素/ようそ]の[存在/そんざい]を[確/たし]かめる
fn contains <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(&HashSet<.T,.H>,.T)->bool> (hs, key):
    let cap0 <i32> *field::get_ref hs "cap"
    let hasher <.H> *field::get_ref hs "hasher"
    let storage <&HashSetStorage<.T>> field::get_ref hs "storage"
    not lt hashset_find_present<.T,.H> storage cap0 hasher key 0

//: ## remove
//: [要素/ようそ]を[削除/さくじょ]する
fn remove <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>,.T)*>Result<HashSet<.T,.H>, Diag>> (hs, key):
    let count0 <i32> *field::get_ref &hs "count"
    let cap0 <i32> *field::get_ref &hs "cap"
    let tombstones0 <i32> *field::get_ref &hs "tombstones"
    let hasher <.H> *field::get_ref &hs "hasher"
    let storage <HashSetStorage<.T>> field::get hs "storage"
    let idx <i32> hashset_find_present<.T,.H> &storage cap0 hasher key
    if:
        lt idx 0
        then:
            hashset_free_storage<.T> storage
            diag_err<HashSet<.T,.H>> diag_key_not_found "hashset_remove"
        else:
            hashset_store_tombstone<.T> &storage idx
            ok<HashSet<.T,.H>, Diag> HashSet<.T,.H> sub count0 1 cap0 add tombstones0 1 storage hasher

//: ## len
//: [要素数/ようそすう]を[返/かえ]す
fn len <.T,.H> <(&HashSet<.T,.H>)->i32> (hs):
    *field::get_ref hs "count"

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
fn free <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(HashSet<.T,.H>)->()> (hs):
    let storage <HashSetStorage<.T>> field::get hs "storage"
    hashset_free_storage<.T> storage
