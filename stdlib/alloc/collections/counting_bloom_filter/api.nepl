//: # counting_bloom_filter/api
//: `CountingBloomFilter` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `insert` / `remove` / `contains` / `clear` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_api_facade_doc\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"api len\" expected=\"64\" actual=\"64\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"api contains inserted item\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=2 status=ok kind=bool label=\"api remove clears singleton item\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter/types" as *
//:| #import "alloc/collections/counting_bloom_filter/api" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf0 %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 64
//:     let bf1 %CountingBloomFilter i32 DefaultHash32 insert bf0 5
//:     let size %i32 len &bf1
//:     let inserted %bool contains &bf1 5
//:     let bf2 %CountingBloomFilter i32 DefaultHash32 remove bf1 5
//:     let removed %bool not contains &bf2 5
//:     free bf2
//:     let report:
//:         test_report_new "counting_bloom_filter_api_facade_doc"
//:         |> test_report_push assert_eq_i32 "api len" 64 size
//:         |> test_report_push assert "api contains inserted item" inserted
//:         |> test_report_push assert "api remove clears singleton item" removed
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./hash" as *
#import "./storage" as *
#import "./mutation" as *
#import "core/field" as *

//: ## counting_bloom_invalid_len_diag
//: 0 以下の counter [長/ちょう]を[拒否/きょひ]する diagnostic を[作/つく]る
//:
//: ### [契約/けいやく]
//: - `new` が owner を[作/つく]る前に invalid length を検出したときの `Diag` を返します。
//: - error kind は `StdErrorKind::CapacityExceeded` です。
//: - error 表示文字列ではなく、typed error kind を[契約/けいやく]とします。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_invalid_len_diag_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"invalid len kind\" expected=\"CapacityExceeded\" actual=\"CapacityExceeded\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter/api" as *
//:| #import "alloc/diag/error" as *
//: fn main %impure fn void i32 \void:
//:     let diag %Diag counting_bloom_invalid_len_diag
//:     let kind %str diag_std_error_kind_str diag
//:     let report:
//:         test_report_new "counting_bloom_filter_invalid_len_diag_doc"
//:         |> test_report_push assert_str_eq "invalid len kind" "CapacityExceeded" kind
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn counting_bloom_invalid_len_diag %impure fn void Diag \void:
    diag_error StdErrorKind::CapacityExceeded "invalid counting bloom filter counter length"

//: ## new
//: [空/から]の Counting Bloom Filter を[作/つく]る
//:
//: ### [契約/けいやく]
//: - `nslots <= 0` は owner を作らず、`Result::Err Diag` を返します。
//: - 成功時は `nslots` 個の counter を持つ空 filter owner を返し、storage はすべて 0 で初期化されます。
//: - 確保失敗は `counting_bloom_alloc_counters` から返る `Diag` をそのまま返します。
//:
//: ### [計算量/けいさんりょう]
//: - counter [長/ちょう]を n とすると O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_new_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"new len\" expected=\"64\" actual=\"64\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"invalid len kind\" expected=\"CapacityExceeded\" actual=\"CapacityExceeded\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 64
//:     let observed_len %i32 len &bf
//:     free bf
//:     let bad %Result CountingBloomFilter i32 DefaultHash32 Diag new DefaultHash32 0
//:     let invalid_kind %str match bad:
//:         Result::Ok unexpected:
//:             free unexpected
//:             "unexpected"
//:         Result::Err diag:
//:             diag_std_error_kind_str diag
//:     let report:
//:         test_report_new "counting_bloom_filter_new_doc"
//:         |> test_report_push assert_eq_i32 "new len" 64 observed_len
//:         |> test_report_push assert_str_eq "invalid len kind" "CapacityExceeded" invalid_kind
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn new <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn .H impure fn i32 Result CountingBloomFilter .T .H Diag \hasher\nslots:
    if:
        le nslots 0
        then:
            diag_err counting_bloom_invalid_len_diag
        else:
            match counting_bloom_alloc_counters nslots 0:
                Result::Err d:
                    err d
                Result::Ok counters:
                    ok CountingBloomFilter<.T,.H> nslots counters hasher

//: ## len
//: counter [長/ちょう]を[返/かえ]す
//:
//: ### [契約/けいやく]
//: - `CountingBloomFilter` owner を[借用/しゃくよう]し、counter storage と hasher を[移動/いどう]しません。
//: - key 型や hasher 型の payload を[読/よ]まない metadata-only observer なので、`.T` / `.H` に `Copy` や hash trait bound を[要求/ようきゅう]しません。
//: - 時間計算量は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_len_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"borrowed len keeps owner\" expected=\"32\" actual=\"32\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 32
//:     let observed_len %i32 len &bf
//:     free bf
//:     let report:
//:         test_report_new "counting_bloom_filter_len_doc"
//:         |> test_report_push assert_eq_i32 "borrowed len keeps owner" 32 observed_len
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn len <.T,.H> %fn &CountingBloomFilter .T .H i32 \bf:
    *field::get_ref bf "nslots"

//: ## insert
//: [要素/ようそ]の probe counter を[加算/かさん]する
//:
//: ### [契約/けいやく]
//: - `CountingBloomFilter` owner を[消費/しょうひ]し、3 probe の counter を 255 で飽和する形で 1 増やした新しい owner を返します。
//: - `new` により `nslots > 0` が[保証/ほしょう]された owner だけを受け取る前提です。
//: - saturation していない範囲で対応する `remove` 回数が `insert` 回数を超えなければ、その key は false negative になりません。
//:
//: ### [計算量/けいさんりょう]
//: - probe 数は 3 で固定です。時間計算量は `Hasher` / `HashKey` 実装に[依存/いぞん]し、固定長 key では O(1)、`str` では文字列長に比例します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_insert_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"inserted item is visible\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"insert keeps len\" expected=\"64\" actual=\"64\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf0 %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 64
//:     let bf1 %CountingBloomFilter i32 DefaultHash32 insert bf0 7
//:     let visible %bool contains &bf1 7
//:     let size %i32 len &bf1
//:     free bf1
//:     let report:
//:         test_report_new "counting_bloom_filter_insert_doc"
//:         |> test_report_push assert "inserted item is visible" visible
//:         |> test_report_push assert_eq_i32 "insert keeps len" 64 size
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn insert <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn CountingBloomFilter .T .H impure fn .T CountingBloomFilter .T .H \bf\key:
    let nslots %i32 field::get bf "nslots"
    let hasher %.H field::get bf "hasher"
    let counters %Vec u8 field::get bf "counters"
    let h0 %i32 counting_bloom_hash0<.T,.H> hasher key
    let h1 %i32 counting_bloom_hash1<.T,.H> hasher key
    let i0 %i32 rem_u h0 nslots
    let i1 %i32 counting_bloom_probe_index nslots h0 h1
    let i2 %i32 counting_bloom_probe_index nslots i1 h1
    counting_bloom_counter_inc &counters i0
    counting_bloom_counter_inc &counters i1
    counting_bloom_counter_inc &counters i2
    CountingBloomFilter<.T,.H> nslots counters hasher

//: ## remove
//: [要素/ようそ]の probe counter を 0 [未満/みまん]にしないよう[減算/げんざん]する
//:
//: ### [契約/けいやく]
//: - `CountingBloomFilter` owner を[消費/しょうひ]し、3 probe の counter を 0 を下回らない形で 1 減らした新しい owner を返します。
//: - caller は key ごとの logical count を管理し、未挿入 key や挿入回数を超える remove を避ける必要があります。
//: - 衝突 key や未挿入 key を remove すると、他 key の counter を下げて false negative を作り得ます。
//: - counter が 255 で飽和した後は、実際の挿入回数と counter 値が一致しないため、remove 回数と logical multiplicity の対応が壊れ得ます。
//:
//: ### [計算量/けいさんりょう]
//: - probe 数は 3 で固定です。時間計算量は `Hasher` / `HashKey` 実装に[依存/いぞん]し、固定長 key では O(1)、`str` では文字列長に比例します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_remove_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"remove clears singleton item\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"one duplicate remains visible\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let single0 %CountingBloomFilter i32 DefaultHash32:
//:         unwrap_ok new DefaultHash32 64
//:         |> insert 7
//:         |> remove 7
//:     let removed %bool not contains &single0 7
//:     free single0
//:     let dup0 %CountingBloomFilter i32 DefaultHash32:
//:         unwrap_ok new DefaultHash32 64
//:         |> insert 7
//:         |> insert 7
//:         |> remove 7
//:     let retained %bool contains &dup0 7
//:     free dup0
//:     let report:
//:         test_report_new "counting_bloom_filter_remove_doc"
//:         |> test_report_push assert "remove clears singleton item" removed
//:         |> test_report_push assert "one duplicate remains visible" retained
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn remove <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn CountingBloomFilter .T .H impure fn .T CountingBloomFilter .T .H \bf\key:
    let nslots %i32 field::get bf "nslots"
    let hasher %.H field::get bf "hasher"
    let counters %Vec u8 field::get bf "counters"
    let h0 %i32 counting_bloom_hash0<.T,.H> hasher key
    let h1 %i32 counting_bloom_hash1<.T,.H> hasher key
    let i0 %i32 rem_u h0 nslots
    let i1 %i32 counting_bloom_probe_index nslots h0 h1
    let i2 %i32 counting_bloom_probe_index nslots i1 h1
    counting_bloom_counter_dec &counters i0
    counting_bloom_counter_dec &counters i1
    counting_bloom_counter_dec &counters i2
    CountingBloomFilter<.T,.H> nslots counters hasher

//: ## contains
//: [要素/ようそ]が[登録済/とうろくず]みかを[近似/きんじ][判定/はんてい]する
//:
//: ### [契約/けいやく]
//: - `CountingBloomFilter` owner を[借用/しゃくよう]し、counter storage と hasher を[移動/いどう]しません。
//: - 3 probe の counter がすべて 1 以上なら `true`、どれか 1 つでも 0 なら `false` を返します。
//: - saturation しておらず、対応する `remove` 回数が `insert` 回数を超えず、同じ hasher / key 実装で照会する限り、挿入済み key は false negative になりません。
//:
//: ### [注意/ちゅうい]
//: - true でも[実際/じっさい]には[入/はい]っていない false positive がありえます。
//: - 過剰 remove、未挿入 key の remove、counter saturation 後の remove は false negative を作り得ます。
//:
//: ### [計算量/けいさんりょう]
//: - probe 数は 3 で固定です。時間計算量は `Hasher` / `HashKey` 実装に[依存/いぞん]し、固定長 key では O(1)、`str` では文字列長に比例します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_contains_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"borrowed contains sees inserted item\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf0 %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 64
//:     let bf1 %CountingBloomFilter i32 DefaultHash32 insert bf0 7
//:     let bf2 %CountingBloomFilter i32 DefaultHash32 insert bf1 12
//:     let ok %bool contains &bf2 12
//:     free bf2
//:     let report:
//:         test_report_new "counting_bloom_filter_contains_doc"
//:         |> test_report_push assert "borrowed contains sees inserted item" ok
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn contains <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %fn &CountingBloomFilter .T .H fn .T bool \bf\key:
    let nslots %i32 *field::get_ref bf "nslots"
    let counters %&Vec u8 field::get_ref bf "counters"
    let hasher %.H *field::get_ref bf "hasher"
    let h0 %i32 counting_bloom_hash0<.T,.H> hasher key
    let h1 %i32 counting_bloom_hash1<.T,.H> hasher key
    let i0 %i32 rem_u h0 nslots
    let i1 %i32 counting_bloom_probe_index nslots h0 h1
    let i2 %i32 counting_bloom_probe_index nslots i1 h1
    let ok0 %bool counting_bloom_counter_nonzero counters i0
    let ok1 %bool counting_bloom_counter_nonzero counters i1
    let ok2 %bool counting_bloom_counter_nonzero counters i2
    and ok0 and ok1 ok2

//: ## clear
//: [全/すべ]ての counter を 0 に[戻/もど]す
//:
//: ### [契約/けいやく]
//: - `CountingBloomFilter` owner を[消費/しょうひ]し、同じ counter [長/ちょう]と hasher を持つ owner を返します。
//: - storage の全 counter を 0 にするため、直前に挿入した key も `contains` で `false` になります。
//:
//: ### [計算量/けいさんりょう]
//: - counter [長/ちょう]を n として O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_clear_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"clear removes inserted item\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"clear keeps len\" expected=\"64\" actual=\"64\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf0 %CountingBloomFilter i32 DefaultHash32:
//:         unwrap_ok new DefaultHash32 64
//:         |> insert 7
//:         |> clear
//:     let removed %bool not contains &bf0 7
//:     let size %i32 len &bf0
//:     free bf0
//:     let report:
//:         test_report_new "counting_bloom_filter_clear_doc"
//:         |> test_report_push assert "clear removes inserted item" removed
//:         |> test_report_push assert_eq_i32 "clear keeps len" 64 size
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn clear <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn CountingBloomFilter .T .H CountingBloomFilter .T .H \bf:
    let nslots %i32 field::get bf "nslots"
    let hasher %.H field::get bf "hasher"
    let counters %Vec u8 field::get bf "counters"
    counting_bloom_fill_counters &counters nslots 0
    CountingBloomFilter<.T,.H> nslots counters hasher

//: ## free
//: counter [配列/はいれつ]を[解放/かいほう]する
//:
//: ### [仕様/しよう]
//: - `CountingBloomFilter` は `new` が[確保/かくほ]した counter `Vec u8` を[所有/しょゆう]します。
//: - `free` はその owner invariant に[基/もと]づき、counter `Vec u8` owner を[閉/と]じます。
//: - 現行 collection cleanup は element / field の Drop traversal を[持/も]たないため、key と hasher は `Copy` に[限/かぎ]ります。
//: - caller は `free` [後/ご]の `CountingBloomFilter` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"counting_bloom_filter_free_doc\" count=1 failed=0\nassertion index=0 status=ok kind=bool label=\"free completes\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/counting_bloom_filter" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//:| #import "core/traits/hash" as *
//: fn main %impure fn void i32 \void:
//:     let bf %CountingBloomFilter i32 DefaultHash32 unwrap_ok new DefaultHash32 64
//:     free bf
//:     let report:
//:         test_report_new "counting_bloom_filter_free_doc"
//:         |> test_report_push assert "free completes" true
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn free <.T: HashKey&Copy,.H: Hasher<.T>&Copy> %impure fn CountingBloomFilter .T .H unit \bf:
    let counters %Vec u8 field::get bf "counters"
    counting_bloom_free_counters counters
