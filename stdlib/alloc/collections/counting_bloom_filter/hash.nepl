//: # counting_bloom_filter/hash
//: `CountingBloomFilter` の hash/probe 計算
//:
//: ### [目的/もくてき]
//: - key と hasher から 3 [本/ぼん]の counter index を[作/つく]るための hash mixing を API から分離します。

#indent 4

#import "core/math" as *
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "core/traits/copy" as *

fn counting_bloom_hash0 <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,.T)->i32> (hasher, key):
    hash_with hasher key

fn counting_bloom_hash1 <.T: HashKey&Copy,.H: Hasher<.T>&Copy> <(.H,.T)->i32> (hasher, key):
    let h0 <i32> counting_bloom_hash0<.T,.H> hasher key
    let hk <i32> hashkey_hash32 key
    let mixed <i32> mix xor h0 hk
    if eq mixed 0 1 mixed

fn counting_bloom_probe_index <(i32,i32,i32)->i32> (nslots, h0, h1):
    rem_u add h0 h1 nslots
