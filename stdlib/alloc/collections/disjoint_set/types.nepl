//: # disjoint_set/types
//: `DisjointSet` の型定義と update error 型
//:
//: ### [目的/もくてき]
//: - Union-Find の owner と、更新失敗時に owner を返す error 型を定義します。
//: - public error accessor を型定義側に置き、caller が `union` 失敗後も owner を安全に回収できるようにします。

#indent 4

#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "core/field" as *

//: ## DisjointSet
//: [代表元/だいひょうげん][配列/はいれつ]と[集合サイズ/しゅうごうさいず][配列/はいれつ]を[所有/しょゆう]する
//:
//: ### [目的/もくてき]
//: - `parent` / `sizes` / `n` を 1 [値/あたい]として[受/う]け[渡/わた]しし、[更新後/こうしんご]も[同/おな]じ[型/かた]で[扱/あつか]えるようにします。
//:
//: ### [注意/ちゅうい]
//: - `parent` と `sizes` の 2 [本/ほん]の[内部配列/ないぶはいれつ]を[所有/しょゆう]するので、[不要/ふよう]になったら `free` します。
pub struct DisjointSet:
    n <i32>
    parent <Vec<i32>>
    sizes <Vec<i32>>

//: ## DisjointSetUpdateError
//: `union` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `union` は[更新/こうしん] API なので `DisjointSet` owner を[受/う]け[取/と]ります。
//: - [範囲外/はんいがい] index では parent / sizes storage を[変更/へんこう]せず、caller が cleanup できるように元の owner を `owner` に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `disjoint_set_update_error_owner` で owner を[回収/かいしゅう]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、`disjoint_set_update_error_diag` から owner を[動/うご]かさず[確認/かくにん]できます。
pub struct DisjointSetUpdateError:
    owner <DisjointSet>
    diag <Diag>

//: disjoint_set_update_error_diag: update [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
pub fn disjoint_set_update_error_diag <(&DisjointSetUpdateError)->Diag> (e):
    *field::get_ref e "diag"

//: disjoint_set_update_error_owner: update [失敗/しっぱい]で[戻/もど]された `DisjointSet` owner を[取/と]り[出/だ]す
pub fn disjoint_set_update_error_owner <(DisjointSetUpdateError)->DisjointSet> (e):
    field::get e "owner"
