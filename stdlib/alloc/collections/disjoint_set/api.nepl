//: # disjoint_set/api
//: `DisjointSet` の public 操作
//:
//: ### [目的/もくてき]
//: - `new` / `len` / `find` / `union` / `same` / `size` / `free` を提供します。
//: - update API は owner を消費して返し、query API は owner を借用して読み取ります。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "./query" as *

fn dsu_diag_len <()*>Diag> ():
    diag_error StdErrorKind::CapacityExceeded "invalid disjoint set length"

fn dsu_diag_index <()*>Diag> ():
    diag_error StdErrorKind::IndexOutOfBounds "disjoint set index out of bounds"

//: ## new
//: [長/なが]さ `n` の[素集合/そしゅうごう]を[作/つく]る
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu <DisjointSet> unwrap_ok<DisjointSet, Diag> new 5;
//:     let ok <bool> eq len &dsu 5;
//:     free dsu
//:     if ok 1 0
//: ```
fn new <(i32)*>Result<DisjointSet, Diag>> (n):
    if:
        lt n 0
        then diag_err<DisjointSet> dsu_diag_len
        else:
            match vec::filled<i32> n 0:
                Result::Err _e:
                    diag_err<DisjointSet> diag_out_of_memory
                Result::Ok parent:
                    match vec::filled<i32> n 1:
                        Result::Err _e:
                            vec::free<i32> parent
                            diag_err<DisjointSet> diag_out_of_memory
                        Result::Ok sizes:
                            let mut i <i32> 0
                            while lt i n:
                                do:
                                    dsu_store_owned &parent i i
                                    set i add i 1
                            ok<DisjointSet, Diag> DisjointSet n parent sizes

//: ## len
//: [保持/ほじ]している[要素数/ようそすう]を[返/かえ]す
//:
//: ### [仕様/しよう]
//: - `DisjointSet` owner は[消費/しょうひ]しません。
//: - caller は `len` [後/ご]も同じ `DisjointSet` を[使/つか]い、不要になったら `free` できます。
fn len <(&DisjointSet)->i32> (dsu):
    *field::get_ref dsu "n"

//: ## find
//: `idx` の[代表元/だいひょうげん]を[返/かえ]す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu0 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 4;
//:     let dsu1 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu0 0 1;
//:     let root0 <i32> unwrap_ok<i32, Diag> find &dsu1 0;
//:     let dsu2 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 4;
//:     let dsu3 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu2 0 1;
//:     let root1 <i32> unwrap_ok<i32, Diag> find &dsu3 1;
//:     free dsu1
//:     free dsu3
//:     if eq root0 root1 1 0
//: ```
fn find <(&DisjointSet,i32)*>Result<i32, Diag>> (dsu, idx):
    let n <i32> *field::get_ref dsu "n"
    if:
        and le 0 idx lt idx n
        then:
            let parent <&Vec<i32>> field::get_ref dsu "parent"
            match dsu_root_storage parent idx:
                Option::Some root:
                    ok<i32, Diag> root
                Option::None:
                    diag_err<i32> dsu_diag_index
        else:
            let d <Diag> dsu_diag_index
            err<i32, Diag> d

//: ## union
//: `a` と `b` の[属/ぞく]する[集合/しゅうごう]を[併合/へいごう]する
//:
//: ### [実装/じっそう]
//: - union-by-size で[小/ちい]さい[木/き]を[大/おお]きい[木/き]の root に[付/つ]けます。
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu0 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 5;
//:     let dsu1 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu0 0 1;
//:     let dsu2 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu1 1 2;
//:     let ok <bool> unwrap_ok<bool, Diag> same &dsu2 0 2;
//:     free dsu2
//:     if ok 1 0
//: ```
fn union <(DisjointSet,i32,i32)*>Result<DisjointSet, DisjointSetUpdateError>> (dsu, a, b):
    let n <i32> *field::get_ref &dsu "n"
    if:
        and and le 0 a lt a n and le 0 b lt b n
        then:
            let result <Result<(), Diag>> block:
                let parent <&Vec<i32>> field::get_ref &dsu "parent"
                let sizes <&Vec<i32>> field::get_ref &dsu "sizes"
                match dsu_root_storage parent a:
                    Option::Some ra:
                        match dsu_root_storage parent b:
                            Option::Some rb:
                                if:
                                    eq ra rb
                                    then:
                                        ok<(), Diag> ()
                                    else:
                                        match dsu_size_storage sizes ra:
                                            Option::Some sa:
                                                match dsu_size_storage sizes rb:
                                                    Option::Some sb:
                                                        let root_keep <i32> if lt sa sb rb ra
                                                        let root_drop <i32> if lt sa sb ra rb
                                                        match dsu_size_storage sizes root_keep:
                                                            Option::Some sk:
                                                                match dsu_size_storage sizes root_drop:
                                                                    Option::Some sd:
                                                                        dsu_store_owned parent root_drop root_keep
                                                                        dsu_store_owned sizes root_keep add sk sd
                                                                        ok<(), Diag> ()
                                                                    Option::None:
                                                                        diag_err<()> dsu_diag_index
                                                            Option::None:
                                                                diag_err<()> dsu_diag_index
                                                    Option::None:
                                                        diag_err<()> dsu_diag_index
                                            Option::None:
                                                diag_err<()> dsu_diag_index
                            Option::None:
                                diag_err<()> dsu_diag_index
                    Option::None:
                        diag_err<()> dsu_diag_index
            match result:
                Result::Ok _unit:
                    ok<DisjointSet, DisjointSetUpdateError> dsu
                Result::Err d:
                    let e <DisjointSetUpdateError> DisjointSetUpdateError dsu d
                    err<DisjointSet, DisjointSetUpdateError> e
        else:
            let d <Diag> dsu_diag_index
            let e <DisjointSetUpdateError> DisjointSetUpdateError dsu d
            err<DisjointSet, DisjointSetUpdateError> e

//: ## same
//: 2 [要素/ようそ]が[同/おな]じ[集合/しゅうごう]に[属/ぞく]するかを[返/かえ]す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu0 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 4;
//:     let dsu1 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu0 0 1;
//:     let ok0 <bool> unwrap_ok<bool, Diag> same &dsu1 0 1;
//:     let dsu2 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 4;
//:     let dsu3 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu2 0 1;
//:     let ok1 <bool> unwrap_ok<bool, Diag> same &dsu3 0 2;
//:     free dsu1
//:     free dsu3
//:     let ok2 <bool> if ok1 false true;
//:     if and ok0 ok2 1 0
//: ```
fn same <(&DisjointSet,i32,i32)*>Result<bool, Diag>> (dsu, a, b):
    let n <i32> *field::get_ref dsu "n"
    if:
        and and le 0 a lt a n and le 0 b lt b n
        then:
            let parent <&Vec<i32>> field::get_ref dsu "parent"
            match dsu_root_storage parent a:
                Option::Some ra:
                    match dsu_root_storage parent b:
                        Option::Some rb:
                            ok<bool, Diag> eq ra rb
                        Option::None:
                            diag_err<bool> dsu_diag_index
                Option::None:
                    diag_err<bool> dsu_diag_index
        else:
            let d <Diag> dsu_diag_index
            err<bool, Diag> d

//: ## size
//: `idx` の[属/ぞく]する[集合/しゅうごう]の[大/おお]きさを[返/かえ]す
//:
//: ### [計算量/けいさんりょう]
//: - O(log n)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu0 <DisjointSet> unwrap_ok<DisjointSet, Diag> new 5;
//:     let dsu1 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu0 0 1;
//:     let dsu2 <DisjointSet> unwrap_ok<DisjointSet, DisjointSetUpdateError> union dsu1 1 2;
//:     let s <i32> unwrap_ok<i32, Diag> size &dsu2 2;
//:     free dsu2
//:     if eq s 3 1 0
//: ```
fn size <(&DisjointSet,i32)*>Result<i32, Diag>> (dsu, idx):
    let n <i32> *field::get_ref dsu "n"
    if:
        and le 0 idx lt idx n
        then:
            let parent <&Vec<i32>> field::get_ref dsu "parent"
            let sizes <&Vec<i32>> field::get_ref dsu "sizes"
            match dsu_root_storage parent idx:
                Option::Some root:
                    match dsu_size_storage sizes root:
                        Option::Some out:
                            ok<i32, Diag> out
                        Option::None:
                            diag_err<i32> dsu_diag_index
                Option::None:
                    diag_err<i32> dsu_diag_index
        else:
            let d <Diag> dsu_diag_index
            err<i32, Diag> d

//: ## free
//: [内部配列/ないぶはいれつ]を[解放/かいほう]する
//:
//: ### [実装/じっそう]
//: - `parent` と `sizes` は `new` が `Vec<i32>` として[確保/かくほ]し、`DisjointSet` が[単独/たんどく]で[所有/しょゆう]します。
//: - owner invariant に[基/もと]づき、内部 cleanup は 2 [本/ほん]の `Vec<i32>` owner を[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - [解放後/かいほうご]に `dsu` を[再利用/さいりよう]してはいけません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/disjoint_set" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let dsu <DisjointSet> unwrap_ok<DisjointSet, Diag> new 3;
//:     free dsu;
//:     0
//: ```
fn free <(DisjointSet)->()> (dsu):
    let parent <Vec<i32>> field::get dsu "parent"
    let sizes <Vec<i32>> field::get dsu "sizes"
    vec::free<i32> parent
    vec::free<i32> sizes
