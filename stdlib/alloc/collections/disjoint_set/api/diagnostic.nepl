//: # disjoint_set/api/diagnostic
//: `DisjointSet` API が返す診断 constructor
//:
//: ### [目的/もくてき]
//: - length / index error の `Diag` 生成を 1 箇所に集約します。
//: - public 操作 module が同じ診断種別と message を共有できるようにします。

#indent 4

#import "alloc/diag/error" as *
#import "core/result" as *

pub fn dsu_diag_len %impure fn () Diag \():
    diag_error StdErrorKind::CapacityExceeded "invalid disjoint set length"

pub fn dsu_diag_index %impure fn () Diag \():
    diag_error StdErrorKind::IndexOutOfBounds "disjoint set index out of bounds"
