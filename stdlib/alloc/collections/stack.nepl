//: # stack
//: `Vec<Option<T>>` backed LIFO stack
//:
//: ### [目的/もくてき]
//: - `push` / `pop_top` / `peek_ref` / `get_ref` / `len_ref` など、stack 操作の基本 API を[提供/ていきょう]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` / `items` を struct field として[保持/ほじ]します。
//: - `items` は `cap` [個/こ]の `Option<T>` で、live slot は `Some(value)`、inactive slot は `None` です。
//: - grow 時は live slot だけを新しい storage へ[写/うつ]し、旧 `Vec` owner を[解放/かいほう]します。
//:
//: ### [注意/ちゅうい]
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には stack payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `is_empty` / `peek` / `pop` は `Stack` を[値/あたい]で[消費/しょうひ]し、内部 storage を[閉/と]じます。owner を[残/のこ]したまま[観測/かんそく]する場合は `len_ref` / `is_empty_ref` / `peek_ref` / `get_ref` を[使/つか]います。
//: - `pop_top` は[更新後/こうしんご]の owner と[値/あたい]を[同時/どうじ]に[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `len_ref` / `is_empty_ref` / `peek_ref` / `get_ref` / `pop_top` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Stack
//: LIFO stack の owner
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `items.len == cap`
struct Stack<.T>:
    len <i32>
    cap <i32>
    items <Vec<Option<.T>>>

//: ## StackPop
//: `pop_top` の[結果/けっか]
struct StackPop<.T>:
    stack <Stack<.T>>
    item <Option<.T>>

fn stack_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

fn stack_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get_ref<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

fn stack_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace_ref<Option<.T>> items idx item

fn stack_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

fn stack_clear_slots_loop <.T: Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, cap, i):
    if:
        lt i cap
        then:
            stack_store_slot<.T> items i none<.T>
            stack_clear_slots_loop<.T> items cap add i 1
        else:
            ()

fn stack_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32)*>()> (src, dst, len):
    let mut i <i32> 0
    while lt i len:
        do:
            match stack_item_at<.T> src i:
                Option::Some item:
                    stack_store_slot<.T> dst i some<.T> item
                Option::None:
                    ()
            set i add i 1

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から] stack を[作/つく]る
fn new <.T: Copy> <()*>Result<Stack<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [容量/ようりょう]を[指定/してい]して[空/から] stack を[作/つく]る
fn with_capacity <.T: Copy> <(i32)*>Result<Stack<.T>, Diag>> (cap):
    let cap0 <i32> stack_normalize_capacity cap
    match stack_alloc_slots<.T> cap0:
        Result::Err d:
            err<Stack<.T>, Diag> d
        Result::Ok items:
            ok<Stack<.T>, Diag> Stack<.T> 0 cap0 items

//: ## push
//: [末尾/まつび]へ[積/つ]む
fn push <.T: Copy> <(Stack<.T>,.T)*>Result<Stack<.T>, Diag>> (stk, item):
    let len0 <i32> *field::get_ref &stk "len"
    let cap0 <i32> *field::get_ref &stk "cap"
    let items <Vec<Option<.T>>> field::get stk "items"
    if:
        eq len0 cap0
        then:
            let new_cap <i32> mul cap0 2
            match stack_alloc_slots<.T> new_cap:
                Result::Err d:
                    vec::free<Option<.T>> items
                    err<Stack<.T>, Diag> d
                Result::Ok new_items:
                    stack_copy_live_slots<.T> &items &new_items len0
                    stack_store_slot<.T> &new_items len0 some<.T> item
                    vec::free<Option<.T>> items
                    ok<Stack<.T>, Diag> Stack<.T> add len0 1 new_cap new_items
        else:
            stack_store_slot<.T> &items len0 some<.T> item
            ok<Stack<.T>, Diag> Stack<.T> add len0 1 cap0 items

//: ## pop_top
//: [末尾/まつび]を[取/と]り[出/だ]し、[更新後/こうしんご]の stack と[値/あたい]を[返/かえ]す
fn pop_top <.T: Copy> <(Stack<.T>)*>StackPop<.T>> (stk):
    let len0 <i32> *field::get_ref &stk "len"
    let cap0 <i32> *field::get_ref &stk "cap"
    let items <Vec<Option<.T>>> field::get stk "items"
    if:
        eq len0 0
        then:
            let next_st <Stack<.T>> Stack<.T> 0 cap0 items
            StackPop<.T> next_st none<.T>
        else:
            let next_len <i32> sub len0 1
            let item <Option<.T>> stack_item_at<.T> &items next_len
            stack_store_slot<.T> &items next_len none<.T>
            let next_st <Stack<.T>> Stack<.T> next_len cap0 items
            StackPop<.T> next_st item

//: ## pop
//: stack を[消費/しょうひ]して[末尾/まつび]の[値/あたい]だけを[返/かえ]す
fn pop <.T: Copy> <(Stack<.T>)*>Option<.T>> (stk):
    let p <StackPop<.T>> pop_top<.T> stk
    let item <Option<.T>> *field::get_ref &p "item"
    free<.T> field::get p "stack"
    item

//: ## peek
//: stack を[消費/しょうひ]して[末尾/まつび]を[読/よ]む
fn peek <.T: Copy> <(Stack<.T>)->Option<.T>> (stk):
    let item <Option<.T>> peek_ref<.T> &stk
    free<.T> stk
    item

//: ## peek_ref
//: `Stack` を[移動/いどう]せずに[末尾/まつび]を[読/よ]む
fn peek_ref <.T: Copy> <(&Stack<.T>)->Option<.T>> (stk):
    let len0 <i32> *field::get_ref stk "len"
    if:
        eq len0 0
        then:
            none<.T>
        else:
            let items <&Vec<Option<.T>>> field::get_ref stk "items"
            stack_item_at<.T> items sub len0 1

//: ## get_ref
//: `Stack` を[移動/いどう]せずに index の[値/あたい]を[読/よ]む
fn get_ref <.T: Copy> <(&Stack<.T>,i32)->Option<.T>> (stk, idx):
    let len0 <i32> *field::get_ref stk "len"
    if:
        lt idx 0
        then:
            none<.T>
        else:
            if:
                le len0 idx
                then:
                    none<.T>
                else:
                    let items <&Vec<Option<.T>>> field::get_ref stk "items"
                    stack_item_at<.T> items idx

//: ## len
//: stack を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
fn len <.T> <(Stack<.T>)->i32> (stk):
    let n <i32> *field::get_ref &stk "len"
    free<.T> stk
    n

//: ## len_ref
//: `Stack` を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len_ref <.T> <(&Stack<.T>)->i32> (stk):
    *field::get_ref stk "len"

//: ## is_empty
//: stack を[消費/しょうひ]して[空/から]かどうかを[返/かえ]す
fn is_empty <.T> <(Stack<.T>)->bool> (stk):
    let ok <bool> is_empty_ref<.T> &stk
    free<.T> stk
    ok

//: ## is_empty_ref
//: `Stack` を[移動/いどう]せずに[空/から]かどうかを[返/かえ]す
fn is_empty_ref <.T> <(&Stack<.T>)->bool> (stk):
    eq len_ref<.T> stk 0

//: ## clear
//: [内容/ないよう]を[空/から]にする
fn clear <.T: Copy> <(Stack<.T>)*>Stack<.T>> (stk):
    let cap0 <i32> *field::get_ref &stk "cap"
    let items <Vec<Option<.T>>> field::get stk "items"
    stack_clear_slots_loop<.T> &items cap0 0
    Stack<.T> 0 cap0 items

//: ## free
//: stack が[所有/しょゆう]する backing storage を[解放/かいほう]する
fn free <.T> <(Stack<.T>)->()> (stk):
    vec::free<Option<.T>> field::get stk "items"
