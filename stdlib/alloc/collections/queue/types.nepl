//: # queue/types
//: FIFO queue の owner 型、push error 型、pop 結果型
//:
//: ### [目的/もくてき]
//: - queue state と backing storage owner を struct field として[表/あらわ]します。
//: - owner-consuming push の[失敗/しっぱい]時にも、caller が queue owner を[回収/かいしゅう]できる error payload を[定義/ていぎ]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec Option .T` で slot state を[表/あらわ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Queue
//: FIFO queue の owner
//:
//: ### [目的/もくてき]
//: - queue state と backing storage owner を 1 [値/あたい]として[移動/いどう]します。
pub struct Queue<.T>:
    len %i32
    cap %i32
    head %i32
    items %Vec Option .T

//: ## QueuePushError
//: `push` の grow [失敗/しっぱい]で[戻/もど]る error payload
//:
//: ### [目的/もくてき]
//: - push が[消費/しょうひ]した queue owner を `queue` に[戻/もど]し、caller が cleanup や[再試行/さいしこう]を[選/えら]べるようにします。
//: - `Diag` だけを[返/かえ]して queue owner の[行方/ゆくえ]を実装 discipline に[隠/かく]すことを[避/さ]けます。
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/queue" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let q %Queue i32 unwrap_ok new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %QueuePushError i32 QueuePushError<i32> q d0;
//:     0
//: ```
pub struct QueuePushError<.T>:
    queue %Queue .T
    diag %Diag

//: ## queue_push_error_diag
//: push [失敗/しっぱい]の `Diag` を owner を[動/うご]かさず[読/よ]む
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/queue" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let q %Queue i32 unwrap_ok new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %QueuePushError i32 QueuePushError<i32> q d0;
//:     0
//: ```
pub fn queue_push_error_diag <.T> %fn &QueuePushError .T Diag \e:
    *field::get_ref e "diag"

//: ## queue_push_error_queue
//: push [失敗/しっぱい]で[戻/もど]された queue owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 Queue は `Vec Option .T` storage を Copy-only payload に[限定/げんてい]しているため、この accessor も `.T: Copy` に[限定/げんてい]します。
//:
//: - error payload は `push` 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/queue" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let q %Queue i32 unwrap_ok new<i32>;
//:     let d0 %Diag diag_out_of_memory;
//:     let error_payload %QueuePushError i32 QueuePushError<i32> q d0;
//:     0
//: ```
pub fn queue_push_error_queue <.T: Copy> %fn QueuePushError .T Queue .T \e:
    field::get e "queue"

//: ## QueuePop
//: `pop_front` の[結果/けっか]
//:
//: ### [目的/もくてき]
//: - [更新後/こうしんご]の queue owner と[取/と]り[出/だ]した[値/あたい]を[同時/どうじ]に[返/かえ]します。
pub struct QueuePop<.T>:
    queue %Queue .T
    item %Option .T

//: ## queue_pop_item
//: `QueuePop` を[借用/しゃくよう]し、[取/と]り[出/だ]した[値/あたい]を[読/よ]む
//:
//: neplg2:test
//: ret: 1
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/queue" as *
//: #import "alloc/diag/error" as *
//: #import "core/math" as *
//: #import "core/option" as *
//: #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let q0 %Queue i32 unwrap_ok new<i32>;
//:     let q1 %Queue i32 unwrap_ok push<i32> q0 7;
//:     let p %QueuePop i32 pop_front<i32> q1;
//:     let ok %bool match queue_pop_item<i32> &p:
//:         Option::Some v:
//:             eq v 7
//:         Option::None:
//:             false
//:     let q2 %Queue i32 queue_pop_queue<i32> p;
//:     free<i32> q2;
//:     if ok 1 0
//: ```
pub fn queue_pop_item <.T: Copy> %fn &QueuePop .T Option .T \p:
    *field::get_ref p "item"

//: ## queue_pop_queue
//: `QueuePop` から[更新後/こうしんご]の queue owner を[取/と]り[出/だ]す
//:
//: neplg2:test
//: ret: 1
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/queue" as *
//: #import "alloc/diag/error" as *
//: #import "core/math" as *
//: #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let q0 %Queue i32 unwrap_ok new<i32>;
//:     let q1 %Queue i32 unwrap_ok push<i32> q0 7;
//:     let p %QueuePop i32 pop_front<i32> q1;
//:     let q2 %Queue i32 queue_pop_queue<i32> p;
//:     let ok %bool is_empty<i32> &q2;
//:     free<i32> q2;
//:     if ok 1 0
//: ```
pub fn queue_pop_queue <.T: Copy> %fn QueuePop .T Queue .T \p:
    field::get p "queue"
