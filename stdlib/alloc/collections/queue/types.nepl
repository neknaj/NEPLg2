//: # queue/types
//: FIFO queue の owner 型と pop 結果型
//:
//: ### [目的/もくてき]
//: - queue state と backing storage owner を struct field として[表/あらわ]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`

#indent 4

#import "core/option" as *
#import "alloc/collections/vec" as vec

//: ## Queue
//: FIFO queue の owner
//:
//: ### [目的/もくてき]
//: - queue state と backing storage owner を 1 [値/あたい]として[移動/いどう]します。
struct Queue<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>

//: ## QueuePop
//: `pop_front` の[結果/けっか]
//:
//: ### [目的/もくてき]
//: - [更新後/こうしんご]の queue owner と[取/と]り[出/だ]した[値/あたい]を[同時/どうじ]に[返/かえ]します。
struct QueuePop<.T>:
    queue <Queue<.T>>
    item <Option<.T>>
