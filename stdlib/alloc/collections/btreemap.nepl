//: # btreemap
//: [順序付き/じゅんじょつき] map
//:
//: ### [目的/もくてき]
//: - `BTreeMap<.K, .V>` を[提供/ていきょう]し、`new` / `insert` / `get` / `contains` / `remove` / `len` / `clear` / `free` の bare 名で[扱/あつか]えるようにします。
//: - 互換名 `BTreeMap` に[加/くわ]えて、sorted-array としての[性質/せいしつ]を[明示/めいじ]する `sorted_array_map_*` alias を[提供/ていきょう]します。
//: - key の[比較/ひかく]は `Ord` trait に[委譲/いじょう]し、`i32` 固定から[脱却/だっきゃく]します。
//:
//: ### [実装/じっそう]
//: - [名前/なまえ]は `BTreeMap` ですが、[現実/げんじつ]の[内部表現/ないぶひょうげん]は[整列済/せいれつず]み key/value [配列/はいれつ]です。
//: - [検索/けんさく]は lower_bound、[挿入/そうにゅう] / [削除/さくじょ]は shift で[実装/じっそう]します。
//: - `sorted_array_map_*` alias は[同/おな]じ[実装/じっそう]を[指/さ]し、B-tree [相当/そうとう]の[更新/こうしん][性能/せいのう]を[期待/きたい]しない[用途/ようと]であることを[呼/よ]び[出/だ]し[名/めい]に[残/のこ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree ではありません。
//: - 大きな mutable table、symbol table、module table、diagnostic table には[使/つか]わないでください。更新が[多/おお]い[表/ひょう]は `HashMap` / `HashSet` を[使/つか]い、安定順の[出力/しゅつりょく]が[必要/ひつよう]な[段階/だんかい]だけ key を[整列/せいれつ]する[構造/こうぞう]を[選/えら]びます。
//: - 小さな[集合/しゅうごう]、構築後に[検索/けんさく]中心になる[順序付き/じゅんじょつき] table、または最終出力の安定順を[保/たも]つ[用途/ようと]に[限定/げんてい]してください。
//: - `Ord` impl が[全順序/ぜんじゅんじょ]を[満/み]たすことを[前提/ぜんてい]にします。
//:
//: ### [計算量/けいさんりょう]
//: - `get` / `contains` は O(log n)、`insert` / `remove` は O(n) です。

#indent 4

#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "alloc/diag/error" as *

//: ## BTreeMap
//: [順序付き/じゅんじょつき] key/value [配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - key と value の[整列済/せいれつず]み[配列/はいれつ]を 1 [値/あたい]として[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree node [分割/ぶんかつ]は[持/も]たず、lower_bound と shift で[動/うご]く[単純/たんじゅん][実装/じっそう]です。
struct BTreeMap<.K,.V>:
    hdr <i32>

fn keys_ptr <(i32)->i32> (hdr):
    load_i32 add hdr 8

fn values_ptr <(i32)->i32> (hdr):
    load_i32 add hdr 12

fn key_eq <.K: Ord> <(.K,.K)->bool> (a, b):
    and not ord_lt a b not ord_lt b a

fn lower_bound <.K: Ord> <(i32,.K,i32,i32)->i32> (keys, key, low, high):
    if:
        lt low high
        then:
            let mid <i32> div_s add low high 2
            let saved <.K> load<.K> add keys mul mid size_of<.K>
            if:
                ord_lt saved key
                then lower_bound<.K> keys key add mid 1 high
                else lower_bound<.K> keys key low mid
        else low

fn is_at <.K: Ord> <(i32,i32,i32,.K)->bool> (keys, len, idx, key):
    if:
        lt idx len
        then key_eq<.K> load<.K> add keys mul idx size_of<.K> key
        else false

fn grow <.K,.V> <(BTreeMap<.K,.V>)*>Result<BTreeMap<.K,.V>, Diag>> (hm):
    let hdr <i32> field::get hm "hdr"
    let len0 <i32> load_i32 hdr
    let cap0 <i32> load_i32 add hdr 4
    let keys0 <i32> keys_ptr hdr
    let vals0 <i32> values_ptr hdr
    let cap1 <i32> mul cap0 2
    let keys1 <i32> alloc_raw mul cap1 size_of<.K>
    if:
        eq keys1 0
        then diag_err<BTreeMap<.K,.V>> diag_out_of_memory
        else:
            let vals1 <i32> alloc_raw mul cap1 size_of<.V>
            if:
                eq vals1 0
                then:
                    dealloc_raw keys1 mul cap1 size_of<.K>
                    diag_err<BTreeMap<.K,.V>> diag_out_of_memory
                else:
                    let mut i <i32> 0
                    while lt i len0:
                        do:
                            store<.K> add keys1 mul i size_of<.K> load<.K> add keys0 mul i size_of<.K>
                            store<.V> add vals1 mul i size_of<.V> load<.V> add vals0 mul i size_of<.V>
                            set i add i 1
                    dealloc_raw keys0 mul cap0 size_of<.K>
                    dealloc_raw vals0 mul cap0 size_of<.V>
                    store_i32 add hdr 4 cap1
                    store_i32 add hdr 8 keys1
                    store_i32 add hdr 12 vals1
                    ok<BTreeMap<.K,.V>, Diag> hm

//: ## new
//: [空/から]の `BTreeMap<.K, .V>` を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     if eq len hm 0 1 0
//: ```
fn new <.K,.V> <()*>Result<BTreeMap<.K,.V>, Diag>> ():
    let cap <i32> 8
    let keys <i32> alloc_raw mul cap size_of<.K>
    if:
        eq keys 0
        then diag_err<BTreeMap<.K,.V>> diag_out_of_memory
        else:
            let vals <i32> alloc_raw mul cap size_of<.V>
            if:
                eq vals 0
                then:
                    dealloc_raw keys mul cap size_of<.K>
                    diag_err<BTreeMap<.K,.V>> diag_out_of_memory
                else:
                    let hdr <i32> alloc_raw 16
                    if:
                        eq hdr 0
                        then:
                            dealloc_raw keys mul cap size_of<.K>
                            dealloc_raw vals mul cap size_of<.V>
                            diag_err<BTreeMap<.K,.V>> diag_out_of_memory
                        else:
                            store_i32 hdr 0
                            store_i32 add hdr 4 cap
                            store_i32 add hdr 8 keys
                            store_i32 add hdr 12 vals
                            ok<BTreeMap<.K,.V>, Diag> BTreeMap hdr

//: ## len
//: [要素数/ようそすう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 3 30 |> uwok
//:         |> insert 7 70 |> uwok
//:     if eq len hm 2 1 0
//: ```
fn len <.K,.V> <(BTreeMap<.K,.V>)->i32> (hm):
    let hdr <i32> field::get hm "hdr"
    load_i32 hdr

//: ## contains
//: key の[存在/そんざい]を[確/たし]かめる
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     if contains hm 7 1 0
//: ```
fn contains <.K: Ord,.V> <(BTreeMap<.K,.V>,.K)->bool> (hm, key):
    let hdr <i32> field::get hm "hdr"
    let len0 <i32> load_i32 hdr
    let keys <i32> keys_ptr hdr
    let idx <i32> lower_bound<.K> keys key 0 len0
    is_at<.K> keys len0 idx key

//: ## get
//: key に[対応/たいおう]する value を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     match get hm 7:
//:         Option::Some v:
//:             if eq v 70 1 0
//:         Option::None:
//:             0
//: ```
fn get <.K: Ord,.V> <(BTreeMap<.K,.V>,.K)->Option<.V>> (hm, key):
    let hdr <i32> field::get hm "hdr"
    let len0 <i32> load_i32 hdr
    let keys <i32> keys_ptr hdr
    let vals <i32> values_ptr hdr
    let idx <i32> lower_bound<.K> keys key 0 len0
    if:
        is_at<.K> keys len0 idx key
        then some<.V> load<.V> add vals mul idx size_of<.V>
        else none<.V>

//: ## btreemap_insert_ready
//: [容量/ようりょう]が[足/た]りている `BTreeMap` に key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [目的/もくてき]
//: - public `insert` が grow の[成功/せいこう]を[確認/かくにん]したあと、実際の lower_bound / shift / store を[一箇所/いっかしょ]で[行/おこな]います。
//: - grow [失敗/しっぱい]を `unwrap_ok` で trap にしないため、確保を伴う[準備/じゅんび]と確保後の[挿入/そうにゅう]を[分離/ぶんり]します。
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound は O(log n)、挿入時の shift は O(n) です。
fn btreemap_insert_ready <.K: Ord,.V> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm1, key, value):
    let hdr <i32> field::get hm1 "hdr"
    let len0 <i32> load_i32 hdr
    let keys <i32> keys_ptr hdr
    let vals <i32> values_ptr hdr
    let idx <i32> lower_bound<.K> keys key 0 len0
    if:
        is_at<.K> keys len0 idx key
        then:
            store<.V> add vals mul idx size_of<.V> value
            ok<BTreeMap<.K,.V>, Diag> hm1
        else:
            let mut i <i32> len0
            while gt i idx:
                do:
                    let from <i32> sub i 1
                    store<.K> add keys mul i size_of<.K> load<.K> add keys mul from size_of<.K>
                    store<.V> add vals mul i size_of<.V> load<.V> add vals mul from size_of<.V>
                    set i from
            store<.K> add keys mul idx size_of<.K> key
            store<.V> add vals mul idx size_of<.V> value
            store_i32 hdr add len0 1
            ok<BTreeMap<.K,.V>, Diag> hm1

//: ## insert
//: key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [実装/じっそう]
//: - 現在の[容量/ようりょう]が[満杯/まんぱい]なら `grow` を[実行/じっこう]し、`Result::Err` はそのまま[返/かえ]します。
//: - 確保に[成功/せいこう]した map、または元から[余裕/よゆう]のある map だけを `btreemap_insert_ready` に[渡/わた]します。
//:
//: ### [失敗/しっぱい]
//: - grow 用 key/value buffer の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Diag::OutOfMemory` を[返/かえ]し、trap しません。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(n)、grow が[起/お]きる[回/かい]は既存要素の copy を含め O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> insert 3 30 |> uwok
//:     if eq len hm 2 1 0
//: ```
fn insert <.K: Ord,.V> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm, key, value):
    let hdr0 <i32> field::get hm "hdr"
    let len_init <i32> load_i32 hdr0
    let cap_init <i32> load_i32 add hdr0 4
    if:
        eq len_init cap_init
        then:
            match grow<.K,.V> hm:
                Result::Ok hm1:
                    btreemap_insert_ready<.K,.V> hm1 key value
                Result::Err d:
                    err<BTreeMap<.K,.V>, Diag> d
        else btreemap_insert_ready<.K,.V> hm key value

//: ## remove
//: key を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> remove 7
//:     if eq len hm 0 1 0
//: ```
fn remove <.K: Ord,.V> <(BTreeMap<.K,.V>,.K)*>BTreeMap<.K,.V>> (hm, key):
    let hdr <i32> field::get hm "hdr"
    let len0 <i32> load_i32 hdr
    let keys <i32> keys_ptr hdr
    let vals <i32> values_ptr hdr
    let idx <i32> lower_bound<.K> keys key 0 len0
    if:
        not is_at<.K> keys len0 idx key
        then hm
        else:
            let mut i <i32> idx
            while lt i sub len0 1:
                do:
                    let nxt <i32> add i 1
                    store<.K> add keys mul i size_of<.K> load<.K> add keys mul nxt size_of<.K>
                    store<.V> add vals mul i size_of<.V> load<.V> add vals mul nxt size_of<.V>
                    set i nxt
            store_i32 hdr sub len0 1
            hm

//: ## clear
//: [全要素/ぜんようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> clear
//:     if eq len hm 0 1 0
//: ```
fn clear <.K,.V> <(BTreeMap<.K,.V>)*>BTreeMap<.K,.V>> (hm):
    let hdr <i32> field::get hm "hdr"
    store_i32 hdr 0
    hm

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     free hm;
//:     0
//: ```
fn free <.K,.V> <(BTreeMap<.K,.V>)*>()> (hm):
    let hdr <i32> field::get hm "hdr"
    let cap <i32> load_i32 add hdr 4
    dealloc_raw keys_ptr hdr mul cap size_of<.K>
    dealloc_raw values_ptr hdr mul cap size_of<.V>
    dealloc_raw hdr 16

//: ## sorted_array_map_new
//: sorted-array map として `new` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [目的/もくてき]
//: - `BTreeMap` 互換[実装/じっそう]を、B-tree ではなく sorted-array map として[意図/いと]して[選/えら]んだことを API [名/めい]に[残/のこ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `new` と[同/おな]じです。
fn sorted_array_map_new new;

//: ## sorted_array_map_insert
//: sorted-array map として `insert` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 挿入位置以降を shift するため O(n) です。大量の逐次 insert には[使/つか]わないでください。
fn sorted_array_map_insert insert;

//: ## sorted_array_map_get
//: sorted-array map として `get` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound により O(log n) です。
fn sorted_array_map_get get;

//: ## sorted_array_map_contains
//: sorted-array map として `contains` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound により O(log n) です。
fn sorted_array_map_contains contains;

//: ## sorted_array_map_remove
//: sorted-array map として `remove` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 削除位置以降を shift するため O(n) です。
fn sorted_array_map_remove remove;

//: ## sorted_array_map_len
//: sorted-array map として `len` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `len` と[同/おな]じ O(1) です。
fn sorted_array_map_len len;

//: ## sorted_array_map_clear
//: sorted-array map として `clear` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `clear` と[同/おな]じ O(1) です。
fn sorted_array_map_clear clear;

//: ## sorted_array_map_free
//: sorted-array map として `free` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - `free` と[同/おな]じく、内部 key/value [配列/はいれつ]を[解放/かいほう]します。
fn sorted_array_map_free free;
