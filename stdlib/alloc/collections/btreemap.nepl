//: # btreemap
//: [順序付き/じゅんじょつき] map
//:
//: ### [目的/もくてき]
//: - `BTreeMap<.K, .V>` を[提供/ていきょう]し、`new` / `insert` / `get` / `contains` / `remove` / `len` / `clear` / `free` の bare 名で[扱/あつか]えるようにします。
//: - 互換名 `BTreeMap` に[加/くわ]えて、sorted-array としての[性質/せいしつ]を[明示/めいじ]する `sorted_array_map_*` alias を[提供/ていきょう]します。
//: - key の[比較/ひかく]は `Ord` trait に[委譲/いじょう]し、`i32` 固定から[脱却/だっきゃく]します。
//:
//: ### [実装/じっそう]
//: - [名前/なまえ]は `BTreeMap` ですが、[現実/げんじつ]の[内部表現/ないぶひょうげん]は[整列済/せいれつず]み key/value [配列/はいれつ]です。
//: - backing storage は `Vec<Option<K>>` / `Vec<Option<V>>` で[保持/ほじ]し、live slot は `Some`、inactive slot は `None` で[表/あらわ]します。
//: - [検索/けんさく]は lower_bound、[挿入/そうにゅう] / [削除/さくじょ]は shift で[実装/じっそう]します。
//: - `sorted_array_map_*` alias は[同/おな]じ[実装/じっそう]を[指/さ]し、B-tree [相当/そうとう]の[更新/こうしん][性能/せいのう]を[期待/きたい]しない[用途/ようと]であることを[呼/よ]び[出/だ]し[名/めい]に[残/のこ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree ではありません。
//: - 大きな mutable table、symbol table、module table、diagnostic table には[使/つか]わないでください。更新が[多/おお]い[表/ひょう]は `HashMap` / `HashSet` を[使/つか]い、安定順の[出力/しゅつりょく]が[必要/ひつよう]な[段階/だんかい]だけ key を[整列/せいれつ]する[構造/こうぞう]を[選/えら]びます。
//: - `.K` / `.V` は `Copy` を[要求/ようきゅう]します。現行 stdlib には map payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `contains` / `get` は map を[値/あたい]で[消費/しょうひ]し、内部 storage を[閉/と]じます。owner を[残/のこ]す[読/よ]み[取/と]りは `len_ref` / `contains_ref` / `get_ref` を[使/つか]います。
//: - `Ord` impl が[全順序/ぜんじゅんじょ]を[満/み]たすことを[前提/ぜんてい]にします。
//:
//: ### [計算量/けいさんりょう]
//: - `get_ref` / `contains_ref` は O(log n)、`insert` / `remove` は O(n) です。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BTreeMapStorage
//: [順序付き/じゅんじょつき] map の backing storage
//:
//: ### [目的/もくてき]
//: - key 配列と value 配列の owner を 1 [値/あたい]として[保持/ほじ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `keys.len == values.len == cap`
//: - `0 <= i < len` の slot は key/value とも `Some`
//: - `len <= i < cap` の slot は key/value とも `None`
struct BTreeMapStorage<.K,.V>:
    keys <Vec<Option<.K>>>
    values <Vec<Option<.V>>>

//: ## BTreeMap
//: [順序付き/じゅんじょつき] key/value [配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - key と value の[整列済/せいれつず]み[配列/はいれつ]を 1 [値/あたい]として[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree node [分割/ぶんかつ]は[持/も]たず、lower_bound と shift で[動/うご]く[単純/たんじゅん][実装/じっそう]です。
struct BTreeMap<.K,.V>:
    len <i32>
    cap <i32>
    storage <BTreeMapStorage<.K,.V>>

fn btreemap_storage_keys <.K,.V> <(&BTreeMapStorage<.K,.V>)->&Vec<Option<.K>>> (storage):
    field::get_ref storage "keys"

fn btreemap_storage_values <.K,.V> <(&BTreeMapStorage<.K,.V>)->&Vec<Option<.V>>> (storage):
    field::get_ref storage "values"

fn key_eq <.K: Ord> <(.K,.K)->bool> (a, b):
    and not ord_lt a b not ord_lt b a

fn btreemap_key_at <.K: Copy> <(&Vec<Option<.K>>,i32)->Option<.K>> (keys, idx):
    match vec::get_ref<Option<.K>> keys idx:
        Option::Some key_opt:
            key_opt
        Option::None:
            none<.K>

fn btreemap_value_at <.V: Copy> <(&Vec<Option<.V>>,i32)->Option<.V>> (values, idx):
    match vec::get_ref<Option<.V>> values idx:
        Option::Some value_opt:
            value_opt
        Option::None:
            none<.V>

fn btreemap_store_key <.K: Copy> <(&Vec<Option<.K>>,i32,Option<.K>)*>()> (keys, idx, key):
    vec::replace_ref<Option<.K>> keys idx key

fn btreemap_store_value <.V: Copy> <(&Vec<Option<.V>>,i32,Option<.V>)*>()> (values, idx, value):
    vec::replace_ref<Option<.V>> values idx value

fn btreemap_key_slot <.K: Copy,.V> <(&BTreeMapStorage<.K,.V>,i32)->Option<.K>> (storage, idx):
    btreemap_key_at<.K> btreemap_storage_keys<.K,.V> storage idx

fn btreemap_value_slot <.K,.V: Copy> <(&BTreeMapStorage<.K,.V>,i32)->Option<.V>> (storage, idx):
    btreemap_value_at<.V> btreemap_storage_values<.K,.V> storage idx

fn btreemap_store_key_slot <.K: Copy,.V> <(&BTreeMapStorage<.K,.V>,i32,Option<.K>)*>()> (storage, idx, key):
    btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage idx key

fn btreemap_store_value_slot <.K,.V: Copy> <(&BTreeMapStorage<.K,.V>,i32,Option<.V>)*>()> (storage, idx, value):
    btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage idx value

fn lower_bound <.K: Ord&Copy> <(&Vec<Option<.K>>,.K,i32,i32)->i32> (keys, key, low, high):
    if:
        lt low high
        then:
            let mid <i32> div_s add low high 2
            match btreemap_key_at<.K> keys mid:
                Option::Some saved:
                    if:
                        ord_lt saved key
                        then lower_bound<.K> keys key add mid 1 high
                        else lower_bound<.K> keys key low mid
                Option::None:
                    mid
        else low

fn is_at <.K: Ord&Copy> <(&Vec<Option<.K>>,i32,i32,.K)->bool> (keys, len0, idx, key):
    if:
        lt idx len0
        then:
            match btreemap_key_at<.K> keys idx:
                Option::Some saved:
                    key_eq<.K> saved key
                Option::None:
                    false
        else false

fn btreemap_lower_bound_storage <.K: Ord&Copy,.V> <(&BTreeMapStorage<.K,.V>,.K,i32,i32)->i32> (storage, key, low, high):
    lower_bound<.K> btreemap_storage_keys<.K,.V> storage key low high

fn btreemap_is_at_storage <.K: Ord&Copy,.V> <(&BTreeMapStorage<.K,.V>,i32,i32,.K)->bool> (storage, len0, idx, key):
    is_at<.K> btreemap_storage_keys<.K,.V> storage len0 idx key

fn btreemap_free_storage <.K,.V> <(BTreeMapStorage<.K,.V>)->()> (storage):
    let keys <Vec<Option<.K>>> field::get storage "keys"
    let values <Vec<Option<.V>>> field::get storage "values"
    vec::free<Option<.K>> keys
    vec::free<Option<.V>> values

fn btreemap_alloc_storage <.K: Copy,.V: Copy> <(i32)*>Result<BTreeMapStorage<.K,.V>, Diag>> (cap):
    match vec::filled<Option<.K>> cap none<.K>:
        Result::Err _e:
            diag_err<BTreeMapStorage<.K,.V>> diag_out_of_memory
        Result::Ok keys:
            match vec::filled<Option<.V>> cap none<.V>:
                Result::Err _e:
                    vec::free<Option<.K>> keys
                    diag_err<BTreeMapStorage<.K,.V>> diag_out_of_memory
                Result::Ok values:
                    ok<BTreeMapStorage<.K,.V>, Diag> BTreeMapStorage<.K,.V> keys values

fn btreemap_copy_live_slots <.K: Copy,.V: Copy> <(&BTreeMapStorage<.K,.V>,&BTreeMapStorage<.K,.V>,i32)*>()> (src, dst, len0):
    let src_keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> src
    let src_values <&Vec<Option<.V>>> btreemap_storage_values<.K,.V> src
    let dst_keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> dst
    let dst_values <&Vec<Option<.V>>> btreemap_storage_values<.K,.V> dst
    let mut i <i32> 0
    while lt i len0:
        do:
            match btreemap_key_at<.K> src_keys i:
                Option::Some key:
                    btreemap_store_key<.K> dst_keys i some<.K> key
                Option::None:
                    ()
            match btreemap_value_at<.V> src_values i:
                Option::Some value:
                    btreemap_store_value<.V> dst_values i some<.V> value
                Option::None:
                    ()
            set i add i 1

fn btreemap_clear_slots <.K: Copy,.V: Copy> <(&BTreeMapStorage<.K,.V>,i32,i32)*>()> (storage, end, i):
    if:
        lt i end
        then:
            btreemap_store_key<.K> btreemap_storage_keys<.K,.V> storage i none<.K>
            btreemap_store_value<.V> btreemap_storage_values<.K,.V> storage i none<.V>
            btreemap_clear_slots<.K,.V> storage end add i 1
        else:
            ()

fn btreemap_shift_right <.K: Copy,.V: Copy> <(&BTreeMapStorage<.K,.V>,i32,i32)*>()> (storage, idx, len0):
    let mut i <i32> len0
    while gt i idx:
        do:
            let from <i32> sub i 1
            match btreemap_key_slot<.K,.V> storage from:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some<.K> saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none<.K>
            match btreemap_value_slot<.K,.V> storage from:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some<.V> saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none<.V>
            set i from

fn btreemap_shift_left_after_remove <.K: Copy,.V: Copy> <(&BTreeMapStorage<.K,.V>,i32,i32)*>()> (storage, idx, len0):
    let last <i32> sub len0 1
    let mut i <i32> idx
    while lt i last:
        do:
            let nxt <i32> add i 1
            match btreemap_key_slot<.K,.V> storage nxt:
                Option::Some saved_key:
                    btreemap_store_key_slot<.K,.V> storage i some<.K> saved_key
                Option::None:
                    btreemap_store_key_slot<.K,.V> storage i none<.K>
            match btreemap_value_slot<.K,.V> storage nxt:
                Option::Some saved_value:
                    btreemap_store_value_slot<.K,.V> storage i some<.V> saved_value
                Option::None:
                    btreemap_store_value_slot<.K,.V> storage i none<.V>
            set i nxt
    btreemap_store_key_slot<.K,.V> storage last none<.K>
    btreemap_store_value_slot<.K,.V> storage last none<.V>

fn grow <.K: Copy,.V: Copy> <(BTreeMap<.K,.V>)*>Result<BTreeMap<.K,.V>, Diag>> (hm):
    let len0 <i32> *field::get_ref &hm "len"
    let cap0 <i32> *field::get_ref &hm "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    let cap1 <i32> mul cap0 2
    match btreemap_alloc_storage<.K,.V> cap1:
        Result::Err d:
            btreemap_free_storage<.K,.V> storage
            err<BTreeMap<.K,.V>, Diag> d
        Result::Ok next_storage:
            btreemap_copy_live_slots<.K,.V> &storage &next_storage len0
            btreemap_free_storage<.K,.V> storage
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> len0 cap1 next_storage

//: ## new
//: [空/から]の `BTreeMap<.K, .V>` を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     if eq len hm 0 1 0
//: ```
fn new <.K: Copy,.V: Copy> <()*>Result<BTreeMap<.K,.V>, Diag>> ():
    let cap <i32> 8
    match btreemap_alloc_storage<.K,.V> cap:
        Result::Err d:
            err<BTreeMap<.K,.V>, Diag> d
        Result::Ok storage:
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> 0 cap storage

//: ## len
//: map を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 3 30 |> uwok
//:         |> insert 7 70 |> uwok
//:     if eq len hm 2 1 0
//: ```
fn len <.K,.V> <(BTreeMap<.K,.V>)->i32> (hm):
    let n <i32> len_ref<.K,.V> &hm
    free<.K,.V> hm
    n

//: ## len_ref
//: map を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len_ref <.K,.V> <(&BTreeMap<.K,.V>)->i32> (hm):
    *field::get_ref hm "len"

//: ## contains
//: map を[消費/しょうひ]して key の[存在/そんざい]を[確/たし]かめる
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     if contains hm 7 1 0
//: ```
fn contains <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K)->bool> (hm, key):
    let ok <bool> contains_ref<.K,.V> &hm key
    free<.K,.V> hm
    ok

//: ## contains_ref
//: map を[移動/いどう]せずに key の[存在/そんざい]を[確/たし]かめる
fn contains_ref <.K: Ord&Copy,.V: Copy> <(&BTreeMap<.K,.V>,.K)->bool> (hm, key):
    let len0 <i32> *field::get_ref hm "len"
    let storage <&BTreeMapStorage<.K,.V>> field::get_ref hm "storage"
    let keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> storage
    let idx <i32> lower_bound<.K> keys key 0 len0
    is_at<.K> keys len0 idx key

//: ## get
//: map を[消費/しょうひ]して key に[対応/たいおう]する value を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:     match get hm 7:
//:         Option::Some v:
//:             if eq v 70 1 0
//:         Option::None:
//:             0
//: ```
fn get <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K)->Option<.V>> (hm, key):
    let value <Option<.V>> get_ref<.K,.V> &hm key
    free<.K,.V> hm
    value

//: ## get_ref
//: map を[移動/いどう]せずに key に[対応/たいおう]する Copy value を[返/かえ]す
fn get_ref <.K: Ord&Copy,.V: Copy> <(&BTreeMap<.K,.V>,.K)->Option<.V>> (hm, key):
    let len0 <i32> *field::get_ref hm "len"
    let storage <&BTreeMapStorage<.K,.V>> field::get_ref hm "storage"
    let keys <&Vec<Option<.K>>> btreemap_storage_keys<.K,.V> storage
    let values <&Vec<Option<.V>>> btreemap_storage_values<.K,.V> storage
    let idx <i32> lower_bound<.K> keys key 0 len0
    if:
        is_at<.K> keys len0 idx key
        then btreemap_value_at<.V> values idx
        else none<.V>

//: ## btreemap_insert_ready
//: [容量/ようりょう]が[足/た]りている `BTreeMap` に key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [目的/もくてき]
//: - public `insert` が grow の[成功/せいこう]を[確認/かくにん]したあと、実際の lower_bound / shift / store を[一箇所/いっかしょ]で[行/おこな]います。
//: - grow [失敗/しっぱい]を `unwrap_ok` で trap にしないため、確保を伴う[準備/じゅんび]と確保後の[挿入/そうにゅう]を[分離/ぶんり]します。
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound は O(log n)、挿入時の shift は O(n) です。
fn btreemap_insert_ready <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm1, key, value):
    let len0 <i32> *field::get_ref &hm1 "len"
    let cap0 <i32> *field::get_ref &hm1 "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm1 "storage"
    let idx <i32> btreemap_lower_bound_storage<.K,.V> &storage key 0 len0
    if:
        btreemap_is_at_storage<.K,.V> &storage len0 idx key
        then:
            btreemap_store_value_slot<.K,.V> &storage idx some<.V> value
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> len0 cap0 storage
        else:
            btreemap_shift_right<.K,.V> &storage idx len0
            btreemap_store_key_slot<.K,.V> &storage idx some<.K> key
            btreemap_store_value_slot<.K,.V> &storage idx some<.V> value
            ok<BTreeMap<.K,.V>, Diag> BTreeMap<.K,.V> add len0 1 cap0 storage

//: ## insert
//: key/value を[挿入/そうにゅう]または[更新/こうしん]する
//:
//: ### [実装/じっそう]
//: - 現在の[容量/ようりょう]が[満杯/まんぱい]なら `grow` を[実行/じっこう]し、`Result::Err` はそのまま[返/かえ]します。
//: - 確保に[成功/せいこう]した map、または元から[余裕/よゆう]のある map だけを `btreemap_insert_ready` に[渡/わた]します。
//:
//: ### [失敗/しっぱい]
//: - grow 用 key/value buffer の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Diag::OutOfMemory` を[返/かえ]し、trap しません。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(n)、grow が[起/お]きる[回/かい]は既存要素の copy を含め O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> insert 3 30 |> uwok
//:     if eq len hm 2 1 0
//: ```
fn insert <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K,.V)*>Result<BTreeMap<.K,.V>, Diag>> (hm, key, value):
    let len_init <i32> *field::get_ref &hm "len"
    let cap_init <i32> *field::get_ref &hm "cap"
    if:
        eq len_init cap_init
        then:
            match grow<.K,.V> hm:
                Result::Ok hm1:
                    btreemap_insert_ready<.K,.V> hm1 key value
                Result::Err d:
                    err<BTreeMap<.K,.V>, Diag> d
        else btreemap_insert_ready<.K,.V> hm key value

//: ## remove
//: key を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> remove 7
//:     if eq len hm 0 1 0
//: ```
fn remove <.K: Ord&Copy,.V: Copy> <(BTreeMap<.K,.V>,.K)*>BTreeMap<.K,.V>> (hm, key):
    let len0 <i32> *field::get_ref &hm "len"
    let cap0 <i32> *field::get_ref &hm "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    let idx <i32> btreemap_lower_bound_storage<.K,.V> &storage key 0 len0
    if:
        not btreemap_is_at_storage<.K,.V> &storage len0 idx key
        then BTreeMap<.K,.V> len0 cap0 storage
        else:
            let last <i32> sub len0 1
            btreemap_shift_left_after_remove<.K,.V> &storage idx len0
            BTreeMap<.K,.V> last cap0 storage

//: ## clear
//: [全要素/ぜんようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>>:
//:         unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>
//:         |> insert 7 70 |> uwok
//:         |> clear
//:     if eq len hm 0 1 0
//: ```
fn clear <.K: Copy,.V: Copy> <(BTreeMap<.K,.V>)*>BTreeMap<.K,.V>> (hm):
    let len0 <i32> *field::get_ref &hm "len"
    let cap0 <i32> *field::get_ref &hm "cap"
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    btreemap_clear_slots<.K,.V> &storage len0 0
    BTreeMap<.K,.V> 0 cap0 storage

//: ## free
//: [内部/ないぶ] storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreemap" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let hm <BTreeMap<i32, i32>> unwrap_ok<BTreeMap<i32, i32>, Diag> new<i32, i32>;
//:     free hm;
//:     0
//: ```
fn free <.K,.V> <(BTreeMap<.K,.V>)->()> (hm):
    let storage <BTreeMapStorage<.K,.V>> field::get hm "storage"
    btreemap_free_storage<.K,.V> storage

//: ## sorted_array_map_new
//: sorted-array map として `new` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [目的/もくてき]
//: - `BTreeMap` 互換[実装/じっそう]を、B-tree ではなく sorted-array map として[意図/いと]して[選/えら]んだことを API [名/めい]に[残/のこ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `new` と[同/おな]じです。
fn sorted_array_map_new new;

//: ## sorted_array_map_insert
//: sorted-array map として `insert` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 挿入位置以降を shift するため O(n) です。大量の逐次 insert には[使/つか]わないでください。
fn sorted_array_map_insert insert;

//: ## sorted_array_map_get
//: sorted-array map として `get` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound により O(log n) です。
fn sorted_array_map_get get;

//: ## sorted_array_map_contains
//: sorted-array map として `contains` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound により O(log n) です。
fn sorted_array_map_contains contains;

//: ## sorted_array_map_remove
//: sorted-array map として `remove` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 削除位置以降を shift するため O(n) です。
fn sorted_array_map_remove remove;

//: ## sorted_array_map_len
//: sorted-array map として `len` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `len` と[同/おな]じ O(1) です。
fn sorted_array_map_len len;

//: ## sorted_array_map_clear
//: sorted-array map として `clear` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `clear` と[同/おな]じ O(n) です。
fn sorted_array_map_clear clear;

//: ## sorted_array_map_free
//: sorted-array map として `free` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - `free` と[同/おな]じく、内部 key/value [配列/はいれつ]を[解放/かいほう]します。
fn sorted_array_map_free free;
