//: # queue
//: `Vec<Option<T>>` backed FIFO queue
//:
//: ### [目的/もくてき]
//: - [末尾/まつび]へ[追加/ついか]し、[先頭/せんとう]から[取/と]り[出/だ]す queue API を[提供/ていきょう]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` / `head` と `items` を struct field として[保持/ほじ]します。
//: - `items` は `cap` [個/こ]の `Option<T>` で、live slot は `Some(value)`、inactive slot は `None` です。
//: - grow 時は[論理順/ろんりじゅん]に新しい `Vec<Option<T>>` へ[写/うつ]し、旧 `Vec` owner を[解放/かいほう]します。
//:
//: ### [注意/ちゅうい]
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には queue payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `is_empty` / `peek` / `pop` は `Queue` を[値/あたい]で[消費/しょうひ]し、内部 storage を[閉/と]じます。owner を[残/のこ]したまま[観測/かんそく]する場合は `len_ref` / `is_empty_ref` / `peek_ref` を[使/つか]います。
//: - `free` [後/ご]の[再利用/さいりよう]は[禁止/きんし]です。
//:
//: ### [計算量/けいさんりょう]
//: - `len_ref` / `is_empty_ref` / `peek_ref` / `pop` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、grow 時は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## Queue
//: FIFO queue の owner
//:
//: ### [目的/もくてき]
//: - queue state と backing storage owner を 1 [値/あたい]として[移動/いどう]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`
struct Queue<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>

//: ## QueuePop
//: `pop_front` の[結果/けっか]
//:
//: ### [目的/もくてき]
//: - [更新後/こうしんご]の queue owner と[取/と]り[出/だ]した[値/あたい]を[同時/どうじ]に[返/かえ]します。
struct QueuePop<.T>:
    queue <Queue<.T>>
    item <Option<.T>>

fn queue_normalize_capacity <(i32)->i32> (cap):
    if lt cap 1 1 cap

fn queue_tail_index <(i32,i32,i32)->i32> (head, len, cap):
    rem_u add head len cap

fn queue_next_index <(i32,i32)->i32> (idx, cap):
    rem_u add idx 1 cap

//: queue_item_at: slot の `Option<T>` を[読/よ]み[出/だ]す
fn queue_item_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (items, idx):
    match vec::get<Option<.T>> items idx:
        Option::Some item:
            item
        Option::None:
            none<.T>

//: queue_store_slot: slot state を[更新/こうしん]する
fn queue_store_slot <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (items, idx, item):
    vec::replace<Option<.T>> items idx item

fn queue_alloc_slots <.T: Copy> <(i32)*>Result<Vec<Option<.T>>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Ok items:
            ok<Vec<Option<.T>>, Diag> items
        Result::Err _e:
            diag_err<Vec<Option<.T>>> diag_out_of_memory

fn queue_clear_slots_loop <.T: Copy> <(&Vec<Option<.T>>,i32,i32)*>()> (items, cap, i):
    if:
        lt i cap
        then:
            queue_store_slot<.T> items i none<.T>
            queue_clear_slots_loop<.T> items cap add i 1
        else:
            ()

fn queue_copy_live_slots <.T: Copy> <(&Vec<Option<.T>>,&Vec<Option<.T>>,i32,i32,i32)*>()> (src, dst, cap, head, len):
    let mut i <i32> 0
    while lt i len:
        do:
            let src_idx <i32> rem_u add head i cap
            match queue_item_at<.T> src src_idx:
                Option::Some item:
                    queue_store_slot<.T> dst i some<.T> item
                Option::None:
                    ()
            set i add i 1

//: ## new
//: [空/から]の queue を[作/つく]る
fn new <.T: Copy> <()*>Result<Queue<.T>, Diag>> ():
    with_capacity<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して queue を[作/つく]る
fn with_capacity <.T: Copy> <(i32)*>Result<Queue<.T>, Diag>> (cap):
    let cap0 <i32> queue_normalize_capacity cap
    match queue_alloc_slots<.T> cap0:
        Result::Err d:
            err<Queue<.T>, Diag> d
        Result::Ok items:
            ok<Queue<.T>, Diag> Queue<.T> 0 cap0 0 items

//: ## len
//: queue を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
fn len <.T> <(Queue<.T>)->i32> (q):
    let n <i32> *field::get_ref &q "len"
    free<.T> q
    n

//: ## len_ref
//: `Queue` を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len_ref <.T> <(&Queue<.T>)->i32> (q):
    *field::get_ref q "len"

//: ## is_empty
//: queue を[消費/しょうひ]して[空/から]かどうかを[返/かえ]す
fn is_empty <.T> <(Queue<.T>)->bool> (q):
    let ok <bool> is_empty_ref<.T> &q
    free<.T> q
    ok

//: ## is_empty_ref
//: `Queue` を[移動/いどう]せずに[空/から]かどうかを[返/かえ]す
fn is_empty_ref <.T> <(&Queue<.T>)->bool> (q):
    eq len_ref<.T> q 0

//: ## push
//: [末尾/まつび]へ[追加/ついか]する
fn push <.T: Copy> <(Queue<.T>,.T)*>Result<Queue<.T>, Diag>> (q, item):
    let len0 <i32> *field::get_ref &q "len"
    let cap0 <i32> *field::get_ref &q "cap"
    let head0 <i32> *field::get_ref &q "head"
    let items <Vec<Option<.T>>> field::get q "items"
    if:
        eq len0 cap0
        then:
            let new_cap <i32> mul cap0 2
            match queue_alloc_slots<.T> new_cap:
                Result::Err d:
                    vec::free<Option<.T>> items
                    err<Queue<.T>, Diag> d
                Result::Ok new_items:
                    queue_copy_live_slots<.T> &items &new_items cap0 head0 len0
                    queue_store_slot<.T> &new_items len0 some<.T> item
                    vec::free<Option<.T>> items
                    ok<Queue<.T>, Diag> Queue<.T> add len0 1 new_cap 0 new_items
        else:
            let tail <i32> queue_tail_index head0 len0 cap0
            queue_store_slot<.T> &items tail some<.T> item
            ok<Queue<.T>, Diag> Queue<.T> add len0 1 cap0 head0 items

//: ## pop_front
//: [先頭/せんとう]を[取/と]り[出/だ]し、[更新後/こうしんご]の queue と[値/あたい]を[返/かえ]す
fn pop_front <.T: Copy> <(Queue<.T>)*>QueuePop<.T>> (q):
    let len0 <i32> *field::get_ref &q "len"
    let cap0 <i32> *field::get_ref &q "cap"
    let head0 <i32> *field::get_ref &q "head"
    let items <Vec<Option<.T>>> field::get q "items"
    if:
        eq len0 0
        then:
            let next_q <Queue<.T>> Queue<.T> 0 cap0 head0 items
            QueuePop<.T> next_q none<.T>
        else:
            let item <Option<.T>> queue_item_at<.T> &items head0
            queue_store_slot<.T> &items head0 none<.T>
            let next_len <i32> sub len0 1
            let next_head <i32> queue_next_index head0 cap0
            let next_q <Queue<.T>> Queue<.T> next_len cap0 next_head items
            QueuePop<.T> next_q item

//: ## pop
//: queue を[消費/しょうひ]して[先頭/せんとう]の[値/あたい]だけを[返/かえ]す
fn pop <.T: Copy> <(Queue<.T>)*>Option<.T>> (q):
    let p <QueuePop<.T>> pop_front<.T> q
    let item <Option<.T>> *field::get_ref &p "item"
    free<.T> field::get p "queue"
    item

//: ## peek
//: queue を[消費/しょうひ]して[先頭/せんとう]を[読/よ]む
fn peek <.T: Copy> <(Queue<.T>)->Option<.T>> (q):
    let item <Option<.T>> peek_ref<.T> &q
    free<.T> q
    item

//: ## peek_ref
//: `Queue` を[移動/いどう]せずに[先頭/せんとう]を[読/よ]む
fn peek_ref <.T: Copy> <(&Queue<.T>)->Option<.T>> (q):
    let len0 <i32> *field::get_ref q "len"
    if:
        eq len0 0
        then:
            none<.T>
        else:
            let head0 <i32> *field::get_ref q "head"
            let items <&Vec<Option<.T>>> field::get_ref q "items"
            queue_item_at<.T> items head0

//: ## clear
//: [内容/ないよう]を[空/から]にする
fn clear <.T: Copy> <(Queue<.T>)*>Queue<.T>> (q):
    let cap0 <i32> *field::get_ref &q "cap"
    let items <Vec<Option<.T>>> field::get q "items"
    queue_clear_slots_loop<.T> &items cap0 0
    Queue<.T> 0 cap0 0 items

//: ## free
//: queue が[所有/しょゆう]する backing storage を[解放/かいほう]する
fn free <.T> <(Queue<.T>)->()> (q):
    vec::free<Option<.T>> field::get q "items"
