//: # list/transform
//: `List` の変換操作
//:
//: ### [目的/もくてき]
//: - input owner を消費し、新しい `Vec` storage を持つ output list を返します。
//: - 失敗時は部分的な output storage owner だけを閉じ、input owner は `ListTransformError<T>` に戻します。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/field" as *

//: map: 各要素へ[関数/かんすう]を[適用/てきよう]して[新/あたら]しい list を[返/かえ]す
pub fn map <.T: Copy,.U: Copy> %impure fn List .T impure fn fn .T .U Result List .U ListTransformError .T \lst\f:
    let items %Vec .T field::get lst "items"
    let n %i32 vec::len &items
    let out_result %Result Vec .U StdErrorKind vec::with_capacity n
    match out_result:
        Result::Err e:
            Result::Err ListTransformError<.T> (List<.T> items) (list_diag_from_vec_error e)
        Result::Ok out0:
            let mut out %Vec .U out0
            let mut i %i32 0
            let mut failed %bool false
            let mut failure %StdErrorKind StdErrorKind::OutOfMemory
            while and lt i n not failed:
                do:
                    match vec::get &items i:
                        Option::Some value:
                            let mapped %.U f value
                            match vec::push out mapped:
                                Result::Ok next_out:
                                    set out next_out
                                    set i add i 1
                                Result::Err e:
                                    let error %StdErrorKind vec::vec_push_error_kind &e
                                    set out vec::vec_push_error_vec e
                                    set failure error
                                    set failed true
                        Option::None:
                            set failure StdErrorKind::InvalidOperation
                            set failed true
            if:
                failed
                then:
                    vec::free out
                    Result::Err ListTransformError<.T> (List<.T> items) (list_diag_from_vec_error failure)
                else:
                    vec::free items
                    Result::Ok List<.U> out

//: filter: 条件を[満/み]たす[要素/ようそ]だけを[残/のこ]す
pub fn filter <.T: Copy> %impure fn List .T impure fn fn .T bool Result List .T ListTransformError .T \lst\p:
    let items %Vec .T field::get lst "items"
    let n %i32 vec::len &items
    let out_result %Result Vec .T StdErrorKind vec::with_capacity n
    match out_result:
        Result::Err e:
            Result::Err ListTransformError<.T> (List<.T> items) (list_diag_from_vec_error e)
        Result::Ok out0:
            let mut out %Vec .T out0
            let mut i %i32 0
            let mut failed %bool false
            let mut failure %StdErrorKind StdErrorKind::OutOfMemory
            while and lt i n not failed:
                do:
                    match vec::get &items i:
                        Option::Some value:
                            if:
                                p value
                                then:
                                    match vec::push out value:
                                        Result::Ok next_out:
                                            set out next_out
                                        Result::Err e:
                                            let error %StdErrorKind vec::vec_push_error_kind &e
                                            set out vec::vec_push_error_vec e
                                            set failure error
                                            set failed true
                                else:
                                    unit
                            set i add i 1
                        Option::None:
                            set failure StdErrorKind::InvalidOperation
                            set failed true
            if:
                failed
                then:
                    vec::free out
                    Result::Err ListTransformError<.T> (List<.T> items) (list_diag_from_vec_error failure)
                else:
                    vec::free items
                    Result::Ok List<.T> out
