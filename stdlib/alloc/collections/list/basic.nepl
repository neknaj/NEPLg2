//: # list/basic
//: `List` の構築、先頭操作、反転、解放
//:
//: ### [目的/もくてき]
//: - owner を消費して storage を作る/更新する基本操作を提供します。
//: - observer は `query` module に分離し、owner 消費と borrow query を混在させません。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/field" as *

//: new: [空/から] list を[作/つく]る
//:
//: ### [実装/じっそう]
//: - `Vec.new` で backing storage を[作/つく]り、`List` owner として[包/つつ]みます。
pub fn new <.T: Copy> %impure fn void Result List .T Diag \void:
    let items_result %Result Vec .T StdErrorKind vec::new
    match items_result:
        Result::Ok items:
            ok List<.T> items
        Result::Err e:
            diag_err list_diag_from_vec_error e

//: cons: [先頭/せんとう]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [実装/じっそう]
//: - 論理先頭は storage 末尾なので、`Vec.push` だけで先頭追加になります。
pub fn cons <.T: Copy> %impure fn .T impure fn List .T Result List .T ListPushError .T \head\tail:
    let items %Vec .T field::get tail "items"
    match vec::push items head:
        Result::Ok next_items:
            Result::Ok List<.T> next_items
        Result::Err e:
            let error %StdErrorKind vec::vec_push_error_kind &e
            let returned_items %Vec .T vec::vec_push_error_vec e
            Result::Err ListPushError<.T> (List<.T> returned_items) (list_diag_from_vec_error error)

//: push: pipe [向/む]けに[先頭/せんとう][追加/ついか]する
pub fn push <.T: Copy> %impure fn List .T impure fn .T Result List .T ListPushError .T \lst\head:
    cons<.T> head lst

//: tail: list を[消費/しょうひ]して[先頭/せんとう]を[除/のぞ]いた list を[返/かえ]す
//:
//: ### [実装/じっそう]
//: - 論理先頭は storage 末尾なので、`Vec.pop` で先頭を[取/と]り[除/のぞ]きます。
pub fn tail <.T: Copy> %impure fn List .T Option List .T \lst:
    let items %Vec .T field::get lst "items"
    if:
        eq vec::len &items 0
        then:
            vec::free items
            none
        else:
            let popped %VecPop .T vec::pop items
            let item %Option .T vec::vec_pop_item &popped
            let next_items %Vec .T vec::vec_pop_vec popped
            match item:
                Option::Some _head:
                    some List<.T> next_items
                Option::None:
                    vec::free next_items
                    none

//: reverse: list を[消費/しょうひ]して[論理順序/ろんりじゅんじょ]を[反転/はんてん]する
pub fn reverse <.T: Copy> %impure fn List .T List .T \lst:
    let items %Vec .T field::get lst "items"
    let n %i32 vec::len &items
    list_reverse_items<.T> &items 0 sub n 1
    List<.T> items

//: free: Copy-only list storage owner を[閉/と]じる
pub fn free <.T: Copy> %impure fn List .T unit \lst:
    list_free_items<.T> lst
