//: # list/storage
//: `List` の storage helper
//:
//: ### [目的/もくてき]
//: - Vec error 変換、論理 index 変換、storage owner 解放、in-place reverse を集約します。
//: - public API が raw pointer や node sentinel を扱わない構成を保ちます。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "core/field" as *

//: list_diag_from_vec_error: Vec storage の error を list API の Diag に[変換/へんかん]する
pub fn list_diag_from_vec_error %impure fn StdErrorKind Diag \kind:
    diag_error kind "list storage operation failed"

//: list_physical_index: 論理 index を storage index に[変換/へんかん]する
pub fn list_physical_index %fn i32 fn i32 i32 \len0\idx:
    sub sub len0 1 idx

//: list_free_items: Copy-only List から storage owner を[取/と]り[出/だ]して[解放/かいほう]する
pub fn list_free_items <.T: Copy> %impure fn List .T unit \lst:
    let items %Vec .T field::get lst "items"
    vec::free items

//: list_reverse_items: storage 順序を in-place に[反転/はんてん]する
pub fn list_reverse_items <.T: Copy> %impure fn &Vec .T impure fn i32 impure fn i32 unit \items\left0\right0:
    let mut left %i32 left0
    let mut right %i32 right0
    while lt left right:
        do:
            match vec::get items left:
                Option::Some left_value:
                    match vec::get items right:
                        Option::Some right_value:
                            vec::replace items left right_value
                            vec::replace items right left_value
                        Option::None:
                            unit
                Option::None:
                    unit
            set left add left 1
            set right sub right 1
