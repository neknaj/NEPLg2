//: # deque/types
//: double-ended queue の owner 型
//:
//: ### [目的/もくてき]
//: - deque state と backing storage owner を struct field として[表/あらわ]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`

#indent 4

#import "core/option" as *
#import "alloc/collections/vec" as vec

//: ## Deque
//: [両端/りょうたん] queue の owner
struct Deque<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>
