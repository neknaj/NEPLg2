//: # deque/types
//: double-ended queue の owner 型と pop 結果型
//:
//: ### [目的/もくてき]
//: - deque state と backing storage owner を struct field として[表/あらわ]します。
//: - raw header / raw element buffer ではなく、初期化済み `Vec<Option<T>>` で slot state を[表/あらわ]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `0 <= len <= cap`
//: - `0 <= head < cap`
//: - `items.len == cap`

#indent 4

#import "core/option" as *
#import "alloc/collections/vec" as vec

//: ## Deque
//: [両端/りょうたん] queue の owner
pub struct Deque<.T>:
    len <i32>
    cap <i32>
    head <i32>
    items <Vec<Option<.T>>>

//: ## DequePop
//: `pop_front` / `pop_back` の[結果/けっか]
//:
//: ### [目的/もくてき]
//: - [更新後/こうしんご]の deque owner と[取/と]り[出/だ]した[値/あたい]を[同時/どうじ]に[返/かえ]します。
//: - 利用側は `deque_pop_item` で item を[読/よ]み、`deque_pop_deque` で[次/つぎ]の deque owner を[受/う]け[取/と]ります。
pub struct DequePop<.T>:
    deque <Deque<.T>>
    item <Option<.T>>
