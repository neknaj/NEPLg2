//: # btreeset/storage
//: `BTreeSet` の backing storage 操作
//:
//: ### [目的/もくてき]
//: - key slot の読み書き、shift、grow、storage 解放を所有します。
//: - public API が raw storage layout を直接扱わないようにします。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "core/field" as *
#import "core/math" as *

//: 現行 storage view は `Vec<Option<T>>` の payload storage 形状を返すため、non-Copy collection drop traversal が入るまで Copy に限定します。
//:
//: neplg2:test[compile_fail]
//: diag_code: type.trait_bound.unsatisfied
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset/storage" as *
//:| #import "alloc/collections/btreeset/types" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: struct CleanupPayload:
//:     value %i32
//: fn borrow_keys %fn &BTreeSetStorage CleanupPayload &Vec Option CleanupPayload \storage:
//:     btreeset_storage_keys<CleanupPayload> storage
//: fn main %fn () i32 \():
//:     0
//: ```
pub fn btreeset_storage_keys <.T: Copy> %fn &BTreeSetStorage .T &Vec Option .T \storage:
    field::get_ref storage "keys"

pub fn btreeset_key_at <.T: Copy> %fn &Vec Option .T fn i32 Option .T \keys\idx:
    match vec::get<Option<.T>> keys idx:
        Option::Some key_opt:
            key_opt
        Option::None:
            none<.T>

pub fn btreeset_store_key <.T: Copy> %impure fn &Vec Option .T impure fn i32 impure fn Option .T () \keys\idx\key:
    vec::replace<Option<.T>> keys idx key

pub fn btreeset_key_slot <.T: Copy> %fn &BTreeSetStorage .T fn i32 Option .T \storage\idx:
    btreeset_key_at<.T> btreeset_storage_keys<.T> storage idx

pub fn btreeset_store_key_slot <.T: Copy> %impure fn &BTreeSetStorage .T impure fn i32 impure fn Option .T () \storage\idx\key:
    btreeset_store_key<.T> btreeset_storage_keys<.T> storage idx key

pub fn btreeset_free_storage <.T: Copy> %fn BTreeSetStorage .T () \storage:
    let keys %Vec Option .T field::get storage "keys"
    vec::free<Option<.T>> keys

pub fn btreeset_alloc_storage <.T: Copy> %impure fn i32 Result BTreeSetStorage .T Diag \cap:
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Err _e:
            diag_err<BTreeSetStorage<.T>> diag_out_of_memory
        Result::Ok keys:
            ok<BTreeSetStorage<.T>, Diag> BTreeSetStorage<.T> keys

pub fn btreeset_copy_live_slots <.T: Copy> %impure fn &BTreeSetStorage .T impure fn &BTreeSetStorage .T impure fn i32 () \src\dst\len0:
    let src_keys %&Vec Option .T btreeset_storage_keys<.T> src
    let dst_keys %&Vec Option .T btreeset_storage_keys<.T> dst
    let mut i %i32 0
    while lt i len0:
        do:
            match btreeset_key_at<.T> src_keys i:
                Option::Some key:
                    btreeset_store_key<.T> dst_keys i some<.T> key
                Option::None:
                    ()
            set i add i 1

pub fn btreeset_clear_slots <.T: Copy> %impure fn &BTreeSetStorage .T impure fn i32 impure fn i32 () \storage\end\i:
    if:
        lt i end
        then:
            btreeset_store_key<.T> btreeset_storage_keys<.T> storage i none<.T>
            btreeset_clear_slots<.T> storage end add i 1
        else:
            ()

pub fn btreeset_shift_right <.T: Copy> %impure fn &BTreeSetStorage .T impure fn i32 impure fn i32 () \storage\idx\len0:
    let mut i %i32 len0
    while gt i idx:
        do:
            let from %i32 sub i 1
            match btreeset_key_slot<.T> storage from:
                Option::Some saved_key:
                    btreeset_store_key_slot<.T> storage i some<.T> saved_key
                Option::None:
                    btreeset_store_key_slot<.T> storage i none<.T>
            set i from

pub fn btreeset_shift_left_after_remove <.T: Copy> %impure fn &BTreeSetStorage .T impure fn i32 impure fn i32 () \storage\idx\len0:
    let last %i32 sub len0 1
    let mut i %i32 idx
    while lt i last:
        do:
            let nxt %i32 add i 1
            match btreeset_key_slot<.T> storage nxt:
                Option::Some saved_key:
                    btreeset_store_key_slot<.T> storage i some<.T> saved_key
                Option::None:
                    btreeset_store_key_slot<.T> storage i none<.T>
            set i nxt
    btreeset_store_key_slot<.T> storage last none<.T>

pub fn btreeset_grow <.T: Copy> %impure fn BTreeSet .T Result BTreeSet .T BTreeSetInsertError .T \set0:
    let len0 %i32 *field::get_ref &set0 "len"
    let cap0 %i32 *field::get_ref &set0 "cap"
    let storage %BTreeSetStorage .T field::get set0 "storage"
    let cap1 %i32 mul cap0 2
    match btreeset_alloc_storage<.T> cap1:
        Result::Err d:
            Result<BTreeSet<.T>, BTreeSetInsertError<.T>>::Err BTreeSetInsertError<.T> (BTreeSet<.T> len0 cap0 storage) d
        Result::Ok next_storage:
            btreeset_copy_live_slots<.T> &storage &next_storage len0
            btreeset_free_storage<.T> storage
            Result<BTreeSet<.T>, BTreeSetInsertError<.T>>::Ok BTreeSet<.T> len0 cap1 next_storage
