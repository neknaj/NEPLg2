//: # btreeset/search
//: `BTreeSet` の lower_bound / slot 判定
//:
//: ### [目的/もくてき]
//: - `Ord` に基づく検索と一致判定を storage 操作から分離します。
//: - public API は検索方針をこの module に委譲し、更新処理だけを組み立てます。

#indent 4

#import "core/option" as *
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/math" as *

//: btreeset_key_eq: Copy key の順序比較から同値性を判定する
//:
//: ### [目的/もくてき]
//: - `a < b` と `b < a` がどちらも false なら、集合上は同じ key とみなします。
//:
//: ### [注意/ちゅうい]
//: - 現行の `Ord` 比較は key を値渡しし、同値判定では `ord_lt` を 2 回呼びます。
//: - borrowed comparison と non-Copy key 用の `OwnedBuffer` / initialized cell 設計が入るまでは、二重消費を避けるため `.T: Copy` に限定します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_key_eq_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"same keys compare equal\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"different keys compare unequal\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let same %bool btreeset_key_eq 7 7
//:     let diff %bool btreeset_key_eq 7 9
//:     let report:
//:         test_report_new "btreeset_key_eq_doc"
//:         |> test_report_push assert_eq_i32 "same keys compare equal" 1 if same 1 0
//:         |> test_report_push assert_eq_i32 "different keys compare unequal" 0 if diff 1 0
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_key_eq <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    and not ord_lt a b not ord_lt b a

pub fn btreeset_lower_bound <.T: Ord&Copy> %fn &Vec Option .T fn .T fn i32 fn i32 i32 \keys\key\low\high:
    if:
        lt low high
        then:
            let mid %i32 div_s add low high 2
            match btreeset_key_at<.T> keys mid:
                Option::Some saved:
                    if:
                        ord_lt saved key
                        then btreeset_lower_bound<.T> keys key add mid 1 high
                        else btreeset_lower_bound<.T> keys key low mid
                Option::None:
                    mid
        else low

pub fn btreeset_is_at <.T: Ord&Copy> %fn &Vec Option .T fn i32 fn i32 fn .T bool \keys\len0\idx\key:
    if:
        lt idx len0
        then:
            match btreeset_key_at<.T> keys idx:
                Option::Some saved:
                    btreeset_key_eq<.T> saved key
                Option::None:
                    false
        else false

pub fn btreeset_lower_bound_storage <.T: Ord&Copy> %fn &BTreeSetStorage .T fn .T fn i32 fn i32 i32 \storage\key\low\high:
    btreeset_lower_bound<.T> btreeset_storage_keys<.T> storage key low high

pub fn btreeset_is_at_storage <.T: Ord&Copy> %fn &BTreeSetStorage .T fn i32 fn i32 fn .T bool \storage\len0\idx\key:
    btreeset_is_at<.T> btreeset_storage_keys<.T> storage len0 idx key
