//: # btreeset/search
//: `BTreeSet` の lower_bound / slot 判定
//:
//: ### [目的/もくてき]
//: - `Ord` に基づく検索と一致判定を storage 操作から分離します。
//: - public API は検索方針をこの module に委譲し、更新処理だけを組み立てます。

#indent 4

#import "core/option" as *
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "./types" as *
#import "./storage" as *
#import "core/math" as *

//: btreeset_key_eq: Copy key の順序比較から同値性を判定する
//:
//: ### [目的/もくてき]
//: - `a < b` と `b < a` がどちらも false なら、集合上は同じ key とみなします。
//:
//: ### [注意/ちゅうい]
//: - 現行の `Ord` 比較は key を値渡しし、同値判定では `ord_lt` を 2 回呼びます。
//: - borrowed comparison と non-Copy key 用の `OwnedBuffer` / initialized cell 設計が入るまでは、二重消費を避けるため `.T: Copy` に限定します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_key_eq_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"same keys compare equal\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"different keys compare unequal\" expected=\"0\" actual=\"0\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let same %bool btreeset_key_eq 7 7
//:     let diff %bool btreeset_key_eq 7 9
//:     let report:
//:         test_report_new "btreeset_key_eq_doc"
//:         |> test_report_push assert_eq_i32 "same keys compare equal" 1 if same 1 0
//:         |> test_report_push assert_eq_i32 "different keys compare unequal" 0 if diff 1 0
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_key_eq <.T: Ord&Copy> %fn .T fn .T bool \a\b:
    and not ord_lt a b not ord_lt b a

//: ## btreeset_lower_bound
//: sorted key prefix の中で key を入れる[位置/いち]を[返/かえ]す
//:
//: ### [契約/けいやく]
//: - `keys` の `low <= i < high` が key の sorted live prefix であることを caller が[保証/ほしょう]します。
//: - 戻り値は `low <= result <= high` を満たします。
//: - `key` 以上の最初の index を返し、すべての live key が `key` より小さい場合は `high` を返します。
//: - live prefix 内に `Option::None` を見つけた場合は storage invariant failure とみなし、その index を返して停止します。
//:
//: ### [計算量/けいさんりょう]
//: - live prefix の長さを n とすると O(log n) です。追加の空間計算量は再帰深さ O(log n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_lower_bound_doc\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"existing key position\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=eq_i32 label=\"between keys position\" expected=\"2\" actual=\"2\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/collections/btreeset/storage" as *
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeSetStorage i32 unwrap_ok btreeset_alloc_storage 4
//:     btreeset_store_key_slot &storage 0 some 1
//:     btreeset_store_key_slot &storage 1 some 3
//:     btreeset_store_key_slot &storage 2 some 7
//:     let keys %&Vec Option i32 btreeset_storage_keys &storage
//:     let existing %i32 btreeset_lower_bound keys 3 0 3
//:     let between %i32 btreeset_lower_bound keys 4 0 3
//:     btreeset_free_storage storage
//:     let report:
//:         test_report_new "btreeset_lower_bound_doc"
//:         |> test_report_push assert_eq_i32 "existing key position" 1 existing
//:         |> test_report_push assert_eq_i32 "between keys position" 2 between
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_lower_bound <.T: Ord&Copy> %fn &Vec Option .T fn .T fn i32 fn i32 i32 \keys\key\low\high:
    if:
        lt low high
        then:
            let mid %i32 div_s add low high 2
            match btreeset_key_at<.T> keys mid:
                Option::Some saved:
                    if:
                        ord_lt saved key
                        then btreeset_lower_bound<.T> keys key add mid 1 high
                        else btreeset_lower_bound<.T> keys key low mid
                Option::None:
                    mid
        else low

//: ## btreeset_is_at
//: sorted key prefix の index が key と[一致/いっち]するか[調/しら]べる
//:
//: ### [契約/けいやく]
//: - `idx < len0` かつ slot が `Option::Some saved` で、`saved` と `key` が `btreeset_key_eq` なら `true` を返します。
//: - `idx >= len0`、範囲外 slot、または `Option::None` slot は `false` を返します。
//: - `keys` owner は[消費/しょうひ]しません。
//:
//: ### [計算量/けいさんりょう]
//: - `Vec.get` と `Ord` 比較 2 回で O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_is_at_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"key is at index\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"missing index is false\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/collections/btreeset/storage" as *
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "alloc/collections/vec" as vec
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeSetStorage i32 unwrap_ok btreeset_alloc_storage 2
//:     btreeset_store_key_slot &storage 0 some 5
//:     let keys %&Vec Option i32 btreeset_storage_keys &storage
//:     let present %bool btreeset_is_at keys 1 0 5
//:     let absent %bool not btreeset_is_at keys 1 1 5
//:     btreeset_free_storage storage
//:     let report:
//:         test_report_new "btreeset_is_at_doc"
//:         |> test_report_push assert "key is at index" present
//:         |> test_report_push assert "missing index is false" absent
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_is_at <.T: Ord&Copy> %fn &Vec Option .T fn i32 fn i32 fn .T bool \keys\len0\idx\key:
    if:
        lt idx len0
        then:
            match btreeset_key_at<.T> keys idx:
                Option::Some saved:
                    btreeset_key_eq<.T> saved key
                Option::None:
                    false
        else false

//: ## btreeset_lower_bound_storage
//: storage wrapper から key view を[借用/しゃくよう]して lower_bound を[実行/じっこう]する
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - `btreeset_storage_keys` で key storage を借用し、戻り値条件は `btreeset_lower_bound` と同じです。
//: - `.T: Copy` は現行 `BTreeSetStorage` の typed key storage view と cleanup contract に合わせるための境界です。
//:
//: ### [計算量/けいさんりょう]
//: - live prefix の長さを n とすると O(log n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_lower_bound_storage_doc\" count=1 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"storage lower bound\" expected=\"1\" actual=\"1\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/collections/btreeset/storage" as *
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeSetStorage i32 unwrap_ok btreeset_alloc_storage 3
//:     btreeset_store_key_slot &storage 0 some 2
//:     btreeset_store_key_slot &storage 1 some 6
//:     let idx %i32 btreeset_lower_bound_storage &storage 5 0 2
//:     btreeset_free_storage storage
//:     let report:
//:         test_report_new "btreeset_lower_bound_storage_doc"
//:         |> test_report_push assert_eq_i32 "storage lower bound" 1 idx
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_lower_bound_storage <.T: Ord&Copy> %fn &BTreeSetStorage .T fn .T fn i32 fn i32 i32 \storage\key\low\high:
    btreeset_lower_bound<.T> btreeset_storage_keys<.T> storage key low high

//: ## btreeset_is_at_storage
//: storage wrapper から key view を[借用/しゃくよう]して index の key [一致/いっち]を[調/しら]べる
//:
//: ### [契約/けいやく]
//: - `storage` owner は[消費/しょうひ]しません。
//: - `idx` の戻り値条件は `btreeset_is_at` と同じで、missing slot と `idx >= len0` は `false` です。
//: - `.T: Copy` は現行 `BTreeSetStorage` の typed key storage view と cleanup contract に合わせるための境界です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"btreeset_is_at_storage_doc\" count=2 failed=0\nassertion index=0 status=ok kind=bool label=\"storage key is at index\" expected=\"true\" actual=\"true\" message=\"\"\nassertion index=1 status=ok kind=bool label=\"storage missing index is false\" expected=\"true\" actual=\"true\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/collections/btreeset/storage" as *
//:| #import "alloc/collections/btreeset/search" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let storage %BTreeSetStorage i32 unwrap_ok btreeset_alloc_storage 2
//:     btreeset_store_key_slot &storage 0 some 8
//:     let present %bool btreeset_is_at_storage &storage 1 0 8
//:     let absent %bool not btreeset_is_at_storage &storage 1 1 8
//:     btreeset_free_storage storage
//:     let report:
//:         test_report_new "btreeset_is_at_storage_doc"
//:         |> test_report_push assert "storage key is at index" present
//:         |> test_report_push assert "storage missing index is false" absent
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn btreeset_is_at_storage <.T: Ord&Copy> %fn &BTreeSetStorage .T fn i32 fn i32 fn .T bool \storage\len0\idx\key:
    btreeset_is_at<.T> btreeset_storage_keys<.T> storage len0 idx key
