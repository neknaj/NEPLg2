//: # btreeset/api/observer
//: `BTreeSet` の借用 observer API
//:
//: ### [目的/もくてき]
//: - `len` / `contains` を set owner を消費しない read-only API として提供します。
//: - sorted key storage の lower_bound だけを使い、payload owner を動かしません。

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/collections/vec" as vec
#import "../types" as *
#import "../storage" as *
#import "../search" as *

//: ## len
//: set を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 3 |> uwok
//:         |> insert 7 |> uwok
//:     let ok <bool> eq len<i32> &s 2
//:     free<i32> s
//:     if ok 1 0
//: ```
pub fn len <.T> <(&BTreeSet<.T>)->i32> (set0):
    *field::get_ref set0 "len"

//: ## contains
//: set を[移動/いどう]せずに key の[存在/そんざい]を[確/たし]かめる
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:     let ok <bool> contains<i32> &s 7
//:     free<i32> s
//:     if ok 1 0
//: ```
pub fn contains <.T: Ord&Copy> <(&BTreeSet<.T>,.T)->bool> (set0, key):
    let len0 <i32> *field::get_ref set0 "len"
    let storage <&BTreeSetStorage<.T>> field::get_ref set0 "storage"
    let keys <&Vec<Option<.T>>> btreeset_storage_keys<.T> storage
    let idx <i32> btreeset_lower_bound<.T> keys key 0 len0
    btreeset_is_at<.T> keys len0 idx key
