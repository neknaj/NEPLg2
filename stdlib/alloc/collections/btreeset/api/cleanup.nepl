//: # btreeset/api/cleanup
//: `BTreeSet` owner の cleanup API
//:
//: ### [目的/もくてき]
//: - set owner から internal storage owner を取り出し、storage helper で閉じます。
//: - cleanup を observer / mutation から分離します。

#indent 4

#import "core/field" as field
#import "core/traits/copy" as *
#import "../types" as *
#import "../storage" as *
#import "core/field" as *

//: ## free
//: Copy-only [内部/ないぶ] storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let s %BTreeSet i32 unwrap_ok new;
//:     free s;
//:     0
//: ```
pub fn free <.T: Copy> %impure fn BTreeSet .T unit \set0:
    let storage %BTreeSetStorage .T field::get set0 "storage"
    btreeset_free_storage<.T> storage
