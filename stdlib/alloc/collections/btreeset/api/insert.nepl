//: # btreeset/api/insert
//: `BTreeSet` の挿入 API
//:
//: ### [目的/もくてき]
//: - grow が必要な準備処理と、容量確保済み storage への lower_bound / shift / store を所有します。
//: - grow failure は owner [返却/へんきゃく]つき `BTreeSetInsertError` として返します。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "../types" as *
#import "../storage" as *
#import "../search" as *
#import "core/field" as *
#import "core/math" as *

//: ## btreeset_insert_ready
//: [容量/ようりょう]が[足/た]りている `BTreeSet` に key を[挿入/そうにゅう]する
//:
//: ### [目的/もくてき]
//: - public `insert` が grow の[成功/せいこう]を[確認/かくにん]したあと、lower_bound / shift / store を[一箇所/いっかしょ]で[行/おこな]います。
//: - grow [失敗/しっぱい]を `unwrap_ok` で trap にしないため、確保を伴う[準備/じゅんび]と確保後の[挿入/そうにゅう]を[分離/ぶんり]します。
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound は O(log n)、新規[挿入/そうにゅう]時の shift は O(n) です。
pub fn btreeset_insert_ready <.T: Ord&Copy> %impure fn BTreeSet .T impure fn .T BTreeSet .T \set1\key:
    let len0 %i32 *field::get_ref &set1 "len"
    let cap0 %i32 *field::get_ref &set1 "cap"
    let storage %BTreeSetStorage .T field::get set1 "storage"
    let idx %i32 btreeset_lower_bound_storage<.T> &storage key 0 len0
    if:
        btreeset_is_at_storage<.T> &storage len0 idx key
        then BTreeSet<.T> len0 cap0 storage
        else:
            btreeset_shift_right<.T> &storage idx len0
            btreeset_store_key_slot<.T> &storage idx some<.T> key
            BTreeSet<.T> add len0 1 cap0 storage

//: ## insert
//: key を[集合/しゅうごう]へ[挿入/そうにゅう]する
//:
//: ### [実装/じっそう]
//: - 現在の[容量/ようりょう]が[満杯/まんぱい]なら `btreeset_grow` を[実行/じっこう]し、`Result::Err` は owner [返却/へんきゃく]つきでそのまま[返/かえ]します。
//: - 確保に[成功/せいこう]した set、または元から[余裕/よゆう]のある set だけを `btreeset_insert_ready` に[渡/わた]します。
//:
//: ### [失敗/しっぱい]
//: - grow 用 key buffer の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `BTreeSetInsertError` に元の set owner と `Diag::OutOfMemory` を[入/い]れて[返/かえ]し、trap しません。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(n)、grow が[起/お]きる[回/かい]は既存要素の copy を含め O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn () i32 \():
//:     let s %BTreeSet i32:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:         |> insert 3 |> uwok
//:     let observed_len %i32 len<i32> &s
//:     let ok %bool eq observed_len 2
//:     free<i32> s
//:     if ok 1 0
//: ```
pub fn insert <.T: Ord&Copy> %impure fn BTreeSet .T impure fn .T Result BTreeSet .T BTreeSetInsertError .T \set0\key:
    let len_init %i32 *field::get_ref &set0 "len"
    let cap_init %i32 *field::get_ref &set0 "cap"
    if:
        eq len_init cap_init
        then:
            match btreeset_grow<.T> set0:
                Result::Ok set1:
                    let next %BTreeSet .T btreeset_insert_ready<.T> set1 key
                    Result<BTreeSet<.T>, BTreeSetInsertError<.T>>::Ok next
                Result::Err e:
                    Result<BTreeSet<.T>, BTreeSetInsertError<.T>>::Err e
        else:
            let next %BTreeSet .T btreeset_insert_ready<.T> set0 key
            Result<BTreeSet<.T>, BTreeSetInsertError<.T>>::Ok next
