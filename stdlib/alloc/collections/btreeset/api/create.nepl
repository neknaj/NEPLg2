//: # btreeset/api/create
//: `BTreeSet` の構築 API
//:
//: ### [目的/もくてき]
//: - 空の sorted-array set storage を確保し、初期 owner を返します。
//: - allocation failure は `Diag` として返し、trap にしません。

#indent 4

#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "../types" as *
#import "../storage" as *
#import "core/math" as *

//: ## new
//: [空/から]の `BTreeSet<.T>` を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let s %BTreeSet i32 unwrap_ok<BTreeSet<i32>, Diag> new<i32>;
//:     let observed_len %i32 len<i32> &s
//:     let ok %bool eq observed_len 0
//:     free<i32> s
//:     if ok 1 0
//: ```
pub fn new <.T: Copy> %impure fn unit Result BTreeSet .T Diag \unit:
    let cap %i32 8
    match btreeset_alloc_storage<.T> cap:
        Result::Err d:
            err d
        Result::Ok storage:
            ok BTreeSet<.T> 0 cap storage
