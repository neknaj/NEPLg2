//: # btreeset/types
//: `BTreeSet` の型定義
//:
//: ### [目的/もくてき]
//: - public API が共有する set 本体と backing storage の型を定義します。
//: - storage 操作や検索処理を別 module に分けても、型の不変条件を 1 [箇所/かしょ]で確認できるようにします。

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BTreeSetStorage
//: [順序付き/じゅんじょつき] set の backing storage
//:
//: ### [不変条件/ふへんじょうけん]
//: - `keys.len == cap`
//: - `0 <= i < len` の slot は `Some`
//: - `len <= i < cap` の slot は `None`
pub struct BTreeSetStorage<.T>:
    keys %Vec Option .T

//: ## BTreeSet
//: [順序付き/じゅんじょつき] key [配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - key [配列/はいれつ]と[長/なが]さを 1 [値/あたい]として[所有/しょゆう]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree node [分割/ぶんかつ]は[持/も]たず、lower_bound と shift による[単純/たんじゅん][実装/じっそう]です。
pub struct BTreeSet<.T>:
    len %i32
    cap %i32
    storage %BTreeSetStorage .T

//: ## BTreeSetInsertError
//: `insert` が[失敗/しっぱい]したときの owner [返却/へんきゃく]つき error
//:
//: ### [目的/もくてき]
//: - `insert` は set owner を[消費/しょうひ]する fallible update です。
//: - grow [失敗/しっぱい]時も caller が set owner を[回収/かいしゅう]して cleanup / retry を[選/えら]べるようにします。
//:
//: ### [注意/ちゅうい]
//: - `Result::Err` を[受/う]け[取/と]った caller は `btreeset_insert_error_owner` で owner を[取/と]り[出/だ]し、[不要/ふよう]なら `free` します。
//: - `diag` は `Diag` の Copy [値/あたい]で、owner を[動/うご]かさず `btreeset_insert_error_diag` から[確認/かくにん]できます。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let s %BTreeSet i32 unwrap_ok new<i32>;
//:     let _e %BTreeSetInsertError i32 BTreeSetInsertError<i32> s (diag_error StdErrorKind::OutOfMemory "grow");
//:     0
//: ```
pub struct BTreeSetInsertError<.T>:
    owner %BTreeSet .T
    diag %Diag

//: btreeset_insert_error_diag: insert [失敗/しっぱい]の[診断/しんだん]を owner を[動/うご]かさず[読/よ]む
pub fn btreeset_insert_error_diag <.T> %fn &BTreeSetInsertError .T Diag \e:
    *field::get_ref e "diag"

//: btreeset_insert_error_owner: insert [失敗/しっぱい]で[戻/もど]された `BTreeSet` owner を[取/と]り[出/だ]す
pub fn btreeset_insert_error_owner <.T: Copy> %fn BTreeSetInsertError .T BTreeSet .T \e:
    field::get e "owner"
