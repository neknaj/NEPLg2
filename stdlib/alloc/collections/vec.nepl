//: # vec
//: [連続/れんぞく]メモリを[用/もち]いる[可変長/かへんちょう][配列/はいれつ] facade
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` を[提供/ていきょう]し、`push` / `filled` / `get` / `pop` / `replace` などの[基本/きほん][操作/そうさ]を[共通/きょうつう] API として[使/つか]えるようにします。
//: - `alloc/collections` の[他/ほか]の[構造/こうぞう]が[依存/いそん]する[基礎/きそ][配列/はいれつ]として[機能/きのう]します。
//:
//: ### [実装/じっそう]
//: - 実装本体は `vec/types`、`vec/storage`、`vec/access`、`vec/mutation`、`vec/query`、`vec/transform`、`vec/sort` が所有します。
//: - この root file は safe public re-export だけを持つ facade です。`as @merge` により `#import "alloc/collections/vec" as v` の qualified API も維持します。
//: - unchecked raw element helper は public module として[公開/こうかい]せず、検査済み `Vec` 操作の private helper に[閉/と]じます。
//:
//: ### [注意/ちゅうい]
//: - `get` / `pop` は[存在/そんざい]しない[位置/いち]を `Option::None` で[返/かえ]します。
//: - `replace` は[範囲外/はんいがい]では[失敗/しっぱい]にせず、[何/なに]も[変更/へんこう]しません。
//: - `new` / `with_capacity` / `push` / `pop` / `drop_last` / `clear` / `free` は `.T: Drop` payload でも使えます。`push` は payload 非依存の `VecStorageInvariant` と private slot initialize proof で tail slot へ[移動/いどう]し、`pop` は private move-out proof と `vec_pop_with` により更新後 `Vec` owner と removed `Option<T>` owner を同時に[回収/かいしゅう]できるようにします。`drop_last` と Drop 版 cleanup は source-level `Drop::drop` と Resource IR proof により removed / initialized slot を[閉/と]じます。
//: - `push` の failure surface は `VecPushRejected<T>` で `Vec` と rejected item を同時に[返/かえ]します。`pop` の result surface は `VecPop<T>` と `vec_pop_with<T, R>` で `Vec` と item option を同じ callback に[渡/わた]します。成功時も失敗時も item owner の[行方/ゆくえ]が API 型と Resource IR proof に[残/のこ]るため、Copy raw-access proof へ[依存/いぞん]しません。
//: - `get`、`vec_pop_item`、`vec_pop_vec`、`sort`、値渡し scan 系 API は、payload を copy して読む、または一部 owner を[捨/す]てる accessor であるため `.T: Copy` に[限定/げんてい]します。Drop payload では owner-preserving API や `count_ref` / `find_index_ref` / `any_ref` / `all_ref` の scoped borrowed predicate API を[使/つか]います。
//: - unchecked raw element helper は root facade から再公開しません。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファの[番地/ばんち]は[変/か]わりえます。
//:
//: ### [計算量/けいさんりょう]
//: - `get` / `replace` / `len` / `cap` / `is_empty` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、[拡張/かくちょう][発生時/はっせいじ]の[最悪/さいあく][時間/じかん][計算量/けいさんりょう]は O(n) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok,ok,ok]\n[0] ok\n[1] ok\n[2] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let empty %Vec i32 unwrap_ok new<i32>
//:     let checks0 checks_push checks_new assert_eq_i32 0 len<i32> &empty
//:     free empty;
//:     let a2 %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks1 checks_push checks0 assert_eq_i32 2 len<i32> &a2
//:     let b2 %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks2 match get<i32> &b2 1:
//:         Option::Some x:
//:             checks_push checks1 assert_eq_i32 20 x
//:         Option::None:
//:             checks_push checks1 assert false
//:     free a2;
//:     free b2;
//:     let shown checks_print_report checks2
//:     checks_exit_code shown
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let v2 %Vec i32:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok0 %i32:
//:         match get<i32> &v2 0:
//:             Option::Some x:
//:                 if ne x 1 then 1 else 0
//:             Option::None:
//:                 1
//:     free<i32> v2;
//:     let w2 %Vec i32:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok1 %bool is_none get<i32> &w2 3
//:     free<i32> w2;
//:     if and eq ok0 0 ok1 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/result" as *
//: fn main %impure fn unit i32 \unit:
//:     let cleared %Vec i32:
//:         unwrap_ok new<i32>
//:         |> push 11 |> uwok
//:         |> push 22 |> uwok
//:         |> clear<i32>
//:     let observed_len %i32 len<i32> &cleared
//:     let ok %bool eq observed_len 0
//:     free<i32> cleared;
//:     if ok 0 1
//: ```

#indent 4
#import "core/field" as *
#import "core/math" as *

pub #import "./vec/types" as @merge
pub #import "./vec/storage" as @merge
pub #import "./vec/access" as @merge
pub #import "./vec/mutation" as @merge
pub #import "./vec/query" as @merge
pub #import "./vec/transform" as @merge
pub #import "./vec/sort" as @merge
