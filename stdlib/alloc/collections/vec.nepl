//: # vec
//: [連続/れんぞく]メモリを[用/もち]いる[可変長/かへんちょう][配列/はいれつ]
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` を[提供/ていきょう]し、`push` / `filled` / `get` / `pop` / `replace` などの[基本/きほん][操作/そうさ]を[共通/きょうつう] API として[使/つか]えるようにします。
//: - `alloc/collections` の[他/ほか]の[構造/こうぞう]が[依存/いそん]する[基礎/きそ][配列/はいれつ]として[機能/きのう]します。
//:
//: ### [実装/じっそう]
//: - `Vec<.T>` は `len` / `cap` / `storage` / `data` を[持/も]つ struct で、storage は `VecStorageState` enum として[管理/かんり]します。
//: - `push` で[容量/ようりょう][不足/ぶそく]が[起/お]きた[場合/ばあい]は 2 [倍/ばい]へ[拡張/かくちょう]し、typed `realloc_ptr` で[再配置/さいはいち]します。
//: - [空/から]の `Vec` は `VecStorageState::Empty` で[表/あらわ]し、null pointer sentinel を owner state として[使/つか]いません。
//:
//: ### [注意/ちゅうい]
//: - `get` / `pop` は[存在/そんざい]しない[位置/いち]を `Option::None` で[返/かえ]します。
//: - `replace` は[範囲外/はんいがい]では[失敗/しっぱい]にせず、[何/なに]も[変更/へんこう]しません。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファの[番地/ばんち]は[変/か]わりえます。
//:
//: ### [計算量/けいさんりょう]
//: - `get` / `replace` / `len` / `cap` / `is_empty` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、[拡張/かくちょう][発生時/はっせいじ]の[最悪/さいあく][時間/じかん][計算量/けいさんりょう]は O(n) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let empty <Vec<i32>> unwrap_ok new<i32>
//:     let checks0 checks_push checks_new assert_eq_i32 0 len<i32> &empty
//:     free empty;
//:     let a2 <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks1 checks_push checks0 assert_eq_i32 2 len<i32> &a2
//:     let b2 <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks2 match get<i32> &b2 1:
//:         Option::Some x:
//:             checks_push checks1 assert_eq_i32 20 x
//:         Option::None:
//:             checks_push checks1 assert false
//:     free a2;
//:     free b2;
//:     checks_exit_code checks2
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v2 <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok0 <i32>:
//:         match get<i32> &v2 0:
//:             Option::Some x:
//:                 if ne x 1 then 1 else 0
//:             Option::None:
//:                 1
//:     free<i32> v2;
//:     let w2 <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok1 <bool> is_none<i32> get<i32> &w2 3
//:     free<i32> w2;
//:     if and eq ok0 0 ok1 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let cleared <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 11 |> uwok
//:         |> push 22 |> uwok
//:         |> clear<i32>
//:     let ok <bool> eq len<i32> &cleared 0
//:     free<i32> cleared;
//:     if ok 0 1
//: ```

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
pub #import "./vec/types" as *
#import "./vec/storage" as vec_storage
#import "./vec/access" as vec_access
#import "./vec/raw" as vec_raw

//: ## facade wrappers
//: storage/access submodule の公開 API を root namespace から[呼/よ]べるようにする
//:
//: ### [目的/もくてき]
//: - `#import "alloc/collections/vec" as v` の `v::new` / `v::len` などを維持しつつ、実装本体を submodule へ[分離/ぶんり]します。
//: - wrapper は raw memory を直接[扱/あつか]わず、責務を `vec/storage` と `vec/access` に[委譲/いじょう]します。

//: vec_empty: root namespace から allocation なしの[空/から] `Vec` を[作/つく]る
//:
//: [実装/じっそう]: `vec/storage` の同名 helper へ[委譲/いじょう]します。
fn vec_empty <.T> <()->Vec<.T>> ():
    vec_storage::vec_empty<.T>

//: vec_alloc_empty: root namespace から[指定/してい][容量/ようりょう]の empty storage を[確保/かくほ]する
//:
//: [実装/じっそう]: storage owner state の構築は `vec/storage` に[集約/しゅうやく]します。
fn vec_alloc_empty <.T> <(i32)->Result<Vec<.T>, StdErrorKind>> (requested_cap):
    vec_storage::vec_alloc_empty<.T> requested_cap

//: vec_storage_mem_ptr: storage state と data field から raw pointer view を[得/え]る
//:
//: [実装/じっそう]: `VecStorageState::Empty` の null view 変換は `vec/storage` に[閉/と]じます。
fn vec_storage_mem_ptr <.T> <(VecStorageState,MemPtr<.T>)->MemPtr<.T>> (storage, data):
    vec_storage::vec_storage_mem_ptr<.T> storage data

//: vec_free_storage: storage state に[応/おう]じて backing buffer を[解放/かいほう]する
//:
//: [実装/じっそう]: raw dealloc は `vec/storage` の storage boundary に[委譲/いじょう]します。
fn vec_free_storage <.T> <(VecStorageState,MemPtr<.T>,i32)->()> (storage, data, cap):
    vec_storage::vec_free_storage<.T> storage data cap

//: new: root namespace から[既定/きてい][容量/ようりょう]の `Vec` を[作/つく]る
//:
//: [実装/じっそう]: allocation policy は `vec/storage::new` が[保持/ほじ]します。
fn new <.T> <()->Result<Vec<.T>, StdErrorKind>> ():
    vec_storage::new<.T>

//: with_capacity: root namespace から[容量/ようりょう][指定/してい]つき `Vec` を[作/つく]る
//:
//: [実装/じっそう]: negative capacity validation と allocation は `vec/storage` に[委譲/いじょう]します。
fn with_capacity <.T> <(i32)->Result<Vec<.T>, StdErrorKind>> (cap):
    vec_storage::with_capacity<.T> cap

//: filled: root namespace から Copy 値で[満/み]たした `Vec` を[作/つく]る
//:
//: [実装/じっそう]: allocation と初期化 loop は `vec/storage` の storage boundary に[閉/と]じます。
fn filled <.T: Copy> <(i32,.T)->Result<Vec<.T>, StdErrorKind>> (n, value):
    vec_storage::filled<.T> n value

//: len: root namespace から `Vec` の[要素数/ようそすう]を[読/よ]む
//:
//: [実装/じっそう]: borrowed observer は `vec/access` に[集約/しゅうやく]します。
fn len <.T> <(&Vec<.T>)->i32> (v):
    vec_access::len<.T> v

//: cap: root namespace から `Vec` の[容量/ようりょう]を[読/よ]む
//:
//: [実装/じっそう]: borrowed observer は `vec/access` に[集約/しゅうやく]します。
fn cap <.T> <(&Vec<.T>)->i32> (v):
    vec_access::cap<.T> v

//: data_ptr: root namespace から[内部/ないぶ] data の raw address view を[読/よ]む
//:
//: [実装/じっそう]: empty storage の null view 変換は `vec/access` 経由で[扱/あつか]います。
fn data_ptr <.T> <(&Vec<.T>)->i32> (v):
    vec_access::data_ptr<.T> v

//: data_mem_ptr: root namespace から[内部/ないぶ] data の typed pointer view を[読/よ]む
//:
//: [実装/じっそう]: storage state の[解釈/かいしゃく]は `vec/access` に[委譲/いじょう]します。
fn data_mem_ptr <.T> <(&Vec<.T>)->MemPtr<.T>> (v):
    vec_access::data_mem_ptr<.T> v

//: data_len: root namespace から data pointer と len を[対/つい]で[読/よ]む
//:
//: [実装/じっそう]: `VecDataLen` の構築は `vec/access` に[集約/しゅうやく]します。
fn data_len <.T> <(&Vec<.T>)->VecDataLen<.T>> (v):
    vec_access::data_len<.T> v

//: is_empty: root namespace から `Vec` が[空/から]か[判定/はんてい]する
//:
//: [実装/じっそう]: borrowed observer は `vec/access` に[委譲/いじょう]します。
fn is_empty <.T> <(&Vec<.T>)->bool> (v):
    vec_access::is_empty<.T> v

//: ## push
//: [末尾/まつび]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `item` を[末尾/まつび]へ[追加/ついか]し、[必要/ひつよう]なら[再確保/さいかくほ]した `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` は `&v` から Copy field として[読/よ]み、`data` owner は[戻/もど]り[値/ち]または dealloc/realloc へ[移動/いどう]します。
//: - [容量/ようりょう][不足/ぶそく]なら 2 [倍/ばい]へ[拡張/かくちょう]し、typed `realloc_ptr<.T>` を[用/もち]います。
//: - [空/から][容量/ようりょう] 0 の `Vec` に対しては 1 [要素分/ようそぶん]から[開始/かいし]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `Result<Vec<.T>, StdErrorKind>` です。`unwrap_ok` や `match` で[受/う]け[取/と]り[直/なお]してください。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファ[番地/ばんち]は[変/か]わります。
//: - [容量/ようりょう][拡張/かくちょう]に[失敗/しっぱい]した[場合/ばあい]、入力 `Vec` の owner はこの[関数/かんすう]が[消費/しょうひ]し、旧 buffer を[解放/かいほう]してから `Err` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [償却/しょうきゃく] O(1)
//: - [最悪/さいあく] O(n)（[再確保/さいかくほ]が[起/お]きる[場合/ばあい]）
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 7;
//:     let ok <bool> eq len<i32> &v1 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
fn push <.T> <(Vec<.T>,.T)->Result<Vec<.T>, StdErrorKind>> (v, item):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    if:
        eq v_len v_cap
        then:
            let grown_cap <i32> if eq v_cap 0 1 mul v_cap 2
            let old_bytes <i32> mul v_cap size_of<.T>
            let new_bytes <i32> mul grown_cap size_of<.T>
            match v_storage:
                VecStorageState::Empty:
                    if:
                        and eq v_len 0 eq v_cap 0
                        then:
                            match alloc_ptr<.T> new_bytes:
                                Result::Ok grown_data:
                                    let write_off <i32> mul v_len size_of<.T>
                                    let write_ptr <i32> add mem_ptr_addr grown_data write_off
                                    let next_len <i32> add v_len 1
                                    store<.T> write_ptr item
                                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len grown_cap VecStorageState::Owned grown_data
                                Result::Err _e:
                                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory
                        else:
                            Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::InvalidOperation
                VecStorageState::Owned:
                    match realloc_ptr<.T> v_data old_bytes new_bytes:
                        Result::Ok grown_data:
                            let write_off <i32> mul v_len size_of<.T>
                            let write_ptr <i32> add mem_ptr_addr grown_data write_off
                            let next_len <i32> add v_len 1
                            store<.T> write_ptr item
                            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len grown_cap VecStorageState::Owned grown_data
                        Result::Err _e:
                            dealloc_raw mem_ptr_addr v_data old_bytes
                            Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory
        else:
            match v_storage:
                VecStorageState::Empty:
                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::InvalidOperation
                VecStorageState::Owned:
                    let write_off <i32> mul v_len size_of<.T>
                    let write_ptr <i32> add mem_ptr_addr v_data write_off
                    let next_len <i32> add v_len 1
                    store<.T> write_ptr item
                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len v_cap VecStorageState::Owned v_data

//: ## get
//: [要素/ようそ]を[取得/しゅとく]する
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら `Option::Some`、[範囲外/はんいがい]なら `Option::None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `idx` の[範囲/はんい]を[判定/はんてい]し、[妥当/だとう]な[場合/ばあい]だけ typed `load` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - `idx` が[負/ふ]でも `Option::None` です。
//: - [失敗/しっぱい]を trap ではなく `Option` で[返/かえ]す[設計/せっけい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 9;
//:     match get<i32> &v1 0:
//:         Option::Some x:
//:             free<i32> v1;
//:             if eq x 9 0 1
//:         Option::None:
//:             free<i32> v1;
//:             1
//: ```
fn get <.T: Copy> <(&Vec<.T>,i32)->Option<.T>> (v, idx):
    let v_len <i32> *field::get_ref v "len"
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    if:
        lt idx 0
        then none<.T>
        else:
            if:
                le v_len idx
                then none<.T>
                else:
                    match v_storage:
                        VecStorageState::Empty:
                            none<.T>
                        VecStorageState::Owned:
                            let read_off <i32> mul idx size_of<.T>
                            some<.T> load<.T> add mem_ptr_addr v_data read_off

//: ## replace
//: [要素/ようそ]を[上書/うわが]きする（[範囲外/はんいがい]は[無視/むし]）
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら[指定/してい]した[要素/ようそ]へ[置/お]き[換/か]えます。
//:
//: ### [実装/じっそう]
//: - `idx` を[検査/けんさ]し、[妥当/だとう]な[場合/ばあい]だけ typed `store` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [範囲外/はんいがい]では[失敗/しっぱい]を[返/かえ]さず、[何/なに]も[変更/へんこう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     replace<i32> &v1 0 5;
//:     free<i32> v1;
//:     0
//: ```
fn replace <.T: Copy> <(&Vec<.T>,i32,.T)*>()> (v, idx, item):
    let v_len <i32> *field::get_ref v "len"
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    if:
        lt idx 0
        then ()
        else:
            if:
                le v_len idx
                then ()
                else:
                    match v_storage:
                        VecStorageState::Empty:
                            ()
                        VecStorageState::Owned:
                            let write_off <i32> mul idx size_of<.T>
                            store<.T> add mem_ptr_addr v_data write_off item

//: ## pop
//: [末尾/まつび][要素/ようそ]を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - [末尾/まつび][要素/ようそ]を `Option` で[返/かえ]し、[長/なが]さを 1 [減/へ]らした `Vec` を[同時/どうじ]に[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len == 0` なら `Option::None` です。
//: - [要素/ようそ]がある[場合/ばあい]は[最後/さいご]の 1 [件/けん]を typed `load` し、`len - 1` の `Vec` と[組/く]にして[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `VecPop<.T>` です。
//: - [確保/かくほ]も[解放/かいほう]も[行/おこな]わないため O(1) です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 4;
//:     let p pop<i32> v1;
//:     let next <Vec<i32>> get p "vec";
//:     free<i32> next;
//:     0
//: ```
fn pop <.T> <(Vec<.T>)->VecPop<.T>> (v):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    if:
        eq v_len 0
        then:
            VecPop<.T> (Vec<.T> v_len v_cap v_storage v_data) none<.T>
        else:
            match v_storage:
                VecStorageState::Empty:
                    VecPop<.T> vec_empty<.T> none<.T>
                VecStorageState::Owned:
                    let next_len <i32> sub v_len 1
                    let read_off <i32> mul next_len size_of<.T>
                    let item <.T> load<.T> add mem_ptr_addr v_data read_off
                    VecPop<.T> (Vec<.T> next_len v_cap VecStorageState::Owned v_data) some<.T> item

//: ## clear
//: [要素/ようそ]をすべて[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - `len` を 0 にして、[確保済/かくほず]み[領域/りょういき]を[再利用/さいりよう]できる[空/から]ベクタを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `data` と `cap` はそのままに、`len` だけを 0 にします。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]メモリは[解放/かいほう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     let v2 clear<i32> v1;
//:     let ok <bool> eq len<i32> &v2 0
//:     free<i32> v2;
//:     if ok 0 1
//: ```
fn clear <.T> <(Vec<.T>)->Vec<.T>> (v):
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    Vec<.T> 0 v_cap v_storage v_data

//: ## raw helper facade wrappers
//: `vec/raw` の内部 helper を root namespace から[呼/よ]べるようにする
//:
//: ### [目的/もくてき]
//: - 既存 doctest と root 内部実装の呼び出し名を保ちながら、raw memory 実装本体は `vec/raw` に[集約/しゅうやく]します。
//: - wrapper は raw memory を直接[扱/あつか]わず、offset 計算と load/store は `vec/raw` に[委譲/いじょう]します。

//: vec_read_at: root namespace から raw storage の index 要素を[読/よ]む
//:
//: [実装/じっそう]: `vec/raw::vec_read_at` に[委譲/いじょう]します。
fn vec_read_at <.T> <(MemPtr<.T>, i32)->.T> (data, idx):
    vec_raw::vec_read_at<.T> data idx

//: vec_write_at: root namespace から raw storage の index 要素を[書/か]く
//:
//: [実装/じっそう]: `vec/raw::vec_write_at` に[委譲/いじょう]します。
fn vec_write_at <.T> <(MemPtr<.T>, i32, .T)->()> (data, idx, item):
    vec_raw::vec_write_at<.T> data idx item

//: vec_fold_impl: root namespace から raw storage fold helper を[呼/よ]ぶ
//:
//: [実装/じっそう]: recursive fold 本体は `vec/raw` に[集約/しゅうやく]します。
fn vec_fold_impl <.T,.U> <(MemPtr<.T>, i32, i32, .U, (.U,.T)->.U)->.U> (data, len, idx, acc, f):
    vec_raw::vec_fold_impl<.T,.U> data len idx acc f

//: vec_reduce_impl: root namespace から raw storage reduce helper を[呼/よ]ぶ
//:
//: [実装/じっそう]: recursive reduce 本体は `vec/raw` に[集約/しゅうやく]します。
fn vec_reduce_impl <.T> <(MemPtr<.T>, i32, i32, .T, (.T,.T)->.T)->.T> (data, len, idx, acc, f):
    vec_raw::vec_reduce_impl<.T> data len idx acc f

//: vec_find_impl: root namespace から raw storage find helper を[呼/よ]ぶ
//:
//: [実装/じっそう]: scan 本体は `vec/raw` に[集約/しゅうやく]します。
fn vec_find_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->Option<.T>> (data, len, idx, p):
    vec_raw::vec_find_impl<.T> data len idx p

//: vec_take_while_len_impl: root namespace から raw storage prefix 境界 helper を[呼/よ]ぶ
//:
//: [実装/じっそう]: iterative scan 本体は `vec/raw` に[集約/しゅうやく]します。
fn vec_take_while_len_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->i32> (data, len, idx, p):
    vec_raw::vec_take_while_len_impl<.T> data len idx p

//: vec_write_prefix_impl: root namespace から raw storage prefix copy helper を[呼/よ]ぶ
//:
//: [実装/じっそう]: read/write loop は `vec/raw` に[集約/しゅうやく]します。
fn vec_write_prefix_impl <.T> <(MemPtr<.T>, MemPtr<.T>, i32, i32)->()> (src_data, out_data, src_from, count):
    vec_raw::vec_write_prefix_impl<.T> src_data out_data src_from count
//: ## map
//: [各要素/かくようそ]を[同/おな]じ[規則/きそく]で[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `xs |> map f` の[形/かたち]で、`Vec<.T>` の[全要素/ぜんようそ]へ[同/おな]じ[純粋/じゅんすい][関数/かんすう]を[適用/てきよう]します。
//: - [元/もと]の[順序/じゅんじょ]を[保/たも]ったまま、[新/あたら]しい `Vec<.U>` を[作成/さくせい]します。
//:
//: ### [実装/じっそう]
//: - [入力/にゅうりょく]の `len` と[同/おな]じ[容量/ようりょう]を[先/さき]に[確保/かくほ]し、raw loop で[順番/じゅんばん]に[書/か]き[込/こ]みます。
//: - [出力/しゅつりょく] `Vec` の `len` は[最後/さいご]に[確定/かくてい]させ、[途中/とちゅう]で[再確保/さいかくほ]を[発生/はっせい]させません。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result<Vec<.U>, StdErrorKind>` を[返/かえ]します。
//: - `f` は `(.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn inc <(i32)->i32> (x):
//:     add x 1
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ys <Vec<i32>> unwrap_ok map<i32,i32> xs inc;
//:     match get<i32> &ys 2:
//:         Option::Some x:
//:             free<i32> ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free<i32> ys;
//:             1
//: ```
fn map <.T,.U> <(Vec<.T>, (.T)->.U)->Result<Vec<.U>, StdErrorKind>> (v, f):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    match with_capacity<.U> src_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.U>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.U>> field::get out0 "data"
            let mut i <i32> 0
            while lt i src_len:
                do:
                    vec_write_at<.U> out_data i f vec_read_at<.T> src_data i
                    set i add i 1
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.U>, StdErrorKind> Vec<.U> src_len out_cap out_storage out_data

//: ## filter
//: [条件/じょうけん]を[満/み]たす[要素/ようそ]だけを[残/のこ]す
//:
//: ### [目的/もくてき]
//: - `xs |> filter p` の[形/かたち]で、[条件/じょうけん] `p` を[満/み]たす[要素/ようそ]だけを[残/のこ]した[新/あたら]しい `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で[残/のこ]す[要素数/ようそすう]を[数/かぞ]え、2 [回目/かいめ]の loop で exact capacity の[出力/しゅつりょく]バッファへ[詰/つ]めます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result<Vec<.T>, StdErrorKind>` を[返/かえ]します。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let ys <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let zs <Vec<i32>> unwrap_ok filter<i32> ys is_even;
//:     let ok <bool> eq len<i32> &zs 2
//:     free<i32> zs;
//:     if ok 0 1
//: ```
fn filter <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let mut keep_len <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set keep_len add keep_len 1
                else ()
            set i add i 1
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            let mut read_i <i32> 0
            let mut write_i <i32> 0
            while lt read_i src_len:
                do:
                    let item <.T> vec_read_at<.T> src_data read_i
                    if:
                        cond p item
                        then:
                            vec_write_at<.T> out_data write_i item
                            set write_i add write_i 1
                        else ()
                    set read_i add read_i 1
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## partition
//: [条件/じょうけん]で 2 [群/ぐん]に[分/わ]ける
//:
//: ### [目的/もくてき]
//: - `xs |> partition p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]と、[満/み]たさない[要素/ようそ]へ[分割/ぶんかつ]します。
//: - [返/かえ]り[値/あたい]は `VecPartition` です。`matched` と `rest` の両方を継続利用または `free` してください。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で `matched` の[要素数/ようそすう]だけを[数/かぞ]え、2 [回目/かいめ]で exact capacity の 2 [本/ほん]の `Vec` へ[振/ふ]り[分/わ]けます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[両方/りょうほう]の[出力/しゅつりょく]で[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - 2 [本/ほん]の[新規/しんき] `Vec` を[確保/かくほ]するので `Result<VecPartition<.T>, StdErrorKind>` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/field" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let parts unwrap_ok partition<i32> xs is_even;
//:     let evens get parts "matched";
//:     let rest get parts "rest";
//:     let ok <bool> eq len<i32> &evens 1
//:     free<i32> evens;
//:     free<i32> rest;
//:     if ok 0 1
//: ```
fn partition <.T> <(Vec<.T>, (.T)->bool)->Result<VecPartition<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let mut left_len <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set left_len add left_len 1
                else ()
            set i add i 1
    let right_len <i32> sub src_len left_len
    match with_capacity<.T> left_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<VecPartition<.T>, StdErrorKind> e
        Result::Ok left0:
            match with_capacity<.T> right_len:
                Result::Err e:
                    let left0_cap <i32> *field::get_ref &left0 "cap"
                    let left0_storage <VecStorageState> *field::get_ref &left0 "storage"
                    let left0_data <MemPtr<.T>> field::get left0 "data"
                    vec_free_storage<.T> left0_storage left0_data left0_cap
                    vec_free_storage<.T> src_storage src_data src_cap
                    Result::Err<VecPartition<.T>, StdErrorKind> e
                Result::Ok right0:
                    let left_cap <i32> *field::get_ref &left0 "cap"
                    let left_storage <VecStorageState> *field::get_ref &left0 "storage"
                    let left_data <MemPtr<.T>> field::get left0 "data"
                    let right_cap <i32> *field::get_ref &right0 "cap"
                    let right_storage <VecStorageState> *field::get_ref &right0 "storage"
                    let right_data <MemPtr<.T>> field::get right0 "data"
                    let mut read_i <i32> 0
                    let mut left_i <i32> 0
                    let mut right_i <i32> 0
                    while lt read_i src_len:
                        do:
                            let item <.T> vec_read_at<.T> src_data read_i
                            if:
                                cond p item
                                then:
                                    vec_write_at<.T> left_data left_i item
                                    set left_i add left_i 1
                                else:
                                    vec_write_at<.T> right_data right_i item
                                    set right_i add right_i 1
                            set read_i add read_i 1
                    vec_free_storage<.T> src_storage src_data src_cap
                    Result::Ok<VecPartition<.T>, StdErrorKind> VecPartition<.T> (Vec<.T> left_len left_cap left_storage left_data) (Vec<.T> right_len right_cap right_storage right_data)

//: ## take_while
//: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]だけを[取/と]る
//:
//: ### [目的/もくてき]
//: - `xs |> take_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]だけを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [最初/さいしょ]に[打/う]ち[切/き]り[位置/いち]を[求/もと]め、その prefix [長/ちょう]だけ exact capacity を[確保/かくほ]して[順番/じゅんばん]に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - `filter` と[違/ちが]い、[途中/とちゅう]で `p` が false になったら[残/のこ]りは[見/み]ません。
//:
//: ### [計算量/けいさんりょう]
//: - O(k) ただし k は[最初/さいしょ]に false になるまでの[走査/そうさ]と[複写/ふくしゃ]を[含/ふく]む
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys <Vec<i32>> unwrap_ok take_while<i32> xs lt_three;
//:     let ok <bool> eq len<i32> &ys 2
//:     free<i32> ys;
//:     if ok 0 1
//: ```
fn take_while <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let keep_len <i32> vec_take_while_len_impl<.T> src_data src_len 0 p
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            vec_write_prefix_impl<.T> src_data out_data 0 keep_len
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## drop_while
//: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]を[捨/す]てる
//:
//: ### [目的/もくてき]
//: - `xs |> drop_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]を[飛/と]ばし、その[残/のこ]りを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `take_while` と[同/おな]じ helper で[打/う]ち[切/き]り[位置/いち]を[求/もと]め、そこから[末尾/まつび]までを exact capacity の[新規/しんき] `Vec` に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - [全要素/ぜんようそ]が `p` を[満/み]たす[場合/ばあい]は[空/から] `Vec` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys <Vec<i32>> unwrap_ok drop_while<i32> xs lt_three;
//:     match get<i32> &ys 0:
//:         Option::Some x:
//:             free<i32> ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free<i32> ys;
//:             1
//: ```
fn drop_while <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let drop_len <i32> vec_take_while_len_impl<.T> src_data src_len 0 p
    let keep_len <i32> sub src_len drop_len
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            vec_write_prefix_impl<.T> src_data out_data drop_len keep_len
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## count
//: [条件/じょうけん]を[満/み]たす[要素数/ようそすう]を[数/かぞ]える
//:
//: ### [目的/もくてき]
//: - `xs |> count p` の[形/かたち]で、`p` が true になる[要素/ようそ]の[個数/こすう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[末尾/まつび]まで 1 [回/かい]だけ[走査/そうさ]し、true のたびに[加算/かさん]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let ok <bool> eq count<i32> &xs is_even 2
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn count <.T: Copy> <(&Vec<.T>, (.T)->bool)->i32> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set out add out 1
                else ()
            set i add i 1
    out

//: ## fold
//: [左/ひだり]から[順/じゅん]に[畳/たた]み[込/こ]む
//:
//: ### [目的/もくてき]
//: - `xs |> fold init f` の[形/かたち]で、[初期値/しょきち] `init` から[始/はじ]めて[全要素/ぜんようそ]を 1 つの[値/あたい]へ[集約/しゅうやく]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]から `len - 1` まで[順番/じゅんばん]に `f acc item` を[適用/てきよう]し、[更新後/こうしんご]の acc を[次/つぎ]へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `init` をそのまま[返/かえ]します。
//: - `f` は `(.U,.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ok <bool> eq fold<i32,i32> &xs 10 add_acc 16
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn fold <.T: Copy,.U> <(&Vec<.T>, .U, (.U,.T)->.U)->.U> (v, acc, f):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    vec_fold_impl<.T,.U> src_data src_len 0 acc f

//: ## reduce
//: [初期値/しょきち]なしで[集約/しゅうやく]する
//:
//: ### [目的/もくてき]
//: - [非空/ひくう] `Vec` なら[先頭/せんとう][要素/ようそ]を[初期値/しょきち]として[残/のこ]りを[畳/たた]み[込/こ]み、[空/から]なら `None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]を[初期値/しょきち]として[読/よ]み[出/だ]し、1 [番目/ばんめ]から[残/のこ]りを[左畳/ひだりたた]み[込/こ]みします。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `Option::None` です。
//: - `f` は `(.T,.T)->.T` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     match reduce<i32> &xs add_acc:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 6 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
fn reduce <.T: Copy> <(&Vec<.T>, (.T,.T)->.T)->Option<.T>> (v, f):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    if:
        eq src_len 0
        then none<.T>
        else:
            some<.T> vec_reduce_impl<.T> src_data src_len 1 vec_read_at<.T> src_data 0 f

//: ## find
//: [条件/じょうけん]に[合/あ]う[最初/さいしょ]の[要素/ようそ]を[探/さが]す
//:
//: ### [目的/もくてき]
//: - `xs |> find p` の[形/かたち]で、0 [番目/ばんめ]から[順/じゅん]に `p` を[試/ため]し、[最初/さいしょ]に[真/しん]となる[要素/ようそ]を `Some` で[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で[即座/そくざ]に[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [見/み]つからなければ `None` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     match find<i32> &xs gt_two:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 3 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
fn find <.T: Copy> <(&Vec<.T>, (.T)->bool)->Option<.T>> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    vec_find_impl<.T> src_data src_len 0 p

//: ## any
//: [条件/じょうけん]を[満/み]たす[要素/ようそ]が 1 つでもあるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> any p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]が 1 つでもあれば `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で `true` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `false` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     let ok <bool> any<i32> &xs gt_two
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn any <.T: Copy> <(&Vec<.T>, (.T)->bool)->bool> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <bool> false
    let mut i <i32> 0
    while and lt i src_len not out:
        do:
            set out p vec_read_at<.T> src_data i
            set i add i 1
    out

//: ## all
//: [全要素/ぜんようそ]が[条件/じょうけん]を[満/み]たすか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> all p` の[形/かたち]で、[全/すべ]ての[要素/ようそ]が `p` を[満/み]たすときだけ `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、1 [件/けん]でも false が[出/で]たら[即座/そくざ]に[打/う]ち[切/き]ります。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `true` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ok <bool> all<i32> &xs is_even
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn all <.T: Copy> <(&Vec<.T>, (.T)->bool)->bool> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <bool> true
    let mut i <i32> 0
    while and lt i src_len out:
        do:
            set out p vec_read_at<.T> src_data i
            set i add i 1
    out

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` が[所有/しょゆう]する `data` [領域/りょういき]を[明示的/めいじてき]に[解放/かいほう]します。
//:
//: ### [実装/じっそう]
//: - `cap` は `&v` から Copy field として[読/よ]み、`data` owner は `dealloc_raw` へ[移動/いどう]します。
//:
//: ### [注意/ちゅうい]
//: - `Vec` [自体/じたい]は[値/あたい]なので[追加/ついか]の[解放/かいほう]は[不要/ふよう]です。
//: - `cap = 0` の[空/から]ベクタでも[呼/よ]べます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     free<i32> v;
//:     0
//: ```
fn free <.T> <(Vec<.T>)->()> (v):
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    vec_free_storage<.T> v_storage v_data v_cap
