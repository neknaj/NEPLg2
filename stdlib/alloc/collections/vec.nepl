//: # vec
//: [連続/れんぞく]メモリを[用/もち]いる[可変長/かへんちょう][配列/はいれつ]
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` を[提供/ていきょう]し、`push` / `filled` / `get` / `pop` / `replace` などの[基本/きほん][操作/そうさ]を[共通/きょうつう] API として[使/つか]えるようにします。
//: - `alloc/collections` の[他/ほか]の[構造/こうぞう]が[依存/いそん]する[基礎/きそ][配列/はいれつ]として[機能/きのう]します。
//:
//: ### [実装/じっそう]
//: - `Vec<.T>` は `len` / `cap` / `storage` / `data` を[持/も]つ struct で、storage は `VecStorageState` enum として[管理/かんり]します。
//: - `push` で[容量/ようりょう][不足/ぶそく]が[起/お]きた[場合/ばあい]は 2 [倍/ばい]へ[拡張/かくちょう]し、typed `realloc_ptr` で[再配置/さいはいち]します。
//: - [空/から]の `Vec` は `VecStorageState::Empty` で[表/あらわ]し、null pointer sentinel を owner state として[使/つか]いません。
//:
//: ### [注意/ちゅうい]
//: - `get` / `pop` は[存在/そんざい]しない[位置/いち]を `Option::None` で[返/かえ]します。
//: - `replace` は[範囲外/はんいがい]では[失敗/しっぱい]にせず、[何/なに]も[変更/へんこう]しません。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファの[番地/ばんち]は[変/か]わりえます。
//:
//: ### [計算量/けいさんりょう]
//: - `get` / `replace` / `len` / `cap` / `is_empty` は O(1) です。
//: - `push` は[償却/しょうきゃく] O(1)、[拡張/かくちょう][発生時/はっせいじ]の[最悪/さいあく][時間/じかん][計算量/けいさんりょう]は O(n) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let empty <Vec<i32>> unwrap_ok new<i32>
//:     let checks0 checks_push checks_new assert_eq_i32 0 len<i32> &empty
//:     free empty;
//:     let a2 <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks1 checks_push checks0 assert_eq_i32 2 len<i32> &a2
//:     let b2 <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 10 |> uwok
//:         |> push 20 |> uwok
//:     let checks2 match get<i32> &b2 1:
//:         Option::Some x:
//:             checks_push checks1 assert_eq_i32 20 x
//:         Option::None:
//:             checks_push checks1 assert false
//:     free a2;
//:     free b2;
//:     checks_exit_code checks2
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v2 <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok0 <i32>:
//:         match get<i32> &v2 0:
//:             Option::Some x:
//:                 if ne x 1 then 1 else 0
//:             Option::None:
//:                 1
//:     free<i32> v2;
//:     let w2 <Vec<i32>>:
//:         unwrap_ok with_capacity<i32> 2
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:     let ok1 <bool> is_none<i32> get<i32> &w2 3
//:     free<i32> w2;
//:     if and eq ok0 0 ok1 0 1
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let cleared <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 11 |> uwok
//:         |> push 22 |> uwok
//:         |> clear<i32>
//:     let ok <bool> eq len<i32> &cleared 0
//:     free<i32> cleared;
//:     if ok 0 1
//: ```

#indent 4

#import "core/mem" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *

//: ## VecStorageState
//: `Vec` の backing storage owner state
//:
//: ### [目的/もくてき]
//: - `cap = 0` の empty storage と、実際に[確保/かくほ]された buffer owner を enum として[分/わ]けます。
//: - `mem_ptr_wrap 0` を owner sentinel として[使/つか]わず、`match` の[網羅性/もうらせい]で storage state を[扱/あつか]います。
//: - backing pointer は `Vec.data` field として[保持/ほじ]し、Resource IR が raw memory cell を[追跡/ついせき]できる[形/かたち]を[保/たも]ちます。
enum VecStorageState:
    Empty
    Owned

impl Clone for VecStorageState:
    fn clone <(&VecStorageState)->VecStorageState> (storage):
        *storage

impl Copy for VecStorageState:
    fn copy_mark <(VecStorageState)->VecStorageState> (storage):
        storage

//: ## Vec
//: [可変長/かへんちょう][配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [要素数/ようそすう]・[容量/ようりょう]・storage owner state を[保持/ほじ]し、`alloc/collections` の[他/ほか] API から[共通/きょうつう]に[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - `len` と `cap` は `i32`、`storage` は `VecStorageState`、`data` は `MemPtr<.T>` で[保持/ほじ]します。
//: - [実体/じったい]の[配列/はいれつ]はヒープ[上/じょう]の[連続/れんぞく][領域/りょういき]です。
//:
//: ### [注意/ちゅうい]
//: - `Vec<.T>` [自体/じたい]は `data` [領域/りょういき]の[所有権/しょゆうけん]を[持/も]ちます。
//: - `Vec<.T>` は shallow copy できません。値を[渡/わた]すと[所有権/しょゆうけん]が[移動/いどう]します。
//: - [再確保/さいかくほ]により `data` の[番地/ばんち]が[変/か]わるため、[生/なま]アドレスを[長期/ちょうき]に[保持/ほじ]してはいけません。
//:
//: ### [計算量/けいさんりょう]
//: - struct [自体/じたい]の[読/よ]み[書/か]きは O(1) です。
//:
//: neplg2:test[compile_fail]
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let moved <Vec<i32>> v;
//:     free<i32> v;
//:     free<i32> moved;
//:     0
//: ```
struct Vec<.T>:
    len <i32>
    cap <i32>
    storage <VecStorageState>
    data <MemPtr<.T>>

//: ## VecDataLen
//: `Vec<.T>` の data/len をまとめて[返/かえ]す[軽量/けいりょう] struct
//:
//: ### [目的/もくてき]
//: - [内部/ないぶ]バッファ[先頭/せんとう]と[要素数/ようそすう]を 1 [回/かい]の[呼/よ]び[出/だ]しで[扱/あつか]えるようにします。
//: - sort [系/けい] helper のように data と len を[対/つい]で[読む/よむ] API で、`.Pair` に[頼/たよ]らず[明示的/めいじてき]な field [名/めい]を[与/あた]えます。
//:
//: ### [実装/じっそう]
//: - `data` は `MemPtr<.T>`、`len` は `i32` を[保持/ほじ]します。
//:
//: ### [注意/ちゅうい]
//: - `data` は `Vec<.T>` の[内部/ないぶ][領域/りょういき]を[指/さ]すため、[再確保/さいかくほ]が[起/お]きると[無効/むこう]になります。
//: - `len` は[取得時点/しゅとくじてん]の[値/あたい]であり、その[後/あと]の[変更/へんこう]には[追従/ついじゅう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - struct [自体/じたい]の[生成/せいせい]と field [読/よ]み[取/と]りは O(1) です。
struct VecDataLen<.T>:
    data <MemPtr<.T>>
    len <i32>

//: ## VecPop
//: `pop` の結果を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `.Pair` の数値 field ではなく、`vec` と `item` を名前付き field として Resource IR に渡します。
//: - 返却された `vec` owner を呼び出し側が明示的に回収できます。
struct VecPop<.T>:
    vec <Vec<.T>>
    item <Option<.T>>

//: ## VecPartition
//: `partition` の 2 本の結果 `Vec` を名前付き field で返す構造です。
//:
//: ### [目的/もくてき]
//: - `matched` は predicate が true の[要素/ようそ]、`rest` は false の[要素/ようそ]を[保持/ほじ]します。
//: - `.Pair` の位置番号ではなく名前付き field にして、owner の[解放/かいほう]漏れを静的検査で[見/み]える形にします。
struct VecPartition<.T>:
    matched <Vec<.T>>
    rest <Vec<.T>>

//: ## vec_empty
//: allocation を[持/も]たない[空/から]の `Vec` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - OOM fallback など追加 allocation を行えない場面でも、null pointer ではなく `VecStorageState::Empty` で空 storage を[表/あらわ]します。
fn vec_empty <.T> <()->Vec<.T>> ():
    Vec<.T> 0 0 VecStorageState::Empty mem_ptr_wrap 0

//: ## vec_alloc_empty
//: [空/から]の `Vec` 用 owned storage を[確保/かくほ]する
//:
//: ### [目的/もくてき]
//: - `cap > 0` の[空/から] `Vec` に対して、`VecStorageState::Owned` の backing storage を[確保/かくほ]します。
//:
//: ### [実装/じっそう]
fn vec_alloc_empty <.T> <(i32)->Result<Vec<.T>, StdErrorKind>> (requested_cap):
    if:
        le requested_cap 0
        then:
            Result::Ok<Vec<.T>, StdErrorKind> vec_empty<.T>
        else:
            match alloc_ptr<.T> mul requested_cap size_of<.T>:
                Result::Ok data:
                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> 0 requested_cap VecStorageState::Owned data
                Result::Err _e:
                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory

//: ## vec_storage_mem_ptr
//: storage state を raw pointer view へ[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `VecStorageState::Empty` は owner state としては null pointer を[持/も]ちませんが、legacy raw pointer observer では 0 address view を[返/かえ]します。
fn vec_storage_mem_ptr <.T> <(VecStorageState,MemPtr<.T>)->MemPtr<.T>> (storage, data):
    match storage:
        VecStorageState::Empty:
            mem_ptr_wrap 0
        VecStorageState::Owned:
            data

//: ## vec_free_storage
//: storage state に[応/おう]じて backing buffer を[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - empty storage は何もせず、owned storage だけを `dealloc_raw` へ[渡/わた]します。
fn vec_free_storage <.T> <(VecStorageState,MemPtr<.T>,i32)->()> (storage, data, cap):
    match storage:
        VecStorageState::Empty:
            ()
        VecStorageState::Owned:
            dealloc_raw mem_ptr_addr data mul cap size_of<.T>

//: ## new
//: [既定/きてい][容量/ようりょう]の[空/から] `Vec<.T>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - [空/から]の `Vec<.T>` を[返/かえ]し、`push` [連鎖/れんさ]の[起点/きてん]として[使/つか]えるようにします。
//:
//: ### [実装/じっそう]
//: - [初期/しょき][容量/ようりょう]を 8 とし、その byte [数/すう]だけ typed `alloc_ptr<.T>` で[確保/かくほ]します。
//: - `len = 0`、`cap = 8`、`data = allocated pointer` の struct を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [初期/しょき][容量/ようりょう]は[固定値/こていち] 8 です。
//: - `cap < 0` は[不正/ふせい]な[容量/ようりょう]として `StdErrorKind::InvalidOperation` を[返/かえ]します。
//: - [確保/かくほ][失敗/しっぱい]した[場合/ばあい]は `Result::Err StdErrorKind::OutOfMemory` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1)、[追加/ついか]の[空間/くうかん][計算量/けいさんりょう]も O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> eq len<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn new <.T> <()->Result<Vec<.T>, StdErrorKind>> ():
    vec_alloc_empty<.T> 8

//: ## with_capacity
//: [初期/しょき][容量/ようりょう]を[指定/してい]して `Vec<.T>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - [事前/じぜん]に[必要/ひつよう]な[容量/ようりょう]が[分/わ]かっている[場面/ばめん]で、[再確保/さいかくほ]を[減/へ]らした `Vec<.T>` を[作/つく]ります。
//:
//: ### [実装/じっそう]
//: - [指定/してい]した `cap` に[応/おう]じて typed `alloc_ptr<.T>` を[呼/よ]び、`len = 0` で[返/かえ]します。
//: - `cap = 0` は null pointer sentinel ではなく、`VecStorageState::Empty` に[正規化/せいきか]します。
//:
//: ### [注意/ちゅうい]
//: - `cap = 0` でも[動作/どうさ]し、`cap` observer は 0 を[返/かえ]します。
//: - [確保/かくほ][失敗/しっぱい]した[場合/ばあい]は `Result::Err StdErrorKind::OutOfMemory` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok with_capacity<i32> 16;
//:     let ok <bool> eq cap<i32> &v 16
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn with_capacity <.T> <(i32)->Result<Vec<.T>, StdErrorKind>> (cap):
    if:
        lt cap 0
        then:
            Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::InvalidOperation
        else:
            vec_alloc_empty<.T> cap

//: ## filled
//: [同/おな]じ Copy [値/あたい]で[満/み]たした `Vec<.T>` を[作/つく]る
//:
//: ### [目的/もくてき]
//: - [固定長/こていちょう]の buffer や table を、`with_capacity` + `push` の loop ではなく 1 つの API で[作成/さくせい]します。
//: - [確保/かくほ][失敗/しっぱい]は `Result::Err StdErrorKind::OutOfMemory` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `n <= 0` なら `VecStorageState::Empty` の[空/から]の `Vec` を[返/かえ]します。
//: - `n > 0` なら `n` [要素分/ようそぶん]を typed `alloc_ptr<.T>` で[確保/かくほ]し、先頭から順に `store` で同じ値を書き込みます。
//: - 書き込み完了後は `len = cap = n` の `Vec` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `.T: Copy` に[限定/げんてい]します。同じ値を複数セルへ複製して保持するためです。
//: - [返/かえ]った `Vec` は通常どおり `free` で[解放/かいほう]してください。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(n)、[追加/ついか]の[空間/くうかん][計算量/けいさんりょう]は O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     match filled<i32> 3 7:
//:         Result::Ok v:
//:             let len_ok <bool> eq len<i32> &v 3
//:             let mid_ok <bool>:
//:                 match get<i32> &v 1:
//:                     Option::Some x:
//:                         eq x 7
//:                     Option::None:
//:                         false
//:             free<i32> v;
//:             if and len_ok mid_ok 0 1
//:         Result::Err _:
//:             1
//: ```
fn filled <.T: Copy> <(i32,.T)->Result<Vec<.T>, StdErrorKind>> (n, value):
    if:
        le n 0
        then:
            Result::Ok<Vec<.T>, StdErrorKind> vec_empty<.T>
        else:
            match alloc_ptr<.T> mul n size_of<.T>:
                Result::Ok data:
                    let mut i <i32> 0
                    while lt i n:
                        do:
                            let write_off <i32> mul i size_of<.T>
                            store<.T> add mem_ptr_addr data write_off value
                            set i add i 1
                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> n n VecStorageState::Owned data
                Result::Err _e:
                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory

//: ## len
//: [要素数/ようそすう]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` に[現在/げんざい][何個/なんこ]の[要素/ようそ]が[入/はい]っているかを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - struct field `len` をそのまま[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 3;
//:     let ok <bool> eq len<i32> &v1 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
fn len <.T> <(&Vec<.T>)->i32> (v):
    *field::get_ref v "len"

//: ## cap
//: [容量/ようりょう]を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - [現在/げんざい][確保/かくほ]されている[要素数/ようそすう]ぶんの[容量/ようりょう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - struct field `cap` をそのまま[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> gt cap<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn cap <.T> <(&Vec<.T>)->i32> (v):
    *field::get_ref v "cap"

//: ## data_ptr
//: [内部/ないぶ]データ[領域/りょういき]の raw address を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - [既存/きぞん] API との[互換/ごかん]のため、`MemPtr<.T>` の[番地/ばんち]を `i32` として[取/と]り[出/だ]します。
//:
//: ### [実装/じっそう]
//: - field `data` の `MemPtr<.T>` を `mem_ptr_addr` で raw address に[戻/もど]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は[生/なま]アドレスなので、[範囲/はんい]・[寿命/じゅみょう]・[再確保/さいかくほ]を[呼/よ]び[出/だ]し[側/がわ]で[管理/かんり]する[必要/ひつよう]があります。
//: - [新規/しんき]コードでは、できるだけ `data_mem_ptr` を[優先/ゆうせん]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> gt data_ptr<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn data_ptr <.T> <(&Vec<.T>)->i32> (v):
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    mem_ptr_addr vec_storage_mem_ptr<.T> v_storage v_data

//: ## data_mem_ptr
//: [内部/ないぶ]データ[領域/りょういき]を `MemPtr<.T>` として[返/かえ]す
//:
//: ### [目的/もくてき]
//: - `alloc/collections` [内部/ないぶ]で `Vec<.T>` の[要素/ようそ][領域/りょういき]を型付きポインタとして[安全/あんぜん]に[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - field `data` をそのまま[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [主/おも]に stdlib [内部/ないぶ]の[実装/じっそう][補助/ほじょ]を[想定/そうてい]した API です。
//: - [再確保/さいかくほ]が[起/お]きると pointer は[無効化/むこうか]されうるので、[長期/ちょうき][保持/ほじ]は[避/さ]けます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/mem" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> gt mem_ptr_addr data_mem_ptr<i32> &v 0
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn data_mem_ptr <.T> <(&Vec<.T>)->MemPtr<.T>> (v):
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    vec_storage_mem_ptr<.T> v_storage v_data

//: ## data_len
//: [内部/ないぶ]バッファ[先頭/せんとう]と[要素数/ようそすう]を[同時/どうじ]に[返/かえ]す
//:
//: ### [目的/もくてき]
//: - sort [系/けい] helper のように `data` と `len` を[同時/どうじ]に[使/つか]う[処理/しょり]で、field [名/めい]つきの struct を[得/え]られるようにします。
//:
//: ### [使用例/しようれい]
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/field" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 7;
//:     let s data_len<i32> &v1;
//:     let ok <bool> and gt mem_ptr_addr get s "data" 0 eq get s "len" 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
//:
//: ### [実装/じっそう]
//: - `Vec<.T>` から `data` と `len` を[取/と]り[出/だ]し、`VecDataLen<.T>` として[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `data` は `MemPtr<.T>` なので、[生/なま]アドレスが[必要/ひつよう]な[場合/ばあい]は `mem_ptr_addr` を[通/とお]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん][計算量/けいさんりょう]は O(1) です。
fn data_len <.T> <(&Vec<.T>)->VecDataLen<.T>> (v):
    let v_len <i32> *field::get_ref v "len"
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let v_data <MemPtr<.T>> vec_storage_mem_ptr<.T> v_storage raw_data
    VecDataLen<.T> v_data v_len

//: ## is_empty
//: [空/から]かどうかを[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `len == 0` なら true を[返/かえ]し、[要素/ようそ]が[存在/そんざい]しないことを[判定/はんてい]します。
//:
//: ### [実装/じっそう]
//: - field `len` を[読/よ]み、0 と[比較/ひかく]します。
//:
//: ### [注意/ちゅうい]
//: - [変更/へんこう]を[伴/ともな]わない[読/よ]み[取/と]り API です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     let ok <bool> is_empty<i32> &v
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn is_empty <.T> <(&Vec<.T>)->bool> (v):
    eq len<.T> v 0

//: ## push
//: [末尾/まつび]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [目的/もくてき]
//: - `item` を[末尾/まつび]へ[追加/ついか]し、[必要/ひつよう]なら[再確保/さいかくほ]した `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len` / `cap` は `&v` から Copy field として[読/よ]み、`data` owner は[戻/もど]り[値/ち]または dealloc/realloc へ[移動/いどう]します。
//: - [容量/ようりょう][不足/ぶそく]なら 2 [倍/ばい]へ[拡張/かくちょう]し、typed `realloc_ptr<.T>` を[用/もち]います。
//: - [空/から][容量/ようりょう] 0 の `Vec` に対しては 1 [要素分/ようそぶん]から[開始/かいし]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `Result<Vec<.T>, StdErrorKind>` です。`unwrap_ok` や `match` で[受/う]け[取/と]り[直/なお]してください。
//: - [再確保/さいかくほ]が[起/お]きると[内部/ないぶ]バッファ[番地/ばんち]は[変/か]わります。
//: - [容量/ようりょう][拡張/かくちょう]に[失敗/しっぱい]した[場合/ばあい]、入力 `Vec` の owner はこの[関数/かんすう]が[消費/しょうひ]し、旧 buffer を[解放/かいほう]してから `Err` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [償却/しょうきゃく] O(1)
//: - [最悪/さいあく] O(n)（[再確保/さいかくほ]が[起/お]きる[場合/ばあい]）
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 7;
//:     let ok <bool> eq len<i32> &v1 1
//:     free<i32> v1;
//:     if ok 0 1
//: ```
fn push <.T> <(Vec<.T>,.T)->Result<Vec<.T>, StdErrorKind>> (v, item):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    if:
        eq v_len v_cap
        then:
            let grown_cap <i32> if eq v_cap 0 1 mul v_cap 2
            let old_bytes <i32> mul v_cap size_of<.T>
            let new_bytes <i32> mul grown_cap size_of<.T>
            match v_storage:
                VecStorageState::Empty:
                    if:
                        and eq v_len 0 eq v_cap 0
                        then:
                            match alloc_ptr<.T> new_bytes:
                                Result::Ok grown_data:
                                    let write_off <i32> mul v_len size_of<.T>
                                    let write_ptr <i32> add mem_ptr_addr grown_data write_off
                                    let next_len <i32> add v_len 1
                                    store<.T> write_ptr item
                                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len grown_cap VecStorageState::Owned grown_data
                                Result::Err _e:
                                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory
                        else:
                            Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::InvalidOperation
                VecStorageState::Owned:
                    match realloc_ptr<.T> v_data old_bytes new_bytes:
                        Result::Ok grown_data:
                            let write_off <i32> mul v_len size_of<.T>
                            let write_ptr <i32> add mem_ptr_addr grown_data write_off
                            let next_len <i32> add v_len 1
                            store<.T> write_ptr item
                            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len grown_cap VecStorageState::Owned grown_data
                        Result::Err _e:
                            dealloc_raw mem_ptr_addr v_data old_bytes
                            Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::OutOfMemory
        else:
            match v_storage:
                VecStorageState::Empty:
                    Result::Err<Vec<.T>, StdErrorKind> StdErrorKind::InvalidOperation
                VecStorageState::Owned:
                    let write_off <i32> mul v_len size_of<.T>
                    let write_ptr <i32> add mem_ptr_addr v_data write_off
                    let next_len <i32> add v_len 1
                    store<.T> write_ptr item
                    Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> next_len v_cap VecStorageState::Owned v_data

//: ## get
//: [要素/ようそ]を[取得/しゅとく]する
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら `Option::Some`、[範囲外/はんいがい]なら `Option::None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `idx` の[範囲/はんい]を[判定/はんてい]し、[妥当/だとう]な[場合/ばあい]だけ typed `load` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - `idx` が[負/ふ]でも `Option::None` です。
//: - [失敗/しっぱい]を trap ではなく `Option` で[返/かえ]す[設計/せっけい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 9;
//:     match get<i32> &v1 0:
//:         Option::Some x:
//:             free<i32> v1;
//:             if eq x 9 0 1
//:         Option::None:
//:             free<i32> v1;
//:             1
//: ```
fn get <.T: Copy> <(&Vec<.T>,i32)->Option<.T>> (v, idx):
    let v_len <i32> *field::get_ref v "len"
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    if:
        lt idx 0
        then none<.T>
        else:
            if:
                le v_len idx
                then none<.T>
                else:
                    match v_storage:
                        VecStorageState::Empty:
                            none<.T>
                        VecStorageState::Owned:
                            let read_off <i32> mul idx size_of<.T>
                            some<.T> load<.T> add mem_ptr_addr v_data read_off

//: ## replace
//: [要素/ようそ]を[上書/うわが]きする（[範囲外/はんいがい]は[無視/むし]）
//:
//: ### [目的/もくてき]
//: - `idx` が[範囲内/はんいない]なら[指定/してい]した[要素/ようそ]へ[置/お]き[換/か]えます。
//:
//: ### [実装/じっそう]
//: - `idx` を[検査/けんさ]し、[妥当/だとう]な[場合/ばあい]だけ typed `store` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [範囲外/はんいがい]では[失敗/しっぱい]を[返/かえ]さず、[何/なに]も[変更/へんこう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     replace<i32> &v1 0 5;
//:     free<i32> v1;
//:     0
//: ```
fn replace <.T: Copy> <(&Vec<.T>,i32,.T)*>()> (v, idx, item):
    let v_len <i32> *field::get_ref v "len"
    let v_storage <VecStorageState> *field::get_ref v "storage"
    let v_data <MemPtr<.T>> *field::get_ref v "data"
    if:
        lt idx 0
        then ()
        else:
            if:
                le v_len idx
                then ()
                else:
                    match v_storage:
                        VecStorageState::Empty:
                            ()
                        VecStorageState::Owned:
                            let write_off <i32> mul idx size_of<.T>
                            store<.T> add mem_ptr_addr v_data write_off item

//: ## pop
//: [末尾/まつび][要素/ようそ]を[取/と]り[出/だ]す
//:
//: ### [目的/もくてき]
//: - [末尾/まつび][要素/ようそ]を `Option` で[返/かえ]し、[長/なが]さを 1 [減/へ]らした `Vec` を[同時/どうじ]に[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `len == 0` なら `Option::None` です。
//: - [要素/ようそ]がある[場合/ばあい]は[最後/さいご]の 1 [件/けん]を typed `load` し、`len - 1` の `Vec` と[組/く]にして[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [返/かえ]り[値/あたい]は `VecPop<.T>` です。
//: - [確保/かくほ]も[解放/かいほう]も[行/おこな]わないため O(1) です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 4;
//:     let p pop<i32> v1;
//:     let next <Vec<i32>> get p "vec";
//:     free<i32> next;
//:     0
//: ```
fn pop <.T> <(Vec<.T>)->VecPop<.T>> (v):
    let v_len <i32> *field::get_ref &v "len"
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    if:
        eq v_len 0
        then:
            VecPop<.T> (Vec<.T> v_len v_cap v_storage v_data) none<.T>
        else:
            match v_storage:
                VecStorageState::Empty:
                    VecPop<.T> vec_empty<.T> none<.T>
                VecStorageState::Owned:
                    let next_len <i32> sub v_len 1
                    let read_off <i32> mul next_len size_of<.T>
                    let item <.T> load<.T> add mem_ptr_addr v_data read_off
                    VecPop<.T> (Vec<.T> next_len v_cap VecStorageState::Owned v_data) some<.T> item

//: ## clear
//: [要素/ようそ]をすべて[削除/さくじょ]する
//:
//: ### [目的/もくてき]
//: - `len` を 0 にして、[確保済/かくほず]み[領域/りょういき]を[再利用/さいりよう]できる[空/から]ベクタを[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `data` と `cap` はそのままに、`len` だけを 0 にします。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ]メモリは[解放/かいほう]しません。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok new<i32>;
//:     let v1 <Vec<i32>> unwrap_ok push v0 1;
//:     let v2 clear<i32> v1;
//:     let ok <bool> eq len<i32> &v2 0
//:     free<i32> v2;
//:     if ok 0 1
//: ```
fn clear <.T> <(Vec<.T>)->Vec<.T>> (v):
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    Vec<.T> 0 v_cap v_storage v_data

//: ## vec_read_at
//: `MemPtr<.T>` から[添字/そえじ][位置/いち]の[要素/ようそ]を[読/よ]む[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` の[内部/ないぶ] loop で、typed `load` の byte offset [計算/けいさん]を 1 [箇所/かしょ]へまとめます。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` を[用/もち]いて `data` から byte offset を[計算/けいさん]し、その[位置/いち]を typed `load<.T>` します。
//:
//: ### [注意/ちゅうい]
//: - [範囲/はんい][検査/けんさ]は[行/おこな]いません。`idx` の[妥当性/だとうせい]は[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]する[前提/ぜんてい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 9 |> uwok
//:         |> push 11 |> uwok
//:     let ok <bool> eq vec_read_at<i32> data_mem_ptr<i32> &v 1 11
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_read_at <.T> <(MemPtr<.T>, i32)->.T> (data, idx):
    load<.T> add mem_ptr_addr data mul idx size_of<.T>

//: ## vec_write_at
//: `MemPtr<.T>` の[添字/そえじ][位置/いち]へ[要素/ようそ]を[書/か]く[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` [内部/ないぶ]の copy / map / filter 実装で、typed `store` の byte offset [計算/けいさん]を[共通化/きょうつうか]します。
//:
//: ### [実装/じっそう]
//: - `idx * size_of<.T>` を[用/もち]いて byte offset を[求/もと]め、typed `store<.T>` を[行/おこな]います。
//:
//: ### [注意/ちゅうい]
//: - [範囲/はんい][検査/けんさ]は[行/おこな]いません。[書/か]き[込/こ]み[先/さき]が[確保/かくほ]ずみであることを[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]する[前提/ぜんてい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v0 <Vec<i32>> unwrap_ok with_capacity<i32> 2;
//:     let data data_mem_ptr<i32> &v0;
//:     vec_write_at<i32> data 0 12;
//:     let ok <bool> eq vec_read_at<i32> data 0 12
//:     free<i32> v0;
//:     if ok 0 1
//: ```
fn vec_write_at <.T> <(MemPtr<.T>, i32, .T)->()> (data, idx, item):
    store<.T> add mem_ptr_addr data mul idx size_of<.T> item

//: ## vec_fold_impl
//: `fold` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から[末尾/まつび]まで[左/ひだり]に acc を[進/すす]める `fold` を、raw pointer と index だけで[表現/ひょうげん]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら acc を[返/かえ]し、それ[以外/いがい]は `f acc item` を[計算/けいさん]して `idx + 1` へ[再帰/さいき]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので、`data` と `len` の[整合性/せいごうせい]は[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_fold_impl<i32,i32> p 3 0 0 add_acc 6
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_fold_impl <.T,.U> <(MemPtr<.T>, i32, i32, .U, (.U,.T)->.U)->.U> (data, len, idx, acc, f):
    if:
        eq idx len
        then acc
        else:
            let next_acc <.U> f acc vec_read_at<.T> data idx
            let next_idx <i32> add idx 1
            vec_fold_impl<.T,.U> data len next_idx next_acc f

//: ## vec_reduce_impl
//: `reduce` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう][要素/ようそ]を[初期値/しょきち]にした[左畳/ひだりたた]み[込/こ]みを raw pointer + index で[実装/じっそう]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら acc を[返/かえ]し、それ[以外/いがい]は[現在/げんざい][要素/ようそ]を[読/よ]んで `f acc item` を[次/つぎ]の acc にします。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` の[判定/はんてい]は[外側/そとがわ]の `reduce` が[担/にな]います。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_reduce_impl<i32> p 3 1 1 add_acc 6
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_reduce_impl <.T> <(MemPtr<.T>, i32, i32, .T, (.T,.T)->.T)->.T> (data, len, idx, acc, f):
    if:
        eq idx len
        then acc
        else:
            let next_acc <.T> f acc vec_read_at<.T> data idx
            let next_idx <i32> add idx 1
            vec_reduce_impl<.T> data len next_idx next_acc f

//: ## vec_find_impl
//: `find` の[再帰/さいき][本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から[順番/じゅんばん]に[条件/じょうけん]を[試/ため]し、[最初/さいしょ]の[一致/いっち]だけを[返/かえ]す処理を raw pointer で[共通化/きょうつうか]します。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら `none`、それ[以外/いがい]は item を[読/よ]んで `p item` を[判定/はんてい]し、[見/み]つかれば `some`、まだなら[次/つぎ]へ[再帰/さいき]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので[範囲/はんい][検査/けんさ]は `len` に[依存/いそん]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n - idx)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     match vec_find_impl<i32> p 2 0 gt_two:
//:         Option::Some x:
//:             free<i32> v;
//:             if eq x 3 0 1
//:         Option::None:
//:             free<i32> v;
//:             1
//: ```
fn vec_find_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->Option<.T>> (data, len, idx, p):
    if:
        eq idx len
        then none<.T>
        else:
            let item <.T> vec_read_at<.T> data idx
            if:
                cond p item
                then some<.T> item
                else:
                    let next_idx <i32> add idx 1
                    vec_find_impl<.T> data len next_idx p

//: ## vec_take_while_len_impl
//: `take_while` / `drop_while` の[境界/きょうかい][位置/いち]を[求/もと]める[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - [先頭/せんとう]から `p` が true の[間/あいだ]だけ[進/すす]み、prefix の[長/なが]さを `i32` で[返/かえ]します。
//: - `take_while` と `drop_while` が[同/おな]じ[境界/きょうかい][探索/たんさく]を[共有/きょうゆう]できるようにします。
//:
//: ### [実装/じっそう]
//: - `idx == len` なら[末尾/まつび]まで[到達/とうたつ]したとみなし、[現在/げんざい]の `idx` を[返/かえ]します。
//: - `idx` から[末尾/まつび]へ while loop で[進/すす]み、最初に `p (data[i])` が false になった[位置/いち]を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [内部/ないぶ] helper なので、`data` と `len` の[整合性/せいごうせい]は[呼/よ]び[出/だ]し[側/がわ]が[保証/ほしょう]する[前提/ぜんてい]です。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]を[想定/そうてい]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(k) ただし k は[先頭/せんとう]から[最初/さいしょ]に false になるまでの[走査/そうさ][長/ちょう]です。
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let v <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let p <MemPtr<i32>> data_mem_ptr<i32> &v
//:     let ok <bool> eq vec_take_while_len_impl<i32> p 3 0 lt_three 2
//:     free<i32> v;
//:     if ok 0 1
//: ```
fn vec_take_while_len_impl <.T> <(MemPtr<.T>, i32, i32, (.T)->bool)->i32> (data, len, idx, p):
    let mut i <i32> idx
    let mut active <bool> true
    while and active lt i len:
        do:
            if:
                cond p vec_read_at<.T> data i
                then:
                    set i add i 1
                else:
                    set active false
    i

//: ## vec_write_prefix_impl
//: [連続部分/れんぞくぶぶん]を[別/べつ]バッファへ[複写/ふくしゃ]する[内部/ないぶ] helper
//:
//: ### [目的/もくてき]
//: - `take_while` / `drop_while` のように、[入力/にゅうりょく] `Vec` の prefix や suffix を[新規/しんき]バッファへ[順番/じゅんばん]どおり[複写/ふくしゃ]する[共通/きょうつう]処理を[切/き]り[出/だ]します。
//:
//: ### [実装/じっそう]
//: - `src_from` から `count` [件/けん]だけ `vec_read_at` / `vec_write_at` を[繰/く]り[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [呼/よ]び[出/だ]し[側/がわ]が[出力先/しゅつりょくさき]バッファの[十分/じゅうぶん]な[容量/ようりょう]を[確保/かくほ]している[前提/ぜんてい]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(count)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let src <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 7 |> uwok
//:         |> push 8 |> uwok
//:         |> push 9 |> uwok
//:     let src_data <MemPtr<i32>> data_mem_ptr<i32> &src
//:     let dst <Vec<i32>> unwrap_ok with_capacity<i32> 2
//:     let dst_data <MemPtr<i32>> data_mem_ptr<i32> &dst
//:     vec_write_prefix_impl<i32> src_data dst_data 1 2;
//:     let ok <bool> eq vec_read_at<i32> dst_data 1 9
//:     free<i32> src;
//:     free<i32> dst;
//:     if ok 0 1
//: ```
fn vec_write_prefix_impl <.T> <(MemPtr<.T>, MemPtr<.T>, i32, i32)->()> (src_data, out_data, src_from, count):
    let mut i <i32> 0
    while lt i count:
        do:
            vec_write_at<.T> out_data i vec_read_at<.T> src_data add src_from i
            set i add i 1

//: ## map
//: [各要素/かくようそ]を[同/おな]じ[規則/きそく]で[変換/へんかん]する
//:
//: ### [目的/もくてき]
//: - `xs |> map f` の[形/かたち]で、`Vec<.T>` の[全要素/ぜんようそ]へ[同/おな]じ[純粋/じゅんすい][関数/かんすう]を[適用/てきよう]します。
//: - [元/もと]の[順序/じゅんじょ]を[保/たも]ったまま、[新/あたら]しい `Vec<.U>` を[作成/さくせい]します。
//:
//: ### [実装/じっそう]
//: - [入力/にゅうりょく]の `len` と[同/おな]じ[容量/ようりょう]を[先/さき]に[確保/かくほ]し、raw loop で[順番/じゅんばん]に[書/か]き[込/こ]みます。
//: - [出力/しゅつりょく] `Vec` の `len` は[最後/さいご]に[確定/かくてい]させ、[途中/とちゅう]で[再確保/さいかくほ]を[発生/はっせい]させません。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result<Vec<.U>, StdErrorKind>` を[返/かえ]します。
//: - `f` は `(.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn inc <(i32)->i32> (x):
//:     add x 1
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ys <Vec<i32>> unwrap_ok map<i32,i32> xs inc;
//:     match get<i32> &ys 2:
//:         Option::Some x:
//:             free<i32> ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free<i32> ys;
//:             1
//: ```
fn map <.T,.U> <(Vec<.T>, (.T)->.U)->Result<Vec<.U>, StdErrorKind>> (v, f):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    match with_capacity<.U> src_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.U>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.U>> field::get out0 "data"
            let mut i <i32> 0
            while lt i src_len:
                do:
                    vec_write_at<.U> out_data i f vec_read_at<.T> src_data i
                    set i add i 1
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.U>, StdErrorKind> Vec<.U> src_len out_cap out_storage out_data

//: ## filter
//: [条件/じょうけん]を[満/み]たす[要素/ようそ]だけを[残/のこ]す
//:
//: ### [目的/もくてき]
//: - `xs |> filter p` の[形/かたち]で、[条件/じょうけん] `p` を[満/み]たす[要素/ようそ]だけを[残/のこ]した[新/あたら]しい `Vec<.T>` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で[残/のこ]す[要素数/ようそすう]を[数/かぞ]え、2 [回目/かいめ]の loop で exact capacity の[出力/しゅつりょく]バッファへ[詰/つ]めます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - [新規/しんき][領域/りょういき]の[確保/かくほ]が[必要/ひつよう]なので `Result<Vec<.T>, StdErrorKind>` を[返/かえ]します。
//: - `p` は `(.T)->bool` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let ys <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let zs <Vec<i32>> unwrap_ok filter<i32> ys is_even;
//:     let ok <bool> eq len<i32> &zs 2
//:     free<i32> zs;
//:     if ok 0 1
//: ```
fn filter <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let mut keep_len <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set keep_len add keep_len 1
                else ()
            set i add i 1
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            let mut read_i <i32> 0
            let mut write_i <i32> 0
            while lt read_i src_len:
                do:
                    let item <.T> vec_read_at<.T> src_data read_i
                    if:
                        cond p item
                        then:
                            vec_write_at<.T> out_data write_i item
                            set write_i add write_i 1
                        else ()
                    set read_i add read_i 1
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## partition
//: [条件/じょうけん]で 2 [群/ぐん]に[分/わ]ける
//:
//: ### [目的/もくてき]
//: - `xs |> partition p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]と、[満/み]たさない[要素/ようそ]へ[分割/ぶんかつ]します。
//: - [返/かえ]り[値/あたい]は `VecPartition` です。`matched` と `rest` の両方を継続利用または `free` してください。
//:
//: ### [実装/じっそう]
//: - 1 [回目/かいめ]の loop で `matched` の[要素数/ようそすう]だけを[数/かぞ]え、2 [回目/かいめ]で exact capacity の 2 [本/ほん]の `Vec` へ[振/ふ]り[分/わ]けます。
//: - [入力/にゅうりょく][順序/じゅんじょ]は[両方/りょうほう]の[出力/しゅつりょく]で[維持/いじ]します。
//:
//: ### [注意/ちゅうい]
//: - 2 [本/ほん]の[新規/しんき] `Vec` を[確保/かくほ]するので `Result<VecPartition<.T>, StdErrorKind>` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/field" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let parts unwrap_ok partition<i32> xs is_even;
//:     let evens get parts "matched";
//:     let rest get parts "rest";
//:     let ok <bool> eq len<i32> &evens 1
//:     free<i32> evens;
//:     free<i32> rest;
//:     if ok 0 1
//: ```
fn partition <.T> <(Vec<.T>, (.T)->bool)->Result<VecPartition<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let mut left_len <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set left_len add left_len 1
                else ()
            set i add i 1
    let right_len <i32> sub src_len left_len
    match with_capacity<.T> left_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<VecPartition<.T>, StdErrorKind> e
        Result::Ok left0:
            match with_capacity<.T> right_len:
                Result::Err e:
                    let left0_cap <i32> *field::get_ref &left0 "cap"
                    let left0_storage <VecStorageState> *field::get_ref &left0 "storage"
                    let left0_data <MemPtr<.T>> field::get left0 "data"
                    vec_free_storage<.T> left0_storage left0_data left0_cap
                    vec_free_storage<.T> src_storage src_data src_cap
                    Result::Err<VecPartition<.T>, StdErrorKind> e
                Result::Ok right0:
                    let left_cap <i32> *field::get_ref &left0 "cap"
                    let left_storage <VecStorageState> *field::get_ref &left0 "storage"
                    let left_data <MemPtr<.T>> field::get left0 "data"
                    let right_cap <i32> *field::get_ref &right0 "cap"
                    let right_storage <VecStorageState> *field::get_ref &right0 "storage"
                    let right_data <MemPtr<.T>> field::get right0 "data"
                    let mut read_i <i32> 0
                    let mut left_i <i32> 0
                    let mut right_i <i32> 0
                    while lt read_i src_len:
                        do:
                            let item <.T> vec_read_at<.T> src_data read_i
                            if:
                                cond p item
                                then:
                                    vec_write_at<.T> left_data left_i item
                                    set left_i add left_i 1
                                else:
                                    vec_write_at<.T> right_data right_i item
                                    set right_i add right_i 1
                            set read_i add read_i 1
                    vec_free_storage<.T> src_storage src_data src_cap
                    Result::Ok<VecPartition<.T>, StdErrorKind> VecPartition<.T> (Vec<.T> left_len left_cap left_storage left_data) (Vec<.T> right_len right_cap right_storage right_data)

//: ## take_while
//: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]だけを[取/と]る
//:
//: ### [目的/もくてき]
//: - `xs |> take_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]だけを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [最初/さいしょ]に[打/う]ち[切/き]り[位置/いち]を[求/もと]め、その prefix [長/ちょう]だけ exact capacity を[確保/かくほ]して[順番/じゅんばん]に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - `filter` と[違/ちが]い、[途中/とちゅう]で `p` が false になったら[残/のこ]りは[見/み]ません。
//:
//: ### [計算量/けいさんりょう]
//: - O(k) ただし k は[最初/さいしょ]に false になるまでの[走査/そうさ]と[複写/ふくしゃ]を[含/ふく]む
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys <Vec<i32>> unwrap_ok take_while<i32> xs lt_three;
//:     let ok <bool> eq len<i32> &ys 2
//:     free<i32> ys;
//:     if ok 0 1
//: ```
fn take_while <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let keep_len <i32> vec_take_while_len_impl<.T> src_data src_len 0 p
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            vec_write_prefix_impl<.T> src_data out_data 0 keep_len
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## drop_while
//: [条件/じょうけん]が[成/な]り[立/た]つ[先頭/せんとう][連続部分/れんぞくぶぶん]を[捨/す]てる
//:
//: ### [目的/もくてき]
//: - `xs |> drop_while p` の[形/かたち]で、[先頭/せんとう]から `p` が[真/しん]である[間/あいだ]を[飛/と]ばし、その[残/のこ]りを[新/あたら]しい `Vec` として[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - `take_while` と[同/おな]じ helper で[打/う]ち[切/き]り[位置/いち]を[求/もと]め、そこから[末尾/まつび]までを exact capacity の[新規/しんき] `Vec` に[複写/ふくしゃ]します。
//:
//: ### [注意/ちゅうい]
//: - [全要素/ぜんようそ]が `p` を[満/み]たす[場合/ばあい]は[空/から] `Vec` を[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn lt_three <(i32)->bool> (x):
//:     lt x 3
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ys <Vec<i32>> unwrap_ok drop_while<i32> xs lt_three;
//:     match get<i32> &ys 0:
//:         Option::Some x:
//:             free<i32> ys;
//:             if eq x 4 0 1
//:         Option::None:
//:             free<i32> ys;
//:             1
//: ```
fn drop_while <.T> <(Vec<.T>, (.T)->bool)->Result<Vec<.T>, StdErrorKind>> (v, p):
    let src_len <i32> *field::get_ref &v "len"
    let src_cap <i32> *field::get_ref &v "cap"
    let src_storage <VecStorageState> *field::get_ref &v "storage"
    let src_data <MemPtr<.T>> field::get v "data"
    let drop_len <i32> vec_take_while_len_impl<.T> src_data src_len 0 p
    let keep_len <i32> sub src_len drop_len
    match with_capacity<.T> keep_len:
        Result::Err e:
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Err<Vec<.T>, StdErrorKind> e
        Result::Ok out0:
            let out_cap <i32> *field::get_ref &out0 "cap"
            let out_storage <VecStorageState> *field::get_ref &out0 "storage"
            let out_data <MemPtr<.T>> field::get out0 "data"
            vec_write_prefix_impl<.T> src_data out_data drop_len keep_len
            vec_free_storage<.T> src_storage src_data src_cap
            Result::Ok<Vec<.T>, StdErrorKind> Vec<.T> keep_len out_cap out_storage out_data

//: ## count
//: [条件/じょうけん]を[満/み]たす[要素数/ようそすう]を[数/かぞ]える
//:
//: ### [目的/もくてき]
//: - `xs |> count p` の[形/かたち]で、`p` が true になる[要素/ようそ]の[個数/こすう]を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[末尾/まつび]まで 1 [回/かい]だけ[走査/そうさ]し、true のたびに[加算/かさん]します。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:         |> push 4 |> uwok
//:     let ok <bool> eq count<i32> &xs is_even 2
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn count <.T: Copy> <(&Vec<.T>, (.T)->bool)->i32> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <i32> 0
    let mut i <i32> 0
    while lt i src_len:
        do:
            if cond p vec_read_at<.T> src_data i:
                then set out add out 1
                else ()
            set i add i 1
    out

//: ## fold
//: [左/ひだり]から[順/じゅん]に[畳/たた]み[込/こ]む
//:
//: ### [目的/もくてき]
//: - `xs |> fold init f` の[形/かたち]で、[初期値/しょきち] `init` から[始/はじ]めて[全要素/ぜんようそ]を 1 つの[値/あたい]へ[集約/しゅうやく]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]から `len - 1` まで[順番/じゅんばん]に `f acc item` を[適用/てきよう]し、[更新後/こうしんご]の acc を[次/つぎ]へ[渡/わた]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `init` をそのまま[返/かえ]します。
//: - `f` は `(.U,.T)->.U` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     let ok <bool> eq fold<i32,i32> &xs 10 add_acc 16
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn fold <.T: Copy,.U> <(&Vec<.T>, .U, (.U,.T)->.U)->.U> (v, acc, f):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    vec_fold_impl<.T,.U> src_data src_len 0 acc f

//: ## reduce
//: [初期値/しょきち]なしで[集約/しゅうやく]する
//:
//: ### [目的/もくてき]
//: - [非空/ひくう] `Vec` なら[先頭/せんとう][要素/ようそ]を[初期値/しょきち]として[残/のこ]りを[畳/たた]み[込/こ]み、[空/から]なら `None` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - 0 [番目/ばんめ]を[初期値/しょきち]として[読/よ]み[出/だ]し、1 [番目/ばんめ]から[残/のこ]りを[左畳/ひだりたた]み[込/こ]みします。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `Option::None` です。
//: - `f` は `(.T,.T)->.T` の[純粋/じゅんすい][関数/かんすう]です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn add_acc <(i32,i32)->i32> (acc, x):
//:     add acc x
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 2 |> uwok
//:         |> push 3 |> uwok
//:     match reduce<i32> &xs add_acc:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 6 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
fn reduce <.T: Copy> <(&Vec<.T>, (.T,.T)->.T)->Option<.T>> (v, f):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    if:
        eq src_len 0
        then none<.T>
        else:
            some<.T> vec_reduce_impl<.T> src_data src_len 1 vec_read_at<.T> src_data 0 f

//: ## find
//: [条件/じょうけん]に[合/あ]う[最初/さいしょ]の[要素/ようそ]を[探/さが]す
//:
//: ### [目的/もくてき]
//: - `xs |> find p` の[形/かたち]で、0 [番目/ばんめ]から[順/じゅん]に `p` を[試/ため]し、[最初/さいしょ]に[真/しん]となる[要素/ようそ]を `Some` で[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で[即座/そくざ]に[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [見/み]つからなければ `None` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//:| #import "core/option" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     match find<i32> &xs gt_two:
//:         Option::Some x:
//:             free<i32> xs;
//:             if eq x 3 0 1
//:         Option::None:
//:             free<i32> xs;
//:             1
//: ```
fn find <.T: Copy> <(&Vec<.T>, (.T)->bool)->Option<.T>> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    vec_find_impl<.T> src_data src_len 0 p

//: ## any
//: [条件/じょうけん]を[満/み]たす[要素/ようそ]が 1 つでもあるか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> any p` の[形/かたち]で、`p` を[満/み]たす[要素/ようそ]が 1 つでもあれば `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、[見/み]つかった[時点/じてん]で `true` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `false` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn gt_two <(i32)->bool> (x):
//:     gt x 2
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 1 |> uwok
//:         |> push 3 |> uwok
//:     let ok <bool> any<i32> &xs gt_two
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn any <.T: Copy> <(&Vec<.T>, (.T)->bool)->bool> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <bool> false
    let mut i <i32> 0
    while and lt i src_len not out:
        do:
            set out p vec_read_at<.T> src_data i
            set i add i 1
    out

//: ## all
//: [全要素/ぜんようそ]が[条件/じょうけん]を[満/み]たすか[判定/はんてい]する
//:
//: ### [目的/もくてき]
//: - `xs |> all p` の[形/かたち]で、[全/すべ]ての[要素/ようそ]が `p` を[満/み]たすときだけ `true` を[返/かえ]します。
//:
//: ### [実装/じっそう]
//: - [先頭/せんとう]から[順番/じゅんばん]に `p` を[評価/ひょうか]し、1 [件/けん]でも false が[出/で]たら[即座/そくざ]に[打/う]ち[切/き]ります。
//:
//: ### [注意/ちゅうい]
//: - [空/から] `Vec` では `true` です。
//:
//: ### [計算量/けいさんりょう]
//: - O(n)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//:| #import "core/math" as *
//: fn is_even <(i32)->bool> (x):
//:     eq rem_s x 2 0
//: fn main <()*>i32> ():
//:     let xs <Vec<i32>>:
//:         unwrap_ok new<i32>
//:         |> push 2 |> uwok
//:         |> push 4 |> uwok
//:     let ok <bool> all<i32> &xs is_even
//:     free<i32> xs;
//:     if ok 0 1
//: ```
fn all <.T: Copy> <(&Vec<.T>, (.T)->bool)->bool> (v, p):
    let src_len <i32> *field::get_ref v "len"
    let src_storage <VecStorageState> *field::get_ref v "storage"
    let raw_data <MemPtr<.T>> *field::get_ref v "data"
    let src_data <MemPtr<.T>> vec_storage_mem_ptr<.T> src_storage raw_data
    let mut out <bool> true
    let mut i <i32> 0
    while and lt i src_len out:
        do:
            set out p vec_read_at<.T> src_data i
            set i add i 1
    out

//: ## free
//: [内部/ないぶ]メモリを[解放/かいほう]する
//:
//: ### [目的/もくてき]
//: - `Vec<.T>` が[所有/しょゆう]する `data` [領域/りょういき]を[明示的/めいじてき]に[解放/かいほう]します。
//:
//: ### [実装/じっそう]
//: - `cap` は `&v` から Copy field として[読/よ]み、`data` owner は `dealloc_raw` へ[移動/いどう]します。
//:
//: ### [注意/ちゅうい]
//: - `Vec` [自体/じたい]は[値/あたい]なので[追加/ついか]の[解放/かいほう]は[不要/ふよう]です。
//: - `cap = 0` の[空/から]ベクタでも[呼/よ]べます。
//:
//: ### [計算量/けいさんりょう]
//: - O(1)
//:
//: ### [使用例/しようれい]
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as *
//: fn main <()*>i32> ():
//:     let v <Vec<i32>> unwrap_ok new<i32>;
//:     free<i32> v;
//:     0
//: ```
fn free <.T> <(Vec<.T>)->()> (v):
    let v_cap <i32> *field::get_ref &v "cap"
    let v_storage <VecStorageState> *field::get_ref &v "storage"
    let v_data <MemPtr<.T>> field::get v "data"
    vec_free_storage<.T> v_storage v_data v_cap
