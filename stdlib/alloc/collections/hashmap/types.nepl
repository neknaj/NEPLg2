//: # alloc/collections/hashmap/types
//: HashMap の型定義と bucket state enum
//:
//: ### [目的/もくてき]
//: - HashMap の storage / table / probing result 型を 1 module に集約します。
//: - bucket 状態は numeric sentinel ではなく enum として表し、probe logic 側で `match` 網羅性検査を効かせます。

#indent 4

#import "core/option" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "core/traits/hash_key" as *
#import "core/traits/hash" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as *

//: ## HashMapBucketState
//: hash table の 1 bucket の[状態/じょうたい]
//:
//: ### [目的/もくてき]
//: - empty / full / tombstone を enum として[表/あらわ]し、`match` で[分岐/ぶんき]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap/types" as *
//: fn main %impure fn void i32 \void:
//:     match HashMapBucketState::Tombstone:
//:         HashMapBucketState::Empty:
//:             1
//:         HashMapBucketState::Full:
//:             1
//:         HashMapBucketState::Tombstone:
//:             0
//: ```
pub enum HashMapBucketState:
    Empty
    Full
    Tombstone

impl Clone for HashMapBucketState:
    fn clone %fn &HashMapBucketState HashMapBucketState \state:
        *state

impl Copy for HashMapBucketState:
    fn copy_mark %fn HashMapBucketState HashMapBucketState \state:
        state

//: ## HashMapInsertSlotState
//: insertion 先 slot が empty 由来か tombstone 由来かを[表/あらわ]す
//:
//: ### [目的/もくてき]
//: - tombstone を[再利用/さいりよう]した[場合/ばあい]だけ tombstone count を[減/へ]らせるようにします。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap/types" as *
//: fn main %impure fn void i32 \void:
//:     match HashMapInsertSlotState::EmptySlot:
//:         HashMapInsertSlotState::EmptySlot:
//:             0
//:         HashMapInsertSlotState::TombstoneSlot:
//:             1
//: ```
pub enum HashMapInsertSlotState:
    EmptySlot
    TombstoneSlot

impl Clone for HashMapInsertSlotState:
    fn clone %fn &HashMapInsertSlotState HashMapInsertSlotState \state:
        *state

impl Copy for HashMapInsertSlotState:
    fn copy_mark %fn HashMapInsertSlotState HashMapInsertSlotState \state:
        state

//: ## HashMapInsertSlot
//: insertion 先の index と[状態/じょうたい]
//:
//: ### [目的/もくてき]
//: - linear probing の[結果/けっか]を index と slot state の組として[返/かえ]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/hashmap/types" as *
//:| #import "core/field" as field
//:| #import "core/math" as *
//: fn main %impure fn void i32 \void:
//:     let slot %HashMapInsertSlot HashMapInsertSlot 3 HashMapInsertSlotState::EmptySlot;
//:     if eq field::get slot "index" 3 0 1
//: ```
pub struct HashMapInsertSlot:
    index %i32
    state %HashMapInsertSlotState

//: ## HashMapStorage
//: HashMap の backing storage
//:
//: ### [目的/もくてき]
//: - 状態配列、key 配列、value 配列の owner を 1 [値/あたい]にまとめます。
//:
//: ### [注意/ちゅうい]
//: - `states.len == keys.len == values.len == cap` を内部不変条件とします。
pub struct HashMapStorage<.K,.V>:
    states %Vec HashMapBucketState
    keys %Vec Option .K
    values %Vec Option .V

//: ## HashMap
//: hash map [本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - [要素数/ようそすう]・[容量/ようりょう]・tombstone 数・storage・hasher をまとめて[保持/ほじ]します。
pub struct HashMap<.K,.V,.H>:
    count %i32
    cap %i32
    tombstones %i32
    storage %HashMapStorage .K .V
    hasher %.H

//: ## HashMapUpdateError
//: owner-consuming update の[失敗/しっぱい]で[戻/もど]る error payload
//:
//: ### [目的/もくてき]
//: - `insert` / `remove` / rehash が[消費/しょうひ]した `HashMap` owner を caller へ[返/かえ]します。
//: - `Diag` だけを[返/かえ]して owner の cleanup / retry [判断/はんだん]を実装 discipline に[隠/かく]すことを[避/さ]けます。
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashmap" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let hm %HashMap i32 i32 DefaultHash32 unwrap_ok new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashMapUpdateError i32 i32 DefaultHash32 HashMapUpdateError<i32,i32,DefaultHash32> hm d0;
//:     0
//: ```
pub struct HashMapUpdateError<.K,.V,.H>:
    owner %HashMap .K .V .H
    diag %Diag

//: ## hashmap_update_error_diag
//: update [失敗/しっぱい]の `Diag` を owner を[動/うご]かさず[読/よ]む
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashmap" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let hm %HashMap i32 i32 DefaultHash32 unwrap_ok new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashMapUpdateError i32 i32 DefaultHash32 HashMapUpdateError<i32,i32,DefaultHash32> hm d0;
//:     0
//: ```
pub fn hashmap_update_error_diag <.K,.V,.H> %fn &HashMapUpdateError .K .V .H Diag \e:
    *field::get_ref e "diag"

//: ## hashmap_update_error_owner
//: update [失敗/しっぱい]で[戻/もど]された `HashMap` owner を[取/と]り[出/だ]す
//:
//: ### [注意/ちゅうい]
//: - 現行 HashMap は Copy-only key/value/hasher contract で storage cleanup を[行/おこな]うため、この accessor も同じ bound に[限定/げんてい]します。
//:
//: - error payload は update 失敗から得るもので、user code で owner-backed aggregate を直接作れません。
//:
//: neplg2:test[compile_fail]
//: diag_codes: type.owner_aggregate.constructor_restricted
//: ```neplg2
//: #entry main
//: #indent 4
//: #target std
//: #import "alloc/collections/hashmap" as *
//: #import "core/traits/hash" as *
//: #import "alloc/diag/error" as *
//: #import "core/result" as *
//: fn main %impure fn void i32 \void:
//:     let hm %HashMap i32 i32 DefaultHash32 unwrap_ok new DefaultHash32;
//:     let d0 %Diag diag_key_not_found;
//:     let e %HashMapUpdateError i32 i32 DefaultHash32 HashMapUpdateError<i32,i32,DefaultHash32> hm d0;
//:     0
//: ```
pub fn hashmap_update_error_owner <.K: HashKey&Copy,.V: Copy,.H: Hasher<.K>&Copy> %fn HashMapUpdateError .K .V .H HashMap .K .V .H \e:
    field::get e "owner"
