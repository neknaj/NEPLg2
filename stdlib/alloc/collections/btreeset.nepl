//: # btreeset
//: [順序付き/じゅんじょつき] set
//:
//: ### [目的/もくてき]
//: - `BTreeSet<.T>` を[提供/ていきょう]し、`new` / `insert` / `contains` / `remove` / `len` / `clear` / `free` の bare 名で[扱/あつか]えるようにします。
//: - 互換名 `BTreeSet` に[加/くわ]えて、sorted-array としての[性質/せいしつ]を[明示/めいじ]する `sorted_array_set_*` alias を[提供/ていきょう]します。
//: - [要素/ようそ]の[比較/ひかく]は `Ord` trait に[委譲/いじょう]し、`i32` 固定の collection から[脱却/だっきゃく]します。
//:
//: ### [実装/じっそう]
//: - [名前/なまえ]は `BTreeSet` ですが、[実体/じったい]は[整列済/せいれつず]み key [配列/はいれつ]です。
//: - backing storage は `Vec<Option<T>>` で[保持/ほじ]し、live slot は `Some`、inactive slot は `None` で[表/あらわ]します。
//: - [検索/けんさく]は lower_bound、[挿入/そうにゅう] / [削除/さくじょ]は shift で[実装/じっそう]します。
//: - `sorted_array_set_*` alias は[同/おな]じ[実装/じっそう]を[指/さ]し、B-tree [相当/そうとう]の[更新/こうしん][性能/せいのう]を[期待/きたい]しない[用途/ようと]であることを[呼/よ]び[出/だ]し[名/めい]に[残/のこ]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree ではありません。
//: - 大きな mutable set、visited set、module traversal set には[使/つか]わないでください。更新が[多/おお]い[集合/しゅうごう]は `HashSet` を[使/つか]い、安定順の[出力/しゅつりょく]が[必要/ひつよう]な[段階/だんかい]だけ key を[整列/せいれつ]する[構造/こうぞう]を[選/えら]びます。
//: - `.T` は `Copy` を[要求/ようきゅう]します。現行 stdlib には set payload の drop traversal がまだ無いため、非 Copy payload は[扱/あつか]いません。
//: - `len` / `contains` は set を[値/あたい]で[消費/しょうひ]し、内部 storage を[閉/と]じます。owner を[残/のこ]す[読/よ]み[取/と]りは `len_ref` / `contains_ref` を[使/つか]います。
//: - `Ord` impl が[全順序/ぜんじゅんじょ]を[満/み]たすことを[前提/ぜんてい]にします。
//:
//: ### [計算量/けいさんりょう]
//: - `contains_ref` は O(log n)、`insert` / `remove` は O(n) です。

#indent 4

#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/ord" as *
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## BTreeSetStorage
//: [順序付き/じゅんじょつき] set の backing storage
//:
//: ### [不変条件/ふへんじょうけん]
//: - `keys.len == cap`
//: - `0 <= i < len` の slot は `Some`
//: - `len <= i < cap` の slot は `None`
struct BTreeSetStorage<.T>:
    keys <Vec<Option<.T>>>

//: ## BTreeSet
//: [順序付き/じゅんじょつき] key [配列/はいれつ]の[本体/ほんたい]
//:
//: ### [目的/もくてき]
//: - key [配列/はいれつ]と[長/なが]さを 1 [値/あたい]として[所有/しょゆう]します。
//:
//: ### [注意/ちゅうい]
//: - [本物/ほんもの]の B-tree node [分割/ぶんかつ]は[持/も]たず、lower_bound と shift による[単純/たんじゅん][実装/じっそう]です。
struct BTreeSet<.T>:
    len <i32>
    cap <i32>
    storage <BTreeSetStorage<.T>>

fn btreeset_storage_keys <.T> <(&BTreeSetStorage<.T>)->&Vec<Option<.T>>> (storage):
    field::get_ref storage "keys"

fn btreeset_key_eq <.T: Ord> <(.T,.T)->bool> (a, b):
    and not ord_lt a b not ord_lt b a

fn btreeset_key_at <.T: Copy> <(&Vec<Option<.T>>,i32)->Option<.T>> (keys, idx):
    match vec::get<Option<.T>> keys idx:
        Option::Some key_opt:
            key_opt
        Option::None:
            none<.T>

fn btreeset_store_key <.T: Copy> <(&Vec<Option<.T>>,i32,Option<.T>)*>()> (keys, idx, key):
    vec::replace<Option<.T>> keys idx key

fn btreeset_key_slot <.T: Copy> <(&BTreeSetStorage<.T>,i32)->Option<.T>> (storage, idx):
    btreeset_key_at<.T> btreeset_storage_keys<.T> storage idx

fn btreeset_store_key_slot <.T: Copy> <(&BTreeSetStorage<.T>,i32,Option<.T>)*>()> (storage, idx, key):
    btreeset_store_key<.T> btreeset_storage_keys<.T> storage idx key

fn btreeset_lower_bound <.T: Ord&Copy> <(&Vec<Option<.T>>,.T,i32,i32)->i32> (keys, key, low, high):
    if:
        lt low high
        then:
            let mid <i32> div_s add low high 2
            match btreeset_key_at<.T> keys mid:
                Option::Some saved:
                    if:
                        ord_lt saved key
                        then btreeset_lower_bound<.T> keys key add mid 1 high
                        else btreeset_lower_bound<.T> keys key low mid
                Option::None:
                    mid
        else low

fn btreeset_is_at <.T: Ord&Copy> <(&Vec<Option<.T>>,i32,i32,.T)->bool> (keys, len0, idx, key):
    if:
        lt idx len0
        then:
            match btreeset_key_at<.T> keys idx:
                Option::Some saved:
                    btreeset_key_eq<.T> saved key
                Option::None:
                    false
        else false

fn btreeset_lower_bound_storage <.T: Ord&Copy> <(&BTreeSetStorage<.T>,.T,i32,i32)->i32> (storage, key, low, high):
    btreeset_lower_bound<.T> btreeset_storage_keys<.T> storage key low high

fn btreeset_is_at_storage <.T: Ord&Copy> <(&BTreeSetStorage<.T>,i32,i32,.T)->bool> (storage, len0, idx, key):
    btreeset_is_at<.T> btreeset_storage_keys<.T> storage len0 idx key

fn btreeset_free_storage <.T> <(BTreeSetStorage<.T>)->()> (storage):
    let keys <Vec<Option<.T>>> field::get storage "keys"
    vec::free<Option<.T>> keys

fn btreeset_alloc_storage <.T: Copy> <(i32)*>Result<BTreeSetStorage<.T>, Diag>> (cap):
    match vec::filled<Option<.T>> cap none<.T>:
        Result::Err _e:
            diag_err<BTreeSetStorage<.T>> diag_out_of_memory
        Result::Ok keys:
            ok<BTreeSetStorage<.T>, Diag> BTreeSetStorage<.T> keys

fn btreeset_copy_live_slots <.T: Copy> <(&BTreeSetStorage<.T>,&BTreeSetStorage<.T>,i32)*>()> (src, dst, len0):
    let src_keys <&Vec<Option<.T>>> btreeset_storage_keys<.T> src
    let dst_keys <&Vec<Option<.T>>> btreeset_storage_keys<.T> dst
    let mut i <i32> 0
    while lt i len0:
        do:
            match btreeset_key_at<.T> src_keys i:
                Option::Some key:
                    btreeset_store_key<.T> dst_keys i some<.T> key
                Option::None:
                    ()
            set i add i 1

fn btreeset_clear_slots <.T: Copy> <(&BTreeSetStorage<.T>,i32,i32)*>()> (storage, end, i):
    if:
        lt i end
        then:
            btreeset_store_key<.T> btreeset_storage_keys<.T> storage i none<.T>
            btreeset_clear_slots<.T> storage end add i 1
        else:
            ()

fn btreeset_shift_right <.T: Copy> <(&BTreeSetStorage<.T>,i32,i32)*>()> (storage, idx, len0):
    let mut i <i32> len0
    while gt i idx:
        do:
            let from <i32> sub i 1
            match btreeset_key_slot<.T> storage from:
                Option::Some saved_key:
                    btreeset_store_key_slot<.T> storage i some<.T> saved_key
                Option::None:
                    btreeset_store_key_slot<.T> storage i none<.T>
            set i from

fn btreeset_shift_left_after_remove <.T: Copy> <(&BTreeSetStorage<.T>,i32,i32)*>()> (storage, idx, len0):
    let last <i32> sub len0 1
    let mut i <i32> idx
    while lt i last:
        do:
            let nxt <i32> add i 1
            match btreeset_key_slot<.T> storage nxt:
                Option::Some saved_key:
                    btreeset_store_key_slot<.T> storage i some<.T> saved_key
                Option::None:
                    btreeset_store_key_slot<.T> storage i none<.T>
            set i nxt
    btreeset_store_key_slot<.T> storage last none<.T>

fn btreeset_grow <.T: Copy> <(BTreeSet<.T>)*>Result<BTreeSet<.T>, Diag>> (set0):
    let len0 <i32> *field::get_ref &set0 "len"
    let cap0 <i32> *field::get_ref &set0 "cap"
    let storage <BTreeSetStorage<.T>> field::get set0 "storage"
    let cap1 <i32> mul cap0 2
    match btreeset_alloc_storage<.T> cap1:
        Result::Err d:
            btreeset_free_storage<.T> storage
            err<BTreeSet<.T>, Diag> d
        Result::Ok next_storage:
            btreeset_copy_live_slots<.T> &storage &next_storage len0
            btreeset_free_storage<.T> storage
            ok<BTreeSet<.T>, Diag> BTreeSet<.T> len0 cap1 next_storage

//: ## new
//: [空/から]の `BTreeSet<.T>` を[作/つく]る
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>> unwrap_ok<BTreeSet<i32>, Diag> new<i32>;
//:     if eq len s 0 1 0
//: ```
fn new <.T: Copy> <()*>Result<BTreeSet<.T>, Diag>> ():
    let cap <i32> 8
    match btreeset_alloc_storage<.T> cap:
        Result::Err d:
            err<BTreeSet<.T>, Diag> d
        Result::Ok storage:
            ok<BTreeSet<.T>, Diag> BTreeSet<.T> 0 cap storage

//: ## len
//: set を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 3 |> uwok
//:         |> insert 7 |> uwok
//:     if eq len s 2 1 0
//: ```
fn len <.T> <(BTreeSet<.T>)->i32> (set0):
    let n <i32> len_ref<.T> &set0
    free<.T> set0
    n

//: ## len_ref
//: set を[移動/いどう]せずに[要素数/ようそすう]を[返/かえ]す
fn len_ref <.T> <(&BTreeSet<.T>)->i32> (set0):
    *field::get_ref set0 "len"

//: ## contains
//: set を[消費/しょうひ]して key の[存在/そんざい]を[確/たし]かめる
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:     if contains s 7 1 0
//: ```
fn contains <.T: Ord&Copy> <(BTreeSet<.T>,.T)->bool> (set0, key):
    let ok <bool> contains_ref<.T> &set0 key
    free<.T> set0
    ok

//: ## contains_ref
//: set を[移動/いどう]せずに key の[存在/そんざい]を[確/たし]かめる
fn contains_ref <.T: Ord&Copy> <(&BTreeSet<.T>,.T)->bool> (set0, key):
    let len0 <i32> *field::get_ref set0 "len"
    let storage <&BTreeSetStorage<.T>> field::get_ref set0 "storage"
    let keys <&Vec<Option<.T>>> btreeset_storage_keys<.T> storage
    let idx <i32> btreeset_lower_bound<.T> keys key 0 len0
    btreeset_is_at<.T> keys len0 idx key

//: ## btreeset_insert_ready
//: [容量/ようりょう]が[足/た]りている `BTreeSet` に key を[挿入/そうにゅう]する
//:
//: ### [目的/もくてき]
//: - public `insert` が grow の[成功/せいこう]を[確認/かくにん]したあと、lower_bound / shift / store を[一箇所/いっかしょ]で[行/おこな]います。
//: - grow [失敗/しっぱい]を `unwrap_ok` で trap にしないため、確保を伴う[準備/じゅんび]と確保後の[挿入/そうにゅう]を[分離/ぶんり]します。
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound は O(log n)、新規[挿入/そうにゅう]時の shift は O(n) です。
fn btreeset_insert_ready <.T: Ord&Copy> <(BTreeSet<.T>,.T)*>Result<BTreeSet<.T>, Diag>> (set1, key):
    let len0 <i32> *field::get_ref &set1 "len"
    let cap0 <i32> *field::get_ref &set1 "cap"
    let storage <BTreeSetStorage<.T>> field::get set1 "storage"
    let idx <i32> btreeset_lower_bound_storage<.T> &storage key 0 len0
    if:
        btreeset_is_at_storage<.T> &storage len0 idx key
        then ok<BTreeSet<.T>, Diag> BTreeSet<.T> len0 cap0 storage
        else:
            btreeset_shift_right<.T> &storage idx len0
            btreeset_store_key_slot<.T> &storage idx some<.T> key
            ok<BTreeSet<.T>, Diag> BTreeSet<.T> add len0 1 cap0 storage

//: ## insert
//: key を[集合/しゅうごう]へ[挿入/そうにゅう]する
//:
//: ### [実装/じっそう]
//: - 現在の[容量/ようりょう]が[満杯/まんぱい]なら `btreeset_grow` を[実行/じっこう]し、`Result::Err` はそのまま[返/かえ]します。
//: - 確保に[成功/せいこう]した set、または元から[余裕/よゆう]のある set だけを `btreeset_insert_ready` に[渡/わた]します。
//:
//: ### [失敗/しっぱい]
//: - grow 用 key buffer の[確保/かくほ]に[失敗/しっぱい]した[場合/ばあい]は `Diag::OutOfMemory` を[返/かえ]し、trap しません。
//:
//: ### [計算量/けいさんりょう]
//: - 通常は O(n)、grow が[起/お]きる[回/かい]は既存要素の copy を含め O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:         |> insert 3 |> uwok
//:     if eq len s 2 1 0
//: ```
fn insert <.T: Ord&Copy> <(BTreeSet<.T>,.T)*>Result<BTreeSet<.T>, Diag>> (set0, key):
    let len_init <i32> *field::get_ref &set0 "len"
    let cap_init <i32> *field::get_ref &set0 "cap"
    if:
        eq len_init cap_init
        then:
            match btreeset_grow<.T> set0:
                Result::Ok set1:
                    btreeset_insert_ready<.T> set1 key
                Result::Err d:
                    err<BTreeSet<.T>, Diag> d
        else btreeset_insert_ready<.T> set0 key

//: ## remove
//: key を[集合/しゅうごう]から[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:         |> remove 7
//:     if eq len s 0 1 0
//: ```
fn remove <.T: Ord&Copy> <(BTreeSet<.T>,.T)*>BTreeSet<.T>> (set0, key):
    let len0 <i32> *field::get_ref &set0 "len"
    let cap0 <i32> *field::get_ref &set0 "cap"
    let storage <BTreeSetStorage<.T>> field::get set0 "storage"
    let idx <i32> btreeset_lower_bound_storage<.T> &storage key 0 len0
    if:
        not btreeset_is_at_storage<.T> &storage len0 idx key
        then BTreeSet<.T> len0 cap0 storage
        else:
            let last <i32> sub len0 1
            btreeset_shift_left_after_remove<.T> &storage idx len0
            BTreeSet<.T> last cap0 storage

//: ## clear
//: [全要素/ぜんようそ]を[削除/さくじょ]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>>:
//:         unwrap_ok<BTreeSet<i32>, Diag> new<i32>
//:         |> insert 7 |> uwok
//:         |> clear
//:     if eq len s 0 1 0
//: ```
fn clear <.T: Copy> <(BTreeSet<.T>)*>BTreeSet<.T>> (set0):
    let len0 <i32> *field::get_ref &set0 "len"
    let cap0 <i32> *field::get_ref &set0 "cap"
    let storage <BTreeSetStorage<.T>> field::get set0 "storage"
    btreeset_clear_slots<.T> &storage len0 0
    BTreeSet<.T> 0 cap0 storage

//: ## free
//: [内部/ないぶ] storage を[解放/かいほう]する
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/btreeset" as *
//:| #import "alloc/diag/error" as *
//:| #import "core/result" as *
//: fn main <()*>i32> ():
//:     let s <BTreeSet<i32>> unwrap_ok<BTreeSet<i32>, Diag> new<i32>;
//:     free s;
//:     0
//: ```
fn free <.T> <(BTreeSet<.T>)->()> (set0):
    let storage <BTreeSetStorage<.T>> field::get set0 "storage"
    btreeset_free_storage<.T> storage

//: ## sorted_array_set_new
//: sorted-array set として `new` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [目的/もくてき]
//: - `BTreeSet` 互換[実装/じっそう]を、B-tree ではなく sorted-array set として[意図/いと]して[選/えら]んだことを API [名/めい]に[残/のこ]します。
//:
//: ### [計算量/けいさんりょう]
//: - `new` と[同/おな]じです。
fn sorted_array_set_new new;

//: ## sorted_array_set_insert
//: sorted-array set として `insert` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 挿入位置以降を shift するため O(n) です。大量の逐次 insert には[使/つか]わないでください。
fn sorted_array_set_insert insert;

//: ## sorted_array_set_contains
//: sorted-array set として `contains` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - lower_bound により O(log n) です。
fn sorted_array_set_contains contains;

//: ## sorted_array_set_remove
//: sorted-array set として `remove` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - 削除位置以降を shift するため O(n) です。
fn sorted_array_set_remove remove;

//: ## sorted_array_set_len
//: sorted-array set として `len` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `len` と[同/おな]じ O(1) です。
fn sorted_array_set_len len;

//: ## sorted_array_set_clear
//: sorted-array set として `clear` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [計算量/けいさんりょう]
//: - `clear` と[同/おな]じ O(n) です。
fn sorted_array_set_clear clear;

//: ## sorted_array_set_free
//: sorted-array set として `free` を[呼/よ]ぶ[別名/べつめい]
//:
//: ### [注意/ちゅうい]
//: - `free` と[同/おな]じく、内部 key [配列/はいれつ]を[解放/かいほう]します。
fn sorted_array_set_free free;
