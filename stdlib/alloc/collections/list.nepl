//: # list
//: `Vec` storage を[用/もち]いた[単純/たんじゅん]な list API
//:
//: ### [目的/もくてき]
//: - `new` / `cons` / `push` / `head` / `tail` / `get` / `reverse` など、list として[使/つか]うための[基本/きほん] API を[提供/ていきょう]します。
//: - 旧実装の raw node chain と `ptr = 0` sentinel をやめ、内部 storage は `Vec<T>` owner として[保持/ほじ]します。
//:
//: ### [実装/じっそう]
//: - `push` / `cons` は `Vec` の末尾へ value を[追加/ついか]します。
//: - 論理上の先頭は storage の末尾です。これにより先頭追加と `tail` は O(1) になります。
//: - `reverse` は storage を in-place に swap し、追加 allocation なしで論理順序を[反転/はんてん]します。
//:
//: ### [注意/ちゅうい]
//: - 要素の観測・変換 API は `.T: Copy` を[要求/ようきゅう]します。現行 stdlib の collection 全体で non-Copy payload drop traversal が未完成なためです。
//: - `len` / `head` / `get` / `fold` などの by-value observer は入力 `List` owner を[消費/しょうひ]し、内部 `Vec` storage を[閉/と]じます。
//: - owner を保持したまま観測する API が必要な場合は、別 issue で `*_ref` API と borrow contract を追加します。
//:
//: ### [計算量/けいさんりょう]
//: - `new` / `head` / `tail` / `is_empty` は O(1) です。
//: - `cons` / `push` は[償却/しょうきゃく] O(1) です。
//: - `get` / `reverse` / `map` / `filter` / `fold` / `reduce` / `find` / `any` / `all` は O(n) です。

#indent 4

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "alloc/diag/error" as *
#import "alloc/collections/vec" as vec

//: ## List
//: list の storage owner
//:
//: ### [目的/もくてき]
//: - raw node pointer ではなく `Vec<T>` を[保持/ほじ]し、storage owner state を `VecStorageState` 側へ[集約/しゅうやく]します。
//:
//: ### [不変条件/ふへんじょうけん]
//: - `items` の末尾が論理上の先頭です。
//: - `items` は `List` が[所有/しょゆう]し、`free` または by-value observer が[閉/と]じます。
struct List<.T>:
    items <Vec<.T>>

//: list_diag_from_vec_error: Vec storage の error を list API の Diag に[変換/へんかん]する
fn list_diag_from_vec_error <(StdErrorKind)*>Diag> (kind):
    diag_error kind "list storage operation failed"

//: list_physical_index: 論理 index を storage index に[変換/へんかん]する
fn list_physical_index <(i32,i32)->i32> (len0, idx):
    sub sub len0 1 idx

//: list_free_items: List から storage owner を[取/と]り[出/だ]して[解放/かいほう]する
fn list_free_items <.T> <(List<.T>)->()> (lst):
    let items <Vec<.T>> field::get lst "items"
    vec::free<.T> items

//: new: [空/から] list を[作/つく]る
//:
//: ### [実装/じっそう]
//: - `Vec.new` で backing storage を[作/つく]り、`List` owner として[包/つつ]みます。
fn new <.T> <()*>Result<List<.T>, Diag>> ():
    match vec::new<.T>:
        Result::Ok items:
            ok<List<.T>, Diag> List<.T> items
        Result::Err e:
            diag_err<List<.T>> list_diag_from_vec_error e

//: cons: [先頭/せんとう]に[要素/ようそ]を[追加/ついか]する
//:
//: ### [実装/じっそう]
//: - 論理先頭は storage 末尾なので、`Vec.push` だけで先頭追加になります。
fn cons <.T: Copy> <(.T,List<.T>)*>Result<List<.T>, Diag>> (head, tail):
    let items <Vec<.T>> field::get tail "items"
    match vec::push<.T> items head:
        Result::Ok next_items:
            ok<List<.T>, Diag> List<.T> next_items
        Result::Err e:
            diag_err<List<.T>> list_diag_from_vec_error e

//: push: pipe [向/む]けに[先頭/せんとう][追加/ついか]する
fn push <.T: Copy> <(List<.T>,.T)*>Result<List<.T>, Diag>> (lst, head):
    cons<.T> head lst

//: len: list を[消費/しょうひ]して[要素数/ようそすう]を[返/かえ]す
fn len <.T> <(List<.T>)->i32> (lst):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    vec::free<.T> items
    n

//: is_empty: list を[消費/しょうひ]して[空/から]かどうかを[返/かえ]す
fn is_empty <.T> <(List<.T>)->bool> (lst):
    eq len<.T> lst 0

//: get: list を[消費/しょうひ]して[指定位置/していいち]の[要素/ようそ]を[返/かえ]す
//:
//: ### [実装/じっそう]
//: - 論理 index 0 は storage 末尾なので、`len - 1 - idx` へ[変換/へんかん]して `Vec.get` します。
fn get <.T: Copy> <(List<.T>,i32)->Option<.T>> (lst, idx):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    let result <Option<.T>>:
        if:
            or lt idx 0 le n idx
            then:
                none<.T>
            else:
                vec::get<.T> &items list_physical_index n idx
    vec::free<.T> items
    result

//: head: list を[消費/しょうひ]して[先頭/せんとう][要素/ようそ]を[返/かえ]す
fn head <.T: Copy> <(List<.T>)->Option<.T>> (lst):
    get<.T> lst 0

//: tail: list を[消費/しょうひ]して[先頭/せんとう]を[除/のぞ]いた list を[返/かえ]す
//:
//: ### [実装/じっそう]
//: - 論理先頭は storage 末尾なので、`Vec.pop` で先頭を[取/と]り[除/のぞ]きます。
fn tail <.T: Copy> <(List<.T>)->Option<List<.T>>> (lst):
    let items <Vec<.T>> field::get lst "items"
    if:
        eq vec::len<.T> &items 0
        then:
            vec::free<.T> items
            none<List<.T>>
        else:
            let popped <VecPop<.T>> vec::pop<.T> items
            let item <Option<.T>> field::get popped "item"
            let next_items <Vec<.T>> field::get popped "vec"
            match item:
                Option::Some _head:
                    some<List<.T>> List<.T> next_items
                Option::None:
                    vec::free<.T> next_items
                    none<List<.T>>

//: free: list storage owner を[閉/と]じる
fn free <.T> <(List<.T>)->()> (lst):
    list_free_items<.T> lst

//: list_reverse_items: storage 順序を in-place に[反転/はんてん]する
fn list_reverse_items <.T: Copy> <(&Vec<.T>,i32,i32)*>()> (items, left0, right0):
    let mut left <i32> left0
    let mut right <i32> right0
    while lt left right:
        do:
            match vec::get<.T> items left:
                Option::Some left_value:
                    match vec::get<.T> items right:
                        Option::Some right_value:
                            vec::replace<.T> items left right_value
                            vec::replace<.T> items right left_value
                        Option::None:
                            ()
                Option::None:
                    ()
            set left add left 1
            set right sub right 1

//: reverse: list を[消費/しょうひ]して[論理順序/ろんりじゅんじょ]を[反転/はんてん]する
fn reverse <.T: Copy> <(List<.T>)*>List<.T>> (lst):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    list_reverse_items<.T> &items 0 sub n 1
    List<.T> items

//: map: 各要素へ[関数/かんすう]を[適用/てきよう]して[新/あたら]しい list を[返/かえ]す
fn map <.T: Copy,.U: Copy> <(List<.T>, (.T)->.U)*>Result<List<.U>, Diag>> (lst, f):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    match vec::with_capacity<.U> n:
        Result::Err e:
            vec::free<.T> items
            diag_err<List<.U>> list_diag_from_vec_error e
        Result::Ok out0:
            let mut out <Vec<.U>> out0
            let mut i <i32> 0
            let mut failed <bool> false
            let mut failure <StdErrorKind> StdErrorKind::OutOfMemory
            while and lt i n not failed:
                do:
                    match vec::get<.T> &items i:
                        Option::Some value:
                            let mapped <.U> f value
                            match vec::push<.U> out mapped:
                                Result::Ok next_out:
                                    set out next_out
                                    set i add i 1
                                Result::Err e:
                                    set out vec::vec_empty<.U>
                                    set failure e
                                    set failed true
                        Option::None:
                            vec::free<.U> out
                            set out vec::vec_empty<.U>
                            set failure StdErrorKind::InvalidOperation
                            set failed true
            vec::free<.T> items
            if:
                failed
                then:
                    vec::free<.U> out
                    diag_err<List<.U>> list_diag_from_vec_error failure
                else:
                    ok<List<.U>, Diag> List<.U> out

//: filter: 条件を[満/み]たす[要素/ようそ]だけを[残/のこ]す
fn filter <.T: Copy> <(List<.T>, (.T)->bool)*>Result<List<.T>, Diag>> (lst, p):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    match vec::with_capacity<.T> n:
        Result::Err e:
            vec::free<.T> items
            diag_err<List<.T>> list_diag_from_vec_error e
        Result::Ok out0:
            let mut out <Vec<.T>> out0
            let mut i <i32> 0
            let mut failed <bool> false
            let mut failure <StdErrorKind> StdErrorKind::OutOfMemory
            while and lt i n not failed:
                do:
                    match vec::get<.T> &items i:
                        Option::Some value:
                            if:
                                p value
                                then:
                                    match vec::push<.T> out value:
                                        Result::Ok next_out:
                                            set out next_out
                                        Result::Err e:
                                            set out vec::vec_empty<.T>
                                            set failure e
                                            set failed true
                                else:
                                    ()
                            set i add i 1
                        Option::None:
                            vec::free<.T> out
                            set out vec::vec_empty<.T>
                            set failure StdErrorKind::InvalidOperation
                            set failed true
            vec::free<.T> items
            if:
                failed
                then:
                    vec::free<.T> out
                    diag_err<List<.T>> list_diag_from_vec_error failure
                else:
                    ok<List<.T>, Diag> List<.T> out

//: fold: list を[消費/しょうひ]して[左/ひだり]から[畳/たた]み[込/こ]む
fn fold <.T: Copy,.U> <(List<.T>, .U, (.U,.T)->.U)->.U> (lst, acc, f):
    let items <Vec<.T>> field::get lst "items"
    let mut remaining <i32> vec::len<.T> &items
    let mut out <.U> acc
    while gt remaining 0:
        do:
            set remaining sub remaining 1
            match vec::get<.T> &items remaining:
                Option::Some value:
                    set out f out value
                Option::None:
                    set remaining 0
    vec::free<.T> items
    out

//: reduce: list を[消費/しょうひ]して[初期値/しょきち]なしで[畳/たた]み[込/こ]む
fn reduce <.T: Copy> <(List<.T>, (.T,.T)->.T)->Option<.T>> (lst, f):
    let items <Vec<.T>> field::get lst "items"
    let n <i32> vec::len<.T> &items
    if:
        eq n 0
        then:
            vec::free<.T> items
            none<.T>
        else:
            match vec::get<.T> &items sub n 1:
                Option::None:
                    vec::free<.T> items
                    none<.T>
                Option::Some first:
                    let mut remaining <i32> sub n 1
                    let mut out <.T> first
                    while gt remaining 0:
                        do:
                            set remaining sub remaining 1
                            match vec::get<.T> &items remaining:
                                Option::Some value:
                                    set out f out value
                                Option::None:
                                    set remaining 0
                    vec::free<.T> items
                    some<.T> out

//: find: 条件に[合/あ]う[最初/さいしょ]の[要素/ようそ]を[返/かえ]す
fn find <.T: Copy> <(List<.T>, (.T)->bool)->Option<.T>> (lst, p):
    let items <Vec<.T>> field::get lst "items"
    let mut remaining <i32> vec::len<.T> &items
    let mut found <Option<.T>> none<.T>
    let mut done <bool> false
    while and gt remaining 0 not done:
        do:
            set remaining sub remaining 1
            match vec::get<.T> &items remaining:
                Option::Some value:
                    if:
                        p value
                        then:
                            set found some<.T> value
                            set done true
                        else:
                            ()
                Option::None:
                    set done true
    vec::free<.T> items
    found

//: any: 条件を[満/み]たす[要素/ようそ]が 1 つでもあるか[返/かえ]す
fn any <.T: Copy> <(List<.T>, (.T)->bool)->bool> (lst, p):
    let items <Vec<.T>> field::get lst "items"
    let mut remaining <i32> vec::len<.T> &items
    let mut result <bool> false
    while and gt remaining 0 not result:
        do:
            set remaining sub remaining 1
            match vec::get<.T> &items remaining:
                Option::Some value:
                    if:
                        p value
                        then:
                            set result true
                        else:
                            ()
                Option::None:
                    set remaining 0
    vec::free<.T> items
    result

//: all: 全要素が条件を[満/み]たすか[返/かえ]す
fn all <.T: Copy> <(List<.T>, (.T)->bool)->bool> (lst, p):
    let items <Vec<.T>> field::get lst "items"
    let mut remaining <i32> vec::len<.T> &items
    let mut result <bool> true
    while and gt remaining 0 result:
        do:
            set remaining sub remaining 1
            match vec::get<.T> &items remaining:
                Option::Some value:
                    if:
                        p value
                        then:
                            ()
                        else:
                            set result false
                Option::None:
                    set result false
    vec::free<.T> items
    result
