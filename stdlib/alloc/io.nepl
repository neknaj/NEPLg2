//: # io
//: [target/たーげっと][非依存/ひいぞん]の stream [抽象/ちゅうしょう]と binary buffer を[集/あつ]めるライブラリ
//:
//: ### [目的/もくてき]
//: - byte stream / text stream の[読/よ]み[書/か]き[能力/のうりょく]を trait として[分離/ぶんり]し、`std/streamio` や `std/io` が[共通/きょうつう][入口/いりぐち]を[構築/こうちく]できるようにします。
//: - binary stream の[媒体/ばいたい]として、`fd_read` / `fd_write` にそのまま[渡/わた]せる[連続/れんぞく] byte buffer `ByteBuf` を[定義/ていぎ]します。
//:
//: ### [注意/ちゅうい]
//: - ここでは syscall や descriptor を[扱/あつか]いません。[具体的/ぐたいてき]な[入出力/にゅうしゅつりょく]は `std/streamio` や `std/fs` が[担当/たんとう]します。
//: - `ByteBuf` は[所有権/しょゆうけん]を[持/も]つので `Copy` / `Clone` を[実装/じっそう]しません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/io" as *
//: struct CountSink:
//:     total <i32>
//:
//: impl ByteWriter for CountSink:
//:     fn write_bytes <(CountSink,ByteBuf)*>Result<CountSink, StdErrorKind>> (sink, bytes):
//:         let n <i32> io_bytebuf_len_ref &bytes;
//:         io_bytebuf_free bytes;
//:         Result::Ok CountSink add get sink "total" n
//:
//: fn main <()*>i32> ():
//:     let bytes0 <ByteBuf> io_bytebuf_from_str "AB";
//:     match io_write_bytes (CountSink 3) bytes0:
//:         Result::Ok sink1:
//:             if eq get sink1 "total" 5 0 1
//:         Result::Err _e:
//:             0
//: ```

#indent 4

#import "alloc/diag/error" as *
#import "alloc/string" as *
#import "core/char" as *
#import "core/field" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *

//: ## ByteBuf
//: [連続/れんぞく]した raw byte buffer を[所有/しょゆう]する handle
//:
//: ### [目的/もくてき]
//: - `Vec<u8>` の[内部表現/ないぶひょうげん]に[依存/いそん]せず、binary I/O の[媒体/ばいたい]を[明示的/めいじてき]に[表/あらわ]します。
//:
//: ### [注意/ちゅうい]
//: - `ptr` は `Some` のときだけ `len` byte の[所有領域/しょゆうりょういき]を[指/さ]します。
//: - 空 buffer は `ptr=None` / `len=0` で表し、null pointer を所有 field として混ぜません。
//: - [使/つか]い[終/お]わったら `io_bytebuf_free` で[解放/かいほう]してください。
struct ByteBuf:
    ptr <Option<MemPtr<u8>>>
    len <i32>

fn io_bytebuf_empty <()->ByteBuf> ():
    ByteBuf none<MemPtr<u8>> 0

fn io_bytebuf_from_owned_ptr <(MemPtr<u8>,i32)->ByteBuf> (ptr, byte_len):
    if:
        le byte_len 0
        then:
            io_bytebuf_empty
        else:
            ByteBuf some<MemPtr<u8>> ptr byte_len

fn io_bytebuf_len <(ByteBuf)->i32> (buf):
    get buf "len"

fn io_bytebuf_len_ref <(&ByteBuf)->i32> (buf):
    *get_ref buf "len"

fn io_bytebuf_ptr_ref <(&ByteBuf)->Option<MemPtr<u8>>> (buf):
    *get_ref buf "ptr"

fn io_bytebuf_storage_size <(i32)->i32> (byte_len):
    if:
        le byte_len 0
        then:
            0
        else:
            byte_len

fn io_bytebuf_byte_at <(&ByteBuf,i32)->Option<i32>> (buf, idx):
    let n <i32> io_bytebuf_len_ref buf
    if:
        or lt idx 0 ge idx n
        then:
            none<i32>
        else:
            match *get_ref buf "ptr":
                Option::Some ptr:
                    load_u8 mem_ptr_add ptr idx
                Option::None:
                    none<i32>

fn io_bytebuf_free <(ByteBuf)->()> (buf):
    let len <i32> get buf "len"
    match get buf "ptr":
        Option::Some ptr:
            match dealloc_ptr<u8> ptr io_bytebuf_storage_size len:
                Result::Ok _:
                    ()
                Result::Err _e:
                    ()
        Option::None:
            ()

//: io_bytebuf_alloc_region: `ByteBuf` 用の byte 領域を確保する
//:
//: [目的/もくてき]:
//: - `ByteBuf` の本文になる領域を `RegionToken<u8>` として確保し、確定前の所有権を token に集約します。
//:
//: [実装/じっそう]:
//: - `alloc_region_bytes<u8>` に必要 byte 数を渡します。`ByteBuf` は header を持たないため、確保 size はそのまま byte 数です。
//:
//: [注意/ちゅうい]:
//: - 空 buffer は `io_bytebuf_empty` を使うため、この helper は正の byte 数に使います。
//: - 確定前に失敗した場合は `dealloc_region` で token を解放してください。
//:
//: [計算量/けいさんりょう]:
//: - 確保器に依存します。平均 O(1)、free list 探索時は最悪 O(n) です。
fn io_bytebuf_alloc_region <(i32)->Result<RegionToken<u8>, StdErrorKind>> (byte_len):
    if:
        lt byte_len 0
        then:
            Result<RegionToken<u8>, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            match alloc_region_bytes<u8> byte_len:
                Result::Ok region:
                    Result<RegionToken<u8>, StdErrorKind>::Ok region
                Result::Err _e:
                    Result<RegionToken<u8>, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: io_bytebuf_region_ptr: 確定前 `ByteBuf` 領域の本文 pointer を参照から得る
//:
//: [目的/もくてき]:
//: - `RegionToken` の所有権を動かさず、copy 先として使う `MemPtr<u8>` だけを得ます。
//:
//: [実装/じっそう]:
//: - token の `ptr` field を `get_ref` 経由で読み、`MemPtr` の copy 値を返します。
//:
//: [注意/ちゅうい]:
//: - 返った pointer は領域を所有しません。確定または解放は元の token に対して一度だけ行ってください。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn io_bytebuf_region_ptr <(&RegionToken<u8>)->MemPtr<u8>> (region):
    *get_ref region "ptr"

//: io_bytebuf_finish_region: 確保済み領域を `ByteBuf` として確定する
//:
//: [目的/もくてき]:
//: - `RegionToken` が持つ領域所有権を、公開 I/O buffer 型の `ByteBuf` へ移します。
//:
//: [実装/じっそう]:
//: - token の基底 pointer を取り出し、同じ byte length とともに `ByteBuf` を構築します。
//:
//: [注意/ちゅうい]:
//: - 呼び出し後は token を再利用しません。
//: - `byte_len` は確保時の size と一致している必要があります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn io_bytebuf_finish_region <(RegionToken<u8>,i32)->ByteBuf> (region, byte_len):
    let ptr <MemPtr<u8>> get region "ptr"
    io_bytebuf_from_owned_ptr ptr byte_len

//: io_bytebuf_from_str_result: `str` を `ByteBuf` へ複製する
//:
//: [目的/もくてき]:
//: - text を binary I/O 用の所有 byte buffer へ変換し、確保失敗を `StdErrorKind::OutOfMemory` として返します。
//:
//: [実装/じっそう]:
//: - 空文字列は確保せず `io_bytebuf_empty` を返します。
//: - 非空の場合は `io_bytebuf_alloc_region` で本文長ぶんの領域を確保し、参照から得た pointer へ bulk copy します。
//: - copy 後に `io_bytebuf_finish_region` で領域所有権を `ByteBuf` へ一度だけ移します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は呼び出し側が所有し、使い終わったら `io_bytebuf_free` してください。
//: - UTF-8 検証や変換は行わず、`str` の byte 表現をそのまま複製します。
//: - 出力領域の raw address を中間値として保持しません。owner は確定まで `RegionToken` に残します。
//:
//: [計算量/けいさんりょう]:
//: - 入力長 n に対して O(n) です。
fn io_bytebuf_from_str_result <(str)->Result<ByteBuf, StdErrorKind>> (text):
    let byte_len <i32> len text
    if:
        eq byte_len 0
        then:
            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_empty
        else:
            match io_bytebuf_alloc_region byte_len:
                Result::Err e:
                    Result<ByteBuf, StdErrorKind>::Err e
                Result::Ok region:
                    let out_data <MemPtr<u8>> io_bytebuf_region_ptr &region
                    mem_copy mem_ptr_addr out_data mem_ptr_addr string_data_ptr text byte_len
                    Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_finish_region region byte_len

//: io_bytebuf_from_str: `str` を `ByteBuf` へ複製する互換 facade
//:
//: [目的/もくてき]:
//: - 既存コード向けに `ByteBuf` を直接返す入口を維持します。
//:
//: [実装/じっそう]:
//: - 本体は `io_bytebuf_from_str_result` に委譲し、失敗時だけ空 `ByteBuf` へ丸めます。
//:
//: [注意/ちゅうい]:
//: - 空入力と確保失敗を区別する必要がある場合は `io_bytebuf_from_str_result` を使ってください。
//:
//: [計算量/けいさんりょう]:
//: - 入力長 n に対して O(n) です。
fn io_bytebuf_from_str <(str)->ByteBuf> (text):
    match io_bytebuf_from_str_result text:
        Result::Ok buf:
            buf
        Result::Err _e:
            io_bytebuf_empty

//: io_bytebuf_to_str_result: `ByteBuf` を UTF-8 検証して `str` へ変換する
//:
//: [目的/もくてき]:
//: - 所有 byte buffer を text helper へ渡せる `str` 表現に詰め直し、invalid UTF-8 と確保失敗を `StdErrorKind` として返します。
//:
//: [実装/じっそう]:
//: - `string_utf8_validate_mem` で UTF-8 として妥当か確認し、成功時だけ `string_from_mem_unchecked_result` で文字列領域を確保して複製します。
//: - 検証と複製に使う pointer は借用 view から得て、入力 `ByteBuf` の所有権は最後に `io_bytebuf_free` で一度だけ消費します。
//: - 成功時も失敗時も入力 `ByteBuf` はこの関数が解放します。
//:
//: [注意/ちゅうい]:
//: - raw bytes を保持したい場合は `ByteBuf` のまま扱い、`str` へ変換しないでください。
//: - 呼び出し後に入力 `ByteBuf` を再利用しないでください。
//:
//: [計算量/けいさんりょう]:
//: - 入力長 n に対して O(n) です。
fn io_bytebuf_to_str_result <(ByteBuf)*>Result<str, StdErrorKind>> (buf):
    let byte_len <i32> io_bytebuf_len_ref &buf
    match io_bytebuf_ptr_ref &buf:
        Option::None:
            if:
                eq byte_len 0
                then:
                    Result<str, StdErrorKind>::Ok ""
                else:
                    io_bytebuf_free buf
                    Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
        Option::Some data:
            if:
                le mem_ptr_addr data 0
                then:
                    io_bytebuf_free buf
                    Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                else:
                    match string_utf8_validate_mem data byte_len:
                        Result::Err _e:
                            io_bytebuf_free buf
                            Result<str, StdErrorKind>::Err StdErrorKind::InvalidUtf8
                        Result::Ok _:
                            match string_from_mem_unchecked_result data byte_len:
                                Result::Err _e:
                                    io_bytebuf_free buf
                                    Result<str, StdErrorKind>::Err StdErrorKind::OutOfMemory
                                Result::Ok text:
                                    io_bytebuf_free buf
                                    Result<str, StdErrorKind>::Ok text

//: io_bytebuf_to_str: `ByteBuf` を `str` へ変換する互換 facade
//:
//: [目的/もくてき]:
//: - 既存コード向けに `str` を直接返す入口を維持します。
//:
//: [実装/じっそう]:
//: - 本体は `io_bytebuf_to_str_result` に委譲し、失敗時だけ空文字列へ丸めます。
//:
//: [注意/ちゅうい]:
//: - 空 buffer と確保失敗を区別する必要がある場合は `io_bytebuf_to_str_result` を使ってください。
//: - invalid UTF-8 の場合も空文字列へ丸めるため、入力 validation が必要な箇所では result API を使ってください。
//: - 入力 `ByteBuf` は成功時も失敗時も消費されます。
//:
//: [計算量/けいさんりょう]:
//: - 入力長 n に対して O(n) です。
fn io_bytebuf_to_str <(ByteBuf)*>str> (buf):
    match io_bytebuf_to_str_result buf:
        Result::Ok text:
            text
        Result::Err _e:
            ""

//: ## ByteBuilder
//: growable な[所有/しょゆう] byte buffer builder
//:
//: ### [目的/もくてき]
//: - WASM binary emitter のように byte を[順番/じゅんばん]に[追加/ついか]する処理を、raw pointer や `Vec` [内部表現/ないぶひょうげん]へ[直接/ちょくせつ][依存/いそん]せずに[書/か]けるようにします。
//: - `finish` で `ByteBuf` を[返/かえ]し、`fs_write_to_bytes` や `stdio_write_bytes_result` へそのまま[渡/わた]せます。
//:
//: ### [注意/ちゅうい]
//: - `ByteBuilder` は[所有権/しょゆうけん]を[持/も]つので `Copy` / `Clone` を[実装/じっそう]しません。
//: - `push_*` / `reserve` / `finish` は builder を[消費/しょうひ]し、成功時は[新/あたら]しい builder または `ByteBuf` を[返/かえ]します。
//: - 失敗時は builder 内部 buffer を[解放/かいほう]してから `Err` を[返/かえ]します。
struct ByteBuilder:
    ptr <MemPtr<u8>>
    len <i32>
    cap <i32>

fn byte_builder_empty <()->ByteBuilder> ():
    ByteBuilder mem_ptr_wrap 0 0 0

//: byte_builder_with_capacity: 指定 capacity の builder を[作/つく]る
//:
//: [目的/もくてき]:
//: - [見積/みつ]もり[済/ず]みの byte [数/すう]がある emitter で、最初の realloc を[避/さ]けます。
//:
//: [注意/ちゅうい]:
//: - capacity が 0 の[場合/ばあい]は[確保/かくほ]せず空 builder を[返/かえ]します。
fn byte_builder_with_capacity <(i32)->Result<ByteBuilder, StdErrorKind>> (capacity):
    if:
        lt capacity 0
        then:
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq capacity 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok byte_builder_empty
                else:
                    match alloc_ptr<u8> capacity:
                        Result::Ok ptr:
                            Result<ByteBuilder, StdErrorKind>::Ok ByteBuilder ptr 0 capacity
                        Result::Err _e:
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_new: default capacity の builder を[作/つく]る
fn byte_builder_new <()->Result<ByteBuilder, StdErrorKind>> ():
    byte_builder_with_capacity 64

fn byte_builder_len <(ByteBuilder)->i32> (builder):
    get builder "len"

fn byte_builder_free <(ByteBuilder)->()> (builder):
    let cap <i32> get builder "cap"
    if:
        gt cap 0
        then:
            match dealloc_ptr<u8> get builder "ptr" cap:
                Result::Ok _:
                    ()
                Result::Err _e:
                    ()
        else:
            ()

fn byte_builder_next_capacity <(i32,i32)->Result<i32, StdErrorKind>> (cap, needed):
    let mut next <i32>:
        if:
            le cap 0
            then:
                8
            else:
                cap
    let mut failed <i32> 0
    while and lt next needed eq failed 0:
        do:
            let doubled <i32> mul next 2
            if:
                le doubled next
                then:
                    set failed 1
                else:
                    set next doubled
    if:
        eq failed 1
        then:
            Result<i32, StdErrorKind>::Err StdErrorKind::CapacityExceeded
        else:
            Result<i32, StdErrorKind>::Ok next

//: byte_builder_reserve: 追加 byte [数/すう]ぶんの capacity を[確保/かくほ]する
//:
//: [目的/もくてき]:
//: - 以後の append が少なくとも additional byte ぶん成功するように、必要なら capacity を 2 [倍/ばい]ずつ[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - 失敗時は builder を[解放/かいほう]します。
fn byte_builder_reserve <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, additional):
    let len0 <i32> get builder "len"
    let cap0 <i32> get builder "cap"
    if:
        lt additional 0
        then:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            let needed <i32> add len0 additional
            if:
                or lt needed len0 le needed cap0
                then:
                    if:
                        lt needed len0
                        then:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::CapacityExceeded
                        else:
                            Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    match byte_builder_next_capacity cap0 needed:
                        Result::Err e:
                            byte_builder_free builder
                            Result<ByteBuilder, StdErrorKind>::Err e
                        Result::Ok next_cap:
                            if:
                                le cap0 0
                                then:
                                    match alloc_ptr<u8> next_cap:
                                        Result::Ok ptr:
                                            Result<ByteBuilder, StdErrorKind>::Ok ByteBuilder ptr len0 next_cap
                                        Result::Err _e:
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory
                                else:
                                    match realloc_ptr<u8> get builder "ptr" cap0 next_cap:
                                        Result::Ok ptr:
                                            Result<ByteBuilder, StdErrorKind>::Ok ByteBuilder ptr len0 next_cap
                                        Result::Err _e:
                                            byte_builder_free builder
                                            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: byte_builder_push_u8: 1 byte を[末尾/まつび]へ[追加/ついか]する
fn byte_builder_push_u8 <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, byte):
    match byte_builder_reserve builder 1:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok reserved:
            let ptr <MemPtr<u8>> get reserved "ptr"
            let len0 <i32> get reserved "len"
            match store_u8 mem_ptr_add ptr len0 byte:
                Result::Ok _:
                    Result<ByteBuilder, StdErrorKind>::Ok ByteBuilder ptr add len0 1 get reserved "cap"
                Result::Err _e:
                    byte_builder_free reserved
                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

//: byte_builder_push_ascii: ASCII char を 1 byte として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - text magic や delimiter など、意味が文字である byte を `char` として受け取ります。
//:
//: [注意/ちゅうい]:
//: - 非 ASCII char は `InvalidOperation` です。失敗時は builder を[解放/かいほう]します。
fn byte_builder_push_ascii <(ByteBuilder,char)*>Result<ByteBuilder, StdErrorKind>> (builder, c):
    if:
        char_is_ascii c
        then:
            byte_builder_push_u8 builder char_to_i32 c
        else:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

fn byte_builder_push_utf8_tail <(ByteBuilder,char,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, c, count):
    if:
        eq count 1
        then:
            Result<ByteBuilder, StdErrorKind>::Ok builder
        else:
            match byte_builder_push_u8 builder char_utf8_byte1 c:
                Result::Err e:
                    Result<ByteBuilder, StdErrorKind>::Err e
                Result::Ok b1:
                    if:
                        eq count 2
                        then:
                            Result<ByteBuilder, StdErrorKind>::Ok b1
                        else:
                            match byte_builder_push_u8 b1 char_utf8_byte2 c:
                                Result::Err e:
                                    Result<ByteBuilder, StdErrorKind>::Err e
                                Result::Ok b2:
                                    if:
                                        eq count 3
                                        then:
                                            Result<ByteBuilder, StdErrorKind>::Ok b2
                                        else:
                                            byte_builder_push_u8 b2 char_utf8_byte3 c

//: byte_builder_push_char_utf8: char を UTF-8 bytes として[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `StringBuilder` ではなく binary `ByteBuilder` に text character を追加したい場合の共通入口です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。capacity grow が発生した場合は allocator / realloc に依存します。
fn byte_builder_push_char_utf8 <(ByteBuilder,char)*>Result<ByteBuilder, StdErrorKind>> (builder, c):
    let count <i32> char_utf8_len c
    match byte_builder_push_u8 builder char_utf8_byte0 c:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok b0:
            byte_builder_push_utf8_tail b0 c count

//: byte_builder_push_bytes_ref: 参照 byte [列/れつ]を[末尾/まつび]へ[複製/ふくせい]する
//:
//: [目的/もくてき]:
//: - 既存 buffer の slice や固定 header を builder に[追加/ついか]します。
//:
//: [注意/ちゅうい]:
//: - source の[所有権/しょゆうけん]は[移動/いどう]しません。
fn byte_builder_push_bytes_ref <(ByteBuilder,MemPtr<u8>,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, src, data_len):
    if:
        lt data_len 0
        then:
            byte_builder_free builder
            Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        else:
            if:
                eq data_len 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    match byte_builder_reserve builder data_len:
                        Result::Err e:
                            Result<ByteBuilder, StdErrorKind>::Err e
                        Result::Ok reserved:
                            let dst <MemPtr<u8>> mem_ptr_add get reserved "ptr" get reserved "len"
                            match mem_copy<u8> dst src data_len:
                                Result::Ok _:
                                    Result<ByteBuilder, StdErrorKind>::Ok ByteBuilder get reserved "ptr" add get reserved "len" data_len get reserved "cap"
                                Result::Err _e:
                                    byte_builder_free reserved
                                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation

//: byte_builder_push_bytebuf: `ByteBuf` の[内容/ないよう]を[追加/ついか]して入力 buffer を[解放/かいほう]する
fn byte_builder_push_bytebuf <(ByteBuilder,ByteBuf)*>Result<ByteBuilder, StdErrorKind>> (builder, bytes):
    let data_len <i32> get bytes "len"
    match get bytes "ptr":
        Option::None:
            if:
                eq data_len 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok builder
                else:
                    byte_builder_free builder
                    Result<ByteBuilder, StdErrorKind>::Err StdErrorKind::InvalidOperation
        Option::Some src:
            let res <Result<ByteBuilder, StdErrorKind>> byte_builder_push_bytes_ref builder src data_len
            match dealloc_ptr<u8> src io_bytebuf_storage_size data_len:
                Result::Ok _:
                    res
                Result::Err _e:
                    res

//: byte_builder_push_leb_u32: u32 LEB128 を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - WASM binary の section size、index、integer immediate を unsigned LEB128 で[書/か]き[込/こ]みます。
//:
//: [実装/じっそう]:
//: - 下位 7 bit を[出力/しゅつりょく]し、残りを unsigned shift で 7 bit ずつ[進/すす]めます。
fn byte_builder_push_leb_u32 <(ByteBuilder,i32)*>Result<ByteBuilder, StdErrorKind>> (builder, value):
    let low <i32> and value 127
    let rest <i32> shr_u value 7
    let out <i32>:
        if:
            eq rest 0
            then:
                low
            else:
                or low 128
    match byte_builder_push_u8 builder out:
        Result::Err e:
            Result<ByteBuilder, StdErrorKind>::Err e
        Result::Ok next:
            if:
                eq rest 0
                then:
                    Result<ByteBuilder, StdErrorKind>::Ok next
                else:
                    byte_builder_push_leb_u32 next rest

//: byte_builder_finish: builder を exact-size の `ByteBuf` へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - growable builder の capacity を[隠/かく]し、`ByteBuf.ptr` が `Some` の場合だけ `ByteBuf.len` byte の[所有領域/しょゆうりょういき]を[指/さ]す invariant に[戻/もど]します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は caller が `io_bytebuf_free` で[解放/かいほう]してください。
fn byte_builder_finish <(ByteBuilder)*>Result<ByteBuf, StdErrorKind>> (builder):
    let len0 <i32> get builder "len"
    let cap0 <i32> get builder "cap"
    if:
        le len0 0
        then:
            byte_builder_free builder
            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_empty
        else:
            if:
                eq len0 cap0
                then:
                    Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr get builder "ptr" len0
                else:
                    match realloc_ptr<u8> get builder "ptr" cap0 len0:
                        Result::Ok ptr:
                            Result<ByteBuf, StdErrorKind>::Ok io_bytebuf_from_owned_ptr ptr len0
                        Result::Err _e:
                            byte_builder_free builder
                            Result<ByteBuf, StdErrorKind>::Err StdErrorKind::OutOfMemory

//: io_bytebuf_from_char_utf8_result: char 1 つを UTF-8 `ByteBuf` へ encode する
//:
//: [目的/もくてき]:
//: - `char` を I/O や `std/text` の byte 境界へ渡すため、所有権付き `ByteBuf` として返します。
//:
//: [注意/ちゅうい]:
//: - 返った `ByteBuf` は呼び出し側が `io_bytebuf_free` で解放してください。
fn io_bytebuf_from_char_utf8_result <(char)*>Result<ByteBuf, StdErrorKind>> (c):
    match byte_builder_with_capacity char_utf8_len c:
        Result::Err e:
            Result<ByteBuf, StdErrorKind>::Err e
        Result::Ok builder:
            match byte_builder_push_char_utf8 builder c:
                Result::Err e:
                    Result<ByteBuf, StdErrorKind>::Err e
                Result::Ok filled:
                    byte_builder_finish filled

//: ## ByteReader
//: [生/なま]の[バイト列/ばいとれつ]を[読/よ]み[出/だ]す[能力/のうりょく]
trait ByteReader:
    fn read_all_bytes <(Self)*>Result<ByteBuf, StdErrorKind>> (stream):
        Result::Err StdErrorKind::IoError

//: ## ByteWriter
//: [生/なま]の[バイト列/ばいとれつ]を[書/か]き[込/こ]む[能力/のうりょく]
trait ByteWriter:
    fn write_bytes <(Self, ByteBuf)*>Result<Self, StdErrorKind>> (stream, bytes):
        Result::Err StdErrorKind::IoError

//: ## TextReader
//: text として[全体/ぜんたい]を[読/よ]み[出/だ]す[能力/のうりょく]
trait TextReader:
    fn read_all_text <(Self)*>Result<str, StdErrorKind>> (stream):
        Result::Err StdErrorKind::IoError

//: ## TextWriter
//: text を[書/か]き[込/こ]む[能力/のうりょく]
trait TextWriter:
    fn write_str <(Self, str)*>Result<Self, StdErrorKind>> (stream, text):
        Result::Err StdErrorKind::IoError

//: ## Flush
//: [保留中/ほりゅうちゅう]の[出力/しゅつりょく]を[外部/がいぶ]へ[反映/はんえい]する[能力/のうりょく]
trait Flush:
    fn flush <(Self)*>Result<Self, StdErrorKind>> (stream):
        Result::Err StdErrorKind::IoError

//: ## Close
//: stream を[閉/と]じる[能力/のうりょく]
trait Close:
    fn close <(Self)*>Result<(), StdErrorKind>> (stream):
        Result::Err StdErrorKind::IoError

fn io_read_all_bytes <.T: ByteReader> <(.T)*>Result<ByteBuf, StdErrorKind>> (stream):
    ByteReader::read_all_bytes stream

fn io_write_bytes <.T: ByteWriter> <(.T, ByteBuf)*>Result<.T, StdErrorKind>> (stream, bytes):
    ByteWriter::write_bytes stream bytes

fn io_read_all_text <.T: TextReader> <(.T)*>Result<str, StdErrorKind>> (stream):
    TextReader::read_all_text stream

fn io_write_str <.T: TextWriter> <(.T, str)*>Result<.T, StdErrorKind>> (stream, text):
    TextWriter::write_str stream text

fn io_flush <.T: Flush> <(.T)*>Result<.T, StdErrorKind>> (stream):
    Flush::flush stream

fn io_close <.T: Close> <(.T)*>Result<(), StdErrorKind>> (stream):
    Close::close stream
