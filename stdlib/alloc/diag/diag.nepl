//: diag: `Diag` / `Diags` の[文字列化/もじれつか]と[表示/ひょうじ]を[担/にな]うライブラリ
//:
//: [目的/もくてき]:
//: - `alloc/diag/error` で[定義/ていぎ]した `Diag` / `Diags` を[人間/にんげん]が[読/よ]める[文字列/もじれつ]へ[変換/へんかん]します。
//: - std target では[標準/ひょうじゅん][出力/しゅつりょく]へ[流/なが]す helper も[提供/ていきょう]します。
//:
//: [実装/じっそう]:
//: - [重大度/じゅうだいど]・error kind・message・span・note・help を[順番/じゅんばん]に[連結/れんけつ]して[組/く]み[立/た]てます。
//: - `Diag` の note/help は[未整形/みせいけい] fragment なので、この renderer が prefix と[改行/かいぎょう]を[付/つ]けます。
//:
//: [注意/ちゅうい]:
//: - ここは stringify/rendering の[暫定/ざんてい] helper です。
//: - reboot [途中/とちゅう]では `Stringify` / `Debug` trait へ[整理/せいり]する[予定/よてい]ですが、[現時点/げんじてん]ではこのモジュールで[共通/きょうつう][表示/ひょうじ]を[担/にな]います。
//:
//: [計算量/けいさんりょう]:
//: - [文字列/もじれつ][連結/れんけつ]ぶんだけ O(n) です。

#indent 4

#import "alloc/diag/error" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "alloc/string" as *
#import "alloc/collections/vec" as v
#if[target=std]
#import "std/stdio" as *
#import "core/field" as *

//: kind_str: `Diag` の kind を[人間/にんげん]向けの[短/みじか]い[識別子/しきべつし]へ[変換/へんかん]する
pub fn kind_str %fn &Diag str \d:
    let k %&DiagKind field::get_ref d "kind";
    let level_name %str diag_level_str *field::get_ref k "level";
    match *field::get_ref k "std_error":
        Option::Some stdk:
            let std_name %str std_error_kind_str stdk;
            let l1 %str concat level_name "[";
            let l2 %str concat l1 std_name;
            concat l2 "]"
        Option::None:
            match *field::get_ref k "local_kind":
                Option::Some local:
                    let l1 %str concat level_name "[";
                    let l2 %str concat l1 local;
                    concat l2 "]"
                Option::None:
                    level_name

pub fn kind_str %fn Diag str \d:
    kind_str &d

//: span_to_string: `Span` を `file:start-end` へ[整形/せいけい]する
pub fn span_to_string %fn Span str \sp:
    let fid %str from_i32 get sp "file_id";
    let s %str from_i32 get sp "start";
    let e %str from_i32 get sp "end";
    let t0 %str concat fid ":";
    let t1 %str concat t0 s;
    let t2 %str concat t1 "-";
    concat t2 e

//: diag_to_string: `Diag` を[表示/ひょうじ]しやすい[文字列/もじれつ]へ[変換/へんかん]する
pub fn diag_to_string %fn &Diag str \d:
    let ks %str kind_str d;
    let h0 %str concat ks ": ";
    let message %str *field::get_ref d "message";
    let mut out %str concat h0 message;
    set out concat out "\n";

    match *field::get_ref d "span":
        Option::Some sp:
            let sp_s %str span_to_string sp;
            let l0 %str concat "at " sp_s;
            set out concat out l0;
            set out concat out "\n";
        Option::None:
            ()

    let notes %str *field::get_ref d "notes";
    if:
        gt len notes 0
        then:
            set out concat out notes;
            set out concat out "\n";
        else:
            ()

    let help %str *field::get_ref d "help";
    if:
        gt len help 0
        then:
            set out concat out "help: ";
            set out concat out help;
            set out concat out "\n";
        else:
            ()

    match *field::get_ref d "source":
        Option::Some src:
            let s0 %str concat out "source: ";
            let s1 %str concat s0 src;
            concat s1 "\n"
        Option::None:
            out
pub fn diag_to_string %fn Diag str \d:
    diag_to_string &d
//: diags_to_string: `Diags` を[改行/かいぎょう][区切/くぎ]りで[連結/れんけつ]する
pub fn diags_to_string %fn &Diags str \ds:
    let items %&Vec Diag field::get_ref ds "items";
    let items_len %i32 v::len<Diag> items;
    diags_to_string_loop items items_len 0 ""

pub fn diags_to_string %fn Diags str \ds:
    let s %str diags_to_string &ds
    diags_free ds
    s

pub fn diags_to_string_loop %fn &Vec Diag fn i32 fn i32 fn str str \items\n\i\acc:
    if:
        ge i n
        then acc
        else:
            match v::get<Diag> items i:
                Option::Some d:
                    let one %str diag_to_string d;
                    let next %str concat acc one;
                    diags_to_string_loop items n add i 1 next
                Option::None:
                    acc

#if[target=std]
pub fn diag_print %impure fn Diag () \d:
    let s %str diag_to_string d;
    print s

#if[target=std]
pub fn diag_println %impure fn Diag () \d:
    let s %str diag_to_string d;
    println s

#if[target=std]
pub fn diags_print %impure fn Diags () \ds:
    let s %str diags_to_string ds;
    print s

#if[target=std]
pub fn diags_println %impure fn Diags () \ds:
    let s %str diags_to_string ds;
    println s
