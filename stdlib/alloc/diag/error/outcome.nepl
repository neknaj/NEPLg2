//: outcome: `Result` と[診断群/しんだんぐん]を[同時/どうじ]に[運/はこ]ぶ helper
//:
//: [目的/もくてき]:
//: - `Outcome<T, E>` と `Result<T, E>` の[共通/きょうつう][観測/かんそく] helper を[提供/ていきょう]します。
//: - [値/あたい]の[成否/せいひ]と `Diags` owner の[解放/かいほう][責務/せきむ]を[同/おな]じ module に[集/あつ]めます。
//:
//: [注意/ちゅうい]:
//: - by-value `outcome_result` は返却しない `Diags` owner を[閉/と]じてから `Result` を[返/かえ]します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error/outcome" as *
//: fn main <()*>i32> ():
//:     let o <Outcome<i32, StdErrorKind>> outcome_ok<i32, StdErrorKind> 7
//:     let checks checks_push checks_new assert outcome_is_ok o
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```

#indent 4

#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "alloc/diag/error/types" as *
#import "alloc/diag/error/diags" as *
#import "core/field" as *
#import "core/math" as *
//: Outcome: `Result` と `Diags` を[同時/どうじ]に[運/はこ]ぶ struct
//:
//: [目的/もくてき]:
//: - compiler や source code を[伴/ともな]う richer な[処理/しょり]で、[値/あたい]の[成否/せいひ]と[診断/しんだん]を[一緒/いっしょ]に[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - [通常/つうじょう]の stdlib API では `Result` で[十分/じゅうぶん]なことが多く、`Outcome` は[限定的/げんていてき]に[使/つか]います。
//: - `diags` は `Option<Diags>` とし、[必要/ひつよう]なときだけ[持/も]たせます。
//:
//: [計算量/けいさんりょう]:
//: - [構築/こうちく]は O(1) です。
pub struct Outcome<.T, .E>:
    result <Result<.T, .E>>
    diags <Option<Diags>>

//: outcome_ok: [診断/しんだん]なしの[成功/せいこう][結果/けっか]を[作/つく]る
pub fn outcome_ok <.T, .E> <(.T)->Outcome<.T, .E>> (v):
    let r <Result<.T, .E>> ok<.T, .E> v;
    Outcome r none<Diags>

//: outcome_err: [診断/しんだん]なしの[失敗/しっぱい][結果/けっか]を[作/つく]る
pub fn outcome_err <.T, .E> <(.E)->Outcome<.T, .E>> (e):
    let r <Result<.T, .E>> err<.T, .E> e;
    Outcome r none<Diags>

//: outcome_with_diags: [診断/しんだん][群/ぐん]を[付与/ふよ]する
pub fn outcome_with_diags <.T, .E> <(Outcome<.T, .E>,Diags)->Outcome<.T, .E>> (o, ds):
    let result <Result<.T, .E>> field::get o "result"
    match field::get o "diags":
        Option::Some old_ds:
            diags_free old_ds
        Option::None:
            ()
    Outcome result some<Diags> ds

//: result_to_outcome: `Result` を[診断/しんだん]なし `Outcome` に[昇格/しょうかく]する
pub fn result_to_outcome <.T, .E> <(Result<.T, .E>)->Outcome<.T, .E>> (r):
    Outcome r none<Diags>

//: into_outcome: `Result` を `Outcome` に[昇格/しょうかく]する[共通/きょうつう][入口/いりぐち]
//:
//: ### [目的/もくてき]
//: - `Result` と `Outcome` を[同/おな]じ helper [名/めい]で[扱/あつか]い、[呼/よ]び[出/だ]し[側/がわ]が[必要/ひつよう]な[時点/じてん]で `Outcome` に[揃/そろ]えられるようにします。
//:
//: ### [使用例/しようれい]
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error" as *
//:| fn main <()*>i32> ():
//:     let r <Result<i32, StdErrorKind>> ok<i32, StdErrorKind> 7;
//:     let o <Outcome<i32, StdErrorKind>> into_outcome r
//:     let checks checks_push checks_new assert outcome_is_ok o
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
//:
//: ### [実装/じっそう]
//: - `result_to_outcome` をそのまま[呼/よ]び、[診断/しんだん][群/ぐん]なしの `Outcome` を[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `Result` [側/がわ]に[診断/しんだん][群/ぐん]はないため、[昇格/しょうかく]しても `diags` は `none` です。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn into_outcome <.T, .E> <(Result<.T, .E>)->Outcome<.T, .E>> (r):
    result_to_outcome r

//: into_outcome: そのまま `Outcome` を[返/かえ]す
//:
//: ### [目的/もくてき]
//: - すでに `Outcome` を[持/も]っている[値/あたい]も `Result` と[同/おな]じ helper [名/めい]で[扱/あつか]えるようにします。
//:
//: ### [実装/じっそう]
//: - [入力/にゅうりょく]をそのまま[返/かえ]します。
//:
//: ### [注意/ちゅうい]
//: - `diags` の[有無/うむ]は[保持/ほじ]されます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn into_outcome <.T, .E> <(Outcome<.T, .E>)->Outcome<.T, .E>> (o):
    o

//: result_like_result: `Result` をそのまま[読/よ]み[出/だ]す
//:
//: ### [目的/もくてき]
//: - `Result` / `Outcome` を[共通/きょうつう] helper で[扱/あつか]うとき、[成否/せいひ]の[軸/じく]だけを[同/おな]じ[名前/なまえ]で[取/と]り[出/だ]せるようにします。
//:
//: ### [実装/じっそう]
//: - [入力/にゅうりょく]の `Result` をそのまま[返/かえ]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn result_like_result <.T, .E> <(Result<.T, .E>)->Result<.T, .E>> (r):
    r

//: result_like_result: `Outcome` [内部/ないぶ]の `Result` を[読/よ]み[出/だ]す
//:
//: ### [目的/もくてき]
//: - `Outcome` [内部/ないぶ]の `result` field を `Result` と[同/おな]じ[名前/なまえ]で[取/と]り[出/だ]せるようにします。
//:
//: ### [実装/じっそう]
//: - `outcome_result` を[呼/よ]びます。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn result_like_result <.T, .E> <(Outcome<.T, .E>)->Result<.T, .E>> (o):
    outcome_result o

//: result_like_result: `Outcome` [参照/さんしょう]から `Result` を Copy [値/あたい]として[読/よ]み[出/だ]す
pub fn result_like_result <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->Result<.T, .E>> (o):
    outcome_result o

//: result_like_is_ok: `Result` の[成功/せいこう]を[判定/はんてい]する
pub fn result_like_is_ok <.T, .E> <(Result<.T, .E>)->bool> (r):
    is_ok r

//: result_like_is_ok: `Outcome` の[成功/せいこう]を[判定/はんてい]する
pub fn result_like_is_ok <.T, .E> <(Outcome<.T, .E>)->bool> (o):
    outcome_is_ok o

//: result_like_is_ok: `Outcome` [参照/さんしょう]の[成功/せいこう]を[判定/はんてい]する
pub fn result_like_is_ok <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->bool> (o):
    outcome_is_ok o

//: result_like_is_err: `Result` の[失敗/しっぱい]を[判定/はんてい]する
pub fn result_like_is_err <.T, .E> <(Result<.T, .E>)->bool> (r):
    is_err r

//: result_like_is_err: `Outcome` の[失敗/しっぱい]を[判定/はんてい]する
pub fn result_like_is_err <.T, .E> <(Outcome<.T, .E>)->bool> (o):
    outcome_is_err o

//: result_like_is_err: `Outcome` [参照/さんしょう]の[失敗/しっぱい]を[判定/はんてい]する
pub fn result_like_is_err <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->bool> (o):
    outcome_is_err o

//: outcome_result: `Outcome` [内部/ないぶ]の `Result` を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `Outcome` を[受/う]け[取/と]った[呼/よ]び[出/だ]し[側/がわ]が、[診断/しんだん][群/ぐん]とは[別/べつ]に[成否/せいひ]だけを[確認/かくにん]できるようにします。
//: - `Result` と `Outcome` を[共通/きょうつう] helper で[扱/あつか]うときの[読/よ]み[取/と]り[入口/いりぐち]として[使/つか]います。
//:
//: [使用例/しようれい]:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/diag/error" as *
//:| fn main <()*>i32> ():
//:     let o <Outcome<i32, StdErrorKind>> outcome_ok<i32, StdErrorKind> 42;
//:     let checks match outcome_result o:
//:         Result::Ok v:
//:             checks_push checks_new assert_eq_i32 42 v
//:         Result::Err _e:
//:             checks_push checks_new assert false
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
//:
//: [実装/じっそう]:
//: - struct field `result` を[返/かえ]し、返さない `diags` axis は `diags_free` で[閉/と]じます。
//:
//: [注意/ちゅうい]:
//: - `diags` は[返/かえ]さないので、[診断/しんだん][群/ぐん]も[見/み]たい[場合/ばあい]は `outcome_diags_or_empty` を[併用/へいよう]します。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn outcome_result <.T, .E> <(Outcome<.T, .E>)->Result<.T, .E>> (o):
    let result <Result<.T, .E>> field::get o "result"
    match field::get o "diags":
        Option::Some ds:
            diags_free ds
        Option::None:
            ()
    result

//: outcome_result: `Outcome` [参照/さんしょう]から Copy [可能/かのう]な `Result` を[読/よ]み[出/だ]す
pub fn outcome_result <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->Result<.T, .E>> (o):
    *field::get_ref o "result"

//: outcome_is_ok: `Outcome.result` が `Ok` か[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - [値/あたい]の[成否/せいひ]だけを[短/みじか]く[読/よ]み[取/と]りたい[場面/ばめん]で、`match` を[省/はぶ]いて[使/つか]えるようにします。
//:
//: [実装/じっそう]:
//: - `outcome_result o` を `match` し、`Result::Ok` なら true を[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - `diags` に warning や error が[含/ふく]まれていても、`result` が `Ok` なら true です。
//: - [診断/しんだん][群/ぐん]の[重大度/じゅうだいど]は `outcome_has_errors` で[別途/べっと]に[確認/かくにん]します。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn outcome_is_ok <.T, .E> <(Outcome<.T, .E>)->bool> (o):
    match outcome_result o:
        Result::Ok _v:
            true
        Result::Err _e:
            false

//: outcome_is_ok: `Outcome` [参照/さんしょう]の `Result` が `Ok` か[判定/はんてい]する
pub fn outcome_is_ok <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->bool> (o):
    match outcome_result o:
        Result::Ok _v:
            true
        Result::Err _e:
            false

//: outcome_is_err: `Outcome.result` が `Err` か[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - [軽量/けいりょう]な[失敗/しっぱい][制御/せいぎょ]だけを[見/み]たい[場面/ばめん]で、`Result` の `Err` かどうかを[即座/そくざ]に[調/しら]べられるようにします。
//:
//: [実装/じっそう]:
//: - `outcome_is_ok` の[否定/ひてい]を[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - `Outcome` の[診断/しんだん][群/ぐん]とは[独立/どくりつ]です。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn outcome_is_err <.T, .E> <(Outcome<.T, .E>)->bool> (o):
    not outcome_is_ok o

//: outcome_is_err: `Outcome` [参照/さんしょう]の `Result` が `Err` か[判定/はんてい]する
pub fn outcome_is_err <.T: Copy, .E: Copy> <(&Outcome<.T, .E>)->bool> (o):
    not outcome_is_ok o

//: outcome_diags_or_empty: `Outcome` の[診断/しんだん][群/ぐん]を[空/から]なら[空/から]の `Diags` に[置/お]き[換/か]えて[返/かえ]す
//:
//: [目的/もくてき]:
//: - `Outcome` を[使/つか]う[側/がわ]が `Option<Diags>` をそのつど `match` せず、[一貫/いっかん]して `Diags` として[扱/あつか]えるようにします。
//:
//: [実装/じっそう]:
//: - `some` ならそのまま[返/かえ]し、`none` なら `diags_new` を[作/つく]ります。
//:
//: [注意/ちゅうい]:
//: - `none` のときは[空/から] `Diags` を[新規/しんき][確保/かくほ]します。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
pub fn outcome_diags_or_empty <.T, .E> <(Outcome<.T, .E>)*>Diags> (o):
    match field::get o "diags":
        Option::Some ds:
            ds
        Option::None:
            diags_new

//: outcome_has_errors: `Outcome` の[診断/しんだん][群/ぐん]に error level が[含/ふく]まれるか[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - compiler や richer な parser が `Outcome.result` とは[別/べつ]に、[診断/しんだん][群/ぐん]の[重大度/じゅうだいど]で[処理/しょり][継続/けいぞく]を[判断/はんだん]するときに[使/つか]います。
//:
//: [実装/じっそう]:
//: - `diags` が `none` なら false、`some` なら `diags_has_errors` を[呼/よ]びます。
//:
//: [注意/ちゅうい]:
//: - `Result::Err` であっても `diags` が[空/から]なら false を[返/かえ]します。
//: - `Outcome.result` の[成否/せいひ]と `DiagLevel::Error` は[別軸/べつじく]です。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(n)（[再帰/さいき]ぶん）
pub fn outcome_has_errors <.T, .E> <(Outcome<.T, .E>)->bool> (o):
    match field::get o "diags":
        Option::Some ds:
            diags_has_errors ds
        Option::None:
            false
