//: diag: [単一/たんいつ][診断/しんだん]の[構築/こうちく]と[観測/かんそく]
//:
//: [目的/もくてき]:
//: - `DiagKind` / `Diag` の constructor と accessor を[提供/ていきょう]します。
//: - `StdErrorKind` との[連携/れんけい]をここに[集/あつ]め、診断群や Outcome の所有権処理から[分離/ぶんり]します。
//:
//: [注意/ちゅうい]:
//: - note/help は[連結/れんけつ]せず、renderer に[整形/せいけい]を[委/ゆだ]ねます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/diag/error/diag" as *
//: fn main %impure fn void i32 \void:
//:     let d %Diag diag_error StdErrorKind::OutOfMemory "allocation failed"
//:     let checks checks_push checks_new assert_str_eq "OutOfMemory" diag_std_error_kind_str d
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```

#indent 4

#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "alloc/diag/error/types" as *
#import "core/field" as *
#import "core/math/bool" as *
//: diag_kind_new: `DiagKind` を[構築/こうちく]する
pub fn diag_kind_new %fn DiagLevel fn Option StdErrorKind fn Option str DiagKind \level\std_error\local_kind:
    DiagKind level std_error local_kind

//: std_error_kind: `StdErrorKind` を[持/も]つ error [診断/しんだん][分類/ぶんるい]を[作/つく]る
pub fn std_error_diag_kind %fn StdErrorKind DiagKind \kind:
    diag_kind_new DiagLevel::Error some kind none

//: log_kind: local kind [付/つ]きの log [分類/ぶんるい]を[作/つく]る
pub fn log_diag_kind %fn str DiagKind \local_kind:
    diag_kind_new DiagLevel::Log none some local_kind

//: info_kind: local kind [付/つ]きの info [分類/ぶんるい]を[作/つく]る
pub fn info_diag_kind %fn str DiagKind \local_kind:
    diag_kind_new DiagLevel::Info none some local_kind

//: warn_kind: local kind [付/つ]きの warn [分類/ぶんるい]を[作/つく]る
pub fn warn_diag_kind %fn str DiagKind \local_kind:
    diag_kind_new DiagLevel::Warn none some local_kind

//: diag_new: [診断/しんだん] 1 [件/けん]を[構築/こうちく]する
pub fn diag_new %impure fn DiagKind impure fn str Diag \kind\message:
    Diag kind message none "" "" none

//: diag_log: log [診断/しんだん]を[作/つく]る
pub fn diag_log %impure fn str Diag \message:
    let kind %DiagKind log_diag_kind "log";
    diag_new kind message

//: diag_info: info [診断/しんだん]を[作/つく]る
pub fn diag_info %impure fn str Diag \message:
    let kind %DiagKind info_diag_kind "info";
    diag_new kind message

//: diag_warn: warn [診断/しんだん]を[作/つく]る
pub fn diag_warn %impure fn str Diag \message:
    let kind %DiagKind warn_diag_kind "warn";
    diag_new kind message

//: diag_error: `StdErrorKind` [付/つ]き error [診断/しんだん]を[作/つく]る
pub fn diag_error %impure fn StdErrorKind impure fn str Diag \kind\message:
    let dk %DiagKind std_error_diag_kind kind;
    diag_new dk message

//: diag_with_span: [位置/いち][情報/じょうほう]を[付与/ふよ]する
pub fn diag_with_span %fn Diag fn Span Diag \d\sp:
    Diag *field::get_ref &d "kind" *field::get_ref &d "message" some sp *field::get_ref &d "notes" *field::get_ref &d "help" *field::get_ref &d "source"

//: diag_with_source: [由来/ゆらい][情報/じょうほう]を[付与/ふよ]する
pub fn diag_with_source %fn Diag fn str Diag \d\src:
    Diag *field::get_ref &d "kind" *field::get_ref &d "message" *field::get_ref &d "span" *field::get_ref &d "notes" *field::get_ref &d "help" some src

//: diag_add_note: note を 1 [件/けん][追加/ついか]する
pub fn diag_add_note %impure fn Diag impure fn str Diag \d\note:
    Diag *field::get_ref &d "kind" *field::get_ref &d "message" *field::get_ref &d "span" note *field::get_ref &d "help" *field::get_ref &d "source"

//: diag_add_help: help を 1 [件/けん][追加/ついか]する
pub fn diag_add_help %impure fn Diag impure fn str Diag \d\help_item:
    Diag *field::get_ref &d "kind" *field::get_ref &d "message" *field::get_ref &d "span" *field::get_ref &d "notes" help_item *field::get_ref &d "source"

//: diag_level: [重大度/じゅうだいど]を[取/と]り[出/だ]す
pub fn diag_level %fn &Diag DiagLevel \d:
    let kind %&DiagKind field::get_ref d "kind";
    *field::get_ref kind "level"

//: diag_level: by-value `Diag` から[重大度/じゅうだいど] enum を[読/よ]む
//:
//: ### [契約/けいやく]
//: - borrowed overload と[同/おな]じ `DiagLevel` を[返/かえ]します。
//: - [重大度/じゅうだいど]は `DiagLevel` enum が[権威/けんい]であり、`"error"` などの[表示/ひょうじ][文字列/もじれつ]では[判定/はんてい]しません。
//: - `Diag` は Copy な[診断/しんだん][値/あたい]なので owner cleanup は[不要/ふよう]です。
//:
//: ### [戻り値/もどりち]
//: - `DiagLevel::Log`
//: - `DiagLevel::Info`
//: - `DiagLevel::Warn`
//: - `DiagLevel::Error`
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `&d` を[作/つく]って borrowed overload に[委譲/いじょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"diag_level_by_value_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"level enum\" expected=\"error\" actual=\"error\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/diag/error/diag" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let d %Diag diag_error StdErrorKind::OutOfMemory "allocation failed"
//:     let level %DiagLevel diag_level d
//:     let actual %str match level:
//:         DiagLevel::Error:
//:             "error"
//:         DiagLevel::Warn:
//:             "warn"
//:         DiagLevel::Info:
//:             "info"
//:         DiagLevel::Log:
//:             "log"
//:     let report:
//:         test_report_new "diag_level_by_value_doc"
//:         |> test_report_push assert_str_eq "level enum" "error" actual
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn diag_level %fn Diag DiagLevel \d:
    diag_level &d

//: diag_std_error_kind: `StdErrorKind` を[取/と]り[出/だ]す
pub fn diag_std_error_kind %fn &Diag Option StdErrorKind \d:
    let kind %&DiagKind field::get_ref d "kind";
    *field::get_ref kind "std_error"

//: diag_std_error_kind: by-value `Diag` から `StdErrorKind` payload を[読/よ]む
//:
//: ### [契約/けいやく]
//: - `DiagKind.std_error` を `Option StdErrorKind` のまま[返/かえ]します。
//: - [共通/きょうつう] stdlib error の[判定/はんてい]は、この `Option` と `StdErrorKind` enum を `match` して[行/おこな]います。
//: - `Option::None` は local kind や log/info/warn など、stdlib [共通/きょうつう] error kind を[持/も]たない[診断/しんだん]を[表/あらわ]します。
//:
//: ### [戻り値/もどりち]
//: - `Option::Some kind`: `StdErrorKind` が[構造化/こうぞうか] payload として[存在/そんざい]します。
//: - `Option::None`: stdlib [共通/きょうつう] error kind は[存在/そんざい]しません。
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - `&d` を[作/つく]って borrowed overload に[委譲/いじょう]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"diag_std_error_kind_by_value_doc\" count=1 failed=0\nassertion index=0 status=ok kind=str_eq label=\"std kind\" expected=\"OutOfMemory\" actual=\"OutOfMemory\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/diag/error/diag" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let d %Diag diag_error StdErrorKind::OutOfMemory "allocation failed"
//:     let kind_name %str match diag_std_error_kind d:
//:         Option::Some k:
//:             std_error_kind_str k
//:         Option::None:
//:             "missing"
//:     let report:
//:         test_report_new "diag_std_error_kind_by_value_doc"
//:         |> test_report_push assert_str_eq "std kind" "OutOfMemory" kind_name
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn diag_std_error_kind %fn Diag Option StdErrorKind \d:
    diag_std_error_kind &d

//: diag_std_error_kind_str: `StdErrorKind` の[文字列/もじれつ][名/めい]を[取/と]り[出/だ]す
pub fn diag_std_error_kind_str %fn &Diag str \d:
    match diag_std_error_kind d:
        Option::Some k:
            std_error_kind_str k
        Option::None:
            "None"

//: diag_std_error_kind_str: by-value `Diag` の std error kind を[表示/ひょうじ][文字列/もじれつ]へ[変換/へんかん]する
//:
//: ### [契約/けいやく]
//: - `diag_std_error_kind d` が `Option::Some k` なら `std_error_kind_str k` を[返/かえ]します。
//: - `Option::None` なら[表示/ひょうじ] helper として `"None"` を[返/かえ]します。
//: - error [判定/はんてい]の[権威/けんい]は `Option StdErrorKind` であり、この[文字列/もじれつ]は doctest や人間向け表示の補助です。
//:
//: ### [戻り値/もどりち]
//: - `StdErrorKind` の[名前/なまえ][文字列/もじれつ]
//: - std error kind がない[場合/ばあい]の `"None"`
//:
//: ### [現在/げんざい]の[実装/じっそう]
//: - by-value accessor を `match` して[文字列/もじれつ]へ[投影/とうえい]します。
//:
//: ### [計算量/けいさんりょう]
//: - [時間/じかん]: O(1)
//: - [空間/くうかん]: O(1)
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"diag_std_error_kind_str_by_value_doc\" count=2 failed=0\nassertion index=0 status=ok kind=str_eq label=\"std kind name\" expected=\"OutOfMemory\" actual=\"OutOfMemory\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"missing kind name\" expected=\"None\" actual=\"None\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #indent 4
//:| #target std
//:| #import "alloc/diag/error/diag" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let d0 %Diag diag_error StdErrorKind::OutOfMemory "allocation failed"
//:     let d1 %Diag diag_warn "careful"
//:     let report:
//:         test_report_new "diag_std_error_kind_str_by_value_doc"
//:         |> test_report_push assert_str_eq "std kind name" "OutOfMemory" diag_std_error_kind_str d0
//:         |> test_report_push assert_str_eq "missing kind name" "None" diag_std_error_kind_str d1
//:     let shown test_report_print_stdout report
//:     test_report_exit_code shown
//: ```
pub fn diag_std_error_kind_str %fn Diag str \d:
    match diag_std_error_kind d:
        Option::Some k:
            std_error_kind_str k
        Option::None:
            "None"

//: diag_err: `Diag` を `Result::Err` に[包/つつ]む
pub fn diag_err <.T> %fn Diag Result .T Diag \d:
    err d

//: diag_out_of_memory: [確保/かくほ][失敗/しっぱい]を[表/あらわ]す error [診断/しんだん]を[作/つく]る
pub fn diag_out_of_memory %impure fn void Diag \void:
    diag_error StdErrorKind::OutOfMemory "allocation failed"

//: diag_empty_collection: [空/から]コレクション[操作/そうさ]の error [診断/しんだん]を[作/つく]る
pub fn diag_empty_collection %impure fn void Diag \void:
    diag_error StdErrorKind::EmptyCollection "collection is empty"

//: diag_capacity_exceeded: [容量/ようりょう][超過/ちょうか]の error [診断/しんだん]を[作/つく]る
pub fn diag_capacity_exceeded %impure fn void Diag \void:
    diag_error StdErrorKind::CapacityExceeded "capacity exceeded"

//: diag_key_not_found: [欠落/けつらく] key の error [診断/しんだん]を[作/つく]る
pub fn diag_key_not_found %impure fn void Diag \void:
    diag_error StdErrorKind::KeyNotFound "key not found"
