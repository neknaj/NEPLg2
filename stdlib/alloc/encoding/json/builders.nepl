//: builders: JsonValue と JsonMember の構築 helper
//:
//: [目的/もくてき]:
//: - JSON literal constructor と Array/Object builder を提供します。
//: - Array/Object builder は JSON fragment を型付き値として保持し、現行の Copy-only `Vec` に non-Copy JSON tree を載せません。
//:
//: [注意/ちゅうい]:
//: - `json_array_push` / `json_object_push` は値を即時 serialize して fragment に追加します。要素をあとから typed tree として走査する API ではありません。

#indent 4

#import "core/result" as *
#import "alloc/string" as *
#import "./types" as *
#import "./escape" as *
#import "./serialize" as *
#import "core/field" as *

//: json_null: JSON null 値を作る
//:
//: [目的/もくてき]:
//: - payload を持たない `JsonValue::Null` を返します。
//:
//: [実装/じっそう]:
//: - enum constructor をそのまま返します。
//:
//: [注意/ちゅうい]:
//: - 追加の情報は保持しません。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_null <()->JsonValue> ():
    JsonValue::Null

//: json_bool: bool 値を JSON Bool に変換する
//:
//: [目的/もくてき]:
//: - NEPL の `bool` を `JsonValue::Bool` として保持します。
//:
//: [実装/じっそう]:
//: - `true` を 1、`false` を 0 の i32 payload に変換します。
//:
//: [注意/ちゅうい]:
//: - serializer は 0 を `false`、0 以外を `true` として出力します。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_bool <(bool)->JsonValue> (v):
    if:
        v
        then:
            JsonValue::Bool 1
        else:
            JsonValue::Bool 0

//: json_number: i32 を JSON Number として保持する
//:
//: [目的/もくてき]:
//: - i32 を `JsonValue::Number` payload に包みます。
//:
//: [実装/じっそう]:
//: - enum constructor に値を渡します。
//:
//: [注意/ちゅうい]:
//: - 現行実装は実数や i32 を超える整数を扱いません。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_number <(i32)->JsonValue> (n):
    JsonValue::Number n

//: json_string: str を JSON String として保持する
//:
//: [目的/もくてき]:
//: - `str` を `JsonValue::String` payload に包みます。
//:
//: [実装/じっそう]:
//: - enum constructor に文字列を渡します。
//:
//: [注意/ちゅうい]:
//: - UTF-8 の妥当性は `str` の作成経路に依存します。serialize 時は `json_escape` を通します。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_string <(str)->JsonValue> (s):
    JsonValue::String s

//: json_array_new: 空の JSON array builder を作る
//:
//: [目的/もくてき]:
//: - `JsonValue::Array` に渡す `JsonArray` builder を作ります。
//:
//: [実装/じっそう]:
//: - 空の body fragment を持つ `JsonArray` を返します。
//:
//: [注意/ちゅうい]:
//: - API 形状は fallible builder として `Result` を保ちます。現行の空 builder 作成自体は allocation を行いません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn json_array_new <()->Result<JsonArray, StdErrorKind>> ():
    Result<JsonArray, StdErrorKind>::Ok JsonArray ""

//: json_array_push: JSON array builder へ要素を追加する
//:
//: [目的/もくてき]:
//: - array body fragment の末尾に value の JSON 表現を追加します。
//:
//: [実装/じっそう]:
//: - 既存 body が空でなければ `,` を挟み、`json_serialize value` を連結します。
//:
//: [注意/ちゅうい]:
//: - 返った `JsonArray` を受け取り直してください。
//:
//: [計算量/けいさんりょう]:
//: - ならし O(1)、再確保時 O(n)
pub fn json_array_push <(JsonArray,JsonValue)->Result<JsonArray, StdErrorKind>> (arr, value):
    let body <str> get arr "items"
    let sep <str> if str_eq body "" "" ","
    let body_sep <str> concat body sep
    let value_text <str> json_serialize value
    Result<JsonArray, StdErrorKind>::Ok JsonArray concat body_sep value_text

//: json_array: JsonArray を JSON Array として保持する
//:
//: [目的/もくてき]:
//: - `json_array_new` / `json_array_push` で作った `JsonArray` を `JsonValue::Array` に包みます。
//:
//: [実装/じっそう]:
//: - enum constructor に typed fragment を渡します。
//:
//: [注意/ちゅうい]:
//: - `arr` は Copy な value fragment です。builder API では返った値を受け取り直す書き方を推奨します。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_array <(JsonArray)->JsonValue> (arr):
    JsonValue::Array arr

//: json_member: object member を作る
//:
//: [目的/もくてき]:
//: - JSON object の key/value pair を型付きで構築します。
//:
//: [実装/じっそう]:
//: - `JsonMember` struct に key と value を詰めます。
//:
//: [注意/ちゅうい]:
//: - key の重複検査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn json_member <(str,JsonValue)->JsonMember> (key, value):
    JsonMember key value

//: json_object_new: 空の JSON object builder を作る
//:
//: [目的/もくてき]:
//: - `JsonValue::Object` に渡す `JsonObject` builder を作ります。
//:
//: [実装/じっそう]:
//: - 空の member body fragment を持つ `JsonObject` を返します。
//:
//: [注意/ちゅうい]:
//: - API 形状は fallible builder として `Result` を保ちます。現行の空 builder 作成自体は allocation を行いません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub fn json_object_new <()->Result<JsonObject, StdErrorKind>> ():
    Result<JsonObject, StdErrorKind>::Ok JsonObject ""

//: json_object_push: JSON object builder へ member を追加する
//:
//: [目的/もくてき]:
//: - key/value を JSON member fragment にして object builder の末尾へ追加します。
//:
//: [実装/じっそう]:
//: - key は `json_quote_string`、value は `json_serialize` を通してから body に連結します。
//:
//: [注意/ちゅうい]:
//: - 出力時の member 順序は push した順序です。
//: - 返った `JsonObject` を受け取り直してください。
//:
//: [計算量/けいさんりょう]:
//: - ならし O(1)、再確保時 O(n)
pub fn json_object_push <(JsonObject,str,JsonValue)->Result<JsonObject, StdErrorKind>> (obj, key, value):
    let body <str> get obj "members"
    let sep <str> if str_eq body "" "" ","
    let body_sep <str> concat body sep
    let key_text <str> json_quote_string key
    let key_colon <str> concat key_text ":"
    let value_text <str> json_serialize value
    let member_text <str> concat key_colon value_text
    Result<JsonObject, StdErrorKind>::Ok JsonObject concat body_sep member_text

//: json_object: JsonObject を JSON Object として保持する
//:
//: [目的/もくてき]:
//: - `json_object_new` / `json_object_push` で作った member fragment を `JsonValue::Object` に包みます。
//:
//: [実装/じっそう]:
//: - enum constructor に typed fragment を渡します。
//:
//: [注意/ちゅうい]:
//: - key の重複検査は行いません。
//: - `obj` は Copy な value fragment です。builder API では返った値を受け取り直す書き方を推奨します。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn json_object <(JsonObject)->JsonValue> (obj):
    JsonValue::Object obj

//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/encoding/json/types" as *
//:| #import "alloc/encoding/json/builders" as *
//: fn main <()*>i32> ():
//:     let a <JsonArray> unwrap_ok json_array_new
//:     let a2 <JsonArray> unwrap_ok json_array_push a json_number 7
//:     let _v <JsonValue> json_array a2
//:     checks_exit_code checks_push checks_new assert true
//: ```
