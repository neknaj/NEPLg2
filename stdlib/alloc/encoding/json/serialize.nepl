//: serialize: JsonValue の compact JSON 文字列化
//:
//: [目的/もくてき]:
//: - `JsonValue` を deterministic な compact JSON string へ変換します。
//: - Array/Object は typed fragment を括弧で包み、JSON module から raw collection storage 依存を排除します。
//:
//: [注意/ちゅうい]:
//: - Number は現行の `i32` 表現を `from_i32` で出力します。
//: - Array/Object の要素順は builder に push された順序を保ちます。

#indent 4

#import "core/math" as *
#import "alloc/string" as *
#import "alloc/string/integer/format" as int_format
#import "./types" as *
#import "./escape" as *
#import "core/field" as *

//: json_serialize_array: JSON array を文字列化する
//:
//: [目的/もくてき]:
//: - `JsonArray` body を `[v0,v1,...]` の JSON 表現へ変換します。
//:
//: [実装/じっそう]:
//: - builder 済み body fragment を `[` と `]` で包みます。
//:
//: [注意/ちゅうい]:
//: - 要素順は `json_array_push` の順序を保ちます。
//:
//: [計算量/けいさんりょう]:
//: - 出力 byte 数に比例します。
pub fn json_serialize_array %fn JsonArray str \items:
    concat3 "[" get items "items" "]"

//: json_serialize_object: JSON object を文字列化する
//:
//: [目的/もくてき]:
//: - `JsonObject` body を `{"k":v,...}` の JSON 表現へ変換します。
//:
//: [実装/じっそう]:
//: - builder 済み member fragment を `{` と `}` で包みます。
//:
//: [注意/ちゅうい]:
//: - member 順序は `json_object_push` の順序を保ちます。key の重複検査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - 出力 byte 数に比例します。
pub fn json_serialize_object %fn JsonObject str \members:
    concat3 "{" get members "members" "}"

//: json_serialize: JSON 値を文字列化する
//:
//: [目的/もくてき]:
//: - `JsonValue` を compact JSON string へ変換します。
//:
//: [実装/じっそう]:
//: - enum variant ごとに literal / escape / recursive serialize を選びます。
//:
//: [注意/ちゅうい]:
//: - Number は現行の `i32` 表現を `from_i32` で出力します。
//: - UTF-8 validation はまだ行いません。
//:
//: [計算量/けいさんりょう]:
//: - 値全体の要素数と出力 byte 数に比例します。
pub fn json_serialize %fn JsonValue str \v:
    match v:
        JsonValue::Null:
            "null"
        JsonValue::Bool b:
            if:
                eq b 0
                then:
                    "false"
                else:
                    "true"
        JsonValue::Number n:
            int_format::from_i32 n
        JsonValue::String s:
            json_quote_string s
        JsonValue::Array a:
            json_serialize_array a
        JsonValue::Object o:
            json_serialize_object o

//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "Checked [ok]\n[0] ok\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "core/result" as *
//:| #import "alloc/encoding/json/types" as *
//:| #import "alloc/encoding/json/builders" as *
//:| #import "alloc/encoding/json/serialize" as *
//: fn main %impure fn void i32 \void:
//:     let obj0 %JsonObject unwrap_ok json_object_new
//:     let obj1 %JsonObject unwrap_ok json_object_push obj0 "n" json_number 4
//:     let checks checks_push checks_new assert_str_eq "{\"n\":4}" json_serialize json_object obj1
//:     let shown checks_print_report checks
//:     checks_exit_code shown
//: ```
