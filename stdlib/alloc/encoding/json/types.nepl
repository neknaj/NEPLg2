//: types: JSON 値と escape 分類の型定義
//:
//: [目的/もくてき]:
//: - JSON 値の enum、object member、string escape 分類を定義します。
//: - 静的検査が効くように JSON kind と escape kind は整数や文字列ではなく enum で管理します。
//:
//: [注意/ちゅうい]:
//: - Number は i32 として保持します（実数や大きな整数は未対応）。
//: - Array/Object は typed JSON fragment を保持します。non-Copy payload collection が完成するまでは、`Vec<JsonValue>` へ JSON tree を載せません。

#indent 4

#import "core/traits/copy" as *

//: JsonArray: JSON array の compact body fragment
//:
//: [目的/もくてき]:
//: - `[` と `]` の内側に入る comma-separated JSON fragment を保持します。
//:
//: [実装/じっそう]:
//: - `items` は既に JSON escaped / serialized 済みの body です。
//:
//: [注意/ちゅうい]:
//: - 現段階の JSON builder は安全な document builder であり、array 要素を再走査する typed tree ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
pub struct JsonArray:
    items <str>

//: JsonObject: JSON object の compact body fragment
//:
//: [目的/もくてき]:
//: - `{` と `}` の内側に入る comma-separated member fragment を保持します。
//:
//: [実装/じっそう]:
//: - `members` は key を quote 済み、value を serialize 済みの body です。
//:
//: [注意/ちゅうい]:
//: - key の重複検査や member の再走査は行いません。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
pub struct JsonObject:
    members <str>

//: JsonValue: JSON の値表現
//:
//: [目的/もくてき]:
//: - JSON の null / bool / number / string / array / object を型付き payload で表します。
//:
//: [実装/じっそう]:
//: - `String` は `str`、`Array` は `JsonArray`、`Object` は `JsonObject` を保持します。
//:
//: [注意/ちゅうい]:
//: - Array/Object は JSON fragment を値として保持します。
//:
//: [計算量/けいさんりょう]:
//: - 定義そのものは O(1) です。
pub enum JsonValue:
    Null
    Bool <i32>
    Number <i32>
    String <str>
    Array <JsonArray>
    Object <JsonObject>

//: JsonMember: JSON object の 1 member
//:
//: [目的/もくてき]:
//: - object の key と value を型付きで保持します。
//:
//: [実装/じっそう]:
//: - key は `str`、value は `JsonValue` です。
//:
//: [注意/ちゅうい]:
//: - key の重複検査や並べ替えは行いません。JSON object の出力順は Vec に push した順序です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub struct JsonMember:
    key <str>
    value <JsonValue>

impl Clone for JsonArray:
    fn clone <(&JsonArray)->JsonArray> (x):
        *x

impl Copy for JsonArray:
    fn copy_mark <(JsonArray)->JsonArray> (x):
        x

impl Clone for JsonObject:
    fn clone <(&JsonObject)->JsonObject> (x):
        *x

impl Copy for JsonObject:
    fn copy_mark <(JsonObject)->JsonObject> (x):
        x

impl Clone for JsonValue:
    fn clone <(&JsonValue)->JsonValue> (x):
        *x

impl Copy for JsonValue:
    fn copy_mark <(JsonValue)->JsonValue> (x):
        x

impl Clone for JsonMember:
    fn clone <(&JsonMember)->JsonMember> (x):
        *x

impl Copy for JsonMember:
    fn copy_mark <(JsonMember)->JsonMember> (x):
        x

//: JsonEscapeKind: JSON string escape の分類
//:
//: [目的/もくてき]:
//: - 入力 byte が JSON string 内でどの escape 表記に対応するかを enum で表します。
//:
//: [実装/じっそう]:
//: - `json_escape_kind` で byte を分類し、`json_escape` はこの enum を `match` して出力を決めます。
//:
//: [注意/ちゅうい]:
//: - Plain は escape せず入力 byte をそのまま 1 byte slice として出力する分類です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
pub enum JsonEscapeKind:
    Backslash
    Quote
    Newline
    CarriageReturn
    Tab
    Backspace
    FormFeed
    Plain

//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "std/test" as *
//:| #import "alloc/encoding/json/types" as *
//: fn main <()*>i32> ():
//:     let v <JsonValue> JsonValue::Null
//:     let checks checks_push checks_new assert true
//:     checks_exit_code checks
//: ```
