//: # alloc/gui
//: GUI / TUI 共通 UI substrate の alloc layer facade
//:
//: ### [目的/もくてき]
//: - `core/gui` の no_alloc 型に、application model、widget description、host effect value を重ねます。
//: - GUI と TUI を別々の framework として分けず、どちらも `ViewNode` と `GuiEffect` を通して backend へ接続できるようにします。
//:
//: ### [実装/じっそう]
//: - 現 checkpoint では app model、layout context、widget descriptor、retained tree、focus traversal、event routing、diff / invalidation、text buffer、theme、accessibility semantic tree を公開します。
//:
//: ### [注意/ちゅうい]
//: - この facade は OS window、DOM、ANSI escape、clipboard を直接扱いません。それらは `std/gui` と `platforms/gui/*` が所有します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #import "alloc/gui" as *
//: ```

#indent 4

pub #import "core/gui" as *
pub #import "alloc/gui/app" as *
pub #import "alloc/gui/layout" as *
pub #import "alloc/gui/widget" as *
pub #import "alloc/gui/tree" as *
pub #import "alloc/gui/focus" as *
pub #import "alloc/gui/routing" as *
pub #import "alloc/gui/diff" as *
pub #import "alloc/gui/text" as *
pub #import "alloc/gui/font" as *
pub #import "alloc/gui/render2d" as *
pub #import "alloc/gui/theme" as *
pub #import "alloc/gui/accessibility" as *
