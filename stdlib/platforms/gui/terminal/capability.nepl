//: # platforms/gui/terminal/capability
//: terminal backend capability の型境界
//:
//: ### [目的/もくてき]
//: - terminal を GUI substrate の `TextGrid` surface backend として表します。
//: - 画面サイズ、keyboard/text input の有無、flush 要否を struct にまとめ、raw terminal state と application model を分離します。
//:
//: ### [設計/せっけい]
//: - surface kind は enum で表し、`match` による静的検査が効く形にします。
//: - capability は現在の frame size と host 能力を持つだけで、ANSI code や TTY handle は保持しません。
//:
//: ### [計算量/けいさんりょう]
//: - constructor と accessor は O(1) です。

#indent 4

#import "core/field" as *
#import "core/math" as *
#import "core/traits/copy" as *

//: TerminalSurfaceKind: terminal backend が提供する surface kind
//:
//: [目的/もくてき]:
//: - terminal backend が pixel surface ではなく text-cell grid であることを enum として表します。
//:
//: [注意/ちゅうい]:
//: - 共通 `core/gui` の `SurfaceKind` が追加された後は、同じ概念をそちらへ移します。
pub enum TerminalSurfaceKind:
    TextGrid

impl Clone for TerminalSurfaceKind:
    fn clone %fn &TerminalSurfaceKind TerminalSurfaceKind \kind:
        *kind

impl Copy for TerminalSurfaceKind:
    fn copy_mark %fn TerminalSurfaceKind TerminalSurfaceKind \kind:
        kind

//: TextGridCapability: TextGrid surface backend の capability
//:
//: [目的/もくてき]:
//: - terminal frame の大きさと、backend が application event へ変換できる入力能力を表します。
//:
//: [実装/じっそう]:
//: - `kind` は常に `TerminalSurfaceKind::TextGrid` です。
//: - `cols` / `rows` は host から得た現在の grid size です。不明な場合は 0 を許します。
//:
//: [注意/ちゅうい]:
//: - raw ANSI、TTY state、DOM handle はここに入れません。
pub struct TextGridCapability:
    kind %TerminalSurfaceKind
    cols %i32
    rows %i32
    has_keyboard %bool
    has_text_input %bool
    requires_flush %bool

impl Clone for TextGridCapability:
    fn clone %fn &TextGridCapability TextGridCapability \cap:
        *cap

impl Copy for TextGridCapability:
    fn copy_mark %fn TextGridCapability TextGridCapability \cap:
        cap

//: text_grid_capability_full: terminal TextGrid capability を明示的に構築する
//:
//: [目的/もくてき]:
//: - host が把握している入力能力まで含めて capability を作ります。
//:
//: [注意/ちゅうい]:
//: - `cols` / `rows` は 0 以上を想定します。検査は `text_grid_capability_has_non_negative_size` で行えます。
pub fn text_grid_capability_full %fn i32 fn i32 fn bool fn bool fn bool TextGridCapability \cols\rows\has_keyboard\has_text_input\requires_flush:
    TextGridCapability TerminalSurfaceKind::TextGrid cols rows has_keyboard has_text_input requires_flush

//: text_grid_capability: terminal TextGrid capability を標準値で構築する
//:
//: [目的/もくてき]:
//: - terminal backend の最小 smoke test や mock backend で使う標準 capability を作ります。
//:
//: [実装/じっそう]:
//: - keyboard と text input は有効、presentation には flush が必要、という terminal host の既定値を入れます。
pub fn text_grid_capability %fn i32 fn i32 TextGridCapability \cols\rows:
    text_grid_capability_full cols rows true true true

//: text_grid_capability_kind: capability の surface kind を返す
pub fn text_grid_capability_kind %fn &TextGridCapability TerminalSurfaceKind \cap:
    *get_ref cap "kind"

//: text_grid_capability_cols: capability の列数を返す
pub fn text_grid_capability_cols %fn &TextGridCapability i32 \cap:
    *get_ref cap "cols"

//: text_grid_capability_rows: capability の行数を返す
pub fn text_grid_capability_rows %fn &TextGridCapability i32 \cap:
    *get_ref cap "rows"

//: text_grid_capability_has_keyboard: keyboard event へ変換できるか返す
pub fn text_grid_capability_has_keyboard %fn &TextGridCapability bool \cap:
    *get_ref cap "has_keyboard"

//: text_grid_capability_has_text_input: text input event へ変換できるか返す
pub fn text_grid_capability_has_text_input %fn &TextGridCapability bool \cap:
    *get_ref cap "has_text_input"

//: text_grid_capability_requires_flush: present に flush が必要か返す
pub fn text_grid_capability_requires_flush %fn &TextGridCapability bool \cap:
    *get_ref cap "requires_flush"

//: terminal_surface_is_text_grid: surface kind が TextGrid であることを判定する
//:
//: [目的/もくてき]:
//: - 呼び出し側が enum の variant 名に直接依存せず、terminal backend capability の smoke check を書けるようにします。
pub fn terminal_surface_is_text_grid %fn TerminalSurfaceKind bool \kind:
    match kind:
        TerminalSurfaceKind::TextGrid:
            true

//: text_grid_capability_has_non_negative_size: grid size が 0 以上か確認する
//:
//: [目的/もくてき]:
//: - TTY size が不明な backend でも 0,0 は許し、負値だけを capability boundary の異常として扱います。
pub fn text_grid_capability_has_non_negative_size %fn &TextGridCapability bool \cap:
    let cols %i32 text_grid_capability_cols cap
    let rows %i32 text_grid_capability_rows cap
    and not lt cols 0 not lt rows 0
