    match kind:
        GuiBareDisplayDriverErrorKind::DriverRejected lower:
            Option::Some lower
        GuiBareDisplayDriverErrorKind::MemoryInitFailed lower_init:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayDriverErrorKind::MemoryApplyFailed lower_apply:
