fn gui_bare_display_memory_checked_add %fn i32 fn i32 fn GuiBareDisplayMemoryErrorKind Result i32 GuiBareDisplayMemoryErrorKind \base\delta\overflow_kind:
    if or lt base 0 lt delta 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 2147483647
            let max_base %i32 sub max_i32 delta
            if gt base max_base:
                then Result::Err overflow_kind
                else Result::Ok add base delta

fn gui_bare_display_memory_checked_mul %fn i32 fn i32 fn GuiBareDisplayMemoryErrorKind Result i32 GuiBareDisplayMemoryErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

fn gui_bare_display_memory_config_total_byte_count %fn &GuiBareFramebufferConfig Result i32 GuiBareDisplayMemoryErrorKind \config:
    let surface %SurfaceId gui_bare_framebuffer_config_surface config
    if le surface_id_raw &surface 0:
        then Result::Err GuiBareDisplayMemoryErrorKind::ConfigSurfaceInvalid
        else:
            let width %i32 gui_bare_framebuffer_config_width config
            if le width 0:
                then Result::Err GuiBareDisplayMemoryErrorKind::ConfigWidthInvalid
                else:
                    let height %i32 gui_bare_framebuffer_config_height config
                    if le height 0:
                        then Result::Err GuiBareDisplayMemoryErrorKind::ConfigHeightInvalid
                        else:
                            let stride_bytes %i32 gui_bare_framebuffer_config_stride_bytes config
                            if le stride_bytes 0:
                                then Result::Err GuiBareDisplayMemoryErrorKind::ConfigStrideInvalid
                                else:
                                    match gui_bare_display_memory_checked_mul width 4 GuiBareDisplayMemoryErrorKind::ConfigStrideOverflow:
                                        Result::Err kind:
                                            Result::Err kind
                                        Result::Ok expected_stride:
                                            if ne stride_bytes expected_stride:
                                                then Result::Err GuiBareDisplayMemoryErrorKind::ConfigStrideMismatch
                                                else gui_bare_display_memory_checked_mul height stride_bytes GuiBareDisplayMemoryErrorKind::SurfaceByteCountOverflow

pub fn gui_bare_display_memory_state_initial %fn GuiBareFramebufferConfig Result GuiBareDisplayMemoryState GuiBareDisplayMemoryErrorKind \config:
    match gui_bare_display_memory_config_total_byte_count &config:
        Result::Err kind:
            Result::Err kind
        Result::Ok total_byte_count:
            let storage_state %GuiBareDisplayStorageState gui_bare_display_storage_state_initial config
            Result::Ok gui_bare_display_memory_state_new storage_state GuiBareDisplayMemoryPhase::Idle total_byte_count Option::None

fn gui_bare_display_memory_target_equal %fn GuiRgba8888RowTileRlePresentHostSpanOperationTarget fn GuiRgba8888RowTileRlePresentHostSpanOperationTarget bool \left\right:
    match left:
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window left_window:
            match right:
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window right_window:
                    eq window_id_raw &left_window window_id_raw &right_window
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
                    false
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
                    false
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
            match right:
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window right_window_nonmatching:
                    false
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
                    true
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
                    false
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
            match right:
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window right_window_nonmatching2:
                    false
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
                    false
                GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
                    true

fn gui_bare_display_memory_descriptor_equal %fn &GuiRgba8888RowTileRlePresentDescriptor fn &GuiRgba8888RowTileRlePresentDescriptor bool \left\right:
    let left_surface %SurfaceId gui_rgba8888_row_tile_rle_present_descriptor_surface left
    let right_surface %SurfaceId gui_rgba8888_row_tile_rle_present_descriptor_surface right
    let left_frame %FrameId gui_rgba8888_row_tile_rle_present_descriptor_frame left
    let right_frame %FrameId gui_rgba8888_row_tile_rle_present_descriptor_frame right
    let left_packet %GuiRgba8888RowTileRlePacketDescriptor gui_rgba8888_row_tile_rle_present_descriptor_packet left
    let right_packet %GuiRgba8888RowTileRlePacketDescriptor gui_rgba8888_row_tile_rle_present_descriptor_packet right
    and:
        eq surface_id_raw &left_surface surface_id_raw &right_surface
        and:
            eq frame_id_raw &left_frame frame_id_raw &right_frame
            and:
                eq gui_rgba8888_row_tile_rle_packet_descriptor_frame_id &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_frame_id &right_packet
                and:
                    eq gui_rgba8888_row_tile_rle_packet_descriptor_batch_index &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_batch_index &right_packet
                    and:
                        eq gui_rgba8888_row_tile_rle_packet_descriptor_tile_index &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_tile_index &right_packet
                        and:
                            eq gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_start &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_start &right_packet
                            and:
                                eq gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count &right_packet
                                and:
                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_row_start &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_row_start &right_packet
                                    and:
                                        eq gui_rgba8888_row_tile_rle_packet_descriptor_row_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_row_count &right_packet
                                        and:
                                            eq gui_rgba8888_row_tile_rle_packet_descriptor_width &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_width &right_packet
                                            and:
                                                eq gui_rgba8888_row_tile_rle_packet_descriptor_height &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_height &right_packet
                                                and:
                                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes &right_packet
                                                    and:
                                                        eq gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows &right_packet
                                                        and:
                                                            eq gui_rgba8888_row_tile_rle_packet_descriptor_tile_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_tile_count &right_packet
                                                            and:
                                                                eq gui_rgba8888_row_tile_rle_packet_descriptor_pixel_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_pixel_count &right_packet
                                                                and:
                                                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_total_run_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_total_run_count &right_packet
                                                                    eq gui_rgba8888_row_tile_rle_packet_descriptor_encoded_byte_count &left_packet gui_rgba8888_row_tile_rle_packet_descriptor_encoded_byte_count &right_packet

fn gui_bare_display_memory_option_frame_equal %fn Option FrameId fn Option FrameId bool \left\right:
    match left:
        Option::None:
            match right:
                Option::None:
                    true
                Option::Some right_frame:
                    false
        Option::Some left_frame:
            match right:
                Option::None:
                    false
                Option::Some right_frame:
                    eq frame_id_raw &left_frame frame_id_raw &right_frame

fn gui_bare_display_memory_config_equal %fn &GuiBareFramebufferConfig fn &GuiBareFramebufferConfig bool \left\right:
    let left_surface %SurfaceId gui_bare_framebuffer_config_surface left
    let right_surface %SurfaceId gui_bare_framebuffer_config_surface right
    and:
        eq surface_id_raw &left_surface surface_id_raw &right_surface
        and:
            eq gui_bare_framebuffer_config_width left gui_bare_framebuffer_config_width right
            and:
                eq gui_bare_framebuffer_config_height left gui_bare_framebuffer_config_height right
                eq gui_bare_framebuffer_config_stride_bytes left gui_bare_framebuffer_config_stride_bytes right

