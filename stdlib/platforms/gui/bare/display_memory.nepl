                                        then Result::Err GuiBareDisplayMemoryErrorKind::PresentPixelCountMismatch
                                        else:
                                            let expected_run_count %i32 gui_rgba8888_row_tile_rle_present_descriptor_expected_run_count &effect_descriptor
                                            let expected_pixel_count %i32 gui_rgba8888_row_tile_rle_present_descriptor_expected_pixel_count &effect_descriptor
                                            if ne effect_run_count expected_run_count:
                                                then Result::Err GuiBareDisplayMemoryErrorKind::PresentRunCountMismatch
                                                else:
                                                    if ne effect_pixel_count expected_pixel_count:
                                                        then Result::Err GuiBareDisplayMemoryErrorKind::PresentPixelCountMismatch
                                                        else:
                                                            let frame %FrameId gui_bare_display_storage_present_effect_frame &effect
                                                            let surface_byte_count %i32 gui_bare_display_memory_state_total_byte_count state
                                                            Result::Ok GuiBareDisplayMemoryAction::FramePresent gui_bare_display_memory_present_plan_new effect_target effect_descriptor frame effect_run_count effect_pixel_count surface_byte_count

fn gui_bare_display_memory_action_for_effect %fn &GuiBareDisplayMemoryState fn GuiBareDisplayStorageEffect Result GuiBareDisplayMemoryAction GuiBareDisplayMemoryErrorKind \state\effect:
    match effect:
        GuiBareDisplayStorageEffect::FrameBegin begin:
            gui_bare_display_memory_action_begin state begin
        GuiBareDisplayStorageEffect::SpanWrite span:
            gui_bare_display_memory_action_span state span
        GuiBareDisplayStorageEffect::FramePresent present:
            gui_bare_display_memory_action_present state present

fn gui_bare_display_memory_last_write_after_action %fn Option GuiBareDisplayMemorySpanWritePlan fn GuiBareDisplayMemoryAction Option GuiBareDisplayMemorySpanWritePlan \last_write\action:
    match action:
        GuiBareDisplayMemoryAction::FrameBegin begin:
            Option::None
        GuiBareDisplayMemoryAction::SpanWrite plan:
            Option::Some plan
        GuiBareDisplayMemoryAction::FramePresent present:
            last_write

//: gui_bare_display_memory_apply: storage ledger を checked byte write plan へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - supplied storage step は canonical storage state から[再適用/さいてきよう]し、state / effect が[一致/いっち]しない場合は[拒否/きょひ]します。
//: - span は RGBA8888 byte range に[変換/へんかん]し、overflow と surface out-of-bounds を[検査/けんさ]します。
//: - present は storage present effect と descriptor complete count が[一致/いっち]する場合だけ[成功/せいこう]します。
pub fn gui_bare_display_memory_apply %fn GuiBareDisplayMemoryState fn GuiBareDisplayStorageStepApplied Result GuiBareDisplayMemoryStepApplied GuiBareDisplayMemoryStepError \state\storage_step:
    match gui_bare_display_memory_state_invariant &state:
        Result::Err invariant_kind:
            Result::Err gui_bare_display_memory_step_error invariant_kind state storage_step
        Result::Ok invariant_ok:
            let framebuffer_step %GuiBareFramebufferStepApplied gui_bare_display_storage_step_applied_framebuffer_step &storage_step
            let current_storage_state %GuiBareDisplayStorageState gui_bare_display_memory_state_storage_state &state
            match gui_bare_display_storage_apply current_storage_state framebuffer_step:
                Result::Err storage_error:
                    let storage_kind %GuiBareDisplayStorageErrorKind gui_bare_display_storage_step_error_kind &storage_error
                    let memory_kind %GuiBareDisplayMemoryErrorKind GuiBareDisplayMemoryErrorKind::StorageApplyFailed storage_kind
                    Result::Err gui_bare_display_memory_step_error memory_kind state storage_step
                Result::Ok expected_storage_step:
                    let expected_storage_state %GuiBareDisplayStorageState gui_bare_display_storage_step_applied_state &expected_storage_step
                    let supplied_storage_state %GuiBareDisplayStorageState gui_bare_display_storage_step_applied_state &storage_step
                    if not gui_bare_display_memory_storage_state_equal &expected_storage_state &supplied_storage_state:
                        then Result::Err gui_bare_display_memory_step_error GuiBareDisplayMemoryErrorKind::StorageStepStateMismatch state storage_step
                        else:
                            let expected_effect %GuiBareDisplayStorageEffect gui_bare_display_storage_step_applied_effect &expected_storage_step
                            let supplied_effect %GuiBareDisplayStorageEffect gui_bare_display_storage_step_applied_effect &storage_step
                            if not gui_bare_display_memory_effect_equal expected_effect supplied_effect:
                                then Result::Err gui_bare_display_memory_step_error GuiBareDisplayMemoryErrorKind::StorageStepEffectMismatch state storage_step
                                else:
                                    match gui_bare_display_memory_action_for_effect &state expected_effect:
                                        Result::Err action_kind:
                                            Result::Err gui_bare_display_memory_step_error action_kind state storage_step
                                        Result::Ok action:
                                            let next_phase %GuiBareDisplayMemoryPhase gui_bare_display_memory_phase_from_storage_state &expected_storage_state
                                            let last_write %Option GuiBareDisplayMemorySpanWritePlan gui_bare_display_memory_state_last_write &state
                                            let next_write %Option GuiBareDisplayMemorySpanWritePlan gui_bare_display_memory_last_write_after_action last_write action
                                            let total_byte_count %i32 gui_bare_display_memory_state_total_byte_count &state
                                            let next_state %GuiBareDisplayMemoryState gui_bare_display_memory_state_new expected_storage_state next_phase total_byte_count next_write
                                            Result::Ok gui_bare_display_memory_step_applied_new next_state action expected_storage_step
