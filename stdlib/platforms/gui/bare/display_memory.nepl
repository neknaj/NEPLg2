fn gui_bare_display_memory_error_category %fn GuiBareDisplayMemoryErrorKind Option GuiError \kind:
    match kind:
        GuiBareDisplayMemoryErrorKind::StorageApplyFailed lower:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::ConfigSurfaceInvalid:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::StorageStepStateMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::StorageStepEffectMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::MemoryPhaseMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::TargetMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::DescriptorMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::AcceptedRunCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::AcceptedPixelCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::RunIndexMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::PixelStartMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::PixelEndMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::BeginWhileActive:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::RunWithoutBegin:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::EndWithoutBegin:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::PresentRunCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayMemoryErrorKind::PresentPixelCountMismatch:
            Option::Some GuiError::InvalidCommand
        _:
            Option::Some GuiError::InvalidGeometry

