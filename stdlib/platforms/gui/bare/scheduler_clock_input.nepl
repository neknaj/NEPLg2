    GuiBareSchedulerClockTimerInputTickFailed action state lower

//: gui_bare_scheduler_clock_yield_input: bare clock tick を yield action 用 input へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `gui_bare_scheduler_clock_tick` を 1 [回/かい]だけ[呼/よ]びます。
//: - success は F5eo が[作/つく]った state と input をそのまま[保持/ほじ]します。
//: - failure は original action と input clock state を lower error と[一緒/いっしょ]に[返/かえ]します。
pub fn gui_bare_scheduler_clock_yield_input %impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopActionYieldToClock Result GuiBareSchedulerClockYieldInputReady GuiBareSchedulerClockInputError \policy\state\action:
    match gui_bare_scheduler_clock_tick policy state:
        Result::Err lower:
            let payload %GuiBareSchedulerClockYieldInputTickFailed gui_bare_scheduler_clock_yield_input_tick_failed_new action state lower
            Result::Err GuiBareSchedulerClockInputError::YieldTickFailed payload
        Result::Ok advance:
            let next_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState field::get advance "state"
            let input %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopStepInput field::get advance "input"
            let ready %GuiBareSchedulerClockYieldInputReady gui_bare_scheduler_clock_yield_input_ready_new action next_state input
            Result::Ok ready

//: gui_bare_scheduler_clock_timer_input: bare clock tick を timer action 用 input へ[写/うつ]す
