fn gui_bare_display_storage_error_category %fn GuiBareDisplayStorageErrorKind Option GuiError \kind:
    match kind:
        GuiBareDisplayStorageErrorKind::FramebufferValidationFailed _:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::AppliedStateMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::StoragePhaseMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::TargetMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::DescriptorMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::AcceptedRunCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::AcceptedPixelCountMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::BeginWhileActive:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::RunWithoutBegin:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::EndWithoutBegin:
            Option::Some GuiError::InvalidCommand
        GuiBareDisplayStorageErrorKind::SpanPixelEndOverflow:
            Option::Some GuiError::InvalidGeometry

fn gui_bare_display_storage_step_error %fn GuiBareDisplayStorageErrorKind fn Option GuiError fn GuiBareDisplayStorageState fn GuiBareFramebufferStepApplied GuiBareDisplayStorageStepError \kind\category\state\framebuffer_step:
    GuiBareDisplayStorageStepError kind category state framebuffer_step

fn gui_bare_display_storage_step_error_from_kind %fn GuiBareDisplayStorageErrorKind fn GuiBareDisplayStorageState fn GuiBareFramebufferStepApplied GuiBareDisplayStorageStepError \kind\state\framebuffer_step:
    let category %Option GuiError gui_bare_display_storage_error_category kind
    gui_bare_display_storage_step_error kind category state framebuffer_step

