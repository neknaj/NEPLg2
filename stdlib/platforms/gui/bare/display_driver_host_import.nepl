//: # platforms/gui/bare/display_driver_host_import
//: Bare display driver host import boundary
//:
//: ### [目的/もくてき]
//: - F5fo の pure driver outcome ledger を、bare embedding host が[提供/ていきょう]する display driver import へ[接続/せつぞく]します。
//: - public memory step はそのまま[信用/しんよう]せず、host import の[前/まえ]に F5fo ledger で preflight し、stale / forged step を[副作用/ふくさよう]なしで[拒否/きょひ]します。
//: - host status は typed `GuiBareDisplayDriverOutcome` に[変換/へんかん]し、最後に F5fo ledger へ[再適用/さいてきよう]します。
//:
//: ### [契約/けいやく]
//: - status `0` だけを accepted outcome として[扱/あつか]い、負 status と正の non-zero status は fail-closed に[返/かえ]します。
//: - success outcome は host が import call を accepted status で[返/かえ]したことと ledger 一致を[示/しめ]すだけで、raw byte buffer を[検証/けんしょう]した証明ではありません。
//: - span write import には row span だけでなく、F5fn が[計算/けいさん]した byte range、surface byte count、run/pixel 範囲、color evidence を[渡/わた]します。
//: - long-running scheduler backend、timer、queue、present loop、DOM、Canvas、minifb、video memory、fallback、silent no-op は[扱/あつか]いません。
//:
//: neplg2:test[stdio]
//: stdout: ""
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #indent 4
//:|
//:| #import "platforms/gui/bare/display_driver_host_import" as *
//:|
//:| fn main %impure fn void i32 \void:
//:|      0
//: ```

#indent 4

#import "alloc/gui/render2d/row_tile_rle_packet" as *
#import "core/cast" as *
#import "core/gui/color" as *
#import "core/gui/error" as *
#import "core/math" as *
#import "core/result" as *
#import "platforms/gui/bare/display_driver" as *
#import "platforms/gui/bare/display_memory" as *
#import "std/gui/tile_present" as *
#import "std/gui/tile_present_host_span_operation" as *
#import "std/gui/tile_present_run_span" as *
#import "std/gui/window" as *

#extern "nepl_gui_bare" "display_driver_begin" fn gui_bare_display_driver_begin_raw %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#extern "nepl_gui_bare" "display_driver_span_write" fn gui_bare_display_driver_span_write_raw %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#extern "nepl_gui_bare" "display_driver_frame_present" fn gui_bare_display_driver_frame_present_raw %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32

fn gui_bare_display_driver_host_import_target_kind %fn GuiRgba8888RowTileRlePresentHostSpanOperationTarget i32 \target:
    match target:
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window window:
            1
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
            2
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
            3

fn gui_bare_display_driver_host_import_window_raw %fn GuiRgba8888RowTileRlePresentHostSpanOperationTarget i32 \target:
    match target:
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window window:
            window_id_raw &window
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen:
            0
        GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device:
            0

pub fn gui_bare_display_driver_host_import_status_error %fn i32 GuiError \status:
    if eq status -1:
        then GuiError::Unsupported
        else:
            if eq status -2:
                then GuiError::InvalidCommand
                else:
                    if eq status -3:
                        then GuiError::ResourceExhausted
                        else:
                            if eq status -4:
                                then GuiError::ResourceExhausted
                                else:
                                    if eq status -6:
                                        then GuiError::InvalidCommand
                                        else GuiError::BackendFailure

pub fn gui_bare_display_driver_host_import_success_outcome %fn GuiBareDisplayMemoryAction GuiBareDisplayDriverOutcome \action:
    match action:
        GuiBareDisplayMemoryAction::FrameBegin plan:
            gui_bare_display_driver_begin_outcome_from_plan plan
        GuiBareDisplayMemoryAction::SpanWrite plan:
            gui_bare_display_driver_span_write_outcome_from_plan plan
        GuiBareDisplayMemoryAction::FramePresent plan:
            gui_bare_display_driver_present_outcome_from_plan plan

pub fn gui_bare_display_driver_host_import_status_outcome %fn GuiBareDisplayMemoryAction fn i32 GuiBareDisplayDriverOutcome \action\status:
    if eq status 0:
        then gui_bare_display_driver_host_import_success_outcome action
        else GuiBareDisplayDriverOutcome::DriverRejected gui_bare_display_driver_host_import_status_error status

fn gui_bare_display_driver_host_import_preflight %fn GuiBareDisplayDriverState fn GuiBareDisplayMemoryStepApplied Result GuiBareDisplayDriverStepApplied GuiBareDisplayDriverStepError \state\memory_step:
    let memory_action %GuiBareDisplayMemoryAction gui_bare_display_memory_step_applied_action &memory_step
    let preview_outcome %GuiBareDisplayDriverOutcome gui_bare_display_driver_host_import_success_outcome memory_action
    gui_bare_display_driver_apply state memory_step preview_outcome

fn gui_bare_display_driver_host_import_descriptor_begin %impure fn GuiBareDisplayMemoryFrameBeginPlan i32 \plan:
    let target %GuiRgba8888RowTileRlePresentHostSpanOperationTarget gui_bare_display_memory_begin_plan_target &plan
