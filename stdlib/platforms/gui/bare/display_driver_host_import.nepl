fn gui_bare_display_driver_host_import_call %impure fn GuiBareDisplayMemoryAction i32 \action:
    match action:
        GuiBareDisplayMemoryAction::FrameBegin plan:
            gui_bare_display_driver_host_import_descriptor_begin plan
        GuiBareDisplayMemoryAction::SpanWrite plan:
            gui_bare_display_driver_host_import_span_write plan
        GuiBareDisplayMemoryAction::FramePresent plan:
            gui_bare_display_driver_host_import_frame_present plan

//: gui_bare_display_driver_host_import_step: checked memory step を bare display driver import へ 1 [回/かい]だけ[渡/わた]す
//:
//: [契約/けいやく]:
//: - preflight が[失敗/しっぱい]した場合は host import を[呼/よ]びません。
//: - preflight success action に[対応/たいおう]する import だけを 1 [回/かい]呼びます。
//: - host status と F5fo ledger の最終[照合/しょうごう]が[成功/せいこう]した場合だけ state を[進/すす]めます。
pub fn gui_bare_display_driver_host_import_step %impure fn GuiBareDisplayDriverState impure fn GuiBareDisplayMemoryStepApplied Result GuiBareDisplayDriverStepApplied GuiBareDisplayDriverStepError \state\memory_step:
    match gui_bare_display_driver_host_import_preflight state memory_step:
        Result::Err preflight_error:
            Result::Err preflight_error
        Result::Ok preview:
            let action %GuiBareDisplayMemoryAction gui_bare_display_driver_step_applied_action &preview
            let status %i32 gui_bare_display_driver_host_import_call action
            let outcome %GuiBareDisplayDriverOutcome gui_bare_display_driver_host_import_status_outcome action status
            gui_bare_display_driver_apply state memory_step outcome
