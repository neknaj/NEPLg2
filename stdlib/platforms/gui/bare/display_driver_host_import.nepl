    let target_kind %i32 gui_bare_display_driver_host_import_target_kind target
    let window_raw %i32 gui_bare_display_driver_host_import_window_raw target
    let x %i32 gui_rgba8888_row_tile_rle_present_run_row_span_x &span
    let y %i32 gui_rgba8888_row_tile_rle_present_run_row_span_y &span
    let width %i32 gui_rgba8888_row_tile_rle_present_run_row_span_width &span
    let height %i32 gui_rgba8888_row_tile_rle_present_run_row_span_height &span
