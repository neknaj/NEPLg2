    let target_kind %i32 gui_bare_display_driver_host_import_target_kind target
    let window_raw %i32 gui_bare_display_driver_host_import_window_raw target
    let surface %SurfaceId gui_rgba8888_row_tile_rle_present_descriptor_surface &descriptor
    let frame %FrameId gui_rgba8888_row_tile_rle_present_descriptor_frame &descriptor
    let packet %GuiRgba8888RowTileRlePacketDescriptor gui_rgba8888_row_tile_rle_present_descriptor_packet &descriptor
    let surface_raw %i32 surface_id_raw &surface
    let frame_raw %i32 frame_id_raw &frame
    let packet_frame_id %i32 gui_rgba8888_row_tile_rle_packet_descriptor_frame_id &packet
    let batch_index %i32 gui_rgba8888_row_tile_rle_packet_descriptor_batch_index &packet
    let tile_index %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_index &packet
    let plan_row_start %i32 gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_start &packet
    let plan_row_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count &packet
    let row_start %i32 gui_rgba8888_row_tile_rle_packet_descriptor_row_start &packet
    let row_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_row_count &packet
    let width %i32 gui_rgba8888_row_tile_rle_packet_descriptor_width &packet
    let height %i32 gui_rgba8888_row_tile_rle_packet_descriptor_height &packet
    let stride_bytes %i32 gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes &packet
    let tile_rows %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows &packet
    let tile_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_count &packet
    let pixel_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_pixel_count &packet
    let total_run_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_total_run_count &packet
    let encoded_byte_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_encoded_byte_count &packet
    gui_bare_display_driver_begin_raw target_kind window_raw surface_raw frame_raw packet_frame_id batch_index tile_index plan_row_start plan_row_count row_start row_count width height stride_bytes tile_rows tile_count pixel_count total_run_count encoded_byte_count surface_byte_count

fn gui_bare_display_driver_host_import_span_write %impure fn GuiBareDisplayMemorySpanWritePlan i32 \plan:
    let target %GuiRgba8888RowTileRlePresentHostSpanOperationTarget gui_bare_display_memory_span_write_plan_target &plan
    let span %GuiRgba8888RowTileRlePresentRunRowSpan gui_bare_display_memory_span_write_plan_span &plan
