fn gui_bare_scheduler_real_loop_runner_from_completed %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverCompleted fn i32 Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \clock_state\owner\completed\step_count:
    let payload %GuiBareSchedulerRealLoopRunnerCompleted gui_bare_scheduler_real_loop_runner_completed_new clock_state owner completed step_count
    Result::Ok GuiBareSchedulerRealLoopRunnerResult::Completed payload

fn gui_bare_scheduler_real_loop_runner_budget_exhausted_result %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverNeedInput fn i32 Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \clock_state\owner\need\step_count:
    let payload %GuiBareSchedulerRealLoopRunnerBudgetExhausted gui_bare_scheduler_real_loop_runner_budget_exhausted_new clock_state owner need step_count
    Result::Ok GuiBareSchedulerRealLoopRunnerResult::BudgetExhausted payload

fn gui_bare_scheduler_real_loop_runner_drain_remaining %impure fn &GuiBareSchedulerRealLoopRunnerPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiBareDisplayMemoryOwner impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult impure fn i32 impure fn i32 Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \policy\clock_state\owner\driver_result\remaining_count\step_count:
    match driver_result:
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult::Completed completed:
            gui_bare_scheduler_real_loop_runner_from_completed clock_state owner completed step_count
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult::NeedInput need:
            if le remaining_count 0:
                then gui_bare_scheduler_real_loop_runner_budget_exhausted_result clock_state owner need step_count
                else:
                    let step_policy %&GuiBareSchedulerRealLoopStepPolicy gui_bare_scheduler_real_loop_runner_policy_step_policy_ref policy
                    match gui_bare_scheduler_real_loop_step step_policy clock_state owner need:
                        Result::Err lower:
                            gui_bare_scheduler_real_loop_runner_step_failed_result clock_state lower
                        Result::Ok ready:
                            let next_clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState gui_bare_scheduler_real_loop_step_ready_clock_state &ready
                            let next_owner %GuiBareDisplayMemoryOwner gui_bare_scheduler_real_loop_step_ready_owner ready
                            let next_driver_result %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult gui_bare_scheduler_real_loop_step_ready_driver_result ready
                            let next_remaining_count %i32 sub remaining_count 1
                            let next_step_count %i32 add step_count 1
                            gui_bare_scheduler_real_loop_runner_drain_remaining policy next_clock_state next_owner next_driver_result next_remaining_count next_step_count

//: gui_bare_scheduler_real_loop_runner_run: bare real-loop を bounded に[実行/じっこう]する
//:
//: [契約/けいやく]:
//: - policy は F5el start の[前/まえ]に[再検査/さいけんさ]します。
//: - F5el start は valid policy で 1 [回/かい]だけ[呼/よ]び、owner を[消費/しょうひ]しません。
//: - F5ga step は `NeedInput` かつ remaining budget が positive の[場合/ばあい]だけ[呼/よ]びます。
pub fn gui_bare_scheduler_real_loop_runner_run %impure fn &GuiBareSchedulerRealLoopRunnerPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiBareDisplayMemoryOwner impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerState Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \policy\clock_state\owner\state:
    let max_step_count %i32 gui_bare_scheduler_real_loop_runner_policy_max_step_count policy
    match gui_bare_scheduler_real_loop_runner_validate_max_step_count max_step_count:
        Result::Err kind:
            gui_bare_scheduler_real_loop_runner_policy_invalid_result kind clock_state owner state
        Result::Ok count:
            let step_policy %&GuiBareSchedulerRealLoopStepPolicy gui_bare_scheduler_real_loop_runner_policy_step_policy_ref policy
            let driver_policy %&GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverPolicy gui_bare_scheduler_real_loop_step_policy_driver_policy_ref step_policy
            match gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_real_loop_driver_start driver_policy state:
                Result::Err lower:
                    gui_bare_scheduler_real_loop_runner_start_failed_result clock_state owner lower
                Result::Ok driver_result:
                    gui_bare_scheduler_real_loop_runner_drain_remaining policy clock_state owner driver_result count 0

