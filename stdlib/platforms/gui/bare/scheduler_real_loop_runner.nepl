#import "std/gui/tile_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_real_loop_driver" as *

pub struct GuiBareSchedulerRealLoopRunnerPolicy:
    step_policy %GuiBareSchedulerRealLoopStepPolicy
    max_step_count %i32

pub enum GuiBareSchedulerRealLoopRunnerPolicyErrorKind:
    MaxStepCountInvalid

impl Clone for GuiBareSchedulerRealLoopRunnerPolicyErrorKind:
    fn clone %fn &GuiBareSchedulerRealLoopRunnerPolicyErrorKind GuiBareSchedulerRealLoopRunnerPolicyErrorKind \kind:
        *kind

impl Copy for GuiBareSchedulerRealLoopRunnerPolicyErrorKind:
    fn copy_mark %fn GuiBareSchedulerRealLoopRunnerPolicyErrorKind GuiBareSchedulerRealLoopRunnerPolicyErrorKind \kind:
        kind

pub struct GuiBareSchedulerRealLoopRunnerBudgetExhausted:
    clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState
    owner %GuiBareDisplayMemoryOwner
    need %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverNeedInput
    step_count %i32

pub struct GuiBareSchedulerRealLoopRunnerCompleted:
    clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState
    owner %GuiBareDisplayMemoryOwner
    completed %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverCompleted
    step_count %i32

pub enum GuiBareSchedulerRealLoopRunnerResult:
    BudgetExhausted %GuiBareSchedulerRealLoopRunnerBudgetExhausted
    Completed %GuiBareSchedulerRealLoopRunnerCompleted

pub struct GuiBareSchedulerRealLoopRunnerPolicyInvalid:
    kind %GuiBareSchedulerRealLoopRunnerPolicyErrorKind
    category %Option GuiError
    clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState
    owner %GuiBareDisplayMemoryOwner
    state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerState

pub struct GuiBareSchedulerRealLoopRunnerStartFailed:
    clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState
    owner %GuiBareDisplayMemoryOwner
    lower %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverError

pub struct GuiBareSchedulerRealLoopRunnerStepFailed:
    clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState
    lower %GuiBareSchedulerRealLoopStepError

pub enum GuiBareSchedulerRealLoopRunnerError:
    PolicyInvalid %GuiBareSchedulerRealLoopRunnerPolicyInvalid
    StartFailed %GuiBareSchedulerRealLoopRunnerStartFailed
    StepFailed %GuiBareSchedulerRealLoopRunnerStepFailed

fn gui_bare_scheduler_real_loop_runner_policy_new %fn GuiBareSchedulerRealLoopStepPolicy fn i32 GuiBareSchedulerRealLoopRunnerPolicy \step_policy\max_step_count:
    GuiBareSchedulerRealLoopRunnerPolicy step_policy max_step_count

fn gui_bare_scheduler_real_loop_runner_validate_max_step_count %fn i32 Result i32 GuiBareSchedulerRealLoopRunnerPolicyErrorKind \max_step_count:
    if lt max_step_count 0:
        then Result::Err GuiBareSchedulerRealLoopRunnerPolicyErrorKind::MaxStepCountInvalid
        else Result::Ok max_step_count

fn gui_bare_scheduler_real_loop_runner_policy_error_kind_category %fn GuiBareSchedulerRealLoopRunnerPolicyErrorKind Option GuiError \kind:
    match kind:
        GuiBareSchedulerRealLoopRunnerPolicyErrorKind::MaxStepCountInvalid:
            Option::Some GuiError::InvalidCommand

pub fn gui_bare_scheduler_real_loop_runner_policy %fn GuiBareSchedulerRealLoopStepPolicy fn i32 Result GuiBareSchedulerRealLoopRunnerPolicy GuiBareSchedulerRealLoopRunnerPolicyErrorKind \step_policy\max_step_count:
    match gui_bare_scheduler_real_loop_runner_validate_max_step_count max_step_count:
        Result::Err kind:
            Result::Err kind
        Result::Ok count:
            Result::Ok gui_bare_scheduler_real_loop_runner_policy_new step_policy count

pub fn gui_bare_scheduler_real_loop_runner_policy_step_policy_ref %fn &GuiBareSchedulerRealLoopRunnerPolicy &GuiBareSchedulerRealLoopStepPolicy \policy:
    field::get_ref policy "step_policy"

pub fn gui_bare_scheduler_real_loop_runner_policy_max_step_count %fn &GuiBareSchedulerRealLoopRunnerPolicy i32 \policy:
    *field::get_ref policy "max_step_count"

fn gui_bare_scheduler_real_loop_runner_budget_exhausted_new %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverNeedInput fn i32 GuiBareSchedulerRealLoopRunnerBudgetExhausted \clock_state\owner\need\step_count:
    GuiBareSchedulerRealLoopRunnerBudgetExhausted clock_state owner need step_count

fn gui_bare_scheduler_real_loop_runner_completed_new %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverCompleted fn i32 GuiBareSchedulerRealLoopRunnerCompleted \clock_state\owner\completed\step_count:
    GuiBareSchedulerRealLoopRunnerCompleted clock_state owner completed step_count

fn gui_bare_scheduler_real_loop_runner_policy_invalid_new %fn GuiBareSchedulerRealLoopRunnerPolicyErrorKind fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerState GuiBareSchedulerRealLoopRunnerPolicyInvalid \kind\clock_state\owner\state:
    let category %Option GuiError gui_bare_scheduler_real_loop_runner_policy_error_kind_category kind
    GuiBareSchedulerRealLoopRunnerPolicyInvalid kind category clock_state owner state

fn gui_bare_scheduler_real_loop_runner_start_failed_new %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverError GuiBareSchedulerRealLoopRunnerStartFailed \clock_state\owner\lower:
    GuiBareSchedulerRealLoopRunnerStartFailed clock_state owner lower

fn gui_bare_scheduler_real_loop_runner_step_failed_new %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareSchedulerRealLoopStepError GuiBareSchedulerRealLoopRunnerStepFailed \clock_state\lower:
    GuiBareSchedulerRealLoopRunnerStepFailed clock_state lower

fn gui_bare_scheduler_real_loop_runner_policy_invalid_result %fn GuiBareSchedulerRealLoopRunnerPolicyErrorKind fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerState Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \kind\clock_state\owner\state:
    let failed %GuiBareSchedulerRealLoopRunnerPolicyInvalid gui_bare_scheduler_real_loop_runner_policy_invalid_new kind clock_state owner state
    Result::Err GuiBareSchedulerRealLoopRunnerError::PolicyInvalid failed

fn gui_bare_scheduler_real_loop_runner_start_failed_result %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareDisplayMemoryOwner fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverError Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \clock_state\owner\lower:
    let failed %GuiBareSchedulerRealLoopRunnerStartFailed gui_bare_scheduler_real_loop_runner_start_failed_new clock_state owner lower
    Result::Err GuiBareSchedulerRealLoopRunnerError::StartFailed failed

fn gui_bare_scheduler_real_loop_runner_step_failed_result %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiBareSchedulerRealLoopStepError Result GuiBareSchedulerRealLoopRunnerResult GuiBareSchedulerRealLoopRunnerError \clock_state\lower:
