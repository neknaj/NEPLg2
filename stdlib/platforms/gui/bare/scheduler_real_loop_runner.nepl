pub fn gui_bare_scheduler_real_loop_runner_error_owner %fn GuiBareSchedulerRealLoopRunnerError GuiBareDisplayMemoryOwner \error:
    match error:
        GuiBareSchedulerRealLoopRunnerError::PolicyInvalid failure:
            gui_bare_scheduler_real_loop_runner_policy_invalid_owner failure
        GuiBareSchedulerRealLoopRunnerError::StartFailed failure:
            gui_bare_scheduler_real_loop_runner_start_failed_owner failure
        GuiBareSchedulerRealLoopRunnerError::StepFailed failure:
            gui_bare_scheduler_real_loop_runner_step_failed_owner failure

