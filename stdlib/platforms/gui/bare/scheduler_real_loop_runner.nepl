//: # platforms/gui/bare/scheduler_real_loop_runner
//: Bare scheduler bounded real-loop runner boundary
//:
//: ### [目的/もくてき]
//: - F5gb Bare scheduler bounded real-loop runner boundary として、F5el start から F5ga 1 action step を bounded に[繰/く]り[返/かえ]します。
//: - `GuiBareDisplayMemoryOwner` を runner result / error から[回収/かいしゅう]できる形で、bare real backend loop checkpoint を[作/つく]ります。
//:
//: ### [契約/けいやく]
//: - policy は bare F5ga real-loop step policy と `max_step_count` だけを[保持/ほじ]します。
//: - F5el driver policy は F5ga policy accessor から[借用/しゃくよう]し、runner policy へ[重複/ちょうふく]して[保持/ほじ]しません。
//: - `max_step_count < 0` は typed `PolicyInvalid` であり、start も step も[呼/よ]ばず original owner を[返/かえ]します。
//: - `max_step_count == 0` でも F5el start は 1 [回/かい]だけ[呼/よ]びます。start が `NeedInput` を[返/かえ]した[場合/ばあい]は step を[呼/よ]ばず `BudgetExhausted` を[返/かえ]します。
//: - F5ga step failure は `gui_bare_scheduler_real_loop_step_error_owner` で owner を[回収/かいしゅう]でき、runner level の error owner accessor でも同じ owner を[返/かえ]します。
//: - queue、sleep、timer wait、direct host import、present loop、DOM、Canvas、minifb、video memory、fallback、silent no-op、explicit input の[捏造/ねつぞう]は[扱/あつか]いません。
//:
//: neplg2:test[stdio]
//: stdout: ""
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #indent 4
//:|
//:| #import "platforms/gui/bare/scheduler_real_loop_runner" as *
//:|
//:| fn main %impure fn void i32 \void:
//:|      0
//: ```

#indent 4

#import "core/field" as field
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
