                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileCountInvalid:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileCountOverflow:
