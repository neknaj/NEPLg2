fn gui_bare_framebuffer_error_category %fn GuiBareFramebufferErrorKind Option GuiError \kind:
    match kind:
        GuiBareFramebufferErrorKind::SurfaceIdInvalid:
            Option::Some GuiError::InvalidCommand
        GuiBareFramebufferErrorKind::WidthInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiBareFramebufferErrorKind::HeightInvalid:
            Option::Some GuiError::InvalidGeometry
        GuiBareFramebufferErrorKind::StrideOverflow:
