        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowBegin payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_begin_window &payload
            let descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_host_span_operation_window_begin_descriptor &payload
            gui_bare_framebuffer_validate_begin state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window window descriptor operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowRunSpan payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_run_span_window &payload
            let span %GuiRgba8888RowTileRlePresentRunRowSpan gui_rgba8888_row_tile_rle_present_host_span_operation_window_run_span_span &payload
            gui_bare_framebuffer_validate_run state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window window span operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowEnd payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_end_window &payload
            let descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_host_span_operation_window_end_descriptor &payload
            gui_bare_framebuffer_validate_end state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Window window descriptor operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenBegin descriptor:
            gui_bare_framebuffer_validate_begin state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen descriptor operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenRunSpan span:
            gui_bare_framebuffer_validate_run state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen span operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenEnd descriptor:
            gui_bare_framebuffer_validate_end state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Offscreen descriptor operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceBegin descriptor:
            gui_bare_framebuffer_validate_begin state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device descriptor operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceRunSpan span:
            gui_bare_framebuffer_validate_run state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device span operation
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceEnd descriptor:
            gui_bare_framebuffer_validate_end state GuiRgba8888RowTileRlePresentHostSpanOperationTarget::Device descriptor operation

//: gui_bare_framebuffer_execute_operation: validation [成功/せいこう]後だけ F5fk host executor を[呼/よ]ぶ
//:
//: [契約/けいやく]:
//: - validation failure では host executor を[呼/よ]びません。
//: - host executor failure では advanced state を[採用/さいよう]せず、original state と operation を error に[保持/ほじ]します。
pub fn gui_bare_framebuffer_execute_operation %impure fn GuiBareFramebufferState impure fn GuiRgba8888RowTileRlePresentHostSpanOperation Result GuiBareFramebufferStepApplied GuiBareFramebufferStepError \state\operation:
    match gui_bare_framebuffer_validate_operation state operation:
        Result::Err error:
            Result::Err error
        Result::Ok applied:
            match gui_bare_scheduler_host_executor_execute_operation operation:
                Result::Err host_error:
                    Result::Err gui_bare_framebuffer_step_error GuiBareFramebufferErrorKind::HostExecutionFailed host_error state operation
                Result::Ok host_execution_done:
                    Result::Ok applied
