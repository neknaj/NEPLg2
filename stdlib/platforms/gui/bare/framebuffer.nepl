            if le height 0:
                then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::HeightInvalid
                else:
                    let plan_row_start %i32 gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_start packet
                    if lt plan_row_start 0:
                        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowStartInvalid
                        else:
                            let plan_row_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_plan_row_count packet
                            if le plan_row_count 0:
                                then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowCountInvalid
                                else:
                                    let row_start %i32 gui_rgba8888_row_tile_rle_packet_descriptor_row_start packet
                                    if lt row_start 0:
                                        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::RowStartInvalid
                                        else:
                                            let row_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_row_count packet
                                            if le row_count 0:
                                                then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::RowCountInvalid
                                                else:
                                                    let stride_bytes %i32 gui_rgba8888_row_tile_rle_packet_descriptor_stride_bytes packet
                                                    if le stride_bytes 0:
                                                        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::StrideInvalid
                                                        else Result::Ok unit

fn gui_bare_framebuffer_descriptor_validate_positive_counts %fn &GuiRgba8888RowTileRlePacketDescriptor Result unit GuiBareFramebufferErrorKind \packet:
    let tile_rows %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_rows packet
    if le tile_rows 0:
        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileRowsInvalid
        else:
            let tile_count %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_count packet
            if le tile_count 0:
                then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileCountInvalid
                else:
                    let tile_index %i32 gui_rgba8888_row_tile_rle_packet_descriptor_tile_index packet
                    if lt tile_index 0:
                        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileIndexInvalid
                        else:
