            Option::Some GuiError::InvalidCommand
        GuiBareFramebufferErrorKind::TargetMismatch:
            Option::Some GuiError::InvalidCommand
        GuiBareFramebufferErrorKind::DescriptorInvalid lower:
            match lower:
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::SurfaceIdInvalid:
                    Option::Some GuiError::InvalidCommand
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::FrameIdInvalid:
                    Option::Some GuiError::InvalidCommand
