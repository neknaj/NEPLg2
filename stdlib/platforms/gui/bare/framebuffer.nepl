                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileIndexOutOfBounds:
                    Option::Some GuiError::InvalidCommand
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::WidthInvalid:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::HeightInvalid:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowStartInvalid:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowCountInvalid:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowExtentOverflow:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowExtentOutOfBounds:
                    Option::Some GuiError::InvalidGeometry
                GuiRgba8888RowTileRlePresentFramePrepareErrorKind::RowStartInvalid:
