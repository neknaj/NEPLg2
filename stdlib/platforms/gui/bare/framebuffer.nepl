fn gui_bare_framebuffer_step_error %fn GuiBareFramebufferErrorKind fn GuiBareFramebufferState fn GuiRgba8888RowTileRlePresentHostSpanOperation GuiBareFramebufferStepError \kind\state\operation:
    let category %Option GuiError gui_bare_framebuffer_error_category kind
    GuiBareFramebufferStepError kind category state operation

fn gui_bare_framebuffer_checked_add %fn i32 fn i32 fn GuiBareFramebufferErrorKind Result i32 GuiBareFramebufferErrorKind \base\delta\overflow_kind:
    if or lt base 0 lt delta 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 2147483647
            let max_base %i32 sub max_i32 delta
            if gt base max_base:
                then Result::Err overflow_kind
                else Result::Ok add base delta

fn gui_bare_framebuffer_checked_mul %fn i32 fn i32 fn GuiBareFramebufferErrorKind Result i32 GuiBareFramebufferErrorKind \left\right\overflow_kind:
    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

pub fn gui_bare_framebuffer_config_checked %fn SurfaceId fn i32 fn i32 Result GuiBareFramebufferConfig GuiBareFramebufferErrorKind \surface\width\height:
    let surface_raw %i32 surface_id_raw &surface
    if le surface_raw 0:
        then Result::Err GuiBareFramebufferErrorKind::SurfaceIdInvalid
        else:
            if le width 0:
                then Result::Err GuiBareFramebufferErrorKind::WidthInvalid
                else:
                    if le height 0:
                        then Result::Err GuiBareFramebufferErrorKind::HeightInvalid
                        else:
                            match gui_bare_framebuffer_checked_mul width 4 GuiBareFramebufferErrorKind::StrideOverflow:
                                Result::Err kind:
                                    Result::Err kind
                                Result::Ok stride_bytes:
                                    Result::Ok gui_bare_framebuffer_config_new surface width height stride_bytes

