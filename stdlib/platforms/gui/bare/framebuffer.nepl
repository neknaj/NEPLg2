    if or lt left 0 lt right 0:
        then Result::Err overflow_kind
        else:
            if or eq left 0 eq right 0:
                then Result::Ok 0
                else:
                    let max_i32 %i32 2147483647
                    let max_left %i32 div_s max_i32 right
                    if gt left max_left:
                        then Result::Err overflow_kind
                        else Result::Ok mul left right

fn gui_bare_framebuffer_present_checked_add %fn i32 fn i32 fn GuiRgba8888RowTileRlePresentFramePrepareErrorKind Result i32 GuiRgba8888RowTileRlePresentFramePrepareErrorKind \base\delta\overflow_kind:
    if or lt base 0 lt delta 0:
        then Result::Err overflow_kind
        else:
            let max_i32 %i32 2147483647
