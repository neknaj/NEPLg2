fn gui_bare_framebuffer_present_tile_count_checked %fn i32 fn i32 Result i32 GuiRgba8888RowTileRlePresentFramePrepareErrorKind \plan_row_count\tile_rows:
    if le plan_row_count 0:
        then Result::Err GuiRgba8888RowTileRlePresentFramePrepareErrorKind::PlanRowCountInvalid
        else:
            if le tile_rows 0:
                then Result::Err GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileRowsInvalid
                else:
                    let quotient %i32 div_s plan_row_count tile_rows
                    let remainder %i32 rem_s plan_row_count tile_rows
                    let tile_count %i32 if eq remainder 0 quotient add quotient 1
                    if le tile_count 0:
                        then Result::Err GuiRgba8888RowTileRlePresentFramePrepareErrorKind::TileCountOverflow
                        else Result::Ok tile_count

fn gui_bare_framebuffer_descriptor_validate_surface_frame %fn &GuiRgba8888RowTileRlePresentDescriptor fn &GuiRgba8888RowTileRlePacketDescriptor Result unit GuiBareFramebufferErrorKind \descriptor\packet:
    let surface %SurfaceId gui_rgba8888_row_tile_rle_present_descriptor_surface descriptor
    let surface_raw %i32 surface_id_raw &surface
    if le surface_raw 0:
        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::SurfaceIdInvalid
        else:
            let frame %FrameId gui_rgba8888_row_tile_rle_present_descriptor_frame descriptor
            let frame_raw %i32 frame_id_raw &frame
            if le frame_raw 0:
                then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::FrameIdInvalid
                else:
                    let packet_frame_id %i32 gui_rgba8888_row_tile_rle_packet_descriptor_frame_id packet
                    if ne packet_frame_id frame_raw:
                        then Result::Err gui_bare_framebuffer_descriptor_error GuiRgba8888RowTileRlePresentFramePrepareErrorKind::FrameIdMismatch
                        else Result::Ok unit

fn gui_bare_framebuffer_descriptor_validate_positive_shape %fn &GuiRgba8888RowTileRlePacketDescriptor Result unit GuiBareFramebufferErrorKind \packet:
    let width %i32 gui_rgba8888_row_tile_rle_packet_descriptor_width packet
    if le width 0:
