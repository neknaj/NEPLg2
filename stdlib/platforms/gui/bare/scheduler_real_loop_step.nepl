//: gui_bare_scheduler_real_loop_step: bare backend action を 1 step [進/すす]める
//:
//: [契約/けいやく]:
//: - F5el `NeedInput` の action variant を wildcard なしで[網羅/もうら]します。
//: - clock branch は clock helper success payload から[取/と]り[出/だ]した action / input だけを F5ek へ[渡/わた]します。
//: - execute branch は F5fy presenter input path から owner を[回収/かいしゅう]してから F5ew へ[渡/わた]します。
//: - F5ek success 後は F5el after-step を 1 [回/かい]だけ[呼/よ]びます。
pub fn gui_bare_scheduler_real_loop_step %impure fn &GuiBareSchedulerRealLoopStepPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiBareDisplayMemoryOwner impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverNeedInput Result GuiBareSchedulerRealLoopStepReady GuiBareSchedulerRealLoopStepError \policy\clock_state\owner\need:
    let action %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopAction gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_real_loop_driver_need_input_action need
    match action:
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopAction::YieldToClock yield_action:
            gui_bare_scheduler_real_loop_step_yield policy clock_state owner yield_action
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopAction::AwaitTimerAdvance timer_action:
            gui_bare_scheduler_real_loop_step_timer policy clock_state owner timer_action
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopAction::ExecuteHostAction execute_action:
            gui_bare_scheduler_real_loop_step_execute policy clock_state owner execute_action
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopAction::Complete complete_action:
            gui_bare_scheduler_real_loop_step_complete policy clock_state owner complete_action

