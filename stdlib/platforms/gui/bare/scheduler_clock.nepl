pub fn gui_bare_scheduler_clock_tick_backend_clock_failed_lower %fn GuiBareSchedulerClockTickBackendClockFailed GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockError \failure:
