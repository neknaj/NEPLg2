pub fn gui_bare_scheduler_clock_start_backend_clock_failed_policy %fn GuiBareSchedulerClockStartBackendClockFailed GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockPolicy \failure:
    field::get failure "policy"

pub fn gui_bare_scheduler_clock_start_backend_clock_failed_lower %fn GuiBareSchedulerClockStartBackendClockFailed GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockError \failure:
    field::get failure "lower"

