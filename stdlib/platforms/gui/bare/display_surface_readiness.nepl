    frame_id %i32
    batch_index %i32
    width %i32
    height %i32
    stride_bytes %i32
    tile_rows %i32
    tile_count %i32
    expected_pixel_count %i32
    ready_pixel_count %i32
    surface_byte_count %i32

impl Clone for GuiBareDisplayWholeSurfacePacketReadinessEvidence:
    fn clone %fn &GuiBareDisplayWholeSurfacePacketReadinessEvidence GuiBareDisplayWholeSurfacePacketReadinessEvidence \evidence:
        *evidence

impl Copy for GuiBareDisplayWholeSurfacePacketReadinessEvidence:
    fn copy_mark %fn GuiBareDisplayWholeSurfacePacketReadinessEvidence GuiBareDisplayWholeSurfacePacketReadinessEvidence \evidence:
        evidence

