    previous_category %Option GuiError
    previous_diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic
    spent_budget %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget
    step %GuiRgba8888CompositorTileRlePresentCommandCursorStep
    completion %GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionCompletion

