//: # Web registered Run next command connector test
//: actual Continue/Yieldから次EndFrameへ進み、slice reset差とcleanupを検証します。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "platforms/gui/web/font_registered_run_executor_test" as fixture with tests
#import "platforms/gui/web/font_registered_run_next_command" as *
#import "platforms/gui/web/font_registered_run_success_phase" as *
#import "std/gui/compositor_tile_present_command_cursor" as *
#import "std/gui/compositor_tile_present_dispatch" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
#import "std/gui/compositor_tile_present_schedule" as *

fn gui_font_web_registered_run_next_command_test_state %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState fn i32 fn i32 bool \state\commands\pixels:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    and eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule commands eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule pixels

fn gui_font_web_registered_run_next_command_test_finish %fn GuiFontWebRegisteredRunNextCommandOwner fn i32 fn i32 fn i32 i32 \owner\commands\pixels\evidence:
    match gui_font_web_registered_run_next_command_owner_into_phase owner:
        GuiFontWebRegisteredRunNextCommandPhaseOwner::BeginFrame phase:
            match gui_font_web_registered_run_next_command_phase_begin_frame_owner_free phase:
                Result::Err _: sub 0 1
                Result::Ok _: 0
        GuiFontWebRegisteredRunNextCommandPhaseOwner::Run phase:
            match gui_font_web_registered_run_next_command_phase_run_owner_free phase:
                Result::Err _: sub 0 1
                Result::Ok _: 0
        GuiFontWebRegisteredRunNextCommandPhaseOwner::EndFrame phase:
            let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_web_registered_run_next_command_phase_end_frame_owner_state &phase
            let state_ok %bool gui_font_web_registered_run_next_command_test_state &state commands pixels
            let command_ok %bool match gui_font_web_registered_run_next_command_phase_end_frame_owner_result &phase:
                GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
                    match command:
                        GuiRgba8888CompositorTileRlePresentCommand::EndFrame _: true
                        _: false
                _: false
            match gui_font_web_registered_run_next_command_phase_end_frame_owner_free phase:
                Result::Err _: sub 0 1
                Result::Ok _: if and state_ok command_ok then evidence else 0
        GuiFontWebRegisteredRunNextCommandPhaseOwner::Completed phase:
            match gui_font_web_registered_run_next_command_phase_completed_owner_free phase:
                Result::Err _: sub 0 1
                Result::Ok _: 0

fn gui_font_web_registered_run_next_command_test_continue %impure fn unit i32 \_unit:
    match fixture::gui_font_web_registered_run_executor_test_success_owner _unit 2 32:
        Result::Err _: 0
        Result::Ok success:
            match gui_font_web_registered_run_execution_success_into_phase success:
                GuiFontWebRegisteredRunSuccessPhaseOwner::Continue owner:
                    match gui_font_web_registered_run_success_continue_step_next_command owner:
                        Result::Err error:
                            match gui_font_web_registered_run_next_command_error_free error:
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        Result::Ok next: gui_font_web_registered_run_next_command_test_finish next 1 16 1
                GuiFontWebRegisteredRunSuccessPhaseOwner::Yield owner:
                    match gui_font_web_registered_run_success_phase_yield_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                GuiFontWebRegisteredRunSuccessPhaseOwner::Completed owner:
                    match gui_font_web_registered_run_success_phase_completed_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0

fn gui_font_web_registered_run_next_command_test_yield %impure fn unit i32 \_unit:
    match fixture::gui_font_web_registered_run_executor_test_success_owner _unit 1 32:
        Result::Err _: 0
        Result::Ok success:
            match gui_font_web_registered_run_execution_success_into_phase success:
                GuiFontWebRegisteredRunSuccessPhaseOwner::Continue owner:
                    match gui_font_web_registered_run_success_phase_continue_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                GuiFontWebRegisteredRunSuccessPhaseOwner::Yield owner:
                    match gui_font_web_registered_run_success_yield_resume_and_step_next_command owner:
                        Result::Err error:
                            match gui_font_web_registered_run_next_command_error_free error:
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        Result::Ok next: gui_font_web_registered_run_next_command_test_finish next 0 0 2
                GuiFontWebRegisteredRunSuccessPhaseOwner::Completed owner:
                    match gui_font_web_registered_run_success_phase_completed_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0

#test
pub fn gui_font_web_registered_run_next_command_test_contract %impure fn unit i32 \_unit:
    add gui_font_web_registered_run_next_command_test_continue _unit gui_font_web_registered_run_next_command_test_yield _unit
