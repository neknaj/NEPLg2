//: # platforms/gui/web/input
//: Web Playground GUI input host boundary
//:
//: ### [目的/もくてき]
//: - Web Playground host が保持する GUI event queue から、NEPLg2 app が typed GUI event を[取/と]り[出/だ]します。
//: - raw host import はこの module に閉じ、application code には `Result Option GuiWebEvent GuiError` として公開します。
//: - action-only caller のため、互換 wrapper として `Result Option ActionId GuiError` も維持します。
//:
//: ### [契約/けいやく]
//: - typed event がある場合は `Result::Ok (Option::Some event)` を返します。
//: - action-only wrapper は互換 API として `Result::Ok (Option::Some action)` を返します。
//: - timeout または empty queue の場合は `Result::Ok Option::None` を返します。
//: - host が GUI input queue を持たない場合は `Result::Err GuiError::Unsupported` を返します。
//: - invalid queue record は `Result::Err GuiError::InvalidCommand` を返します。
//: - raw host import の 0 / 負 sentinel はこの module の境界内でだけ扱います。
//:
//: ### [現状/げんじょう]
//: - Phase 3 では Web Playground の action、pointer、keyboard、text input、window、timer event を扱い、window id と pointer position milli-unit を `GuiWebEvent` に保持します。
//: - Web backend は pointer move と連続 timer tick を SharedArrayBuffer publish 前の backend 境界で順序保存 coalescing できます。IME composition、lifecycle などの full event union は後続 phase で追加します。
//:
//: neplg2:test[skip]
//: ```neplg2
//:| #target std
//:| #import "platforms/gui/web" as *
//: ```

#indent 4

#import "alloc/gui/app" as app
#import "core/char" as *
#import "core/field" as field
#import "core/gui" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "std/gui/window" as *

#extern "nepl_gui_web" "poll_action_id" fn gui_web_poll_action_id_raw %impure fn void i32
#extern "nepl_gui_web" "wait_action_id" fn gui_web_wait_action_id_raw %impure fn i32 i32
#extern "nepl_gui_web" "poll_event_kind" fn gui_web_poll_event_kind_raw %impure fn void i32
#extern "nepl_gui_web" "wait_event_kind" fn gui_web_wait_event_kind_raw %impure fn i32 i32
#extern "nepl_gui_web" "last_event_window_id" fn gui_web_last_event_window_id_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_action_id" fn gui_web_last_event_action_id_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_point_x_milli" fn gui_web_last_event_point_x_milli_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_point_y_milli" fn gui_web_last_event_point_y_milli_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_pointer_kind" fn gui_web_last_event_pointer_kind_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_pointer_id" fn gui_web_last_event_pointer_id_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_pointer_button" fn gui_web_last_event_pointer_button_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_keyboard_kind" fn gui_web_last_event_keyboard_kind_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_key_code" fn gui_web_last_event_key_code_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_key_modifiers" fn gui_web_last_event_key_modifiers_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_text_scalar_value" fn gui_web_last_event_text_scalar_value_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_window_kind" fn gui_web_last_event_window_kind_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_window_width" fn gui_web_last_event_window_width_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_window_height" fn gui_web_last_event_window_height_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_timer_id" fn gui_web_last_event_timer_id_raw %impure fn void i32
#extern "nepl_gui_web" "last_event_timer_tick" fn gui_web_last_event_timer_tick_raw %impure fn void i32

//: GuiWebEvent: Web backend が[取/と]り[出/だ]した typed GUI event record
//:
//: [目的/もくてき]:
//: - `GuiEvent` と backend-local routing metadata を 1 つの値として[渡/わた]します。
//: - window id と pointer position は Web Playground backend の queue record から来る値であり、core/gui の public event identity にはしません。
//:
//: [現状/げんじょう]:
//: - point は milli-unit の整数です。formal host ABI では logical / physical unit の契約へ移します。
pub struct GuiWebEvent:
    window_id %WindowId
    point_milli %GuiPoint
    event %GuiEvent

impl Clone for GuiWebEvent:
    fn clone %fn &GuiWebEvent GuiWebEvent \event:
        *event

impl Copy for GuiWebEvent:
    fn copy_mark %fn GuiWebEvent GuiWebEvent \event:
        event

//: gui_web_event_window_id: Web event の window id を[読/よ]む
pub fn gui_web_event_window_id %fn &GuiWebEvent WindowId \event:
    *field::get_ref event "window_id"

//: gui_web_event_point_milli: Web event の pointer position milli-unit を[読/よ]む
pub fn gui_web_event_point_milli %fn &GuiWebEvent GuiPoint \event:
    *field::get_ref event "point_milli"

//: gui_web_event_gui_event: Web event が[包/つつ]む `GuiEvent` を[読/よ]む
pub fn gui_web_event_gui_event %fn &GuiWebEvent GuiEvent \event:
    *field::get_ref event "event"

//: gui_web_event_action: action event なら `ActionId` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::Action` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_action %fn &GuiWebEvent Option ActionId \event:
    match gui_web_event_gui_event event:
        GuiEvent::Action action:
            Option::Some action
        _:
            Option::None

//: gui_web_event_pointer: pointer event なら `PointerEvent` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::Pointer` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_pointer %fn &GuiWebEvent Option PointerEvent \event:
    match gui_web_event_gui_event event:
        GuiEvent::Pointer pointer:
            Option::Some pointer
        _:
            Option::None

//: gui_web_event_keyboard: keyboard event なら `KeyboardEvent` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::Keyboard` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_keyboard %fn &GuiWebEvent Option KeyboardEvent \event:
    match gui_web_event_gui_event event:
        GuiEvent::Keyboard keyboard:
            Option::Some keyboard
        _:
            Option::None

//: gui_web_event_text_input: text input event なら `TextInputEvent` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::TextInput` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_text_input %fn &GuiWebEvent Option TextInputEvent \event:
    match gui_web_event_gui_event event:
        GuiEvent::TextInput text_input:
            Option::Some text_input
        _:
            Option::None

//: gui_web_event_window: window event なら `WindowEvent` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::Window` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_window %fn &GuiWebEvent Option WindowEvent \event:
    match gui_web_event_gui_event event:
        GuiEvent::Window window:
            Option::Some window
        _:
            Option::None

//: gui_web_event_timer: timer event なら `TimerEvent` を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - event が `GuiEvent::Timer` の場合は `Option::Some` を返します。
//: - それ以外の event variant は `Option::None` を返します。
pub fn gui_web_event_timer %fn &GuiWebEvent Option TimerEvent \event:
    match gui_web_event_gui_event event:
        GuiEvent::Timer timer:
            Option::Some timer
        _:
            Option::None

//: gui_web_action_result_from_raw: host raw action id を `Result Option ActionId GuiError` へ[正規化/せいきか]する
//:
//: [目的/もくてき]:
//: - host import が返す sentinel を public API に漏らさず、型付きの `Result` と `Option ActionId` に変換します。
//:
//: [契約/けいやく]:
//: - raw が 1 以上なら `Option::Some` を返します。
//: - raw が 0 なら timeout / empty queue として `Option::None` を返します。
//: - raw が -1 なら host queue unsupported として `GuiError::Unsupported` を返します。
//: - raw がその他の負値なら invalid queue record として `GuiError::InvalidCommand` を返します。
fn gui_web_action_result_from_raw %fn i32 Result Option ActionId GuiError \raw:
    if:
        gt raw 0
        then:
            let action %ActionId app::action_id raw
            let some %Option ActionId Option::Some action
            Result::Ok some
        else:
            if:
                lt raw 0
                then:
                    if:
                        eq raw -1
                        then:
                            Result::Err GuiError::Unsupported
                        else:
                            Result::Err GuiError::InvalidCommand
                else:
                    let none %Option ActionId Option::None
                    Result::Ok none

//: gui_web_event_result_from_kind_raw: host raw event kind と last event payload を typed result へ[正規化/せいきか]する
//:
//: [目的/もくてき]:
//: - event kind の sentinel と、last-event accessor の raw field を public API に漏らさず、`Result Option GuiWebEvent GuiError` に変換します。
//:
//: [契約/けいやく]:
//: - raw kind 1 は action event です。
//: - raw kind 2 は pointer event です。
//: - raw kind 3 は keyboard event です。
//: - raw kind 4 は text input event です。
//: - raw kind 5 は window event です。
//: - raw kind 6 は timer event です。
//: - raw kind 0 は timeout / empty queue です。
//: - raw kind -1 は unsupported host queue です。
//: - raw kind -2 または未知の kind は invalid command です。
fn gui_web_event_result_from_kind_raw %impure fn i32 Result Option GuiWebEvent GuiError \raw:
    if:
        lt raw 0
        then:
            if:
                eq raw -1
                then:
                    Result::Err GuiError::Unsupported
                else:
                    Result::Err GuiError::InvalidCommand
        else:
            match raw:
                0:
                    let none %Option GuiWebEvent Option::None
                    Result::Ok none
                1:
                    gui_web_action_event_result_from_last
                2:
                    gui_web_pointer_event_result_from_last
                3:
                    gui_web_keyboard_event_result_from_last
                4:
                    gui_web_text_input_event_result_from_last
                5:
                    gui_web_window_event_result_from_last
                6:
                    gui_web_timer_event_result_from_last
                _:
                    Result::Err GuiError::InvalidCommand

fn gui_web_web_event_from_gui_event %impure fn GuiEvent Result Option GuiWebEvent GuiError \gui_event:
    let x_milli %i32 gui_web_last_event_point_x_milli_raw
    let y_milli %i32 gui_web_last_event_point_y_milli_raw
    let point %GuiPoint gui_point_new x_milli y_milli
    let raw_window %i32 gui_web_last_event_window_id_raw
    match window_id_result raw_window:
        Result::Ok window_id:
            let web_event %GuiWebEvent GuiWebEvent window_id point gui_event
            let some %Option GuiWebEvent Option::Some web_event
            Result::Ok some
        Result::Err _:
            Result::Err GuiError::InvalidCommand

fn gui_web_action_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let action_raw %i32 gui_web_last_event_action_id_raw
    if:
        gt action_raw 0
        then:
            let action %ActionId app::action_id action_raw
            let gui_event %GuiEvent gui_event_action action
            gui_web_web_event_from_gui_event gui_event
        else:
            Result::Err GuiError::InvalidCommand

fn gui_web_pointer_kind_from_raw %fn i32 Result PointerEventKind GuiError \raw:
    if:
        eq raw 1
        then:
            Result::Ok PointerEventKind::Move
        else:
            if:
                eq raw 2
                then:
                    Result::Ok PointerEventKind::Down
                else:
                    if:
                        eq raw 3
                        then:
                            Result::Ok PointerEventKind::Up
                        else:
                            if:
                                eq raw 4
                                then:
                                    Result::Ok PointerEventKind::Cancel
                                else:
                                    Result::Err GuiError::InvalidCommand

fn gui_web_pointer_button_from_raw %fn i32 Result PointerButton GuiError \raw:
    if:
        eq raw 0
        then:
            Result::Ok PointerButton::None
        else:
            if:
                eq raw 1
                then:
                    Result::Ok PointerButton::Primary
                else:
                    if:
                        eq raw 2
                        then:
                            Result::Ok PointerButton::Secondary
                        else:
                            if:
                                eq raw 3
                                then:
                                    Result::Ok PointerButton::Middle
                                else:
                                    Result::Err GuiError::InvalidCommand

fn gui_web_pointer_event_result_from_parts %impure fn PointerEventKind impure fn PointerButton Result Option GuiWebEvent GuiError \kind\button:
    let pointer_id %i32 gui_web_last_event_pointer_id_raw
    if:
        gt pointer_id 0
        then:
            let x_milli %i32 gui_web_last_event_point_x_milli_raw
            let y_milli %i32 gui_web_last_event_point_y_milli_raw
            let point %GuiPoint gui_point_new x_milli y_milli
            let pointer_event %PointerEvent pointer_event_new kind pointer_id point button
            let gui_event %GuiEvent gui_event_pointer pointer_event
            gui_web_web_event_from_gui_event gui_event
        else:
            Result::Err GuiError::InvalidCommand

fn gui_web_pointer_event_result_from_button %impure fn PointerEventKind impure fn i32 Result Option GuiWebEvent GuiError \kind\button_raw:
    match gui_web_pointer_button_from_raw button_raw:
        Result::Ok button:
            gui_web_pointer_event_result_from_parts kind button
        Result::Err error:
            Result::Err error

fn gui_web_pointer_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let kind_raw %i32 gui_web_last_event_pointer_kind_raw
    match gui_web_pointer_kind_from_raw kind_raw:
        Result::Ok kind:
            let button_raw %i32 gui_web_last_event_pointer_button_raw
            gui_web_pointer_event_result_from_button kind button_raw
        Result::Err error:
            Result::Err error

fn gui_web_keyboard_kind_from_raw %fn i32 Result KeyboardEventKind GuiError \raw:
    if:
        eq raw 1
        then:
            Result::Ok KeyboardEventKind::KeyDown
        else:
            if:
                eq raw 2
                then:
                    Result::Ok KeyboardEventKind::KeyUp
                else:
                    Result::Err GuiError::InvalidCommand

fn gui_web_keyboard_event_result_from_parts %impure fn KeyboardEventKind Result Option GuiWebEvent GuiError \kind:
    let key_code %i32 gui_web_last_event_key_code_raw
    let modifier_bits %i32 gui_web_last_event_key_modifiers_raw
    if:
        and gt key_code 0 ge modifier_bits 0
        then:
            let modifiers %KeyModifiers key_modifiers_new modifier_bits
            let keyboard_event %KeyboardEvent keyboard_event_new kind key_code modifiers
            let gui_event %GuiEvent gui_event_keyboard keyboard_event
            gui_web_web_event_from_gui_event gui_event
        else:
            Result::Err GuiError::InvalidCommand

fn gui_web_keyboard_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let kind_raw %i32 gui_web_last_event_keyboard_kind_raw
    match gui_web_keyboard_kind_from_raw kind_raw:
        Result::Ok kind:
            gui_web_keyboard_event_result_from_parts kind
        Result::Err error:
            Result::Err error

fn gui_web_text_input_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let scalar %i32 gui_web_last_event_text_scalar_value_raw
    match char_from_i32_result scalar:
        Result::Ok value:
            let text_event %TextInputEvent text_input_event_new value
            let gui_event %GuiEvent gui_event_text_input text_event
            gui_web_web_event_from_gui_event gui_event
        Result::Err _message:
            Result::Err GuiError::InvalidCommand

fn gui_web_window_kind_from_raw %fn i32 Result WindowEventKind GuiError \raw:
    if:
        eq raw 1
        then:
            Result::Ok WindowEventKind::Resized
        else:
            if:
                eq raw 2
                then:
                    Result::Ok WindowEventKind::Focused
                else:
                    if:
                        eq raw 3
                        then:
                            Result::Ok WindowEventKind::Unfocused
                        else:
                            if:
                                eq raw 4
                                then:
                                    Result::Ok WindowEventKind::CloseRequested
                                else:
                                    Result::Err GuiError::InvalidCommand

fn gui_web_window_event_result_from_parts %impure fn WindowEventKind Result Option GuiWebEvent GuiError \kind:
    let width %i32 gui_web_last_event_window_width_raw
    let height %i32 gui_web_last_event_window_height_raw
    if:
        and gt width 0 gt height 0
        then:
            let size %GuiSize gui_size_new width height
            let window_event %WindowEvent window_event_new kind size
            let gui_event %GuiEvent gui_event_window window_event
            gui_web_web_event_from_gui_event gui_event
        else:
            Result::Err GuiError::InvalidCommand

fn gui_web_window_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let kind_raw %i32 gui_web_last_event_window_kind_raw
    match gui_web_window_kind_from_raw kind_raw:
        Result::Ok kind:
            gui_web_window_event_result_from_parts kind
        Result::Err error:
            Result::Err error

fn gui_web_timer_event_result_from_last %impure fn void Result Option GuiWebEvent GuiError \void:
    let timer_id %i32 gui_web_last_event_timer_id_raw
    let tick %i32 gui_web_last_event_timer_tick_raw
    if:
        and gt timer_id 0 ge tick 0
        then:
            let timer_event %TimerEvent timer_event_new timer_id tick
            let gui_event %GuiEvent gui_event_timer timer_event
            gui_web_web_event_from_gui_event gui_event
        else:
            Result::Err GuiError::InvalidCommand

//: gui_web_action_from_raw: host raw action id を legacy `Option ActionId` へ[正規化/せいきか]する
//:
//: [目的/もくてき]:
//: - 既存 caller の互換 path です。新しい interactive app は unsupported を区別できる `gui_web_wait_action_result` を使います。
fn gui_web_action_from_raw %fn i32 Option ActionId \raw:
    match gui_web_action_result_from_raw raw:
        Result::Ok action:
            action
        Result::Err _:
            Option::None

//: gui_web_poll_action: GUI action event を非 blocking に[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - Web host queue に溜まった action event を 1 件だけ読みます。
//: - event loop が別の work を進めたい場合に使います。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn gui_web_poll_action %impure fn void Option ActionId \void:
    let raw %i32 gui_web_poll_action_id_raw
    gui_web_action_from_raw raw

//: gui_web_poll_action_result: GUI action event を非 blocking に[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - unsupported host と empty queue を `Result` / `Option` で[分/わ]けます。
pub fn gui_web_poll_action_result %impure fn void Result Option ActionId GuiError \void:
    let raw %i32 gui_web_poll_action_id_raw
    gui_web_action_result_from_raw raw

//: gui_web_poll_event_result: GUI event を非 blocking に[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - action id だけではなく、window id と pointer position を含む typed event record を 1 件だけ読みます。
//: - unsupported host、empty queue、invalid queue record を `Result` / `Option` で[分/わ]けます。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn gui_web_poll_event_result %impure fn void Result Option GuiWebEvent GuiError \void:
    let raw %i32 gui_web_poll_event_kind_raw
    gui_web_event_result_from_kind_raw raw

//: gui_web_wait_action: GUI action event を待って[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - Web host queue に action event が来るまで、最大 timeout_ms だけ待ちます。
//: - interactive app が busy loop を避けるために使います。
//:
//: [契約/けいやく]:
//: - timeout_ms は 0 以上を渡します。負の値は host 側で 0 として扱われます。
//: - event が来た場合は `Option::Some action`、timeout または unsupported の場合は `Option::None` を返します。
pub fn gui_web_wait_action %impure fn i32 Option ActionId \timeout_ms:
    let raw %i32 gui_web_wait_action_id_raw timeout_ms
    gui_web_action_from_raw raw

//: gui_web_wait_action_result: GUI action event を待って[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - interactive app が busy loop を避けつつ、host input queue unsupported を明示的に終了処理へ分岐できるようにします。
//:
//: [契約/けいやく]:
//: - event が来た場合は `Result::Ok (Option::Some action)` を返します。
//: - timeout した場合は `Result::Ok Option::None` を返します。
//: - host queue が存在しない場合は `Result::Err GuiError::Unsupported` を返します。
pub fn gui_web_wait_action_result %impure fn i32 Result Option ActionId GuiError \timeout_ms:
    let raw %i32 gui_web_wait_action_id_raw timeout_ms
    gui_web_action_result_from_raw raw

//: gui_web_wait_event_result: GUI event を待って[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - interactive app が busy loop を避けつつ、action 以外の event へ拡張できる typed record 境界を使えるようにします。
//:
//: [契約/けいやく]:
//: - event が来た場合は `Result::Ok (Option::Some event)` を返します。
//: - timeout した場合は `Result::Ok Option::None` を返します。
//: - host queue が存在しない場合は `Result::Err GuiError::Unsupported` を返します。
//: - queue record が不正な場合は `Result::Err GuiError::InvalidCommand` を返します。
pub fn gui_web_wait_event_result %impure fn i32 Result Option GuiWebEvent GuiError \timeout_ms:
    let raw %i32 gui_web_wait_event_kind_raw timeout_ms
