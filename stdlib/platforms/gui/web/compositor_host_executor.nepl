fn gui_web_compositor_host_executor_status_error %fn i32 GuiError \status:
    if eq status -1:
        then GuiError::Unsupported
        else:
            if eq status -2:
                then GuiError::InvalidCommand
                else:
                    if eq status -3:
                        then GuiError::ResourceExhausted
                        else:
                            if eq status -4:
                                then GuiError::ResourceExhausted
                                else:
                                    if eq status -6:
                                        then GuiError::InvalidCommand
                                        else GuiError::BackendFailure

fn gui_web_compositor_host_executor_status_unit %fn i32 Result unit GuiError \status:
    if eq status 0:
        then Result::Ok unit
        else Result::Err gui_web_compositor_host_executor_status_error status

