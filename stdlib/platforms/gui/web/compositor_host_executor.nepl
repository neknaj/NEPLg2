//: gui_web_compositor_host_executor_execute_action: Web host import へ action 1 [件/けん]を[渡/わた]す
//:
//: [契約/けいやく]:
//: - action variant は F5ni std platform bridge で target と record kind に[投影/とうえい]します。
//: - 各 branch は begin、run、end のいずれか 1 import だけを[呼/よ]びます。
//: - unsupported host は `GuiError::Unsupported` として[返/かえ]します。
pub fn gui_web_compositor_host_executor_execute_action %impure fn GuiRgba8888CompositorTileRlePresentHostExecutionAction Result unit GuiError \action:
    let target %GuiRgba8888CompositorTileRlePresentHostActionPlatformTarget gui_rgba8888_compositor_tile_rle_present_host_action_platform_bridge_action_target &action
    match action:
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowBegin payload:
            let descriptor %GuiRgba8888CompositorTileRlePresentFrameDescriptor gui_rgba8888_compositor_tile_rle_present_host_execution_window_begin_descriptor &payload
            gui_web_compositor_host_executor_descriptor_begin target &descriptor
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowRun payload:
            let record %GuiRgba8888CompositorTileRlePresentHostCommandRunRecord gui_rgba8888_compositor_tile_rle_present_host_execution_window_run_record &payload
            gui_web_compositor_host_executor_run_record target &record
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::WindowEnd payload:
            let descriptor %GuiRgba8888CompositorTileRlePresentFrameDescriptor gui_rgba8888_compositor_tile_rle_present_host_execution_window_end_descriptor &payload
            gui_web_compositor_host_executor_descriptor_end target &descriptor
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenBegin descriptor:
            gui_web_compositor_host_executor_descriptor_begin target &descriptor
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenRun record:
            gui_web_compositor_host_executor_run_record target &record
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::OffscreenEnd descriptor:
            gui_web_compositor_host_executor_descriptor_end target &descriptor
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceBegin descriptor:
            gui_web_compositor_host_executor_descriptor_begin target &descriptor
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceRun record:
            gui_web_compositor_host_executor_run_record target &record
        GuiRgba8888CompositorTileRlePresentHostExecutionAction::DeviceEnd descriptor:
            gui_web_compositor_host_executor_descriptor_end target &descriptor

//: gui_web_compositor_host_executor_step: Web host execution outcome を F5nh session complete へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - session pending から expected action を borrowed accessor で[読/よ]みます。
//: - Web host execution outcome を F5ni std platform bridge で F5nh complete へ[戻/もど]します。
//: - action identity は completion API へ[渡/わた]しません。
pub fn gui_web_compositor_host_executor_step %impure fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport impure fn GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionPending Result GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionCompletion GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionCompleteError \support\pending:
    let action %GuiRgba8888CompositorTileRlePresentHostExecutionAction gui_rgba8888_compositor_tile_rle_present_host_action_platform_bridge_pending_action &pending
    let outcome %Result unit GuiError gui_web_compositor_host_executor_execute_action action
    gui_rgba8888_compositor_tile_rle_present_host_action_platform_bridge_complete_outcome support pending outcome
