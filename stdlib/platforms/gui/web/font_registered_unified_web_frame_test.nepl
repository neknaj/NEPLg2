//: # Web registered unified frame test adapter
//: actual RetryReadyから一つのproduction呼出しでterminal Completedまで実行します。

#indent 4

#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_host_action_failure_recovery" as *
#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_retry_policy" as *
#import "alloc/gui/font/registered_face/simple_glyph/indexed/stroke_compositor_tile_rle_begin_frame_retry_policy_test" as fixture with tests
#import "core/field" as field
#import "core/gui" as *
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "platforms/gui/web/font_registered_terminal_completion" as *
#import "platforms/gui/web/font_registered_begin_frame_retry_success_phase" as *
#import "platforms/gui/web/font_registered_unified_web_frame" as *
#import "std/gui/compositor_tile_present_dispatch" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
#import "std/gui/compositor_tile_present_host_executor" as *
#import "std/gui/compositor_tile_present_schedule" as *
#import "std/gui/compositor_tile_present_virtual_drain" as *
#import "std/gui/host" as *

fn gui_font_web_registered_unified_web_frame_test_provenance %fn Option GuiError fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget i32 \category\diagnostic\budget:
    let a %i32 match category:
        Option::Some value:
            match value:
                GuiError::Unsupported: 1
                _: 0
        _: 0
    let b %i32 add a match diagnostic:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic::SinkRejected _: 2
        _: 0
    add b match budget:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget::Exhausted: 4
        _: 0

fn gui_font_web_registered_unified_web_frame_test_terminal %fn GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion i32 \completion:
    match completion:
        GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion::Completed state:
            let dispatch gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch &state
            let schedule gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
            let drain gui_rgba8888_compositor_tile_rle_present_schedule_state_drain &schedule
            let a %i32 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 2 then 8 else 0
            let b %i32 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 16 then 16 else 0
            let c %i32 match gui_rgba8888_compositor_tile_rle_present_virtual_drain_phase &drain:
                GuiRgba8888CompositorTileRlePresentVirtualDrainPhase::Ended: 32
                _: 0
            add add a b c
        _: 0

#test
pub fn gui_font_web_registered_unified_web_frame_test_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_retry_policy_test_ready_owner _unit:
        Result::Err evidence: evidence
        Result::Ok ready:
            match gui_rgba8888_compositor_tile_rle_present_schedule_policy 4 64:
                Result::Err _:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_retry_ready_owner_free ready:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Ok policy:
                    let host %GuiHost gui_host_new (gui_capabilities_offscreen_pixel 64 64) none
                    match gui_font_web_registered_unified_web_frame_execute &host &policy GuiRgba8888CompositorTileRlePresentHostExecutorSupport::Offscreen ready:
                        Result::Err error:
                            match gui_font_web_registered_unified_web_frame_error_free error:
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        Result::Ok outcome:
                            match outcome:
                                GuiFontWebRegisteredUnifiedWebFrameSuccess::Continue owner:
                                    match gui_font_web_registered_begin_frame_retry_success_continue_owner_free owner:
                                        Result::Err _: sub 0 1
                                        Result::Ok _: 0
                                GuiFontWebRegisteredUnifiedWebFrameSuccess::Completed owner:
                                    match gui_font_web_registered_begin_frame_retry_success_completed_owner_free owner:
                                        Result::Err _: sub 0 1
                                        Result::Ok _: 0
                                GuiFontWebRegisteredUnifiedWebFrameSuccess::Terminal terminal:
                                    let parts %GuiFontWebRegisteredTerminalCompletionSuccessParts gui_font_web_registered_terminal_completion_success_into_parts terminal
                                    let previous_category field::get parts "previous_category"
                                    let previous_diagnostic field::get parts "previous_diagnostic"
                                    let spent_budget field::get parts "spent_budget"
                                    let _actual field::get parts "actual_completion"
                                    let terminal_completion field::get parts "terminal_completion"
                                    let provenance %i32 gui_font_web_registered_unified_web_frame_test_provenance previous_category previous_diagnostic spent_budget
                                    add add 64 provenance gui_font_web_registered_unified_web_frame_test_terminal terminal_completion
