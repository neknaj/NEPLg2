pub fn gui_font_web_registered_run_next_command_phase_owner_free %fn GuiFontWebRegisteredRunNextCommandPhaseOwner Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    match owner:
        GuiFontWebRegisteredRunNextCommandPhaseOwner::BeginFrame payload: gui_font_web_registered_run_next_command_phase_begin_frame_owner_free payload
        GuiFontWebRegisteredRunNextCommandPhaseOwner::Run payload: gui_font_web_registered_run_next_command_phase_run_owner_free payload
        GuiFontWebRegisteredRunNextCommandPhaseOwner::EndFrame payload: gui_font_web_registered_run_next_command_phase_end_frame_owner_free payload
        GuiFontWebRegisteredRunNextCommandPhaseOwner::Completed payload: gui_font_web_registered_run_next_command_phase_completed_owner_free payload

