pub enum GuiFontWebRegisteredRunNextCommandPhaseOwner:
    BeginFrame %GuiFontWebRegisteredRunNextCommandPhaseBeginFrameOwner
    Run %GuiFontWebRegisteredRunNextCommandPhaseRunOwner
    EndFrame %GuiFontWebRegisteredRunNextCommandPhaseEndFrameOwner
    Completed %GuiFontWebRegisteredRunNextCommandPhaseCompletedOwner

//: current Run stepを閉じ、同じcursor authorityから次outputを一度だけ得る
fn gui_font_web_registered_run_step_next_command %fn Option GuiError fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget fn GuiRgba8888CompositorTileRlePresentDispatchLoopState fn GuiRgba8888CompositorTileRlePresentCommandCursorStep Result GuiFontWebRegisteredRunNextCommandOwner GuiFontWebRegisteredRunNextCommandError \previous_category\previous_diagnostic\spent_budget\state\current_step:
    let cursor %GuiRgba8888CompositorTileRlePresentCommandCursorOwner gui_rgba8888_compositor_tile_rle_present_command_cursor_step_finish_owner current_step
    match gui_rgba8888_compositor_tile_rle_present_command_cursor_step cursor:
        Result::Ok step: Result::Ok GuiFontWebRegisteredRunNextCommandOwner previous_category previous_diagnostic spent_budget state step
        Result::Err lower: Result::Err GuiFontWebRegisteredRunNextCommandError previous_category previous_diagnostic spent_budget state lower

//: Continue stateを保ったまま、exact Run stepの次outputへ一度だけ進む
pub fn gui_font_web_registered_run_success_continue_step_next_command %fn GuiFontWebRegisteredRunSuccessPhaseContinueOwner Result GuiFontWebRegisteredRunNextCommandOwner GuiFontWebRegisteredRunNextCommandError \owner:
    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_web_registered_run_success_phase_continue_owner_state &owner
    let parts %GuiFontWebRegisteredRunSuccessPhaseContinueOwnerParts gui_font_web_registered_run_success_phase_continue_owner_into_parts owner
    gui_font_web_registered_run_step_next_command field::get parts "previous_category" field::get parts "previous_diagnostic" field::get parts "spent_budget" state field::get parts "step"

//: Yield stateのsliceだけを一度resetし、exact Run stepの次outputへ一度だけ進む
pub fn gui_font_web_registered_run_success_yield_resume_and_step_next_command %fn GuiFontWebRegisteredRunSuccessPhaseYieldOwner Result GuiFontWebRegisteredRunNextCommandOwner GuiFontWebRegisteredRunNextCommandError \owner:
    let yielded %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_web_registered_run_success_phase_yield_owner_state &owner
    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_resume_slice yielded
    let parts %GuiFontWebRegisteredRunSuccessPhaseYieldOwnerParts gui_font_web_registered_run_success_phase_yield_owner_into_parts owner
    gui_font_web_registered_run_step_next_command field::get parts "previous_category" field::get parts "previous_diagnostic" field::get parts "spent_budget" state field::get parts "step"

pub fn gui_font_web_registered_run_next_command_owner_state %fn &GuiFontWebRegisteredRunNextCommandOwner GuiRgba8888CompositorTileRlePresentDispatchLoopState \owner:
    *field::get_ref owner "state"

pub fn gui_font_web_registered_run_next_command_owner_result %fn &GuiFontWebRegisteredRunNextCommandOwner GuiRgba8888CompositorTileRlePresentCommandCursorStepResult \owner:
    gui_rgba8888_compositor_tile_rle_present_command_cursor_step_result field::get_ref owner "step"

fn gui_font_web_registered_run_next_command_owner_into_parts %fn GuiFontWebRegisteredRunNextCommandOwner GuiFontWebRegisteredRunNextCommandOwnerParts \owner:
    GuiFontWebRegisteredRunNextCommandOwnerParts field::get owner "previous_category" field::get owner "previous_diagnostic" field::get owner "spent_budget" field::get owner "state" field::get owner "step"

//: neutral next stepをexact resultで全域分類し、同じstep authorityをtyped ownerへ移す
pub fn gui_font_web_registered_run_next_command_owner_into_phase %fn GuiFontWebRegisteredRunNextCommandOwner GuiFontWebRegisteredRunNextCommandPhaseOwner \owner:
    let result %GuiRgba8888CompositorTileRlePresentCommandCursorStepResult gui_font_web_registered_run_next_command_owner_result &owner
    let parts %GuiFontWebRegisteredRunNextCommandOwnerParts gui_font_web_registered_run_next_command_owner_into_parts owner
    let previous_category field::get parts "previous_category"
    let previous_diagnostic field::get parts "previous_diagnostic"
    let spent_budget field::get parts "spent_budget"
    let state field::get parts "state"
    let step field::get parts "step"
    match result:
        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
            match command:
                GuiRgba8888CompositorTileRlePresentCommand::BeginFrame _: GuiFontWebRegisteredRunNextCommandPhaseOwner::BeginFrame GuiFontWebRegisteredRunNextCommandPhaseBeginFrameOwner previous_category previous_diagnostic spent_budget state step
                GuiRgba8888CompositorTileRlePresentCommand::Run _: GuiFontWebRegisteredRunNextCommandPhaseOwner::Run GuiFontWebRegisteredRunNextCommandPhaseRunOwner previous_category previous_diagnostic spent_budget state step
                GuiRgba8888CompositorTileRlePresentCommand::EndFrame _: GuiFontWebRegisteredRunNextCommandPhaseOwner::EndFrame GuiFontWebRegisteredRunNextCommandPhaseEndFrameOwner previous_category previous_diagnostic spent_budget state step
        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Completed:
            GuiFontWebRegisteredRunNextCommandPhaseOwner::Completed GuiFontWebRegisteredRunNextCommandPhaseCompletedOwner previous_category previous_diagnostic spent_budget state step

pub fn gui_font_web_registered_run_next_command_phase_begin_frame_owner_free %fn GuiFontWebRegisteredRunNextCommandPhaseBeginFrameOwner Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free field::get owner "step"

