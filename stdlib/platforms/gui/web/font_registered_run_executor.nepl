pub enum GuiFontWebRegisteredRunExecutionError:
    ScheduleFailed %GuiFontWebRegisteredRunExecutionScheduleError
    HostRequestFailed %GuiFontWebRegisteredRunExecutionHostRequestError
    UnexpectedSessionCompleted %GuiFontWebRegisteredRunExecutionUnexpectedCompleted
    CompletionFailed %GuiFontWebRegisteredRunExecutionCompleteError

pub enum GuiFontWebRegisteredRunExecutionErrorRecovery:
    ScheduleFailed %GuiFontWebRegisteredRunExecutionScheduleError
    HostRequestFailed %GuiFontWebRegisteredRunExecutionHostRequestError
    UnexpectedSessionCompleted %GuiFontWebRegisteredRunExecutionUnexpectedCompleted
    CompletionFailed %GuiFontWebRegisteredRunExecutionCompleteError

//: Run authorityをschedule、same-record request、F5nh session、Web executorへ順に一度ずつ渡す
pub fn gui_font_web_registered_retry_yield_next_command_execute_run %impure fn &GuiHost impure fn &GuiRgba8888CompositorTileRlePresentSchedulePolicy impure fn GuiRgba8888CompositorTileRlePresentHostExecutorSupport impure fn GuiFontWebRegisteredBeginFrameRetryYieldNextCommandOwner Result GuiFontWebRegisteredRunExecutionSuccess GuiFontWebRegisteredRunExecutionError \host\policy\support\owner:
    let parts %GuiFontWebRegisteredBeginFrameRetryYieldNextCommandOwnerParts gui_font_web_registered_begin_frame_retry_yield_next_command_owner_into_parts owner
    let previous_category %Option GuiError field::get parts "previous_category"
    let previous_diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic field::get parts "previous_diagnostic"
    let spent_budget %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget field::get parts "spent_budget"
    let next_owner field::get parts "next_owner"
    let record_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunRecordOwner gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_next_command_owner_into_run_record next_owner
    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_record_owner_into_schedule policy record_owner:
        Result::Err lower:
            Result::Err GuiFontWebRegisteredRunExecutionError::ScheduleFailed GuiFontWebRegisteredRunExecutionScheduleError previous_category previous_diagnostic spent_budget lower
        Result::Ok scheduled:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_owner_into_host_request host scheduled:
                Result::Err lower:
                    Result::Err GuiFontWebRegisteredRunExecutionError::HostRequestFailed GuiFontWebRegisteredRunExecutionHostRequestError previous_category previous_diagnostic spent_budget lower
                Result::Ok request_owner:
                    let request_parts %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameResumedRunHostRequestOwnerParts gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_owner_into_parts request_owner
                    let step %GuiRgba8888CompositorTileRlePresentCommandCursorStep field::get request_parts "step"
                    let pending %GuiRgba8888CompositorTileRlePresentDispatchLoopPendingRequest field::get request_parts "pending"
                    let driver gui_rgba8888_compositor_tile_rle_present_host_execution_driver_prepare pending
                    let session gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_start driver
                    match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_request session:
                        GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionRequestResult::Completed:
                            Result::Err GuiFontWebRegisteredRunExecutionError::UnexpectedSessionCompleted GuiFontWebRegisteredRunExecutionUnexpectedCompleted previous_category previous_diagnostic spent_budget step
                        GuiRgba8888CompositorTileRlePresentHostActionExecutorSessionRequestResult::Action action_pending:
                            match gui_web_compositor_host_executor_step support action_pending:
                                Result::Err lower:
                                    Result::Err GuiFontWebRegisteredRunExecutionError::CompletionFailed GuiFontWebRegisteredRunExecutionCompleteError previous_category previous_diagnostic spent_budget step lower
                                Result::Ok completion:
                                    Result::Ok GuiFontWebRegisteredRunExecutionSuccess previous_category previous_diagnostic spent_budget step completion

pub fn gui_font_web_registered_run_execution_success_completion %fn &GuiFontWebRegisteredRunExecutionSuccess GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion \owner:
    gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_completion_dispatch_loop_completion field::get_ref owner "completion"

pub fn gui_font_web_registered_run_execution_success_into_parts %fn GuiFontWebRegisteredRunExecutionSuccess GuiFontWebRegisteredRunExecutionSuccessParts \owner:
    GuiFontWebRegisteredRunExecutionSuccessParts field::get owner "previous_category" field::get owner "previous_diagnostic" field::get owner "spent_budget" field::get owner "step" field::get owner "completion"

pub fn gui_font_web_registered_run_execution_success_free %fn GuiFontWebRegisteredRunExecutionSuccess Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \owner:
    gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free field::get owner "step"

pub fn gui_font_web_registered_run_execution_complete_error_category_value %fn &GuiFontWebRegisteredRunExecutionCompleteError Option GuiError \error:
    gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_complete_error_category_value field::get_ref error "lower"

//: completion failureのcursorとowner-bearing F5nh lower recoveryを分断せずcallerへ移す
pub fn gui_font_web_registered_run_execution_complete_error_into_parts %fn GuiFontWebRegisteredRunExecutionCompleteError GuiFontWebRegisteredRunExecutionCompleteErrorParts \error:
    GuiFontWebRegisteredRunExecutionCompleteErrorParts field::get error "previous_category" field::get error "previous_diagnostic" field::get error "spent_budget" field::get error "step" field::get error "lower"

pub fn gui_font_web_registered_run_execution_schedule_error_into_parts %fn GuiFontWebRegisteredRunExecutionScheduleError GuiFontWebRegisteredRunExecutionScheduleErrorParts \error:
    GuiFontWebRegisteredRunExecutionScheduleErrorParts field::get error "previous_category" field::get error "previous_diagnostic" field::get error "spent_budget" field::get error "lower"

pub fn gui_font_web_registered_run_execution_host_request_error_into_parts %fn GuiFontWebRegisteredRunExecutionHostRequestError GuiFontWebRegisteredRunExecutionHostRequestErrorParts \error:
    GuiFontWebRegisteredRunExecutionHostRequestErrorParts field::get error "previous_category" field::get error "previous_diagnostic" field::get error "spent_budget" field::get error "lower"

pub fn gui_font_web_registered_run_execution_unexpected_completed_into_parts %fn GuiFontWebRegisteredRunExecutionUnexpectedCompleted GuiFontWebRegisteredRunExecutionUnexpectedCompletedParts \error:
    GuiFontWebRegisteredRunExecutionUnexpectedCompletedParts field::get error "previous_category" field::get error "previous_diagnostic" field::get error "spent_budget" field::get error "step"

pub fn gui_font_web_registered_run_execution_error_into_recovery %fn GuiFontWebRegisteredRunExecutionError GuiFontWebRegisteredRunExecutionErrorRecovery \error:
    match error:
        GuiFontWebRegisteredRunExecutionError::ScheduleFailed payload: GuiFontWebRegisteredRunExecutionErrorRecovery::ScheduleFailed payload
        GuiFontWebRegisteredRunExecutionError::HostRequestFailed payload: GuiFontWebRegisteredRunExecutionErrorRecovery::HostRequestFailed payload
        GuiFontWebRegisteredRunExecutionError::UnexpectedSessionCompleted payload: GuiFontWebRegisteredRunExecutionErrorRecovery::UnexpectedSessionCompleted payload
        GuiFontWebRegisteredRunExecutionError::CompletionFailed payload: GuiFontWebRegisteredRunExecutionErrorRecovery::CompletionFailed payload

pub fn gui_font_web_registered_run_execution_error_free %fn GuiFontWebRegisteredRunExecutionError Result unit GuiRgba8888CompositorTileRleEncodedFinishErrorKind \error:
    match gui_font_web_registered_run_execution_error_into_recovery error:
        GuiFontWebRegisteredRunExecutionErrorRecovery::ScheduleFailed payload:
            gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_schedule_error_free field::get payload "lower"
        GuiFontWebRegisteredRunExecutionErrorRecovery::HostRequestFailed payload:
            gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_run_host_request_error_free field::get payload "lower"
        GuiFontWebRegisteredRunExecutionErrorRecovery::UnexpectedSessionCompleted payload:
            gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free field::get payload "step"
        GuiFontWebRegisteredRunExecutionErrorRecovery::CompletionFailed payload:
            let parts %GuiFontWebRegisteredRunExecutionCompleteErrorParts gui_font_web_registered_run_execution_complete_error_into_parts payload
            let lower field::get parts "lower"
            gui_rgba8888_compositor_tile_rle_present_host_action_attempt_driver_error_close gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_complete_error_lower lower
            gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free field::get parts "step"
