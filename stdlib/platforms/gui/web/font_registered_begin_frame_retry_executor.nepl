    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_executor_session_complete support session_owner outcome:
        Result::Ok completion_owner:
            Result::Ok GuiFontWebRegisteredBeginFrameRetryExecutionSuccess previous_category previous_diagnostic spent_budget completion_owner
        Result::Err completion_error:
            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_completion_error_recover completion_error:
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RetryPending retry_pending:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_retry_pending_decide retry_pending spent_budget GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryPolicyDecision::RetryWithSupport support:
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryPolicyDecisionOwner::AbortReady abort_ready:
                            Result::Err GuiFontWebRegisteredBeginFrameRetryExecutionFailure::RetryAbort GuiFontWebRegisteredBeginFrameRetryExecutionRetryAbort previous_category previous_diagnostic GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget::Exhausted abort_ready
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryPolicyDecisionOwner::RetryReady unexpected:
                            Result::Err GuiFontWebRegisteredBeginFrameRetryExecutionFailure::InvariantViolation gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_retry_ready_owner_free unexpected
                GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecovery::RecoveredState recovered:
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_recovered_state_scheduler_decide recovered GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameRecoveredStateSchedulerDecision::Abort:
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameRecoveredStateSchedulerDecisionOwner::AbortReady abort_ready:
                            Result::Err GuiFontWebRegisteredBeginFrameRetryExecutionFailure::RecoveredAbort GuiFontWebRegisteredBeginFrameRetryExecutionRecoveredAbort previous_category previous_diagnostic spent_budget abort_ready
                        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameRecoveredStateSchedulerDecisionOwner::ResumePending unexpected:
                            Result::Err GuiFontWebRegisteredBeginFrameRetryExecutionFailure::InvariantViolation gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_recovered_state_resume_pending_owner_free unexpected

