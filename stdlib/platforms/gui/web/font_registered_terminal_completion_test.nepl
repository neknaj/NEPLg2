//: # Web registered terminal completion test adapter
//: actual EndFrame completionとexact cursorをterminal Completedへ閉じるF5oaf chainを検証します。

#indent 4

#import "core/field" as field
#import "core/gui/error" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "platforms/gui/web/font_registered_end_frame_executor_test" as fixture with tests
#import "platforms/gui/web/font_registered_terminal_completion" as *
#import "std/gui/compositor_tile_present_dispatch" as *
#import "std/gui/compositor_tile_present_dispatch_loop" as *
#import "std/gui/compositor_tile_present_host_action_executor_session" as *
#import "std/gui/compositor_tile_present_schedule" as *
#import "std/gui/compositor_tile_present_virtual_drain" as *

fn gui_font_web_registered_terminal_completion_test_state_evidence %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState i32 \state:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    let drain %GuiRgba8888CompositorTileRlePresentVirtualDrain gui_rgba8888_compositor_tile_rle_present_schedule_state_drain &schedule
    let a %i32 if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 2 then 1 else 0
    let b %i32 add a if eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 16 then 2 else 0
    let c %i32 add b if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_run_count &drain 1 then 4 else 0
    let d %i32 add c if eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_pixel_count &drain 16 then 8 else 0
    add d match gui_rgba8888_compositor_tile_rle_present_virtual_drain_phase &drain:
        GuiRgba8888CompositorTileRlePresentVirtualDrainPhase::Ended: 16
        _: 0

fn gui_font_web_registered_terminal_completion_test_provenance %fn Option GuiError fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget i32 \category\diagnostic\budget:
    let a %i32 match category:
        Option::Some value:
            match value:
                GuiError::Unsupported: 1
                _: 0
        _: 0
    let b %i32 add a match diagnostic:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic::SinkRejected _: 2
        _: 0
    add b match budget:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget::Exhausted: 4
        _: 0

#test
pub fn gui_font_web_registered_terminal_completion_test_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_web_registered_end_frame_executor_test_success _unit:
        Result::Err evidence: evidence
        Result::Ok execution:
            match gui_font_web_registered_end_frame_execution_into_terminal_completion execution:
                Result::Err error:
                    match gui_font_web_registered_terminal_completion_error_free error:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Ok success:
                    let parts %GuiFontWebRegisteredTerminalCompletionSuccessParts gui_font_web_registered_terminal_completion_success_into_parts success
                    let previous_category field::get parts "previous_category"
                    let previous_diagnostic field::get parts "previous_diagnostic"
                    let spent_budget field::get parts "spent_budget"
                    let actual_completion field::get parts "actual_completion"
                    let terminal_completion field::get parts "terminal_completion"
                    let provenance %i32 gui_font_web_registered_terminal_completion_test_provenance previous_category previous_diagnostic spent_budget
                    let actual_evidence %i32 match gui_rgba8888_compositor_tile_rle_present_host_action_executor_session_completion_dispatch_loop_completion &actual_completion:
                        GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion::Completed _: 8
                        _: 0
                    let terminal_evidence %i32 match terminal_completion:
                        GuiRgba8888CompositorTileRlePresentDispatchLoopCompletion::Completed state:
                            if eq gui_font_web_registered_terminal_completion_test_state_evidence &state 31 then 48 else 0
                        _: 0
                    add add add 64 provenance actual_evidence terminal_evidence
