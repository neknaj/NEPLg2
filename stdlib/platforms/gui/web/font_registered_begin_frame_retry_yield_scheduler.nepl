//: 未resume Yieldを一度分解し、caller decisionに対応するconcrete authorityへ移す
pub fn gui_font_web_registered_begin_frame_retry_yield_scheduler_decide %fn GuiFontWebRegisteredBeginFrameRetrySuccessYieldOwner fn GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecision GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecisionOwner \owner\decision:
    let parts %GuiFontWebRegisteredBeginFrameRetrySuccessYieldOwnerParts gui_font_web_registered_begin_frame_retry_success_yield_owner_into_parts owner
    let previous_category %Option GuiError field::get parts "previous_category"
    let previous_diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic field::get parts "previous_diagnostic"
    let spent_budget %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget field::get parts "spent_budget"
    let phase_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionYieldOwner field::get parts "phase_owner"
    match decision:
        GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecision::ResumeSlice:
            GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecisionOwner::ResumePending GuiFontWebRegisteredBeginFrameRetryYieldResumePendingOwner previous_category previous_diagnostic spent_budget phase_owner
        GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecision::Abort:
            GuiFontWebRegisteredBeginFrameRetryYieldSchedulerDecisionOwner::AbortReady GuiFontWebRegisteredBeginFrameRetryYieldAbortReadyOwner previous_category previous_diagnostic spent_budget phase_owner

pub fn gui_font_web_registered_begin_frame_retry_yield_resume_pending_state %fn &GuiFontWebRegisteredBeginFrameRetryYieldResumePendingOwner GuiRgba8888CompositorTileRlePresentDispatchLoopState \owner:
    gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_yield_owner_state field::get_ref owner "phase_owner"

//: ResumePendingだけをF5nzm resumeとF5nzn next-commandへ順に一度ずつ渡す
pub fn gui_font_web_registered_begin_frame_retry_yield_resume_and_step_next_command %fn GuiFontWebRegisteredBeginFrameRetryYieldResumePendingOwner Result GuiFontWebRegisteredBeginFrameRetryYieldNextCommandOwner GuiFontWebRegisteredBeginFrameRetryYieldNextCommandError \owner:
    let previous_category %Option GuiError field::get owner "previous_category"
    let previous_diagnostic %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic field::get owner "previous_diagnostic"
    let spent_budget %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget field::get owner "spent_budget"
    let phase_owner %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionYieldOwner field::get owner "phase_owner"
    let resumed %GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionResumedOwner gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_host_action_yield_resume_slice phase_owner
    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_owner_step_next_command resumed:
        Result::Ok next_owner:
            Result::Ok GuiFontWebRegisteredBeginFrameRetryYieldNextCommandOwner previous_category previous_diagnostic spent_budget next_owner
        Result::Err lower:
            Result::Err GuiFontWebRegisteredBeginFrameRetryYieldNextCommandError previous_category previous_diagnostic spent_budget lower

pub fn gui_font_web_registered_begin_frame_retry_yield_abort_ready_owner_into_parts %fn GuiFontWebRegisteredBeginFrameRetryYieldAbortReadyOwner GuiFontWebRegisteredBeginFrameRetryYieldAbortReadyOwnerParts \owner:
