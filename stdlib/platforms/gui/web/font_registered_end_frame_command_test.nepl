fn gui_font_web_registered_end_frame_command_test_provenance %fn Option GuiError fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic fn GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget i32 \category\diagnostic\budget:
    let category_evidence %i32 match category:
        Option::Some value:
            match value:
                GuiError::Unsupported: 1
                _: 0
        _: 0
    let diagnostic_evidence %i32 match diagnostic:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionFailureRecoveryDiagnostic::SinkRejected _: 2
        _: 0
    let budget_evidence %i32 match budget:
        GuiFontRegisteredFaceSimpleGlyphIndexedStrokeCompositorTileRleBeginFrameHostActionRetryBudget::Exhausted: 4
        _: 0
    add add category_evidence diagnostic_evidence budget_evidence

fn gui_font_web_registered_end_frame_command_test_state %fn &GuiRgba8888CompositorTileRlePresentDispatchLoopState bool \state:
    let dispatch %GuiRgba8888CompositorTileRlePresentDispatchState gui_rgba8888_compositor_tile_rle_present_dispatch_loop_state_dispatch state
    let schedule %GuiRgba8888CompositorTileRlePresentScheduleState gui_rgba8888_compositor_tile_rle_present_dispatch_state_schedule &dispatch
    let drain %GuiRgba8888CompositorTileRlePresentVirtualDrain gui_rgba8888_compositor_tile_rle_present_schedule_state_drain &schedule
    and and eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_command_count &schedule 1 eq gui_rgba8888_compositor_tile_rle_present_schedule_state_slice_pixel_count &schedule 16 and eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_run_count &drain 1 eq gui_rgba8888_compositor_tile_rle_present_virtual_drain_seen_pixel_count &drain 16

pub fn gui_font_web_registered_end_frame_command_test_owner %impure fn unit Result GuiFontWebRegisteredEndFrameCommandOwner i32 \_unit:
    match fixture::gui_font_web_registered_run_executor_test_success_owner _unit 2 32:
        Result::Err evidence: Result::Err evidence
        Result::Ok run_success:
            match gui_font_web_registered_run_execution_success_step_end_frame run_success:
                Result::Ok owner: Result::Ok owner
                Result::Err error:
                    match gui_font_web_registered_end_frame_command_error_free error:
                        Result::Err _: Result::Err sub 0 1
                        Result::Ok _: Result::Err 0

#test
pub fn gui_font_web_registered_end_frame_command_test_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_web_registered_run_executor_test_success_owner _unit 2 32:
        Result::Err evidence: evidence
        Result::Ok run_success:
            match gui_font_web_registered_run_execution_success_step_end_frame run_success:
                Result::Err error:
                    match gui_font_web_registered_end_frame_command_error_free error:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Ok owner:
                    let parts %GuiFontWebRegisteredEndFrameCommandOwnerParts gui_font_web_registered_end_frame_command_owner_into_parts owner
                    let provenance %i32 gui_font_web_registered_end_frame_command_test_provenance field::get parts "previous_category" field::get parts "previous_diagnostic" field::get parts "spent_budget"
                    let lower field::get parts "lower"
                    let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_owner_state &lower
                    let command_evidence %i32 match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_owner_step_result &lower:
                        GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
                            match command:
                                GuiRgba8888CompositorTileRlePresentCommand::EndFrame _: 8
                                _: 0
                        _: 0
                    let state_evidence %i32 if gui_font_web_registered_end_frame_command_test_state &state then 32 else 0
                    match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_owner_free lower:
                        Result::Err _: sub 0 1
                        Result::Ok _: add (add (add provenance command_evidence) 16) state_evidence

#test
pub fn gui_font_web_registered_end_frame_command_test_non_continue_contract %impure fn unit i32 \_unit:
    match fixture::gui_font_web_registered_run_executor_test_success_owner _unit 1 16:
        Result::Err evidence: evidence
        Result::Ok run_success:
            match gui_font_web_registered_run_execution_success_step_end_frame run_success:
                Result::Ok owner:
                    match gui_font_web_registered_end_frame_command_owner_free owner:
                        Result::Err _: sub 0 1
                        Result::Ok _: 0
                Result::Err error:
                    match gui_font_web_registered_end_frame_command_error_into_recovery error:
                        GuiFontWebRegisteredEndFrameCommandErrorRecovery::TransitionFailed payload:
                            let parts %GuiFontWebRegisteredEndFrameCommandLowerErrorParts gui_font_web_registered_end_frame_command_lower_error_into_parts payload
                            match gui_font_registered_face_simple_glyph_indexed_stroke_compositor_tile_rle_begin_frame_resumed_end_frame_error_free field::get parts "lower":
                                Result::Err _: sub 0 1
                                Result::Ok _: 0
                        GuiFontWebRegisteredEndFrameCommandErrorRecovery::ContinueExpected payload:
                            let parts %GuiFontWebRegisteredEndFrameCommandPhaseErrorParts gui_font_web_registered_end_frame_command_phase_error_into_parts payload
                            let provenance %i32 gui_font_web_registered_end_frame_command_test_provenance field::get parts "previous_category" field::get parts "previous_diagnostic" field::get parts "spent_budget"
                            let state %GuiRgba8888CompositorTileRlePresentDispatchLoopState field::get parts "state"
                            let step %GuiRgba8888CompositorTileRlePresentCommandCursorStep field::get parts "step"
                            let state_evidence %i32 if gui_font_web_registered_end_frame_command_test_state &state then 8 else 0
                            let step_evidence %i32 match gui_rgba8888_compositor_tile_rle_present_command_cursor_step_result &step:
                                GuiRgba8888CompositorTileRlePresentCommandCursorStepResult::Command command:
                                    match command:
                                        GuiRgba8888CompositorTileRlePresentCommand::Run _: 16
                                        _: 0
                                _: 0
                            match gui_rgba8888_compositor_tile_rle_present_command_cursor_step_free step:
                                Result::Err _: sub 0 1
                                Result::Ok _: add (add provenance state_evidence) step_evidence

#test
pub fn gui_font_web_registered_end_frame_command_test_all_contract %impure fn unit i32 \_unit:
    add gui_font_web_registered_end_frame_command_test_contract _unit gui_font_web_registered_end_frame_command_test_non_continue_contract _unit
