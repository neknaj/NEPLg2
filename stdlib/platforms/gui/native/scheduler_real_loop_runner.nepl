fn gui_native_scheduler_real_loop_runner_drain_remaining %impure fn &GuiNativeSchedulerRealLoopRunnerPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult impure fn i32 impure fn i32 Result GuiNativeSchedulerRealLoopRunnerResult GuiNativeSchedulerRealLoopRunnerError \policy\clock_state\driver_result\remaining_count\step_count:
    match driver_result:
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult::Completed completed:
            gui_native_scheduler_real_loop_runner_from_completed clock_state completed step_count
        GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult::NeedInput need:
            if le remaining_count 0:
                then gui_native_scheduler_real_loop_runner_budget_exhausted_result clock_state need step_count
                else:
                    let step_policy %&GuiNativeSchedulerRealLoopStepPolicy gui_native_scheduler_real_loop_runner_policy_step_policy_ref policy
                    match gui_native_scheduler_real_loop_step step_policy clock_state need:
                        Result::Err lower:
                            gui_native_scheduler_real_loop_runner_step_failed_result clock_state lower
                        Result::Ok ready:
                            let next_clock_state %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState gui_native_scheduler_real_loop_step_ready_clock_state &ready
                            let next_driver_result %GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverResult gui_native_scheduler_real_loop_step_ready_driver_result ready
                            let next_remaining_count %i32 sub remaining_count 1
                            let next_step_count %i32 add step_count 1
                            gui_native_scheduler_real_loop_runner_drain_remaining policy next_clock_state next_driver_result next_remaining_count next_step_count

//: gui_native_scheduler_real_loop_runner_run: native real-loop を bounded に[実行/じっこう]する
//:
//: [契約/けいやく]:
//: - policy は F5el start の[前/まえ]に[再検査/さいけんさ]します。
//: - F5el start は valid policy で 1 [回/かい]だけ[呼/よ]びます。
//: - F5fz step は `NeedInput` かつ remaining budget が positive の[場合/ばあい]だけ[呼/よ]びます。
pub fn gui_native_scheduler_real_loop_runner_run %impure fn &GuiNativeSchedulerRealLoopRunnerPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerState Result GuiNativeSchedulerRealLoopRunnerResult GuiNativeSchedulerRealLoopRunnerError \policy\clock_state\state:
    let max_step_count %i32 gui_native_scheduler_real_loop_runner_policy_max_step_count policy
    match gui_native_scheduler_real_loop_runner_validate_max_step_count max_step_count:
        Result::Err kind:
            gui_native_scheduler_real_loop_runner_policy_invalid_result kind clock_state state
        Result::Ok count:
            let step_policy %&GuiNativeSchedulerRealLoopStepPolicy gui_native_scheduler_real_loop_runner_policy_step_policy_ref policy
            let driver_policy %&GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverPolicy gui_native_scheduler_real_loop_step_policy_driver_policy_ref step_policy
            match gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_real_loop_driver_start driver_policy state:
                Result::Err lower:
                    gui_native_scheduler_real_loop_runner_start_failed_result clock_state lower
                Result::Ok driver_result:
                    gui_native_scheduler_real_loop_runner_drain_remaining policy clock_state driver_result count 0

