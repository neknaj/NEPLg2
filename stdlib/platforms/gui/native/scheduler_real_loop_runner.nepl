fn gui_native_scheduler_real_loop_runner_budget_exhausted_result %fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerBackendClockState fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopDriverNeedInput fn i32 Result GuiNativeSchedulerRealLoopRunnerResult GuiNativeSchedulerRealLoopRunnerError \clock_state\need\step_count:
