fn gui_native_scheduler_real_loop_runner_validate_max_step_count %fn i32 Result i32 GuiNativeSchedulerRealLoopRunnerPolicyErrorKind \max_step_count:
    if lt max_step_count 0:
        then Result::Err GuiNativeSchedulerRealLoopRunnerPolicyErrorKind::MaxStepCountInvalid
        else Result::Ok max_step_count

fn gui_native_scheduler_real_loop_runner_policy_error_kind_category %fn GuiNativeSchedulerRealLoopRunnerPolicyErrorKind Option GuiError \kind:
    match kind:
        GuiNativeSchedulerRealLoopRunnerPolicyErrorKind::MaxStepCountInvalid:
            Option::Some GuiError::InvalidCommand

pub fn gui_native_scheduler_real_loop_runner_policy %fn GuiNativeSchedulerRealLoopStepPolicy fn i32 Result GuiNativeSchedulerRealLoopRunnerPolicy GuiNativeSchedulerRealLoopRunnerPolicyErrorKind \step_policy\max_step_count:
    match gui_native_scheduler_real_loop_runner_validate_max_step_count max_step_count:
        Result::Err kind:
            Result::Err kind
        Result::Ok count:
            Result::Ok gui_native_scheduler_real_loop_runner_policy_new step_policy count

