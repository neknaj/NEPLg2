//: gui_native_scheduler_host_executor_execute_operation: span operation 1 [件/けん]を native host import へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - operation variant は wildcard なしで[網羅/もうら]します。
//: - 各 branch は begin、run、end のいずれか 1 import だけを[呼/よ]びます。
//: - unsupported host は `GuiError::Unsupported` として[返/かえ]します。
pub fn gui_native_scheduler_host_executor_execute_operation %impure fn GuiRgba8888RowTileRlePresentHostSpanOperation Result unit GuiError \operation:
    match operation:
        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowBegin payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_begin_window &payload
            let descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_host_span_operation_window_begin_descriptor &payload
            let target_kind %i32 1
            let window_raw %i32 window_id_raw &window
            gui_native_scheduler_host_executor_descriptor_begin target_kind window_raw &descriptor
        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowRunSpan payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_run_span_window &payload
            let span %GuiRgba8888RowTileRlePresentRunRowSpan gui_rgba8888_row_tile_rle_present_host_span_operation_window_run_span_span &payload
            let target_kind %i32 1
            let window_raw %i32 window_id_raw &window
            gui_native_scheduler_host_executor_run_span target_kind window_raw &span
        GuiRgba8888RowTileRlePresentHostSpanOperation::WindowEnd payload:
            let window %WindowId gui_rgba8888_row_tile_rle_present_host_span_operation_window_end_window &payload
            let descriptor %GuiRgba8888RowTileRlePresentDescriptor gui_rgba8888_row_tile_rle_present_host_span_operation_window_end_descriptor &payload
            let target_kind %i32 1
            let window_raw %i32 window_id_raw &window
            gui_native_scheduler_host_executor_descriptor_end target_kind window_raw &descriptor
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenBegin descriptor:
            let target_kind %i32 2
            let window_raw %i32 0
            gui_native_scheduler_host_executor_descriptor_begin target_kind window_raw &descriptor
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenRunSpan span:
            let target_kind %i32 2
            let window_raw %i32 0
            gui_native_scheduler_host_executor_run_span target_kind window_raw &span
        GuiRgba8888RowTileRlePresentHostSpanOperation::OffscreenEnd descriptor:
            let target_kind %i32 2
            let window_raw %i32 0
            gui_native_scheduler_host_executor_descriptor_end target_kind window_raw &descriptor
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceBegin descriptor:
            let target_kind %i32 3
            let window_raw %i32 0
            gui_native_scheduler_host_executor_descriptor_begin target_kind window_raw &descriptor
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceRunSpan span:
            let target_kind %i32 3
            let window_raw %i32 0
            gui_native_scheduler_host_executor_run_span target_kind window_raw &span
        GuiRgba8888RowTileRlePresentHostSpanOperation::DeviceEnd descriptor:
            let target_kind %i32 3
            let window_raw %i32 0
            gui_native_scheduler_host_executor_descriptor_end target_kind window_raw &descriptor

//: gui_native_scheduler_host_executor_step: native host execution outcome を F5ew one-step bridge へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - typed `ExecuteHostAction` だけを[受/う]けます。
//: - pending operation を borrowed accessor で[読/よ]み、host execution outcome を F5ev input helper で[包/つつ]みます。
//: - F5ew `gui_native_scheduler_executor_step` を 1 [回/かい]だけ[呼/よ]び、lower `Result` をそのまま[返/かえ]します。
pub fn gui_native_scheduler_host_executor_step %impure fn &GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopStepPolicy impure fn GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerLoopActionExecuteHostAction Result GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopStepResult GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerRealLoopStepError \policy\action:
    let execute %&GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnVirtualSchedulerExecute gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_loop_action_execute_host_action_execute_ref &action
    let pending %&GuiRgba8888RowTileRlePresentHostSpanOperationPresenterExecutorSessionTurnDriverPending gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_virtual_scheduler_execute_pending_ref execute
    let operation %GuiRgba8888RowTileRlePresentHostSpanOperation gui_rgba8888_row_tile_rle_present_host_span_operation_presenter_executor_session_turn_driver_pending_operation pending
    let outcome %Result unit GuiError gui_native_scheduler_host_executor_execute_operation operation
    let ready %GuiNativeSchedulerExecutorInputReady gui_native_scheduler_executor_input action outcome
    gui_native_scheduler_executor_step policy ready
