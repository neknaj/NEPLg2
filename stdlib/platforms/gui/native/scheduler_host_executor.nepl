#extern "nepl_gui_native" "execute_span_operation_run" fn gui_native_execute_span_operation_run_raw %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32
#extern "nepl_gui_native" "execute_span_operation_end" fn gui_native_execute_span_operation_end_raw %impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 i32

fn gui_native_scheduler_host_executor_status_error %fn i32 GuiError \status:
    if eq status -1:
        then GuiError::Unsupported
        else:
            if eq status -2:
                then GuiError::InvalidCommand
                else:
                    if eq status -3:
                        then GuiError::ResourceExhausted
                        else:
                            if eq status -4:
                                then GuiError::ResourceExhausted
                                else:
                                    if eq status -6:
                                        then GuiError::InvalidCommand
                                        else GuiError::BackendFailure

fn gui_native_scheduler_host_executor_status_unit %fn i32 Result unit GuiError \status:
    if eq status 0:
        then Result::Ok unit
        else Result::Err gui_native_scheduler_host_executor_status_error status

