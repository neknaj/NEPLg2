//: # platforms/wasix/tui/box
//: 罫線付き行と styled box line helper
//:
//: ### 目的
//: - box の内側幅、切り詰め、padding、罫線組み立てを text/style helper から利用する薄い構築 layer に分離します。
//: - narrow width の契約を box helper に閉じ込め、呼び出し側に width guard を要求しないようにします。

#indent 4

#import "alloc/string" as *
#import "std/stdio" as *
#import "platforms/wasix/tui/text" as *
#import "platforms/wasix/tui/style" as *

//: box_inner_cols: ボックス全体幅から内側幅を求める
//:
//: [目的/もくてき]:
//: - narrow width の扱いを `line_box` / `line_top` / `line_bottom` で統一します。
//:
//: [実装/じっそう]:
//: - `cols <= 2` では内側幅を 0 に丸め、負の繰り返し回数や呼び出し側ごとの分岐を避けます。
pub fn box_inner_cols <(i32)->i32> (cols):
    if:
        lt cols 3
        then:
            0
        else:
            sub cols 2

//: line_box_body: ボックス内側に入る本文を幅に合わせる
//:
//: [目的/もくてき]:
//: - 本文が指定幅を超えても、ボックス行の表示幅が `cols` を超えないようにします。
//:
//: [実装/じっそう]:
//: - 表示幅ベースで `inner` 以内に切り詰め、その後右側空白で `inner` 幅まで埋めます。
pub fn line_box_body <(str,i32)*>str> (content, inner):
    line_pad_to_cols line_clip_to_cols content inner inner

//: line_box: 罫線付きの1行（`│ ... │`）を作る
//:
//: [目的/もくてき]:
//: - 枠線付きUIの行構築を簡潔に行います。
//:
//: [実装/じっそう]:
//: - `cols <= 0` は空文字列、`cols == 1` は左罫線のみを返します。
//: - `cols >= 2` では内側幅 `cols-2` に合わせて `content` を切り詰め・右パディングし、両端に縦罫線を付けます。
//:
//: [注意/ちゅうい]:
//: - ANSI/OSC8 を含む `content` の厳密な切り詰めは対象外です。
pub fn line_box <(str,i32)*>str> (content, cols):
    if:
        lt cols 1
        then:
            ""
        else:
            if:
                eq cols 1
                then:
                    "│"
                else:
                    let inner <i32> box_inner_cols cols;
                    let body <str> line_box_body content inner;
                    concat3 "│" body "│"

//: line_box_styled: 罫線付きの1行を typed style 付きで作る
//:
//: [目的/もくてき]:
//: - 行全体の背景色や前景色を確実に塗りたい場合に使います。
//:
//: [実装/じっそう]:
//: - 先に `content` を内側幅まで切り詰め・パディングし、その結果に `style_text` を適用します。
//: - `cols <= 0` は空文字列、`cols == 1` は左罫線のみ、`cols == 2` は左右罫線のみを返します。
//:
//: [注意/ちゅうい]:
//: - 罫線（`│`）自体は無色です。内側領域のみ style がつきます。
pub fn line_box_styled <(AnsiTextStyle,str,i32)*>str> (style, content, cols):
    if:
        lt cols 1
        then:
            ""
        else:
            if:
                eq cols 1
                then:
                    "│"
                else:
                    let inner <i32> box_inner_cols cols;
                    if:
                        lt inner 1
                        then:
                            "││"
                        else:
                            let body <str> line_box_body content inner;
                            let styled <str> style_text style body;
                            concat3 "│" styled "│"

//: line_top: 上枠（`┌──┐`）を作る
//:
//: [目的/もくてき]:
//: - ボックス描画の先頭行を生成します。
//: - `cols <= 0` は空文字列、`cols == 1` は左上罫線のみを返します。
pub fn line_top <(i32)*>str> (cols):
    if:
        lt cols 1
        then:
            ""
        else:
            if:
                eq cols 1
                then:
                    "┌"
                else:
                    concat3 "┌" repeat_text "─" box_inner_cols cols "┐"

//: line_bottom: 下枠（`└──┘`）を作る
//:
//: [目的/もくてき]:
//: - ボックス描画の最終行を生成します。
//: - `cols <= 0` は空文字列、`cols == 1` は左下罫線のみを返します。
pub fn line_bottom <(i32)*>str> (cols):
    if:
        lt cols 1
        then:
            ""
        else:
            if:
                eq cols 1
                then:
                    "└"
                else:
                    concat3 "└" repeat_text "─" box_inner_cols cols "┘"
