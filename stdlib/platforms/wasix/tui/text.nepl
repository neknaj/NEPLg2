//: # platforms/wasix/tui/text
//: TUI 表示幅計算、行 padding / clipping、折り返し helper
//:
//: ### 目的
//: - 端末上の表示幅に関わる pure text helper を、TTY ABI や行バッファ raw storage から分離します。
//: - ANSI/OSC8 制御列を幅 0 として扱う近似表示幅を共有し、box / buffer の幅処理を同じ仕様へ揃えます。

#indent 4

#import "core/math" as *
#import "core/result" as *
#import "alloc/string" as *
#import "alloc/collections/vec" as *
#import "alloc/collections/vec" as v

//: TuiStrPushRes: `Vec<str>` push の結果
//:
//: [目的/もくてき]:
//: - `text_wrap_lines` の行配列 owner と push 成否を同時に返します。
struct TuiStrPushRes:
    items <Vec<str>>
    ok <bool>

//: tui_empty_str_vec: 空の `Vec<str>` を作る
//:
//: [目的/もくてき]:
//: - allocation failure 時に consumed owner を再利用せず、空の折り返し結果へ切り替えます。
fn tui_empty_str_vec <()->Vec<str>> ():
    v::vec_empty<str>

//: tui_push_str: `Vec<str>` push を trap せず結果化する
fn tui_push_str <(Vec<str>,str)->TuiStrPushRes> (items, item):
    match v::push<str> items item:
        Result::Ok next:
            TuiStrPushRes next true
        Result::Err _e:
            TuiStrPushRes tui_empty_str_vec false

//: repeat_text: 文字列を指定回数だけ連結して返す
//:
//: [目的/もくてき]:
//: - 罫線や空白など、同じ文字列を繰り返す行生成を簡潔に記述します。
//:
//: [実装/じっそう]:
//: - `out` に対して `concat out s` を n 回繰り返します。
//:
//: [注意/ちゅうい]:
//: - `concat` の繰り返しなので、長大文字列ではコストが大きくなります。
//:
//: [計算量/けいさんりょう]:
//: - O(n^2)（文字列再確保の影響を含む）
fn repeat_text <(str,i32)*>str> (s, n):
    if:
        lt n 1
        then:
            ""
        else:
            let mut out <str> "";
            let mut i <i32> 0;
            while lt i n:
                do:
                    set out concat out s;
                    set i add i 1;
            out

fn str_byte_at <(str,i32)*>i32> (s, i):
    string_byte_at_unchecked s i

//: str_display_width: 文字列の表示幅を概算する
//:
//: [目的/もくてき]:
//: - 行の右パディングを行う際に、日本語を含む表示の崩れを減らします。
//:
//: [実装/じっそう]:
//: - UTF-8 の先頭バイトから文字境界を推定し、ASCII は幅1、非ASCIIは幅2で加算します。
//: - ANSI CSI（`ESC [`）と OSC8（`ESC ] ... ESC \\`）は幅0としてスキップします。
//:
//: [注意/ちゅうい]:
//: - 厳密な文字幅計算ではなく、端末依存差を含む近似です。
//: - ゼロ幅結合や一部絵文字の幅は環境ごとに差が出ます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn str_display_width <(str)*>i32> (s):
    let n <i32> len s;
    let mut i <i32> 0;
    let mut w <i32> 0;
    while lt i n:
        do:
            let b <i32> str_byte_at s i;
            if:
                eq b '\x1B'
                then:
                    let i1 <i32> add i 1;
                    if:
                        lt i1 n
                        then:
                            let n1 <i32> str_byte_at s i1;
                            // CSI は final byte まで幅 0 として読み飛ばします。
                            if:
                                eq n1 '['
                                then:
                                    set i add i 2;
                                    let mut done <bool> false;
                                    while and lt i n not done:
                                        do:
                                            let c <i32> str_byte_at s i;
                                            let is_final <bool> and ge c 64 lt c 127;
                                            if:
                                                is_final
                                                then:
                                                    set done true
                                                else:
                                                    ();
                                            set i add i 1;
                                else:
                                    // OSC8 は ST まで幅 0 として読み飛ばします。
                                    if:
                                        eq n1 ']'
                                        then:
                                            set i add i 2;
                                            let mut done2 <bool> false;
                                            while and lt i n not done2:
                                                do:
                                                    let c2 <i32> str_byte_at s i;
                                                    let i2 <i32> add i 1;
                                                    let has_next <bool> lt i2 n;
                                                    let is_esc_br <bool> and eq c2 '\x1B' and has_next eq str_byte_at s i2 '\\';
                                                    if:
                                                        is_esc_br
                                                        then:
                                                            set i add i 2;
                                                            set done2 true;
                                                        else:
                                                            set i add i 1;
                                        else:
                                            set i add i 1;
                        else:
                            set i add i 1;
                else:
                    if:
                        lt b 128
                        then:
                            set i add i 1;
                            set w add w 1;
                        else:
                            if:
                                and not lt b 240 lt b 248
                                then:
                                    set i add i 4;
                                    set w add w 2;
                                else:
                                    if:
                                        and not lt b 224 lt b 240
                                        then:
                                            set i add i 3;
                                            set w add w 2;
                                        else:
                                            if:
                                                and not lt b 192 lt b 224
                                                then:
                                                    set i add i 2;
                                                    set w add w 2;
                                                else:
                                                    set i add i 1;
                                                    set w add w 1;
    w

//: line_pad_to_cols: 行文字列を指定表示幅まで右側空白で埋める
//:
//: [目的/もくてき]:
//: - 以前の長い行が残る問題を防ぎ、行更新を安定させます。
//:
//: [実装/じっそう]:
//: - `str_display_width` で現在幅を求め、足りない分だけ空白を連結します。
//:
//: [注意/ちゅうい]:
//: - 入力が指定幅を超える場合は切り詰めず、そのまま返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn line_pad_to_cols <(str,i32)*>str> (s, cols):
    let w <i32> str_display_width s;
    if:
        lt w cols
        then:
            concat s repeat_text " " sub cols w
        else:
            s

//: line_clip_to_cols: 行文字列を指定表示幅以内に切り詰める
//:
//: [目的/もくてき]:
//: - 横幅制限がある領域へ安全に描画するため、表示幅ベースで文字列を切り詰めます。
//:
//: [実装/じっそう]:
//: - UTF-8 先頭バイトから 1文字ごとのバイト長と概算表示幅を求め、
//:   次の文字を追加すると `cols` を超える時点で切り出しを終了します。
//:
//: [注意/ちゅうい]:
//: - ANSI/OSC8 を含む文字列の厳密処理は対象外です（通常テキスト向け）。
//: - 幅計算は厳密な East Asian Width 判定ではなく近似です。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn line_clip_to_cols <(str,i32)*>str> (s, cols):
    if:
        lt cols 1
        then:
            ""
        else:
            let n <i32> len s;
            let mut i <i32> 0;
            let mut end <i32> 0;
            let mut w <i32> 0;
            let mut done <bool> false;
            while and lt i n not done:
                do:
                    let b <i32> str_byte_at s i;
                    let ch_len <i32> if:
                        lt b 128
                        then 1
                        else:
                            if:
                                and not lt b 240 lt b 248
                                then 4
                                else:
                                    if:
                                        and not lt b 224 lt b 240
                                        then 3
                                        else:
                                            if:
                                                and not lt b 192 lt b 224
                                                then 2
                                                else 1
                    let ch_w <i32> if lt b 128 1 2;
                    let next_w <i32> add w ch_w;
                    if:
                        lt cols next_w
                        then:
                            set done true
                        else:
                            set w next_w;
                            set i add i ch_len;
                            set end i;
            str_slice s 0 end

//: text_wrap_lines: 表示幅で折り返した行配列を作る
//:
//: [目的/もくてき]:
//: - 長文を端末上で読みやすく表示するため、表示幅単位で複数行へ折り返します。
//:
//: [実装/じっそう]:
//: - 改行文字 `\n` を明示的な行区切りとして扱います。
//: - それ以外は UTF-8 先頭バイトから文字幅を推定し、`cols` を超える前で折り返します。
//:
//: [注意/ちゅうい]:
//: - 幅計算は近似です。結合文字や一部絵文字は端末依存差が出ます。
//: - `cols <= 0` の場合は空配列を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn text_wrap_lines <(str,i32)*>Vec<str>> (text, cols):
    let mut out <Vec<str>> tui_empty_str_vec;
    let mut failed <bool> false;
    match v::new<str>:
        Result::Ok out0:
            set out out0
        Result::Err _e:
            set failed true;
    if:
        lt cols 1
        then:
            out
        else:
            let n <i32> len text;
            let mut i <i32> 0;
            let mut line_start <i32> 0;
            let mut line_w <i32> 0;
            while and lt i n not failed:
                do:
                    let b <i32> str_byte_at text i;
                    if:
                        eq b '\n'
                        then:
                            let ln <str> str_slice text line_start i;
                            let pushed_out <TuiStrPushRes> tui_push_str out ln;
                            let pushed_ok <bool> get pushed_out "ok";
                            set out get pushed_out "items";
                            if:
                                pushed_ok
                                then:
                                    set i add i 1;
                                    set line_start i;
                                    set line_w 0;
                                else:
                                    set failed true;
                                    ()
                        else:
                            let ch_len <i32> if:
                                lt b 128
                                then 1
                                else:
                                    if:
                                        and not lt b 240 lt b 248
                                        then 4
                                        else:
                                            if:
                                                and not lt b 224 lt b 240
                                                then 3
                                                else:
                                                    if:
                                                        and not lt b 192 lt b 224
                                                        then 2
                                                        else 1
                            let ch_w <i32> if lt b 128 1 2;
                            let next_w <i32> add line_w ch_w;
                            if:
                                lt cols next_w
                                then:
                                    if:
                                        eq i line_start
                                        then:
                                            let ln2 <str> str_slice text line_start add i ch_len;
                                            let pushed_out2 <TuiStrPushRes> tui_push_str out ln2;
                                            let pushed_ok2 <bool> get pushed_out2 "ok";
                                            set out get pushed_out2 "items";
                                            if:
                                                pushed_ok2
                                                then:
                                                    set i add i ch_len;
                                                    set line_start i;
                                                    set line_w 0;
                                                else:
                                                    set failed true;
                                                    ()
                                        else:
                                            let ln3 <str> str_slice text line_start i;
                                            let pushed_out3 <TuiStrPushRes> tui_push_str out ln3;
                                            let pushed_ok3 <bool> get pushed_out3 "ok";
                                            set out get pushed_out3 "items";
                                            if:
                                                pushed_ok3
                                                then:
                                                    set line_start i;
                                                    set line_w 0;
                                                else:
                                                    set failed true;
                                                    ()
                                else:
                                    set i add i ch_len;
                                    set line_w next_w;
            if:
                not failed
                then:
                    let tail <str> str_slice text line_start n;
                    let pushed_tail <TuiStrPushRes> tui_push_str out tail;
                    set out get pushed_tail "items";
                    ()
                else ()
            out
