//: # platforms/wasix/tui/text
//: TUI text helper の public facade
//:
//: ### 目的
//: - 端末表示幅の近似、padding / clipping、折り返し helper を既存の import path から公開します。
//: - 実装は repeat / width / line / wrap に分け、ANSI/OSC8 width handling と `Vec<str>` owner handling が同居しないようにします。
//:
//: ### 注意
//: - 表示幅計算は厳密な East Asian Width 判定ではなく、UTF-8 先頭バイトに基づく近似です。
//: - この facade には処理本体を置きません。

#indent 4

pub #import "./text/repeat" as @merge
pub #import "./text/width" as @merge
pub #import "./text/line" as @merge
pub #import "./text/wrap" as @merge
