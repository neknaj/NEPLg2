#indent 4

//: # span
//: NEPLg2.0 self-host compiler の source span [基盤/きばん]
//:
//: [目的/もくてき]:
//: - lexer / parser / diagnostic が[共有/きょうゆう]する source position を[定義/ていぎ]します。
//: - byte offset [基準/きじゅん]の `[start, end)` range と `file_id` を 1 [個/こ]の値として[扱/あつか]います。
//:
//: [注意/ちゅうい]:
//: - offset は UTF-8 文字数ではなく byte index です。
//: - 入力 byte 列が UTF-8 として[妥当/だとう]であることは CLI / source loading [境界/きょうかい]で[保証/ほしょう]します。
//:
//: [計算量/けいさんりょう]:
//: - span の[構築/こうちく]と[判定/はんてい]は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "neplg2/core/infra/span" as *
//: fn main <()->i32> ():
//:     let s <SelfhostSourceSpan> source_span_new 0 2 5
//:     if and source_span_is_valid s and source_span_contains s 3 eq source_span_len s 3 0 1
//: ```

#import "core/field" as field
#import "core/math" as *
#import "core/traits/copy" as *
#import "core/field" as *

//: SelfhostSourceSpan: source file [内/ない]の byte range
//:
//: [目的/もくてき]:
//: - `file_id` と `[start, end)` を[保持/ほじ]し、diagnostic label と token span の[共通/きょうつう]表現にします。
pub struct SelfhostSourceSpan:
    file_id <i32>
    start <i32>
    end <i32>

impl Clone for SelfhostSourceSpan:
    fn clone <(&SelfhostSourceSpan)->SelfhostSourceSpan> (self):
        *self

impl Copy for SelfhostSourceSpan:
    fn copy_mark <(SelfhostSourceSpan)->SelfhostSourceSpan> (self):
        self

//: source_span_new: source range を[作/つく]る
//:
//: [注意/ちゅうい]:
//: - `start <= end` の[検査/けんさ]は `source_span_is_valid` で[行/おこな]います。
pub fn source_span_new <(i32,i32,i32)->SelfhostSourceSpan> (file_id, start, end):
    SelfhostSourceSpan file_id start end

//: source_span_empty: 0 byte range を[作/つく]る
pub fn source_span_empty <(i32,i32)->SelfhostSourceSpan> (file_id, offset):
    source_span_new file_id offset offset

//: source_span_len: byte range の[長/なが]さを[返/かえ]す
pub fn source_span_len <(SelfhostSourceSpan)->i32> (span):
    sub field::get span "end" field::get span "start"

//: source_span_is_valid: range が[負/ふ]でなく[逆転/ぎゃくてん]していないか[返/かえ]す
pub fn source_span_is_valid <(SelfhostSourceSpan)->bool> (span):
    let start <i32> field::get span "start"
    let end <i32> field::get span "end"
    and ge start 0 ge end start

//: source_span_contains: byte offset が range [内/ない]か[返/かえ]す
pub fn source_span_contains <(SelfhostSourceSpan,i32)->bool> (span, offset):
    let start <i32> field::get span "start"
    let end <i32> field::get span "end"
    and le start offset lt offset end

//: source_span_join: 2 [個/こ]の span を[覆/おお]う span を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - `file_id` は左側の span を[採用/さいよう]します。異なる file の join は parser [側/がわ]で[避/さ]けます。
pub fn source_span_join <(SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostSourceSpan> (left, right):
    let file_id <i32> field::get left "file_id"
    let left_start <i32> field::get left "start"
    let left_end <i32> field::get left "end"
    let right_start <i32> field::get right "start"
    let right_end <i32> field::get right "end"
    let start <i32> if lt left_start right_start left_start right_start
    let end <i32> if lt left_end right_end right_end left_end
    source_span_new file_id start end

//: selfhost_span_stage0: Stage 0 marker 互換の smoke API
//:
//: [目的/もくてき]:
//: - 既存の Stage 0 doctest import 経路を[保/たも]ちながら、実 span 実装が[動/うご]くことも[確認/かくにん]します。
pub fn selfhost_span_stage0 <()->i32> ():
    let s <SelfhostSourceSpan> source_span_new 0 1 3
    if source_span_is_valid s 0 1
