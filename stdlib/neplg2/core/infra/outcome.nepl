#indent 4

//: # outcome
//: NEPLg2.0 self-host compiler の diagnostic [付/つ]き Result [基盤/きばん]
//:
//: [目的/もくてき]:
//: - parser / resolver / checker のように、[成否/せいひ]と diagnostic [列/れつ]を[同時/どうじ]に[返/かえ]る stage の[共通/きょうつう] return [型/かた]を[定義/ていぎ]します。
//: - `Result<T,E>` と `SelfhostDiagnostics` を[分離/ぶんり]して[保持/ほじ]し、error 以外の warning / info も[失/うしな]わずに[運/はこ]びます。
//:
//: [実装/じっそう]:
//: - `SelfhostOutcome<T,E>` は result を owned field として[保持/ほじ]し、diagnostics と[分離/ぶんり]して[運/はこ]びます。
//: - empty diagnostics を[作/つく]る API は diagnostics buffer の allocation failure を `Result::Err StdErrorKind::OutOfMemory` で[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - `selfhost_outcome_result` は outcome を[消費/しょうひ]し、diagnostics buffer を[解放/かいほう]してから result を[返/かえ]します。
//: - `selfhost_outcome_free` と diagnostics [追加/ついか][失敗/しっぱい][経路/けいろ]は、payload cleanup callback を[受/う]け[取/と]って storage 解放前に[実行/じっこう]します。
//: - diagnostics を[読/よ]みたい場合は、result を[取/と]り[出/だ]す[前/まえ]に `selfhost_outcome_diagnostics_len` / `selfhost_outcome_has_errors` を[呼/よ]びます。
//:
//: [計算量/けいさんりょう]:
//: - outcome [構築/こうちく]は O(1) です。empty diagnostics を[作/つく]る場合は Vec [確保/かくほ]に[依存/いそん]します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/outcome" as *
//: fn main %impure fn () i32 \():
//:     match selfhost_outcome_ok<i32,str> 7:
//:         Result::Ok outcome:
//:             match selfhost_outcome_result outcome:
//:                 Result::Ok value:
//:                     if eq value 7 0 1
//:                 Result::Err _e:
//:                     1
//:         Result::Err _e:
//:             1
//: ```

#import "core/field" as field
#import "core/result" as *
#import "neplg2/core/infra/diag" as *
#import "core/field" as *
#import "core/math" as *

//: SelfhostOutcome: Result と diagnostic collection を[一緒/いっしょ]に[運/はこ]ぶ値
pub struct SelfhostOutcome<.T, .E>:
    result %Result .T .E
    diagnostics %SelfhostDiagnostics

//: selfhost_outcome_drop_result_payload: result payload cleanup callback を[実行/じっこう]する
//:
//: [目的/もくてき]:
//: - outcome を result として[取/と]り[出/だ]さずに[捨/す]てる[経路/けいろ]で、Ok / Err payload を caller 指定の cleanup に[渡/わた]します。
//:
//: [実装/じっそう]:
//: - owned field の `Result<T,E>` を match し、payload binding として[所有権/しょゆうけん]を[受/う]けます。
//: - Ok payload には `drop_ok`、Err payload には `drop_err` を[呼/よ]びます。callback は payload を[消費/しょうひ]します。
//:
//: [注意/ちゅうい]:
//: - この関数は result を[消費/しょうひ]します。呼び[出/だ]し[側/がわ]は同じ result を[返/かえ]してはいけません。
pub fn selfhost_outcome_drop_result_payload <.T, .E> %impure fn Result .T .E impure fn impure fn .T () impure fn impure fn .E () () \result\drop_ok\drop_err:
    match result:
        Result::Ok value:
            drop_ok value
        Result::Err err_value:
            drop_err err_value

//: selfhost_outcome_ignore_i32: i32 payload を no-op で[消費/しょうひ]する cleanup callback
pub fn selfhost_outcome_ignore_i32 %impure fn i32 () \value:
    ()

//: selfhost_outcome_ignore_str: str payload を no-op で[消費/しょうひ]する cleanup callback
pub fn selfhost_outcome_ignore_str %impure fn str () \value:
    ()

//: selfhost_outcome_new: result と diagnostics から outcome を[作/つく]る
pub fn selfhost_outcome_new <.T, .E> %fn Result .T .E fn SelfhostDiagnostics Result SelfhostOutcome .T .E StdErrorKind \result\diagnostics:
    Result<SelfhostOutcome<.T, .E>, StdErrorKind>::Ok SelfhostOutcome<.T, .E> result diagnostics

//: selfhost_outcome_from_result: Result に empty diagnostics を[付/つ]けて outcome へ[昇格/しょうかく]する
pub fn selfhost_outcome_from_result <.T, .E> %fn Result .T .E Result SelfhostOutcome .T .E StdErrorKind \result:
    match selfhost_diagnostics_new:
        Result::Ok diagnostics:
            selfhost_outcome_new<.T, .E> result diagnostics
        Result::Err e:
            Result<SelfhostOutcome<.T, .E>, StdErrorKind>::Err e

//: selfhost_outcome_ok: success result と empty diagnostics を[持/も]つ outcome を[作/つく]る
pub fn selfhost_outcome_ok <.T, .E> %fn .T Result SelfhostOutcome .T .E StdErrorKind \value:
    selfhost_outcome_from_result<.T, .E> Result<.T, .E>::Ok value

//: selfhost_outcome_err: error result と empty diagnostics を[持/も]つ outcome を[作/つく]る
pub fn selfhost_outcome_err <.T, .E> %fn .E Result SelfhostOutcome .T .E StdErrorKind \err_value:
    selfhost_outcome_from_result<.T, .E> Result<.T, .E>::Err err_value

//: selfhost_outcome_with_diagnostics: diagnostics を[差/さ]し[替/か]えた outcome を[作/つく]る
//:
//: [注意/ちゅうい]:
//: - 古い diagnostics buffer はこの関数が[解放/かいほう]します。
pub fn selfhost_outcome_with_diagnostics <.T, .E> %impure fn SelfhostOutcome .T .E impure fn SelfhostDiagnostics SelfhostOutcome .T .E \outcome\diagnostics:
    let result %Result .T .E field::get outcome "result"
    let old_diagnostics %SelfhostDiagnostics field::get outcome "diagnostics"
    selfhost_diagnostics_free old_diagnostics
    SelfhostOutcome<.T, .E> result diagnostics

//: selfhost_outcome_push_diagnostic: outcome の diagnostics に 1 [件/けん][追加/ついか]する
pub fn selfhost_outcome_push_diagnostic <.T, .E> %impure fn SelfhostOutcome .T .E impure fn SelfhostDiagnostic impure fn impure fn .T () impure fn impure fn .E () Result SelfhostOutcome .T .E StdErrorKind \outcome\diag\drop_ok\drop_err:
    let result %Result .T .E field::get outcome "result"
    let diagnostics %SelfhostDiagnostics field::get outcome "diagnostics"
    match selfhost_diagnostics_push diagnostics diag:
        Result::Ok next_diagnostics:
            Result<SelfhostOutcome<.T, .E>, StdErrorKind>::Ok SelfhostOutcome<.T, .E> result next_diagnostics
        Result::Err e:
            selfhost_outcome_drop_result_payload<.T, .E> result drop_ok drop_err
            Result<SelfhostOutcome<.T, .E>, StdErrorKind>::Err e

//: selfhost_outcome_diagnostics_len: outcome が[保持/ほじ]する diagnostic [件数/けんすう]を[返/かえ]す
pub fn selfhost_outcome_diagnostics_len <.T, .E> %fn &SelfhostOutcome .T .E i32 \outcome:
    let diagnostics %&SelfhostDiagnostics field::get_ref outcome "diagnostics"
    selfhost_diagnostics_len diagnostics

//: selfhost_outcome_has_errors: outcome の diagnostics に error が[含/ふく]まれるか[返/かえ]す
pub fn selfhost_outcome_has_errors <.T, .E> %fn &SelfhostOutcome .T .E bool \outcome:
    let diagnostics %&SelfhostDiagnostics field::get_ref outcome "diagnostics"
    selfhost_diagnostics_has_errors diagnostics

//: selfhost_outcome_result: diagnostics を[解放/かいほう]し、Result を[取/と]り[出/だ]す
pub fn selfhost_outcome_result <.T, .E> %impure fn SelfhostOutcome .T .E Result .T .E \outcome:
    let result %Result .T .E field::get outcome "result"
    let diagnostics %SelfhostDiagnostics field::get outcome "diagnostics"
    selfhost_diagnostics_free diagnostics
    result

//: selfhost_outcome_free: result payload と diagnostics を[解放/かいほう]する
pub fn selfhost_outcome_free <.T, .E> %impure fn SelfhostOutcome .T .E impure fn impure fn .T () impure fn impure fn .E () () \outcome\drop_ok\drop_err:
    let result %Result .T .E selfhost_outcome_result<.T, .E> outcome
    selfhost_outcome_drop_result_payload<.T, .E> result drop_ok drop_err

//: selfhost_outcome_stage0: outcome [基盤/きばん]の smoke API
pub fn selfhost_outcome_stage0 %impure fn () i32 \():
    match selfhost_outcome_ok<i32,str> 1:
        Result::Ok outcome:
            let n %i32 selfhost_outcome_diagnostics_len<i32,str> &outcome
            match selfhost_outcome_result<i32,str> outcome:
                Result::Ok value:
                    if and eq n 0 eq value 1 0 1
                Result::Err _e:
                    1
        Result::Err _e:
            1
