#indent 4

//: # text
//: NEPLg2.0 self-host compiler の source text / line map [基盤/きばん]
//:
//: [目的/もくてき]:
//: - lexer が[返/かえ]す byte span を、diagnostic と parser recovery が[使/つか]う line / column へ[変換/へんかん]します。
//: - `SourceText` が source [文字列/もじれつ]と line start table を[保持/ほじ]し、各 stage が source を[個別/こべつ]に[再走査/さいそうさ]しないようにします。
//:
//: [実装/じっそう]:
//: - line start table は 0-origin の byte offset を[昇順/しょうじゅん]に[保持/ほじ]する `Vec<i32>` です。
//: - LF / CRLF / CR を newline として[扱/あつか]い、line span は newline byte を[除/のぞ]いた `[start, end)` を[返/かえ]します。
//:
//: [注意/ちゅうい]:
//: - offset / column は UTF-8 byte index です。Unicode scalar 数ではありません。
//: - filesystem と stdio には[依存/いぞん]しません。CLI 層は UTF-8 [検証済/けんしょうず]みの `str` をここへ[渡/わた]します。
//:
//: [計算量/けいさんりょう]:
//: - `source_text_new` は source byte 数 n に対して O(n) 時間、line 数 l に対して O(l) 領域です。
//: - offset から location への[変換/へんかん]は line 数 l に対して O(log l) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "neplg2/core/infra/text" as *
//: fn main %impure fn unit i32 \unit:
//:     match source_text_new 0 "smoke.nepl" "a\nb":
//:         Result::Ok text:
//:             let count %i32 source_text_line_count &text
//:             source_text_free text
//:             if eq count 2 0 1
//:         Result::Err _e:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/access" as string_access
#import "alloc/string/byte_index" as string_byte_index
#import "core/field" as field
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "core/field" as *

fn source_text_byte_or_end %fn str fn i32 i32 \source\idx:
    match string_byte_index::checked_string_byte_at source idx:
        Option::Some b:
            b
        Option::None:
            -1

//: SelfhostSourceText: 1 [入力/にゅうりょく] source と line start table
//:
//: [目的/もくてき]:
//: - `file_id`、[表示用/ひょうじよう] path、source [本文/ほんぶん]、line start table を 1 [値/あたい]として[扱/あつか]います。
//:
//: [注意/ちゅうい]:
//: - `line_starts` の[所有権/しょゆうけん]を[持/も]つため、[使/つか]い[終/お]わったら `source_text_free` を[呼/よ]びます。
pub struct SelfhostSourceText:
    file_id %i32
    path %str
    source %str
    line_starts %Vec i32

//: SelfhostSourceLocation: source byte offset に[対応/たいおう]する line / column
//:
//: [目的/もくてき]:
//: - diagnostic renderer が span の[開始/かいし]位置を[表示/ひょうじ]できるよう、0-origin line / column を[保持/ほじ]します。
pub struct SelfhostSourceLocation:
    file_id %i32
    offset %i32
    line %i32
    column %i32

//: SourceTextLineStartPushState: line start 追加結果の[状態/じょうたい]
//:
//: [目的/もくてき]:
//: - `Vec::push` が成功したか失敗したかを、呼び出し側の loop へ enum と returned owner で明示します。
pub enum SourceTextLineStartPushState:
    Ok
    Err

//: SourceTextLineStartPush: line start 追加後に loop へ戻す owner と状態
//:
//: [目的/もくてき]:
//: - 成功時は追加済み Vec、失敗時は `VecPushError` に戻された入力 Vec を返し、loop 変数を常に再初期化できるようにします。
pub struct SourceTextLineStartPush:
    state %SourceTextLineStartPushState
    starts %Vec i32

impl Clone for SelfhostSourceLocation:
    fn clone %fn &SelfhostSourceLocation SelfhostSourceLocation \self:
        *self

impl Copy for SelfhostSourceLocation:
    fn copy_mark %fn SelfhostSourceLocation SelfhostSourceLocation \self:
        self

//: source_text_next_index_after_cr: CR または CRLF の次 byte offset を[返/かえ]す
//:
//: [目的/もくてき]:
//: - line map 構築時に、CRLF を 1 つの改行として[扱/あつか]い、CR 単独も改行として[扱/あつか]います。
//:
//: [注意/ちゅうい]:
//: - idx は `'\r'` を指している前提です。返る offset は次の line start です。
pub fn source_text_next_index_after_cr %fn str fn i32 fn i32 i32 \source\n\idx:
    let next_idx %i32 add idx 1
    if:
        lt next_idx n
        then:
            let next_ch %i32 source_text_byte_or_end source next_idx
            match next_ch:
                '\n':
                    add idx 2
                _:
                    next_idx
        else:
            next_idx

//: source_text_push_line_start: line start offset を Vec に[追加/ついか]し、loop 用 outcome を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `Vec::push` は consuming API なので、while loop の accumulator へ戻す owner を成功/失敗の両方で明示します。
//: - 失敗時、`Vec::push` が返した入力 Vec owner を保持し、呼び出し側が cleanup できるようにします。
pub fn source_text_push_line_start %fn Vec i32 fn i32 SourceTextLineStartPush \starts\offset:
    match v::push<i32> starts offset:
        Result::Ok next_starts:
            SourceTextLineStartPush SourceTextLineStartPushState::Ok next_starts
        Result::Err e:
            SourceTextLineStartPush SourceTextLineStartPushState::Err v::vec_push_error_vec e

//: source_text_collect_line_starts: source を 1 [回/かい][走査/そうさ]して line start table を[作/つく]る
//:
//: [実装/じっそう]:
//: - source byte を while で前から 1 回だけ[走査/そうさ]します。
//: - LF / CR / CRLF を[見/み]つけたときだけ次 line start を `Vec<i32>` へ[追加/ついか]します。
//:
//: [注意/ちゅうい]:
//: - allocation failure は `Result::Err StdErrorKind::OutOfMemory` として[返/かえ]します。
pub fn source_text_collect_line_starts %fn str fn i32 fn i32 fn Vec i32 Result Vec i32 StdErrorKind \source\n\idx\starts:
    let mut i %i32 idx
    let mut out %Vec i32 starts
    let mut failed %bool false
    while and lt i n not failed:
        do:
            let ch %i32 source_text_byte_or_end source i
            match ch:
                '\n':
                    let pushed %SourceTextLineStartPush source_text_push_line_start out add i 1
                    let push_state %SourceTextLineStartPushState field::get pushed "state"
                    let next_out %Vec i32 field::get pushed "starts"
                    match push_state:
                        SourceTextLineStartPushState::Ok:
                            set out next_out
                            set i add i 1
                        SourceTextLineStartPushState::Err:
                            set out next_out
                            set failed true
                '\r':
                    let next_idx %i32 source_text_next_index_after_cr source n i
                    let pushed %SourceTextLineStartPush source_text_push_line_start out next_idx
                    let push_state %SourceTextLineStartPushState field::get pushed "state"
                    let next_out %Vec i32 field::get pushed "starts"
                    match push_state:
                        SourceTextLineStartPushState::Ok:
                            set out next_out
                            set i next_idx
                        SourceTextLineStartPushState::Err:
                            set out next_out
                            set failed true
                _:
                    set i add i 1
    if:
        failed
        then:
            v::free out
            Result::Err StdErrorKind::OutOfMemory
        else:
            Result::Ok out

//: source_text_new: source text と line map を[作/つく]る
//:
//: [目的/もくてき]:
//: - CLI / test harness が[読/よ]み[込/こ]んだ 1 [入力/にゅうりょく] source を compiler core の[共通/きょうつう] text [表現/ひょうげん]へ[変換/へんかん]します。
//:
//: [注意/ちゅうい]:
//: - `path` は diagnostic [表示用/ひょうじよう]の[名前/なまえ]です。filesystem へは[接続/せつぞく]しません。
pub fn source_text_new %fn i32 fn str fn str Result SelfhostSourceText StdErrorKind \file_id\path\source:
    match v::filled<i32> 1 0:
        Result::Ok starts:
            let n %i32 string_access::len source
            match source_text_collect_line_starts source n 0 starts:
                Result::Ok line_starts:
                    Result::Ok SelfhostSourceText file_id path source line_starts
                Result::Err e:
                    Result::Err e
        Result::Err _e:
            Result::Err StdErrorKind::OutOfMemory

//: source_text_free: line start table を[解放/かいほう]する
pub fn source_text_free %fn SelfhostSourceText unit \text:
    v::free field::get text "line_starts"

//: source_text_len: source [本文/ほんぶん]の byte [長/ちょう]を[返/かえ]す
pub fn source_text_len %fn &SelfhostSourceText i32 \text:
    string_access::len *field::get_ref text "source"

//: source_text_line_count: line start table の[要素数/ようそすう]を[返/かえ]す
pub fn source_text_line_count %fn &SelfhostSourceText i32 \text:
    let starts %&Vec i32 field::get_ref text "line_starts"
    v::len starts

//: source_text_line_start: line index の[開始/かいし] byte offset を[返/かえ]す
pub fn source_text_line_start %fn &SelfhostSourceText fn i32 Option i32 \text\line:
    let starts %&Vec i32 field::get_ref text "line_starts"
    if:
        lt line 0
        then:
            none
        else:
            v::get starts line

//: source_text_line_index_search: offset を[含/ふく]む line index を binary search で[探/さが]す
//:
//: [注意/ちゅうい]:
//: - `offset` が source [長/ちょう]以内であることは[呼/よ]び[出/だ]し[側/がわ]で[確認/かくにん]します。
pub fn source_text_line_index_search %fn &Vec i32 fn i32 fn i32 fn i32 fn i32 i32 \starts\offset\low\high\best:
    if:
        ge low high
        then:
            best
        else:
            let mid %i32 div_s add low high 2
            match v::get starts mid:
                Option::Some start:
                    if:
                        le start offset
                        then:
                            source_text_line_index_search starts offset add mid 1 high mid
                        else:
                            source_text_line_index_search starts offset low mid best
                Option::None:
                    best

//: source_text_line_index_for_offset: byte offset の line index を[返/かえ]す
pub fn source_text_line_index_for_offset %fn &SelfhostSourceText fn i32 Option i32 \text\offset:
    let n %i32 source_text_len text
    if:
        or lt offset 0 gt offset n
        then:
            none
        else:
            let starts %&Vec i32 field::get_ref text "line_starts"
            let count %i32 v::len starts
            some source_text_line_index_search starts offset 0 count 0

//: source_text_trim_line_end: newline byte を[除/のぞ]いた line end を[返/かえ]す
pub fn source_text_trim_line_end %fn str fn i32 fn i32 i32 \source\start\raw_end:
    if:
        le raw_end start
        then:
            raw_end
        else:
            let last_idx %i32 sub raw_end 1
            let last %i32 source_text_byte_or_end source last_idx
            match last:
                '\n':
                    if:
                        le last_idx start
                        then:
                            last_idx
                        else:
                            let prev_idx %i32 sub last_idx 1
                            let prev %i32 source_text_byte_or_end source prev_idx
                            match prev:
                                '\r':
                                    prev_idx
                                _:
                                    last_idx
                '\r':
                    last_idx
                _:
                    raw_end

//: source_text_next_line_start_or_len: [次/つぎ]の line start、なければ source [長/ちょう]を[返/かえ]す
pub fn source_text_next_line_start_or_len %fn &Vec i32 fn i32 fn i32 i32 \starts\next_line\n:
    match v::get starts next_line:
        Option::Some start:
            start
        Option::None:
            n

//: source_text_line_span: line index の source span を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 返す span の end は newline byte を[含/ふく]みません。
pub fn source_text_line_span %fn &SelfhostSourceText fn i32 Option SelfhostSourceSpan \text\line:
    let starts %&Vec i32 field::get_ref text "line_starts"
    let count %i32 v::len starts
    if:
        or lt line 0 ge line count
        then:
            none
        else:
            match v::get starts line:
                Option::Some start:
                    let source %str *field::get_ref text "source"
                    let file_id %i32 *field::get_ref text "file_id"
                    let n %i32 string_access::len source
                    let raw_end %i32 source_text_next_line_start_or_len starts add line 1 n
                    let end %i32 source_text_trim_line_end source start raw_end
                    some source_span_new file_id start end
                Option::None:
                    none

//: source_text_location_for_offset: byte offset を line / column へ[変換/へんかん]する
//:
//: [注意/ちゅうい]:
//: - `offset == len(source)` は EOF [位置/いち]として[有効/ゆうこう]です。
pub fn source_text_location_for_offset %fn &SelfhostSourceText fn i32 Option SelfhostSourceLocation \text\offset:
    match source_text_line_index_for_offset text offset:
        Option::Some line:
            match source_text_line_start text line:
                Option::Some start:
                    let file_id %i32 *field::get_ref text "file_id"
                    some SelfhostSourceLocation file_id offset line sub offset start
                Option::None:
                    none
        Option::None:
            none

//: selfhost_text_stage0: source text [基盤/きばん]の smoke API
pub fn selfhost_text_stage0 %impure fn unit i32 \unit:
    match source_text_new 0 "stage0.nepl" "a\nb":
        Result::Ok text:
            let count %i32 source_text_line_count &text
            source_text_free text
            if eq count 2 0 1
        Result::Err _e:
            1
