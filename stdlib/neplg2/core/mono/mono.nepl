#indent 4

//: # mono
//: NEPLg2.0 の monomorphize stage を置くモジュールです。
//:
//: [目的/もくてき]:
//: - generic instance cache、name mangling、trait impl selection の最終解決をここに集約します。
//: - generic function の元定義、type argument table の範囲、instance id を typed value として扱います。
//: - 後続の cache / codegen が同じ key と deterministic seed を使えるようにします。
//:
//: [実装/じっそう]:
//: - `SelfhostMonoDefId` は module 内 function を `(module_index, function_index)` で表します。
//: - `SelfhostMonoTypeArgRange` は type argument table の連続範囲を表します。空範囲は `first_arg = 0, arg_count = 0` です。
//: - `SelfhostMonoInstanceKey` は generic instance cache の lookup key です。
//: - `selfhost_mono_instance_key_seed` は key から symbol suffix / cache bucket 用の deterministic seed を作ります。
//:
//: [注意/ちゅうい]:
//: - ここでは key の値モデルだけを定義します。cache storage、trait impl lookup、実際の HIR 複製は別 issue で追加します。
//: - seed は同一 process / 同一 source で安定する非暗号 hash です。衝突時は `selfhost_mono_instance_key_eq` で実 key を比較してください。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: key の作成、比較、seed 計算はいずれも O(1)
//: - [空間/くうかん]: O(1)
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "neplg2/core/mono/mono" as *
//: fn main <()->i32> ():
//:     selfhost_mono_stage0
//: ```

#import "core/math" as *
#import "core/option" as *
#import "core/traits/copy" as *

//: SelfhostMonoDefId: monomorphize 対象の元 function 定義
//:
//: [目的/もくてき]:
//: - module graph / HIR の table index を組にして、generic instance の元定義を安定参照します。
//:
//: [注意/ちゅうい]:
//: - index は self-host compiler 内の arena-local 値です。Rust compiler の global DefId とは混ぜないでください。
pub struct SelfhostMonoDefId:
    module_index <i32>
    function_index <i32>

impl Clone for SelfhostMonoDefId:
    fn clone <(&SelfhostMonoDefId)->SelfhostMonoDefId> (self):
        *self

impl Copy for SelfhostMonoDefId:
    fn copy_mark <(SelfhostMonoDefId)->SelfhostMonoDefId> (self):
        self

//: SelfhostMonoTypeArgRange: instance key が参照する type argument table 範囲
//:
//: [目的/もくてき]:
//: - type argument の実体を key struct に複製せず、arena/table 上の連続範囲として扱います。
//:
//: [注意/ちゅうい]:
//: - `arg_count = 0` の場合も canonical empty range として `first_arg = 0` を使います。
pub struct SelfhostMonoTypeArgRange:
    first_arg <i32>
    arg_count <i32>

impl Clone for SelfhostMonoTypeArgRange:
    fn clone <(&SelfhostMonoTypeArgRange)->SelfhostMonoTypeArgRange> (self):
        *self

impl Copy for SelfhostMonoTypeArgRange:
    fn copy_mark <(SelfhostMonoTypeArgRange)->SelfhostMonoTypeArgRange> (self):
        self

//: SelfhostMonoInstanceKey: generic instance cache の lookup key
//:
//: [目的/もくてき]:
//: - 元 function と type argument 範囲を 1 つの key にまとめ、cache / name mangling / codegen が同じ identity を共有できるようにします。
pub struct SelfhostMonoInstanceKey:
    def <SelfhostMonoDefId>
    type_args <SelfhostMonoTypeArgRange>

impl Clone for SelfhostMonoInstanceKey:
    fn clone <(&SelfhostMonoInstanceKey)->SelfhostMonoInstanceKey> (self):
        *self

impl Copy for SelfhostMonoInstanceKey:
    fn copy_mark <(SelfhostMonoInstanceKey)->SelfhostMonoInstanceKey> (self):
        self

//: SelfhostMonoInstanceId: monomorphize instance table 内の stable index
pub struct SelfhostMonoInstanceId:
    index <i32>

impl Clone for SelfhostMonoInstanceId:
    fn clone <(&SelfhostMonoInstanceId)->SelfhostMonoInstanceId> (self):
        *self

impl Copy for SelfhostMonoInstanceId:
    fn copy_mark <(SelfhostMonoInstanceId)->SelfhostMonoInstanceId> (self):
        self

//: selfhost_mono_def_id_new: 元 function 定義 ID を作る
pub fn selfhost_mono_def_id_new <(i32,i32)->SelfhostMonoDefId> (module_index, function_index):
    SelfhostMonoDefId module_index function_index

//: selfhost_mono_def_id_is_valid: 元 function 定義 ID が有効範囲か判定する
pub fn selfhost_mono_def_id_is_valid <(SelfhostMonoDefId)->bool> (def):
    and ge def.module_index 0 ge def.function_index 0

//: selfhost_mono_type_arg_range_new: type argument table 範囲を作る
pub fn selfhost_mono_type_arg_range_new <(i32,i32)->SelfhostMonoTypeArgRange> (first_arg, arg_count):
    SelfhostMonoTypeArgRange first_arg arg_count

//: selfhost_mono_type_arg_range_empty: canonical empty type argument 範囲を返す
pub fn selfhost_mono_type_arg_range_empty <()->SelfhostMonoTypeArgRange> ():
    selfhost_mono_type_arg_range_new 0 0

//: selfhost_mono_type_arg_range_is_valid: type argument table 範囲が有効か判定する
pub fn selfhost_mono_type_arg_range_is_valid <(SelfhostMonoTypeArgRange)->bool> (range):
    and ge range.first_arg 0 ge range.arg_count 0

//: selfhost_mono_instance_key_new: generic instance key を作る
pub fn selfhost_mono_instance_key_new <(SelfhostMonoDefId,SelfhostMonoTypeArgRange)->SelfhostMonoInstanceKey> (def, type_args):
    SelfhostMonoInstanceKey def type_args

//: selfhost_mono_instance_key_is_valid: instance key が有効な index 範囲だけを持つか判定する
pub fn selfhost_mono_instance_key_is_valid <(SelfhostMonoInstanceKey)->bool> (key):
    and selfhost_mono_def_id_is_valid key.def selfhost_mono_type_arg_range_is_valid key.type_args

//: selfhost_mono_instance_key_eq: instance key の完全一致を判定する
pub fn selfhost_mono_instance_key_eq <(SelfhostMonoInstanceKey,SelfhostMonoInstanceKey)->bool> (a, b):
    let a_def <SelfhostMonoDefId> a.def
    let b_def <SelfhostMonoDefId> b.def
    let a_args <SelfhostMonoTypeArgRange> a.type_args
    let b_args <SelfhostMonoTypeArgRange> b.type_args
    and:
        and eq a_def.module_index b_def.module_index eq a_def.function_index b_def.function_index
        and eq a_args.first_arg b_args.first_arg eq a_args.arg_count b_args.arg_count

//: selfhost_mono_instance_id_new: instance table ID を作る
pub fn selfhost_mono_instance_id_new <(i32)->SelfhostMonoInstanceId> (index):
    SelfhostMonoInstanceId index

//: selfhost_mono_instance_id_index: instance table index を返す
pub fn selfhost_mono_instance_id_index <(SelfhostMonoInstanceId)->i32> (instance_id):
    instance_id.index

//: selfhost_mono_instance_id_pending: instance がまだ割り当てられていない状態を返す
//:
//: [目的/もくてき]:
//: - 未割り当てを `SelfhostMonoInstanceId(-1)` ではなく `Option::None` として表します。
pub fn selfhost_mono_instance_id_pending <()->Option<SelfhostMonoInstanceId>> ():
    none<SelfhostMonoInstanceId>

//: selfhost_mono_instance_id_assigned: 割り当て済み instance ID を Option に包む
//:
//: [目的/もくてき]:
//: - cache lookup の結果が存在する場合だけ `SelfhostMonoInstanceId` を payload として保持します。
pub fn selfhost_mono_instance_id_assigned <(SelfhostMonoInstanceId)->Option<SelfhostMonoInstanceId>> (instance_id):
    some<SelfhostMonoInstanceId> instance_id

//: selfhost_mono_seed_mix: mangle seed 用の 32-bit mixing step
//:
//: [目的/もくてき]:
//: - key の各 field を順に混ぜ、name mangling と cache bucket で使う deterministic seed を作ります。
//:
//: [注意/ちゅうい]:
//: - 非暗号 hash です。identity 判定には必ず full key comparison を使ってください。
pub fn selfhost_mono_seed_mix <(i32,i32)->i32> (seed, value):
    let h0 <i32> xor seed add value -1640531527
    let h1 <i32> mul h0 -2048144789
    let h2 <i32> xor h1 shr_u h1 13
    let h3 <i32> mul h2 -1028477387
    xor h3 shr_u h3 16

//: selfhost_mono_instance_key_seed: instance key から deterministic mangle seed を作る
pub fn selfhost_mono_instance_key_seed <(SelfhostMonoInstanceKey)->i32> (key):
    let def <SelfhostMonoDefId> key.def
    let args <SelfhostMonoTypeArgRange> key.type_args
    let s0 <i32> selfhost_mono_seed_mix -2128831035 def.module_index
    let s1 <i32> selfhost_mono_seed_mix s0 def.function_index
    let s2 <i32> selfhost_mono_seed_mix s1 args.first_arg
    selfhost_mono_seed_mix s2 args.arg_count

//: selfhost_mono_stage0: mono key model の smoke API
pub fn selfhost_mono_stage0 <()->i32> ():
    let def0 <SelfhostMonoDefId> selfhost_mono_def_id_new 2 5
    let range0 <SelfhostMonoTypeArgRange> selfhost_mono_type_arg_range_new 9 3
    let key0 <SelfhostMonoInstanceKey> selfhost_mono_instance_key_new def0 range0
    let key1 <SelfhostMonoInstanceKey> selfhost_mono_instance_key_new (selfhost_mono_def_id_new 2 5) (selfhost_mono_type_arg_range_new 9 3)
    let key2 <SelfhostMonoInstanceKey> selfhost_mono_instance_key_new (selfhost_mono_def_id_new 2 6) range0
    let seed0 <i32> selfhost_mono_instance_key_seed key0
    let seed1 <i32> selfhost_mono_instance_key_seed key1
    let seed2 <i32> selfhost_mono_instance_key_seed key2
    let instance_id <SelfhostMonoInstanceId> selfhost_mono_instance_id_new 7
    let pending <Option<SelfhostMonoInstanceId>> selfhost_mono_instance_id_pending
    let assigned <Option<SelfhostMonoInstanceId>> selfhost_mono_instance_id_assigned instance_id
    let assigned_ok <bool>:
        match assigned:
            Option::Some assigned_id:
                eq 7 selfhost_mono_instance_id_index assigned_id
            Option::None:
                false
    let ok <bool>:
        and:
            and selfhost_mono_instance_key_is_valid key0 selfhost_mono_instance_key_eq key0 key1
            and:
                and not selfhost_mono_instance_key_eq key0 key2 eq seed0 seed1
                and ne seed0 seed2 and is_none<SelfhostMonoInstanceId> pending assigned_ok
    if ok 0 1
