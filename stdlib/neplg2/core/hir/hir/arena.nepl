#indent 4
#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "./id" as *
#import "./range" as *
#import "./expr" as *
#import "./function" as *
#import "./module" as *

//: selfhost_hir_module_new: [空/から]の HIR module を[作/つく]る
pub fn selfhost_hir_module_new %impure fn void Result SelfhostHirModule StdErrorKind \void:
    let functions_result %Result Vec SelfhostHirFunction StdErrorKind v::new
    match functions_result:
        Result::Ok functions:
            let params_result %Result Vec SelfhostHirParam StdErrorKind v::new
            match params_result:
                Result::Ok params:
                    let exprs_result %Result Vec SelfhostHirExpr StdErrorKind v::new
                    match exprs_result:
                        Result::Ok exprs:
                            let expr_children_result %Result Vec SelfhostHirExprId StdErrorKind v::new
                            match expr_children_result:
                                Result::Ok expr_children:
                                    Result::Ok SelfhostHirModule functions params exprs expr_children
                                Result::Err e:
                                    v::free functions
                                    v::free params
                                    v::free exprs
                                    Result::Err e
                        Result::Err e:
                            v::free functions
                            v::free params
                            Result::Err e
                Result::Err e:
                    v::free functions
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_hir_module_free: HIR module が所有する table を[解放/かいほう]する
pub fn selfhost_hir_module_free %impure fn SelfhostHirModule unit \module:
    v::free field::get module "functions"
    v::free field::get module "params"
    v::free field::get module "exprs"
    v::free field::get module "expr_children"

//: selfhost_hir_module_function_len: function table の要素数を[返/かえ]す
pub fn selfhost_hir_module_function_len %fn &SelfhostHirModule i32 \module:
    let functions %&Vec SelfhostHirFunction field::get_ref module "functions"
    v::len functions

//: selfhost_hir_module_param_len: parameter table の要素数を[返/かえ]す
pub fn selfhost_hir_module_param_len %fn &SelfhostHirModule i32 \module:
    let params %&Vec SelfhostHirParam field::get_ref module "params"
    v::len params

//: selfhost_hir_module_expr_len: expression table の要素数を[返/かえ]す
pub fn selfhost_hir_module_expr_len %fn &SelfhostHirModule i32 \module:
    let exprs %&Vec SelfhostHirExpr field::get_ref module "exprs"
    v::len exprs

//: selfhost_hir_module_child_len: expression child table の要素数を[返/かえ]す
pub fn selfhost_hir_module_child_len %fn &SelfhostHirModule i32 \module:
    let expr_children %&Vec SelfhostHirExprId field::get_ref module "expr_children"
    v::len expr_children

//: selfhost_hir_module_add_expr_alloc_new: expression 追加結果を[作/つく]る
pub fn selfhost_hir_module_add_expr_alloc_new %impure fn SelfhostHirModule impure fn SelfhostHirExprId SelfhostHirModuleExprAlloc \module\expr_id:
    SelfhostHirModuleExprAlloc module expr_id

//: selfhost_hir_module_expr_alloc_expr_id: expression 追加結果から新しい ExprId を[読/よ]む
//:
//: [目的/もくてき]:
//: - `SelfhostHirModuleExprAlloc` は module owner を含むため、通常の source から field を直接読むことはできません。
//: - この accessor は borrow から Copy な `SelfhostHirExprId` だけを返し、module owner は動かしません。
pub fn selfhost_hir_module_expr_alloc_expr_id %fn &SelfhostHirModuleExprAlloc SelfhostHirExprId \allocated:
    *field::get_ref allocated "expr_id"

//: selfhost_hir_module_expr_alloc_into_module: expression 追加結果を[消費/しょうひ]して module owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - expression 追加後の module owner を次の HIR 操作へ渡すための public 経路です。
//: - wrapper を消費するため、`SelfhostHirModuleExprAlloc` から module owner を複製する経路は作りません。
pub fn selfhost_hir_module_expr_alloc_into_module %impure fn SelfhostHirModuleExprAlloc SelfhostHirModule \allocated:
    field::get allocated "module"

//: selfhost_hir_module_add_function_alloc_new: function 追加結果を[作/つく]る
pub fn selfhost_hir_module_add_function_alloc_new %impure fn SelfhostHirModule impure fn SelfhostHirFunctionId SelfhostHirModuleFunctionAlloc \module\function_id:
    SelfhostHirModuleFunctionAlloc module function_id

//: selfhost_hir_module_function_alloc_function_id: function 追加結果から新しい FunctionId を[読/よ]む
//:
//: [目的/もくてき]:
//: - `SelfhostHirModuleFunctionAlloc` の module owner は保持したまま、Copy な `SelfhostHirFunctionId` だけを観測します。
pub fn selfhost_hir_module_function_alloc_function_id %fn &SelfhostHirModuleFunctionAlloc SelfhostHirFunctionId \allocated:
    *field::get_ref allocated "function_id"

//: selfhost_hir_module_function_alloc_into_module: function 追加結果を[消費/しょうひ]して module owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - function 追加後の module owner を次の HIR 操作へ渡すための public 経路です。
pub fn selfhost_hir_module_function_alloc_into_module %impure fn SelfhostHirModuleFunctionAlloc SelfhostHirModule \allocated:
    field::get allocated "module"

//: selfhost_hir_module_add_child_range_alloc_new: child range 追加結果を[作/つく]る
pub fn selfhost_hir_module_add_child_range_alloc_new %impure fn SelfhostHirModule impure fn SelfhostHirChildRange SelfhostHirModuleChildRangeAlloc \module\child_range:
    SelfhostHirModuleChildRangeAlloc module child_range

//: selfhost_hir_module_child_range_alloc_child_range: child range 追加結果から範囲を[読/よ]む
//:
//: [目的/もくてき]:
//: - module owner は保持したまま、Copy な `SelfhostHirChildRange` だけを観測します。
pub fn selfhost_hir_module_child_range_alloc_child_range %fn &SelfhostHirModuleChildRangeAlloc SelfhostHirChildRange \allocated:
    *field::get_ref allocated "child_range"

//: selfhost_hir_module_child_range_alloc_into_module: child range 追加結果を[消費/しょうひ]して module owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - child range 追加後の module owner を次の HIR 操作へ渡すための public 経路です。
pub fn selfhost_hir_module_child_range_alloc_into_module %impure fn SelfhostHirModuleChildRangeAlloc SelfhostHirModule \allocated:
    field::get allocated "module"

//: selfhost_hir_module_add_param_range_alloc_new: parameter range 追加結果を[作/つく]る
pub fn selfhost_hir_module_add_param_range_alloc_new %impure fn SelfhostHirModule impure fn SelfhostHirParamRange SelfhostHirModuleParamRangeAlloc \module\param_range:
    SelfhostHirModuleParamRangeAlloc module param_range

//: selfhost_hir_module_param_range_alloc_param_range: parameter range 追加結果から範囲を[読/よ]む
//:
//: [目的/もくてき]:
//: - module owner は保持したまま、Copy な `SelfhostHirParamRange` だけを観測します。
pub fn selfhost_hir_module_param_range_alloc_param_range %fn &SelfhostHirModuleParamRangeAlloc SelfhostHirParamRange \allocated:
