//: selfhost_hir_module_copy_params: parameter record 列を parameter table に[複製/ふくせい]する
pub fn selfhost_hir_module_copy_params %impure fn Vec SelfhostHirParam impure fn &Vec SelfhostHirParam impure fn i32 impure fn i32 Result Vec SelfhostHirParam StdErrorKind \out\params\n\idx:
    if:
        ge idx n
        then:
            Result::Ok out
        else:
            match v::get params idx:
                Option::Some param:
                    match v::push out param:
                        Result::Ok next_out:
                            selfhost_hir_module_copy_params next_out params n add idx 1
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err error
                Option::None:
                    v::free out
                    Result::Err StdErrorKind::IndexOutOfBounds

//: selfhost_hir_module_copy_expr_children: child id 列を expression child table に[複製/ふくせい]する
pub fn selfhost_hir_module_copy_expr_children %impure fn Vec SelfhostHirExprId impure fn &Vec SelfhostHirExprId impure fn i32 impure fn i32 Result Vec SelfhostHirExprId StdErrorKind \out\children\n\idx:
    if:
        ge idx n
        then:
            Result::Ok out
        else:
            match v::get children idx:
                Option::Some expr_id:
                    match v::push out expr_id:
                        Result::Ok next_out:
                            selfhost_hir_module_copy_expr_children next_out children n add idx 1
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err error
                Option::None:
                    v::free out
                    Result::Err StdErrorKind::IndexOutOfBounds

//: selfhost_hir_module_add_expr: expression table に record を[追加/ついか]する
//:
//: [注意/ちゅうい]:
//: - 失敗時、入力 module の owner はこの関数が消費し、残り table を解放してから `Err` を返します。
pub fn selfhost_hir_module_add_expr %impure fn SelfhostHirModule impure fn SelfhostHirExpr Result SelfhostHirModuleExprAlloc StdErrorKind \module\expr:
    let expr_id %SelfhostHirExprId selfhost_hir_expr_id_new selfhost_hir_module_expr_len &module
    let functions %Vec SelfhostHirFunction field::get module "functions"
    let params %Vec SelfhostHirParam field::get module "params"
    let exprs %Vec SelfhostHirExpr field::get module "exprs"
    let expr_children %Vec SelfhostHirExprId field::get module "expr_children"
    match v::push exprs expr:
        Result::Ok next_exprs:
            Result::Ok selfhost_hir_module_add_expr_alloc_new (SelfhostHirModule functions params next_exprs expr_children) expr_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free functions
            v::free params
            v::free expr_children
            Result::Err error

//: selfhost_hir_module_add_function: function table に record を[追加/ついか]する
//:
//: [注意/ちゅうい]:
//: - 失敗時、入力 module の owner はこの関数が消費し、残り table を解放してから `Err` を返します。
pub fn selfhost_hir_module_add_function %impure fn SelfhostHirModule impure fn SelfhostHirFunction Result SelfhostHirModuleFunctionAlloc StdErrorKind \module\func:
    let function_id %SelfhostHirFunctionId selfhost_hir_function_id_new selfhost_hir_module_function_len &module
    let functions %Vec SelfhostHirFunction field::get module "functions"
    let params %Vec SelfhostHirParam field::get module "params"
    let exprs %Vec SelfhostHirExpr field::get module "exprs"
    let expr_children %Vec SelfhostHirExprId field::get module "expr_children"
    match v::push functions func:
        Result::Ok next_functions:
            Result::Ok selfhost_hir_module_add_function_alloc_new (SelfhostHirModule next_functions params exprs expr_children) function_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free params
            v::free exprs
            v::free expr_children
            Result::Err error

//: selfhost_hir_module_add_param_range: parameter table に parameter record 列を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - lowering が parameter table の raw offset を直接作らずに、typed range として function record へ渡せるようにします。
//:
//: [注意/ちゅうい]:
//: - `params_to_add` はこの関数が消費し、成功・失敗どちらでも解放します。
//: - 失敗時、入力 module の owner はこの関数が消費し、残り table を解放してから `Err` を返します。
pub fn selfhost_hir_module_add_param_range %impure fn SelfhostHirModule impure fn Vec SelfhostHirParam Result SelfhostHirModuleParamRangeAlloc StdErrorKind \module\params_to_add:
    let param_count %i32 v::len &params_to_add
    if:
        eq param_count 0
        then:
            v::free params_to_add
            Result::Ok selfhost_hir_module_add_param_range_alloc_new module selfhost_hir_param_range_empty
        else:
            let first_param %i32 selfhost_hir_module_param_len &module
            let functions %Vec SelfhostHirFunction field::get module "functions"
            let params %Vec SelfhostHirParam field::get module "params"
            let exprs %Vec SelfhostHirExpr field::get module "exprs"
            let expr_children %Vec SelfhostHirExprId field::get module "expr_children"
            match selfhost_hir_module_copy_params params &params_to_add param_count 0:
                Result::Ok next_params:
                    v::free params_to_add
                    let param_range %SelfhostHirParamRange selfhost_hir_param_range_new_unchecked first_param param_count
                    Result::Ok selfhost_hir_module_add_param_range_alloc_new (SelfhostHirModule functions next_params exprs expr_children) param_range
                Result::Err e:
                    v::free functions
                    v::free exprs
                    v::free expr_children
                    v::free params_to_add
                    Result::Err e

//: selfhost_hir_module_add_child_range: expression child table に child id 列を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - lowering が child table の raw offset を直接作らずに、typed range として parent expression へ渡せるようにします。
//:
//: [注意/ちゅうい]:
//: - `children` はこの関数が消費し、成功・失敗どちらでも解放します。
//: - 失敗時、入力 module の owner はこの関数が消費し、残り table を解放してから `Err` を返します。
pub fn selfhost_hir_module_add_child_range %impure fn SelfhostHirModule impure fn Vec SelfhostHirExprId Result SelfhostHirModuleChildRangeAlloc StdErrorKind \module\children:
    let child_count %i32 v::len &children
    if:
        eq child_count 0
        then:
            v::free children
            Result::Ok selfhost_hir_module_add_child_range_alloc_new module selfhost_hir_child_range_empty
        else:
            let first_child %i32 selfhost_hir_module_child_len &module
            let functions %Vec SelfhostHirFunction field::get module "functions"
            let params %Vec SelfhostHirParam field::get module "params"
            let exprs %Vec SelfhostHirExpr field::get module "exprs"
            let expr_children %Vec SelfhostHirExprId field::get module "expr_children"
            match selfhost_hir_module_copy_expr_children expr_children &children child_count 0:
                Result::Ok next_expr_children:
                    v::free children
                    let child_range %SelfhostHirChildRange selfhost_hir_child_range_new_unchecked first_child child_count
                    Result::Ok selfhost_hir_module_add_child_range_alloc_new (SelfhostHirModule functions params exprs next_expr_children) child_range
                Result::Err e:
                    v::free functions
                    v::free params
                    v::free exprs
                    v::free children
                    Result::Err e

//: selfhost_hir_module_get_function: function id の record を[返/かえ]す
pub fn selfhost_hir_module_get_function %fn &SelfhostHirModule fn SelfhostHirFunctionId Option SelfhostHirFunction \module\function_id:
    if:
        lt function_id.index 0
        then:
            none
        else:
            let functions %&Vec SelfhostHirFunction field::get_ref module "functions"
            v::get functions function_id.index

//: selfhost_hir_module_get_expr: expression id の record を[返/かえ]す
pub fn selfhost_hir_module_get_expr %fn &SelfhostHirModule fn SelfhostHirExprId Option SelfhostHirExpr \module\expr_id:
    if:
        lt expr_id.index 0
        then:
            none
        else:
            let exprs %&Vec SelfhostHirExpr field::get_ref module "exprs"
            v::get exprs expr_id.index

//: selfhost_hir_module_get_param: parameter range 内の parameter record を[返/かえ]す
pub fn selfhost_hir_module_get_param %fn &SelfhostHirModule fn SelfhostHirParamRange fn i32 Option SelfhostHirParam \module\param_range\idx:
    match param_range:
        SelfhostHirParamRange::Empty:
            none
        SelfhostHirParamRange::Range range:
            if:
                or lt idx 0 ge idx range.param_count
                then:
                    none
                else:
                    let params %&Vec SelfhostHirParam field::get_ref module "params"
                    v::get params add range.first_param idx

//: selfhost_hir_module_get_child: child range 内の expression id を[返/かえ]す
pub fn selfhost_hir_module_get_child %fn &SelfhostHirModule fn SelfhostHirChildRange fn i32 Option SelfhostHirExprId \module\child_range\idx:
    match child_range:
        SelfhostHirChildRange::Empty:
            none
        SelfhostHirChildRange::Range range:
            if:
                or lt idx 0 ge idx range.child_count
                then:
                    none
                else:
                    let expr_children %&Vec SelfhostHirExprId field::get_ref module "expr_children"
                    v::get expr_children add range.first_child idx
