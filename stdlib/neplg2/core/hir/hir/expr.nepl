#indent 4

//: # hir/hir/expr
//: selfhost compiler の typed HIR expression payload と record を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - checker / lowering が確定した型、span、value identity、function identity、child range を HIR expression として保存します。
//: - HIR 以降の phase が source token や scope lookup を再実行せず、typed payload だけで同じ expression boundary を参照できるようにします。
//:
//: [契約/けいやく]:
//: - `SelfhostHirExpr.ty` と identity payload が authority です。payload の文字列や source span から型や定義 identity を推測し直してはいけません。
//: - 関数値は `SelfhostHirFunctionValueIdentity` によって effect / type / DefId evidence を保持します。`memo_call` や indirect call はこの identity の制約を別 stage で検査します。
//:
//: [計算量/けいさんりょう]:
//: - expression record の構築と accessor は O(1) です。child traversal の計算量は child range を消費する後続 stage が持ちます。
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *
#import "./range" as *

//: SelfhostHirExprKind: S4 初期段階で扱う HIR expression の分類
//:
//: [目的/もくてき]:
//: - HIR expression の payload variant を、数値 tag や文字列ではなく enum として後続 phase に渡します。
//:
//: [契約/けいやく]:
//: - この enum は payload の分類だけを表します。expression type の authority は `SelfhostHirExpr.ty` です。
//: - variant を追加した場合は、`selfhost_hir_expr_kind_eq` と `selfhost_hir_expr_kind` の match を同時に更新します。
pub enum SelfhostHirExprKind:
    Error
    Unit
    BoolLiteral
    I32Literal
    F32Literal
    StrLiteral
    Var
    FnValue
    Call
    Block
    If

impl Clone for SelfhostHirExprKind:
    fn clone %fn &SelfhostHirExprKind SelfhostHirExprKind \self:
        *self

impl Copy for SelfhostHirExprKind:
    fn copy_mark %fn SelfhostHirExprKind SelfhostHirExprKind \self:
        self

//: SelfhostHirFunctionValueIdentity: HIR に保存する関数値の typed identity
//:
//: [目的/もくてき]:
//: - `@ident` などから作られる関数値を、表示名だけでなく定義 id、関数型、effect と一緒に保存します。
//: - monomorphize、indirect call、`memo_call`、Resource IR summary が同じ関数を参照していることを typed payload で確認できるようにします。
//:
//: [契約/けいやく]:
//: - `function_ty` はこの関数値そのものの関数型を指します。
//: - `effect` は `function_ty` に含まれる関数 effect と一致していなければなりません。
//: - `def_id` が `Option::None` の identity は、外部 artifact から復元した direct-call 専用候補など、安定定義 id がまだ証明されていない状態を表します。そのまま HIR `FnValue`、indirect call、`memo_call` へ進めてはいけません。
//: - `type_arg_count` は現時点では 0 の monomorphic identity だけを accepted lowering に使います。generic type argument の実体は、後続の stable type-argument range / canonical key issue で追加します。
//:
//: [計算量/けいさんりょう]:
//: - identity の生成とコピーは、文字列 payload の扱いを除けば O(1) です。
pub struct SelfhostHirFunctionValueIdentity:
    symbol %str
    def_id %Option SelfhostDefId
    function_ty %SelfhostTypeId
    effect %SelfhostEffectKind
    type_arg_count %i32

impl Clone for SelfhostHirFunctionValueIdentity:
    fn clone %fn &SelfhostHirFunctionValueIdentity SelfhostHirFunctionValueIdentity \self:
        *self

impl Copy for SelfhostHirFunctionValueIdentity:
    fn copy_mark %fn SelfhostHirFunctionValueIdentity SelfhostHirFunctionValueIdentity \self:
        self

//: SelfhostHirFunctionValueIdentityBuildError: 関数値 identity 構築の失敗分類
//:
//: [目的/もくてき]:
//: - `type_arg_count` など、payload の内部不変条件を bool や文字列ではなく enum で報告します。
//: - caller は `Result` を match し、invalid identity を HIR に入れない fail-closed path を取れます。
//:
//: [契約/けいやく]:
//: - variant は constructor の失敗理由を表します。表示文や diagnostic message は別 layer で決めます。
//: - generic function value lowering を実装するまでは、負の type argument count だけを構築時の typed error として扱います。
pub enum SelfhostHirFunctionValueIdentityBuildError:
    NegativeTypeArgCount

impl Clone for SelfhostHirFunctionValueIdentityBuildError:
    fn clone %fn &SelfhostHirFunctionValueIdentityBuildError SelfhostHirFunctionValueIdentityBuildError \self:
        *self

impl Copy for SelfhostHirFunctionValueIdentityBuildError:
    fn copy_mark %fn SelfhostHirFunctionValueIdentityBuildError SelfhostHirFunctionValueIdentityBuildError \self:
        self

//: SelfhostHirCallExpr: call payload に保存する callee identity と argument child range
//:
//: [目的/もくてき]:
//: - direct call の表示名、DefId-linked callable identity、関数型、effect、型引数数、同じ HIR module arena 内にある argument expression range をまとめます。
//: - `@ident` function value、indirect call、`memo_call`、Resource IR summary が同じ callable を参照していることを後続 phase が型付き payload だけで確認できるようにします。
//:
//: [契約/けいやく]:
//: - `name` は diagnostic / dump / backend symbol 用の表示名です。型や identity の authority として使ってはいけません。
//: - `def_id` は checker が選んだ `SelfhostCallableCandidate` 由来の定義 identity です。HIR lowering で source token や scope lookup から再構築してはいけません。
//: - `callable_type` は callee の関数型です。expression 全体の結果型は `SelfhostHirExpr.ty` にあり、この field は callee identity / monomorphize / Resource IR 用の証拠として保持します。
//: - `effect` は callee の effect 証拠です。pure / impure call boundary、indirect call、`memo_call` の検査はこの payload を参照します。
//: - `type_arg_count` は現時点では 0 の monomorphic call だけを accepted path にします。generic instantiation の stable type-argument range は後続 issue で追加します。
//: - `args` は `SelfhostHirModule` arena 内の child range です。range 外参照は module arena 側の invariant で拒否します。
//:
//: [計算量/けいさんりょう]:
//: - record copy と field access は O(1) です。
pub struct SelfhostHirCallExpr:
    name %str
    def_id %SelfhostDefId
    callable_type %SelfhostTypeId
    effect %SelfhostEffectKind
    type_arg_count %i32
    args %SelfhostHirChildRange

impl Clone for SelfhostHirCallExpr:
    fn clone %fn &SelfhostHirCallExpr SelfhostHirCallExpr \self:
        *self

impl Copy for SelfhostHirCallExpr:
    fn copy_mark %fn SelfhostHirCallExpr SelfhostHirCallExpr \self:
        self

//: SelfhostHirValueIdentity: HIR に保存する値参照の typed identity
//:
//: [目的/もくてき]:
//: - `NamedValue` argument などから作られる変数参照を、表示名だけでなく DefId、値型、定義分類と一緒に保存します。
//: - HIR lowering 後に scope lookup を再実行せず、monomorphize、Resource IR、backend が同じ値定義を参照していることを確認できるようにします。
//:
//: [契約/けいやく]:
//: - `symbol` は diagnostic / dump / backend symbol 用の表示名です。
//: - `def_id` は name resolver が割り当てた定義 identity です。`Var` payload は DefId のない文字列参照へ戻してはいけません。
//: - `value_ty` はこの値参照 expression の型であり、`SelfhostHirExpr.ty` と一致していなければなりません。
//: - `kind` は local / parameter / builtin などの名前空間分類です。後続 phase は kind に応じて capture、local slot、builtin lowering を分けます。
//:
//: [計算量/けいさんりょう]:
//: - identity record の構築、copy、field access は O(1) です。
pub struct SelfhostHirValueIdentity:
    symbol %str
    def_id %SelfhostDefId
    value_ty %SelfhostTypeId
    kind %SelfhostDefKind

impl Clone for SelfhostHirValueIdentity:
    fn clone %fn &SelfhostHirValueIdentity SelfhostHirValueIdentity \self:
        *self

impl Copy for SelfhostHirValueIdentity:
    fn copy_mark %fn SelfhostHirValueIdentity SelfhostHirValueIdentity \self:
        self

//: SelfhostHirExprPayload: HIR expression の payload 分類
//:
//: [目的/もくてき]:
//: - typed HIR expression が、literal、value reference、function value、call、block、if のどの実体を持つかを enum で表します。
//:
//: [契約/けいやく]:
//: - `SelfhostHirExpr.ty` が expression type の authority であり、payload variant だけから型を推測してはいけません。
//: - `FnValue`、`Var`、`Call` は DefId-linked identity payload を持ちます。source spelling から identity を再構築してはいけません。
//: - `Call`、`Block`、`If` は child range を通じて module arena 内の child expression を参照します。
pub enum SelfhostHirExprPayload:
    Error
    Unit
    BoolLiteral %bool
    I32Literal %i32
    F32Literal %f32
    StrLiteral %str
    Var %SelfhostHirValueIdentity
    FnValue %SelfhostHirFunctionValueIdentity
    Call %SelfhostHirCallExpr
    Block %SelfhostHirChildRange
    If %SelfhostHirChildRange

impl Clone for SelfhostHirExprPayload:
    fn clone %fn &SelfhostHirExprPayload SelfhostHirExprPayload \self:
        *self

impl Copy for SelfhostHirExprPayload:
    fn copy_mark %fn SelfhostHirExprPayload SelfhostHirExprPayload \self:
        self

//: SelfhostHirExpr: 型付き HIR expression record
//:
//: [目的/もくてき]:
//: - HIR lowering が生成した expression の型、source span、payload を 1 つにまとめます。
//:
//: [契約/けいやく]:
//: - `ty` は typecheck / lowering が確定した `SelfhostTypeId` です。payload の literal kind や call name から後で推測し直してはいけません。
//: - `span` は diagnostic、dump、source map 用の位置情報です。最適化や backend lowering はこの span を意味論の根拠にしてはいけません。
//: - `payload` は expression の構造情報であり、child id / range は同じ `SelfhostHirModule` arena 内を指します。
//:
//: [計算量/けいさんりょう]:
//: - record copy と field access は O(1) です。
pub struct SelfhostHirExpr:
    ty %SelfhostTypeId
    span %SelfhostSourceSpan
    payload %SelfhostHirExprPayload

impl Clone for SelfhostHirExpr:
    fn clone %fn &SelfhostHirExpr SelfhostHirExpr \self:
        *self

impl Copy for SelfhostHirExpr:
    fn copy_mark %fn SelfhostHirExpr SelfhostHirExpr \self:
        self

//: selfhost_hir_expr_kind_eq: expression kind が同じ分類か[返/かえ]す
//:
//: [目的/もくてき]:
//: - HIR expression kind を numeric tag に落とさず、variant を直接 match して比較します。
//: - expression kind 追加時に比較分岐を明示的に更新する形を保ちます。
pub fn selfhost_hir_expr_kind_eq %fn SelfhostHirExprKind fn SelfhostHirExprKind bool \a\b:
    match a:
        SelfhostHirExprKind::Error:
            match b:
                SelfhostHirExprKind::Error:
                    true
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::Unit:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    true
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::BoolLiteral:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    true
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::I32Literal:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    true
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::F32Literal:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    true
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::StrLiteral:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    true
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::Var:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    true
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::FnValue:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    true
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::Call:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    true
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::Block:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    true
                SelfhostHirExprKind::If:
                    false
        SelfhostHirExprKind::If:
            match b:
                SelfhostHirExprKind::Error:
                    false
                SelfhostHirExprKind::Unit:
                    false
                SelfhostHirExprKind::BoolLiteral:
                    false
                SelfhostHirExprKind::I32Literal:
                    false
                SelfhostHirExprKind::F32Literal:
                    false
                SelfhostHirExprKind::StrLiteral:
                    false
                SelfhostHirExprKind::Var:
                    false
                SelfhostHirExprKind::FnValue:
                    false
                SelfhostHirExprKind::Call:
                    false
                SelfhostHirExprKind::Block:
                    false
                SelfhostHirExprKind::If:
                    true

//: selfhost_hir_expr_new: expression record を[作/つく]る
pub fn selfhost_hir_expr_new %fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirExprPayload SelfhostHirExpr \ty\span\payload:
    SelfhostHirExpr ty span payload

//: selfhost_hir_value_identity_new: 値参照 identity を[作/つく]る
//:
//: [目的/もくてき]:
//: - HIR `Var` payload に保存する値 identity を構築します。
//: - checker / lowering が確定した DefId、型、binding kind をまとめ、後続 phase が source scope を再探索しなくても同じ値定義を参照できるようにします。
//:
//: [契約/けいやく]:
//: - `symbol` は表示用です。identity の authority は `def_id` です。
//: - `value_ty` は、この identity を持つ `SelfhostHirExpr.ty` と一致している必要があります。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_hir_value_identity_new %fn str fn SelfhostDefId fn SelfhostTypeId fn SelfhostDefKind SelfhostHirValueIdentity \symbol\def_id\value_ty\kind:
    SelfhostHirValueIdentity symbol def_id value_ty kind

//: selfhost_hir_function_value_identity_new_result: 関数値 identity を検査して[作/つく]る
//:
//: [目的/もくてき]:
//: - 関数値を HIR payload に入れる前に、型引数数などの不変条件を `Result` で確認します。
//: - generic function value の実体はまだ selfhost HIR artifact 境界に実装されていないため、この関数は数の健全性だけを検査し、generic lowering の可否は後段 checker が別途 fail-closed に判定します。
//:
//: [戻/もど]り[値/ち]:
//: - `Result::Ok(identity)` は `type_arg_count` が負でないことを示します。
//: - `Result::Err(NegativeTypeArgCount)` は不正な identity を HIR に保存してはいけないことを示します。
pub fn selfhost_hir_function_value_identity_new_result %fn str fn Option SelfhostDefId fn SelfhostTypeId fn SelfhostEffectKind fn i32 Result SelfhostHirFunctionValueIdentity SelfhostHirFunctionValueIdentityBuildError \symbol\def_id\function_ty\effect\type_arg_count:
    if lt type_arg_count 0:
        Result::Err SelfhostHirFunctionValueIdentityBuildError::NegativeTypeArgCount
    else:
        Result::Ok SelfhostHirFunctionValueIdentity symbol def_id function_ty effect type_arg_count

//: selfhost_hir_function_value_identity_monomorphic: monomorphic named function の identity を[作/つく]る
//:
//: [目的/もくてき]:
//: - 現在の `@ident` argument checker が受理する、型引数を必要としない named function value を作ります。
//: - `def_id` を `Option::Some` として保存し、indirect call や `memo_call` が stable identity を要求できるようにします。
//:
//: [制約/せいやく]:
//: - generic type argument はこの helper では表現しません。generic function value は stable type argument range / canonical key を導入してから別 constructor で扱います。
pub fn selfhost_hir_function_value_identity_monomorphic %fn str fn SelfhostDefId fn SelfhostTypeId fn SelfhostEffectKind SelfhostHirFunctionValueIdentity \symbol\def_id\function_ty\effect:
    SelfhostHirFunctionValueIdentity symbol some def_id function_ty effect 0

//: selfhost_hir_function_value_identity_has_def_id: identity が stable 定義 id を持つか[返/かえ]す
//:
//: [目的/もくてき]:
//: - `.neplmeta` などから復元した direct-call 専用候補を、`FnValue` / indirect call / `memo_call` へ誤って流さないための検査点を提供します。
pub fn selfhost_hir_function_value_identity_has_def_id %fn &SelfhostHirFunctionValueIdentity bool \identity:
    match *field::get_ref identity "def_id":
        Option::Some _def_id:
            true
        Option::None:
            false

//: selfhost_hir_function_value_identity_is_monomorphic: identity が型引数なしとして扱えるか[返/かえ]す
//:
//: [目的/もくてき]:
//: - 現在の selfhost HIR lowering が安全に扱える monomorphic function value だけを通す gate として使います。
//: - generic lowering を実装するまでは、0 以外を accepted path に入れないことで fail-closed にします。
pub fn selfhost_hir_function_value_identity_is_monomorphic %fn &SelfhostHirFunctionValueIdentity bool \identity:
    eq *field::get_ref identity "type_arg_count" 0

//: selfhost_hir_expr_error: error expression record を[作/つく]る
pub fn selfhost_hir_expr_error %fn SelfhostTypeId fn SelfhostSourceSpan SelfhostHirExpr \ty\span:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::Error

//: selfhost_hir_expr_unit: unit expression record を[作/つく]る
pub fn selfhost_hir_expr_unit %fn SelfhostTypeId fn SelfhostSourceSpan SelfhostHirExpr \ty\span:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::Unit

//: selfhost_hir_expr_bool_literal: bool literal expression record を[作/つく]る
pub fn selfhost_hir_expr_bool_literal %fn SelfhostTypeId fn SelfhostSourceSpan fn bool SelfhostHirExpr \ty\span\value:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::BoolLiteral value

//: selfhost_hir_expr_i32_literal: i32 literal expression record を[作/つく]る
pub fn selfhost_hir_expr_i32_literal %fn SelfhostTypeId fn SelfhostSourceSpan fn i32 SelfhostHirExpr \ty\span\value:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::I32Literal value

//: selfhost_hir_expr_f32_literal: f32 literal expression record を[作/つく]る
//:
//: [目的/もくてき]:
//: - checker が確定した `f32` literal payload を、typed HIR expression として保存します。
//: - HIR 以降の phase が source token や float lexeme を再読せず、semantic `f32` 値だけを使えるようにします。
//:
//: [契約/けいやく]:
//: - `ty` は `f32` 型を指す `SelfhostTypeId` です。payload variant だけから型を推測し直してはいけません。
//: - `value` は source spelling ではなく、literal payload checker が一度だけ解析した `f32` 値です。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_hir_expr_f32_literal %fn SelfhostTypeId fn SelfhostSourceSpan fn f32 SelfhostHirExpr \ty\span\value:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::F32Literal value

//: selfhost_hir_expr_str_literal: str literal expression record を[作/つく]る
pub fn selfhost_hir_expr_str_literal %fn SelfhostTypeId fn SelfhostSourceSpan fn str SelfhostHirExpr \ty\span\value:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::StrLiteral value

//: selfhost_hir_expr_var: variable reference expression record を[作/つく]る
//:
//: [目的/もくてき]:
//: - 変数参照を DefId-linked identity として保存します。
//: - 文字列名だけを受け取る constructor は用意せず、checker / lowering が確定した identity を渡す境界にします。
pub fn selfhost_hir_expr_var %fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirValueIdentity SelfhostHirExpr \ty\span\identity:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::Var identity

//: selfhost_hir_expr_fn_value: named function value expression record を[作/つく]る
//:
//: [目的/もくてき]:
//: - 明示 `@ident` などで作られた関数値を、typed identity payload として HIR に保存します。
//: - `Var` や `Call` と異なり、関数名の文字列だけでは monomorphize / Resource IR / backend の参照境界を証明できないため、この constructor は `SelfhostHirFunctionValueIdentity` を要求します。
//:
//: [注意/ちゅうい]:
//: - この constructor は HIR record を作るだけです。`def_id` の有無、monomorphic 制約、capturing function の拒否、`memo_call` の private cache proof は caller 側の checker / lowering issue で検査します。
pub fn selfhost_hir_expr_fn_value %fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirFunctionValueIdentity SelfhostHirExpr \ty\span\identity:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::FnValue identity

//: selfhost_hir_expr_call: direct call expression record を[作/つく]る
//:
//: [目的/もくてき]:
//: - checker が選択した callable identity と HIR child argument range を、source 再読なしの call payload として保存します。
//: - 表示名だけでは `memo_call` / indirect call / Resource IR summary が同じ callable を参照していることを証明できないため、DefId、callee function type、effect、型引数数を同時に受け取ります。
//:
//: [契約/けいやく]:
//: - `name` は表示用です。call target の authority は `def_id`、`callable_type`、`effect`、`type_arg_count` です。
//: - 現 checkpoint では monomorphic direct call だけを受け取り、payload の `type_arg_count` はこの constructor が 0 に固定します。generic call の stable type-argument identity は後続 issue で追加します。
//: - この constructor は HIR record を作るだけで、candidate 収集や overload 解決を行いません。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostHirExpr`: `Call` payload を持つ typed HIR expression record です。
//:
//: [計算量/けいさんりょう]:
//: - record 構築だけなので O(1) です。
pub fn selfhost_hir_expr_call %fn SelfhostTypeId fn SelfhostSourceSpan fn str fn SelfhostDefId fn SelfhostTypeId fn SelfhostEffectKind fn SelfhostHirChildRange SelfhostHirExpr \ty\span\name\def_id\callable_type\effect\args:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::Call SelfhostHirCallExpr name def_id callable_type effect 0 args

//: selfhost_hir_expr_block: block expression record を[作/つく]る
pub fn selfhost_hir_expr_block %fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirChildRange SelfhostHirExpr \ty\span\children:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::Block children

//: selfhost_hir_expr_if: if expression record を[作/つく]る
pub fn selfhost_hir_expr_if %fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirChildRange SelfhostHirExpr \ty\span\branches:
    selfhost_hir_expr_new ty span SelfhostHirExprPayload::If branches

//: selfhost_hir_expr_kind: expression record の kind を[返/かえ]す
pub fn selfhost_hir_expr_kind %fn &SelfhostHirExpr SelfhostHirExprKind \expr:
    match *field::get_ref expr "payload":
        SelfhostHirExprPayload::Error:
            SelfhostHirExprKind::Error
        SelfhostHirExprPayload::Unit:
            SelfhostHirExprKind::Unit
        SelfhostHirExprPayload::BoolLiteral _value:
            SelfhostHirExprKind::BoolLiteral
        SelfhostHirExprPayload::I32Literal _value:
            SelfhostHirExprKind::I32Literal
        SelfhostHirExprPayload::F32Literal _value:
            SelfhostHirExprKind::F32Literal
        SelfhostHirExprPayload::StrLiteral _value:
            SelfhostHirExprKind::StrLiteral
        SelfhostHirExprPayload::Var _name:
            SelfhostHirExprKind::Var
        SelfhostHirExprPayload::FnValue _identity:
            SelfhostHirExprKind::FnValue
        SelfhostHirExprPayload::Call _call:
            SelfhostHirExprKind::Call
        SelfhostHirExprPayload::Block _children:
            SelfhostHirExprKind::Block
        SelfhostHirExprPayload::If _branches:
            SelfhostHirExprKind::If

//: selfhost_hir_expr_child_range: expression record の child 範囲を[返/かえ]す
pub fn selfhost_hir_expr_child_range %fn &SelfhostHirExpr SelfhostHirChildRange \expr:
    match *field::get_ref expr "payload":
        SelfhostHirExprPayload::Error:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::Unit:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::BoolLiteral _value:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::I32Literal _value:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::F32Literal _value:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::StrLiteral _value:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::Var _name:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::FnValue _identity:
            selfhost_hir_child_range_empty
        SelfhostHirExprPayload::Call call:
            call.args
        SelfhostHirExprPayload::Block children:
            children
        SelfhostHirExprPayload::If branches:
            branches
