#indent 4
#import "core/math" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/ty/ty" as *
#import "./id" as *
#import "./range" as *

//: SelfhostHirParam: HIR function parameter record
//:
//: [目的/もくてき]:
//: - checker が確定した parameter name / type / mutability を function table から参照できるようにします。
pub struct SelfhostHirParam:
    name %str
    ty %SelfhostTypeId
    mutable %bool
    span %SelfhostSourceSpan

impl Clone for SelfhostHirParam:
    fn clone %fn &SelfhostHirParam SelfhostHirParam \self:
        *self

impl Copy for SelfhostHirParam:
    fn copy_mark %fn SelfhostHirParam SelfhostHirParam \self:
        self

//: SelfhostHirFunction: HIR function record
//:
//: [目的/もくてき]:
//: - function name、戻り値型、span、root expression、parameter table 範囲を保持します。
pub struct SelfhostHirFunction:
    name %str
    result %SelfhostTypeId
    span %SelfhostSourceSpan
    root %SelfhostHirExprId
    params %SelfhostHirParamRange

impl Clone for SelfhostHirFunction:
    fn clone %fn &SelfhostHirFunction SelfhostHirFunction \self:
        *self

impl Copy for SelfhostHirFunction:
    fn copy_mark %fn SelfhostHirFunction SelfhostHirFunction \self:
        self

//: selfhost_hir_param_new: parameter record を[作/つく]る
pub fn selfhost_hir_param_new %fn str fn SelfhostTypeId fn bool fn SelfhostSourceSpan SelfhostHirParam \name\ty\mutable\span:
    SelfhostHirParam name ty mutable span

//: selfhost_hir_function_new: function record を[作/つく]る
//:
//: [目的/もくてき]:
//: - parameter table 範囲を raw `first/count` の組ではなく `SelfhostHirParamRange` として受け取ります。
//: - 0 引数関数は `SelfhostHirParamRange::Empty` で表し、負の count を function record に保存できない形にします。
pub fn selfhost_hir_function_new %fn str fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirExprId fn SelfhostHirParamRange SelfhostHirFunction \name\result\span\root\params:
    SelfhostHirFunction name result span root params

//: selfhost_hir_function_with_params: parameter range を持つ function record を[作/つく]る
pub fn selfhost_hir_function_with_params %fn str fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostHirExprId fn SelfhostHirParamRange SelfhostHirFunction \name\result\span\root\param_range:
    selfhost_hir_function_new name result span root param_range

//: selfhost_hir_function_param_range: function record の parameter 範囲を[返/かえ]す
pub fn selfhost_hir_function_param_range %fn SelfhostHirFunction SelfhostHirParamRange \func:
    func.params
