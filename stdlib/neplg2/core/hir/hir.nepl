    let expr_children <Vec<SelfhostHirExprId>> field::get module "expr_children"
    match v::push<SelfhostHirExpr> exprs expr:
        Result::Ok next_exprs:
            Result<SelfhostHirModuleExprAlloc, StdErrorKind>::Ok selfhost_hir_module_add_expr_alloc_new (SelfhostHirModule functions params next_exprs expr_children) expr_id
        Result::Err e:
            v::free<SelfhostHirFunction> functions
            v::free<SelfhostHirParam> params
            v::free<SelfhostHirExprId> expr_children
