//: selfhost_hir_module_copy_params: parameter record 列を parameter table に[複製/ふくせい]する
fn selfhost_hir_module_copy_params <(Vec<SelfhostHirParam>,&Vec<SelfhostHirParam>,i32,i32)*>Result<Vec<SelfhostHirParam>, StdErrorKind>> (out, params, n, idx):
    if:
        ge idx n
        then:
            Result<Vec<SelfhostHirParam>, StdErrorKind>::Ok out
        else:
            match v::get<SelfhostHirParam> params idx:
                Option::Some param:
                    match v::push<SelfhostHirParam> out param:
                        Result::Ok next_out:
                            selfhost_hir_module_copy_params next_out params n add idx 1
                        Result::Err e:
                            Result<Vec<SelfhostHirParam>, StdErrorKind>::Err e
                Option::None:
                    v::free<SelfhostHirParam> out
                    Result<Vec<SelfhostHirParam>, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds

//: selfhost_hir_module_copy_expr_children: child id 列を expression child table に[複製/ふくせい]する
fn selfhost_hir_module_copy_expr_children <(Vec<SelfhostHirExprId>,&Vec<SelfhostHirExprId>,i32,i32)*>Result<Vec<SelfhostHirExprId>, StdErrorKind>> (out, children, n, idx):
    if:
        ge idx n
        then:
            Result<Vec<SelfhostHirExprId>, StdErrorKind>::Ok out
        else:
            match v::get<SelfhostHirExprId> children idx:
                Option::Some expr_id:
                    match v::push<SelfhostHirExprId> out expr_id:
                        Result::Ok next_out:
                            selfhost_hir_module_copy_expr_children next_out children n add idx 1
                        Result::Err e:
                            Result<Vec<SelfhostHirExprId>, StdErrorKind>::Err e
                Option::None:
                    v::free<SelfhostHirExprId> out
                    Result<Vec<SelfhostHirExprId>, StdErrorKind>::Err StdErrorKind::IndexOutOfBounds

