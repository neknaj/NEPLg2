#indent 4

//: # hir
//: NEPLg2.0 の解決済み中間表現を置くモジュールです。
//:
//: [目的/もくてき]:
//: - AST と typecheck 結果から backend 前の HIR へ落とす stage の受け皿を提供します。
//: - function / parameter / expression を table に保存し、後続 pass が stable id で参照できるようにします。
//: - deep HIR traversal を再帰ではなく explicit stack へ移すため、expression child も flat table で保持します。
//:
//: [実装/じっそう]:
//: - `SelfhostHirModule` は function / param / expr / expr_children の 4 つの Vec を所有します。
//: - `SelfhostHirFunctionId` と `SelfhostHirExprId` は arena-local index です。別 module の id と混ぜないでください。
//: - expression record は typed child range から作り、first_child / child_count で child table 範囲を参照します。
//: - function record は typed parameter range から作り、first_param / param_count で param table 範囲を参照します。
//:
//: [注意/ちゅうい]:
//: - これは S4 HIR stage の最小 model です。完全な lowering、pattern、drop plan は別 issue で追加します。
//: - string literal は現時点では `name` field に lexeme / symbol を置く最小表現です。後で string table に分離します。
//:
//: [計算量/けいさんりょう]:
//: - record 追加は Vec の償却 O(1)、再確保時 O(n) です。
//: - id lookup と len は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/field" as field
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span <SelfhostSourceSpan> source_span_new 3 10 14
//:             let result_ty <SelfhostTypeId> selfhost_type_id_new 1
//:             let expr <SelfhostHirExpr> selfhost_hir_expr_new SelfhostHirExprKind::Unit result_ty span -1 0 "" 0 false
//:             match selfhost_hir_module_add_expr module0 expr:
//:                 Result::Ok expr_alloc:
//:                     let root <SelfhostHirExprId> field::get expr_alloc "expr_id"
//:                     let module1 <SelfhostHirModule> field::get expr_alloc "module"
//:                     let func <SelfhostHirFunction> selfhost_hir_function_new "main" result_ty span root 0 0
//:                     match selfhost_hir_module_add_function module1 func:
//:                         Result::Ok func_alloc:
//:                             let function_id <SelfhostHirFunctionId> field::get func_alloc "function_id"
//:                             let module2 <SelfhostHirModule> field::get func_alloc "module"
//:                             let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_expr_len &module2
//:                             let checks2 checks_push checks1 check_eq_i32 1 selfhost_hir_module_function_len &module2
//:                             let checks3 checks_push checks2 check_eq_i32 0 selfhost_hir_expr_id_index root
//:                             let checks4 checks_push checks3 check_eq_i32 0 selfhost_hir_function_id_index function_id
//:                             match selfhost_hir_module_get_function &module2 function_id:
//:                                 Option::Some got_func:
//:                                     let checks5 checks_push checks4 check_str_eq "main" got_func.name
//:                                     match selfhost_hir_module_get_expr &module2 got_func.root:
//:                                         Option::Some got_expr:
//:                                             let checks6 checks_push checks5 check selfhost_hir_expr_kind_eq got_expr.kind SelfhostHirExprKind::Unit
//:                                             selfhost_hir_module_free module2
//:                                             let shown checks_print_report checks6
//:                                             checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module2
//:                                             let checks6 checks_push checks5 Result<(),str>::Err "missing root expr"
//:                                             let shown checks_print_report checks6
//:                                             checks_exit_code shown
//:                                 Option::None:
//:                                     selfhost_hir_module_free module2
//:                                     let checks5 checks_push checks4 Result<(),str>::Err "missing function"
//:                                     let shown checks_print_report checks5
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<(),str>::Err "function push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<(),str>::Err "expr push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<(),str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/field" as field
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span <SelfhostSourceSpan> source_span_new 4 20 25
//:             let result_ty <SelfhostTypeId> selfhost_type_id_new 1
//:             let child_expr <SelfhostHirExpr> selfhost_hir_expr_leaf SelfhostHirExprKind::Unit result_ty span "" 0 false
//:             match selfhost_hir_module_add_expr module0 child_expr:
//:                 Result::Ok child_alloc:
//:                     let child_id <SelfhostHirExprId> field::get child_alloc "expr_id"
//:                     let module1 <SelfhostHirModule> field::get child_alloc "module"
//:                     let child_ids0 <Vec<SelfhostHirExprId>> unwrap_ok v::new<SelfhostHirExprId>
//:                     let child_ids1 <Vec<SelfhostHirExprId>> unwrap_ok v::push<SelfhostHirExprId> child_ids0 child_id
//:                     match selfhost_hir_module_add_child_range module1 child_ids1:
//:                         Result::Ok range_alloc:
//:                             let child_range <SelfhostHirChildRange> field::get range_alloc "child_range"
//:                             let module2 <SelfhostHirModule> field::get range_alloc "module"
//:                             let parent_expr <SelfhostHirExpr> selfhost_hir_expr_with_children SelfhostHirExprKind::Block result_ty span child_range "" 0 false
//:                             match selfhost_hir_module_add_expr module2 parent_expr:
//:                                 Result::Ok parent_alloc:
//:                                     let parent_id <SelfhostHirExprId> field::get parent_alloc "expr_id"
//:                                     let module3 <SelfhostHirModule> field::get parent_alloc "module"
//:                                     let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_child_len &module3
//:                                     let checks2 checks_push checks1 check_eq_i32 0 selfhost_hir_child_range_first child_range
//:                                     let checks3 checks_push checks2 check_eq_i32 1 selfhost_hir_child_range_count child_range
//:                                     match selfhost_hir_module_get_child &module3 child_range 0:
//:                                         Option::Some got_child:
//:                                             let expected_child_idx <i32> selfhost_hir_expr_id_index child_id
//:                                             let got_child_idx <i32> selfhost_hir_expr_id_index got_child
//:                                             let checks4 checks_push checks3 check_eq_i32 expected_child_idx got_child_idx
//:                                             match selfhost_hir_module_get_expr &module3 parent_id:
//:                                                 Option::Some got_parent:
//:                                                     let checks5 checks_push checks4 check selfhost_hir_expr_kind_eq got_parent.kind SelfhostHirExprKind::Block
//:                                                     let checks6 checks_push checks5 check_eq_i32 1 got_parent.child_count
//:                                                     let checks7 checks_push checks6 check_eq_i32 0 got_parent.first_child
//:                                                     selfhost_hir_module_free module3
//:                                                     let shown checks_print_report checks7
//:                                                     checks_exit_code shown
//:                                                 Option::None:
//:                                                     selfhost_hir_module_free module3
//:                                                     let checks5 checks_push checks4 Result<(),str>::Err "missing parent expr"
//:                                                     let shown checks_print_report checks5
//:                                                     checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module3
//:                                             let checks4 checks_push checks3 Result<(),str>::Err "missing child id"
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                 Result::Err _e:
//:                                     let checks1 checks_push checks0 Result<(),str>::Err "parent expr push failed"
//:                                     let shown checks_print_report checks1
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<(),str>::Err "child range push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<(),str>::Err "child expr push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<(),str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/field" as field
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span <SelfhostSourceSpan> source_span_new 5 30 35
//:             let result_ty <SelfhostTypeId> selfhost_type_id_new 1
//:             let param0 <SelfhostHirParam> selfhost_hir_param_new "x" result_ty true span
//:             let params0 <Vec<SelfhostHirParam>> unwrap_ok v::new<SelfhostHirParam>
//:             let params1 <Vec<SelfhostHirParam>> unwrap_ok v::push<SelfhostHirParam> params0 param0
//:             match selfhost_hir_module_add_param_range module0 params1:
//:                 Result::Ok param_alloc:
//:                     let param_range <SelfhostHirParamRange> field::get param_alloc "param_range"
//:                     let module1 <SelfhostHirModule> field::get param_alloc "module"
//:                     let root_expr <SelfhostHirExpr> selfhost_hir_expr_leaf SelfhostHirExprKind::Unit result_ty span "" 0 false
//:                     match selfhost_hir_module_add_expr module1 root_expr:
//:                         Result::Ok expr_alloc:
//:                             let root <SelfhostHirExprId> field::get expr_alloc "expr_id"
//:                             let module2 <SelfhostHirModule> field::get expr_alloc "module"
//:                             let func <SelfhostHirFunction> selfhost_hir_function_with_params "main" result_ty span root param_range
//:                             match selfhost_hir_module_add_function module2 func:
//:                                 Result::Ok func_alloc:
//:                                     let function_id <SelfhostHirFunctionId> field::get func_alloc "function_id"
//:                                     let module3 <SelfhostHirModule> field::get func_alloc "module"
//:                                     let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_param_len &module3
//:                                     let checks2 checks_push checks1 check_eq_i32 0 selfhost_hir_param_range_first param_range
//:                                     let checks3 checks_push checks2 check_eq_i32 1 selfhost_hir_param_range_count param_range
//:                                     match selfhost_hir_module_get_param &module3 param_range 0:
//:                                         Option::Some got_param:
//:                                             let checks4 checks_push checks3 check_str_eq "x" got_param.name
//:                                             let checks5 checks_push checks4 check got_param.mutable
//:                                             match selfhost_hir_module_get_function &module3 function_id:
//:                                                 Option::Some got_func:
//:                                                     let got_range <SelfhostHirParamRange> selfhost_hir_function_param_range got_func
//:                                                     let checks6 checks_push checks5 check_eq_i32 0 selfhost_hir_param_range_first got_range
//:                                                     let checks7 checks_push checks6 check_eq_i32 1 selfhost_hir_param_range_count got_range
//:                                                     selfhost_hir_module_free module3
//:                                                     let shown checks_print_report checks7
//:                                                     checks_exit_code shown
//:                                                 Option::None:
//:                                                     selfhost_hir_module_free module3
//:                                                     let checks6 checks_push checks5 Result<(),str>::Err "missing function"
//:                                                     let shown checks_print_report checks6
//:                                                     checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module3
//:                                             let checks4 checks_push checks3 Result<(),str>::Err "missing param"
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                 Result::Err _e:
//:                                     let checks1 checks_push checks0 Result<(),str>::Err "function push failed"
//:                                     let shown checks_print_report checks1
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<(),str>::Err "root expr push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<(),str>::Err "param range push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<(),str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostHirFunctionId: HIR module 内の function table index
struct SelfhostHirFunctionId:
    index <i32>

impl Clone for SelfhostHirFunctionId:
    fn clone <(&SelfhostHirFunctionId)->SelfhostHirFunctionId> (self):
        *self

impl Copy for SelfhostHirFunctionId:
    fn copy_mark <(SelfhostHirFunctionId)->SelfhostHirFunctionId> (self):
        self

//: SelfhostHirExprId: HIR module 内の expression table index
struct SelfhostHirExprId:
    index <i32>

impl Clone for SelfhostHirExprId:
    fn clone <(&SelfhostHirExprId)->SelfhostHirExprId> (self):
        *self

impl Copy for SelfhostHirExprId:
    fn copy_mark <(SelfhostHirExprId)->SelfhostHirExprId> (self):
        self

//: SelfhostHirChildRangeItems: nonempty expression child table 範囲の payload
//:
//: [目的/もくてき]:
//: - child を持つ expression だけが child table の開始 index と個数を保持します。
struct SelfhostHirChildRangeItems:
    first_child <i32>
    child_count <i32>

impl Clone for SelfhostHirChildRangeItems:
    fn clone <(&SelfhostHirChildRangeItems)->SelfhostHirChildRangeItems> (self):
        *self

impl Copy for SelfhostHirChildRangeItems:
    fn copy_mark <(SelfhostHirChildRangeItems)->SelfhostHirChildRangeItems> (self):
        self

//: SelfhostHirChildRange: expression child table 上の連続範囲
//:
//: [目的/もくてき]:
//: - 空範囲を `-1` sentinel ではなく `Empty` variant として表し、payload の有無を match で確定します。
enum SelfhostHirChildRange:
    Empty
    Range <SelfhostHirChildRangeItems>

impl Clone for SelfhostHirChildRange:
    fn clone <(&SelfhostHirChildRange)->SelfhostHirChildRange> (self):
        *self

impl Copy for SelfhostHirChildRange:
    fn copy_mark <(SelfhostHirChildRange)->SelfhostHirChildRange> (self):
        self

//: SelfhostHirParamRangeItems: nonempty parameter table 範囲の payload
//:
//: [目的/もくてき]:
//: - parameter を持つ function だけが parameter table の開始 index と個数を保持します。
struct SelfhostHirParamRangeItems:
    first_param <i32>
    param_count <i32>

impl Clone for SelfhostHirParamRangeItems:
    fn clone <(&SelfhostHirParamRangeItems)->SelfhostHirParamRangeItems> (self):
        *self

impl Copy for SelfhostHirParamRangeItems:
    fn copy_mark <(SelfhostHirParamRangeItems)->SelfhostHirParamRangeItems> (self):
        self

//: SelfhostHirParamRange: parameter table 上の連続範囲
//:
//: [目的/もくてき]:
//: - 空範囲を `-1` sentinel ではなく `Empty` variant として表し、payload の有無を match で確定します。
enum SelfhostHirParamRange:
    Empty
    Range <SelfhostHirParamRangeItems>

impl Clone for SelfhostHirParamRange:
    fn clone <(&SelfhostHirParamRange)->SelfhostHirParamRange> (self):
        *self

impl Copy for SelfhostHirParamRange:
    fn copy_mark <(SelfhostHirParamRange)->SelfhostHirParamRange> (self):
        self

//: SelfhostHirExprKind: S4 初期段階で扱う HIR expression の分類
enum SelfhostHirExprKind:
    Error
    Unit
    BoolLiteral
    I32Literal
    StrLiteral
    Var
    Call
    Block
    If

impl Clone for SelfhostHirExprKind:
    fn clone <(&SelfhostHirExprKind)->SelfhostHirExprKind> (self):
        *self

impl Copy for SelfhostHirExprKind:
    fn copy_mark <(SelfhostHirExprKind)->SelfhostHirExprKind> (self):
        self

//: SelfhostHirParam: HIR function parameter record
//:
//: [目的/もくてき]:
//: - checker が確定した parameter name / type / mutability を function table から参照できるようにします。
struct SelfhostHirParam:
    name <str>
    ty <SelfhostTypeId>
    mutable <bool>
    span <SelfhostSourceSpan>

impl Clone for SelfhostHirParam:
    fn clone <(&SelfhostHirParam)->SelfhostHirParam> (self):
        *self

impl Copy for SelfhostHirParam:
    fn copy_mark <(SelfhostHirParam)->SelfhostHirParam> (self):
        self

//: SelfhostHirExpr: HIR expression record
//:
//: [目的/もくてき]:
//: - expression kind、型、span、child table 範囲、最小 payload を 1 record にまとめます。
//:
//: [注意/ちゅうい]:
//: - `name` は Var / Call / StrLiteral の初期 payload です。後続の symbol table / string table 導入時に分離します。
//: - `int_value` / `bool_value` は literal 用 payload です。使わない kind では 0 / false を入れます。
struct SelfhostHirExpr:
    kind <SelfhostHirExprKind>
    ty <SelfhostTypeId>
    span <SelfhostSourceSpan>
    first_child <i32>
    child_count <i32>
    name <str>
    int_value <i32>
    bool_value <bool>

impl Clone for SelfhostHirExpr:
    fn clone <(&SelfhostHirExpr)->SelfhostHirExpr> (self):
        *self

impl Copy for SelfhostHirExpr:
    fn copy_mark <(SelfhostHirExpr)->SelfhostHirExpr> (self):
        self

//: SelfhostHirFunction: HIR function record
//:
//: [目的/もくてき]:
//: - function name、戻り値型、span、root expression、parameter table 範囲を保持します。
struct SelfhostHirFunction:
    name <str>
    result <SelfhostTypeId>
    span <SelfhostSourceSpan>
    root <SelfhostHirExprId>
    first_param <i32>
    param_count <i32>

impl Clone for SelfhostHirFunction:
    fn clone <(&SelfhostHirFunction)->SelfhostHirFunction> (self):
        *self

impl Copy for SelfhostHirFunction:
    fn copy_mark <(SelfhostHirFunction)->SelfhostHirFunction> (self):
        self

//: SelfhostHirModule: HIR stage の arena root
struct SelfhostHirModule:
    functions <Vec<SelfhostHirFunction>>
    params <Vec<SelfhostHirParam>>
    exprs <Vec<SelfhostHirExpr>>
    expr_children <Vec<SelfhostHirExprId>>

//: SelfhostHirModuleExprAlloc: expression 追加結果
struct SelfhostHirModuleExprAlloc:
    module <SelfhostHirModule>
    expr_id <SelfhostHirExprId>

//: SelfhostHirModuleFunctionAlloc: function 追加結果
struct SelfhostHirModuleFunctionAlloc:
    module <SelfhostHirModule>
    function_id <SelfhostHirFunctionId>

//: SelfhostHirModuleChildRangeAlloc: child range 追加結果
struct SelfhostHirModuleChildRangeAlloc:
    module <SelfhostHirModule>
    child_range <SelfhostHirChildRange>

//: SelfhostHirModuleParamRangeAlloc: parameter range 追加結果
struct SelfhostHirModuleParamRangeAlloc:
    module <SelfhostHirModule>
    param_range <SelfhostHirParamRange>

//: selfhost_hir_function_id_new: function id を[作/つく]る
fn selfhost_hir_function_id_new <(i32)->SelfhostHirFunctionId> (index):
    SelfhostHirFunctionId index

//: selfhost_hir_function_id_index: function id の index を[返/かえ]す
fn selfhost_hir_function_id_index <(SelfhostHirFunctionId)->i32> (function_id):
    function_id.index

//: selfhost_hir_expr_id_new: expression id を[作/つく]る
fn selfhost_hir_expr_id_new <(i32)->SelfhostHirExprId> (index):
    SelfhostHirExprId index

//: selfhost_hir_expr_id_pending: expression id がまだ設定されていない状態を[返/かえ]す
fn selfhost_hir_expr_id_pending <()->Option<SelfhostHirExprId>> ():
    none<SelfhostHirExprId>

//: selfhost_hir_expr_id_assigned: expression id を Option に[包/つつ]む
fn selfhost_hir_expr_id_assigned <(SelfhostHirExprId)->Option<SelfhostHirExprId>> (expr_id):
    some<SelfhostHirExprId> expr_id

//: selfhost_hir_expr_id_index: expression id の index を[返/かえ]す
fn selfhost_hir_expr_id_index <(SelfhostHirExprId)->i32> (expr_id):
    expr_id.index

//: selfhost_hir_child_range_new: child table 範囲を[作/つく]る
fn selfhost_hir_child_range_new <(i32,i32)->SelfhostHirChildRange> (first_child, child_count):
    SelfhostHirChildRange::Range SelfhostHirChildRangeItems first_child child_count

//: selfhost_hir_child_range_empty: child を持たない範囲を[返/かえ]す
fn selfhost_hir_child_range_empty <()->SelfhostHirChildRange> ():
    SelfhostHirChildRange::Empty

//: selfhost_hir_child_range_first: child table の開始 index を[返/かえ]す
fn selfhost_hir_child_range_first <(SelfhostHirChildRange)->i32> (child_range):
    match child_range:
        SelfhostHirChildRange::Empty:
            0
        SelfhostHirChildRange::Range range:
            range.first_child

//: selfhost_hir_child_range_count: child 数を[返/かえ]す
fn selfhost_hir_child_range_count <(SelfhostHirChildRange)->i32> (child_range):
    match child_range:
        SelfhostHirChildRange::Empty:
            0
        SelfhostHirChildRange::Range range:
            range.child_count

//: selfhost_hir_param_range_new: parameter table 範囲を[作/つく]る
fn selfhost_hir_param_range_new <(i32,i32)->SelfhostHirParamRange> (first_param, param_count):
    SelfhostHirParamRange::Range SelfhostHirParamRangeItems first_param param_count

//: selfhost_hir_param_range_empty: parameter を持たない範囲を[返/かえ]す
fn selfhost_hir_param_range_empty <()->SelfhostHirParamRange> ():
    SelfhostHirParamRange::Empty

//: selfhost_hir_param_range_first: parameter table の開始 index を[返/かえ]す
fn selfhost_hir_param_range_first <(SelfhostHirParamRange)->i32> (param_range):
    match param_range:
        SelfhostHirParamRange::Empty:
            0
        SelfhostHirParamRange::Range range:
            range.first_param

//: selfhost_hir_param_range_count: parameter 数を[返/かえ]す
fn selfhost_hir_param_range_count <(SelfhostHirParamRange)->i32> (param_range):
    match param_range:
