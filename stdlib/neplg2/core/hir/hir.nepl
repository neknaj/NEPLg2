//:
//: [注意/ちゅうい]:
//: - 失敗時、入力 module の owner はこの関数が消費し、残り table を解放してから `Err` を返します。
fn selfhost_hir_module_add_expr <(SelfhostHirModule,SelfhostHirExpr)*>Result<SelfhostHirModuleExprAlloc, StdErrorKind>> (module, expr):
    let expr_id <SelfhostHirExprId> selfhost_hir_expr_id_new selfhost_hir_module_expr_len &module
