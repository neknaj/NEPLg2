#indent 4

//: # hir
//: NEPLg2.0 の解決済み中間表現を置くモジュールです。
//:
//: [目的/もくてき]:
//: - AST と typecheck 結果から backend 前の HIR へ落とす stage の受け皿を提供します。
//: - function / parameter / expression を table に保存し、後続 pass が stable id で参照できるようにします。
//: - deep HIR traversal を再帰ではなく explicit stack へ移すため、expression child も flat table で保持します。
//:
//: [実装/じっそう]:
//: - `SelfhostHirModule` は function / param / expr / expr_children の 4 つの Vec を所有します。
//: - `SelfhostHirFunctionId` と `SelfhostHirExprId` は arena-local index です。別 module の id と混ぜないでください。
//: - expression record は variant payload で kind 固有の情報を持ち、child table 範囲は child を持つ payload からだけ参照します。
//: - function record は typed parameter range から作り、first_param / param_count で param table 範囲を参照します。
//:
//: [注意/ちゅうい]:
//: - これは S4 HIR stage の最小 model です。完全な lowering、pattern、drop plan は別 issue で追加します。
//: - string literal は現時点では payload の `str` 値に lexeme / symbol を置く最小表現です。後で string table に分離します。
//:
//: [計算量/けいさんりょう]:
//: - record 追加は Vec の償却 O(1)、再確保時 O(n) です。
//: - id lookup と len は O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span %SelfhostSourceSpan source_span_new 3 10 14
//:             let result_ty %SelfhostTypeId selfhost_type_id_new 1
//:             let expr %SelfhostHirExpr selfhost_hir_expr_unit result_ty span
//:             match selfhost_hir_module_add_expr module0 expr:
//:                 Result::Ok expr_alloc:
//:                     let root %SelfhostHirExprId selfhost_hir_module_expr_alloc_expr_id &expr_alloc
//:                     let module1 %SelfhostHirModule selfhost_hir_module_expr_alloc_into_module expr_alloc
//:                     let func %SelfhostHirFunction selfhost_hir_function_new "main" result_ty span root 0 0
//:                     match selfhost_hir_module_add_function module1 func:
//:                         Result::Ok func_alloc:
//:                             let function_id %SelfhostHirFunctionId selfhost_hir_module_function_alloc_function_id &func_alloc
//:                             let module2 %SelfhostHirModule selfhost_hir_module_function_alloc_into_module func_alloc
//:                             let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_expr_len &module2
//:                             let checks2 checks_push checks1 check_eq_i32 1 selfhost_hir_module_function_len &module2
//:                             let checks3 checks_push checks2 check_eq_i32 0 selfhost_hir_expr_id_index root
//:                             let checks4 checks_push checks3 check_eq_i32 0 selfhost_hir_function_id_index function_id
//:                             match selfhost_hir_module_get_function &module2 function_id:
//:                                 Option::Some got_func:
//:                                     let checks5 checks_push checks4 check_str_eq "main" got_func.name
//:                                     match selfhost_hir_module_get_expr &module2 got_func.root:
//:                                         Option::Some got_expr:
//:                                             let checks6 checks_push checks5 check selfhost_hir_expr_kind_eq selfhost_hir_expr_kind &got_expr SelfhostHirExprKind::Unit
//:                                             selfhost_hir_module_free module2
//:                                             let shown checks_print_report checks6
//:                                             checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module2
//:                                             let checks6 checks_push checks5 Result<unit,str>::Err "missing root expr"
//:                                             let shown checks_print_report checks6
//:                                             checks_exit_code shown
//:                                 Option::None:
//:                                     selfhost_hir_module_free module2
//:                                     let checks5 checks_push checks4 Result<unit,str>::Err "missing function"
//:                                     let shown checks_print_report checks5
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<unit,str>::Err "function push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<unit,str>::Err "expr push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<unit,str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span %SelfhostSourceSpan source_span_new 4 20 25
//:             let result_ty %SelfhostTypeId selfhost_type_id_new 1
//:             let child_expr %SelfhostHirExpr selfhost_hir_expr_unit result_ty span
//:             match selfhost_hir_module_add_expr module0 child_expr:
//:                 Result::Ok child_alloc:
//:                     let child_id %SelfhostHirExprId selfhost_hir_module_expr_alloc_expr_id &child_alloc
//:                     let module1 %SelfhostHirModule selfhost_hir_module_expr_alloc_into_module child_alloc
//:                     let child_ids0 %Vec SelfhostHirExprId unwrap_ok v::new<SelfhostHirExprId>
//:                     let child_ids1 %Vec SelfhostHirExprId unwrap_ok v::push<SelfhostHirExprId> child_ids0 child_id
//:                     match selfhost_hir_module_add_child_range module1 child_ids1:
//:                         Result::Ok range_alloc:
//:                             let child_range %SelfhostHirChildRange selfhost_hir_module_child_range_alloc_child_range &range_alloc
//:                             let module2 %SelfhostHirModule selfhost_hir_module_child_range_alloc_into_module range_alloc
//:                             let parent_expr %SelfhostHirExpr selfhost_hir_expr_block result_ty span child_range
//:                             match selfhost_hir_module_add_expr module2 parent_expr:
//:                                 Result::Ok parent_alloc:
//:                                     let parent_id %SelfhostHirExprId selfhost_hir_module_expr_alloc_expr_id &parent_alloc
//:                                     let module3 %SelfhostHirModule selfhost_hir_module_expr_alloc_into_module parent_alloc
//:                                     let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_child_len &module3
//:                                     let checks2 checks_push checks1 check_eq_i32 0 selfhost_hir_child_range_first child_range
//:                                     let checks3 checks_push checks2 check_eq_i32 1 selfhost_hir_child_range_count child_range
//:                                     match selfhost_hir_module_get_child &module3 child_range 0:
//:                                         Option::Some got_child:
//:                                             let expected_child_idx %i32 selfhost_hir_expr_id_index child_id
//:                                             let got_child_idx %i32 selfhost_hir_expr_id_index got_child
//:                                             let checks4 checks_push checks3 check_eq_i32 expected_child_idx got_child_idx
//:                                             match selfhost_hir_module_get_expr &module3 parent_id:
//:                                                 Option::Some got_parent:
//:                                                     let checks5 checks_push checks4 check selfhost_hir_expr_kind_eq selfhost_hir_expr_kind &got_parent SelfhostHirExprKind::Block
//:                                                     let got_range %SelfhostHirChildRange selfhost_hir_expr_child_range &got_parent
//:                                                     let checks6 checks_push checks5 check_eq_i32 1 selfhost_hir_child_range_count got_range
//:                                                     let checks7 checks_push checks6 check_eq_i32 0 selfhost_hir_child_range_first got_range
//:                                                     selfhost_hir_module_free module3
//:                                                     let shown checks_print_report checks7
//:                                                     checks_exit_code shown
//:                                                 Option::None:
//:                                                     selfhost_hir_module_free module3
//:                                                     let checks5 checks_push checks4 Result<unit,str>::Err "missing parent expr"
//:                                                     let shown checks_print_report checks5
//:                                                     checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module3
//:                                             let checks4 checks_push checks3 Result<unit,str>::Err "missing child id"
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                 Result::Err _e:
//:                                     let checks1 checks_push checks0 Result<unit,str>::Err "parent expr push failed"
//:                                     let shown checks_print_report checks1
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<unit,str>::Err "child range push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<unit,str>::Err "child expr push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<unit,str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/hir/hir" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/ty/ty" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     let checks0 checks_new
//:     match selfhost_hir_module_new:
//:         Result::Ok module0:
//:             let span %SelfhostSourceSpan source_span_new 5 30 35
//:             let result_ty %SelfhostTypeId selfhost_type_id_new 1
//:             let param0 %SelfhostHirParam selfhost_hir_param_new "x" result_ty true span
//:             let params0 %Vec SelfhostHirParam unwrap_ok v::new<SelfhostHirParam>
//:             let params1 %Vec SelfhostHirParam unwrap_ok v::push<SelfhostHirParam> params0 param0
//:             match selfhost_hir_module_add_param_range module0 params1:
//:                 Result::Ok param_alloc:
//:                     let param_range %SelfhostHirParamRange selfhost_hir_module_param_range_alloc_param_range &param_alloc
//:                     let module1 %SelfhostHirModule selfhost_hir_module_param_range_alloc_into_module param_alloc
//:                     let root_expr %SelfhostHirExpr selfhost_hir_expr_unit result_ty span
//:                     match selfhost_hir_module_add_expr module1 root_expr:
//:                         Result::Ok expr_alloc:
//:                             let root %SelfhostHirExprId selfhost_hir_module_expr_alloc_expr_id &expr_alloc
//:                             let module2 %SelfhostHirModule selfhost_hir_module_expr_alloc_into_module expr_alloc
//:                             let func %SelfhostHirFunction selfhost_hir_function_with_params "main" result_ty span root param_range
//:                             match selfhost_hir_module_add_function module2 func:
//:                                 Result::Ok func_alloc:
//:                                     let function_id %SelfhostHirFunctionId selfhost_hir_module_function_alloc_function_id &func_alloc
//:                                     let module3 %SelfhostHirModule selfhost_hir_module_function_alloc_into_module func_alloc
//:                                     let checks1 checks_push checks0 check_eq_i32 1 selfhost_hir_module_param_len &module3
//:                                     let checks2 checks_push checks1 check_eq_i32 0 selfhost_hir_param_range_first param_range
//:                                     let checks3 checks_push checks2 check_eq_i32 1 selfhost_hir_param_range_count param_range
//:                                     match selfhost_hir_module_get_param &module3 param_range 0:
//:                                         Option::Some got_param:
//:                                             let checks4 checks_push checks3 check_str_eq "x" got_param.name
//:                                             let checks5 checks_push checks4 check got_param.mutable
//:                                             match selfhost_hir_module_get_function &module3 function_id:
//:                                                 Option::Some got_func:
//:                                                     let got_range %SelfhostHirParamRange selfhost_hir_function_param_range got_func
//:                                                     let checks6 checks_push checks5 check_eq_i32 0 selfhost_hir_param_range_first got_range
//:                                                     let checks7 checks_push checks6 check_eq_i32 1 selfhost_hir_param_range_count got_range
//:                                                     selfhost_hir_module_free module3
//:                                                     let shown checks_print_report checks7
//:                                                     checks_exit_code shown
//:                                                 Option::None:
//:                                                     selfhost_hir_module_free module3
//:                                                     let checks6 checks_push checks5 Result<unit,str>::Err "missing function"
//:                                                     let shown checks_print_report checks6
//:                                                     checks_exit_code shown
//:                                         Option::None:
//:                                             selfhost_hir_module_free module3
//:                                             let checks4 checks_push checks3 Result<unit,str>::Err "missing param"
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                 Result::Err _e:
//:                                     let checks1 checks_push checks0 Result<unit,str>::Err "function push failed"
//:                                     let shown checks_print_report checks1
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<unit,str>::Err "root expr push failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<unit,str>::Err "param range push failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<unit,str>::Err "module alloc failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

pub #import "./hir/id" as *
pub #import "./hir/range" as *
pub #import "./hir/expr" as *
pub #import "./hir/function" as *
pub #import "./hir/module" as *
pub #import "./hir/arena" as *
pub #import "./hir/stage0" as *
