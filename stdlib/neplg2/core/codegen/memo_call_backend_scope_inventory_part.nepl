//: SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority: event emit前に閉じたtraversal scope
//:
//: [目的/もくてき]:
//: - Rust側`ResourceFunction.blocks[].ops`列挙へ差し替える位置を、event tableのraw count引数から分離します。
//:
//: [契約/けいやく]:
//: - 現checkpointではcontext-bound operation projection全recordのkey / graph一致を検査してからscopeを発行します。
//: - `expected_event_count`はbody header 1件とscope内operation全件の合計です。emit後のevent table長から逆算しません。
//: - ownerを持たないmodule-private値であり、actual Resource IR function/block/op列挙完了を意味しません。
struct SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority:
    origin %SelfhostMemoCallBackendPrivateCacheTraversalScopeOrigin
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_count %i32
    expected_event_count %i32

impl Clone for SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority:
    fn clone %fn &SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority \self:
        *self

impl Copy for SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority:
    fn copy_mark %fn SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority SelfhostMemoCallBackendPrivateCacheResourceLoweringTraversalScopeAuthority \self:
        self


