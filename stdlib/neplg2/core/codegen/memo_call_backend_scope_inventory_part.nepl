    fn clone %fn &SelfhostMemoCallBackendPrivateCacheResourceIrOperationKind SelfhostMemoCallBackendPrivateCacheResourceIrOperationKind \self:
        *self

impl Copy for SelfhostMemoCallBackendPrivateCacheResourceIrOperationKind:
    fn copy_mark %fn SelfhostMemoCallBackendPrivateCacheResourceIrOperationKind SelfhostMemoCallBackendPrivateCacheResourceIrOperationKind \self:
        self

