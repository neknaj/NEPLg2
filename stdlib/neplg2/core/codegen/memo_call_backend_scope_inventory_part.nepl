//: SelfhostMemoCallBackendPrivateCacheResourceIrBlockInventoryRecord: ResourceFunction.blocks 1件の列挙記録
//:
//: [契約/けいやく]:
//: - block ordinalとterminator ordinalはそれぞれ`0..block_count`のdense順序です。
//: - operation rangeは全blockを通じたdenseなoperation ordinalを表し、次blockのrangeと隙間なく接続します。
//: - spanはRust ResourceBlock.spanのselfhost非負i32投影で、function spanとのsame-file/containmentはこの境界では要求しません。
//: - terminator spanはRust ResourceTerminator全variantが持つspanのselfhost非負i32投影で、block spanとのsame-file/containmentは要求しません。
//: - terminatorはeventへ合成しませんが、各blockで明示的に1件列挙したことをscope発行前に検査します。
struct SelfhostMemoCallBackendPrivateCacheResourceIrBlockInventoryRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    block_ordinal %i32
    block_id %i32
    span %SelfhostSourceSpan
    first_operation_ordinal %i32
    operation_count %i32
    terminator_ordinal %i32
    terminator_span %SelfhostSourceSpan
    terminator_kind %SelfhostMemoCallBackendPrivateCacheResourceIrTerminatorKind
    return_payload %SelfhostMemoCallBackendPrivateCacheResourceIrReturnPayload

struct SelfhostMemoCallBackendPrivateCacheResourceBlockSpanError:
    block_ordinal %i32
    span %SelfhostSourceSpan

struct SelfhostMemoCallBackendPrivateCacheResourceTerminatorSpanError:
    block_ordinal %i32
    span %SelfhostSourceSpan

struct SelfhostMemoCallBackendPrivateCacheResourceOperationSpanError:
    operation_ordinal %i32
    span %SelfhostSourceSpan

