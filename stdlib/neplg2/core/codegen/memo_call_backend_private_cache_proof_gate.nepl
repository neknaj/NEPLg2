//: selfhost_memo_call_backend_private_cache_proof_status_eq: proof status が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_status_eq %fn SelfhostMemoCallBackendPrivateCacheProofStatus fn SelfhostMemoCallBackendPrivateCacheProofStatus bool \a\b:
    match a:
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
                    true
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
                    false
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
                    false
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
                    true

//: selfhost_memo_call_backend_private_cache_proof_kind_eq: proof kind が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_kind_eq %fn SelfhostMemoCallBackendPrivateCacheProofKind fn SelfhostMemoCallBackendPrivateCacheProofKind bool \a\b:
    match a:
        SelfhostMemoCallBackendPrivateCacheProofKind::RequestOccurrenceGateEvidence:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofKind::RequestOccurrenceGateEvidence:
                    true

//: selfhost_memo_call_backend_private_cache_request_kind_eq: request kind が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_request_kind_eq %fn SelfhostMemoCallBackendRequestKind fn SelfhostMemoCallBackendRequestKind bool \a\b:
    match a:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            match b:
                SelfhostMemoCallBackendRequestKind::MemoCall:
                    true

//: selfhost_memo_call_backend_private_cache_proof_key_eq: proof key が同じ request boundary を指すか[返/かえ]す
pub fn selfhost_memo_call_backend_private_cache_proof_key_eq %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheProofKey bool \a\b:
    and:
        eq selfhost_hir_expr_id_index a.memoized_expr_id selfhost_hir_expr_id_index b.memoized_expr_id
        and:
            selfhost_def_id_eq a.source_function_def_id b.source_function_def_id
            and:
                selfhost_type_id_eq a.function_ty b.function_ty
                and:
                    eq selfhost_hir_expr_id_index a.root_expr_id selfhost_hir_expr_id_index b.root_expr_id
                    and:
                        eq a.body_module_fingerprint b.body_module_fingerprint
                        and:
                            selfhost_memo_call_backend_private_cache_request_kind_eq a.request_kind b.request_kind
                            and:
                                selfhost_effect_kind_eq a.source_effect b.source_effect
                                and:
                                    eq a.type_arg_count b.type_arg_count
                                    and:
                                        selfhost_memo_call_backend_private_cache_proof_kind_eq a.proof_kind b.proof_kind
                                        eq a.proof_schema_version b.proof_schema_version

//: selfhost_memo_call_backend_private_cache_proof_key_from_entry_result: request entry から proof key を[作/つく]る
fn selfhost_memo_call_backend_private_cache_proof_key_from_entry_result %fn SelfhostMemoCallBackendRequestTableEntry fn SelfhostHirExprId fn i32 Result SelfhostMemoCallBackendPrivateCacheProofKey SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \entry\root_expr_id\body_module_fingerprint:
    if:
        eq body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::BodyModuleFingerprintPlaceholder
        else:
            Result::Ok selfhost_memo_call_backend_private_cache_proof_key_new entry.memoized_expr_id entry.request.source_function_def_id entry.request.function_ty root_expr_id body_module_fingerprint entry.request.request_kind entry.request.source_effect entry.request.type_arg_count

//: selfhost_memo_call_backend_private_cache_proof_lookup_finish: proof lookup の最終状態を[畳/たた]む
fn selfhost_memo_call_backend_private_cache_proof_lookup_finish %fn SelfhostMemoCallBackendPrivateCacheProofKey fn Option SelfhostMemoCallBackendPrivateCacheProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \key\found:
    match found:
        Option::Some status:
            Result::Ok status
        Option::None:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofMissing key

//: selfhost_memo_call_backend_private_cache_proof_lookup_loop: proof table から matching status を[探/さが]す
//:
//: [契約/けいやく]:
//: - matching proof が 2 件以上ある場合は `ProofDuplicate` として拒否します。record order による first-wins は使いません。
fn selfhost_memo_call_backend_private_cache_proof_lookup_loop %fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostMemoCallBackendPrivateCacheProofKey fn i32 fn Option SelfhostMemoCallBackendPrivateCacheProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \proofs\key\idx\found:
    if:
        ge idx selfhost_memo_call_backend_private_cache_proof_table_len proofs
        then:
            selfhost_memo_call_backend_private_cache_proof_lookup_finish key found
        else:
            let records %&Vec SelfhostMemoCallBackendPrivateCacheProofRecord field::get_ref proofs "records"
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_memo_call_backend_private_cache_proof_key_eq record.key key
                        then:
