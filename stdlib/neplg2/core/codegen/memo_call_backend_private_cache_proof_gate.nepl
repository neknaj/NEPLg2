fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_get %fn &SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable fn i32 Option SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord \table\idx:
    let records %&Vec SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord field::get_ref table "records"
    v::get records idx

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_record_validate_result: witness authority field を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - placeholder fingerprint、負の graph id、負の ordinal、root/support ordinal の重複は fresh witness の根拠として扱いません。
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_record_validate_result %fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord Result unit SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \record:
    if:
        eq record.key.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessBodyModuleFingerprintPlaceholder record.key
        else:
            if:
                lt record.graph_id.index 0
                then:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessGraphIdInvalid record.graph_id.index
                else:
                    if:
                        lt record.root_operation_ordinal 0
                        then:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessOperationOrdinalInvalid record.root_operation_ordinal
                        else:
                            if:
                                lt record.support_operation_ordinal 0
                                then:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessOperationOrdinalInvalid record.support_operation_ordinal
                                else:
                                    if:
                                        eq record.root_operation_ordinal record.support_operation_ordinal
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRootSupportOrdinalDuplicate record.root_operation_ordinal
                                        else:
                                            Result::Ok unit

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_record_identity_eq: witness record の identity が同じか[返/かえ]す
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_record_identity_eq %fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord bool \a\b:
    and:
        selfhost_memo_call_backend_private_cache_proof_key_eq a.key b.key
        selfhost_memo_call_backend_private_cache_resource_graph_id_eq a.graph_id b.graph_id
        eq a.root_operation_ordinal b.root_operation_ordinal
        eq a.support_operation_ordinal b.support_operation_ordinal

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_loop: 同じ witness identity が既にあるか[探/さが]す
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_loop %fn &SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord fn i32 fn i32 Result bool SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\record\idx\n:
    if:
        ge idx n
        then:
            Result::Ok false
        else:
            match selfhost_memo_call_backend_private_cache_region_fresh_witness_table_get table idx:
                Option::Some existing:
                    if:
                        selfhost_memo_call_backend_private_cache_region_fresh_witness_record_identity_eq existing record
                        then:
                            Result::Ok true
                        else:
                            selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_loop table record add idx 1 n
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_result: duplicate witness を[検査/けんさ]する
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_result %fn &SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord Result bool SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\record:
    selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_loop table record 0 selfhost_memo_call_backend_private_cache_region_fresh_witness_table_len table

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_table_push: fresh witness record を table へ[追加/ついか]する
//:
//: [契約/けいやく]:
//: - invalid witness と duplicate witness は owner table を閉じて fail-closed にします。record order による first-wins は使いません。
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_push %impure fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable impure fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord Result SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\record:
    match selfhost_memo_call_backend_private_cache_region_fresh_witness_record_validate_result record:
        Result::Ok _valid:
            match selfhost_memo_call_backend_private_cache_region_fresh_witness_table_contains_result &table record:
                Result::Ok exists:
                    if:
                        exists
                        then:
                            selfhost_memo_call_backend_private_cache_region_fresh_witness_table_free table
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessDuplicate record.key
                        else:
                            let records %Vec SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord field::get table "records"
                            match v::push records record:
                                Result::Ok next_records:
                                    Result::Ok SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable next_records
                                Result::Err e:
                                    let error %StdErrorKind field::get e "error"
                                    v::free v::vec_push_error_vec e
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRecordPushFailed error
                Result::Err e:
                    selfhost_memo_call_backend_private_cache_region_fresh_witness_table_free table
                    Result::Err e
        Result::Err e:
            selfhost_memo_call_backend_private_cache_region_fresh_witness_table_free table
            Result::Err e

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_candidate_validate_result: candidate record が accepted 中間状態か[確認/かくにん]する
//:
//: [契約/けいやく]:
//: - candidate record も再検査します。private helper 由来であっても、placeholder key や不正 ordinal を witness bridge の成功に使いません。
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_candidate_validate_result %fn SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord Result unit SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \candidate:
    if:
        eq candidate.key.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessBodyModuleFingerprintPlaceholder candidate.key
        else:
            if:
                lt candidate.graph_id.index 0
                then:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessGraphIdInvalid candidate.graph_id.index
                else:
                    if:
                        lt candidate.root_operation_ordinal 0
                        then:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessOperationOrdinalInvalid candidate.root_operation_ordinal
                        else:
                            if:
                                lt candidate.support_operation_ordinal 0
                                then:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessOperationOrdinalInvalid candidate.support_operation_ordinal
                                else:
                                    if:
                                        eq candidate.root_operation_ordinal candidate.support_operation_ordinal
                                        then:
