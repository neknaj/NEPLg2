                                lt candidate.support_operation_ordinal 0
                                then:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessOperationOrdinalInvalid candidate.support_operation_ordinal
                                else:
                                    if:
                                        eq candidate.root_operation_ordinal candidate.support_operation_ordinal
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRootSupportOrdinalDuplicate candidate.root_operation_ordinal
                                        else:
                                            match candidate.status:
                                                SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus::PrivateCacheRegionNoEscapeCandidateAccepted:
                                                    Result::Ok unit

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_resource_table_from_candidate: accepted candidate から Resource proof table を 1 件[作/つく]る
//:
//: [契約/けいやく]:
//: - ここで作るのは module-private Resource proof table だけです。request-evidence gate、Pure mask、backend bytes、artifact key は作りません。
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_resource_table_from_candidate %impure fn SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord Result SelfhostMemoCallBackendPrivateCacheResourceProofTable SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \candidate:
