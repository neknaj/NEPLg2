//: - coverage source validation が先に同じ identity を確認していても、この境界が `EffectObservedNoEscape` の発行点なので candidate の root / fingerprint / graph を直接照合します。
fn selfhost_memo_call_backend_private_cache_actual_traversal_private_effect_no_escape_coverage_candidate_validate_result %fn SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageCompleteAuthority fn SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord Result unit SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind \authority\candidate:
    if:
        eq authority.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::CoverageRejected SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                not eq candidate.key.body_module_fingerprint authority.body_module_fingerprint
                then:
                    Result::Err SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::CoverageRejected SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind::SourceBodyIdentityMismatch
                else:
