                                                else:
                                                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop table add idx 1 n expected_key expected_graph_id true record.operation_ordinal seen_support support_operation_ordinal
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionSupportCandidate:
                                    if:
                                        seen_support
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofSupportDuplicate record.key
                                        else:
                                            if:
                                                and seen_root eq record.operation_ordinal root_operation_ordinal
                                                then:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofOperationOrdinalDuplicate record.operation_ordinal
                                                else:
                                                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop table add idx 1 n expected_key expected_graph_id seen_root root_operation_ordinal true record.operation_ordinal
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionMayEscape:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMayEscape record.key
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionObservationRejected:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofObservationRejected record.key
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnsupported:
