//: - operation ordinal は同じ graph 内の Resource event id として扱います。future walker が同じ ordinal を二重発行した場合は fail-closed にします。
fn selfhost_memo_call_backend_private_cache_resource_graph_edge_identity_eq %fn SelfhostMemoCallBackendPrivateCacheResourceGraphEdgeRecord fn SelfhostMemoCallBackendPrivateCacheResourceGraphEdgeRecord bool \a\b:
    and:
        selfhost_memo_call_backend_private_cache_proof_key_eq a.key b.key
        and:
            selfhost_memo_call_backend_private_cache_resource_graph_id_eq a.graph_id b.graph_id
            eq a.operation_ordinal b.operation_ordinal

