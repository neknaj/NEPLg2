                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnavailable:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnavailable record.key
                        else:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofGraphMismatch record.graph_id.index
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofKeyMismatch record.key
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop: region proof table を no-escape candidate 直前で[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - wildcard fallback は使いません。region proof status が増えた場合、それを candidate、escape、observation、unsupported、unavailable のどれとして扱うかを明示します。
//: - loop が成功しても返すのは `PrivateCacheRegionNoEscapeCandidateAccepted` だけです。既存 `PrivateCacheNoEscapeProven` や `RequestEvidenceProven` へ変換しません。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable fn i32 fn i32 fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceGraphId fn bool fn i32 fn bool fn i32 Result SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\idx\n\expected_key\expected_graph_id\seen_root\root_operation_ordinal\seen_support\support_operation_ordinal:
    if:
        ge idx n
        then:
            if:
                and seen_root seen_support
                then:
                    Result::Ok selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_new expected_key expected_graph_id root_operation_ordinal support_operation_ordinal
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMissingFreshRegion
        else:
            match selfhost_memo_call_backend_private_cache_region_proof_table_get table idx:
                Option::Some record:
                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_scan_record_result table idx n expected_key expected_graph_id seen_root root_operation_ordinal seen_support support_operation_ordinal record
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_from_table_result: region proof table を candidate record へ[進/すす]める
//:
//: [契約/けいやく]:
//: - empty table は missing fresh region と同一視せず、`RegionProofEmpty` として分けます。producer が何も観測していない場合と、root/support の片方だけを観測した場合では原因が違うためです。
//: - 最初の record の key / graph id を期待値として使い、残りの record が同じ request occurrence と同じ graph に属することを検査します。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_from_table_result %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable Result SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table:
    let n %i32 selfhost_memo_call_backend_private_cache_region_proof_table_len table
    if:
        eq n 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofEmpty
        else:
            match selfhost_memo_call_backend_private_cache_region_proof_table_get table 0:
                Option::Some first:
                    match selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_validate_result first:
                        Result::Ok _valid:
                            selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop table 0 n first.key first.graph_id false -1 false -1
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRecordReadFailed 0

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_i32_result: candidate record result を smoke count へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - i32 へ写すのは public doctest / source policy の代表結果用です。candidate record 自体は private のままにし、accepted Resource proof や backend plan の代替にしません。
