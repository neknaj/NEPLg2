fn selfhost_memo_call_backend_private_cache_proof_gate_request_table_contains_key_loop %fn &SelfhostMemoCallBackendRequestTable fn SelfhostHirExprId fn i32 fn SelfhostMemoCallBackendPrivateCacheProofKey fn i32 fn i32 Result bool SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \table\root_expr_id\body_module_fingerprint\key\idx\n:
