fn selfhost_memo_call_backend_private_cache_proof_lookup_result %fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostMemoCallBackendPrivateCacheProofKey Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \proofs\key:
    selfhost_memo_call_backend_private_cache_proof_lookup_loop proofs key 0 none

//: selfhost_memo_call_backend_private_cache_proof_gate_request_record_matches: table entry と HIR 再構築 request が一致するか[返/かえ]す
//:
//: [契約/けいやく]:
//: - diagnostic metadata は比較しません。`diagnostic_symbol` と `diagnostic_span` は表示・source map 用であり、identity authority ではないためです。
fn selfhost_memo_call_backend_private_cache_proof_gate_request_record_matches %fn &SelfhostMemoCallBackendRequestTableEntry fn SelfhostMemoCallBackendRequest bool \entry\rebuilt:
    let stored %SelfhostMemoCallBackendRequest *field::get_ref entry "request"
    let stored_kind_ok %bool match stored.request_kind:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            true
    let rebuilt_kind_ok %bool match rebuilt.request_kind:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            true
    let def_id_ok %bool selfhost_def_id_eq stored.source_function_def_id rebuilt.source_function_def_id
    let type_ok %bool selfhost_type_id_eq stored.function_ty rebuilt.function_ty
    let stored_effect_ok %bool selfhost_effect_kind_eq stored.source_effect SelfhostEffectKind::Pure
    let rebuilt_effect_ok %bool selfhost_effect_kind_eq rebuilt.source_effect SelfhostEffectKind::Pure
    let type_args_ok %bool and eq stored.type_arg_count 0 eq rebuilt.type_arg_count 0
    and stored_kind_ok and rebuilt_kind_ok and and def_id_ok type_ok and and stored_effect_ok rebuilt_effect_ok type_args_ok

//: selfhost_memo_call_backend_private_cache_proof_gate_recheck_entry_result: 1 request entry を HIR に対して[再/さい][検査/けんさ]する
fn selfhost_memo_call_backend_private_cache_proof_gate_recheck_entry_result %fn &SelfhostHirModule fn SelfhostMemoCallBackendRequestTableEntry Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\entry:
