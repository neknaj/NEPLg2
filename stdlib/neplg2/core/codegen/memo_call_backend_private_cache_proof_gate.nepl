            selfhost_memo_call_backend_private_cache_resource_proof_table_free resource_proofs
            match gate_result:
                Result::Ok summary:
                    Result::Ok summary
                Result::Err e:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessResourceProofRejected e
        Result::Err e:
            Result::Err e

