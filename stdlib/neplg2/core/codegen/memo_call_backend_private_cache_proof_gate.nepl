            let refuted_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheProofGateErrorKind selfhost_memo_call_backend_private_cache_proof_gate_stage0_run_i32_result SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted
            Result::Ok SelfhostMemoCallBackendPrivateCacheProofGateStage0Summary accepted.request_count accepted.proven_request_count missing_rejected refuted_rejected
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_backend_readiness_request_status_from_gate_result: request-evidence gate result を readiness 用 status へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - 既存 request-evidence gate の `Err` と、count 不足 / count 矛盾を module-private status として分けます。
//:
//: [契約/けいやく]:
//: - `RequestEvidenceReady` になっても、private effect mask evidence と照合するまでは backend readiness ではありません。
//: - `body_module_fingerprint == 0` は placeholder origin なので、request evidence 側でも拒否します。
fn selfhost_memo_call_backend_private_cache_backend_readiness_request_status_from_gate_result %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus \root_expr_id\body_module_fingerprint\gate_result:
    if:
        eq body_module_fingerprint 0
        then:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceBodyModuleFingerprintPlaceholder
        else:
            match gate_result:
                Result::Ok summary:
                    if:
                        eq summary.request_count 0
                        then:
                            SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceEmpty
                        else:
                            if:
                                gt summary.proven_request_count summary.request_count
                                then:
                                    SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceInconsistent
                                else:
                                    if:
                                        not eq summary.proven_request_count summary.request_count
                                        then:
                                            SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceIncomplete
                                        else:
                                            SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceReady SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence root_expr_id body_module_fingerprint summary.request_count summary.proven_request_count
                Result::Err _e:
                    SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceRejected

//: selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_mask_result: private-effect mask status を readiness 用 status へ[包/つつ]む
//:
//: [契約/けいやく]:
//: - status だけを readiness gate へ渡しません。request evidence と同じ root / body fingerprint を指すことを後段で照合します。
fn selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_mask_result %fn SelfhostHirExprId fn i32 fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus \root_expr_id\body_module_fingerprint\status:
    if:
        eq body_module_fingerprint 0
        then:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus::MaskEvidenceBodyModuleFingerprintPlaceholder
        else:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus::MaskEvidenceReady SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence root_expr_id body_module_fingerprint status

//: selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_status: upstream private-effect status を readiness mask status へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - request-evidence proof record への変換とは別に、upper orchestration が渡した private-effect proof status を readiness 用 mask status へ写します。
//:
//: [契約/けいやく]:
//: - `UpstreamPrivateEffectProven` だけを `PrivateEffectMaskProven` にします。
//: - Missing / Unknown は producer error へ潰さず readiness mask status として保持し、readiness gate で fail-closed にします。
fn selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_status %fn SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus \status:
    match status:
        SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectProven:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskProven
        SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskRefuted
        SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskMissing
        SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskUnknown

//: selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_evidence: upstream private-effect evidence を identity-bearing mask evidence へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - evidence の root / body fingerprint を mask evidence 側 identity として使います。request evidence 側 identity は caller の HIR root / body fingerprint から別に作り、後段 gate で照合します。
//: - この conversion は checker-layer gate、Resource proof table、request-evidence proof table、GraphInput、backend bytes、effect mask 実体、artifact key を作りません。
fn selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_evidence %fn SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus \evidence:
    let mask_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_status evidence.status
    selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_mask_result evidence.root_expr_id evidence.body_module_fingerprint mask_status

//: selfhost_memo_call_backend_private_cache_backend_readiness_identity_matches: request evidence と mask evidence が同じ body を[指/さ]すか[返/かえ]す
fn selfhost_memo_call_backend_private_cache_backend_readiness_identity_matches %fn &SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence fn &SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence bool \request\mask:
    and:
        eq selfhost_hir_expr_id_index request.root_expr_id selfhost_hir_expr_id_index mask.root_expr_id
        eq request.body_module_fingerprint mask.body_module_fingerprint

//: selfhost_memo_call_backend_private_cache_backend_readiness_gate_result: request evidence と private effect mask evidence を[合成/ごうせい]する
//:
//: [目的/もくてき]:
//: - request occurrence evidence と private effect mask evidence が同じ body に対して揃った場合だけ、non-executable readiness summary を返します。
//:
//: [契約/けいやく]:
//: - `PrivateEffectMaskProven` だけを受け入れます。missing / unknown / refuted は wildcard で丸めず、個別 error として返します。
//: - この gate は backend bytes、effect mask 実体、sealed representation、artifact key、proof table record を生成しません。
fn selfhost_memo_call_backend_private_cache_backend_readiness_gate_result %fn SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence Result SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \request\mask:
    if:
        not selfhost_memo_call_backend_private_cache_backend_readiness_identity_matches &request &mask
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::PrivateEffectMaskIdentityMismatch
        else:
            match mask.status:
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskProven:
                    Result::Ok SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary request.root_expr_id request.body_module_fingerprint request.request_count request.proven_request_count SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskProven
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskRefuted:
                    Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::PrivateEffectMaskRefuted
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskMissing:
                    Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::PrivateEffectMaskMissing
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus::PrivateEffectMaskUnknown:
                    Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::PrivateEffectMaskUnknown

//: selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_status_result: readiness status 同士を public Result へ[畳/たた]む
fn selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_status_result %fn SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus Result SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \request_status\mask_status:
    match request_status:
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceReady request:
            match mask_status:
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus::MaskEvidenceReady mask:
                    selfhost_memo_call_backend_private_cache_backend_readiness_gate_result request mask
                SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus::MaskEvidenceBodyModuleFingerprintPlaceholder:
                    Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::BodyModuleFingerprintPlaceholder
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceRejected:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::RequestEvidenceRejected
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceEmpty:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::RequestEvidenceEmpty
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceIncomplete:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::RequestEvidenceIncomplete
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceInconsistent:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::RequestEvidenceInconsistent
        SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus::RequestEvidenceBodyModuleFingerprintPlaceholder:
            Result::Err SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind::BodyModuleFingerprintPlaceholder

//: selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result: gate result と mask status から readiness summary を[作/つく]る
fn selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus Result SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \root_expr_id\body_module_fingerprint\gate_result\mask_status:
    let request_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus selfhost_memo_call_backend_private_cache_backend_readiness_request_status_from_gate_result root_expr_id body_module_fingerprint gate_result
    let mask_ready_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_mask_result root_expr_id body_module_fingerprint mask_status
    selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_status_result request_status mask_ready_status

//: selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result_and_upstream_private_effect_evidence: request gate result と upstream private-effect evidence から readiness summary を[作/つく]る
//:
//: [目的/もくてき]:
//: - request occurrence evidence と upstream private-effect mask evidence を、同じ body identity で揃った場合だけ readiness summary へ進めます。
//:
//: [契約/けいやく]:
//: - request evidence 側 identity は caller が渡した HIR root / body fingerprint から作ります。
//: - mask evidence 側 identity は upstream evidence から作ります。両者が一致しない場合は `PrivateEffectMaskIdentityMismatch` で拒否します。
fn selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result_and_upstream_private_effect_evidence %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence Result SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \root_expr_id\body_module_fingerprint\gate_result\upstream_evidence:
    let request_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus selfhost_memo_call_backend_private_cache_backend_readiness_request_status_from_gate_result root_expr_id body_module_fingerprint gate_result
    let mask_ready_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus selfhost_memo_call_backend_private_cache_backend_readiness_mask_status_from_upstream_private_effect_evidence upstream_evidence
    selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_status_result request_status mask_ready_status

//: selfhost_memo_call_backend_private_cache_backend_readiness_count_from_evidence_result: stage0 用に readiness summary を i32 result へ[写/うつ]す
fn selfhost_memo_call_backend_private_cache_backend_readiness_count_from_evidence_result %fn SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \request\mask:
    match selfhost_memo_call_backend_private_cache_backend_readiness_gate_result request mask:
        Result::Ok summary:
            Result::Ok summary.request_count
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result: gate result と mask status から代表 count を[返/かえ]す
fn selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \root_expr_id\body_module_fingerprint\gate_result\mask_status:
    match selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result root_expr_id body_module_fingerprint gate_result mask_status:
        Result::Ok summary:
            Result::Ok summary.request_count
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result_and_upstream_private_effect_evidence: upstream private-effect readiness summary を count result へ[写/うつ]す
fn selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result_and_upstream_private_effect_evidence %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \root_expr_id\body_module_fingerprint\gate_result\upstream_evidence:
    match selfhost_memo_call_backend_private_cache_backend_readiness_summary_from_gate_result_and_upstream_private_effect_evidence root_expr_id body_module_fingerprint gate_result upstream_evidence:
        Result::Ok summary:
            Result::Ok summary.request_count
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_upstream_status_from_private_effect_handoff_status: public handoff status を private upstream status へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - 全 variant を明示 match し、Missing / Unknown を Proven に丸めません。
fn selfhost_memo_call_backend_private_cache_upstream_status_from_private_effect_handoff_status %fn SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus \status:
    match status:
        SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus::Proven:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectProven
        SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus::Refuted:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus::Missing:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus::Unknown:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown

//: selfhost_memo_call_backend_private_cache_upstream_evidence_from_private_effect_handoff_evidence: public handoff evidence を private upstream evidence へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - root / body fingerprint は handoff evidence 側の値をそのまま使います。request evidence 側 identity は readiness gate の既存照合に任せます。
fn selfhost_memo_call_backend_private_cache_upstream_evidence_from_private_effect_handoff_evidence %fn SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffEvidence SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence \evidence:
    let status %SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus selfhost_memo_call_backend_private_cache_upstream_status_from_private_effect_handoff_status evidence.status
    SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence evidence.root_expr_id evidence.body_module_fingerprint status

//: selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result_and_private_effect_handoff_evidence: public handoff から backend readiness count を[返/かえ]す
//:
//: [目的/もくてき]:
//: - checker-layer upper orchestration が、mask evidence status を backend private 型へ触れずに既存 readiness gate へ渡せるようにします。
//:
//: [契約/けいやく]:
//: - request evidence identity は caller が渡す root / body fingerprint から作り、mask evidence identity は handoff evidence から作ります。両者は既存 readiness gate で照合します。
//: - この helper は non-executable readiness probe です。backend bytes、effect mask 実体、sealed representation、`.neplobj` / `.neplproof` artifact key を作りません。
pub fn selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result_and_private_effect_handoff_evidence %fn SelfhostHirExprId fn i32 fn Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffEvidence Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind \root_expr_id\body_module_fingerprint\gate_result\handoff_evidence:
    let upstream_evidence %SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence selfhost_memo_call_backend_private_cache_upstream_evidence_from_private_effect_handoff_evidence handoff_evidence
    selfhost_memo_call_backend_private_cache_backend_readiness_count_from_gate_result_and_upstream_private_effect_evidence root_expr_id body_module_fingerprint gate_result upstream_evidence

//: selfhost_memo_call_backend_private_cache_actual_traversal_private_effect_upstream_status_from_source_kind: traversal source kind を neutral upstream private-effect status へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - actual traversal source table を backend readiness の upstream evidence に渡す前に、現時点で証明できないものを fail-closed status へ分類します。
//:
//: [契約/けいやく]:
//: - この projection は explicit 2-slot coverage / checker mask evidence ではありません。`UpstreamPrivateEffectProven` は返しません。
//: - accepted-shaped graph source は「private effect slot が証明された」ことを意味しないため Missing にします。
//: - private-effect operation、unsupported、unavailable は Unknown にし、escape / public store / observable identity は Refuted にします。
fn selfhost_memo_call_backend_private_cache_actual_traversal_private_effect_upstream_status_from_source_kind %fn SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus \kind:
    match kind:
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PrivateCacheStoragePlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PrivateCacheEntryPlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::ReturnedOwnedClonePlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::ReturnCacheReferencePlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PublicStorePlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::ExternalHandlePlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::UnsupportedPlace:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::OwnsEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::BorrowViewEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CloneOutOwnedValueEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectMissing
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::ReturnCacheReferenceEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PublicStoreEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CallBoundaryUnsupportedEdge:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheLookupOperation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheInsertOperation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PrivateCacheEffectOperation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::PrivateStateEffectOperation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectUnknown
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheHitObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheMissObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheSizeObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheStatsObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheClearObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheDebugObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::CacheRegionIdentityObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::FunctionIdentityObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::FunctionHashObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::FunctionDebugObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::ClosureAllocationIdentityObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::RawIdentityObservation:
            SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus::UpstreamPrivateEffectRefuted
        SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind::RawRepresentationObservation:
