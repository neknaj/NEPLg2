//: - graph input はまず private Resource proof table に畳まれ、その後で既存 request-evidence gate に通されます。graph record を直接 request accepted proof として扱いません。
fn selfhost_memo_call_backend_private_cache_resource_graph_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheResourceGraphInput Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind \module\root\fuel\body_module_fingerprint\graph:
