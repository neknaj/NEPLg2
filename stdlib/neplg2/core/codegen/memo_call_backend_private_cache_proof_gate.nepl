//: selfhost_memo_call_backend_private_cache_resource_graph_closed_status_result: closed graph を Resource proof status へ[畳/たた]む
//:
//: [契約/けいやく]:
//: - `ClosedForPrivateCacheBoundary` でも place が 1 件もない graph は proof authority として不十分です。empty graph は `Unknown` に倒し、accepted path へ進めません。
fn selfhost_memo_call_backend_private_cache_resource_graph_closed_status_result %fn &SelfhostMemoCallBackendPrivateCacheResourceGraphInput fn SelfhostMemoCallBackendPrivateCacheResourceGraphBodyRecord Result SelfhostMemoCallBackendPrivateCacheResourceProofStatus SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind \input\body:
    let initial %SelfhostMemoCallBackendPrivateCacheResourceGraphFoldSummary selfhost_memo_call_backend_private_cache_resource_graph_fold_summary_new SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheNoEscapeProven false
    match selfhost_memo_call_backend_private_cache_resource_graph_fold_places_loop input body 0 initial:
        Result::Ok place_summary:
            if:
                place_summary.saw_place
                then:
                    match selfhost_memo_call_backend_private_cache_resource_graph_fold_edges_loop input body 0 place_summary:
                        Result::Ok edge_summary:
                            Result::Ok edge_summary.status
                        Result::Err e:
                            Result::Err e
                else:
                    Result::Ok SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheUnknown
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_resource_graph_body_to_status_result: graph body を Resource proof status へ[写/うつ]す
