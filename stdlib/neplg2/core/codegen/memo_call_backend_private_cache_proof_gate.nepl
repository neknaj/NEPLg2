                        then:
                            Result::Ok unit
                        else:
                            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestIdentityMismatch entry.memoized_expr_id
                Result::Err request_error:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestRecheckRejected SelfhostMemoCallBackendRequestRejection entry.memoized_expr_id request_error.kind
        Option::None:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestExpressionMissing entry.memoized_expr_id

