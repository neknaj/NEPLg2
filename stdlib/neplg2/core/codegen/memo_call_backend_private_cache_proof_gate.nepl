                selfhost_memo_call_backend_private_cache_proof_key_eq record.key expected_key
                then:
                    if:
                        selfhost_memo_call_backend_private_cache_resource_graph_id_eq record.graph_id expected_graph_id
                        then:
                            match record.status:
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionRootCandidate:
                                    if:
                                        seen_root
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRootDuplicate record.key
                                        else:
                                            if:
                                                and seen_support eq record.operation_ordinal support_operation_ordinal
                                                then:
