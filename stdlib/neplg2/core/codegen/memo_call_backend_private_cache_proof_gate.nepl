    SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord key graph_id root_operation_ordinal support_operation_ordinal status

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_table_new: [空/から]の fresh witness table を[作/つく]る
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_new %impure fn void Result SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \void:
    let records_result %Result Vec SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord StdErrorKind v::new
