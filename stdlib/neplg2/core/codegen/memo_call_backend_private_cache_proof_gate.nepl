#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *
#import "./memo_call_backend_request" as *
#import "./memo_call_backend_request_table" as *

//: SelfhostMemoCallBackendPrivateCacheProofStatus: memo_call PrivateCache request-evidence の[状態/じょうたい]
//:
//: [目的/もくてき]:
//: - gate が要求する request occurrence evidence の成功と反証を bool に潰さず、match の網羅性検査で分岐できるようにします。
//:
//: [契約/けいやく]:
//: - `RequestEvidenceProven` はこの gate の入力 record が request occurrence と一致したことを表すだけです。PrivateCache region の non-escape、effect masking、backend cache correctness を証明した status として扱ってはいけません。
enum SelfhostMemoCallBackendPrivateCacheProofStatus:
    RequestEvidenceProven
    RequestEvidenceRefuted

//: SelfhostMemoCallBackendPrivateCacheProofKind: proof record が何を証明する record かを示す分類
//:
//: [目的/もくてき]:
//: - 将来 `PrivateCacheRegionNoEscape` や `NoObservation` などの proof が増えたとき、request occurrence gate 用 record と混同しないようにします。
pub enum SelfhostMemoCallBackendPrivateCacheProofKind:
    RequestOccurrenceGateEvidence

//: SelfhostMemoCallBackendPrivateCacheProofKey: memo_call PrivateCache proof と request を[結/むす]び[付/つ]ける key
//:
//: [契約/けいやく]:
//: - `memoized_expr_id` は同じ source function を複数回 memoize した occurrence を区別します。
//: - `source_function_def_id` と `function_ty` は HIR leaf の function identity から得た typed evidence です。
//: - `root_expr_id` と `body_module_fingerprint` は session-local HIR id の origin を縛り、別 root / 別 module の proof reuse を防ぎます。
//: - `request_kind`、`source_effect`、`type_arg_count` は request manifest の semantic field を key に含め、generic request や impure source を別 proof として扱います。
//: - `proof_kind` と `proof_schema_version` は、この record が request occurrence gate 用 evidence であることと key shape を明示します。後続の no-escape proof や identity-observation proof と混同してはいけません。
pub struct SelfhostMemoCallBackendPrivateCacheProofKey:
    memoized_expr_id %SelfhostHirExprId
    source_function_def_id %SelfhostDefId
    function_ty %SelfhostTypeId
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    request_kind %SelfhostMemoCallBackendRequestKind
    source_effect %SelfhostEffectKind
    type_arg_count %i32
    proof_kind %SelfhostMemoCallBackendPrivateCacheProofKind
    proof_schema_version %i32

//: SelfhostMemoCallBackendPrivateCacheProofRecord: 1 つの memo_call proof status
//:
//: [契約/けいやく]:
//: - record は proof producer が対象にした request key と、その gate-evidence status だけを保持します。
//: - `RequestEvidenceProven` 以外の status は accepted summary を作りません。
struct SelfhostMemoCallBackendPrivateCacheProofRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    status %SelfhostMemoCallBackendPrivateCacheProofStatus

//: SelfhostMemoCallBackendPrivateCacheProofTable: memo_call PrivateCache proof record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。この table 自体に `Clone` / `Copy` を実装してはいけません。
//: - table は module-private です。外部 module は proof record owner buffer を直組みして accepted gate へ渡せません。
struct SelfhostMemoCallBackendPrivateCacheProofTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheProofRecord

//: SelfhostMemoCallBackendPrivateCacheProofGateSummary: proof gate の accepted summary
//:
//: [目的/もくてき]:
//: - この summary は backend bytes ではなく、同じ HIR root 由来の memoized request が proof table で裏付けられたことだけを表します。
pub struct SelfhostMemoCallBackendPrivateCacheProofGateSummary:
    request_count %i32
    proven_request_count %i32

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus: private effect mask proof の[接続/せつぞく][状態/じょうたい]
//:
//: [目的/もくてき]:
//: - request-evidence gate の `RequestEvidenceProven` と、PrivateCache / PrivateState の no-escape mask proof を別 authority として合成します。
//:
//: [契約/けいやく]:
//: - `PrivateEffectMaskProven` だけが backend readiness へ進めます。
//: - missing / unknown / refuted は accepted backend path へ進めません。request occurrence evidence が揃っていても、private effect mask が未証明なら fail-closed にします。
//: - この status は module-private です。checker-layer private effect proof table や backend artifact をこの module で偽造しません。
enum SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus:
    PrivateEffectMaskProven
    PrivateEffectMaskRefuted
    PrivateEffectMaskMissing
    PrivateEffectMaskUnknown

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence: backend readiness が[受/う]ける request-evidence 側の identity-bearing summary
//:
//: [契約/けいやく]:
//: - proof gate summary は count だけなので、この record で root と body fingerprint を束ねてから mask evidence と照合します。
//: - module-private のままにします。public caller が別 body の summary と mask を混ぜる入口は作りません。
struct SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence:
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    request_count %i32
    proven_request_count %i32

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence: backend readiness が[受/う]ける private-effect mask 側の identity-bearing evidence
//:
//: [契約/けいやく]:
//: - status だけでは request evidence と同じ body 由来か分からないため、root と body fingerprint を必ず保持します。
//: - `PrivateEffectMaskProven` でも identity が request evidence と一致しなければ readiness へ進めません。
struct SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence:
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    status %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary: memo_call backend へ[進/すす]む[直前/ちょくぜん]の non-executable readiness
//:
//: [契約/けいやく]:
//: - request evidence と private effect mask evidence がどちらも揃ったことだけを表します。
//: - backend bytes、cache allocation、effect mask 実体、sealed representation、artifact key は保持しません。
struct SelfhostMemoCallBackendPrivateCacheBackendReadinessSummary:
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    request_count %i32
    proven_request_count %i32
    mask_status %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskStatus

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus: request-evidence 側 readiness 入力の module-private status
//:
//: [契約/けいやく]:
//: - `RequestEvidenceReady` だけが request evidence payload を持ちます。proof gate `Err` や count 不足はこの段階で分類し、backend readiness summary には進めません。
enum SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidenceStatus:
    RequestEvidenceReady %SelfhostMemoCallBackendPrivateCacheBackendReadinessRequestEvidence
    RequestEvidenceRejected
    RequestEvidenceEmpty
    RequestEvidenceIncomplete
    RequestEvidenceInconsistent
    RequestEvidenceBodyModuleFingerprintPlaceholder

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus: mask 側 readiness 入力の module-private status
//:
//: [契約/けいやく]:
//: - `MaskEvidenceReady` は identity-bearing mask evidence を持ちます。placeholder origin は mask status へ進めず readiness error に写します。
enum SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidenceStatus:
    MaskEvidenceReady %SelfhostMemoCallBackendPrivateCacheBackendReadinessMaskEvidence
    MaskEvidenceBodyModuleFingerprintPlaceholder

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus: upstream private-effect proof の neutral status
//:
//: [目的/もくてき]:
//: - checker-layer proof producer や Resource proof table を backend module に import せず、upper orchestration が backend readiness に渡すべき mask proof の結果だけを表します。
//:
//: [契約/けいやく]:
//: - `UpstreamPrivateEffectProven` だけが mask accepted へ写ります。
//: - Refuted / Missing / Unknown は readiness gate で fail-closed にします。Missing / Unknown を producer error に潰すと backend readiness 側で不足を分類できなくなるため、この neutral status として保持します。
enum SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus:
    UpstreamPrivateEffectProven
    UpstreamPrivateEffectRefuted
    UpstreamPrivateEffectMissing
    UpstreamPrivateEffectUnknown

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence: upper orchestration が渡す private-effect mask proof evidence
//:
//: [契約/けいやく]:
//: - root / body fingerprint は mask proof が対象にした body identity です。request evidence 側 identity とは readiness gate で別途照合します。
//: - checker-layer proof table、Resource proof record、effect mask 実体、backend artifact は保持しません。
struct SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectEvidence:
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    status %SelfhostMemoCallBackendPrivateCacheBackendReadinessUpstreamPrivateEffectStatus

//: SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus: upper orchestration から backend readiness へ渡す public private-effect status
//:
//: [目的/もくてき]:
//: - checker-layer mask evidence の status を、backend module が checker 型へ依存せず受け取れる transport enum として表します。
//:
//: [契約/けいやく]:
//: - `Proven` だけが backend readiness の accepted mask status へ写ります。
//: - `Refuted` / `Missing` / `Unknown` は既存 readiness gate で fail-closed にします。
//: - この public handoff status は backend bytes、effect mask 実体、sealed representation、artifact key の authority ではありません。
pub enum SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus:
    Proven
    Refuted
    Missing
    Unknown

//: SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffEvidence: public handoff の same-body identity-bearing evidence
//:
//: [契約/けいやく]:
//: - `root_expr_id` と `body_module_fingerprint` は checker mask evidence が対象にした body identity です。request evidence 側 identity は readiness gate で別途照合します。
//: - checker proof table、slot coverage table、private upstream evidence、backend readiness summary、backend bytes、artifact key は保持しません。
pub struct SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffEvidence:
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    status %SelfhostMemoCallBackendPrivateCachePrivateEffectReadinessHandoffStatus

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffStatus: actual traversal coverage を checker-layer bridge へ渡す public status
//:
//: [目的/もくてき]:
//: - actual traversal が private-effect slot について観測した no-escape / escape / 明示不在 / graph 欠落 / traversal 未対応を、checker module が backend private source table に依存せず受け取れる transport enum として表します。
//:
//: [契約/けいやく]:
//: - `EffectAbsentAfterCompleteTraversal` は同じ body slot の complete traversal 後に effect 不在を明示した場合だけ使えます。source table 欠落や unknown を absence として推測してはいけません。
//: - この status は checker-layer slot coverage producer の入力 status へ写すためだけの public transport であり、backend bytes、effect mask 実体、sealed representation、artifact key の authority ではありません。
pub enum SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffStatus:
    EffectObservedNoEscape
    EffectObservedMayEscape
    EffectAbsentAfterCompleteTraversal
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffEvidence: public coverage handoff の same-body slot evidence
//:
//: [契約/けいやく]:
//: - `body_root` と `body_module_fingerprint` は actual traversal が走査した body identity です。
//: - `effect` は coverage slot の effect です。checker-layer bridge が `PrivateCache` / `PrivateState` の fixed 2 slot として再検査します。
//: - actual traversal source table、checker proof table、slot coverage table、private upstream evidence、backend readiness summary、backend bytes、artifact key は保持しません。
pub struct SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffEvidence:
    body_root %SelfhostHirExprId
    body_module_fingerprint %i32
    effect %SelfhostEffectKind
    status %SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffStatus

//: SelfhostMemoCallBackendPrivateCacheProofGateStage0Summary: proof gate smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted proof、missing proof、refuted proof を 1 つの doctest で確認できるようにします。
pub struct SelfhostMemoCallBackendPrivateCacheProofGateStage0Summary:
    accepted_request_count %i32
    accepted_proof_count %i32
    missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    refuted_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheProofGateErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceProofStatus: Resource IR private-cache observation の[状態/じょうたい]
//:
//: [目的/もくてき]:
//: - Resource IR 側の private-cache escape analysis が「外へ逃げない」「外へ逃げる」「入力不足」「未判定」を bool に潰さず producer へ渡すための typed status です。
//:
//: [契約/けいやく]:
//: - `PrivateCacheNoEscapeProven` は request occurrence evidence へ変換できますが、それだけで cache algorithm correctness、sealed backend representation、artifact replay を証明したことにはなりません。
//: - `PrivateCacheMayEscape` は request occurrence を反証する evidence へ変換し、既存 gate が `ProofRefuted` として backend accepted path を止めます。
//: - `PrivateCacheMissing` と `PrivateCacheUnknown` は proof table に保存せず producer error にします。未証明の private cache を pure / accepted に mask してはいけません。
enum SelfhostMemoCallBackendPrivateCacheResourceProofStatus:
    PrivateCacheNoEscapeProven
    PrivateCacheMayEscape
    PrivateCacheMissing
    PrivateCacheUnknown

//: SelfhostMemoCallBackendPrivateCacheResourceProofRecord: Resource IR observation 由来の private-cache proof record
//:
//: [契約/けいやく]:
//: - key は既存 request-evidence gate と同じ `SelfhostMemoCallBackendPrivateCacheProofKey` を使います。Resource proof producer が別の key shape を使うと、request occurrence、root origin、body module fingerprint、request kind、effect、type argument count の照合が弱くなるためです。
//: - status は Resource IR 側の observation です。この record から直接 backend bytes や executable cache plan を作ってはいけません。
struct SelfhostMemoCallBackendPrivateCacheResourceProofRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    status %SelfhostMemoCallBackendPrivateCacheResourceProofStatus

//: SelfhostMemoCallBackendPrivateCacheResourceProofTable: Resource IR observation record の owner table
//:
//: [契約/けいやく]:
//: - table は module-private です。外部 caller が forged Resource observation table を accepted gate へ直接渡せないようにします。
//: - `records` は owner buffer です。この table に `Clone` / `Copy` を実装してはいけません。
//: - table は session-local な producer 入力であり、永続 `.neplproof` artifact ではありません。
struct SelfhostMemoCallBackendPrivateCacheResourceProofTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheResourceProofRecord

//: SelfhostMemoCallBackendPrivateCacheProofGateErrorKind: proof gate の失敗分類
//:
//: [目的/もくてき]:
//: - request collection、HIR 再照合、proof table construction、proof lookup、refuted proof を表示文ではなく enum payload として返します。
pub enum SelfhostMemoCallBackendPrivateCacheProofGateErrorKind:
    RequestCollectionFailed %SelfhostMemoCallBackendRequestCollectorErrorKind
    RequestEntryMissing %i32
    RequestExpressionMissing %SelfhostHirExprId
    RequestRecheckRejected %SelfhostMemoCallBackendRequestRejection
    RequestIdentityMismatch %SelfhostHirExprId
    BodyModuleFingerprintPlaceholder
    ProofTableAllocFailed %StdErrorKind
    ProofRecordPushFailed %StdErrorKind
    ProofRecordReadFailed %i32
    ProofMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ProofRefuted %SelfhostMemoCallBackendPrivateCacheProofKey
    ProofDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    ProofOrphan %SelfhostMemoCallBackendPrivateCacheProofKey
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind: request evidence と private effect mask の[合成/ごうせい][拒否/きょひ]
//:
//: [目的/もくてき]:
//: - request-evidence gate の成功と private effect mask の成功を混同しないよう、backend readiness 直前の不足を typed error として分けます。
//:
//: [契約/けいやく]:
//: - `RequestEvidenceEmpty` は memo_call backend accepted path に進める request が無いことを表します。
//: - `RequestEvidenceIncomplete` は request count と proven count が一致しないことを表します。
//: - private effect mask 系 error は、request evidence が揃っていても mask proof が揃っていない場合に返します。
pub enum SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind:
    RequestEvidenceRejected
    RequestEvidenceEmpty
    RequestEvidenceIncomplete
    RequestEvidenceInconsistent
    BodyModuleFingerprintPlaceholder
    PrivateEffectMaskMissing
    PrivateEffectMaskUnknown
    PrivateEffectMaskRefuted
    PrivateEffectMaskIdentityMismatch

//: SelfhostMemoCallBackendPrivateCacheBackendReadinessStage0Summary: backend readiness gate smoke の代表結果
//:
//: [目的/もくてき]:
//: - request evidence と private effect mask evidence が両方揃った場合だけ readiness summary になり、各不足は fail-closed になることを確認します。
//:
//: [契約/けいやく]:
//: - summary は count と typed Result だけを公開します。private mask status、backend readiness summary、proof table、backend bytes、effect mask、artifact key は公開しません。
pub struct SelfhostMemoCallBackendPrivateCacheBackendReadinessStage0Summary:
    accepted_request_count %i32
    accepted_proof_count %i32
    request_evidence_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    empty_request_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    partial_request_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    inconsistent_request_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    mask_missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    mask_unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    mask_refuted_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    mask_identity_mismatch_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    upstream_mask_accepted_count %i32
    upstream_mask_refuted_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    upstream_mask_missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    upstream_mask_unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    upstream_mask_identity_mismatch_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    upstream_mask_placeholder_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectReadinessStage0Summary: actual traversal source 由来 private-effect readiness projection smoke の代表結果
//:
//: [目的/もくてき]:
//: - actual traversal source table から backend readiness 用の neutral upstream private-effect evidence へ写す前段が、Proven を推測せず fail-closed になることを確認します。
//:
//: [契約/けいやく]:
//: - summary は typed Result だけを公開します。upstream evidence、checker proof、slot coverage table、effect mask 実体、backend bytes、artifact key は公開しません。
pub struct SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectReadinessStage0Summary:
    closed_clone_missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    private_cache_effect_unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    private_state_effect_unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    escape_refuted_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    unavailable_unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    empty_source_missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind
    placeholder_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheBackendReadinessErrorKind

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageCompleteAuthority: complete traversal coverage の body / graph authority
//:
//: [契約/けいやく]:
//: - `request_root_expr_id` は source table record の proof key root と照合します。
//: - `body_root_expr_id` は public coverage handoff に載せる actual traversal body root です。
//: - `body_module_fingerprint` と `graph_id` は source table record と完全一致しなければなりません。
//: - この authority は module-private です。source table だけから complete absence を推測しないために、complete traversal producer 内で明示的に渡します。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageCompleteAuthority:
    request_root_expr_id %SelfhostHirExprId
    body_root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffPair: fixed 2 slot coverage handoff pair
//:
//: [契約/けいやく]:
//: - pair は backend module-private です。外部 caller は cache / state handoff を個別 public evidence として受け取るだけで、source table や pair owner を偽造できません。
//: - `cache_handoff` は `PrivateCache`、`state_handoff` は `PrivateState` として producer 内で作ります。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffPair:
    cache_handoff %SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffEvidence
    state_handoff %SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffEvidence

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind: source table 由来 coverage handoff producer の拒否理由
//:
//: [目的/もくてき]:
//: - source table availability、empty source、body identity mismatch、graph identity mismatch、record read failure を typed error として分けます。
//:
//: [契約/けいやく]:
//: - empty source は complete traversal absence ではありません。
//: - source table owner や traversal record は error payload に入れません。
pub enum SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind:
    SourceRejected
    SourceTableEmpty
    SourceRecordReadFailed %i32
    BodyModuleFingerprintPlaceholder
    SourceBodyIdentityMismatch
    SourceGraphIdentityMismatch

//: SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerStage0Summary: source table 由来 coverage handoff producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted complete absence、actual use、escape と absence の混在、missing、unsupported、empty、placeholder、authority mismatch を public Result code で確認します。
//:
//: [契約/けいやく]:
//: - summary は fixed status code と typed Result だけを公開します。source table owner、handoff pair、fresh witness、proof table、effect mask、backend artifact は保持しません。
pub struct SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerStage0Summary:
    complete_absence_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    reader_context_complete_absence_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    reader_context_private_cache_effect_unsupported_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    private_cache_effect_unsupported_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    private_state_effect_unsupported_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    may_escape_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    mixed_absence_escape_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    missing_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    unsupported_pair_code %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    empty_source_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    placeholder_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    fingerprint_mismatch_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    identity_mismatch_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind
    graph_mismatch_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageHandoffProducerErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind: Resource proof producer の失敗分類
//:
//: [目的/もくてき]:
//: - Resource observation table の構築、duplicate detection、Missing / Unknown rejection、request-evidence proof table 生成、既存 gate rejection を enum として分けます。
//:
//: [契約/けいやく]:
//: - `ResourceProofMissing` と `ResourceProofUnknown` は成功 summary に畳みません。Resource IR 側の証明が無い、または未判定であることをそのまま compile-blocking error として保持します。
//: - `RequestEvidenceGateRejected` は、Resource observation から request-evidence table を作ったあと既存 gate が拒否したことを表します。特に `PrivateCacheMayEscape` はここで `ProofRefuted` として観測されます。
pub enum SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind:
    ResourceProofTableAllocFailed %StdErrorKind
    ResourceProofRecordPushFailed %StdErrorKind
    ResourceProofRecordReadFailed %i32
    ResourceProofDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    BodyModuleFingerprintPlaceholder
    ResourceProofMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ResourceProofUnknown %SelfhostMemoCallBackendPrivateCacheProofKey
    RequestEvidenceGateRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceProofProducerStage0Summary: Resource proof producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - Resource `NoEscapeProven` から既存 request-evidence gate 成功へ進む case と、`MayEscape`、`Missing`、`Unknown`、duplicate を fail-closed に拒否する case を確認します。
pub struct SelfhostMemoCallBackendPrivateCacheResourceProofProducerStage0Summary:
    accepted_request_count %i32
    accepted_proof_count %i32
    may_escape_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind
    missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind
    unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind
    duplicate_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceGraphId: memo_call private-cache Resource graph の session-local id
//:
//: [契約/けいやく]:
//: - graph id は同じ request key の中で複数の traversal candidate を区別するための session-local id です。永続 artifact key ではありません。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphId:
    index %i32

//: SelfhostMemoCallBackendPrivateCacheResourcePlaceId: memo_call private-cache Resource graph 内の place id
//:
//: [契約/けいやく]:
//: - place id は graph-local id です。別 graph や別 root の place と混ぜてはいけません。
struct SelfhostMemoCallBackendPrivateCacheResourcePlaceId:
    index %i32

//: SelfhostMemoCallBackendPrivateCacheResourceGraphCompleteness: Resource graph の閉包状態
//:
//: [目的/もくてき]:
//: - graph が memo_call private-cache boundary について閉じている場合だけ、place / edge fold を no-escape observation に使います。
enum SelfhostMemoCallBackendPrivateCacheResourceGraphCompleteness:
    ClosedForPrivateCacheBoundary
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostMemoCallBackendPrivateCacheResourcePlaceKind: private-cache Resource graph place の分類
//:
//: [契約/けいやく]:
//: - private storage / entry / owned clone value は外部観測可能な cache identity を露出しません。
//: - return reference、public store、external handle は cache identity や cache storage を外へ出すため `MayEscape` に畳みます。
//: - unsupported place は `Unknown` に畳み、pure accepted path へ進めません。
enum SelfhostMemoCallBackendPrivateCacheResourcePlaceKind:
    PrivateCacheStorage
    PrivateCacheEntry
    ReturnedOwnedClone
    ReturnCacheReference
    PublicStore
    ExternalHandle
    UnsupportedPlace

//: SelfhostMemoCallBackendPrivateCacheResourceEdgeKind: private-cache Resource graph edge の分類
//:
//: [契約/けいやく]:
//: - owned / borrow-view / clone-out edge は、対応する place が private のままなら no-escape fold を悪化させません。
//: - cache reference return と public store edge は cache storage が外部へ到達するため `MayEscape` に畳みます。
//: - unsupported call boundary は `Unknown` に畳みます。
enum SelfhostMemoCallBackendPrivateCacheResourceEdgeKind:
    Owns
    BorrowView
    CloneOutOwnedValue
    ReturnCacheReference
    StoreToPublic
    CallBoundaryUnsupported

//: SelfhostMemoCallBackendPrivateCacheResourceGraphBodyRecord: memo_call request に対する Resource graph header
//:
//: [契約/けいやく]:
//: - `key` は既存 request-evidence gate と同じ typed key です。memoized occurrence、root、module fingerprint、request kind、effect、type argument count を落としません。
//: - `graph_id` は同じ key 内の graph-local id です。
//: - `completeness` が `ClosedForPrivateCacheBoundary` でない場合、place / edge を no-escape proof へ使いません。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphBodyRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    completeness %SelfhostMemoCallBackendPrivateCacheResourceGraphCompleteness

//: SelfhostMemoCallBackendPrivateCacheResourceGraphPlaceRecord: memo_call Resource graph の place event
//:
//: [契約/けいやく]:
//: - place は `key + graph_id + place_id` で識別します。source text や span は authority にしません。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphPlaceRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    place_id %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheResourcePlaceKind

//: SelfhostMemoCallBackendPrivateCacheResourceGraphEdgeRecord: memo_call Resource graph の edge event
//:
//: [契約/けいやく]:
//: - edge endpoint は同じ graph-local place id を指します。この stage では endpoint の存在を検査し、欠落があれば fail-closed にします。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphEdgeRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    to_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheResourceEdgeKind

//: SelfhostMemoCallBackendPrivateCacheResourceGraphInput: memo_call Resource graph input の owner table
//:
//: [契約/けいやく]:
//: - table は module-private です。外部 caller が forged graph input を accepted gate へ直接渡せる public API は作りません。
//: - body / place / edge record はこの owner table に閉じ、stage0 helper または将来の actual graph walker boundary が生成します。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphInput:
    bodies %Vec SelfhostMemoCallBackendPrivateCacheResourceGraphBodyRecord
    places %Vec SelfhostMemoCallBackendPrivateCacheResourceGraphPlaceRecord
    edges %Vec SelfhostMemoCallBackendPrivateCacheResourceGraphEdgeRecord

//: SelfhostMemoCallBackendPrivateCacheResourceGraphFoldSummary: graph fold 中の status と place 観測有無
//:
//: [契約/けいやく]:
//: - closed graph でも private-cache place が 1 つも観測されない場合は `Unknown` に倒します。空 graph から `NoEscapeProven` を合成しません。
struct SelfhostMemoCallBackendPrivateCacheResourceGraphFoldSummary:
    status %SelfhostMemoCallBackendPrivateCacheResourceProofStatus
    saw_place %bool

//: SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind: Resource graph producer の失敗分類
//:
//: [目的/もくてき]:
//: - graph input table の構築、graph structure validation、private-cache no-escape fold、既存 Resource proof table 生成の失敗を enum として分けます。
pub enum SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind:
    GraphBodyTableAllocFailed %StdErrorKind
    GraphPlaceTableAllocFailed %StdErrorKind
    GraphEdgeTableAllocFailed %StdErrorKind
    GraphBodyPushFailed %StdErrorKind
    GraphPlacePushFailed %StdErrorKind
    GraphEdgePushFailed %StdErrorKind
    GraphBodyReadFailed %i32
    GraphPlaceReadFailed %i32
    GraphEdgeReadFailed %i32
    GraphBodyDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    GraphPlaceDuplicate %i32
    GraphEdgeDuplicate %i32
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    PlaceIdInvalid %i32
    OperationOrdinalInvalid %i32
    GraphBodyMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    GraphEventForNonClosedGraph %i32
    EdgeEndpointMissing %i32
    OutputResourceProofRejected %SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceGraphProducerStage0Summary: Resource graph producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - closed private graph、escaping graph、missing graph、unsupported graph、duplicate body、endpoint missing を確認します。
pub struct SelfhostMemoCallBackendPrivateCacheResourceGraphProducerStage0Summary:
    accepted_request_count %i32
    accepted_proof_count %i32
    may_escape_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    unknown_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    duplicate_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    endpoint_missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedReason: walker が private-cache graph を closed にできなかった理由
//:
//: [契約/けいやく]:
//: - reason は diagnostic string ではなく typed enum です。後段はこの値を `TraversalUnsupported` として fail-closed に扱い、pure accepted path へは進めません。
enum SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedReason:
    UnknownResourceOperation
    UnknownPlaceRoot
    UnknownProjection
    UnknownCallBoundary
    PrivateCacheOperationUnsupported
    CacheObservationUnsupported
    FunctionIdentityObservationUnsupported
    RawIdentityObservationUnsupported
    PrivateStateBoundaryUnsupported

//: SelfhostMemoCallBackendPrivateCacheObservationKind: memoized function の pure 化を壊す可観測操作の分類
//:
//: [目的/もくてき]:
//: - actual Resource IR walker が将来検出する cache 観測と function identity 観測を、文字列や診断名ではなく typed enum として扱います。
//:
//: [契約/けいやく]:
//: - ここに並ぶ操作は、private cache region が外へ逃げなくても pure public API から観測できると memoization の参照透過性を壊します。
//: - この enum は module-private です。外部 caller が観測種別を渡して accepted path を作る public API は作りません。
//: - cache hit / miss、size、stats、clear、debug、cache region identity は cache state の観測または変更を公開するため `CacheObservationUnsupported` へ畳みます。
//: - function equality、hash、debug、closure allocation identity は memoized wrapper identity の観測なので `FunctionIdentityObservationUnsupported` へ畳みます。
//: - raw address / raw representation は raw identity の観測なので `RawIdentityObservationUnsupported` へ畳みます。
enum SelfhostMemoCallBackendPrivateCacheObservationKind:
    CacheHitObserved
    CacheMissObserved
    CacheSizeObserved
    CacheStatsObserved
    CacheClearObserved
    CacheDebugObserved
    CacheRegionIdentityObserved
    FunctionEqualityObserved
    FunctionHashObserved
    FunctionDebugObserved
    ClosureAllocationIdentityObserved
    RawIdentityObserved
    RawRepresentationObserved
    UnsupportedObservation

//: SelfhostMemoCallBackendPrivateCacheObservationBanStatus: 可観測操作禁止検査の record 状態
//:
//: [目的/もくてき]:
//: - actual walker が見つけた観測禁止操作を、成功 proof と混ぜずに scanner の unsupported event へ渡すための status です。
//:
//: [契約/けいやく]:
//: - `NoObservationDetected` は「この 1 record では観測を報告していない」ことだけを表します。body 全体に観測が無い証明ではないため、NoEscape proof や accepted backend plan に使ってはいけません。
//: - `ObservationDetected` は pure public API で観測できる操作を検出したことを表し、必ず unsupported walker event へ変換して fail-closed に扱います。
enum SelfhostMemoCallBackendPrivateCacheObservationBanStatus:
    NoObservationDetected
    ObservationDetected %SelfhostMemoCallBackendPrivateCacheObservationKind

//: SelfhostMemoCallBackendPrivateCacheObservationBanRecord: observation ban producer が読む 1 record
//:
//: [契約/けいやく]:
//: - key は既存 request-evidence gate と同じ proof key です。memoized occurrence、root、module fingerprint、request kind、effect、type argument count を落としません。
//: - operation ordinal は walker event stream 内での順序証拠です。scanner が cross-kind duplicate を検査できるよう、この record から unsupported event へそのまま渡します。
struct SelfhostMemoCallBackendPrivateCacheObservationBanRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    status %SelfhostMemoCallBackendPrivateCacheObservationBanStatus

//: SelfhostMemoCallBackendPrivateCacheObservationBanTable: observation ban record の owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。外部 caller が forged observation table を public API に渡して accepted path を作る経路は作りません。
//: - table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheObservationBanTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheObservationBanRecord

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerBodyRecord: future walker が返す private-cache graph header
//:
//: [契約/けいやく]:
//: - body record は proof key と graph id と upstream completeness だけを authority にします。source text、span、display name、public surface hash から body identity を推測しません。
struct SelfhostMemoCallBackendPrivateCacheResourceWalkerBodyRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    completeness %SelfhostMemoCallBackendPrivateCacheResourceGraphCompleteness

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerPlaceEventRecord: future walker が観測した private-cache place event
//:
//: [契約/けいやく]:
//: - operation ordinal は同じ body graph 内で place / edge / unsupported event を通じて一意でなければなりません。
struct SelfhostMemoCallBackendPrivateCacheResourceWalkerPlaceEventRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    place_id %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheResourcePlaceKind

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerEdgeEventRecord: future walker が観測した private-cache graph edge event
//:
//: [契約/けいやく]:
//: - endpoint は同じ body graph の place id を指します。scanner は負の endpoint を拒否し、GraphInput producer は endpoint missing をさらに検査します。
struct SelfhostMemoCallBackendPrivateCacheResourceWalkerEdgeEventRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    to_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheResourceEdgeKind

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedEventRecord: closed graph にできない walker event
//:
//: [契約/けいやく]:
//: - unsupported event が closed body に属する場合、その body は output GraphInput では `TraversalUnsupported` として渡します。partial place / edge graph を no-escape proof に使いません。
struct SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedEventRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    reason %SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedReason

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerInput: future walker event の owner table
//:
//: [契約/けいやく]:
//: - owner table は module-private です。actual walker が未接続の段階で、外部 caller が forged event stream を accepted path へ渡せる public API は作りません。
struct SelfhostMemoCallBackendPrivateCacheResourceWalkerInput:
    bodies %Vec SelfhostMemoCallBackendPrivateCacheResourceWalkerBodyRecord
    places %Vec SelfhostMemoCallBackendPrivateCacheResourceWalkerPlaceEventRecord
    edges %Vec SelfhostMemoCallBackendPrivateCacheResourceWalkerEdgeEventRecord
    unsupported %Vec SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedEventRecord

//: SelfhostMemoCallBackendPrivateCacheActualWalkerEventPayload: future actual walker が返す単一 event stream の 1 payload
//:
//: [目的/もくてき]:
//: - actual Resource IR walker は実装上、body / place / edge / unsupported / observation を 1 本の typed stream として返す方が、traversal order と owner cleanup を管理しやすくなります。
//: - この enum は、その単一 stream を既存の `ResourceWalkerInput` と `ObservationBanTable` へ分配するための module-private payload です。
//:
//: [契約/けいやく]:
//: - payload は actual traversal の結果を分類するためだけに使います。`PrivateCacheNoEscapeProven`、`PrivateCacheStorage`、`CloneOutOwnedValue`、accepted proof record はここでは作りません。
//: - observation payload は observation ban gate へ渡すための record であり、graph path に直接混ぜて accepted proof を作る用途には使いません。
//: - この enum は public API に出しません。actual walker が接続されるまでは、外部 caller が forged stream を渡せる入口を作らないためです。
enum SelfhostMemoCallBackendPrivateCacheActualWalkerEventPayload:
    Body %SelfhostMemoCallBackendPrivateCacheResourceWalkerBodyRecord
    Place %SelfhostMemoCallBackendPrivateCacheResourceWalkerPlaceEventRecord
    Edge %SelfhostMemoCallBackendPrivateCacheResourceWalkerEdgeEventRecord
    Unsupported %SelfhostMemoCallBackendPrivateCacheResourceWalkerUnsupportedEventRecord
    Observation %SelfhostMemoCallBackendPrivateCacheObservationBanRecord

//: SelfhostMemoCallBackendPrivateCacheActualWalkerEventTable: future actual walker event stream の owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。外部 module から stream を渡せる public API は、actual Resource walker 本体が authority を持つまで作りません。
//: - table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerEventTable:
    events %Vec SelfhostMemoCallBackendPrivateCacheActualWalkerEventPayload

//: SelfhostMemoCallBackendPrivateCacheActualWalkerEventSplitOutput: unified event stream を分配した owner pair
//:
//: [契約/けいやく]:
//: - `walker_input` は body / place / edge / unsupported event だけを持ち、既存 scanner で GraphInput へ正規化されます。
//: - `observations` は `ObservationDetected` だけを保持します。`NoObservationDetected` は proof ではないため、accepted path には進めず、単に分配後の観測禁止 table に追加しません。
//: - この struct は owner を 2 つ持つため、`Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerEventSplitOutput:
    walker_input %SelfhostMemoCallBackendPrivateCacheResourceWalkerInput
    observations %SelfhostMemoCallBackendPrivateCacheObservationBanTable

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderRequestContext: actual traversal body reader が[信頼/しんらい]する request authority
//:
//: [目的/もくてき]:
//: - HIR root から再収集した request entry を、real body reader が読む前に recheck 済みの authority context へ正規化します。
//:
//: [契約/けいやく]:
//: - この context は owner を持ちません。`entry`、root、body fingerprint、proof key、graph id はすべて値として保持します。
//: - context の成功は accepted proof を意味しません。actual Resource IR body input、fresh witness、effect masking、sealed backend representation は別 boundary が証明します。
//: - module-private のまま保ちます。public caller が context を作って producer path の authority を差し替えることはできません。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderRequestContext:
    entry %SelfhostMemoCallBackendRequestTableEntry
    root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyLoweringAvailabilityStatus: DefId から body HIR への lowering 可用性
//:
//: [目的/もくてき]:
//: - `MemoizedFunctionValue` identity が指す関数定義から、actual body reader が読む HIR body root を得られるかを typed status として保持します。
//:
//: [契約/けいやく]:
//: - `BodyLoweringAvailable` だけが source plan 生成へ進めます。missing / unavailable / unsupported は accepted wrapper source へ変換せず、availability error として fail-closed にします。
//: - この status は proof ではありません。PrivateCache / PrivateState の effect mask、Resource proof、sealed backend representation、artifact key は別境界が扱います。
enum SelfhostMemoCallBackendPrivateCacheActualTraversalBodyLoweringAvailabilityStatus:
    BodyLoweringAvailable
    BodyLoweringMissing
    BodyLoweringUnavailable
    BodyLoweringUnsupported

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyResolutionRecord: DefId-linked body reader 解決 record
//:
//: [目的/もくてき]:
//: - `MemoizedFunctionValue` request の `source_function_def_id` を、lowering 済み body HIR root と同じ body module fingerprint に結び付けます。
//:
//: [契約/けいやく]:
//: - `source_function_def_id`、`function_ty`、`request_kind`、`source_effect`、`type_arg_count` は request context と完全一致しなければなりません。
//: - `body_root_expr_id` は body reader が読む HIR root であり、request collection root とは別の authority です。root の存在は resolver lookup が `SelfhostHirModule` に対して再検査します。
//: - record は owner を持ちません。resolver table owner と Resource proof/backend owner を混同してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalBodyResolutionRecord:
    source_function_def_id %SelfhostDefId
    function_ty %SelfhostTypeId
    request_kind %SelfhostMemoCallBackendRequestKind
    source_effect %SelfhostEffectKind
    type_arg_count %i32
    body_root_expr_id %SelfhostHirExprId
    body_module_fingerprint %i32
    lowering_status %SelfhostMemoCallBackendPrivateCacheActualTraversalBodyLoweringAvailabilityStatus

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyResolutionTable: body reader resolver record の owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。public caller が forged body resolution table を accepted path へ渡せる入口は作りません。
//: - `records` は owner buffer です。この table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalBodyResolutionTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheActualTraversalBodyResolutionRecord

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderSeed: actual traversal body reader の stage0 input evidence
//:
//: [目的/もくてき]:
//: - future real reader が HIR lowering result / Resource IR body から返すべき最小 evidence を、stage0 で typed value として表します。
//:
//: [契約/けいやく]:
//: - seed は proof ではありません。`RequestEvidenceProven`、private-cache no-escape proof、PrivateCache / PrivateState の pure mask、sealed backend representation、`.neplobj` / `.neplproof` artifact 完了を意味しません。
//: - seed の key / graph id は、recheck 済み `ActualTraversalBodyReaderRequestContext` と照合されて初めて owner-bearing walker input に変換できます。seed 側の key / graph id だけで authority を完結させてはいけません。
//: - seed は module-private です。public caller が seed を直組みして accepted path を作る入口は作りません。
//: - `observation_status` が `ObservationDetected` の場合は accepted path に進めません。`NoObservationDetected` も body 全体の無観測証明ではなく、この seed が observation record を持たないという入力状態だけを表します。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderSeed:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    place_kind %SelfhostMemoCallBackendPrivateCacheResourcePlaceKind
    to_place_index %i32
    edge_kind %SelfhostMemoCallBackendPrivateCacheResourceEdgeKind
    observation_status %SelfhostMemoCallBackendPrivateCacheObservationBanStatus

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderOperationPolicyKind: actual traversal body reader が[発行/はっこう]できる operation policy
//:
//: [目的/もくてき]:
//: - production reader が fixed wrapper body を直接 walker input に焼き込むのではなく、cache lookup / insert / observation / private effect を typed source vocabulary へ落とす前段を固定します。
//:
//: [契約/けいやく]:
//: - policy は実行可能 cache 操作でも accepted proof でもありません。source record を作り、source-to-operation projection と classifier / normalizer へ渡すためだけの分類です。
//: - `WrapperPrivateCacheStorage` と `WrapperCloneOutOwnedValue` だけが現時点の production accepted wrapper body representative です。
//: - cache lookup / insert / private effect は typed vocabulary として保持しますが、この slice では unsupported traversal として fail-closed にします。effect mask、backend bytes、artifact key、proof table record は作りません。
//: - observation policy は observation source へ写し、graph path に混ぜません。
enum SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderOperationPolicyKind:
    WrapperPrivateCacheStorage
    WrapperCloneOutOwnedValue
    CacheLookupOperation
    CacheInsertOperation
    PrivateCacheEffectOperation
    PrivateStateEffectOperation
    CacheHitObservation
    CacheMissObservation
    CacheSizeObservation
    CacheStatsObservation
    CacheClearObservation
    CacheDebugObservation
    CacheRegionIdentityObservation
    FunctionIdentityObservation
    FunctionHashObservation
    FunctionDebugObservation
    ClosureAllocationIdentityObservation
    RawIdentityObservation
    RawRepresentationObservation

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderAcceptedSourceKind: body traversal が accepted として[数/かぞ]えてよい source tag
//:
//: [目的/もくてき]:
//: - default wrapper representative ではなく、actual traversal が明示的に返す accepted source だけを state に追加するための語彙です。
//:
//: [契約/けいやく]:
//: - この enum は accepted graph candidate に寄与する source だけを持ちます。private effect、observation、unsupported、unavailable source はここに追加しません。
//: - helper はこの enum を traversal source kind へ写して source table へ入れるだけです。fresh witness、proof table、GraphInput、backend bytes、effect mask、artifact key は作りません。
enum SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderAcceptedSourceKind:
    PrivateCacheStoragePlace
    CloneOutOwnedValueEdge

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBodyInputAvailabilityErrorKind: actual traversal body input が available でない理由
//:
//: [目的/もくてき]:
//: - HIR-root request から actual Resource IR body input へ進む境界で、producer 自体が未接続の場合、body が無い場合、real input が unavailable の場合、対応外の場合、malformed な場合、context-bound source が request authority と対応しない場合、stage0 seed が context と対応しない場合を bool や unavailable source へ潰さず enum として分けます。
//:
//: [契約/けいやく]:
//: - この enum は module-private です。外部 caller が availability を偽造して accepted source を作る public API は作りません。
//: - `ActualTraversalBodyInputProducerNotConnected` は stage0 の producer 未接続 fallback だけを表します。real body reader が返す `ActualTraversalBodyInputUnavailable` と混同してはいけません。
//: - `ActualTraversalBodyInputKeyMismatch` / `GraphMismatch` は available reader source が recheck 済み context とずれた場合の拒否です。seed 系 variant とは分け、production source と fixture seed の原因を混同しません。
//: - seed 系 variant は real reader 接続前の stage0 evidence boundary 専用です。seed mismatch、missing seed、unsupported seed、malformed seed を existing unavailable fallback へ潰すと、accepted proof の偽造原因を追えなくなります。
//: - error payload は owner を持ちません。available path の `ResourceWalkerInput` と `ObservationBanTable` owner は `ActualWalkerEventSplitOutput` の `Ok` payload だけで運びます。
enum SelfhostMemoCallBackendPrivateCacheActualTraversalBodyInputAvailabilityErrorKind:
    ActualTraversalBodyInputProducerNotConnected %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputUnavailable %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputMalformed %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ActualTraversalBodyInputEmpty %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputKeyMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputGraphMismatch %i32
    ActualTraversalBodySourceTableAllocFailed %StdErrorKind
    ActualTraversalBodySourcePushFailed %StdErrorKind
    ActualTraversalBodySourceReadFailed %i32
    ActualTraversalBodyChildRangeInvalid %SelfhostHirRangeBuildError
    ActualTraversalBodyChildReadFailed %i32
    ActualTraversalBodyFuelExhausted %i32
    ActualTraversalBodyOperationTableAllocFailed %StdErrorKind
    ActualTraversalBodyOperationPushFailed %StdErrorKind
    ActualTraversalBodyOperationReadFailed %i32
    ActualTraversalBodyEventBuildRejected %SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind
    ActualTraversalBodyNormalizerRejected %SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind
    ActualTraversalBodyResolutionTableAllocFailed %StdErrorKind
    ActualTraversalBodyResolutionPushFailed %StdErrorKind
    ActualTraversalBodyResolutionReadFailed %i32
    ActualTraversalBodyResolutionMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionUnavailable %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionKeyMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionFingerprintMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionRootMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodySeedMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodySeedKeyMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodySeedGraphMismatch %i32
    ActualTraversalBodySeedUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodySeedObservationUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodySeedMalformed %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ActualTraversalBodySeedObservationBuildRejected %SelfhostMemoCallBackendPrivateCacheProofKey

//: SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind: actual traversal source の[現状/げんじょう]分類
//:
//: [目的/もくてき]:
//: - operation producer bridge が直接 `UnknownResourceOperation` を作るのではなく、actual Resource IR traversal から何を受け取ったかを表す source record を一段挟みます。
//:
//: [契約/けいやく]:
//: - `ResourceIrTraversalUnavailable` は、actual Resource IR traversal 本体がまだ未接続であることを typed source として表します。
//: - private cache storage / clone-out / escaping reference / public store / unsupported / observation source は、actual traversal が返すべき分類語彙を先に固定するための variant です。
//: - known unsupported source は `ResourceIrTraversalUnavailable` へ混ぜません。実際に walker input で観測された unsupported event と、actual traversal 本体が未接続な状態は別の原因なので、source kind で分けます。
//: - この enum は operation kind ではありません。operation classifier が読む vocabulary へは、別の projection boundary を通して変換します。
//: - この source から作れるのは operation classifier 用 record までです。`PrivateCacheNoEscapeProven`、sealed backend bytes、GraphInput、proof table record は作りません。
enum SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind:
    PrivateCacheStoragePlace
    PrivateCacheEntryPlace
    ReturnedOwnedClonePlace
    ReturnCacheReferencePlace
    PublicStorePlace
    ExternalHandlePlace
    UnsupportedPlace
    OwnsEdge
    BorrowViewEdge
    CloneOutOwnedValueEdge
    ReturnCacheReferenceEdge
    PublicStoreEdge
    CallBoundaryUnsupportedEdge
    CacheLookupOperation
    CacheInsertOperation
    PrivateCacheEffectOperation
    PrivateStateEffectOperation
    CacheHitObservation
    CacheMissObservation
    CacheSizeObservation
    CacheStatsObservation
    CacheClearObservation
    CacheDebugObservation
    CacheRegionIdentityObservation
    FunctionIdentityObservation
    FunctionHashObservation
    FunctionDebugObservation
    ClosureAllocationIdentityObservation
    RawIdentityObservation
    RawRepresentationObservation
    UnsupportedTraversalSource
    UnsupportedObservationSource
    ResourceIrTraversalUnavailable

//: SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceRecord: operation producer が読む traversal source record
//:
//: [契約/けいやく]:
//: - key / graph id / operation ordinal は HIR-root request authority と proof key construction から得ます。source text、display name、diagnostic string は source authority ではありません。
//: - from_place / to_place は、将来 actual traversal から edge あるいは place source が来るときの graph-local id です。stage0 では 0 の placeholder place を使いますが、負値は source table push で拒否します。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    to_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceKind

//: SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable: actual traversal source の owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。public caller が forged traversal source を渡して accepted path を作る入口は作りません。
//: - table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceRecord

//: SelfhostMemoCallBackendPrivateCacheRegionProofInputKind: traversal source から private region proof へ渡す入力分類
//:
//: [目的/もくてき]:
//: - actual traversal source の語彙を、そのまま proof status と同一視せず、private cache region proof が読む入力語彙へ一段正規化します。
//:
//: [契約/けいやく]:
//: - この enum は module-private です。外部 caller が proof 入力を偽造して accepted path を作る public API は作りません。
//: - `TraversalUnavailable` は actual Resource IR traversal 本体が未接続であることだけを表します。known unsupported source、observation、escape sink と混同してはいけません。
//: - `PrivateCacheRegionRoot`、`PrivateCacheRegionEntry`、`ReturnedOwnedValue`、`InternalOwnsEdge`、`InternalBorrowViewEdge`、`OwnedCloneOutEdge` は、この stage0 では「bad source が無い場合にだけ region candidate smoke の候補になる」入力です。Pure mask や sealed backend representation の完了ではありません。
enum SelfhostMemoCallBackendPrivateCacheRegionProofInputKind:
    PrivateCacheRegionRoot
    PrivateCacheRegionEntry
    ReturnedOwnedValue
    InternalOwnsEdge
    InternalBorrowViewEdge
    OwnedCloneOutEdge
    EscapingReference
    PublicStoreEscape
    ExternalHandleEscape
    CacheStateObservation
    FunctionIdentityObservation
    RawIdentityObservation
    UnsupportedTraversal
    UnsupportedObservation
    TraversalUnavailable

//: SelfhostMemoCallBackendPrivateCacheRegionProofInputRecord: private region proof producer が読む正規化済み入力 record
//:
//: [契約/けいやく]:
//: - key / graph id / ordinal / place id は traversal source record からそのまま受け取ります。source text、display name、diagnostic text、backend bytes は authority にしません。
//: - input record は owner ではありません。owner lifecycle は `SelfhostMemoCallBackendPrivateCacheRegionProofTable` が保持します。
struct SelfhostMemoCallBackendPrivateCacheRegionProofInputRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    to_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheRegionProofInputKind

//: SelfhostMemoCallBackendPrivateCacheRegionProofStatus: private cache region proof の record 状態
//:
//: [契約/けいやく]:
//: - `PrivateCacheRegionRootCandidate` は private cache region の root source を見つけたことだけを表します。
//: - `PrivateCacheRegionSupportCandidate` は region root に付随する entry / owned value / internal edge source を見つけたことだけを表します。
//: - fold は root candidate と support candidate の両方を要求します。support だけの table は root なし candidate として fail-closed にします。
//: - この status は PrivateCache / PrivateState effect を Pure へ mask する権限ではありません。effect masking は後続の Resource effect fold issue が担当します。
//: - `PrivateCacheRegionMayEscape`、`PrivateCacheRegionObservationRejected`、`PrivateCacheRegionUnsupported`、`PrivateCacheRegionUnavailable` はいずれも fail-closed です。これらを proof table や backend bytes へ変換してはいけません。
enum SelfhostMemoCallBackendPrivateCacheRegionProofStatus:
    PrivateCacheRegionRootCandidate
    PrivateCacheRegionSupportCandidate
    PrivateCacheRegionMayEscape
    PrivateCacheRegionObservationRejected
    PrivateCacheRegionUnsupported
    PrivateCacheRegionUnavailable

//: SelfhostMemoCallBackendPrivateCacheRegionProofRecord: private region proof producer の 1 record
//:
//: [契約/けいやく]:
//: - record は traversal source 由来の key、graph id、ordinal と status だけを保持します。
//: - root candidate または support candidate の record が 1 件あることだけでは十分ではありません。table fold が全 record を読み、root と support の両方があり、bad status が無いことを確認してはじめて stage0 accepted smoke になります。
struct SelfhostMemoCallBackendPrivateCacheRegionProofRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    status %SelfhostMemoCallBackendPrivateCacheRegionProofStatus

//: SelfhostMemoCallBackendPrivateCacheRegionProofTable: private region proof record の owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。外部 caller が proof record を渡して accepted path を作る入口は作りません。
//: - table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheRegionProofTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheRegionProofRecord

//: SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus: region proof consistency checker の中間状態
//:
//: [目的/もくてき]:
//: - private cache region proof table が単一 key / 単一 graph に閉じ、root candidate と support candidate を 1 件ずつ持つことだけを表します。
//:
//: [契約/けいやく]:
//: - この status は `PrivateCacheNoEscapeProven` ではありません。actual Resource IR traversal、fresh region proof、PrivateCache / PrivateState effect masking、sealed backend representation、artifact proof はまだ後続 stage の責務です。
//: - status は module-private です。public API に出すのは Result payload を持つ smoke summary だけにし、外部 caller が candidate を accepted proof として渡せる入口を作りません。
enum SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus:
    PrivateCacheRegionNoEscapeCandidateAccepted

//: SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord: region candidate consistency checker の成功 record
//:
//: [契約/けいやく]:
//: - key と graph id は table 内の全 record が一致した authority を保持します。
//: - root / support ordinal は、同じ operation ordinal を二重に使っていないことを確認した結果です。
//: - record は proof artifact ではありません。この record から request-evidence proof table、Resource proof table、backend bytes、Pure mask を作ってはいけません。
struct SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    root_operation_ordinal %i32
    support_operation_ordinal %i32
    status %SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus

//: SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus: fresh region witness checker の中間状態
//:
//: [目的/もくてき]:
//: - candidate consistency checker とは別の根拠として、fresh private cache region を観測した候補だけを表します。
//:
//: [契約/けいやく]:
//: - この status は actual Resource IR traversal の完全な freshness proof ではありません。stage0 の checker-layer witness が candidate と同じ key / graph / ordinal を指すことだけを表します。
//: - `PrivateCacheRegionFreshWitnessCandidateAccepted` 以外は fail-closed です。missing / rejected / unavailable を accepted proof へ混ぜてはいけません。
enum SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus:
    PrivateCacheRegionFreshWitnessCandidateAccepted
    PrivateCacheRegionFreshWitnessMissing
    PrivateCacheRegionFreshWitnessRejected
    PrivateCacheRegionFreshWitnessUnavailable

//: SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord: fresh region witness candidate の 1 record
//:
//: [契約/けいやく]:
//: - witness authority は proof key、graph id、root operation ordinal、support operation ordinal、typed status に限定します。
//: - source text、display name、diagnostic label、backend bytes、artifact key、GraphInput、Resource proof record を witness authority として使ってはいけません。
//: - record は module-private です。外部 caller が witness を forged input として public accepted path へ渡せる入口を作りません。
struct SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    root_operation_ordinal %i32
    support_operation_ordinal %i32
    status %SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus

//: SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable: fresh region witness record の owner table
//:
//: [契約/けいやく]:
//: - owner table は module-private です。`Clone` / `Copy` を実装してはいけません。
//: - stage0 では 1 witness だけを受け入れます。duplicate witness は first-wins にせず fail-closed にします。
struct SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord

//: SelfhostMemoCallBackendPrivateCacheActualTraversalBundle: actual traversal producer が返す最小 owner bundle
//:
//: [目的/もくてき]:
//: - 将来の actual Resource IR traversal producer が、private cache region source と fresh-region witness を別々の authority にせず、同じ request key / graph に紐づく owner bundle として返す契約を固定します。
//:
//: [契約/けいやく]:
//: - この bundle は module-private です。public caller が source table や witness table を偽造して accepted request-evidence path へ渡す入口は作りません。
//: - `sources` は region candidate extraction のためだけに読みます。`witnesses` は candidate extraction 成功後に fresh witness request-evidence bridge へ owner として渡します。
//: - bundle 自体に `Clone` / `Copy` を実装してはいけません。owner table の lifetime は cleanup helper と request-evidence bridge が閉じます。
//: - この bundle は actual traversal 本体の完了を意味しません。stage0 fixture では accepted source と matching witness を作りますが、HIR-root production path は引き続き `ResourceIrTraversalUnavailable` source だけを emit します。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalBundle:
    sources %SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable
    witnesses %SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable

//: SelfhostMemoCallBackendPrivateCacheActualTraversalFreshWitnessAuthorityBundle: no-escape coverage 発行用の actual traversal-owned owner bundle
//:
//: [目的/もくてき]:
//: - `ActualTraversalBundle` は source-derived witness helper でも作れるため、`EffectObservedNoEscape` の発行入力には使いません。この wrapper は actual traversal が fresh witness authority として返した owner bundle だけを no-escape coverage helper に渡すための module-private 型です。
//:
//: [契約/けいやく]:
//: - wrapper は module-private owner です。public caller が source table や witness table を渡して no-escape coverage を偽造できる入口は作りません。
//: - source-derived witness helper や context-bound source-derived bundle からこの型へ変換しません。
//: - この wrapper 自体に `Clone` / `Copy` を実装してはいけません。source / witness owner は no-escape coverage helper が必ず閉じます。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalFreshWitnessAuthorityBundle:
    sources %SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable
    witnesses %SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable

//: SelfhostMemoCallBackendPrivateCacheBodyReaderNoEscapeCoverageAuthorityBundle: body reader no-escape coverage の authority と witness owner を[束/たば]ねる
//:
//: [目的/もくてき]:
//: - resolver が返した同じ body root から、coverage complete authority と fresh witness authority owner を作ったことを 1 つの module-private value にまとめます。
//:
//: [契約/けいやく]:
//: - coverage authority は owner を持たない値で、witness bundle は source / witness owner を保持します。
//: - この bundle は public API に出しません。caller supplied source / witness / coverage authority を混ぜて no-escape coverage を偽造できる入口を作らないためです。
//: - この bundle 自体に `Clone` / `Copy` を実装してはいけません。witness bundle の owner は no-escape coverage helper が消費します。
struct SelfhostMemoCallBackendPrivateCacheBodyReaderNoEscapeCoverageAuthorityBundle:
    coverage_authority %SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageCompleteAuthority
    witness_bundle %SelfhostMemoCallBackendPrivateCacheActualTraversalFreshWitnessAuthorityBundle

//: SelfhostMemoCallBackendPrivateCacheActualTraversalSourceOutputOrigin: traversal source output の由来分類
//:
//: [目的/もくてき]:
//: - resolver-bound HIR body reader 由来の source-derived output と、将来の full Resource IR traversal 由来 output を同じ owner boundary で区別します。
//:
//: [契約/けいやく]:
//: - `HirReaderSourceDerived` は production Resource traversal 完了を意味しません。
//: - `ResourceLoweringTraversalProduced` だけが production output gate を通過できます。
//: - この enum は owner を持ちません。source table、fresh witness table、backend artifact は別境界が所有します。
enum SelfhostMemoCallBackendPrivateCacheActualTraversalSourceOutputOrigin:
    HirReaderSourceDerived
    ResourceLoweringTraversalProduced

//: SelfhostMemoCallBackendPrivateCacheActualTraversalSourceOutput: traversal source owner と same-body authority を束ねた output envelope
//:
//: [目的/もくてき]:
//: - resolver-bound body root から得た source owner を、同じ body root の coverage authority と origin tag に束ねます。
//:
//: [契約/けいやく]:
//: - `sources` owner はこの output が保持します。no-escape authority bundle へ進むか、output free helper で閉じます。
//: - `context` と `coverage_authority` は同じ resolver lookup の body root から作られた値です。request root を body root として代用しません。
//: - この output は fresh witness owner、GraphInput、proof table、PrivateCache / PrivateState effect mask、backend bytes、sealed representation、artifact key を保持しません。
//: - `origin` が `HirReaderSourceDerived` の場合、production gate は必ず拒否します。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalSourceOutput:
    origin %SelfhostMemoCallBackendPrivateCacheActualTraversalSourceOutputOrigin
    context %SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderRequestContext
    coverage_authority %SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectCoverageCompleteAuthority
    body_root %SelfhostHirExprId
    sources %SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable

//: SelfhostMemoCallBackendPrivateCacheActualTraversalProductionFreshWitnessAuthorityInput: production fresh witness authority 前段の source owner
//:
//: [目的/もくてき]:
//: - `ResourceLoweringTraversalProduced` origin の source owner だけを、fresh witness authority へ渡す前段 input owner として `SourceOutput` から分離します。
//:
//: [契約/けいやく]:
//: - この input は module-private owner です。public caller が source table を渡して fresh witness / no-escape authority を偽造できる入口は作りません。
//: - `HirReaderSourceDerived` output からは作りません。source-derived HIR reader output は production traversal authority ではないためです。
//: - この input は fresh witness table、no-escape coverage pair、GraphInput、proof table、effect mask、backend bytes、sealed representation、artifact key を保持しません。
//: - この input 自体に `Clone` / `Copy` を実装してはいけません。source owner は後続 helper が消費するか、input free helper で閉じます。
struct SelfhostMemoCallBackendPrivateCacheActualTraversalProductionFreshWitnessAuthorityInput:
    context %SelfhostMemoCallBackendPrivateCacheActualTraversalBodyReaderRequestContext
    body_root %SelfhostHirExprId
    sources %SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable

//: SelfhostMemoCallBackendPrivateCacheActualWalkerOperationKind: actual walker が列挙する Resource operation 相当の最小分類
//:
//: [目的/もくてき]:
//: - actual Resource IR traversal を接続する前に、memo_call private cache boundary で必要な operation vocabulary を typed enum として固定します。
//: - この分類は unified event stream への入力であり、proof status や backend representation そのものではありません。
//:
//: [契約/けいやく]:
//: - private cache storage / entry / owned clone は graph event へ写します。
//: - cache reference return、external handle、public store は escaping graph event へ写し、後段で refuted proof として扱わせます。
//: - known unsupported source と traversal unavailable はどちらも unsupported event へ写しますが、operation kind としては分けます。未接続と既知 unsupported を同じ source origin として扱わないためです。
//: - cache state、function identity、raw identity の観測は graph event へ混ぜず、observation event として normalizer の observation precedence に委ねます。
enum SelfhostMemoCallBackendPrivateCacheActualWalkerOperationKind:
    PrivateCacheStoragePlace
    PrivateCacheEntryPlace
    ReturnedOwnedClonePlace
    ReturnCacheReferencePlace
    PublicStorePlace
    ExternalHandlePlace
    UnsupportedPlace
    OwnsEdge
    BorrowViewEdge
    CloneOutOwnedValueEdge
    ReturnCacheReferenceEdge
    PublicStoreEdge
    CallBoundaryUnsupportedEdge
    CacheLookupOperation
    CacheInsertOperation
    PrivateCacheEffectOperation
    PrivateStateEffectOperation
    UnsupportedTraversalSource
    UnsupportedObservationSource
    UnknownResourceOperation
    CacheHitObservation
    CacheMissObservation
    CacheSizeObservation
    CacheStatsObservation
    CacheClearObservation
    CacheDebugObservation
    CacheRegionIdentityObservation
    FunctionIdentityObservation
    FunctionHashObservation
    FunctionDebugObservation
    ClosureAllocationIdentityObservation
    RawIdentityObservation
    RawRepresentationObservation

//: SelfhostMemoCallBackendPrivateCacheActualWalkerOperationRecord: operation classifier が読む 1 record
//:
//: [契約/けいやく]:
//: - key / graph id / operation ordinal は actual traversal 由来の authority です。classifier はこれらを event record へそのまま運び、source text や display name から補いません。
//: - `from_place` と `to_place` は edge 用の endpoint です。place / observation / unsupported operation では `from_place` を主 place として使い、未使用の endpoint も負値を許さないことで malformed record を早期に拒否します。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerOperationRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    to_place %SelfhostMemoCallBackendPrivateCacheResourcePlaceId
    kind %SelfhostMemoCallBackendPrivateCacheActualWalkerOperationKind

//: SelfhostMemoCallBackendPrivateCacheActualWalkerOperationTable: operation classifier 用 owner table
//:
//: [契約/けいやく]:
//: - table は module-private owner です。public API で caller が operation table を渡して accepted graph を作る入口は作りません。
//: - table 自体に `Clone` / `Copy` を実装してはいけません。
struct SelfhostMemoCallBackendPrivateCacheActualWalkerOperationTable:
    records %Vec SelfhostMemoCallBackendPrivateCacheActualWalkerOperationRecord

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind: walker event scanner の拒否理由
//:
//: [目的/もくてき]:
//: - walker event owner の構築失敗、typed event validation、duplicate operation、GraphInput への projection、既存 graph gate rejection を enum として分けます。
pub enum SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind:
    WalkerBodyTableAllocFailed %StdErrorKind
    WalkerPlaceEventTableAllocFailed %StdErrorKind
    WalkerEdgeEventTableAllocFailed %StdErrorKind
    WalkerUnsupportedEventTableAllocFailed %StdErrorKind
    WalkerBodyPushFailed %StdErrorKind
    WalkerPlaceEventPushFailed %StdErrorKind
    WalkerEdgeEventPushFailed %StdErrorKind
    WalkerUnsupportedEventPushFailed %StdErrorKind
    WalkerBodyReadFailed %i32
    WalkerPlaceEventReadFailed %i32
    WalkerEdgeEventReadFailed %i32
    WalkerUnsupportedEventReadFailed %i32
    WalkerBodyDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    WalkerOperationDuplicate %i32
    WalkerBodyMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    WalkerEventForNonClosedGraph %i32
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    PlaceIdInvalid %i32
    OperationOrdinalInvalid %i32
    OutputGraphInputRejected %SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    OutputGraphGateRejected %SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind: 可観測操作禁止 producer の拒否分類
//:
//: [目的/もくてき]:
//: - HIR root 由来 request、private observation table、walker scanner、graph gate のどこで fail-closed になったかを enum payload として保持します。
//:
//: [契約/けいやく]:
//: - observation table owner や walker input owner は error payload に入れません。
//: - `OutputGraphGateRejected` は観測禁止操作または未証明 graph が既存 graph gate で拒否されたことを表します。これは accepted backend plan ではありません。
pub enum SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind:
    RequestCollectionFailed %SelfhostMemoCallBackendRequestCollectorErrorKind
    RequestEntryMissing %i32
    RequestRecheckRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    ProofKeyRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    ObservationRecordReadFailed %i32
    WalkerInputBuildRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ScannerOutputRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    OutputGraphGateRejected %SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerStage0Summary: walker scanner smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted / may-escape / missing / unsupported projection、duplicate ordinal、missing body event、placeholder body を確認します。
pub struct SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerStage0Summary:
    accepted_result %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    may_escape_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    missing_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    unsupported_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    duplicate_ordinal_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    missing_body_event_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    placeholder_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceObservationBanStage0Summary: 可観測操作禁止境界の smoke 結果
//:
//: [目的/もくてき]:
//: - cache observation、function identity observation、raw identity observation がいずれも Unknown proof rejection へ流れることを public doctest で確認できるようにします。
//:
//: [契約/けいやく]:
//: - summary は private observation kind や walker input owner を公開しません。公開されるのは既存 scanner error を持つ Result だけです。
pub struct SelfhostMemoCallBackendPrivateCacheResourceObservationBanStage0Summary:
    cache_observation_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind
    function_identity_observation_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind
    raw_identity_observation_rejected %Result i32 SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind

//: SelfhostMemoCallBackendPrivateCacheResourceWalkerProducerBridgeErrorKind: HIR root 由来 producer bridge の拒否分類
//:
//: [目的/もくてき]:
//: - actual Resource IR walker 本体へ接続する前段として、HIR root から request を再収集し、producer-owned な private walker event stream を作る境界の失敗を enum として表します。
//:
//: [契約/けいやく]:
//: - caller supplied request table、public walker event stream、direct GraphInput は authority にしません。
//: - actual traversal が閉じた graph を作れない場合は `WalkerInputBuildRejected` や `ScannerOutputRejected` ではなく、typed unsupported event を scanner / graph gate へ流し、最終的に `OutputGraphGateRejected` の Unknown proof として返します。
pub enum SelfhostMemoCallBackendPrivateCacheResourceWalkerProducerBridgeErrorKind:
    RequestCollectionFailed %SelfhostMemoCallBackendRequestCollectorErrorKind
    RequestEntryMissing %i32
    RequestRecheckRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    ProofKeyRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    WalkerInputBuildRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ScannerOutputRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    OutputGraphGateRejected %SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind: unified walker event normalizer の拒否分類
//:
//: [目的/もくてき]:
//: - future actual walker の単一 event stream を既存の scanner / graph gate / observation ban gate へ渡す途中で、どの境界が拒否したかを enum で保持します。
//:
//: [契約/けいやく]:
//: - error payload は owner table を含みません。途中失敗時には normalizer が unified event table、walker input、observation table の owner を閉じます。
//: - `GraphGateRejected` は graph-only stream が既存 graph gate で拒否されたことを表します。`ObservationGateRejected` は detected observation が既存 observation ban gate で拒否されたことを表します。
//: - この error は accepted backend plan ではありません。stage0 doctest が fail-closed 経路を比較するための public enum です。
pub enum SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind:
    ActualWalkerEventTableAllocFailed %StdErrorKind
    ActualWalkerEventPushFailed %StdErrorKind
    ActualWalkerEventReadFailed %i32
    WalkerInputBuildRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ObservationTableBuildRejected %StdErrorKind
    ScannerOutputRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    GraphGateRejected %SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind
    ObservationGateRejected %SelfhostMemoCallBackendPrivateCacheObservationBanProducerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheActualWalkerEventProducerBridgeErrorKind: HIR root から unified event stream を作る producer bridge の拒否分類
//:
//: [目的/もくてき]:
//: - actual Resource IR walker 本体が接続される前段として、HIR root 由来の request authority から unified event table を作り、normalizer へ渡す境界の失敗を enum として表します。
//:
//: [契約/けいやく]:
//: - request table と unified event table の owner は error payload に含めません。途中失敗時は producer bridge または normalizer が owner を閉じます。
//: - `ActualTraversalBodyInputMissing`、`ActualTraversalBodyInputUnavailable`、`ActualTraversalBodyInputUnsupported`、`ActualTraversalBodyInputMalformed` は、request から actual Resource IR body input を得る前段の typed availability rejection です。これらを accepted source として扱ってはいけません。
//: - `ActualTraversalBodyInputEmpty`、`ActualTraversalBodyInputKeyMismatch`、`ActualTraversalBodyInputGraphMismatch` は、available reader output から作った source table が recheck 済み request context と対応しない場合の拒否です。空 table は「全 record が一致した」という空真にしてはいけません。
//: - `ActualWalkerEventBuildRejected` は unified event table の構築失敗です。`NormalizerRejected` は構築済み stream が既存 normalizer / scanner / graph gate / observation ban gate で fail-closed になったことを表します。
//: - この enum は accepted proof ではありません。stage0 doctest が HIR-root producer bridge の fail-closed 経路を比較するための public error taxonomy です。
pub enum SelfhostMemoCallBackendPrivateCacheActualWalkerEventProducerBridgeErrorKind:
    RequestCollectionFailed %SelfhostMemoCallBackendRequestCollectorErrorKind
    RequestEntryMissing %i32
    RequestRecheckRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    ProofKeyRejected %SelfhostMemoCallBackendPrivateCacheProofGateErrorKind
    ActualWalkerTraversalInputRejected %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ActualTraversalBodyInputMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputUnavailable %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputMalformed %SelfhostMemoCallBackendPrivateCacheResourceWalkerInputScannerErrorKind
    ActualTraversalBodyInputEmpty %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputKeyMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyInputGraphMismatch %i32
    ActualTraversalBodyResolutionTableAllocFailed %StdErrorKind
    ActualTraversalBodyResolutionPushFailed %StdErrorKind
    ActualTraversalBodyResolutionReadFailed %i32
    ActualTraversalBodyResolutionMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionUnavailable %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionUnsupported %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionKeyMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionFingerprintMismatch %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionRootMissing %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualTraversalBodyResolutionDuplicate %SelfhostMemoCallBackendPrivateCacheProofKey
    ActualWalkerTraversalBodyReadFailed %i32
    ActualWalkerTraversalBodyChildRangeInvalid %SelfhostHirRangeBuildError
    ActualWalkerTraversalBodyChildReadFailed %i32
    ActualWalkerTraversalBodyFuelExhausted %i32
    ActualWalkerTraversalPlaceReadFailed %i32
    ActualWalkerTraversalEdgeReadFailed %i32
    ActualWalkerTraversalUnsupportedReadFailed %i32
    ActualWalkerTraversalObservationReadFailed %i32
    ActualWalkerTraversalSourceTableAllocFailed %StdErrorKind
    ActualWalkerTraversalSourcePushFailed %StdErrorKind
    ActualWalkerTraversalSourceReadFailed %i32
    ActualWalkerOperationTableAllocFailed %StdErrorKind
    ActualWalkerOperationPushFailed %StdErrorKind
    ActualWalkerOperationReadFailed %i32
    ActualWalkerEventBuildRejected %SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind
    NormalizerRejected %SelfhostMemoCallBackendPrivateCacheActualWalkerEventNormalizerErrorKind
    Stage0FixtureAllocFailed %StdErrorKind

//: SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind: private cache region proof producer の拒否分類
//:
//: [目的/もくてき]:
//: - traversal source から private cache region candidate smoke へ進む途中で、どの境界が fail-closed になったかを enum payload として保持します。
//:
