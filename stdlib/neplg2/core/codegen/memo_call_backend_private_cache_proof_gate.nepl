//: - `operation_ordinal` は観測順序であり、place node の identity には使いません。同じ graph 内で同じ place id が再定義された場合は duplicate として拒否します。
fn selfhost_memo_call_backend_private_cache_resource_graph_place_identity_eq %fn SelfhostMemoCallBackendPrivateCacheResourceGraphPlaceRecord fn SelfhostMemoCallBackendPrivateCacheResourceGraphPlaceRecord bool \a\b:
    and:
        selfhost_memo_call_backend_private_cache_proof_key_eq a.key b.key
        and:
            selfhost_memo_call_backend_private_cache_resource_graph_id_eq a.graph_id b.graph_id
            selfhost_memo_call_backend_private_cache_resource_place_id_eq a.place_id b.place_id

