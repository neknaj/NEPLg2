                                else:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofOrphan record.key
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_proof_gate_from_collected_table_result: 内部収集済み table を[検査/けんさ]し owner を[閉/と]じる
fn selfhost_memo_call_backend_private_cache_proof_gate_from_collected_table_result %impure fn &SelfhostHirModule impure fn SelfhostMemoCallBackendRequestTable impure fn SelfhostHirExprId impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\table\root_expr_id\body_module_fingerprint\proofs:
    let request_count %i32 selfhost_memo_call_backend_request_table_len &table
    match selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result module &table 0 request_count:
        Result::Ok _unit:
