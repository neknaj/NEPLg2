                Result::Ok proven_count:
                    let proof_count %i32 selfhost_memo_call_backend_private_cache_proof_table_len proofs
                    match selfhost_memo_call_backend_private_cache_proof_gate_validate_orphan_loop &table proofs root_expr_id body_module_fingerprint 0 proof_count request_count:
                        Result::Ok _orphan_checked:
                            selfhost_memo_call_backend_request_table_free table
                            Result::Ok SelfhostMemoCallBackendPrivateCacheProofGateSummary request_count proven_count
                        Result::Err e:
                            selfhost_memo_call_backend_request_table_free table
                            Result::Err e
                Result::Err e:
                    selfhost_memo_call_backend_request_table_free table
                    Result::Err e
        Result::Err e:
            selfhost_memo_call_backend_request_table_free table
            Result::Err e

//: selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result: HIR root の memo_call PrivateCache proof gate を[実行/じっこう]する
//:
//: [契約/けいやく]:
