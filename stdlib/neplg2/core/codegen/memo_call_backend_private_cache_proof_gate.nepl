fn selfhost_memo_call_backend_private_cache_region_fresh_witness_resource_table_from_candidate %impure fn SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord Result SelfhostMemoCallBackendPrivateCacheResourceProofTable SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \candidate:
    match selfhost_memo_call_backend_private_cache_resource_proof_table_new:
        Result::Ok table0:
            let resource_record %SelfhostMemoCallBackendPrivateCacheResourceProofRecord selfhost_memo_call_backend_private_cache_resource_proof_record_new candidate.key SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheNoEscapeProven
            match selfhost_memo_call_backend_private_cache_resource_proof_table_push table0 resource_record:
                Result::Ok resource_table:
                    Result::Ok resource_table
                Result::Err e:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessResourceProofRejected e
        Result::Err e:
            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessResourceProofRejected e

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_scan_record_result: 1 witness を candidate と[照合/しょうごう]する
//:
//: [契約/けいやく]:
//: - witness は candidate と同じ request key / graph / root ordinal / support ordinal を持つ必要があります。
//: - accepted 以外の witness status は fail-closed です。missing / rejected / unavailable を no-escape proof として扱いません。
fn selfhost_memo_call_backend_private_cache_region_fresh_witness_scan_record_result %impure fn SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord impure fn &SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable impure fn i32 impure fn i32 impure fn bool impure fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessRecord Result SelfhostMemoCallBackendPrivateCacheResourceProofTable SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \candidate\witnesses\idx\n\seen\record:
    match selfhost_memo_call_backend_private_cache_region_fresh_witness_record_validate_result record:
        Result::Ok _valid:
            if:
                selfhost_memo_call_backend_private_cache_proof_key_eq record.key candidate.key
                then:
                    if:
                        selfhost_memo_call_backend_private_cache_resource_graph_id_eq record.graph_id candidate.graph_id
                        then:
                            if:
                                eq record.root_operation_ordinal candidate.root_operation_ordinal
                                then:
                                    if:
                                        eq record.support_operation_ordinal candidate.support_operation_ordinal
                                        then:
                                            match record.status:
                                                SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus::PrivateCacheRegionFreshWitnessCandidateAccepted:
                                                    if:
                                                        seen
                                                        then:
                                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessDuplicate record.key
                                                        else:
                                                            selfhost_memo_call_backend_private_cache_region_fresh_witness_loop candidate witnesses add idx 1 n true
                                                SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus::PrivateCacheRegionFreshWitnessMissing:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessMissing record.key
                                                SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus::PrivateCacheRegionFreshWitnessRejected:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRejected record.key
                                                SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessStatus::PrivateCacheRegionFreshWitnessUnavailable:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessUnavailable record.key
                                        else:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessSupportOrdinalMismatch record.support_operation_ordinal
                                else:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRootOrdinalMismatch record.root_operation_ordinal
                        else:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessGraphMismatch record.graph_id.index
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessKeyMismatch record.key
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_loop: witness table を candidate と[照合/しょうごう]する
//:
//: [契約/けいやく]:
