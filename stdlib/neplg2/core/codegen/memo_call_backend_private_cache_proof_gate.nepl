                                        else:
                                            match candidate.status:
                                                SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus::PrivateCacheRegionNoEscapeCandidateAccepted:
                                                    Result::Ok unit

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_resource_table_from_candidate: accepted candidate から Resource proof table を 1 件[作/つく]る
//:
//: [契約/けいやく]:
