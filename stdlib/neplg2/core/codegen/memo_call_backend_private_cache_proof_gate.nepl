fn selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result %fn &SelfhostHirModule fn &SelfhostMemoCallBackendRequestTable fn i32 fn i32 Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\table\idx\n:
