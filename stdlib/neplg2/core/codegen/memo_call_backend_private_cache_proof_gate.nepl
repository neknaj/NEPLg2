                        else:
                            selfhost_memo_call_backend_private_cache_proof_lookup_loop proofs key add idx 1 found
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed idx

