//: selfhost_memo_call_backend_private_cache_actual_traversal_private_effect_no_escape_coverage_error_from_region_error: internal region error を no-escape coverage public error へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - no-escape coverage handoff は internal region proof taxonomy をそのまま public Result payload に載せません。boundary contract に必要な分類だけを保持します。
fn selfhost_memo_call_backend_private_cache_actual_traversal_private_effect_no_escape_coverage_error_from_region_error %fn SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind \error:
    match error:
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessMissing _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessMissing
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRejected _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessRejected
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessUnavailable _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessUnavailable
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnsupported _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessUnsupportedSource
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofObservationRejected _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessUnsupportedSource
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnavailable _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessUnsupportedSource
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMayEscape _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessEscapingSource
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessKeyMismatch _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessGraphMismatch _graph:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessRootOrdinalMismatch _ordinal:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionFreshWitnessSupportOrdinalMismatch _ordinal:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofKeyMismatch _key:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofGraphMismatch _graph:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessAuthorityMismatch
        _:
            SelfhostMemoCallBackendPrivateCacheActualTraversalPrivateEffectNoEscapeCoverageErrorKind::WitnessInternalRejected

