//: - proof table は borrow であり、この関数は閉じません。
fn selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\root\fuel\body_module_fingerprint\proofs:
