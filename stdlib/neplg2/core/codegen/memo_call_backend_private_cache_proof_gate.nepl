        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_region_proof_fold_loop: region proof table を fail-closed に[畳/たた]む
//:
//: [契約/けいやく]:
//: - root candidate record は private cache region root を見つけたことだけを表します。support candidate record は付随 source を見つけたことだけを表します。
//: - table 全体に bad status が無く、root candidate と support candidate の両方を確認するまで `Ok` を返しません。
//: - match は wildcard fallback を使いません。status が増えた場合、accepted / rejected のどちらに畳むかを明示する必要があります。
fn selfhost_memo_call_backend_private_cache_region_proof_fold_loop %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable fn i32 fn i32 fn bool fn bool Result i32 SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\idx\n\seen_region_root\seen_support:
    if:
        ge idx n
        then:
            if:
                and seen_region_root seen_support
                then:
                    Result::Ok 1
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMissingFreshRegion
        else:
            match selfhost_memo_call_backend_private_cache_region_proof_table_get table idx:
                Option::Some record:
                    match record.status:
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionRootCandidate:
                            selfhost_memo_call_backend_private_cache_region_proof_fold_loop table add idx 1 n true seen_support
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionSupportCandidate:
                            selfhost_memo_call_backend_private_cache_region_proof_fold_loop table add idx 1 n seen_region_root true
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionMayEscape:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMayEscape record.key
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionObservationRejected:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofObservationRejected record.key
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnsupported:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnsupported record.key
                        SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnavailable:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnavailable record.key
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_region_proof_fold_i32_result: region proof table の accepted count smoke を[返/かえ]す
fn selfhost_memo_call_backend_private_cache_region_proof_fold_i32_result %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable Result i32 SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table:
    selfhost_memo_call_backend_private_cache_region_proof_fold_loop table 0 selfhost_memo_call_backend_private_cache_region_proof_table_len table false false

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_new: no-escape candidate record を[作/つく]る
//:
//: [契約/けいやく]:
//: - この record は consistency checker の出力であり、Resource proof table record ではありません。
//: - root / support ordinal を保持するのは、同じ traversal operation を root と support の両方として二重消費していないことを後続 diagnostic が確認できるようにするためです。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_new %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceGraphId fn i32 fn i32 SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord \key\graph_id\root_operation_ordinal\support_operation_ordinal:
    SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord key graph_id root_operation_ordinal support_operation_ordinal SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateStatus::PrivateCacheRegionNoEscapeCandidateAccepted

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_validate_result: region proof record の authority field を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - table push でも同じ構造検査を行いますが、consistency checker は borrowed table を読む最後の gate なので、placeholder origin や負の graph / ordinal をここでも fail-closed にします。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_validate_result %fn SelfhostMemoCallBackendPrivateCacheRegionProofRecord Result unit SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \record:
    if:
        eq record.key.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofBodyModuleFingerprintPlaceholder record.key
        else:
            if:
                lt record.graph_id.index 0
                then:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofGraphIdInvalid record.graph_id.index
                else:
                    if:
                        lt record.operation_ordinal 0
                        then:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofOperationOrdinalInvalid record.operation_ordinal
                        else:
                            Result::Ok unit

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_scan_record_result: 1 record を candidate consistency state へ[畳/たた]む
//:
//: [契約/けいやく]:
//: - 全 record は同じ proof key と graph id に属していなければなりません。mismatch を first-wins にすると別 request や別 graph の support source で root を補えてしまうため、typed error として拒否します。
//: - root と support は stage0 では 1 件ずつだけ受け入れます。複数 support を扱う本物の graph-shaped proof は actual Resource IR traversal と graph proof が所有する後続 boundary で追加します。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_scan_record_result %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable fn i32 fn i32 fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceGraphId fn bool fn i32 fn bool fn i32 fn SelfhostMemoCallBackendPrivateCacheRegionProofRecord Result SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\idx\n\expected_key\expected_graph_id\seen_root\root_operation_ordinal\seen_support\support_operation_ordinal\record:
    match selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_validate_result record:
        Result::Ok _valid:
            if:
                selfhost_memo_call_backend_private_cache_proof_key_eq record.key expected_key
                then:
                    if:
                        selfhost_memo_call_backend_private_cache_resource_graph_id_eq record.graph_id expected_graph_id
                        then:
                            match record.status:
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionRootCandidate:
                                    if:
                                        seen_root
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRootDuplicate record.key
                                        else:
                                            if:
                                                and seen_support eq record.operation_ordinal support_operation_ordinal
                                                then:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofOperationOrdinalDuplicate record.operation_ordinal
                                                else:
                                                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop table add idx 1 n expected_key expected_graph_id true record.operation_ordinal seen_support support_operation_ordinal
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionSupportCandidate:
                                    if:
                                        seen_support
                                        then:
                                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofSupportDuplicate record.key
                                        else:
                                            if:
                                                and seen_root eq record.operation_ordinal root_operation_ordinal
                                                then:
                                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofOperationOrdinalDuplicate record.operation_ordinal
                                                else:
                                                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop table add idx 1 n expected_key expected_graph_id seen_root root_operation_ordinal true record.operation_ordinal
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionMayEscape:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMayEscape record.key
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionObservationRejected:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofObservationRejected record.key
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnsupported:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnsupported record.key
                                SelfhostMemoCallBackendPrivateCacheRegionProofStatus::PrivateCacheRegionUnavailable:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofUnavailable record.key
                        else:
                            Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofGraphMismatch record.graph_id.index
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofKeyMismatch record.key
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop: region proof table を no-escape candidate 直前で[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - wildcard fallback は使いません。region proof status が増えた場合、それを candidate、escape、observation、unsupported、unavailable のどれとして扱うかを明示します。
//: - loop が成功しても返すのは `PrivateCacheRegionNoEscapeCandidateAccepted` だけです。既存 `PrivateCacheNoEscapeProven` や `RequestEvidenceProven` へ変換しません。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_loop %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable fn i32 fn i32 fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceGraphId fn bool fn i32 fn bool fn i32 Result SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table\idx\n\expected_key\expected_graph_id\seen_root\root_operation_ordinal\seen_support\support_operation_ordinal:
    if:
        ge idx n
        then:
            if:
                and seen_root seen_support
                then:
                    Result::Ok selfhost_memo_call_backend_private_cache_region_no_escape_candidate_record_new expected_key expected_graph_id root_operation_ordinal support_operation_ordinal
                else:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofMissingFreshRegion
        else:
            match selfhost_memo_call_backend_private_cache_region_proof_table_get table idx:
                Option::Some record:
                    selfhost_memo_call_backend_private_cache_region_no_escape_candidate_scan_record_result table idx n expected_key expected_graph_id seen_root root_operation_ordinal seen_support support_operation_ordinal record
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind::RegionProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_region_no_escape_candidate_from_table_result: region proof table を candidate record へ[進/すす]める
//:
//: [契約/けいやく]:
//: - empty table は missing fresh region と同一視せず、`RegionProofEmpty` として分けます。producer が何も観測していない場合と、root/support の片方だけを観測した場合では原因が違うためです。
//: - 最初の record の key / graph id を期待値として使い、残りの record が同じ request occurrence と同じ graph に属することを検査します。
fn selfhost_memo_call_backend_private_cache_region_no_escape_candidate_from_table_result %fn &SelfhostMemoCallBackendPrivateCacheRegionProofTable Result SelfhostMemoCallBackendPrivateCacheRegionNoEscapeCandidateRecord SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \table:
    let n %i32 selfhost_memo_call_backend_private_cache_region_proof_table_len table
    if:
