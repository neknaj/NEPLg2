fn selfhost_memo_call_backend_private_cache_region_proof_stage0_run_i32_with_sources_result %impure fn SelfhostMemoCallBackendPrivateCacheActualWalkerTraversalSourceTable Result i32 SelfhostMemoCallBackendPrivateCacheRegionProofProducerErrorKind \sources:
