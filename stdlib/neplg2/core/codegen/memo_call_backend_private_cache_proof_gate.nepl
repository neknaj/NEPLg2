        Result::Err e:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestCollectionFailed e

//: selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result: Resource status を request-evidence status へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - Resource IR の private-cache no-escape observation を、既存 request-evidence gate が扱う status へ変換します。
//:
//: [契約/けいやく]:
//: - `PrivateCacheNoEscapeProven` だけが `RequestEvidenceProven` になります。
//: - `PrivateCacheMayEscape` は `RequestEvidenceRefuted` になります。この status は gate 側で accepted summary にならず、`ProofRefuted` として拒否されます。
//: - `PrivateCacheMissing` と `PrivateCacheUnknown` は proof record を作らず producer error にします。未証明を `Ok` の deferred plan にしません。
fn selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \key\status:
    match status:
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheNoEscapeProven:
            Result::Ok SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheMayEscape:
            Result::Ok SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheMissing:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofMissing key
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheUnknown:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofUnknown key

//: selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result: Resource observation record を request-evidence record へ[変換/へんかん]する
fn selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result %fn SelfhostMemoCallBackendPrivateCacheResourceProofRecord Result SelfhostMemoCallBackendPrivateCacheProofRecord SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \record:
    match selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result record.key record.status:
        Result::Ok request_status:
            Result::Ok selfhost_memo_call_backend_private_cache_proof_record_new record.key request_status
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output: producer 失敗時に output proof table を[閉/と]じる
fn selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output %impure fn SelfhostMemoCallBackendPrivateCacheProofTable impure fn SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \output\error:
    selfhost_memo_call_backend_private_cache_proof_table_free output
    Result::Err error

//: selfhost_memo_call_backend_private_cache_resource_proof_produce_loop: Resource observation table を request-evidence proof table へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - direct table contents を左から読み、Missing / Unknown を producer error として止めます。
//: - output proof table push は既存 private writer を使うため、body module fingerprint placeholder や lower push failure は既存 gate error を `RequestEvidenceGateRejected` に包みます。
fn selfhost_memo_call_backend_private_cache_resource_proof_produce_loop %impure fn SelfhostMemoCallBackendPrivateCacheProofTable impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable impure fn i32 Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \output\source\idx:
    if:
        ge idx selfhost_memo_call_backend_private_cache_resource_proof_table_len source
        then:
            Result::Ok output
        else:
            let records %&Vec SelfhostMemoCallBackendPrivateCacheResourceProofRecord field::get_ref source "records"
            match v::get records idx:
                Option::Some resource_record:
                    match selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result resource_record:
                        Result::Ok request_record:
                            match selfhost_memo_call_backend_private_cache_proof_table_push output request_record:
                                Result::Ok next_output:
                                    selfhost_memo_call_backend_private_cache_resource_proof_produce_loop next_output source add idx 1
                                Result::Err gate_error:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error
                        Result::Err e:
                            selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output output e
                Option::None:
                    selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output output SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result: Resource table から request-evidence proof table を[作/つく]る
//:
//: [目的/もくてき]:
//: - producer-owned Resource observation を既存 gate が読める module-private proof table へ変換します。
//:
//: [契約/けいやく]:
//: - 成功時だけ caller が output proof table owner を受け取ります。失敗時はこの関数が output owner を閉じます。
fn selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result %impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \source:
    match selfhost_memo_call_backend_private_cache_proof_table_new:
        Result::Ok output0:
            selfhost_memo_call_backend_private_cache_resource_proof_produce_loop output0 source 0
        Result::Err gate_error:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error

//: selfhost_memo_call_backend_private_cache_resource_proof_gate_from_hir_root_result: Resource observation 由来の proof で既存 gate を[実行/じっこう]する
//:
//: [目的/もくてき]:
//: - Resource observation table を直接 accepted authority にせず、module-private request-evidence proof table へ変換してから既存 gate へ渡します。
//:
//: [契約/けいやく]:
//: - この入口は module-private です。Resource IR graph walker / no-escape producer が接続されるまで、外部 caller に accepted path を公開しません。
//: - request table は既存 gate の内部で HIR root から再構築します。Resource table は proof table へ変換されるだけで、caller supplied request table にはなりません。
//: - 既存 gate の成功は non-executable summary のままであり、backend bytes、cache operation、sealed representation は作りません。
fn selfhost_memo_call_backend_private_cache_resource_proof_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \module\root\fuel\body_module_fingerprint\resource_proofs:
    match selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result resource_proofs:
        Result::Ok request_proofs:
            let result %Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result module root fuel body_module_fingerprint &request_proofs
            selfhost_memo_call_backend_private_cache_proof_table_free request_proofs
            match result:
                Result::Ok summary:
                    Result::Ok summary
                Result::Err gate_error:
                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_proof_gate_error_code: gate error kind の比較用 code を[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_gate_error_code %fn SelfhostMemoCallBackendPrivateCacheProofGateErrorKind i32 \error:
    match error:
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestCollectionFailed _e:
            1
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestEntryMissing _index:
            2
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestExpressionMissing _expr_id:
            3
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestRecheckRejected _rejection:
            4
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestIdentityMismatch _expr_id:
            5
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::BodyModuleFingerprintPlaceholder:
            6
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofTableAllocFailed _e:
            7
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordPushFailed _e:
            8
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed _index:
            9
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofMissing _key:
            10
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRefuted _key:
            11
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofDuplicate _key:
            12
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofOrphan _key:
            13
        SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::Stage0FixtureAllocFailed _e:
            14

//: selfhost_memo_call_backend_private_cache_proof_gate_error_kind_eq: gate error が同じ分類か[返/かえ]す
pub fn selfhost_memo_call_backend_private_cache_proof_gate_error_kind_eq %fn SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheProofGateErrorKind bool \a\b:
    eq selfhost_memo_call_backend_private_cache_proof_gate_error_code a selfhost_memo_call_backend_private_cache_proof_gate_error_code b

//: selfhost_memo_call_backend_private_cache_proof_gate_error_result_eq: error result が期待分類と key を持つか[返/かえ]す
pub fn selfhost_memo_call_backend_private_cache_proof_gate_error_result_eq %fn Result i32 SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheProofGateErrorKind fn SelfhostMemoCallBackendPrivateCacheProofKey bool \result\expected\expected_key:
    match result:
        Result::Ok _value:
            false
        Result::Err actual:
            let kind_ok %bool selfhost_memo_call_backend_private_cache_proof_gate_error_kind_eq actual expected
            let key_ok %bool match actual:
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofMissing actual_key:
                    selfhost_memo_call_backend_private_cache_proof_key_eq actual_key expected_key
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRefuted actual_key:
                    selfhost_memo_call_backend_private_cache_proof_key_eq actual_key expected_key
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofDuplicate actual_key:
                    selfhost_memo_call_backend_private_cache_proof_key_eq actual_key expected_key
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofOrphan actual_key:
                    selfhost_memo_call_backend_private_cache_proof_key_eq actual_key expected_key
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestCollectionFailed _e:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestEntryMissing _index:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestExpressionMissing _expr_id:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestRecheckRejected _rejection:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestIdentityMismatch _expr_id:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::BodyModuleFingerprintPlaceholder:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofTableAllocFailed _e:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordPushFailed _e:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed _index:
                    true
                SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::Stage0FixtureAllocFailed _e:
                    true
            and kind_ok key_ok

