                Result::Ok output0:
                    selfhost_memo_call_backend_private_cache_resource_graph_input_to_resource_proof_loop output0 graph 0
                Result::Err e:
                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind::OutputResourceProofRejected e
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_resource_graph_gate_from_hir_root_result: Resource graph input 由来の proof で既存 gate を[実行/じっこう]する
//:
//: [契約/けいやく]:
//: - graph input は borrowed owner table です。この関数は graph input を閉じません。
//: - graph input はまず private Resource proof table に畳まれ、その後で既存 request-evidence gate に通されます。graph record を直接 request accepted proof として扱いません。
fn selfhost_memo_call_backend_private_cache_resource_graph_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheResourceGraphInput Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind \module\root\fuel\body_module_fingerprint\graph:
    match selfhost_memo_call_backend_private_cache_resource_graph_input_to_resource_proof_table_result graph:
        Result::Ok resource_proofs:
            let result %Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind selfhost_memo_call_backend_private_cache_resource_proof_gate_from_hir_root_result module root fuel body_module_fingerprint &resource_proofs
            selfhost_memo_call_backend_private_cache_resource_proof_table_free resource_proofs
            match result:
                Result::Ok summary:
                    Result::Ok summary
                Result::Err e:
                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind::OutputResourceProofRejected e
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_proof_status_eq: proof status が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_status_eq %fn SelfhostMemoCallBackendPrivateCacheProofStatus fn SelfhostMemoCallBackendPrivateCacheProofStatus bool \a\b:
    match a:
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
                    true
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
                    false
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
                    false
                SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
                    true

//: selfhost_memo_call_backend_private_cache_proof_kind_eq: proof kind が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_kind_eq %fn SelfhostMemoCallBackendPrivateCacheProofKind fn SelfhostMemoCallBackendPrivateCacheProofKind bool \a\b:
    match a:
        SelfhostMemoCallBackendPrivateCacheProofKind::RequestOccurrenceGateEvidence:
            match b:
                SelfhostMemoCallBackendPrivateCacheProofKind::RequestOccurrenceGateEvidence:
                    true

//: selfhost_memo_call_backend_private_cache_request_kind_eq: request kind が同じ variant か[返/かえ]す
fn selfhost_memo_call_backend_private_cache_request_kind_eq %fn SelfhostMemoCallBackendRequestKind fn SelfhostMemoCallBackendRequestKind bool \a\b:
    match a:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            match b:
                SelfhostMemoCallBackendRequestKind::MemoCall:
                    true

//: selfhost_memo_call_backend_private_cache_proof_key_eq: proof key が同じ request boundary を指すか[返/かえ]す
pub fn selfhost_memo_call_backend_private_cache_proof_key_eq %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheProofKey bool \a\b:
    and:
        eq selfhost_hir_expr_id_index a.memoized_expr_id selfhost_hir_expr_id_index b.memoized_expr_id
        and:
            selfhost_def_id_eq a.source_function_def_id b.source_function_def_id
            and:
                selfhost_type_id_eq a.function_ty b.function_ty
                and:
                    eq selfhost_hir_expr_id_index a.root_expr_id selfhost_hir_expr_id_index b.root_expr_id
                    and:
                        eq a.body_module_fingerprint b.body_module_fingerprint
                        and:
                            selfhost_memo_call_backend_private_cache_request_kind_eq a.request_kind b.request_kind
                            and:
                                selfhost_effect_kind_eq a.source_effect b.source_effect
                                and:
                                    eq a.type_arg_count b.type_arg_count
                                    and:
                                        selfhost_memo_call_backend_private_cache_proof_kind_eq a.proof_kind b.proof_kind
                                        eq a.proof_schema_version b.proof_schema_version

//: selfhost_memo_call_backend_private_cache_proof_key_from_entry_result: request entry から proof key を[作/つく]る
fn selfhost_memo_call_backend_private_cache_proof_key_from_entry_result %fn SelfhostMemoCallBackendRequestTableEntry fn SelfhostHirExprId fn i32 Result SelfhostMemoCallBackendPrivateCacheProofKey SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \entry\root_expr_id\body_module_fingerprint:
    if:
        eq body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::BodyModuleFingerprintPlaceholder
        else:
            Result::Ok selfhost_memo_call_backend_private_cache_proof_key_new entry.memoized_expr_id entry.request.source_function_def_id entry.request.function_ty root_expr_id body_module_fingerprint entry.request.request_kind entry.request.source_effect entry.request.type_arg_count

//: selfhost_memo_call_backend_private_cache_proof_lookup_finish: proof lookup の最終状態を[畳/たた]む
fn selfhost_memo_call_backend_private_cache_proof_lookup_finish %fn SelfhostMemoCallBackendPrivateCacheProofKey fn Option SelfhostMemoCallBackendPrivateCacheProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \key\found:
    match found:
        Option::Some status:
            Result::Ok status
        Option::None:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofMissing key

//: selfhost_memo_call_backend_private_cache_proof_lookup_loop: proof table から matching status を[探/さが]す
//:
//: [契約/けいやく]:
//: - matching proof が 2 件以上ある場合は `ProofDuplicate` として拒否します。record order による first-wins は使いません。
fn selfhost_memo_call_backend_private_cache_proof_lookup_loop %fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostMemoCallBackendPrivateCacheProofKey fn i32 fn Option SelfhostMemoCallBackendPrivateCacheProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \proofs\key\idx\found:
    if:
        ge idx selfhost_memo_call_backend_private_cache_proof_table_len proofs
        then:
            selfhost_memo_call_backend_private_cache_proof_lookup_finish key found
        else:
            let records %&Vec SelfhostMemoCallBackendPrivateCacheProofRecord field::get_ref proofs "records"
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_memo_call_backend_private_cache_proof_key_eq record.key key
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofDuplicate key
                                Option::None:
                                    selfhost_memo_call_backend_private_cache_proof_lookup_loop proofs key add idx 1 some record.status
                        else:
                            selfhost_memo_call_backend_private_cache_proof_lookup_loop proofs key add idx 1 found
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_proof_lookup_result: key に対応する proof status を[返/かえ]す
fn selfhost_memo_call_backend_private_cache_proof_lookup_result %fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostMemoCallBackendPrivateCacheProofKey Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \proofs\key:
    selfhost_memo_call_backend_private_cache_proof_lookup_loop proofs key 0 none

//: selfhost_memo_call_backend_private_cache_proof_gate_request_record_matches: table entry と HIR 再構築 request が一致するか[返/かえ]す
//:
//: [契約/けいやく]:
//: - diagnostic metadata は比較しません。`diagnostic_symbol` と `diagnostic_span` は表示・source map 用であり、identity authority ではないためです。
fn selfhost_memo_call_backend_private_cache_proof_gate_request_record_matches %fn &SelfhostMemoCallBackendRequestTableEntry fn SelfhostMemoCallBackendRequest bool \entry\rebuilt:
    let stored %SelfhostMemoCallBackendRequest *field::get_ref entry "request"
    let stored_kind_ok %bool match stored.request_kind:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            true
    let rebuilt_kind_ok %bool match rebuilt.request_kind:
        SelfhostMemoCallBackendRequestKind::MemoCall:
            true
    let def_id_ok %bool selfhost_def_id_eq stored.source_function_def_id rebuilt.source_function_def_id
    let type_ok %bool selfhost_type_id_eq stored.function_ty rebuilt.function_ty
    let stored_effect_ok %bool selfhost_effect_kind_eq stored.source_effect SelfhostEffectKind::Pure
    let rebuilt_effect_ok %bool selfhost_effect_kind_eq rebuilt.source_effect SelfhostEffectKind::Pure
    let type_args_ok %bool and eq stored.type_arg_count 0 eq rebuilt.type_arg_count 0
    and stored_kind_ok and rebuilt_kind_ok and and def_id_ok type_ok and and stored_effect_ok rebuilt_effect_ok type_args_ok

//: selfhost_memo_call_backend_private_cache_proof_gate_recheck_entry_result: 1 request entry を HIR に対して[再/さい][検査/けんさ]する
fn selfhost_memo_call_backend_private_cache_proof_gate_recheck_entry_result %fn &SelfhostHirModule fn SelfhostMemoCallBackendRequestTableEntry Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\entry:
    match selfhost_hir_module_get_expr module entry.memoized_expr_id:
        Option::Some expr:
            match selfhost_memo_call_backend_request_from_hir_expr_result &expr:
                Result::Ok rebuilt:
                    if:
                        selfhost_memo_call_backend_private_cache_proof_gate_request_record_matches &entry rebuilt
                        then:
                            Result::Ok unit
                        else:
                            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestIdentityMismatch entry.memoized_expr_id
                Result::Err request_error:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestRecheckRejected SelfhostMemoCallBackendRequestRejection entry.memoized_expr_id request_error.kind
        Option::None:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestExpressionMissing entry.memoized_expr_id

//: selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result: request table を左から[再/さい][検査/けんさ]する
fn selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result %fn &SelfhostHirModule fn &SelfhostMemoCallBackendRequestTable fn i32 fn i32 Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\table\idx\n:
    if:
        ge idx n
        then:
            Result::Ok unit
        else:
            match selfhost_memo_call_backend_request_table_get_entry table idx:
                Option::Some entry:
                    match selfhost_memo_call_backend_private_cache_proof_gate_recheck_entry_result module entry:
                        Result::Ok _unit:
                            selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result module table add idx 1 n
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestEntryMissing idx

//: selfhost_memo_call_backend_private_cache_proof_gate_status_result: matching proof status を accepted / rejected に[畳/たた]む
fn selfhost_memo_call_backend_private_cache_proof_gate_status_result %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheProofStatus Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \key\status:
    match status:
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven:
            Result::Ok unit
        SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRefuted key

//: selfhost_memo_call_backend_private_cache_proof_gate_entry_result: 1 request entry に proof を[適用/てきよう]する
fn selfhost_memo_call_backend_private_cache_proof_gate_entry_result %fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostMemoCallBackendRequestTableEntry fn SelfhostHirExprId fn i32 Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \proofs\entry\root_expr_id\body_module_fingerprint:
    match selfhost_memo_call_backend_private_cache_proof_key_from_entry_result entry root_expr_id body_module_fingerprint:
        Result::Ok key:
            match selfhost_memo_call_backend_private_cache_proof_lookup_result proofs key:
                Result::Ok status:
                    selfhost_memo_call_backend_private_cache_proof_gate_status_result key status
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_proof_gate_apply_loop_result: request table 全体へ proof table を[適用/てきよう]する
fn selfhost_memo_call_backend_private_cache_proof_gate_apply_loop_result %fn &SelfhostMemoCallBackendRequestTable fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostHirExprId fn i32 fn i32 fn i32 Result i32 SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \table\proofs\root_expr_id\body_module_fingerprint\idx\n:
    if:
        ge idx n
        then:
            Result::Ok idx
        else:
            match selfhost_memo_call_backend_request_table_get_entry table idx:
                Option::Some entry:
                    match selfhost_memo_call_backend_private_cache_proof_gate_entry_result proofs entry root_expr_id body_module_fingerprint:
                        Result::Ok _unit:
                            selfhost_memo_call_backend_private_cache_proof_gate_apply_loop_result table proofs root_expr_id body_module_fingerprint add idx 1 n
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestEntryMissing idx

//: selfhost_memo_call_backend_private_cache_proof_gate_request_table_contains_key_loop: request table が proof key に対応する entry を持つか[返/かえ]す
//:
//: [目的/もくてき]:
//: - proof table に root subtree 外の orphan proof が混ざっても accepted summary にしないため、proof record 側から request table へ逆引きします。
fn selfhost_memo_call_backend_private_cache_proof_gate_request_table_contains_key_loop %fn &SelfhostMemoCallBackendRequestTable fn SelfhostHirExprId fn i32 fn SelfhostMemoCallBackendPrivateCacheProofKey fn i32 fn i32 Result bool SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \table\root_expr_id\body_module_fingerprint\key\idx\n:
    if:
        ge idx n
        then:
            Result::Ok false
        else:
            match selfhost_memo_call_backend_request_table_get_entry table idx:
                Option::Some entry:
                    match selfhost_memo_call_backend_private_cache_proof_key_from_entry_result entry root_expr_id body_module_fingerprint:
                        Result::Ok entry_key:
                            if:
                                selfhost_memo_call_backend_private_cache_proof_key_eq entry_key key
                                then:
                                    Result::Ok true
                                else:
                                    selfhost_memo_call_backend_private_cache_proof_gate_request_table_contains_key_loop table root_expr_id body_module_fingerprint key add idx 1 n
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestEntryMissing idx

//: selfhost_memo_call_backend_private_cache_proof_gate_validate_orphan_loop: proof table に orphan record がないか[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - proof record が request table のどの entry key とも一致しない場合は `ProofOrphan` として拒否します。
//: - proof table の読み取り失敗は `ProofRecordReadFailed` として保持します。
fn selfhost_memo_call_backend_private_cache_proof_gate_validate_orphan_loop %fn &SelfhostMemoCallBackendRequestTable fn &SelfhostMemoCallBackendPrivateCacheProofTable fn SelfhostHirExprId fn i32 fn i32 fn i32 fn i32 Result unit SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \table\proofs\root_expr_id\body_module_fingerprint\idx\proof_count\request_count:
    if:
        ge idx proof_count
        then:
            Result::Ok unit
        else:
            let records %&Vec SelfhostMemoCallBackendPrivateCacheProofRecord field::get_ref proofs "records"
            match v::get records idx:
                Option::Some record:
                    match selfhost_memo_call_backend_private_cache_proof_gate_request_table_contains_key_loop table root_expr_id body_module_fingerprint record.key 0 request_count:
                        Result::Ok found:
                            if:
                                found
                                then:
                                    selfhost_memo_call_backend_private_cache_proof_gate_validate_orphan_loop table proofs root_expr_id body_module_fingerprint add idx 1 proof_count request_count
                                else:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofOrphan record.key
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::ProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_proof_gate_from_collected_table_result: 内部収集済み table を[検査/けんさ]し owner を[閉/と]じる
fn selfhost_memo_call_backend_private_cache_proof_gate_from_collected_table_result %impure fn &SelfhostHirModule impure fn SelfhostMemoCallBackendRequestTable impure fn SelfhostHirExprId impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\table\root_expr_id\body_module_fingerprint\proofs:
    let request_count %i32 selfhost_memo_call_backend_request_table_len &table
    match selfhost_memo_call_backend_private_cache_proof_gate_recheck_loop_result module &table 0 request_count:
        Result::Ok _unit:
            match selfhost_memo_call_backend_private_cache_proof_gate_apply_loop_result &table proofs root_expr_id body_module_fingerprint 0 request_count:
                Result::Ok proven_count:
                    let proof_count %i32 selfhost_memo_call_backend_private_cache_proof_table_len proofs
                    match selfhost_memo_call_backend_private_cache_proof_gate_validate_orphan_loop &table proofs root_expr_id body_module_fingerprint 0 proof_count request_count:
                        Result::Ok _orphan_checked:
                            selfhost_memo_call_backend_request_table_free table
                            Result::Ok SelfhostMemoCallBackendPrivateCacheProofGateSummary request_count proven_count
                        Result::Err e:
                            selfhost_memo_call_backend_request_table_free table
                            Result::Err e
                Result::Err e:
                    selfhost_memo_call_backend_request_table_free table
                    Result::Err e
        Result::Err e:
            selfhost_memo_call_backend_request_table_free table
            Result::Err e

//: selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result: HIR root の memo_call PrivateCache proof gate を[実行/じっこう]する
//:
//: [契約/けいやく]:
//: - request table はこの関数の内部で作り、成功・失敗どちらでも閉じます。
//: - proof table は borrow であり、この関数は閉じません。
fn selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind \module\root\fuel\body_module_fingerprint\proofs:
    match selfhost_memo_call_backend_request_table_from_hir_root_result module root fuel:
        Result::Ok table:
            selfhost_memo_call_backend_private_cache_proof_gate_from_collected_table_result module table root body_module_fingerprint proofs
        Result::Err e:
            Result::Err SelfhostMemoCallBackendPrivateCacheProofGateErrorKind::RequestCollectionFailed e

//: selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result: Resource status を request-evidence status へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - Resource IR の private-cache no-escape observation を、既存 request-evidence gate が扱う status へ変換します。
//:
//: [契約/けいやく]:
//: - `PrivateCacheNoEscapeProven` だけが `RequestEvidenceProven` になります。
//: - `PrivateCacheMayEscape` は `RequestEvidenceRefuted` になります。この status は gate 側で accepted summary にならず、`ProofRefuted` として拒否されます。
//: - `PrivateCacheMissing` と `PrivateCacheUnknown` は proof record を作らず producer error にします。未証明を `Ok` の deferred plan にしません。
fn selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result %fn SelfhostMemoCallBackendPrivateCacheProofKey fn SelfhostMemoCallBackendPrivateCacheResourceProofStatus Result SelfhostMemoCallBackendPrivateCacheProofStatus SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \key\status:
    match status:
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheNoEscapeProven:
            Result::Ok SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceProven
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheMayEscape:
            Result::Ok SelfhostMemoCallBackendPrivateCacheProofStatus::RequestEvidenceRefuted
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheMissing:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofMissing key
        SelfhostMemoCallBackendPrivateCacheResourceProofStatus::PrivateCacheUnknown:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofUnknown key

//: selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result: Resource observation record を request-evidence record へ[変換/へんかん]する
fn selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result %fn SelfhostMemoCallBackendPrivateCacheResourceProofRecord Result SelfhostMemoCallBackendPrivateCacheProofRecord SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \record:
    match selfhost_memo_call_backend_private_cache_resource_status_to_request_status_result record.key record.status:
        Result::Ok request_status:
            Result::Ok selfhost_memo_call_backend_private_cache_proof_record_new record.key request_status
        Result::Err e:
            Result::Err e

//: selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output: producer 失敗時に output proof table を[閉/と]じる
fn selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output %impure fn SelfhostMemoCallBackendPrivateCacheProofTable impure fn SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \output\error:
    selfhost_memo_call_backend_private_cache_proof_table_free output
    Result::Err error

//: selfhost_memo_call_backend_private_cache_resource_proof_produce_loop: Resource observation table を request-evidence proof table へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - direct table contents を左から読み、Missing / Unknown を producer error として止めます。
//: - output proof table push は既存 private writer を使うため、body module fingerprint placeholder や lower push failure は既存 gate error を `RequestEvidenceGateRejected` に包みます。
fn selfhost_memo_call_backend_private_cache_resource_proof_produce_loop %impure fn SelfhostMemoCallBackendPrivateCacheProofTable impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable impure fn i32 Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \output\source\idx:
    if:
        ge idx selfhost_memo_call_backend_private_cache_resource_proof_table_len source
        then:
            Result::Ok output
        else:
            let records %&Vec SelfhostMemoCallBackendPrivateCacheResourceProofRecord field::get_ref source "records"
            match v::get records idx:
                Option::Some resource_record:
                    match selfhost_memo_call_backend_private_cache_resource_record_to_request_record_result resource_record:
                        Result::Ok request_record:
                            match selfhost_memo_call_backend_private_cache_proof_table_push output request_record:
                                Result::Ok next_output:
                                    selfhost_memo_call_backend_private_cache_resource_proof_produce_loop next_output source add idx 1
                                Result::Err gate_error:
                                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error
                        Result::Err e:
                            selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output output e
                Option::None:
                    selfhost_memo_call_backend_private_cache_resource_producer_fail_with_output output SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::ResourceProofRecordReadFailed idx

//: selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result: Resource table から request-evidence proof table を[作/つく]る
//:
//: [目的/もくてき]:
//: - producer-owned Resource observation を既存 gate が読める module-private proof table へ変換します。
//:
//: [契約/けいやく]:
//: - 成功時だけ caller が output proof table owner を受け取ります。失敗時はこの関数が output owner を閉じます。
fn selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result %impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable Result SelfhostMemoCallBackendPrivateCacheProofTable SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \source:
    match selfhost_memo_call_backend_private_cache_proof_table_new:
        Result::Ok output0:
            selfhost_memo_call_backend_private_cache_resource_proof_produce_loop output0 source 0
        Result::Err gate_error:
            Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error

//: selfhost_memo_call_backend_private_cache_resource_proof_gate_from_hir_root_result: Resource observation 由来の proof で既存 gate を[実行/じっこう]する
//:
//: [目的/もくてき]:
//: - Resource observation table を直接 accepted authority にせず、module-private request-evidence proof table へ変換してから既存 gate へ渡します。
//:
//: [契約/けいやく]:
//: - この入口は module-private です。Resource IR graph walker / no-escape producer が接続されるまで、外部 caller に accepted path を公開しません。
//: - request table は既存 gate の内部で HIR root から再構築します。Resource table は proof table へ変換されるだけで、caller supplied request table にはなりません。
//: - 既存 gate の成功は non-executable summary のままであり、backend bytes、cache operation、sealed representation は作りません。
fn selfhost_memo_call_backend_private_cache_resource_proof_gate_from_hir_root_result %impure fn &SelfhostHirModule impure fn SelfhostHirExprId impure fn i32 impure fn i32 impure fn &SelfhostMemoCallBackendPrivateCacheResourceProofTable Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind \module\root\fuel\body_module_fingerprint\resource_proofs:
    match selfhost_memo_call_backend_private_cache_resource_proof_table_to_request_evidence_result resource_proofs:
        Result::Ok request_proofs:
            let result %Result SelfhostMemoCallBackendPrivateCacheProofGateSummary SelfhostMemoCallBackendPrivateCacheProofGateErrorKind selfhost_memo_call_backend_private_cache_proof_gate_from_hir_root_result module root fuel body_module_fingerprint &request_proofs
            selfhost_memo_call_backend_private_cache_proof_table_free request_proofs
            match result:
                Result::Ok summary:
                    Result::Ok summary
                Result::Err gate_error:
                    Result::Err SelfhostMemoCallBackendPrivateCacheResourceProofProducerErrorKind::RequestEvidenceGateRejected gate_error
        Result::Err e:
            Result::Err e

