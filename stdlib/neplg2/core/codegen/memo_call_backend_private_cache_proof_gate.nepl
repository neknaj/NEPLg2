fn selfhost_memo_call_backend_private_cache_region_fresh_witness_table_free %impure fn SelfhostMemoCallBackendPrivateCacheRegionFreshWitnessTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_call_backend_private_cache_region_fresh_witness_table_len: fresh witness record 数を[返/かえ]す
