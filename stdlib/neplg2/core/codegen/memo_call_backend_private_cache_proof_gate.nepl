fn selfhost_memo_call_backend_private_cache_resource_graph_input_to_resource_proof_loop %impure fn SelfhostMemoCallBackendPrivateCacheResourceProofTable impure fn &SelfhostMemoCallBackendPrivateCacheResourceGraphInput impure fn i32 Result SelfhostMemoCallBackendPrivateCacheResourceProofTable SelfhostMemoCallBackendPrivateCacheResourceGraphProducerErrorKind \output\graph\idx:
