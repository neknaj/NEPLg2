//: memo_call backend private-cache Resource IR recursive operation topology source part
//:
//: ResourceFunction.blocks直下とBranch / Loop / Match内の再帰`Vec<ResourceOp>`を、global preorder nodeと明示scope edgeでlosslessに保持し、central inventory authorityへ接続するvalidator modelです。

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
