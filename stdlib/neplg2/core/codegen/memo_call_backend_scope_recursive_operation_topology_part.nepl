//: SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeParent: operation scopeの親identity
//:
//: [契約/けいやく]:
//: - `Block`はResourceFunction.blocksのdense block ordinal、`Operation`はselfhost投影が割り当てたglobal preorder node ordinalです。
//: - Rust modelにglobal ordinalやscope idが保存されているとは主張しません。これらは再帰列挙を検査するselfhost projection contractです。
enum SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeParent:
    Block %i32
    Operation %i32

//: SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeRole: Rustの各`Vec<ResourceOp>` fieldを区別するrole
//:
//: [契約/けいやく]:
//: - blockごとに`BlockOps`をちょうど1個持ちます。
//: - BranchはThen / Else、LoopはCondition / Bodyだけを各1個持ちます。
//: - MatchArmのordinalは0からdenseです。arm数0もRustのVec表現として保持し、意味上の到達可能性や型検査はここで推測しません。
enum SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeRole:
    BlockOps
    BranchThen
    BranchElse
    LoopCondition
    LoopBody
    MatchArm %i32

//: SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyNodeRecord: global preorder上のResourceOp node
//:
//: [契約/けいやく]:
//: - node ordinalは0からdenseで、kind / span / sparse payload ownerのoperation ordinalと同じdomainです。
//: - `subtree_end`はexclusiveです。node自身と全nested scopeをpreorderで覆い、leafでは`node_ordinal + 1`です。
struct SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyNodeRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    node_ordinal %i32
    owning_block_ordinal %i32
    parent_scope_id %i32
    subtree_end %i32

//: SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyScopeRecord: 1個のordered `Vec<ResourceOp>` region
//:
//: [契約/けいやく]:
//: - edge rangeはdirect childだけを表し、nested descendant数を混ぜません。
//: - `first_node`と`subtree_end`は各direct child subtreeを連結したexclusive preorder rangeです。空scopeでは同値です。
//: - scope idはowner内で0からdenseです。異なるparentのscope group間にglobal割当順は設けず、同じoperation parentの中だけrole順（Branch Then / Else、Loop Condition / Body、Match arm 0..N）を要求します。
struct SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyScopeRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    scope_id %i32
    parent %SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeParent
    role %SelfhostMemoCallBackendPrivateCacheResourceIrOperationScopeRole
    edge_start %i32
    child_count %i32
    first_node %i32
    subtree_end %i32

//: SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyEdgeRecord: scope内direct childのordered edge
struct SelfhostMemoCallBackendPrivateCacheResourceIrOperationTopologyEdgeRecord:
    key %SelfhostMemoCallBackendPrivateCacheProofKey
    graph_id %SelfhostMemoCallBackendPrivateCacheResourceGraphId
    edge_ordinal %i32
    scope_id %i32
    sibling_ordinal %i32
    child_node_ordinal %i32

