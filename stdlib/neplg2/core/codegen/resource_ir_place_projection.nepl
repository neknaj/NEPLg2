pub fn selfhost_resource_ir_resource_offset_is_structurally_valid %fn SelfhostResourceIrResourceOffset bool \offset:
    match offset:
        SelfhostResourceIrResourceOffset::Known value:
            ge value 0
        SelfhostResourceIrResourceOffset::Symbolic place_index:
            ge place_index 0
        SelfhostResourceIrResourceOffset::ScaledSymbolic value:
            and ge value.place_index 0 ge value.scale 0
        SelfhostResourceIrResourceOffset::Offset value:
            ge value.place_index 0
        SelfhostResourceIrResourceOffset::ScaledOffset value:
            and ge value.place_index 0 ge value.scale 0
        SelfhostResourceIrResourceOffset::Unknown:
            true

