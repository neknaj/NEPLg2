#indent 4

//: # ty/memo_trait
//: `memo_call` Phase 1 が使う `MemoKey` / `MemoValue` の self-host 側 structural predicate を置くモジュールです。
//:
//: [目的/もくてき]:
//: - `memo_call @func` は private cache の key と value を安全に保存します。そのため key には pure で安定した equality / hash が必要で、value には cache storage の identity を外へ漏らさず Copy 相当で返せることが必要です。
//: - `Copy` だけでは function value、raw memory handle、owner token、public mutable state 由来の値まで通してしまうため、この module は memoization 専用の追加 predicate を enum error として返します。
//: - typechecker、HIR lowering、Resource IR、backend が同じ拒否理由を共有できるよう、文字列診断ではなく `SelfhostMemoTraitRejectKind` を authority にします。
//:
//: [契約/けいやく]:
//: - `selfhost_memo_key_type_result` は、現 checkpoint では `unit`、`bool`、`i32`、`u8`、`char` だけを受理します。
//: - `selfhost_memo_value_type_result` は、key と同じ型に加えて `f32` を受理します。`f32` は NaN、符号付き zero、正規化、hash consistency の仕様が固定されるまで key としては拒否します。
//: - `str`、`function`、`named`、`applied`、`parameter`、`error`、`never`、`i64`、`f64`、存在しない `TypeId` は fail-closed に拒否します。
//: - `Named` / `Applied` は Rust 実装の最終方針では structural aggregate として受理され得ます。ただし self-host の現行 `TypeArena` は field layout、trait impl evidence、drop/copy evidence を持たないため、ここで推測して受理してはいけません。
//:
//: [現状/げんじょう]:
//: - この module は trait solver ではありません。`MemoKey` / `MemoValue` の trait definition source identity、Copy trait evidence、Drop なし proof、private cache region proof は後続 stage が接続します。
//: - `I64` / `F64` は self-host 型モデルには載っていますが、現 Rust compiler の Phase 1 memo predicate と parity が固定されていないため、明示的に unsupported として拒否します。
//:
//: [計算量/けいさんりょう]:
//: - `TypeId` lookup と record variant の match だけなので O(1) です。
//: - 将来 aggregate を受理する段階では、対象 aggregate から到達する field type 数に比例する O(n) の構造走査になります。その時点では cycle / recursive type の proof boundary も追加します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_result_is_accept summary.unit_key
//:             let checks2 checks_push checks1 check selfhost_memo_trait_result_is_accept summary.i32_key
//:             let checks3 checks_push checks2 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.f32_key) SelfhostMemoTraitRejectKind::F32KeyUnsupported
//:             let checks4 checks_push checks3 check selfhost_memo_trait_result_is_accept summary.f32_value
//:             let checks5 checks_push checks4 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.function_value) SelfhostMemoTraitRejectKind::FunctionUnsupported
//:             let shown checks_print_report checks5
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./arena" as *
#import "./id" as *
#import "./kind/model" as *
#import "./record" as *

//: SelfhostMemoTraitRejectKind: `MemoKey` / `MemoValue` structural predicate の拒否理由
//:
//: [目的/もくてき]:
//: - memoization の拒否を単なる `false` にせず、診断や regression test が「どの安全条件で拒否したか」を enum として確認できるようにします。
//:
//: [分類/ぶんるい]:
//: - `MissingTypeRecord` は arena に存在しない `TypeId` です。
//: - `ErrorTypeUnsupported` は既に壊れた型を memo trait evidence として使おうとした場合です。
//: - `I64Unsupported` と `F64Unsupported` は backend scalar parity と hash/value policy が未固定の型を保守的に拒否した場合です。
//: - `F32KeyUnsupported` は `f32` を key にしようとした場合です。value としての `f32` は Phase 1 で受理します。
//: - `StrUnsupported` は immutable string の equality/hash/clone/drop proof が未接続であるため拒否した場合です。
//: - `NeverUnsupported` は値を作れない型を memo trait の具体 payload として扱わないための拒否です。
//: - `FunctionUnsupported` は function identity の canonicalization と cache namespace が未完成なため拒否した場合です。
//: - `NamedLayoutUnknown` と `AppliedLayoutUnknown` は field layout と trait evidence を持たない aggregate を推測で受理しないための拒否です。
//: - `ParameterUnresolved` は generic parameter が concrete type に代入される前に predicate へ来た場合です。
pub enum SelfhostMemoTraitRejectKind:
    MissingTypeRecord
    ErrorTypeUnsupported
    I64Unsupported
    F32KeyUnsupported
    F64Unsupported
    StrUnsupported
    NeverUnsupported
    FunctionUnsupported
    NamedLayoutUnknown
    AppliedLayoutUnknown
    ParameterUnresolved

impl Clone for SelfhostMemoTraitRejectKind:
    fn clone %fn &SelfhostMemoTraitRejectKind SelfhostMemoTraitRejectKind \self:
        *self

impl Copy for SelfhostMemoTraitRejectKind:
    fn copy_mark %fn SelfhostMemoTraitRejectKind SelfhostMemoTraitRejectKind \self:
        self

//: SelfhostMemoTraitStage0Summary: focused doctest 用の代表 predicate 結果
//:
//: [目的/もくてき]:
//: - module-level doctest が arena owner の構築を繰り返さず、受理と拒否の代表例だけを確認できるようにします。
//: - production predicate の戻り値型と同じ `Result unit SelfhostMemoTraitRejectKind` を保持し、テストが bool だけではなく拒否理由も確認できるようにします。
pub struct SelfhostMemoTraitStage0Summary:
    unit_key %Result unit SelfhostMemoTraitRejectKind
    i32_key %Result unit SelfhostMemoTraitRejectKind
    f32_key %Result unit SelfhostMemoTraitRejectKind
    f32_value %Result unit SelfhostMemoTraitRejectKind
    function_value %Result unit SelfhostMemoTraitRejectKind

//: selfhost_memo_trait_result_is_accept: memo trait predicate result が成功か[返/かえ]す
//:
//: [目的/もくてき]:
//: - diagnostic や detailed test は `Result` の中身を match しますが、call gate では「受理されたか」だけを扱いたい場所もあります。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: predicate は `Ok unit` です。
//: - `false`: predicate は `Err(kind)` です。caller は必要に応じて `kind` を診断へ渡します。
//:
//: [計算量/けいさんりょう]:
//: - enum tag の match だけなので O(1) です。
pub fn selfhost_memo_trait_result_is_accept %fn Result unit SelfhostMemoTraitRejectKind bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_reject_kind_eq: 拒否理由が同じ分類か[返/かえ]す
//:
//: [目的/もくてき]:
//: - focused test と diagnostic projection が表示文字列ではなく enum variant を比較できるようにします。
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。新しい拒否理由を追加した場合、この比較関数も明示的に更新する必要があります。
pub fn selfhost_memo_trait_reject_kind_eq %fn SelfhostMemoTraitRejectKind fn SelfhostMemoTraitRejectKind bool \a\b:
    match a:
        SelfhostMemoTraitRejectKind::MissingTypeRecord:
            match b:
                SelfhostMemoTraitRejectKind::MissingTypeRecord:
                    true
                SelfhostMemoTraitRejectKind::ErrorTypeUnsupported:
                    false
                SelfhostMemoTraitRejectKind::I64Unsupported:
                    false
                SelfhostMemoTraitRejectKind::F32KeyUnsupported:
                    false
                SelfhostMemoTraitRejectKind::F64Unsupported:
                    false
                SelfhostMemoTraitRejectKind::StrUnsupported:
                    false
                SelfhostMemoTraitRejectKind::NeverUnsupported:
                    false
                SelfhostMemoTraitRejectKind::FunctionUnsupported:
                    false
                SelfhostMemoTraitRejectKind::NamedLayoutUnknown:
                    false
                SelfhostMemoTraitRejectKind::AppliedLayoutUnknown:
                    false
                SelfhostMemoTraitRejectKind::ParameterUnresolved:
                    false
        SelfhostMemoTraitRejectKind::ErrorTypeUnsupported:
            match b:
                SelfhostMemoTraitRejectKind::MissingTypeRecord:
                    false
                SelfhostMemoTraitRejectKind::ErrorTypeUnsupported:
                    true
                SelfhostMemoTraitRejectKind::I64Unsupported:
                    false
