#indent 4

//: # ty/memo_trait
//: `memo_call` Phase 1 が使う `MemoKey` / `MemoValue` の self-host 側 structural predicate を置くモジュールです。
//:
//: [目的/もくてき]:
//: - `memo_call @func` は private cache の key と value を安全に保存します。そのため key には pure で安定した equality / hash が必要で、value には cache storage の identity を外へ漏らさず Copy 相当で返せることが必要です。
//: - `Copy` だけでは function value、raw memory handle、owner token、public mutable state 由来の値まで通してしまうため、この module は memoization 専用の追加 predicate を enum error として返します。
//: - typechecker、HIR lowering、Resource IR、backend が同じ拒否理由を共有できるよう、文字列診断ではなく `SelfhostMemoTraitRejectKind` を authority にします。
//:
//: [契約/けいやく]:
//: - `selfhost_memo_key_type_result` は、現 checkpoint では `unit`、`bool`、`i32`、`u8`、`char` だけを受理します。
//: - `selfhost_memo_value_type_result` は、key と同じ型に加えて `f32` を受理します。`f32` は NaN、符号付き zero、正規化、hash consistency の仕様が固定されるまで key としては拒否します。
//: - `str`、`function`、`named`、`applied`、`parameter`、`error`、`never`、`i64`、`f64`、存在しない `TypeId` は fail-closed に拒否します。
//: - `Named` / `Applied` は Rust 実装の最終方針では structural aggregate として受理され得ます。ただし self-host の現行 `TypeArena` は field layout、trait impl evidence、drop/copy evidence を持たないため、ここで推測して受理してはいけません。
//: - `selfhost_memo_*_type_result_with_evidence` は、後続の trait / layout solver が作った証拠 table を消費するための入口です。この入口でも primitive、function、parameter、missing record の判定は証拠で上書きできません。証拠は `Named` / `Applied` の structural aggregate 判定だけを運びます。
//:
//: [現状/げんじょう]:
//: - この module は trait solver ではありません。`MemoKey` / `MemoValue` の trait definition source identity、Copy trait evidence、Drop なし proof、private cache region proof は後続 stage が接続します。
//: - `I64` / `F64` は self-host 型モデルには載っていますが、現 Rust compiler の Phase 1 memo predicate と parity が固定されていないため、明示的に unsupported として拒否します。
//:
//: [計算量/けいさんりょう]:
//: - `TypeId` lookup と record variant の match だけなので O(1) です。
//: - 将来 aggregate を受理する段階では、対象 aggregate から到達する field type 数に比例する O(n) の構造走査になります。その時点では cycle / recursive type の proof boundary も追加します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_result_is_accept summary.unit_key
//:             let checks2 checks_push checks1 check selfhost_memo_trait_result_is_accept summary.i32_key
//:             let checks3 checks_push checks2 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.f32_key) SelfhostMemoTraitRejectKind::F32KeyUnsupported
//:             let checks4 checks_push checks3 check selfhost_memo_trait_result_is_accept summary.f32_value
//:             let checks5 checks_push checks4 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.function_value) SelfhostMemoTraitRejectKind::FunctionUnsupported
//:             let shown checks_print_report checks5
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./arena" as *
#import "./id" as *
#import "./kind/model" as *
#import "./record" as *

//: SelfhostMemoTraitRejectKind: `MemoKey` / `MemoValue` structural predicate の拒否理由
//:
//: [目的/もくてき]:
//: - memoization の拒否を単なる `false` にせず、診断や regression test が「どの安全条件で拒否したか」を enum として確認できるようにします。
//:
//: [分類/ぶんるい]:
//: - `MissingTypeRecord` は arena に存在しない `TypeId` です。
//: - `ErrorTypeUnsupported` は既に壊れた型を memo trait evidence として使おうとした場合です。
//: - `I64Unsupported` と `F64Unsupported` は backend scalar parity と hash/value policy が未固定の型を保守的に拒否した場合です。
//: - `F32KeyUnsupported` は `f32` を key にしようとした場合です。value としての `f32` は Phase 1 で受理します。
//: - `StrUnsupported` は immutable string の equality/hash/clone/drop proof が未接続であるため拒否した場合です。
//: - `NeverUnsupported` は値を作れない型を memo trait の具体 payload として扱わないための拒否です。
//: - `FunctionUnsupported` は function identity の canonicalization と cache namespace が未完成なため拒否した場合です。
//: - `NamedLayoutUnknown` と `AppliedLayoutUnknown` は field layout と trait evidence を持たない aggregate を推測で受理しないための拒否です。
//: - `ParameterUnresolved` は generic parameter が concrete type に代入される前に predicate へ来た場合です。
//: - `*ProofMissing` / `*ProofImpure` / `*ProofUnknown` は aggregate の Copy / Drop / Eq / Hash 証明が `MemoKey` / `MemoValue` の要求を満たさない場合です。
//: - hazard 系 variant は cache 内部参照、external handle、owner token、public mutable state、unknown hazard を含むため、key または value として安全に memo cache へ置けない場合です。
pub enum SelfhostMemoTraitRejectKind:
    MissingTypeRecord
    ErrorTypeUnsupported
    I64Unsupported
    F32KeyUnsupported
    F64Unsupported
    StrUnsupported
    NeverUnsupported
    FunctionUnsupported
    NamedLayoutUnknown
    AppliedLayoutUnknown
    ParameterUnresolved
    CopyProofMissing
    CopyProofImpure
    CopyProofUnknown
    DropProofMissing
    DropProofImpure
    DropProofUnknown
    EqProofMissing
    EqProofImpure
    EqProofUnknown
    HashProofMissing
    HashProofImpure
    HashProofUnknown
    CacheReferenceEscape
    ExternalHandle
    OwnerToken
    PublicMutableState
    HazardUnknown

impl Clone for SelfhostMemoTraitRejectKind:
    fn clone %fn &SelfhostMemoTraitRejectKind SelfhostMemoTraitRejectKind \self:
        *self

impl Copy for SelfhostMemoTraitRejectKind:
    fn copy_mark %fn SelfhostMemoTraitRejectKind SelfhostMemoTraitRejectKind \self:
        self

//: SelfhostMemoTraitStage0Summary: focused doctest 用の代表 predicate 結果
//:
//: [目的/もくてき]:
//: - module-level doctest が arena owner の構築を繰り返さず、受理と拒否の代表例だけを確認できるようにします。
//: - production predicate の戻り値型と同じ `Result unit SelfhostMemoTraitRejectKind` を保持し、テストが bool だけではなく拒否理由も確認できるようにします。
pub struct SelfhostMemoTraitStage0Summary:
    unit_key %Result unit SelfhostMemoTraitRejectKind
    i32_key %Result unit SelfhostMemoTraitRejectKind
    f32_key %Result unit SelfhostMemoTraitRejectKind
    f32_value %Result unit SelfhostMemoTraitRejectKind
    function_value %Result unit SelfhostMemoTraitRejectKind

//: SelfhostMemoTraitEvidenceRecord: aggregate memo trait 証拠 table の 1 record
//:
//: [目的/もくてき]:
//: - `Named` / `Applied` type が `MemoKey` / `MemoValue` を満たすかどうかを、trait solver / layout solver が決定した結果として運びます。
//: - この record は solver の代替ではありません。field layout、Copy / Drop / Eq / Hash の証明、cache internal reference 非露出の確認は、record を作る側の責務です。
//:
//: [契約/けいやく]:
//: - `type_id` は同じ `SelfhostTypeArena` 内の `Named` または `Applied` record を指します。
//: - `key_result` と `value_result` は `Result unit SelfhostMemoTraitRejectKind` のまま保持し、診断が拒否理由を失わないようにします。
//: - function type、generic parameter、primitive unsupported scalar の拒否はこの record で上書きできません。消費側は record lookup より先に arena record variant を確認します。
//:
//: [計算量/けいさんりょう]:
//: - record の構築とコピーは O(1) です。
pub struct SelfhostMemoTraitEvidenceRecord:
    type_id %SelfhostTypeId
    key_result %Result unit SelfhostMemoTraitRejectKind
    value_result %Result unit SelfhostMemoTraitRejectKind

impl Clone for SelfhostMemoTraitEvidenceRecord:
    fn clone %fn &SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitEvidenceRecord \self:
        *self

impl Copy for SelfhostMemoTraitEvidenceRecord:
    fn copy_mark %fn SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitEvidenceRecord \self:
        self

//: SelfhostMemoTraitEvidenceTable: aggregate memo trait 証拠の session-local table
//:
//: [目的/もくてき]:
//: - selfhost checker が同じ TypeArena session 内で計算した aggregate predicate 結果を、`memo_call` gate へ渡すための owner です。
//: - table は source text、diagnostic string、layout owner、trait solver state を持ちません。消費側は小さな Copy record だけを読みます。
//:
//: [契約/けいやく]:
//: - この table は永続 artifact の key ではありません。将来 `.neplmeta` / `.neplproof` へ出す場合は canonical type key と solver policy hash を別途使います。
//: - 同じ `type_id` が複数ある場合は最初の record を使います。生成側は重複を作らない責務を持ちますが、消費側は探索範囲を広げて後続 record を推測しません。
//:
//: [計算量/けいさんりょう]:
//: - lookup は record 数を n として O(n) です。現段階では小さな focused boundary であり、trait solver 側の stable map / canonical key index は後続 slice で追加します。
pub struct SelfhostMemoTraitEvidenceTable:
    records %Vec SelfhostMemoTraitEvidenceRecord

//: SelfhostMemoTraitEvidenceStage0Summary: evidence table 付き predicate の focused summary
//:
//: [目的/もくてき]:
//: - doctest が `Named` を証拠なしでは拒否し、証拠ありでは Result payload を消費できることを確認します。
//: - production API と同じ `Result unit SelfhostMemoTraitRejectKind` を保持し、bool だけの smoke にしません。
pub struct SelfhostMemoTraitEvidenceStage0Summary:
    named_without_evidence %Result unit SelfhostMemoTraitRejectKind
    named_key_with_evidence %Result unit SelfhostMemoTraitRejectKind
    named_value_with_evidence %Result unit SelfhostMemoTraitRejectKind
    named_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_without_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_key_with_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_value_with_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind
    f32_key_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind
    missing_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind

//: selfhost_memo_trait_result_is_accept: memo trait predicate result が成功か[返/かえ]す
//:
//: [目的/もくてき]:
//: - diagnostic や detailed test は `Result` の中身を match しますが、call gate では「受理されたか」だけを扱いたい場所もあります。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: predicate は `Ok unit` です。
//: - `false`: predicate は `Err(kind)` です。caller は必要に応じて `kind` を診断へ渡します。
//:
//: [計算量/けいさんりょう]:
//: - enum tag の match だけなので O(1) です。
pub fn selfhost_memo_trait_result_is_accept %fn Result unit SelfhostMemoTraitRejectKind bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_reject_kind_code: 拒否理由を比較用 code へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - focused test と diagnostic projection が表示文字列ではなく enum variant を比較できるようにします。
//: - variant ごとの code を 1 箇所に閉じ、`selfhost_memo_trait_reject_kind_eq` が組み合わせ数ではなく variant 数に比例して保守できるようにします。
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。新しい拒否理由を追加した場合、この関数も明示的に更新します。
fn selfhost_memo_trait_reject_kind_code %fn SelfhostMemoTraitRejectKind i32 \kind:
    match kind:
        SelfhostMemoTraitRejectKind::MissingTypeRecord:
            0
        SelfhostMemoTraitRejectKind::ErrorTypeUnsupported:
            1
        SelfhostMemoTraitRejectKind::I64Unsupported:
            2
        SelfhostMemoTraitRejectKind::F32KeyUnsupported:
            3
        SelfhostMemoTraitRejectKind::F64Unsupported:
            4
        SelfhostMemoTraitRejectKind::StrUnsupported:
            5
        SelfhostMemoTraitRejectKind::NeverUnsupported:
            6
        SelfhostMemoTraitRejectKind::FunctionUnsupported:
            7
        SelfhostMemoTraitRejectKind::NamedLayoutUnknown:
            8
        SelfhostMemoTraitRejectKind::AppliedLayoutUnknown:
            9
        SelfhostMemoTraitRejectKind::ParameterUnresolved:
            10
        SelfhostMemoTraitRejectKind::CopyProofMissing:
            11
        SelfhostMemoTraitRejectKind::CopyProofImpure:
            12
        SelfhostMemoTraitRejectKind::CopyProofUnknown:
            13
        SelfhostMemoTraitRejectKind::DropProofMissing:
            14
        SelfhostMemoTraitRejectKind::DropProofImpure:
            15
        SelfhostMemoTraitRejectKind::DropProofUnknown:
            16
        SelfhostMemoTraitRejectKind::EqProofMissing:
            17
        SelfhostMemoTraitRejectKind::EqProofImpure:
            18
        SelfhostMemoTraitRejectKind::EqProofUnknown:
            19
        SelfhostMemoTraitRejectKind::HashProofMissing:
            20
        SelfhostMemoTraitRejectKind::HashProofImpure:
            21
        SelfhostMemoTraitRejectKind::HashProofUnknown:
            22
        SelfhostMemoTraitRejectKind::CacheReferenceEscape:
            23
        SelfhostMemoTraitRejectKind::ExternalHandle:
            24
        SelfhostMemoTraitRejectKind::OwnerToken:
            25
        SelfhostMemoTraitRejectKind::PublicMutableState:
            26
        SelfhostMemoTraitRejectKind::HazardUnknown:
            27

//: selfhost_memo_trait_reject_kind_eq: 拒否理由が同じ分類か[返/かえ]す
//:
//: [目的/もくてき]:
//: - focused test と diagnostic projection が表示文字列ではなく enum variant を比較できるようにします。
//:
//: [契約/けいやく]:
//: - `selfhost_memo_trait_reject_kind_code` が wildcard arm なしで全 variant を明示的に射影するため、この関数は整数比較だけを行います。
pub fn selfhost_memo_trait_reject_kind_eq %fn SelfhostMemoTraitRejectKind fn SelfhostMemoTraitRejectKind bool \a\b:
    eq selfhost_memo_trait_reject_kind_code a selfhost_memo_trait_reject_kind_code b
//: selfhost_memo_trait_evidence_record_new: aggregate memo trait 証拠 record を[作/つく]る
//:
//: [目的/もくてき]:
//: - trait / layout solver が計算済みの key/value predicate 結果を、memo trait gate が読める Copy payload へまとめます。
//:
//: [契約/けいやく]:
//: - この関数は証拠の正しさを証明しません。caller は `type_id` が同じ arena 内の aggregate type であること、`key_result` / `value_result` がその aggregate の実際の structural proof に対応することを保証します。
//: - 消費側は aggregate 以外の型ではこの record を使わないため、誤って function type などの record が table に入っても primitive / function / parameter の判定は上書きされません。
pub fn selfhost_memo_trait_evidence_record_new %fn SelfhostTypeId fn Result unit SelfhostMemoTraitRejectKind fn Result unit SelfhostMemoTraitRejectKind SelfhostMemoTraitEvidenceRecord \type_id\key_result\value_result:
    SelfhostMemoTraitEvidenceRecord type_id key_result value_result

//: selfhost_memo_trait_evidence_table_new: [空/から]の aggregate memo trait 証拠 table を[作/つく]る
//:
//: [目的/もくてき]:
//: - checker が `MemoKey` / `MemoValue` structural proof を別 pass で集めたあと、memo gate へ渡す owner table を作ります。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(table)`: 空の table を作れました。
//: - `Err(error)`: backing vector の確保に失敗しました。
pub fn selfhost_memo_trait_evidence_table_new %impure fn void Result SelfhostMemoTraitEvidenceTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitEvidenceRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitEvidenceTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_evidence_table_free: evidence table の owner buffer を[解放/かいほう]する
//:
//: [目的/もくてき]:
//: - table が持つ `Vec` owner を明示的に閉じ、selfhost smoke や後続 checker pass が owner leak を残さないようにします。
pub fn selfhost_memo_trait_evidence_table_free %impure fn SelfhostMemoTraitEvidenceTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_evidence_table_push: evidence record を table に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - solver が計算した aggregate result を順序付き table へ追加します。
//:
//: [契約/けいやく]:
//: - 失敗時は入力 table の backing vector を回収し、`StdErrorKind` だけを返します。
//: - duplicate `type_id` の拒否はこの関数では行いません。duplicate を作らない責務は solver 側に置き、消費側は最初の record だけを使うことで探索範囲を固定します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(table)`: record を末尾へ追加した table owner を返します。
//: - `Err(error)`: `Vec` の拡張に失敗しました。入力 table の backing vector はこの関数が解放済みです。
pub fn selfhost_memo_trait_evidence_table_push %impure fn SelfhostMemoTraitEvidenceTable impure fn SelfhostMemoTraitEvidenceRecord Result SelfhostMemoTraitEvidenceTable StdErrorKind \table\record:
    let records %Vec SelfhostMemoTraitEvidenceRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitEvidenceTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_memo_trait_evidence_table_find_loop: evidence record を左から[探/さが]す
//:
//: [目的/もくてき]:
//: - table lookup を小さな再帰 helper に閉じ、public predicate 側が lookup の詳細を持たないようにします。
//:
//: [契約/けいやく]:
//: - 最初に `type_id` が一致した record を返します。
//: - 見つからなければ `none` を返します。
fn selfhost_memo_trait_evidence_table_find_loop %fn &SelfhostMemoTraitEvidenceTable fn SelfhostTypeId fn i32 Option SelfhostMemoTraitEvidenceRecord \table\type_id\idx:
    let records %&Vec SelfhostMemoTraitEvidenceRecord field::get_ref table "records"
    let n %i32 v::len records
    if:
        ge idx n
        then:
            none
        else:
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_type_id_eq record.type_id type_id
                        then:
                            some record
                        else:
                            let next_idx %i32 add idx 1
                            selfhost_memo_trait_evidence_table_find_loop table type_id next_idx
                Option::None:
                    none

//: selfhost_memo_trait_evidence_table_find: TypeId に対応する aggregate evidence を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `Named` / `Applied` predicate が、trait solver から渡された Result payload を取得するための唯一の lookup 入口です。
//:
//: [契約/けいやく]:
//: - duplicate `type_id` が table に含まれている場合は、左から最初の record を返します。この規則により、消費側は後続 record を見て policy を推測しません。
//:
//: [戻/もど]り[値/ち]:
//: - `some(record)`: `type_id` に一致する最初の evidence record です。
//: - `none`: 対応する evidence record はありません。
//:
//: [計算量/けいさんりょう]:
//: - record 数を n として O(n) です。
pub fn selfhost_memo_trait_evidence_table_find %fn &SelfhostMemoTraitEvidenceTable fn SelfhostTypeId Option SelfhostMemoTraitEvidenceRecord \table\type_id:
    selfhost_memo_trait_evidence_table_find_loop table type_id 0

//: selfhost_memo_key_primitive_result: primitive 型が `MemoKey` Phase 1 を満たすか[返/かえ]す
//:
//: [目的/もくてき]:
//: - key 側の許可集合を value 側と分け、`f32` が value では受理されるが key では拒否される契約を明示します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: primitive は Phase 1 の memo key として受理できます。
//: - `Err(kind)`: primitive は key として拒否されます。
fn selfhost_memo_key_primitive_result %fn SelfhostPrimitiveTypeKind Result unit SelfhostMemoTraitRejectKind \kind:
    match kind:
        SelfhostPrimitiveTypeKind::Error:
            Result::Err SelfhostMemoTraitRejectKind::ErrorTypeUnsupported
        SelfhostPrimitiveTypeKind::Unit:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Bool:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::I32:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::I64:
            Result::Err SelfhostMemoTraitRejectKind::I64Unsupported
        SelfhostPrimitiveTypeKind::U8:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Char:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Str:
            Result::Err SelfhostMemoTraitRejectKind::StrUnsupported
        SelfhostPrimitiveTypeKind::F32:
            Result::Err SelfhostMemoTraitRejectKind::F32KeyUnsupported
        SelfhostPrimitiveTypeKind::F64:
            Result::Err SelfhostMemoTraitRejectKind::F64Unsupported
        SelfhostPrimitiveTypeKind::Never:
            Result::Err SelfhostMemoTraitRejectKind::NeverUnsupported

//: selfhost_memo_value_primitive_result: primitive 型が `MemoValue` Phase 1 を満たすか[返/かえ]す
//:
//: [目的/もくてき]:
//: - value 側は cache hit 時に Copy 相当で返せればよいため、key では拒否する `f32` を受理します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: primitive は Phase 1 の memo value として受理できます。
//: - `Err(kind)`: primitive は value として拒否されます。
fn selfhost_memo_value_primitive_result %fn SelfhostPrimitiveTypeKind Result unit SelfhostMemoTraitRejectKind \kind:
    match kind:
        SelfhostPrimitiveTypeKind::Error:
            Result::Err SelfhostMemoTraitRejectKind::ErrorTypeUnsupported
        SelfhostPrimitiveTypeKind::Unit:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Bool:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::I32:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::I64:
            Result::Err SelfhostMemoTraitRejectKind::I64Unsupported
        SelfhostPrimitiveTypeKind::U8:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Char:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::Str:
            Result::Err SelfhostMemoTraitRejectKind::StrUnsupported
        SelfhostPrimitiveTypeKind::F32:
            Result::Ok unit
        SelfhostPrimitiveTypeKind::F64:
            Result::Err SelfhostMemoTraitRejectKind::F64Unsupported
        SelfhostPrimitiveTypeKind::Never:
            Result::Err SelfhostMemoTraitRejectKind::NeverUnsupported

//: selfhost_memo_key_type_result: TypeArena 上の型が `MemoKey` Phase 1 を満たすか[返/かえ]す
//:
//: [目的/もくてき]:
//: - `memo_call` gate が key type を検査するとき、arena record だけを authority として fail-closed に分類します。
//:
//: [契約/けいやく]:
//: - `Named` / `Applied` は field layout と trait evidence が接続されるまで拒否します。これは Rust 実装の structural aggregate acceptance を否定するものではなく、self-host 側で未証明の aggregate を推測で通さないための境界です。
//: - `Parameter` は concrete substitution 後に再度 predicate へ渡す必要があります。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: key type として受理できます。
//: - `Err(kind)`: `kind` が拒否理由です。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn selfhost_memo_key_type_result %fn &SelfhostTypeArena fn SelfhostTypeId Result unit SelfhostMemoTraitRejectKind \arena\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    selfhost_memo_key_primitive_result kind
                SelfhostTypeRecord::Named _named:
                    Result::Err SelfhostMemoTraitRejectKind::NamedLayoutUnknown
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Err SelfhostMemoTraitRejectKind::ParameterUnresolved
                SelfhostTypeRecord::Applied _applied:
                    Result::Err SelfhostMemoTraitRejectKind::AppliedLayoutUnknown
                SelfhostTypeRecord::Function _function:
                    Result::Err SelfhostMemoTraitRejectKind::FunctionUnsupported
        Option::None:
            Result::Err SelfhostMemoTraitRejectKind::MissingTypeRecord

//: selfhost_memo_value_type_result: TypeArena 上の型が `MemoValue` Phase 1 を満たすか[返/かえ]す
//:
//: [目的/もくてき]:
//: - `memo_call` gate が result type を検査するとき、cache storage への reference / identity を外へ漏らさない Phase 1 value だけを受理します。
//:
//: [契約/けいやく]:
//: - value predicate は key predicate より少し広く、`f32` を受理します。
//: - `str` や aggregate owner は Clone/Drop/identity proof が未接続なので拒否します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: value type として受理できます。
//: - `Err(kind)`: `kind` が拒否理由です。
//:
//: [計算量/けいさんりょう]:
//: - O(1) です。
pub fn selfhost_memo_value_type_result %fn &SelfhostTypeArena fn SelfhostTypeId Result unit SelfhostMemoTraitRejectKind \arena\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    selfhost_memo_value_primitive_result kind
                SelfhostTypeRecord::Named _named:
                    Result::Err SelfhostMemoTraitRejectKind::NamedLayoutUnknown
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Err SelfhostMemoTraitRejectKind::ParameterUnresolved
                SelfhostTypeRecord::Applied _applied:
                    Result::Err SelfhostMemoTraitRejectKind::AppliedLayoutUnknown
                SelfhostTypeRecord::Function _function:
                    Result::Err SelfhostMemoTraitRejectKind::FunctionUnsupported
        Option::None:
            Result::Err SelfhostMemoTraitRejectKind::MissingTypeRecord

//: selfhost_memo_key_type_result_with_evidence: aggregate evidence table を使って `MemoKey` predicate を[返/かえ]す
//:
//: [目的/もくてき]:
//: - trait / layout solver が `Named` / `Applied` aggregate について計算した structural proof を、`memo_call` gate が利用できる形にします。
//:
//: [契約/けいやく]:
//: - primitive は既存の primitive predicate を使います。evidence table に同じ `TypeId` の record があっても primitive の許可集合は上書きしません。
//: - `Named` / `Applied` だけが evidence table を参照します。証拠が無い場合は既存と同じ `NamedLayoutUnknown` / `AppliedLayoutUnknown` を返します。
//: - `Function`、`Parameter`、missing record は evidence で受理できません。
//:
//: [計算量/けいさんりょう]:
//: - primitive / function / parameter / missing は O(1) です。`Named` / `Applied` は evidence record 数を n として O(n) です。
pub fn selfhost_memo_key_type_result_with_evidence %fn &SelfhostTypeArena fn &SelfhostMemoTraitEvidenceTable fn SelfhostTypeId Result unit SelfhostMemoTraitRejectKind \arena\evidence\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    selfhost_memo_key_primitive_result kind
                SelfhostTypeRecord::Named _named:
                    match selfhost_memo_trait_evidence_table_find evidence type_id:
                        Option::Some evidence_record:
                            evidence_record.key_result
                        Option::None:
                            Result::Err SelfhostMemoTraitRejectKind::NamedLayoutUnknown
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Err SelfhostMemoTraitRejectKind::ParameterUnresolved
                SelfhostTypeRecord::Applied _applied:
                    match selfhost_memo_trait_evidence_table_find evidence type_id:
                        Option::Some evidence_record:
                            evidence_record.key_result
                        Option::None:
                            Result::Err SelfhostMemoTraitRejectKind::AppliedLayoutUnknown
                SelfhostTypeRecord::Function _function:
                    Result::Err SelfhostMemoTraitRejectKind::FunctionUnsupported
        Option::None:
            Result::Err SelfhostMemoTraitRejectKind::MissingTypeRecord

//: selfhost_memo_value_type_result_with_evidence: aggregate evidence table を使って `MemoValue` predicate を[返/かえ]す
//:
//: [目的/もくてき]:
//: - value 側でも、trait / layout solver が証明済みの aggregate だけを受理できるようにします。
//:
//: [契約/けいやく]:
//: - primitive value predicate は evidence で上書きしません。特に `str`、`i64`、`f64`、`never` は証拠 record があっても primitive policy に従って拒否されます。
//: - `Named` / `Applied` は evidence table に record がある場合だけ、その record の `value_result` を返します。
//: - function value は cache identity / namespace / backend representation が未完成なので、fake evidence があっても拒否します。
//:
//: [計算量/けいさんりょう]:
//: - primitive / function / parameter / missing は O(1) です。`Named` / `Applied` は evidence record 数を n として O(n) です。
pub fn selfhost_memo_value_type_result_with_evidence %fn &SelfhostTypeArena fn &SelfhostMemoTraitEvidenceTable fn SelfhostTypeId Result unit SelfhostMemoTraitRejectKind \arena\evidence\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    selfhost_memo_value_primitive_result kind
                SelfhostTypeRecord::Named _named:
                    match selfhost_memo_trait_evidence_table_find evidence type_id:
                        Option::Some evidence_record:
                            evidence_record.value_result
                        Option::None:
                            Result::Err SelfhostMemoTraitRejectKind::NamedLayoutUnknown
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Err SelfhostMemoTraitRejectKind::ParameterUnresolved
                SelfhostTypeRecord::Applied _applied:
                    match selfhost_memo_trait_evidence_table_find evidence type_id:
                        Option::Some evidence_record:
                            evidence_record.value_result
                        Option::None:
                            Result::Err SelfhostMemoTraitRejectKind::AppliedLayoutUnknown
                SelfhostTypeRecord::Function _function:
                    Result::Err SelfhostMemoTraitRejectKind::FunctionUnsupported
        Option::None:
            Result::Err SelfhostMemoTraitRejectKind::MissingTypeRecord

//: selfhost_memo_key_type_is_allowed: `MemoKey` predicate を bool へ落とす adapter
//:
//: [目的/もくてき]:
//: - 既存の call gate が bool predicate を要求する場所で使います。失敗理由が必要な診断経路では `selfhost_memo_key_type_result` を直接使ってください。
pub fn selfhost_memo_key_type_is_allowed %fn &SelfhostTypeArena fn SelfhostTypeId bool \arena\type_id:
    selfhost_memo_trait_result_is_accept selfhost_memo_key_type_result arena type_id

//: selfhost_memo_value_type_is_allowed: `MemoValue` predicate を bool へ落とす adapter
//:
//: [目的/もくてき]:
//: - 既存の call gate が bool predicate を要求する場所で使います。失敗理由が必要な診断経路では `selfhost_memo_value_type_result` を直接使ってください。
pub fn selfhost_memo_value_type_is_allowed %fn &SelfhostTypeArena fn SelfhostTypeId bool \arena\type_id:
    selfhost_memo_trait_result_is_accept selfhost_memo_value_type_result arena type_id

//: selfhost_memo_trait_stage0_summary_new: stage0 doctest 用 summary を[作/つく]る
fn selfhost_memo_trait_stage0_summary_new %fn Result unit SelfhostMemoTraitRejectKind fn Result unit SelfhostMemoTraitRejectKind fn Result unit SelfhostMemoTraitRejectKind fn Result unit SelfhostMemoTraitRejectKind fn Result unit SelfhostMemoTraitRejectKind SelfhostMemoTraitStage0Summary \unit_key\i32_key\f32_key\f32_value\function_value:
    SelfhostMemoTraitStage0Summary unit_key i32_key f32_key f32_value function_value

//: selfhost_memo_trait_stage0_finish: doctest 用 TypeArena を解放して summary を[返/かえ]す
//:
//: [目的/もくてき]:
//: - smoke test で作った arena owner を漏らさず、predicate 結果だけを戻します。
fn selfhost_memo_trait_stage0_finish %impure fn SelfhostTypeArena impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind Result SelfhostMemoTraitStage0Summary StdErrorKind \arena\unit_key\i32_key\f32_key\f32_value\function_value:
    selfhost_type_arena_free arena
    Result::Ok selfhost_memo_trait_stage0_summary_new unit_key i32_key f32_key f32_value function_value

//: selfhost_memo_trait_stage0: `MemoKey` / `MemoValue` predicate の代表 smoke
//:
//: [目的/もくてき]:
//: - doctest から小さく呼べるよう、unit/i32/f32/function の代表型を arena に登録し、Phase 1 の受理・拒否境界をまとめて返します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(summary)`: arena 構築に成功し、summary の各 field に predicate 結果が入っています。
//: - `Err(error)`: arena / Vec の確保に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の型だけを追加するため O(1) です。
pub fn selfhost_memo_trait_stage0 %impure fn void Result SelfhostMemoTraitStage0Summary StdErrorKind \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_primitive arena0 SelfhostPrimitiveTypeKind::Unit:
                Result::Ok allocated_unit:
                    let unit_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_unit
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_unit
                    match selfhost_type_arena_add_primitive arena1 SelfhostPrimitiveTypeKind::I32:
                        Result::Ok allocated_i32:
                            let i32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_i32
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_i32
                            match selfhost_type_arena_add_primitive arena2 SelfhostPrimitiveTypeKind::F32:
                                Result::Ok allocated_f32:
                                    let f32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_f32
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_f32
                                    let params0 %Result Vec SelfhostTypeId StdErrorKind v::new
                                    match params0:
                                        Result::Ok params_empty:
                                            match selfhost_type_arena_add_function arena3 params_empty i32_id:
                                                Result::Ok allocated_function:
                                                    let function_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_function
                                                    let arena4 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_function
                                                    let unit_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 unit_id
                                                    let i32_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 i32_id
                                                    let f32_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 f32_id
                                                    let f32_value %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result &arena4 f32_id
                                                    let function_value %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result &arena4 function_id
                                                    selfhost_memo_trait_stage0_finish arena4 unit_key i32_key f32_key f32_value function_value
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            selfhost_type_arena_free arena3
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: SelfhostMemoTraitEvidenceNamedStage0Summary: named / primitive / missing override smoke の局所 summary
//:
//: [目的/もくてき]:
//: - `Named` aggregate evidence と、aggregate ではない primitive / missing record の override 不可を、Applied smoke から分けて小さく検査します。
//: - 公開 `SelfhostMemoTraitEvidenceStage0Summary` へ合成する前の中間 payload であり、外部 API ではありません。
struct SelfhostMemoTraitEvidenceNamedStage0Summary:
    named_without_evidence %Result unit SelfhostMemoTraitRejectKind
    named_key_with_evidence %Result unit SelfhostMemoTraitRejectKind
    named_value_with_evidence %Result unit SelfhostMemoTraitRejectKind
    named_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind
    f32_key_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind
    missing_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind

//: SelfhostMemoTraitEvidenceAppliedStage0Summary: applied aggregate evidence smoke の局所 summary
//:
//: [目的/もくてき]:
//: - `Applied` aggregate evidence の no-evidence / accepted evidence / rejected evidence を、Named smoke と別関数で検査します。
//: - stage0 の式木を小さく保ち、self-host compiler の prefix call 探索範囲を無駄に増やさないための分割です。
struct SelfhostMemoTraitEvidenceAppliedStage0Summary:
    applied_without_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_key_with_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_value_with_evidence %Result unit SelfhostMemoTraitRejectKind
    applied_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind

//: selfhost_memo_trait_evidence_stage0_add_single_applied: stage0 用 applied type を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - evidence consumer smoke が `Applied` record を実際の `SelfhostTypeArena` 上に作れるよう、1 個の型引数を持つ applied named type の構築だけを局所化します。
//:
//: [契約/けいやく]:
//: - この helper は doctest 用であり、aggregate solver ではありません。型引数の structural proof は作らず、arena record variant を `Applied` にするためだけに使います。
//: - 失敗時は入力 arena または途中で確保した型引数 vector を解放します。
fn selfhost_memo_trait_evidence_stage0_add_single_applied %impure fn SelfhostTypeArena impure fn SelfhostNamedTypeId impure fn SelfhostTypeId Result SelfhostTypeArenaAlloc StdErrorKind \arena\nominal_id\arg:
    let params_result %Result Vec SelfhostTypeId StdErrorKind v::new
    match params_result:
        Result::Ok params0:
            match v::push params0 arg:
                Result::Ok params1:
                    selfhost_type_arena_add_applied_named arena nominal_id params1
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    selfhost_type_arena_free arena
                    Result::Err error
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_memo_trait_evidence_named_stage0_finish: named smoke の owner を[解放/かいほう]して summary を[返/かえ]す
//:
//: [目的/もくてき]:
//: - Named smoke 用に作った TypeArena と evidence table を両方閉じ、Copy な Result payload だけを返します。
fn selfhost_memo_trait_evidence_named_stage0_finish %impure fn SelfhostTypeArena impure fn SelfhostMemoTraitEvidenceTable impure fn SelfhostMemoTraitEvidenceNamedStage0Summary Result SelfhostMemoTraitEvidenceNamedStage0Summary StdErrorKind \arena\table\summary:
    selfhost_memo_trait_evidence_table_free table
    selfhost_type_arena_free arena
    Result::Ok summary

//: selfhost_memo_trait_evidence_applied_stage0_finish: applied smoke の owner を[解放/かいほう]して summary を[返/かえ]す
//:
//: [目的/もくてき]:
//: - Applied smoke 用に作った TypeArena と evidence table を両方閉じ、Copy な Result payload だけを返します。
fn selfhost_memo_trait_evidence_applied_stage0_finish %impure fn SelfhostTypeArena impure fn SelfhostMemoTraitEvidenceTable impure fn SelfhostMemoTraitEvidenceAppliedStage0Summary Result SelfhostMemoTraitEvidenceAppliedStage0Summary StdErrorKind \arena\table\summary:
    selfhost_memo_trait_evidence_table_free table
    selfhost_type_arena_free arena
    Result::Ok summary

//: selfhost_memo_trait_evidence_named_stage0: named evidence と non-aggregate override 不可を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `Named` は証拠なしでは `NamedLayoutUnknown` で拒否され、証拠があるときだけ record の Result payload を返すことを確認します。
//: - `f32` key と missing record は fake evidence があっても受理されないことを、同じ smoke で確認します。
fn selfhost_memo_trait_evidence_named_stage0 %impure fn void Result SelfhostMemoTraitEvidenceNamedStage0Summary StdErrorKind \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_named arena0 selfhost_named_type_id_new 0:
                Result::Ok allocated_named_ok:
                    let named_ok_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_named_ok
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_named_ok
                    match selfhost_type_arena_add_named arena1 selfhost_named_type_id_new 1:
                        Result::Ok allocated_named_reject:
                            let named_reject_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_named_reject
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_named_reject
                            match selfhost_type_arena_add_primitive arena2 SelfhostPrimitiveTypeKind::F32:
                                Result::Ok allocated_f32:
                                    let f32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_f32
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_f32
                                    match selfhost_memo_trait_evidence_table_new:
                                        Result::Ok table0:
                                            let named_without_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table0 named_ok_id
                                            let ok_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new named_ok_id (Result::Ok unit) (Result::Ok unit)
                                            match selfhost_memo_trait_evidence_table_push table0 ok_record:
                                                Result::Ok table1:
                                                    let reject_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new named_reject_id (Result::Err SelfhostMemoTraitRejectKind::StrUnsupported) (Result::Err SelfhostMemoTraitRejectKind::StrUnsupported)
                                                    match selfhost_memo_trait_evidence_table_push table1 reject_record:
                                                        Result::Ok table2:
                                                            let fake_f32_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new f32_id (Result::Ok unit) (Result::Ok unit)
                                                            match selfhost_memo_trait_evidence_table_push table2 fake_f32_record:
                                                                Result::Ok table3:
                                                                    let missing_id %SelfhostTypeId selfhost_type_id_new 9999
                                                                    let fake_missing_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new missing_id (Result::Ok unit) (Result::Ok unit)
                                                                    match selfhost_memo_trait_evidence_table_push table3 fake_missing_record:
                                                                        Result::Ok table4:
                                                                            let named_key_with_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table4 named_ok_id
                                                                            let named_value_with_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result_with_evidence &arena3 &table4 named_ok_id
                                                                            let named_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table4 named_reject_id
                                                                            let f32_key_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table4 f32_id
                                                                            let missing_with_fake_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table4 missing_id
                                                                            let summary %SelfhostMemoTraitEvidenceNamedStage0Summary SelfhostMemoTraitEvidenceNamedStage0Summary named_without_evidence named_key_with_evidence named_value_with_evidence named_key_rejected_by_evidence f32_key_with_fake_evidence missing_with_fake_evidence
                                                                            selfhost_memo_trait_evidence_named_stage0_finish arena3 table4 summary
                                                                        Result::Err e:
                                                                            selfhost_type_arena_free arena3
                                                                            Result::Err e
                                                                Result::Err e:
                                                                    selfhost_type_arena_free arena3
                                                                    Result::Err e
                                                        Result::Err e:
                                                            selfhost_type_arena_free arena3
                                                            Result::Err e
                                                Result::Err e:
                                                    selfhost_type_arena_free arena3
                                                    Result::Err e
                                        Result::Err e:
                                            selfhost_type_arena_free arena3
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_evidence_applied_stage0: applied evidence consumer を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `Applied` は証拠なしでは `AppliedLayoutUnknown` で拒否され、証拠があるときだけ record の Result payload を返すことを確認します。
//: - 型引数には `f32` を使いますが、この smoke は field proof を作りません。`Applied` record variant だけを作り、solver 由来 evidence の消費境界を固定します。
fn selfhost_memo_trait_evidence_applied_stage0 %impure fn void Result SelfhostMemoTraitEvidenceAppliedStage0Summary StdErrorKind \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_primitive arena0 SelfhostPrimitiveTypeKind::F32:
                Result::Ok allocated_f32:
                    let f32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_f32
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_f32
                    match selfhost_memo_trait_evidence_stage0_add_single_applied arena1 (selfhost_named_type_id_new 2) f32_id:
                        Result::Ok allocated_applied_ok:
                            let applied_ok_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_applied_ok
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_applied_ok
                            match selfhost_memo_trait_evidence_stage0_add_single_applied arena2 (selfhost_named_type_id_new 3) f32_id:
                                Result::Ok allocated_applied_reject:
                                    let applied_reject_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_applied_reject
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_applied_reject
                                    match selfhost_memo_trait_evidence_table_new:
                                        Result::Ok table0:
                                            let applied_without_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table0 applied_ok_id
                                            let applied_ok_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new applied_ok_id (Result::Ok unit) (Result::Ok unit)
                                            match selfhost_memo_trait_evidence_table_push table0 applied_ok_record:
                                                Result::Ok table1:
                                                    let applied_reject_record %SelfhostMemoTraitEvidenceRecord selfhost_memo_trait_evidence_record_new applied_reject_id (Result::Err SelfhostMemoTraitRejectKind::StrUnsupported) (Result::Err SelfhostMemoTraitRejectKind::StrUnsupported)
                                                    match selfhost_memo_trait_evidence_table_push table1 applied_reject_record:
                                                        Result::Ok table2:
                                                            let applied_key_with_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table2 applied_ok_id
                                                            let applied_value_with_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result_with_evidence &arena3 &table2 applied_ok_id
                                                            let applied_key_rejected_by_evidence %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result_with_evidence &arena3 &table2 applied_reject_id
                                                            let summary %SelfhostMemoTraitEvidenceAppliedStage0Summary SelfhostMemoTraitEvidenceAppliedStage0Summary applied_without_evidence applied_key_with_evidence applied_value_with_evidence applied_key_rejected_by_evidence
                                                            selfhost_memo_trait_evidence_applied_stage0_finish arena3 table2 summary
                                                        Result::Err e:
                                                            selfhost_type_arena_free arena3
                                                            Result::Err e
                                                Result::Err e:
                                                    selfhost_type_arena_free arena3
                                                    Result::Err e
                                        Result::Err e:
                                            selfhost_type_arena_free arena3
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_evidence_stage0: aggregate evidence table 付き predicate の代表 smoke
//:
//: [目的/もくてき]:
//: - `Named` type は証拠なしでは `NamedLayoutUnknown` で拒否され、同じ TypeId に solver 由来の record がある場合だけ、その Result payload を返すことを確認します。
//: - `Applied` type についても同じ no-evidence / accepted evidence / rejected evidence の境界を確認し、source regex だけに依存しない runtime smoke にします。
//: - primitive や missing record に fake evidence が入っても arena record variant の判定を上書きできないことを確認します。
//: - この smoke は aggregate structural proof を作りません。後続 solver が作る証拠を memo gate がどのように消費するかだけを固定します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(summary)`: arena と evidence table の構築に成功し、summary に代表 predicate result が入っています。
//: - `Err(error)`: arena / evidence table の確保に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の record だけを扱うため O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: ##: [9] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_evidence_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.named_without_evidence) SelfhostMemoTraitRejectKind::NamedLayoutUnknown
//:             let checks2 checks_push checks1 check selfhost_memo_trait_result_is_accept summary.named_key_with_evidence
//:             let checks3 checks_push checks2 check selfhost_memo_trait_result_is_accept summary.named_value_with_evidence
//:             let checks4 checks_push checks3 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.named_key_rejected_by_evidence) SelfhostMemoTraitRejectKind::StrUnsupported
//:             let checks5 checks_push checks4 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.applied_without_evidence) SelfhostMemoTraitRejectKind::AppliedLayoutUnknown
//:             let checks6 checks_push checks5 check selfhost_memo_trait_result_is_accept summary.applied_key_with_evidence
//:             let checks7 checks_push checks6 check selfhost_memo_trait_result_is_accept summary.applied_value_with_evidence
//:             let checks8 checks_push checks7 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.applied_key_rejected_by_evidence) SelfhostMemoTraitRejectKind::StrUnsupported
//:             let checks9 checks_push checks8 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.f32_key_with_fake_evidence) SelfhostMemoTraitRejectKind::F32KeyUnsupported
//:             let checks10 checks_push checks9 check selfhost_memo_trait_reject_kind_eq (unwrap_err summary.missing_with_fake_evidence) SelfhostMemoTraitRejectKind::MissingTypeRecord
//:             let shown checks_print_report checks10
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait evidence stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
pub fn selfhost_memo_trait_evidence_stage0 %impure fn void Result SelfhostMemoTraitEvidenceStage0Summary StdErrorKind \void:
    match selfhost_memo_trait_evidence_named_stage0:
        Result::Ok named:
            match selfhost_memo_trait_evidence_applied_stage0:
                Result::Ok applied:
                    Result::Ok SelfhostMemoTraitEvidenceStage0Summary named.named_without_evidence named.named_key_with_evidence named.named_value_with_evidence named.named_key_rejected_by_evidence applied.applied_without_evidence applied.applied_key_with_evidence applied.applied_value_with_evidence applied.applied_key_rejected_by_evidence named.f32_key_with_fake_evidence named.missing_with_fake_evidence
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e
