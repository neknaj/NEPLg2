fn selfhost_memo_trait_stage0_finish %impure fn SelfhostTypeArena impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind impure fn Result unit SelfhostMemoTraitRejectKind Result SelfhostMemoTraitStage0Summary StdErrorKind \arena\unit_key\i32_key\f32_key\f32_value\function_value:
