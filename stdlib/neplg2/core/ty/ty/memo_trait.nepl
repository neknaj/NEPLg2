//: selfhost_memo_trait_stage0: `MemoKey` / `MemoValue` predicate の代表 smoke
//:
//: [目的/もくてき]:
//: - doctest から小さく呼べるよう、unit/i32/f32/function の代表型を arena に登録し、Phase 1 の受理・拒否境界をまとめて返します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(summary)`: arena 構築に成功し、summary の各 field に predicate 結果が入っています。
//: - `Err(error)`: arena / Vec の確保に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の型だけを追加するため O(1) です。
pub fn selfhost_memo_trait_stage0 %impure fn void Result SelfhostMemoTraitStage0Summary StdErrorKind \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_primitive arena0 SelfhostPrimitiveTypeKind::Unit:
                Result::Ok allocated_unit:
                    let unit_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_unit
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_unit
                    match selfhost_type_arena_add_primitive arena1 SelfhostPrimitiveTypeKind::I32:
                        Result::Ok allocated_i32:
                            let i32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_i32
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_i32
                            match selfhost_type_arena_add_primitive arena2 SelfhostPrimitiveTypeKind::F32:
                                Result::Ok allocated_f32:
                                    let f32_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_f32
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_f32
                                    let params0 %Result Vec SelfhostTypeId StdErrorKind v::new
                                    match params0:
                                        Result::Ok params_empty:
                                            match selfhost_type_arena_add_function arena3 params_empty i32_id:
                                                Result::Ok allocated_function:
                                                    let function_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_function
                                                    let arena4 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_function
                                                    let unit_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 unit_id
                                                    let i32_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 i32_id
                                                    let f32_key %Result unit SelfhostMemoTraitRejectKind selfhost_memo_key_type_result &arena4 f32_id
                                                    let f32_value %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result &arena4 f32_id
                                                    let function_value %Result unit SelfhostMemoTraitRejectKind selfhost_memo_value_type_result &arena4 function_id
                                                    selfhost_memo_trait_stage0_finish arena4 unit_key i32_key f32_key f32_value function_value
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            selfhost_type_arena_free arena3
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e
