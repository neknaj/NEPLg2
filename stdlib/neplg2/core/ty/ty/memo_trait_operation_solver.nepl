#indent 4

//: # ty/memo_trait_operation_solver
//: `MemoKey` / `MemoValue` aggregate proof に渡す Copy / Drop / Eq / Hash proof status を、型構造と layout evidence から[計算/けいさん]する入口です。
//:
//: [目的/もくてき]:
//: - `memo_trait_operation_proof.nepl` は operation proof status table の運搬と producer gate への合流だけを担当します。この module は、その table に入れる record を型構造から作ります。
//: - Phase 1 では、recursive aggregate gate で cycle / depth / unsupported field を先に拒否したうえで、layout validator が受理した product field closure を読み、primitive field と nested aggregate field の operation proof status を root aggregate の status へ fold します。
//: - function、parameter、または未対応 primitive である場合は、推測で `Proven` にせず `Unknown` status を fold し、producer gate の typed rejection へ進めます。
//:
//: [契約/けいやく]:
//: - source text、span、path、display name、diagnostic text、lexeme は proof authority にしません。入力は `SelfhostTypeArena`、`SelfhostMemoTraitLayoutEvidenceTable`、`SelfhostTypeId` だけです。
//: - table construction は必ず `selfhost_memo_trait_recursive_aggregate_result` で root aggregate closure を検査してから operation table を作ります。cycle / depth / unsupported field を operation status の `Unknown` へ曖昧に潰しません。
//: - layout は必ず `selfhost_memo_trait_layout_evidence_for_type_result` で検証済みの `Known(range)` だけを使います。field range の counter を source position や unchecked index として使いません。
//: - primitive `unit` / `bool` / `i32` / `u8` / `char` は Copy / Drop / Eq / Hash を `Proven` とします。
//: - `f32` は value としては primitive predicate で受理され得ますが、key hash / equality の仕様が未固定なので Eq / Hash を `Unknown` として fold します。
//: - nested aggregate field は同じ layout evidence から子 aggregate record を再帰計算して親へ merge します。ただし cycle、depth limit、unsupported field の拒否は public table construction が先に通す recursive aggregate gate の責務です。
//: - trait impl table、method body purity、Drop なし proof、public mutable state / owner token hazard は後続 slice の責務です。この module はそれらを `Unknown` に畳み、accepted proof へ進めません。
//: - proof store、`.neplproof` artifact、canonical key codec、HIR、Resource IR、backend へ依存しません。
//:
//: [現状/げんじょう]:
//: - primitive field と nested aggregate field を持つ product aggregate の operation proof を計算します。
//: - recursive aggregate gate が成功した nested aggregate closure だけを fold します。trait impl table と method body purity は未接続なので、operation status の authority は primitive policy と layout evidence に限定されます。
//:
//: [計算量/けいさんりょう]:
//: - layout lookup と validation は `memo_trait_layout.nepl` の計算量に従います。
//: - recursive field fold は、branch ごとの再計算を含めて実際に展開した field edge 数 e に対して O(e) です。同じ child aggregate が複数 branch から現れる場合は branch ごとに再計算します。
//: - table construction は record 1 件だけを push するため O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_layout" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_proof" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_solver" as *
//:| #import "neplg2/core/ty/ty/memo_trait_recursive_aggregate" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_operation_solver_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_solver_record_is_all_proven_result summary.empty_record
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_solver_record_is_all_proven_result summary.i32_field_record
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_solver_record_has_hash_unknown_result summary.f32_field_record
//:             let missing_layout_error SelfhostMemoTraitOperationSolverErrorKind::LayoutRejected SelfhostMemoTraitLayoutEvidenceErrorKind::MissingLayout
//:             let actual_missing_layout %SelfhostMemoTraitOperationSolverErrorKind unwrap_err summary.missing_layout_rejected
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_solver_error_kind_eq actual_missing_layout missing_layout_error
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_proof_result_is_accept summary.i32_table_lookup
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_solver_record_is_all_proven_result summary.nested_i32_record
//:             let checks7 checks_push checks6 check selfhost_memo_trait_operation_solver_record_has_hash_unknown_result summary.nested_f32_record
//:             let nested_missing_layout_error SelfhostMemoTraitOperationSolverErrorKind::RecursiveRejected SelfhostMemoTraitRecursiveAggregateErrorKind::LayoutRejected SelfhostMemoTraitLayoutEvidenceErrorKind::MissingLayout
//:             let actual_nested_missing_layout %SelfhostMemoTraitOperationSolverErrorKind unwrap_err summary.nested_missing_layout_rejected
//:             let checks8 checks_push checks7 check selfhost_memo_trait_operation_solver_error_kind_eq actual_nested_missing_layout nested_missing_layout_error
//:             let cycle_error SelfhostMemoTraitOperationSolverErrorKind::RecursiveRejected SelfhostMemoTraitRecursiveAggregateErrorKind::CycleDetected
//:             let actual_cycle %SelfhostMemoTraitOperationSolverErrorKind unwrap_err summary.recursive_cycle_rejected
//:             let checks9 checks_push checks8 check selfhost_memo_trait_operation_solver_error_kind_eq actual_cycle cycle_error
//:             let shown checks_print_report checks9
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait operation solver stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./arena" as *
#import "./id" as *
#import "./kind/model" as *
#import "./memo_trait_layout" as *
#import "./memo_trait_operation_proof" as *
#import "./memo_trait_producer" as *
#import "./memo_trait_recursive_aggregate" as *
#import "./record" as *

//: SelfhostMemoTraitOperationSolverErrorKind: operation proof solver の失敗分類
//:
//: [目的/もくてき]:
//: - layout validation、field range read、operation proof table owner のどこで失敗したかを enum payload として保持します。
pub enum SelfhostMemoTraitOperationSolverErrorKind:
    RecursiveRejected %SelfhostMemoTraitRecursiveAggregateErrorKind
    LayoutRejected %SelfhostMemoTraitLayoutEvidenceErrorKind
    FieldReadRejected %SelfhostMemoTraitLayoutEvidenceErrorKind
    TableAllocFailed %StdErrorKind
    TablePushRejected %SelfhostMemoTraitOperationProofErrorKind

//: SelfhostMemoTraitOperationSolverStage0Summary: structural operation solver の代表 smoke
//:
//: [目的/もくてき]:
//: - empty aggregate、primitive field aggregate、nested aggregate、layout 欠落、solver table lookup を public API 経由で確認します。
pub struct SelfhostMemoTraitOperationSolverStage0Summary:
    empty_record %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    i32_field_record %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    f32_field_record %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    missing_layout_rejected %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    i32_table_lookup %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationProofErrorKind
    nested_i32_record %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    nested_f32_record %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind
    nested_missing_layout_rejected %Result unit SelfhostMemoTraitOperationSolverErrorKind
    recursive_cycle_rejected %Result unit SelfhostMemoTraitOperationSolverErrorKind

impl Clone for SelfhostMemoTraitOperationSolverErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationSolverErrorKind SelfhostMemoTraitOperationSolverErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationSolverErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationSolverErrorKind SelfhostMemoTraitOperationSolverErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationSolverStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationSolverStage0Summary SelfhostMemoTraitOperationSolverStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationSolverStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationSolverStage0Summary SelfhostMemoTraitOperationSolverStage0Summary \self:
        self

//: selfhost_memo_trait_operation_solver_stage0_summary_new: stage0 summary を[作/つく]る
fn selfhost_memo_trait_operation_solver_stage0_summary_new %fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationProofErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind fn Result unit SelfhostMemoTraitOperationSolverErrorKind fn Result unit SelfhostMemoTraitOperationSolverErrorKind SelfhostMemoTraitOperationSolverStage0Summary \empty_record\i32_field_record\f32_field_record\missing_layout_rejected\i32_table_lookup\nested_i32_record\nested_f32_record\nested_missing_layout_rejected\recursive_cycle_rejected:
    SelfhostMemoTraitOperationSolverStage0Summary empty_record i32_field_record f32_field_record missing_layout_rejected i32_table_lookup nested_i32_record nested_f32_record nested_missing_layout_rejected recursive_cycle_rejected

//: selfhost_memo_trait_operation_solver_status_code: proof status を merge 用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - private helper です。status は public API では enum のまま保持し、数値 code を外へ出しません。
fn selfhost_memo_trait_operation_solver_status_code %fn SelfhostMemoTraitAggregateProofStatus i32 \status:
    match status:
        SelfhostMemoTraitAggregateProofStatus::Proven:
            0
        SelfhostMemoTraitAggregateProofStatus::Missing:
            1
        SelfhostMemoTraitAggregateProofStatus::Unknown:
            2
        SelfhostMemoTraitAggregateProofStatus::Impure:
            3

//: selfhost_memo_trait_operation_solver_status_from_code: merge 用 code を proof status へ[戻/もど]す
fn selfhost_memo_trait_operation_solver_status_from_code %fn i32 SelfhostMemoTraitAggregateProofStatus \code:
    if:
        ge code 3
        then:
            SelfhostMemoTraitAggregateProofStatus::Impure
        else:
            if:
                eq code 2
                then:
                    SelfhostMemoTraitAggregateProofStatus::Unknown
                else:
                    if:
                        eq code 1
                        then:
                            SelfhostMemoTraitAggregateProofStatus::Missing
                        else:
                            SelfhostMemoTraitAggregateProofStatus::Proven

//: selfhost_memo_trait_operation_solver_status_merge: field status を aggregate status へ[畳/たた]む
//:
//: [契約/けいやく]:
//: - どちらかが `Impure` なら `Impure`、次に `Unknown`、次に `Missing` を優先します。`Proven` だけを成功として扱います。
fn selfhost_memo_trait_operation_solver_status_merge %fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitAggregateProofStatus \a\b:
    let a_code %i32 selfhost_memo_trait_operation_solver_status_code a
    let b_code %i32 selfhost_memo_trait_operation_solver_status_code b
    let merged_code %i32 if gt a_code b_code a_code b_code
    selfhost_memo_trait_operation_solver_status_from_code merged_code

//: selfhost_memo_trait_operation_solver_status_eq: proof status が同じか[返/かえ]す
pub fn selfhost_memo_trait_operation_solver_status_eq %fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus bool \a\b:
    eq selfhost_memo_trait_operation_solver_status_code a selfhost_memo_trait_operation_solver_status_code b

//: selfhost_memo_trait_operation_solver_record_unknown: 4 operation を Unknown にした record を[作/つく]る
fn selfhost_memo_trait_operation_solver_record_unknown %fn SelfhostTypeId SelfhostMemoTraitOperationProofRecord \type_id:
    selfhost_memo_trait_operation_proof_record_new type_id SelfhostMemoTraitAggregateProofStatus::Unknown SelfhostMemoTraitAggregateProofStatus::Unknown SelfhostMemoTraitAggregateProofStatus::Unknown SelfhostMemoTraitAggregateProofStatus::Unknown

//: selfhost_memo_trait_operation_solver_record_f32_value_only: f32 field 用の保守的 status record を[作/つく]る
//:
//: [契約/けいやく]:
//: - `f32` は Copy / Drop は local value として扱えますが、memo key の Eq / Hash 仕様が未固定なので Eq / Hash は `Unknown` にします。
fn selfhost_memo_trait_operation_solver_record_f32_value_only %fn SelfhostTypeId SelfhostMemoTraitOperationProofRecord \type_id:
    selfhost_memo_trait_operation_proof_record_new type_id SelfhostMemoTraitAggregateProofStatus::Proven SelfhostMemoTraitAggregateProofStatus::Proven SelfhostMemoTraitAggregateProofStatus::Unknown SelfhostMemoTraitAggregateProofStatus::Unknown

//: selfhost_memo_trait_operation_solver_primitive_record: primitive type の operation status を[作/つく]る
fn selfhost_memo_trait_operation_solver_primitive_record %fn SelfhostTypeId fn SelfhostPrimitiveTypeKind SelfhostMemoTraitOperationProofRecord \type_id\kind:
    match kind:
        SelfhostPrimitiveTypeKind::Unit:
            selfhost_memo_trait_operation_proof_record_all_proven type_id
        SelfhostPrimitiveTypeKind::Bool:
            selfhost_memo_trait_operation_proof_record_all_proven type_id
        SelfhostPrimitiveTypeKind::I32:
            selfhost_memo_trait_operation_proof_record_all_proven type_id
        SelfhostPrimitiveTypeKind::U8:
            selfhost_memo_trait_operation_proof_record_all_proven type_id
        SelfhostPrimitiveTypeKind::Char:
            selfhost_memo_trait_operation_proof_record_all_proven type_id
        SelfhostPrimitiveTypeKind::F32:
            selfhost_memo_trait_operation_solver_record_f32_value_only type_id
        SelfhostPrimitiveTypeKind::Error:
            selfhost_memo_trait_operation_solver_record_unknown type_id
        SelfhostPrimitiveTypeKind::I64:
            selfhost_memo_trait_operation_solver_record_unknown type_id
        SelfhostPrimitiveTypeKind::Str:
            selfhost_memo_trait_operation_solver_record_unknown type_id
        SelfhostPrimitiveTypeKind::F64:
            selfhost_memo_trait_operation_solver_record_unknown type_id
        SelfhostPrimitiveTypeKind::Never:
            selfhost_memo_trait_operation_solver_record_unknown type_id

//: selfhost_memo_trait_operation_solver_field_record_result: field type の operation status を[作/つく]る
//:
//: [契約/けいやく]:
//: - primitive は local primitive policy で record 化します。
//: - named / applied aggregate は同じ layout evidence table から子 aggregate record を再帰計算します。
//: - parameter、function、missing type はこの slice では `Unknown` です。推測で `Proven` にしません。
fn selfhost_memo_trait_operation_solver_field_record_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitLayoutEvidenceTable fn SelfhostTypeId Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind \types\layout_table\field_type:
    match selfhost_type_arena_get_record types field_type:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    Result::Ok selfhost_memo_trait_operation_solver_primitive_record field_type kind
                SelfhostTypeRecord::Named _named:
                    selfhost_memo_trait_operation_solver_record_result types layout_table field_type
                SelfhostTypeRecord::Applied _applied:
                    selfhost_memo_trait_operation_solver_record_result types layout_table field_type
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Ok selfhost_memo_trait_operation_solver_record_unknown field_type
                SelfhostTypeRecord::Function _function:
                    Result::Ok selfhost_memo_trait_operation_solver_record_unknown field_type
        Option::None:
            Result::Ok selfhost_memo_trait_operation_solver_record_unknown field_type

//: selfhost_memo_trait_operation_solver_record_merge: field record を aggregate record へ[畳/たた]む
fn selfhost_memo_trait_operation_solver_record_merge %fn SelfhostMemoTraitOperationProofRecord fn SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationProofRecord \aggregate\field_record:
    let copy_proof %SelfhostMemoTraitAggregateProofStatus selfhost_memo_trait_operation_solver_status_merge aggregate.copy_proof field_record.copy_proof
    let drop_proof %SelfhostMemoTraitAggregateProofStatus selfhost_memo_trait_operation_solver_status_merge aggregate.drop_proof field_record.drop_proof
    let eq_proof %SelfhostMemoTraitAggregateProofStatus selfhost_memo_trait_operation_solver_status_merge aggregate.eq_proof field_record.eq_proof
    let hash_proof %SelfhostMemoTraitAggregateProofStatus selfhost_memo_trait_operation_solver_status_merge aggregate.hash_proof field_record.hash_proof
    selfhost_memo_trait_operation_proof_record_new aggregate.type_id copy_proof drop_proof eq_proof hash_proof

//: selfhost_memo_trait_operation_solver_fold_fields_result: layout field range を operation status へ[畳/たた]む
fn selfhost_memo_trait_operation_solver_fold_fields_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitLayoutEvidenceTable fn SelfhostMemoTraitAggregateFieldRange fn i32 fn SelfhostMemoTraitOperationProofRecord Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind \types\layout_table\range\idx\aggregate:
    if:
        ge idx range.field_count
        then:
            Result::Ok aggregate
        else:
            match selfhost_memo_trait_layout_field_type_at_result layout_table range idx:
                Result::Ok field_type:
                    match selfhost_memo_trait_operation_solver_field_record_result types layout_table field_type:
                        Result::Ok field_record:
                            let next_aggregate %SelfhostMemoTraitOperationProofRecord selfhost_memo_trait_operation_solver_record_merge aggregate field_record
                            selfhost_memo_trait_operation_solver_fold_fields_result types layout_table range add idx 1 next_aggregate
                        Result::Err field_error:
                            Result::Err field_error
                Result::Err field_error:
                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::FieldReadRejected field_error

//: selfhost_memo_trait_operation_solver_record_result: 型構造から operation proof record を[作/つく]る
//:
//: [契約/けいやく]:
//: - この関数は module 内部の lower helper です。公開入口は `selfhost_memo_trait_operation_solver_table_for_type_result` だけです。
//: - 公開入口は先に recursive aggregate gate を通すため、cycle / depth limit / unsupported field を operation proof record へ誤って畳みません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(record)`: layout validator が受理した field range を fold して operation proof status を作りました。
//: - `Err(LayoutRejected(kind))`: target が aggregate ではない、layout が無い、field range が壊れているなどの理由で layout validator が拒否しました。
fn selfhost_memo_trait_operation_solver_record_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitLayoutEvidenceTable fn SelfhostTypeId Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationSolverErrorKind \types\layout_table\type_id:
    match selfhost_memo_trait_layout_evidence_for_type_result layout_table types type_id:
        Result::Ok fields:
            match fields:
                SelfhostMemoTraitAggregateFieldEvidence::Known range:
                    let initial %SelfhostMemoTraitOperationProofRecord selfhost_memo_trait_operation_proof_record_all_proven type_id
                    selfhost_memo_trait_operation_solver_fold_fields_result types layout_table range 0 initial
                SelfhostMemoTraitAggregateFieldEvidence::MissingLayout:
                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::LayoutRejected SelfhostMemoTraitLayoutEvidenceErrorKind::MissingLayout
                SelfhostMemoTraitAggregateFieldEvidence::GenericArgumentUnsubstituted:
                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::LayoutRejected SelfhostMemoTraitLayoutEvidenceErrorKind::GenericArgumentUnsubstituted
                SelfhostMemoTraitAggregateFieldEvidence::CycleLimitReached:
                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::LayoutRejected SelfhostMemoTraitLayoutEvidenceErrorKind::CycleLimitReached
        Result::Err layout_error:
            Result::Err SelfhostMemoTraitOperationSolverErrorKind::LayoutRejected layout_error

//: selfhost_memo_trait_operation_solver_table_for_type_result: 型構造から operation proof table を[作/つく]る
//:
//: [契約/けいやく]:
//: - 成功時は対象 type 1 件分の record を持つ owner table を返します。
//: - `max_depth` は既存 recursive aggregate gate に渡す深さ上限です。cycle / depth / unsupported field は operation proof status に変換せず、`RecursiveRejected` として返します。
//: - 失敗時は作成済み table owner をこの関数内で閉じ、partial table を返しません。
pub fn selfhost_memo_trait_operation_solver_table_for_type_result %impure fn &SelfhostTypeArena impure fn &SelfhostMemoTraitLayoutEvidenceTable impure fn SelfhostTypeId impure fn i32 Result SelfhostMemoTraitOperationProofTable SelfhostMemoTraitOperationSolverErrorKind \types\layout_table\type_id\max_depth:
    match selfhost_memo_trait_recursive_aggregate_result types layout_table type_id max_depth:
        Result::Ok _summary:
            match selfhost_memo_trait_operation_proof_table_new:
                Result::Ok table:
                    match selfhost_memo_trait_operation_solver_record_result types layout_table type_id:
                        Result::Ok record:
                            match selfhost_memo_trait_operation_proof_table_push table record:
                                Result::Ok next_table:
                                    Result::Ok next_table
                                Result::Err push_error:
                                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::TablePushRejected push_error
                        Result::Err solve_error:
                            selfhost_memo_trait_operation_proof_table_free table
                            Result::Err solve_error
                Result::Err alloc_error:
                    Result::Err SelfhostMemoTraitOperationSolverErrorKind::TableAllocFailed alloc_error
        Result::Err recursive_error:
            Result::Err SelfhostMemoTraitOperationSolverErrorKind::RecursiveRejected recursive_error

//: selfhost_memo_trait_operation_solver_record_is_all_proven: record の 4 operation が Proven か[返/かえ]す
pub fn selfhost_memo_trait_operation_solver_record_is_all_proven %fn SelfhostMemoTraitOperationProofRecord bool \record:
    and:
        selfhost_memo_trait_operation_solver_status_eq record.copy_proof SelfhostMemoTraitAggregateProofStatus::Proven
        and:
            selfhost_memo_trait_operation_solver_status_eq record.drop_proof SelfhostMemoTraitAggregateProofStatus::Proven
            and:
                selfhost_memo_trait_operation_solver_status_eq record.eq_proof SelfhostMemoTraitAggregateProofStatus::Proven
                selfhost_memo_trait_operation_solver_status_eq record.hash_proof SelfhostMemoTraitAggregateProofStatus::Proven

//: selfhost_memo_trait_operation_solver_record_has_hash_unknown: record の Hash proof が Unknown か[返/かえ]す
pub fn selfhost_memo_trait_operation_solver_record_has_hash_unknown %fn SelfhostMemoTraitOperationProofRecord bool \record:
    selfhost_memo_trait_operation_solver_status_eq record.hash_proof SelfhostMemoTraitAggregateProofStatus::Unknown

