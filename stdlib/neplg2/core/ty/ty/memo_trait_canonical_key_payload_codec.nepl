#indent 4

//: # ty/memo_trait_canonical_key_payload_codec
//: `.neplproof` が保存する canonical key tree payload の byte codec です。
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が bytes から `SelfhostCanonicalTypeKeyArena` を再構築するための境界を提供します。
//: - serialized payload には、payload schema、node kind、primitive stable code、stable nominal key material、argument order だけを入れます。
//: - serialized payload には、`SelfhostCanonicalTypeKeyId`、`SelfhostNamedTypeId`、`SelfhostTypeId`、proof store record index、source text、span、path、display name、diagnostic text、lexeme を入れません。
//: - named / applied node は stable nominal key material を decode した後、caller が渡した `SelfhostMemoTraitStableNominalKeyTable` へ照合し、現在の session 内の `SelfhostNamedTypeId` へ再対応付けします。
//:
//: [契約/けいやく]:
//: - byte format は header、fixed-width node table、argument table の順です。node table と argument table は count で境界を決め、末尾 bytes は `TrailingBytes` として拒否します。
//: - decoded payload は必ず materialized canonical key arena と root key になります。record key 内の payload hash や bytes 内の hash 値を信用して受理する経路は持ちません。
//: - `Parameter` と `Function` は Phase 1 の `.neplproof` canonical key payload では受理しません。generic type argument identity と higher-order function identity が入るまで fail-closed にします。
//: - stable nominal key table に同じ stable nominal key が 2 件ある場合は `NominalKeyDuplicate` として拒否し、first wins にはしません。
//: - `selfhost_memo_trait_canonical_key_payload_decode_and_hash_result` は convenience API です。preseed の acceptance authority は引き続き materialized arena/root を `memo_trait_canonical_key_payload.nepl` の hash producer へ渡す側に置きます。
//:
//: [現状/げんじょう]:
//: - Phase 1 codec は 31-bit nonnegative little-endian words だけを受理します。負値や high bit を持つ word は永続形式の互換性を曖昧にしないため拒否します。
//: - writer 全体、persistent `.neplproof` record reader、proof store append preseed loop は後続 slice で接続します。この module は canonical key payload bytes の typed decode と hash 再計算境界だけを固定します。
//:
//: [計算量/けいさんりょう]:
//: - decode は node 数 n と argument 数 a に対して O(n + a) です。
//: - stable nominal key の逆引きは table record 数 m に対して各 named/applied node ごとに O(m) です。Phase 1 では正しさ境界を優先し、後続で stable map 化します。
//: - source-wide scan、path lookup、diagnostic formatting、file I/O は行いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_canonical_key_payload_codec" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_canonical_key_payload_codec_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_canonical_key_payload_codec_hash_result_is_ok summary.named_payload
//:             let checks2 checks_push checks1 check selfhost_memo_trait_canonical_key_payload_codec_hash_result_is_ok summary.applied_payload
//:             let checks3 checks_push checks2 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.schema_mismatch) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::PayloadSchemaMismatch
//:             let checks4 checks_push checks3 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.trailing_bytes) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::TrailingBytes
//:             let checks5 checks_push checks4 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.unknown_primitive) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnknownPrimitiveCode
//:             let checks6 checks_push checks5 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.unsupported_function) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::FunctionTypeUnsupported
//:             let checks7 checks_push checks6 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.arg_target_out_of_range) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::ArgTargetOutOfRange
//:             let checks8 checks_push checks7 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.invalid_argument_range) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::InvalidArgumentRange
//:             let checks9 checks_push checks8 check selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq (unwrap_err summary.nominal_missing) SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NominalKeyMissing
//:             let shown checks_print_report checks9
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "canonical key payload codec stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/cast" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./id" as *
#import "./key" as *
#import "./kind/model" as *
#import "./memo_trait_canonical_key" as *
#import "./memo_trait_canonical_key_payload" as *

//: SelfhostMemoTraitCanonicalKeyPayloadDecoded: decoded canonical key tree payload
//:
//: [目的/もくてき]:
//: - bytes から復元した canonical key arena と root key を 1 つの owner record として扱います。
//: - decoded payload は store-local id ではなく、現在の session 内で再構築された arena-local key id だけを保持します。
pub struct SelfhostMemoTraitCanonicalKeyPayloadDecoded:
    schema_version %i32
    arena %SelfhostCanonicalTypeKeyArena
    root %SelfhostCanonicalTypeKeyId

//: SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind: canonical key payload bytes decode の拒否理由
//:
//: [目的/もくてき]:
//: - bytes の破損、schema 不一致、範囲外参照、unsupported node、stable nominal key の照合失敗、hash 再計算失敗を enum で返します。
pub enum SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind:
    PayloadSchemaMismatch
    UnexpectedEnd
    TrailingBytes
    UnknownNodeTag
    UnknownPrimitiveCode
    NodeCountNegative
    ArgCountNegative
    NodeCountLimitExceeded
    ArgCountLimitExceeded
    RootOutOfRange
    ArgTargetOutOfRange
    InvalidArgumentRange
    TypeParameterUnsupported
    FunctionTypeUnsupported
    NominalKeyMissing
    NominalKeyDuplicate
    NominalKeyInvalid %SelfhostMemoTraitStableNominalKeyErrorKind
    WordHighBitUnsupported
    OutOfMemory
    PayloadHashInvalid %SelfhostMemoTraitCanonicalKeyPayloadErrorKind

//: SelfhostMemoTraitCanonicalKeyPayloadCodecHeader: decode 済み header
struct SelfhostMemoTraitCanonicalKeyPayloadCodecHeader:
    schema_version %i32
    node_count %i32
    arg_count %i32
    root_index %i32

//: SelfhostMemoTraitCanonicalKeyPayloadCodecProjection: stage0 decode projection
struct SelfhostMemoTraitCanonicalKeyPayloadCodecProjection:
    result %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind

//: SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary: codec の代表 smoke
pub struct SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary:
    named_payload %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    applied_payload %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    schema_mismatch %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    trailing_bytes %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    unknown_primitive %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    unsupported_function %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    arg_target_out_of_range %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    invalid_argument_range %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    nominal_missing %Result SelfhostMemoTraitCanonicalKeyPayloadHash SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind

impl Clone for SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind:
    fn clone %fn &SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind:
    fn copy_mark %fn SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \self:
        self

impl Clone for SelfhostMemoTraitCanonicalKeyPayloadCodecHeader:
    fn clone %fn &SelfhostMemoTraitCanonicalKeyPayloadCodecHeader SelfhostMemoTraitCanonicalKeyPayloadCodecHeader \self:
        *self

impl Copy for SelfhostMemoTraitCanonicalKeyPayloadCodecHeader:
    fn copy_mark %fn SelfhostMemoTraitCanonicalKeyPayloadCodecHeader SelfhostMemoTraitCanonicalKeyPayloadCodecHeader \self:
        self

impl Clone for SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary:
    fn clone %fn &SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary SelfhostMemoTraitCanonicalKeyPayloadCodecStage0Summary \self:
        self

//: selfhost_memo_trait_canonical_key_payload_codec_magic: canonical key payload codec magic word
//:
//: [契約/けいやく]:
//: - header の先頭 word です。schema version と別に、別 artifact payload を誤って canonical key payload として decode しないために使います。
pub fn selfhost_memo_trait_canonical_key_payload_codec_magic %fn void i32 \void:
    791211

//: selfhost_memo_trait_canonical_key_payload_codec_node_limit: Phase 1 decode の node 数上限
pub fn selfhost_memo_trait_canonical_key_payload_codec_node_limit %fn void i32 \void:
    4096

//: selfhost_memo_trait_canonical_key_payload_codec_arg_limit: Phase 1 decode の argument 数上限
pub fn selfhost_memo_trait_canonical_key_payload_codec_arg_limit %fn void i32 \void:
    8192

//: selfhost_memo_trait_canonical_key_payload_codec_node_width: node record の word 幅
fn selfhost_memo_trait_canonical_key_payload_codec_node_width %fn void i32 \void:
    8

//: selfhost_memo_trait_canonical_key_payload_codec_header_words: header の word 数
fn selfhost_memo_trait_canonical_key_payload_codec_header_words %fn void i32 \void:
    5

//: selfhost_memo_trait_canonical_key_payload_codec_error_from_std: Vec 操作の失敗を decode error へ[写/うつ]す
fn selfhost_memo_trait_canonical_key_payload_codec_error_from_std %fn StdErrorKind SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \kind:
    match kind:
        StdErrorKind::OutOfMemory:
            SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::OutOfMemory
        _:
            SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::OutOfMemory

//: selfhost_memo_trait_canonical_key_payload_codec_stable_nominal_key_eq: stable nominal key が同じか[返/かえ]す
fn selfhost_memo_trait_canonical_key_payload_codec_stable_nominal_key_eq %fn SelfhostMemoTraitStableNominalKey fn SelfhostMemoTraitStableNominalKey bool \a\b:
    and:
        eq a.schema_version b.schema_version
        and:
            eq a.module_fingerprint b.module_fingerprint
            and:
                eq a.definition_fingerprint b.definition_fingerprint
                and:
                    eq a.constructor_ordinal b.constructor_ordinal
                    and:
                        eq a.type_arity b.type_arity
                        eq a.nominal_key_hash b.nominal_key_hash

//: selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_loop: stable key から session-local named id を[探/さが]す
fn selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_loop %fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostMemoTraitStableNominalKey fn i32 fn Option SelfhostNamedTypeId Result SelfhostNamedTypeId SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \table\key\idx\found:
    let records %&Vec SelfhostMemoTraitStableNominalKeyRecord field::get_ref table "records"
    let n %i32 v::len records
    if:
        ge idx n
        then:
            match found:
                Option::Some nominal_id:
                    Result::Ok nominal_id
                Option::None:
                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NominalKeyMissing
        else:
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_memo_trait_canonical_key_payload_codec_stable_nominal_key_eq record.key key
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NominalKeyDuplicate
                                Option::None:
                                    selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_loop table key add idx 1 some record.nominal_id
                        else:
                            selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_loop table key add idx 1 found
                Option::None:
                    match found:
                        Option::Some nominal_id:
                            Result::Ok nominal_id
                        Option::None:
                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NominalKeyMissing

//: selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_result: stable nominal key を session-local named id へ[戻/もど]す
fn selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_result %fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostMemoTraitStableNominalKey Result SelfhostNamedTypeId SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \table\key:
    selfhost_memo_trait_canonical_key_payload_codec_find_nominal_id_loop table key 0 none

//: selfhost_memo_trait_canonical_key_payload_codec_primitive_kind_result: stable primitive code を primitive kind へ[戻/もど]す
fn selfhost_memo_trait_canonical_key_payload_codec_primitive_kind_result %fn i32 Result SelfhostPrimitiveTypeKind SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \code:
    if:
        eq code 101
        then:
            Result::Ok SelfhostPrimitiveTypeKind::Error
        else:
            if:
                eq code 102
                then:
                    Result::Ok SelfhostPrimitiveTypeKind::Unit
                else:
                    if:
                        eq code 103
                        then:
                            Result::Ok SelfhostPrimitiveTypeKind::Bool
                        else:
                            if:
                                eq code 104
                                then:
                                    Result::Ok SelfhostPrimitiveTypeKind::I32
                                else:
                                    if:
                                        eq code 105
                                        then:
                                            Result::Ok SelfhostPrimitiveTypeKind::I64
                                        else:
                                            if:
                                                eq code 106
                                                then:
                                                    Result::Ok SelfhostPrimitiveTypeKind::U8
                                                else:
                                                    if:
                                                        eq code 107
                                                        then:
                                                            Result::Ok SelfhostPrimitiveTypeKind::Char
                                                        else:
                                                            if:
                                                                eq code 108
                                                                then:
                                                                    Result::Ok SelfhostPrimitiveTypeKind::Str
                                                                else:
                                                                    if:
                                                                        eq code 109
                                                                        then:
                                                                            Result::Ok SelfhostPrimitiveTypeKind::F32
                                                                        else:
                                                                            if:
                                                                                eq code 110
                                                                                then:
                                                                                    Result::Ok SelfhostPrimitiveTypeKind::F64
                                                                                else:
                                                                                    if:
                                                                                        eq code 111
                                                                                        then:
                                                                                            Result::Ok SelfhostPrimitiveTypeKind::Never
                                                                                        else:
                                                                                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnknownPrimitiveCode

//: selfhost_memo_trait_canonical_key_payload_codec_word_at_byte_result: little-endian word を[読/よ]む
//:
//: [契約/けいやく]:
//: - Phase 1 は 31-bit nonnegative word だけを受理します。4 byte 目の high bit が立つ場合は負値または将来拡張値として拒否します。
fn selfhost_memo_trait_canonical_key_payload_codec_word_at_byte_result %fn &Vec u8 fn i32 Result i32 SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \bytes\byte_offset:
    let byte_len %i32 v::len bytes
    if:
        or lt byte_offset 0 ge add byte_offset 3 byte_len
        then:
            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
        else:
            match v::get bytes byte_offset:
                Option::Some b0_raw:
                    match v::get bytes add byte_offset 1:
                        Option::Some b1_raw:
                            match v::get bytes add byte_offset 2:
                                Option::Some b2_raw:
                                    match v::get bytes add byte_offset 3:
                                        Option::Some b3_raw:
                                            let b3 %i32 cast b3_raw
                                            if:
                                                gt b3 127
                                                then:
                                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::WordHighBitUnsupported
                                                else:
                                                    let b0 %i32 cast b0_raw
                                                    let b1 %i32 cast b1_raw
                                                    let b2 %i32 cast b2_raw
                                                    let lo %i32 add b0 mul b1 256
                                                    let hi %i32 add mul b2 65536 mul b3 16777216
                                                    Result::Ok add lo hi
                                        Option::None:
                                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
                                Option::None:
                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
                        Option::None:
                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
                Option::None:
                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd

//: selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result: word index から little-endian word を[読/よ]む
fn selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result %fn &Vec u8 fn i32 Result i32 SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \bytes\word_index:
    if:
        lt word_index 0
        then:
            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
        else:
            selfhost_memo_trait_canonical_key_payload_codec_word_at_byte_result bytes mul word_index 4

//: selfhost_memo_trait_canonical_key_payload_codec_node_word_index: node field の word index を[返/かえ]す
fn selfhost_memo_trait_canonical_key_payload_codec_node_word_index %fn i32 fn i32 i32 \node_index\field_index:
    add selfhost_memo_trait_canonical_key_payload_codec_header_words add mul node_index selfhost_memo_trait_canonical_key_payload_codec_node_width field_index

//: selfhost_memo_trait_canonical_key_payload_codec_arg_word_index: argument slot の word index を[返/かえ]す
fn selfhost_memo_trait_canonical_key_payload_codec_arg_word_index %fn SelfhostMemoTraitCanonicalKeyPayloadCodecHeader fn i32 i32 \header\arg_index:
    add selfhost_memo_trait_canonical_key_payload_codec_header_words add mul header.node_count selfhost_memo_trait_canonical_key_payload_codec_node_width arg_index

//: selfhost_memo_trait_canonical_key_payload_codec_expected_word_count: payload 全体の word 数を[返/かえ]す
fn selfhost_memo_trait_canonical_key_payload_codec_expected_word_count %fn SelfhostMemoTraitCanonicalKeyPayloadCodecHeader i32 \header:
    add selfhost_memo_trait_canonical_key_payload_codec_header_words add mul header.node_count selfhost_memo_trait_canonical_key_payload_codec_node_width header.arg_count

//: selfhost_memo_trait_canonical_key_payload_codec_header_checked_result: header count と byte 長を[検査/けんさ]する
fn selfhost_memo_trait_canonical_key_payload_codec_header_checked_result %fn &Vec u8 fn i32 fn i32 fn i32 fn i32 Result SelfhostMemoTraitCanonicalKeyPayloadCodecHeader SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \bytes\schema_version\node_count\arg_count\root_index:
    if:
        ne schema_version selfhost_memo_trait_canonical_key_payload_schema_version
        then:
            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::PayloadSchemaMismatch
        else:
            if:
                lt node_count 0
                then:
                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NodeCountNegative
                else:
                    if:
                        lt arg_count 0
                        then:
                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::ArgCountNegative
                        else:
                            if:
                                gt node_count selfhost_memo_trait_canonical_key_payload_codec_node_limit
                                then:
                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::NodeCountLimitExceeded
                                else:
                                    if:
                                        gt arg_count selfhost_memo_trait_canonical_key_payload_codec_arg_limit
                                        then:
                                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::ArgCountLimitExceeded
                                        else:
                                            if:
                                                or lt root_index 0 ge root_index node_count
                                                then:
                                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::RootOutOfRange
                                                else:
                                                    let header %SelfhostMemoTraitCanonicalKeyPayloadCodecHeader SelfhostMemoTraitCanonicalKeyPayloadCodecHeader schema_version node_count arg_count root_index
                                                    let expected_bytes %i32 mul selfhost_memo_trait_canonical_key_payload_codec_expected_word_count header 4
                                                    let actual_bytes %i32 v::len bytes
                                                    if:
                                                        lt actual_bytes expected_bytes
                                                        then:
                                                            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::UnexpectedEnd
                                                        else:
                                                            if:
                                                                gt actual_bytes expected_bytes
                                                                then:
                                                                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::TrailingBytes
                                                                else:
                                                                    Result::Ok header

//: selfhost_memo_trait_canonical_key_payload_codec_header_result: bytes header を[読/よ]む
fn selfhost_memo_trait_canonical_key_payload_codec_header_result %fn &Vec u8 Result SelfhostMemoTraitCanonicalKeyPayloadCodecHeader SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \bytes:
    match selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result bytes 0:
        Result::Ok magic:
            if:
                ne magic selfhost_memo_trait_canonical_key_payload_codec_magic
                then:
                    Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::PayloadSchemaMismatch
                else:
                    match selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result bytes 1:
                        Result::Ok schema_version:
                            match selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result bytes 2:
                                Result::Ok node_count:
                                    match selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result bytes 3:
                                        Result::Ok arg_count:
                                            match selfhost_memo_trait_canonical_key_payload_codec_word_at_index_result bytes 4:
                                                Result::Ok root_index:
                                                    selfhost_memo_trait_canonical_key_payload_codec_header_checked_result bytes schema_version node_count arg_count root_index
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_canonical_key_payload_codec_stable_nominal_key_result: node field から stable nominal key を[作/つく]る
fn selfhost_memo_trait_canonical_key_payload_codec_stable_nominal_key_result %fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostMemoTraitStableNominalKey SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind \schema_version\module_fingerprint\definition_fingerprint\constructor_ordinal\type_arity:
    if:
        ne schema_version selfhost_memo_trait_stable_nominal_key_schema_version
        then:
            Result::Err SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::PayloadSchemaMismatch
        else:
            match selfhost_memo_trait_stable_nominal_key_result (some module_fingerprint) (some definition_fingerprint) (some constructor_ordinal) type_arity:
                Result::Ok key:
                    Result::Ok key
                Result::Err e:
