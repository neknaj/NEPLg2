#indent 4
#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./id" as *
#import "./kind/eq" as *
#import "./kind/model" as *
#import "./record" as *
#import "./arena" as *

//: # canonical type key
//: type arena local な `SelfhostTypeId` から、artifact key に使える構造 key を[作/つく]る module です。
//:
//: [目的/もくてき]:
//: - `SelfhostTypeId` は 1 回の type arena に閉じた index なので、中間ファイルや cache key に直接入れません。
//: - canonical key は primitive / named / type parameter / applied / function の構造を key node table と argument table に投影します。
//: - named type は現段階では constructor table の `SelfhostNamedTypeId` を使います。module path と surface hash を含む永続 nominal key は、interface artifact 実装時にこの境界へ追加します。
//: - type parameter は binder depth と binder 内 index で投影し、source spelling や diagnostic span を key に混ぜません。
//:
//: [計算量/けいさんりょう]:
//: - projection は root から到達する型 record と型引数 edge の数に比例する O(n) です。
//: - equality は比較する canonical key tree の大きさに比例します。
pub struct SelfhostCanonicalTypeKeyId:
    index %i32

pub struct SelfhostCanonicalTypeKeyArgRange:
    first_arg %i32
    arg_count %i32

pub struct SelfhostCanonicalAppliedTypeKey:
    nominal_id %SelfhostNamedTypeId
    args %SelfhostCanonicalTypeKeyArgRange

pub struct SelfhostCanonicalFunctionTypeKey:
    args %SelfhostCanonicalTypeKeyArgRange
    result %SelfhostCanonicalTypeKeyId

pub enum SelfhostCanonicalTypeKeyNode:
    Primitive %SelfhostPrimitiveTypeKind
    Named %SelfhostNamedTypeId
    Parameter %SelfhostTypeParameterBinding
    Applied %SelfhostCanonicalAppliedTypeKey
    Function %SelfhostCanonicalFunctionTypeKey

pub struct SelfhostCanonicalTypeKeyArena:
    nodes %Vec SelfhostCanonicalTypeKeyNode
    args %Vec SelfhostCanonicalTypeKeyId

pub struct SelfhostCanonicalTypeKeyArenaAlloc:
    arena %SelfhostCanonicalTypeKeyArena
    key_id %SelfhostCanonicalTypeKeyId

pub enum SelfhostCanonicalTypeKeyProjectErrorKind:
    MissingTypeRecord
    MissingTypeArgument
    MissingFunctionArgument
    InvalidAppliedArgumentRange
    InvalidFunctionArgumentRange
    OutOfMemory
    InternalInvariant

//: SelfhostCanonicalTypeKeyCopyErrorKind: canonical key arena 間 copy の拒否理由
//:
//: [目的/もくてき]:
//: - `.neplproof` decoded payload のように `TypeId` authority を持たない canonical key tree を store-local arena へ複製するとき、壊れた source arena、range、fuel、allocation failure を typed error として分けます。
//:
//: [契約/けいやく]:
//: - copy failure は target arena owner を閉じた後に返します。caller は失敗した partial target arena を compile の authority として使ってはいけません。
pub enum SelfhostCanonicalTypeKeyCopyErrorKind:
    MissingSourceNode
    MissingSourceArgument
    InvalidAppliedArgumentRange
    InvalidFunctionArgumentRange
    TraversalFuelExhausted
    OutOfMemory
    InternalInvariant

pub struct SelfhostCanonicalTypeKeyProjectError:
    kind %SelfhostCanonicalTypeKeyProjectErrorKind
    type_id %SelfhostTypeId

struct SelfhostCanonicalTypeKeyArgBuild:
    arena %SelfhostCanonicalTypeKeyArena
    args %SelfhostCanonicalTypeKeyArgRange

impl Clone for SelfhostCanonicalTypeKeyId:
    fn clone %fn &SelfhostCanonicalTypeKeyId SelfhostCanonicalTypeKeyId \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyId:
    fn copy_mark %fn SelfhostCanonicalTypeKeyId SelfhostCanonicalTypeKeyId \self:
        self

impl Clone for SelfhostCanonicalTypeKeyArgRange:
    fn clone %fn &SelfhostCanonicalTypeKeyArgRange SelfhostCanonicalTypeKeyArgRange \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyArgRange:
    fn copy_mark %fn SelfhostCanonicalTypeKeyArgRange SelfhostCanonicalTypeKeyArgRange \self:
        self

impl Clone for SelfhostCanonicalAppliedTypeKey:
    fn clone %fn &SelfhostCanonicalAppliedTypeKey SelfhostCanonicalAppliedTypeKey \self:
        *self

impl Copy for SelfhostCanonicalAppliedTypeKey:
    fn copy_mark %fn SelfhostCanonicalAppliedTypeKey SelfhostCanonicalAppliedTypeKey \self:
        self

impl Clone for SelfhostCanonicalFunctionTypeKey:
    fn clone %fn &SelfhostCanonicalFunctionTypeKey SelfhostCanonicalFunctionTypeKey \self:
        *self

impl Copy for SelfhostCanonicalFunctionTypeKey:
    fn copy_mark %fn SelfhostCanonicalFunctionTypeKey SelfhostCanonicalFunctionTypeKey \self:
        self

impl Clone for SelfhostCanonicalTypeKeyNode:
    fn clone %fn &SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyNode:
    fn copy_mark %fn SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode \self:
        self

impl Clone for SelfhostCanonicalTypeKeyProjectErrorKind:
    fn clone %fn &SelfhostCanonicalTypeKeyProjectErrorKind SelfhostCanonicalTypeKeyProjectErrorKind \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyProjectErrorKind:
    fn copy_mark %fn SelfhostCanonicalTypeKeyProjectErrorKind SelfhostCanonicalTypeKeyProjectErrorKind \self:
        self

impl Clone for SelfhostCanonicalTypeKeyCopyErrorKind:
    fn clone %fn &SelfhostCanonicalTypeKeyCopyErrorKind SelfhostCanonicalTypeKeyCopyErrorKind \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyCopyErrorKind:
    fn copy_mark %fn SelfhostCanonicalTypeKeyCopyErrorKind SelfhostCanonicalTypeKeyCopyErrorKind \self:
        self

impl Clone for SelfhostCanonicalTypeKeyProjectError:
    fn clone %fn &SelfhostCanonicalTypeKeyProjectError SelfhostCanonicalTypeKeyProjectError \self:
        *self

impl Copy for SelfhostCanonicalTypeKeyProjectError:
    fn copy_mark %fn SelfhostCanonicalTypeKeyProjectError SelfhostCanonicalTypeKeyProjectError \self:
        self

pub fn selfhost_canonical_type_key_id_new %fn i32 SelfhostCanonicalTypeKeyId \index:
    SelfhostCanonicalTypeKeyId index

pub fn selfhost_canonical_type_key_id_index %fn SelfhostCanonicalTypeKeyId i32 \key_id:
    key_id.index

pub fn selfhost_canonical_type_key_id_eq %fn SelfhostCanonicalTypeKeyId fn SelfhostCanonicalTypeKeyId bool \a\b:
    eq a.index b.index

pub fn selfhost_canonical_type_key_arg_range_new_unchecked %fn i32 fn i32 SelfhostCanonicalTypeKeyArgRange \first_arg\arg_count:
    SelfhostCanonicalTypeKeyArgRange first_arg arg_count

pub fn selfhost_canonical_type_key_arg_range_is_valid %fn SelfhostCanonicalTypeKeyArgRange bool \args:
    and:
        ge args.first_arg 0
        and ge args.arg_count 0 le args.arg_count sub 2147483647 args.first_arg

pub fn selfhost_canonical_type_key_arg_range_is_nonempty_valid %fn SelfhostCanonicalTypeKeyArgRange bool \args:
    and:
        gt args.arg_count 0
        selfhost_canonical_type_key_arg_range_is_valid args

pub fn selfhost_canonical_type_key_arena_new %impure fn void Result SelfhostCanonicalTypeKeyArena StdErrorKind \void:
    let nodes_result %Result Vec SelfhostCanonicalTypeKeyNode StdErrorKind v::new
    match nodes_result:
        Result::Ok nodes:
            let args_result %Result Vec SelfhostCanonicalTypeKeyId StdErrorKind v::new
            match args_result:
                Result::Ok args:
                    Result::Ok SelfhostCanonicalTypeKeyArena nodes args
                Result::Err e:
                    v::free nodes
                    Result::Err e
        Result::Err e:
            Result::Err e

pub fn selfhost_canonical_type_key_arena_free %impure fn SelfhostCanonicalTypeKeyArena unit \arena:
    v::free field::get arena "nodes"
    v::free field::get arena "args"

pub fn selfhost_canonical_type_key_arena_node_len %fn &SelfhostCanonicalTypeKeyArena i32 \arena:
    let nodes %&Vec SelfhostCanonicalTypeKeyNode field::get_ref arena "nodes"
    v::len nodes

pub fn selfhost_canonical_type_key_arena_arg_len %fn &SelfhostCanonicalTypeKeyArena i32 \arena:
    let args %&Vec SelfhostCanonicalTypeKeyId field::get_ref arena "args"
    v::len args

pub fn selfhost_canonical_type_key_arena_alloc_key_id %fn &SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyId \allocated:
    *field::get_ref allocated "key_id"

pub fn selfhost_canonical_type_key_arena_alloc_into_arena %impure fn SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyArena \allocated:
    field::get allocated "arena"

pub fn selfhost_canonical_type_key_arena_get_node %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId Option SelfhostCanonicalTypeKeyNode \arena\key_id:
    if:
        lt key_id.index 0
        then:
            none
        else:
            let nodes %&Vec SelfhostCanonicalTypeKeyNode field::get_ref arena "nodes"
            v::get nodes key_id.index

fn selfhost_canonical_type_key_arena_alloc_new %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId SelfhostCanonicalTypeKeyArenaAlloc \arena\key_id:
    SelfhostCanonicalTypeKeyArenaAlloc arena key_id

fn selfhost_canonical_type_key_project_error_new %fn SelfhostCanonicalTypeKeyProjectErrorKind fn SelfhostTypeId SelfhostCanonicalTypeKeyProjectError \kind\type_id:
    SelfhostCanonicalTypeKeyProjectError kind type_id

fn selfhost_canonical_type_key_project_error_from_std %fn StdErrorKind fn SelfhostTypeId SelfhostCanonicalTypeKeyProjectError \kind\type_id:
    match kind:
        StdErrorKind::OutOfMemory:
            selfhost_canonical_type_key_project_error_new SelfhostCanonicalTypeKeyProjectErrorKind::OutOfMemory type_id
        _:
            selfhost_canonical_type_key_project_error_new SelfhostCanonicalTypeKeyProjectErrorKind::InternalInvariant type_id

fn selfhost_canonical_type_key_project_fail %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyProjectErrorKind impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \arena\kind\type_id:
    selfhost_canonical_type_key_arena_free arena
    Result::Err selfhost_canonical_type_key_project_error_new kind type_id

fn selfhost_canonical_type_key_project_arg_fail %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyProjectErrorKind impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArgBuild SelfhostCanonicalTypeKeyProjectError \arena\kind\type_id:
    selfhost_canonical_type_key_arena_free arena
    Result::Err selfhost_canonical_type_key_project_error_new kind type_id

fn selfhost_canonical_type_key_push_node %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyNode impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \arena\node\source_type_id:
    let key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_id_new selfhost_canonical_type_key_arena_node_len &arena
    let nodes %Vec SelfhostCanonicalTypeKeyNode field::get arena "nodes"
    let args %Vec SelfhostCanonicalTypeKeyId field::get arena "args"
    match v::push nodes node:
        Result::Ok next_nodes:
            let next_arena %SelfhostCanonicalTypeKeyArena SelfhostCanonicalTypeKeyArena next_nodes args
            Result::Ok selfhost_canonical_type_key_arena_alloc_new next_arena key_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free args
            Result::Err selfhost_canonical_type_key_project_error_from_std error source_type_id

fn selfhost_canonical_type_key_push_arg_id %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArena SelfhostCanonicalTypeKeyProjectError \arena\arg\source_type_id:
    let nodes %Vec SelfhostCanonicalTypeKeyNode field::get arena "nodes"
    let args %Vec SelfhostCanonicalTypeKeyId field::get arena "args"
    match v::push args arg:
        Result::Ok next_args:
            Result::Ok SelfhostCanonicalTypeKeyArena nodes next_args
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free nodes
            Result::Err selfhost_canonical_type_key_project_error_from_std error source_type_id

fn selfhost_canonical_type_key_arg_build_new %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArgRange SelfhostCanonicalTypeKeyArgBuild \arena\args:
    SelfhostCanonicalTypeKeyArgBuild arena args

fn selfhost_canonical_type_key_project_type_args_loop %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId impure fn i32 impure fn i32 impure fn i32 Result SelfhostCanonicalTypeKeyArgBuild SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id\first_arg\idx\n:
    if:
        ge idx n
        then:
            let args %SelfhostCanonicalTypeKeyArgRange selfhost_canonical_type_key_arg_range_new_unchecked first_arg n
            Result::Ok selfhost_canonical_type_key_arg_build_new key_arena args
        else:
            match selfhost_type_arena_applied_arg types type_id idx:
                Option::Some arg_type_id:
                    match selfhost_canonical_type_key_project_node types key_arena arg_type_id:
                        Result::Ok arg_alloc:
                            let arg_key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &arg_alloc
                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena arg_alloc
                            match selfhost_canonical_type_key_push_arg_id next_arena arg_key_id type_id:
                                Result::Ok pushed_arena:
                                    selfhost_canonical_type_key_project_type_args_loop types pushed_arena type_id first_arg add idx 1 n
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    selfhost_canonical_type_key_project_arg_fail key_arena SelfhostCanonicalTypeKeyProjectErrorKind::MissingTypeArgument type_id

fn selfhost_canonical_type_key_project_function_args_loop %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId impure fn i32 impure fn i32 impure fn i32 Result SelfhostCanonicalTypeKeyArgBuild SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id\first_arg\idx\n:
    if:
        ge idx n
        then:
            let args %SelfhostCanonicalTypeKeyArgRange selfhost_canonical_type_key_arg_range_new_unchecked first_arg n
            Result::Ok selfhost_canonical_type_key_arg_build_new key_arena args
        else:
            match selfhost_type_arena_function_arg types type_id idx:
                Option::Some arg_type_id:
                    match selfhost_canonical_type_key_project_node types key_arena arg_type_id:
                        Result::Ok arg_alloc:
                            let arg_key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &arg_alloc
                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena arg_alloc
                            match selfhost_canonical_type_key_push_arg_id next_arena arg_key_id type_id:
                                Result::Ok pushed_arena:
                                    selfhost_canonical_type_key_project_function_args_loop types pushed_arena type_id first_arg add idx 1 n
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    selfhost_canonical_type_key_project_arg_fail key_arena SelfhostCanonicalTypeKeyProjectErrorKind::MissingFunctionArgument type_id

fn selfhost_canonical_type_key_project_applied %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId impure fn SelfhostAppliedTypeRecord Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id\applied:
    let source_args %SelfhostAppliedTypeArgRange selfhost_applied_type_record_args applied
    if:
        not selfhost_applied_type_arg_range_is_valid source_args
        then:
            selfhost_canonical_type_key_project_fail key_arena SelfhostCanonicalTypeKeyProjectErrorKind::InvalidAppliedArgumentRange type_id
        else:
            let first_arg %i32 selfhost_canonical_type_key_arena_arg_len &key_arena
            let n %i32 selfhost_applied_type_arg_range_count source_args
            match selfhost_canonical_type_key_project_type_args_loop types key_arena type_id first_arg 0 n:
                Result::Ok build:
                    let next_arena %SelfhostCanonicalTypeKeyArena field::get build "arena"
                    let args %SelfhostCanonicalTypeKeyArgRange field::get build "args"
                    let nominal_id %SelfhostNamedTypeId selfhost_applied_type_record_id applied
                    let applied_key %SelfhostCanonicalAppliedTypeKey SelfhostCanonicalAppliedTypeKey nominal_id args
                    let node %SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode::Applied applied_key
                    selfhost_canonical_type_key_push_node next_arena node type_id
                Result::Err e:
                    Result::Err e

fn selfhost_canonical_type_key_project_function %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId impure fn SelfhostFunctionTypeRecord Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id\function:
    if:
        not selfhost_function_type_arg_range_is_valid function.args
        then:
            selfhost_canonical_type_key_project_fail key_arena SelfhostCanonicalTypeKeyProjectErrorKind::InvalidFunctionArgumentRange type_id
        else:
            let first_arg %i32 selfhost_canonical_type_key_arena_arg_len &key_arena
            let n %i32 selfhost_function_type_arg_range_count function.args
            match selfhost_canonical_type_key_project_function_args_loop types key_arena type_id first_arg 0 n:
                Result::Ok build:
                    let arg_arena %SelfhostCanonicalTypeKeyArena field::get build "arena"
                    let args %SelfhostCanonicalTypeKeyArgRange field::get build "args"
                    match selfhost_canonical_type_key_project_node types arg_arena function.result:
                        Result::Ok result_alloc:
                            let result_key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &result_alloc
                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena result_alloc
                            let node %SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode::Function SelfhostCanonicalFunctionTypeKey args result_key_id
                            selfhost_canonical_type_key_push_node next_arena node type_id
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e

fn selfhost_canonical_type_key_project_node %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id:
    match selfhost_type_arena_get_record types type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    let node %SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode::Primitive kind
                    selfhost_canonical_type_key_push_node key_arena node type_id
                SelfhostTypeRecord::Named named:
                    let nominal_id %SelfhostNamedTypeId selfhost_named_type_record_id named
                    let node %SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode::Named nominal_id
                    selfhost_canonical_type_key_push_node key_arena node type_id
                SelfhostTypeRecord::Parameter parameter:
                    let binding %SelfhostTypeParameterBinding selfhost_type_parameter_record_binding parameter
                    let node %SelfhostCanonicalTypeKeyNode SelfhostCanonicalTypeKeyNode::Parameter binding
                    selfhost_canonical_type_key_push_node key_arena node type_id
                SelfhostTypeRecord::Applied applied:
                    selfhost_canonical_type_key_project_applied types key_arena type_id applied
                SelfhostTypeRecord::Function function:
                    selfhost_canonical_type_key_project_function types key_arena type_id function
        Option::None:
            selfhost_canonical_type_key_project_fail key_arena SelfhostCanonicalTypeKeyProjectErrorKind::MissingTypeRecord type_id

pub fn selfhost_canonical_type_key_project_into_arena %impure fn &SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \types\key_arena\type_id:
    selfhost_canonical_type_key_project_node types key_arena type_id

pub fn selfhost_canonical_type_key_project_from_arena %impure fn &SelfhostTypeArena impure fn SelfhostTypeId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyProjectError \types\type_id:
    match selfhost_canonical_type_key_arena_new:
        Result::Ok key_arena:
            selfhost_canonical_type_key_project_into_arena types key_arena type_id
        Result::Err e:
            Result::Err selfhost_canonical_type_key_project_error_from_std e type_id

//: selfhost_canonical_type_key_copy_error_kind_code: copy error kind の一次分類 code を[返/かえ]す
//:
//: [契約/けいやく]:
//: - この code は永続化 schema ではありません。同一 module 内の equality 実装だけが利用します。
//: - wildcard arm は使いません。copy error variant が増えた場合、この match も明示的に更新します。
fn selfhost_canonical_type_key_copy_error_kind_code %fn SelfhostCanonicalTypeKeyCopyErrorKind i32 \kind:
    match kind:
        SelfhostCanonicalTypeKeyCopyErrorKind::MissingSourceNode:
            1
        SelfhostCanonicalTypeKeyCopyErrorKind::MissingSourceArgument:
            2
        SelfhostCanonicalTypeKeyCopyErrorKind::InvalidAppliedArgumentRange:
            3
        SelfhostCanonicalTypeKeyCopyErrorKind::InvalidFunctionArgumentRange:
            4
        SelfhostCanonicalTypeKeyCopyErrorKind::TraversalFuelExhausted:
            5
        SelfhostCanonicalTypeKeyCopyErrorKind::OutOfMemory:
            6
        SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant:
            7

//: selfhost_canonical_type_key_copy_error_kind_eq: canonical key copy error が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - copy error variant は payload を持たないため、網羅 match で作った一次分類 code を比較します。
//: - variant 追加時は `selfhost_canonical_type_key_copy_error_kind_code` の match が更新漏れを検出する境界になります。
pub fn selfhost_canonical_type_key_copy_error_kind_eq %fn SelfhostCanonicalTypeKeyCopyErrorKind fn SelfhostCanonicalTypeKeyCopyErrorKind bool \a\b:
    eq selfhost_canonical_type_key_copy_error_kind_code a selfhost_canonical_type_key_copy_error_kind_code b

//: selfhost_canonical_type_key_copy_error_from_std: Vec allocation error を copy error へ[写像/しゃぞう]する
//:
//: [契約/けいやく]:
//: - `OutOfMemory` と `CapacityExceeded` は copy を継続できない容量失敗として扱います。
//: - それ以外の std error は copy 境界では想定外なので `InternalInvariant` へ畳み込みます。
fn selfhost_canonical_type_key_copy_error_from_std %fn StdErrorKind SelfhostCanonicalTypeKeyCopyErrorKind \kind:
    match kind:
        StdErrorKind::Failure:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::OutOfMemory:
            SelfhostCanonicalTypeKeyCopyErrorKind::OutOfMemory
        StdErrorKind::EmptyCollection:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::IndexOutOfBounds:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::KeyNotFound:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::CapacityExceeded:
            SelfhostCanonicalTypeKeyCopyErrorKind::OutOfMemory
        StdErrorKind::InvalidOperation:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::InvalidUtf8:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::ParseError:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::IoError:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant
        StdErrorKind::Other:
            SelfhostCanonicalTypeKeyCopyErrorKind::InternalInvariant

//: selfhost_canonical_type_key_copy_fail: target arena を閉じて copy error を[返/かえ]す
//:
//: [契約/けいやく]:
//: - subtree copy が失敗した場合、partial target arena を外へ返さないため、この helper が必ず owner を閉じます。
fn selfhost_canonical_type_key_copy_fail %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyCopyErrorKind Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \target_arena\kind:
    selfhost_canonical_type_key_arena_free target_arena
    Result::Err kind

//: selfhost_canonical_type_key_copy_arg_fail: target arena を閉じて argument copy error を[返/かえ]す
//:
//: [契約/けいやく]:
//: - argument list の途中で source が壊れていた場合、部分的に複製した argument arena を成功値として返しません。
fn selfhost_canonical_type_key_copy_arg_fail %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyCopyErrorKind Result SelfhostCanonicalTypeKeyArgBuild SelfhostCanonicalTypeKeyCopyErrorKind \target_arena\kind:
    selfhost_canonical_type_key_arena_free target_arena
    Result::Err kind

//: selfhost_canonical_type_key_copy_push_node: copied node を target arena に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - 返す key id は push 前の target node length から作り、target arena 内だけで有効です。
//: - node push に失敗した場合は argument vector を閉じ、typed copy error を返します。
fn selfhost_canonical_type_key_copy_push_node %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyNode Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \target_arena\node:
    let key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_id_new selfhost_canonical_type_key_arena_node_len &target_arena
    let nodes %Vec SelfhostCanonicalTypeKeyNode field::get target_arena "nodes"
    let args %Vec SelfhostCanonicalTypeKeyId field::get target_arena "args"
    match v::push nodes node:
        Result::Ok next_nodes:
            let next_arena %SelfhostCanonicalTypeKeyArena SelfhostCanonicalTypeKeyArena next_nodes args
            Result::Ok selfhost_canonical_type_key_arena_alloc_new next_arena key_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free args
            Result::Err selfhost_canonical_type_key_copy_error_from_std error

//: selfhost_canonical_type_key_copy_push_arg_id: copied argument key id を target arena に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - argument key id は既に target arena に複製済みの node を指していなければいけません。この helper は source arena の key id を直接受け取りません。
//: - argument push に失敗した場合は node vector を閉じ、partial arena を外へ返しません。
fn selfhost_canonical_type_key_copy_push_arg_id %impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId Result SelfhostCanonicalTypeKeyArena SelfhostCanonicalTypeKeyCopyErrorKind \target_arena\arg:
    let nodes %Vec SelfhostCanonicalTypeKeyNode field::get target_arena "nodes"
    let args %Vec SelfhostCanonicalTypeKeyId field::get target_arena "args"
    match v::push args arg:
        Result::Ok next_args:
            Result::Ok SelfhostCanonicalTypeKeyArena nodes next_args
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free nodes
            Result::Err selfhost_canonical_type_key_copy_error_from_std error

//: selfhost_canonical_type_key_copy_args_loop: source argument range を target arena の key id 列へ[複製/ふくせい]する
//:
//: [目的/もくてき]:
//: - source arena の argument range を順に読み、各 argument subtree を target arena へ複製してから target の argument vector に追加します。
//:
//: [契約/けいやく]:
//: - source argument が欠けている場合は `MissingSourceArgument` で fail-closed にします。
//: - fuel は循環や壊れた graph で再帰が止まらないことを防ぐために消費します。
fn selfhost_canonical_type_key_copy_args_loop %impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArgRange impure fn i32 impure fn i32 Result SelfhostCanonicalTypeKeyArgBuild SelfhostCanonicalTypeKeyCopyErrorKind \source_arena\target_arena\source_args\idx\fuel:
    if:
        ge idx source_args.arg_count
        then:
            let copied_args %SelfhostCanonicalTypeKeyArgRange selfhost_canonical_type_key_arg_range_new_unchecked sub selfhost_canonical_type_key_arena_arg_len &target_arena source_args.arg_count source_args.arg_count
            Result::Ok selfhost_canonical_type_key_arg_build_new target_arena copied_args
        else:
            match selfhost_canonical_type_key_arena_arg source_arena source_args idx:
                Option::Some source_arg:
                    match selfhost_canonical_type_key_copy_node_result source_arena target_arena source_arg sub fuel 1:
                        Result::Ok copied_arg_alloc:
                            let copied_arg %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &copied_arg_alloc
                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena copied_arg_alloc
                            match selfhost_canonical_type_key_copy_push_arg_id next_arena copied_arg:
                                Result::Ok pushed_arena:
                                    selfhost_canonical_type_key_copy_args_loop source_arena pushed_arena source_args add idx 1 fuel
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    selfhost_canonical_type_key_copy_arg_fail target_arena SelfhostCanonicalTypeKeyCopyErrorKind::MissingSourceArgument

//: selfhost_canonical_type_key_copy_applied_result: applied type key を target arena へ[複製/ふくせい]する
//:
//: [契約/けいやく]:
//: - source applied key の argument range が壊れている場合は node を追加せず、target arena を閉じます。
//: - nominal id は stable nominal key table 由来の値なのでそのまま複製し、argument key id だけ target arena local に作り直します。
fn selfhost_canonical_type_key_copy_applied_result %impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalAppliedTypeKey impure fn i32 Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \source_arena\target_arena\applied\fuel:
    if:
        not selfhost_canonical_type_key_arg_range_is_valid applied.args
        then:
            selfhost_canonical_type_key_copy_fail target_arena SelfhostCanonicalTypeKeyCopyErrorKind::InvalidAppliedArgumentRange
        else:
            match selfhost_canonical_type_key_copy_args_loop source_arena target_arena applied.args 0 fuel:
                Result::Ok build:
                    let next_arena %SelfhostCanonicalTypeKeyArena field::get build "arena"
                    let copied_args %SelfhostCanonicalTypeKeyArgRange field::get build "args"
                    let copied_applied %SelfhostCanonicalAppliedTypeKey SelfhostCanonicalAppliedTypeKey applied.nominal_id copied_args
                    selfhost_canonical_type_key_copy_push_node next_arena SelfhostCanonicalTypeKeyNode::Applied copied_applied
                Result::Err e:
                    Result::Err e

//: selfhost_canonical_type_key_copy_function_result: function type key を target arena へ[複製/ふくせい]する
//:
//: [契約/けいやく]:
//: - function argument range と result subtree の両方を target arena local key id に作り直します。
//: - source の result key が欠けている場合や fuel が尽きた場合は、partial target arena を成功値として返しません。
fn selfhost_canonical_type_key_copy_function_result %impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalFunctionTypeKey impure fn i32 Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \source_arena\target_arena\function\fuel:
    if:
        not selfhost_canonical_type_key_arg_range_is_valid function.args
        then:
            selfhost_canonical_type_key_copy_fail target_arena SelfhostCanonicalTypeKeyCopyErrorKind::InvalidFunctionArgumentRange
        else:
            match selfhost_canonical_type_key_copy_args_loop source_arena target_arena function.args 0 fuel:
                Result::Ok build:
                    let arg_arena %SelfhostCanonicalTypeKeyArena field::get build "arena"
                    let copied_args %SelfhostCanonicalTypeKeyArgRange field::get build "args"
                    match selfhost_canonical_type_key_copy_node_result source_arena arg_arena function.result sub fuel 1:
                        Result::Ok result_alloc:
                            let result_key %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &result_alloc
                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena result_alloc
                            let copied_function %SelfhostCanonicalFunctionTypeKey SelfhostCanonicalFunctionTypeKey copied_args result_key
                            selfhost_canonical_type_key_copy_push_node next_arena SelfhostCanonicalTypeKeyNode::Function copied_function
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e

//: selfhost_canonical_type_key_copy_node_result: source arena の canonical key subtree を target arena へ[複製/ふくせい]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader のように `TypeId` を authority として持たない入力から、materialized canonical key tree だけを proof store の owned arena へ移すための境界です。
//:
//: [契約/けいやく]:
//: - 返される `SelfhostCanonicalTypeKeyId` は target arena 内だけで意味を持ちます。source arena の key id 数値を再利用しません。
//: - source に壊れた argument range や循環がある場合は typed error で fail-closed にします。失敗時は target arena owner をこの関数が閉じます。
fn selfhost_canonical_type_key_copy_node_result %impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn i32 Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \source_arena\target_arena\source_key\fuel:
    if:
        le fuel 0
        then:
            selfhost_canonical_type_key_copy_fail target_arena SelfhostCanonicalTypeKeyCopyErrorKind::TraversalFuelExhausted
        else:
            match selfhost_canonical_type_key_arena_get_node source_arena source_key:
                Option::Some node:
                    match node:
                        SelfhostCanonicalTypeKeyNode::Primitive kind:
                            selfhost_canonical_type_key_copy_push_node target_arena SelfhostCanonicalTypeKeyNode::Primitive kind
                        SelfhostCanonicalTypeKeyNode::Named named:
                            selfhost_canonical_type_key_copy_push_node target_arena SelfhostCanonicalTypeKeyNode::Named named
                        SelfhostCanonicalTypeKeyNode::Parameter parameter:
                            selfhost_canonical_type_key_copy_push_node target_arena SelfhostCanonicalTypeKeyNode::Parameter parameter
                        SelfhostCanonicalTypeKeyNode::Applied applied:
                            selfhost_canonical_type_key_copy_applied_result source_arena target_arena applied sub fuel 1
                        SelfhostCanonicalTypeKeyNode::Function function:
                            selfhost_canonical_type_key_copy_function_result source_arena target_arena function sub fuel 1
                Option::None:
                    selfhost_canonical_type_key_copy_fail target_arena SelfhostCanonicalTypeKeyCopyErrorKind::MissingSourceNode

//: selfhost_canonical_type_key_copy_from_arena: canonical key subtree を別 arena に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - session-local `SelfhostTypeId` を持たない serialized / decoded artifact 入力を、既存の canonical key arena owner に安全に取り込めるようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(alloc)`: target arena に source root から到達する canonical key subtree を追加しました。`alloc.key_id` がコピー後の root です。
//: - `Err(kind)`: source arena が不正、または target arena への追加に失敗しました。target arena owner は閉じられており、呼び出し側は再利用してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - source root から到達する node / argument edge 数に比例します。共有 subtree は Phase 1 では参照先ごとに再コピーします。
pub fn selfhost_canonical_type_key_copy_from_arena %impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId Result SelfhostCanonicalTypeKeyArenaAlloc SelfhostCanonicalTypeKeyCopyErrorKind \source_arena\target_arena\source_root:
    let fuel %i32 add add selfhost_canonical_type_key_arena_node_len source_arena selfhost_canonical_type_key_arena_arg_len source_arena 8
    selfhost_canonical_type_key_copy_node_result source_arena target_arena source_root fuel

pub fn selfhost_canonical_type_key_arena_arg %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyArgRange fn i32 Option SelfhostCanonicalTypeKeyId \arena\args\idx:
    if:
        or lt idx 0 ge idx args.arg_count
        then:
            none
        else:
            let table %&Vec SelfhostCanonicalTypeKeyId field::get_ref arena "args"
            v::get table add args.first_arg idx

fn selfhost_canonical_type_key_arg_ranges_equal_raw %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyArgRange fn SelfhostCanonicalTypeKeyArgRange fn i32 bool \arena\a\b\idx:
    if:
        ge idx a.arg_count
        then:
            true
        else:
            match selfhost_canonical_type_key_arena_arg arena a idx:
                Option::Some arg_a:
                    match selfhost_canonical_type_key_arena_arg arena b idx:
                        Option::Some arg_b:
                            if:
                                selfhost_canonical_type_key_equal arena arg_a arg_b
                                then:
                                    selfhost_canonical_type_key_arg_ranges_equal_raw arena a b add idx 1
                                else:
                                    false
                        Option::None:
                            false
                Option::None:
                    false

fn selfhost_canonical_type_key_arg_ranges_equal %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyArgRange fn SelfhostCanonicalTypeKeyArgRange bool \arena\a\b:
    if:
        not and selfhost_canonical_type_key_arg_range_is_valid a selfhost_canonical_type_key_arg_range_is_valid b
        then:
            false
        else:
            if:
                ne a.arg_count b.arg_count
                then:
                    false
                else:
                    selfhost_canonical_type_key_arg_ranges_equal_raw arena a b 0

fn selfhost_canonical_type_key_nodes_equal %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyNode fn SelfhostCanonicalTypeKeyNode bool \arena\a\b:
    match a:
        SelfhostCanonicalTypeKeyNode::Primitive a_kind:
            match b:
                SelfhostCanonicalTypeKeyNode::Primitive b_kind:
                    let a_general %SelfhostTypeKind selfhost_primitive_type_kind_to_type_kind a_kind
                    let b_general %SelfhostTypeKind selfhost_primitive_type_kind_to_type_kind b_kind
                    selfhost_type_kind_eq a_general b_general
                _:
                    false
        SelfhostCanonicalTypeKeyNode::Named a_named:
            match b:
                SelfhostCanonicalTypeKeyNode::Named b_named:
                    selfhost_named_type_id_eq a_named b_named
                _:
                    false
        SelfhostCanonicalTypeKeyNode::Parameter a_parameter:
            match b:
                SelfhostCanonicalTypeKeyNode::Parameter b_parameter:
                    selfhost_type_parameter_binding_eq a_parameter b_parameter
                _:
                    false
        SelfhostCanonicalTypeKeyNode::Applied a_applied:
            match b:
                SelfhostCanonicalTypeKeyNode::Applied b_applied:
                    and:
                        selfhost_named_type_id_eq a_applied.nominal_id b_applied.nominal_id
                        selfhost_canonical_type_key_arg_ranges_equal arena a_applied.args b_applied.args
                _:
                    false
        SelfhostCanonicalTypeKeyNode::Function a_function:
            match b:
                SelfhostCanonicalTypeKeyNode::Function b_function:
                    and:
                        selfhost_canonical_type_key_arg_ranges_equal arena a_function.args b_function.args
                        selfhost_canonical_type_key_equal arena a_function.result b_function.result
                _:
                    false

pub fn selfhost_canonical_type_key_equal %fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId fn SelfhostCanonicalTypeKeyId bool \arena\a\b:
    match selfhost_canonical_type_key_arena_get_node arena a:
        Option::Some node_a:
            match selfhost_canonical_type_key_arena_get_node arena b:
                Option::Some node_b:
                    if:
                        selfhost_canonical_type_key_id_eq a b
                        then:
                            true
                        else:
                            selfhost_canonical_type_key_nodes_equal arena node_a node_b
                Option::None:
                    false
        Option::None:
            false
