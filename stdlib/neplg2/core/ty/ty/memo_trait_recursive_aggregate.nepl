//: selfhost_memo_trait_recursive_aggregate_stage0_after_table: fixture 構築後に public API を[実行/じっこう]する
fn selfhost_memo_trait_recursive_aggregate_stage0_after_table %impure fn SelfhostTypeArena impure fn SelfhostMemoTraitLayoutEvidenceTable impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId Result SelfhostMemoTraitRecursiveAggregateStage0Summary StdErrorKind \arena\table\unit_id\root_id\child_id\nested_root_id\parameter_root_id\function_root_id:
    let accepted %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table root_id 4
    let nested_accepted %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table nested_root_id 4
    let cycle_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table child_id 4
    let depth_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table child_id 0
    let target_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table unit_id 4
    let missing_id %SelfhostTypeId selfhost_type_id_new 9999
    let missing_type_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table missing_id 4
    let parameter_field_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table parameter_root_id 4
    let function_field_rejected %Result SelfhostMemoTraitRecursiveAggregateSummary SelfhostMemoTraitRecursiveAggregateErrorKind selfhost_memo_trait_recursive_aggregate_result &arena &table function_root_id 4
    let summary %SelfhostMemoTraitRecursiveAggregateStage0Summary selfhost_memo_trait_recursive_aggregate_stage0_summary_new accepted nested_accepted cycle_rejected depth_rejected target_rejected missing_type_rejected parameter_field_rejected function_field_rejected
    selfhost_memo_trait_recursive_aggregate_stage0_finish arena table summary

