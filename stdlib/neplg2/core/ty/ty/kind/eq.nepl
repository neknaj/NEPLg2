//: selfhost_type_kind_eq: TypeKind が同じ分類か[返/かえ]す
//:
//: [目的/もくてき]:
//: - TypeKind を i32 tag に落とさず、enum variant を直接 match して比較します。
//: - 新しい型分類を追加した場合、比較関数も明示的に更新する必要があります。
pub fn selfhost_type_kind_eq %fn SelfhostTypeKind fn SelfhostTypeKind bool \a\b:
    match a:
        SelfhostTypeKind::Error:
            match b:
                SelfhostTypeKind::Error:
                    true
                SelfhostTypeKind::Unit:
                    false
                SelfhostTypeKind::Bool:
                    false
                SelfhostTypeKind::I32:
                    false
                SelfhostTypeKind::I64:
                    false
                SelfhostTypeKind::U8:
                    false
                SelfhostTypeKind::Char:
                    false
                SelfhostTypeKind::Str:
                    false
                SelfhostTypeKind::F32:
                    false
                SelfhostTypeKind::F64:
                    false
                SelfhostTypeKind::Never:
                    false
                SelfhostTypeKind::Function:
                    false
                SelfhostTypeKind::Named:
                    false
        SelfhostTypeKind::Unit:
