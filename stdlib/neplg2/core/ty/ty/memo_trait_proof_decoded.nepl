            let accepted_candidate_record %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind match accepted_lookup:
                Result::Ok range:
                    selfhost_memo_trait_neplproof_decoded_artifact_candidate_record_at_result &artifact accepted_fingerprint range 0
                Result::Err kind:
                    Result::Err kind
            let invalid_range %SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofIndexCandidateRange -1 1
            let candidate_range_error %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_candidate_record_at_result &artifact accepted_fingerprint invalid_range 0
            let candidate_offset_error %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind match accepted_lookup:
                Result::Ok range:
                    selfhost_memo_trait_neplproof_decoded_artifact_candidate_record_at_result &artifact accepted_fingerprint range range.candidate_count
                Result::Err kind:
                    Result::Err kind
            let candidate_target_error %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind match accepted_lookup:
                Result::Ok range:
                    selfhost_memo_trait_neplproof_decoded_artifact_candidate_record_at_result &artifact missing_fingerprint range 0
                Result::Err kind:
                    Result::Err kind
            let accepted_collision_candidate_record %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind Result::Err SelfhostMemoTraitNeplProofDecodedArtifactErrorKind::CandidateAccessInvalid SelfhostMemoTraitNeplProofDecodedCandidateErrorKind::CandidateRangeInvalid
            let accepted_record %Result SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_record_at_result &artifact 0
            let accepted_index %Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_index_at_result &artifact 0
            let missing_lookup %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_lookup_result &artifact missing_fingerprint
            selfhost_memo_trait_neplproof_decoded_artifact_free artifact
            Result::Ok selfhost_memo_trait_neplproof_decoded_artifact_stage0_summary_new accepted_lookup accepted_candidate_record candidate_range_error candidate_offset_error candidate_target_error accepted_collision_candidate_record accepted_record accepted_index missing_lookup (Result::Ok unit)
        Result::Err kind:
            Result::Err kind

