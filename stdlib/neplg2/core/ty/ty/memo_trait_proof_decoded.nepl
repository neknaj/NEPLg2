                Result::Ok artifact:
                    let accepted_lookup %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_lookup_result &artifact accepted_fingerprint
