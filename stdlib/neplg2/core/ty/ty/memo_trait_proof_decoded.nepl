//: selfhost_memo_trait_neplproof_decoded_artifact_stage0: decoded artifact owner contract の代表結果を[返/かえ]す
//:
//: [目的/もくてき]:
//: - artifact schema の accepted record から decoded artifact owner を作り、lookup、record copy-out、index copy-out、missing candidate、invalid record rejection を同じ public boundary 経由で確認します。
pub fn selfhost_memo_trait_neplproof_decoded_artifact_stage0 %impure fn void Result SelfhostMemoTraitNeplProofDecodedArtifactStage0Summary StdErrorKind \void:
    let artifact_summary %SelfhostMemoTraitNeplProofArtifactStage0Summary selfhost_memo_trait_neplproof_artifact_stage0
    match artifact_summary.accepted_record:
        Result::Ok first_record:
            let first_key %SelfhostMemoTraitNeplProofRecordKey *field::get_ref &first_record "key"
            let accepted_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint *field::get_ref &first_key "canonical_fingerprint"
            let missing_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint accepted_fingerprint.schema_version add accepted_fingerprint.root_hash 1
            let first_proof_kind %SelfhostMemoTraitStoredProofKind *field::get_ref &first_record "proof_kind"
            let first_proof %SelfhostMemoTraitStoredAggregateProof *field::get_ref &first_record "proof"
            let first_record_payload_hash %i32 *field::get_ref &first_record "record_payload_hash"
            let second_same_fingerprint_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key first_proof_kind first_proof add first_record_payload_hash 1
            let invalid_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key first_proof_kind first_proof 0
            match selfhost_memo_trait_neplproof_decoded_artifact_stage0_records_one first_record:
                Result::Ok records:
                    match selfhost_memo_trait_neplproof_decoded_artifact_stage0_run_artifact records accepted_fingerprint missing_fingerprint:
                        Result::Ok partial_summary:
                            let invalid_record_result %Result unit SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_stage0_invalid_record invalid_record
                            let accepted_collision_candidate_record %Result SelfhostMemoTraitNeplProofDecodedCandidateRecord SelfhostMemoTraitNeplProofDecodedArtifactErrorKind selfhost_memo_trait_neplproof_decoded_artifact_stage0_collision_candidate first_record second_same_fingerprint_record accepted_fingerprint
                            Result::Ok selfhost_memo_trait_neplproof_decoded_artifact_stage0_summary_new partial_summary.accepted_lookup partial_summary.accepted_candidate_record partial_summary.candidate_range_error partial_summary.candidate_offset_error partial_summary.candidate_target_error accepted_collision_candidate_record partial_summary.accepted_record partial_summary.accepted_index partial_summary.missing_lookup invalid_record_result
                        Result::Err _kind:
                            Result::Err StdErrorKind::InvalidOperation
                Result::Err e:
                    Result::Err e
        Result::Err _kind:
            Result::Err StdErrorKind::InvalidOperation
