            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_reader_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_neplproof_reader_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    match a:
        StdErrorKind::Failure:
            match b:
                StdErrorKind::Failure:
                    true
                _:
                    false
        StdErrorKind::OutOfMemory:
            match b:
                StdErrorKind::OutOfMemory:
                    true
                _:
                    false
        StdErrorKind::EmptyCollection:
            match b:
                StdErrorKind::EmptyCollection:
                    true
                _:
                    false
        StdErrorKind::IndexOutOfBounds:
            match b:
                StdErrorKind::IndexOutOfBounds:
                    true
                _:
                    false
        StdErrorKind::KeyNotFound:
            match b:
                StdErrorKind::KeyNotFound:
                    true
                _:
                    false
        StdErrorKind::CapacityExceeded:
            match b:
                StdErrorKind::CapacityExceeded:
                    true
                _:
                    false
        StdErrorKind::InvalidOperation:
            match b:
                StdErrorKind::InvalidOperation:
                    true
                _:
                    false
        StdErrorKind::InvalidUtf8:
            match b:
                StdErrorKind::InvalidUtf8:
                    true
                _:
                    false
        StdErrorKind::ParseError:
            match b:
                StdErrorKind::ParseError:
                    true
                _:
                    false
        StdErrorKind::IoError:
            match b:
                StdErrorKind::IoError:
                    true
                _:
                    false
        StdErrorKind::Other:
            match b:
                StdErrorKind::Other:
                    true
                _:
                    false

//: selfhost_memo_trait_neplproof_reader_error_kind_code: reader error の variant code を[返/かえ]す
//:
//: [目的/もくてき]:
//: - equality helper が、payload 比較に入る前に variant の違いを O(1) で切り分けられるようにします。
//: - code は診断表示や永続 artifact schema ではなく、同一 module 内の比較補助です。
fn selfhost_memo_trait_neplproof_reader_error_kind_code %fn SelfhostMemoTraitNeplProofReaderErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitNeplProofReaderErrorKind::MagicMismatch:
            1
        SelfhostMemoTraitNeplProofReaderErrorKind::WordReadInvalid _inner:
            2
        SelfhostMemoTraitNeplProofReaderErrorKind::HeaderInvalid _inner:
            3
        SelfhostMemoTraitNeplProofReaderErrorKind::RecordCountLimitExceeded:
            4
        SelfhostMemoTraitNeplProofReaderErrorKind::IndexCountLimitExceeded:
            5
        SelfhostMemoTraitNeplProofReaderErrorKind::IndexCountUnsupported:
            6
        SelfhostMemoTraitNeplProofReaderErrorKind::TrailingBytes:
            7
        SelfhostMemoTraitNeplProofReaderErrorKind::SourceKindTagInvalid:
            8
        SelfhostMemoTraitNeplProofReaderErrorKind::ProofKindTagInvalid:
            9
        SelfhostMemoTraitNeplProofReaderErrorKind::FieldEvidenceTagInvalid:
            10
        SelfhostMemoTraitNeplProofReaderErrorKind::FieldEvidencePayloadInvalid:
            11
        SelfhostMemoTraitNeplProofReaderErrorKind::ProofStatusTagInvalid:
            12
        SelfhostMemoTraitNeplProofReaderErrorKind::HazardTagInvalid:
            13
        SelfhostMemoTraitNeplProofReaderErrorKind::ResultTagInvalid:
            14
        SelfhostMemoTraitNeplProofReaderErrorKind::ResultPayloadInvalid:
            15
        SelfhostMemoTraitNeplProofReaderErrorKind::RejectKindTagInvalid:
            16
        SelfhostMemoTraitNeplProofReaderErrorKind::RecordInvalid _inner:
            17
        SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid _inner:
            18
        SelfhostMemoTraitNeplProofReaderErrorKind::IndexEntryInvalid _inner:
            19
        SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid _inner:
            20
        SelfhostMemoTraitNeplProofReaderErrorKind::DecodedArtifactInvalid _inner:
            21

//: selfhost_memo_trait_neplproof_reader_error_kind_eq: reader error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ variant は payload も比較します。
//: - non-payload variant は `reader_error_kind_code` で同じ variant と分かった後に true を返します。
pub fn selfhost_memo_trait_neplproof_reader_error_kind_eq %fn SelfhostMemoTraitNeplProofReaderErrorKind fn SelfhostMemoTraitNeplProofReaderErrorKind bool \a\b:
    if:
        ne selfhost_memo_trait_neplproof_reader_error_kind_code a selfhost_memo_trait_neplproof_reader_error_kind_code b
        then:
            false
        else:
            match a:
                SelfhostMemoTraitNeplProofReaderErrorKind::WordReadInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofReaderErrorKind::WordReadInvalid b_kind:
                            selfhost_memo_trait_artifact_word_codec_read_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofReaderErrorKind::HeaderInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofReaderErrorKind::HeaderInvalid b_kind:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofReaderErrorKind::RecordInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofReaderErrorKind::RecordInvalid b_kind:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid b_kind:
                            selfhost_memo_trait_neplproof_reader_std_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofReaderErrorKind::IndexEntryInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofReaderErrorKind::IndexEntryInvalid b_kind:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid a_kind:
