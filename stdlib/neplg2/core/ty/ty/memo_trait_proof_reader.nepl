    let field_count %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 20
    let copy_tag %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 21
    let drop_tag %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 22
