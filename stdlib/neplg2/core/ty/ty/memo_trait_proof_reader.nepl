//: selfhost_memo_trait_neplproof_reader_record_only_bounds_result: record-only byte stream の件数と終端を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - この API は serialized index table を読まないため、header の `index_count` は generated sidecar index が作る件数と同じ `record_count` でなければいけません。
//: - byte 長は header prefix と fixed-width record table だけに一致する必要があります。短い入力は word read error と同じ `UnexpectedEnd`、長い入力は `TrailingBytes` にします。
fn selfhost_memo_trait_neplproof_reader_record_only_bounds_result %fn &Vec u8 fn SelfhostMemoTraitNeplProofHeader Result unit SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header:
    if:
        gt header.record_count selfhost_memo_trait_neplproof_reader_record_count_limit
        then:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordCountLimitExceeded
        else:
            if:
                ne header.index_count header.record_count
                then:
                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexCountUnsupported
                else:
                    let expected_bytes %i32 mul selfhost_memo_trait_neplproof_reader_expected_record_only_words header 4
                    let actual_bytes %i32 v::len bytes
                    if:
                        lt actual_bytes expected_bytes
                        then:
                            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::WordReadInvalid SelfhostMemoTraitArtifactWordReadErrorKind::UnexpectedEnd
                        else:
                            if:
                                gt actual_bytes expected_bytes
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::TrailingBytes
                                else:
                                    Result::Ok unit

//: selfhost_memo_trait_neplproof_reader_record_push: decoded record vector へ record を[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `SelfhostMemoTraitNeplProofRecord` は Copy payload なので、push failure では rejected item を閉じる必要はありません。
//: - push failure では stdlib Vec が返した owner をこの helper が閉じ、error kind だけを reader error へ残します。
fn selfhost_memo_trait_neplproof_reader_record_push %impure fn Vec SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord Result Vec SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofReaderErrorKind \records\record:
    match v::push records record:
        Result::Ok next_records:
            Result::Ok next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid error

//: selfhost_memo_trait_neplproof_reader_records_loop: record table を先頭から順に[読/よ]む
//:
//: [契約/けいやく]:
//: - 成功時だけ record vector owner を返します。
//: - 途中で decode / validation / push が失敗した場合、partial record vector はここで閉じます。
fn selfhost_memo_trait_neplproof_reader_records_loop %impure fn &Vec u8 impure fn Vec SelfhostMemoTraitNeplProofRecord impure fn i32 impure fn i32 Result Vec SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofReaderErrorKind \bytes\records\idx\record_count:
    if:
        ge idx record_count
        then:
            Result::Ok records
        else:
            match selfhost_memo_trait_neplproof_reader_record_result bytes idx:
                Result::Ok record:
                    match selfhost_memo_trait_neplproof_reader_record_push records record:
                        Result::Ok next_records:
                            selfhost_memo_trait_neplproof_reader_records_loop bytes next_records add idx 1 record_count
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    v::free records
                    Result::Err e

//: selfhost_memo_trait_neplproof_reader_records_unbounded_result: 終端検査済み bytes から record vector owner を[読/よ]む
//:
//: [契約/けいやく]:
//: - caller は record-only bounds または indexed bounds を先に検査します。
//: - この helper は record 件数上限と record table decode だけを担当し、後続 section の有無を判定しません。
fn selfhost_memo_trait_neplproof_reader_records_unbounded_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result Vec SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header:
    if:
        gt header.record_count selfhost_memo_trait_neplproof_reader_record_count_limit
        then:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordCountLimitExceeded
        else:
            let records_result %Result Vec SelfhostMemoTraitNeplProofRecord StdErrorKind v::new
            match records_result:
                Result::Ok records:
                    selfhost_memo_trait_neplproof_reader_records_loop bytes records 0 header.record_count
                Result::Err e:
                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid e

//: selfhost_memo_trait_neplproof_reader_records_result: header 検査済み bytes から record vector owner を[読/よ]む
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(records)`: caller が owner を受け取り、decoded artifact へ移すか `v::free` で閉じます。
//: - `Err(kind)`: allocation 失敗、終端不整合、tag 不整合、record schema validation failure のいずれかです。partial owner はこの関数内で閉じます。
fn selfhost_memo_trait_neplproof_reader_records_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result Vec SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header:
    match selfhost_memo_trait_neplproof_reader_record_only_bounds_result bytes header:
        Result::Ok _bounds:
            selfhost_memo_trait_neplproof_reader_records_unbounded_result bytes header
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_indexed_bounds_result: indexed byte stream の件数と終端を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - この API は serialized index table までを読むため、header の `index_count` をそのまま index table 件数として扱います。
//: - byte 長は header prefix、fixed-width record table、fixed-width index table だけに一致する必要があります。payload section 付き artifact は payload reader extension が別途扱います。
fn selfhost_memo_trait_neplproof_reader_indexed_bounds_result %fn &Vec u8 fn SelfhostMemoTraitNeplProofHeader Result unit SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header:
    if:
        gt header.record_count selfhost_memo_trait_neplproof_reader_record_count_limit
        then:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordCountLimitExceeded
        else:
            if:
                gt header.index_count selfhost_memo_trait_neplproof_reader_index_count_limit
                then:
                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexCountLimitExceeded
                else:
                    let expected_bytes %i32 mul selfhost_memo_trait_neplproof_reader_expected_indexed_words header 4
                    let actual_bytes %i32 v::len bytes
                    if:
                        lt actual_bytes expected_bytes
                        then:
                            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::WordReadInvalid SelfhostMemoTraitArtifactWordReadErrorKind::UnexpectedEnd
                        else:
                            if:
                                gt actual_bytes expected_bytes
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::TrailingBytes
                                else:
                                    Result::Ok unit

//: selfhost_memo_trait_neplproof_reader_index_word_push: index word vector へ scalar word を[追加/ついか]する
fn selfhost_memo_trait_neplproof_reader_index_word_push %impure fn Vec i32 impure fn i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \words\word:
    match v::push words word:
        Result::Ok out:
            Result::Ok out
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid error

//: selfhost_memo_trait_neplproof_reader_index_words_loop: 1 index entry の fixed-width word を[線形/せんけい]に[読/よ]む
fn selfhost_memo_trait_neplproof_reader_index_words_loop %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader impure fn i32 impure fn i32 impure fn Vec i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header\index_ordinal\idx\words:
    if:
        ge idx selfhost_memo_trait_neplproof_reader_index_words
        then:
            Result::Ok words
        else:
            match selfhost_memo_trait_neplproof_reader_index_word_result bytes header index_ordinal idx:
                Result::Ok word:
                    match selfhost_memo_trait_neplproof_reader_index_word_push words word:
                        Result::Ok next_words:
                            selfhost_memo_trait_neplproof_reader_index_words_loop bytes header index_ordinal add idx 1 next_words
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    v::free words
                    Result::Err e

//: selfhost_memo_trait_neplproof_reader_index_words_result: 1 index entry の fixed-width word vector を[作/つく]る
fn selfhost_memo_trait_neplproof_reader_index_words_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader impure fn i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header\index_ordinal:
    let words_result %Result Vec i32 StdErrorKind v::new
    match words_result:
        Result::Ok words:
            selfhost_memo_trait_neplproof_reader_index_words_loop bytes header index_ordinal 0 words
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid e

//: selfhost_memo_trait_neplproof_reader_index_word_or_zero: fixed-width index field を[読/よ]む
fn selfhost_memo_trait_neplproof_reader_index_word_or_zero %fn &Vec i32 fn i32 i32 \words\idx:
    match v::get words idx:
        Option::Some word:
            word
        Option::None:
            0

//: selfhost_memo_trait_neplproof_reader_index_from_words_result: word vector から typed index entry を[戻/もど]す
fn selfhost_memo_trait_neplproof_reader_index_from_words_result %fn &Vec i32 fn i32 Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind \words\record_count:
    let fingerprint_schema %i32 selfhost_memo_trait_neplproof_reader_index_word_or_zero words 0
    let fingerprint_root_hash %i32 selfhost_memo_trait_neplproof_reader_index_word_or_zero words 1
    let record_ordinal %i32 selfhost_memo_trait_neplproof_reader_index_word_or_zero words 2
    let record_payload_hash %i32 selfhost_memo_trait_neplproof_reader_index_word_or_zero words 3
    match selfhost_memo_trait_neplproof_index_entry_from_parts_result fingerprint_schema fingerprint_root_hash record_ordinal record_payload_hash record_count:
        Result::Ok entry:
            Result::Ok entry
        Result::Err kind:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexEntryInvalid kind

//: selfhost_memo_trait_neplproof_reader_index_result: index ordinal から typed artifact index entry を[読/よ]む
fn selfhost_memo_trait_neplproof_reader_index_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader impure fn i32 Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header\index_ordinal:
    match selfhost_memo_trait_neplproof_reader_index_words_result bytes header index_ordinal:
        Result::Ok words:
            let index_result %Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind selfhost_memo_trait_neplproof_reader_index_from_words_result &words header.record_count
            v::free words
            index_result
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_index_push: decoded index vector へ entry を[追加/ついか]する
fn selfhost_memo_trait_neplproof_reader_index_push %impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitNeplProofIndexEntry Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind \indexes\entry:
    match v::push indexes entry:
        Result::Ok next_indexes:
            Result::Ok next_indexes
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid error

//: selfhost_memo_trait_neplproof_reader_indexes_loop: serialized index table を先頭から順に[読/よ]む
fn selfhost_memo_trait_neplproof_reader_indexes_loop %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn i32 Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header\indexes\idx:
    if:
        ge idx header.index_count
        then:
            Result::Ok indexes
        else:
            match selfhost_memo_trait_neplproof_reader_index_result bytes header idx:
                Result::Ok entry:
                    match selfhost_memo_trait_neplproof_reader_index_push indexes entry:
                        Result::Ok next_indexes:
                            selfhost_memo_trait_neplproof_reader_indexes_loop bytes header next_indexes add idx 1
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    v::free indexes
                    Result::Err e

//: selfhost_memo_trait_neplproof_reader_indexes_result: header 検査済み bytes から serialized index vector owner を[読/よ]む
fn selfhost_memo_trait_neplproof_reader_indexes_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofReaderErrorKind \bytes\header:
    match selfhost_memo_trait_neplproof_reader_indexed_bounds_result bytes header:
        Result::Ok _bounds:
            let indexes_result %Result Vec SelfhostMemoTraitNeplProofIndexEntry StdErrorKind v::new
            match indexes_result:
                Result::Ok indexes:
                    selfhost_memo_trait_neplproof_reader_indexes_loop bytes header indexes 0
                Result::Err e:
                    Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::IndexPushInvalid e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_decoded_artifact_from_record_bytes_result: record-only bytes から decoded artifact owner を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` header と record table を typed record vector へ戻し、generated sorted sidecar index 付き decoded artifact owner として返します。
//:
//: [契約/けいやく]:
//: - この関数は proof store へ投入せず、proof acceptance も行いません。
//: - 成功時の owner は caller が `selfhost_memo_trait_neplproof_decoded_artifact_free` で閉じます。
//: - decoded artifact constructor が拒否した場合、record vector owner は constructor 側で閉じられます。
pub fn selfhost_memo_trait_neplproof_reader_decoded_artifact_from_record_bytes_result %impure fn &Vec u8 Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofReaderErrorKind \bytes:
    match selfhost_memo_trait_neplproof_reader_header_result bytes:
        Result::Ok header:
            match selfhost_memo_trait_neplproof_reader_records_result bytes header:
                Result::Ok records:
                    match selfhost_memo_trait_neplproof_decoded_artifact_from_records records:
                        Result::Ok artifact:
                            Result::Ok artifact
                        Result::Err e:
                            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::DecodedArtifactInvalid e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_decoded_artifact_from_indexed_record_bytes_result: serialized index table 付き bytes から decoded artifact owner を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` header、record table、serialized sidecar index table を typed owner へ戻します。
//:
//: [契約/けいやく]:
//: - この関数は proof store へ投入せず、proof acceptance も行いません。
//: - reader は index table を読みますが、index hit だけで proof を受理しません。decoded artifact accessor と preseed / proof store gate が後続で再検査します。
//: - 成功時の owner は caller が `selfhost_memo_trait_neplproof_decoded_artifact_free` で閉じます。
//: - decoded artifact constructor が拒否した場合、record vector owner と index vector owner は constructor 側で閉じられます。
pub fn selfhost_memo_trait_neplproof_reader_decoded_artifact_from_indexed_record_bytes_result %impure fn &Vec u8 Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofReaderErrorKind \bytes:
    match selfhost_memo_trait_neplproof_reader_header_result bytes:
        Result::Ok header:
            match selfhost_memo_trait_neplproof_reader_indexed_bounds_result bytes header:
                Result::Ok _bounds:
                    match selfhost_memo_trait_neplproof_reader_records_unbounded_result bytes header:
                        Result::Ok records:
                            match selfhost_memo_trait_neplproof_reader_indexes_result bytes header:
                                Result::Ok indexes:
                                    match selfhost_memo_trait_neplproof_decoded_artifact_from_record_and_index_tables header records indexes:
                                        Result::Ok artifact:
                                            Result::Ok artifact
                                        Result::Err e:
                                            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::DecodedArtifactInvalid e
                                Result::Err e:
                                    v::free records
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_decoded_artifact_result_is_ok: decoded artifact reader result が成功か[返/かえ]す
pub fn selfhost_memo_trait_neplproof_reader_decoded_artifact_result_is_ok %fn Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofReaderErrorKind bool \result:
    match result:
