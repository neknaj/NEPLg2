pub fn selfhost_memo_trait_neplproof_reader_unit_result_is_ok %fn Result unit SelfhostMemoTraitNeplProofReaderErrorKind bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_reader_decoded_artifact_unit_result: stage0 用に artifact owner を[閉/と]じて unit result へ[写/うつ]す
fn selfhost_memo_trait_neplproof_reader_decoded_artifact_unit_result %impure fn Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofReaderErrorKind Result unit SelfhostMemoTraitNeplProofReaderErrorKind \result:
    match result:
        Result::Ok artifact:
            selfhost_memo_trait_neplproof_decoded_artifact_free artifact
            Result::Ok unit
