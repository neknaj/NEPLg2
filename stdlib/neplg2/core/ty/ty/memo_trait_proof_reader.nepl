                    let rules %SelfhostMemoTraitRuleIdentity selfhost_memo_trait_rule_identity_new rule_schema solver_version primitive_rule_hash aggregate_rule_hash hazard_rule_hash
                    Result::Ok selfhost_memo_trait_proof_store_policy_new sources rules
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_reader_proof_from_words_result: record 内の stored proof word 群を typed proof へ[戻/もど]す
fn selfhost_memo_trait_neplproof_reader_proof_from_words_result %fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostMemoTraitStoredAggregateProof SelfhostMemoTraitNeplProofReaderErrorKind \field_tag\first_field\field_count\copy_tag\drop_tag\eq_tag\hash_tag\hazard_tag\key_result_tag\key_result_payload\value_result_tag\value_result_payload:
    match selfhost_memo_trait_neplproof_reader_field_evidence_result field_tag first_field field_count:
