    let value_kind %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 8
    let value_module %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 9
    let value_symbol %i32 selfhost_memo_trait_neplproof_reader_record_word_or_zero words 10
