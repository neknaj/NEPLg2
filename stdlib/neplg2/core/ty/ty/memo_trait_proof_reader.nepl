//: selfhost_memo_trait_neplproof_reader_record_result: record ordinal から typed artifact record を[読/よ]む
fn selfhost_memo_trait_neplproof_reader_record_result %impure fn &Vec u8 impure fn i32 Result SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofReaderErrorKind \bytes\record_ordinal:
