//: selfhost_memo_trait_neplproof_reader_record_word_push: record word vector へ scalar word を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - fixed-width record を深い `match` の連鎖で読むと、型検査の prefix call 解決と branch 統合の探索が不要に大きくなります。
//: - reader はまず 31 word を小さな linear loop で読み、後続の schema/tag validator は `Vec i32` から field を参照します。
//:
//: [契約/けいやく]:
//: - 成功時だけ新しい word vector owner を返します。
//: - push failure では `VecPushError` に入っている元 owner を閉じ、error kind だけを typed reader error として返します。
fn selfhost_memo_trait_neplproof_reader_record_word_push %impure fn Vec i32 impure fn i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \words\word:
    match v::push words word:
        Result::Ok out:
            Result::Ok out
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid error

//: selfhost_memo_trait_neplproof_reader_record_words_loop: 1 record の fixed-width word を[線形/せんけい]に[読/よ]む
//:
//: [契約/けいやく]:
//: - `idx` は record-local field ordinal です。
//: - word decode が失敗した場合、途中まで構築した `words` owner はこの関数が閉じます。
//: - 成功時はちょうど `selfhost_memo_trait_neplproof_reader_record_words` 件の word を持つ owner を返します。
fn selfhost_memo_trait_neplproof_reader_record_words_loop %impure fn &Vec u8 impure fn i32 impure fn i32 impure fn Vec i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \bytes\record_ordinal\idx\words:
    if:
        ge idx selfhost_memo_trait_neplproof_reader_record_words
        then:
            Result::Ok words
        else:
            match selfhost_memo_trait_neplproof_reader_record_word_result bytes record_ordinal idx:
                Result::Ok word:
                    match selfhost_memo_trait_neplproof_reader_record_word_push words word:
                        Result::Ok next_words:
                            selfhost_memo_trait_neplproof_reader_record_words_loop bytes record_ordinal add idx 1 next_words
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    v::free words
                    Result::Err e

//: selfhost_memo_trait_neplproof_reader_record_words_result: 1 record の fixed-width word vector を[作/つく]る
fn selfhost_memo_trait_neplproof_reader_record_words_result %impure fn &Vec u8 impure fn i32 Result Vec i32 SelfhostMemoTraitNeplProofReaderErrorKind \bytes\record_ordinal:
    let words_result %Result Vec i32 StdErrorKind v::new
    match words_result:
        Result::Ok words:
            selfhost_memo_trait_neplproof_reader_record_words_loop bytes record_ordinal 0 words
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofReaderErrorKind::RecordPushInvalid e

//: selfhost_memo_trait_neplproof_reader_record_word_or_zero: fixed-width record field を[読/よ]む
//:
//: [契約/けいやく]:
//: - `record_words_result` が成功していれば、version 1 record の field はすべて存在します。
//: - defensive に欠けた field を見た場合は `0` を返します。version 1 では schema version、tag、hash の `0` はすべて validator で拒否されるため、欠落 field が accepted record へ化けることはありません。
fn selfhost_memo_trait_neplproof_reader_record_word_or_zero %fn &Vec i32 fn i32 i32 \words\idx:
    match v::get words idx:
        Option::Some word:
            word
        Option::None:
            0

//: selfhost_memo_trait_neplproof_reader_record_key_from_words_result: word vector から key/policy payload を[戻/もど]す
fn selfhost_memo_trait_neplproof_reader_record_key_from_words_result %fn &Vec i32 Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofReaderErrorKind \words:
