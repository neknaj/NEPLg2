                                        Result::Ok hash_proof:
                                            match selfhost_memo_trait_neplproof_reader_hazard_result hazard_tag:
                                                Result::Ok hazard:
                                                    match selfhost_memo_trait_neplproof_reader_memo_result_result key_result_tag key_result_payload:
                                                        Result::Ok key_result:
                                                            match selfhost_memo_trait_neplproof_reader_memo_result_result value_result_tag value_result_payload:
                                                                Result::Ok value_result:
                                                                    Result::Ok selfhost_memo_trait_stored_aggregate_proof_new fields copy_proof drop_proof eq_proof hash_proof hazard key_result value_result
                                                                Result::Err e:
