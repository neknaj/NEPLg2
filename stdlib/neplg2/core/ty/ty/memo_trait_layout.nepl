//: selfhost_memo_trait_layout_evidence_for_type_result: TypeId から aggregate field evidence を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` aggregate solver が、type record variant と constructor layout table の整合性を 1 箇所で確認できるようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(Known(range))`: constructor layout と field table は producer gate の field evidence として使えます。
//: - `Err(kind)`: layout 欠落、型 record 欠落、未解決 parameter、arity mismatch などのため fail-closed に拒否します。
//:
//: [計算量/けいさんりょう]:
//: - named は layout lookup O(n) と field validation O(m) です。
//: - applied は layout lookup O(n)、type argument validation O(k)、field validation O(m) です。
pub fn selfhost_memo_trait_layout_evidence_for_type_result %fn &SelfhostMemoTraitLayoutEvidenceTable fn &SelfhostTypeArena fn SelfhostTypeId Result SelfhostMemoTraitAggregateFieldEvidence SelfhostMemoTraitLayoutEvidenceErrorKind \table\types\type_id:
    match selfhost_type_arena_get_record types type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive _kind:
                    Result::Err SelfhostMemoTraitLayoutEvidenceErrorKind::TargetNotAggregate
                SelfhostTypeRecord::Named named:
                    selfhost_memo_trait_layout_named_result table types selfhost_named_type_record_id named
                SelfhostTypeRecord::Parameter _parameter:
                    Result::Err SelfhostMemoTraitLayoutEvidenceErrorKind::GenericArgumentUnsubstituted
                SelfhostTypeRecord::Applied applied:
                    selfhost_memo_trait_layout_applied_result table types type_id applied
                SelfhostTypeRecord::Function _function:
                    Result::Err SelfhostMemoTraitLayoutEvidenceErrorKind::TargetNotAggregate
        Option::None:
            Result::Err SelfhostMemoTraitLayoutEvidenceErrorKind::MissingTypeRecord

