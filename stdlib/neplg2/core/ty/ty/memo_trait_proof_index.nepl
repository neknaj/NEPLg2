//: selfhost_memo_trait_neplproof_index_candidate_range_eq: candidate range payload が同じか[返/かえ]す
//:
//: [目的/もくてき]:
//: - doctest と caller が candidate range を bool/string へ潰さず、typed field の一致として確認できるようにします。
pub fn selfhost_memo_trait_neplproof_index_candidate_range_eq %fn SelfhostMemoTraitNeplProofIndexCandidateRange fn SelfhostMemoTraitNeplProofIndexCandidateRange bool \a\b:
    and:
        eq a.start_index b.start_index
        eq a.candidate_count b.candidate_count

//: selfhost_memo_trait_neplproof_sorted_index_error_kind_eq: sorted index error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ variant は payload も比較します。
//: - wildcard arm は使いません。error variant を追加した場合、この equality も明示的に更新します。
pub fn selfhost_memo_trait_neplproof_sorted_index_error_kind_eq %fn SelfhostMemoTraitNeplProofSortedIndexErrorKind fn SelfhostMemoTraitNeplProofSortedIndexErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid a_kind:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid b_kind:
                    selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected a_kind:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected b_kind:
                    selfhost_memo_trait_neplproof_index_validation_error_kind_eq a_kind b_kind
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    true

//: selfhost_memo_trait_neplproof_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `StdErrorKind` は payload を持たない enum なので、網羅 match で作った code を equality にだけ使います。
//: - wildcard arm は使いません。variant 追加時はこの match が更新漏れを検出します。
fn selfhost_memo_trait_neplproof_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            0
        StdErrorKind::OutOfMemory:
            1
        StdErrorKind::EmptyCollection:
            2
        StdErrorKind::IndexOutOfBounds:
            3
        StdErrorKind::KeyNotFound:
            4
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            6
        StdErrorKind::InvalidUtf8:
            7
        StdErrorKind::ParseError:
            8
        StdErrorKind::IoError:
            9
        StdErrorKind::Other:
            10

//: selfhost_memo_trait_neplproof_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_neplproof_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    eq selfhost_memo_trait_neplproof_std_error_kind_code a selfhost_memo_trait_neplproof_std_error_kind_code b

//: selfhost_memo_trait_neplproof_index_producer_error_kind_eq: producer error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ variant は payload も比較します。
//: - wildcard arm は使いません。error variant を追加した場合、この equality も明示的に更新します。
pub fn selfhost_memo_trait_neplproof_index_producer_error_kind_eq %fn SelfhostMemoTraitNeplProofIndexProducerErrorKind fn SelfhostMemoTraitNeplProofIndexProducerErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofIndexProducerErrorKind::HeaderInvalid a_kind:
            match b:
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::HeaderInvalid b_kind:
                    selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::AllocFailed _b_kind:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::PushFailed _b_kind:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::RecordEntryMissing:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::RecordInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::IndexEntryBuildRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::ProducedTableRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofIndexProducerErrorKind::ProducedOrderRejected _b_kind:
                    false
