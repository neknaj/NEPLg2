    let proof %SelfhostMemoTraitStoredAggregateProof selfhost_memo_trait_neplproof_sorted_index_stage0_proof
    let first_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 1001
    let second_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 2002
    let missing_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 3003
    let first_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema first_fingerprint 3003 policy
    let second_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema second_fingerprint 3004 policy
    let second_same_fingerprint_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema first_fingerprint 3005 policy
    let first_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 4004
    let second_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord second_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let second_same_fingerprint_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord second_same_fingerprint_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let accepted_header %SelfhostMemoTraitNeplProofHeader SelfhostMemoTraitNeplProofHeader selfhost_memo_trait_neplproof_artifact_schema_version canonical_schema policy_schema 2 2
    let first_index %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry first_fingerprint 0 4004
    let second_index %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry second_fingerprint 1 5005
    let collision_second_index %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry first_fingerprint 1 5005
    let fingerprint_unsorted_first %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry second_fingerprint 1 5005
