#indent 4

//: # ty/memo_trait_proof_index
//: `.neplproof` artifact の sidecar index を、reader / preseed の[前段/ぜんだん]で[安全/あんぜん]に[絞/しぼ]り[込/こ]むための contract module です。
//:
//: [目的/もくてき]:
//: - `memo_trait_proof_artifact.nepl` は decoded record / index table 全体の整合性を検査します。この module は、その検査済み table に対して serialized index が満たすべき sorted order と lookup range の contract を固定します。
//: - canonical fingerprint から index table 内の candidate range だけを返し、record payload、proof payload、policy、canonical payload hash の受理は後続の canonical payload decode、preseed decision、proof store lookup、producer gate に委譲します。
//: - lookup failure や index order corruption を bool や表示文字列へ潰さず、typed enum error として返します。
//:
//: [契約/けいやく]:
//: - `selfhost_memo_trait_neplproof_sorted_index_lookup_result` はまず header と decoded index table validation を再実行します。caller が「検査済み」と思っている table でも、この public boundary は fail-closed に同じ前提を確認します。
//: - sidecar index は canonical fingerprint、record ordinal、record payload hash だけを authority として持つ候補 index です。fingerprint hit は proof acceptance ではありません。
//: - sorted order は `(canonical_fingerprint.schema_version, canonical_fingerprint.root_hash, record_ordinal)` の昇順です。同じ fingerprint の entry は連続した collision group として扱い、canonical equality と policy equality は後続 proof store 側で絞ります。
//: - source text、span、path suffix、display name、diagnostic text、lexeme は lookup key、sort key、tie-break authority に入りません。
//: - proof store の stable sidecar index とは責務を混ぜません。この module は artifact record ordinal 候補を返すだけで、store-local canonical equality / policy / producer gate は proof store の責務です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(range)` は、sorted index table 内で同じ canonical fingerprint を持つ candidate group の開始 index と件数だけを表します。
//: - `Err(CandidateMissing)` は、table は有効だが対象 fingerprint group が存在しないことを表します。
//: - `Err(HeaderInvalid(_))`、`Err(TableValidationRejected(_))`、`Err(FingerprintOrderInvalid)`、`Err(RecordOrdinalOrderInvalid)`、`Err(IndexEntryMissing)` は artifact を fail-closed に拒否すべき破損を表します。
//:
//: [現状/げんじょう]:
//: - Phase 1 は decoded `Vec` 上で sorted contract と range lookup を行います。binary reader、serializer、persistent map、binary search は後続 slice です。
//: - 現実装の lookup は線形 scan です。ただし sorted order と candidate range の contract を先に固定することで、後続 serializer / reader は同じ Result 型を保ったまま binary search や persistent stable map へ置き換えられます。
//:
//: [計算量/けいさんりょう]:
//: - header / table validation は `memo_trait_proof_artifact.nepl` の既存検査に従います。現 stage では record 数 n と index 数 m に対して O(n * m + m * m) の coverage 検査を含みます。
//: - sorted order check は index 数 m に対して O(m) です。
//: - candidate range lookup は現 stage では O(m) です。sorted contract があるため、後続では O(log m + c) に置き換えられます。c は同じ fingerprint の collision candidate 数です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_artifact" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_index" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_neplproof_sorted_index_stage0:
//:         Result::Ok summary:
//:             let expected_range SelfhostMemoTraitNeplProofIndexCandidateRange 0 1
//:             let expected_collision_range SelfhostMemoTraitNeplProofIndexCandidateRange 0 2
//:             let checks1 checks_push checks0 check selfhost_memo_trait_neplproof_index_candidate_range_eq (unwrap_ok summary.accepted_range) expected_range
//:             let checks2 checks_push checks1 check selfhost_memo_trait_neplproof_index_candidate_range_eq (unwrap_ok summary.accepted_collision_range) expected_collision_range
//:             let checks3 checks_push checks2 check selfhost_memo_trait_neplproof_sorted_index_error_kind_eq (unwrap_err summary.missing_candidate) SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing
//:             let checks4 checks_push checks3 check selfhost_memo_trait_neplproof_sorted_index_error_kind_eq (unwrap_err summary.fingerprint_unsorted) SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid
//:             let checks5 checks_push checks4 check selfhost_memo_trait_neplproof_sorted_index_error_kind_eq (unwrap_err summary.ordinal_unsorted) SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid
//:             let checks6 checks_push checks5 check selfhost_memo_trait_neplproof_sorted_index_error_kind_eq (unwrap_err summary.table_rejected) SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexRecordMismatch
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "sorted neplproof index stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./memo_trait" as *
#import "./memo_trait_canonical_key" as *
#import "./memo_trait_canonical_key_payload" as *
#import "./memo_trait_policy" as *
#import "./memo_trait_proof_artifact" as *
#import "./memo_trait_proof_store" as *

//: SelfhostMemoTraitNeplProofIndexCandidateRange: sorted sidecar index 内の candidate group
//:
//: [目的/もくてき]:
//: - canonical fingerprint が一致した index entry 群の範囲を、proof payload から分離して表します。
//:
//: [契約/けいやく]:
//: - `start_index` は index vector 内の開始位置です。
//: - `candidate_count` は同じ fingerprint を持つ連続 entry 数です。
//: - この range は proof acceptance ではありません。caller は各 entry が指す record を読み、canonical payload decode、payload hash 再計算、policy、proof kind、producer gate を続けて通します。
pub struct SelfhostMemoTraitNeplProofIndexCandidateRange:
    start_index %i32
    candidate_count %i32

//: SelfhostMemoTraitNeplProofSortedIndexErrorKind: sorted artifact index lookup の拒否理由
//:
//: [目的/もくてき]:
//: - header / decoded table validation、sort order corruption、candidate missing を 1 つの typed error として caller へ返します。
//:
//: [分類/ぶんるい]:
//: - `HeaderInvalid`: header schema / count boundary が artifact schema validator に拒否されました。
//: - `TableValidationRejected`: decoded record / index table の aggregate validation が拒否されました。
//: - `IndexEntryMissing`: vector length 上は存在するはずの index entry を読み出せない defensive failure です。
//: - `FingerprintOrderInvalid`: fingerprint の昇順が壊れています。
//: - `RecordOrdinalOrderInvalid`: 同じ fingerprint group 内の record ordinal 昇順が壊れています。
//: - `CandidateMissing`: artifact は有効ですが、対象 fingerprint の candidate group がありません。
pub enum SelfhostMemoTraitNeplProofSortedIndexErrorKind:
    HeaderInvalid %SelfhostMemoTraitNeplProofArtifactErrorKind
    TableValidationRejected %SelfhostMemoTraitNeplProofIndexValidationErrorKind
    IndexEntryMissing
    FingerprintOrderInvalid
    RecordOrdinalOrderInvalid
    CandidateMissing

//: SelfhostMemoTraitNeplProofSortedIndexStage0Summary: sorted index contract の代表 smoke
pub struct SelfhostMemoTraitNeplProofSortedIndexStage0Summary:
    accepted_range %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind
    accepted_collision_range %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind
    missing_candidate %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind
    fingerprint_unsorted %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind
    ordinal_unsorted %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind
    table_rejected %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind

impl Clone for SelfhostMemoTraitNeplProofIndexCandidateRange:
    fn clone %fn &SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofIndexCandidateRange \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofIndexCandidateRange:
    fn copy_mark %fn SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofIndexCandidateRange \self:
        self

impl Clone for SelfhostMemoTraitNeplProofSortedIndexErrorKind:
    fn clone %fn &SelfhostMemoTraitNeplProofSortedIndexErrorKind SelfhostMemoTraitNeplProofSortedIndexErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofSortedIndexErrorKind:
    fn copy_mark %fn SelfhostMemoTraitNeplProofSortedIndexErrorKind SelfhostMemoTraitNeplProofSortedIndexErrorKind \self:
        self

impl Clone for SelfhostMemoTraitNeplProofSortedIndexStage0Summary:
    fn clone %fn &SelfhostMemoTraitNeplProofSortedIndexStage0Summary SelfhostMemoTraitNeplProofSortedIndexStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofSortedIndexStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitNeplProofSortedIndexStage0Summary SelfhostMemoTraitNeplProofSortedIndexStage0Summary \self:
        self

//: selfhost_memo_trait_neplproof_index_candidate_range_eq: candidate range payload が同じか[返/かえ]す
//:
//: [目的/もくてき]:
//: - doctest と caller が candidate range を bool/string へ潰さず、typed field の一致として確認できるようにします。
pub fn selfhost_memo_trait_neplproof_index_candidate_range_eq %fn SelfhostMemoTraitNeplProofIndexCandidateRange fn SelfhostMemoTraitNeplProofIndexCandidateRange bool \a\b:
    and:
        eq a.start_index b.start_index
        eq a.candidate_count b.candidate_count

//: selfhost_memo_trait_neplproof_sorted_index_error_kind_eq: sorted index error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ variant は payload も比較します。
//: - wildcard arm は使いません。error variant を追加した場合、この equality も明示的に更新します。
pub fn selfhost_memo_trait_neplproof_sorted_index_error_kind_eq %fn SelfhostMemoTraitNeplProofSortedIndexErrorKind fn SelfhostMemoTraitNeplProofSortedIndexErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid a_kind:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid b_kind:
                    selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected a_kind:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected b_kind:
                    selfhost_memo_trait_neplproof_index_validation_error_kind_eq a_kind b_kind
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    true
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    false
        SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
            match b:
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected _b_kind:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid:
                    false
                SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing:
                    true

//: selfhost_memo_trait_neplproof_fingerprint_lt: canonical fingerprint の stable order
//:
//: [契約/けいやく]:
//: - schema version を先に比較し、同じ schema の中で root hash を比較します。
//: - source text や表示名を tie-break に使いません。
fn selfhost_memo_trait_neplproof_fingerprint_lt %fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitCanonicalTypeFingerprint bool \a\b:
    if:
        lt a.schema_version b.schema_version
        then:
            true
        else:
            if:
                gt a.schema_version b.schema_version
                then:
                    false
                else:
                    lt a.root_hash b.root_hash

//: selfhost_memo_trait_neplproof_sorted_index_pair_result: 隣接 entry の sorted order を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - fingerprint が小さく戻る場合は `FingerprintOrderInvalid` です。
//: - fingerprint が同じ group では record ordinal が狭義に増加しなければいけません。
fn selfhost_memo_trait_neplproof_sorted_index_pair_result %fn SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofIndexEntry Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \previous\current:
    if:
        selfhost_memo_trait_neplproof_fingerprint_lt current.canonical_fingerprint previous.canonical_fingerprint
        then:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid
        else:
            if:
                selfhost_memo_trait_canonical_type_fingerprint_eq previous.canonical_fingerprint current.canonical_fingerprint
                then:
                    if:
                        ge previous.record_ordinal current.record_ordinal
                        then:
                            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid
                        else:
                            Result::Ok unit
                else:
                    Result::Ok unit

//: selfhost_memo_trait_neplproof_sorted_index_tail_loop: 2 件目以降の order を[検査/けんさ]する
fn selfhost_memo_trait_neplproof_sorted_index_tail_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofIndexEntry fn i32 Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\previous\idx:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Ok unit
        else:
            match v::get indexes idx:
                Option::Some current:
                    match selfhost_memo_trait_neplproof_sorted_index_pair_result previous current:
                        Result::Ok _unit:
                            selfhost_memo_trait_neplproof_sorted_index_tail_loop indexes current add idx 1
                        Result::Err kind:
                            Result::Err kind
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_order_result: index table の sorted order を[検査/けんさ]する
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: index table は candidate lookup 用の sorted order を満たします。
//: - `Err(kind)`: sorted order または defensive read が破損しています。
pub fn selfhost_memo_trait_neplproof_sorted_index_order_result %fn &Vec SelfhostMemoTraitNeplProofIndexEntry Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes:
    let n %i32 v::len indexes
    if:
        le n 1
        then:
            Result::Ok unit
        else:
            match v::get indexes 0:
                Option::Some first:
                    selfhost_memo_trait_neplproof_sorted_index_tail_loop indexes first 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_candidate_range_count_loop: 同じ fingerprint group の[件数/けんすう]を[数/かぞ]える
fn selfhost_memo_trait_neplproof_candidate_range_count_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn i32 fn i32 Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\target\start\idx\count:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Ok SelfhostMemoTraitNeplProofIndexCandidateRange start count
        else:
            match v::get indexes idx:
                Option::Some entry:
                    if:
                        selfhost_memo_trait_canonical_type_fingerprint_eq entry.canonical_fingerprint target
                        then:
                            selfhost_memo_trait_neplproof_candidate_range_count_loop indexes target start add idx 1 add count 1
                        else:
                            Result::Ok SelfhostMemoTraitNeplProofIndexCandidateRange start count
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_candidate_range_lookup_loop: sorted index から target fingerprint group を[探/さが]す
fn selfhost_memo_trait_neplproof_candidate_range_lookup_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\target\idx:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing
        else:
            match v::get indexes idx:
                Option::Some entry:
                    if:
                        selfhost_memo_trait_canonical_type_fingerprint_eq entry.canonical_fingerprint target
                        then:
                            selfhost_memo_trait_neplproof_candidate_range_count_loop indexes target idx idx 0
                        else:
                            if:
                                selfhost_memo_trait_neplproof_fingerprint_lt target entry.canonical_fingerprint
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing
                                else:
                                    selfhost_memo_trait_neplproof_candidate_range_lookup_loop indexes target add idx 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_lookup_result: decoded `.neplproof` index から candidate range を[返/かえ]す
//:
//: [目的/もくてき]:
//: - reader が canonical fingerprint から record ordinal 候補の group へ進むための lookup boundary です。
//:
//: [契約/けいやく]:
//: - header validation、decoded index table validation、sorted order check をすべて通した後でなければ candidate range を返しません。
//: - `Ok(range)` は proof acceptance ではありません。caller は range 内の entry が指す record ごとに canonical payload decode、payload hash 再計算、policy、proof kind、proof store preseed / lookup を通します。
//: - index hit、fingerprint hit、record payload hash match だけで proof を受理する経路はありません。
pub fn selfhost_memo_trait_neplproof_sorted_index_lookup_result %fn SelfhostMemoTraitNeplProofHeader fn &Vec SelfhostMemoTraitNeplProofRecord fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \header\records\indexes\target:
    match selfhost_memo_trait_neplproof_header_result header.artifact_schema_version header.canonical_payload_schema_version header.policy_schema_version header.record_count header.index_count:
        Result::Ok checked_header:
            match selfhost_memo_trait_neplproof_index_table_result checked_header records indexes:
                Result::Ok _table_valid:
                    match selfhost_memo_trait_neplproof_sorted_index_order_result indexes:
                        Result::Ok _sorted:
                            selfhost_memo_trait_neplproof_candidate_range_lookup_loop indexes target 0
                        Result::Err kind:
                            Result::Err kind
                Result::Err kind:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected kind
        Result::Err kind:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid kind

//: selfhost_memo_trait_neplproof_sorted_index_result_is_ok: lookup result が accepted range か[返/かえ]す
pub fn selfhost_memo_trait_neplproof_sorted_index_result_is_ok %fn Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind bool \result:
    match result:
        Result::Ok _range:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_sorted_index_stage0_policy: focused smoke 用 policy を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_policy %fn i32 SelfhostMemoTraitProofStorePolicy \policy_schema:
    let key_source %SelfhostMemoTraitSourceIdentity selfhost_memo_trait_source_identity_new SelfhostMemoTraitSourceKind::MemoKeyTrait 10 11 12
    let value_source %SelfhostMemoTraitSourceIdentity selfhost_memo_trait_source_identity_new SelfhostMemoTraitSourceKind::MemoValueTrait 20 21 22
    let sources %SelfhostMemoTraitSourceIdentitySet selfhost_memo_trait_source_identity_set_new key_source value_source
    let rules %SelfhostMemoTraitRuleIdentity selfhost_memo_trait_rule_identity_new policy_schema 1 30 31 32
    selfhost_memo_trait_proof_store_policy_new sources rules

//: selfhost_memo_trait_neplproof_sorted_index_stage0_proof: focused smoke 用 proof を[作/つく]る
