//: selfhost_memo_trait_neplproof_fingerprint_lt: canonical fingerprint の stable order
//:
//: [契約/けいやく]:
//: - schema version を先に比較し、同じ schema の中で root hash を比較します。
//: - source text や表示名を tie-break に使いません。
fn selfhost_memo_trait_neplproof_fingerprint_lt %fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitCanonicalTypeFingerprint bool \a\b:
    if:
        lt a.schema_version b.schema_version
        then:
            true
        else:
            if:
                gt a.schema_version b.schema_version
                then:
                    false
                else:
                    lt a.root_hash b.root_hash

//: selfhost_memo_trait_neplproof_sorted_index_pair_result: 隣接 entry の sorted order を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - fingerprint が小さく戻る場合は `FingerprintOrderInvalid` です。
//: - fingerprint が同じ group では record ordinal が狭義に増加しなければいけません。
fn selfhost_memo_trait_neplproof_sorted_index_pair_result %fn SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofIndexEntry Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \previous\current:
    if:
        selfhost_memo_trait_neplproof_fingerprint_lt current.canonical_fingerprint previous.canonical_fingerprint
        then:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::FingerprintOrderInvalid
        else:
            if:
                selfhost_memo_trait_canonical_type_fingerprint_eq previous.canonical_fingerprint current.canonical_fingerprint
                then:
                    if:
                        ge previous.record_ordinal current.record_ordinal
                        then:
                            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::RecordOrdinalOrderInvalid
                        else:
                            Result::Ok unit
                else:
                    Result::Ok unit

//: selfhost_memo_trait_neplproof_sorted_index_tail_loop: 2 件目以降の order を[検査/けんさ]する
fn selfhost_memo_trait_neplproof_sorted_index_tail_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofIndexEntry fn i32 Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\previous\idx:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Ok unit
        else:
            match v::get indexes idx:
                Option::Some current:
                    match selfhost_memo_trait_neplproof_sorted_index_pair_result previous current:
                        Result::Ok _unit:
                            selfhost_memo_trait_neplproof_sorted_index_tail_loop indexes current add idx 1
                        Result::Err kind:
                            Result::Err kind
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_order_result: index table の sorted order を[検査/けんさ]する
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: index table は candidate lookup 用の sorted order を満たします。
//: - `Err(kind)`: sorted order または defensive read が破損しています。
pub fn selfhost_memo_trait_neplproof_sorted_index_order_result %fn &Vec SelfhostMemoTraitNeplProofIndexEntry Result unit SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes:
    let n %i32 v::len indexes
    if:
        le n 1
        then:
            Result::Ok unit
        else:
            match v::get indexes 0:
                Option::Some first:
                    selfhost_memo_trait_neplproof_sorted_index_tail_loop indexes first 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_candidate_range_count_loop: 同じ fingerprint group の[件数/けんすう]を[数/かぞ]える
fn selfhost_memo_trait_neplproof_candidate_range_count_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn i32 fn i32 Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\target\start\idx\count:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Ok SelfhostMemoTraitNeplProofIndexCandidateRange start count
        else:
            match v::get indexes idx:
                Option::Some entry:
                    if:
                        selfhost_memo_trait_canonical_type_fingerprint_eq entry.canonical_fingerprint target
                        then:
                            selfhost_memo_trait_neplproof_candidate_range_count_loop indexes target start add idx 1 add count 1
                        else:
                            Result::Ok SelfhostMemoTraitNeplProofIndexCandidateRange start count
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_candidate_range_lookup_loop: sorted index から target fingerprint group を[探/さが]す
fn selfhost_memo_trait_neplproof_candidate_range_lookup_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \indexes\target\idx:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing
        else:
            match v::get indexes idx:
                Option::Some entry:
                    if:
                        selfhost_memo_trait_canonical_type_fingerprint_eq entry.canonical_fingerprint target
                        then:
                            selfhost_memo_trait_neplproof_candidate_range_count_loop indexes target idx idx 0
                        else:
                            if:
                                selfhost_memo_trait_neplproof_fingerprint_lt target entry.canonical_fingerprint
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::CandidateMissing
                                else:
                                    selfhost_memo_trait_neplproof_candidate_range_lookup_loop indexes target add idx 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_lookup_result: decoded `.neplproof` index から candidate range を[返/かえ]す
//:
//: [目的/もくてき]:
//: - reader が canonical fingerprint から record ordinal 候補の group へ進むための lookup boundary です。
//:
//: [契約/けいやく]:
//: - header validation、decoded index table validation、sorted order check をすべて通した後でなければ candidate range を返しません。
//: - `Ok(range)` は proof acceptance ではありません。caller は range 内の entry が指す record ごとに canonical payload decode、payload hash 再計算、policy、proof kind、proof store preseed / lookup を通します。
//: - index hit、fingerprint hit、record payload hash match だけで proof を受理する経路はありません。
pub fn selfhost_memo_trait_neplproof_sorted_index_lookup_result %fn SelfhostMemoTraitNeplProofHeader fn &Vec SelfhostMemoTraitNeplProofRecord fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitCanonicalTypeFingerprint Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind \header\records\indexes\target:
    match selfhost_memo_trait_neplproof_header_result header.artifact_schema_version header.canonical_payload_schema_version header.policy_schema_version header.record_count header.index_count:
        Result::Ok checked_header:
            match selfhost_memo_trait_neplproof_index_table_result checked_header records indexes:
                Result::Ok _table_valid:
                    match selfhost_memo_trait_neplproof_sorted_index_order_result indexes:
                        Result::Ok _sorted:
                            selfhost_memo_trait_neplproof_candidate_range_lookup_loop indexes target 0
                        Result::Err kind:
                            Result::Err kind
                Result::Err kind:
                    Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::TableValidationRejected kind
        Result::Err kind:
            Result::Err SelfhostMemoTraitNeplProofSortedIndexErrorKind::HeaderInvalid kind

//: selfhost_memo_trait_neplproof_sorted_index_result_is_ok: lookup result が accepted range か[返/かえ]す
pub fn selfhost_memo_trait_neplproof_sorted_index_result_is_ok %fn Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind bool \result:
    match result:
        Result::Ok _range:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_sorted_index_entry_lt: sidecar entry の producer sort order
//:
//: [契約/けいやく]:
//: - 比較 key は lookup contract と同じ `(canonical_fingerprint.schema_version, canonical_fingerprint.root_hash, record_ordinal)` だけです。
//: - source text、span、path、display name、diagnostic text、lexeme、proof store stable identity は tie-break に使いません。
fn selfhost_memo_trait_neplproof_sorted_index_entry_lt %fn SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofIndexEntry bool \a\b:
    if:
        selfhost_memo_trait_neplproof_fingerprint_lt a.canonical_fingerprint b.canonical_fingerprint
        then:
            true
        else:
            if:
                selfhost_memo_trait_canonical_type_fingerprint_eq a.canonical_fingerprint b.canonical_fingerprint
                then:
                    lt a.record_ordinal b.record_ordinal
                else:
                    false

//: selfhost_memo_trait_neplproof_sorted_index_bubble_back_loop: push 済み entry を sorted order へ[戻/もど]す
//:
//: [目的/もくてき]:
//: - Phase 1 producer が追加した末尾 entry を、隣接 swap だけで既存 sorted contract と同じ順序へ移します。
//:
//: [契約/けいやく]:
//: - `indexes` の長さは変えません。
//: - `v::replace` は Copy entry の slot swap にだけ使い、record payload や proof payload は変更しません。
//: - 読み出しに失敗した場合は defensive failure として `IndexEntryMissing` を返します。ここで欠けているのは record ではなく、producer が作成中の index vector slot です。
fn selfhost_memo_trait_neplproof_sorted_index_bubble_back_loop %impure fn &Vec SelfhostMemoTraitNeplProofIndexEntry impure fn i32 Result unit SelfhostMemoTraitNeplProofIndexProducerErrorKind \indexes\idx:
    if:
        le idx 0
        then:
            Result::Ok unit
        else:
            let previous_idx %i32 sub idx 1
            match v::get indexes previous_idx:
                Option::Some previous:
                    match v::get indexes idx:
                        Option::Some current:
                            if:
                                selfhost_memo_trait_neplproof_sorted_index_entry_lt current previous
                                then:
                                    v::replace indexes previous_idx current
                                    v::replace indexes idx previous
                                    selfhost_memo_trait_neplproof_sorted_index_bubble_back_loop indexes previous_idx
                                else:
                                    Result::Ok unit
                        Option::None:
                            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::IndexEntryMissing
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_push_sorted: entry を[追加/ついか]し sorted order へ[整/ととの]える
//:
//: [契約/けいやく]:
//: - 成功時だけ新しい `Vec` owner を返します。
//: - `push` または bubble-back が失敗した場合、途中の `Vec` owner はこの helper が閉じます。
fn selfhost_memo_trait_neplproof_sorted_index_push_sorted %impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitNeplProofIndexEntry Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexProducerErrorKind \indexes\entry:
    match v::push indexes entry:
        Result::Ok next_indexes:
            let next_len %i32 v::len &next_indexes
            let pushed_index %i32 sub next_len 1
            match selfhost_memo_trait_neplproof_sorted_index_bubble_back_loop &next_indexes pushed_index:
                Result::Ok _sorted:
                    Result::Ok next_indexes
                Result::Err kind:
                    v::free next_indexes
                    Result::Err kind
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::PushFailed error

//: selfhost_memo_trait_neplproof_sorted_index_entry_from_record_result: record から sidecar entry を[作/つく]る
//:
//: [契約/けいやく]:
//: - record key と record body は必ず artifact validator へ再投入します。
//: - 作った index entry も artifact index entry validator へ通します。
//: - proof payload、policy、canonical payload hash は index entry へ複製しません。index entry は fingerprint、record ordinal、record payload hash だけを持ちます。
fn selfhost_memo_trait_neplproof_sorted_index_entry_from_record_result %fn SelfhostMemoTraitNeplProofRecord fn i32 fn i32 Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexProducerErrorKind \record\record_ordinal\record_count:
    match selfhost_memo_trait_neplproof_record_key_result record.key.canonical_fingerprint record.key.canonical_payload_schema_version record.key.canonical_payload_hash record.key.policy:
        Result::Ok checked_key:
            match selfhost_memo_trait_neplproof_record_result checked_key record.proof_kind record.proof record.record_payload_hash:
                Result::Ok _checked_record:
                    match selfhost_memo_trait_neplproof_index_entry_result record.key.canonical_fingerprint record_ordinal record.record_payload_hash record_count:
                        Result::Ok entry:
                            Result::Ok entry
                        Result::Err kind:
                            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::IndexEntryBuildRejected kind
                Result::Err kind:
                    Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::RecordInvalid kind
        Result::Err kind:
            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::RecordInvalid kind

//: selfhost_memo_trait_neplproof_sorted_index_build_loop: decoded records から sorted sidecar index を[構築/こうちく]する
//:
//: [契約/けいやく]:
//: - 成功時だけ index vector owner を返します。
//: - record validation、index entry construction、push、sort のいずれかが失敗した場合、partial index vector を閉じます。
fn selfhost_memo_trait_neplproof_sorted_index_build_loop %impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn &Vec SelfhostMemoTraitNeplProofRecord impure fn i32 impure fn i32 Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexProducerErrorKind \indexes\records\idx\record_count:
    if:
        ge idx record_count
        then:
            Result::Ok indexes
        else:
            match v::get records idx:
                Option::Some record:
                    match selfhost_memo_trait_neplproof_sorted_index_entry_from_record_result record idx record_count:
                        Result::Ok entry:
                            match selfhost_memo_trait_neplproof_sorted_index_push_sorted indexes entry:
                                Result::Ok next_indexes:
                                    selfhost_memo_trait_neplproof_sorted_index_build_loop next_indexes records add idx 1 record_count
                                Result::Err kind:
                                    Result::Err kind
                        Result::Err kind:
                            v::free indexes
                            Result::Err kind
                Option::None:
                    v::free indexes
                    Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::RecordEntryMissing

//: selfhost_memo_trait_neplproof_sorted_index_finish_build: producer output を既存 validator へ[通/とお]す
//:
//: [契約/けいやく]:
//: - producer が作った index vector は、返す前に header validation、decoded table validation、sorted order validation を通ります。
//: - 検証に失敗した場合、index vector owner はこの helper が閉じます。
fn selfhost_memo_trait_neplproof_sorted_index_finish_build %impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn &Vec SelfhostMemoTraitNeplProofRecord Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexProducerErrorKind \indexes\records:
    let record_count %i32 v::len records
    match selfhost_memo_trait_neplproof_header_result selfhost_memo_trait_neplproof_artifact_schema_version selfhost_memo_trait_canonical_key_payload_schema_version selfhost_memo_trait_neplproof_policy_schema_version record_count record_count:
        Result::Ok header:
            match selfhost_memo_trait_neplproof_index_table_result header records &indexes:
                Result::Ok _table_valid:
                    match selfhost_memo_trait_neplproof_sorted_index_order_result &indexes:
                        Result::Ok _order_valid:
                            Result::Ok indexes
                        Result::Err kind:
                            v::free indexes
                            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::ProducedOrderRejected kind
                Result::Err kind:
                    v::free indexes
                    Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::ProducedTableRejected kind
        Result::Err kind:
            v::free indexes
            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::HeaderInvalid kind

//: selfhost_memo_trait_neplproof_sorted_index_build_result: decoded records から sorted sidecar index を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` serializer / preseed writer が decoded record vector から、既存 lookup contract に入れられる sorted sidecar index vector を作るための public producer API です。
//:
//: [契約/けいやく]:
//: - 入力 record vector は借用し、成功時に index vector owner だけを返します。
//: - record ごとに 1 つの index entry を作り、record ordinal coverage と sorted order を既存 validator へ通した owner だけを返します。
//: - 返す index は proof acceptance ではありません。caller は lookup 後に canonical payload decode、payload hash 再計算、policy、proof kind、proof store preseed / lookup、producer gate を続けます。
//:
//: [計算量/けいさんりょう]:
//: - Phase 1 実装は insertion sort 相当のため O(n^2) です。後続の serialized stable map / binary writer では同じ Result contract を保って構築を高速化します。
pub fn selfhost_memo_trait_neplproof_sorted_index_build_result %impure fn &Vec SelfhostMemoTraitNeplProofRecord Result Vec SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexProducerErrorKind \records:
    let indexes_result %Result Vec SelfhostMemoTraitNeplProofIndexEntry StdErrorKind v::new
    match indexes_result:
        Result::Ok indexes0:
            let record_count %i32 v::len records
            match selfhost_memo_trait_neplproof_sorted_index_build_loop indexes0 records 0 record_count:
                Result::Ok built_indexes:
                    selfhost_memo_trait_neplproof_sorted_index_finish_build built_indexes records
                Result::Err kind:
                    Result::Err kind
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::AllocFailed e

//: selfhost_memo_trait_neplproof_sorted_index_stage0_policy: focused smoke 用 policy を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_policy %fn i32 SelfhostMemoTraitProofStorePolicy \policy_schema:
    let key_source %SelfhostMemoTraitSourceIdentity selfhost_memo_trait_source_identity_new SelfhostMemoTraitSourceKind::MemoKeyTrait 10 11 12
    let value_source %SelfhostMemoTraitSourceIdentity selfhost_memo_trait_source_identity_new SelfhostMemoTraitSourceKind::MemoValueTrait 20 21 22
    let sources %SelfhostMemoTraitSourceIdentitySet selfhost_memo_trait_source_identity_set_new key_source value_source
    let rules %SelfhostMemoTraitRuleIdentity selfhost_memo_trait_rule_identity_new policy_schema 1 30 31 32
    selfhost_memo_trait_proof_store_policy_new sources rules

//: selfhost_memo_trait_neplproof_sorted_index_stage0_proof: focused smoke 用 proof を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_proof %fn void SelfhostMemoTraitStoredAggregateProof \void:
    selfhost_memo_trait_stored_aggregate_proof_known_new 0 0 (Result::Ok unit) (Result::Ok unit)

//: selfhost_memo_trait_neplproof_sorted_index_record_push: stage0 record vector へ record を[追加/ついか]する
fn selfhost_memo_trait_neplproof_sorted_index_record_push %impure fn Vec SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord Result Vec SelfhostMemoTraitNeplProofRecord StdErrorKind \records\record:
    match v::push records record:
        Result::Ok next_records:
            Result::Ok next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_memo_trait_neplproof_sorted_index_index_push: stage0 index vector へ entry を[追加/ついか]する
fn selfhost_memo_trait_neplproof_sorted_index_index_push %impure fn Vec SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitNeplProofIndexEntry Result Vec SelfhostMemoTraitNeplProofIndexEntry StdErrorKind \indexes\entry:
    match v::push indexes entry:
        Result::Ok next_indexes:
            Result::Ok next_indexes
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_memo_trait_neplproof_sorted_index_stage0_records_two: 2 record の stage0 vector を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_records_two %impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord Result Vec SelfhostMemoTraitNeplProofRecord StdErrorKind \first\second:
    let records_result %Result Vec SelfhostMemoTraitNeplProofRecord StdErrorKind v::new
    match records_result:
        Result::Ok records0:
            match selfhost_memo_trait_neplproof_sorted_index_record_push records0 first:
                Result::Ok records1:
                    selfhost_memo_trait_neplproof_sorted_index_record_push records1 second
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_sorted_index_stage0_indexes_two: 2 index entry の stage0 vector を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_indexes_two %impure fn SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitNeplProofIndexEntry Result Vec SelfhostMemoTraitNeplProofIndexEntry StdErrorKind \first\second:
    let indexes_result %Result Vec SelfhostMemoTraitNeplProofIndexEntry StdErrorKind v::new
    match indexes_result:
        Result::Ok indexes0:
            match selfhost_memo_trait_neplproof_sorted_index_index_push indexes0 first:
                Result::Ok indexes1:
                    selfhost_memo_trait_neplproof_sorted_index_index_push indexes1 second
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_sorted_index_stage0_run_two_indexes: Vec owner を[閉/と]じながら lookup を[実行/じっこう]する
fn selfhost_memo_trait_neplproof_sorted_index_stage0_run_two_indexes %impure fn SelfhostMemoTraitNeplProofHeader impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitNeplProofIndexEntry impure fn SelfhostMemoTraitCanonicalTypeFingerprint Result Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind StdErrorKind \header\first_record\second_record\first_index\second_index\target:
    match selfhost_memo_trait_neplproof_sorted_index_stage0_records_two first_record second_record:
        Result::Ok records:
            match selfhost_memo_trait_neplproof_sorted_index_stage0_indexes_two first_index second_index:
                Result::Ok indexes:
                    let lookup %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind selfhost_memo_trait_neplproof_sorted_index_lookup_result header &records &indexes target
                    v::free records
                    v::free indexes
                    Result::Ok lookup
                Result::Err e:
                    v::free records
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_sorted_index_stage0_producer_header: producer smoke 用 header を[作/つく]る
fn selfhost_memo_trait_neplproof_sorted_index_stage0_producer_header %fn i32 SelfhostMemoTraitNeplProofHeader \record_count:
    SelfhostMemoTraitNeplProofHeader selfhost_memo_trait_neplproof_artifact_schema_version selfhost_memo_trait_canonical_key_payload_schema_version selfhost_memo_trait_neplproof_policy_schema_version record_count record_count

//: selfhost_memo_trait_neplproof_sorted_index_stage0_run_producer_lookup: producer output を lookup へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - `records` owner はこの helper が必ず閉じます。
//: - producer が成功した場合は、生成した index owner も lookup 後に閉じます。
fn selfhost_memo_trait_neplproof_sorted_index_stage0_run_producer_lookup %impure fn Vec SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitCanonicalTypeFingerprint Result Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind SelfhostMemoTraitNeplProofIndexProducerErrorKind \records\target:
    match selfhost_memo_trait_neplproof_sorted_index_build_result &records:
        Result::Ok indexes:
            let record_count %i32 v::len &records
            let header %SelfhostMemoTraitNeplProofHeader selfhost_memo_trait_neplproof_sorted_index_stage0_producer_header record_count
            let lookup %Result SelfhostMemoTraitNeplProofIndexCandidateRange SelfhostMemoTraitNeplProofSortedIndexErrorKind selfhost_memo_trait_neplproof_sorted_index_lookup_result header &records &indexes target
            v::free records
            v::free indexes
            Result::Ok lookup
        Result::Err kind:
            v::free records
            Result::Err kind

//: selfhost_memo_trait_neplproof_sorted_index_stage0_run_invalid_record: invalid record を producer error として[返/かえ]す
//:
//: [契約/けいやく]:
//: - 成功値 `Ok unit` は「producer が予期せず invalid record を受理した」ことを表すため、doctest は `Err(RecordInvalid(_))` を期待します。
//: - `records` owner と、予期せず作られた index owner はこの helper が閉じます。
fn selfhost_memo_trait_neplproof_sorted_index_stage0_run_invalid_record %impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord Result unit SelfhostMemoTraitNeplProofIndexProducerErrorKind \invalid_record\second_record:
    match selfhost_memo_trait_neplproof_sorted_index_stage0_records_two invalid_record second_record:
        Result::Ok records:
            match selfhost_memo_trait_neplproof_sorted_index_build_result &records:
                Result::Ok indexes:
                    v::free records
                    v::free indexes
                    Result::Ok unit
                Result::Err kind:
                    v::free records
                    Result::Err kind
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofIndexProducerErrorKind::AllocFailed e

