    let ordinal_unsorted_second %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry first_fingerprint 0 4004
    let mismatched_index %SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofIndexEntry second_fingerprint 0 4004
    match selfhost_memo_trait_neplproof_sorted_index_stage0_run_two_indexes accepted_header first_record second_record first_index second_index first_fingerprint:
        Result::Ok accepted_range:
