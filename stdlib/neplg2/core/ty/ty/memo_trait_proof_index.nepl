    let second_same_fingerprint_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema first_fingerprint 3005 policy
    let first_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 4004
    let second_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord second_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let second_same_fingerprint_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord second_same_fingerprint_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let invalid_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 0
    match selfhost_memo_trait_neplproof_sorted_index_stage0_records_two second_record first_record:
        Result::Ok unordered_records_for_first:
            match selfhost_memo_trait_neplproof_sorted_index_stage0_run_producer_lookup unordered_records_for_first first_fingerprint:
                Result::Ok built_first_range:
                    match selfhost_memo_trait_neplproof_sorted_index_stage0_records_two second_record first_record:
                        Result::Ok unordered_records_for_second:
                            match selfhost_memo_trait_neplproof_sorted_index_stage0_run_producer_lookup unordered_records_for_second second_fingerprint:
                                Result::Ok built_second_range:
                                    match selfhost_memo_trait_neplproof_sorted_index_stage0_records_two second_same_fingerprint_record first_record:
                                        Result::Ok collision_records:
                                            match selfhost_memo_trait_neplproof_sorted_index_stage0_run_producer_lookup collision_records first_fingerprint:
                                                Result::Ok built_collision_range:
                                                    let invalid_record_result %Result unit SelfhostMemoTraitNeplProofIndexProducerErrorKind selfhost_memo_trait_neplproof_sorted_index_stage0_run_invalid_record invalid_record second_record
                                                    Result::Ok selfhost_memo_trait_neplproof_sorted_index_producer_stage0_summary_new built_first_range built_second_range built_collision_range invalid_record_result
                                                Result::Err _e:
