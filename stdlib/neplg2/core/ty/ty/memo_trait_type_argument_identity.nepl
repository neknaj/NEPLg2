fn selfhost_memo_trait_stable_type_argument_identity_stage0_collect_missing %impure fn SelfhostTypeArena impure fn SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitStableTypeArgumentIdentityErrorKind impure fn Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitStableTypeArgumentIdentityErrorKind Result SelfhostMemoTraitStableTypeArgumentIdentityStage0Summary StdErrorKind \arena\table\empty_table\i32_id\applied_id\parameter_id\function_id\accepted\reversed:
