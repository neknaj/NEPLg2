#indent 4
#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "./id" as *
#import "./kind/model" as *
#import "./record" as *

//: SelfhostTypeArena: self-host type stage の型 table
pub struct SelfhostTypeArena:
    records %Vec SelfhostTypeRecord
    function_args %Vec SelfhostTypeId

//: SelfhostTypeArenaAlloc: 型追加後の arena と新しい TypeId
pub struct SelfhostTypeArenaAlloc:
    arena %SelfhostTypeArena
    type_id %SelfhostTypeId


//: selfhost_type_arena_new: [空/から]の TypeArena を[作/つく]る
pub fn selfhost_type_arena_new %impure fn void Result SelfhostTypeArena StdErrorKind \void:
    let records_result %Result Vec SelfhostTypeRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            let function_args_result %Result Vec SelfhostTypeId StdErrorKind v::new
            match function_args_result:
                Result::Ok function_args:
                    Result::Ok SelfhostTypeArena records function_args
                Result::Err e:
                    v::free records
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_type_arena_free: TypeArena が所有する buffer を[解放/かいほう]する
pub fn selfhost_type_arena_free %impure fn SelfhostTypeArena unit \arena:
    v::free field::get arena "records"
    v::free field::get arena "function_args"

//: selfhost_type_arena_len: arena に登録された型数を[返/かえ]す
pub fn selfhost_type_arena_len %fn &SelfhostTypeArena i32 \arena:
    let records %&Vec SelfhostTypeRecord field::get_ref arena "records"
    v::len records

//: selfhost_type_arena_function_arg_len: function argument table の長さを[返/かえ]す
pub fn selfhost_type_arena_function_arg_len %fn &SelfhostTypeArena i32 \arena:
    let function_args %&Vec SelfhostTypeId field::get_ref arena "function_args"
    v::len function_args

//: selfhost_type_arena_alloc_new: 型追加結果を[作/つく]る
pub fn selfhost_type_arena_alloc_new %impure fn SelfhostTypeArena impure fn SelfhostTypeId SelfhostTypeArenaAlloc \arena\type_id:
    SelfhostTypeArenaAlloc arena type_id

//: selfhost_type_arena_alloc_type_id: 型追加結果から新しい TypeId を[読/よ]む
//:
//: [目的/もくてき]:
//: - `SelfhostTypeArenaAlloc` は arena owner を含むため、通常の source から field を直接読むことはできません。
//: - この accessor は borrow から Copy な `SelfhostTypeId` だけを返し、arena owner は動かしません。
pub fn selfhost_type_arena_alloc_type_id %fn &SelfhostTypeArenaAlloc SelfhostTypeId \allocated:
    *field::get_ref allocated "type_id"

//: selfhost_type_arena_alloc_into_arena: 型追加結果を[消費/しょうひ]して arena owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - 型追加後の arena owner を次の arena 操作へ渡すための唯一の public 経路です。
//: - wrapper を消費するため、`SelfhostTypeArenaAlloc` から owner field を複製する経路は作りません。
pub fn selfhost_type_arena_alloc_into_arena %impure fn SelfhostTypeArenaAlloc SelfhostTypeArena \allocated:
    field::get allocated "arena"

//: selfhost_type_arena_push_record: record を arena に[追加/ついか]する
pub fn selfhost_type_arena_push_record %impure fn SelfhostTypeArena impure fn SelfhostTypeRecord Result SelfhostTypeArenaAlloc StdErrorKind \arena\record:
    let type_id %SelfhostTypeId selfhost_type_id_new selfhost_type_arena_len &arena
    let records %Vec SelfhostTypeRecord field::get arena "records"
    let function_args %Vec SelfhostTypeId field::get arena "function_args"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok selfhost_type_arena_alloc_new (SelfhostTypeArena next_records function_args) type_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            v::free function_args
            Result::Err error

//: selfhost_type_arena_add_primitive: primitive type を arena に[追加/ついか]する
pub fn selfhost_type_arena_add_primitive %impure fn SelfhostTypeArena impure fn SelfhostPrimitiveTypeKind Result SelfhostTypeArenaAlloc StdErrorKind \arena\kind:
    selfhost_type_arena_push_record arena selfhost_type_record_primitive kind

//: selfhost_type_arena_copy_function_args: function 引数 TypeId を arena argument table に[複製/ふくせい]する
pub fn selfhost_type_arena_copy_function_args %impure fn Vec SelfhostTypeId impure fn &Vec SelfhostTypeId impure fn i32 impure fn i32 Result Vec SelfhostTypeId StdErrorKind \out\params\n\idx:
    if:
        ge idx n
        then:
            Result::Ok out
        else:
            match v::get params idx:
                Option::Some type_id:
                    match v::push out type_id:
                        Result::Ok next_out:
                            selfhost_type_arena_copy_function_args next_out params n add idx 1
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err error
                Option::None:
                    v::free out
                    Result::Err StdErrorKind::IndexOutOfBounds

//: selfhost_type_arena_add_function: function type を arena に[追加/ついか]する
//:
//: [注意/ちゅうい]:
//: - `params` はこの関数が消費し、成功・失敗どちらでも解放します。
pub fn selfhost_type_arena_add_function %impure fn SelfhostTypeArena impure fn Vec SelfhostTypeId impure fn SelfhostTypeId Result SelfhostTypeArenaAlloc StdErrorKind \arena\params\result:
    let first_arg %i32 selfhost_type_arena_function_arg_len &arena
    let arg_count %i32 v::len &params
    let records %Vec SelfhostTypeRecord field::get arena "records"
    let function_args %Vec SelfhostTypeId field::get arena "function_args"
    match selfhost_type_arena_copy_function_args function_args &params arg_count 0:
        Result::Ok next_args:
            v::free params
            let record %SelfhostTypeRecord selfhost_type_record_function first_arg arg_count result
            selfhost_type_arena_push_record (SelfhostTypeArena records next_args) record
        Result::Err e:
            v::free records
            v::free params
            Result::Err e

//: selfhost_type_arena_get_record: TypeId の record を[返/かえ]す
pub fn selfhost_type_arena_get_record %fn &SelfhostTypeArena fn SelfhostTypeId Option SelfhostTypeRecord \arena\type_id:
    if:
        lt type_id.index 0
        then:
            none
        else:
            let records %&Vec SelfhostTypeRecord field::get_ref arena "records"
            v::get records type_id.index

//: selfhost_type_arena_get_kind: TypeId の TypeKind を[返/かえ]す
pub fn selfhost_type_arena_get_kind %fn &SelfhostTypeArena fn SelfhostTypeId Option SelfhostTypeKind \arena\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive kind:
                    some selfhost_primitive_type_kind_to_type_kind kind
                SelfhostTypeRecord::Function _function:
                    some SelfhostTypeKind::Function
        Option::None:
            none

//: selfhost_type_arena_function_arg_count: function type の引数数を[返/かえ]す
pub fn selfhost_type_arena_function_arg_count %fn &SelfhostTypeArena fn SelfhostTypeId Option i32 \arena\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive _kind:
                    none
                SelfhostTypeRecord::Function function:
                    some function.arg_count
        Option::None:
            none

//: selfhost_type_arena_function_arg: function type の指定引数 TypeId を[返/かえ]す
pub fn selfhost_type_arena_function_arg %fn &SelfhostTypeArena fn SelfhostTypeId fn i32 Option SelfhostTypeId \arena\type_id\arg_idx:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive _kind:
                    none
                SelfhostTypeRecord::Function function:
                    if:
                        or lt arg_idx 0 ge arg_idx function.arg_count
                        then:
                            none
                        else:
                            let function_args %&Vec SelfhostTypeId field::get_ref arena "function_args"
                            v::get function_args add function.first_arg arg_idx
        Option::None:
            none

//: selfhost_type_arena_function_result: function type の戻り値 TypeId を[返/かえ]す
pub fn selfhost_type_arena_function_result %fn &SelfhostTypeArena fn SelfhostTypeId Option SelfhostTypeId \arena\type_id:
    match selfhost_type_arena_get_record arena type_id:
        Option::Some record:
            match record:
                SelfhostTypeRecord::Primitive _kind:
                    none
                SelfhostTypeRecord::Function function:
                    some function.result
        Option::None:
            none
