                                    match selfhost_memo_trait_proof_store_push_stable_key &arena &nominal_table store1 policy named_id ok_proof:
                                        Result::Ok store1_stable:
                                            let primitive_proof %SelfhostMemoTraitStoredAggregateProof selfhost_memo_trait_stored_aggregate_proof_known_new 0 0 (Result::Ok unit) (Result::Ok unit)
                                            match selfhost_memo_trait_proof_store_push &arena store1_stable policy f32_id primitive_proof:
                                                Result::Ok store2:
                                                    let unsupported_proof %SelfhostMemoTraitStoredAggregateProof selfhost_memo_trait_stored_aggregate_proof_known_new 0 0 (Result::Ok unit) (Result::Ok unit)
                                                    match selfhost_memo_trait_proof_store_push_with_kind &arena store2 policy unsupported_id SelfhostMemoTraitStoredProofKind::KeyOnlyUnsupported unsupported_proof:
                                                        Result::Ok store3:
                                                            let found %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record &arena &store3 policy named_id
                                                            let stale %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record &arena &store3 stale_policy named_id
                                                            let missing %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record &arena &store3 policy missing_id
                                                            let primitive %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record &arena &store3 policy f32_id
                                                            let unsupported %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record &arena &store3 policy unsupported_id
                                                            let stable_found %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record_stable_key &arena &nominal_table &store3 policy named_id
                                                            let stable_mismatch %Result SelfhostMemoTraitEvidenceRecord SelfhostMemoTraitProofStoreLookupErrorKind selfhost_memo_trait_proof_store_lookup_record_stable_key &arena &mismatched_nominal_table &store3 policy named_id
                                                            let stable_duplicate %Result unit SelfhostMemoTraitProofStorePushErrorKind selfhost_memo_trait_proof_store_stage0_duplicate_rejection &arena &nominal_table policy named_id ok_proof
