#indent 4

//: # ty/memo_trait_proof_payload_reader
//: `.neplproof` の record table に続く canonical payload bytes section を[読/よ]み、preseed が[使/つか]える materialized key owner へ[変換/へんかん]する reader extension です。
//:
//: [目的/もくてき]:
//: - `memo_trait_proof_reader.nepl` は header と fixed-width record table を typed decoded artifact へ戻します。この module は、その直後に続く canonical payload bytes section を record ordinal と 1 対 1 に対応させます。
//: - payload bytes は `memo_trait_canonical_key_payload_codec.nepl` で decode し、decode ごとの arena-local root を、共有 `SelfhostCanonicalTypeKeyArena` へ `selfhost_canonical_type_key_copy_from_arena` で複製します。
//: - 返り値は decoded artifact owner、materialized key arena owner、record ordinal と対応する materialized key id vector owner を 1 つに束ねます。これは `memo_trait_proof_preseed.nepl` の batch projector が期待する入力形と同じです。
//:
//: [契約/けいやく]:
//: - `.neplproof` payload section は indexed prefix の直後にあり、各 record につき `payload_byte_len` word と、その byte 数ぶんの canonical payload codec bytes を持ちます。
//: - indexed prefix の byte 数は、prefix owner を確保して複写する前に reader 側の `selfhost_memo_trait_neplproof_reader_indexed_prefix_byte_count_result` で検査します。過大な `record_count` / `index_count` は allocation 前に fail-closed にします。
//: - indexed prefix は `selfhost_memo_trait_neplproof_reader_decoded_artifact_from_indexed_record_bytes_result` に渡して検査します。この module は record tag、stored proof、index entry の別 authority を作りません。
//: - payload bytes decode は materialized key を作るだけです。payload hash、canonical fingerprint、policy、proof kind、store relation の受理判定は preseed / proof store 側が再検査します。
//: - `SelfhostTypeId`、source text、span、path suffix、display name、diagnostic text、lexeme、record payload hash 単独、fingerprint hit 単独、index hit 単独は、この reader の authority ではありません。
//: - 失敗時は、この module が作った decoded artifact owner、materialized key arena owner、materialized key id vector owner、payload slice owner を閉じます。caller は error payload だけを受け取ります。
//:
//: [現状/げんじょう]:
//: - Phase 1 は decoded record table、serialized sidecar index table、canonical payload section を同じ bytes から読みます。persistent stable map、generic type argument identity、full public surface hash は後続 slice の責務です。
//: - payload section の長さ word は 31-bit nonnegative word codec を使います。payload の中身そのものは canonical payload codec の schema と終端検査に委譲します。
//: - この module は preseed module を import しません。依存方向を `reader -> payload reader -> preseed caller` に保ち、preseed の判定規則を reader へ逆流させないためです。
//:
//: [計算量/けいさんりょう]:
//: - indexed prefix copy は byte 数 p に対して O(p) です。record table と index table decode は既存 reader の O(n + m) 境界に従います。
//: - 過大な record / index count は prefix copy 前の O(1) preflight で拒否します。
//: - payload section decode は record 数 n、payload byte 総量 b、canonical key tree 総 node/edge 数 k に対して O(b + k) です。
//: - materialized key id vector の構築は O(n) です。lookup、proof acceptance、proof store relation 判定、FileSystem、source scan は行いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_canonical_key_payload_codec" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_payload_reader" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_neplproof_payload_reader_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_neplproof_payload_reader_unit_result_is_ok summary.accepted
//:             let checks2 checks_push checks1 check selfhost_memo_trait_neplproof_payload_reader_error_kind_eq (unwrap_err summary.short_payload) SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesUnexpectedEnd
//:             let checks3 checks_push checks2 check selfhost_memo_trait_neplproof_payload_reader_error_kind_eq (unwrap_err summary.payload_decode_invalid) SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadDecodeInvalid SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind::FunctionTypeUnsupported
//:             let checks4 checks_push checks3 check selfhost_memo_trait_neplproof_payload_reader_error_kind_eq (unwrap_err summary.trailing_bytes) SelfhostMemoTraitNeplProofPayloadReaderErrorKind::TrailingBytes
//:             let shown checks_print_report checks4
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "neplproof payload reader stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./id" as *
#import "./key" as *
#import "./memo_trait_artifact_word_codec" as *
#import "./memo_trait_canonical_key" as *
#import "./memo_trait_canonical_key_payload" as *
#import "./memo_trait_canonical_key_payload_codec" as *
#import "./memo_trait_proof_artifact" as *
#import "./memo_trait_proof_decoded" as *
#import "./memo_trait_proof_reader" as *

//: SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact: payload section reader の owner bundle
//:
//: [目的/もくてき]:
//: - decoded artifact と、それに対応する materialized canonical key arena / key id table を同じ lifetime で扱います。
//:
//: [契約/けいやく]:
//: - `materialized_key_ids[i]` は `artifact.records[i]` の canonical payload bytes から materialize された root key です。
//: - `materialized_key_ids` の id は `materialized_key_arena` 内だけで意味を持ちます。record ordinal、store-local id、serialized id として扱ってはいけません。
pub struct SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact:
    artifact %SelfhostMemoTraitNeplProofDecodedArtifact
    materialized_key_arena %SelfhostCanonicalTypeKeyArena
    materialized_key_ids %Vec SelfhostCanonicalTypeKeyId

//: SelfhostMemoTraitNeplProofPayloadReaderErrorKind: payload section reader の拒否理由
//:
//: [分類/ぶんるい]:
//: - header / record prefix の失敗は既存 reader error を payload として保持します。
//: - payload bytes の範囲不整合、payload decode、materialized arena copy、key id vector push を別 variant に分けます。
pub enum SelfhostMemoTraitNeplProofPayloadReaderErrorKind:
    HeaderReadInvalid %SelfhostMemoTraitNeplProofReaderErrorKind
    RecordPrefixAllocInvalid %StdErrorKind
    RecordPrefixPushInvalid %StdErrorKind
    RecordPrefixUnexpectedEnd
    RecordDecodeInvalid %SelfhostMemoTraitNeplProofReaderErrorKind
    PayloadLengthWordInvalid %SelfhostMemoTraitArtifactWordReadErrorKind
    PayloadLengthInvalid
    PayloadBytesUnexpectedEnd
    PayloadBytesAllocInvalid %StdErrorKind
    PayloadBytesPushInvalid %StdErrorKind
    PayloadDecodeInvalid %SelfhostMemoTraitCanonicalKeyPayloadDecodeErrorKind
    MaterializedArenaAllocInvalid %StdErrorKind
    MaterializedKeyCopyInvalid %SelfhostCanonicalTypeKeyCopyErrorKind
    MaterializedKeyIdAllocInvalid %StdErrorKind
    MaterializedKeyIdPushInvalid %StdErrorKind
    TrailingBytes

struct SelfhostMemoTraitNeplProofPayloadReaderStep:
    materialized_key_arena %SelfhostCanonicalTypeKeyArena
    materialized_key_ids %Vec SelfhostCanonicalTypeKeyId
    next_byte_offset %i32

//: SelfhostMemoTraitNeplProofPayloadReaderStage0Summary: payload reader の代表 smoke
pub struct SelfhostMemoTraitNeplProofPayloadReaderStage0Summary:
    accepted %Result unit SelfhostMemoTraitNeplProofPayloadReaderErrorKind
    short_payload %Result unit SelfhostMemoTraitNeplProofPayloadReaderErrorKind
    payload_decode_invalid %Result unit SelfhostMemoTraitNeplProofPayloadReaderErrorKind
    trailing_bytes %Result unit SelfhostMemoTraitNeplProofPayloadReaderErrorKind

impl Clone for SelfhostMemoTraitNeplProofPayloadReaderErrorKind:
    fn clone %fn &SelfhostMemoTraitNeplProofPayloadReaderErrorKind SelfhostMemoTraitNeplProofPayloadReaderErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofPayloadReaderErrorKind:
    fn copy_mark %fn SelfhostMemoTraitNeplProofPayloadReaderErrorKind SelfhostMemoTraitNeplProofPayloadReaderErrorKind \self:
        self

impl Clone for SelfhostMemoTraitNeplProofPayloadReaderStage0Summary:
    fn clone %fn &SelfhostMemoTraitNeplProofPayloadReaderStage0Summary SelfhostMemoTraitNeplProofPayloadReaderStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofPayloadReaderStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitNeplProofPayloadReaderStage0Summary SelfhostMemoTraitNeplProofPayloadReaderStage0Summary \self:
        self

//: selfhost_memo_trait_neplproof_payload_reader_materialized_artifact_free: materialized artifact bundle を[閉/と]じる
//:
//: [契約/けいやく]:
//: - decoded artifact、materialized key arena、key id vector をすべて閉じます。
//: - key id vector は Copy payload だけを持つため `v::free` だけで十分です。
pub fn selfhost_memo_trait_neplproof_payload_reader_materialized_artifact_free %impure fn SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact unit \artifact:
    selfhost_memo_trait_neplproof_decoded_artifact_free field::get artifact "artifact"
    selfhost_canonical_type_key_arena_free field::get artifact "materialized_key_arena"
    v::free field::get artifact "materialized_key_ids"

//: selfhost_memo_trait_neplproof_payload_reader_header_words: payload reader が前段 prefix として扱う header word 数
fn selfhost_memo_trait_neplproof_payload_reader_header_words %fn void i32 \void:
    6

//: selfhost_memo_trait_neplproof_payload_reader_record_words: payload reader が前段 prefix として扱う record word 数
fn selfhost_memo_trait_neplproof_payload_reader_record_words %fn void i32 \void:
    31

//: selfhost_memo_trait_neplproof_payload_reader_index_words: payload reader が前段 prefix として扱う index entry word 数
fn selfhost_memo_trait_neplproof_payload_reader_index_words %fn void i32 \void:
    4

//: selfhost_memo_trait_neplproof_payload_reader_record_only_word_count: record-only prefix の word 数を[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_record_only_word_count %fn SelfhostMemoTraitNeplProofHeader i32 \header:
    add selfhost_memo_trait_neplproof_payload_reader_header_words mul header.record_count selfhost_memo_trait_neplproof_payload_reader_record_words

//: selfhost_memo_trait_neplproof_payload_reader_record_only_byte_count: record-only prefix の byte 数を[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_record_only_byte_count %fn SelfhostMemoTraitNeplProofHeader i32 \header:
    mul selfhost_memo_trait_neplproof_payload_reader_record_only_word_count header 4

//: selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_word_count: indexed prefix の word 数を[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_word_count %fn SelfhostMemoTraitNeplProofHeader i32 \header:
    add selfhost_memo_trait_neplproof_payload_reader_record_only_word_count header mul header.index_count selfhost_memo_trait_neplproof_payload_reader_index_words

//: selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count: indexed prefix の byte 数を[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count %fn SelfhostMemoTraitNeplProofHeader i32 \header:
    mul selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_word_count header 4

//: selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count_result: indexed prefix の byte 数を allocation 前に[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - payload reader が prefix owner を作る前に、reader 本体と同じ `record_count` / `index_count` 上限を通します。
//: - 成功時の byte count は、この module 内の unchecked arithmetic ではなく reader boundary が返した値を使います。
//:
//: [契約/けいやく]:
//: - この関数が `Err` を返した場合、caller は prefix copy、decoded artifact construction、payload section scan へ進んではいけません。
//: - 拒否理由は `RecordDecodeInvalid(reader_error)` に包み、reader 側の typed error payload を失いません。
fn selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count_result %fn SelfhostMemoTraitNeplProofHeader Result i32 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \header:
    match selfhost_memo_trait_neplproof_reader_indexed_prefix_byte_count_result header:
        Result::Ok byte_count:
            Result::Ok byte_count
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::RecordDecodeInvalid e

//: selfhost_memo_trait_neplproof_payload_reader_step_new: payload decode loop の owner state を[作/つく]る
fn selfhost_memo_trait_neplproof_payload_reader_step_new %impure fn SelfhostCanonicalTypeKeyArena impure fn Vec SelfhostCanonicalTypeKeyId impure fn i32 SelfhostMemoTraitNeplProofPayloadReaderStep \arena\key_ids\next_byte_offset:
    SelfhostMemoTraitNeplProofPayloadReaderStep arena key_ids next_byte_offset

//: selfhost_memo_trait_neplproof_payload_reader_abort: 3 owner を[閉/と]じて error を[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_abort %impure fn SelfhostMemoTraitNeplProofDecodedArtifact impure fn SelfhostCanonicalTypeKeyArena impure fn Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitNeplProofPayloadReaderErrorKind Result SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact SelfhostMemoTraitNeplProofPayloadReaderErrorKind \artifact\arena\key_ids\kind:
    selfhost_memo_trait_neplproof_decoded_artifact_free artifact
    selfhost_canonical_type_key_arena_free arena
    v::free key_ids
    Result::Err kind

//: selfhost_memo_trait_neplproof_payload_reader_copy_byte_push: copied bytes vector へ 1 byte を[追加/ついか]する
fn selfhost_memo_trait_neplproof_payload_reader_copy_byte_push %impure fn Vec u8 impure fn u8 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \out\byte:
    match v::push out byte:
        Result::Ok next:
            Result::Ok next
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesPushInvalid error

//: selfhost_memo_trait_neplproof_payload_reader_copy_range_loop: byte range を owner vector へ[複写/ふくしゃ]する
fn selfhost_memo_trait_neplproof_payload_reader_copy_range_loop %impure fn &Vec u8 impure fn Vec u8 impure fn i32 impure fn i32 impure fn i32 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \source\out\start\idx\count:
    if:
        ge idx count
        then:
            Result::Ok out
        else:
            let source_offset %i32 add start idx
            match v::get source source_offset:
                Option::Some byte:
                    match selfhost_memo_trait_neplproof_payload_reader_copy_byte_push out byte:
                        Result::Ok next_out:
                            selfhost_memo_trait_neplproof_payload_reader_copy_range_loop source next_out start add idx 1 count
                        Result::Err e:
                            Result::Err e
                Option::None:
                    v::free out
                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesUnexpectedEnd

//: selfhost_memo_trait_neplproof_payload_reader_copy_range_result: byte range owner を[作/つく]る
fn selfhost_memo_trait_neplproof_payload_reader_copy_range_result %impure fn &Vec u8 impure fn i32 impure fn i32 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \source\start\count:
    let out_result %Result Vec u8 StdErrorKind v::new
    match out_result:
        Result::Ok out:
            selfhost_memo_trait_neplproof_payload_reader_copy_range_loop source out start 0 count
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesAllocInvalid e

//: selfhost_memo_trait_neplproof_payload_reader_record_prefix_push: record prefix 用 Vec push error を別分類へ[写/うつ]す
fn selfhost_memo_trait_neplproof_payload_reader_record_prefix_push %impure fn Vec u8 impure fn u8 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \out\byte:
    match v::push out byte:
        Result::Ok next:
            Result::Ok next
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::RecordPrefixPushInvalid error

//: selfhost_memo_trait_neplproof_payload_reader_record_prefix_loop: indexed prefix bytes を[複写/ふくしゃ]する
fn selfhost_memo_trait_neplproof_payload_reader_record_prefix_loop %impure fn &Vec u8 impure fn Vec u8 impure fn i32 impure fn i32 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \source\out\idx\count:
    if:
        ge idx count
        then:
            Result::Ok out
        else:
            match v::get source idx:
                Option::Some byte:
                    match selfhost_memo_trait_neplproof_payload_reader_record_prefix_push out byte:
                        Result::Ok next_out:
                            selfhost_memo_trait_neplproof_payload_reader_record_prefix_loop source next_out add idx 1 count
                        Result::Err e:
                            Result::Err e
                Option::None:
                    v::free out
                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::RecordPrefixUnexpectedEnd

//: selfhost_memo_trait_neplproof_payload_reader_record_prefix_result: indexed reader に渡す prefix bytes を[作/つく]る
fn selfhost_memo_trait_neplproof_payload_reader_record_prefix_result %impure fn &Vec u8 impure fn i32 Result Vec u8 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \bytes\byte_count:
    let prefix_result %Result Vec u8 StdErrorKind v::new
    match prefix_result:
        Result::Ok prefix:
            selfhost_memo_trait_neplproof_payload_reader_record_prefix_loop bytes prefix 0 byte_count
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::RecordPrefixAllocInvalid e

//: selfhost_memo_trait_neplproof_payload_reader_decoded_artifact_result: indexed prefix bytes を既存 reader へ[渡/わた]す
fn selfhost_memo_trait_neplproof_payload_reader_decoded_artifact_result %impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofPayloadReaderErrorKind \bytes\header:
    match selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count_result header:
        Result::Ok prefix_byte_count:
            match selfhost_memo_trait_neplproof_payload_reader_record_prefix_result bytes prefix_byte_count:
                Result::Ok prefix:
                    let artifact_result %Result SelfhostMemoTraitNeplProofDecodedArtifact SelfhostMemoTraitNeplProofReaderErrorKind selfhost_memo_trait_neplproof_reader_decoded_artifact_from_indexed_record_bytes_result &prefix
                    v::free prefix
                    match artifact_result:
                        Result::Ok artifact:
                            Result::Ok artifact
                        Result::Err e:
                            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::RecordDecodeInvalid e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_payload_reader_length_result: payload section の length word を[読/よ]む
fn selfhost_memo_trait_neplproof_payload_reader_length_result %fn &Vec u8 fn i32 Result i32 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \bytes\offset:
    match selfhost_memo_trait_artifact_word_codec_word_at_byte_result bytes offset:
        Result::Ok length:
            Result::Ok length
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadLengthWordInvalid e

//: selfhost_memo_trait_neplproof_payload_reader_payload_end_result: section の次 offset を[検査/けんさ]して[返/かえ]す
fn selfhost_memo_trait_neplproof_payload_reader_payload_end_result %fn &Vec u8 fn i32 fn i32 Result i32 SelfhostMemoTraitNeplProofPayloadReaderErrorKind \bytes\offset\payload_length:
    if:
        lt payload_length 0
        then:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadLengthInvalid
        else:
            let payload_start %i32 add offset 4
            if:
                lt payload_start offset
                then:
                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadLengthInvalid
                else:
                    let payload_end %i32 add payload_start payload_length
                    if:
                        lt payload_end payload_start
                        then:
                            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadLengthInvalid
                        else:
                            if:
                                gt payload_end v::len bytes
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesUnexpectedEnd
                                else:
                                    Result::Ok payload_end

//: selfhost_memo_trait_neplproof_payload_reader_decode_one_result: 1 record 分の payload bytes を materialize する
fn selfhost_memo_trait_neplproof_payload_reader_decode_one_result %impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostCanonicalTypeKeyArena impure fn Vec SelfhostCanonicalTypeKeyId impure fn i32 impure fn i32 Result SelfhostMemoTraitNeplProofPayloadReaderStep SelfhostMemoTraitNeplProofPayloadReaderErrorKind \nominal_table\bytes\materialized_key_arena\materialized_key_ids\record_ordinal\offset:
    match selfhost_memo_trait_neplproof_payload_reader_length_result bytes offset:
        Result::Ok payload_length:
            match selfhost_memo_trait_neplproof_payload_reader_payload_end_result bytes offset payload_length:
                Result::Ok next_offset:
                    let payload_start %i32 add offset 4
                    match selfhost_memo_trait_neplproof_payload_reader_copy_range_result bytes payload_start payload_length:
                        Result::Ok payload_bytes:
                            match selfhost_memo_trait_canonical_key_payload_decode_result nominal_table &payload_bytes:
                                Result::Ok decoded:
                                    let decoded_arena %&SelfhostCanonicalTypeKeyArena field::get_ref &decoded "arena"
                                    let decoded_root %SelfhostCanonicalTypeKeyId *field::get_ref &decoded "root"
                                    match selfhost_canonical_type_key_copy_from_arena decoded_arena materialized_key_arena decoded_root:
                                        Result::Ok copied:
                                            let copied_key_id %SelfhostCanonicalTypeKeyId selfhost_canonical_type_key_arena_alloc_key_id &copied
                                            let next_arena %SelfhostCanonicalTypeKeyArena selfhost_canonical_type_key_arena_alloc_into_arena copied
                                            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
                                            v::free payload_bytes
                                            match v::push materialized_key_ids copied_key_id:
                                                Result::Ok next_key_ids:
                                                    Result::Ok selfhost_memo_trait_neplproof_payload_reader_step_new next_arena next_key_ids next_offset
                                                Result::Err e:
                                                    let error %StdErrorKind field::get e "error"
                                                    v::free v::vec_push_error_vec e
                                                    selfhost_canonical_type_key_arena_free next_arena
                                                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::MaterializedKeyIdPushInvalid error
                                        Result::Err copy_error:
                                            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
                                            v::free payload_bytes
                                            v::free materialized_key_ids
                                            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::MaterializedKeyCopyInvalid copy_error
                                Result::Err decode_error:
                                    v::free payload_bytes
                                    selfhost_canonical_type_key_arena_free materialized_key_arena
                                    v::free materialized_key_ids
                                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadDecodeInvalid decode_error
                        Result::Err e:
                            selfhost_canonical_type_key_arena_free materialized_key_arena
                            v::free materialized_key_ids
                            Result::Err e
                Result::Err e:
                    selfhost_canonical_type_key_arena_free materialized_key_arena
                    v::free materialized_key_ids
                    Result::Err e
        Result::Err e:
            selfhost_canonical_type_key_arena_free materialized_key_arena
            v::free materialized_key_ids
            Result::Err e

//: selfhost_memo_trait_neplproof_payload_reader_loop: payload section を record ordinal 順に[読/よ]む
fn selfhost_memo_trait_neplproof_payload_reader_loop %impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostMemoTraitNeplProofDecodedArtifact impure fn SelfhostCanonicalTypeKeyArena impure fn Vec SelfhostCanonicalTypeKeyId impure fn i32 impure fn i32 impure fn i32 Result SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact SelfhostMemoTraitNeplProofPayloadReaderErrorKind \nominal_table\bytes\artifact\materialized_key_arena\materialized_key_ids\record_ordinal\record_count\offset:
    if:
        ge record_ordinal record_count
        then:
            let actual_len %i32 v::len bytes
            if:
                lt actual_len offset
                then:
                    selfhost_memo_trait_neplproof_payload_reader_abort artifact materialized_key_arena materialized_key_ids SelfhostMemoTraitNeplProofPayloadReaderErrorKind::PayloadBytesUnexpectedEnd
                else:
                    if:
                        gt actual_len offset
                        then:
                            selfhost_memo_trait_neplproof_payload_reader_abort artifact materialized_key_arena materialized_key_ids SelfhostMemoTraitNeplProofPayloadReaderErrorKind::TrailingBytes
                        else:
                            Result::Ok SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact artifact materialized_key_arena materialized_key_ids
        else:
            match selfhost_memo_trait_neplproof_payload_reader_decode_one_result nominal_table bytes materialized_key_arena materialized_key_ids record_ordinal offset:
                Result::Ok step:
                    let next_arena %SelfhostCanonicalTypeKeyArena field::get step "materialized_key_arena"
                    let next_key_ids %Vec SelfhostCanonicalTypeKeyId field::get step "materialized_key_ids"
                    let next_offset %i32 field::get step "next_byte_offset"
                    selfhost_memo_trait_neplproof_payload_reader_loop nominal_table bytes artifact next_arena next_key_ids add record_ordinal 1 record_count next_offset
                Result::Err e:
                    selfhost_memo_trait_neplproof_decoded_artifact_free artifact
                    Result::Err e

//: selfhost_memo_trait_neplproof_payload_reader_materialized_artifact_result: `.neplproof` bytes から materialized artifact bundle を[作/つく]る
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(bundle)`: decoded artifact、共有 materialized key arena、record ordinal 対応 key id vector を返します。caller は `selfhost_memo_trait_neplproof_payload_reader_materialized_artifact_free` で閉じます。
//: - `Err(kind)`: header / record / payload section / materialization のいずれかで fail-closed になりました。内部で作った owner は閉じています。
//:
//: [契約/けいやく]:
//: - この関数は proof store へ投入しません。proof acceptance は caller が preseed module の batch path へ渡した後に行います。
//: - indexed prefix は既存 reader へ渡し、payload section は `record_count` 件だけ順に decode します。
pub fn selfhost_memo_trait_neplproof_payload_reader_materialized_artifact_result %impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 Result SelfhostMemoTraitNeplProofPayloadReaderMaterializedArtifact SelfhostMemoTraitNeplProofPayloadReaderErrorKind \nominal_table\bytes:
    match selfhost_memo_trait_neplproof_reader_header_result bytes:
        Result::Ok header:
            match selfhost_memo_trait_neplproof_payload_reader_decoded_artifact_result bytes header:
                Result::Ok artifact:
                    match selfhost_canonical_type_key_arena_new:
                        Result::Ok materialized_key_arena:
                            let key_ids_result %Result Vec SelfhostCanonicalTypeKeyId StdErrorKind v::new
                            match key_ids_result:
                                Result::Ok key_ids:
                                    match selfhost_memo_trait_neplproof_payload_reader_indexed_prefix_byte_count_result header:
                                        Result::Ok payload_offset:
                                            selfhost_memo_trait_neplproof_payload_reader_loop nominal_table bytes artifact materialized_key_arena key_ids 0 header.record_count payload_offset
                                        Result::Err e:
                                            selfhost_memo_trait_neplproof_payload_reader_abort artifact materialized_key_arena key_ids e
                                Result::Err e:
                                    selfhost_memo_trait_neplproof_decoded_artifact_free artifact
                                    selfhost_canonical_type_key_arena_free materialized_key_arena
                                    Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::MaterializedKeyIdAllocInvalid e
                        Result::Err e:
                            selfhost_memo_trait_neplproof_decoded_artifact_free artifact
                            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::MaterializedArenaAllocInvalid e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofPayloadReaderErrorKind::HeaderReadInvalid e

