//: selfhost_memo_trait_neplproof_artifact_schema_version: `.neplproof` record layout version
//:
//: [契約/けいやく]:
//: - header / record key / record / index entry の field 意味や validation rule を変える場合は、この version を上げます。
pub fn selfhost_memo_trait_neplproof_artifact_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_neplproof_policy_schema_version: `.neplproof` が受理する policy schema version
//:
//: [契約/けいやく]:
//: - 現 stage では `SelfhostMemoTraitProofStorePolicy.rules.schema_version` と一致させます。policy payload layout が変わる場合、古い artifact は別 schema として扱います。
pub fn selfhost_memo_trait_neplproof_policy_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_neplproof_header_new: validation 済み header を[作/つく]る
fn selfhost_memo_trait_neplproof_header_new %fn i32 fn i32 fn i32 fn i32 fn i32 SelfhostMemoTraitNeplProofHeader \artifact_schema_version\canonical_payload_schema_version\policy_schema_version\record_count\index_count:
    SelfhostMemoTraitNeplProofHeader artifact_schema_version canonical_payload_schema_version policy_schema_version record_count index_count

//: selfhost_memo_trait_neplproof_record_key_new: validation 済み record key を[作/つく]る
fn selfhost_memo_trait_neplproof_record_key_new %fn i32 fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn SelfhostMemoTraitProofStorePolicy SelfhostMemoTraitNeplProofRecordKey \canonical_payload_schema_version\canonical_fingerprint\canonical_payload_hash\policy:
    SelfhostMemoTraitNeplProofRecordKey canonical_payload_schema_version canonical_fingerprint canonical_payload_hash policy

//: selfhost_memo_trait_neplproof_record_new: validation 済み artifact record を[作/つく]る
fn selfhost_memo_trait_neplproof_record_new %fn SelfhostMemoTraitNeplProofRecordKey fn SelfhostMemoTraitStoredProofKind fn SelfhostMemoTraitStoredAggregateProof fn i32 SelfhostMemoTraitNeplProofRecord \key\proof_kind\proof\record_payload_hash:
    SelfhostMemoTraitNeplProofRecord key proof_kind proof record_payload_hash

//: selfhost_memo_trait_neplproof_index_entry_new: validation 済み index entry を[作/つく]る
fn selfhost_memo_trait_neplproof_index_entry_new %fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn i32 SelfhostMemoTraitNeplProofIndexEntry \canonical_fingerprint\record_ordinal\record_payload_hash:
    SelfhostMemoTraitNeplProofIndexEntry canonical_fingerprint record_ordinal record_payload_hash

//: selfhost_memo_trait_neplproof_header_result: artifact header を[検査/けんさ]する
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(header)`: schema version と件数境界が現 compiler で受理できる形です。
//: - `Err(kind)`: schema mismatch または負の件数です。caller は record payload を読まず fail-closed にできます。
pub fn selfhost_memo_trait_neplproof_header_result %fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostMemoTraitNeplProofHeader SelfhostMemoTraitNeplProofArtifactErrorKind \artifact_schema_version\canonical_payload_schema_version\policy_schema_version\record_count\index_count:
    if:
        not eq artifact_schema_version selfhost_memo_trait_neplproof_artifact_schema_version
        then:
            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch
        else:
            if:
                or:
                    not eq canonical_payload_schema_version selfhost_memo_trait_canonical_key_payload_schema_version
                    not eq canonical_payload_schema_version selfhost_memo_trait_canonical_type_fingerprint_schema_version
                then:
                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch
                else:
                    if:
                        not eq policy_schema_version selfhost_memo_trait_neplproof_policy_schema_version
                        then:
                            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch
                        else:
                            if:
                                lt record_count 0
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative
                                else:
                                    if:
                                        lt index_count 0
                                        then:
                                            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative
                                        else:
                                            Result::Ok selfhost_memo_trait_neplproof_header_new artifact_schema_version canonical_payload_schema_version policy_schema_version record_count index_count

//: selfhost_memo_trait_neplproof_record_key_result: serialized record key を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - canonical fingerprint と canonical payload schema の version が一致しない場合は拒否します。
//: - canonical payload hash は nonzero でなければいけません。
//: - policy rules schema version が artifact schema と一致しない proof は stale policy として扱います。
pub fn selfhost_memo_trait_neplproof_record_key_result %fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn i32 fn SelfhostMemoTraitProofStorePolicy Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind \canonical_fingerprint\canonical_payload_schema_version\canonical_payload_hash\policy:
    if:
        or:
            not eq canonical_payload_schema_version selfhost_memo_trait_canonical_key_payload_schema_version
            or:
                not eq canonical_payload_schema_version selfhost_memo_trait_canonical_type_fingerprint_schema_version
                not eq canonical_fingerprint.schema_version canonical_payload_schema_version
        then:
            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch
        else:
            if:
                eq canonical_payload_hash 0
                then:
                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder
                else:
                    if:
                        not eq policy.rules.schema_version selfhost_memo_trait_neplproof_policy_schema_version
                        then:
                            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch
                        else:
                            Result::Ok selfhost_memo_trait_neplproof_record_key_new canonical_payload_schema_version canonical_fingerprint canonical_payload_hash policy

//: selfhost_memo_trait_neplproof_record_key_from_parts_result: serialized record key fields を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - binary reader は canonical fingerprint を schema version と root hash の word pair として読みます。
//: - reader が canonical key fingerprint producer module 全体へ直接依存しなくてよいように、この artifact schema 境界で typed fingerprint payload を組み立て、既存の record key validator へ委譲します。
//:
//: [契約/けいやく]:
//: - この関数は proof acceptance authority ではありません。
//: - fingerprint schema、canonical payload schema、canonical payload hash、policy schema の検査は `selfhost_memo_trait_neplproof_record_key_result` と同じです。
//: - source text、span、path、diagnostic、lexeme、session-local id は入力に含めません。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の scalar field だけを確認するため O(1) です。
pub fn selfhost_memo_trait_neplproof_record_key_from_parts_result %fn i32 fn i32 fn i32 fn i32 fn SelfhostMemoTraitProofStorePolicy Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind \canonical_payload_schema_version\canonical_fingerprint_schema_version\canonical_fingerprint_root_hash\canonical_payload_hash\policy:
    let canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_fingerprint_schema_version canonical_fingerprint_root_hash
    selfhost_memo_trait_neplproof_record_key_result canonical_fingerprint canonical_payload_schema_version canonical_payload_hash policy

//: selfhost_memo_trait_neplproof_record_result: serialized proof record を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - record payload hash が `0` の record は、body payload の同一性を検査できないため拒否します。
//: - proof kind と stored proof payload の semantic validation は proof store / producer gate が行います。この関数は artifact record body の placeholder を拒否する境界です。
//: - `KeyOnlyUnsupported` などの proof kind を artifact schema 層だけで受理しません。reader はこの record を proof store preseed / lookup gate へ渡し、expected proof kind と producer gate の両方で fail-closed に検査します。
pub fn selfhost_memo_trait_neplproof_record_result %fn SelfhostMemoTraitNeplProofRecordKey fn SelfhostMemoTraitStoredProofKind fn SelfhostMemoTraitStoredAggregateProof fn i32 Result SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofArtifactErrorKind \key\proof_kind\proof\record_payload_hash:
    if:
        eq record_payload_hash 0
        then:
            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder
        else:
            Result::Ok selfhost_memo_trait_neplproof_record_new key proof_kind proof record_payload_hash

//: selfhost_memo_trait_neplproof_index_entry_result: artifact index entry を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - canonical fingerprint schema が現行 schema と一致しない場合は拒否します。
//: - record ordinal は `0 <= record_ordinal < record_count` でなければいけません。
//: - record payload hash は nonzero でなければいけません。
pub fn selfhost_memo_trait_neplproof_index_entry_result %fn SelfhostMemoTraitCanonicalTypeFingerprint fn i32 fn i32 fn i32 Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofArtifactErrorKind \canonical_fingerprint\record_ordinal\record_payload_hash\record_count:
    if:
        not eq canonical_fingerprint.schema_version selfhost_memo_trait_canonical_type_fingerprint_schema_version
        then:
            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch
        else:
            if:
                lt record_ordinal 0
                then:
                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexNegative
                else:
                    if:
                        ge record_ordinal record_count
                        then:
                            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange
                        else:
                            if:
                                eq record_payload_hash 0
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder
                                else:
                                    Result::Ok selfhost_memo_trait_neplproof_index_entry_new canonical_fingerprint record_ordinal record_payload_hash

//: selfhost_memo_trait_neplproof_index_entry_from_parts_result: serialized index entry fields を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - binary reader は sidecar index entry を fingerprint schema、fingerprint root hash、record ordinal、record payload hash の word 列として読みます。
//: - reader が canonical key module 全体へ直接依存しなくてよいように、この artifact schema 境界で typed fingerprint payload を組み立て、既存の index entry validator へ委譲します。
//:
//: [契約/けいやく]:
//: - この関数は proof acceptance authority ではありません。
//: - fingerprint schema、record ordinal range、record payload hash placeholder の検査は `selfhost_memo_trait_neplproof_index_entry_result` と同じです。
//: - source text、span、path、diagnostic、lexeme、session-local id は入力に含めません。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の scalar field だけを確認するため O(1) です。
pub fn selfhost_memo_trait_neplproof_index_entry_from_parts_result %fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofArtifactErrorKind \canonical_fingerprint_schema_version\canonical_fingerprint_root_hash\record_ordinal\record_payload_hash\record_count:
    let canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_fingerprint_schema_version canonical_fingerprint_root_hash
    selfhost_memo_trait_neplproof_index_entry_result canonical_fingerprint record_ordinal record_payload_hash record_count

//: selfhost_memo_trait_neplproof_index_entry_matches_record_result: index entry が record payload を[指/さ]すか[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - fingerprint と record payload hash の両方が一致した場合だけ `Ok unit` を返します。
//: - これは index invariant の検査であり、proof acceptance ではありません。reader はこの後、proof store preseed と lookup gate を実行します。
pub fn selfhost_memo_trait_neplproof_index_entry_matches_record_result %fn SelfhostMemoTraitNeplProofIndexEntry fn SelfhostMemoTraitNeplProofRecord Result unit SelfhostMemoTraitNeplProofArtifactErrorKind \entry\record:
    if:
        not selfhost_memo_trait_canonical_type_fingerprint_eq entry.canonical_fingerprint record.key.canonical_fingerprint
        then:
            Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch
        else:
            if:
                not eq entry.record_payload_hash record.record_payload_hash
                then:
                    Result::Err SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch
                else:
                    Result::Ok unit

//: selfhost_memo_trait_neplproof_record_revalidate_for_index_table: decoded record を index table 検査の前提として[再検査/さいけんさ]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が既に `SelfhostMemoTraitNeplProofRecord` を構築していても、index table 全体を信頼する前に record key と record payload hash を同じ validator で再確認します。
//:
//: [契約/けいやく]:
//: - validation 失敗の詳細は単一 record validator が保持します。この aggregate boundary では、reader が index table 全体を拒否すべきことを `RecordInvalid` として返します。
fn selfhost_memo_trait_neplproof_record_revalidate_for_index_table %fn SelfhostMemoTraitNeplProofRecord Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \record:
    match selfhost_memo_trait_neplproof_record_key_result record.key.canonical_fingerprint record.key.canonical_payload_schema_version record.key.canonical_payload_hash record.key.policy:
        Result::Ok key:
            match selfhost_memo_trait_neplproof_record_result key record.proof_kind record.proof record.record_payload_hash:
                Result::Ok _record:
                    Result::Ok unit
                Result::Err _kind:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::RecordInvalid
        Result::Err _kind:
            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::RecordInvalid

//: selfhost_memo_trait_neplproof_index_revalidate_for_index_table: decoded index entry を index table 検査の前提として[再検査/さいけんさ]する
//:
//: [契約/けいやく]:
//: - index entry 自体の schema、ordinal range、payload hash placeholder は単一 entry validator に委譲します。
fn selfhost_memo_trait_neplproof_index_revalidate_for_index_table %fn SelfhostMemoTraitNeplProofIndexEntry fn i32 Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \entry\record_count:
    match selfhost_memo_trait_neplproof_index_entry_result entry.canonical_fingerprint entry.record_ordinal entry.record_payload_hash record_count:
        Result::Ok _entry:
            Result::Ok unit
        Result::Err _kind:
            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexEntryInvalid

//: selfhost_memo_trait_neplproof_index_validation_record_loop: record vector 全体を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - `idx` は caller が `0` から渡します。vector length 内で `get` が失敗した場合は、破損した decoded vector として fail-closed にします。
fn selfhost_memo_trait_neplproof_index_validation_record_loop %fn &Vec SelfhostMemoTraitNeplProofRecord fn i32 Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \records\idx:
    let n %i32 v::len records
    if:
        ge idx n
        then:
            Result::Ok unit
        else:
            match v::get records idx:
                Option::Some record:
                    match selfhost_memo_trait_neplproof_record_revalidate_for_index_table record:
                        Result::Ok _unit:
                            selfhost_memo_trait_neplproof_index_validation_record_loop records add idx 1
                        Result::Err kind:
                            Result::Err kind
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::RecordEntryMissing

//: selfhost_memo_trait_neplproof_index_validation_duplicate_before_loop: record ordinal の[重複/じゅうふく]を[前方/ぜんぽう]だけで[探/さが]す
//:
//: [目的/もくてき]:
//: - index entry を左から検査しながら、現在 entry より前に同じ record ordinal が出ていないかを確認します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok true`: 前方に同じ record ordinal が存在します。
//: - `Ok false`: 前方に同じ record ordinal は存在しません。
//: - `Err(IndexEntryMissing)`: vector length から有効と判断した位置を読み出せないため、decoded index table の内部破損として扱います。
fn selfhost_memo_trait_neplproof_index_validation_duplicate_before_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn i32 fn i32 fn i32 Result bool SelfhostMemoTraitNeplProofIndexValidationErrorKind \indexes\record_ordinal\idx\scan:
    if:
        ge scan idx
        then:
            Result::Ok false
        else:
            match v::get indexes scan:
                Option::Some previous:
                    if:
                        eq previous.record_ordinal record_ordinal
                        then:
                            Result::Ok true
                        else:
                            selfhost_memo_trait_neplproof_index_validation_duplicate_before_loop indexes record_ordinal idx add scan 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_index_validation_entry_loop: index vector 全体を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - index entry は hint なので、entry が指す record を取得した後も fingerprint と record payload hash を照合します。
//: - record ordinal の重複は missing coverage を隠すため、重複を見つけた時点で `IndexRecordOrdinalDuplicate` を返します。
fn selfhost_memo_trait_neplproof_index_validation_entry_loop %fn &Vec SelfhostMemoTraitNeplProofRecord fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn i32 Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \records\indexes\idx:
    let n %i32 v::len indexes
    let record_count %i32 v::len records
    if:
        ge idx n
        then:
            Result::Ok unit
        else:
            match v::get indexes idx:
                Option::Some entry:
                    match selfhost_memo_trait_neplproof_index_revalidate_for_index_table entry record_count:
                        Result::Ok _unit:
                            match selfhost_memo_trait_neplproof_index_validation_duplicate_before_loop indexes entry.record_ordinal idx 0:
                                Result::Ok has_duplicate:
                                    if:
                                        has_duplicate
                                        then:
                                            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexRecordOrdinalDuplicate
                                        else:
                                            match v::get records entry.record_ordinal:
                                                Option::Some record:
                                                    match selfhost_memo_trait_neplproof_index_entry_matches_record_result entry record:
                                                        Result::Ok _matched:
                                                            selfhost_memo_trait_neplproof_index_validation_entry_loop records indexes add idx 1
                                                        Result::Err _kind:
                                                            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexRecordMismatch
                                                Option::None:
                                                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexEntryInvalid
                                Result::Err kind:
                                    Result::Err kind
                        Result::Err kind:
                            Result::Err kind
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_index_validation_record_covered_loop: 1 つの record ordinal が index から[到達/とうたつ]できるか[調/しら]べる
//:
//: [戻/もど]り[値/ち]:
//: - `Ok true`: 指定 record ordinal を指す index entry が存在します。
//: - `Ok false`: index entry は読めたが、指定 record ordinal を指す entry は存在しません。
//: - `Err(IndexEntryMissing)`: vector length から有効と判断した位置を読み出せないため、coverage 不足ではなく decoded index vector の破損として扱います。
fn selfhost_memo_trait_neplproof_index_validation_record_covered_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn i32 fn i32 Result bool SelfhostMemoTraitNeplProofIndexValidationErrorKind \indexes\record_ordinal\idx:
    let n %i32 v::len indexes
    if:
        ge idx n
        then:
            Result::Ok false
        else:
            match v::get indexes idx:
                Option::Some entry:
                    if:
                        eq entry.record_ordinal record_ordinal
                        then:
                            Result::Ok true
                        else:
                            selfhost_memo_trait_neplproof_index_validation_record_covered_loop indexes record_ordinal add idx 1
                Option::None:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexEntryMissing

//: selfhost_memo_trait_neplproof_index_validation_coverage_loop: record ordinal 全体が index に[覆/おお]われているか[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - index vector の entry 自体は `selfhost_memo_trait_neplproof_index_validation_entry_loop` で検査済みであることを前提にします。
//: - coverage が欠けている場合は、record が store へ投入されても stable index lookup から到達できないため fail-closed にします。
fn selfhost_memo_trait_neplproof_index_validation_coverage_loop %fn &Vec SelfhostMemoTraitNeplProofIndexEntry fn i32 fn i32 Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \indexes\record_count\record_ordinal:
    if:
        ge record_ordinal record_count
        then:
            Result::Ok unit
        else:
            match selfhost_memo_trait_neplproof_index_validation_record_covered_loop indexes record_ordinal 0:
                Result::Ok covered:
                    if:
                        covered
                        then:
                            selfhost_memo_trait_neplproof_index_validation_coverage_loop indexes record_count add record_ordinal 1
                        else:
                            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexRecordOrdinalMissing
                Result::Err kind:
                    Result::Err kind

//: selfhost_memo_trait_neplproof_index_table_result: decoded artifact の index table 全体を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が header、record vector、index vector を decoded した直後に、proof store preseed へ進めてよい artifact かを判定します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok unit`: header 件数、record payload、index entry、record ordinal coverage がすべて整合しています。
//: - `Err(kind)`: decoded artifact が fail-closed に拒否される理由です。
//:
//: [契約/けいやく]:
//: - この関数は file I/O、byte decode、serializer、proof store への投入を行いません。
//: - index entry は候補 narrowing のための sidecar であり、ここで `Ok` になっても proof を受理したことにはなりません。caller は materialized canonical key、policy、proof kind、producer gate を続けて検査します。
//: - store-local id、source text、span、path、diagnostic、lexeme はここでも authority にしません。
pub fn selfhost_memo_trait_neplproof_index_table_result %fn SelfhostMemoTraitNeplProofHeader fn &Vec SelfhostMemoTraitNeplProofRecord fn &Vec SelfhostMemoTraitNeplProofIndexEntry Result unit SelfhostMemoTraitNeplProofIndexValidationErrorKind \header\records\indexes:
    let record_len %i32 v::len records
    let index_len %i32 v::len indexes
    if:
        not eq record_len header.record_count
        then:
            Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::RecordCountMismatch
        else:
            if:
                not eq index_len header.index_count
                then:
                    Result::Err SelfhostMemoTraitNeplProofIndexValidationErrorKind::IndexCountMismatch
                else:
                    match selfhost_memo_trait_neplproof_index_validation_record_loop records 0:
                        Result::Ok _records_valid:
                            match selfhost_memo_trait_neplproof_index_validation_entry_loop records indexes 0:
                                Result::Ok _indexes_valid:
                                    selfhost_memo_trait_neplproof_index_validation_coverage_loop indexes record_len 0
                                Result::Err kind:
                                    Result::Err kind
                        Result::Err kind:
                            Result::Err kind

//: selfhost_memo_trait_neplproof_artifact_error_kind_eq: artifact error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。error variant を追加した場合、この比較関数も明示的に更新します。
pub fn selfhost_memo_trait_neplproof_artifact_error_kind_eq %fn SelfhostMemoTraitNeplProofArtifactErrorKind fn SelfhostMemoTraitNeplProofArtifactErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
            match b:
                SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
                    true
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch:
                    false
        SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch:
            match b:
                SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch:
                    true
                SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch:
                    false
        SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch:
            match b:
                SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch:
                    true
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch:
                    false
        SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative:
            match b:
                SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordCountNegative:
                    true
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexNegative:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch:
                    false
                SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch:
                    false
        SelfhostMemoTraitNeplProofArtifactErrorKind::IndexCountNegative:
            match b:
                SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch:
