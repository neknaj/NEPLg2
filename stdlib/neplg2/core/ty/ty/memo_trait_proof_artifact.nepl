#indent 4

//: # ty/memo_trait_proof_artifact
//: `MemoKey` / `MemoValue` proof を `.neplproof` artifact へ[載/の]せるための typed schema boundary です。
//:
//: [目的/もくてき]:
//: - `memo_trait_proof_store.nepl` は store-local `SelfhostCanonicalTypeKeyId` と canonical key arena を持ちます。この module は、その store-local id を永続 artifact へ出さず、serialized proof record が保持してよい小さい stable payload だけを型として定義します。
//: - `.neplproof` reader / serializer は後続 slice で実装します。この checkpoint では、reader が構築すべき header、record key、record payload、sidecar index entry の shape と fail-closed validation を固定します。
//: - proof artifact の検査を bool や表示文字列へ潰さず、schema mismatch、placeholder hash、index invariant の破損を enum error として返します。
//:
//: [契約/けいやく]:
//: - artifact record key は canonical key の serialized payload schema、canonical type fingerprint、canonical payload hash、solver policy identity を持ちます。`SelfhostCanonicalTypeKeyId`、`SelfhostTypeId`、`SelfhostNamedTypeId`、record index は record key の authority にしません。
//: - canonical payload hash は、後続 serializer が canonical key tree payload を書き出した後に、その payload と fingerprint が同じ入力から来たことを確認するための sidecar です。hash が一致しても reader は store materialization 後に canonical equality、policy equality、proof kind、producer gate を通す必要があります。
//: - sidecar index entry は fingerprint と record ordinal と record payload hash だけを持つ候補 narrowing 用 payload です。index hit は proof acceptance authority ではありません。
//: - source text、source span、path suffix、display name、diagnostic text、lexeme は artifact schema の accepted authority に入りません。必要な source 情報は、すでに stable public surface / policy / canonical fingerprint へ正規化された後の typed payload だけを通します。
//:
//: [現状/げんじょう]:
//: - これは `.neplproof` の binary / text codec ではありません。file I/O、byte parser、serializer、canonical key tree の実際の payload encoding、persistent stable map は後続 slice で追加します。
//: - Phase 1 の record key は `memo_trait_canonical_key_payload.nepl` が materialized canonical key tree から作る nonzero hash を受けます。後続 serializer は同じ payload schema で bytes を読んだ後、この hash producer と同じ authority へ接続します。
//: - record payload は既存 proof store の `SelfhostMemoTraitStoredProofKind` と `SelfhostMemoTraitStoredAggregateProof` をそのまま使います。proof kind は identity には入れませんが、record payload と index payload hash には含める前提です。
//:
//: [計算量/けいさんりょう]:
//: - header / key / record / index の validation は Copy field の比較だけなので O(1) です。
//: - index entry と record の照合も fingerprint と record payload hash の比較だけなので O(1) です。reader が decoded record set 全体を検査する場合は record 数 n に比例します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: ##: [9] ok
//: ##: [10] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_artifact" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_neplproof_artifact_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check selfhost_memo_trait_neplproof_header_result_is_ok summary.accepted_header
//:     let checks2 checks_push checks1 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.header_schema_mismatch) SelfhostMemoTraitNeplProofArtifactErrorKind::ArtifactSchemaMismatch
//:     let checks3 checks_push checks2 check selfhost_memo_trait_neplproof_record_key_result_is_ok summary.accepted_key
//:     let checks4 checks_push checks3 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.key_schema_mismatch) SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalKeySchemaMismatch
//:     let checks5 checks_push checks4 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.key_payload_placeholder) SelfhostMemoTraitNeplProofArtifactErrorKind::CanonicalPayloadHashPlaceholder
//:     let checks6 checks_push checks5 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.policy_schema_mismatch) SelfhostMemoTraitNeplProofArtifactErrorKind::PolicySchemaMismatch
//:     let checks7 checks_push checks6 check selfhost_memo_trait_neplproof_record_result_is_ok summary.accepted_record
//:     let checks8 checks_push checks7 check selfhost_memo_trait_neplproof_index_entry_result_is_ok summary.accepted_index
//:     let checks9 checks_push checks8 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.index_out_of_range) SelfhostMemoTraitNeplProofArtifactErrorKind::RecordIndexOutOfRange
//:     let checks10 checks_push checks9 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.index_fingerprint_mismatch) SelfhostMemoTraitNeplProofArtifactErrorKind::IndexFingerprintMismatch
//:     let checks11 checks_push checks10 check selfhost_memo_trait_neplproof_artifact_error_kind_eq (unwrap_err summary.index_record_hash_mismatch) SelfhostMemoTraitNeplProofArtifactErrorKind::IndexRecordHashMismatch
//:     let shown checks_print_report checks11
//:     checks_exit_code shown
//: ```

#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./memo_trait_canonical_key" as *
#import "./memo_trait_canonical_key_payload" as *
#import "./memo_trait_policy" as *
#import "./memo_trait_proof_store" as *
#import "./memo_trait_producer" as *
#import "./memo_trait" as *

//: SelfhostMemoTraitNeplProofHeader: `.neplproof` artifact 全体の schema header
//:
//: [目的/もくてき]:
//: - reader が record payload を読む前に、artifact schema、canonical key payload schema、policy schema、record / index の件数境界を確認できるようにします。
//:
//: [契約/けいやく]:
//: - `artifact_schema_version` はこの module が定義する `.neplproof` record layout の version です。
//: - `canonical_payload_schema_version` は canonical key tree serialization / payload hash の version です。現段階では payload schema と canonical fingerprint schema の両方に一致することを要求します。
//: - `policy_schema_version` は proof store policy の rule schema version と同じ namespace です。
//: - `record_count` と `index_count` は負であってはいけません。後続 reader はこの件数を上限として allocation と range check を行います。
pub struct SelfhostMemoTraitNeplProofHeader:
    artifact_schema_version %i32
    canonical_payload_schema_version %i32
    policy_schema_version %i32
    record_count %i32
    index_count %i32

//: SelfhostMemoTraitNeplProofRecordKey: serialized proof record の stable key payload
//:
//: [目的/もくてき]:
//: - store-local `SelfhostCanonicalTypeKeyId` を artifact に出さず、canonical payload schema、canonical type fingerprint、canonical payload hash、solver policy を record key として保持します。
//:
//: [契約/けいやく]:
//: - `canonical_fingerprint` は stable nominal key table から作った canonical type fingerprint です。
//: - `canonical_payload_hash` は serialized canonical key tree payload の hash です。`0` は placeholder として拒否します。
//: - `policy` は source identity と solver rule identity を含む reuse boundary です。
pub struct SelfhostMemoTraitNeplProofRecordKey:
    canonical_payload_schema_version %i32
    canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    canonical_payload_hash %i32
    policy %SelfhostMemoTraitProofStorePolicy

//: SelfhostMemoTraitNeplProofRecord: serialized proof record の typed payload
//:
//: [目的/もくてき]:
//: - `.neplproof` の 1 record が持つ key、proof kind、stored proof、record payload hash を 1 つにまとめます。
//:
//: [契約/けいやく]:
//: - `record_payload_hash` は proof kind と stored proof payload を含む serialized record body の hash です。`0` は placeholder として拒否します。
//: - この hash は duplicate / conflict の hint であり、proof acceptance authority ではありません。reader は materialized store record に対して preseed decision と proof store lookup gate を通します。
pub struct SelfhostMemoTraitNeplProofRecord:
    key %SelfhostMemoTraitNeplProofRecordKey
    proof_kind %SelfhostMemoTraitStoredProofKind
    proof %SelfhostMemoTraitStoredAggregateProof
    record_payload_hash %i32

//: SelfhostMemoTraitNeplProofIndexEntry: serialized artifact 内の stable sidecar index entry
//:
//: [目的/もくてき]:
//: - reader が record 全体を毎回走査せず、canonical fingerprint から候補 record ordinal へ narrowing できるようにします。
//:
//: [契約/けいやく]:
//: - `record_ordinal` は artifact record 配列内の ordinal です。負数、または header の `record_count` 以上の値は拒否します。
//: - `record_payload_hash` は index entry が指す record の payload hash と一致しなければいけません。index が古い record や別 record を指す場合は fail-closed にします。
//: - index entry は proof payload、policy、canonical payload hash を複製しません。
pub struct SelfhostMemoTraitNeplProofIndexEntry:
    canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    record_ordinal %i32
    record_payload_hash %i32

//: SelfhostMemoTraitNeplProofArtifactErrorKind: `.neplproof` schema validation の拒否理由
//:
//: [目的/もくてき]:
//: - schema mismatch、placeholder hash、index invariant 破損を表示文字列ではなく enum として扱います。
pub enum SelfhostMemoTraitNeplProofArtifactErrorKind:
    ArtifactSchemaMismatch
    CanonicalKeySchemaMismatch
    PolicySchemaMismatch
    RecordCountNegative
    IndexCountNegative
    CanonicalPayloadHashPlaceholder
    RecordPayloadHashPlaceholder
    RecordIndexNegative
    RecordIndexOutOfRange
    IndexFingerprintMismatch
    IndexRecordHashMismatch

//: SelfhostMemoTraitNeplProofArtifactStage0Summary: artifact schema focused smoke summary
pub struct SelfhostMemoTraitNeplProofArtifactStage0Summary:
    accepted_header %Result SelfhostMemoTraitNeplProofHeader SelfhostMemoTraitNeplProofArtifactErrorKind
    header_schema_mismatch %Result SelfhostMemoTraitNeplProofHeader SelfhostMemoTraitNeplProofArtifactErrorKind
    accepted_key %Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind
    key_schema_mismatch %Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind
    key_payload_placeholder %Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind
    policy_schema_mismatch %Result SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofArtifactErrorKind
    accepted_record %Result SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofArtifactErrorKind
    accepted_index %Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofArtifactErrorKind
    index_out_of_range %Result SelfhostMemoTraitNeplProofIndexEntry SelfhostMemoTraitNeplProofArtifactErrorKind
    index_fingerprint_mismatch %Result unit SelfhostMemoTraitNeplProofArtifactErrorKind
    index_record_hash_mismatch %Result unit SelfhostMemoTraitNeplProofArtifactErrorKind

