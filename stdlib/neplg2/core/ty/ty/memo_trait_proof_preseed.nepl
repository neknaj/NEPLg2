        Result::Err e:
            let error %StdErrorKind field::get e "error"
            let build_error %SelfhostMemoTraitNeplProofDecodedBatchStdError selfhost_memo_trait_neplproof_decoded_batch_std_error_new record_ordinal error
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::BatchRecordPushInvalid build_error

//: selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_loop: decoded artifact から batch record を順に[作/つく]る
//:
//: [契約/けいやく]:
//: - `record_ordinal` は artifact record と materialized key id vector の同じ index を対応させます。
//: - `materialized_key_id` は vector に存在するだけでは不十分です。caller-owned materialized key arena でも読めることを確認してから batch record に入れます。
//: - builder は batch append を実行しません。proof acceptance は後続の `selfhost_memo_trait_neplproof_decoded_record_batch_append` が再検査します。
//: - 個別 record / key id の取得に失敗した場合、構築中の output vector を閉じます。
fn selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_loop %impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn Vec SelfhostMemoTraitNeplProofDecodedBatchRecord impure fn i32 impure fn i32 Result Vec SelfhostMemoTraitNeplProofDecodedBatchRecord SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind \artifact\materialized_key_arena\materialized_key_ids\expected_policy\out\record_ordinal\record_count:
    if:
        ge record_ordinal record_count
        then:
            Result::Ok out
        else:
            match v::get materialized_key_ids record_ordinal:
                Option::Some materialized_key_id:
                    match selfhost_canonical_type_key_arena_get_node materialized_key_arena materialized_key_id:
                        Option::Some _node:
                            match selfhost_memo_trait_neplproof_decoded_artifact_record_at_result artifact record_ordinal:
                                Result::Ok record:
                                    let batch_record %SelfhostMemoTraitNeplProofDecodedBatchRecord selfhost_memo_trait_neplproof_decoded_batch_record_new materialized_key_id expected_policy record
                                    match selfhost_memo_trait_neplproof_decoded_batch_records_push out batch_record record_ordinal:
                                        Result::Ok next_out:
                                            selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_loop artifact materialized_key_arena materialized_key_ids expected_policy next_out add record_ordinal 1 record_count
                                        Result::Err push_error:
                                            Result::Err push_error
                                Result::Err artifact_error:
                                    let build_error %SelfhostMemoTraitNeplProofDecodedBatchRecordError selfhost_memo_trait_neplproof_decoded_batch_record_error_new record_ordinal artifact_error
                                    v::free out
                                    Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::RecordInvalid build_error
                        Option::None:
                            v::free out
                            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyMissing record_ordinal
                Option::None:
                    v::free out
                    Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyMissing record_ordinal

//: selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_result: decoded artifact と materialized key id 列から batch input を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が record bytes と canonical payload bytes を別々に decode した後、decoded artifact record ordinal と materialized canonical key id を 1 対 1 に対応付けます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(records)`: caller は返された `Vec SelfhostMemoTraitNeplProofDecodedBatchRecord` owner を batch append 後に閉じます。
//: - `Err(kind)`: decoded artifact invariant、materialized key id coverage、record copy-out、output vector allocation / push のいずれかで fail-closed になりました。作成途中の output vector はこの関数内で閉じています。
//:
//: [契約/けいやく]:
//: - `materialized_key_ids[i]` は `artifact.records[i]` の canonical payload bytes から materialized された key id でなければいけません。
//: - `materialized_key_ids[i]` は caller-owned `materialized_key_arena` で実在する slot でなければいけません。存在しない id は `MaterializedKeyMissing(i)` として拒否します。
//: - この関数は source text、span、path、diagnostic、lexeme、index hit を authority にしません。
//: - `expected_policy` は現在の compiler policy から来る値です。record key 内の policy と一致するかは batch append 側が再検査します。
//:
//: [計算量/けいさんりょう]:
//: - record 数 m に対して、artifact validate と長さ確認の後、record / key id を 1 回ずつ copy-out するため O(m) です。
pub fn selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_result %impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy Result Vec SelfhostMemoTraitNeplProofDecodedBatchRecord SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind \artifact\materialized_key_arena\materialized_key_ids\expected_policy:
    match selfhost_memo_trait_neplproof_decoded_artifact_validate_result artifact:
        Result::Ok _unit:
            let header %SelfhostMemoTraitNeplProofHeader *field::get_ref artifact "header"
            if:
                ne v::len materialized_key_ids header.record_count
                then:
                    Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyCountMismatch
                else:
                    let out_result %Result Vec SelfhostMemoTraitNeplProofDecodedBatchRecord StdErrorKind v::new
                    match out_result:
                        Result::Ok out:
                            selfhost_memo_trait_neplproof_decoded_batch_records_from_artifact_loop artifact materialized_key_arena materialized_key_ids expected_policy out 0 header.record_count
                        Result::Err error:
                            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::BatchRecordAllocInvalid error
        Result::Err artifact_error:
            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::ArtifactInvalid artifact_error

//: selfhost_memo_trait_neplproof_decoded_batch_record_from_candidate_result: candidate range から batch record 1 件を[作/つく]る
//:
//: [目的/もくてき]:
//: - sorted index lookup で得た candidate range を、preseed batch append が扱う `SelfhostMemoTraitNeplProofDecodedBatchRecord` へ変換します。
//: - full artifact projector が全 record を順に投影するのに対し、この API は lookup target の candidate 1 件だけを取り出す reader / cache hit path の前段です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(record)`: candidate accessor が返した record ordinal に対応する materialized key id が caller-owned arena に存在し、batch append へ渡せる copy payload が作られました。
//: - `Err(kind)`: candidate range / offset / target / record 対応、materialized key table coverage、materialized key arena coverage のいずれかで fail-closed になりました。
//:
//: [契約/けいやく]:
//: - `candidate_offset` は candidate range 内の相対 offset です。materialized key id vector の index として使ってはいけません。
//: - materialized key id は、candidate accessor が返した `index_entry.record_ordinal` で読みます。これにより sorted index の並び順と decoded record ordinal を混同しません。
//: - この関数は proof acceptance ではありません。後続の `selfhost_memo_trait_neplproof_record_append_materialized_checked` が canonical payload hash、fingerprint、policy、store relation を再検査します。
//: - source text、span、path、diagnostic、lexeme、index hit だけを authority にしません。
//:
//: [計算量/けいさんりょう]:
//: - candidate accessor は artifact validation、candidate range validation、target fingerprint check、index entry / record 対応検査を再実行します。この関数自身の追加処理は、成功後の materialized key id lookup と arena slot check を O(1) で行います。
pub fn selfhost_memo_trait_neplproof_decoded_batch_record_from_candidate_result %impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofIndexCandidateRange impure fn i32 Result SelfhostMemoTraitNeplProofDecodedBatchRecord SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind \artifact\materialized_key_arena\materialized_key_ids\expected_policy\target\candidate_range\candidate_offset:
    match selfhost_memo_trait_neplproof_decoded_artifact_candidate_record_at_result artifact target candidate_range candidate_offset:
        Result::Ok candidate_record:
            let header %SelfhostMemoTraitNeplProofHeader *field::get_ref artifact "header"
            if:
                ne v::len materialized_key_ids header.record_count
                then:
                    Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyCountMismatch
                else:
                    let candidate_index_entry %SelfhostMemoTraitNeplProofIndexEntry *field::get_ref &candidate_record "index_entry"
                    let candidate_payload_record %SelfhostMemoTraitNeplProofRecord *field::get_ref &candidate_record "record"
                    let record_ordinal %i32 candidate_index_entry.record_ordinal
                    match v::get materialized_key_ids record_ordinal:
                        Option::Some materialized_key_id:
                            match selfhost_canonical_type_key_arena_get_node materialized_key_arena materialized_key_id:
                                Option::Some _node:
                                    Result::Ok selfhost_memo_trait_neplproof_decoded_batch_record_new materialized_key_id expected_policy candidate_payload_record
                                Option::None:
                                    Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyMissing record_ordinal
                        Option::None:
                            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyMissing record_ordinal
        Result::Err artifact_error:
            let candidate_error %SelfhostMemoTraitNeplProofDecodedBatchCandidateError selfhost_memo_trait_neplproof_decoded_batch_candidate_error_new candidate_offset artifact_error
            Result::Err SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::CandidateInvalid candidate_error

//: selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_build_error: build error を candidate offset 付き preseed error に[写/うつ]す
fn selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_build_error %fn i32 fn SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedError \candidate_offset\build_error:
    selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_error_new candidate_offset SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedErrorKind::BuildInvalid build_error

//: selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_append_error: append error を candidate offset 付き preseed error に[写/うつ]す
fn selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_append_error %fn i32 fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedError \candidate_offset\append_error:
    selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_error_new candidate_offset SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedErrorKind::AppendInvalid append_error

//: selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_one: candidate 1 件を build して store へ[投入/とうにゅう]する
//:
//: [契約/けいやく]:
//: - build failure では入力 store owner をこの helper が閉じます。
//: - append failure は `selfhost_memo_trait_neplproof_record_append_materialized_checked` の contract に従って store が閉じられた状態で返ります。
fn selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_one %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofIndexCandidateRange impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedError \store\nominal_table\materialized_key_arena\artifact\materialized_key_ids\expected_policy\target\candidate_range\candidate_offset:
    match selfhost_memo_trait_neplproof_decoded_batch_record_from_candidate_result artifact materialized_key_arena materialized_key_ids expected_policy target candidate_range candidate_offset:
        Result::Ok batch_record:
            match selfhost_memo_trait_neplproof_record_append_materialized_checked store nominal_table materialized_key_arena batch_record.materialized_key_id batch_record.expected_policy batch_record.record:
                Result::Ok next_store:
                    Result::Ok next_store
                Result::Err append_error:
                    Result::Err selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_append_error candidate_offset append_error
        Result::Err build_error:
            selfhost_memo_trait_proof_store_free store
            Result::Err selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_build_error candidate_offset build_error

//: selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_loop: candidate range を順に preseed する
//:
//: [契約/けいやく]:
//: - `candidate_offset` は range-local offset として error に保持します。artifact record ordinal や sorted index absolute position ではありません。
//: - 途中で失敗した場合、store owner は閉じられており、部分投入済み store を返しません。
fn selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_loop %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofIndexCandidateRange impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedError \store\nominal_table\materialized_key_arena\artifact\materialized_key_ids\expected_policy\target\candidate_range\candidate_offset:
    if:
        ge candidate_offset candidate_range.candidate_count
        then:
            Result::Ok store
        else:
            match selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_one store nominal_table materialized_key_arena artifact materialized_key_ids expected_policy target candidate_range candidate_offset:
                Result::Ok next_store:
                    selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_loop next_store nominal_table materialized_key_arena artifact materialized_key_ids expected_policy target candidate_range add candidate_offset 1
                Result::Err error:
                    Result::Err error

//: selfhost_memo_trait_neplproof_decoded_candidate_range_preseed: sorted index candidate range を proof store へ[投入/とうにゅう]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が decoded artifact、materialized key id table、lookup target fingerprint、candidate range を得た後、対象 candidate group だけを working proof store へ preseed します。
//: - 全 record を preseed する batch path と違い、lookup で絞り込んだ candidate range だけを通すため、reader / cache hit path の探索範囲を candidate 数 c に制限します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(store)`: candidate range 内の全 candidate が `AcceptMissing` append または `ExistingMatching` skip として処理されました。
//: - `Err(error)`: `error.candidate_offset` の candidate で build または append が fail-closed になりました。入力 store owner は閉じられており、caller は部分投入済み store を使ってはいけません。
//:
//: [契約/けいやく]:
//: - この API は `.neplproof` reader / serializer 本体ではありません。record bytes decode、persistent stable map、serialized index の責務を持ちません。
//: - この API は proof acceptance ではありません。candidate range は探索範囲を狭めるだけで、canonical payload hash、fingerprint、policy、store relation の受理判定は `selfhost_memo_trait_neplproof_record_append_materialized_checked` が再検査します。
//: - candidate range が壊れている場合も、`candidate_offset = 0` の build error として single-candidate projector の typed error を返します。
//: - `candidate_offset` は error payload にだけ使います。materialized key id lookup は single-candidate projector が `index_entry.record_ordinal` で行います。
//: - fingerprint、payload hash、policy、store relation は record ごとに `selfhost_memo_trait_neplproof_record_append_materialized_checked` が再検査します。
//:
//: [計算量/けいさんりょう]:
//: - candidate 数 c に対して、各 candidate の accessor validation と store relation 判定を行います。現段階では accessor が artifact validation を再実行するため O(c * artifact_validation + c * n * k + materialization) です。
pub fn selfhost_memo_trait_neplproof_decoded_candidate_range_preseed %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &SelfhostMemoTraitNeplProofDecodedArtifact impure fn &Vec SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofIndexCandidateRange Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofDecodedCandidateRangePreseedError \store\nominal_table\materialized_key_arena\artifact\materialized_key_ids\expected_policy\target\candidate_range:
    if:
        le candidate_range.candidate_count 0
        then:
            selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_one store nominal_table materialized_key_arena artifact materialized_key_ids expected_policy target candidate_range 0
        else:
            selfhost_memo_trait_neplproof_decoded_candidate_range_preseed_loop store nominal_table materialized_key_arena artifact materialized_key_ids expected_policy target candidate_range 0

//: selfhost_memo_trait_neplproof_preseed_batch_error_new: ordinal 付き batch error を[作/つく]る
fn selfhost_memo_trait_neplproof_preseed_batch_error_new %fn i32 fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind SelfhostMemoTraitNeplProofPreseedBatchError \record_ordinal\kind:
    SelfhostMemoTraitNeplProofPreseedBatchError record_ordinal kind

//: selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq: batch error kind が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - `RecordAppendInvalid` は単一 record append error の nested payload まで比較します。
//: - wildcard arm は使わず、variant 追加時に match の更新漏れが見える形にします。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq %fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
            match b:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    true
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid _b_error:
                    false
        SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid a_error:
            match b:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    false
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid b_error:
                    selfhost_memo_trait_neplproof_preseed_append_error_kind_eq a_error b_error

//: selfhost_memo_trait_neplproof_preseed_batch_error_eq: batch error が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - record ordinal と nested error kind の両方が一致した場合だけ true を返します。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_eq %fn SelfhostMemoTraitNeplProofPreseedBatchError fn SelfhostMemoTraitNeplProofPreseedBatchError bool \a\b:
    and:
        eq a.record_ordinal b.record_ordinal
        selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq a.kind b.kind

//: selfhost_memo_trait_neplproof_preseed_batch_error_is_append: batch error が指定 ordinal の append error か[返/かえ]す
//:
//: [目的/もくてき]:
//: - doctest と source policy が、ordinal と単一 record append error payload の両方を簡潔に確認できるようにします。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_is_append %fn SelfhostMemoTraitNeplProofPreseedBatchError fn i32 fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind bool \error\record_ordinal\append_error:
    if:
        not eq error.record_ordinal record_ordinal
        then:
            false
        else:
            match error.kind:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    false
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid actual:
                    selfhost_memo_trait_neplproof_preseed_append_error_kind_eq actual append_error

//: selfhost_memo_trait_neplproof_preseed_result_is_ok: decoded preseed 判定が成功したか[返/かえ]す
pub fn selfhost_memo_trait_neplproof_preseed_result_is_ok %fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind bool \result:
    match result:
        Result::Ok _decision:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_preseed_batch_result_is_ok: batch preseed が成功したか[返/かえ]す
pub fn selfhost_memo_trait_neplproof_preseed_batch_result_is_ok %fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked: validation 済み record を store relation 判定へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - materialized key が candidate arena に存在しない場合は、store を走査せず `MaterializedCanonicalKeyMissing` を返します。
//: - canonical payload hash、canonical fingerprint、policy は、この順で照合します。前段が失敗した場合、後段の decision は作りません。
//: - canonical payload hash は caller から受け取らず、materialized canonical key tree からこの関数内で再計算します。
fn selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record:
    match selfhost_canonical_type_key_arena_get_node materialized_key_arena materialized_key_id:
        Option::Some _node:
            match selfhost_memo_trait_canonical_key_payload_hash_result nominal_table materialized_key_arena materialized_key_id:
                Result::Ok payload_hash:
                    let materialized_canonical_payload_hash %i32 selfhost_memo_trait_canonical_key_payload_hash_value payload_hash
                    if:
                        not eq materialized_canonical_payload_hash record.key.canonical_payload_hash
                        then:
                            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch
                        else:
                            if:
                                not selfhost_memo_trait_canonical_type_fingerprint_eq materialized_fingerprint record.key.canonical_fingerprint
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch
                                else:
                                    if:
                                        not selfhost_memo_trait_proof_store_policy_eq expected_policy record.key.policy
                                        then:
                                            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch
                                        else:
                                            Result::Ok selfhost_memo_trait_proof_store_preseed_decision_materialized_key store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record.proof_kind record.proof
                Result::Err payload_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid payload_error
        Option::None:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing

//: selfhost_memo_trait_neplproof_record_preseed_decision_materialized: decoded record を validation して preseed 判定へ[進/すす]める
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が record bytes を schema 型へ decode した後、store へ record を追加するか、skip するか、conflict として拒否するかを決める入口です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(AcceptMissing)`: record key と同じ stable identity は store にありません。caller はこの record を materialized store append へ進められます。
//: - `Ok(ExistingMatching)`: 同じ stable identity と同じ proof payload が既に store にあります。caller は再追加を skip できます。
//: - `Ok(RejectedConflict)`: 同じ stable identity で異なる proof payload が既に store にあります。caller は artifact を上書きせず拒否します。
//: - `Err(kind)`: artifact schema または decoded key と record key の対応が壊れています。caller は通常検査へ fallback し、artifact を authority として使ってはいけません。
//:
//: [契約/けいやく]:
//: - canonical payload hash は caller から raw `i32` として受け取らず、`nominal_table` と `materialized_key_arena` から再計算します。
pub fn selfhost_memo_trait_neplproof_record_preseed_decision_materialized %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record:
    match selfhost_memo_trait_neplproof_record_key_result record.key.canonical_fingerprint record.key.canonical_payload_schema_version record.key.canonical_payload_hash record.key.policy:
        Result::Ok checked_key:
            match selfhost_memo_trait_neplproof_record_result checked_key record.proof_kind record.proof record.record_payload_hash:
                Result::Ok checked_record:
                    selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint checked_record
                Result::Err artifact_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid artifact_error
        Result::Err artifact_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid artifact_error

//: selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked: decoded owner 参照を materialized 判定へ[渡/わた]す
//:
//: [目的/もくてき]:
//: - codec が作った `SelfhostMemoTraitCanonicalKeyPayloadDecoded` から arena と root を取り出し、fingerprint を再計算してから既存の materialized preseed 判定へ進めます。
//:
//: [契約/けいやく]:
//: - decoded owner の解放は caller が行います。この helper は借用だけを受け取り、owner を閉じません。
//: - fingerprint 生成に失敗した場合は typed error へ畳み込み、raw hash や placeholder を authority として扱いません。
fn selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostMemoTraitCanonicalKeyPayloadDecoded fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\decoded\expected_policy\record:
    let materialized_key_arena %&SelfhostCanonicalTypeKeyArena field::get_ref decoded "arena"
    let materialized_key_id %SelfhostCanonicalTypeKeyId *field::get_ref decoded "root"
    match selfhost_memo_trait_canonical_type_fingerprint_result nominal_table materialized_key_arena materialized_key_id:
        Result::Ok materialized_fingerprint:
            selfhost_memo_trait_neplproof_record_preseed_decision_materialized store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record
        Result::Err fingerprint_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid fingerprint_error

//: selfhost_memo_trait_neplproof_record_preseed_decision_decoded_payload_bytes: canonical payload bytes から preseed 判定を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が record key と canonical payload bytes を得た後、bytes decode、fingerprint 再計算、payload hash 再計算、policy 照合、store relation 判定を1つの入口で行います。
//:
//: [契約/けいやく]:
//: - bytes 内や record key 内の hash だけを信用しません。decode した canonical key arena から fingerprint と payload hash を再計算します。
//: - この関数は store を変更しません。`AcceptMissing` を受けて store に追加するかどうかは append API が担当します。
//: - decode した canonical payload owner は、この関数内で必ず閉じます。
pub fn selfhost_memo_trait_neplproof_record_preseed_decision_decoded_payload_bytes %impure fn &SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\canonical_payload_bytes\expected_policy\record:
    match selfhost_memo_trait_canonical_key_payload_decode_result nominal_table canonical_payload_bytes:
        Result::Ok decoded:
            let result %Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked store nominal_table &decoded expected_policy record
            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
            result
        Result::Err decode_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid decode_error

//: selfhost_memo_trait_neplproof_record_append_materialized_decision: materialized key と preseed decision から store 更新を[行/おこな]う
//:
//: [目的/もくてき]:
//: - bytes decode 済み single-record append と batch append が、`AcceptMissing` / `ExistingMatching` / `RejectedConflict` の所有権 contract を共有できるようにします。
//:
//: [契約/けいやく]:
//: - `AcceptMissing` では proof store 側の materialized append API だけを使い、caller-owned key id を store-local id として保存しません。
//: - `ExistingMatching` は store owner をそのまま返します。
//: - `RejectedConflict` は store owner を閉じてから typed error を返します。
fn selfhost_memo_trait_neplproof_record_append_materialized_decision %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitProofStorePreseedDecision Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record\decision:
    match decision:
        SelfhostMemoTraitProofStorePreseedDecision::AcceptMissing:
            match selfhost_memo_trait_proof_store_push_materialized_key store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record.proof_kind record.proof:
                Result::Ok next_store:
                    Result::Ok next_store
                Result::Err push_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid push_error
        SelfhostMemoTraitProofStorePreseedDecision::ExistingMatching:
            Result::Ok store
        SelfhostMemoTraitProofStorePreseedDecision::RejectedConflict:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict

//: selfhost_memo_trait_neplproof_record_append_materialized_checked: materialized key から single-record append を[試/こころ]みる
//:
//: [目的/もくてき]:
//: - batch loop が bytes owner を持たず、reader が materialized arena に置いた key id だけを持つ場合でも、single-record append と同じ検査順序を使えるようにします。
//:
//: [契約/けいやく]:
//: - fingerprint は caller から受け取らず、`nominal_table` と `materialized_key_arena` からこの helper 内で再計算します。
//: - decision error または fingerprint error では入力 store を閉じ、partial seeded store を成功値として返しません。
fn selfhost_memo_trait_neplproof_record_append_materialized_checked %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\record:
    match selfhost_memo_trait_canonical_type_fingerprint_result nominal_table materialized_key_arena materialized_key_id:
        Result::Ok materialized_fingerprint:
            match selfhost_memo_trait_neplproof_record_preseed_decision_materialized &store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record:
                Result::Ok decision:
                    selfhost_memo_trait_neplproof_record_append_materialized_decision store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record decision
                Result::Err decision_error:
                    selfhost_memo_trait_proof_store_free store
                    Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid decision_error
        Result::Err fingerprint_error:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid fingerprint_error

//: selfhost_memo_trait_neplproof_record_append_decoded_checked: decoded owner 参照から store append を[試/こころ]みる
//:
//: [目的/もくてき]:
//: - decoded canonical key に対する fingerprint 再計算、record validation、preseed decision、store append を順に行う single-record bridge です。
//:
//: [契約/けいやく]:
//: - この helper は decoded owner を解放しません。bytes-level public API が decode 成功後に必ず owner を閉じます。
//: - decision error または fingerprint error では入力 store を閉じ、partial seeded store を成功値として返しません。
fn selfhost_memo_trait_neplproof_record_append_decoded_checked %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostMemoTraitCanonicalKeyPayloadDecoded impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\decoded\expected_policy\record:
    let materialized_key_arena %&SelfhostCanonicalTypeKeyArena field::get_ref decoded "arena"
    let materialized_key_id %SelfhostCanonicalTypeKeyId *field::get_ref decoded "root"
    selfhost_memo_trait_neplproof_record_append_materialized_checked store nominal_table materialized_key_arena materialized_key_id expected_policy record

//: selfhost_memo_trait_neplproof_record_append_decoded_payload_bytes: decoded record を proof store へ[投入/とうにゅう]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が1 record分の canonical payload bytes と typed record payload を得た後、store へ安全に preseed します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(store)`: `ExistingMatching` なら store は変更されず、`AcceptMissing` なら materialized canonical key と proof record が追加された store を返します。
//: - `Err(kind)`: decode、fingerprint、record validation、conflict、store append のいずれかで fail-closed になりました。入力 store owner は閉じられており、caller はその store を compile に使ってはいけません。
//:
//: [契約/けいやく]:
//: - `AcceptMissing` の場合だけ `selfhost_memo_trait_proof_store_push_materialized_key` を呼びます。
//: - `ExistingMatching` は同じ artifact record の再投入なので skip します。
//: - `RejectedConflict` は warning や duplicate skip ではなく `RejectedConflict` error として返します。
pub fn selfhost_memo_trait_neplproof_record_append_decoded_payload_bytes %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\canonical_payload_bytes\expected_policy\record:
    match selfhost_memo_trait_canonical_key_payload_decode_result nominal_table canonical_payload_bytes:
        Result::Ok decoded:
            let result %Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind selfhost_memo_trait_neplproof_record_append_decoded_checked store nominal_table &decoded expected_policy record
            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
            result
        Result::Err decode_error:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid decode_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_error: batch ordinal と append error を[束/たば]ねる
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_error %fn i32 fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind SelfhostMemoTraitNeplProofPreseedBatchError \record_ordinal\append_error:
    selfhost_memo_trait_neplproof_preseed_batch_error_new record_ordinal SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid append_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_one: batch record 1 件を store へ[投入/とうにゅう]する
//:
//: [契約/けいやく]:
//: - `record_ordinal` は error payload にだけ使い、proof store の authority にはしません。
//: - failure は `selfhost_memo_trait_neplproof_record_append_materialized_checked` の contract に従って store を閉じたうえで返ります。
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_one %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitNeplProofDecodedBatchRecord impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedBatchError \store\nominal_table\materialized_key_arena\batch_record\record_ordinal:
    match selfhost_memo_trait_neplproof_record_append_materialized_checked store nominal_table materialized_key_arena batch_record.materialized_key_id batch_record.expected_policy batch_record.record:
        Result::Ok next_store:
            Result::Ok next_store
        Result::Err append_error:
            Result::Err selfhost_memo_trait_neplproof_decoded_record_batch_append_error record_ordinal append_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_loop: materialized decoded record 列を順に preseed する
//:
//: [契約/けいやく]:
//: - record は入力順に処理します。後続で persistent stable map を導入しても、この fail-closed の順序と ordinal error は維持します。
//: - どこか 1 件でも失敗した場合、入力 store owner は閉じられており、この loop は部分投入済み store を返しません。
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_loop %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostMemoTraitNeplProofDecodedBatchRecord impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedBatchError \store\nominal_table\materialized_key_arena\records\idx:
    let n %i32 v::len records
    if:
        ge idx n
        then:
            Result::Ok store
        else:
            match v::get records idx:
                Option::Some batch_record:
                    match selfhost_memo_trait_neplproof_decoded_record_batch_append_one store nominal_table materialized_key_arena batch_record idx:
                        Result::Ok next_store:
                            selfhost_memo_trait_neplproof_decoded_record_batch_append_loop next_store nominal_table materialized_key_arena records add idx 1
                        Result::Err batch_error:
                            Result::Err batch_error
                Option::None:
                    selfhost_memo_trait_proof_store_free store
                    Result::Err selfhost_memo_trait_neplproof_preseed_batch_error_new idx SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing

//: selfhost_memo_trait_neplproof_decoded_record_batch_append: materialized decoded record batch を proof store へ[投入/とうにゅう]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が複数 record の typed payload と materialized key id を得た後、working proof store へ順に preseed します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(store)`: すべての record が `AcceptMissing` append または `ExistingMatching` skip として処理され、成功した working store を返します。
//: - `Err(error)`: `error.record_ordinal` の record で fail-closed になりました。入力 store owner は閉じられており、caller は部分投入済み store を使ってはいけません。
//:
//: [契約/けいやく]:
//: - この API は materialized key arena を借用するだけで、arena owner を閉じません。arena の lifetime は caller が batch 完了後に管理します。
//: - binary `.neplproof` reader、record bytes decode、serialized index、persistent map はこの API の責務ではありません。
//: - fingerprint、payload hash、policy は record ごとに再検査します。`SelfhostMemoTraitNeplProofDecodedBatchRecord` 内の key id や artifact record key だけでは受理しません。
//:
//: [計算量/けいさんりょう]:
//: - m 件の record に対して、各 record の key validation と store relation 判定を行うため O(m * n * k + materialization) です。
pub fn selfhost_memo_trait_neplproof_decoded_record_batch_append %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostMemoTraitNeplProofDecodedBatchRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedBatchError \store\nominal_table\materialized_key_arena\records:
    selfhost_memo_trait_neplproof_decoded_record_batch_append_loop store nominal_table materialized_key_arena records 0

//: selfhost_memo_trait_neplproof_preseed_stage0_summary_new: stage0 summary を[作/つく]る
fn selfhost_memo_trait_neplproof_preseed_stage0_summary_new %fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError fn Result unit SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind fn Result unit SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind fn Result unit SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind fn Result unit SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind SelfhostMemoTraitNeplProofPreseedStage0Summary \accept_missing\existing_matching\rejected_conflict\missing_key\hash_mismatch\fingerprint_mismatch\policy_mismatch\invalid_record\batch_empty\batch_existing_matching\batch_rejected_conflict\batch_invalid_record\batch_from_artifact\batch_from_artifact_count_mismatch\batch_candidate_from_artifact\batch_candidate_offset_mismatch:
    SelfhostMemoTraitNeplProofPreseedStage0Summary accept_missing existing_matching rejected_conflict missing_key hash_mismatch fingerprint_mismatch policy_mismatch invalid_record batch_empty batch_existing_matching batch_rejected_conflict batch_invalid_record batch_from_artifact batch_from_artifact_count_mismatch batch_candidate_from_artifact batch_candidate_offset_mismatch

//: selfhost_memo_trait_neplproof_preseed_stage0_finish: owner を[閉/と]じて summary を[返/かえ]す
fn selfhost_memo_trait_neplproof_preseed_stage0_finish %impure fn SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitProofStore impure fn SelfhostMemoTraitNeplProofPreseedStage0Summary Result SelfhostMemoTraitNeplProofPreseedStage0Summary StdErrorKind \arena\materialized_key_arena\store\summary:
    selfhost_memo_trait_proof_store_free store
    selfhost_canonical_type_key_arena_free materialized_key_arena
    selfhost_type_arena_free arena
    Result::Ok summary

//: selfhost_memo_trait_neplproof_preseed_stage0_finish_with_nominal_table: stable nominal table も[閉/と]じて summary を[返/かえ]す
fn selfhost_memo_trait_neplproof_preseed_stage0_finish_with_nominal_table %impure fn SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitProofStore impure fn SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostMemoTraitNeplProofPreseedStage0Summary Result SelfhostMemoTraitNeplProofPreseedStage0Summary StdErrorKind \arena\materialized_key_arena\store\nominal_table\summary:
    selfhost_memo_trait_stable_nominal_key_table_free nominal_table
    selfhost_memo_trait_neplproof_preseed_stage0_finish arena materialized_key_arena store summary

//: selfhost_memo_trait_neplproof_preseed_stage0_finish_after_closed_store: store が append API に[閉/と]じられた後で summary を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `RejectedConflict` の append API は、失敗を返す前に入力 store owner を閉じます。
//: - stage0 はその契約を尊重し、store を二重に解放せず、残った nominal table / canonical key arena / type arena だけを閉じます。
fn selfhost_memo_trait_neplproof_preseed_stage0_finish_after_closed_store %impure fn SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostMemoTraitNeplProofPreseedStage0Summary Result SelfhostMemoTraitNeplProofPreseedStage0Summary StdErrorKind \arena\materialized_key_arena\nominal_table\summary:
    selfhost_memo_trait_stable_nominal_key_table_free nominal_table
    selfhost_canonical_type_key_arena_free materialized_key_arena
    selfhost_type_arena_free arena
    Result::Ok summary

//: selfhost_memo_trait_neplproof_preseed_stage0_abort_with_key_store: owner を[閉/と]じて setup 失敗を[返/かえ]す
fn selfhost_memo_trait_neplproof_preseed_stage0_abort_with_key_store %impure fn SelfhostTypeArena impure fn SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitProofStore Result SelfhostMemoTraitNeplProofPreseedStage0Summary StdErrorKind \arena\materialized_key_arena\store:
    selfhost_memo_trait_proof_store_free store
    selfhost_canonical_type_key_arena_free materialized_key_arena
    selfhost_type_arena_free arena
    Result::Err StdErrorKind::InvalidOperation

//: selfhost_memo_trait_neplproof_preseed_stage0_abort_with_key_store_nominal_table: nominal table を[含/ふく]む setup 失敗 owner を[閉/と]じる
