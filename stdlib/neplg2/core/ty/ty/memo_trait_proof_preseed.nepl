#indent 4

//: # ty/memo_trait_proof_preseed
//: decoded `.neplproof` record を proof store の preseed 判定へつなぐ境界です。
//:
//: [目的/もくてき]:
//: - `memo_trait_proof_artifact.nepl` は serialized record の schema と placeholder 検査だけを担当します。
//: - `memo_trait_proof_store.nepl` は canonical key arena と proof record を所有し、既存 store との重複や conflict を判定します。
//: - この module は、decoded canonical key payload bytes を materialize し、artifact record key、materialized key fingerprint、solver policy を照合し、問題がない場合だけ proof store の materialized preseed / append API へ進めます。
//:
//: [契約/けいやく]:
//: - `materialized_fingerprint` は、decoded canonical key payload から作られた値でなければいけません。payload hash は `memo_trait_canonical_key_payload.nepl` の producer で materialized canonical key tree からこの module が再計算し、caller から raw `i32` として受け取りません。
//: - record schema validation、canonical payload materialization、canonical payload hash、canonical fingerprint、policy の不一致は typed error として返します。`AcceptMissing` / `ExistingMatching` / `RejectedConflict` は、これらの照合を通過した後の store relation だけを表します。
//: - store-local `SelfhostCanonicalTypeKeyId` や `SelfhostMemoTraitProofStoreStableIdentity` は artifact schema に出しません。caller-owned materialized arena と store arena は proof store 側の cross-arena equality で比較します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では `.neplproof` artifact 全体の reader / serializer はまだこの module にありません。canonical payload bytes の codec は `memo_trait_canonical_key_payload_codec.nepl` に分離し、この module は codec の decoded owner を proof store 境界へ渡します。
//: - batch preseed は、reader が materialized canonical key arena と typed record を作った後の copyable batch record だけを扱います。decoded artifact と materialized key id vector から batch record vector を作る projector はこの module に置きますが、per-record bytes table、binary reader、serializer、persistent stable map は後続 slice の責務です。
//: - empty store に対する `AcceptMissing`、seed 済み store に対する `ExistingMatching` / `RejectedConflict`、hash / fingerprint / policy / invalid record の fail-closed 分類と、batch の empty / skip / conflict / invalid-record ordinal を stage0 で確認します。
//:
//: [計算量/けいさんりょう]:
//: - artifact record validation と fingerprint / policy 照合は O(1) です。payload hash 再計算は materialized canonical key tree size k に対して O(k) です。
//: - decoded artifact から batch record vector を作る projector は record 数 m に対して O(m) です。artifact invariant の検査と materialized key id vector の長さ検査を先に行い、record ordinal ごとの copy-out と push だけを行います。
//: - sorted index lookup 後の candidate range から batch record 1 件を作る projector は、candidate accessor 側の artifact validation / range validation を再実行し、その後 materialized key id table の coverage check と O(1) の copy-out を行います。
//: - candidate range preseed は candidate 数 c に対して、candidate accessor validation と proof store relation 判定を順に行います。現段階では accessor が artifact validation を再実行するため O(c * artifact_validation + c * n * k + materialization) です。
//: - store relation 判定は proof store の record 数 n と canonical key tree size k に対して O(n * k) です。batch record 数を m とすると、batch preseed は各 record の materialized key validation と store relation 判定を順に行うため O(m * n * k + materialization) です。後続の index 化でも、この module は照合順序と typed error 境界を保ちます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: ##: [9] ok
//: ##: [10] ok
//: ##: [11] ok
//: ##: [12] ok
//: ##: [13] ok
//: ##: [14] ok
//: ##: [15] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_artifact" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_decoded" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_preseed" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_store" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_neplproof_preseed_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_neplproof_preseed_result_is_ok summary.accept_missing
//:             let checks2 checks_push checks1 check selfhost_memo_trait_neplproof_preseed_error_kind_eq (unwrap_err summary.missing_key) SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing
//:             let checks3 checks_push checks2 check selfhost_memo_trait_neplproof_preseed_error_kind_eq (unwrap_err summary.hash_mismatch) SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch
//:             let checks4 checks_push checks3 check selfhost_memo_trait_neplproof_preseed_error_kind_eq (unwrap_err summary.fingerprint_mismatch) SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch
//:             let checks5 checks_push checks4 check selfhost_memo_trait_neplproof_preseed_error_kind_eq (unwrap_err summary.policy_mismatch) SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch
//:             let checks6 checks_push checks5 check selfhost_memo_trait_neplproof_preseed_error_kind_eq (unwrap_err summary.invalid_record) SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder
//:             let checks7 checks_push checks6 check selfhost_memo_trait_proof_store_preseed_decision_eq (unwrap_ok summary.existing_matching) SelfhostMemoTraitProofStorePreseedDecision::ExistingMatching
//:             let checks8 checks_push checks7 check selfhost_memo_trait_proof_store_preseed_decision_eq (unwrap_ok summary.rejected_conflict) SelfhostMemoTraitProofStorePreseedDecision::RejectedConflict
//:             let checks9 checks_push checks8 check selfhost_memo_trait_neplproof_preseed_batch_result_is_ok summary.batch_empty
//:             let checks10 checks_push checks9 check selfhost_memo_trait_neplproof_preseed_batch_result_is_ok summary.batch_existing_matching
//:             let checks11 checks_push checks10 check selfhost_memo_trait_neplproof_preseed_batch_error_is_append (unwrap_err summary.batch_rejected_conflict) 1 SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict
//:             let expected_invalid_preseed %SelfhostMemoTraitNeplProofPreseedErrorKind SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder
//:             let expected_invalid_append %SelfhostMemoTraitNeplProofPreseedAppendErrorKind SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid expected_invalid_preseed
//:             let checks12 checks_push checks11 check selfhost_memo_trait_neplproof_preseed_batch_error_is_append (unwrap_err summary.batch_invalid_record) 1 expected_invalid_append
//:             let checks13 checks_push checks12 check selfhost_memo_trait_neplproof_decoded_batch_build_result_is_ok summary.batch_from_artifact
//:             let checks14 checks_push checks13 check selfhost_memo_trait_neplproof_decoded_batch_build_error_kind_eq (unwrap_err summary.batch_from_artifact_count_mismatch) SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::MaterializedKeyCountMismatch
//:             let checks15 checks_push checks14 check selfhost_memo_trait_neplproof_decoded_batch_build_result_is_ok summary.batch_candidate_from_artifact
//:             let expected_candidate_error %SelfhostMemoTraitNeplProofDecodedBatchCandidateError SelfhostMemoTraitNeplProofDecodedBatchCandidateError 1 SelfhostMemoTraitNeplProofDecodedArtifactErrorKind::CandidateAccessInvalid SelfhostMemoTraitNeplProofDecodedCandidateErrorKind::CandidateOffsetOutOfRange
//:             let checks16 checks_push checks15 check selfhost_memo_trait_neplproof_decoded_batch_build_error_kind_eq (unwrap_err summary.batch_candidate_offset_mismatch) SelfhostMemoTraitNeplProofDecodedBatchBuildErrorKind::CandidateInvalid expected_candidate_error
//:             let shown checks_print_report checks16
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait neplproof preseed stage0 setup failed"
//:             let shown checks_print_report checks1
