        lt word 0
        then:
            v::free bytes
            Result::Err StdErrorKind::InvalidOperation
        else:
            let b0 %i32 rem_s word 256
            let q1 %i32 div_s word 256
            let b1 %i32 rem_s q1 256
            let q2 %i32 div_s q1 256
            let b2 %i32 rem_s q2 256
            let q3 %i32 div_s q2 256
            let b3 %i32 rem_s q3 256
            match selfhost_memo_trait_neplproof_preseed_stage0_push_payload_byte bytes b0:
                Result::Ok bytes1:
                    match selfhost_memo_trait_neplproof_preseed_stage0_push_payload_byte bytes1 b1:
                        Result::Ok bytes2:
                            match selfhost_memo_trait_neplproof_preseed_stage0_push_payload_byte bytes2 b2:
                                Result::Ok bytes3:
                                    selfhost_memo_trait_neplproof_preseed_stage0_push_payload_byte bytes3 b3
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e

