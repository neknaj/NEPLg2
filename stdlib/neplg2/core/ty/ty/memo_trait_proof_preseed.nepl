impl Copy for SelfhostMemoTraitNeplProofPreseedStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitNeplProofPreseedStage0Summary SelfhostMemoTraitNeplProofPreseedStage0Summary \self:
        self

//: selfhost_memo_trait_neplproof_preseed_error_kind_code: preseed error の一次分類 code を[返/かえ]す
//:
//: [目的/もくてき]:
//: - payload を持つ variant を code だけで一致させず、先に variant 種別が違う場合を高速に除外します。
//:
//: [契約/けいやく]:
//: - この code は public artifact schema ではありません。表示や永続化ではなく、同一 module 内の equality 実装だけが利用します。
fn selfhost_memo_trait_neplproof_preseed_error_kind_code %fn SelfhostMemoTraitNeplProofPreseedErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid _error:
            1
        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid _error:
            2
        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
            3
        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid _error:
            4
        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid _error:
            5
        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
            6
        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
            7
        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
            8

//: selfhost_memo_trait_neplproof_preseed_error_kind_eq: decoded preseed error が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - artifact、payload decode、payload materialization、fingerprint error payload はそれぞれの typed equality へ委譲します。
//: - payload を持たない variant は code equality で比較します。payload を持つ variant は code だけでは一致させません。
pub fn selfhost_memo_trait_neplproof_preseed_error_kind_eq %fn SelfhostMemoTraitNeplProofPreseedErrorKind fn SelfhostMemoTraitNeplProofPreseedErrorKind bool \a\b:
    if:
        ne selfhost_memo_trait_neplproof_preseed_error_kind_code a selfhost_memo_trait_neplproof_preseed_error_kind_code b
        then:
            false
        else:
            match a:
                SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid a_error:
                    match b:
                        SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid b_error:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_error b_error
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
                            false
                SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid a_error:
                    match b:
                        SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid b_error:
                            selfhost_memo_trait_canonical_key_payload_decode_error_kind_eq a_error b_error
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
                            false
                SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
                    true
                SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid a_error:
                    match b:
                        SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid b_error:
                            selfhost_memo_trait_canonical_key_payload_error_kind_eq a_error b_error
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
                            false
                SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid a_error:
                    match b:
                        SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid _b_error:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid b_error:
                            selfhost_memo_trait_canonical_fingerprint_error_kind_eq a_error b_error
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
                            false
                        SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
                            false
                SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch:
                    true
                SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch:
                    true
                SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch:
                    true

//: selfhost_memo_trait_neplproof_preseed_append_error_kind_eq: append error が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - decision error と store push error は nested typed equality で比較します。`RejectedConflict` は singleton variant として比較します。
pub fn selfhost_memo_trait_neplproof_preseed_append_error_kind_eq %fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid a_error:
            match b:
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid b_error:
                    selfhost_memo_trait_neplproof_preseed_error_kind_eq a_error b_error
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict:
                    false
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid _b_error:
                    false
        SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict:
            match b:
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid _b_error:
                    false
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict:
                    true
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid _b_error:
                    false
        SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid a_error:
            match b:
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid _b_error:
                    false
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict:
                    false
                SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid b_error:
                    selfhost_memo_trait_proof_store_push_error_kind_eq a_error b_error

//: selfhost_memo_trait_neplproof_decoded_batch_record_new: batch 入力 record を[作/つく]る
//:
//: [目的/もくてき]:
//: - stage0 や reader が、匿名 tuple ではなく名前付き field の payload として materialized key と proof record を渡せるようにします。
pub fn selfhost_memo_trait_neplproof_decoded_batch_record_new %fn SelfhostCanonicalTypeKeyId fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofDecodedBatchRecord \materialized_key_id\expected_policy\record:
    SelfhostMemoTraitNeplProofDecodedBatchRecord materialized_key_id expected_policy record

//: selfhost_memo_trait_neplproof_preseed_batch_error_new: ordinal 付き batch error を[作/つく]る
fn selfhost_memo_trait_neplproof_preseed_batch_error_new %fn i32 fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind SelfhostMemoTraitNeplProofPreseedBatchError \record_ordinal\kind:
    SelfhostMemoTraitNeplProofPreseedBatchError record_ordinal kind

//: selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq: batch error kind が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - `RecordAppendInvalid` は単一 record append error の nested payload まで比較します。
//: - wildcard arm は使わず、variant 追加時に match の更新漏れが見える形にします。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq %fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind fn SelfhostMemoTraitNeplProofPreseedBatchErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
            match b:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    true
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid _b_error:
                    false
        SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid a_error:
            match b:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    false
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid b_error:
                    selfhost_memo_trait_neplproof_preseed_append_error_kind_eq a_error b_error

//: selfhost_memo_trait_neplproof_preseed_batch_error_eq: batch error が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - record ordinal と nested error kind の両方が一致した場合だけ true を返します。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_eq %fn SelfhostMemoTraitNeplProofPreseedBatchError fn SelfhostMemoTraitNeplProofPreseedBatchError bool \a\b:
    and:
        eq a.record_ordinal b.record_ordinal
        selfhost_memo_trait_neplproof_preseed_batch_error_kind_eq a.kind b.kind

//: selfhost_memo_trait_neplproof_preseed_batch_error_is_append: batch error が指定 ordinal の append error か[返/かえ]す
//:
//: [目的/もくてき]:
//: - doctest と source policy が、ordinal と単一 record append error payload の両方を簡潔に確認できるようにします。
pub fn selfhost_memo_trait_neplproof_preseed_batch_error_is_append %fn SelfhostMemoTraitNeplProofPreseedBatchError fn i32 fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind bool \error\record_ordinal\append_error:
    if:
        not eq error.record_ordinal record_ordinal
        then:
            false
        else:
            match error.kind:
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing:
                    false
                SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid actual:
                    selfhost_memo_trait_neplproof_preseed_append_error_kind_eq actual append_error

//: selfhost_memo_trait_neplproof_preseed_result_is_ok: decoded preseed 判定が成功したか[返/かえ]す
pub fn selfhost_memo_trait_neplproof_preseed_result_is_ok %fn Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind bool \result:
    match result:
        Result::Ok _decision:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_preseed_batch_result_is_ok: batch preseed が成功したか[返/かえ]す
pub fn selfhost_memo_trait_neplproof_preseed_batch_result_is_ok %fn Result unit SelfhostMemoTraitNeplProofPreseedBatchError bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked: validation 済み record を store relation 判定へ[渡/わた]す
//:
//: [契約/けいやく]:
//: - materialized key が candidate arena に存在しない場合は、store を走査せず `MaterializedCanonicalKeyMissing` を返します。
//: - canonical payload hash、canonical fingerprint、policy は、この順で照合します。前段が失敗した場合、後段の decision は作りません。
//: - canonical payload hash は caller から受け取らず、materialized canonical key tree からこの関数内で再計算します。
fn selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record:
    match selfhost_canonical_type_key_arena_get_node materialized_key_arena materialized_key_id:
        Option::Some _node:
            match selfhost_memo_trait_canonical_key_payload_hash_result nominal_table materialized_key_arena materialized_key_id:
                Result::Ok payload_hash:
                    let materialized_canonical_payload_hash %i32 selfhost_memo_trait_canonical_key_payload_hash_value payload_hash
                    if:
                        not eq materialized_canonical_payload_hash record.key.canonical_payload_hash
                        then:
                            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadHashMismatch
                        else:
                            if:
                                not selfhost_memo_trait_canonical_type_fingerprint_eq materialized_fingerprint record.key.canonical_fingerprint
                                then:
                                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintMismatch
                                else:
                                    if:
                                        not selfhost_memo_trait_proof_store_policy_eq expected_policy record.key.policy
                                        then:
                                            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedPolicyMismatch
                                        else:
                                            Result::Ok selfhost_memo_trait_proof_store_preseed_decision_materialized_key store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record.proof_kind record.proof
                Result::Err payload_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadMaterializationInvalid payload_error
        Option::None:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedCanonicalKeyMissing

//: selfhost_memo_trait_neplproof_record_preseed_decision_materialized: decoded record を validation して preseed 判定へ[進/すす]める
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が record bytes を schema 型へ decode した後、store へ record を追加するか、skip するか、conflict として拒否するかを決める入口です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(AcceptMissing)`: record key と同じ stable identity は store にありません。caller はこの record を materialized store append へ進められます。
//: - `Ok(ExistingMatching)`: 同じ stable identity と同じ proof payload が既に store にあります。caller は再追加を skip できます。
//: - `Ok(RejectedConflict)`: 同じ stable identity で異なる proof payload が既に store にあります。caller は artifact を上書きせず拒否します。
//: - `Err(kind)`: artifact schema または decoded key と record key の対応が壊れています。caller は通常検査へ fallback し、artifact を authority として使ってはいけません。
//:
//: [契約/けいやく]:
//: - canonical payload hash は caller から raw `i32` として受け取らず、`nominal_table` と `materialized_key_arena` から再計算します。
pub fn selfhost_memo_trait_neplproof_record_preseed_decision_materialized %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostCanonicalTypeKeyArena fn SelfhostCanonicalTypeKeyId fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record:
    match selfhost_memo_trait_neplproof_record_key_result record.key.canonical_fingerprint record.key.canonical_payload_schema_version record.key.canonical_payload_hash record.key.policy:
        Result::Ok checked_key:
            match selfhost_memo_trait_neplproof_record_result checked_key record.proof_kind record.proof record.record_payload_hash:
                Result::Ok checked_record:
                    selfhost_memo_trait_neplproof_record_preseed_decision_materialized_checked store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint checked_record
                Result::Err artifact_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid artifact_error
        Result::Err artifact_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::ArtifactRecordInvalid artifact_error

//: selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked: decoded owner 参照を materialized 判定へ[渡/わた]す
//:
//: [目的/もくてき]:
//: - codec が作った `SelfhostMemoTraitCanonicalKeyPayloadDecoded` から arena と root を取り出し、fingerprint を再計算してから既存の materialized preseed 判定へ進めます。
//:
//: [契約/けいやく]:
//: - decoded owner の解放は caller が行います。この helper は借用だけを受け取り、owner を閉じません。
//: - fingerprint 生成に失敗した場合は typed error へ畳み込み、raw hash や placeholder を authority として扱いません。
fn selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked %fn &SelfhostMemoTraitProofStore fn &SelfhostMemoTraitStableNominalKeyTable fn &SelfhostMemoTraitCanonicalKeyPayloadDecoded fn SelfhostMemoTraitProofStorePolicy fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\decoded\expected_policy\record:
    let materialized_key_arena %&SelfhostCanonicalTypeKeyArena field::get_ref decoded "arena"
    let materialized_key_id %SelfhostCanonicalTypeKeyId *field::get_ref decoded "root"
    match selfhost_memo_trait_canonical_type_fingerprint_result nominal_table materialized_key_arena materialized_key_id:
        Result::Ok materialized_fingerprint:
            selfhost_memo_trait_neplproof_record_preseed_decision_materialized store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record
        Result::Err fingerprint_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid fingerprint_error

//: selfhost_memo_trait_neplproof_record_preseed_decision_decoded_payload_bytes: canonical payload bytes から preseed 判定を[作/つく]る
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が record key と canonical payload bytes を得た後、bytes decode、fingerprint 再計算、payload hash 再計算、policy 照合、store relation 判定を1つの入口で行います。
//:
//: [契約/けいやく]:
//: - bytes 内や record key 内の hash だけを信用しません。decode した canonical key arena から fingerprint と payload hash を再計算します。
//: - この関数は store を変更しません。`AcceptMissing` を受けて store に追加するかどうかは append API が担当します。
//: - decode した canonical payload owner は、この関数内で必ず閉じます。
pub fn selfhost_memo_trait_neplproof_record_preseed_decision_decoded_payload_bytes %impure fn &SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind \store\nominal_table\canonical_payload_bytes\expected_policy\record:
    match selfhost_memo_trait_canonical_key_payload_decode_result nominal_table canonical_payload_bytes:
        Result::Ok decoded:
            let result %Result SelfhostMemoTraitProofStorePreseedDecision SelfhostMemoTraitNeplProofPreseedErrorKind selfhost_memo_trait_neplproof_record_preseed_decision_decoded_checked store nominal_table &decoded expected_policy record
            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
            result
        Result::Err decode_error:
            Result::Err SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid decode_error

//: selfhost_memo_trait_neplproof_record_append_materialized_decision: materialized key と preseed decision から store 更新を[行/おこな]う
//:
//: [目的/もくてき]:
//: - bytes decode 済み single-record append と batch append が、`AcceptMissing` / `ExistingMatching` / `RejectedConflict` の所有権 contract を共有できるようにします。
//:
//: [契約/けいやく]:
//: - `AcceptMissing` では proof store 側の materialized append API だけを使い、caller-owned key id を store-local id として保存しません。
//: - `ExistingMatching` は store owner をそのまま返します。
//: - `RejectedConflict` は store owner を閉じてから typed error を返します。
fn selfhost_memo_trait_neplproof_record_append_materialized_decision %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitCanonicalTypeFingerprint impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitProofStorePreseedDecision Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\materialized_key_arena\materialized_key_id\expected_policy\materialized_fingerprint\record\decision:
    match decision:
        SelfhostMemoTraitProofStorePreseedDecision::AcceptMissing:
            match selfhost_memo_trait_proof_store_push_materialized_key store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record.proof_kind record.proof:
                Result::Ok next_store:
                    Result::Ok next_store
                Result::Err push_error:
                    Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::StoreAppendInvalid push_error
        SelfhostMemoTraitProofStorePreseedDecision::ExistingMatching:
            Result::Ok store
        SelfhostMemoTraitProofStorePreseedDecision::RejectedConflict:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::RejectedConflict

//: selfhost_memo_trait_neplproof_record_append_materialized_checked: materialized key から single-record append を[試/こころ]みる
//:
//: [目的/もくてき]:
//: - batch loop が bytes owner を持たず、reader が materialized arena に置いた key id だけを持つ場合でも、single-record append と同じ検査順序を使えるようにします。
//:
//: [契約/けいやく]:
//: - fingerprint は caller から受け取らず、`nominal_table` と `materialized_key_arena` からこの helper 内で再計算します。
//: - decision error または fingerprint error では入力 store を閉じ、partial seeded store を成功値として返しません。
fn selfhost_memo_trait_neplproof_record_append_materialized_checked %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostCanonicalTypeKeyId impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\materialized_key_arena\materialized_key_id\expected_policy\record:
    match selfhost_memo_trait_canonical_type_fingerprint_result nominal_table materialized_key_arena materialized_key_id:
        Result::Ok materialized_fingerprint:
            match selfhost_memo_trait_neplproof_record_preseed_decision_materialized &store nominal_table materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record:
                Result::Ok decision:
                    selfhost_memo_trait_neplproof_record_append_materialized_decision store materialized_key_arena materialized_key_id expected_policy materialized_fingerprint record decision
                Result::Err decision_error:
                    selfhost_memo_trait_proof_store_free store
                    Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid decision_error
        Result::Err fingerprint_error:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid SelfhostMemoTraitNeplProofPreseedErrorKind::MaterializedFingerprintInvalid fingerprint_error

//: selfhost_memo_trait_neplproof_record_append_decoded_checked: decoded owner 参照から store append を[試/こころ]みる
//:
//: [目的/もくてき]:
//: - decoded canonical key に対する fingerprint 再計算、record validation、preseed decision、store append を順に行う single-record bridge です。
//:
//: [契約/けいやく]:
//: - この helper は decoded owner を解放しません。bytes-level public API が decode 成功後に必ず owner を閉じます。
//: - decision error または fingerprint error では入力 store を閉じ、partial seeded store を成功値として返しません。
fn selfhost_memo_trait_neplproof_record_append_decoded_checked %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostMemoTraitCanonicalKeyPayloadDecoded impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\decoded\expected_policy\record:
    let materialized_key_arena %&SelfhostCanonicalTypeKeyArena field::get_ref decoded "arena"
    let materialized_key_id %SelfhostCanonicalTypeKeyId *field::get_ref decoded "root"
    selfhost_memo_trait_neplproof_record_append_materialized_checked store nominal_table materialized_key_arena materialized_key_id expected_policy record

//: selfhost_memo_trait_neplproof_record_append_decoded_payload_bytes: decoded record を proof store へ[投入/とうにゅう]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が1 record分の canonical payload bytes と typed record payload を得た後、store へ安全に preseed します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(store)`: `ExistingMatching` なら store は変更されず、`AcceptMissing` なら materialized canonical key と proof record が追加された store を返します。
//: - `Err(kind)`: decode、fingerprint、record validation、conflict、store append のいずれかで fail-closed になりました。入力 store owner は閉じられており、caller はその store を compile に使ってはいけません。
//:
//: [契約/けいやく]:
//: - `AcceptMissing` の場合だけ `selfhost_memo_trait_proof_store_push_materialized_key` を呼びます。
//: - `ExistingMatching` は同じ artifact record の再投入なので skip します。
//: - `RejectedConflict` は warning や duplicate skip ではなく `RejectedConflict` error として返します。
pub fn selfhost_memo_trait_neplproof_record_append_decoded_payload_bytes %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &Vec u8 impure fn SelfhostMemoTraitProofStorePolicy impure fn SelfhostMemoTraitNeplProofRecord Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind \store\nominal_table\canonical_payload_bytes\expected_policy\record:
    match selfhost_memo_trait_canonical_key_payload_decode_result nominal_table canonical_payload_bytes:
        Result::Ok decoded:
            let result %Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedAppendErrorKind selfhost_memo_trait_neplproof_record_append_decoded_checked store nominal_table &decoded expected_policy record
            selfhost_memo_trait_canonical_key_payload_decoded_free decoded
            result
        Result::Err decode_error:
            selfhost_memo_trait_proof_store_free store
            Result::Err SelfhostMemoTraitNeplProofPreseedAppendErrorKind::DecisionInvalid SelfhostMemoTraitNeplProofPreseedErrorKind::CanonicalPayloadDecodeInvalid decode_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_error: batch ordinal と append error を[束/たば]ねる
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_error %fn i32 fn SelfhostMemoTraitNeplProofPreseedAppendErrorKind SelfhostMemoTraitNeplProofPreseedBatchError \record_ordinal\append_error:
    selfhost_memo_trait_neplproof_preseed_batch_error_new record_ordinal SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordAppendInvalid append_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_one: batch record 1 件を store へ[投入/とうにゅう]する
//:
//: [契約/けいやく]:
//: - `record_ordinal` は error payload にだけ使い、proof store の authority にはしません。
//: - failure は `selfhost_memo_trait_neplproof_record_append_materialized_checked` の contract に従って store を閉じたうえで返ります。
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_one %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn SelfhostMemoTraitNeplProofDecodedBatchRecord impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedBatchError \store\nominal_table\materialized_key_arena\batch_record\record_ordinal:
    match selfhost_memo_trait_neplproof_record_append_materialized_checked store nominal_table materialized_key_arena batch_record.materialized_key_id batch_record.expected_policy batch_record.record:
        Result::Ok next_store:
            Result::Ok next_store
        Result::Err append_error:
            Result::Err selfhost_memo_trait_neplproof_decoded_record_batch_append_error record_ordinal append_error

//: selfhost_memo_trait_neplproof_decoded_record_batch_append_loop: materialized decoded record 列を順に preseed する
//:
//: [契約/けいやく]:
//: - record は入力順に処理します。後続で persistent stable map を導入しても、この fail-closed の順序と ordinal error は維持します。
//: - どこか 1 件でも失敗した場合、入力 store owner は閉じられており、この loop は部分投入済み store を返しません。
fn selfhost_memo_trait_neplproof_decoded_record_batch_append_loop %impure fn SelfhostMemoTraitProofStore impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn &SelfhostCanonicalTypeKeyArena impure fn &Vec SelfhostMemoTraitNeplProofDecodedBatchRecord impure fn i32 Result SelfhostMemoTraitProofStore SelfhostMemoTraitNeplProofPreseedBatchError \store\nominal_table\materialized_key_arena\records\idx:
    let n %i32 v::len records
    if:
        ge idx n
        then:
            Result::Ok store
        else:
            match v::get records idx:
                Option::Some batch_record:
                    match selfhost_memo_trait_neplproof_decoded_record_batch_append_one store nominal_table materialized_key_arena batch_record idx:
                        Result::Ok next_store:
                            selfhost_memo_trait_neplproof_decoded_record_batch_append_loop next_store nominal_table materialized_key_arena records add idx 1
                        Result::Err batch_error:
                            Result::Err batch_error
                Option::None:
                    selfhost_memo_trait_proof_store_free store
                    Result::Err selfhost_memo_trait_neplproof_preseed_batch_error_new idx SelfhostMemoTraitNeplProofPreseedBatchErrorKind::RecordMissing

//: selfhost_memo_trait_neplproof_decoded_record_batch_append: materialized decoded record batch を proof store へ[投入/とうにゅう]する
//:
//: [目的/もくてき]:
//: - `.neplproof` reader が複数 record の typed payload と materialized key id を得た後、working proof store へ順に preseed します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(store)`: すべての record が `AcceptMissing` append または `ExistingMatching` skip として処理され、成功した working store を返します。
//: - `Err(error)`: `error.record_ordinal` の record で fail-closed になりました。入力 store owner は閉じられており、caller は部分投入済み store を使ってはいけません。
//:
//: [契約/けいやく]:
//: - この API は materialized key arena を借用するだけで、arena owner を閉じません。arena の lifetime は caller が batch 完了後に管理します。
//: - binary `.neplproof` reader、record bytes decode、serialized index、persistent map はこの API の責務ではありません。
//: - fingerprint、payload hash、policy は record ごとに再検査します。`SelfhostMemoTraitNeplProofDecodedBatchRecord` 内の key id や artifact record key だけでは受理しません。
//:
//: [計算量/けいさんりょう]:
//: - m 件の record に対して、各 record の key validation と store relation 判定を行うため O(m * n * k + materialization) です。
