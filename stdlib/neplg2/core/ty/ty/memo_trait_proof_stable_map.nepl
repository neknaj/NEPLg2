//: selfhost_memo_trait_neplproof_stable_map_stage0_run_invalid_record: invalid record を producer error として[返/かえ]す
fn selfhost_memo_trait_neplproof_stable_map_stage0_run_invalid_record %impure fn SelfhostMemoTraitNeplProofRecord impure fn SelfhostMemoTraitNeplProofRecord Result unit SelfhostMemoTraitNeplProofStableMapProducerErrorKind \invalid_record\second_record:
    match selfhost_memo_trait_neplproof_stable_map_stage0_records_two invalid_record second_record:
        Result::Ok records:
            match selfhost_memo_trait_neplproof_stable_map_build_result &records:
                Result::Ok entries:
                    v::free records
                    v::free entries
                    Result::Ok unit
                Result::Err kind:
                    v::free records
                    match kind:
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::EntryBuildRejected inner:
                            match inner:
                                SelfhostMemoTraitNeplProofStableMapErrorKind::RecordInvalid artifact_kind:
                                    Result::Err SelfhostMemoTraitNeplProofStableMapProducerErrorKind::RecordInvalid artifact_kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::KeyInvalid artifact_kind:
                                    Result::Err SelfhostMemoTraitNeplProofStableMapProducerErrorKind::RecordInvalid artifact_kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::IndexEntryInvalid _artifact_kind:
                                    Result::Err kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::EntryMissing:
                                    Result::Err kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::FingerprintOrderInvalid:
                                    Result::Err kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::PayloadHashOrderInvalid:
                                    Result::Err kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::RecordOrdinalOrderInvalid:
                                    Result::Err kind
                                SelfhostMemoTraitNeplProofStableMapErrorKind::CandidateMissing:
                                    Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::AllocFailed _error:
                            Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::PushFailed _error:
                            Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::RecordEntryMissing:
                            Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::EntryMissing:
                            Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::RecordInvalid _artifact_kind:
                            Result::Err kind
                        SelfhostMemoTraitNeplProofStableMapProducerErrorKind::ProducedOrderRejected _inner:
                            Result::Err kind
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofStableMapProducerErrorKind::AllocFailed e

