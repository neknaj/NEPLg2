//: selfhost_memo_trait_neplproof_stable_map_stage0: stable map contract の代表結果を[返/かえ]す
//:
//: [目的/もくてき]:
//: - doctest が accepted range、同一 stable key の collision group、missing candidate、各種 order corruption、producer build、invalid record rejection を同じ public API 経由で確認できるようにします。
pub fn selfhost_memo_trait_neplproof_stable_map_stage0 %impure fn void Result SelfhostMemoTraitNeplProofStableMapStage0Summary StdErrorKind \void:
    let canonical_schema %i32 selfhost_memo_trait_canonical_key_payload_schema_version
    let policy_schema %i32 selfhost_memo_trait_neplproof_policy_schema_version
    let policy %SelfhostMemoTraitProofStorePolicy selfhost_memo_trait_neplproof_stable_map_stage0_policy policy_schema
    let proof %SelfhostMemoTraitStoredAggregateProof selfhost_memo_trait_neplproof_stable_map_stage0_proof
    let first_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 1001
    let second_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 2002
    let missing_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint SelfhostMemoTraitCanonicalTypeFingerprint canonical_schema 3003
    let first_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema first_fingerprint 3003 policy
    let second_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema second_fingerprint 3004 policy
    let first_collision_key %SelfhostMemoTraitNeplProofRecordKey SelfhostMemoTraitNeplProofRecordKey canonical_schema first_fingerprint 3003 policy
    let first_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 4004
    let second_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord second_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let first_collision_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_collision_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 5005
    let invalid_record %SelfhostMemoTraitNeplProofRecord SelfhostMemoTraitNeplProofRecord first_key SelfhostMemoTraitStoredProofKind::KeyAndValue proof 0
    let first_entry %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 0 4004
    let second_entry %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry second_fingerprint 3004 policy 1 5005
    let collision_second_entry %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 1 5005
    let fingerprint_unsorted_first %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry second_fingerprint 3004 policy 1 5005
    let fingerprint_unsorted_second %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 0 4004
    let payload_hash_unsorted_first %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3004 policy 1 5005
    let payload_hash_unsorted_second %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 0 4004
    let ordinal_unsorted_first %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 1 5005
    let ordinal_unsorted_second %SelfhostMemoTraitNeplProofStableMapEntry SelfhostMemoTraitNeplProofStableMapEntry first_fingerprint 3003 policy 0 4004
    match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries first_entry second_entry first_fingerprint 3003:
        Result::Ok accepted_range:
            match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries first_entry collision_second_entry first_fingerprint 3003:
                Result::Ok accepted_collision_range:
                    match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries first_entry second_entry missing_fingerprint 3003:
                        Result::Ok missing_candidate:
                            match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries fingerprint_unsorted_first fingerprint_unsorted_second first_fingerprint 3003:
                                Result::Ok fingerprint_unsorted:
                                    match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries payload_hash_unsorted_first payload_hash_unsorted_second first_fingerprint 3003:
                                        Result::Ok payload_hash_unsorted:
                                            match selfhost_memo_trait_neplproof_stable_map_stage0_run_two_entries ordinal_unsorted_first ordinal_unsorted_second first_fingerprint 3003:
                                                Result::Ok ordinal_unsorted:
                                                    match selfhost_memo_trait_neplproof_stable_map_stage0_records_two second_record first_record:
                                                        Result::Ok unordered_records:
                                                            match selfhost_memo_trait_neplproof_stable_map_stage0_run_producer_lookup unordered_records first_fingerprint 3003:
                                                                Result::Ok built_first_range:
                                                                    match selfhost_memo_trait_neplproof_stable_map_stage0_records_two first_collision_record first_record:
                                                                        Result::Ok collision_records:
                                                                            match selfhost_memo_trait_neplproof_stable_map_stage0_run_producer_lookup collision_records first_fingerprint 3003:
                                                                                Result::Ok built_collision_range:
                                                                                    let invalid_record_result %Result unit SelfhostMemoTraitNeplProofStableMapProducerErrorKind selfhost_memo_trait_neplproof_stable_map_stage0_run_invalid_record invalid_record second_record
                                                                                    Result::Ok selfhost_memo_trait_neplproof_stable_map_stage0_summary_new accepted_range accepted_collision_range missing_candidate fingerprint_unsorted payload_hash_unsorted ordinal_unsorted built_first_range built_collision_range invalid_record_result
                                                                                Result::Err _e:
                                                                                    Result::Err StdErrorKind::InvalidOperation
                                                                        Result::Err e:
                                                                            Result::Err e
                                                                Result::Err _e:
                                                                    Result::Err StdErrorKind::InvalidOperation
                                                        Result::Err e:
                                                            Result::Err e
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e
