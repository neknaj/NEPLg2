#indent 4
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./id" as *
#import "./kind/model" as *

//: SelfhostFunctionTypeArgRangeItems: nonempty function argument table 範囲の payload
//:
//: [目的/もくてき]:
//: - function type が持つ引数列の開始 index と個数を、nonempty の場合だけ保持します。
pub struct SelfhostFunctionTypeArgRangeItems:
    first_arg %i32
    arg_count %i32

impl Clone for SelfhostFunctionTypeArgRangeItems:
    fn clone %fn &SelfhostFunctionTypeArgRangeItems SelfhostFunctionTypeArgRangeItems \self:
        *self

impl Copy for SelfhostFunctionTypeArgRangeItems:
    fn copy_mark %fn SelfhostFunctionTypeArgRangeItems SelfhostFunctionTypeArgRangeItems \self:
        self

//: SelfhostFunctionTypeArgRange: function argument table 上の連続範囲
//:
//: [目的/もくてき]:
//: - 0 引数 function type を `first_arg = 0, arg_count = 0` の loose pair ではなく `Empty` variant として表します。
//: - nonempty のときだけ payload を持つため、比較や accessor が match による網羅性検査を使えます。
pub enum SelfhostFunctionTypeArgRange:
    Empty
    Range %SelfhostFunctionTypeArgRangeItems

impl Clone for SelfhostFunctionTypeArgRange:
    fn clone %fn &SelfhostFunctionTypeArgRange SelfhostFunctionTypeArgRange \self:
        *self

impl Copy for SelfhostFunctionTypeArgRange:
    fn copy_mark %fn SelfhostFunctionTypeArgRange SelfhostFunctionTypeArgRange \self:
        self

//: SelfhostFunctionTypeArgRangeBuildError: function argument range 構築の失敗分類
pub enum SelfhostFunctionTypeArgRangeBuildError:
    NegativeFirst
    NegativeCount
    NonCanonicalEmpty
    EndOverflow
    OutOfBounds

impl Clone for SelfhostFunctionTypeArgRangeBuildError:
    fn clone %fn &SelfhostFunctionTypeArgRangeBuildError SelfhostFunctionTypeArgRangeBuildError \self:
        *self

impl Copy for SelfhostFunctionTypeArgRangeBuildError:
    fn copy_mark %fn SelfhostFunctionTypeArgRangeBuildError SelfhostFunctionTypeArgRangeBuildError \self:
        self

//: SelfhostFunctionTypeRecord: function type record の payload
//:
//: [目的/もくてき]:
//: - function type だけが持つ argument table 範囲と戻り値 TypeId を保持します。
//: - primitive type から function-only field を読めないよう、`SelfhostTypeRecord::Function` の payload に閉じ込めます。
pub struct SelfhostFunctionTypeRecord:
    args %SelfhostFunctionTypeArgRange
    result %SelfhostTypeId

//: SelfhostNamedTypeRecord: named type record の payload
//:
//: [目的/もくてき]:
//: - source 上の `Foo` のような named type を、primitive に丸めず type constructor table の identity として保持します。
//: - field layout や generic application はこの record に入れず、後続 stage が constructor table / canonical type key から取得します。
pub struct SelfhostNamedTypeRecord:
    nominal_id %SelfhostNamedTypeId

//: SelfhostAppliedTypeArgRange: applied named type の型引数 table 範囲
//:
//: [目的/もくてき]:
//: - `Box i32` のような generic type application が持つ型引数列の開始 index と個数を保持します。
//: - applied named type は少なくとも 1 個の型引数を持つため、0 個の範囲はこの payload に入れません。
pub struct SelfhostAppliedTypeArgRange:
    first_arg %i32
    arg_count %i32

//: SelfhostAppliedTypeRecord: applied named type record の payload
//:
//: [目的/もくてき]:
//: - generic type constructor の定義 identity と、arena type argument table 上の引数範囲を保持します。
//: - source spelling は保持せず、constructor lookup 後の identity と型引数 TypeId だけを後続 stage へ渡します。
pub struct SelfhostAppliedTypeRecord:
    nominal_id %SelfhostNamedTypeId
    args %SelfhostAppliedTypeArgRange

impl Clone for SelfhostFunctionTypeRecord:
    fn clone %fn &SelfhostFunctionTypeRecord SelfhostFunctionTypeRecord \self:
        *self

impl Copy for SelfhostFunctionTypeRecord:
    fn copy_mark %fn SelfhostFunctionTypeRecord SelfhostFunctionTypeRecord \self:
        self

impl Clone for SelfhostAppliedTypeArgRange:
    fn clone %fn &SelfhostAppliedTypeArgRange SelfhostAppliedTypeArgRange \self:
        *self

impl Copy for SelfhostAppliedTypeArgRange:
    fn copy_mark %fn SelfhostAppliedTypeArgRange SelfhostAppliedTypeArgRange \self:
        self

impl Clone for SelfhostNamedTypeRecord:
    fn clone %fn &SelfhostNamedTypeRecord SelfhostNamedTypeRecord \self:
        *self

impl Copy for SelfhostNamedTypeRecord:
    fn copy_mark %fn SelfhostNamedTypeRecord SelfhostNamedTypeRecord \self:
        self

impl Clone for SelfhostAppliedTypeRecord:
    fn clone %fn &SelfhostAppliedTypeRecord SelfhostAppliedTypeRecord \self:
        *self

impl Copy for SelfhostAppliedTypeRecord:
    fn copy_mark %fn SelfhostAppliedTypeRecord SelfhostAppliedTypeRecord \self:
        self

//: SelfhostTypeRecord: arena に保存する型 record
//:
//: [目的/もくてき]:
//: - primitive type、named type、applied named type、function type を enum payload で分け、存在しない field を record に持たせません。
//: - named payload は type constructor table の定義 identity だけを保持し、source span や display name を arena record に混ぜません。
//: - applied payload は constructor identity と型引数範囲だけを保持し、generic application の spelling を後続 stage へ漏らしません。
//: - function payload は `SelfhostFunctionTypeRecord` に集約し、accessor は record variant を match してから読む構造にします。
pub enum SelfhostTypeRecord:
    Primitive %SelfhostPrimitiveTypeKind
    Named %SelfhostNamedTypeRecord
    Applied %SelfhostAppliedTypeRecord
    Function %SelfhostFunctionTypeRecord

impl Clone for SelfhostTypeRecord:
    fn clone %fn &SelfhostTypeRecord SelfhostTypeRecord \self:
        *self

impl Copy for SelfhostTypeRecord:
    fn copy_mark %fn SelfhostTypeRecord SelfhostTypeRecord \self:
        self


//: selfhost_type_record_primitive: primitive type record を[作/つく]る
pub fn selfhost_type_record_primitive %fn SelfhostPrimitiveTypeKind SelfhostTypeRecord \kind:
    SelfhostTypeRecord::Primitive kind

//: selfhost_type_record_named: named type record を[作/つく]る
pub fn selfhost_type_record_named %fn SelfhostNamedTypeId SelfhostTypeRecord \nominal_id:
    SelfhostTypeRecord::Named SelfhostNamedTypeRecord nominal_id

//: selfhost_named_type_record_id: named type record の identity を[返/かえ]す
pub fn selfhost_named_type_record_id %fn SelfhostNamedTypeRecord SelfhostNamedTypeId \record:
    record.nominal_id

//: selfhost_applied_type_arg_range_new_unchecked: 証明済みの applied type argument range を直接[作/つく]る
//:
//: [注意/ちゅうい]:
//: - caller は `first_arg >= 0`、`arg_count > 0`、`first_arg + arg_count` が arena type argument table 内であることを保証してください。
pub fn selfhost_applied_type_arg_range_new_unchecked %fn i32 fn i32 SelfhostAppliedTypeArgRange \first_arg\arg_count:
    SelfhostAppliedTypeArgRange first_arg arg_count

//: selfhost_applied_type_arg_range_is_valid: applied type argument range が内部不変条件を満たすか[返/かえ]す
pub fn selfhost_applied_type_arg_range_is_valid %fn SelfhostAppliedTypeArgRange bool \args:
    and:
        ge args.first_arg 0
        and gt args.arg_count 0 le args.arg_count sub 2147483647 args.first_arg

//: selfhost_applied_type_arg_range_count: applied type argument 数を[返/かえ]す
pub fn selfhost_applied_type_arg_range_count %fn SelfhostAppliedTypeArgRange i32 \args:
    args.arg_count

//: selfhost_type_record_applied: generic application record を[作/つく]る
pub fn selfhost_type_record_applied %fn SelfhostNamedTypeId fn SelfhostAppliedTypeArgRange SelfhostTypeRecord \nominal_id\args:
    SelfhostTypeRecord::Applied SelfhostAppliedTypeRecord nominal_id args

//: selfhost_applied_type_record_id: applied named type record の constructor identity を[返/かえ]す
pub fn selfhost_applied_type_record_id %fn SelfhostAppliedTypeRecord SelfhostNamedTypeId \record:
    record.nominal_id

//: selfhost_applied_type_record_args: applied named type record の型引数範囲を[返/かえ]す
pub fn selfhost_applied_type_record_args %fn SelfhostAppliedTypeRecord SelfhostAppliedTypeArgRange \record:
    record.args

//: selfhost_function_type_arg_range_new_unchecked: 証明済みの nonempty function argument range を直接[作/つく]る
//:
//: [注意/ちゅうい]:
//: - この関数は `first_arg >= 0`、`arg_count > 0`、`first_arg + arg_count` が function argument table 内であることを検査しません。
//: - 通常の caller は `selfhost_function_type_arg_range_new_result` または `selfhost_function_type_arg_range_new_bounded_result` を使います。
pub fn selfhost_function_type_arg_range_new_unchecked %fn i32 fn i32 SelfhostFunctionTypeArgRange \first_arg\arg_count:
    SelfhostFunctionTypeArgRange::Range SelfhostFunctionTypeArgRangeItems first_arg arg_count

//: selfhost_function_type_arg_range_empty: 0 引数 function type の canonical range を[返/かえ]す
pub fn selfhost_function_type_arg_range_empty %fn void SelfhostFunctionTypeArgRange \void:
    SelfhostFunctionTypeArgRange::Empty

//: selfhost_function_type_arg_range_new_result: function argument range を検査して[作/つく]る
pub fn selfhost_function_type_arg_range_new_result %fn i32 fn i32 Result SelfhostFunctionTypeArgRange SelfhostFunctionTypeArgRangeBuildError \first_arg\arg_count:
    if:
        lt first_arg 0
        then:
            Result::Err SelfhostFunctionTypeArgRangeBuildError::NegativeFirst
        else:
            if:
                lt arg_count 0
                then:
                    Result::Err SelfhostFunctionTypeArgRangeBuildError::NegativeCount
                else:
                    if:
                        eq arg_count 0
                        then:
                            if:
                                eq first_arg 0
                                then:
                                    Result::Ok selfhost_function_type_arg_range_empty
                                else:
                                    Result::Err SelfhostFunctionTypeArgRangeBuildError::NonCanonicalEmpty
                        else:
                            if:
                                gt arg_count sub 2147483647 first_arg
                                then:
                                    Result::Err SelfhostFunctionTypeArgRangeBuildError::EndOverflow
                                else:
                                    Result::Ok selfhost_function_type_arg_range_new_unchecked first_arg arg_count

//: selfhost_function_type_arg_range_new_bounded_result: function argument table 長も含めて範囲を検査する
pub fn selfhost_function_type_arg_range_new_bounded_result %fn i32 fn i32 fn i32 Result SelfhostFunctionTypeArgRange SelfhostFunctionTypeArgRangeBuildError \first_arg\arg_count\table_len:
    match selfhost_function_type_arg_range_new_result first_arg arg_count:
        Result::Ok args:
            if:
                lt table_len 0
                then:
                    Result::Err SelfhostFunctionTypeArgRangeBuildError::OutOfBounds
                else:
                    match args:
                        SelfhostFunctionTypeArgRange::Empty:
                            Result::Ok args
                        SelfhostFunctionTypeArgRange::Range range:
                            if:
                                gt range.first_arg table_len
                                then:
                                    Result::Err SelfhostFunctionTypeArgRangeBuildError::OutOfBounds
                                else:
                                    if:
                                        gt range.arg_count sub table_len range.first_arg
                                        then:
                                            Result::Err SelfhostFunctionTypeArgRangeBuildError::OutOfBounds
                                        else:
                                            Result::Ok args
        Result::Err e:
            Result::Err e

//: selfhost_function_type_arg_range_is_valid: range payload が内部不変条件を満たすか[返/かえ]す
pub fn selfhost_function_type_arg_range_is_valid %fn SelfhostFunctionTypeArgRange bool \args:
    match args:
        SelfhostFunctionTypeArgRange::Empty:
            true
        SelfhostFunctionTypeArgRange::Range range:
            and:
                ge range.first_arg 0
                and gt range.arg_count 0 le range.arg_count sub 2147483647 range.first_arg

//: selfhost_function_type_arg_range_first: argument table の開始 index を[返/かえ]す
pub fn selfhost_function_type_arg_range_first %fn SelfhostFunctionTypeArgRange i32 \args:
    match args:
        SelfhostFunctionTypeArgRange::Empty:
            0
        SelfhostFunctionTypeArgRange::Range range:
            range.first_arg

//: selfhost_function_type_arg_range_count: argument 数を[返/かえ]す
pub fn selfhost_function_type_arg_range_count %fn SelfhostFunctionTypeArgRange i32 \args:
    match args:
        SelfhostFunctionTypeArgRange::Empty:
            0
        SelfhostFunctionTypeArgRange::Range range:
            range.arg_count

//: selfhost_type_record_function: function type record を[作/つく]る
pub fn selfhost_type_record_function %fn SelfhostFunctionTypeArgRange fn SelfhostTypeId SelfhostTypeRecord \args\result:
    SelfhostTypeRecord::Function SelfhostFunctionTypeRecord args result
