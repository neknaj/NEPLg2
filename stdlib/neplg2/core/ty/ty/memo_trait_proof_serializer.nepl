//: selfhost_memo_trait_neplproof_serializer_memo_result_artifact_word: memo trait result を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_memo_result_artifact_word %fn Result unit SelfhostMemoTraitRejectKind i32 \result:
    match result:
        Result::Ok _unit:
            1
        Result::Err _kind:
            2

//: selfhost_memo_trait_neplproof_serializer_memo_result_payload: memo trait result の payload word を[返/かえ]す
fn selfhost_memo_trait_neplproof_serializer_memo_result_payload %fn Result unit SelfhostMemoTraitRejectKind i32 \result:
    match result:
        Result::Ok _unit:
            0
        Result::Err kind:
            selfhost_memo_trait_neplproof_serializer_reject_kind_artifact_word kind

//: selfhost_memo_trait_neplproof_serializer_field_evidence_result: writer が reader で復元できる field evidence だけを[受/う]け[入/い]れる
//:
//: [契約/けいやく]:
//: - `Known(range)` は producer / reader と同じ range validator を通します。
//: - non-Known variant は payload word を 0 にして書くため、そのまま受理します。
//: - この検査は proof acceptance ではありません。writer と reader の schema 逆写像を保つための payload validation です。
fn selfhost_memo_trait_neplproof_serializer_field_evidence_result %fn SelfhostMemoTraitAggregateFieldEvidence Result SelfhostMemoTraitAggregateFieldEvidence SelfhostMemoTraitNeplProofSerializerErrorKind \fields:
    match fields:
        SelfhostMemoTraitAggregateFieldEvidence::Known range:
            if:
