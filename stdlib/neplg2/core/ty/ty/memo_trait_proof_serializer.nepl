        SelfhostMemoTraitAggregateHazardEvidence::ExternalHandle:
            3
        SelfhostMemoTraitAggregateHazardEvidence::OwnerToken:
            4
        SelfhostMemoTraitAggregateHazardEvidence::PublicMutableState:
            5
        SelfhostMemoTraitAggregateHazardEvidence::Unknown:
            6

//: selfhost_memo_trait_neplproof_serializer_reject_kind_artifact_word: MemoKey / MemoValue reject kind を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_reject_kind_artifact_word %fn SelfhostMemoTraitRejectKind i32 \kind:
