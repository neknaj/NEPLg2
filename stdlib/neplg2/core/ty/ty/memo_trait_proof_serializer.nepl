#indent 4

//: # ty/memo_trait_proof_serializer
//: typed `.neplproof` artifact payload を永続 bytes へ[書/か]き[出/だ]す serializer 境界です。
//:
//: [目的/もくてき]:
//: - `memo_trait_proof_reader.nepl` と `memo_trait_proof_payload_reader.nepl` が読む Phase 1 `.neplproof` layout を、typed header、typed record、canonical payload bytes から逆向きに構成します。
//: - serializer は schema validator を通した `SelfhostMemoTraitNeplProofHeader` / `SelfhostMemoTraitNeplProofRecord` だけを bytes に写します。
//: - little-endian word write は `memo_trait_artifact_word_codec.nepl` の共有 writer に委譲し、reader と同じ 31-bit nonnegative word contract を使います。
//: - payload section は record table の直後に、各 record ごとに `payload_byte_len` word と canonical payload codec bytes を並べます。
//:
//: [契約/けいやく]:
//: - `selfhost_memo_trait_neplproof_serializer_header_result` は magic word と 5 header word だけを書きます。header は既存 artifact header validator を通し、Phase 1 では serialized index table を持たないため `index_count == record_count` だけを受理します。
//: - `selfhost_memo_trait_neplproof_serializer_record_result` は fixed-width 31 word の record table entry を書きます。record key と record body は、書き込み前に artifact schema validator へ再投入します。
//: - `Known(range)` field evidence は reader と同じ range validator を通します。writer が reader で読めない record bytes を作らないための逆写像 contract です。
//: - enum の artifact word は typed enum から `match` で作ります。数値 word を caller に渡させず、future variant が増えた場合は writer 側も明示的に更新します。
//: - payload bytes は caller が所有する canonical payload codec の bytes を borrow して copy します。serializer は payload bytes owner を閉じません。
//: - output bytes は serializer が owner として消費します。途中で word write や byte push が失敗した場合、partial output owner はこの module または共有 word codec が閉じ、caller へ error enum だけを返します。
//: - serializer は proof acceptance authority ではありません。payload hash、record payload hash、fingerprint、index hit のいずれかだけで proof を受理しません。
//: - source text、span、path suffix、display name、diagnostic text、lexeme、session-local `SelfhostTypeId`、store-local `SelfhostCanonicalTypeKeyId` は serialized bytes の authority にしません。
//: - proof store lookup / preseed / producer gate は呼びません。serializer は正規化済み typed payload を bytes に変換する codec 境界です。
//:
//: [現状/げんじょう]:
//: - Phase 1 は header、fixed-width record table entry、payload section entry の writer です。multi-record payload bundle owner、serialized sorted index table、persistent stable map、record payload hash 再計算は後続 slice で接続します。
//: - Phase 1 API は caller が header.record_count 件の record writer と payload entry writer を同じ順序で呼ぶ前提です。stage0 は 1 record artifact を round-trip して reader との layout 一致を確認します。
//: - `record_payload_hash` と `canonical_payload_hash` は placeholder でないことだけを artifact validator で確認します。hash 再計算と proof store relation 検査は payload reader / preseed / proof store 側の責務として残します。
//:
//: [計算量/けいさんりょう]:
//: - header write は固定 6 word のため O(1) です。
//: - record write は fixed-width 31 word のため O(1) です。
//: - payload entry write は payload byte 長 b に対して O(b) です。
//: - source scan、module graph、proof store lookup、preseed、diagnostic rendering は行いません。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_artifact" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_payload_reader" as *
//:| #import "neplg2/core/ty/ty/memo_trait_proof_serializer" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_neplproof_serializer_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_neplproof_serializer_unit_result_is_ok summary.accepted_writer
//:             let invalid_header_error unwrap_err summary.invalid_header
//:             let checks2 checks_push checks1 check selfhost_memo_trait_neplproof_serializer_error_kind_eq invalid_header_error SelfhostMemoTraitNeplProofSerializerErrorKind::IndexCountUnsupported
//:             let invalid_record_error unwrap_err summary.invalid_record
//:             let checks3 checks_push checks2 check selfhost_memo_trait_neplproof_serializer_error_kind_eq invalid_record_error SelfhostMemoTraitNeplProofSerializerErrorKind::RecordInvalid SelfhostMemoTraitNeplProofArtifactErrorKind::RecordPayloadHashPlaceholder
//:             let invalid_proof_payload_error unwrap_err summary.invalid_proof_payload
//:             let checks4 checks_push checks3 check selfhost_memo_trait_neplproof_serializer_error_kind_eq invalid_proof_payload_error SelfhostMemoTraitNeplProofSerializerErrorKind::ProofPayloadInvalid
//:             let checks5 checks_push checks4 check selfhost_memo_trait_neplproof_payload_reader_unit_result_is_ok summary.payload_reader_roundtrip
//:             let shown checks_print_report checks5
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "neplproof serializer stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./id" as *
#import "./key" as *
#import "./memo_trait" as *
#import "./memo_trait_artifact_word_codec" as *
#import "./memo_trait_canonical_key" as *
#import "./memo_trait_canonical_key_payload" as *
#import "./memo_trait_canonical_key_payload_codec" as *
#import "./memo_trait_policy" as *
#import "./memo_trait_producer" as *
#import "./memo_trait_proof_artifact" as *
#import "./memo_trait_proof_payload_reader" as *
#import "./memo_trait_proof_reader" as *
#import "./memo_trait_proof_store" as *

//: SelfhostMemoTraitNeplProofSerializerErrorKind: `.neplproof` serializer の拒否理由
//:
//: [分類/ぶんるい]:
//: - `HeaderInvalid(kind)`: artifact header validator が schema / count を拒否しました。
//: - `IndexCountUnsupported`: Phase 1 serializer は serialized index table をまだ書かないため、`index_count != record_count` の header を拒否します。
//: - `RecordInvalid(kind)`: record key または record body validator が拒否しました。
//: - `ProofPayloadInvalid`: stored proof payload は artifact schema 上は表せるが、reader が復元時に拒否する field range などを含んでいます。
//: - `RecordWordOrdinalInvalid`: fixed-width record writer が schema v1 の範囲外 ordinal を要求しました。
//: - `WordPushInvalid(kind)`: shared word codec が word write を拒否しました。
//: - `PayloadByteMissing`: borrowed payload bytes の length と `get` が一致しない defensive failure です。
//: - `PayloadBytePushInvalid(kind)`: payload byte copy 中の `Vec` push に失敗しました。
pub enum SelfhostMemoTraitNeplProofSerializerErrorKind:
    HeaderInvalid %SelfhostMemoTraitNeplProofArtifactErrorKind
    IndexCountUnsupported
    RecordInvalid %SelfhostMemoTraitNeplProofArtifactErrorKind
    ProofPayloadInvalid
    RecordWordOrdinalInvalid
    WordPushInvalid %StdErrorKind
    PayloadByteMissing
    PayloadBytePushInvalid %StdErrorKind

//: SelfhostMemoTraitNeplProofSerializerStage0Summary: serializer の代表 smoke
pub struct SelfhostMemoTraitNeplProofSerializerStage0Summary:
    accepted_writer %Result unit SelfhostMemoTraitNeplProofSerializerErrorKind
    invalid_header %Result unit SelfhostMemoTraitNeplProofSerializerErrorKind
    invalid_record %Result unit SelfhostMemoTraitNeplProofSerializerErrorKind
    invalid_proof_payload %Result unit SelfhostMemoTraitNeplProofSerializerErrorKind
    payload_reader_roundtrip %Result unit SelfhostMemoTraitNeplProofPayloadReaderErrorKind

impl Clone for SelfhostMemoTraitNeplProofSerializerErrorKind:
    fn clone %fn &SelfhostMemoTraitNeplProofSerializerErrorKind SelfhostMemoTraitNeplProofSerializerErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofSerializerErrorKind:
    fn copy_mark %fn SelfhostMemoTraitNeplProofSerializerErrorKind SelfhostMemoTraitNeplProofSerializerErrorKind \self:
        self

impl Clone for SelfhostMemoTraitNeplProofSerializerStage0Summary:
    fn clone %fn &SelfhostMemoTraitNeplProofSerializerStage0Summary SelfhostMemoTraitNeplProofSerializerStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitNeplProofSerializerStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitNeplProofSerializerStage0Summary SelfhostMemoTraitNeplProofSerializerStage0Summary \self:
        self

//: selfhost_memo_trait_neplproof_serializer_record_words: Phase 1 record body の word 数
fn selfhost_memo_trait_neplproof_serializer_record_words %fn void i32 \void:
    31

//: selfhost_memo_trait_neplproof_serializer_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_neplproof_serializer_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    match a:
        StdErrorKind::Failure:
            match b:
                StdErrorKind::Failure:
                    true
                _:
                    false
        StdErrorKind::OutOfMemory:
            match b:
                StdErrorKind::OutOfMemory:
                    true
                _:
                    false
        StdErrorKind::EmptyCollection:
            match b:
                StdErrorKind::EmptyCollection:
                    true
                _:
                    false
        StdErrorKind::IndexOutOfBounds:
            match b:
                StdErrorKind::IndexOutOfBounds:
                    true
                _:
                    false
        StdErrorKind::KeyNotFound:
            match b:
                StdErrorKind::KeyNotFound:
                    true
                _:
                    false
        StdErrorKind::CapacityExceeded:
            match b:
                StdErrorKind::CapacityExceeded:
                    true
                _:
                    false
        StdErrorKind::InvalidOperation:
            match b:
                StdErrorKind::InvalidOperation:
                    true
                _:
                    false
        StdErrorKind::InvalidUtf8:
            match b:
                StdErrorKind::InvalidUtf8:
                    true
                _:
                    false
        StdErrorKind::ParseError:
            match b:
                StdErrorKind::ParseError:
                    true
                _:
                    false
        StdErrorKind::IoError:
            match b:
                StdErrorKind::IoError:
                    true
                _:
                    false
        StdErrorKind::Other:
            match b:
                StdErrorKind::Other:
                    true
                _:
                    false

//: selfhost_memo_trait_neplproof_serializer_error_kind_code: serializer error の variant code を[返/かえ]す
fn selfhost_memo_trait_neplproof_serializer_error_kind_code %fn SelfhostMemoTraitNeplProofSerializerErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitNeplProofSerializerErrorKind::HeaderInvalid _inner:
            1
        SelfhostMemoTraitNeplProofSerializerErrorKind::IndexCountUnsupported:
            2
        SelfhostMemoTraitNeplProofSerializerErrorKind::RecordInvalid _inner:
            3
        SelfhostMemoTraitNeplProofSerializerErrorKind::ProofPayloadInvalid:
            4
        SelfhostMemoTraitNeplProofSerializerErrorKind::RecordWordOrdinalInvalid:
            5
        SelfhostMemoTraitNeplProofSerializerErrorKind::WordPushInvalid _inner:
            6
        SelfhostMemoTraitNeplProofSerializerErrorKind::PayloadByteMissing:
            7
        SelfhostMemoTraitNeplProofSerializerErrorKind::PayloadBytePushInvalid _inner:
            8

//: selfhost_memo_trait_neplproof_serializer_error_kind_eq: serializer error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - nested payload を持つ variant は payload も比較します。
//: - non-payload variant は variant code が一致した場合だけ true を返します。
pub fn selfhost_memo_trait_neplproof_serializer_error_kind_eq %fn SelfhostMemoTraitNeplProofSerializerErrorKind fn SelfhostMemoTraitNeplProofSerializerErrorKind bool \a\b:
    if:
        ne selfhost_memo_trait_neplproof_serializer_error_kind_code a selfhost_memo_trait_neplproof_serializer_error_kind_code b
        then:
            false
        else:
            match a:
                SelfhostMemoTraitNeplProofSerializerErrorKind::HeaderInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofSerializerErrorKind::HeaderInvalid b_kind:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofSerializerErrorKind::RecordInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofSerializerErrorKind::RecordInvalid b_kind:
                            selfhost_memo_trait_neplproof_artifact_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofSerializerErrorKind::WordPushInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofSerializerErrorKind::WordPushInvalid b_kind:
                            selfhost_memo_trait_neplproof_serializer_std_error_kind_eq a_kind b_kind
                        _:
                            false
                SelfhostMemoTraitNeplProofSerializerErrorKind::PayloadBytePushInvalid a_kind:
                    match b:
                        SelfhostMemoTraitNeplProofSerializerErrorKind::PayloadBytePushInvalid b_kind:
                            selfhost_memo_trait_neplproof_serializer_std_error_kind_eq a_kind b_kind
                        _:
                            false
                _:
                    true

//: selfhost_memo_trait_neplproof_serializer_unit_result_is_ok: serializer unit result が成功か[返/かえ]す
pub fn selfhost_memo_trait_neplproof_serializer_unit_result_is_ok %fn Result unit SelfhostMemoTraitNeplProofSerializerErrorKind bool \result:
    match result:
        Result::Ok _unit:
            true
        Result::Err _kind:
            false

//: selfhost_memo_trait_neplproof_serializer_push_word_result: shared word codec で word を[追加/ついか]する
//:
//: [契約/けいやく]:
//: - 成功時は追加済み bytes owner を返します。
//: - 失敗時の output owner cleanup は shared word codec の契約に従います。
fn selfhost_memo_trait_neplproof_serializer_push_word_result %impure fn Vec u8 impure fn i32 Result Vec u8 SelfhostMemoTraitNeplProofSerializerErrorKind \bytes\word:
    match selfhost_memo_trait_artifact_word_codec_push_word_std_result bytes word:
        Result::Ok next:
            Result::Ok next
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofSerializerErrorKind::WordPushInvalid e

//: selfhost_memo_trait_neplproof_serializer_header_checked_result: header を serializer phase に[検査/けんさ]する
fn selfhost_memo_trait_neplproof_serializer_header_checked_result %fn SelfhostMemoTraitNeplProofHeader Result SelfhostMemoTraitNeplProofHeader SelfhostMemoTraitNeplProofSerializerErrorKind \header:
    match selfhost_memo_trait_neplproof_header_result header.artifact_schema_version header.canonical_payload_schema_version header.policy_schema_version header.record_count header.index_count:
        Result::Ok checked:
            if:
                ne checked.index_count checked.record_count
                then:
                    Result::Err SelfhostMemoTraitNeplProofSerializerErrorKind::IndexCountUnsupported
                else:
                    Result::Ok checked
        Result::Err e:
            Result::Err SelfhostMemoTraitNeplProofSerializerErrorKind::HeaderInvalid e

//: selfhost_memo_trait_neplproof_serializer_push_header_words: checked header を bytes へ[書/か]く
fn selfhost_memo_trait_neplproof_serializer_push_header_words %impure fn Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result Vec u8 SelfhostMemoTraitNeplProofSerializerErrorKind \bytes\header:
    match selfhost_memo_trait_neplproof_serializer_push_word_result bytes selfhost_memo_trait_neplproof_reader_magic:
        Result::Ok bytes1:
            match selfhost_memo_trait_neplproof_serializer_push_word_result bytes1 header.artifact_schema_version:
                Result::Ok bytes2:
                    match selfhost_memo_trait_neplproof_serializer_push_word_result bytes2 header.canonical_payload_schema_version:
                        Result::Ok bytes3:
                            match selfhost_memo_trait_neplproof_serializer_push_word_result bytes3 header.policy_schema_version:
                                Result::Ok bytes4:
                                    match selfhost_memo_trait_neplproof_serializer_push_word_result bytes4 header.record_count:
                                        Result::Ok bytes5:
                                            selfhost_memo_trait_neplproof_serializer_push_word_result bytes5 header.index_count
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_neplproof_serializer_header_result: `.neplproof` header bytes を[追加/ついか]する
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(bytes)`: magic と header words が追加された output owner です。
//: - `Err(kind)`: header schema / Phase 1 index count / shared word codec のいずれかが拒否したことを表します。
pub fn selfhost_memo_trait_neplproof_serializer_header_result %impure fn Vec u8 impure fn SelfhostMemoTraitNeplProofHeader Result Vec u8 SelfhostMemoTraitNeplProofSerializerErrorKind \bytes\header:
    match selfhost_memo_trait_neplproof_serializer_header_checked_result header:
        Result::Ok checked:
            selfhost_memo_trait_neplproof_serializer_push_header_words bytes checked
        Result::Err e:
            v::free bytes
            Result::Err e

//: selfhost_memo_trait_neplproof_serializer_source_kind_artifact_word: source kind enum を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_source_kind_artifact_word %fn SelfhostMemoTraitSourceKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            1
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            2

//: selfhost_memo_trait_neplproof_serializer_proof_kind_artifact_word: stored proof kind enum を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_proof_kind_artifact_word %fn SelfhostMemoTraitStoredProofKind i32 \kind:
    match kind:
        SelfhostMemoTraitStoredProofKind::KeyAndValue:
            1
        SelfhostMemoTraitStoredProofKind::KeyOnlyUnsupported:
            2
        SelfhostMemoTraitStoredProofKind::ValueOnlyUnsupported:
            3

//: selfhost_memo_trait_neplproof_serializer_field_evidence_artifact_word: field evidence enum を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_field_evidence_artifact_word %fn SelfhostMemoTraitAggregateFieldEvidence i32 \fields:
    match fields:
        SelfhostMemoTraitAggregateFieldEvidence::Known _range:
            1
        SelfhostMemoTraitAggregateFieldEvidence::MissingLayout:
            2
        SelfhostMemoTraitAggregateFieldEvidence::GenericArgumentUnsubstituted:
            3
        SelfhostMemoTraitAggregateFieldEvidence::CycleLimitReached:
            4

//: selfhost_memo_trait_neplproof_serializer_field_evidence_first_field: field evidence の first field payload を[返/かえ]す
fn selfhost_memo_trait_neplproof_serializer_field_evidence_first_field %fn SelfhostMemoTraitAggregateFieldEvidence i32 \fields:
    match fields:
        SelfhostMemoTraitAggregateFieldEvidence::Known range:
            range.first_field
        SelfhostMemoTraitAggregateFieldEvidence::MissingLayout:
            0
        SelfhostMemoTraitAggregateFieldEvidence::GenericArgumentUnsubstituted:
            0
        SelfhostMemoTraitAggregateFieldEvidence::CycleLimitReached:
            0

//: selfhost_memo_trait_neplproof_serializer_field_evidence_count: field evidence の field count payload を[返/かえ]す
fn selfhost_memo_trait_neplproof_serializer_field_evidence_count %fn SelfhostMemoTraitAggregateFieldEvidence i32 \fields:
    match fields:
        SelfhostMemoTraitAggregateFieldEvidence::Known range:
            range.field_count
        SelfhostMemoTraitAggregateFieldEvidence::MissingLayout:
            0
        SelfhostMemoTraitAggregateFieldEvidence::GenericArgumentUnsubstituted:
            0
        SelfhostMemoTraitAggregateFieldEvidence::CycleLimitReached:
            0

//: selfhost_memo_trait_neplproof_serializer_proof_status_artifact_word: operation proof status を artifact word へ[写/うつ]す
fn selfhost_memo_trait_neplproof_serializer_proof_status_artifact_word %fn SelfhostMemoTraitAggregateProofStatus i32 \status:
    match status:
        SelfhostMemoTraitAggregateProofStatus::Proven:
            1
        SelfhostMemoTraitAggregateProofStatus::Missing:
            2
        SelfhostMemoTraitAggregateProofStatus::Impure:
            3
        SelfhostMemoTraitAggregateProofStatus::Unknown:
            4

//: selfhost_memo_trait_neplproof_serializer_hazard_artifact_word: hazard evidence を artifact word へ[写/うつ]す
