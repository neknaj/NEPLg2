#indent 4

//: # ty/substitution
//: self-host compiler の `SelfhostTypeArena` 上で、generic type parameter を concrete type argument に[置換/ちかん]する typed traversal module です。
//:
//: [目的/もくてき]:
//: - generic impl instantiation では、`T` のような binder 由来の型 parameter を、resolver が選んだ concrete type argument に置き換えた target type / trait application type が必要になります。
//: - hash だけの substitution result を先に通すと、actual type traversal を通らない値が generic impl acceptance の authority になってしまいます。
//: - この module は `SelfhostTypeRecord` を variant ごとに走査し、parameter replacement、applied type rebuild、function type rebuild を typed step stream として記録します。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostTypeArena`、`SelfhostTypeSubstitutionBindingTable`、root `SelfhostTypeId` の typed field だけです。
//: - source text、span、lexeme、display name、diagnostic text、module path、public surface hash、HIR、Resource IR、backend artifact、proof store record は substitution authority にしません。
//: - binding table は `SelfhostTypeParameterBinding` と replacement `SelfhostTypeId` の対応だけを持ちます。同じ binding が 2 回以上出た場合は fail-closed に拒否します。
//: - replacement `SelfhostTypeId` は同じ arena 内に存在しなければなりません。別 arena の TypeId を混ぜないため、この module は stable hash だけの replacement を受け取りません。
//: - replacement 型自体をさらに再帰置換しません。generic instantiation の concrete type argument は、上位の stable type argument identity / solver gate が concrete であることを別 evidence として検査します。
//: - applied type と function type は、child を置換した後に arena 末尾へ再構築します。primitive、named、未置換 parameter は元の TypeId をそのまま output とします。
//: - traversal fuel が尽きた場合は、壊れた cyclic arena または想定外に深い型として拒否します。fuel は後続で explicit stack へ置き換えられますが、現在の semantic contract は変えません。
//:
//: [現状/げんじょう]:
//: - この module は reusable type substitution engine です。`memo_trait_public_impl_generic_substitution_shape` や materializer accepted path への接続は後続 slice で行います。
//: - trait bound solver、generic coherence、operation candidate materializer、PrivateCache / PrivateState effect masking、prechecked artifact には接続しません。
//:
//: [計算量/けいさんりょう]:
//: - 走査する型 record / edge 数を n、binding table の record 数を m、rebuild する applied / function child edge 数を a とすると、現在は duplicate validation が O(m * m)、parameter lookup が O(n * m)、rebuild が O(a) です。
//: - 合計の上界は O(m * m + n * m + a) です。この値は現在の単純な `Vec` table 実装の詳細であり、substitution evidence の公開契約ではありません。
//: - binding table の sorted index 化、duplicate validation index 化、lookup cache は、入力と出力の typed contract を保って後から差し替えられる最適化です。
//: - 追加空間は step table と、rebuild 対象の applied / function argument vector に比例します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/id" as *
//:| #import "neplg2/core/ty/ty/substitution" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_type_substitution_stage0:
//:         Result::Ok summary:
//:             let expected_duplicate %SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind::DuplicateBinding selfhost_type_parameter_binding_new_unchecked 0 0
//:             let expected_invalid %SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind::InvalidBinding selfhost_type_parameter_binding_new_unchecked 0 sub 0 1
//:             let expected_missing_replacement %SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind::ReplacementTypeMissing selfhost_type_id_new 99
//:             let expected_missing_root %SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind::MissingSourceTypeRecord selfhost_type_id_new 99
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check is_ok summary.accepted
//:             let checks2 checks_push checks1 check summary.accepted_step_hash_verified
//:             let checks3 checks_push checks2 check selfhost_type_substitution_error_result_eq summary.duplicate_binding expected_duplicate
//:             let checks4 checks_push checks3 check selfhost_type_substitution_error_result_eq summary.invalid_binding expected_invalid
//:             let checks5 checks_push checks4 check selfhost_type_substitution_error_result_eq summary.missing_replacement expected_missing_replacement
//:             let checks6 checks_push checks5 check selfhost_type_substitution_error_result_eq summary.missing_root expected_missing_root
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "type substitution stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./arena" as *
#import "./id" as *
#import "./kind/model" as *
#import "./record" as *

//: SelfhostTypeSubstitutionBindingRecord: 1 generic binding と 1 concrete replacement TypeId の対応 record
//:
//: [契約/けいやく]:
//: - `binding` は source spelling ではなく binder depth / parameter index です。
//: - `replacement_type_id` は同じ `SelfhostTypeArena` 内の concrete type argument を指します。
pub struct SelfhostTypeSubstitutionBindingRecord:
    binding %SelfhostTypeParameterBinding
    replacement_type_id %SelfhostTypeId

//: SelfhostTypeSubstitutionBindingTable: substitution environment の owner table
//:
//: [契約/けいやく]:
//: - この table は generic binder slot と type argument TypeId の対応を持ちます。
//: - validation は substitution 開始時に行い、invalid binding、duplicate binding、missing replacement を fail-closed に拒否します。
pub struct SelfhostTypeSubstitutionBindingTable:
    records %Vec SelfhostTypeSubstitutionBindingRecord

//: SelfhostTypeSubstitutionStepKind: substitution traversal step の分類
//:
//: [目的/もくてき]:
//: - bool や文字列ではなく enum で、どの variant をどの規則で処理したかを保存します。
pub enum SelfhostTypeSubstitutionStepKind:
    PrimitiveKept
    NamedKept
    ParameterKept
    ParameterReplaced
    AppliedRebuilt
    FunctionRebuilt

//: SelfhostTypeSubstitutionStepRecord: typed traversal の 1 step
//:
//: [契約/けいやく]:
//: - `step_ordinal` は step table 内の 0-origin index です。
//: - `source_type_id` と `output_type_id` は同じ arena 内の TypeId です。
//: - `child_count` は applied type の型引数数、function type の引数数 + result 1、leaf step の 0 を表します。
pub struct SelfhostTypeSubstitutionStepRecord:
    step_ordinal %i32
    source_type_id %SelfhostTypeId
    output_type_id %SelfhostTypeId
    kind %SelfhostTypeSubstitutionStepKind
    child_count %i32

//: SelfhostTypeSubstitutionStepTable: substitution step stream の owner table
//:
//: [契約/けいやく]:
//: - caller は result を使い終えたら `selfhost_type_substitution_result_free` で step table と arena をまとめて閉じます。
pub struct SelfhostTypeSubstitutionStepTable:
    records %Vec SelfhostTypeSubstitutionStepRecord

//: SelfhostTypeSubstitutionEvidence: accepted substitution traversal evidence
//:
//: [契約/けいやく]:
//: - `step_stream_hash` は step table の typed record 全体を schema 付きで畳み込んだ nonzero hash です。
//: - evidence は output TypeId だけでなく、root input、binding count、step count を保持します。
//: - 後続 consumer は `selfhost_type_substitution_step_table_hash_result` で step table を再検査してから evidence を使います。
pub struct SelfhostTypeSubstitutionEvidence:
    schema_version %i32
    root_type_id %SelfhostTypeId
    output_type_id %SelfhostTypeId
    binding_count %i32
    step_count %i32
    step_stream_hash %i32

//: SelfhostTypeSubstitutionResult: substitution 成功時の owner bundle
//:
//: [契約/けいやく]:
//: - `arena` は input arena を消費して更新した owner です。
//: - `step_table` は traversal evidence の再検査に必要な typed stream です。
pub struct SelfhostTypeSubstitutionResult:
    arena %SelfhostTypeArena
    step_table %SelfhostTypeSubstitutionStepTable
    evidence %SelfhostTypeSubstitutionEvidence

//: SelfhostTypeSubstitutionNodeResult: recursive traversal 内部の owner bundle
struct SelfhostTypeSubstitutionNodeResult:
    arena %SelfhostTypeArena
    step_table %SelfhostTypeSubstitutionStepTable
    output_type_id %SelfhostTypeId

//: SelfhostTypeSubstitutionArgBuild: applied / function rebuild 用の一時 argument owner
struct SelfhostTypeSubstitutionArgBuild:
    arena %SelfhostTypeArena
    step_table %SelfhostTypeSubstitutionStepTable
    args %Vec SelfhostTypeId

//: SelfhostTypeSubstitutionErrorKind: type substitution engine の拒否理由
pub enum SelfhostTypeSubstitutionErrorKind:
    BindingTableAllocFailed %StdErrorKind
    BindingPushFailed %StdErrorKind
    BindingRecordReadFailed %i32
    StepTableAllocFailed %StdErrorKind
    StepPushFailed %StdErrorKind
    ArgVectorAllocFailed %StdErrorKind
    ArgPushFailed %StdErrorKind
    InvalidBinding %SelfhostTypeParameterBinding
    DuplicateBinding %SelfhostTypeParameterBinding
    ReplacementTypeMissing %SelfhostTypeId
    MissingSourceTypeRecord %SelfhostTypeId
    MissingAppliedTypeArgument %SelfhostTypeId
    MissingFunctionTypeArgument %SelfhostTypeId
    MissingFunctionResult %SelfhostTypeId
    AppliedRebuildFailed %StdErrorKind
    FunctionRebuildFailed %StdErrorKind
    TraversalFuelExhausted %SelfhostTypeId
    StepStreamHashPlaceholder
    EvidenceHashMismatch

//: SelfhostTypeSubstitutionStage0Summary: substitution engine smoke の代表結果
pub struct SelfhostTypeSubstitutionStage0Summary:
    accepted %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind
    accepted_step_hash_verified %bool
    duplicate_binding %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind
    invalid_binding %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind
    missing_replacement %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind
    missing_root %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind

impl Clone for SelfhostTypeSubstitutionBindingRecord:
    fn clone %fn &SelfhostTypeSubstitutionBindingRecord SelfhostTypeSubstitutionBindingRecord \self:
        *self

impl Copy for SelfhostTypeSubstitutionBindingRecord:
    fn copy_mark %fn SelfhostTypeSubstitutionBindingRecord SelfhostTypeSubstitutionBindingRecord \self:
        self

impl Clone for SelfhostTypeSubstitutionStepKind:
    fn clone %fn &SelfhostTypeSubstitutionStepKind SelfhostTypeSubstitutionStepKind \self:
        *self

impl Copy for SelfhostTypeSubstitutionStepKind:
    fn copy_mark %fn SelfhostTypeSubstitutionStepKind SelfhostTypeSubstitutionStepKind \self:
        self

impl Clone for SelfhostTypeSubstitutionStepRecord:
    fn clone %fn &SelfhostTypeSubstitutionStepRecord SelfhostTypeSubstitutionStepRecord \self:
        *self

impl Copy for SelfhostTypeSubstitutionStepRecord:
    fn copy_mark %fn SelfhostTypeSubstitutionStepRecord SelfhostTypeSubstitutionStepRecord \self:
        self

impl Clone for SelfhostTypeSubstitutionEvidence:
    fn clone %fn &SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionEvidence \self:
        *self

impl Copy for SelfhostTypeSubstitutionEvidence:
    fn copy_mark %fn SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionEvidence \self:
        self

impl Clone for SelfhostTypeSubstitutionErrorKind:
    fn clone %fn &SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind \self:
        *self

impl Copy for SelfhostTypeSubstitutionErrorKind:
    fn copy_mark %fn SelfhostTypeSubstitutionErrorKind SelfhostTypeSubstitutionErrorKind \self:
        self

impl Clone for SelfhostTypeSubstitutionStage0Summary:
    fn clone %fn &SelfhostTypeSubstitutionStage0Summary SelfhostTypeSubstitutionStage0Summary \self:
        *self

impl Copy for SelfhostTypeSubstitutionStage0Summary:
    fn copy_mark %fn SelfhostTypeSubstitutionStage0Summary SelfhostTypeSubstitutionStage0Summary \self:
        self

//: selfhost_type_substitution_schema_version: substitution evidence schema
pub fn selfhost_type_substitution_schema_version %fn void i32 \void:
    1

//: selfhost_type_substitution_default_fuel: recursive traversal の既定 fuel
pub fn selfhost_type_substitution_default_fuel %fn void i32 \void:
    256

//: selfhost_type_substitution_binding_record_new: substitution binding record を[作/つく]る
pub fn selfhost_type_substitution_binding_record_new %fn SelfhostTypeParameterBinding fn SelfhostTypeId SelfhostTypeSubstitutionBindingRecord \binding\replacement_type_id:
    SelfhostTypeSubstitutionBindingRecord binding replacement_type_id

//: selfhost_type_substitution_binding_table_new: [空/から]の binding table を[作/つく]る
pub fn selfhost_type_substitution_binding_table_new %impure fn void Result SelfhostTypeSubstitutionBindingTable SelfhostTypeSubstitutionErrorKind \void:
    let records_result %Result Vec SelfhostTypeSubstitutionBindingRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostTypeSubstitutionBindingTable records
        Result::Err e:
            Result::Err SelfhostTypeSubstitutionErrorKind::BindingTableAllocFailed e

//: selfhost_type_substitution_binding_table_free: binding table owner を[閉/と]じる
pub fn selfhost_type_substitution_binding_table_free %impure fn SelfhostTypeSubstitutionBindingTable unit \table:
    v::free field::get table "records"

//: selfhost_type_substitution_binding_table_len: binding record 数を[返/かえ]す
pub fn selfhost_type_substitution_binding_table_len %fn &SelfhostTypeSubstitutionBindingTable i32 \table:
    let records %&Vec SelfhostTypeSubstitutionBindingRecord field::get_ref table "records"
    v::len records

//: selfhost_type_substitution_binding_table_push: binding record を[追加/ついか]する
pub fn selfhost_type_substitution_binding_table_push %impure fn SelfhostTypeSubstitutionBindingTable impure fn SelfhostTypeSubstitutionBindingRecord Result SelfhostTypeSubstitutionBindingTable SelfhostTypeSubstitutionErrorKind \table\record:
    let records %Vec SelfhostTypeSubstitutionBindingRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostTypeSubstitutionBindingTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostTypeSubstitutionErrorKind::BindingPushFailed error

//: selfhost_type_substitution_step_table_new: [空/から]の step table を[作/つく]る
fn selfhost_type_substitution_step_table_new %impure fn void Result SelfhostTypeSubstitutionStepTable SelfhostTypeSubstitutionErrorKind \void:
    let records_result %Result Vec SelfhostTypeSubstitutionStepRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostTypeSubstitutionStepTable records
        Result::Err e:
            Result::Err SelfhostTypeSubstitutionErrorKind::StepTableAllocFailed e

//: selfhost_type_substitution_step_table_free: step table owner を[閉/と]じる
pub fn selfhost_type_substitution_step_table_free %impure fn SelfhostTypeSubstitutionStepTable unit \table:
    v::free field::get table "records"

//: selfhost_type_substitution_step_table_len: step record 数を[返/かえ]す
pub fn selfhost_type_substitution_step_table_len %fn &SelfhostTypeSubstitutionStepTable i32 \table:
    let records %&Vec SelfhostTypeSubstitutionStepRecord field::get_ref table "records"
    v::len records

//: selfhost_type_substitution_result_free: substitution result owner を[閉/と]じる
pub fn selfhost_type_substitution_result_free %impure fn SelfhostTypeSubstitutionResult unit \result:
    selfhost_type_arena_free field::get result "arena"
    selfhost_type_substitution_step_table_free field::get result "step_table"

//: selfhost_type_substitution_mix2: substitution hash 用に 2 値を[混/ま]ぜる
fn selfhost_type_substitution_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_type_substitution_mix4: substitution hash 用に 4 値を[混/ま]ぜる
fn selfhost_type_substitution_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_type_substitution_mix2 (selfhost_type_substitution_mix2 a b) (selfhost_type_substitution_mix2 c d)

//: selfhost_type_substitution_step_kind_code: step kind を hash 用 code へ[写/うつ]す
fn selfhost_type_substitution_step_kind_code %fn SelfhostTypeSubstitutionStepKind i32 \kind:
    match kind:
        SelfhostTypeSubstitutionStepKind::PrimitiveKept:
            1
        SelfhostTypeSubstitutionStepKind::NamedKept:
            2
        SelfhostTypeSubstitutionStepKind::ParameterKept:
            3
        SelfhostTypeSubstitutionStepKind::ParameterReplaced:
            4
        SelfhostTypeSubstitutionStepKind::AppliedRebuilt:
            5
        SelfhostTypeSubstitutionStepKind::FunctionRebuilt:
            6

//: selfhost_type_substitution_step_record_hash: step record を hash material へ[写/うつ]す
fn selfhost_type_substitution_step_record_hash %fn SelfhostTypeSubstitutionStepRecord i32 \record:
    let id_material %i32 selfhost_type_substitution_mix4 record.step_ordinal record.source_type_id.index record.output_type_id.index record.child_count
    selfhost_type_substitution_mix4 731101 selfhost_type_substitution_step_kind_code record.kind id_material selfhost_type_substitution_schema_version

//: selfhost_type_substitution_step_table_hash_loop: step table を左から hash に[畳/たた]む
fn selfhost_type_substitution_step_table_hash_loop %fn &SelfhostTypeSubstitutionStepTable fn i32 fn i32 fn i32 Result i32 SelfhostTypeSubstitutionErrorKind \table\idx\n\current_hash:
    if:
        ge idx n
        then:
            if:
                eq current_hash 0
                then:
                    Result::Err SelfhostTypeSubstitutionErrorKind::StepStreamHashPlaceholder
                else:
                    Result::Ok current_hash
        else:
            let records %&Vec SelfhostTypeSubstitutionStepRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some record:
                    if:
                        not eq record.step_ordinal idx
                        then:
                            Result::Err SelfhostTypeSubstitutionErrorKind::EvidenceHashMismatch
                        else:
                            selfhost_type_substitution_step_table_hash_loop table add idx 1 n selfhost_type_substitution_mix2 current_hash selfhost_type_substitution_step_record_hash record
                Option::None:
                    Result::Err SelfhostTypeSubstitutionErrorKind::EvidenceHashMismatch

//: selfhost_type_substitution_step_table_hash_result: step table から schema 付き hash を再計算する
pub fn selfhost_type_substitution_step_table_hash_result %fn &SelfhostTypeSubstitutionStepTable Result i32 SelfhostTypeSubstitutionErrorKind \table:
    let n %i32 selfhost_type_substitution_step_table_len table
    let initial_hash %i32 selfhost_type_substitution_mix4 731001 selfhost_type_substitution_schema_version n 0
    selfhost_type_substitution_step_table_hash_loop table 0 n initial_hash

//: selfhost_type_substitution_push_step: typed traversal step を[追加/ついか]する
fn selfhost_type_substitution_push_step %impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeSubstitutionStepKind impure fn i32 Result SelfhostTypeSubstitutionStepTable SelfhostTypeSubstitutionErrorKind \table\source_type_id\output_type_id\kind\child_count:
    let step_ordinal %i32 selfhost_type_substitution_step_table_len &table
    let record %SelfhostTypeSubstitutionStepRecord SelfhostTypeSubstitutionStepRecord step_ordinal source_type_id output_type_id kind child_count
    let records %Vec SelfhostTypeSubstitutionStepRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostTypeSubstitutionStepTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostTypeSubstitutionErrorKind::StepPushFailed error

//: selfhost_type_substitution_error_std_code: StdErrorKind を local equality code へ[写/うつ]す
fn selfhost_type_substitution_error_std_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            1
        StdErrorKind::OutOfMemory:
            2
        StdErrorKind::EmptyCollection:
            3
        StdErrorKind::IndexOutOfBounds:
            4
        StdErrorKind::KeyNotFound:
            5
        StdErrorKind::CapacityExceeded:
            6
        StdErrorKind::InvalidOperation:
            7
        StdErrorKind::InvalidUtf8:
            8
        StdErrorKind::ParseError:
            9
        StdErrorKind::IoError:
            10
        StdErrorKind::Other:
            11

//: selfhost_type_substitution_error_kind_code: error variant を equality 用 code へ[写/うつ]す
fn selfhost_type_substitution_error_kind_code %fn SelfhostTypeSubstitutionErrorKind i32 \kind:
    match kind:
        SelfhostTypeSubstitutionErrorKind::BindingTableAllocFailed _error:
            1
        SelfhostTypeSubstitutionErrorKind::BindingPushFailed _error:
            2
        SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed _idx:
            3
        SelfhostTypeSubstitutionErrorKind::StepTableAllocFailed _error:
            4
        SelfhostTypeSubstitutionErrorKind::StepPushFailed _error:
            5
        SelfhostTypeSubstitutionErrorKind::ArgVectorAllocFailed _error:
            6
        SelfhostTypeSubstitutionErrorKind::ArgPushFailed _error:
            7
        SelfhostTypeSubstitutionErrorKind::InvalidBinding _binding:
            8
        SelfhostTypeSubstitutionErrorKind::DuplicateBinding _binding:
            9
        SelfhostTypeSubstitutionErrorKind::ReplacementTypeMissing _id:
            10
        SelfhostTypeSubstitutionErrorKind::MissingSourceTypeRecord _id:
            11
        SelfhostTypeSubstitutionErrorKind::MissingAppliedTypeArgument _id:
            12
        SelfhostTypeSubstitutionErrorKind::MissingFunctionTypeArgument _id:
            13
        SelfhostTypeSubstitutionErrorKind::MissingFunctionResult _id:
            14
        SelfhostTypeSubstitutionErrorKind::AppliedRebuildFailed _error:
            15
        SelfhostTypeSubstitutionErrorKind::FunctionRebuildFailed _error:
            16
        SelfhostTypeSubstitutionErrorKind::TraversalFuelExhausted _id:
            17
        SelfhostTypeSubstitutionErrorKind::StepStreamHashPlaceholder:
            18
        SelfhostTypeSubstitutionErrorKind::EvidenceHashMismatch:
            19

//: selfhost_type_substitution_error_kind_payload0: error payload の第 1 比較成分を[返/かえ]す
fn selfhost_type_substitution_error_kind_payload0 %fn SelfhostTypeSubstitutionErrorKind i32 \kind:
    match kind:
        SelfhostTypeSubstitutionErrorKind::BindingTableAllocFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::BindingPushFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed idx:
            idx
        SelfhostTypeSubstitutionErrorKind::StepTableAllocFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::StepPushFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::ArgVectorAllocFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::ArgPushFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::InvalidBinding binding:
            binding.binder_depth
        SelfhostTypeSubstitutionErrorKind::DuplicateBinding binding:
            binding.binder_depth
        SelfhostTypeSubstitutionErrorKind::ReplacementTypeMissing id:
            id.index
        SelfhostTypeSubstitutionErrorKind::MissingSourceTypeRecord id:
            id.index
        SelfhostTypeSubstitutionErrorKind::MissingAppliedTypeArgument id:
            id.index
        SelfhostTypeSubstitutionErrorKind::MissingFunctionTypeArgument id:
            id.index
        SelfhostTypeSubstitutionErrorKind::MissingFunctionResult id:
            id.index
        SelfhostTypeSubstitutionErrorKind::AppliedRebuildFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::FunctionRebuildFailed error:
            selfhost_type_substitution_error_std_code error
        SelfhostTypeSubstitutionErrorKind::TraversalFuelExhausted id:
            id.index
        SelfhostTypeSubstitutionErrorKind::StepStreamHashPlaceholder:
            0
        SelfhostTypeSubstitutionErrorKind::EvidenceHashMismatch:
            0

//: selfhost_type_substitution_error_kind_payload1: error payload の第 2 比較成分を[返/かえ]す
fn selfhost_type_substitution_error_kind_payload1 %fn SelfhostTypeSubstitutionErrorKind i32 \kind:
    match kind:
        SelfhostTypeSubstitutionErrorKind::BindingTableAllocFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::BindingPushFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed _idx:
            0
        SelfhostTypeSubstitutionErrorKind::StepTableAllocFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::StepPushFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::ArgVectorAllocFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::ArgPushFailed _error:
            0
        SelfhostTypeSubstitutionErrorKind::InvalidBinding binding:
            binding.parameter_index
        SelfhostTypeSubstitutionErrorKind::DuplicateBinding binding:
            binding.parameter_index
        SelfhostTypeSubstitutionErrorKind::ReplacementTypeMissing _id:
            0
        SelfhostTypeSubstitutionErrorKind::MissingSourceTypeRecord _id:
            0
        SelfhostTypeSubstitutionErrorKind::MissingAppliedTypeArgument _id:
            0
        SelfhostTypeSubstitutionErrorKind::MissingFunctionTypeArgument _id:
