                Result::Ok step_table:
                    match selfhost_type_substitution_substitute_type_result arena step_table bindings root_type_id selfhost_type_substitution_default_fuel:
                        Result::Ok node:
                            let next_arena %SelfhostTypeArena field::get node "arena"
                            let next_steps %SelfhostTypeSubstitutionStepTable field::get node "step_table"
                            let output_type_id %SelfhostTypeId field::get node "output_type_id"
                            match selfhost_type_substitution_evidence_new_result &next_steps root_type_id output_type_id selfhost_type_substitution_binding_table_len bindings:
                                Result::Ok evidence:
                                    Result::Ok selfhost_type_substitution_result_new next_arena next_steps evidence
                                Result::Err e:
                                    selfhost_type_substitution_fail_with_step_table next_arena next_steps e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    selfhost_type_arena_free arena
                    Result::Err e
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

