                                            let accepted %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind Result::Ok accepted_evidence
                                            let summary %SelfhostTypeSubstitutionStage0Summary selfhost_type_substitution_stage0_summary_new accepted accepted_step_hash_verified duplicate_binding invalid_binding missing_replacement missing_root
                                            Result::Ok summary
                                        Result::Err e:
                                            Result::Err e
