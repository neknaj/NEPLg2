//: selfhost_type_substitution_error_kind_eq: error kind が payload まで同じか[返/かえ]す
pub fn selfhost_type_substitution_error_kind_eq %fn SelfhostTypeSubstitutionErrorKind fn SelfhostTypeSubstitutionErrorKind bool \a\b:
    let code_eq %bool eq selfhost_type_substitution_error_kind_code a selfhost_type_substitution_error_kind_code b
    let payload0_eq %bool eq selfhost_type_substitution_error_kind_payload0 a selfhost_type_substitution_error_kind_payload0 b
    let payload1_eq %bool eq selfhost_type_substitution_error_kind_payload1 a selfhost_type_substitution_error_kind_payload1 b
    let payload2_eq %bool eq selfhost_type_substitution_error_kind_payload2 a selfhost_type_substitution_error_kind_payload2 b
    and code_eq and payload0_eq and payload1_eq payload2_eq

//: selfhost_type_substitution_error_result_eq: result の error が expected と同じか[返/かえ]す
pub fn selfhost_type_substitution_error_result_eq %fn Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind fn SelfhostTypeSubstitutionErrorKind bool \result\expected:
    match result:
        Result::Ok _evidence:
            false
        Result::Err error:
            selfhost_type_substitution_error_kind_eq error expected

//: selfhost_type_substitution_binding_table_find_loop: binding table から replacement を[探/さが]す
fn selfhost_type_substitution_binding_table_find_loop %fn &SelfhostTypeSubstitutionBindingTable fn SelfhostTypeParameterBinding fn i32 fn Option SelfhostTypeId Result Option SelfhostTypeId SelfhostTypeSubstitutionErrorKind \table\binding\idx\found:
    if:
        ge idx selfhost_type_substitution_binding_table_len table
        then:
            Result::Ok found
        else:
            let records %&Vec SelfhostTypeSubstitutionBindingRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_type_parameter_binding_eq record.binding binding
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostTypeSubstitutionErrorKind::DuplicateBinding binding
                                Option::None:
                                    selfhost_type_substitution_binding_table_find_loop table binding add idx 1 some record.replacement_type_id
                        else:
                            selfhost_type_substitution_binding_table_find_loop table binding add idx 1 found
                Option::None:
                    Result::Err SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed idx

//: selfhost_type_substitution_binding_table_find_result: binding table から replacement を[返/かえ]す
fn selfhost_type_substitution_binding_table_find_result %fn &SelfhostTypeSubstitutionBindingTable fn SelfhostTypeParameterBinding Result Option SelfhostTypeId SelfhostTypeSubstitutionErrorKind \table\binding:
    selfhost_type_substitution_binding_table_find_loop table binding 0 none

//: selfhost_type_substitution_binding_record_validate_result: 1 binding record を[検査/けんさ]する
fn selfhost_type_substitution_binding_record_validate_result %fn &SelfhostTypeArena fn SelfhostTypeSubstitutionBindingRecord Result unit SelfhostTypeSubstitutionErrorKind \arena\record:
    if:
        not selfhost_type_parameter_binding_is_valid record.binding
        then:
            Result::Err SelfhostTypeSubstitutionErrorKind::InvalidBinding record.binding
        else:
            match selfhost_type_arena_get_record arena record.replacement_type_id:
                Option::Some _replacement:
                    Result::Ok unit
                Option::None:
                    Result::Err SelfhostTypeSubstitutionErrorKind::ReplacementTypeMissing record.replacement_type_id

//: selfhost_type_substitution_binding_table_duplicate_probe: 同じ binding が後続にないか[調/しら]べる
fn selfhost_type_substitution_binding_table_duplicate_probe %fn &SelfhostTypeSubstitutionBindingTable fn SelfhostTypeParameterBinding fn i32 Result unit SelfhostTypeSubstitutionErrorKind \table\binding\idx:
    if:
        ge idx selfhost_type_substitution_binding_table_len table
        then:
            Result::Ok unit
        else:
            let records %&Vec SelfhostTypeSubstitutionBindingRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some record:
                    if:
                        selfhost_type_parameter_binding_eq record.binding binding
                        then:
                            Result::Err SelfhostTypeSubstitutionErrorKind::DuplicateBinding binding
                        else:
                            selfhost_type_substitution_binding_table_duplicate_probe table binding add idx 1
                Option::None:
                    Result::Err SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed idx

//: selfhost_type_substitution_binding_table_validate_loop: binding table 全体を[検査/けんさ]する
fn selfhost_type_substitution_binding_table_validate_loop %fn &SelfhostTypeArena fn &SelfhostTypeSubstitutionBindingTable fn i32 Result unit SelfhostTypeSubstitutionErrorKind \arena\table\idx:
    if:
        ge idx selfhost_type_substitution_binding_table_len table
        then:
            Result::Ok unit
        else:
            let records %&Vec SelfhostTypeSubstitutionBindingRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some record:
                    match selfhost_type_substitution_binding_record_validate_result arena record:
                        Result::Ok _unit:
                            match selfhost_type_substitution_binding_table_duplicate_probe table record.binding add idx 1:
                                Result::Ok _no_duplicate:
                                    selfhost_type_substitution_binding_table_validate_loop arena table add idx 1
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostTypeSubstitutionErrorKind::BindingRecordReadFailed idx

//: selfhost_type_substitution_binding_table_validate_result: binding table が substitution environment として有効か[検査/けんさ]する
fn selfhost_type_substitution_binding_table_validate_result %fn &SelfhostTypeArena fn &SelfhostTypeSubstitutionBindingTable Result unit SelfhostTypeSubstitutionErrorKind \arena\table:
    selfhost_type_substitution_binding_table_validate_loop arena table 0

//: selfhost_type_substitution_fail_with_step_table: arena と step table を[閉/と]じて error を[返/かえ]す
fn selfhost_type_substitution_fail_with_step_table %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionResult SelfhostTypeSubstitutionErrorKind \arena\step_table\error:
    selfhost_type_arena_free arena
    selfhost_type_substitution_step_table_free step_table
    Result::Err error

//: selfhost_type_substitution_node_fail: recursive node の partial owner を[閉/と]じる
fn selfhost_type_substitution_node_fail %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\step_table\error:
    selfhost_type_arena_free arena
    selfhost_type_substitution_step_table_free step_table
    Result::Err error

//: selfhost_type_substitution_node_fail_after_step_table_consumed: step table を消費済みの node traversal 失敗を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `selfhost_type_substitution_push_step` は step table owner を消費します。
//: - その呼び出しが失敗した後に caller がまだ持っている owner は arena だけなので、ここでは arena だけを閉じます。
//: - Resource IR の moved cell を隠すためではなく、失敗分岐ごとの所有権境界を関数名で明示するための helper です。
fn selfhost_type_substitution_node_fail_after_step_table_consumed %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\error:
    selfhost_type_arena_free arena
    Result::Err error

//: selfhost_type_substitution_node_fail_after_arena_builder_consumed: arena builder を消費済みの node traversal 失敗を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `selfhost_type_arena_add_applied_named` と `selfhost_type_arena_add_function` は arena と argument vector を消費し、失敗時もその owner を caller へ返しません。
//: - そのため caller 側では、まだ所有している step table だけを閉じます。
fn selfhost_type_substitution_node_fail_after_arena_builder_consumed %impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \step_table\error:
    selfhost_type_substitution_step_table_free step_table
    Result::Err error

//: selfhost_type_substitution_arg_build_fail: argument vector を含む partial owner を[閉/と]じる
fn selfhost_type_substitution_arg_build_fail %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn Vec SelfhostTypeId impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionArgBuild SelfhostTypeSubstitutionErrorKind \arena\step_table\args\error:
    selfhost_type_arena_free arena
    selfhost_type_substitution_step_table_free step_table
    v::free args
    Result::Err error

//: selfhost_type_substitution_arg_build_fail_after_args_consumed: argument vector 消費後の失敗を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `selfhost_type_substitution_push_arg_result` は argument vector owner を消費します。
//: - 失敗時に caller が同じ vector を解放すると二重解放になるため、ここでは arena と step table だけを閉じます。
fn selfhost_type_substitution_arg_build_fail_after_args_consumed %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeSubstitutionErrorKind Result SelfhostTypeSubstitutionArgBuild SelfhostTypeSubstitutionErrorKind \arena\step_table\error:
    selfhost_type_arena_free arena
    selfhost_type_substitution_step_table_free step_table
    Result::Err error

//: selfhost_type_substitution_node_result_new: recursive node result を[作/つく]る
fn selfhost_type_substitution_node_result_new %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeId SelfhostTypeSubstitutionNodeResult \arena\step_table\output_type_id:
    SelfhostTypeSubstitutionNodeResult arena step_table output_type_id

//: selfhost_type_substitution_arg_build_new: rebuild argument build result を[作/つく]る
fn selfhost_type_substitution_arg_build_new %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn Vec SelfhostTypeId SelfhostTypeSubstitutionArgBuild \arena\step_table\args:
    SelfhostTypeSubstitutionArgBuild arena step_table args

//: selfhost_type_substitution_push_leaf_result: leaf step を[追加/ついか]して node result にする
fn selfhost_type_substitution_push_leaf_result %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostTypeSubstitutionStepKind Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\step_table\source_type_id\output_type_id\kind:
    match selfhost_type_substitution_push_step step_table source_type_id output_type_id kind 0:
        Result::Ok next_steps:
            Result::Ok selfhost_type_substitution_node_result_new arena next_steps output_type_id
        Result::Err e:
            selfhost_type_substitution_node_fail_after_step_table_consumed arena e

//: selfhost_type_substitution_substitute_type_result: 1 TypeId を[置換/ちかん]する recursive core
fn selfhost_type_substitution_substitute_type_result %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn &SelfhostTypeSubstitutionBindingTable impure fn SelfhostTypeId impure fn i32 Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\step_table\bindings\type_id\fuel:
    if:
        le fuel 0
        then:
            selfhost_type_substitution_node_fail arena step_table SelfhostTypeSubstitutionErrorKind::TraversalFuelExhausted type_id
        else:
            match selfhost_type_arena_get_record &arena type_id:
                Option::Some record:
                    match record:
                        SelfhostTypeRecord::Primitive _kind:
                            selfhost_type_substitution_push_leaf_result arena step_table type_id type_id SelfhostTypeSubstitutionStepKind::PrimitiveKept
                        SelfhostTypeRecord::Named _named:
                            selfhost_type_substitution_push_leaf_result arena step_table type_id type_id SelfhostTypeSubstitutionStepKind::NamedKept
                        SelfhostTypeRecord::Parameter parameter:
                            match selfhost_type_substitution_binding_table_find_result bindings parameter.binding:
                                Result::Ok replacement:
                                    match replacement:
                                        Option::Some replacement_type_id:
                                            selfhost_type_substitution_push_leaf_result arena step_table type_id replacement_type_id SelfhostTypeSubstitutionStepKind::ParameterReplaced
                                        Option::None:
                                            selfhost_type_substitution_push_leaf_result arena step_table type_id type_id SelfhostTypeSubstitutionStepKind::ParameterKept
                                Result::Err e:
                                    selfhost_type_substitution_node_fail arena step_table e
                        SelfhostTypeRecord::Applied applied:
                            selfhost_type_substitution_substitute_applied_result arena step_table bindings type_id applied sub fuel 1
                        SelfhostTypeRecord::Function function:
                            selfhost_type_substitution_substitute_function_result arena step_table bindings type_id function sub fuel 1
                Option::None:
                    selfhost_type_substitution_node_fail arena step_table SelfhostTypeSubstitutionErrorKind::MissingSourceTypeRecord type_id

//: selfhost_type_substitution_new_arg_vector_result: rebuild 用 TypeId vector を[作/つく]る
fn selfhost_type_substitution_new_arg_vector_result %impure fn void Result Vec SelfhostTypeId SelfhostTypeSubstitutionErrorKind \void:
    let args_result %Result Vec SelfhostTypeId StdErrorKind v::new
    match args_result:
        Result::Ok args:
            Result::Ok args
        Result::Err e:
            Result::Err SelfhostTypeSubstitutionErrorKind::ArgVectorAllocFailed e

//: selfhost_type_substitution_push_arg_result: rebuild 用 argument vector に TypeId を[追加/ついか]する
fn selfhost_type_substitution_push_arg_result %impure fn Vec SelfhostTypeId impure fn SelfhostTypeId Result Vec SelfhostTypeId SelfhostTypeSubstitutionErrorKind \args\type_id:
    match v::push args type_id:
        Result::Ok next_args:
            Result::Ok next_args
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostTypeSubstitutionErrorKind::ArgPushFailed error

//: selfhost_type_substitution_applied_args_loop: applied type arguments を左から[置換/ちかん]する
fn selfhost_type_substitution_applied_args_loop %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn &SelfhostTypeSubstitutionBindingTable impure fn Vec SelfhostTypeId impure fn SelfhostTypeId impure fn i32 impure fn i32 impure fn i32 Result SelfhostTypeSubstitutionArgBuild SelfhostTypeSubstitutionErrorKind \arena\step_table\bindings\args\source_type_id\idx\n\fuel:
    if:
        ge idx n
        then:
            Result::Ok selfhost_type_substitution_arg_build_new arena step_table args
        else:
            match selfhost_type_arena_applied_arg &arena source_type_id idx:
                Option::Some arg_type_id:
                    match selfhost_type_substitution_substitute_type_result arena step_table bindings arg_type_id fuel:
                        Result::Ok node:
                            let next_arena %SelfhostTypeArena field::get node "arena"
                            let next_steps %SelfhostTypeSubstitutionStepTable field::get node "step_table"
                            let output_arg %SelfhostTypeId field::get node "output_type_id"
                            match selfhost_type_substitution_push_arg_result args output_arg:
                                Result::Ok next_args:
                                    selfhost_type_substitution_applied_args_loop next_arena next_steps bindings next_args source_type_id add idx 1 n fuel
                                Result::Err e:
                                    selfhost_type_substitution_arg_build_fail_after_args_consumed next_arena next_steps e
                        Result::Err e:
                            v::free args
                            Result::Err e
                Option::None:
                    selfhost_type_substitution_arg_build_fail arena step_table args SelfhostTypeSubstitutionErrorKind::MissingAppliedTypeArgument source_type_id

//: selfhost_type_substitution_function_args_loop: function argument types を左から[置換/ちかん]する
fn selfhost_type_substitution_function_args_loop %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn &SelfhostTypeSubstitutionBindingTable impure fn Vec SelfhostTypeId impure fn SelfhostTypeId impure fn i32 impure fn i32 impure fn i32 Result SelfhostTypeSubstitutionArgBuild SelfhostTypeSubstitutionErrorKind \arena\step_table\bindings\args\source_type_id\idx\n\fuel:
    if:
        ge idx n
        then:
            Result::Ok selfhost_type_substitution_arg_build_new arena step_table args
        else:
            match selfhost_type_arena_function_arg &arena source_type_id idx:
                Option::Some arg_type_id:
                    match selfhost_type_substitution_substitute_type_result arena step_table bindings arg_type_id fuel:
                        Result::Ok node:
                            let next_arena %SelfhostTypeArena field::get node "arena"
                            let next_steps %SelfhostTypeSubstitutionStepTable field::get node "step_table"
                            let output_arg %SelfhostTypeId field::get node "output_type_id"
                            match selfhost_type_substitution_push_arg_result args output_arg:
                                Result::Ok next_args:
                                    selfhost_type_substitution_function_args_loop next_arena next_steps bindings next_args source_type_id add idx 1 n fuel
                                Result::Err e:
                                    selfhost_type_substitution_arg_build_fail_after_args_consumed next_arena next_steps e
                        Result::Err e:
                            v::free args
                            Result::Err e
                Option::None:
                    selfhost_type_substitution_arg_build_fail arena step_table args SelfhostTypeSubstitutionErrorKind::MissingFunctionTypeArgument source_type_id

//: selfhost_type_substitution_substitute_applied_result: applied named type を child 置換後に[再構築/さいこうちく]する
fn selfhost_type_substitution_substitute_applied_result %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn &SelfhostTypeSubstitutionBindingTable impure fn SelfhostTypeId impure fn SelfhostAppliedTypeRecord impure fn i32 Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\step_table\bindings\type_id\applied\fuel:
    let arg_count %i32 selfhost_applied_type_arg_range_count selfhost_applied_type_record_args applied
    match selfhost_type_substitution_new_arg_vector_result:
        Result::Ok args:
            match selfhost_type_substitution_applied_args_loop arena step_table bindings args type_id 0 arg_count fuel:
                Result::Ok build:
                    let build_arena %SelfhostTypeArena field::get build "arena"
                    let build_steps %SelfhostTypeSubstitutionStepTable field::get build "step_table"
                    let build_args %Vec SelfhostTypeId field::get build "args"
                    match selfhost_type_arena_add_applied_named build_arena applied.nominal_id build_args:
                        Result::Ok allocated:
                            let output_type_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated
                            let next_arena %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated
                            match selfhost_type_substitution_push_step build_steps type_id output_type_id SelfhostTypeSubstitutionStepKind::AppliedRebuilt arg_count:
                                Result::Ok next_steps:
                                    Result::Ok selfhost_type_substitution_node_result_new next_arena next_steps output_type_id
                                Result::Err e:
                                    selfhost_type_substitution_node_fail_after_step_table_consumed next_arena e
                        Result::Err e:
                            selfhost_type_substitution_node_fail_after_arena_builder_consumed build_steps SelfhostTypeSubstitutionErrorKind::AppliedRebuildFailed e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            selfhost_type_substitution_node_fail arena step_table e

//: selfhost_type_substitution_substitute_function_result: function type を child 置換後に[再構築/さいこうちく]する
fn selfhost_type_substitution_substitute_function_result %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn &SelfhostTypeSubstitutionBindingTable impure fn SelfhostTypeId impure fn SelfhostFunctionTypeRecord impure fn i32 Result SelfhostTypeSubstitutionNodeResult SelfhostTypeSubstitutionErrorKind \arena\step_table\bindings\type_id\function\fuel:
    let arg_count %i32 selfhost_function_type_arg_range_count function.args
    match selfhost_type_substitution_new_arg_vector_result:
        Result::Ok args:
            match selfhost_type_substitution_function_args_loop arena step_table bindings args type_id 0 arg_count fuel:
                Result::Ok build:
                    let build_arena %SelfhostTypeArena field::get build "arena"
                    let build_steps %SelfhostTypeSubstitutionStepTable field::get build "step_table"
                    let build_args %Vec SelfhostTypeId field::get build "args"
                    match selfhost_type_substitution_substitute_type_result build_arena build_steps bindings function.result fuel:
                        Result::Ok result_node:
                            let result_arena %SelfhostTypeArena field::get result_node "arena"
                            let result_steps %SelfhostTypeSubstitutionStepTable field::get result_node "step_table"
                            let output_result %SelfhostTypeId field::get result_node "output_type_id"
                            match selfhost_type_arena_add_function result_arena build_args output_result:
                                Result::Ok allocated:
                                    let output_type_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated
                                    let next_arena %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated
                                    match selfhost_type_substitution_push_step result_steps type_id output_type_id SelfhostTypeSubstitutionStepKind::FunctionRebuilt add arg_count 1:
                                        Result::Ok next_steps:
                                            Result::Ok selfhost_type_substitution_node_result_new next_arena next_steps output_type_id
                                        Result::Err e:
                                            selfhost_type_substitution_node_fail_after_step_table_consumed next_arena e
                                Result::Err e:
                                    selfhost_type_substitution_node_fail_after_arena_builder_consumed result_steps SelfhostTypeSubstitutionErrorKind::FunctionRebuildFailed e
                        Result::Err e:
                            v::free build_args
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            selfhost_type_substitution_node_fail arena step_table e

//: selfhost_type_substitution_evidence_new_result: output と step stream から accepted evidence を[作/つく]る
fn selfhost_type_substitution_evidence_new_result %fn &SelfhostTypeSubstitutionStepTable fn SelfhostTypeId fn SelfhostTypeId fn i32 Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind \step_table\root_type_id\output_type_id\binding_count:
    match selfhost_type_substitution_step_table_hash_result step_table:
        Result::Ok step_hash:
            if:
                eq step_hash 0
                then:
                    Result::Err SelfhostTypeSubstitutionErrorKind::StepStreamHashPlaceholder
                else:
                    Result::Ok SelfhostTypeSubstitutionEvidence selfhost_type_substitution_schema_version root_type_id output_type_id binding_count selfhost_type_substitution_step_table_len step_table step_hash
        Result::Err e:
            Result::Err e

//: selfhost_type_substitution_result_new: success result owner bundle を[作/つく]る
fn selfhost_type_substitution_result_new %impure fn SelfhostTypeArena impure fn SelfhostTypeSubstitutionStepTable impure fn SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionResult \arena\step_table\evidence:
    SelfhostTypeSubstitutionResult arena step_table evidence

//: selfhost_type_substitution_result: root TypeId を binding table に従って[置換/ちかん]する
//:
//: [契約/けいやく]:
//: - `arena` はこの関数が消費します。成功時は result owner に移り、失敗時はこの関数が閉じます。
//: - `bindings` は borrow で読みます。caller が所有権を持ち続け、不要になったら free します。
//: - success は actual `SelfhostTypeRecord` traversal と step stream を持ちますが、generic impl materializer acceptance ではありません。
pub fn selfhost_type_substitution_result %impure fn SelfhostTypeArena impure fn &SelfhostTypeSubstitutionBindingTable impure fn SelfhostTypeId Result SelfhostTypeSubstitutionResult SelfhostTypeSubstitutionErrorKind \arena\bindings\root_type_id:
