            match selfhost_type_substitution_stage0_duplicate_binding_table selfhost_type_id_new 1:
                Result::Ok duplicate_table:
                    let duplicate_binding %Result SelfhostTypeSubstitutionEvidence SelfhostTypeSubstitutionErrorKind selfhost_type_substitution_stage0_run_with_table duplicate_table selfhost_type_id_new 4
                    match selfhost_type_substitution_stage0_invalid_binding_table selfhost_type_id_new 1:
