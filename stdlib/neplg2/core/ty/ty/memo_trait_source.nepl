#indent 4

//: # ty/memo_trait_source
//: `MemoKey` / `MemoValue` の trusted trait source identity を proof store policy へ渡すための registry 境界です。
//:
//: [目的/もくてき]:
//: - `memo_trait_policy.nepl` は source identity の型を定義します。この module は、その型に載せる「現在の selfhost compiler が信頼する MemoKey / MemoValue trait definition」を 1 か所で作ります。
//: - proof store や producer がそれぞれ raw fingerprint を組み立てると、同じ意味の source identity が複数箇所へ散り、更新漏れや key/value 取り違えが起きます。この registry は source identity construction を `core/ty` の小さな authority に閉じます。
//: - 表示名、source path suffix、diagnostic message は accepted path の authority にしません。registry が返す値は typed source identity だけで、表示は後続 diagnostic layer が扱います。
//:
//: [契約/けいやく]:
//: - `SelfhostMemoTraitTrustedSourceRegistry` は `MemoKey` と `MemoValue` の source identity を両方持ちます。片方が欠けた registry は作りません。
//: - source identity は `SelfhostMemoTraitDefinitionSourceRecord` から materializer を通して作ります。expected kind と record kind が一致しない場合や、signature fingerprint が未確定の場合は `Result::Err` にします。
//: - `selfhost_memo_trait_trusted_source_registry_current_result` は、現 selfhost compiler が使う table-backed source identity registry を `Result` で返します。
//: - `selfhost_memo_trait_trusted_source_registry_sources` は proof store policy に渡す `SelfhostMemoTraitSourceIdentitySet` を返します。
//: - `selfhost_memo_trait_trusted_source_registry_is_current` は、registry が current source identity と一致するかを typed equality で確認します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では module / symbol / signature の fingerprint payload は事前に用意した i32 値です。ただし raw i32 を proof store 側へ散らさず、typed definition source table と materializer の境界に閉じています。
//: - これは source text や public surface hash を走査する full trait definition table ではありません。将来 `MemoKey` / `MemoValue` trait definition table が入ったら、この module の current table producer を stable trait definition key 由来の table へ置き換えます。その場合も proof store はこの registry から source set を受け取るだけで、source text を再読しません。
//:
//: [計算量/けいさんりょう]:
//: - current registry の構築、source materialization、source set projection、current 判定はすべて Copy payload の field 構築、variant match、または equality だけなので O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: ##: [9] ok
//: ##: [10] ok
//: ##: [11] ok
//: ##: [12] ok
//: ##: [13] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/ty/ty/memo_trait_source" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_trusted_source_registry_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check summary.memo_key_kind
//:     let checks2 checks_push checks1 check summary.memo_value_kind
//:     let checks3 checks_push checks2 check summary.source_set_matches
//:     let checks4 checks_push checks3 check summary.registry_is_current
//:     let checks5 checks_push checks4 check summary.memo_key_materialized
//:     let checks6 checks_push checks5 check summary.memo_value_materialized
//:     let checks7 checks_push checks6 check selfhost_memo_trait_source_materialize_error_kind_eq (unwrap_err summary.kind_mismatch_rejected) SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch
//:     let checks8 checks_push checks7 check selfhost_memo_trait_source_materialize_error_kind_eq (unwrap_err summary.signature_missing_rejected) SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing
//:     let checks9 checks_push checks8 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_missing_key_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing
//:     let checks10 checks_push checks9 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_missing_value_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing
//:     let checks11 checks_push checks10 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_duplicate_key_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate
//:     let checks12 checks_push checks11 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_duplicate_value_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate
//:     let checks13 checks_push checks12 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_key_source_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing
//:     let checks14 checks_push checks13 check selfhost_memo_trait_trusted_source_registry_error_kind_eq (unwrap_err summary.table_value_source_rejected) SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing
//:     let shown checks_print_report checks14
//:     checks_exit_code shown
//: ```

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./memo_trait_policy" as *

//: SelfhostMemoTraitDefinitionFingerprint: trait definition source の stable fingerprint payload
//:
//: [目的/もくてき]:
//: - module、symbol、signature の fingerprint を 1 つの typed payload にまとめます。
//: - raw i32 を proof store や registry 呼び出し側へ散らさず、source materializer の入力境界に閉じます。
//:
//: [契約/けいやく]:
//: - `module_hash` は trait definition を含む module identity の fingerprint です。
//: - `symbol_hash` は module 内の trait symbol identity の fingerprint です。
//: - `signature_hash` は public trait signature と bound contract の fingerprint です。
//: - この struct は表示名や path suffix を持ちません。表示は diagnostic layer の責務です。
pub struct SelfhostMemoTraitDefinitionFingerprint:
    module_hash %i32
    symbol_hash %i32
    signature_hash %i32

//: SelfhostMemoTraitDefinitionSourceRecord: materializer が読む trait definition source record
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` trait definition の source identity を作る前段として、kind と fingerprint と signature availability をまとめます。
//:
//: [契約/けいやく]:
//: - `kind` は record がどの trusted memo trait source から来たかを表します。
//: - `fingerprint` は source identity に入れる stable payload です。
//: - `signature_available = false` の record は、source text や public signature が未確定であるため materialize できません。
pub struct SelfhostMemoTraitDefinitionSourceRecord:
    kind %SelfhostMemoTraitSourceKind
    fingerprint %SelfhostMemoTraitDefinitionFingerprint
    signature_available %bool

//: SelfhostMemoTraitDefinitionSourceTable: trusted memo trait definition source record の小さな table
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` の current source record を、個別 helper 直結ではなく table selection 経由で registry に渡します。
//: - 欠落と重複を source identity materialization の前に typed error として分類し、proof store policy に不完全な source set が入らないようにします。
//:
//: [契約/けいやく]:
//: - `memo_key` は `SelfhostMemoTraitSourceKind::MemoKeyTrait` record が 1 件だけ見つかった場合に `some(record)` です。
//: - `memo_value` は `SelfhostMemoTraitSourceKind::MemoValueTrait` record が 1 件だけ見つかった場合に `some(record)` です。
//: - duplicate flag が true の場合、対応する source kind は複数 record を持つため registry へ進めません。
//:
//: [現状/げんじょう]:
//: - Phase 1 の current table は固定 2 件です。将来 full trait definition table に接続する場合も、この table payload へ投影してから同じ validator を通します。
//:
//: [計算量/けいさんりょう]:
//: - table は固定 2 slot なので、追加、検証、registry 変換はいずれも O(1) です。
pub struct SelfhostMemoTraitDefinitionSourceTable:
    memo_key %Option SelfhostMemoTraitDefinitionSourceRecord
    memo_value %Option SelfhostMemoTraitDefinitionSourceRecord
    duplicate_memo_key %bool
    duplicate_memo_value %bool

//: SelfhostMemoTraitSourceMaterializeErrorKind: source identity materialization の拒否理由
//:
//: [目的/もくてき]:
//: - source identity を作れない理由を bool や文字列へ潰さず、source policy と診断層が網羅的に扱える enum として保持します。
pub enum SelfhostMemoTraitSourceMaterializeErrorKind:
    KindMismatch
    SignatureMissing

//: SelfhostMemoTraitTrustedSourceRegistryErrorKind: current trusted registry 構築の拒否理由
//:
//: [目的/もくてき]:
//: - current registry の MemoKey 側と MemoValue 側のどちらの source materialization が壊れたかを区別します。
//: - registry current path が materializer の `Result` を捨てず、失敗原因を typed payload として保持できるようにします。
pub enum SelfhostMemoTraitTrustedSourceRegistryErrorKind:
    MemoKeyDefinitionMissing
    MemoValueDefinitionMissing
    MemoKeyDefinitionDuplicate
    MemoValueDefinitionDuplicate
    MemoKeySourceRejected %SelfhostMemoTraitSourceMaterializeErrorKind
    MemoValueSourceRejected %SelfhostMemoTraitSourceMaterializeErrorKind

//: SelfhostMemoTraitTrustedSourceRegistry: current memo trait source identity registry
//:
//: [目的/もくてき]:
//: - proof store policy が使う `MemoKey` / `MemoValue` source identity を、呼び出し側ごとの raw fingerprint construction から分離します。
//:
//: [契約/けいやく]:
//: - `memo_key` は `SelfhostMemoTraitSourceKind::MemoKeyTrait` の identity です。
//: - `memo_value` は `SelfhostMemoTraitSourceKind::MemoValueTrait` の identity です。
pub struct SelfhostMemoTraitTrustedSourceRegistry:
    memo_key %SelfhostMemoTraitSourceIdentity
    memo_value %SelfhostMemoTraitSourceIdentity

//: SelfhostMemoTraitTrustedSourceRegistryStage0Summary: registry smoke の[代表/だいひょう][結果/けっか]
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` の current source identity が、typed definition source record から materializer を通って作られていることを 1 つの値にまとめます。
//: - proof store が trusted source を raw constructor で作らず、registry / source set の境界だけを使っていることを doctest から確認しやすくします。
//:
//: [契約/けいやく]:
//: - `memo_key_kind` と `memo_value_kind` は、materialized identity の kind が期待する trait kind と一致した場合に `true` になります。
//: - `source_set_matches` は、registry から投影した source set が current helper の source set と一致した場合に `true` になります。
//: - `registry_is_current` は、registry snapshot が current compiler policy と一致した場合に `true` になります。
//: - `memo_key_materialized` と `memo_value_materialized` は、current prepared definition source record が materializer で `Ok` になったことを表します。
//: - `kind_mismatch_rejected` と `signature_missing_rejected` は、拒否 case を `Result::Err` として保持します。bool に潰さないことで、error enum の追加時に match の網羅性検査が効きます。
//: - `table_missing_key_rejected` と `table_missing_value_rejected` は、definition source table の欠落を registry validator が拒否した代表結果です。
//: - `table_duplicate_key_rejected` と `table_duplicate_value_rejected` は、definition source table の重複を registry validator が拒否した代表結果です。
//: - `table_key_source_rejected` と `table_value_source_rejected` は、table record は存在するが materializer が source identity 化を拒否した代表結果です。
//:
//: [現状/げんじょう]:
//: - 現在の summary は Stage 0 の smoke 用です。full trait definition table から stable source record を生成する段階では、同じ summary field を使い、入力だけを table-backed producer に置き換えます。
//:
//: [計算量/けいさんりょう]:
//: - field は固定個数で、summary の作成と比較は O(1) 時間・O(1) 追加空間です。
pub struct SelfhostMemoTraitTrustedSourceRegistryStage0Summary:
    memo_key_kind %bool
    memo_value_kind %bool
    source_set_matches %bool
    registry_is_current %bool
    memo_key_materialized %bool
    memo_value_materialized %bool
    kind_mismatch_rejected %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind
    signature_missing_rejected %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind
    table_missing_key_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind
    table_missing_value_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind
    table_duplicate_key_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind
    table_duplicate_value_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind
    table_key_source_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind
    table_value_source_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind

impl Clone for SelfhostMemoTraitDefinitionFingerprint:
    fn clone %fn &SelfhostMemoTraitDefinitionFingerprint SelfhostMemoTraitDefinitionFingerprint \self:
        *self

impl Copy for SelfhostMemoTraitDefinitionFingerprint:
    fn copy_mark %fn SelfhostMemoTraitDefinitionFingerprint SelfhostMemoTraitDefinitionFingerprint \self:
        self

impl Clone for SelfhostMemoTraitDefinitionSourceRecord:
    fn clone %fn &SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceRecord \self:
        *self

impl Copy for SelfhostMemoTraitDefinitionSourceRecord:
    fn copy_mark %fn SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceRecord \self:
        self

impl Clone for SelfhostMemoTraitDefinitionSourceTable:
    fn clone %fn &SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitDefinitionSourceTable \self:
        *self

impl Copy for SelfhostMemoTraitDefinitionSourceTable:
    fn copy_mark %fn SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitDefinitionSourceTable \self:
        self

impl Clone for SelfhostMemoTraitSourceMaterializeErrorKind:
    fn clone %fn &SelfhostMemoTraitSourceMaterializeErrorKind SelfhostMemoTraitSourceMaterializeErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitSourceMaterializeErrorKind:
    fn copy_mark %fn SelfhostMemoTraitSourceMaterializeErrorKind SelfhostMemoTraitSourceMaterializeErrorKind \self:
        self

impl Clone for SelfhostMemoTraitTrustedSourceRegistryErrorKind:
    fn clone %fn &SelfhostMemoTraitTrustedSourceRegistryErrorKind SelfhostMemoTraitTrustedSourceRegistryErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitTrustedSourceRegistryErrorKind:
    fn copy_mark %fn SelfhostMemoTraitTrustedSourceRegistryErrorKind SelfhostMemoTraitTrustedSourceRegistryErrorKind \self:
        self

impl Clone for SelfhostMemoTraitTrustedSourceRegistry:
    fn clone %fn &SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistry \self:
        *self

impl Copy for SelfhostMemoTraitTrustedSourceRegistry:
    fn copy_mark %fn SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistry \self:
        self

impl Clone for SelfhostMemoTraitTrustedSourceRegistryStage0Summary:
    fn clone %fn &SelfhostMemoTraitTrustedSourceRegistryStage0Summary SelfhostMemoTraitTrustedSourceRegistryStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitTrustedSourceRegistryStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitTrustedSourceRegistryStage0Summary SelfhostMemoTraitTrustedSourceRegistryStage0Summary \self:
        self

//: selfhost_memo_trait_definition_fingerprint_new: trait source fingerprint payload を[作/つく]る
//:
//: [目的/もくてき]:
//: - module / symbol / signature fingerprint をまとめ、materializer 呼び出し側が raw i32 の位置を取り違えないようにします。
//:
//: [契約/けいやく]:
//: - `module_hash` は trait definition を含む module identity を表します。
//: - `symbol_hash` は module 内の trait symbol identity を表します。
//: - `signature_hash` は public trait signature と bound contract を表します。
//: - この関数は fingerprint payload を構成するだけです。`MemoKey` / `MemoValue` の expected kind や signature availability の検査は `selfhost_memo_trait_source_identity_from_definition` が行います。
//:
//: [現状/げんじょう]:
//: - Stage 0 では i32 fingerprint を prepared value として使います。これは外部 diagnostic text や path suffix を authority にしないための typed payload であり、full trait definition table が入った後は stable nominal key / public surface hash 由来の値に置き換えます。
//:
//: [計算量/けいさんりょう]:
//: - field を 3 つ束ねるだけなので O(1) 時間・O(1) 追加空間です。
pub fn selfhost_memo_trait_definition_fingerprint_new %fn i32 fn i32 fn i32 SelfhostMemoTraitDefinitionFingerprint \module_hash\symbol_hash\signature_hash:
    SelfhostMemoTraitDefinitionFingerprint module_hash symbol_hash signature_hash

//: selfhost_memo_trait_definition_source_record_new: trait definition source record を[作/つく]る
//:
//: [目的/もくてき]:
//: - kind、fingerprint、signature availability を 1 つの materializer input にします。
//: - source identity を作る前の record と、検査済みの trusted source identity を分けることで、current registry path が検査を飛ばして raw identity を作る退行を防ぎます。
//:
//: [契約/けいやく]:
//: - この constructor は record を作るだけで、trusted source identity を受理しません。受理可否は `selfhost_memo_trait_source_identity_from_definition` が `Result` で返します。
//: - `kind` は caller が期待する source kind と一致する必要があります。一致しない場合、materializer は `KindMismatch` を返します。
//: - `signature_available` が `false` の record は、trait definition の public signature が source identity authority として確定していないため、materializer が `SignatureMissing` を返します。
//:
//: [現状/げんじょう]:
//: - Stage 0 では prepared current record をここで作ります。将来は parser / checker が作った trait definition table から、同じ record 型へ stable key と signature hash を materialize します。
//:
//: [計算量/けいさんりょう]:
//: - field を 3 つ束ねるだけなので O(1) 時間・O(1) 追加空間です。
pub fn selfhost_memo_trait_definition_source_record_new %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitDefinitionFingerprint fn bool SelfhostMemoTraitDefinitionSourceRecord \kind\fingerprint\signature_available:
    SelfhostMemoTraitDefinitionSourceRecord kind fingerprint signature_available

//: selfhost_memo_trait_definition_source_table_empty: trusted source definition table の空値を[作/つく]る
//:
//: [目的/もくてき]:
//: - current registry や将来の trait definition table materializer が、MemoKey / MemoValue record の欠落を `none` として表せる初期値を作ります。
//:
//: [契約/けいやく]:
//: - 空 table はまだ trusted registry ではありません。`selfhost_memo_trait_trusted_source_registry_from_definition_table` を通すと missing error になります。
//:
//: [計算量/けいさんりょう]:
//: - 固定 field を初期化するだけなので O(1) です。
pub fn selfhost_memo_trait_definition_source_table_empty %fn void SelfhostMemoTraitDefinitionSourceTable \void:
    SelfhostMemoTraitDefinitionSourceTable none none false false

//: selfhost_memo_trait_definition_source_table_with_key: MemoKey record を table に[入/い]れる
fn selfhost_memo_trait_definition_source_table_with_key %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceTable \table\record:
    match table.memo_key:
        Option::Some _existing:
            SelfhostMemoTraitDefinitionSourceTable table.memo_key table.memo_value true table.duplicate_memo_value
        Option::None:
            SelfhostMemoTraitDefinitionSourceTable (some record) table.memo_value table.duplicate_memo_key table.duplicate_memo_value

//: selfhost_memo_trait_definition_source_table_with_value: MemoValue record を table に[入/い]れる
fn selfhost_memo_trait_definition_source_table_with_value %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceTable \table\record:
    match table.memo_value:
        Option::Some _existing:
            SelfhostMemoTraitDefinitionSourceTable table.memo_key table.memo_value table.duplicate_memo_key true
        Option::None:
            SelfhostMemoTraitDefinitionSourceTable table.memo_key (some record) table.duplicate_memo_key table.duplicate_memo_value

//: selfhost_memo_trait_definition_source_table_add_record: source record を kind に従って table へ[追加/ついか]する
//:
//: [目的/もくてき]:
//: - trait definition table から得た record を、MemoKey / MemoValue の typed slot へ分類します。
//:
//: [契約/けいやく]:
//: - 同じ source kind を複数回追加した場合、既存 record は置き換えず duplicate flag だけを立てます。
//: - duplicate flag が立った table は registry materialization で fail-closed になります。
//:
//: [計算量/けいさんりょう]:
//: - source kind の match と固定 slot 更新だけなので O(1) です。
pub fn selfhost_memo_trait_definition_source_table_add_record %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceTable \table\record:
    match record.kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            selfhost_memo_trait_definition_source_table_with_key table record
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            selfhost_memo_trait_definition_source_table_with_value table record

//: selfhost_memo_trait_source_materialize_error_kind_eq: materializer error kind が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。error kind が増えた場合は equality を明示的に更新します。
pub fn selfhost_memo_trait_source_materialize_error_kind_eq %fn SelfhostMemoTraitSourceMaterializeErrorKind fn SelfhostMemoTraitSourceMaterializeErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch:
            match b:
                SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch:
                    true
                SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing:
                    false
        SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing:
            match b:
                SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch:
                    false
                SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing:
                    true

//: selfhost_memo_trait_source_materialize_error_kind_code: materializer error kind を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。error kind が増えた場合は code projection を明示的に更新します。
fn selfhost_memo_trait_source_materialize_error_kind_code %fn SelfhostMemoTraitSourceMaterializeErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch:
            1
        SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing:
            2

//: selfhost_memo_trait_trusted_source_registry_error_kind_eq: registry error kind が同じか[返/かえ]す
//:
//: [契約/けいやく]:
//: - MemoKey 側と MemoValue 側を混同しません。payload の materialize error kind も比較します。
//: - wildcard arm は使いません。registry error kind が増えた場合は match の網羅性検査で比較処理の更新漏れを検出します。
pub fn selfhost_memo_trait_trusted_source_registry_error_kind_eq %fn SelfhostMemoTraitTrustedSourceRegistryErrorKind fn SelfhostMemoTraitTrustedSourceRegistryErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    true
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected _b_error:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected _b_error:
                    false
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    true
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected _b_error:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected _b_error:
                    false
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    true
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected _b_error:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected _b_error:
                    false
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    true
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected _b_error:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected _b_error:
                    false
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected a_error:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected b_error:
                    selfhost_memo_trait_source_materialize_error_kind_eq a_error b_error
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected _b_error:
                    false
        SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected a_error:
            match b:
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected _b_error:
                    false
                SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected b_error:
                    selfhost_memo_trait_source_materialize_error_kind_eq a_error b_error

//: selfhost_memo_trait_source_identity_from_definition: trait definition record から source identity を[作/つく]る
//:
//: [目的/もくてき]:
//: - typed trait definition source record を、proof store policy が使う `SelfhostMemoTraitSourceIdentity` へ materialize します。
//:
//: [契約/けいやく]:
//: - `expected_kind` と `record.kind` が一致しない場合は `KindMismatch` を返します。
//: - `record.signature_available` が false の場合は、signature hash を authority にできないため `SignatureMissing` を返します。
//: - 成功時だけ、record 内の fingerprint payload を `SelfhostMemoTraitSourceIdentity` として意味づけます。
//:
//: [計算量/けいさんりょう]:
//: - kind equality と bool branch と field construction だけなので O(1) です。
pub fn selfhost_memo_trait_source_identity_from_definition %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitDefinitionSourceRecord Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind \expected_kind\record:
    if:
        selfhost_memo_trait_source_kind_eq expected_kind record.kind
        then:
            if:
                record.signature_available
                then:
                    Result::Ok selfhost_memo_trait_source_identity_new record.kind record.fingerprint.module_hash record.fingerprint.symbol_hash record.fingerprint.signature_hash
                else:
                    Result::Err SelfhostMemoTraitSourceMaterializeErrorKind::SignatureMissing
        else:
            Result::Err SelfhostMemoTraitSourceMaterializeErrorKind::KindMismatch

//: selfhost_memo_trait_trusted_memo_key_definition_source_current: current MemoKey definition record を[返/かえ]す
//:
//: [目的/もくてき]:
//: - 現 compiler が信頼する `MemoKey` trait source fingerprint を、current definition source table の 1 record として返します。
//:
//: [現状/げんじょう]:
//: - fingerprint payload は prepared value です。trait definition table が入ったら、この helper の入力だけを table 由来の stable definition key へ置き換えます。
fn selfhost_memo_trait_trusted_memo_key_definition_source_current %fn void SelfhostMemoTraitDefinitionSourceRecord \void:
    selfhost_memo_trait_definition_source_record_new:
        SelfhostMemoTraitSourceKind::MemoKeyTrait
        selfhost_memo_trait_definition_fingerprint_new 10 11 12
        true

//: selfhost_memo_trait_trusted_memo_value_definition_source_current: current MemoValue definition record を[返/かえ]す
//:
//: [目的/もくてき]:
//: - 現 compiler が信頼する `MemoValue` trait source fingerprint を、current definition source table の 1 record として返します。
//:
//: [現状/げんじょう]:
//: - fingerprint payload は prepared value です。trait definition table が入ったら、この helper の入力だけを table 由来の stable definition key へ置き換えます。
fn selfhost_memo_trait_trusted_memo_value_definition_source_current %fn void SelfhostMemoTraitDefinitionSourceRecord \void:
    selfhost_memo_trait_definition_source_record_new:
        SelfhostMemoTraitSourceKind::MemoValueTrait
        selfhost_memo_trait_definition_fingerprint_new 20 21 22
        true

//: selfhost_memo_trait_definition_source_table_current: current MemoKey / MemoValue definition table を[作/つく]る
//:
//: [目的/もくてき]:
//: - current registry が個別 prepared record helper へ直結せず、definition table の欠落・重複検査を通るようにします。
//:
//: [契約/けいやく]:
//: - Phase 1 では固定 2 record の table です。
//: - 将来 full trait definition table を導入する場合は、この関数が parser / checker 由来の stable trait definition record table を返すように置き換わります。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 record を追加するだけなので O(1) です。
fn selfhost_memo_trait_definition_source_table_current %fn void SelfhostMemoTraitDefinitionSourceTable \void:
    let table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record table0 selfhost_memo_trait_trusted_memo_key_definition_source_current
    selfhost_memo_trait_definition_source_table_add_record table1 selfhost_memo_trait_trusted_memo_value_definition_source_current

//: selfhost_memo_trait_trusted_source_registry_new: trusted source registry を[作/つく]る
//:
//: [目的/もくてき]:
//: - current registry constructor だけが使う private helper です。外部 API から同じ型の `MemoKey` / `MemoValue` identity を入れ替えた trusted registry を作れないように、公開しません。
//: - 将来、外部 artifact から registry snapshot を読み込む場合は、この helper を公開するのではなく、kind mismatch を `Result` で拒否する validator を別に用意します。
fn selfhost_memo_trait_trusted_source_registry_new %fn SelfhostMemoTraitSourceIdentity fn SelfhostMemoTraitSourceIdentity SelfhostMemoTraitTrustedSourceRegistry \memo_key\memo_value:
    SelfhostMemoTraitTrustedSourceRegistry memo_key memo_value

//: selfhost_memo_trait_trusted_memo_key_source_identity_current_result: current MemoKey source identity materializer smoke を Result で[返/かえ]す
//:
//: [目的/もくてき]:
//: - current MemoKey definition record を materializer へ通し、Stage 0 smoke が kind mismatch や signature missing の扱いを確認できるようにします。
//:
//: [契約/けいやく]:
//: - この helper は公開しません。proof store policy 用 source set は、欠落・重複検査を持つ `selfhost_memo_trait_trusted_source_registry_current_result` からだけ取得します。
fn selfhost_memo_trait_trusted_memo_key_source_identity_current_result %fn void Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind \void:
    selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoKeyTrait selfhost_memo_trait_trusted_memo_key_definition_source_current

//: selfhost_memo_trait_trusted_memo_value_source_identity_current_result: current MemoValue source identity materializer smoke を Result で[返/かえ]す
//:
//: [目的/もくてき]:
//: - current MemoValue definition record を materializer へ通し、Stage 0 smoke が kind mismatch や signature missing の扱いを確認できるようにします。
//:
//: [契約/けいやく]:
//: - この helper は公開しません。proof store policy 用 source set は、欠落・重複検査を持つ `selfhost_memo_trait_trusted_source_registry_current_result` からだけ取得します。
fn selfhost_memo_trait_trusted_memo_value_source_identity_current_result %fn void Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind \void:
    selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoValueTrait selfhost_memo_trait_trusted_memo_value_definition_source_current

//: selfhost_memo_trait_trusted_source_registry_from_definition_records: 検出済み record から trusted registry を[作/つく]る
fn selfhost_memo_trait_trusted_source_registry_from_definition_records %fn SelfhostMemoTraitDefinitionSourceRecord fn SelfhostMemoTraitDefinitionSourceRecord Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind \key_record\value_record:
    match selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoKeyTrait key_record:
        Result::Ok memo_key:
            match selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoValueTrait value_record:
                Result::Ok memo_value:
                    Result::Ok selfhost_memo_trait_trusted_source_registry_new memo_key memo_value
                Result::Err value_error:
                    Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueSourceRejected value_error
        Result::Err key_error:
            Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeySourceRejected key_error

//: selfhost_memo_trait_trusted_source_registry_from_definition_table: definition table から trusted registry を[作/つく]る
//:
//: [目的/もくてき]:
//: - table-backed producer が集めた MemoKey / MemoValue definition source record を検証し、proof store policy 用 registry に materialize します。
//:
//: [契約/けいやく]:
//: - MemoKey record が無い場合は `MemoKeyDefinitionMissing` です。
//: - MemoValue record が無い場合は `MemoValueDefinitionMissing` です。
//: - 同じ kind が複数見つかった場合は duplicate error です。最初の record を黙って採用してはいけません。
//: - record の expected kind や signature availability は `selfhost_memo_trait_source_identity_from_definition` が検査し、対応する source rejected error へ写します。
//: - 複数の異常が同時にある場合は、duplicate を欠落や source rejected より先に拒否し、MemoKey 側の duplicate を MemoValue 側の duplicate より先に返します。
//:
//: [計算量/けいさんりょう]:
//: - 固定 slot と 2 件の materialization だけなので O(1) です。
pub fn selfhost_memo_trait_trusted_source_registry_from_definition_table %fn SelfhostMemoTraitDefinitionSourceTable Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind \table:
    if:
        table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionDuplicate
        else:
            if:
                table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionDuplicate
                else:
                    match table.memo_key:
                        Option::Some key_record:
                            match table.memo_value:
                                Option::Some value_record:
                                    selfhost_memo_trait_trusted_source_registry_from_definition_records key_record value_record
                                Option::None:
                                    Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoValueDefinitionMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitTrustedSourceRegistryErrorKind::MemoKeyDefinitionMissing

//: selfhost_memo_trait_trusted_source_registry_current_result: current MemoKey / MemoValue source registry を Result で[返/かえ]す
//:
//: [目的/もくてき]:
//: - current definition source table を作り、欠落・重複・materialization failure を typed registry error として返します。
//:
//: [契約/けいやく]:
//: - proof store はこの API から current source set を取得し、source record や raw fingerprint を直接組み立てません。
pub fn selfhost_memo_trait_trusted_source_registry_current_result %fn void Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind \void:
    selfhost_memo_trait_trusted_source_registry_from_definition_table selfhost_memo_trait_definition_source_table_current

//: selfhost_memo_trait_trusted_source_registry_sources: registry から proof policy 用 source set を[作/つく]る
//:
//: [目的/もくてき]:
//: - `SelfhostMemoTraitProofStorePolicy` に渡す source identity set を registry field から投影します。
pub fn selfhost_memo_trait_trusted_source_registry_sources %fn &SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitSourceIdentitySet \registry:
    selfhost_memo_trait_source_identity_set_new *field::get_ref registry "memo_key" *field::get_ref registry "memo_value"

//: selfhost_memo_trait_trusted_source_identity_set_current_result: current source identity set を Result で[返/かえ]す
//:
//: [目的/もくてき]:
//: - proof store など fail-closed に進みたい caller が、current registry construction error を握りつぶさず扱えるようにします。
pub fn selfhost_memo_trait_trusted_source_identity_set_current_result %fn void Result SelfhostMemoTraitSourceIdentitySet SelfhostMemoTraitTrustedSourceRegistryErrorKind \void:
    match selfhost_memo_trait_trusted_source_registry_current_result:
        Result::Ok registry:
            Result::Ok selfhost_memo_trait_trusted_source_registry_sources &registry
        Result::Err error:
            Result::Err error

//: selfhost_memo_trait_trusted_source_registry_is_current: registry が current source identity と一致するか[返/かえ]す
//:
//: [目的/もくてき]:
//: - prepared artifact が持つ registry snapshot を、current compiler policy と照合するための小さい helper です。
pub fn selfhost_memo_trait_trusted_source_registry_is_current %fn &SelfhostMemoTraitTrustedSourceRegistry bool \registry:
    match selfhost_memo_trait_trusted_source_identity_set_current_result:
        Result::Ok current_sources:
            selfhost_memo_trait_source_identity_set_eq:
                selfhost_memo_trait_trusted_source_registry_sources registry
                current_sources
        Result::Err _error:
            false

//: selfhost_memo_trait_trusted_source_registry_stage0_summary_new: registry smoke summary を[作/つく]る
fn selfhost_memo_trait_trusted_source_registry_stage0_summary_new %fn bool fn bool fn bool fn bool fn bool fn bool fn Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind fn Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind SelfhostMemoTraitTrustedSourceRegistryStage0Summary \memo_key_kind\memo_value_kind\source_set_matches\registry_is_current\memo_key_materialized\memo_value_materialized\kind_mismatch_rejected\signature_missing_rejected\table_missing_key_rejected\table_missing_value_rejected\table_duplicate_key_rejected\table_duplicate_value_rejected\table_key_source_rejected\table_value_source_rejected:
    SelfhostMemoTraitTrustedSourceRegistryStage0Summary memo_key_kind memo_value_kind source_set_matches registry_is_current memo_key_materialized memo_value_materialized kind_mismatch_rejected signature_missing_rejected table_missing_key_rejected table_missing_value_rejected table_duplicate_key_rejected table_duplicate_value_rejected table_key_source_rejected table_value_source_rejected

//: selfhost_memo_trait_trusted_source_registry_stage0: current registry の代表検査を[返/かえ]す
//:
//: [目的/もくてき]:
//: - current registry が MemoKey / MemoValue の kind を取り違えず、source set projection と current 判定が typed equality を通ることを確認します。
//: - materializer が expected kind mismatch と signature missing を成功扱いしないことも同じ smoke に載せます。
pub fn selfhost_memo_trait_trusted_source_registry_stage0 %fn void SelfhostMemoTraitTrustedSourceRegistryStage0Summary \void:
    let key_record %SelfhostMemoTraitDefinitionSourceRecord selfhost_memo_trait_trusted_memo_key_definition_source_current
    let value_record %SelfhostMemoTraitDefinitionSourceRecord selfhost_memo_trait_trusted_memo_value_definition_source_current
    let missing_signature_record %SelfhostMemoTraitDefinitionSourceRecord:
        selfhost_memo_trait_definition_source_record_new:
            SelfhostMemoTraitSourceKind::MemoKeyTrait
            selfhost_memo_trait_definition_fingerprint_new 10 11 12
            false
    let missing_value_signature_record %SelfhostMemoTraitDefinitionSourceRecord:
        selfhost_memo_trait_definition_source_record_new:
            SelfhostMemoTraitSourceKind::MemoValueTrait
            selfhost_memo_trait_definition_fingerprint_new 20 21 22
            false
    let materialized_key %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoKeyTrait key_record
    let materialized_value %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoValueTrait value_record
    let kind_mismatch_rejected %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoValueTrait key_record
    let signature_missing_rejected %Result SelfhostMemoTraitSourceIdentity SelfhostMemoTraitSourceMaterializeErrorKind selfhost_memo_trait_source_identity_from_definition SelfhostMemoTraitSourceKind::MemoKeyTrait missing_signature_record
    let missing_key_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let missing_key_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record missing_key_table0 value_record
    let missing_value_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let missing_value_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record missing_value_table0 key_record
    let duplicate_key_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let duplicate_key_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_key_table0 key_record
    let duplicate_key_table2 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_key_table1 key_record
    let duplicate_value_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let duplicate_value_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_value_table0 value_record
    let duplicate_value_table2 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_value_table1 value_record
    let key_source_rejected_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let key_source_rejected_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record key_source_rejected_table0 missing_signature_record
    let key_source_rejected_table2 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record key_source_rejected_table1 value_record
    let value_source_rejected_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let value_source_rejected_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record value_source_rejected_table0 key_record
    let value_source_rejected_table2 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record value_source_rejected_table1 missing_value_signature_record
    let table_missing_key_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table missing_key_table1
    let table_missing_value_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table missing_value_table1
    let table_duplicate_key_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table duplicate_key_table2
    let table_duplicate_value_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table duplicate_value_table2
    let table_key_source_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table key_source_rejected_table2
    let table_value_source_rejected %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitTrustedSourceRegistryErrorKind selfhost_memo_trait_trusted_source_registry_from_definition_table value_source_rejected_table2
    match selfhost_memo_trait_trusted_source_registry_current_result:
