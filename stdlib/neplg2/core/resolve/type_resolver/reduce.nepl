#indent 4

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "./constructor" as *
#import "./input" as *
#import "./resolved" as *
#import "./typeparam" as *
#import "./reduce/model" as *
#import "./reduce/plan" as *
#import "./reduce/build" as *

//: SelfhostTypeReduceGenericArgBuild: generic application 引数列を縮約した途中結果
//:
//: [目的/もくてき]:
//: - constructor arity に従って読んだ型引数 node id と、そこまで進んだ build state / next index を一緒に運びます。
//: - owner を含むため、この構造は constructor-aware reducer 内部の一時 payload としてだけ使います。
struct SelfhostTypeReduceGenericArgBuild:
    state %SelfhostTypeReduceBuildState
    params %Vec SelfhostResolvedTypeNodeId
    next_index %i32

fn selfhost_type_reduce_generic_arg_build_new %impure fn SelfhostTypeReduceBuildState impure fn Vec SelfhostResolvedTypeNodeId impure fn i32 SelfhostTypeReduceGenericArgBuild \state\params\next_index:
    SelfhostTypeReduceGenericArgBuild state params next_index

fn selfhost_type_reduce_generic_arg_build_fail %impure fn SelfhostTypeReduceBuildState impure fn Vec SelfhostResolvedTypeNodeId impure fn SelfhostTypeReduceErrorKind impure fn SelfhostSourceSpan Result SelfhostTypeReduceGenericArgBuild SelfhostTypeReduceError \state\params\kind\span:
    selfhost_type_reduce_build_state_free state
    v::free params
    Result::Err selfhost_type_reduce_error_new kind span

fn selfhost_type_reduce_generic_arg_push %impure fn SelfhostTypeReduceBuildState impure fn Vec SelfhostResolvedTypeNodeId impure fn SelfhostResolvedTypeNodeId impure fn i32 impure fn SelfhostSourceSpan Result SelfhostTypeReduceGenericArgBuild SelfhostTypeReduceError \state\params\node_id\next_index\span:
    match v::push params node_id:
        Result::Ok next_params:
            Result::Ok selfhost_type_reduce_generic_arg_build_new state next_params next_index
        Result::Err e:
            v::free v::vec_push_error_vec e
            selfhost_type_reduce_build_state_free state
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory span

fn selfhost_type_reduce_push_node_with_state %impure fn SelfhostTypeReduceBuildState impure fn SelfhostResolvedTypeNode impure fn SelfhostSourceSpan impure fn i32 Result SelfhostTypeReduceStep SelfhostTypeReduceError \state\node\span\next_index:
    let node_id %SelfhostResolvedTypeNodeId selfhost_resolved_type_node_id_new selfhost_type_reduce_build_state_node_len &state
    let nodes %Vec SelfhostResolvedTypeNode field::get state "nodes"
    let function_args %Vec SelfhostResolvedTypeNodeId field::get state "function_args"
    let type_args %Vec SelfhostResolvedTypeNodeId field::get state "type_args"
    match v::push nodes node:
        Result::Ok next_nodes:
            Result::Ok selfhost_type_reduce_step_new (selfhost_type_reduce_build_state_new next_nodes function_args type_args) node_id next_index
        Result::Err e:
            v::free v::vec_push_error_vec e
            v::free function_args
            v::free type_args
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory span

fn selfhost_type_reduce_copy_applied_args %impure fn Vec SelfhostResolvedTypeNodeId impure fn &Vec SelfhostResolvedTypeNodeId impure fn i32 impure fn i32 Result Vec SelfhostResolvedTypeNodeId StdErrorKind \out\params\n\idx:
    if:
        ge idx n
        then:
            Result::Ok out
        else:
            match v::get params idx:
                Option::Some node_id:
                    match v::push out node_id:
                        Result::Ok next_out:
                            selfhost_type_reduce_copy_applied_args next_out params n add idx 1
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err error
                Option::None:
                    v::free out
                    Result::Err StdErrorKind::IndexOutOfBounds

fn selfhost_type_reduce_add_applied_named_from_params %impure fn SelfhostTypeReduceBuildState impure fn SelfhostNamedTypeId impure fn SelfhostSourceSpan impure fn Vec SelfhostResolvedTypeNodeId impure fn i32 Result SelfhostTypeReduceStep SelfhostTypeReduceError \state\nominal_id\span\params\next_index:
    let first_arg %i32 selfhost_type_reduce_build_state_type_arg_len &state
    let arg_count %i32 v::len &params
    if:
        le arg_count 0
        then:
            selfhost_type_reduce_build_state_free state
            v::free params
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::InternalInvariant span
        else:
            let nodes %Vec SelfhostResolvedTypeNode field::get state "nodes"
            let function_args %Vec SelfhostResolvedTypeNodeId field::get state "function_args"
            let type_args %Vec SelfhostResolvedTypeNodeId field::get state "type_args"
            match selfhost_type_reduce_copy_applied_args type_args &params arg_count 0:
                Result::Ok next_type_args:
                    v::free params
                    let args %SelfhostResolvedAppliedTypeArgRange selfhost_resolved_applied_type_arg_range_new_unchecked first_arg arg_count
                    let applied %SelfhostResolvedAppliedType SelfhostResolvedAppliedType nominal_id span args
                    selfhost_type_reduce_push_node_with_state (selfhost_type_reduce_build_state_new nodes function_args next_type_args) (SelfhostResolvedTypeNode::Applied applied) span next_index
                Result::Err _e:
                    v::free nodes
                    v::free function_args
                    v::free params
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory span

fn selfhost_type_prefix_list_validate_generic_args_loop %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeReducePlan fn i32 fn i32 fn SelfhostSourceSpan Result i32 SelfhostTypeReduceError \source\constructors\plan\idx\remaining\span:
    if:
        le remaining 0
        then:
            Result::Ok idx
        else:
            let n %i32 selfhost_type_reduce_plan_len plan
            if:
                ge idx n
                then:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::GenericTypeArgumentMissing span
                else:
                    match selfhost_type_prefix_list_validate_at_with_constructors source constructors plan idx:
                        Result::Ok next_idx:
                            selfhost_type_prefix_list_validate_generic_args_loop source constructors plan next_idx sub remaining 1 span
                        Result::Err e:
                            Result::Err e

fn selfhost_type_prefix_list_validate_named_with_constructors %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeReducePlan fn SelfhostTypeReducePlanItem fn i32 Result i32 SelfhostTypeReduceError \source\constructors\plan\item\idx:
    match selfhost_type_constructor_table_find_span constructors source item.span:
        Option::Some constructor:
            if:
                lt constructor.arity 0
                then:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::InternalInvariant item.span
                else:
                    if:
                        eq constructor.arity 0
                        then:
                            Result::Ok add idx 1
                        else:
                            selfhost_type_prefix_list_validate_generic_args_loop source constructors plan add idx 1 constructor.arity item.span
        Option::None:
            Result::Ok add idx 1

fn selfhost_type_prefix_list_validate_function_nonvoid_arg_with_constructors %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeReducePlan fn i32 fn SelfhostSourceSpan Result i32 SelfhostTypeReduceError \source\constructors\plan\arg_idx\fn_span:
    let n %i32 selfhost_type_reduce_plan_len plan
    match selfhost_type_prefix_list_validate_at_with_constructors source constructors plan arg_idx:
        Result::Ok result_idx:
            if:
                ge result_idx n
                then:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingResult fn_span
                else:
                    selfhost_type_prefix_list_validate_at_with_constructors source constructors plan result_idx
        Result::Err e:
            Result::Err e

fn selfhost_type_prefix_list_validate_function_with_constructors %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeReducePlan fn SelfhostSourceSpan fn i32 Result i32 SelfhostTypeReduceError \source\constructors\plan\fn_span\idx:
    let n %i32 selfhost_type_reduce_plan_len plan
    let arg_idx %i32 add idx 1
    if:
        ge arg_idx n
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span
        else:
            match selfhost_type_reduce_plan_get plan arg_idx:
                Option::Some arg_item:
                    if:
                        arg_item.is_void
                        then:
                            let result_idx %i32 add idx 2
                            if:
                                ge result_idx n
                                then:
                                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingResult fn_span
                                else:
                                    selfhost_type_prefix_list_validate_at_with_constructors source constructors plan result_idx
                        else:
                            selfhost_type_prefix_list_validate_function_nonvoid_arg_with_constructors source constructors plan arg_idx fn_span
                Option::None:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span

pub fn selfhost_type_prefix_list_validate_at_with_constructors %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeReducePlan fn i32 Result i32 SelfhostTypeReduceError \source\constructors\plan\idx:
    let n %i32 selfhost_type_reduce_plan_len plan
    if:
        ge idx n
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span
        else:
            match selfhost_type_reduce_plan_get plan idx:
                Option::Some item:
                    let span %SelfhostSourceSpan item.span
                    let dispatch_kind %SelfhostTypeReduceDispatchKind item.dispatch_kind
                    if:
                        item.is_function
                        then:
                            selfhost_type_prefix_list_validate_function_with_constructors source constructors plan span idx
                        else if:
                            item.is_primitive
                            then:
                                Result::Ok add idx 1
                            else if:
                                item.is_named
                                then:
                                    selfhost_type_prefix_list_validate_named_with_constructors source constructors plan item idx
                                else:
                                    Result::Err selfhost_type_reduce_error_new (selfhost_type_reduce_dispatch_kind_error dispatch_kind) span
                Option::None:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span

fn selfhost_type_prefix_list_build_generic_args_loop %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeReducePlan impure fn i32 impure fn i32 impure fn SelfhostTypeReduceBuildState impure fn Vec SelfhostResolvedTypeNodeId impure fn SelfhostSourceSpan Result SelfhostTypeReduceGenericArgBuild SelfhostTypeReduceError \source\constructors\plan\idx\remaining\state\params\span:
    if:
        le remaining 0
        then:
            Result::Ok selfhost_type_reduce_generic_arg_build_new state params idx
        else:
            let n %i32 selfhost_type_reduce_plan_len plan
            if:
                ge idx n
                then:
                    selfhost_type_reduce_generic_arg_build_fail state params SelfhostTypeReduceErrorKind::GenericTypeArgumentMissing span
                else:
                    match selfhost_type_prefix_list_build_at_with_constructors source constructors plan idx state:
                        Result::Ok arg_step:
                            let arg_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &arg_step
                            let next_idx %i32 selfhost_type_reduce_step_next_index &arg_step
                            let next_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state arg_step
                            match selfhost_type_reduce_generic_arg_push next_state params arg_id next_idx span:
                                Result::Ok pushed:
                                    let loop_state %SelfhostTypeReduceBuildState field::get pushed "state"
                                    let loop_params %Vec SelfhostResolvedTypeNodeId field::get pushed "params"
                                    let loop_idx %i32 field::get pushed "next_index"
                                    selfhost_type_prefix_list_build_generic_args_loop source constructors plan loop_idx sub remaining 1 loop_state loop_params span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            v::free params
                            Result::Err e

fn selfhost_type_prefix_list_build_named_with_constructors %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeReducePlan impure fn SelfhostTypeReducePlanItem impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\plan\item\idx\state:
    match selfhost_type_constructor_table_find_span constructors source item.span:
        Option::Some constructor:
            if:
                lt constructor.arity 0
                then:
                    selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::InternalInvariant item.span
                else:
                    if:
                        eq constructor.arity 0
                        then:
                            let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Named SelfhostResolvedNamedTypeRef item.span
                            selfhost_type_reduce_push_node_with_state state node item.span add idx 1
                        else:
                            let params_result %Result Vec SelfhostResolvedTypeNodeId StdErrorKind v::new
                            match params_result:
                                Result::Ok params:
                                    match selfhost_type_prefix_list_build_generic_args_loop source constructors plan add idx 1 constructor.arity state params item.span:
                                        Result::Ok arg_build:
                                            let next_state %SelfhostTypeReduceBuildState field::get arg_build "state"
                                            let applied_params %Vec SelfhostResolvedTypeNodeId field::get arg_build "params"
                                            let next_idx %i32 field::get arg_build "next_index"
                                            selfhost_type_reduce_add_applied_named_from_params next_state constructor.nominal_id item.span applied_params next_idx
                                        Result::Err e:
                                            Result::Err e
                                Result::Err _e:
                                    selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::OutOfMemory item.span
        Option::None:
            let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Named SelfhostResolvedNamedTypeRef item.span
            selfhost_type_reduce_push_node_with_state state node item.span add idx 1

pub fn selfhost_type_prefix_list_build_at_with_constructors %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeReducePlan impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\plan\idx\state:
    match selfhost_type_reduce_plan_get plan idx:
        Option::Some item:
            let span %SelfhostSourceSpan item.span
            let dispatch_kind %SelfhostTypeReduceDispatchKind item.dispatch_kind
            if:
                item.is_function
                then:
                    selfhost_type_prefix_list_build_function_with_constructors source constructors plan span idx state
                else if:
                    item.is_primitive
                    then:
                        let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Primitive item.primitive
                        selfhost_type_reduce_push_node_with_state state node span add idx 1
                    else if:
                        item.is_named
                        then:
                            selfhost_type_prefix_list_build_named_with_constructors source constructors plan item idx state
                        else:
                            selfhost_type_reduce_fail state (selfhost_type_reduce_dispatch_kind_error dispatch_kind) span
        Option::None:
            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span

fn selfhost_type_prefix_list_build_function_nonvoid_arg_with_constructors %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeReducePlan impure fn i32 impure fn SelfhostSourceSpan impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\plan\arg_idx\fn_span\state:
    match selfhost_type_prefix_list_build_at_with_constructors source constructors plan arg_idx state:
        Result::Ok param_step:
            let param_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &param_step
            let result_idx %i32 selfhost_type_reduce_step_next_index &param_step
            let param_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state param_step
            match selfhost_type_prefix_list_build_at_with_constructors source constructors plan result_idx param_state:
                Result::Ok result_step:
                    let result_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &result_step
                    let next_index %i32 selfhost_type_reduce_step_next_index &result_step
                    let result_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state result_step
                    selfhost_type_reduce_add_function_nonempty_params result_state param_id result_id fn_span next_index
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

fn selfhost_type_prefix_list_build_function_with_constructors %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeReducePlan impure fn SelfhostSourceSpan impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\plan\fn_span\idx\state:
    let arg_idx %i32 add idx 1
    match selfhost_type_reduce_plan_get plan arg_idx:
        Option::Some arg_item:
            if:
                arg_item.is_void
                then:
                    let result_idx %i32 add idx 2
                    match selfhost_type_prefix_list_build_at_with_constructors source constructors plan result_idx state:
                        Result::Ok result_step:
                            let result_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &result_step
                            let next_index %i32 selfhost_type_reduce_step_next_index &result_step
                            let next_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state result_step
                            selfhost_type_reduce_add_function_empty_params next_state result_id fn_span next_index
                        Result::Err e:
                            Result::Err e
                else:
                    selfhost_type_prefix_list_build_function_nonvoid_arg_with_constructors source constructors plan arg_idx fn_span state
        Option::None:
            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span

//: selfhost_type_prefix_list_validate_named_with_constructors_and_type_parameters: named item の constructor / parameter 境界を[検証/けんしょう]する
//:
//: [目的/もくてき]:
//: - `T` が type parameter environment にあるとき、constructor-aware validation がそれを generic constructor として余分な型引数を消費しないようにします。
//: - 同じ名前が constructor table と type parameter environment の両方にある場合は、曖昧さを typed error として先に固定します。
//:
//: [場合分/ばあいわ]け:
//: - parameter だけがある場合は 1 item を消費します。
//: - parameter と constructor が両方ある場合は `TypeParameterConstructorNameConflict` です。
//: - parameter がない場合は既存の constructor-aware named validation へ委譲します。
//:
//: [計算量/けいさんりょう]:
//: - lookup は `O(c + p)` です。`c` は constructor 数、`p` は type parameter 数です。
fn selfhost_type_prefix_list_validate_named_with_constructors_and_type_parameters %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeParameterEnv fn &SelfhostTypeReducePlan fn SelfhostTypeReducePlanItem fn i32 Result i32 SelfhostTypeReduceError \source\constructors\type_parameters\plan\item\idx:
    match selfhost_type_parameter_env_find_span type_parameters source item.span:
        Option::Some _parameter:
            match selfhost_type_constructor_table_find_span constructors source item.span:
                Option::Some _constructor:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TypeParameterConstructorNameConflict item.span
                Option::None:
                    Result::Ok add idx 1
        Option::None:
            selfhost_type_prefix_list_validate_named_with_constructors source constructors plan item idx

fn selfhost_type_prefix_list_validate_function_nonvoid_arg_with_constructors_and_type_parameters %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeParameterEnv fn &SelfhostTypeReducePlan fn i32 fn SelfhostSourceSpan Result i32 SelfhostTypeReduceError \source\constructors\type_parameters\plan\arg_idx\fn_span:
    let n %i32 selfhost_type_reduce_plan_len plan
    match selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters source constructors type_parameters plan arg_idx:
        Result::Ok result_idx:
            if:
                ge result_idx n
                then:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingResult fn_span
                else:
                    selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters source constructors type_parameters plan result_idx
        Result::Err e:
            Result::Err e

fn selfhost_type_prefix_list_validate_function_with_constructors_and_type_parameters %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeParameterEnv fn &SelfhostTypeReducePlan fn SelfhostSourceSpan fn i32 Result i32 SelfhostTypeReduceError \source\constructors\type_parameters\plan\fn_span\idx:
    let n %i32 selfhost_type_reduce_plan_len plan
    let arg_idx %i32 add idx 1
    if:
        ge arg_idx n
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span
        else:
            match selfhost_type_reduce_plan_get plan arg_idx:
                Option::Some arg_item:
                    if:
                        arg_item.is_void
                        then:
                            let result_idx %i32 add idx 2
                            if:
                                ge result_idx n
                                then:
                                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingResult fn_span
                                else:
                                    selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters source constructors type_parameters plan result_idx
                        else:
                            selfhost_type_prefix_list_validate_function_nonvoid_arg_with_constructors_and_type_parameters source constructors type_parameters plan arg_idx fn_span
                Option::None:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span

//: selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters: constructor と parameter を使って 1 型式の消費範囲を[検証/けんしょう]する
//:
//: [目的/もくてき]:
//: - build 前に prefix list の境界を決め、同じ入力で build が同じ消費範囲を辿れることを確認します。
//:
//: [契約/けいやく]:
//: - 成功時は `idx` から始まる 1 つの型式を消費した次 index を返します。
//: - 失敗時は source span 付きの `SelfhostTypeReduceError` を返し、owner を持つ値は消費しません。
pub fn selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters %fn &str fn &SelfhostTypeConstructorTable fn &SelfhostTypeParameterEnv fn &SelfhostTypeReducePlan fn i32 Result i32 SelfhostTypeReduceError \source\constructors\type_parameters\plan\idx:
    let n %i32 selfhost_type_reduce_plan_len plan
    if:
        ge idx n
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span
        else:
            match selfhost_type_reduce_plan_get plan idx:
                Option::Some item:
                    let span %SelfhostSourceSpan item.span
                    let dispatch_kind %SelfhostTypeReduceDispatchKind item.dispatch_kind
                    if:
                        item.is_function
                        then:
                            selfhost_type_prefix_list_validate_function_with_constructors_and_type_parameters source constructors type_parameters plan span idx
                        else if:
                            item.is_primitive
                            then:
                                Result::Ok add idx 1
                            else if:
                                item.is_named
                                then:
                                    selfhost_type_prefix_list_validate_named_with_constructors_and_type_parameters source constructors type_parameters plan item idx
                                else:
                                    Result::Err selfhost_type_reduce_error_new (selfhost_type_reduce_dispatch_kind_error dispatch_kind) span
                Option::None:
                    Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span

fn selfhost_type_prefix_list_build_generic_args_loop_with_constructors_and_type_parameters %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypeReducePlan impure fn i32 impure fn i32 impure fn SelfhostTypeReduceBuildState impure fn Vec SelfhostResolvedTypeNodeId impure fn SelfhostSourceSpan Result SelfhostTypeReduceGenericArgBuild SelfhostTypeReduceError \source\constructors\type_parameters\plan\idx\remaining\state\params\span:
    if:
        le remaining 0
        then:
            Result::Ok selfhost_type_reduce_generic_arg_build_new state params idx
        else:
            let n %i32 selfhost_type_reduce_plan_len plan
            if:
                ge idx n
                then:
                    selfhost_type_reduce_generic_arg_build_fail state params SelfhostTypeReduceErrorKind::GenericTypeArgumentMissing span
                else:
                    match selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters source constructors type_parameters plan idx state:
                        Result::Ok arg_step:
                            let arg_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &arg_step
                            let next_idx %i32 selfhost_type_reduce_step_next_index &arg_step
                            let next_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state arg_step
                            match selfhost_type_reduce_generic_arg_push next_state params arg_id next_idx span:
                                Result::Ok pushed:
                                    let loop_state %SelfhostTypeReduceBuildState field::get pushed "state"
                                    let loop_params %Vec SelfhostResolvedTypeNodeId field::get pushed "params"
                                    let loop_idx %i32 field::get pushed "next_index"
                                    selfhost_type_prefix_list_build_generic_args_loop_with_constructors_and_type_parameters source constructors type_parameters plan loop_idx sub remaining 1 loop_state loop_params span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            v::free params
                            Result::Err e

//: selfhost_type_prefix_list_build_named_with_constructors_and_type_parameters: named item を resolved node へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - named-looking item を、type parameter、bare named type、applied named type、unknown named type のいずれかへ縮約します。
//:
//: [契約/けいやく]:
//: - type parameter と constructor が衝突した場合は、片方を優先せず build state を解放して `TypeParameterConstructorNameConflict` を返します。
//: - constructor arity が正なら、arity 個の引数を再帰的に build して `Applied` node を作ります。
//: - constructor table にない名前は後続 diagnostic のため `Named` node として残します。
//:
//: [計算量/けいさんりょう]:
//: - 単独 item では `O(c + p)`、generic application では各引数の build cost を加えます。
fn selfhost_type_prefix_list_build_named_with_constructors_and_type_parameters %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypeReducePlan impure fn SelfhostTypeReducePlanItem impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\type_parameters\plan\item\idx\state:
    match selfhost_type_parameter_env_find_span type_parameters source item.span:
        Option::Some parameter:
            match selfhost_type_constructor_table_find_span constructors source item.span:
                Option::Some _constructor:
                    selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::TypeParameterConstructorNameConflict item.span
                Option::None:
                    let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Parameter selfhost_resolved_type_parameter_ref_new parameter.parameter_id item.span
                    selfhost_type_reduce_push_node_with_state state node item.span add idx 1
        Option::None:
            match selfhost_type_constructor_table_find_span constructors source item.span:
                Option::Some constructor:
                    if:
                        lt constructor.arity 0
                        then:
                            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::InternalInvariant item.span
                        else:
                            if:
                                eq constructor.arity 0
                                then:
                                    let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Named SelfhostResolvedNamedTypeRef item.span
                                    selfhost_type_reduce_push_node_with_state state node item.span add idx 1
                                else:
                                    let params_result %Result Vec SelfhostResolvedTypeNodeId StdErrorKind v::new
                                    match params_result:
                                        Result::Ok params:
                                            match selfhost_type_prefix_list_build_generic_args_loop_with_constructors_and_type_parameters source constructors type_parameters plan add idx 1 constructor.arity state params item.span:
                                                Result::Ok arg_build:
                                                    let next_state %SelfhostTypeReduceBuildState field::get arg_build "state"
                                                    let applied_params %Vec SelfhostResolvedTypeNodeId field::get arg_build "params"
                                                    let next_idx %i32 field::get arg_build "next_index"
                                                    selfhost_type_reduce_add_applied_named_from_params next_state constructor.nominal_id item.span applied_params next_idx
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err _e:
                                            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::OutOfMemory item.span
                Option::None:
                    let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Named SelfhostResolvedNamedTypeRef item.span
                    selfhost_type_reduce_push_node_with_state state node item.span add idx 1

//: selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters: constructor と parameter を使って 1 型式を resolved tree に[構築/こうちく]する
//:
//: [目的/もくてき]:
//: - validation と同じ規則で prefix list を読み、node table / function argument table / type argument table を更新します。
//:
//: [契約/けいやく]:
//: - 成功時は build step が tree owner と root node id と次 index を所有します。
//: - 失敗時は入力 build state をこの関数または下位関数が解放し、caller は同じ owner を再利用できません。
pub fn selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypeReducePlan impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\type_parameters\plan\idx\state:
    match selfhost_type_reduce_plan_get plan idx:
        Option::Some item:
            let span %SelfhostSourceSpan item.span
            let dispatch_kind %SelfhostTypeReduceDispatchKind item.dispatch_kind
            if:
                item.is_function
                then:
                    selfhost_type_prefix_list_build_function_with_constructors_and_type_parameters source constructors type_parameters plan span idx state
                else if:
                    item.is_primitive
                    then:
                        let node %SelfhostResolvedTypeNode SelfhostResolvedTypeNode::Primitive item.primitive
                        selfhost_type_reduce_push_node_with_state state node span add idx 1
                    else if:
                        item.is_named
                        then:
                            selfhost_type_prefix_list_build_named_with_constructors_and_type_parameters source constructors type_parameters plan item idx state
                        else:
                            selfhost_type_reduce_fail state (selfhost_type_reduce_dispatch_kind_error dispatch_kind) span
        Option::None:
            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::UnexpectedEnd selfhost_type_reduce_empty_span

fn selfhost_type_prefix_list_build_function_nonvoid_arg_with_constructors_and_type_parameters %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypeReducePlan impure fn i32 impure fn SelfhostSourceSpan impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\type_parameters\plan\arg_idx\fn_span\state:
    match selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters source constructors type_parameters plan arg_idx state:
        Result::Ok param_step:
            let param_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &param_step
            let result_idx %i32 selfhost_type_reduce_step_next_index &param_step
            let param_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state param_step
            match selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters source constructors type_parameters plan result_idx param_state:
                Result::Ok result_step:
                    let result_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &result_step
                    let next_index %i32 selfhost_type_reduce_step_next_index &result_step
                    let result_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state result_step
                    selfhost_type_reduce_add_function_nonempty_params result_state param_id result_id fn_span next_index
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

fn selfhost_type_prefix_list_build_function_with_constructors_and_type_parameters %impure fn &str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypeReducePlan impure fn SelfhostSourceSpan impure fn i32 impure fn SelfhostTypeReduceBuildState Result SelfhostTypeReduceStep SelfhostTypeReduceError \source\constructors\type_parameters\plan\fn_span\idx\state:
    let arg_idx %i32 add idx 1
    match selfhost_type_reduce_plan_get plan arg_idx:
        Option::Some arg_item:
            if:
                arg_item.is_void
                then:
                    let result_idx %i32 add idx 2
                    match selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters source constructors type_parameters plan result_idx state:
                        Result::Ok result_step:
                            let result_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &result_step
                            let next_index %i32 selfhost_type_reduce_step_next_index &result_step
                            let next_state %SelfhostTypeReduceBuildState selfhost_type_reduce_step_into_build_state result_step
                            selfhost_type_reduce_add_function_empty_params next_state result_id fn_span next_index
                        Result::Err e:
                            Result::Err e
                else:
                    selfhost_type_prefix_list_build_function_nonvoid_arg_with_constructors_and_type_parameters source constructors type_parameters plan arg_idx fn_span state
        Option::None:
            selfhost_type_reduce_fail state SelfhostTypeReduceErrorKind::FunctionMissingArgument fn_span

//: selfhost_type_prefix_list_reduce: flat type prefix list を resolved type tree へ[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `%` を除いた prefix item list を、TypeId 割当前の node tree に変換します。
//: - `fn i32 fn i32 i32` は nonempty function 引数列として flatten し、`fn void fn unit unit` は 0 引数 function が function を返す形のまま保持します。
//:
//: [注意/ちゅうい]:
//: - `void` は型ではないため、top-level や戻り値位置に現れた場合は `VoidAsType` を返します。
//: - primitive 判定は token に文字列を保存せず、source text と item span から必要な境界でだけ lexeme を切り出します。
pub fn selfhost_type_prefix_list_reduce %impure fn str impure fn &SelfhostTypePrefixList Result SelfhostResolvedTypeTreeRoot SelfhostTypeReduceError \source\list:
    let n %i32 selfhost_type_prefix_list_len list
    if:
        eq n 0
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::EmptyInput selfhost_type_reduce_empty_span
        else:
            match selfhost_type_reduce_plan_from_prefix_list &source list:
                Result::Ok plan:
                    match selfhost_type_prefix_list_validate_at &plan 0:
                        Result::Ok validated_next:
                            if:
                                ne validated_next n
                                then:
                                    match selfhost_type_reduce_plan_get &plan validated_next:
                                        Option::Some trailing:
                                            let span %SelfhostSourceSpan trailing.span
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems span
                                        Option::None:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems selfhost_type_reduce_empty_span
                                else:
                                    match selfhost_resolved_type_tree_new:
                                        Result::Ok tree:
                                            let state %SelfhostTypeReduceBuildState selfhost_type_reduce_build_state_from_tree tree
                                            match selfhost_type_prefix_list_build_at &plan 0 state:
                                                Result::Ok step:
                                                    let root_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &step
                                                    let result_tree %SelfhostResolvedTypeTree selfhost_type_reduce_step_into_tree step
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Ok selfhost_resolved_type_tree_root_new result_tree root_id
                                                Result::Err e:
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Err e
                                        Result::Err _e:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory selfhost_type_reduce_empty_span
                        Result::Err e:
                            selfhost_type_reduce_plan_free plan
                            Result::Err e
                Result::Err e:
                    Result::Err e

//: selfhost_type_prefix_list_reduce_with_constructors: constructor arity を使って flat type prefix list を resolved type tree へ[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `Box i32` や `Result i32 str` のような generic type application を、constructor table の arity に基づいて 1 つの applied type node へ縮約します。
//: - arity 0 constructor は従来の named type node として保持し、projection 段階で named type record へ変換します。
//:
//: [契約/けいやく]:
//: - constructor table に存在する arity > 0 の named type は、直後から arity 個の型式を再帰的に消費します。
//: - 型引数が不足した場合は `GenericTypeArgumentMissing` を返します。
//: - constructor table に存在しない named type は旧 reducer と同じ未解決 named type として保持します。
pub fn selfhost_type_prefix_list_reduce_with_constructors %impure fn str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypePrefixList Result SelfhostResolvedTypeTreeRoot SelfhostTypeReduceError \source\constructors\list:
    let n %i32 selfhost_type_prefix_list_len list
    if:
        eq n 0
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::EmptyInput selfhost_type_reduce_empty_span
        else:
            match selfhost_type_reduce_plan_from_prefix_list &source list:
                Result::Ok plan:
                    match selfhost_type_prefix_list_validate_at_with_constructors &source constructors &plan 0:
                        Result::Ok validated_next:
                            if:
                                ne validated_next n
                                then:
                                    match selfhost_type_reduce_plan_get &plan validated_next:
                                        Option::Some trailing:
                                            let span %SelfhostSourceSpan trailing.span
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems span
                                        Option::None:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems selfhost_type_reduce_empty_span
                                else:
                                    match selfhost_resolved_type_tree_new:
                                        Result::Ok tree:
                                            let state %SelfhostTypeReduceBuildState selfhost_type_reduce_build_state_from_tree tree
                                            match selfhost_type_prefix_list_build_at_with_constructors &source constructors &plan 0 state:
                                                Result::Ok step:
                                                    let root_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &step
                                                    let result_tree %SelfhostResolvedTypeTree selfhost_type_reduce_step_into_tree step
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Ok selfhost_resolved_type_tree_root_new result_tree root_id
                                                Result::Err e:
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Err e
                                        Result::Err _e:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory selfhost_type_reduce_empty_span
                        Result::Err e:
                            selfhost_type_reduce_plan_free plan
                            Result::Err e
                Result::Err e:
                    Result::Err e

//: selfhost_type_prefix_list_reduce_with_constructors_and_type_parameters: constructor と generic parameter を使って flat type prefix list を resolved type tree へ[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - generic function / type declaration の binder から得た `SelfhostTypeParameterEnv` を使い、`T` や `E` を named type constructor ではなく `Parameter` node として縮約します。
//: - `Result T E` のような型では、constructor table が `Result` の arity を決め、各 type argument の中で type parameter lookup を行います。
//:
//: [契約/けいやく]:
//: - primitive type は type parameter lookup より先に primitive node へ縮約します。`unit` などの予約名は parameter environment 作成時にも拒否されます。
//: - 同じ source spelling が constructor table と type parameter environment の両方にある場合は、曖昧なまま片方を優先せず `TypeParameterConstructorNameConflict` を返します。
//: - constructor table に存在しない named type は、従来どおり未解決 named type として保持します。
//:
//: [現状/げんじょう]:
//: - `SelfhostTypeParameterId` は resolver-local identity です。後続の永続 artifact では binder path と signature hash に正規化する必要があります。
//: - type parameter は resolved tree で named constructor と区別して保持し、projection stage が現在 binder の `SelfhostTypeParameterBinding` へ正規化します。
//:
//: [計算量/けいさんりょう]:
//: - 各 named item ごとに constructor lookup と parameter lookup を行うため、`O(m * (c + p))` です。`m` は prefix item 数、`c` は constructor 数、`p` は type parameter 数です。
pub fn selfhost_type_prefix_list_reduce_with_constructors_and_type_parameters %impure fn str impure fn &SelfhostTypeConstructorTable impure fn &SelfhostTypeParameterEnv impure fn &SelfhostTypePrefixList Result SelfhostResolvedTypeTreeRoot SelfhostTypeReduceError \source\constructors\type_parameters\list:
    let n %i32 selfhost_type_prefix_list_len list
    if:
        eq n 0
        then:
            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::EmptyInput selfhost_type_reduce_empty_span
        else:
            match selfhost_type_reduce_plan_from_prefix_list &source list:
                Result::Ok plan:
                    match selfhost_type_prefix_list_validate_at_with_constructors_and_type_parameters &source constructors type_parameters &plan 0:
                        Result::Ok validated_next:
                            if:
                                ne validated_next n
                                then:
                                    match selfhost_type_reduce_plan_get &plan validated_next:
                                        Option::Some trailing:
                                            let span %SelfhostSourceSpan trailing.span
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems span
                                        Option::None:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::TrailingItems selfhost_type_reduce_empty_span
                                else:
                                    match selfhost_resolved_type_tree_new:
                                        Result::Ok tree:
                                            let state %SelfhostTypeReduceBuildState selfhost_type_reduce_build_state_from_tree tree
                                            match selfhost_type_prefix_list_build_at_with_constructors_and_type_parameters &source constructors type_parameters &plan 0 state:
                                                Result::Ok step:
                                                    let root_id %SelfhostResolvedTypeNodeId selfhost_type_reduce_step_node_id &step
                                                    let result_tree %SelfhostResolvedTypeTree selfhost_type_reduce_step_into_tree step
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Ok selfhost_resolved_type_tree_root_new result_tree root_id
                                                Result::Err e:
                                                    selfhost_type_reduce_plan_free plan
                                                    Result::Err e
                                        Result::Err _e:
                                            selfhost_type_reduce_plan_free plan
                                            Result::Err selfhost_type_reduce_error_new SelfhostTypeReduceErrorKind::OutOfMemory selfhost_type_reduce_empty_span
                        Result::Err e:
                            selfhost_type_reduce_plan_free plan
                            Result::Err e
                Result::Err e:
                    Result::Err e
