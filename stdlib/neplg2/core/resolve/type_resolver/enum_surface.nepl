//:                                                 match selfhost_resolved_enum_session_constructor_kind &enum_session 0:
//:                                                     Option::Some kind:
//:                                                         selfhost_type_constructor_kind_eq kind SelfhostTypeConstructorKind::TypeConstructor 2
//:                                                     Option::None:
//:                                                         false
