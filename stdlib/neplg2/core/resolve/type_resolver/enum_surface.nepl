//:                                                                 and and eq selfhost_named_type_id_index definition.nominal_id 1 selfhost_type_constructor_kind_eq kind SelfhostTypeConstructorKind::Type selfhost_resolved_enum_session_variant_name_eq &enum_session 3 "Ok"
