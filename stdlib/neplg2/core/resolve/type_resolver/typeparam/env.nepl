#indent 4

//: # type_resolver/typeparam/env: generic type parameter environment operations
//:
//: [目的/もくてき]:
//: - generic binder から得た type parameter header を `SelfhostTypeParameterEnv` に登録し、type prefix reduction が named constructor lookup より先に binder-local parameter を識別できるようにします。
//: - `T` / `E` のような名前を `SelfhostTypeParameterId` へ正規化し、resolved tree では `SelfhostResolvedTypeNode::Parameter` として扱える境界を提供します。
//:
//: [契約/けいやく]:
//: - environment は `Vec SelfhostTypeParameter` の owner です。成功時は `SelfhostTypeParameterEnvAddResult` で更新後 owner を返し、失敗時は入力 owner を閉じます。
//: - environment owner lifecycle は `selfhost_type_parameter_env_new` で始まり、成功時の更新を `selfhost_type_parameter_env_add_result_into_env` で回収し、最後に `selfhost_type_parameter_env_free` で閉じます。
//: - `selfhost_type_parameter_env_add_checked` は reserved name、negative kind arity、higher-kinded type parameter、duplicate name、allocation failure を typed error として fail-closed にします。
//: - lookup は `Option::Some(parameter)` / `Option::None` で明示し、unknown name を未検査 named constructor と混同しません。
//: - add / allocation / checked failure は `Result::Ok` / `Result::Err` branch として明示します。
//:
//: [現状/げんじょう]:
//: - entry vector を insertion order で保持し、名前 lookup は後ろから前へ線形探索します。現時点では重複名を拒否するため shadowing はありません。
//: - `kind_arity > 0` は `SelfhostTypeParameterEnvErrorKind::HigherKindedTypeParameterUnsupported` として拒否し、future higher-kinded support の設計余地を error kind に残します。
//:
//: [計算量/けいさんりょう]:
//: - `new` / `free` / `len` / id accessor は vector operation を除き `O(1)` です。
//: - `find` / `find_span` / `add_checked` の duplicate check は `O(n)` です。`n` は 1 binder environment 内の parameter 数です。
//:
//: [authority boundary]:
//: - binder name と `SelfhostSourceSpan` は parser / declaration checker が渡す header evidence です。`SelfhostSourceSpan` は diagnostic span only であり、この module は `find_span` の一時 lookup key 生成以外で source text を保持しません。
//: - constructor table との衝突、type reduction、TypeArena projection、`binder_depth` 正規化は後段の reduce / project authority です。
//:
//: [owner boundary]:
//: - 成功時は caller が `selfhost_type_parameter_env_add_result_into_env` で environment owner を回収し、最後に `selfhost_type_parameter_env_free` へ渡します。
//: - `selfhost_type_parameter_env_add_fail` は入力 environment owner を必ず解放します。`v::push` 失敗時は push error payload 内の vector owner を `v::free v::vec_push_error_vec e` で閉じます。
//:
//: [type boundary]:
//: - `SelfhostTypeParameterEnv` は generic parameter の authority であり、`SelfhostTypeConstructorTable` や `SelfhostTypeArena` ではありません。
//: - `void` は 0 引数関数 marker、`unit` は unit 型/値、`fn` / `impure` は function type marker なので、parameter 名として予約します。
//: - 現在の予約名集合は `void`、`fn`、`impure`、`unit`、`bool`、`i32`、`i64`、`u8`、`char`、`str`、`f32`、`f64`、`never` です。
//: - constructor table との同名衝突は `SelfhostTypeReduceErrorKind::TypeParameterConstructorNameConflict` を返す reducer 境界で扱い、この environment 登録では判定しません。
//:
//: [error variant]:
//: - `SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName`、`NegativeKindArity`、`HigherKindedTypeParameterUnsupported`、`DuplicateTypeParameter`、`OutOfMemory` を具体的な failure branch として返します。
//:
//: [最小例/さいしょうれい]:
//: - doctest では空 environment に `T` を追加し、`find` と `find_span` が同じ binder-local id を返すことを確認します。
//:
//: [典型例/てんけいれい]:
//: - doctest では `void` の予約名、重複名、negative arity、higher-kinded arity がそれぞれ concrete enum error kind で fail-closed になることを確認します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #indent 4
//:|
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/resolve/type_resolver/typeparam" as *
//:| #import "std/test" as *
//:
//: fn check_parameter_error_kind %impure fn Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError impure fn SelfhostTypeParameterEnvErrorKind Result unit str \result\expected:
//:     match result:
//:         Result::Ok added:
//:             selfhost_type_parameter_env_free selfhost_type_parameter_env_add_result_into_env added
//:             Result::Err "type parameter add unexpectedly succeeded"
//:         Result::Err e:
//:             if:
//:                 selfhost_type_parameter_env_error_kind_eq e.kind expected
//:                 then:
//:                     Result::Ok unit
//:                 else:
//:                     Result::Err "type parameter add error kind mismatch"
//:
//: fn check_reserved_name %impure fn void Result unit str \void:
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env:
//:             let span %SelfhostSourceSpan source_span_empty_unchecked 0 0
//:             let expected %SelfhostTypeParameterEnvErrorKind SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName
//:             let result %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env "void" 0 span
//:             check_parameter_error_kind result expected
//:         Result::Err _e:
//:             Result::Err "type parameter env allocation failed"
//:
//: fn check_duplicate_name %impure fn void Result unit str \void:
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env0:
//:             let span %SelfhostSourceSpan source_span_empty_unchecked 0 0
//:             match selfhost_type_parameter_env_add_checked env0 "T" 0 span:
//:                 Result::Ok added:
//:                     let env1 %SelfhostTypeParameterEnv selfhost_type_parameter_env_add_result_into_env added
//:                     let result %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env1 "T" 0 span
//:                     check_parameter_error_kind result SelfhostTypeParameterEnvErrorKind::DuplicateTypeParameter
//:                 Result::Err _e:
//:                     Result::Err "first type parameter add failed"
//:         Result::Err _e:
//:             Result::Err "type parameter env allocation failed"
//:
//: fn check_negative_arity %impure fn void Result unit str \void:
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env:
//:             let span %SelfhostSourceSpan source_span_empty_unchecked 0 0
//:             let expected %SelfhostTypeParameterEnvErrorKind SelfhostTypeParameterEnvErrorKind::NegativeKindArity
//:             let bad_arity %i32 sub 0 1
//:             let result %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env "N" bad_arity span
//:             check_parameter_error_kind result expected
//:         Result::Err _e:
//:             Result::Err "type parameter env allocation failed"
//:
//: fn check_higher_kinded_arity %impure fn void Result unit str \void:
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env:
//:             let span %SelfhostSourceSpan source_span_empty_unchecked 0 0
//:             let result %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env "F" 1 span
//:             check_parameter_error_kind result SelfhostTypeParameterEnvErrorKind::HigherKindedTypeParameterUnsupported
//:         Result::Err _e:
//:             Result::Err "type parameter env allocation failed"
//:
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env0:
//:             let source %str "T"
//:             let span %SelfhostSourceSpan source_span_new_unchecked 0 0 1
//:             match selfhost_type_parameter_env_add_checked env0 "T" 0 span:
//:                 Result::Ok added:
//:                     let parameter_id %SelfhostTypeParameterId selfhost_type_parameter_env_add_result_parameter_id &added
//:                     let env1 %SelfhostTypeParameterEnv selfhost_type_parameter_env_add_result_into_env added
//:                     match selfhost_type_parameter_env_find &env1 "T":
//:                         Option::Some found:
//:                             let expected_index %i32 selfhost_type_parameter_id_index parameter_id
//:                             let found_index %i32 selfhost_type_parameter_id_index found.parameter_id
//:                             let checks1 checks_push checks0 check_eq_i32 expected_index found_index
//:                             match selfhost_type_parameter_env_find_span &env1 &source span:
//:                                 Option::Some found_by_span:
//:                                     let found_by_span_index %i32 selfhost_type_parameter_id_index found_by_span.parameter_id
//:                                     let checks2 checks_push checks1 check_eq_i32 expected_index found_by_span_index
//:                                     selfhost_type_parameter_env_free env1
//:                                     let checks3 checks_push checks2 check_reserved_name
//:                                     let checks4 checks_push checks3 check_duplicate_name
//:                                     let checks5 checks_push checks4 check_negative_arity
//:                                     let checks6 checks_push checks5 check_higher_kinded_arity
//:                                     let shown checks_print_report checks6
//:                                     checks_exit_code shown
//:                                 Option::None:
//:                                     selfhost_type_parameter_env_free env1
//:                                     let checks2 checks_push checks1 Result::Err "type parameter span lookup failed"
//:                                     let shown checks_print_report checks2
//:                                     checks_exit_code shown
//:                         Option::None:
//:                             selfhost_type_parameter_env_free env1
//:                             let checks1 checks_push checks0 Result::Err "type parameter lookup failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result::Err "type parameter add failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "type parameter env allocation failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
//:
#import "alloc/collections/vec" as v
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "./id" as *
#import "./model" as *

//: selfhost_type_parameter_env_new: [空/から]の type parameter environment を[作/つく]る
//:
//: [目的/もくてき]:
//: - generic binder を読み始める前の空 environment を作ります。
//:
//: [場合分/ばあいわ]け:
//: - `Ok(env)`: entry vector の確保に成功しました。
//: - `Err(e)`: vector 確保に失敗しました。caller はまだ environment owner を持ちません。
//:
//: [契約/けいやく]:
//: - 成功時だけ caller は `SelfhostTypeParameterEnv` owner を受け取ります。
//:
//: [戻/もど]り[値/ち]:
//: - `Result::Ok(env)`: 空の parameter environment owner です。
//: - `Result::Err(e)`: `Vec` 確保失敗の `StdErrorKind` です。解放すべき environment owner は存在しません。
//:
//: [計算量/けいさんりょう]:
//: - 成功時は `O(1)` です。
//:
//: [owner boundary]:
//: - `Result::Ok` branch でだけ environment owner が caller へ移動します。
//:
//: [error variant]:
//: - allocation failure は `StdErrorKind::OutOfMemory` などの concrete `StdErrorKind::*` として返します。
pub fn selfhost_type_parameter_env_new %impure fn void Result SelfhostTypeParameterEnv StdErrorKind \void:
    let entries_result %Result Vec SelfhostTypeParameter StdErrorKind v::new
    match entries_result:
        Result::Ok entries:
            Result::Ok SelfhostTypeParameterEnv entries
        Result::Err e:
            Result::Err e

//: selfhost_type_parameter_env_free: environment の buffer を[解放/かいほう]する
//:
//: [目的/もくてき]:
//: - `SelfhostTypeParameterEnv` が持つ entry vector owner を閉じます。
//:
//: [契約/けいやく]:
//: - caller はこの関数へ渡した environment owner を再利用できません。
//: - `SelfhostTypeParameter` は Copy payload だけを持つため、entry ごとの destructor は不要です。
//:
//: [戻/もど]り[値/ち]:
//: - `unit`: 解放が完了したことを表します。
//:
//: [計算量/けいさんりょう]:
//: - vector 解放コストを除き `O(1)` です。
//:
//: [owner boundary]:
//: - この関数が environment owner lifecycle の終端です。
pub fn selfhost_type_parameter_env_free %impure fn SelfhostTypeParameterEnv unit \env:
    v::free field::get env "entries"

//: selfhost_type_parameter_env_len: parameter 数を[返/かえ]す
//:
//: [目的/もくてき]:
//: - 次に追加する parameter id の index と、source policy / doctest の確認に使います。
//:
//: [契約/けいやく]:
//: - borrow accessor なので environment owner は消費しません。
//:
//: [戻/もど]り[値/ち]:
//: - `i32`: 現在の entry 数です。
//:
//: [計算量/けいさんりょう]:
//: - `O(1)` です。
pub fn selfhost_type_parameter_env_len %fn &SelfhostTypeParameterEnv i32 \env:
    let entries %&Vec SelfhostTypeParameter field::get_ref env "entries"
    v::len entries

//: selfhost_type_parameter_env_add_result_parameter_id: 追加で割り当てた parameter identity を[読/よ]む
//:
//: [目的/もくてき]:
//: - checked add 成功 payload から、追加された parameter の `SelfhostTypeParameterId` だけを borrow で読みます。
//:
//: [契約/けいやく]:
//: - borrow accessor なので `SelfhostTypeParameterEnvAddResult` の owner は消費しません。
//: - environment owner は別途 `selfhost_type_parameter_env_add_result_into_env` で取り出します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostTypeParameterId`: `add_checked` が割り当てた binder-local id です。
//:
//: [計算量/けいさんりょう]:
//: - `O(1)` です。
//:
//: [owner boundary]:
//: - この accessor は add result owner を消費せず、environment owner recovery は行いません。
//:
//: [type boundary]:
//: - 返す id は `SelfhostTypeParameterId` であり、named constructor id ではありません。
pub fn selfhost_type_parameter_env_add_result_parameter_id %fn &SelfhostTypeParameterEnvAddResult SelfhostTypeParameterId \added:
    *field::get_ref added "parameter_id"

//: selfhost_type_parameter_env_add_result_into_env: 追加後 environment owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - checked add 成功 payload を消費し、更新後の `SelfhostTypeParameterEnv` owner を caller へ戻します。
//:
//: [契約/けいやく]:
//: - この関数は `SelfhostTypeParameterEnvAddResult` を消費します。
//: - caller は取り出した environment owner を後続 lookup や free に渡します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostTypeParameterEnv`: parameter 追加後の environment owner です。
//:
//: [計算量/けいさんりょう]:
//: - `O(1)` です。
//:
//: [owner boundary]:
//: - add result payload から environment owner を回収する唯一の public helper です。
pub fn selfhost_type_parameter_env_add_result_into_env %impure fn SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnv \added:
    field::get added "env"

//: selfhost_type_parameter_name_is_reserved: type parameter として使えない予約名か[返/かえ]す
//:
//: [目的/もくてき]:
//: - primitive type、`void` marker、function marker と generic parameter 名が衝突しないようにします。
//:
//: [契約/けいやく]:
//: - 予約名の判定は type parameter environment 登録境界のみに使います。constructor table の予約名判定とは別 helper です。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `void`、`fn`、`impure`、`unit`、primitive type 名、`never` のいずれかです。
//: - `false`: 現在の予約名集合には含まれません。
//:
//: [現状/げんじょう]:
//: - 予約名は固定の string 比較で列挙します。primitive type set が増えたら、この関数も同じ commit で更新します。
//:
//: [計算量/けいさんりょう]:
//: - primitive type 名の個数に対する固定長比較なので、現状は `O(1)` と扱います。
//:
//: [type boundary]:
//: - `void` は 0 引数関数 marker、`unit` は unit 型/値として予約されます。これらを binder-local parameter へ変換しません。
//: - この helper は `SelfhostTypeParameterEnv` に登録する前の名前だけを判定し、environment owner や constructor table owner は触りません。
//: - 予約名は `void`, `fn`, `impure`, `unit`, `bool`, `i32`, `i64`, `u8`, `char`, `str`, `f32`, `f64`, `never` です。
fn selfhost_type_parameter_name_is_reserved %fn str bool \name:
    if:
        string_search::str_eq name "void"
        then:
            true
        else if:
            string_search::str_eq name "fn"
            then:
                true
            else if:
                string_search::str_eq name "impure"
                then:
                    true
                else if:
                    string_search::str_eq name "unit"
                    then:
                        true
                    else if:
                        string_search::str_eq name "bool"
                        then:
                            true
                        else if:
                            string_search::str_eq name "i32"
                            then:
                                true
                            else if:
                                string_search::str_eq name "i64"
                                then:
                                    true
                                else if:
                                    string_search::str_eq name "u8"
                                    then:
                                        true
                                    else if:
                                        string_search::str_eq name "char"
                                        then:
                                            true
                                        else if:
                                            string_search::str_eq name "str"
                                            then:
                                                true
                                            else if:
                                                string_search::str_eq name "f32"
                                                then:
                                                    true
                                                else if:
                                                    string_search::str_eq name "f64"
                                                    then:
                                                        true
                                                    else:
                                                        string_search::str_eq name "never"

//: selfhost_type_parameter_env_get: id に対応する parameter header を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `SelfhostTypeParameterId` の index から environment entry を読みます。
//:
//: [契約/けいやく]:
//: - 負 index と範囲外 index は `none` として fail-closed に扱います。
//: - borrow accessor なので environment owner は消費しません。
//: - 戻り値は `Option::Some` または `Option::None` で、panic や sentinel index は使いません。
//:
//: [場合分/ばあいわ]け:
//: - `Option::Some(parameter)`: id の index が environment 内にあります。
//: - `Option::None`: index が負、または environment の範囲外です。
//:
//: [戻/もど]り[値/ち]:
//: - `Option::Some(parameter)`: Copy header を返します。
//: - `Option::None`: id がこの environment の entry を指していません。
//:
//: [計算量/けいさんりょう]:
//: - `Vec::get` なので `O(1)` です。
//:
//: [type boundary]:
//: - id は `SelfhostTypeParameterEnv` に対してだけ解決されます。named constructor lookup は行いません。
pub fn selfhost_type_parameter_env_get %fn &SelfhostTypeParameterEnv fn SelfhostTypeParameterId Option SelfhostTypeParameter \env\parameter_id:
    if:
        lt parameter_id.index 0
        then:
            none
        else:
            let entries %&Vec SelfhostTypeParameter field::get_ref env "entries"
            v::get entries parameter_id.index

//: selfhost_type_parameter_env_find_loop: 名前 lookup の後ろ向き線形探索
//:
//: [目的/もくてき]:
//: - 将来 shadowing を許す設計に拡張しても最新 binder を優先できるよう、末尾から探索します。
//:
//: [契約/けいやく]:
//: - `idx` から 0 へ向かって後ろ向きに線形探索します。
//: - 戻り値は `Option::Some` または `Option::None` で、探索失敗を sentinel entry で表しません。
//:
//: [場合分/ばあいわ]け:
//: - `Option::Some(parameter)`: `name` と一致する entry が見つかりました。
//: - `Option::None`: `idx` から 0 までに一致する entry がありません。
//:
//: [戻/もど]り[値/ち]:
//: - `Option::Some(parameter)`: 一致した最新 entry です。
//: - `Option::None`: 探索範囲に一致する parameter がありません。
//:
//: [計算量/けいさんりょう]:
//: - `O(n)` です。`n` は探索する entry 数です。
fn selfhost_type_parameter_env_find_loop %fn &SelfhostTypeParameterEnv fn str fn i32 Option SelfhostTypeParameter \env\name\idx:
    if:
        lt idx 0
        then:
            none
        else:
            match selfhost_type_parameter_env_get env selfhost_type_parameter_id_new idx:
                Option::Some parameter:
                    if:
                        string_search::str_eq parameter.name name
                        then:
                            some parameter
                        else:
                            selfhost_type_parameter_env_find_loop env name sub idx 1
                Option::None:
                    none

//: selfhost_type_parameter_env_find: 名前に対応する type parameter を[返/かえ]す
//:
//: [目的/もくてき]:
//: - source spelling から作った lookup key を `SelfhostTypeParameterEnv` に解決します。
//:
//: [契約/けいやく]:
//: - `none` は「type parameter ではない」ことを表します。caller は constructor lookup や unknown named type handling へ進みます。
//: - 戻り値は `Option::Some` または `Option::None` で、unknown name を typed parameter として捏造しません。
//:
//: [場合分/ばあいわ]け:
//: - `Option::Some(parameter)`: environment に同名 parameter があります。
//: - `Option::None`: 同名 parameter はありません。caller は constructor lookup や unknown named type handling へ進めます。
//:
//: [戻/もど]り[値/ち]:
//: - `Option::Some(parameter)`: 同名 binder-local parameter です。
//: - `Option::None`: environment には同名 parameter がありません。
//:
//: [計算量/けいさんりょう]:
//: - `O(n)` です。`n` は environment の entry 数です。
//:
//: [authority boundary]:
//: - name lookup authority は `SelfhostTypeParameterEnv` です。constructor table との衝突診断は reducer 境界で行います。
//:
//: [type boundary]:
//: - 戻り値は generic parameter header であり、named type constructor header ではありません。
pub fn selfhost_type_parameter_env_find %fn &SelfhostTypeParameterEnv fn str Option SelfhostTypeParameter \env\name:
    selfhost_type_parameter_env_find_loop env name sub selfhost_type_parameter_env_len env 1

//: selfhost_type_parameter_env_find_span: source span の名前に対応する type parameter を[返/かえ]す
//:
//: [目的/もくてき]:
//: - resolved type tree や reduce plan が名前の source span だけを持つ境界で、source text から lookup key を切り出します。
//:
//: [契約/けいやく]:
//: - 切り出した文字列は一時 lookup key です。canonical key や永続 artifact key として保存しません。
//: - source span の妥当性は caller が持つ parser / reducer authority に従います。
//:
//: [場合分/ばあいわ]け:
//: - `some(parameter)`: span の文字列と一致する parameter があります。
//: - `none`: 一致する parameter はありません。
//:
//: [戻/もど]り[値/ち]:
//: - `Option::Some(parameter)`: span が指す名前に一致する binder-local parameter です。
//: - `Option::None`: 一致する parameter はありません。
//:
//: [計算量/けいさんりょう]:
//: - slice 作成を除き lookup は `O(n)` です。
//:
//: [authority boundary]:
//: - `SelfhostSourceSpan` は diagnostic/source range authority です。source spelling は lookup のために一時的に切り出すだけです。
pub fn selfhost_type_parameter_env_find_span %fn &SelfhostTypeParameterEnv fn &str fn SelfhostSourceSpan Option SelfhostTypeParameter \env\source\span:
    let source_view %str Clone::clone source
    let name %str string_slice::str_slice source_view span.start span.end
    selfhost_type_parameter_env_find env name

//: selfhost_type_parameter_env_add_fail: 追加失敗時に environment owner を閉じて error を[返/かえ]す
//:
//: [目的/もくてき]:
//: - checked add の failure branch を 1 箇所に集め、入力 environment owner の解放漏れを防ぎます。
//:
//: [契約/けいやく]:
//: - この関数は入力 environment owner を必ず解放します。
//: - caller は `Err` を受け取った後に同じ environment owner を使えません。
//:
//: [戻/もど]り[値/ち]:
//: - `Result::Err(error)`: 指定された `SelfhostTypeParameterEnvErrorKind` と span を持つ typed error です。
//:
//: [計算量/けいさんりょう]:
//: - vector 解放コストを除き `O(1)` です。
//:
//: [owner boundary]:
//: - `selfhost_type_parameter_env_free env` を必ず実行して owner lifecycle を閉じます。
//:
//: [error variant]:
//: - caller が渡した `SelfhostTypeParameterEnvErrorKind::*` をそのまま payload に入れます。
fn selfhost_type_parameter_env_add_fail %impure fn SelfhostTypeParameterEnv impure fn SelfhostTypeParameterEnvErrorKind impure fn SelfhostSourceSpan Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError \env\kind\span:
    selfhost_type_parameter_env_free env
    Result::Err selfhost_type_parameter_env_error_new kind span

//: selfhost_type_parameter_env_add_checked: checked generic type parameter を environment に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - parser / declaration checker が読んだ generic binder を、type resolver 用 environment に追加します。
//:
//: [場合分/ばあいわ]け:
//: - `Ok(result)`: `name` が予約語でなく、`kind_arity == 0` で、同名 parameter がなく、vector 追加に成功しました。
//: - `Err(SelfhostTypeParameterEnvErrorKind::NegativeKindArity)`: `kind_arity < 0` です。
//: - `Err(SelfhostTypeParameterEnvErrorKind::HigherKindedTypeParameterUnsupported)`: `kind_arity > 0` です。
//: - `Err(SelfhostTypeParameterEnvErrorKind::DuplicateTypeParameter)`: 同じ environment に `name` がすでにあります。
//: - `Err(SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName)`: `name` が primitive / marker 名です。
//: - `Err(SelfhostTypeParameterEnvErrorKind::OutOfMemory)`: vector 追加に失敗しました。
//:
//: [戻/もど]り[値/ち]:
//: - `Result::Ok(result)`: 更新後 environment owner と割り当てた `SelfhostTypeParameterId` を持つ payload です。
//: - `Result::Err(error)`: 入力 environment owner はこの関数で解放済みです。`error.kind` は concrete `SelfhostTypeParameterEnvErrorKind::*` です。
//:
//: [契約/けいやく]:
//: - 失敗時は入力 environment owner をこの関数が解放します。
//: - constructor table との衝突は reducer 境界で診断し、この関数では判定しません。
//:
//: [計算量/けいさんりょう]:
//: - 重複検査により `O(n)` です。`n` は既存 parameter 数です。
//:
//: [authority boundary]:
//: - `name` / `span` / `kind_arity` は parser / declaration checker が渡す generic binder header evidence です。
//:
//: [owner boundary]:
//: - 成功時は `Result::Ok` payload に environment owner を移し、失敗時はこの関数が owner を閉じます。`v::push` 失敗時は `v::free v::vec_push_error_vec e` で vector owner を閉じます。
//:
//: [type boundary]:
//: - この関数は generic parameter environment だけを更新します。constructor table との同名衝突は `SelfhostTypeReduceErrorKind::TypeParameterConstructorNameConflict` を出す後段 reducer 境界に任せます。
//:
//: [error variant]:
//: - `SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName`、`NegativeKindArity`、`HigherKindedTypeParameterUnsupported`、`DuplicateTypeParameter`、`OutOfMemory` を返します。
//:
//: [最小例/さいしょうれい]:
//: - doctest では successful add の owner recovery / free と、negative arity、higher-kinded arity、duplicate name を concrete enum error kind で確認します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #indent 4
//:|
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/resolve/type_resolver/typeparam" as *
//:| #import "std/test" as *
//:
//: fn check_parameter_error_kind %impure fn Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError impure fn SelfhostTypeParameterEnvErrorKind Result unit str \result\expected:
//:     match result:
//:         Result::Ok added:
//:             selfhost_type_parameter_env_free selfhost_type_parameter_env_add_result_into_env added
//:             Result::Err "type parameter add unexpectedly succeeded"
//:         Result::Err e:
//:             if:
//:                 selfhost_type_parameter_env_error_kind_eq e.kind expected
//:                 then:
//:                     Result::Ok unit
//:                 else:
//:                     Result::Err "type parameter add error kind mismatch"
//:
//: fn main %impure fn void i32 \void:
//:     let span %SelfhostSourceSpan source_span_empty_unchecked 0 0
//:     let checks0 checks_new
//:     match selfhost_type_parameter_env_new:
//:         Result::Ok env0:
//:             match selfhost_type_parameter_env_add_checked env0 "T" 0 span:
//:                 Result::Ok added:
//:                     let env1 %SelfhostTypeParameterEnv selfhost_type_parameter_env_add_result_into_env added
//:                     let result_duplicate %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env1 "T" 0 span
//:                     let checks1 checks_push checks0 check_parameter_error_kind result_duplicate SelfhostTypeParameterEnvErrorKind::DuplicateTypeParameter
//:                     match selfhost_type_parameter_env_new:
//:                         Result::Ok env2:
//:                             let bad_arity %i32 sub 0 1
//:                             let result_negative %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env2 "N" bad_arity span
//:                             let checks2 checks_push checks1 check_parameter_error_kind result_negative SelfhostTypeParameterEnvErrorKind::NegativeKindArity
//:                             match selfhost_type_parameter_env_new:
//:                                 Result::Ok env3:
//:                                     let result_higher %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env3 "F" 1 span
//:                                     let checks3 checks_push checks2 check_parameter_error_kind result_higher SelfhostTypeParameterEnvErrorKind::HigherKindedTypeParameterUnsupported
//:                                     match selfhost_type_parameter_env_new:
//:                                         Result::Ok env4:
//:                                             let result_reserved %Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError selfhost_type_parameter_env_add_checked env4 "unit" 0 span
//:                                             let checks4 checks_push checks3 check_parameter_error_kind result_reserved SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                         Result::Err _e:
//:                                             let checks4 checks_push checks3 Result::Err "reserved env allocation failed"
//:                                             let shown checks_print_report checks4
//:                                             checks_exit_code shown
//:                                 Result::Err _e:
//:                                     let checks3 checks_push checks2 Result::Err "higher env allocation failed"
//:                                     let shown checks_print_report checks3
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks2 checks_push checks1 Result::Err "negative env allocation failed"
//:                             let shown checks_print_report checks2
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result::Err "type parameter add failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "type parameter env allocation failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```
pub fn selfhost_type_parameter_env_add_checked %impure fn SelfhostTypeParameterEnv impure fn str impure fn i32 impure fn SelfhostSourceSpan Result SelfhostTypeParameterEnvAddResult SelfhostTypeParameterEnvError \env\name\kind_arity\span:
    if:
        selfhost_type_parameter_name_is_reserved name
        then:
            selfhost_type_parameter_env_add_fail env SelfhostTypeParameterEnvErrorKind::ReservedTypeParameterName span
        else if:
            lt kind_arity 0
            then:
                selfhost_type_parameter_env_add_fail env SelfhostTypeParameterEnvErrorKind::NegativeKindArity span
            else if:
                gt kind_arity 0
                then:
                    selfhost_type_parameter_env_add_fail env SelfhostTypeParameterEnvErrorKind::HigherKindedTypeParameterUnsupported span
                else:
                    match selfhost_type_parameter_env_find &env name:
                        Option::Some _existing:
                            selfhost_type_parameter_env_add_fail env SelfhostTypeParameterEnvErrorKind::DuplicateTypeParameter span
                        Option::None:
                            let parameter_id %SelfhostTypeParameterId selfhost_type_parameter_id_new selfhost_type_parameter_env_len &env
                            let parameter %SelfhostTypeParameter SelfhostTypeParameter name parameter_id kind_arity span
                            let entries %Vec SelfhostTypeParameter field::get env "entries"
                            match v::push entries parameter:
                                Result::Ok next_entries:
                                    Result::Ok SelfhostTypeParameterEnvAddResult (SelfhostTypeParameterEnv next_entries) parameter_id
                                Result::Err e:
                                    v::free v::vec_push_error_vec e
                                    Result::Err selfhost_type_parameter_env_error_new SelfhostTypeParameterEnvErrorKind::OutOfMemory span
