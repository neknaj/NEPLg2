#indent 4

//: # name_resolver
//: NEPLg2.0 の名前解決と import visibility を置くモジュールです。
//:
//: [目的/もくてき]:
//: - DefId、scope、hoist、qualified alias、open import の解決をこの stage に集約します。
//: - `SelfhostDefId` と scope binding table を使い、後続 stage が文字列だけで定義を参照しない境界を作ります。
//:
//: [注意/ちゅうい]:
//: - `SelfhostNameScope` は binding table を所有します。使い終わった scope は `selfhost_name_scope_free` で解放してください。
//: - 現段階の `find` は同一 scope の後勝ち shadowing だけを扱います。親 scope、import、hoist は後続 issue で追加します。
//: - value / type / trait などの名前空間を分けたい caller は `selfhost_name_scope_find_kind` を使います。
//: - 型推論や overload 候補選択は `check/` に委譲し、ここでは名前から定義候補への対応を安定化します。
//:
//: [計算量/けいさんりょう]:
//: - binding 追加: 償却 O(1)
//: - binding 取得: O(1)
//: - 名前検索 / kind 指定検索: O(n)
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/resolve/name_resolver" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match selfhost_name_scope_new:
//:         Result::Ok scope0:
//:             let span <SelfhostSourceSpan> source_span_new 0 1 2
//:             let first <SelfhostNameBinding> selfhost_name_binding_pending "x" SelfhostDefKind::Local span
//:             match selfhost_name_scope_add_binding scope0 first:
//:                 Result::Ok add1:
//:                     let first_id <SelfhostDefId> selfhost_name_scope_add_result_def_id &add1
//:                     let scope1 <SelfhostNameScope> selfhost_name_scope_add_result_into_scope add1
//:                     let second <SelfhostNameBinding> selfhost_name_binding_pending "x" SelfhostDefKind::Param span
//:                     match selfhost_name_scope_add_binding scope1 second:
//:                         Result::Ok add2:
//:                             let second_id <SelfhostDefId> selfhost_name_scope_add_result_def_id &add2
//:                             let scope2 <SelfhostNameScope> selfhost_name_scope_add_result_into_scope add2
//:                             let checks1 checks_push checks0 check_eq_i32 0 selfhost_def_id_index first_id
//:                             let checks2 checks_push checks1 check_eq_i32 1 selfhost_def_id_index second_id
//:                             match selfhost_name_scope_find &scope2 "x":
//:                                 Option::Some binding:
//:                                     let checks3 checks_push checks2 check selfhost_name_binding_def_id_eq binding second_id
//:                                     let checks4 checks_push checks3 check selfhost_def_kind_eq binding.kind SelfhostDefKind::Param
//:                                     let checks5 checks_push checks4 check_eq_i32 2 selfhost_name_scope_len &scope2
//:                                     let shown checks_print_report checks5
//:                                     selfhost_name_scope_free scope2
//:                                     checks_exit_code shown
//:                                 Option::None:
//:                                     let checks3 checks_push checks2 Result<(),str>::Err "missing latest binding"
//:                                     let shown checks_print_report checks3
//:                                     selfhost_name_scope_free scope2
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<(),str>::Err "second binding allocation failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<(),str>::Err "first binding allocation failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<(),str>::Err "scope allocation failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "std/test" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/resolve/name_resolver" as *
//: fn main <()*>i32> ():
//:     let checks0 checks_new
//:     match selfhost_name_scope_new:
//:         Result::Ok scope0:
//:             let span <SelfhostSourceSpan> source_span_new 0 10 14
//:             let local_binding <SelfhostNameBinding> selfhost_name_binding_pending "Item" SelfhostDefKind::Local span
//:             match selfhost_name_scope_add_binding scope0 local_binding:
//:                 Result::Ok add1:
//:                     let local_id <SelfhostDefId> selfhost_name_scope_add_result_def_id &add1
//:                     let scope1 <SelfhostNameScope> selfhost_name_scope_add_result_into_scope add1
//:                     let struct_binding <SelfhostNameBinding> selfhost_name_binding_pending "Item" SelfhostDefKind::Struct span
//:                     match selfhost_name_scope_add_binding scope1 struct_binding:
//:                         Result::Ok add2:
//:                             let struct_id <SelfhostDefId> selfhost_name_scope_add_result_def_id &add2
//:                             let scope2 <SelfhostNameScope> selfhost_name_scope_add_result_into_scope add2
//:                             match selfhost_name_scope_find &scope2 "Item":
//:                                 Option::Some latest:
//:                                     let checks1 checks_push checks0 check selfhost_name_binding_def_id_eq latest struct_id
//:                                     match selfhost_name_scope_find_kind &scope2 "Item" SelfhostDefKind::Local:
//:                                         Option::Some value_binding:
//:                                             let checks2 checks_push checks1 check selfhost_name_binding_def_id_eq value_binding local_id
//:                                             match selfhost_name_scope_find_kind &scope2 "Item" SelfhostDefKind::Builtin:
//:                                                 Option::None:
//:                                                     let checks3 checks_push checks2 check_eq_i32 2 selfhost_name_scope_len &scope2
//:                                                     let shown checks_print_report checks3
//:                                                     selfhost_name_scope_free scope2
//:                                                     checks_exit_code shown
//:                                                 Option::Some _unexpected:
//:                                                     let checks3 checks_push checks2 Result<(),str>::Err "unexpected builtin binding"
//:                                                     let shown checks_print_report checks3
//:                                                     selfhost_name_scope_free scope2
//:                                                     checks_exit_code shown
//:                                         Option::None:
//:                                             let checks2 checks_push checks1 Result<(),str>::Err "missing local binding"
//:                                             let shown checks_print_report checks2
//:                                             selfhost_name_scope_free scope2
//:                                             checks_exit_code shown
//:                                 Option::None:
//:                                     let checks1 checks_push checks0 Result<(),str>::Err "missing latest binding"
//:                                     let shown checks_print_report checks1
//:                                     selfhost_name_scope_free scope2
//:                                     checks_exit_code shown
//:                         Result::Err _e:
//:                             let checks1 checks_push checks0 Result<(),str>::Err "struct binding allocation failed"
//:                             let shown checks_print_report checks1
//:                             checks_exit_code shown
//:                 Result::Err _e:
//:                     let checks1 checks_push checks0 Result<(),str>::Err "local binding allocation failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result<(),str>::Err "scope allocation failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```


pub #import "./name_resolver/id" as *
pub #import "./name_resolver/kind" as *
pub #import "./name_resolver/binding" as *
pub #import "./name_resolver/scope" as *
pub #import "./name_resolver/stage0" as *
