#indent 4

//: # name_resolver/scope
//: binding順序とDefIdを保持した独立scope ownerを作ります。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/resolve/name_resolver" as *
//: fn main %impure fn void i32 \void:
//:|     match selfhost_name_scope_new void:
//:|         Result::Err _e: 1
//:|         Result::Ok scope0:
//:|             let outer selfhost_name_binding_pending "outer" SelfhostDefKind::Local source_span_empty_unchecked 0 0
//:|             match selfhost_name_scope_add_binding scope0 outer:
//:|                 Result::Err _e: 1
//:|                 Result::Ok added:
//:|                     let parent selfhost_name_scope_add_result_into_scope added
//:|                     match selfhost_name_scope_fork &parent:
//:|                         Result::Err _e:
//:|                             selfhost_name_scope_free parent
//:|                             1
//:|                         Result::Ok child0:
//:|                             let local selfhost_name_binding_pending "value" SelfhostDefKind::Local source_span_empty_unchecked 0 0
//:|                             match selfhost_name_scope_add_binding child0 local:
//:|                                 Result::Err _e:
//:|                                     selfhost_name_scope_free parent
//:|                                     1
//:|                                 Result::Ok local_added:
//:|                                     let local_id selfhost_name_scope_add_result_def_id &local_added
//:|                                     let child selfhost_name_scope_add_result_into_scope local_added
//:|                                     let inherited_ok %bool match selfhost_name_scope_find &child "outer":
//:|                                         Option::Some binding: selfhost_name_binding_def_id_eq binding selfhost_def_id_new 0
//:|                                         Option::None: false
//:|                                     let local_ok %bool match selfhost_name_scope_find &child "value":
//:|                                         Option::Some binding: and selfhost_name_binding_def_id_eq binding local_id selfhost_def_id_eq local_id selfhost_def_id_new 1
//:|                                         Option::None: false
//:|                                     let parent_ok %bool match selfhost_name_scope_find &parent "value":
//:|                                         Option::None: true
//:|                                         Option::Some _binding: false
//:|                                     let length_ok %bool and eq selfhost_name_scope_len &parent 1 eq selfhost_name_scope_len &child 2
//:|                                     selfhost_name_scope_free child
//:|                                     selfhost_name_scope_free parent
//:|                                     if and and and length_ok inherited_ok local_ok parent_ok 0 1
//: ```
#import "alloc/collections/vec" as v
#import "alloc/string/search" as string_search
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "./binding" as *
#import "./id" as *
#import "./kind" as *

//: SelfhostNameScope: binding table を所有する scope
//:
//: [注意/ちゅうい]:
//: - `bindings` は insertion order で保持され、検索は末尾から行うことで後勝ち shadowing を表します。
pub struct SelfhostNameScope:
    bindings %Vec SelfhostNameBinding

//: SelfhostNameScopeAddResult: binding 追加後の scope と割り当てた DefId
pub struct SelfhostNameScopeAddResult:
    scope %SelfhostNameScope
    def_id %SelfhostDefId


//: selfhost_name_scope_new: [空/から]の scope を[作/つく]る
pub fn selfhost_name_scope_new %impure fn void Result SelfhostNameScope StdErrorKind \void:
    let bindings_result %Result Vec SelfhostNameBinding StdErrorKind v::new
    match bindings_result:
        Result::Ok bindings:
            Result::Ok SelfhostNameScope bindings
        Result::Err e:
            Result::Err e

//: selfhost_name_scope_free: scope の binding table を[解放/かいほう]する
pub fn selfhost_name_scope_free %impure fn SelfhostNameScope unit \scope:
    v::free field::get scope "bindings"

//: selfhost_name_scope_len: scope 内の binding 数を[返/かえ]す
pub fn selfhost_name_scope_len %fn &SelfhostNameScope i32 \scope:
    let bindings %&Vec SelfhostNameBinding field::get_ref scope "bindings"
    v::len bindings

//: selfhost_name_scope_add_result_new: add result を[作/つく]る
pub fn selfhost_name_scope_add_result_new %impure fn SelfhostNameScope impure fn SelfhostDefId SelfhostNameScopeAddResult \scope\def_id:
    SelfhostNameScopeAddResult scope def_id

//: selfhost_name_scope_add_result_def_id: add result から割り当てられた DefId を[読/よ]む
//:
//: [目的/もくてき]:
//: - `SelfhostNameScopeAddResult` は scope owner を含むため、通常の source から field を直接読むことはできません。
//: - この accessor は borrow から Copy な `SelfhostDefId` だけを返し、scope owner は動かしません。
pub fn selfhost_name_scope_add_result_def_id %fn &SelfhostNameScopeAddResult SelfhostDefId \added:
    *field::get_ref added "def_id"

//: selfhost_name_scope_add_result_into_scope: add result を[消費/しょうひ]して scope owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - binding 追加後の scope owner を次の名前解決操作へ渡すための public 経路です。
//: - wrapper を消費するため、`SelfhostNameScopeAddResult` から scope owner を複製する経路は作りません。
pub fn selfhost_name_scope_add_result_into_scope %impure fn SelfhostNameScopeAddResult SelfhostNameScope \added:
    field::get added "scope"

//: selfhost_name_scope_add_binding: scope に binding を 1 件[追加/ついか]する
//:
//: [目的/もくてき]:
//: - 追加位置を `SelfhostDefId` として割り当て、binding 側にも同じ id を保存します。
//:
//: [注意/ちゅうい]:
//: - 失敗時、入力 scope の owner はこの関数が消費し、`Vec::push` から戻った binding buffer を閉じます。
pub fn selfhost_name_scope_add_binding %impure fn SelfhostNameScope impure fn SelfhostNameBinding Result SelfhostNameScopeAddResult StdErrorKind \scope\binding:
    let def_id %SelfhostDefId selfhost_def_id_new selfhost_name_scope_len &scope
    let bindings %Vec SelfhostNameBinding field::get scope "bindings"
    let item %SelfhostNameBinding selfhost_name_binding_new binding.name selfhost_def_id_assigned def_id binding.kind binding.span
    match v::push bindings item:
        Result::Ok next_bindings:
            Result::Ok selfhost_name_scope_add_result_new (SelfhostNameScope next_bindings) def_id
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_name_scope_get: DefId の binding record を[返/かえ]す
pub fn selfhost_name_scope_get %fn &SelfhostNameScope fn SelfhostDefId Option SelfhostNameBinding \scope\def_id:
    if:
        lt def_id.index 0
        then:
            none
        else:
            let bindings %&Vec SelfhostNameBinding field::get_ref scope "bindings"
            v::get bindings def_id.index

fn selfhost_name_scope_fork_loop %impure fn &SelfhostNameScope impure fn Vec SelfhostNameBinding impure fn i32 impure fn i32 Result SelfhostNameScope StdErrorKind \scope\bindings\idx\count:
    if ge idx count:
        then: Result::Ok SelfhostNameScope bindings
        else match selfhost_name_scope_get scope selfhost_def_id_new idx:
            Option::None:
                v::free bindings
                Result::Err StdErrorKind::IndexOutOfBounds
            Option::Some binding:
                match v::push bindings binding:
                    Result::Err e:
                        let error %StdErrorKind field::get e "error"
                        v::free v::vec_push_error_vec e
                        Result::Err error
                    Result::Ok next: selfhost_name_scope_fork_loop scope next add idx 1 count

//: selfhost_name_scope_fork: DefId順序を保持したarm-local scope ownerを作る
pub fn selfhost_name_scope_fork %impure fn &SelfhostNameScope Result SelfhostNameScope StdErrorKind \scope:
    let result %Result Vec SelfhostNameBinding StdErrorKind v::new
    match result:
        Result::Err e: Result::Err e
        Result::Ok bindings: selfhost_name_scope_fork_loop scope bindings 0 selfhost_name_scope_len scope

//: selfhost_name_scope_find_loop: 指定名の binding を末尾から[探/さが]す
//:
//: [実装/じっそう]:
//: - 同一 scope 内の shadowing は後から追加された binding が優先されるため、末尾から線形探索します。
pub fn selfhost_name_scope_find_loop %fn &SelfhostNameScope fn str fn i32 Option SelfhostNameBinding \scope\name\idx:
    if:
        lt idx 0
        then:
            none
        else:
            match selfhost_name_scope_get scope selfhost_def_id_new idx:
                Option::Some binding:
                    match string_search::str_eq binding.name name:
                        true:
                            some binding
                        false:
                            selfhost_name_scope_find_loop scope name sub idx 1
                Option::None:
                    none

//: selfhost_name_scope_find: 指定名の最新 binding を[返/かえ]す
pub fn selfhost_name_scope_find %fn &SelfhostNameScope fn str Option SelfhostNameBinding \scope\name:
    selfhost_name_scope_find_loop scope name sub selfhost_name_scope_len scope 1

//: selfhost_name_scope_find_kind_loop: 指定名かつ指定 kind の binding を末尾から[探/さが]す
//:
//: [実装/じっそう]:
//: - 名前と `SelfhostDefKind` の両方が一致する binding だけを返します。
//: - value / type / trait のような名前空間を呼び出し側で分けたいときに使います。
pub fn selfhost_name_scope_find_kind_loop %fn &SelfhostNameScope fn str fn SelfhostDefKind fn i32 Option SelfhostNameBinding \scope\name\kind\idx:
    if:
        lt idx 0
        then:
            none
        else:
            match selfhost_name_scope_get scope selfhost_def_id_new idx:
                Option::Some binding:
                    match and string_search::str_eq binding.name name selfhost_def_kind_eq binding.kind kind:
                        true:
                            some binding
                        false:
                            selfhost_name_scope_find_kind_loop scope name kind sub idx 1
                Option::None:
                    none

//: selfhost_name_scope_find_kind: 指定名かつ指定 kind の最新 binding を[返/かえ]す
pub fn selfhost_name_scope_find_kind %fn &SelfhostNameScope fn str fn SelfhostDefKind Option SelfhostNameBinding \scope\name\kind:
    selfhost_name_scope_find_kind_loop scope name kind sub selfhost_name_scope_len scope 1

