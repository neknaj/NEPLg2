#indent 4

#import "core/option" as *
#import "neplg2/core/ty/ty" as *
#import "./model" as *

//: selfhost_builtin_signature_unary: 1 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_unary %fn SelfhostTypeKind fn SelfhostTypeKind SelfhostBuiltinSignature \arg0\result:
    SelfhostBuiltinSignature::Unary SelfhostBuiltinUnarySignature arg0 result

//: selfhost_builtin_signature_binary: 2 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_binary %fn SelfhostTypeKind fn SelfhostTypeKind fn SelfhostTypeKind SelfhostBuiltinSignature \arg0\arg1\result:
    SelfhostBuiltinSignature::Binary SelfhostBuiltinBinarySignature arg0 arg1 result

//: selfhost_builtin_signature_ternary: 3 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_ternary %fn SelfhostTypeKind fn SelfhostTypeKind fn SelfhostTypeKind fn SelfhostTypeKind SelfhostBuiltinSignature \arg0\arg1\arg2\result:
    SelfhostBuiltinSignature::Ternary SelfhostBuiltinTernarySignature arg0 arg1 arg2 result

//: selfhost_builtin_function_arg_count: builtin function の引数数を[返/かえ]す
pub fn selfhost_builtin_function_arg_count %fn SelfhostBuiltinFunction i32 \builtin:
    match builtin.signature:
        SelfhostBuiltinSignature::Unary _sig:
            1
        SelfhostBuiltinSignature::Binary _sig:
            2
        SelfhostBuiltinSignature::Ternary _sig:
            3

//: selfhost_builtin_function_arg_kind: builtin function の指定引数 type kind を[返/かえ]す
pub fn selfhost_builtin_function_arg_kind %fn SelfhostBuiltinFunction fn i32 Option SelfhostTypeKind \builtin\index:
    match builtin.signature:
        SelfhostBuiltinSignature::Unary sig:
            match index:
                0:
                    some sig.arg0
                _:
                    none
        SelfhostBuiltinSignature::Binary sig:
            match index:
                0:
                    some sig.arg0
                1:
                    some sig.arg1
                _:
                    none
        SelfhostBuiltinSignature::Ternary sig:
            match index:
                0:
                    some sig.arg0
                1:
                    some sig.arg1
                2:
                    some sig.arg2
                _:
                    none

//: selfhost_builtin_function_result_kind: builtin function の戻り値 type kind を[返/かえ]す
pub fn selfhost_builtin_function_result_kind %fn SelfhostBuiltinFunction SelfhostTypeKind \builtin:
    match builtin.signature:
        SelfhostBuiltinSignature::Unary sig:
            sig.result
        SelfhostBuiltinSignature::Binary sig:
            sig.result
        SelfhostBuiltinSignature::Ternary sig:
            sig.result
