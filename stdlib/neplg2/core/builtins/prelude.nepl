#indent 4

//: # prelude
//: NEPLg2.0 self-host compiler が扱う builtins / intrinsic / prelude 情報を置くモジュールです。
//:
//: [目的/もくてき]:
//: - primitive type、compiler builtin、default prelude の登録境界を固定します。
//: - Rust 側 `builtins.rs` が公開している builtin function の名前、kind、arity、引数型、戻り値型、effect を self-host 側から型付きで参照できるようにします。
//: - resolver / checker が builtin と primitive の registry 定義を重複実装しないよう、有限集合の index lookup API をここへ集約します。
//:
//: [実装/じっそう]:
//: - builtin kind は enum で表し、関数 registry は arity ごとの signature enum payload と固定 index lookup で表します。
//: - 現時点の Rust builtin function は `alloc` / `dealloc` / `realloc` の 3 件です。
//: - string-based lookup は `str_addr` / `alloc/string` の RawMemoryLoadCell gate 対応後に追加します。現段階では文字列依存を避け、registry の index と typed metadata を先に固定します。
//:
//: [注意/ちゅうい]:
//: - `MemLoadI32` / `MemStoreI32` は Rust 側 `BuiltinKind` には存在しますが、現在の `builtins()` registry には登録されていません。低レベル load/store は stdlib の inline wasm 経由で扱います。
//: - primitive name registry は `SelfhostTypeKind` が現在表現できる primitive と named numeric alias を持ちます。struct / enum / type variable などは type layer の後続 issue で追加します。
//: - name からの lookup は `ISS-20260428T213732897Z-RAWMEMORYLOADCELL-GATE-REJECTS-INITI-6041ACF2` の解消後に、`str_eq` / `hash32` を使う形で追加します。
//: - builtin の raw memory effect model は static checker 側の Resource IR と同期する必要があります。ここでは現行 Rust surface の metadata を固定します。
//:
//: [計算量/けいさんりょう]:
//: - index lookup は O(1) です。
//: - registry 比較は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/option" as *
//:| #import "neplg2/core/builtins/prelude" as *
//:| #import "neplg2/core/ty/ty" as *
//: fn main <()->i32> ():
//:     selfhost_prelude_stage0
//: ```

#import "core/math" as *
#import "core/option" as *
#import "core/traits/copy" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostBuiltinKind: compiler builtin の分類
//:
//: [目的/もくてき]:
//: - builtin function の意味を文字列ではなく enum で表します。
//: - Rust 側 `BuiltinKind` と同じ分類を self-host 側に置き、後続の resolver / checker / codegen が match で網羅的に扱えるようにします。
pub enum SelfhostBuiltinKind:
    MemAlloc
    MemDealloc
    MemRealloc
    MemLoadI32
    MemStoreI32

impl Clone for SelfhostBuiltinKind:
    fn clone <(&SelfhostBuiltinKind)->SelfhostBuiltinKind> (self):
        *self

impl Copy for SelfhostBuiltinKind:
    fn copy_mark <(SelfhostBuiltinKind)->SelfhostBuiltinKind> (self):
        self

//: SelfhostBuiltinUnarySignature: 1 引数 builtin function の signature
//:
//: [目的/もくてき]:
//: - 存在する引数だけを payload として保持し、未使用 slot や sentinel type を builtin metadata から排除します。
pub struct SelfhostBuiltinUnarySignature:
    arg0 <SelfhostTypeKind>
    result <SelfhostTypeKind>

impl Clone for SelfhostBuiltinUnarySignature:
    fn clone <(&SelfhostBuiltinUnarySignature)->SelfhostBuiltinUnarySignature> (self):
        *self

impl Copy for SelfhostBuiltinUnarySignature:
    fn copy_mark <(SelfhostBuiltinUnarySignature)->SelfhostBuiltinUnarySignature> (self):
        self

//: SelfhostBuiltinBinarySignature: 2 引数 builtin function の signature
//:
//: [目的/もくてき]:
//: - binary builtin の引数列と戻り値を、arity と常に一致する payload として保持します。
pub struct SelfhostBuiltinBinarySignature:
    arg0 <SelfhostTypeKind>
    arg1 <SelfhostTypeKind>
    result <SelfhostTypeKind>

impl Clone for SelfhostBuiltinBinarySignature:
    fn clone <(&SelfhostBuiltinBinarySignature)->SelfhostBuiltinBinarySignature> (self):
        *self

impl Copy for SelfhostBuiltinBinarySignature:
    fn copy_mark <(SelfhostBuiltinBinarySignature)->SelfhostBuiltinBinarySignature> (self):
        self

//: SelfhostBuiltinTernarySignature: 3 引数 builtin function の signature
//:
//: [目的/もくてき]:
//: - ternary builtin の引数列と戻り値を、余分な field を持たない payload として保持します。
pub struct SelfhostBuiltinTernarySignature:
    arg0 <SelfhostTypeKind>
    arg1 <SelfhostTypeKind>
    arg2 <SelfhostTypeKind>
    result <SelfhostTypeKind>

impl Clone for SelfhostBuiltinTernarySignature:
    fn clone <(&SelfhostBuiltinTernarySignature)->SelfhostBuiltinTernarySignature> (self):
        *self

impl Copy for SelfhostBuiltinTernarySignature:
    fn copy_mark <(SelfhostBuiltinTernarySignature)->SelfhostBuiltinTernarySignature> (self):
        self

//: SelfhostBuiltinSignature: builtin function の arity-specific signature
//:
//: [目的/もくてき]:
//: - builtin signature を固定長 slot ではなく enum payload で表し、arity と引数 payload の不一致を構造上作れないようにします。
//: - accessor はこの enum を match するため、新しい arity を追加した場合に処理漏れを静的に発見しやすくします。
pub enum SelfhostBuiltinSignature:
    Unary <SelfhostBuiltinUnarySignature>
    Binary <SelfhostBuiltinBinarySignature>
    Ternary <SelfhostBuiltinTernarySignature>

impl Clone for SelfhostBuiltinSignature:
    fn clone <(&SelfhostBuiltinSignature)->SelfhostBuiltinSignature> (self):
        *self

impl Copy for SelfhostBuiltinSignature:
    fn copy_mark <(SelfhostBuiltinSignature)->SelfhostBuiltinSignature> (self):
        self

//: SelfhostBuiltinFunction: builtin function registry の 1 件
//:
//: [目的/もくてき]:
//: - builtin の名前、分類、signature metadata、effect metadata を小さな Copy record として保持します。
//:
//: [注意/ちゅうい]:
//: - 引数列は `SelfhostBuiltinSignature` の payload に集約し、存在しない引数 slot を表現しません。
//: - `pure` は現行 Rust builtin registry の effect を固定するための field です。Resource IR 側で effect model が変わった場合はこの registry も同時に更新します。
pub struct SelfhostBuiltinFunction:
    name <str>
    kind <SelfhostBuiltinKind>
    signature <SelfhostBuiltinSignature>
    pure <bool>

impl Clone for SelfhostBuiltinFunction:
    fn clone <(&SelfhostBuiltinFunction)->SelfhostBuiltinFunction> (self):
        *self

impl Copy for SelfhostBuiltinFunction:
    fn copy_mark <(SelfhostBuiltinFunction)->SelfhostBuiltinFunction> (self):
        self

//: SelfhostPrimitiveTypeName: primitive type の canonical name
//:
//: [目的/もくてき]:
//: - primitive type の名前解決と表示に使う canonical name を `SelfhostTypeKind` と対応付けます。
//: - source parser が `()` のような専用 token で扱う型でも、registry 上の canonical name は `unit` として保持します。
pub struct SelfhostPrimitiveTypeName:
    name <str>
    kind <SelfhostTypeKind>

impl Clone for SelfhostPrimitiveTypeName:
    fn clone <(&SelfhostPrimitiveTypeName)->SelfhostPrimitiveTypeName> (self):
        *self

impl Copy for SelfhostPrimitiveTypeName:
    fn copy_mark <(SelfhostPrimitiveTypeName)->SelfhostPrimitiveTypeName> (self):
        self

//: selfhost_builtin_kind_eq: builtin kind が同じ分類か[返/かえ]す
//:
//: [目的/もくてき]:
//: - enum を i32 tag に落とさず、variant を直接 match して比較します。
//: - 新しい builtin kind を追加した場合、比較関数も match の分岐として更新する必要があります。
pub fn selfhost_builtin_kind_eq <(SelfhostBuiltinKind,SelfhostBuiltinKind)->bool> (a, b):
    match a:
        SelfhostBuiltinKind::MemAlloc:
            match b:
                SelfhostBuiltinKind::MemAlloc:
                    true
                SelfhostBuiltinKind::MemDealloc:
                    false
                SelfhostBuiltinKind::MemRealloc:
                    false
                SelfhostBuiltinKind::MemLoadI32:
                    false
                SelfhostBuiltinKind::MemStoreI32:
                    false
        SelfhostBuiltinKind::MemDealloc:
            match b:
                SelfhostBuiltinKind::MemAlloc:
                    false
                SelfhostBuiltinKind::MemDealloc:
                    true
                SelfhostBuiltinKind::MemRealloc:
                    false
                SelfhostBuiltinKind::MemLoadI32:
                    false
                SelfhostBuiltinKind::MemStoreI32:
                    false
        SelfhostBuiltinKind::MemRealloc:
            match b:
                SelfhostBuiltinKind::MemAlloc:
                    false
                SelfhostBuiltinKind::MemDealloc:
                    false
                SelfhostBuiltinKind::MemRealloc:
                    true
                SelfhostBuiltinKind::MemLoadI32:
                    false
                SelfhostBuiltinKind::MemStoreI32:
                    false
        SelfhostBuiltinKind::MemLoadI32:
            match b:
                SelfhostBuiltinKind::MemAlloc:
                    false
                SelfhostBuiltinKind::MemDealloc:
                    false
                SelfhostBuiltinKind::MemRealloc:
                    false
                SelfhostBuiltinKind::MemLoadI32:
                    true
                SelfhostBuiltinKind::MemStoreI32:
                    false
        SelfhostBuiltinKind::MemStoreI32:
            match b:
                SelfhostBuiltinKind::MemAlloc:
                    false
                SelfhostBuiltinKind::MemDealloc:
                    false
                SelfhostBuiltinKind::MemRealloc:
                    false
                SelfhostBuiltinKind::MemLoadI32:
                    false
                SelfhostBuiltinKind::MemStoreI32:
                    true

//: selfhost_builtin_signature_unary: 1 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_unary <(SelfhostTypeKind,SelfhostTypeKind)->SelfhostBuiltinSignature> (arg0, result):
    SelfhostBuiltinSignature::Unary SelfhostBuiltinUnarySignature arg0 result

//: selfhost_builtin_signature_binary: 2 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_binary <(SelfhostTypeKind,SelfhostTypeKind,SelfhostTypeKind)->SelfhostBuiltinSignature> (arg0, arg1, result):
    SelfhostBuiltinSignature::Binary SelfhostBuiltinBinarySignature arg0 arg1 result

//: selfhost_builtin_signature_ternary: 3 引数 builtin signature を[作/つく]る
pub fn selfhost_builtin_signature_ternary <(SelfhostTypeKind,SelfhostTypeKind,SelfhostTypeKind,SelfhostTypeKind)->SelfhostBuiltinSignature> (arg0, arg1, arg2, result):
    SelfhostBuiltinSignature::Ternary SelfhostBuiltinTernarySignature arg0 arg1 arg2 result

//: selfhost_builtin_function_new: builtin function record を[作/つく]る
pub fn selfhost_builtin_function_new <(str,SelfhostBuiltinKind,SelfhostBuiltinSignature,bool)->SelfhostBuiltinFunction> (name, kind, signature, pure):
    SelfhostBuiltinFunction name kind signature pure

//: selfhost_builtin_function_alloc: `alloc(size: i32) -> i32` の metadata を[返/かえ]す
pub fn selfhost_builtin_function_alloc <()->SelfhostBuiltinFunction> ():
    selfhost_builtin_function_new "alloc" SelfhostBuiltinKind::MemAlloc selfhost_builtin_signature_unary SelfhostTypeKind::I32 SelfhostTypeKind::I32 true

//: selfhost_builtin_function_dealloc: `dealloc(ptr: i32, size: i32) -> unit` の metadata を[返/かえ]す
pub fn selfhost_builtin_function_dealloc <()->SelfhostBuiltinFunction> ():
    selfhost_builtin_function_new "dealloc" SelfhostBuiltinKind::MemDealloc selfhost_builtin_signature_binary SelfhostTypeKind::I32 SelfhostTypeKind::I32 SelfhostTypeKind::Unit true

//: selfhost_builtin_function_realloc: `realloc(ptr: i32, old: i32, new: i32) -> i32` の metadata を[返/かえ]す
pub fn selfhost_builtin_function_realloc <()->SelfhostBuiltinFunction> ():
    selfhost_builtin_function_new "realloc" SelfhostBuiltinKind::MemRealloc selfhost_builtin_signature_ternary SelfhostTypeKind::I32 SelfhostTypeKind::I32 SelfhostTypeKind::I32 SelfhostTypeKind::I32 true

//: selfhost_builtin_function_count: registry に登録された builtin function 数を[返/かえ]す
pub fn selfhost_builtin_function_count <()->i32> ():
    3

//: selfhost_builtin_function_at: registry index から builtin function を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - index は 0 から始まります。範囲外なら `None` です。
pub fn selfhost_builtin_function_at <(i32)->Option<SelfhostBuiltinFunction>> (index):
    match index:
        0:
            some<SelfhostBuiltinFunction> selfhost_builtin_function_alloc
        1:
            some<SelfhostBuiltinFunction> selfhost_builtin_function_dealloc
        2:
            some<SelfhostBuiltinFunction> selfhost_builtin_function_realloc
        _:
            none<SelfhostBuiltinFunction>

//: selfhost_builtin_function_arg_count: builtin function の引数数を[返/かえ]す
pub fn selfhost_builtin_function_arg_count <(SelfhostBuiltinFunction)->i32> (builtin):
    match builtin.signature:
        SelfhostBuiltinSignature::Unary _sig:
            1
        SelfhostBuiltinSignature::Binary _sig:
            2
        SelfhostBuiltinSignature::Ternary _sig:
            3

//: selfhost_builtin_function_arg_kind: builtin function の指定引数 type kind を[返/かえ]す
pub fn selfhost_builtin_function_arg_kind <(SelfhostBuiltinFunction,i32)->Option<SelfhostTypeKind>> (builtin, index):
    match builtin.signature:
        SelfhostBuiltinSignature::Unary sig:
            match index:
                0:
                    some<SelfhostTypeKind> sig.arg0
                _:
                    none<SelfhostTypeKind>
        SelfhostBuiltinSignature::Binary sig:
            match index:
                0:
                    some<SelfhostTypeKind> sig.arg0
                1:
                    some<SelfhostTypeKind> sig.arg1
                _:
                    none<SelfhostTypeKind>
        SelfhostBuiltinSignature::Ternary sig:
            match index:
                0:
                    some<SelfhostTypeKind> sig.arg0
                1:
                    some<SelfhostTypeKind> sig.arg1
                2:
                    some<SelfhostTypeKind> sig.arg2
                _:
                    none<SelfhostTypeKind>

//: selfhost_builtin_function_result_kind: builtin function の戻り値 type kind を[返/かえ]す
pub fn selfhost_builtin_function_result_kind <(SelfhostBuiltinFunction)->SelfhostTypeKind> (builtin):
    match builtin.signature:
        SelfhostBuiltinSignature::Unary sig:
            sig.result
        SelfhostBuiltinSignature::Binary sig:
            sig.result
        SelfhostBuiltinSignature::Ternary sig:
            sig.result

//: selfhost_builtin_function_is_pure: builtin function が現行 registry 上 pure か[返/かえ]す
pub fn selfhost_builtin_function_is_pure <(SelfhostBuiltinFunction)->bool> (builtin):
    builtin.pure

//: selfhost_primitive_type_name_new: primitive type name record を[作/つく]る
pub fn selfhost_primitive_type_name_new <(str,SelfhostTypeKind)->SelfhostPrimitiveTypeName> (name, kind):
    SelfhostPrimitiveTypeName name kind

//: selfhost_primitive_type_count: registry に登録された primitive type name 数を[返/かえ]す
pub fn selfhost_primitive_type_count <()->i32> ():
    10

//: selfhost_primitive_type_at: registry index から primitive type name を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - index は 0 から始まります。範囲外なら `None` です。
pub fn selfhost_primitive_type_at <(i32)->Option<SelfhostPrimitiveTypeName>> (index):
    match index:
        0:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "unit" SelfhostTypeKind::Unit
        1:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "bool" SelfhostTypeKind::Bool
        2:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "i32" SelfhostTypeKind::I32
        3:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "i64" SelfhostTypeKind::I64
        4:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "u8" SelfhostTypeKind::U8
        5:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "char" SelfhostTypeKind::Char
        6:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "str" SelfhostTypeKind::Str
        7:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "f32" SelfhostTypeKind::F32
        8:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "f64" SelfhostTypeKind::F64
        9:
            some<SelfhostPrimitiveTypeName> selfhost_primitive_type_name_new "never" SelfhostTypeKind::Never
        _:
            none<SelfhostPrimitiveTypeName>

//: selfhost_default_prelude_path: Rust loader と同じ default prelude path を[返/かえ]す
pub fn selfhost_default_prelude_path <()->str> ():
    "std/prelude_base"

//: selfhost_prelude_stage0_char_ok: primitive registry に `char` があるか[返/かえ]す
pub fn selfhost_prelude_stage0_char_ok <()->bool> ():
    match selfhost_primitive_type_at 5:
        Option::Some primitive:
            selfhost_type_kind_eq primitive.kind SelfhostTypeKind::Char
        Option::None:
            false

//: selfhost_prelude_stage0_float_never_ok: primitive registry に floating / never type があるか[返/かえ]す
pub fn selfhost_prelude_stage0_float_never_ok <()->bool> ():
    match selfhost_primitive_type_at 7:
        Option::Some f32_primitive:
            match selfhost_primitive_type_at 8:
                Option::Some f64_primitive:
                    match selfhost_primitive_type_at 9:
                        Option::Some never_primitive:
                            let f32_ok <bool> selfhost_type_kind_eq f32_primitive.kind SelfhostTypeKind::F32
                            let f64_ok <bool> selfhost_type_kind_eq f64_primitive.kind SelfhostTypeKind::F64
                            let never_ok <bool> selfhost_type_kind_eq never_primitive.kind SelfhostTypeKind::Never
                            and f32_ok and f64_ok never_ok
                        Option::None:
                            false
                Option::None:
                    false
        Option::None:
            false

//: selfhost_prelude_stage0_alloc_ok: `alloc` builtin metadata が Rust surface と合うか[返/かえ]す
pub fn selfhost_prelude_stage0_alloc_ok <()->bool> ():
    match selfhost_builtin_function_at 0:
        Option::Some builtin:
            if:
                not selfhost_builtin_kind_eq builtin.kind SelfhostBuiltinKind::MemAlloc
                then:
                    false
                else:
                    if:
                        not eq selfhost_builtin_function_arg_count builtin 1
                        then:
                            false
                        else:
                            match selfhost_builtin_function_arg_kind builtin 0:
                                Option::Some arg0:
                                    let arg_ok <bool> selfhost_type_kind_eq arg0 SelfhostTypeKind::I32
                                    let result_ok <bool> selfhost_type_kind_eq selfhost_builtin_function_result_kind builtin SelfhostTypeKind::I32
                                    and arg_ok and result_ok selfhost_builtin_function_is_pure builtin
                                Option::None:
                                    false
        Option::None:
            false

//: selfhost_prelude_stage0_realloc_ok: `realloc` builtin metadata が Rust surface と合うか[返/かえ]す
pub fn selfhost_prelude_stage0_realloc_ok <()->bool> ():
    match selfhost_builtin_function_at 2:
        Option::Some builtin:
            if:
                not eq selfhost_builtin_function_arg_count builtin 3
                then:
                    false
                else:
                    match selfhost_builtin_function_arg_kind builtin 2:
                        Option::Some arg2:
                            selfhost_type_kind_eq arg2 SelfhostTypeKind::I32
                        Option::None:
                            false
        Option::None:
            false

//: selfhost_prelude_stage0_no_extra_builtin_ok: 範囲外 index が `None` か[返/かえ]す
pub fn selfhost_prelude_stage0_no_extra_builtin_ok <()->bool> ():
    is_none<SelfhostBuiltinFunction> selfhost_builtin_function_at 3

//: selfhost_prelude_stage0: builtins / prelude registry の最小 sanity check
pub fn selfhost_prelude_stage0 <()->i32> ():
    if:
        not eq selfhost_primitive_type_count 10
        then:
            1
        else:
            if:
                not eq selfhost_builtin_function_count 3
                then:
                    1
                else:
                    if:
                        not selfhost_prelude_stage0_char_ok
                        then:
                            1
                        else:
                            let primitive_ok <bool> selfhost_prelude_stage0_float_never_ok
                            let builtin_ok <bool> and selfhost_prelude_stage0_alloc_ok selfhost_prelude_stage0_realloc_ok
                            let registry_ok <bool> and builtin_ok selfhost_prelude_stage0_no_extra_builtin_ok
                            if:
                                and primitive_ok registry_ok
                                then:
                                    0
                                else:
                                    1
