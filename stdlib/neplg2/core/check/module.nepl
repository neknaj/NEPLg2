#indent 4

//: # check/module
//: NEPLg2.0 self-host compiler の module item stream [検査/けんさ]を置くモジュールです。
//:
//: [目的/もくてき]:
//: - parser が作った `SelfhostModuleAst` を、後続の resolve / type / effect / Resource IR に渡す前に typed item stream として検査します。
//: - 検査は `SelfhostModuleItemKind` の exhaustive match と `core/proof` の typed proof query で行い、文字列 kind や module 名 allowlist を証明として扱いません。
//: - この file は public facade に限定し、実装本体は summary / proof adapter / diagnostic / orchestration ごとの submodule に分けます。
//:
//: [注意/ちゅうい]:
//: - ここで行うのは module item stream の整合性検査と集計です。source span のような汎用 property は `core/proof/` の typed query を通し、型推論、trait coherence、effect、owner / borrow / initialized の証明も後続 stage が同じ proof boundary と Resource IR を通して行います。
//: - raw backend text は対応する `#wasm:` / `#llvmir:` item の直後の raw block 内にあることだけを確認します。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: item 数 n に対して O(n)。
//: - [空間/くうかん]: 集計値と raw block 状態だけを持つため O(1)。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_module_ast_new:
//:         Result::Ok ast0:
//:             let entry %SelfhostModuleItem selfhost_module_item_new SelfhostModuleItemKind::EntryDirective source_span_new 0 0 11 "#entry main"
//:             match selfhost_module_ast_push ast0 entry:
//:                 Result::Ok ast1:
//:                     let head %SelfhostModuleDeclarationHead selfhost_module_declaration_head_new SelfhostModuleDeclarationHeadKind::Name source_span_new 0 15 19
//:                     let header %SelfhostModuleDeclarationHeader selfhost_module_declaration_header_new SelfhostModuleDeclarationKind::Function SelfhostModuleDeclarationVisibility::Private source_span_new 0 12 19 source_span_new 0 12 14 some head
//:                     let decl %SelfhostModuleItem selfhost_module_item_new_with_declaration SelfhostModuleItemKind::FunctionDecl "fn main" header
//:                     match selfhost_module_ast_push ast1 decl:
//:                         Result::Ok ast2:
//:                             match selfhost_check_module_ast &ast2:
//:                                 Result::Ok summary:
//:                                     let n %i32 selfhost_module_check_summary_item_count summary
//:                                     selfhost_module_ast_free ast2
//:                                     if eq n 2 0 1
//:                                 Result::Err _diag:
//:                                     selfhost_module_ast_free ast2
//:                                     1
//:                         Result::Err _e:
//:                             1
//:                 Result::Err _e:
//:                     1
//:         Result::Err _e:
//:             1
//: ```

pub #import "./module/summary" as *
pub #import "./module/orchestrate" as *
