            let second_binding %SelfhostNameBinding selfhost_name_binding_pending "make" SelfhostDefKind::Function span
            let second_added %SelfhostNameScopeAddResult unwrap_ok selfhost_name_scope_add_binding scope1 second_binding
            let second_def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &second_added
