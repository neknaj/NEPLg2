    let choice_span %SelfhostSourceSpan source_span_new_unchecked 0 9 15
    let other_span %SelfhostSourceSpan source_span_new_unchecked 0 36 41
    let generic_span %SelfhostSourceSpan source_span_new_unchecked 0 61 68
    let constructors0 %SelfhostTypeConstructorTable unwrap_ok selfhost_type_constructor_table_new
    let choice_added %SelfhostTypeConstructorAddResult unwrap_ok selfhost_type_constructor_table_add_checked constructors0 "Choice" 0 choice_span
    let choice_id %SelfhostNamedTypeId selfhost_type_constructor_add_result_nominal_id &choice_added
    let constructors1 %SelfhostTypeConstructorTable selfhost_type_constructor_add_result_into_table choice_added
    let other_added %SelfhostTypeConstructorAddResult unwrap_ok selfhost_type_constructor_table_add_checked constructors1 "Other" 0 other_span
    let other_id %SelfhostNamedTypeId selfhost_type_constructor_add_result_nominal_id &other_added
    let constructors2 %SelfhostTypeConstructorTable selfhost_type_constructor_add_result_into_table other_added
    let generic_added %SelfhostTypeConstructorAddResult unwrap_ok selfhost_type_constructor_table_add_checked constructors2 "Generic" 1 generic_span
    let generic_id %SelfhostNamedTypeId selfhost_type_constructor_add_result_nominal_id &generic_added
    let constructors %SelfhostTypeConstructorTable selfhost_type_constructor_add_result_into_table generic_added
    let arena0 %SelfhostTypeArena unwrap_ok selfhost_type_arena_new
    let choice_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_named arena0 choice_id
    let choice_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &choice_alloc
    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena choice_alloc
    let other_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_named arena1 other_id
    let other_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &other_alloc
    let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena other_alloc
    let i32_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_primitive arena2 SelfhostPrimitiveTypeKind::I32
    let i32_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &i32_alloc
    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena i32_alloc
    let generic_args0 %Vec SelfhostTypeId unwrap_ok v::new
    let generic_args %Vec SelfhostTypeId unwrap_ok v::push generic_args0 i32_type
    let generic_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_applied_named arena3 generic_id generic_args
    let generic_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &generic_alloc
    let arena4 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena generic_alloc
    let first_result_type %SelfhostTypeId if eq mode 1 generic_type choice_type
    let choice_params %Vec SelfhostTypeId unwrap_ok v::new
    let choice_fn_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_function arena4 choice_params first_result_type
    let choice_fn %SelfhostTypeId selfhost_type_arena_alloc_type_id &choice_fn_alloc
    let arena5 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena choice_fn_alloc
    let other_params %Vec SelfhostTypeId unwrap_ok v::new
    let other_fn_alloc %SelfhostTypeArenaAlloc unwrap_ok selfhost_type_arena_add_function arena5 other_params other_type
    let other_fn %SelfhostTypeId selfhost_type_arena_alloc_type_id &other_fn_alloc
    let arena %SelfhostTypeArena selfhost_type_arena_alloc_into_arena other_fn_alloc
    let scope0 %SelfhostNameScope unwrap_ok selfhost_name_scope_new
    let first_added %SelfhostNameScopeAddResult unwrap_ok selfhost_name_scope_add_binding scope0 selfhost_name_binding_pending "make" SelfhostDefKind::Function choice_span
    let choice_def %SelfhostDefId selfhost_name_scope_add_result_def_id &first_added
    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope first_added
    let second_added %SelfhostNameScopeAddResult unwrap_ok selfhost_name_scope_add_binding scope1 selfhost_name_binding_pending "make" SelfhostDefKind::Function other_span
    let other_def %SelfhostDefId selfhost_name_scope_add_result_def_id &second_added
    let scope %SelfhostNameScope selfhost_name_scope_add_result_into_scope second_added
    let signatures0 %SelfhostCallableSignatureTable unwrap_ok selfhost_callable_signature_table_new
    let signatures1 %SelfhostCallableSignatureTable unwrap_ok selfhost_callable_signature_table_add signatures0 selfhost_callable_signature_new choice_def choice_fn SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired choice_span
    let signatures %SelfhostCallableSignatureTable unwrap_ok selfhost_callable_signature_table_add signatures1 selfhost_callable_signature_new other_def other_fn SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired other_span
    let candidates0 %Vec SelfhostCallableCandidate unwrap_ok v::new
    let candidates1 %Vec SelfhostCallableCandidate unwrap_ok v::push candidates0 selfhost_callable_candidate_new "make" choice_def choice_fn SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired choice_span
    let candidates %Vec SelfhostCallableCandidate unwrap_ok v::push candidates1 selfhost_callable_candidate_new "make" other_def other_fn SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired other_span
    let value_types %SelfhostValueTypeEvidenceTable unwrap_ok selfhost_value_type_evidence_table_new
    let child_source "pub enum Choice:\n    First\npub enum Other:\n    Only\npub enum Generic<.T>:\n    Item %.T\n"
    let root_source %str if:
        eq mode 0
        then: "#import \"Child\" as child\nfn choose %fn void i32 \\void:\n    match make:\n        child::Choice::First:\n            0\n"
        else:
            if:
                eq mode 1
                then: "#import \"Child\" as child\nfn generic_first %fn void i32 \\void:\n    match make:\n        child::Generic::Item value:\n            0\n        child::Other::Only:\n            1\n"
                else: "#import \"Child\" as child\nfn nondirect_first %fn void i32 \\void:\n    match make:\n        Choice::First:\n            0\n        child::Other::Only:\n            1\n"
    let vfs0 %SelfhostVirtualFileSystem unwrap_ok selfhost_vfs_new
    let vfs1 %SelfhostVirtualFileSystem unwrap_ok selfhost_vfs_add vfs0 "Child" child_source
    let vfs %SelfhostVirtualFileSystem unwrap_ok selfhost_vfs_add vfs1 "Root" root_source
    let graph %SelfhostModuleGraph unwrap_ok selfhost_build_module_graph &vfs "Root"
    let order %SelfhostModuleOrder unwrap_ok selfhost_module_order_build &graph &vfs
    let first_ambiguous %bool match selfhost_type_arena_fork &arena:
        Result::Err _e: false
        Result::Ok probe_arena:
            match selfhost_match_context_from_vfs &vfs "Root" 0 0:
                Result::Err _e:
                    selfhost_type_arena_free probe_arena
                    false
                Result::Ok probe_context:
                    let probed %Result SelfhostMatchCheckedScrutineeParts SelfhostMatchCheckedScrutineeError selfhost_match_checked_scrutinee_result &probe_context &constructors probe_arena &scope &value_types &signatures &candidates
                    selfhost_match_context_free probe_context
                    match probed:
                        Result::Ok parts:
                            selfhost_match_checked_scrutinee_parts_free parts
