//: - success payload は direct call であることと、checked argument が function value evidence であることの両方を満たす必要があります。
//: - `add_type` と `takes_type` は固定 fixture の monomorphic function type であり、generic function value はこの helper の対象外です。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `takes` call が1引数 direct call として成功し、その引数が function value として記録されました。
//: - `false`: setup、candidate collection、reducer、または success payload のいずれかが期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - helper の fixture setup は O(1) です。reducer 内部は prefix item 数、candidate 数、function value candidate 照合に従います。
fn selfhost_check_expr_stage1_function_value_argument_ok_with_scope %impure fn Vec SelfhostToken impure fn SelfhostTypeArena impure fn SelfhostTypeId impure fn SelfhostTypeId bool \tokens\arena\add_type\takes_type:
    let segment %SelfhostBodySegment selfhost_check_expr_stage1_function_value_argument_segment
    match selfhost_check_expr_stage1_make_named_candidate_vec "takes" takes_type:
        Result::Ok candidates:
            let add_span %SelfhostSourceSpan source_span_new_unchecked 0 7 10
            match selfhost_check_expr_stage1_value_context_with_function "add" add_type add_span:
                Result::Ok context:
                    match selfhost_check_expr_stage1_reduce_body_segment_with_value_context &tokens "takes @add" segment arena context &candidates none:
                        Result::Ok success:
                            let ok %bool and selfhost_check_expr_stage1_success_is_one_arg_direct_call &success selfhost_check_expr_stage1_success_has_function_value_argument &success
                            selfhost_expression_line_check_success_free success
                            v::free candidates
                            v::free tokens
                            ok
                        Result::Err _e:
                            v::free candidates
                            v::free tokens
                            false
                Result::Err _e:
                    selfhost_type_arena_free arena
                    v::free candidates
                    v::free tokens
                    false
        Result::Err _e:
