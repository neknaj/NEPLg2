#indent 4

//: # check/expr/stage1
//: body expression line から call reduction までの smoke test API を置く module です。
//:
//: [目的/もくてき]:
//: - token buffer、`SelfhostBodySegmentKind::ExpressionLine`、type arena、callable candidate を組み合わせ、`body_line.nepl` の接続が実際に direct call plan を返すことを確認します。
//: - `BlockIntro` を誤って expression line reduction へ渡した場合に、typed error として拒否されることを確認します。
//: - `%i32 add 1 2` のような明示 type ascription が、`%` を call reduction へ渡さず expected type と内側 expression range に分解されることを確認します。
//: - `add %i32 1 2` のような argument-scope ascription が、raw prefix item 数ではなく実引数式 cursor と source-backed ascription checker で縮約されることを確認します。
//: - `takes @add` のような明示 function value argument が、expected function type と named callable signature の一致でだけ縮約されることを確認します。
//: - `takes add` のような bare function name は、NEPLg2.1 の no partial application 規則に従って function value へ暗黙変換されないことを確認します。
//:
//: [契約/けいやく]:
//: - この module は focused smoke helper だけを持ち、production の接続規則は `body_line.nepl` に置きます。
//: - fixture は `SelfhostToken` と `SelfhostBodySegment` を直接作り、lexer と module parser の詳細はそれぞれの doctest に任せます。
//: - smoke helper は所有する type arena、candidate vec、token vec をすべて閉じてから整数 status を返します。
//:
//: [計算量/けいさんりょう]:
//: - 固定 source `"add 1 2"` の token 数と固定 candidate 数だけを扱うため O(1) です。

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/ast/prefix_expr" as *
#import "neplg2/core/syntax/parser/body_segmenter" as *
#import "neplg2/core/syntax/token" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *
#import "./expectation" as *
#import "./call_candidate" as *
#import "./candidate_collection" as *
#import "./value_evidence" as *
#import "./argument_payload" as *
#import "./model" as *
#import "./body_line" as *

//: SelfhostCheckExprStage1ValueContext: smoke helper 用の scope と値型証拠 table
//:
//: [目的/もくてき]:
//: - source-backed reducer の入力である `SelfhostNameScope`、`SelfhostValueTypeEvidenceTable`、`SelfhostCallableSignatureTable` を、stage1 fixture 内で同じ owner lifetime として扱います。
//: - fixture が名前付き値を使わない場合でも、空 context を渡して production API と同じ呼び出し形を通します。
//:
//: [契約/けいやく]:
//: - この型は stage1 smoke helper 専用です。production checker の環境 model ではありません。
//: - `scope`、`value_types`、`signatures` は同じ checker phase で構築されたものとして扱い、関数終了時に必ず解放します。
struct SelfhostCheckExprStage1ValueContext:
    scope %SelfhostNameScope
    value_types %SelfhostValueTypeEvidenceTable
    signatures %SelfhostCallableSignatureTable

//: selfhost_check_expr_stage1_value_context_new: stage1 fixture context owner を[作/つく]る
//:
//: [目的/もくてき]:
//: - scope、value type evidence table、callable signature table を 1 つの aggregate にまとめ、source-backed expression checker helper へ同時に渡せるようにします。
//: - stage1 smoke helper 内の owner 移動を明示し、個別 table を引数列に並べることによる解放漏れを避けます。
//:
//: [契約/けいやく]:
//: - この constructor は渡された 3 つの owner を消費し、返した context owner の一部にします。
//: - 返した context は caller が `selfhost_check_expr_stage1_value_context_free` で閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - 所有済みの stage1 fixture context です。
//:
//: [計算量/けいさんりょう]:
//: - field を束ねるだけなので O(1) です。
fn selfhost_check_expr_stage1_value_context_new %impure fn SelfhostNameScope impure fn SelfhostValueTypeEvidenceTable impure fn SelfhostCallableSignatureTable SelfhostCheckExprStage1ValueContext \scope\value_types\signatures:
    SelfhostCheckExprStage1ValueContext scope value_types signatures

//: selfhost_check_expr_stage1_value_context_scope: context 内の scope borrow を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `selfhost_check_expr_reduce_body_segment_with_source` へ渡す名前解決 scope を、context owner から借用として取り出します。
//:
//: [戻/もど]り[値/ち]:
//: - context が所有する `SelfhostNameScope` への borrow です。caller は解放してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - field borrow だけなので O(1) です。
fn selfhost_check_expr_stage1_value_context_scope %fn &SelfhostCheckExprStage1ValueContext &SelfhostNameScope \context:
    field::get_ref context "scope"

//: selfhost_check_expr_stage1_value_context_value_types: context 内の value evidence table borrow を[返/かえ]す
//:
//: [目的/もくてき]:
//: - named value argument の型証拠を source-backed reducer に渡すため、context 内の table を借用で公開します。
//:
//: [戻/もど]り[値/ち]:
//: - context が所有する `SelfhostValueTypeEvidenceTable` への borrow です。caller は解放してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - field borrow だけなので O(1) です。
fn selfhost_check_expr_stage1_value_context_value_types %fn &SelfhostCheckExprStage1ValueContext &SelfhostValueTypeEvidenceTable \context:
    field::get_ref context "value_types"

//: selfhost_check_expr_stage1_value_context_signatures: context 内の callable signature table borrow を[返/かえ]す
//:
//: [目的/もくてき]:
//: - named callable や `@add` function value argument の候補収集で使う signature table を、context から借用で渡します。
//:
//: [戻/もど]り[値/ち]:
//: - context が所有する `SelfhostCallableSignatureTable` への borrow です。caller は解放してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - field borrow だけなので O(1) です。
fn selfhost_check_expr_stage1_value_context_signatures %fn &SelfhostCheckExprStage1ValueContext &SelfhostCallableSignatureTable \context:
    field::get_ref context "signatures"

//: selfhost_check_expr_stage1_value_context_free: stage1 fixture context owner を[閉/と]じる
//:
//: [目的/もくてき]:
//: - source-backed reducer helper の success / failure path で、scope、value evidence table、callable signature table をまとめて解放します。
//:
//: [契約/けいやく]:
//: - `context` owner を消費します。呼び出し後に accessor で中身を借用してはいけません。
//: - この関数は fixture context 専用の cleanup boundary であり、production checker environment の lifetime 管理は扱いません。
//:
//: [計算量/けいさんりょう]:
//: - 各 table の内部 buffer 解放に従います。stage1 fixture では固定小サイズのため O(1) です。
fn selfhost_check_expr_stage1_value_context_free %impure fn SelfhostCheckExprStage1ValueContext unit \context:
    selfhost_name_scope_free field::get context "scope"
    selfhost_value_type_evidence_table_free field::get context "value_types"
    selfhost_callable_signature_table_free field::get context "signatures"

//: selfhost_check_expr_stage1_empty_value_context: 空の stage1 fixture context を[作/つく]る
//:
//: [目的/もくてき]:
//: - 名前付き値や関数候補を使わない expression line smoke でも、production API と同じ context 引数を渡せるようにします。
//:
//: [契約/けいやく]:
//: - 成功時は caller が context owner を受け取り、`selfhost_check_expr_stage1_value_context_free` で閉じます。
//: - 途中の table 作成に失敗した場合、この helper が作成済み owner を閉じてから `StdErrorKind` を返します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(context)`: 空 scope、空 value evidence table、空 signature table を持つ context owner です。
//: - `Err(error)`: context 構築中の allocation 失敗です。
//:
//: [計算量/けいさんりょう]:
//: - 固定 3 table の作成だけなので O(1) です。
fn selfhost_check_expr_stage1_empty_value_context %impure fn void Result SelfhostCheckExprStage1ValueContext StdErrorKind \void:
    match selfhost_name_scope_new:
        Result::Ok scope:
            match selfhost_value_type_evidence_table_new:
                Result::Ok value_types:
                    match selfhost_callable_signature_table_new:
                        Result::Ok signatures:
                            Result::Ok selfhost_check_expr_stage1_value_context_new scope value_types signatures
                        Result::Err e:
                            selfhost_value_type_evidence_table_free value_types
                            selfhost_name_scope_free scope
                            Result::Err e
                Result::Err e:
                    selfhost_name_scope_free scope
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_value_context_with_binding_only: 型証拠を持たない local binding context を[作/つく]る
//:
//: [目的/もくてき]:
//: - scope には名前があるが value type evidence がない場合に、named argument reducer が missing evidence を fail-closed に扱うことを確認します。
//:
//: [契約/けいやく]:
//: - `selfhost_name_scope_add_binding` は入力 scope owner を消費します。失敗時の owner cleanup はその関数の契約に従います。
//: - table 作成の後段で失敗した場合、この helper が作成済み owner を閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(context)`: `name` の local binding だけを持ち、型証拠を持たない context owner です。
//: - `Err(error)`: binding 追加または table 作成に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 binding と空 table 2 個だけを作るため O(1) です。
fn selfhost_check_expr_stage1_value_context_with_binding_only %impure fn str impure fn SelfhostSourceSpan Result SelfhostCheckExprStage1ValueContext StdErrorKind \name\span:
    match selfhost_name_scope_new:
        Result::Ok scope0:
            let binding %SelfhostNameBinding selfhost_name_binding_pending name SelfhostDefKind::Local span
            match selfhost_name_scope_add_binding scope0 binding:
                Result::Ok added:
                    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope added
                    match selfhost_value_type_evidence_table_new:
                        Result::Ok value_types:
                            match selfhost_callable_signature_table_new:
                                Result::Ok signatures:
                                    Result::Ok selfhost_check_expr_stage1_value_context_new scope1 value_types signatures
                                Result::Err e:
                                    selfhost_value_type_evidence_table_free value_types
                                    selfhost_name_scope_free scope1
                                    Result::Err e
                        Result::Err e:
                            selfhost_name_scope_free scope1
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_value_context_with_typed_value: local binding と型証拠を持つ context を[作/つく]る
//:
//: [目的/もくてき]:
//: - named value argument が `SelfhostValueTypeEvidenceTable` を通じて expected type と照合される経路を fixture 化します。
//:
//: [契約/けいやく]:
//: - scope へ追加された `DefId` と value evidence の `DefId` は同じものを使います。
//: - `selfhost_name_scope_add_binding` と evidence table add は入力 owner を消費します。後段失敗時はこの helper が残った owner を閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(context)`: `name` の local binding と `value_type` evidence を持つ context owner です。
//: - `Err(error)`: binding 追加、evidence 追加、または table 作成に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 binding / 1 evidence / 空 signature table だけを作るため O(1) です。
fn selfhost_check_expr_stage1_value_context_with_typed_value %impure fn str impure fn SelfhostTypeId impure fn SelfhostSourceSpan Result SelfhostCheckExprStage1ValueContext StdErrorKind \name\value_type\span:
    match selfhost_name_scope_new:
        Result::Ok scope0:
            let binding %SelfhostNameBinding selfhost_name_binding_pending name SelfhostDefKind::Local span
            match selfhost_name_scope_add_binding scope0 binding:
                Result::Ok added:
                    let def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &added
                    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope added
                    match selfhost_value_type_evidence_table_new:
                        Result::Ok value_types0:
                            let evidence %SelfhostValueTypeEvidence selfhost_value_type_evidence_new def_id value_type span
                            match selfhost_value_type_evidence_table_add value_types0 evidence:
                                Result::Ok value_types1:
                                    match selfhost_callable_signature_table_new:
                                        Result::Ok signatures:
                                            Result::Ok selfhost_check_expr_stage1_value_context_new scope1 value_types1 signatures
                                        Result::Err e:
                                            selfhost_value_type_evidence_table_free value_types1
                                            selfhost_name_scope_free scope1
                                            Result::Err e
                                Result::Err e:
                                    selfhost_name_scope_free scope1
                                    Result::Err e
                        Result::Err e:
                            selfhost_name_scope_free scope1
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_value_context_with_function: function binding と callable signature を持つ context を[作/つく]る
//:
//: [目的/もくてき]:
//: - named callable reduction と `@name` function value argument が、scope の DefId から signature table へ到達する経路を fixture 化します。
//:
//: [契約/けいやく]:
//: - scope へ追加された function binding の DefId と callable signature の DefId は同じものを使います。
//: - signature は pure / monomorphic fixture として作ります。generic inference や impure callable の検査はこの helper の責務ではありません。
//: - `selfhost_name_scope_add_binding` が失敗した場合、入力 scope owner は callee が消費します。
//: - 成功時は context owner を返し、caller が `selfhost_check_expr_stage1_value_context_free` で scope、value evidence table、signature table を閉じます。
//: - `selfhost_callable_signature_table_add` が失敗した場合、入力 signature table owner は callee が消費します。この helper は残った value evidence table と scope を閉じます。
//: - signature table 作成そのものが失敗した場合、この helper が作成済みの value evidence table と scope を閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(context)`: `name` の function binding と `callable_type` signature を持つ context owner です。
//: - `Err(error)`: binding 追加、signature 追加、または table 作成に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 binding / 1 signature / 空 value evidence table だけを作るため O(1) です。
fn selfhost_check_expr_stage1_value_context_with_function %impure fn str impure fn SelfhostTypeId impure fn SelfhostSourceSpan Result SelfhostCheckExprStage1ValueContext StdErrorKind \name\callable_type\span:
    match selfhost_name_scope_new:
        Result::Ok scope0:
            let binding %SelfhostNameBinding selfhost_name_binding_pending name SelfhostDefKind::Function span
            match selfhost_name_scope_add_binding scope0 binding:
                Result::Ok added:
                    let def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &added
                    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope added
                    match selfhost_value_type_evidence_table_new:
                        Result::Ok value_types:
                            match selfhost_callable_signature_table_new:
                                Result::Ok signatures0:
                                    let signature %SelfhostCallableSignature selfhost_callable_signature_new def_id callable_type SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired span
                                    match selfhost_callable_signature_table_add signatures0 signature:
                                        Result::Ok signatures1:
                                            Result::Ok selfhost_check_expr_stage1_value_context_new scope1 value_types signatures1
                                        Result::Err e:
                                            selfhost_value_type_evidence_table_free value_types
                                            selfhost_name_scope_free scope1
                                            Result::Err e
                                Result::Err e:
                                    selfhost_value_type_evidence_table_free value_types
                                    selfhost_name_scope_free scope1
                                    Result::Err e
                        Result::Err e:
                            selfhost_name_scope_free scope1
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_value_context_with_shadowed_function_value: function を同名 local で shadow した context を[作/つく]る
//:
//: [目的/もくてき]:
//: - callable signature table には古い function signature が残っていても、scope の最新 binding が local value なら argument position では value evidence fallback が使われることを確認します。
//: - 候補収集が `find_kind(Function)` だけで古い function を復活させる退行を、stage1 smoke から検出できるようにします。
//:
//: [契約/けいやく]:
//: - 成功時は scope、value evidence table、callable signature table をまとめた context owner を返し、caller が `selfhost_check_expr_stage1_value_context_free` で閉じます。
//: - `selfhost_name_scope_add_binding`、`selfhost_value_type_evidence_table_add`、`selfhost_callable_signature_table_add` が失敗した場合、各 callee が入力 owner を消費します。
//: - この helper は callee に渡していない残り owner だけを直接閉じます。例えば signature 追加失敗時は残った value evidence table と scope を閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(context)`: 同名 function signature と、それを shadow する local value evidence を持つ context owner です。
//: - `Err(error)`: binding、evidence、signature、または table 作成が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 binding、1 evidence、1 signature だけを作るため O(1) です。
fn selfhost_check_expr_stage1_value_context_with_shadowed_function_value %impure fn str impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostSourceSpan Result SelfhostCheckExprStage1ValueContext StdErrorKind \name\callable_type\value_type\span:
    match selfhost_name_scope_new:
        Result::Ok scope0:
            let function_binding %SelfhostNameBinding selfhost_name_binding_pending name SelfhostDefKind::Function span
            match selfhost_name_scope_add_binding scope0 function_binding:
                Result::Ok function_added:
                    let function_def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &function_added
                    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope function_added
                    let value_binding %SelfhostNameBinding selfhost_name_binding_pending name SelfhostDefKind::Local span
                    match selfhost_name_scope_add_binding scope1 value_binding:
                        Result::Ok value_added:
                            let value_def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &value_added
                            let scope2 %SelfhostNameScope selfhost_name_scope_add_result_into_scope value_added
                            match selfhost_value_type_evidence_table_new:
                                Result::Ok value_types0:
                                    let evidence %SelfhostValueTypeEvidence selfhost_value_type_evidence_new value_def_id value_type span
                                    match selfhost_value_type_evidence_table_add value_types0 evidence:
                                        Result::Ok value_types1:
                                            match selfhost_callable_signature_table_new:
                                                Result::Ok signatures0:
                                                    let signature %SelfhostCallableSignature selfhost_callable_signature_new function_def_id callable_type SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired span
                                                    match selfhost_callable_signature_table_add signatures0 signature:
                                                        Result::Ok signatures1:
                                                            Result::Ok selfhost_check_expr_stage1_value_context_new scope2 value_types1 signatures1
                                                        Result::Err e:
                                                            selfhost_value_type_evidence_table_free value_types1
                                                            selfhost_name_scope_free scope2
                                                            Result::Err e
                                                Result::Err e:
                                                    selfhost_value_type_evidence_table_free value_types1
                                                    selfhost_name_scope_free scope2
                                                    Result::Err e
                                        Result::Err e:
                                            selfhost_name_scope_free scope2
                                            Result::Err e
                                Result::Err e:
                                    selfhost_name_scope_free scope2
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_make_named_candidate_vec: 指定名の callable candidate list を[作/つく]る
//:
//: [目的/もくてき]:
//: - `%i32 add 1 2` の ascription projection 後や named fixture で渡す、最小の callable candidate list を作ります。
//: - direct expression line の候補収集は `selfhost_check_expr_stage1_collect_candidates_from_fixture_scope` で name scope と signature table を通します。
//:
//: [契約/けいやく]:
//: - 成功時は caller が `Vec SelfhostCallableCandidate` の owner を受け取り、検査後に解放します。
//: - `v::push` が失敗した場合は中間 vector owner を解放し、`StdErrorKind` だけを返します。
//: - DefId と generic state は smoke fixture 用の固定値です。module surface や overload indexing の検査はこの helper の責務ではありません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidates)`: 指定名の pure monomorphic callable candidate を 1 件だけ持つ vector owner です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 件の candidate だけを作るため O(1) です。
fn selfhost_check_expr_stage1_make_named_candidate_vec %impure fn str impure fn SelfhostTypeId Result Vec SelfhostCallableCandidate StdErrorKind \name\callable_type:
    let candidates_result %Result Vec SelfhostCallableCandidate StdErrorKind v::new
    match candidates_result:
        Result::Ok candidates0:
            let candidate %SelfhostCallableCandidate selfhost_callable_candidate_new name selfhost_def_id_new 0 callable_type SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired source_span_new_unchecked 0 0 3
            match v::push candidates0 candidate:
                Result::Ok candidates1:
                    Result::Ok candidates1
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err error
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage1_make_candidate_vec: `add` candidate list を[作/つく]る
//:
//: [目的/もくてき]:
//: - 既存 smoke helper が `"add"` 固定候補を簡潔に作れるよう、named helper を薄く包みます。
//:
//: [契約/けいやく]:
//: - owner contract と error contract は `selfhost_check_expr_stage1_make_named_candidate_vec` と同じです。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidates)`: `"add"` の pure monomorphic callable candidate を 1 件だけ持つ vector owner です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - named helper を 1 回呼ぶだけなので O(1) です。
fn selfhost_check_expr_stage1_make_candidate_vec %impure fn SelfhostTypeId Result Vec SelfhostCallableCandidate StdErrorKind \callable_type:
    selfhost_check_expr_stage1_make_named_candidate_vec "add" callable_type

//: selfhost_check_expr_stage1_collect_candidates_from_fixture_scope: fixture scope から `add` candidate を[集/あつ]める
//:
//: [目的/もくてき]:
//: - `"add 1 2"` の先頭 identifier を `SelfhostNameScope` で解決し、DefId 経由で callable signature table に接続します。
//: - direct line smoke test が手作り candidate ではなく、実際の checker 境界と同じ candidate collection API を通ることを確認します。
//:
//: [契約/けいやく]:
//: - scope と signature table はこの helper 内で所有し、collection の成功・失敗にかかわらず解放します。
//: - `Ok(candidates)` の場合だけ caller が candidate vector owner を受け取り、call reduction 後に解放します。
//: - fixture 構築中の allocation failure は `OutOfMemory`、prefix list 構築失敗は `PrefixBuildFailed` として typed error に落とします。
//: - `selfhost_name_scope_add_binding` と `selfhost_callable_signature_table_add` が失敗した場合、入力 owner は callee が消費します。この helper は残った owner だけを閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidates)`: source-backed candidate collection から得た callable candidate vector owner です。
//: - `Err(error)`: typed candidate collection error です。allocation と prefix build failure は enum kind で区別されます。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 binding / 1 signature fixture の構築は O(1) です。candidate collection 自体は prefix item 数と同名候補数に従います。
fn selfhost_check_expr_stage1_collect_candidates_from_fixture_scope %impure fn str impure fn &Vec SelfhostToken impure fn SelfhostBodySegment impure fn SelfhostTypeId Result Vec SelfhostCallableCandidate SelfhostCallableCandidateCollectError \source\tokens\segment\add_type:
    let span %SelfhostSourceSpan source_span_new_unchecked 0 0 3
    match selfhost_name_scope_new:
        Result::Ok scope0:
            let binding %SelfhostNameBinding selfhost_name_binding_pending "add" SelfhostDefKind::Function span
            match selfhost_name_scope_add_binding scope0 binding:
                Result::Ok scope_add:
                    let def_id %SelfhostDefId selfhost_name_scope_add_result_def_id &scope_add
                    let scope1 %SelfhostNameScope selfhost_name_scope_add_result_into_scope scope_add
                    match selfhost_callable_signature_table_new:
                        Result::Ok table0:
                            let signature %SelfhostCallableSignature selfhost_callable_signature_new def_id add_type SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired span
                            match selfhost_callable_signature_table_add table0 signature:
                                Result::Ok table1:
                                    match selfhost_expr_prefix_list_from_syntax_range tokens segment.head:
                                        Result::Ok prefix:
                                            let result %Result Vec SelfhostCallableCandidate SelfhostCallableCandidateCollectError selfhost_callable_candidates_collect_for_prefix source tokens &prefix &scope1 &table1
                                            selfhost_expr_prefix_list_free prefix
                                            selfhost_callable_signature_table_free table1
                                            selfhost_name_scope_free scope1
                                            result
                                        Result::Err prefix_error:
                                            selfhost_callable_signature_table_free table1
                                            selfhost_name_scope_free scope1
                                            Result::Err selfhost_callable_candidate_collect_error_new SelfhostCallableCandidateCollectErrorKind::PrefixBuildFailed prefix_error.span
                                Result::Err _e:
                                    selfhost_name_scope_free scope1
                                    Result::Err selfhost_callable_candidate_collect_error_new SelfhostCallableCandidateCollectErrorKind::OutOfMemory span
                        Result::Err _e:
                            selfhost_name_scope_free scope1
                            Result::Err selfhost_callable_candidate_collect_error_new SelfhostCallableCandidateCollectErrorKind::OutOfMemory span
                Result::Err _e:
                    Result::Err selfhost_callable_candidate_collect_error_new SelfhostCallableCandidateCollectErrorKind::OutOfMemory span
        Result::Err _e:
            Result::Err selfhost_callable_candidate_collect_error_new SelfhostCallableCandidateCollectErrorKind::OutOfMemory span

//: selfhost_check_expr_stage1_add_two_i32_function: `i32 i32 -> i32` の関数型を arena に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `add 1 2` の direct call reduction に必要な callable type を fixture 内で構築します。
//:
//: [契約/けいやく]:
//: - 成功時は `SelfhostTypeArenaAlloc` を返し、caller が `selfhost_type_arena_alloc_into_arena` で arena owner に戻します。
//: - parameter Vec の作成または push が失敗した場合、この helper が入力 arena owner を直接解放します。
//: - function type allocation が失敗した場合は、`selfhost_type_arena_add_function` が arena owner と parameter Vec owner を消費して閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(allocated)`: `i32, i32 -> i32` の function type を追加した arena allocation owner です。
//: - `Err(error)`: parameter Vec 構築または arena allocation が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - parameter 2 件の固定構築なので O(1) です。
fn selfhost_check_expr_stage1_add_two_i32_function %impure fn SelfhostTypeArena impure fn SelfhostTypeId Result SelfhostTypeArenaAlloc StdErrorKind \arena\i32_type:
    let params_result %Result Vec SelfhostTypeId StdErrorKind v::new
    match params_result:
        Result::Ok params0:
            match v::push params0 i32_type:
                Result::Ok params1:
                    match v::push params1 i32_type:
                        Result::Ok params2:
                            selfhost_type_arena_add_function arena params2 i32_type
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            selfhost_type_arena_free arena
                            Result::Err error
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    selfhost_type_arena_free arena
                    Result::Err error
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_check_expr_stage1_add_one_i32_function: `i32 -> i32` の function type を arena に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `@add` function value argument smoke で、引数として渡す単項関数 `add` の型を構築します。
