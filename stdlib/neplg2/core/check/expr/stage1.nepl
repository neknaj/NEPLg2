//:
//: [計算量/けいさんりょう]:
//: - success payload の1回の pattern match だけを行うため O(1) です。
fn selfhost_check_expr_stage1_success_is_two_arg_direct_call %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let reduced %&SelfhostCallReduceResult selfhost_expression_line_check_success_result success
    match *reduced:
        SelfhostCallReduceResult::DirectCall call:
            eq call.argument_count 2

//: selfhost_check_expr_stage1_argument_is_i32_literal_range: checked argument が指定範囲の i32 literal か[調/しら]べる
//:
//: [目的/もくてき]:
//: - pipe smoke では、`1 |> add 2` が単に2引数 call になっただけでなく、左辺 `1` が第1 argument、右辺 suffix の `2` が第2 argument として保存されたことを確認します。
//: - `SelfhostCheckedArgumentKind` を網羅的に match し、literal payload を `TypedExpression` などへ丸める退行を検出します。
//:
//: [契約/けいやく]:
//: - `start_index` と `next_index` は prefix list 上の半開区間です。pipe fixture では左辺 `1` が `[0, 1)`、右辺 `2` が `[3, 4)` になります。
//: - この helper は borrow を観測するだけで、checked argument owner を移動しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: argument kind が `I32Literal(expected_value)` で、消費範囲も期待と一致します。
//: - `false`: kind、literal 値、または消費範囲のいずれかが期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - argument payload 1 件を O(1) で確認します。
fn selfhost_check_expr_stage1_argument_is_i32_literal_range %fn &SelfhostCheckedArgument fn i32 fn i32 fn i32 bool \argument\expected_value\expected_start\expected_next:
    let checked_argument %SelfhostCheckedArgument *argument
    if:
        not and eq checked_argument.start_index expected_start eq checked_argument.next_index expected_next
        then:
            false
        else:
            match checked_argument.kind:
                SelfhostCheckedArgumentKind::UnitValue:
                    false
                SelfhostCheckedArgumentKind::BoolLiteral _value:
                    false
                SelfhostCheckedArgumentKind::I32Literal value:
                    eq value expected_value
                SelfhostCheckedArgumentKind::F32Literal _value:
                    false
                SelfhostCheckedArgumentKind::CharLiteral _value:
                    false
                SelfhostCheckedArgumentKind::StrLiteral _value:
                    false
                SelfhostCheckedArgumentKind::NamedValue _identity:
                    false
                SelfhostCheckedArgumentKind::TypedExpression:
                    false
                SelfhostCheckedArgumentKind::FunctionValue _candidate:
                    false
                SelfhostCheckedArgumentKind::CheckedExpr _expr_id:
                    false
                SelfhostCheckedArgumentKind::NestedDirectCall _candidate:
                    false
                SelfhostCheckedArgumentKind::BlockResult:
                    false

//: selfhost_check_expr_stage1_argument_is_checked_expr_range: checked argument が既存 checked tree node 参照か[調/しら]べる
//:
//: [目的/もくてき]:
//: - pipe chain の2段目以降では、前段の source token を再び argument として解釈せず、前段 reducer が作った checked expression node を第1引数として渡します。
//: - この helper は `SelfhostCheckedArgumentKind::CheckedExpr` を直接確認し、chain 実装が HIR lowering の authority を checked tree に保っていることを smoke test から固定します。
//:
//: [契約/けいやく]:
//: - `start_index` と `next_index` は chain の前段が覆う半開区間です。`1 |> add 2 |> add 3` では前段 `1 |> add 2` が `[0, 4)` になります。
//: - checked expr id の具体値は tree allocation order に依存するため、この helper は kind と消費範囲だけを確認します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: argument kind が `CheckedExpr` で、消費範囲も期待と一致します。
//: - `false`: kind または消費範囲が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - argument payload 1 件を O(1) で確認します。
fn selfhost_check_expr_stage1_argument_is_checked_expr_range %fn &SelfhostCheckedArgument fn i32 fn i32 bool \argument\expected_start\expected_next:
    let checked_argument %SelfhostCheckedArgument *argument
    if:
        not and eq checked_argument.start_index expected_start eq checked_argument.next_index expected_next
        then:
            false
        else:
            match checked_argument.kind:
                SelfhostCheckedArgumentKind::UnitValue:
                    false
                SelfhostCheckedArgumentKind::BoolLiteral _value:
                    false
                SelfhostCheckedArgumentKind::I32Literal _value:
                    false
                SelfhostCheckedArgumentKind::F32Literal _value:
                    false
                SelfhostCheckedArgumentKind::CharLiteral _value:
                    false
                SelfhostCheckedArgumentKind::StrLiteral _value:
                    false
                SelfhostCheckedArgumentKind::NamedValue _identity:
                    false
                SelfhostCheckedArgumentKind::TypedExpression:
                    false
                SelfhostCheckedArgumentKind::FunctionValue _candidate:
                    false
                SelfhostCheckedArgumentKind::CheckedExpr _expr_id:
                    true
                SelfhostCheckedArgumentKind::NestedDirectCall _candidate:
                    false
                SelfhostCheckedArgumentKind::BlockResult:
                    false

//: selfhost_check_expr_stage1_success_has_pipe_argument_order: pipe 正規化後の checked argument 順序を[調/しら]べる
//:
//: [目的/もくてき]:
//: - `1 |> add 2` の pipe 正規化が、source-backed checked argument list に `1, 2` の順で evidence を保存することを確認します。
//: - HIR lowering が source token や scope lookup を再実行しない設計では、checked argument list の順序が call semantics の authority になります。
//:
//: [契約/けいやく]:
//: - fixture source は固定の `1 |> add 2` であり、prefix item index は `0:IntLiteral`, `1:Pipe`, `2:add`, `3:IntLiteral` です。
//: - `success` は borrow であり、この helper は内部 Vec を解放しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: checked argument が2件で、0番目が左辺 `1`、1番目が右辺 suffix `2` です。
//: - `false`: checked argument 数、Vec access、payload kind、literal 値、または消費範囲が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - 固定2件の Vec access と payload match だけなので O(1) です。
fn selfhost_check_expr_stage1_success_has_pipe_argument_order %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let checked_arguments %&Vec SelfhostCheckedArgument selfhost_expression_line_check_success_checked_arguments success
    if:
        not eq v::len checked_arguments 2
        then:
            false
        else:
            match v::get checked_arguments 0:
                Option::Some first:
                    match v::get checked_arguments 1:
                        Option::Some second:
                            and selfhost_check_expr_stage1_argument_is_i32_literal_range &first 1 0 1 selfhost_check_expr_stage1_argument_is_i32_literal_range &second 2 3 4
                        Option::None:
                            false
                Option::None:
                    false

//: selfhost_check_expr_stage1_success_has_pipe_chain_argument_order: pipe chain 最終段の checked argument 順序を[調/しら]べる
//:
//: [目的/もくてき]:
//: - `1 |> add 2 |> add 3` の最終段が、前段 `1 |> add 2` の checked expression を第1引数、suffix `3` を第2引数として保存することを確認します。
//: - chain を平坦な token 列へ戻して再解釈すると、型検査済みの前段 result type と checked tree node が失われるため、この helper は `CheckedExpr` payload を明示的に要求します。
//:
//: [契約/けいやく]:
//: - fixture source は固定であり、prefix item index は `0:1`, `1:|>`, `2:add`, `3:2`, `4:|>`, `5:add`, `6:3` です。
//: - `success` は borrow であり、この helper は内部 Vec を解放しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: checked argument が2件で、0番目が前段 checked expression `[0, 4)`、1番目が suffix literal `3` `[6, 7)` です。
//: - `false`: checked argument 数、Vec access、payload kind、literal 値、または消費範囲が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - 固定2件の Vec access と payload match だけなので O(1) です。
fn selfhost_check_expr_stage1_success_has_pipe_chain_argument_order %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let checked_arguments %&Vec SelfhostCheckedArgument selfhost_expression_line_check_success_checked_arguments success
    if:
        not eq v::len checked_arguments 2
        then:
            false
        else:
            match v::get checked_arguments 0:
                Option::Some first:
                    match v::get checked_arguments 1:
                        Option::Some second:
                            and selfhost_check_expr_stage1_argument_is_checked_expr_range &first 0 4 selfhost_check_expr_stage1_argument_is_i32_literal_range &second 3 6 7
                        Option::None:
                            false
                Option::None:
                    false

//: selfhost_check_expr_stage1_checked_expr_argument_id: checked expression argument の expr id を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - pipe chain の checked tree topology を検査するため、`CheckedExpr` argument が指す `SelfhostCheckedExprId` を Option として取り出します。
//: - kind が違う argument を dummy id へ丸めると tree 接続の退行を見逃すため、`CheckedExpr` 以外は `None` にします。
//:
//: [契約/けいやく]:
//: - `argument` は borrow であり、この helper は owner を移動しません。
//: - `start_index` / `next_index` はここでは確認しません。caller は必要なら `selfhost_check_expr_stage1_argument_is_checked_expr_range` と組み合わせます。
//:
//: [戻/もど]り[値/ち]:
//: - `Some(expr_id)`: argument が checked tree node 参照でした。
//: - `None`: argument が literal、value、function value、legacy summary など別分類でした。
//:
//: [計算量/けいさんりょう]:
//: - argument payload 1 件の match だけなので O(1) です。
fn selfhost_check_expr_stage1_checked_expr_argument_id %fn &SelfhostCheckedArgument Option SelfhostCheckedExprId \argument:
    let checked_argument %SelfhostCheckedArgument *argument
    match checked_argument.kind:
        SelfhostCheckedArgumentKind::CheckedExpr expr_id:
            some expr_id
        _:
            none

//: selfhost_check_expr_stage1_pipe_chain_previous_call_arguments_ok: pipe chain 前段 node の argument を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `1 |> add 2 |> add 3` の前段 node が、左辺 literal `1` と suffix literal `2` を引数として持つ `DirectCall` であることを確認します。
//: - 最終段の第1引数が `CheckedExpr` であるだけでは、参照先 node の内容が壊れても検出できません。この helper は参照先 node まで辿ります。
//:
//: [契約/けいやく]:
//: - `tree` は成功結果が所有する checked tree の borrow です。
//: - `expr_id` は最終段第1引数から取り出した id です。存在しない id は `false` にします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 参照先が2引数 `DirectCall` で、引数 payload と prefix 範囲が `[0, 1)` と `[3, 4)` に一致します。
//: - `false`: node lookup、node kind、argument range、payload、または範囲が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - fixed fixture の node 1 件と argument 2 件だけを読むため O(1) です。
fn selfhost_check_expr_stage1_pipe_chain_previous_call_arguments_ok %fn &SelfhostCheckedExprTree fn SelfhostCheckedExprId bool \tree\expr_id:
    match selfhost_checked_expr_tree_get_node tree expr_id:
        Option::Some node:
            match node.kind:
                SelfhostCheckedExprNodeKind::DirectCall call:
                    let arguments %SelfhostCheckedArgumentRange call.arguments
                    if:
                        not eq selfhost_checked_argument_range_count arguments 2
                        then:
                            false
                        else:
                            match selfhost_checked_expr_tree_get_argument tree arguments 0:
                                Option::Some first:
                                    match selfhost_checked_expr_tree_get_argument tree arguments 1:
                                        Option::Some second:
                                            and selfhost_check_expr_stage1_argument_is_i32_literal_range &first 1 0 1 selfhost_check_expr_stage1_argument_is_i32_literal_range &second 2 3 4
                                        Option::None:
                                            false
                                Option::None:
                                    false
                _:
                    false
        Option::None:
            false

//: selfhost_check_expr_stage1_pipe_chain_root_links_previous_direct_call: pipe chain root が前段 node へ[接続/せつぞく]しているか[調/しら]べる
//:
//: [目的/もくてき]:
//: - `1 |> add 2 |> add 3` の最終 root が `DirectCall` で、第1引数として前段 direct call node を `CheckedExpr` 参照していることを確認します。
//: - source-less pipe rejection を緩めるのではなく、source-backed chain が checked tree DAG として左結合に構成される契約を固定します。
//:
//: [契約/けいやく]:
//: - fixture source は固定であり、root は後段 `add`、第1引数は前段 `[0, 4)`、第2引数は literal `3` `[6, 7)` です。
//: - `success` は borrow であり、この helper は tree、argument table、success payload を解放しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: root と前段の両方が期待した `DirectCall` topology と argument payload を持っています。
//: - `false`: root id、node kind、argument count、argument kind、または前段参照先が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - fixed fixture の root node 1 件、前段 node 1 件、argument 4 件を読むため O(1) です。
fn selfhost_check_expr_stage1_pipe_chain_root_links_previous_direct_call %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let tree %&SelfhostCheckedExprTree selfhost_expression_line_check_success_checked_tree success
    let root_expr %SelfhostCheckedExprId selfhost_expression_line_check_success_root_expr success
    match selfhost_checked_expr_tree_get_node tree root_expr:
        Option::Some node:
            match node.kind:
                SelfhostCheckedExprNodeKind::DirectCall call:
                    let arguments %SelfhostCheckedArgumentRange call.arguments
                    if:
                        not eq selfhost_checked_argument_range_count arguments 2
                        then:
                            false
                        else:
                            match selfhost_checked_expr_tree_get_argument tree arguments 0:
                                Option::Some first:
                                    match selfhost_checked_expr_tree_get_argument tree arguments 1:
                                        Option::Some second:
                                            if:
                                                not and selfhost_check_expr_stage1_argument_is_checked_expr_range &first 0 4 selfhost_check_expr_stage1_argument_is_i32_literal_range &second 3 6 7
                                                then:
                                                    false
                                                else:
                                                    match selfhost_check_expr_stage1_checked_expr_argument_id &first:
                                                        Option::Some previous_expr:
                                                            selfhost_check_expr_stage1_pipe_chain_previous_call_arguments_ok tree previous_expr
                                                        Option::None:
                                                            false
                                        Option::None:
                                            false
                                Option::None:
                                    false
                _:
                    false
        Option::None:
            false

//: selfhost_check_expr_stage1_success_has_ascribed_pipe_argument_order: ascribed pipe 正規化後の checked argument 順序を[調/しら]べる
//:
//: [目的/もくてき]:
//: - `1 |> %fn i32 fn i32 i32 add 2` の pipe 正規化が、`%fn ...` の型式 token 群を飛ばし、checked argument list に左辺 `1` と suffix `2` だけを保存することを確認します。
//:
//: [契約/けいやく]:
//: - fixture source は固定であり、prefix item index は `0:IntLiteral`, `1:Pipe`, `2:%`, `3:fn`, `4:i32`, `5:fn`, `6:i32`, `7:i32`, `8:add`, `9:IntLiteral` です。
//: - success は borrow であり、この helper は内部 owner を移動しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: checked argument が2件で、0番目が左辺 `1`、1番目が suffix `2` です。
//: - `false`: checked argument 数、payload kind、literal 値、または consume-width が期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - 固定2件の Vec access と payload match だけなので O(1) です。
fn selfhost_check_expr_stage1_success_has_ascribed_pipe_argument_order %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let checked_arguments %&Vec SelfhostCheckedArgument selfhost_expression_line_check_success_checked_arguments success
    if:
        not eq v::len checked_arguments 2
        then:
            false
        else:
            match v::get checked_arguments 0:
                Option::Some first:
                    match v::get checked_arguments 1:
                        Option::Some second:
                            and selfhost_check_expr_stage1_argument_is_i32_literal_range &first 1 0 1 selfhost_check_expr_stage1_argument_is_i32_literal_range &second 2 9 10
                        Option::None:
                            false
                Option::None:
                    false

//: selfhost_check_expr_stage1_success_is_one_arg_direct_call: reducer success が1引数 direct call か[調/しら]べる
//:
//: [目的/もくてき]:
//: - function value argument fixture など、外側 call が1つの checked argument だけを消費する経路を確認します。
//: - call reduction の成功判定を `SelfhostCallReduceResult` の enum payload に固定し、表示用 message に依存しない smoke assertion にします。
//:
//: [契約/けいやく]:
//: - `success` は borrow であり、所有権や内部 Vec をこの helper が閉じることはありません。
//: - `DirectCall` 以外は、将来別の success kind が増えてもこの fixture の期待から外れるため `false` にします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: success payload が `DirectCall` で、`argument_count` が 1 です。
//: - `false`: success kind または引数数が fixture の期待と違います。
//:
//: [計算量/けいさんりょう]:
//: - success payload の先頭 variant と引数数だけを見るため O(1) です。
fn selfhost_check_expr_stage1_success_is_one_arg_direct_call %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let reduced %&SelfhostCallReduceResult selfhost_expression_line_check_success_result success
    match *reduced:
        SelfhostCallReduceResult::DirectCall call:
            eq call.argument_count 1

//: selfhost_check_expr_stage1_success_has_function_value_argument: checked argument が function value として[記録/きろく]されたか[調/しら]べる
//:
//: [目的/もくてき]:
//: - `takes @add` のような明示 function value argument が、通常の named value や partial application ではなく `FunctionValue` argument として保存されたことを確認します。
//: - 高階関数境界の smoke test が、単に call が成功しただけでなく、argument evidence の種類まで検査するようにします。
//:
//: [契約/けいやく]:
//: - `success` 内の checked argument Vec は borrow で観測するだけで、この helper は要素 owner を移動しません。
//: - stage1 の対象 fixture は1引数 consumer なので、checked argument 数が1でない場合は失敗とします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: checked argument が1件だけあり、その payload が function value evidence です。
//: - `false`: checked argument 数が違う、Vec access に失敗した、または payload kind が違います。
//:
//: [計算量/けいさんりょう]:
//: - Vec length と index 0 の1回の観測だけなので O(1) です。
fn selfhost_check_expr_stage1_success_has_function_value_argument %fn &SelfhostExpressionLineCheckSuccess bool \success:
    let checked_arguments %&Vec SelfhostCheckedArgument selfhost_expression_line_check_success_checked_arguments success
    if:
        not eq v::len checked_arguments 1
        then:
            false
        else:
            match v::get checked_arguments 0:
                Option::Some argument:
                    selfhost_checked_argument_is_function_value &argument
                Option::None:
                    false

//: selfhost_check_expr_stage1_segment_span: body segment の代表 span を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - setup 失敗を call reduction error へ畳むときに、fixture segment 由来の span を error payload へ入れます。
//: - span の authority を source text ではなく `SelfhostBodySegment.head` に置き、empty segment だけを明示的な空 span にします。
//:
//: [契約/けいやく]:
//: - `segment` は値渡しで受けますが、payload owner を保持する型ではないため追加 cleanup はありません。
//: - `SelfhostSyntaxRange::Empty` は本来 fixture setup で避けるべき状態ですが、out-of-memory error を作るための defensive fallback として空 span を返します。
//:
//: [戻/もど]り[値/ち]:
//: - `Range`: range に記録されている source span。
//: - `Empty`: `source_span_empty_unchecked 0 0` による空 span。
//:
//: [計算量/けいさんりょう]:
//: - segment head の1回の pattern match だけなので O(1) です。
fn selfhost_check_expr_stage1_segment_span %fn SelfhostBodySegment SelfhostSourceSpan \segment:
    match segment.head:
        SelfhostSyntaxRange::Range range:
            range.span
        SelfhostSyntaxRange::Empty:
            source_span_empty_unchecked 0 0

//: selfhost_check_expr_stage1_reduce_body_segment_with_value_context: value context owner を reducer に[渡/わた]して expression segment を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - scope、value type evidence、callable signature table を持つ stage1 fixture context から borrow を取り出し、source-backed body segment reducer へ渡します。
//: - reducer 実行後に context owner を必ず閉じ、fixture が owner を残さないことを smoke test 側で保証します。
//:
//: [契約/けいやく]:
//: - `context` owner はこの helper が消費し、成功・失敗どちらでも `selfhost_check_expr_stage1_value_context_free` で閉じます。
//: - `arena` owner は reducer 側へ渡します。成功時は `SelfhostExpressionLineCheckSuccess` が arena owner を保持し、caller が success free で閉じます。
//: - 失敗時は reducer が arena owner を解放済みであり、返る typed error payload は arena owner を保持しません。
//: - `tokens`、`source`、`candidates` は borrow として渡すだけで、この helper は閉じません。
//:
//: [戻/もど]り[値/ち]:
//: - `Result::Ok success`: expression segment reduction が成功し、checked argument evidence を持つ success payload を返します。
//: - `Result::Err error`: call reduction または expression line check の typed error payload を返します。
//:
//: [計算量/けいさんりょう]:
//: - wrapper 自体は O(1) です。支配的な計算量は reducer 内部の prefix item 数、candidate 数、nested argument 探索に従います。
fn selfhost_check_expr_stage1_reduce_body_segment_with_value_context %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostBodySegment impure fn SelfhostTypeArena impure fn SelfhostCheckExprStage1ValueContext impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation Result SelfhostExpressionLineCheckSuccess SelfhostExpressionLineCheckError \tokens\source\segment\arena\context\candidates\expected:
    let scope %&SelfhostNameScope selfhost_check_expr_stage1_value_context_scope &context
    let value_types %&SelfhostValueTypeEvidenceTable selfhost_check_expr_stage1_value_context_value_types &context
