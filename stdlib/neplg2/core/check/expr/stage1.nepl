                        eq ascription_base 0
                        then:
                            let argument_ascription %i32 selfhost_check_expr_stage1_ascribed_argument_body_line
                            if:
                                eq argument_ascription 0
                                then:
                                    let named_argument %i32 selfhost_check_expr_stage1_named_argument_body_line
                                    if:
                                        eq named_argument 0
                                        then:
                                            let nested_argument %i32 selfhost_check_expr_stage1_nested_call_argument_body_line
                                            if:
                                                eq nested_argument 0
                                                then:
                                                    let function_value_argument %i32 selfhost_check_expr_stage1_function_value_argument_body_line
                                                    if:
                                                        eq function_value_argument 0
                                                        then:
