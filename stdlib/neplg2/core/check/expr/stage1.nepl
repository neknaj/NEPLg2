                    v::free candidates
                    v::free tokens
                    false
                Result::Err e:
                    let ok %bool selfhost_expression_line_check_error_is_call_reduce_kind e expected
                    v::free candidates
                    v::free tokens
                    ok
        Result::Err _e:
            selfhost_check_expr_stage1_value_context_free context
            selfhost_type_arena_free arena
            v::free tokens
            false

