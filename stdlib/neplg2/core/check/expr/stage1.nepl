//: - `Err(error)`: parameter Vec 構築または arena allocation が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - parameter 1 件の固定構築なので O(1) です。
fn selfhost_check_expr_stage1_add_function_value_consumer %impure fn SelfhostTypeArena impure fn SelfhostTypeId impure fn SelfhostTypeId Result SelfhostTypeArenaAlloc StdErrorKind \arena\function_value_type\result_type:
    let params_result %Result Vec SelfhostTypeId StdErrorKind v::new
    match params_result:
        Result::Ok params0:
            match v::push params0 function_value_type:
                Result::Ok params1:
                    selfhost_type_arena_add_function arena params1 result_type
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    selfhost_type_arena_free arena
                    Result::Err error
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

