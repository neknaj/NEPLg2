#indent 4

//: # check/expr/match_actual_member
//: current VFS Matchの単一NamedValue scrutineeをactual enum memberへ接続します。
//:
//: [authority boundary]:
//: - 公開入口はrange、span、TypeId、nominal ID、raw enum/member名を受けません。
//: - scrutinee TypeIdはscopeの最新DefId-linked value evidenceから取得し、同じarena内のrecord存在を確認します。
//: - variantは選択armのexact 3-segment AST projectionだけを使い、actual arenaへsynthetic typeを追加しません。
//: - scope、value evidence、arena、constructor tableが選択functionと同じchecker phaseから作られたことは、この段階ではcaller preconditionです。production authorityへの昇格にはmodule checker environmentとのco-productionが必要です。
//:
//: [制約/せいやく]: exact export originと一致する非generic enum armだけはexpected typeを導出し、期待型無し失敗時に一度だけ再検査します。generic fresh inference、reference deref、payload typing、exhaustiveness、arm body型統一は後続sliceです。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "neplg2/core/check/expr/match_actual_member" as *
//: fn main %fn void i32 \void:
//:     match SelfhostMatchCheckedActualMemberError::ArmOutOfBounds:
//:         SelfhostMatchCheckedActualMemberError::ArmOutOfBounds: 0
//:         _: 1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/access" as string_access
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/check/expr/call_candidate" as *
#import "neplg2/core/check/expr/checked_tree" as *
#import "neplg2/core/check/expr/checked_tree_id" as *
#import "neplg2/core/check/expr/exported_enum_member" as *
#import "neplg2/core/check/expr/match_checked_scrutinee" as *
#import "neplg2/core/check/expr/match_scrutinee" as *
#import "neplg2/core/check/expr/model" as *
#import "neplg2/core/check/expr/expectation" as *
#import "neplg2/core/check/expr/value_evidence" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/graph" as *
#import "neplg2/core/resolve/name_resolver/scope" as *
#import "neplg2/core/resolve/name_resolver/qualified_enum_import" as *
#import "neplg2/core/resolve/name_resolver/public_export_table" as *
#import "neplg2/core/resolve/type_resolver/constructor" as *
#import "neplg2/core/syntax/parser/match_arm_segmenter" as *
#import "neplg2/core/syntax/parser/match_context" as *
#import "neplg2/core/ty/ty/arena" as *
#import "neplg2/core/ty/ty/id" as *

pub enum SelfhostMatchActualMemberError:
    Context %SelfhostMatchContextErrorKind
    Scrutinee %SelfhostMatchScrutineeRootErrorKind
    ArmOutOfBounds
    PatternNotDirectAlias
    Member %SelfhostCheckedExportedEnumMemberError

//: SelfhostMatchCheckedActualMemberContext: checked scrutinee treeとactual enum member ownerを同時に保持する
//:
//: [owner boundary]: member contextがarena/enum sessionを所有し、このcontextがchecked argument列とchecked treeを所有します。
//: [type boundary]: root_typeはmember contextへ渡したactual TypeIdと同じ値で、root_exprは同じchecked tree内でだけ有効です。
pub struct SelfhostMatchCheckedActualMemberContext:
    member %SelfhostCheckedExportedEnumMemberContext
    reduction %SelfhostCallReduceResult
    checked_arguments %Vec SelfhostCheckedArgument
    checked_tree %SelfhostCheckedExprTree
    root_expr %SelfhostCheckedExprId
    root_type %SelfhostTypeId

pub enum SelfhostMatchCheckedActualMemberError:
    Context %SelfhostMatchContextErrorKind
    Scrutinee %SelfhostMatchCheckedScrutineeError
    ArmOutOfBounds
    PatternNotDirectAlias
    ExpectedOrigin
    Member %SelfhostCheckedExportedEnumMemberError

struct SelfhostMatchActualArmSpans:
    alias %SelfhostSourceSpan
    enum_name %SelfhostSourceSpan
    member %SelfhostSourceSpan

impl Clone for SelfhostMatchActualArmSpans:
    fn clone %fn &SelfhostMatchActualArmSpans SelfhostMatchActualArmSpans \self: *self

impl Copy for SelfhostMatchActualArmSpans:
    fn copy_mark %fn SelfhostMatchActualArmSpans SelfhostMatchActualArmSpans \self: self

enum SelfhostMatchActualArmProjectionError:
    ArmOutOfBounds
    PatternNotDirectAlias

fn selfhost_match_actual_span_eq %fn SelfhostSourceSpan fn SelfhostSourceSpan bool \a\b:
    and and eq a.file_id b.file_id eq a.start b.start eq a.end b.end

fn selfhost_match_actual_export_count %fn &SelfhostPublicExportTable fn i32 fn str fn i32 fn i32 i32 \table\owner\name\idx\count:
    if:
        ge idx selfhost_public_export_table_count table
        then: count
        else:
            match selfhost_public_export_table_get table idx:
                Option::None: count
                Option::Some entry:
                    let matches %bool and eq entry.owner_module_node_index owner string_search::str_eq entry.visible_name name
                    selfhost_match_actual_export_count table owner name add idx 1 if matches add count 1 count

//: selfhost_match_actual_expected_nominal: arm originとborrowed constructor headerを再結合する
//:
//: [契約/けいやく]: exact qualified import、単一public enum export、元宣言spanと一致するconstructorのnominal identityとarityを返します。synthetic origin headerはnoneです。
//: [owner boundary]: 一時qualified/export tableは全経路で閉じ、caller ownerは借用したままです。
fn selfhost_match_actual_expected_nominal %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn SelfhostMatchActualArmSpans impure fn &SelfhostTypeConstructorTable Option SelfhostMatchActualExpectedNominal \graph\vfs\order\path\spans\constructors:
    match selfhost_qualified_enum_import_table_build graph vfs path spans.alias:
        Result::Err _e: none
        Result::Ok qualified:
            let source %str *selfhost_qualified_enum_import_table_source &qualified
            let source_file_id %i32 selfhost_qualified_enum_import_table_source_file_id &qualified
            let valid_span %bool and eq spans.enum_name.file_id source_file_id and le 0 spans.enum_name.start le spans.enum_name.end string_access::str_byte_len source
            if:
                not valid_span
                then:
                    selfhost_qualified_enum_import_table_free qualified
                    none
                else:
                    let visible_name %str string_slice::str_slice source spans.enum_name.start spans.enum_name.end
                    let owner %i32 selfhost_qualified_enum_import_table_target_node_index &qualified
                    match selfhost_public_export_table_build graph vfs order:
                        Result::Err _e:
                            selfhost_qualified_enum_import_table_free qualified
                            none
                        Result::Ok exports:
                            let expected %Option SelfhostMatchActualExpectedNominal if:
                                ne selfhost_match_actual_export_count &exports owner visible_name 0 0 1
                                then: none
                                else:
                                    match selfhost_public_export_table_lookup &exports owner visible_name:
                                        Option::None: none
                                        Option::Some entry:
                                            match entry.kind:
                                                SelfhostPublicExportKind::Enum:
                                                    match selfhost_type_constructor_table_find constructors entry.original_name:
                                                        Option::None: none
                                                        Option::Some constructor:
                                                            if:
                                                                and selfhost_match_actual_span_eq constructor.span entry.original_name_span string_search::str_eq constructor.name entry.original_name
                                                                then: some SelfhostMatchActualExpectedNominal constructor.nominal_id (selfhost_type_constructor_kind_arg_count constructor.kind) spans.enum_name
                                                                else: none
                                                _: none
                            selfhost_public_export_table_free exports
                            selfhost_qualified_enum_import_table_free qualified
                            expected

struct SelfhostMatchActualExpectedNominal:
    nominal_id %SelfhostNamedTypeId
    arity %i32
    source_span %SelfhostSourceSpan

impl Clone for SelfhostMatchActualExpectedNominal:
    fn clone %fn &SelfhostMatchActualExpectedNominal SelfhostMatchActualExpectedNominal \self:
        *self

impl Copy for SelfhostMatchActualExpectedNominal:
    fn copy_mark %fn SelfhostMatchActualExpectedNominal SelfhostMatchActualExpectedNominal \self:
        self

fn selfhost_match_actual_first_expected_nominal %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn &SelfhostMatchContext impure fn &SelfhostTypeConstructorTable Option SelfhostMatchActualExpectedNominal \graph\vfs\order\path\context\constructors:
    if:
        eq selfhost_match_context_arm_len context 0
        then: none
        else:
            match selfhost_match_actual_arm_spans context 0:
                Result::Err _e: none
                Result::Ok spans:
                    selfhost_match_actual_expected_nominal graph vfs order path spans constructors

struct SelfhostMatchActualFreshArgs:
    arena %SelfhostTypeArena
    args %Vec SelfhostTypeId

fn selfhost_match_actual_add_fresh_args %impure fn SelfhostTypeArena impure fn Vec SelfhostTypeId impure fn i32 impure fn i32 Result SelfhostMatchActualFreshArgs StdErrorKind \arena\args\arity\idx:
    if:
        ge idx arity
        then: Result::Ok SelfhostMatchActualFreshArgs arena args
        else:
            match selfhost_type_arena_add_fresh_inference_variable arena:
                Result::Err e:
                    v::free args
                    Result::Err e
                Result::Ok allocated:
                    let variable_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated
                    let next_arena %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated
                    match v::push args variable_type:
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            selfhost_type_arena_free next_arena
                            Result::Err error
                        Result::Ok next_args:
                            selfhost_match_actual_add_fresh_args next_arena next_args arity add idx 1

fn selfhost_match_actual_add_expected_type %impure fn SelfhostTypeArena impure fn SelfhostMatchActualExpectedNominal Result SelfhostTypeArenaAlloc StdErrorKind \arena\expected:
    if:
        eq expected.arity 0
        then: selfhost_type_arena_add_named arena expected.nominal_id
        else:
            let args_result %Result Vec SelfhostTypeId StdErrorKind v::new
            match args_result:
                Result::Err e:
                    selfhost_type_arena_free arena
                    Result::Err e
                Result::Ok args:
                    match selfhost_match_actual_add_fresh_args arena args expected.arity 0:
                        Result::Err e: Result::Err e
                        Result::Ok fresh:
                            selfhost_type_arena_add_applied_named (field::get fresh "arena") expected.nominal_id (field::get fresh "args")

fn selfhost_match_actual_arm_spans %fn &SelfhostMatchContext fn i32 Result SelfhostMatchActualArmSpans SelfhostMatchActualArmProjectionError \context\arm_ordinal:
    match selfhost_match_variant_arm_list_get selfhost_match_context_arms context arm_ordinal:
        Option::None: Result::Err SelfhostMatchActualArmProjectionError::ArmOutOfBounds
        Option::Some arm:
            match selfhost_match_variant_arm_direct_alias selfhost_match_context_arms context arm:
                Option::None: Result::Err SelfhostMatchActualArmProjectionError::PatternNotDirectAlias
                Option::Some direct:
                    let alias_segment %SelfhostMatchPatternSegment field::get direct "alias"
                    let enum_name_segment %SelfhostMatchPatternSegment field::get direct "enum_name"
                    let member_segment %SelfhostMatchPatternSegment field::get direct "member"
                    Result::Ok SelfhostMatchActualArmSpans alias_segment.span enum_name_segment.span member_segment.span

fn selfhost_match_checked_actual_member_connect %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn SelfhostMatchActualArmSpans impure fn SelfhostMatchCheckedScrutineeParts impure fn SelfhostTypeConstructorTable Result SelfhostMatchCheckedActualMemberContext SelfhostMatchCheckedActualMemberError \graph\vfs\order\path\spans\checked_root\constructors:
    let parts %SelfhostMatchCheckedScrutineeOwnedParts selfhost_match_checked_scrutinee_parts_into_owned checked_root
    let arena %SelfhostTypeArena field::get parts "arena"
    let reduction %SelfhostCallReduceResult field::get parts "result"
    let checked_arguments %Vec SelfhostCheckedArgument field::get parts "checked_arguments"
    let checked_tree %SelfhostCheckedExprTree field::get parts "checked_tree"
    let root_expr %SelfhostCheckedExprId field::get parts "root_expr"
    let root_type %SelfhostTypeId field::get parts "root_type"
    match selfhost_check_exported_enum_member_actual_context_result graph vfs order path spans.alias spans.enum_name spans.member arena constructors root_type:
        Result::Err e:
            v::free checked_arguments
            selfhost_checked_expr_tree_free checked_tree
            Result::Err SelfhostMatchCheckedActualMemberError::Member e
        Result::Ok member:
            Result::Ok SelfhostMatchCheckedActualMemberContext member reduction checked_arguments checked_tree root_expr root_type

//: selfhost_check_match_single_named_value_actual_member_result: VFS authorityからactual checked memberを生成する
//:
//: [入力/にゅうりょく]:
//: - graph、VFS、order、pathと三つのordinalはcurrent source上のMatch armを選びます。
//: - scopeとvalue evidenceは単一NamedValue scrutineeのactual TypeId authorityです。
//: - arenaとconstructorsは同じchecker sessionのownerであり、この関数が消費します。
//:
//: [戻/もど]り[値/ち]:
//: - 成功時はactual arena、enum session、checked memberを一括所有するcontextを返します。
//: - 失敗時はMatch context、arena、constructorsを残さず解放し、失敗段階をtyped errorで返します。
//:
//: [計算量/けいさんりょう]: VFS parseとmodule graph/export探索、およびenum variant数に比例します。
pub fn selfhost_check_match_single_named_value_actual_member_result %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn i32 impure fn i32 impure fn i32 impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn SelfhostTypeArena impure fn SelfhostTypeConstructorTable Result SelfhostCheckedExportedEnumMemberContext SelfhostMatchActualMemberError \graph\vfs\order\path\function_ordinal\segment_ordinal\arm_ordinal\scope\value_types\arena\constructors:
    match selfhost_match_context_from_vfs vfs path function_ordinal segment_ordinal:
        Result::Err e:
            selfhost_type_arena_free arena
            selfhost_type_constructor_table_free constructors
            Result::Err SelfhostMatchActualMemberError::Context e
        Result::Ok context:
            match selfhost_match_scrutinee_single_named_value_result selfhost_match_context_tokens &context selfhost_match_context_source &context selfhost_match_context_scrutinee_range &context scope value_types &arena:
                Result::Err e:
                    selfhost_match_context_free context
                    selfhost_type_arena_free arena
                    selfhost_type_constructor_table_free constructors
                    Result::Err SelfhostMatchActualMemberError::Scrutinee e
                Result::Ok root:
                    match selfhost_match_actual_arm_spans &context arm_ordinal:
                        Result::Err projection_error:
                            selfhost_match_context_free context
                            selfhost_type_arena_free arena
                            selfhost_type_constructor_table_free constructors
                            match projection_error:
                                SelfhostMatchActualArmProjectionError::ArmOutOfBounds: Result::Err SelfhostMatchActualMemberError::ArmOutOfBounds
                                SelfhostMatchActualArmProjectionError::PatternNotDirectAlias: Result::Err SelfhostMatchActualMemberError::PatternNotDirectAlias
                        Result::Ok spans:
                            let checked %Result SelfhostCheckedExportedEnumMemberContext SelfhostCheckedExportedEnumMemberError selfhost_check_exported_enum_member_actual_context_result graph vfs order path spans.alias spans.enum_name spans.member arena constructors root.ty
                            selfhost_match_context_free context
                            match checked:
                                Result::Err e: Result::Err SelfhostMatchActualMemberError::Member e
                                Result::Ok result: Result::Ok result

fn selfhost_match_checked_actual_member_with_spans %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn SelfhostMatchContext impure fn SelfhostMatchActualArmSpans impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn SelfhostTypeArena impure fn SelfhostTypeConstructorTable Result SelfhostMatchCheckedActualMemberContext SelfhostMatchCheckedActualMemberError \graph\vfs\order\path\context\spans\scope\value_types\signatures\candidates\arena\constructors:
    match selfhost_match_actual_first_expected_nominal graph vfs order path &context &constructors:
        Option::None:
            match selfhost_match_checked_scrutinee_result &context &constructors arena scope value_types signatures candidates:
                Result::Err e:
                    selfhost_match_context_free context
                    selfhost_type_constructor_table_free constructors
                    Result::Err SelfhostMatchCheckedActualMemberError::Scrutinee e
                Result::Ok checked_root:
                    selfhost_match_context_free context
                    selfhost_match_checked_actual_member_connect graph vfs order path spans checked_root constructors
        Option::Some expected_nominal:
            match selfhost_match_actual_add_expected_type arena expected_nominal:
                Result::Err _e:
                    selfhost_match_context_free context
                    selfhost_type_constructor_table_free constructors
                    Result::Err SelfhostMatchCheckedActualMemberError::ExpectedOrigin
                Result::Ok allocated:
                    let expected_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated
                    let expected_arena %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated
                    let expectation %SelfhostTypeExpectation selfhost_type_expectation_new expected_type SelfhostTypeExpectationSource::MatchArmDerived expected_nominal.source_span
                    match selfhost_match_checked_scrutinee_retry_result &context &constructors expected_arena scope value_types signatures candidates expectation:
                        Result::Err e:
                            selfhost_match_context_free context
                            selfhost_type_constructor_table_free constructors
                            Result::Err SelfhostMatchCheckedActualMemberError::Scrutinee e
                        Result::Ok checked_root:
                            selfhost_match_context_free context
                            selfhost_match_checked_actual_member_connect graph vfs order path spans checked_root constructors

//: selfhost_check_match_checked_actual_member_result: checked reduction rootをactual member gateへ接続する
//:
//: [契約/けいやく]: scrutineeはfork上でexpected type無しに検査し、exact origin付き非generic arm expectedがある場合だけ失敗後に元arenaで一度再検査します。成功root node型はtreeから再取得し、型を再割当しません。
//: [authority boundary]: range/span/TypeId/nominal/raw member名をcallerから受けず、current VFS contextとchecked rootだけを使います。scope/value/signature/candidate/arena/constructorの同一checker phase由来はcaller preconditionです。
//: [owner boundary]: arenaはscrutinee checkerからmember gateへmoveし、成功contextはmember ownerとchecked treeを同時に保持します。全失敗経路で到達済みownerを閉じます。
pub fn selfhost_check_match_checked_actual_member_result %impure fn &SelfhostModuleGraph impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModuleOrder impure fn str impure fn i32 impure fn i32 impure fn i32 impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn SelfhostTypeArena impure fn SelfhostTypeConstructorTable Result SelfhostMatchCheckedActualMemberContext SelfhostMatchCheckedActualMemberError \graph\vfs\order\path\function_ordinal\segment_ordinal\arm_ordinal\scope\value_types\signatures\candidates\arena\constructors:
    match selfhost_match_context_from_vfs vfs path function_ordinal segment_ordinal:
        Result::Err e:
            selfhost_type_arena_free arena
            selfhost_type_constructor_table_free constructors
            Result::Err SelfhostMatchCheckedActualMemberError::Context e
        Result::Ok context:
            match selfhost_match_actual_arm_spans &context arm_ordinal:
                Result::Err projection_error:
                    selfhost_match_context_free context
                    selfhost_type_arena_free arena
                    selfhost_type_constructor_table_free constructors
                    match projection_error:
                        SelfhostMatchActualArmProjectionError::ArmOutOfBounds: Result::Err SelfhostMatchCheckedActualMemberError::ArmOutOfBounds
                        SelfhostMatchActualArmProjectionError::PatternNotDirectAlias: Result::Err SelfhostMatchCheckedActualMemberError::PatternNotDirectAlias
                Result::Ok spans:
                    selfhost_match_checked_actual_member_with_spans graph vfs order path context spans scope value_types signatures candidates arena constructors

//: selfhost_match_checked_actual_member_context_free: member ownerとchecked scrutinee treeを一度だけ閉じる
pub fn selfhost_match_checked_actual_member_context_free %impure fn SelfhostMatchCheckedActualMemberContext unit \context:
    v::free field::get context "checked_arguments"
    selfhost_checked_expr_tree_free field::get context "checked_tree"
    selfhost_checked_exported_enum_member_context_free field::get context "member"

pub fn selfhost_match_checked_actual_member_context_member %fn &SelfhostMatchCheckedActualMemberContext SelfhostCheckedEnumMember \context:
    selfhost_checked_exported_enum_member_context_checked field::get_ref context "member"

pub fn selfhost_match_checked_actual_member_context_tree %fn &SelfhostMatchCheckedActualMemberContext &SelfhostCheckedExprTree \context:
    field::get_ref context "checked_tree"

pub fn selfhost_match_checked_actual_member_context_root_expr %fn &SelfhostMatchCheckedActualMemberContext SelfhostCheckedExprId \context:
    *field::get_ref context "root_expr"

pub fn selfhost_match_checked_actual_member_context_root_type %fn &SelfhostMatchCheckedActualMemberContext SelfhostTypeId \context:
    *field::get_ref context "root_type"
