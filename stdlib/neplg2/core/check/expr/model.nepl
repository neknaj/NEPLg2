#indent 4

//: # check/expr/model
//: prefix call reduction の成功 payload と失敗 payload を定義する module です。
//:
//: [目的/もくてき]:
//: - expression checker の初期 slice で、HIR をまだ生成せずに reduction の判断結果を型付きで返します。
//: - 成功 payload は selected candidate、実引数数、result type、span を保持し、後続の HIR lowering が同じ evidence を使えるようにします。
//: - 失敗 payload は error kind、span、generic state を保持し、generic 証拠不足や partial application を曖昧な通常失敗へ潰しません。
//:
//: [契約/けいやく]:
//: - `SelfhostCallReduceResult::DirectCall` は「call tree へ縮約できる」という checker-side plan であり、HIR node ではありません。
//: - unsupported / fail-closed は `Result::Err` として返します。未対応機能を成功 variant にして後段へ流してはいけません。

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty" as *
#import "./call_candidate" as *
#import "./argument_payload" as *

//: SelfhostReducedCall: direct named call として縮約できた payload
//:
//: [目的/もくてき]:
//: - selected candidate index と argument count を保存し、後続 lowering が prefix list のどの範囲を call arguments として使うかを再計算しないようにします。
//: - result type は expected type 検査後の candidate result です。
pub struct SelfhostReducedCall:
    candidate_index %i32
    argument_count %i32
    result_type %SelfhostTypeId
    span %SelfhostSourceSpan

//: SelfhostTrailingBlockArgument: `BlockIntro` が持つ末尾 block argument の evidence
//:
//: [目的/もくてき]:
//: - `head:` の `head` 部分は flat prefix list として扱えますが、`:` の後ろの nested body は prefix item ではありません。
//: - この payload は、nested body を prefix list に混ぜず、source-backed checker が expected parameter type 付きで検査するための境界です。
//:
//: [契約/けいやく]:
//: - `body` は `SelfhostBodySegmentKind::BlockIntro` の nested body envelope です。
//: - reducer はこの envelope を flat prefix item へ混ぜず、`block_body.nepl` で単一 `ExpressionLine` へ分解してから `BlockResult` expectation で検査します。
//: - 複数式や nested block など、この slice で安全に縮約できない body は具体的な `TrailingBlockBody*` error として fail-closed にします。
pub struct SelfhostTrailingBlockArgument:
    body %SelfhostSyntaxRange
    span %SelfhostSourceSpan

impl Clone for SelfhostTrailingBlockArgument:
    fn clone %fn &SelfhostTrailingBlockArgument SelfhostTrailingBlockArgument \self:
        *self

impl Copy for SelfhostTrailingBlockArgument:
    fn copy_mark %fn SelfhostTrailingBlockArgument SelfhostTrailingBlockArgument \self:
        self

impl Clone for SelfhostReducedCall:
    fn clone %fn &SelfhostReducedCall SelfhostReducedCall \self:
        *self

impl Copy for SelfhostReducedCall:
    fn copy_mark %fn SelfhostReducedCall SelfhostReducedCall \self:
        self

//: SelfhostCallReduceResult: expression reduction の成功結果
pub enum SelfhostCallReduceResult:
    DirectCall %SelfhostReducedCall

impl Clone for SelfhostCallReduceResult:
    fn clone %fn &SelfhostCallReduceResult SelfhostCallReduceResult \self:
        *self

impl Copy for SelfhostCallReduceResult:
    fn copy_mark %fn SelfhostCallReduceResult SelfhostCallReduceResult \self:
        self

//: SelfhostCallReduceOwnedResult: arena owner を更新し得る call reduction の成功 payload
//:
//: [目的/もくてき]:
//: - source-backed argument checker は `%T literal` の `T` を TypeArena へ投影するため、call reduction の成功後に更新済み arena owner を caller へ返す必要があります。
//: - borrowed `selfhost_call_reduce_prefix` は stage0 / fail-closed 用に残し、owner を扱う入口だけがこの payload を返します。
//:
//: [契約/けいやく]:
//: - `result` は `SelfhostCallReduceResult` と同じ direct call plan です。
//: - `checked_arguments` は source-backed argument checker が得た引数ごとの typed evidence です。HIR lowering はここから function value / nested call / block result を再計算せずに参照できます。
//: - `arena` は成功時に caller が所有します。失敗時、owner-returning reducer は受け取った arena を解放してから error を返します。
pub struct SelfhostCallReduceOwnedResult:
    arena %SelfhostTypeArena
    result %SelfhostCallReduceResult
    checked_arguments %Vec SelfhostCheckedArgument

//: SelfhostCallReduceOwnedResultParts: owned result を消費して取り出す field 群
//:
//: [目的/もくてき]:
//: - arena owner、copyable な reduction result、checked argument list owner をまとめて次の owner payload へ移すための一時構造です。
//: - caller が `SelfhostCallReduceOwnedResult` から複数 field を個別に取り出して owner を落とす退行を避けます。
pub struct SelfhostCallReduceOwnedResultParts:
    arena %SelfhostTypeArena
    result %SelfhostCallReduceResult
    checked_arguments %Vec SelfhostCheckedArgument

//: SelfhostCallReduceErrorKind: call reduction の失敗分類
//:
//: [目的/もくてき]:
//: - parser 入力不正、名前解決失敗、callable でない値、partial application、argument type mismatch、argument ascription failure、argument name evidence failure、argument function value evidence failure、未対応の実引数式、overload、generic、expected type mismatch を enum として分けます。
//: - display text は別 module の diagnostic projection へ移し、checker 本体はこの分類を返します。
//: - `UnsupportedArgumentExpression` は、ascription 付き引数や nested call のように 1 個の prefix item では型証拠を得られないが、raw item 数で overload 失敗へ潰してはいけない場合に使います。
//: - `ArgumentAscriptionProjectionFailed` と `ArgumentAscriptionExpectedTypeConflict` は、argument-scope `%T expr` の型注釈自体の不備と expected parameter type との衝突を分けます。
//: - `ArgumentNamedValue*` は、argument position の名前が値として解決できない場合と、値は解決できるが型証拠がまだ無い場合を分けます。
//: - `ArgumentFunctionValue*` は、明示 `@ident` を function value argument として扱うための expected function type、callable identity、signature、monomorphic check、型一致の失敗を分けます。
//: - `ArgumentLiteral*` は、source-backed literal payload 生成で token 参照や意味値解析に失敗した場合を分けます。literal decode の失敗を unsupported expression へ潰してはいけません。
//: - `ArgumentNestedCandidate*` は、nested named call argument の head を function candidate として収集する段階の不整合を分けます。
//: - `TrailingBlockBody*` は、末尾 block argument の nested body を `BlockResult` expectation で検査する前の入力構築失敗を分けます。partial application や raw arity error へ潰してはいけません。
//: - `UnexpectedTrailingBlockArgument` は、candidate の parameter をすでにすべて消費した後に `BlockIntro.body` が残った場合です。
pub enum SelfhostCallReduceErrorKind:
    EmptyInput
    UnsupportedPrefixItem
    UnresolvedName
    NotCallable
    PartialApplicationRejected
    ArgumentTypeMismatch
    ArgumentAscriptionProjectionFailed
    ArgumentAscriptionExpectedTypeConflict
    ArgumentNamedValueUnresolved
    ArgumentNamedValuePendingBinding
    ArgumentNamedValueUnsupportedBinding
    ArgumentNamedValueEvidenceMissing
    ArgumentFunctionValueExpectedFunctionType
    ArgumentFunctionValueMissingName
    ArgumentFunctionValueUnresolved
    ArgumentFunctionValueAmbiguous
    ArgumentFunctionValuePendingBinding
    ArgumentFunctionValueMissingSignature
    ArgumentFunctionValueHeadTokenOutOfBounds
    ArgumentFunctionValueOutOfMemory
    ArgumentFunctionValueGenericUnsupported
    ArgumentFunctionValueTypeMismatch
    ArgumentLiteralTokenOutOfBounds
    ArgumentLiteralBoolInvalid
    ArgumentLiteralI32Invalid
    ArgumentLiteralI32RadixUnsupported
    ArgumentLiteralStringMalformed
    ArgumentLiteralStringEscapeUnsupported
    ArgumentNestedCandidatePendingBinding
    ArgumentNestedCandidateMissingSignature
    ArgumentNestedCandidateHeadTokenOutOfBounds
    ArgumentNestedCandidateOutOfMemory
    ArgumentNestedCandidateInternalInvariant
    TrailingBlockBodySegmentFailed
    TrailingBlockBodyEmpty
    TrailingBlockBodyMultipleSegments
    TrailingBlockBodyNestedBlockUnsupported
    TrailingBlockBodyPrefixBuildFailed
    TrailingBlockBodyCandidateCollectFailed
    UnexpectedTrailingBlockArgument
    UnsupportedArgumentExpression
    OverloadNoCandidate
    OverloadAmbiguous
    GenericInferenceEvidenceMissing
    GenericInferenceConflict
    GenericInferenceUnsupported
    ExpectedTypeMismatch
    OutOfMemory
    InternalInvariant

impl Clone for SelfhostCallReduceErrorKind:
    fn clone %fn &SelfhostCallReduceErrorKind SelfhostCallReduceErrorKind \self:
        *self

impl Copy for SelfhostCallReduceErrorKind:
    fn copy_mark %fn SelfhostCallReduceErrorKind SelfhostCallReduceErrorKind \self:
        self

//: selfhost_call_reduce_owned_result_new: owner 付き call reduction 成功 payload を[作/つく]る
pub fn selfhost_call_reduce_owned_result_new %impure fn SelfhostTypeArena impure fn SelfhostCallReduceResult impure fn Vec SelfhostCheckedArgument SelfhostCallReduceOwnedResult \arena\result\checked_arguments:
    SelfhostCallReduceOwnedResult arena result checked_arguments

//: selfhost_call_reduce_owned_result_result: direct call plan を borrow で[返/かえ]す
pub fn selfhost_call_reduce_owned_result_result %fn &SelfhostCallReduceOwnedResult &SelfhostCallReduceResult \owned:
    field::get_ref owned "result"

//: selfhost_call_reduce_owned_result_checked_arguments: checked argument list を borrow で[返/かえ]す
pub fn selfhost_call_reduce_owned_result_checked_arguments %fn &SelfhostCallReduceOwnedResult &Vec SelfhostCheckedArgument \owned:
    field::get_ref owned "checked_arguments"

//: selfhost_call_reduce_owned_result_into_arena: updated arena owner を[取/と]り[出/だ]す
//:
//: [注意/ちゅうい]:
//: - この互換 helper は checked argument list を解放してから arena だけを返します。checked argument を後続へ渡す caller は `selfhost_call_reduce_owned_result_into_parts` を使ってください。
pub fn selfhost_call_reduce_owned_result_into_arena %impure fn SelfhostCallReduceOwnedResult SelfhostTypeArena \owned:
    v::free field::get owned "checked_arguments"
    field::get owned "arena"

//: selfhost_call_reduce_owned_result_into_parts: owner result を field owner 群へ[分解/ぶんかい]する
pub fn selfhost_call_reduce_owned_result_into_parts %impure fn SelfhostCallReduceOwnedResult SelfhostCallReduceOwnedResultParts \owned:
    let arena %SelfhostTypeArena field::get owned "arena"
    let result %SelfhostCallReduceResult field::get owned "result"
    let checked_arguments %Vec SelfhostCheckedArgument field::get owned "checked_arguments"
    SelfhostCallReduceOwnedResultParts arena result checked_arguments

//: selfhost_call_reduce_owned_result_parts_into_arena: parts から arena owner を[取/と]り[出/だ]す
pub fn selfhost_call_reduce_owned_result_parts_into_arena %impure fn SelfhostCallReduceOwnedResultParts SelfhostTypeArena \parts:
    v::free field::get parts "checked_arguments"
    field::get parts "arena"

//: SelfhostCallReduceError: call reduction 失敗の typed payload
//:
//: [目的/もくてき]:
//: - error kind と span を常に保持し、generic 関連の失敗では generic state も併せて返します。
//: - `generic_state` が `NoneRequired` の場合、その error は generic solver 由来ではありません。
pub struct SelfhostCallReduceError:
    kind %SelfhostCallReduceErrorKind
    span %SelfhostSourceSpan
    generic_state %SelfhostGenericInferenceState

impl Clone for SelfhostCallReduceError:
    fn clone %fn &SelfhostCallReduceError SelfhostCallReduceError \self:
        *self

impl Copy for SelfhostCallReduceError:
    fn copy_mark %fn SelfhostCallReduceError SelfhostCallReduceError \self:
        self

//: selfhost_reduced_call_new: direct call reduction payload を[作/つく]る
pub fn selfhost_reduced_call_new %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan SelfhostReducedCall \candidate_index\argument_count\result_type\span:
    SelfhostReducedCall candidate_index argument_count result_type span

//: selfhost_trailing_block_argument_new: 末尾 block argument evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - `BlockIntro.body` の syntax range と diagnostic 用 span をまとめ、call reducer へ typed payload として渡します。
//: - nested body はここで prefix 化しません。block result checker が expected type を持って再帰検査するまで、range evidence として保持します。
pub fn selfhost_trailing_block_argument_new %fn SelfhostSyntaxRange fn SelfhostSourceSpan SelfhostTrailingBlockArgument \body\span:
    SelfhostTrailingBlockArgument body span

//: selfhost_call_reduce_error_new: non-generic call reduction error を[作/つく]る
pub fn selfhost_call_reduce_error_new %fn SelfhostCallReduceErrorKind fn SelfhostSourceSpan SelfhostCallReduceError \kind\span:
    SelfhostCallReduceError kind span SelfhostGenericInferenceState::NoneRequired

//: selfhost_call_reduce_error_generic: generic call reduction error を[作/つく]る
pub fn selfhost_call_reduce_error_generic %fn SelfhostCallReduceErrorKind fn SelfhostSourceSpan fn SelfhostGenericInferenceState SelfhostCallReduceError \kind\span\state:
    SelfhostCallReduceError kind span state

//: selfhost_call_reduce_error_kind_eq: error kind が同じ分類か[返/かえ]す
pub fn selfhost_call_reduce_error_kind_eq %fn SelfhostCallReduceErrorKind fn SelfhostCallReduceErrorKind bool \a\b:
    match a:
        SelfhostCallReduceErrorKind::EmptyInput:
            match b:
                SelfhostCallReduceErrorKind::EmptyInput:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::UnsupportedPrefixItem:
            match b:
                SelfhostCallReduceErrorKind::UnsupportedPrefixItem:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::UnresolvedName:
            match b:
                SelfhostCallReduceErrorKind::UnresolvedName:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::NotCallable:
            match b:
                SelfhostCallReduceErrorKind::NotCallable:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::PartialApplicationRejected:
            match b:
                SelfhostCallReduceErrorKind::PartialApplicationRejected:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentTypeMismatch:
            match b:
                SelfhostCallReduceErrorKind::ArgumentTypeMismatch:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentAscriptionProjectionFailed:
            match b:
                SelfhostCallReduceErrorKind::ArgumentAscriptionProjectionFailed:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentAscriptionExpectedTypeConflict:
            match b:
                SelfhostCallReduceErrorKind::ArgumentAscriptionExpectedTypeConflict:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentNamedValueUnresolved:
            match b:
                SelfhostCallReduceErrorKind::ArgumentNamedValueUnresolved:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentNamedValuePendingBinding:
            match b:
                SelfhostCallReduceErrorKind::ArgumentNamedValuePendingBinding:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentNamedValueUnsupportedBinding:
            match b:
                SelfhostCallReduceErrorKind::ArgumentNamedValueUnsupportedBinding:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentNamedValueEvidenceMissing:
            match b:
                SelfhostCallReduceErrorKind::ArgumentNamedValueEvidenceMissing:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValueExpectedFunctionType:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValueExpectedFunctionType:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingName:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingName:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValueUnresolved:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValueUnresolved:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValueAmbiguous:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValueAmbiguous:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValuePendingBinding:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValuePendingBinding:
                    true
                _:
                    false
        SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingSignature:
            match b:
                SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingSignature:
