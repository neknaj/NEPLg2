#indent 4

//: # check/expr/stage0
//: expression call reduction の smoke test API と focused fixture helper を置く module です。
//:
//: [目的/もくてき]:
//: - `SelfhostExprPrefixList`、callable candidate、type arena を実際に組み合わせ、call reduction の成功と fail-closed error を小さく確認します。
//: - doctest 側が owner-backed `SelfhostTypeArena` を独自 aggregate に包まずに済むよう、stdlib 内の helper で fixture を構築します。
//:
//: [契約/けいやく]:
//: - この module は stage0 fixture だけを持ちます。production の reduction 規則は `call_reduce.nepl` に置きます。
//: - fixture は parser / lexer を通さず、typed prefix item を直接作ります。これにより call reduction の責務だけを検査します。
//:
//: [計算量/けいさんりょう]:
//: - fixture prefix list の構築は引数数 k に対して O(k) です。
//: - stage0 全体は固定サイズの候補と型だけを作るため O(1) です。

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/syntax/ast/prefix_expr" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *
#import "./expectation" as *
#import "./call_candidate" as *
#import "./model" as *
#import "./call_reduce" as *

//: selfhost_check_expr_stage0_push_arg_item_kind: fixture 用の argument item を 1 つ[追加/ついか]する
//:
//: [目的/もくてき]:
//: - stage0 fixture が `IntLiteral` だけでなく、意図的な型不一致を作れるよう item kind を明示して push します。
//: - token index と span は固定 fixture の位置情報であり、diagnostic kind の確認に必要な最小 evidence だけを持たせます。
fn selfhost_check_expr_stage0_push_arg_item_kind %impure fn Vec SelfhostExprPrefixItem impure fn i32 impure fn SelfhostExprPrefixItemKind Result Vec SelfhostExprPrefixItem StdErrorKind \items\idx\kind:
    let span %SelfhostSourceSpan source_span_new_unchecked 0 add idx 4 add idx 5
    let item %SelfhostExprPrefixItem selfhost_expr_prefix_item_new kind add idx 1 span
    match v::push items item:
        Result::Ok next_items:
            Result::Ok next_items
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_check_expr_stage0_push_arg_items: `IntLiteral` の fixture 引数列を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - `add 1 2` のような通常成功経路を作るため、`n` 個の `IntLiteral` item を prefix list に追加します。
//: - 実装は `selfhost_check_expr_stage0_push_arg_item_kind` を再利用し、型不一致 fixture と同じ token index / span 規則を使います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(items)`: すべての item を追加できました。
//: - `Err(error)`: Vec push が失敗したため、caller が fixture 構築失敗として扱います。
fn selfhost_check_expr_stage0_push_arg_items %impure fn Vec SelfhostExprPrefixItem impure fn i32 impure fn i32 Result Vec SelfhostExprPrefixItem StdErrorKind \items\n\idx:
    if:
        ge idx n
        then:
            Result::Ok items
        else:
            match selfhost_check_expr_stage0_push_arg_item_kind items idx SelfhostExprPrefixItemKind::IntLiteral:
                Result::Ok next_items:
                    selfhost_check_expr_stage0_push_arg_items next_items n add idx 1
                Result::Err error:
                    Result::Err error

//: selfhost_check_expr_stage0_make_prefix: `add` head と固定数の実引数 item を持つ prefix list を[作/つく]る
//:
//: [目的/もくてき]:
//: - `selfhost_call_reduce_prefix` へ渡す最小 fixture として、先頭 `NamedValue` と `argument_count` 個の `IntLiteral` を構築します。
//: - lexer / parser を通さず、call reducer が要求する prefix item evidence だけを直接作ることで、失敗時の原因を call reduction へ集中させます。
//:
//: [契約/けいやく]:
//: - 成功時に返す `SelfhostExprPrefixList` は caller が必ず `selfhost_expr_prefix_list_free` で閉じます。
//: - Vec push 失敗時は、push error payload から元の Vec owner を回収して解放し、`StdErrorKind` だけを返します。
//: - `argument_count` は fixture 用の小さい非負値を想定します。負値や極端な値の正規化は、この smoke helper の責務ではありません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(prefix)`: call reducer 入力に使える owner 付き prefix list です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - `argument_count` を n とすると、item 追加は O(n) です。
fn selfhost_check_expr_stage0_make_prefix %impure fn i32 Result SelfhostExprPrefixList StdErrorKind \argument_count:
    let items_result %Result Vec SelfhostExprPrefixItem StdErrorKind v::new
    match items_result:
        Result::Ok items0:
            let head %SelfhostExprPrefixItem selfhost_expr_prefix_item_new SelfhostExprPrefixItemKind::NamedValue 0 source_span_new_unchecked 0 0 3
            match v::push items0 head:
                Result::Ok items1:
                    match selfhost_check_expr_stage0_push_arg_items items1 argument_count 0:
                        Result::Ok items2:
                            Result::Ok selfhost_expr_prefix_list_new items2
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err error
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage0_make_prefix_with_first_arg: 先頭実引数だけ型を差し替えた prefix fixture を[作/つく]る
//:
//: [目的/もくてき]:
//: - `add <first> 1` の形を作り、callee の parameter type と実引数 item kind が食い違う場合の reducer 診断を検査します。
//: - 2 番目の引数は `IntLiteral` に固定し、失敗原因が先頭引数の型不一致に集中するようにします。
//:
//: [契約/けいやく]:
//: - 成功時に返す `SelfhostExprPrefixList` は caller が `selfhost_expr_prefix_list_free` で解放します。
//: - 途中で Vec push が失敗した場合は、push error payload から元の Vec owner を回収して解放します。
//: - この helper は argument type mismatch fixture 専用であり、arbitrary expression kind の型推論は行いません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(prefix)`: 先頭実引数 kind だけを caller 指定にした owner 付き prefix list です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - head と実引数 2 件だけを作るため O(1) です。
fn selfhost_check_expr_stage0_make_prefix_with_first_arg %impure fn SelfhostExprPrefixItemKind Result SelfhostExprPrefixList StdErrorKind \first_arg_kind:
    let items_result %Result Vec SelfhostExprPrefixItem StdErrorKind v::new
    match items_result:
        Result::Ok items0:
            let head %SelfhostExprPrefixItem selfhost_expr_prefix_item_new SelfhostExprPrefixItemKind::NamedValue 0 source_span_new_unchecked 0 0 3
            match v::push items0 head:
                Result::Ok items1:
                    match selfhost_check_expr_stage0_push_arg_item_kind items1 0 first_arg_kind:
                        Result::Ok items2:
                            match selfhost_check_expr_stage0_push_arg_item_kind items2 1 SelfhostExprPrefixItemKind::IntLiteral:
                                Result::Ok items3:
                                    Result::Ok selfhost_expr_prefix_list_new items3
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err error
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage0_make_prefix_with_ascribed_first_arg: `%T literal` を先頭実引数にした prefix fixture を[作/つく]る
//:
//: [目的/もくてき]:
//: - `add %i32 1 2` に相当する flat prefix item 列を、lexer / parser を通さずに stage0 で構築します。
//: - 現 checkpoint の `SelfhostExprPrefixList` は token kind と span だけを持ち、`i32` という type token の text を保持しません。そのため、この fixture は `%T literal` の成功ではなく「raw item 数を arity とみなさず、typed unsupported として拒否する」契約を検査します。
//:
//: [契約/けいやく]:
//: - 成功時に返す `SelfhostExprPrefixList` は caller が `selfhost_expr_prefix_list_free` で解放します。
//: - `%T literal` は 3 個の raw prefix item で表し、reducer が raw item count を直接 arity とみなさないことを検査します。
//: - この helper は type text や type resolver を持たないため、型注釈の成功 projection は `ascription.nepl` 側の責務です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(prefix)`: ascribed argument unsupported fixture として使う owner 付き prefix list です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - head、type marker、type head、literal 2 件の固定構築なので O(1) です。
fn selfhost_check_expr_stage0_make_prefix_with_ascribed_first_arg %impure fn void Result SelfhostExprPrefixList StdErrorKind \void:
    let items_result %Result Vec SelfhostExprPrefixItem StdErrorKind v::new
    match items_result:
        Result::Ok items0:
            let head %SelfhostExprPrefixItem selfhost_expr_prefix_item_new SelfhostExprPrefixItemKind::NamedValue 0 source_span_new_unchecked 0 0 3
            match v::push items0 head:
                Result::Ok items1:
                    match selfhost_check_expr_stage0_push_arg_item_kind items1 0 SelfhostExprPrefixItemKind::TypeAnnotationMarker:
                        Result::Ok items2:
                            match selfhost_check_expr_stage0_push_arg_item_kind items2 1 SelfhostExprPrefixItemKind::NamedValue:
                                Result::Ok items3:
                                    match selfhost_check_expr_stage0_push_arg_item_kind items3 2 SelfhostExprPrefixItemKind::IntLiteral:
                                        Result::Ok items4:
                                            match selfhost_check_expr_stage0_push_arg_item_kind items4 3 SelfhostExprPrefixItemKind::IntLiteral:
                                                Result::Ok items5:
                                                    Result::Ok selfhost_expr_prefix_list_new items5
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err error
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage0_make_candidate_vec: `add` callable candidate table を 1 件だけ[作/つく]る
//:
//: [目的/もくてき]:
//: - stage0 の reduction smoke が overload candidate collection を経由せず、手組みの候補集合だけで reducer を検査できるようにします。
//: - `generic_state` を候補 payload に入れ、generic evidence missing の失敗分類も同じ入口で確認できるようにします。
//:
//: [契約/けいやく]:
//: - 成功時に返す candidate Vec owner は caller が `v::free` で閉じます。
//: - 候補名は `"add"`、DefId は fixture 固定値です。名前解決や module surface の正しさはこの helper の責務ではありません。
//: - Vec push 失敗時は push error payload から Vec owner を回収して解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidates)`: reducer 入力に使う 1 件の callable candidate Vec です。
//: - `Err(error)`: Vec 確保または push が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 件の候補だけを作るため O(1) です。
fn selfhost_check_expr_stage0_make_candidate_vec %impure fn SelfhostTypeId impure fn SelfhostGenericInferenceState Result Vec SelfhostCallableCandidate StdErrorKind \callable_type\generic_state:
    let candidates_result %Result Vec SelfhostCallableCandidate StdErrorKind v::new
    match candidates_result:
        Result::Ok candidates0:
            let candidate %SelfhostCallableCandidate selfhost_callable_candidate_new "add" selfhost_def_id_new 0 callable_type SelfhostEffectKind::Pure generic_state source_span_new_unchecked 0 0 3
            match v::push candidates0 candidate:
                Result::Ok candidates1:
                    Result::Ok candidates1
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err error
        Result::Err e:
            Result::Err e

//: selfhost_check_expr_stage0_reduce: prefix fixture と candidate fixture を組み合わせて reducer を[実行/じっこう]する
//:
//: [目的/もくてき]:
//: - stage0 smoke の共通入口として、prefix list と candidate Vec の構築、`selfhost_call_reduce_prefix` 呼び出し、owner cleanup を 1 箇所に集めます。
//: - caller は argument count、generic state、expected result だけを差し替えて、success / partial application / expected mismatch などを検査できます。
//:
//: [契約/けいやく]:
//: - `arena` は borrow で受け取り、この helper は arena owner を消費しません。
//: - prefix list と candidate Vec はこの helper が生成し、reducer 呼び出し後に必ず解放します。
//: - fixture 構築失敗は reducer の通常 error と同じ `SelfhostCallReduceError` へ変換し、`OutOfMemory` として返します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(result)`: call reducer が返した success payload です。
//: - `Err(error)`: reducer の typed error、または fixture 構築失敗を表す `OutOfMemory` です。
//:
//: [計算量/けいさんりょう]:
//: - prefix fixture 構築は `argument_count` を n として O(n) です。candidate は固定 1 件です。
fn selfhost_check_expr_stage0_reduce %impure fn &SelfhostTypeArena impure fn SelfhostTypeId impure fn i32 impure fn SelfhostGenericInferenceState impure fn Option SelfhostTypeExpectation Result SelfhostCallReduceResult SelfhostCallReduceError \arena\add_type\argument_count\generic_state\expected:
    match selfhost_check_expr_stage0_make_prefix argument_count:
        Result::Ok prefix:
            match selfhost_check_expr_stage0_make_candidate_vec add_type generic_state:
                Result::Ok candidates:
                    let result %Result SelfhostCallReduceResult SelfhostCallReduceError selfhost_call_reduce_prefix arena &prefix &candidates expected
                    v::free candidates
                    selfhost_expr_prefix_list_free prefix
                    result
                Result::Err _e:
                    selfhost_expr_prefix_list_free prefix
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OutOfMemory source_span_empty_unchecked 0 0
        Result::Err _e:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OutOfMemory source_span_empty_unchecked 0 0

//: selfhost_check_expr_stage0_error_is: reducer 結果が期待 error kind か[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - stage0 smoke が表示文字列ではなく `SelfhostCallReduceErrorKind` の enum で失敗分類を確認できるようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `result` が `Err` で、error kind が `expected` と一致します。
//: - `false`: success だった、または error kind が異なります。
//:
//: [計算量/けいさんりょう]:
//: - enum payload 1 個を見るだけなので O(1) です。
fn selfhost_check_expr_stage0_error_is %fn Result SelfhostCallReduceResult SelfhostCallReduceError fn SelfhostCallReduceErrorKind bool \result\expected:
    match result:
        Result::Ok _reduced:
            false
        Result::Err e:
            selfhost_call_reduce_error_kind_eq e.kind expected

//: selfhost_check_expr_stage0_direct_ok: 2 引数 direct call が成功するか[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `add 1 2` 相当の fixture が partial application や overload error ではなく、`DirectCall` として縮約されることを確認します。
//: - 返り値 type が fixture の `i32_type` と一致することも同時に確認します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `DirectCall` で argument count が 2、result type が i32 でした。
//: - `false`: reducer が error を返した、または success payload が期待と異なります。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 引数 fixture なので O(1) です。
fn selfhost_check_expr_stage0_direct_ok %impure fn &SelfhostTypeArena impure fn SelfhostTypeId impure fn SelfhostTypeId bool \arena\i32_type\add_type:
    match selfhost_check_expr_stage0_reduce arena add_type 2 SelfhostGenericInferenceState::NoneRequired none:
        Result::Ok reduced:
            match reduced:
                SelfhostCallReduceResult::DirectCall call:
                    and eq call.argument_count 2 selfhost_type_id_eq call.result_type i32_type
        Result::Err _e:
            false

//: selfhost_check_expr_stage0_partial_rejected: 1 引数不足が partial application として拒否されるか[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - NEPLg2.1 はカリー化風の型表記を使っても部分適用を許さないため、`add 1` 相当を `PartialApplicationRejected` として固定します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 期待した partial application rejection でした。
//: - `false`: success または別 error でした。
//:
//: [計算量/けいさんりょう]:
//: - 固定 1 引数 fixture なので O(1) です。
fn selfhost_check_expr_stage0_partial_rejected %impure fn &SelfhostTypeArena impure fn SelfhostTypeId bool \arena\add_type:
    selfhost_check_expr_stage0_error_is (selfhost_check_expr_stage0_reduce arena add_type 1 SelfhostGenericInferenceState::NoneRequired none) SelfhostCallReduceErrorKind::PartialApplicationRejected

//: selfhost_check_expr_stage0_expected_rejected: 外側 expected result との衝突が拒否されるか[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `add 1 2` は i32 を返すため、外側 expected type として bool を渡した場合に `ExpectedTypeMismatch` になることを確認します。
//: - expected source は `ExplicitAscription` の固定 span とし、diagnostic 表示ではなく reducer の typed kind を検査します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: expected type mismatch が返りました。
//: - `false`: success または別 error でした。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 引数 fixture なので O(1) です。
fn selfhost_check_expr_stage0_expected_rejected %impure fn &SelfhostTypeArena impure fn SelfhostTypeId impure fn SelfhostTypeId bool \arena\bool_type\add_type:
    let expected %SelfhostTypeExpectation selfhost_type_expectation_new bool_type SelfhostTypeExpectationSource::ExplicitAscription source_span_new_unchecked 0 0 3
    selfhost_check_expr_stage0_error_is (selfhost_check_expr_stage0_reduce arena add_type 2 SelfhostGenericInferenceState::NoneRequired some expected) SelfhostCallReduceErrorKind::ExpectedTypeMismatch

//: selfhost_check_expr_stage0_argument_type_rejected: literal 引数の型不一致が拒否されることを[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `add` 候補が `i32, i32 -> i32` を要求する状況で、先頭実引数を `BoolLiteral` に差し替えます。
//: - reducer が arity と expected result だけで成功せず、parameter type と argument evidence の不一致を `ArgumentTypeMismatch` として返すことを確認します。
//:
//: [契約/けいやく]:
//: - prefix list と candidate Vec はこの helper が作り、reducer 呼び出し後に必ず解放します。
//: - `arena` は borrow であり、この helper は type arena owner を消費しません。
//: - 失敗分類は表示文字列ではなく `SelfhostCallReduceErrorKind::ArgumentTypeMismatch` で確認します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 期待した `ArgumentTypeMismatch` が返りました。
//: - `false`: fixture 構築、候補構築、または reducer の失敗分類が期待と異なります。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 引数・候補 1 件なので O(1) です。
fn selfhost_check_expr_stage0_argument_type_rejected %impure fn &SelfhostTypeArena impure fn SelfhostTypeId bool \arena\add_type:
    match selfhost_check_expr_stage0_make_prefix_with_first_arg SelfhostExprPrefixItemKind::BoolLiteral:
        Result::Ok prefix:
            match selfhost_check_expr_stage0_make_candidate_vec add_type SelfhostGenericInferenceState::NoneRequired:
                Result::Ok candidates:
                    let result %Result SelfhostCallReduceResult SelfhostCallReduceError selfhost_call_reduce_prefix arena &prefix &candidates none
                    v::free candidates
                    selfhost_expr_prefix_list_free prefix
                    selfhost_check_expr_stage0_error_is result SelfhostCallReduceErrorKind::ArgumentTypeMismatch
                Result::Err _e:
                    selfhost_expr_prefix_list_free prefix
                    false
        Result::Err _e:
            false

//: selfhost_check_expr_stage0_ascribed_argument_unsupported: ascribed argument が raw arity 失敗に[潰/つぶ]れないことを[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - `add %i32 1 2` のような入力は、実引数式としては 2 引数ですが、flat prefix item としては callee を除いて 4 item になります。
//: - reducer が `item_count - 1` を argument count とみなして `OverloadNoCandidate` を返すと、後続の argument-scope ascription checker を接続できません。
//: - 現 checkpoint では `%T literal` の型照合に必要な source / token text がないため、正しい失敗は `UnsupportedArgumentExpression` です。
//:
//: [契約/けいやく]:
//: - prefix list と candidate Vec はこの helper が作り、reducer 呼び出し後に必ず解放します。
//: - `arena` は borrow であり、この helper は type arena owner を消費しません。
//: - `%T literal` を raw arity error や overload error へ潰さず、typed unsupported argument error として残すことを契約にします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: ascribed argument が typed unsupported として返りました。
//: - `false`: raw arity 判定や別 error に潰れています。
//:
//: [計算量/けいさんりょう]:
//: - 固定 fixture と候補 1 件だけを使うため O(1) です。
fn selfhost_check_expr_stage0_ascribed_argument_unsupported %impure fn &SelfhostTypeArena impure fn SelfhostTypeId bool \arena\add_type:
    match selfhost_check_expr_stage0_make_prefix_with_ascribed_first_arg:
        Result::Ok prefix:
            match selfhost_check_expr_stage0_make_candidate_vec add_type SelfhostGenericInferenceState::NoneRequired:
                Result::Ok candidates:
                    let result %Result SelfhostCallReduceResult SelfhostCallReduceError selfhost_call_reduce_prefix arena &prefix &candidates none
                    v::free candidates
                    selfhost_expr_prefix_list_free prefix
                    selfhost_check_expr_stage0_error_is result SelfhostCallReduceErrorKind::UnsupportedArgumentExpression
                Result::Err _e:
                    selfhost_expr_prefix_list_free prefix
                    false
        Result::Err _e:
            false

//: selfhost_check_expr_stage0_generic_rejected: generic evidence missing が typed error として残るか[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - candidate payload に `EvidenceMissing` を入れ、reducer が通常の overload failure へ潰さず `GenericInferenceEvidenceMissing` として返すことを確認します。
//: - error payload 内の generic state も同じ enum value として残ることを確認します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: error kind と generic state がどちらも期待通りでした。
//: - `false`: success、別 error、または generic state 欠落です。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 引数・候補 1 件なので O(1) です。
fn selfhost_check_expr_stage0_generic_rejected %impure fn &SelfhostTypeArena impure fn SelfhostTypeId bool \arena\add_type:
    match selfhost_check_expr_stage0_reduce arena add_type 2 SelfhostGenericInferenceState::EvidenceMissing none:
        Result::Ok _reduced:
            false
        Result::Err e:
            and:
                selfhost_call_reduce_error_kind_eq e.kind SelfhostCallReduceErrorKind::GenericInferenceEvidenceMissing
                selfhost_generic_inference_state_eq e.generic_state SelfhostGenericInferenceState::EvidenceMissing

//: selfhost_check_expr_stage0_ambiguous_rejected: 同じ call に候補が 2 件ある場合の ambiguity を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - 同じ signature の `add` candidate を 2 件作り、reducer が片方を勝手に選ばず `OverloadAmbiguous` として fail-closed になることを確認します。
//: - overload 解決の tie-break を fixture 側で暗黙に作らないため、DefId だけを変えた候補を追加します。
//:
//: [契約/けいやく]:
//: - prefix list と candidate Vec はこの helper が作り、成功/失敗のどちらでも解放します。
//: - `arena` は borrow であり、この helper は type arena owner を消費しません。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: ambiguity が expected error として返りました。
//: - `false`: success、別 error、または fixture 構築失敗です。
//:
//: [計算量/けいさんりょう]:
//: - 固定 2 候補・2 引数なので O(1) です。
fn selfhost_check_expr_stage0_ambiguous_rejected %impure fn &SelfhostTypeArena impure fn SelfhostTypeId bool \arena\add_type:
    match selfhost_check_expr_stage0_make_prefix 2:
        Result::Ok prefix:
            match selfhost_check_expr_stage0_make_candidate_vec add_type SelfhostGenericInferenceState::NoneRequired:
                Result::Ok candidates1:
                    let candidate %SelfhostCallableCandidate selfhost_callable_candidate_new "add" selfhost_def_id_new 1 add_type SelfhostEffectKind::Pure SelfhostGenericInferenceState::NoneRequired source_span_new_unchecked 0 0 3
                    match v::push candidates1 candidate:
                        Result::Ok candidates2:
                            let result %Result SelfhostCallReduceResult SelfhostCallReduceError selfhost_call_reduce_prefix arena &prefix &candidates2 none
                            v::free candidates2
                            selfhost_expr_prefix_list_free prefix
                            selfhost_check_expr_stage0_error_is result SelfhostCallReduceErrorKind::OverloadAmbiguous
                        Result::Err e:
                            v::free v::vec_push_error_vec e
                            selfhost_expr_prefix_list_free prefix
                            false
                Result::Err _e:
                    selfhost_expr_prefix_list_free prefix
                    false
        Result::Err _e:
            false

//: selfhost_check_expr_stage0_add_two_i32_function: `i32, i32 -> i32` の function type を arena に[追加/ついか]する
//:
//: [目的/もくてき]:
//: - stage0 smoke で共有する `add` candidate type を、同じ `SelfhostTypeArena` owner 内に構築します。
//: - parameter Vec も owner なので、function type allocation へ渡す前の push failure path で arena を漏らさないようにします。
//:
//: [契約/けいやく]:
//: - 成功時は `SelfhostTypeArenaAlloc` が arena owner と追加された function type id を保持します。
//: - parameter Vec の作成または push が失敗した場合、この helper が入力 arena owner を直接解放します。
//: - function type allocation が失敗した場合は、`selfhost_type_arena_add_function` が arena owner と parameter Vec owner を消費して閉じます。
//: - `i32_type` は同じ arena 内に存在する primitive type id であることを caller が保証します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(allocated)`: `i32, i32 -> i32` の function type を追加した arena allocation owner です。
//: - `Err(error)`: parameter Vec 構築または arena allocation が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - parameter 2 件の固定構築なので O(1) です。
fn selfhost_check_expr_stage0_add_two_i32_function %impure fn SelfhostTypeArena impure fn SelfhostTypeId Result SelfhostTypeArenaAlloc StdErrorKind \arena\i32_type:
    let params_result %Result Vec SelfhostTypeId StdErrorKind v::new
    match params_result:
        Result::Ok params0:
            match v::push params0 i32_type:
                Result::Ok params1:
                    match v::push params1 i32_type:
                        Result::Ok params2:
                            selfhost_type_arena_add_function arena params2 i32_type
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            selfhost_type_arena_free arena
                            Result::Err error
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    selfhost_type_arena_free arena
                    Result::Err error
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_check_expr_stage0: expression call reduction の smoke API
//:
//: [目的/もくてき]:
//: - direct call success、partial application rejection、argument type mismatch、expected type mismatch、generic evidence missing、overload ambiguity を 1 回で確認します。
//: - これは public compiler API ではなく、self-host expression checker slice の接続確認用です。
//:
//: [契約/けいやく]:
//: - この smoke API は `SelfhostTypeArena` owner を自分で作り、成功 path ではすべての stage0 check 後に解放します。
//: - setup 中に primitive type または function type allocation が失敗した場合、owner cleanup は各 allocation helper の owner contract に従います。
//: - 返り値は runner が扱いやすい `i32` status であり、詳細 diagnostic の表示や永続化はこの API の責務ではありません。
//:
//: [戻/もど]り[値/ち]:
//: - `0`: すべての stage0 checks が期待通りでした。
//: - `1`: setup または reduction のいずれかが失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の primitive type、function type、fixture reduction だけを実行するため O(1) です。
pub fn selfhost_check_expr_stage0 %impure fn void i32 \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_primitive arena0 SelfhostPrimitiveTypeKind::I32:
                Result::Ok i32_alloc:
                    let i32_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &i32_alloc
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena i32_alloc
                    match selfhost_type_arena_add_primitive arena1 SelfhostPrimitiveTypeKind::Bool:
                        Result::Ok bool_alloc:
                            let bool_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &bool_alloc
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena bool_alloc
                            match selfhost_check_expr_stage0_add_two_i32_function arena2 i32_type:
                                Result::Ok add_alloc:
                                    let add_type %SelfhostTypeId selfhost_type_arena_alloc_type_id &add_alloc
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena add_alloc
                                    let ok0 %bool selfhost_check_expr_stage0_direct_ok &arena3 i32_type add_type
                                    let ok1 %bool selfhost_check_expr_stage0_partial_rejected &arena3 add_type
                                    let ok2 %bool selfhost_check_expr_stage0_expected_rejected &arena3 bool_type add_type
                                    let ok3 %bool selfhost_check_expr_stage0_argument_type_rejected &arena3 add_type
                                    let ok4 %bool selfhost_check_expr_stage0_generic_rejected &arena3 add_type
                                    let ok5 %bool selfhost_check_expr_stage0_ambiguous_rejected &arena3 add_type
                                    let ok6 %bool selfhost_check_expr_stage0_ascribed_argument_unsupported &arena3 add_type
                                    selfhost_type_arena_free arena3
                                    if and ok0 and ok1 and ok2 and ok3 and ok4 and ok5 ok6 0 1
                                Result::Err _e:
                                    1
                        Result::Err _e:
                            1
                Result::Err _e:
                    1
        Result::Err _e:
            1
