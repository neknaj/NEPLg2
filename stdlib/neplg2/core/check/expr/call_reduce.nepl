            selfhost_checked_expr_tree_free checked_tree
            Result::Err selfhost_call_reduce_error_from_block_body_result block_error

//: selfhost_call_reduce_argument_type_check_loop_with_source: source-backed に実引数式 cursor を[照合/しょうごう]する
//:
//: [目的/もくてき]:
//: - `%T literal` や `%T NamedValue` のように source text、token buffer、scope、value type evidence が必要な argument expression を扱うため、arena owner を受け渡しながら argument loop を進めます。
//: - borrowed loop と同じ parameter / item cursor 境界を使い、source-backed checker だけが ascription projection と named value evidence lookup を成功させます。
//: - nested named call argument は scope と callable signature table から nested head の候補を集め、expected parameter type を nested expression の result expectation として縮約します。
//:
//: [契約/けいやく]:
//: - 成功時は更新済み `SelfhostTypeArena` owner と checked argument list owner を返します。
//: - 失敗時、この関数または argument checker が arena owner を解放します。
//: - `param_idx` が `param_count` に到達した時点で `item_index == item_count` なら完全飽和です。
fn selfhost_call_reduce_argument_type_check_loop_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn Vec SelfhostCheckedArgument impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem Result SelfhostCallReduceArgumentCheckState SelfhostCallReduceError \tokens\source\arena\checked_arguments\checked_tree\prefix\scope\value_types\signatures\candidate\param_count\param_idx\item_index\item_count\trailing_block\head:
    if:
        ge param_idx param_count
        then:
            if:
                eq item_index item_count
                then:
                    match trailing_block:
                        Option::Some block_arg:
                            selfhost_call_reduce_free_argument_state_error arena checked_arguments checked_tree selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnexpectedTrailingBlockArgument block_arg.span
                        Option::None:
                            Result::Ok selfhost_call_reduce_argument_check_state_new arena checked_arguments checked_tree
                else:
                    selfhost_call_reduce_free_argument_state_error arena checked_arguments checked_tree selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadNoCandidate head.span
        else:
            if:
                ge item_index item_count
                then:
                    match trailing_block:
                        Option::Some block_arg:
                            match selfhost_type_arena_function_arg &arena candidate.callable_type param_idx:
                                Option::Some expected_arg_type:
                                    match selfhost_call_reduce_trailing_block_body_result tokens source arena checked_tree scope value_types signatures expected_arg_type block_arg item_index:
                                        Result::Ok match_state:
                                            let checked_arena %SelfhostTypeArena field::get match_state "arena"
                                            let next_tree %SelfhostCheckedExprTree field::get match_state "checked_tree"
                                            let checked_argument %SelfhostCheckedArgument field::get match_state "checked_argument"
                                            match selfhost_call_reduce_push_checked_argument checked_arena checked_arguments next_tree checked_argument block_arg.span:
                                                Result::Ok state:
                                                    let next_arena %SelfhostTypeArena field::get state "arena"
                                                    let next_arguments %Vec SelfhostCheckedArgument field::get state "checked_arguments"
                                                    let state_tree %SelfhostCheckedExprTree field::get state "checked_tree"
                                                    selfhost_call_reduce_argument_type_check_loop_with_source tokens source next_arena next_arguments state_tree prefix scope value_types signatures candidate param_count add param_idx 1 item_index item_count none head
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            v::free checked_arguments
                                            Result::Err e
                                Option::None:
                                    selfhost_call_reduce_free_argument_state_error arena checked_arguments checked_tree selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span
                        Option::None:
                            selfhost_call_reduce_free_argument_state_error arena checked_arguments checked_tree selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PartialApplicationRejected head.span
                else:
                    match selfhost_type_arena_function_arg &arena candidate.callable_type param_idx:
                        Option::Some expected_arg_type:
                            match selfhost_call_reduce_argument_match_at_with_source_or_nested tokens source arena checked_tree prefix scope value_types signatures item_index item_count expected_arg_type head:
                                Result::Ok match_state:
                                    let argument_match %SelfhostExprArgumentMatch field::get match_state "match_value"
                                    let checked_argument %SelfhostCheckedArgument field::get match_state "checked_argument"
                                    let next_arena %SelfhostTypeArena field::get match_state "arena"
                                    let next_tree %SelfhostCheckedExprTree field::get match_state "checked_tree"
                                    match selfhost_call_reduce_push_checked_argument next_arena checked_arguments next_tree checked_argument head.span:
                                        Result::Ok state:
                                            let checked_arena %SelfhostTypeArena field::get state "arena"
                                            let next_arguments %Vec SelfhostCheckedArgument field::get state "checked_arguments"
                                            let state_tree %SelfhostCheckedExprTree field::get state "checked_tree"
                                            selfhost_call_reduce_argument_type_check_loop_with_source tokens source checked_arena next_arguments state_tree prefix scope value_types signatures candidate param_count add param_idx 1 argument_match.next_index item_count trailing_block head
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    v::free checked_arguments
                                    Result::Err e
                        Option::None:
                            selfhost_call_reduce_free_argument_state_error arena checked_arguments checked_tree selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_single_named_candidate: source-less に 1 candidate の direct call を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - source text を必要としない最小 reducer として、flat prefix item の型証拠だけで direct call plan を作ります。
//: - `%T expr`、named value argument、nested call など source-backed checker が必要な引数は成功扱いせず、typed error として上位へ返します。
//:
//: [契約/けいやく]:
//: - partial application は許可せず、parameter が残った場合は `PartialApplicationRejected` を返します。
//: - generic state と result expectation は、この関数の中で必ず確認します。
//: - checked argument evidence は作らない source-less 経路であり、HIR lowering に詳細 payload が必要な入口では source-backed reducer を使います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(DirectCall)`: source-less に検査できる direct call plan です。
//: - `Err(error)`: generic 未対応、callable でない候補、実引数不足、型不一致、unsupported argument、または result expectation 不一致です。
//:
//: [計算量/けいさんりょう]:
//: - parameter 数を p とすると、実引数走査は O(p) です。各 item の型証拠確認は source-less helper のコストに従います。
fn selfhost_call_reduce_single_named_candidate %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn i32 fn SelfhostExprPrefixItem fn SelfhostCallableCandidate fn Option SelfhostTypeExpectation Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\item_count\head\candidate\expected:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _:
            match selfhost_type_arena_function_arg_count arena candidate.callable_type:
                Option::Some param_count:
                    match selfhost_call_reduce_argument_type_check_loop arena prefix candidate param_count 0 1 item_count head:
                        Result::Ok _:
                            match selfhost_call_reduce_expected_result arena candidate expected:
                                Result::Ok result_type:
                                    Result::Ok SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            Result::Err e

//: selfhost_call_reduce_single_named_candidate_with_source: source-backed に 1 candidate の direct call を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - named head に対して候補が 1 つに絞れた後、実引数列、末尾 block argument、期待 result type をまとめて検査します。
//: - 成功時には direct call plan に加えて、各実引数から得た checked argument evidence を owner result に保持します。
//:
//: [契約/けいやく]:
//: - generic candidate は `selfhost_call_reduce_generic_state_error` で fail-closed にし、未解決の型変数を HIR plan へ流しません。
//: - `arena` と checked argument Vec は成功時に `SelfhostCallReduceOwnedResult` へ移り、失敗時にはこの関数または下位 helper が閉じます。
//: - `trailing_block` がある場合は、parameter 不足位置でだけ block body result として消費します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: direct call plan、result type、checked argument evidence、更新済み arena owner を返します。
//: - `Err(error)`: generic 未対応、callable でない候補、引数検査失敗、result expectation 不一致、または OOM です。
//:
//: [計算量/けいさんりょう]:
//: - parameter 数を p とすると、実引数消費は O(p) 回の検査です。各 argument の検査コストは ascription/nested call/source token lookup に依存します。
fn selfhost_call_reduce_single_named_candidate_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn SelfhostExprPrefixItem impure fn SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\item_count\head\candidate\expected\trailing_block:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _:
            match selfhost_type_arena_function_arg_count &arena candidate.callable_type:
                Option::Some param_count:
                    let checked_arguments_result %Result Vec SelfhostCheckedArgument StdErrorKind v::new
                    match checked_arguments_result:
                        Result::Ok checked_arguments:
                            match selfhost_call_reduce_argument_type_check_loop_with_source tokens source arena checked_arguments checked_tree prefix scope value_types signatures candidate param_count 0 1 item_count trailing_block head:
                                Result::Ok state:
                                    let checked_arena %SelfhostTypeArena field::get state "arena"
                                    let checked_arguments_result %Vec SelfhostCheckedArgument field::get state "checked_arguments"
                                    let checked_tree_result %SelfhostCheckedExprTree field::get state "checked_tree"
                                    match selfhost_call_reduce_expected_result &checked_arena candidate expected:
                                        Result::Ok result_type:
                                            match selfhost_checked_expr_tree_add_direct_call_borrowed checked_tree_result candidate result_type head.span &checked_arguments_result:
                                                Result::Ok root_alloc:
                                                    let root_expr %SelfhostCheckedExprId selfhost_checked_expr_node_alloc_expr_id &root_alloc
                                                    let root_tree %SelfhostCheckedExprTree selfhost_checked_expr_node_alloc_into_tree root_alloc
                                                    let result %SelfhostCallReduceResult SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                                    Result::Ok selfhost_call_reduce_owned_result_new checked_arena result checked_arguments_result root_tree root_expr
                                                Result::Err tree_error:
                                                    selfhost_type_arena_free checked_arena
                                                    v::free checked_arguments_result
                                                    Result::Err selfhost_call_reduce_error_from_checked_tree_std_error tree_error head.span
                                        Result::Err e:
                                            selfhost_type_arena_free checked_arena
                                            v::free checked_arguments_result
                                            selfhost_checked_expr_tree_free checked_tree_result
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err _alloc_error:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OutOfMemory head.span
                Option::None:
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_existing_error arena e

//: selfhost_call_reduce_named_prefix: source-less に named head の候補数を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - prefix head が named value であることを確認済みの状態で、候補 0/1/複数を direct call reduction の error または single-candidate reducer へ分配します。
//: - source-less reducer の入口として、候補が複数ある場合に探索を広げず `OverloadAmbiguous` で止めます。
//:
//: [契約/けいやく]:
//: - 候補 0 は unresolved name、候補複数は ambiguity として扱います。
//: - この関数は `candidates` を borrow するだけで、Vec owner を解放しません。
//: - 1 候補の場合だけ `selfhost_call_reduce_single_named_candidate` に進みます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(result)`: 唯一候補で source-less direct call plan が作れました。
//: - `Err(error)`: 未解決、曖昧、candidate Vec 不整合、または single-candidate reducer の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - candidate 数判定は O(1) です。1 候補の場合の支配的コストは single-candidate reducer に従います。
fn selfhost_call_reduce_named_prefix %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn SelfhostExprPrefixItem fn i32 Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\candidates\expected\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate arena prefix item_count head candidate expected
                        Option::None:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_named_prefix_with_source_and_trailing_block: named head の候補数を[確認/かくにん]して source-backed reducer へ[渡/わた]す
//:
//: [目的/もくてき]:
//: - prefix head が `NamedValue` であることを確認済みの状態で、候補 0/1/複数を分け、1 候補だけを direct call reducer へ渡します。
//: - 末尾 block argument を持つ expression line と通常 argument を同じ候補選択規則で扱います。
//:
//: [契約/けいやく]:
//: - 候補 0 は `UnresolvedName`、複数は `OverloadAmbiguous` として fail-closed にします。
//: - この関数は `candidates` を borrow するだけで解放しません。arena owner は成功 payload へ移るか、失敗時に cleanup helper が閉じます。
//: - 候補が 1 つでも、引数検査や result expectation は下位の single-candidate reducer が行います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: 唯一候補の direct call と checked argument evidence です。
//: - `Err(error)`: 未解決、曖昧、candidate Vec 不整合、または下位 reducer の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - candidate 数の判定は O(1) です。1 候補の場合の支配的コストは single-candidate reducer に従います。
fn selfhost_call_reduce_named_prefix_with_source_and_trailing_block %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\candidates\expected\trailing_block\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate_with_source tokens source arena checked_tree prefix scope value_types signatures item_count head candidate expected trailing_block
                        Option::None:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_named_prefix_with_source: 末尾 block なしで named head を source-backed に[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - 通常 expression line の named head を、末尾 block argument なしの direct call として処理します。
//: - 実装は trailing block 対応関数へ `None` を渡し、候補 0/1/複数と owner cleanup の規則を共有します。
//:
//: [契約/けいやく]:
//: - この関数自体は新しい候補選択規則を持ちません。`trailing_block = none` であることだけを固定します。
//: - arena owner の移動/解放契約は `selfhost_call_reduce_named_prefix_with_source_and_trailing_block` と同じです。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: direct call plan と checked argument evidence です。
//: - `Err(error)`: 委譲先 reducer の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - wrapper 自体は O(1) です。支配的コストは委譲先 reducer に従います。
fn selfhost_call_reduce_named_prefix_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\candidates\expected\head\item_count:
    selfhost_call_reduce_named_prefix_with_source_and_trailing_block tokens source arena checked_tree prefix scope value_types signatures candidates expected none head item_count

//: selfhost_call_reduce_prefix_with_source_in_tree: 既存 checked tree owner の中で source-backed prefix expression を[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - top-level expression line と trailing block body の再帰検査が同じ checked expression tree を共有できるようにします。
//: - public entry は空 tree を作るだけに留め、実際の head 分類・候補選択・owner cleanup はこの内部入口へ集約します。
//:
//: [契約/けいやく]:
//: - `checked_tree` はこの関数が owner として受け取ります。成功時は `SelfhostCallReduceOwnedResult` に移り、失敗時はこの関数または下位 helper が閉じます。
//: - empty input や unsupported head でも tree owner を解放してから typed error を返します。
//: - source-backed reducer の公開 signature を変えず、tree owner は再帰 reducer 内だけで伝播させます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: checked tree と root expression id を含む owner result です。
//: - `Err(error)`: 入力、候補選択、argument 検査、block result 検査、または tree 追加の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - head 取得は O(1) です。支配的コストは委譲先の candidate 判定と argument 検査に従います。
fn selfhost_call_reduce_prefix_with_source_in_tree %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\candidates\expected\trailing_block:
    let item_count %i32 selfhost_expr_prefix_list_len prefix
    if:
        eq item_count 0
        then:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::EmptyInput source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix 0:
                Option::Some head:
                    match head.kind:
                        SelfhostExprPrefixItemKind::NamedValue:
                            selfhost_call_reduce_named_prefix_with_source_and_trailing_block tokens source arena checked_tree prefix scope value_types signatures candidates expected trailing_block head item_count
                        _:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::UnsupportedPrefixItem head.span
                Option::None:
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_prefix: prefix expression list を direct call plan へ[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `SelfhostExprPrefixList` の先頭 item と callable candidate list を照合し、最小 direct call plan を返します。
//: - この関数は source text を読み直さず、parser が分類した item kind、token index、span と type arena だけを使います。
//:
//: [場合分/ばあいわ]け:
//: - `Ok(DirectCall)`: named function call が完全飽和し、expected result にも合っています。
//: - `Err(PartialApplicationRejected)`: 引数不足です。NEPLg2.1 は部分適用を導入しないため、関数値としては返しません。
//: - `Err(ArgumentTypeMismatch)`: 引数 item の型証拠が parameter type と一致しません。
//: - `Err(UnsupportedArgumentExpression)`: 引数式の消費幅は 1 引数として扱うべきですが、この checkpoint の checker では source / token 付き検査を実行できません。
//: - `Err(OverloadAmbiguous)`: 候補が複数あり、この slice では narrowing しません。
//: - `Err(GenericInference*)`: generic solver がこの call を安全に一意化できません。
pub fn selfhost_call_reduce_prefix %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\candidates\expected:
    let item_count %i32 selfhost_expr_prefix_list_len prefix
    if:
        eq item_count 0
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::EmptyInput source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix 0:
                Option::Some head:
                    match head.kind:
                        SelfhostExprPrefixItemKind::NamedValue:
                            selfhost_call_reduce_named_prefix arena prefix candidates expected head item_count
                        _:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnsupportedPrefixItem head.span
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_prefix_with_source_and_trailing_block: source-backed argument checker と末尾 block argument evidence で prefix expression list を[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `add %i32 1 2`、`add %i32 x 2`、`add add 1 2 3` のように、実引数位置の `%T expr` や nested named call が source text、token span、scope、値型証拠、callable signature table を必要とする場合に使う owner-returning entry です。
//: - `add 1:` のような `BlockIntro` は、`head` の prefix item と `body` の nested body envelope を同じ flat list へ混ぜず、`trailing_block` として別に受け取ります。
//: - borrowed `selfhost_call_reduce_prefix` は source-less / fail-closed の契約を保ち、この関数だけが ascription projection による `SelfhostTypeArena` 更新を caller へ返します。
//:
//: [契約/けいやく]:
//: - 成功時は `SelfhostCallReduceOwnedResult` が更新済み arena owner と direct call plan を保持します。
//: - 失敗時はこの reducer または argument checker が受け取った arena owner を解放します。caller は失敗後に同じ arena を使いません。
//: - `NamedValue` argument は scope binding と value type evidence がそろう場合だけ成功します。nested named call は callable signature table から候補を集め、expected parameter type を result expectation として検査します。
//: - `trailing_block` が `Some` の場合、parameter が不足している位置では nested body を `BlockResult` expectation 付き expression として検査します。parameter 消費後に余る block は `UnexpectedTrailingBlockArgument` として拒否します。
//: - block body の segment 化、prefix build、candidate collection が失敗した場合は `TrailingBlockBody*` error へ分け、partial application や overload failure へ潰しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: source-backed に検査済みの direct call plan、checked argument evidence、更新済み arena owner です。
//: - `Err(error)`: empty input、unsupported head、候補選択、argument 検査、trailing block 検査、または result expectation の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - prefix head 取得は O(1) です。支配的コストは候補数判定、parameter 数 p に対する実引数検査、必要な場合の block body segment 化に依存します。
pub fn selfhost_call_reduce_prefix_with_source_and_trailing_block %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected\trailing_block:
    let item_count %i32 selfhost_expr_prefix_list_len prefix
    if:
        eq item_count 0
        then:
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::EmptyInput source_span_empty_unchecked 0 0
        else:
            match selfhost_checked_expr_tree_new:
                Result::Ok checked_tree:
                    selfhost_call_reduce_prefix_with_source_in_tree tokens source arena checked_tree prefix scope value_types signatures candidates expected trailing_block
                Result::Err _alloc_error:
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OutOfMemory source_span_empty_unchecked 0 0

//: selfhost_call_reduce_prefix_with_source: source-backed argument checker を使って prefix expression list を[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - 末尾 block argument を持たない通常の expression line 用入口です。
//: - 実装は `selfhost_call_reduce_prefix_with_source_and_trailing_block` に `None` を渡し、BlockIntro 専用経路と通常経路の規則を一箇所に集めます。
//:
//: [契約/けいやく]:
//: - source text、tokens、scope、value type evidence、signature table の authority は委譲先へそのまま渡します。
//: - trailing block を持つ構文はこの入口では扱わず、caller は `with_source_and_trailing_block` を使います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: 末尾 block なしとして検査済みの direct call result です。
//: - `Err(error)`: 委譲先 reducer の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - wrapper 自体は O(1) です。実際の縮約コストは `selfhost_call_reduce_prefix_with_source_and_trailing_block` と同じです。
pub fn selfhost_call_reduce_prefix_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected:
    selfhost_call_reduce_prefix_with_source_and_trailing_block tokens source arena prefix scope value_types signatures candidates expected none
