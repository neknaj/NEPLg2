fn selfhost_call_reduce_pipe_candidates_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn Option SelfhostCheckedArgument impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\pipe_candidates\expected\target_ascription\trailing_block\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index:
    let candidate_count %i32 v::len &pipe_candidates
    if:
        eq candidate_count 0
        then:
            selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::PipeTargetUnresolved rhs_head.span
        else:
            match target_ascription:
                Option::Some expectation:
                    match selfhost_call_reduce_pipe_target_ascription_select_candidate &arena &pipe_candidates expectation rhs_head candidate_count:
                        Result::Ok candidate:
