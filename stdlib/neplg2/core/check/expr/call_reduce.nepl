#indent 4

//: # check/expr/call_reduce
//: `SelfhostExprPrefixList` と callable candidates から direct call reduction plan を作る module です。
//:
//: [目的/もくてき]:
//: - parser が保持した flat prefix list を、checker が型と候補情報に基づいて縮約する最初の入口にします。
//: - full expression checker が未実装の機能は、成功 plan ではなく typed error として返します。
//:
//: [契約/けいやく]:
//: - 先頭 item が `NamedValue` で、候補が 1 つだけで、候補型が function type で、実引数式が parameter count ぶんだけ消費され、各引数の型証拠が parameter type と一致し、expected result が一致する場合だけ `DirectCall` を返します。
//: - 引数不足は partial application として扱わず、`PartialApplicationRejected` を返します。
//: - 候補が複数ある場合、この slice では expected type による ambiguity narrowing を行わず `OverloadAmbiguous` を返します。
//: - generic inference が `EvidenceMissing` / `Conflict` / `Unsupported` の候補は fail-closed にします。
//: - full expression checker が未実装の引数式は、型が一致したものとして通さず `UnsupportedArgumentExpression` として拒否します。
//: - `%T literal` や nested named call のような可変幅引数式は、source / token 付き argument checker が接続された入口だけで成功扱いします。raw item 数を arity として数える旧挙動へ戻してはいけません。

#import "alloc/collections/vec" as v
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/syntax/ast/prefix_expr" as *
#import "neplg2/core/syntax/token" as *
#import "neplg2/core/ty/ty" as *
#import "./expectation" as *
#import "./call_candidate" as *
#import "./candidate_collection" as *
#import "./model" as *
#import "./argument" as *
#import "./value_evidence" as *
#import "./block_body" as *

fn selfhost_call_reduce_generic_state_error %fn SelfhostCallableCandidate Result unit SelfhostCallReduceError \candidate:
    match candidate.generic_state:
        SelfhostGenericInferenceState::NoneRequired:
            Result::Ok unit
        SelfhostGenericInferenceState::Unique:
            Result::Ok unit
        SelfhostGenericInferenceState::EvidenceMissing:
            Result::Err selfhost_call_reduce_error_generic SelfhostCallReduceErrorKind::GenericInferenceEvidenceMissing candidate.span candidate.generic_state
        SelfhostGenericInferenceState::Conflict:
            Result::Err selfhost_call_reduce_error_generic SelfhostCallReduceErrorKind::GenericInferenceConflict candidate.span candidate.generic_state
        SelfhostGenericInferenceState::Unsupported:
            Result::Err selfhost_call_reduce_error_generic SelfhostCallReduceErrorKind::GenericInferenceUnsupported candidate.span candidate.generic_state

fn selfhost_call_reduce_expected_result %fn &SelfhostTypeArena fn SelfhostCallableCandidate fn Option SelfhostTypeExpectation Result SelfhostTypeId SelfhostCallReduceError \arena\candidate\expected:
    match selfhost_type_arena_function_result arena candidate.callable_type:
        Option::Some result_type:
            match expected:
                Option::Some expectation:
                    if:
                        selfhost_type_arena_types_equal arena result_type expectation.expected_type
                        then:
                            Result::Ok result_type
                        else:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ExpectedTypeMismatch expectation.span
                Option::None:
                    Result::Ok result_type
        Option::None:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::NotCallable candidate.span

fn selfhost_call_reduce_error_from_argument_match %fn SelfhostExprArgumentMatchError fn SelfhostExprPrefixItem Result unit SelfhostCallReduceError \error\head:
    match error.kind:
        SelfhostExprArgumentMatchErrorKind::MissingArgument:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PartialApplicationRejected head.span
        SelfhostExprArgumentMatchErrorKind::TypeMismatch:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentTypeMismatch error.span
        SelfhostExprArgumentMatchErrorKind::UnsupportedAscribedArgument:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnsupportedArgumentExpression error.span
        SelfhostExprArgumentMatchErrorKind::AscriptionProjectionFailed:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentAscriptionProjectionFailed error.span
        SelfhostExprArgumentMatchErrorKind::AscriptionExpectedTypeConflict:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentAscriptionExpectedTypeConflict error.span
        SelfhostExprArgumentMatchErrorKind::NamedValueUnresolved:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNamedValueUnresolved error.span
        SelfhostExprArgumentMatchErrorKind::NamedValuePendingBinding:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNamedValuePendingBinding error.span
        SelfhostExprArgumentMatchErrorKind::NamedValueUnsupportedBinding:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNamedValueUnsupportedBinding error.span
        SelfhostExprArgumentMatchErrorKind::NamedValueEvidenceMissing:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNamedValueEvidenceMissing error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueExpectedFunctionType:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueExpectedFunctionType error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueMissingName:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingName error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueUnresolved:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueUnresolved error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueAmbiguous:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueAmbiguous error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValuePendingBinding:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValuePendingBinding error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueMissingSignature:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingSignature error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueHeadTokenOutOfBounds:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueHeadTokenOutOfBounds error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueOutOfMemory:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueOutOfMemory error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueGenericUnsupported:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueGenericUnsupported error.span
        SelfhostExprArgumentMatchErrorKind::FunctionValueTypeMismatch:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentFunctionValueTypeMismatch error.span
        SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnsupportedArgumentExpression error.span
        SelfhostExprArgumentMatchErrorKind::InternalInvariant:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_error_from_argument_match_owned %fn SelfhostExprArgumentMatchError fn SelfhostExprPrefixItem SelfhostCallReduceError \error\head:
    match selfhost_call_reduce_error_from_argument_match error head:
        Result::Err e:
            e
        Result::Ok _unit:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_free_error_new %impure fn SelfhostTypeArena impure fn SelfhostCallReduceErrorKind impure fn SelfhostSourceSpan Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \arena\kind\span:
    selfhost_type_arena_free arena
    Result::Err selfhost_call_reduce_error_new kind span

fn selfhost_call_reduce_free_existing_error %impure fn SelfhostTypeArena impure fn SelfhostCallReduceError Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \arena\error:
    selfhost_type_arena_free arena
    Result::Err error

fn selfhost_call_reduce_free_argument_error %impure fn SelfhostTypeArena impure fn SelfhostCallReduceError Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \arena\error:
    selfhost_type_arena_free arena
    Result::Err error

fn selfhost_call_reduce_error_from_candidate_collect %fn SelfhostCallableCandidateCollectError SelfhostCallReduceError \error:
    match error.kind:
        SelfhostCallableCandidateCollectErrorKind::PendingBinding:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNestedCandidatePendingBinding error.span
        SelfhostCallableCandidateCollectErrorKind::MissingSignature:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNestedCandidateMissingSignature error.span
        SelfhostCallableCandidateCollectErrorKind::HeadTokenOutOfBounds:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNestedCandidateHeadTokenOutOfBounds error.span
        SelfhostCallableCandidateCollectErrorKind::OutOfMemory:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNestedCandidateOutOfMemory error.span
        _:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::ArgumentNestedCandidateInternalInvariant error.span

fn selfhost_call_reduce_error_from_block_body_result %fn SelfhostBlockBodyResultError SelfhostCallReduceError \error:
    match error.kind:
        SelfhostBlockBodyResultErrorKind::SegmentFailed:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodySegmentFailed error.span
        SelfhostBlockBodyResultErrorKind::EmptyBody:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodyEmpty error.span
        SelfhostBlockBodyResultErrorKind::MultipleSegments:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodyMultipleSegments error.span
        SelfhostBlockBodyResultErrorKind::NestedBlockUnsupported:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodyNestedBlockUnsupported error.span
        SelfhostBlockBodyResultErrorKind::PrefixBuildFailed:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodyPrefixBuildFailed error.span
        SelfhostBlockBodyResultErrorKind::CandidateCollectFailed:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::TrailingBlockBodyCandidateCollectFailed error.span
        SelfhostBlockBodyResultErrorKind::InternalInvariant:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant error.span

//: selfhost_call_reduce_argument_type_check_loop: 実引数式 cursor と parameter type を順に[照合/しょうごう]する
//:
//: [目的/もくてき]:
//: - prefix list の先頭 callee 以降を、実引数式ごとに consume-width 付きで走査します。
//: - parameter index と prefix item index を分けることで、`%T literal` や nested call のように複数 item で 1 引数式になるケースを後続 slice で同じ境界へ接続できます。
//: - argument module が unsupported を返す未対応式は成功扱いせず、該当 item の span で `UnsupportedArgumentExpression` を返します。
//:
//: [契約/けいやく]:
//: - prefix list の index `0` は callee head です。最初の実引数式は `item_index = 1` から走査します。
//: - `param_idx` が `param_count` に到達した時点で `item_index == item_count` なら完全飽和です。
//: - parameter が余っている場合は partial application rejection、実引数 item が余っている場合は overload no-candidate として返します。
//: - type arena から parameter type が取り出せない場合は、caller 側の不整合として `InternalInvariant` を返します。
fn selfhost_call_reduce_argument_type_check_loop %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn SelfhostCallableCandidate fn i32 fn i32 fn i32 fn i32 fn SelfhostExprPrefixItem Result unit SelfhostCallReduceError \arena\prefix\candidate\param_count\param_idx\item_index\item_count\head:
    if:
        ge param_idx param_count
        then:
            if:
                eq item_index item_count
                then:
                    Result::Ok unit
                else:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadNoCandidate head.span
        else:
            if:
                ge item_index item_count
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PartialApplicationRejected head.span
                else:
                    match selfhost_type_arena_function_arg arena candidate.callable_type param_idx:
                        Option::Some expected_arg_type:
                            match selfhost_expr_argument_match_at arena prefix item_index item_count expected_arg_type:
                                Result::Ok argument_match:
                                    selfhost_call_reduce_argument_type_check_loop arena prefix candidate param_count add param_idx 1 argument_match.next_index item_count head
                                Result::Err argument_error:
                                    selfhost_call_reduce_error_from_argument_match argument_error head
                        Option::None:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_argument_match_direct_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\item_index\item_count\expected_type\head:
    match selfhost_expr_argument_match_at_with_source tokens source arena prefix scope value_types signatures item_index item_count expected_type:
        Result::Ok owned_match:
            Result::Ok owned_match
        Result::Err argument_error:
            Result::Err selfhost_call_reduce_error_from_argument_match_owned argument_error head

fn selfhost_call_reduce_argument_consume_loop_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidate\param_count\param_idx\item_index\item_count\head:
    if:
        ge param_idx param_count
        then:
            Result::Ok selfhost_expr_argument_owned_match_new arena selfhost_expr_argument_match_new item_index
        else:
            if:
                ge item_index item_count
                then:
                    selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PartialApplicationRejected head.span
                else:
                    match selfhost_type_arena_function_arg &arena candidate.callable_type param_idx:
                        Option::Some expected_arg_type:
                            match selfhost_call_reduce_argument_match_at_with_source_or_nested tokens source arena prefix scope value_types signatures item_index item_count expected_arg_type head:
                                Result::Ok owned_match:
                                    let argument_match %SelfhostExprArgumentMatch selfhost_expr_argument_owned_match_match &owned_match
                                    let next_arena %SelfhostTypeArena selfhost_expr_argument_owned_match_into_arena owned_match
                                    selfhost_call_reduce_argument_consume_loop_with_source tokens source next_arena prefix scope value_types signatures candidate param_count add param_idx 1 argument_match.next_index item_count head
                                Result::Err e:
                                    Result::Err e
                        Option::None:
                            selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_nested_single_named_candidate_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidate\item_index\item_count\expected_type\head:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _unit:
            match selfhost_type_arena_function_arg_count &arena candidate.callable_type:
                Option::Some param_count:
                    match selfhost_call_reduce_argument_consume_loop_with_source tokens source arena prefix scope value_types signatures candidate param_count 0 add item_index 1 item_count head:
                        Result::Ok consumed:
                            let argument_match %SelfhostExprArgumentMatch selfhost_expr_argument_owned_match_match &consumed
                            let checked_arena %SelfhostTypeArena selfhost_expr_argument_owned_match_into_arena consumed
                            let expected %SelfhostTypeExpectation selfhost_type_expectation_new expected_type SelfhostTypeExpectationSource::OuterConsumerArgument head.span
                            match selfhost_call_reduce_expected_result &checked_arena candidate some expected:
                                Result::Ok _result_type:
                                    Result::Ok selfhost_expr_argument_owned_match_new checked_arena argument_match
                                Result::Err e:
                                    selfhost_type_arena_free checked_arena
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            selfhost_call_reduce_free_argument_error arena e

fn selfhost_call_reduce_nested_named_candidates_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Vec SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\item_index\item_count\expected_type\head:
    let candidate_count %i32 v::len &candidates
    if:
        eq candidate_count 0
        then:
            v::free candidates
            selfhost_call_reduce_argument_match_direct_with_source tokens source arena prefix scope value_types signatures item_index item_count expected_type head
        else:
            if:
                gt candidate_count 1
                then:
                    v::free candidates
                    selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get &candidates 0:
                        Option::Some candidate:
                            let reduced %Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError selfhost_call_reduce_nested_single_named_candidate_with_source tokens source arena prefix scope value_types signatures candidate item_index item_count expected_type head
                            v::free candidates
                            reduced
                        Option::None:
                            v::free candidates
                            selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_argument_match_at_with_source_or_nested %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\item_index\item_count\expected_type\head:
    match selfhost_expr_prefix_list_get prefix item_index:
        Option::Some item:
            match item.kind:
                SelfhostExprPrefixItemKind::NamedValue:
                    match selfhost_callable_candidates_collect_for_head_item source tokens item scope signatures:
                        Result::Ok nested_candidates:
                            selfhost_call_reduce_nested_named_candidates_with_source tokens source arena prefix scope value_types signatures nested_candidates item_index item_count expected_type item
                        Result::Err collect_error:
                            selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_from_candidate_collect collect_error
                _:
                    selfhost_call_reduce_argument_match_direct_with_source tokens source arena prefix scope value_types signatures item_index item_count expected_type head
        Option::None:
            selfhost_call_reduce_free_argument_error arena selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_trailing_block_body_result: 末尾 block argument を `BlockResult` expectation で[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `BlockIntro.body` を、次に不足している parameter の 1 実引数式として検査します。
//: - nested body envelope は `block_body.nepl` で単一 expression line に分解し、その expression を既存の source-backed call reducer へ渡します。
//:
//: [契約/けいやく]:
//: - 成功時は block body expression が `expected_type` を返すことまで確認済みの arena owner を返します。
//: - 失敗時は、この関数が受け取った arena owner を閉じるか、再帰 reducer が閉じた状態で typed error を返します。
//: - block body の prefix/candidate owner は、再帰 reducer が成功しても失敗しても必ず解放します。
fn selfhost_call_reduce_trailing_block_body_result %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostTypeId impure fn SelfhostTrailingBlockArgument Result SelfhostTypeArena SelfhostCallReduceError \tokens\source\arena\scope\value_types\signatures\expected_type\block_arg:
    match selfhost_block_body_result_input_from_trailing_block tokens source scope signatures block_arg:
        Result::Ok input:
            let block_expected %SelfhostTypeExpectation selfhost_type_expectation_new expected_type SelfhostTypeExpectationSource::BlockResult block_arg.span
            let prefix %&SelfhostExprPrefixList selfhost_block_body_result_input_prefix &input
            let candidates %&Vec SelfhostCallableCandidate selfhost_block_body_result_input_candidates &input
            let reduced %Result SelfhostCallReduceOwnedResult SelfhostCallReduceError selfhost_call_reduce_prefix_with_source tokens source arena prefix scope value_types signatures candidates some block_expected
            selfhost_block_body_result_input_free input
            match reduced:
                Result::Ok owned:
                    Result::Ok selfhost_call_reduce_owned_result_into_arena owned
                Result::Err e:
                    Result::Err e
        Result::Err block_error:
            selfhost_type_arena_free arena
            Result::Err selfhost_call_reduce_error_from_block_body_result block_error

//: selfhost_call_reduce_argument_type_check_loop_with_source: source-backed に実引数式 cursor を[照合/しょうごう]する
//:
//: [目的/もくてき]:
//: - `%T literal` や `%T NamedValue` のように source text、token buffer、scope、value type evidence が必要な argument expression を扱うため、arena owner を受け渡しながら argument loop を進めます。
//: - borrowed loop と同じ parameter / item cursor 境界を使い、source-backed checker だけが ascription projection と named value evidence lookup を成功させます。
//: - nested named call argument は scope と callable signature table から nested head の候補を集め、expected parameter type を nested expression の result expectation として縮約します。
//:
//: [契約/けいやく]:
//: - 成功時は更新済み `SelfhostTypeArena` owner を返します。
//: - 失敗時、この関数または argument checker が arena owner を解放します。
//: - `param_idx` が `param_count` に到達した時点で `item_index == item_count` なら完全飽和です。
fn selfhost_call_reduce_argument_type_check_loop_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem Result SelfhostTypeArena SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidate\param_count\param_idx\item_index\item_count\trailing_block\head:
    if:
        ge param_idx param_count
        then:
            if:
                eq item_index item_count
                then:
                    match trailing_block:
                        Option::Some block_arg:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnexpectedTrailingBlockArgument block_arg.span
                        Option::None:
                            Result::Ok arena
                else:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadNoCandidate head.span
        else:
            if:
                ge item_index item_count
                then:
                    match trailing_block:
                        Option::Some block_arg:
                            match selfhost_type_arena_function_arg &arena candidate.callable_type param_idx:
                                Option::Some expected_arg_type:
                                    match selfhost_call_reduce_trailing_block_body_result tokens source arena scope value_types signatures expected_arg_type block_arg:
                                        Result::Ok checked_arena:
                                            selfhost_call_reduce_argument_type_check_loop_with_source tokens source checked_arena prefix scope value_types signatures candidate param_count add param_idx 1 item_index item_count none head
                                        Result::Err e:
                                            Result::Err e
                                Option::None:
                                    selfhost_type_arena_free arena
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span
                        Option::None:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PartialApplicationRejected head.span
                else:
                    match selfhost_type_arena_function_arg &arena candidate.callable_type param_idx:
                        Option::Some expected_arg_type:
                            match selfhost_call_reduce_argument_match_at_with_source_or_nested tokens source arena prefix scope value_types signatures item_index item_count expected_arg_type head:
                                Result::Ok owned_match:
                                    let argument_match %SelfhostExprArgumentMatch selfhost_expr_argument_owned_match_match &owned_match
                                    let next_arena %SelfhostTypeArena selfhost_expr_argument_owned_match_into_arena owned_match
                                    selfhost_call_reduce_argument_type_check_loop_with_source tokens source next_arena prefix scope value_types signatures candidate param_count add param_idx 1 argument_match.next_index item_count trailing_block head
                                Result::Err e:
                                    Result::Err e
                        Option::None:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_single_named_candidate %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn i32 fn SelfhostExprPrefixItem fn SelfhostCallableCandidate fn Option SelfhostTypeExpectation Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\item_count\head\candidate\expected:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _:
            match selfhost_type_arena_function_arg_count arena candidate.callable_type:
                Option::Some param_count:
                    match selfhost_call_reduce_argument_type_check_loop arena prefix candidate param_count 0 1 item_count head:
                        Result::Ok _:
                            match selfhost_call_reduce_expected_result arena candidate expected:
                                Result::Ok result_type:
                                    Result::Ok SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            Result::Err e

fn selfhost_call_reduce_single_named_candidate_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn SelfhostExprPrefixItem impure fn SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\item_count\head\candidate\expected\trailing_block:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _:
            match selfhost_type_arena_function_arg_count &arena candidate.callable_type:
                Option::Some param_count:
                    match selfhost_call_reduce_argument_type_check_loop_with_source tokens source arena prefix scope value_types signatures candidate param_count 0 1 item_count trailing_block head:
                        Result::Ok checked_arena:
                            match selfhost_call_reduce_expected_result &checked_arena candidate expected:
                                Result::Ok result_type:
                                    let result %SelfhostCallReduceResult SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                    Result::Ok selfhost_call_reduce_owned_result_new checked_arena result
                                Result::Err e:
                                    selfhost_call_reduce_free_existing_error checked_arena e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            selfhost_call_reduce_free_existing_error arena e

fn selfhost_call_reduce_named_prefix %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn SelfhostExprPrefixItem fn i32 Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\candidates\expected\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate arena prefix item_count head candidate expected
                        Option::None:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_named_prefix_with_source_and_trailing_block %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected\trailing_block\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate_with_source tokens source arena prefix scope value_types signatures item_count head candidate expected trailing_block
                        Option::None:
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::InternalInvariant head.span

fn selfhost_call_reduce_named_prefix_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected\head\item_count:
    selfhost_call_reduce_named_prefix_with_source_and_trailing_block tokens source arena prefix scope value_types signatures candidates expected none head item_count

//: selfhost_call_reduce_prefix: prefix expression list を direct call plan へ[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `SelfhostExprPrefixList` の先頭 item と callable candidate list を照合し、最小 direct call plan を返します。
//: - この関数は source text を読み直さず、parser が分類した item kind、token index、span と type arena だけを使います。
//:
//: [場合分/ばあいわ]け:
//: - `Ok(DirectCall)`: named function call が完全飽和し、expected result にも合っています。
//: - `Err(PartialApplicationRejected)`: 引数不足です。NEPLg2.1 は部分適用を導入しないため、関数値としては返しません。
//: - `Err(ArgumentTypeMismatch)`: 引数 item の型証拠が parameter type と一致しません。
//: - `Err(UnsupportedArgumentExpression)`: 引数式の消費幅は 1 引数として扱うべきですが、この checkpoint の checker では source / token 付き検査を実行できません。
//: - `Err(OverloadAmbiguous)`: 候補が複数あり、この slice では narrowing しません。
//: - `Err(GenericInference*)`: generic solver がこの call を安全に一意化できません。
pub fn selfhost_call_reduce_prefix %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\candidates\expected:
    let item_count %i32 selfhost_expr_prefix_list_len prefix
    if:
        eq item_count 0
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::EmptyInput source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix 0:
                Option::Some head:
                    match head.kind:
                        SelfhostExprPrefixItemKind::NamedValue:
                            selfhost_call_reduce_named_prefix arena prefix candidates expected head item_count
                        _:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnsupportedPrefixItem head.span
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_prefix_with_source_and_trailing_block: source-backed argument checker と末尾 block argument evidence で prefix expression list を[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - `add %i32 1 2`、`add %i32 x 2`、`add add 1 2 3` のように、実引数位置の `%T expr` や nested named call が source text、token span、scope、値型証拠、callable signature table を必要とする場合に使う owner-returning entry です。
//: - `add 1:` のような `BlockIntro` は、`head` の prefix item と `body` の nested body envelope を同じ flat list へ混ぜず、`trailing_block` として別に受け取ります。
//: - borrowed `selfhost_call_reduce_prefix` は source-less / fail-closed の契約を保ち、この関数だけが ascription projection による `SelfhostTypeArena` 更新を caller へ返します。
//:
//: [契約/けいやく]:
//: - 成功時は `SelfhostCallReduceOwnedResult` が更新済み arena owner と direct call plan を保持します。
//: - 失敗時はこの reducer または argument checker が受け取った arena owner を解放します。caller は失敗後に同じ arena を使いません。
//: - `NamedValue` argument は scope binding と value type evidence がそろう場合だけ成功します。nested named call は callable signature table から候補を集め、expected parameter type を result expectation として検査します。
//: - `trailing_block` が `Some` の場合、parameter が不足している位置では nested body を `BlockResult` expectation 付き expression として検査します。parameter 消費後に余る block は `UnexpectedTrailingBlockArgument` として拒否します。
//: - block body の segment 化、prefix build、candidate collection が失敗した場合は `TrailingBlockBody*` error へ分け、partial application や overload failure へ潰しません。
pub fn selfhost_call_reduce_prefix_with_source_and_trailing_block %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected\trailing_block:
    let item_count %i32 selfhost_expr_prefix_list_len prefix
    if:
        eq item_count 0
        then:
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::EmptyInput source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix 0:
                Option::Some head:
                    match head.kind:
                        SelfhostExprPrefixItemKind::NamedValue:
                            selfhost_call_reduce_named_prefix_with_source_and_trailing_block tokens source arena prefix scope value_types signatures candidates expected trailing_block head item_count
                        _:
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::UnsupportedPrefixItem head.span
                Option::None:
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_prefix_with_source: source-backed argument checker を使って prefix expression list を[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - 末尾 block argument を持たない通常の expression line 用入口です。
//: - 実装は `selfhost_call_reduce_prefix_with_source_and_trailing_block` に `None` を渡し、BlockIntro 専用経路と通常経路の規則を一箇所に集めます。
pub fn selfhost_call_reduce_prefix_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\prefix\scope\value_types\signatures\candidates\expected:
    selfhost_call_reduce_prefix_with_source_and_trailing_block tokens source arena prefix scope value_types signatures candidates expected none
