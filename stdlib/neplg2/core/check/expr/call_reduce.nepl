fn selfhost_call_reduce_pipe_ascribed_target_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn Option SelfhostCheckedArgument impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\expected\trailing_block\left_argument\ascription_head\item_count\pipe_index\rhs_index:
    match selfhost_call_reduce_pipe_rhs_range_from_prefix prefix rhs_index item_count ascription_head.span:
        Result::Ok syntax_range:
            match selfhost_expr_ascription_project_head_expectation tokens source arena syntax_range:
                Result::Ok projection:
                    let target_expectation %SelfhostTypeExpectation selfhost_expr_ascription_head_projection_expectation &projection
                    let expression_token %i32 selfhost_expr_ascription_head_projection_expression_first_token &projection
                    let projected_arena %SelfhostTypeArena selfhost_expr_ascription_head_projection_into_arena projection
                    match selfhost_call_reduce_pipe_find_prefix_item_by_token prefix add rhs_index 1 item_count expression_token target_expectation.span:
                        Result::Ok target_index:
                            match selfhost_expr_prefix_list_get prefix target_index:
                                Option::Some target_item:
                                    match target_item.kind:
                                        SelfhostExprPrefixItemKind::NamedValue:
                                            match selfhost_callable_candidates_collect_for_head_item source tokens target_item scope signatures:
                                                Result::Ok pipe_candidates:
                                                    selfhost_call_reduce_pipe_candidates_with_source tokens source projected_arena checked_tree prefix scope value_types signatures pipe_candidates expected some target_expectation trailing_block left_argument target_item item_count pipe_index add target_index 1
                                                Result::Err collect_error:
                                                    selfhost_checked_expr_tree_free checked_tree
                                                    selfhost_type_arena_free projected_arena
                                                    Result::Err selfhost_call_reduce_pipe_error_from_candidate_collect collect_error
                                        _:
                                            selfhost_checked_expr_tree_free checked_tree
                                            selfhost_call_reduce_free_error_new projected_arena SelfhostCallReduceErrorKind::PipeRightTargetUnsupported target_item.span
                                Option::None:
                                    selfhost_checked_expr_tree_free checked_tree
                                    selfhost_call_reduce_free_error_new projected_arena SelfhostCallReduceErrorKind::PipeTargetInternalInvariant target_expectation.span
                        Result::Err e:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_existing_error projected_arena e
                Result::Err e:
                    selfhost_checked_expr_tree_free checked_tree
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAscriptionProjectionFailed selfhost_call_reduce_pipe_span_from_ascription_error e
        Result::Err e:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_existing_error arena e

