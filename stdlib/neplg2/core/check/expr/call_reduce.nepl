                                                    let root_tree %SelfhostCheckedExprTree selfhost_checked_expr_node_alloc_into_tree root_alloc
                                                    let result %SelfhostCallReduceResult SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                                    Result::Ok selfhost_call_reduce_owned_result_new checked_arena result checked_arguments_result root_tree root_expr
                                                Result::Err tree_error:
                                                    selfhost_type_arena_free checked_arena
                                                    v::free checked_arguments_result
                                                    Result::Err selfhost_call_reduce_error_from_checked_tree_std_error tree_error head.span
                                        Result::Err e:
                                            selfhost_type_arena_free checked_arena
                                            v::free checked_arguments_result
                                            selfhost_checked_expr_tree_free checked_tree_result
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err _alloc_error:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OutOfMemory head.span
                Option::None:
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_existing_error arena e

//: selfhost_call_reduce_named_prefix: source-less に named head の候補数を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - prefix head が named value であることを確認済みの状態で、候補 0/1/複数を direct call reduction の error または single-candidate reducer へ分配します。
//: - source-less reducer の入口として、候補が複数ある場合に探索を広げず `OverloadAmbiguous` で止めます。
//:
//: [契約/けいやく]:
//: - 候補 0 は unresolved name、候補複数は ambiguity として扱います。
//: - この関数は `candidates` を borrow するだけで、Vec owner を解放しません。
//: - 1 候補の場合だけ `selfhost_call_reduce_single_named_candidate` に進みます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(result)`: 唯一候補で source-less direct call plan が作れました。
//: - `Err(error)`: 未解決、曖昧、candidate Vec 不整合、または single-candidate reducer の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - candidate 数判定は O(1) です。1 候補の場合の支配的コストは single-candidate reducer に従います。
fn selfhost_call_reduce_named_prefix %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn SelfhostExprPrefixItem fn i32 Result SelfhostCallReduceResult SelfhostCallReduceError \arena\prefix\candidates\expected\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate arena prefix item_count head candidate expected
                        Option::None:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_named_prefix_with_source_and_trailing_block: named head の候補数を[確認/かくにん]して source-backed reducer へ[渡/わた]す
//:
//: [目的/もくてき]:
//: - prefix head が `NamedValue` であることを確認済みの状態で、候補 0/1/複数を分け、1 候補だけを direct call reducer へ渡します。
//: - 末尾 block argument を持つ expression line と通常 argument を同じ候補選択規則で扱います。
//:
//: [契約/けいやく]:
//: - 候補 0 は `UnresolvedName`、複数は `OverloadAmbiguous` として fail-closed にします。
//: - この関数は `candidates` を borrow するだけで解放しません。arena owner は成功 payload へ移るか、失敗時に cleanup helper が閉じます。
//: - 候補が 1 つでも、引数検査や result expectation は下位の single-candidate reducer が行います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: 唯一候補の direct call と checked argument evidence です。
//: - `Err(error)`: 未解決、曖昧、candidate Vec 不整合、または下位 reducer の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - candidate 数の判定は O(1) です。1 候補の場合の支配的コストは single-candidate reducer に従います。
fn selfhost_call_reduce_named_prefix_with_source_and_trailing_block %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\candidates\expected\trailing_block\head\item_count:
    let candidate_count %i32 v::len candidates
    if:
        eq candidate_count 0
        then:
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::UnresolvedName head.span
        else:
            if:
                gt candidate_count 1
                then:
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::OverloadAmbiguous head.span
                else:
                    match v::get candidates 0:
                        Option::Some candidate:
                            selfhost_call_reduce_single_named_candidate_with_source tokens source arena checked_tree prefix scope value_types signatures item_count head candidate expected trailing_block
                        Option::None:
                            selfhost_checked_expr_tree_free checked_tree
                            selfhost_call_reduce_free_error_new arena SelfhostCallReduceErrorKind::InternalInvariant head.span

//: selfhost_call_reduce_named_prefix_with_source: 末尾 block なしで named head を source-backed に[縮約/しゅくやく]する
//:
//: [目的/もくてき]:
//: - 通常 expression line の named head を、末尾 block argument なしの direct call として処理します。
//: - 実装は trailing block 対応関数へ `None` を渡し、候補 0/1/複数と owner cleanup の規則を共有します。
//:
//: [契約/けいやく]:
//: - この関数自体は新しい候補選択規則を持ちません。`trailing_block = none` であることだけを固定します。
//: - arena owner の移動/解放契約は `selfhost_call_reduce_named_prefix_with_source_and_trailing_block` と同じです。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(owned_result)`: direct call plan と checked argument evidence です。
//: - `Err(error)`: 委譲先 reducer の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - wrapper 自体は O(1) です。支配的コストは委譲先 reducer に従います。
fn selfhost_call_reduce_named_prefix_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn &Vec SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn SelfhostExprPrefixItem impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\candidates\expected\head\item_count:
    selfhost_call_reduce_named_prefix_with_source_and_trailing_block tokens source arena checked_tree prefix scope value_types signatures candidates expected none head item_count

//: selfhost_call_reduce_pipe_error_from_candidate_collect: pipe 右辺 target の候補収集失敗を call reduction error へ[写像/しゃぞう]する
//:
//: [目的/もくてき]:
//: - `left |> right ...` の `right` を callable target として解決する境界で、scope / signature table / token span の不整合を pipe 専用 error に保ちます。
//: - nested call argument の候補収集 error と混ぜると、diagnostic や契約テストが「pipe target が壊れた」のか「通常引数内の nested call が壊れた」のかを区別できなくなるため、ここで分類を分けます。
//:
//: [戻/もど]り[値/ち]:
//: - pipe target collection の原因に対応する `SelfhostCallReduceError` です。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_call_reduce_pipe_error_from_candidate_collect %fn SelfhostCallableCandidateCollectError SelfhostCallReduceError \error:
    match error.kind:
        SelfhostCallableCandidateCollectErrorKind::EmptyPrefix:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant error.span
        SelfhostCallableCandidateCollectErrorKind::PrefixBuildFailed:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant error.span
        SelfhostCallableCandidateCollectErrorKind::UnsupportedHead:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeRightTargetUnsupported error.span
        SelfhostCallableCandidateCollectErrorKind::PendingBinding:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetPendingBinding error.span
        SelfhostCallableCandidateCollectErrorKind::MissingSignature:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetMissingSignature error.span
        SelfhostCallableCandidateCollectErrorKind::HeadTokenOutOfBounds:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetHeadTokenOutOfBounds error.span
        SelfhostCallableCandidateCollectErrorKind::OutOfMemory:
            selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetOutOfMemory error.span

//: selfhost_call_reduce_pipe_operator_index_loop: prefix list 内の最初の pipe operator 位置を[探/さが]す
//:
//: [目的/もくてき]:
//: - source-backed reducer の入口で、pipe expression と通常 named-head expression を分けます。
//: - pipe chain は左結合で処理するため、ここでは 2 個目の pipe を error にせず、最初の pipe 位置だけを返します。
//:
//: [契約/けいやく]:
//: - `found` が `None` のまま終端へ到達した場合、caller は通常の named-head reduction へ進みます。
//: - `found` が `Some(index)` の場合、それより後ろの pipe は chain dispatcher が次段として処理します。
//:
//: [計算量/けいさんりょう]:
//: - prefix item を左から 1 回だけ見るため O(n) です。
fn selfhost_call_reduce_pipe_operator_index_loop %fn &SelfhostExprPrefixList fn i32 fn i32 fn Option i32 Result Option i32 SelfhostCallReduceError \prefix\item_count\idx\found:
    if:
        ge idx item_count
        then:
            Result::Ok found
        else:
            match selfhost_expr_prefix_list_get prefix idx:
                Option::Some item:
                    match item.kind:
                        SelfhostExprPrefixItemKind::PipeOperator:
                            match found:
                                Option::Some existing:
                                    Result::Ok some existing
                                Option::None:
                                    selfhost_call_reduce_pipe_operator_index_loop prefix item_count add idx 1 some idx
                        _:
                            selfhost_call_reduce_pipe_operator_index_loop prefix item_count add idx 1 found
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_pipe_operator_index: prefix list の最初の pipe operator を[検出/けんしゅつ]する
//:
//: [目的/もくてき]:
//: - `a |> f b` を通常 head call とは別の source-backed 境界へ渡すかどうかを決めます。
//: - `a |> f b |> g c` のような chain でも、最初の pipe だけを返し、残りは pipe chain dispatcher が左から処理します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(None)`: pipe はありません。
//: - `Ok(Some(index))`: 最初の pipe item index です。
fn selfhost_call_reduce_pipe_operator_index %fn &SelfhostExprPrefixList fn i32 Result Option i32 SelfhostCallReduceError \prefix\item_count:
    selfhost_call_reduce_pipe_operator_index_loop prefix item_count 0 none

//: selfhost_call_reduce_pipe_next_operator_index_loop: 指定 index 以降の次の pipe operator を[探/さが]す
//:
//: [目的/もくてき]:
//: - pipe chain の各段を `left |> target suffix...` の segment に分けるため、現在段の右辺 suffix がどこで終わるかを決めます。
//: - 文字列や HIR を再構築せず、flat prefix item list の `PipeOperator` だけを境界 evidence とします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(Some(index))`: 次の pipe item index です。
//: - `Ok(None)`: これ以降に pipe はありません。
//: - `Err(PipeTargetInternalInvariant)`: prefix list の index 取得に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - `idx` から `item_count` までを線形に見るため O(n) です。chain 全体では各段の探索開始位置を進めるので、通常入力では O(n * pipe_count) ではなく小さい線形区間に閉じます。
fn selfhost_call_reduce_pipe_next_operator_index_loop %fn &SelfhostExprPrefixList fn i32 fn i32 Result Option i32 SelfhostCallReduceError \prefix\idx\item_count:
    if:
        ge idx item_count
        then:
            Result::Ok none
        else:
            match selfhost_expr_prefix_list_get prefix idx:
                Option::Some item:
                    match item.kind:
                        SelfhostExprPrefixItemKind::PipeOperator:
                            Result::Ok some idx
                        _:
                            selfhost_call_reduce_pipe_next_operator_index_loop prefix add idx 1 item_count
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant source_span_empty_unchecked 0 0

//: selfhost_call_reduce_pipe_next_operator_index: pipe chain の次段境界を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `pipe_index` の右辺 target と suffix を検査するとき、次の pipe より手前だけを現在段の suffix として扱います。
//: - これにより `1 |> add 2 |> add 3` の最初の `add` は suffix `2` だけを消費し、2 個目の pipe を raw trailing item として誤消費しません。
//:
//: [計算量/けいさんりょう]:
//: - `start_idx` から末尾までの線形走査です。
fn selfhost_call_reduce_pipe_next_operator_index %fn &SelfhostExprPrefixList fn i32 fn i32 Result Option i32 SelfhostCallReduceError \prefix\start_idx\item_count:
    selfhost_call_reduce_pipe_next_operator_index_loop prefix start_idx item_count

//: selfhost_call_reduce_prefix_cover_span: prefix expression 全体を[覆/おお]う span を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `a |> f b` を `f a b` 相当の checked direct call に正規化しても、diagnostic と checked tree root は元の pipe expression 全体を指せるようにします。
//:
//: [契約/けいやく]:
//: - span join に失敗した場合は caller が渡した fallback を返します。fixture と parser の通常入力では同一 file 内 token なので join は成功する想定です。
//:
//: [計算量/けいさんりょう]:
//: - 先頭と末尾 item を 1 回ずつ読むだけなので O(1) です。
fn selfhost_call_reduce_prefix_cover_span %fn &SelfhostExprPrefixList fn i32 fn SelfhostSourceSpan SelfhostSourceSpan \prefix\item_count\fallback:
    match selfhost_expr_prefix_list_get prefix 0:
        Option::Some first:
            match selfhost_expr_prefix_list_get prefix sub item_count 1:
                Option::Some last:
                    match source_span_join_result first.span last.span:
                        Result::Ok span:
                            span
                        Result::Err _e:
                            fallback
                Option::None:
                    fallback
        Option::None:
            fallback

//: selfhost_call_reduce_pipe_free_candidates_tree_error_new: pipe candidate owner と checker owner を[閉/と]じて error を[返/かえ]す
//:
//: [目的/もくてき]:
//: - pipe reducer は右辺 target の candidate Vec owner を内部で作るため、arena / checked tree と同時に閉じる cleanup 境界が必要です。
//:
//: [契約/けいやく]:
//: - `pipe_candidates`、`checked_tree`、`arena` はこの関数が必ず閉じます。
//: - 返り値は常に `Err` です。
fn selfhost_call_reduce_pipe_free_candidates_tree_error_new %impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn Vec SelfhostCallableCandidate impure fn SelfhostCallReduceErrorKind impure fn SelfhostSourceSpan Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \arena\checked_tree\pipe_candidates\kind\span:
    v::free pipe_candidates
    selfhost_checked_expr_tree_free checked_tree
    selfhost_call_reduce_free_error_new arena kind span

//: selfhost_call_reduce_pipe_free_candidates_tree_existing_error: pipe 候補 owner と checker owner を[閉/と]じて既存 error を[返/かえ]す
//:
//: [目的/もくてき]:
//: - ascribed pipe target の型不一致など、すでに具体的な `SelfhostCallReduceError` を作った経路で owner cleanup を一箇所に集めます。
//:
//: [契約/けいやく]:
//: - `pipe_candidates`、`checked_tree`、`arena` はこの関数が必ず閉じます。
//: - `error` の kind/span は変更しません。
fn selfhost_call_reduce_pipe_free_candidates_tree_existing_error %impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn Vec SelfhostCallableCandidate impure fn SelfhostCallReduceError Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \arena\checked_tree\pipe_candidates\error:
    v::free pipe_candidates
    selfhost_checked_expr_tree_free checked_tree
    selfhost_call_reduce_free_existing_error arena error

//: selfhost_call_reduce_pipe_span_from_ascription_error: ascription 投影 error の代表 span を[返/かえ]す
//:
//: [目的/もくてき]:
//: - pipe target ascription の `%T` 投影失敗を `PipeTargetAscriptionProjectionFailed` へ包むとき、元の typed sub-error が持つ位置情報を失わないようにします。
//:
//: [契約/けいやく]:
//: - 表示文字列は生成しません。span だけを取り出し、error kind は caller が pipe 専用 variant として決めます。
//:
//: [計算量/けいさんりょう]:
//: - enum match と field 読み出しだけなので O(1) です。
fn selfhost_call_reduce_pipe_span_from_ascription_error %fn SelfhostExprAscriptionError SelfhostSourceSpan \error:
    match error:
        SelfhostExprAscriptionError::EmptyExpressionRange span:
            span
        SelfhostExprAscriptionError::InvalidExpressionRange span:
            span
        SelfhostExprAscriptionError::NotTypeAscription span:
            span
        SelfhostExprAscriptionError::TypePrefixBuildFailed e:
            e.span
        SelfhostExprAscriptionError::TypeReduceFailed e:
            e.span
        SelfhostExprAscriptionError::TypeProjectFailed e:
            e.span
        SelfhostExprAscriptionError::MissingExpressionTail span:
            span

//: selfhost_call_reduce_pipe_rhs_range_from_prefix: pipe 右辺を source token range として[切/き]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `left |> %T target suffix...` の `%T` 境界を type resolver に任せるため、prefix item index の右辺範囲を token range に戻します。
//: - ascription projector は source token index を authority とするため、prefix item index と token index の変換をここで明示します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(range)`: `rhs_index` から式末尾までを覆う source token range です。
//: - `Err(error)`: prefix item 取得の不整合です。pipe target 内部不整合として扱います。
//:
//: [計算量/けいさんりょう]:
//: - 先頭 item と末尾 item を 1 回ずつ読むだけなので O(1) です。
fn selfhost_call_reduce_pipe_rhs_range_from_prefix %fn &SelfhostExprPrefixList fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostSyntaxRange SelfhostCallReduceError \prefix\rhs_index\item_count\fallback_span:
    match selfhost_expr_prefix_list_get prefix rhs_index:
        Option::Some first_item:
            match selfhost_expr_prefix_list_get prefix sub item_count 1:
                Option::Some last_item:
                    let token_count %i32 add sub last_item.token_index first_item.token_index 1
                    let span %SelfhostSourceSpan source_span_new_unchecked first_item.span.file_id first_item.span.start last_item.span.end
                    Result::Ok selfhost_syntax_range_new_unchecked first_item.token_index token_count span
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant fallback_span
        Option::None:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant fallback_span

//: selfhost_call_reduce_pipe_find_prefix_item_by_token_loop: token index に対応する pipe RHS item を[探/さが]す
//:
//: [目的/もくてき]:
//: - `%T` projector が返す expression-first token を、call reducer が扱う prefix item index に戻します。
//: - source token index と prefix item index を混同すると suffix 開始位置が壊れるため、pipe 専用の変換境界として保持します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(index)`: `token_index` を持つ prefix item index です。
//: - `Err(PipeRightTargetUnsupported)`: 対応する expression item が見つかりません。
//: - `Err(PipeTargetInternalInvariant)`: prefix list の取得に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - `idx` から `item_count` までを線形に見るため O(n) です。探索範囲は RHS の token 数だけに閉じます。
fn selfhost_call_reduce_pipe_find_prefix_item_by_token_loop %fn &SelfhostExprPrefixList fn i32 fn i32 fn i32 fn SelfhostSourceSpan Result i32 SelfhostCallReduceError \prefix\idx\item_count\token_index\fallback_span:
    if:
        ge idx item_count
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeRightTargetUnsupported fallback_span
        else:
            match selfhost_expr_prefix_list_get prefix idx:
                Option::Some item:
                    if:
                        eq item.token_index token_index
                        then:
                            Result::Ok idx
                        else:
                            selfhost_call_reduce_pipe_find_prefix_item_by_token_loop prefix add idx 1 item_count token_index fallback_span
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant fallback_span

//: selfhost_call_reduce_pipe_find_prefix_item_by_token: pipe RHS の expression-first token を prefix item index へ[戻/もど]す
//:
//: [目的/もくてき]:
//: - ascribed pipe target の `%T` 直後にある callable target item を特定します。
//:
//: [計算量/けいさんりょう]:
//: - RHS 残り item 数を n として O(n) です。
fn selfhost_call_reduce_pipe_find_prefix_item_by_token %fn &SelfhostExprPrefixList fn i32 fn i32 fn i32 fn SelfhostSourceSpan Result i32 SelfhostCallReduceError \prefix\start_idx\item_count\token_index\fallback_span:
    selfhost_call_reduce_pipe_find_prefix_item_by_token_loop prefix start_idx item_count token_index fallback_span

//: selfhost_call_reduce_pipe_candidate_matches_target_ascription: pipe target 注釈型と callable type が[一致/いっち]するか[返/かえ]す
//:
//: [目的/もくてき]:
//: - `%fn ... target` の明示注釈を、pipe target 候補を絞り込むための型 evidence として扱います。
//: - overload narrowing と単一候補照合の一致規則をこの helper に集約します。
//:
//: [契約/けいやく]:
//: - この関数は診断を作らず、型一致の真偽だけを返します。
//: - 注釈型は target callable そのものの型です。pipe 左辺の型、pipe 全体の結果型、suffix argument の型とは混同しません。
//:
//: [計算量/けいさんりょう]:
//: - 型一致判定の実コストは function type tree の大きさに依存します。
fn selfhost_call_reduce_pipe_candidate_matches_target_ascription %fn &SelfhostTypeArena fn SelfhostCallableCandidate fn SelfhostTypeExpectation bool \arena\candidate\expectation:
    selfhost_type_arena_types_equal arena expectation.expected_type candidate.callable_type

//: selfhost_call_reduce_pipe_target_ascription_match_count_loop: 注釈型に[一致/いっち]する pipe target 候補数を[数/かぞ]える
//:
//: [目的/もくてき]:
//: - pipe target の明示 function type 注釈を overload narrowing に使い、候補が複数ある場合でも探索空間を注釈型で狭めます。
//: - 候補列の owner は caller が保持し、この helper は借用だけで数えます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(count)`: 注釈型と callable type が一致した候補数です。
//: - `Err(PipeTargetInternalInvariant)`: candidate vector の取得に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 候補数を c、型一致判定の平均コストを t として O(c * t) です。
fn selfhost_call_reduce_pipe_target_ascription_match_count_loop %fn &SelfhostTypeArena fn &Vec SelfhostCallableCandidate fn SelfhostTypeExpectation fn i32 fn i32 Result i32 SelfhostCallReduceError \arena\pipe_candidates\expectation\idx\candidate_count:
    if:
        ge idx candidate_count
        then:
            Result::Ok 0
        else:
            match v::get pipe_candidates idx:
                Option::Some candidate:
                    match selfhost_call_reduce_pipe_target_ascription_match_count_loop arena pipe_candidates expectation add idx 1 candidate_count:
                        Result::Ok rest:
                            if:
                                selfhost_call_reduce_pipe_candidate_matches_target_ascription arena candidate expectation
                                then:
                                    Result::Ok add rest 1
                                else:
                                    Result::Ok rest
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant expectation.span

//: selfhost_call_reduce_pipe_target_ascription_first_match_loop: 注釈型に[一致/いっち]する最初の pipe target 候補を[返/かえ]す
//:
//: [目的/もくてき]:
//: - match count が 1 件であることを確認した後、その候補 payload を direct call 正規化へ渡します。
//: - count helper と同じ一致規則を使い、候補選択の規則が二重化しないようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidate)`: 注釈型と callable type が一致した唯一の候補です。
//: - `Err(PipeTargetInternalInvariant)`: 事前に 1 件一致を確認したにもかかわらず候補取得または探索に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 候補数を c、型一致判定の平均コストを t として最悪 O(c * t) です。
fn selfhost_call_reduce_pipe_target_ascription_first_match_loop %fn &SelfhostTypeArena fn &Vec SelfhostCallableCandidate fn SelfhostTypeExpectation fn i32 fn i32 Result SelfhostCallableCandidate SelfhostCallReduceError \arena\pipe_candidates\expectation\idx\candidate_count:
    if:
        ge idx candidate_count
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant expectation.span
        else:
            match v::get pipe_candidates idx:
                Option::Some candidate:
                    if:
                        selfhost_call_reduce_pipe_candidate_matches_target_ascription arena candidate expectation
                        then:
                            Result::Ok candidate
                        else:
                            selfhost_call_reduce_pipe_target_ascription_first_match_loop arena pipe_candidates expectation add idx 1 candidate_count
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant expectation.span

//: selfhost_call_reduce_pipe_target_ascription_select_candidate: 注釈型で pipe target overload を[選別/せんべつ]する
//:
//: [目的/もくてき]:
//: - `left |> %fn ... target suffix...` では、`target` の overload 候補を明示された function type で絞り込んでから曖昧性を判定します。
//: - 型注釈が探索空間を狭めるという NEPLg2.1 の方針を pipe target にも適用します。
//:
//: [場合分/ばあいわ]け:
//: - 一致候補 0 件は `PipeTargetAscriptionTypeMismatch` です。target は見つかっているが、注釈型と合う callable がありません。
//: - 一致候補 1 件は `Ok(candidate)` です。この候補だけを direct call 正規化へ渡します。
//: - 一致候補 2 件以上は `PipeTargetAmbiguous` です。同じ callable type を持つ overload が複数あるため、型注釈だけでは選べません。
//:
//: [契約/けいやく]:
//: - `pipe_candidates` owner は caller が保持し、この helper は借用だけを行います。
//: - generic inference、trait solving、引数式を使った追加 narrowing はこの slice の責務ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 一致数確認と候補取得で候補列を最大 2 回見るため、候補数を c、型一致判定の平均コストを t として O(c * t) です。
fn selfhost_call_reduce_pipe_target_ascription_select_candidate %fn &SelfhostTypeArena fn &Vec SelfhostCallableCandidate fn SelfhostTypeExpectation fn SelfhostExprPrefixItem fn i32 Result SelfhostCallableCandidate SelfhostCallReduceError \arena\pipe_candidates\expectation\rhs_head\candidate_count:
    match selfhost_call_reduce_pipe_target_ascription_match_count_loop arena pipe_candidates expectation 0 candidate_count:
        Result::Ok match_count:
            if:
                eq match_count 0
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAscriptionTypeMismatch expectation.span
                else:
                    if:
                        gt match_count 1
                        then:
                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAmbiguous rhs_head.span
                        else:
                            selfhost_call_reduce_pipe_target_ascription_first_match_loop arena pipe_candidates expectation 0 candidate_count
        Result::Err e:
            Result::Err e

//: selfhost_call_reduce_pipe_candidate_applicability_from_error: 候補 probe の失敗を[分類/ぶんるい]する
//:
//: [目的/もくてき]:
//: - 候補ごとの軽量 probe が返した call reduction error を、候補不一致、source-backed 再検査対象、選択禁止の未対応へ分類します。
//: - 注釈無し pipe target narrowing では、型不一致・引数数不一致・result expectation mismatch は候補固有の `NoMatch` として扱えます。
//: - source-backed owner checker が必要な失敗は `SourceBackedRequired` とし、generic 未解決や内部境界は `SelectionBlockedUnsupported` として一意選択から除外します。
//:
//: [契約/けいやく]:
//: - この関数は診断を作りません。最終的な error kind は候補列全体の集計後に caller が決めます。
//: - 境界外の error は candidate 固有の不一致にしません。再検査できるものと選択禁止のものを enum で分け、コメントだけに依存しない静的契約にします。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_call_reduce_pipe_candidate_applicability_from_error %fn SelfhostCallReduceError SelfhostPipeCandidateApplicability \error:
    match error.kind:
        SelfhostCallReduceErrorKind::EmptyInput:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::UnsupportedPrefixItem:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::UnresolvedName:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::NotCallable:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::PartialApplicationRejected:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::ArgumentTypeMismatch:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::ArgumentAscriptionProjectionFailed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentAscriptionExpectedTypeConflict:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNamedValueUnresolved:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNamedValuePendingBinding:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNamedValueUnsupportedBinding:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNamedValueEvidenceMissing:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueExpectedFunctionType:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingName:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueUnresolved:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueAmbiguous:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValuePendingBinding:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueMissingSignature:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentFunctionValueHeadTokenOutOfBounds:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentFunctionValueOutOfMemory:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentFunctionValueGenericUnsupported:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentFunctionValueTypeMismatch:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralTokenOutOfBounds:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentLiteralBoolInvalid:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralI32Invalid:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralI32RadixUnsupported:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralF32Invalid:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralStringMalformed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralStringEscapeUnsupported:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralStringEscapeMalformed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralStringSliceFailed:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentLiteralStringBuildFailed:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentLiteralCharMalformed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralCharEscapeUnsupported:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralCharInvalidScalar:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentLiteralCharMultipleScalars:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNegativeLiteralMissingOperand:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::ArgumentNegativeLiteralOperandNotNumeric:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::ArgumentNegativeLiteralSpanJoinFailed:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentNegativeLiteralTypeMismatch:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::ArgumentNestedCandidatePendingBinding:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNestedCandidateMissingSignature:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::ArgumentNestedCandidateHeadTokenOutOfBounds:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentNestedCandidateOutOfMemory:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ArgumentNestedCandidateInternalInvariant:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::TrailingBlockBodySegmentFailed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::TrailingBlockBodyEmpty:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::TrailingBlockBodyMultipleSegments:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::TrailingBlockBodyNestedBlockUnsupported:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::TrailingBlockBodyPrefixBuildFailed:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::TrailingBlockBodyCandidateCollectFailed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::TrailingBlockBodyUnitTypeMissing:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::UnexpectedTrailingBlockArgument:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeMissingLeftOperand:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeMissingRightTarget:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeUnsupportedMultiple:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeRightTargetUnsupported:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetPendingBinding:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetMissingSignature:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetHeadTokenOutOfBounds:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::PipeTargetOutOfMemory:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::PipeTargetInternalInvariant:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::PipeTargetUnresolved:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetAmbiguous:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetNoApplicableCandidate:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::PipeTargetAscriptionProjectionFailed:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::PipeTargetAscriptionTypeMismatch:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::PipeTargetRequiresInput:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::PipeLeftSegmentNotSingleValue:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::UnsupportedArgumentExpression:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::OverloadNoCandidate:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::OverloadAmbiguous:
            SelfhostPipeCandidateApplicability::SourceBackedRequired
        SelfhostCallReduceErrorKind::GenericInferenceEvidenceMissing:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::GenericInferenceConflict:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::GenericInferenceUnsupported:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::ExpectedTypeMismatch:
            SelfhostPipeCandidateApplicability::NoMatch
        SelfhostCallReduceErrorKind::CheckedTreeBuildInvalidOperation:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::OutOfMemory:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported
        SelfhostCallReduceErrorKind::InternalInvariant:
            SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported

//: selfhost_call_reduce_pipe_candidate_suffix_applicability: pipe 右辺 suffix が candidate の残り引数へ[合/あ]うか[調/しら]べる
//:
//: [目的/もくてき]:
//: - pipe target の第1引数に左辺が合うと分かった後、右辺 suffix と最終 result expectation だけを借用で検査します。
//: - 成功 path では checked argument payload を作らず、候補選択に必要な「合うかどうか」だけを調べます。
//:
//: [契約/けいやく]:
//: - `rhs_suffix_index` から `item_count` までをこの pipe 段の suffix とみなします。chain の次段 pipe は caller が `item_count` で切り落としています。
//: - 借用 reducer が扱えないが source-backed checker なら判定できる可能性がある引数式は `SourceBackedRequired` です。source-backed owner reducer をここで候補ごとに試行してはいけません。
//:
//: [戻/もど]り[値/ち]:
//: - `Match`: suffix と result expectation まで合いました。
//: - `NoMatch`: candidate 固有の型・arity・result 不一致が分かりました。
//: - `SourceBackedRequired`: 既存 source-backed checker でなければ判定できません。
//: - `SelectionBlockedUnsupported`: generic 未解決、内部境界、OOM など、候補選択へ使ってはいけない未対応状態です。
fn selfhost_call_reduce_pipe_candidate_suffix_applicability %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn SelfhostCallableCandidate fn i32 fn Option SelfhostTypeExpectation fn SelfhostExprPrefixItem fn i32 fn i32 Result SelfhostPipeCandidateApplicability SelfhostCallReduceError \arena\prefix\candidate\param_count\expected\rhs_head\item_count\rhs_suffix_index:
    match selfhost_call_reduce_argument_type_check_loop arena prefix candidate param_count 1 rhs_suffix_index item_count rhs_head:
        Result::Ok _unit:
            match selfhost_call_reduce_expected_result arena candidate expected:
                Result::Ok _result_type:
                    Result::Ok SelfhostPipeCandidateApplicability::Match
                Result::Err e:
                    Result::Ok selfhost_call_reduce_pipe_candidate_applicability_from_error e
        Result::Err e:
            Result::Ok selfhost_call_reduce_pipe_candidate_applicability_from_error e

//: selfhost_call_reduce_pipe_candidate_applicability: 1 pipe target candidate を軽量 probe する
//:
//: [目的/もくてき]:
//: - 注釈無し pipe target が複数候補を持つ場合に、左辺、右辺 suffix、外側 expected type で候補を一意に絞れるかを調べます。
//: - この probe は source text や checked tree owner を消費しません。候補確定後だけ既存の source-backed reducer を一度実行します。
//:
//: [契約/けいやく]:
//: - generic 未解決 candidate は `SelectionBlockedUnsupported` です。generic solver が無い段階で別候補を選ぶと将来の推論結果を隠すためです。
//: - `left_argument = Some` は pipe chain 2 段目以降の checked 左辺です。型一致だけを見て、checked tree node を再解釈しません。
//: - `left_argument = None` は単一 pipe または chain 1 段目です。左辺 segment は借用 argument matcher が pipe 位置までちょうど消費できる場合だけ `Match` 候補へ進めます。
//:
//: [計算量/けいさんりょう]:
//: - 候補1件につき、第1引数型取得 O(1)、型一致または左辺借用 matcher、suffix の parameter 数に比例する借用 matcher を行います。
fn selfhost_call_reduce_pipe_candidate_applicability %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn Option SelfhostCheckedArgument fn SelfhostExprPrefixItem fn i32 fn i32 fn i32 Result SelfhostPipeCandidateApplicability SelfhostCallReduceError \arena\prefix\candidate\expected\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _unit:
            match selfhost_type_arena_function_arg_count arena candidate.callable_type:
                Option::Some param_count:
                    if:
                        eq param_count 0
                        then:
                            Result::Ok SelfhostPipeCandidateApplicability::NoMatch
                        else:
                            match selfhost_type_arena_function_arg arena candidate.callable_type 0:
                                Option::Some first_arg_type:
                                    match left_argument:
                                        Option::Some checked_left:
                                            if:
                                                selfhost_type_arena_types_equal arena checked_left.value_type first_arg_type
                                                then:
                                                    selfhost_call_reduce_pipe_candidate_suffix_applicability arena prefix candidate param_count expected rhs_head item_count rhs_suffix_index
                                                else:
                                                    Result::Ok SelfhostPipeCandidateApplicability::NoMatch
                                        Option::None:
                                            match selfhost_expr_argument_match_at arena prefix 0 pipe_index first_arg_type:
                                                Result::Ok left_match:
                                                    if:
                                                        eq left_match.next_index pipe_index
                                                        then:
                                                            selfhost_call_reduce_pipe_candidate_suffix_applicability arena prefix candidate param_count expected rhs_head item_count rhs_suffix_index
                                                        else:
                                                            Result::Ok SelfhostPipeCandidateApplicability::SourceBackedRequired
                                                Result::Err e:
                                                    match selfhost_call_reduce_error_from_argument_match e rhs_head:
                                                        Result::Ok _unit:
                                                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
                                                        Result::Err call_error:
                                                            Result::Ok selfhost_call_reduce_pipe_candidate_applicability_from_error call_error
                                Option::None:
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
                Option::None:
                    Result::Ok SelfhostPipeCandidateApplicability::NoMatch
        Result::Err e:
            Result::Ok selfhost_call_reduce_pipe_candidate_applicability_from_error e

//: selfhost_call_reduce_pipe_candidate_probe_summary_next: 候補 probe summary を 1 件ぶん[更新/こうしん]する
//:
//: [目的/もくてき]:
//: - 候補列を 1 pass で集計するため、現在の summary と probe 結果から次の summary を作ります。
//: - candidate payload は summary に保存せず、必要になった場合に同じ probe 規則を使う first-match helper が取り出します。
//:
//: [計算量/けいさんりょう]:
//: - copy payload の組み立てだけなので O(1) です。
fn selfhost_call_reduce_pipe_candidate_probe_summary_next %fn SelfhostPipeCandidateProbeSummary fn SelfhostPipeCandidateApplicability SelfhostPipeCandidateProbeSummary \summary\applicability:
    match applicability:
        SelfhostPipeCandidateApplicability::Match:
            SelfhostPipeCandidateProbeSummary add summary.match_count 1 summary.source_backed_required_count summary.blocked_unsupported_count
        SelfhostPipeCandidateApplicability::NoMatch:
            summary
        SelfhostPipeCandidateApplicability::SourceBackedRequired:
            SelfhostPipeCandidateProbeSummary summary.match_count add summary.source_backed_required_count 1 summary.blocked_unsupported_count
        SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported:
            SelfhostPipeCandidateProbeSummary summary.match_count summary.source_backed_required_count add summary.blocked_unsupported_count 1

//: selfhost_call_reduce_pipe_candidate_probe_summary_loop: pipe target 候補列を軽量 probe で[集計/しゅうけい]する
//:
//: [目的/もくてき]:
//: - 注釈無し pipe target の候補列を左から1回だけ走査し、候補不一致、一致、probe未対応を集計します。
//: - 候補 vector の owner は caller が保持し、この helper は借用だけを行います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(summary)`: 候補列全体の match / source-backed required / blocked unsupported count です。実際の一致 candidate payload は、summary が一意一致を示した後に `selfhost_call_reduce_pipe_candidate_probe_first_match_loop` が同じ規則で取り直します。
//: - `Err(PipeTargetInternalInvariant)`: 候補数と vector 取得結果が矛盾しました。
//:
//: [計算量/けいさんりょう]:
//: - 候補数を c、1候補の軽量 probe cost を p として O(c * p) です。
fn selfhost_call_reduce_pipe_candidate_probe_summary_loop %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn Option SelfhostCheckedArgument fn SelfhostExprPrefixItem fn i32 fn i32 fn i32 fn i32 fn i32 fn SelfhostPipeCandidateProbeSummary Result SelfhostPipeCandidateProbeSummary SelfhostCallReduceError \arena\prefix\pipe_candidates\expected\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index\idx\candidate_count\summary:
    if:
        ge idx candidate_count
        then:
            Result::Ok summary
        else:
            match v::get pipe_candidates idx:
                Option::Some candidate:
                    match selfhost_call_reduce_pipe_candidate_applicability arena prefix candidate expected left_argument rhs_head item_count pipe_index rhs_suffix_index:
                        Result::Ok applicability:
                            let next_summary %SelfhostPipeCandidateProbeSummary selfhost_call_reduce_pipe_candidate_probe_summary_next summary applicability
                            selfhost_call_reduce_pipe_candidate_probe_summary_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index add idx 1 candidate_count next_summary
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span

//: selfhost_call_reduce_pipe_candidate_probe_first_match_loop: 軽量 probe で一致する最初の candidate を[返/かえ]す
//:
//: [目的/もくてき]:
//: - summary で `match_count == 1` と確認した後、同じ applicability 規則で唯一の一致 candidate を取り出します。
//: - summary payload に candidate を保存しないため、型式境界を単純に保ったまま候補 payload を安全に復元できます。
//:
//: [契約/けいやく]:
//: - caller は `source_backed_required_count == 0`、`blocked_unsupported_count == 0`、`match_count == 1` を先に確認してから呼びます。
//: - それでも一致候補が見つからない場合は、候補列の取得または事前集計との不整合として `PipeTargetInternalInvariant` です。
//:
//: [計算量/けいさんりょう]:
//: - 候補数 c と1候補 probe cost p に対して最悪 O(c * p) です。呼び出しは唯一候補を採用する場合だけです。
fn selfhost_call_reduce_pipe_candidate_probe_first_match_loop %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn Option SelfhostCheckedArgument fn SelfhostExprPrefixItem fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostCallableCandidate SelfhostCallReduceError \arena\prefix\pipe_candidates\expected\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index\idx\candidate_count:
    if:
        ge idx candidate_count
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
        else:
            match v::get pipe_candidates idx:
                Option::Some candidate:
                    match selfhost_call_reduce_pipe_candidate_applicability arena prefix candidate expected left_argument rhs_head item_count pipe_index rhs_suffix_index:
                        Result::Ok applicability:
                            match applicability:
                                SelfhostPipeCandidateApplicability::Match:
                                    Result::Ok candidate
                                SelfhostPipeCandidateApplicability::NoMatch:
                                    selfhost_call_reduce_pipe_candidate_probe_first_match_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index add idx 1 candidate_count
                                SelfhostPipeCandidateApplicability::SourceBackedRequired:
                                    selfhost_call_reduce_pipe_candidate_probe_first_match_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index add idx 1 candidate_count
                                SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported:
                                    selfhost_call_reduce_pipe_candidate_probe_first_match_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index add idx 1 candidate_count
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span

//: selfhost_call_reduce_pipe_candidate_probe_first_source_backed_required_loop: 軽量 probe で唯一残った source-backed 必須 candidate を[返/かえ]す
//:
//: [目的/もくてき]:
//: - summary で `match_count == 0`、`source_backed_required_count == 1`、`blocked_unsupported_count == 0` と確認した後、その唯一の `SourceBackedRequired` candidate を取り出します。
//: - `%T expr` のような source-backed argument は borrowed probe だけでは判定できませんが、他候補がすべて `NoMatch` なら、候補ごとの探索を広げず既存 source-backed finisher を 1 回だけ実行できます。
//:
//: [契約/けいやく]:
//: - caller は `match_count == 0`、`source_backed_required_count == 1`、`blocked_unsupported_count == 0` を先に確認してから呼びます。
//: - `Match` や `SelectionBlockedUnsupported` が見つかった場合、または `SourceBackedRequired` が見つからない場合は、事前集計との矛盾として `PipeTargetInternalInvariant` を返します。
//: - この helper は候補 vector を借用するだけで、arena、checked tree、candidate owner を移動しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(candidate)`: 唯一の source-backed 必須 candidate です。caller はこの candidate だけを source-backed checker へ渡します。
//: - `Err(error)`: summary と再走査結果が矛盾した場合の typed invariant error です。
//:
//: [計算量/けいさんりょう]:
//: - 候補数 c と1候補 probe cost p に対して最悪 O(c * p) です。呼び出しは唯一の source-backed 必須 candidate を採用する場合だけです。
fn selfhost_call_reduce_pipe_candidate_probe_first_source_backed_required_loop %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn Option SelfhostCheckedArgument fn SelfhostExprPrefixItem fn i32 fn i32 fn i32 fn i32 fn i32 Result SelfhostCallableCandidate SelfhostCallReduceError \arena\prefix\pipe_candidates\expected\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index\idx\candidate_count:
    if:
        ge idx candidate_count
        then:
            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
        else:
            match v::get pipe_candidates idx:
                Option::Some candidate:
                    match selfhost_call_reduce_pipe_candidate_applicability arena prefix candidate expected left_argument rhs_head item_count pipe_index rhs_suffix_index:
                        Result::Ok applicability:
                            match applicability:
                                SelfhostPipeCandidateApplicability::Match:
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
                                SelfhostPipeCandidateApplicability::NoMatch:
                                    selfhost_call_reduce_pipe_candidate_probe_first_source_backed_required_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index add idx 1 candidate_count
                                SelfhostPipeCandidateApplicability::SourceBackedRequired:
                                    Result::Ok candidate
                                SelfhostPipeCandidateApplicability::SelectionBlockedUnsupported:
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetInternalInvariant rhs_head.span

//: selfhost_call_reduce_pipe_target_argument_select_candidate: 注釈無し pipe target を引数列で[選別/せんべつ]する
//:
//: [目的/もくてき]:
//: - `left |> target suffix...` の target が overload されている場合に、左辺と suffix の型・消費幅で候補を一意化できるか判定します。
//: - type ascription が無くても、NEPLg2.1 の前置情報と引数型から探索空間を狭められるケースを扱います。
//:
//: [場合分/ばあいわ]け:
//: - `Match` が 1 件で、`SourceBackedRequired` と `SelectionBlockedUnsupported` が 0 件ならその候補を返します。
//: - `Match` が 0 件、`SourceBackedRequired` が 1 件、`SelectionBlockedUnsupported` が 0 件なら、その唯一候補を返します。caller は既存 source-backed finisher を 1 回だけ実行します。
//: - `Match` が 0 件、`SourceBackedRequired` が 0 件、`SelectionBlockedUnsupported` が 0 件なら `PipeTargetNoApplicableCandidate` です。
//: - `Match` が複数、`SourceBackedRequired` が複数、`SelectionBlockedUnsupported` が1件以上、または `Match` と `SourceBackedRequired` が混在する場合は `PipeTargetAmbiguous` です。
//:
//: [計算量/けいさんりょう]:
//: - 候補列を1回だけ走査するため、候補数 c と1候補 probe cost p に対して O(c * p) です。
fn selfhost_call_reduce_pipe_target_argument_select_candidate %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn &Vec SelfhostCallableCandidate fn Option SelfhostTypeExpectation fn Option SelfhostCheckedArgument fn SelfhostExprPrefixItem fn i32 fn i32 fn i32 fn i32 Result SelfhostCallableCandidate SelfhostCallReduceError \arena\prefix\pipe_candidates\expected\left_argument\rhs_head\item_count\pipe_index\rhs_suffix_index\candidate_count:
    let initial %SelfhostPipeCandidateProbeSummary SelfhostPipeCandidateProbeSummary 0 0 0
    match selfhost_call_reduce_pipe_candidate_probe_summary_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index 0 candidate_count initial:
        Result::Ok summary:
            if:
                gt summary.blocked_unsupported_count 0
                then:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAmbiguous rhs_head.span
                else:
                    if:
                        gt summary.source_backed_required_count 0
                        then:
                            if:
                                eq summary.match_count 0
                                then:
                                    if:
                                        eq summary.source_backed_required_count 1
                                        then:
                                            selfhost_call_reduce_pipe_candidate_probe_first_source_backed_required_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index 0 candidate_count
                                        else:
                                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAmbiguous rhs_head.span
                                else:
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAmbiguous rhs_head.span
                        else:
                            if:
                                eq summary.match_count 0
                                then:
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetNoApplicableCandidate rhs_head.span
                                else:
                                    if:
                                        gt summary.match_count 1
                                        then:
                                            Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeTargetAmbiguous rhs_head.span
                                        else:
                                            selfhost_call_reduce_pipe_candidate_probe_first_match_loop arena prefix pipe_candidates expected left_argument rhs_head item_count pipe_index rhs_suffix_index 0 candidate_count
        Result::Err e:
            Result::Err e

//: selfhost_call_reduce_pipe_finish_candidate_with_checked_left: checked 左辺を第1引数として direct call を[作/つく]る
//:
//: [目的/もくてき]:
//: - 単一 pipe と pipe chain の各段で共通する「target の第1引数に左辺 evidence を差し込み、右辺 suffix を残り parameter として検査する」処理を集約します。
//: - pipe chain では前段の direct call root が `CheckedExpr` argument として渡されます。ここで source token や scope lookup を再実行せず、checked tree 内の node id を authority にします。
//:
//: [契約/けいやく]:
//: - `left_argument` はすでに target の第1 parameter type と照合済みでなければなりません。
//: - `rhs_suffix_index` から `item_count` までだけをこの段の右辺 suffix として消費します。chain の次段 pipe は caller が `item_count` を切って除外します。
//: - `pipe_candidates` は成功・失敗のどちらでもこの関数が閉じます。
//: - 成功時は direct call node を `checked_tree` に追加し、その node id を owned result の `root_expr` として返します。
//:
//: [計算量/けいさんりょう]:
//: - target の残り parameter 数を p とすると、suffix argument 検査は O(p) 回です。各 argument の実コストは既存 source-backed argument checker に従います。
fn selfhost_call_reduce_pipe_finish_candidate_with_checked_left %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Vec SelfhostCallableCandidate impure fn SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn i32 impure fn SelfhostCheckedArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\pipe_candidates\candidate\expected\trailing_block\rhs_head\item_count\rhs_suffix_index\param_count\left_argument:
    let checked_arguments_result %Result Vec SelfhostCheckedArgument StdErrorKind v::new
    match checked_arguments_result:
        Result::Ok checked_arguments:
            match selfhost_call_reduce_push_checked_argument arena checked_arguments checked_tree left_argument rhs_head.span:
                Result::Ok first_state:
                    let first_arena %SelfhostTypeArena field::get first_state "arena"
                    let first_arguments %Vec SelfhostCheckedArgument field::get first_state "checked_arguments"
                    let first_tree %SelfhostCheckedExprTree field::get first_state "checked_tree"
                    match selfhost_call_reduce_argument_type_check_loop_with_source tokens source first_arena first_arguments first_tree prefix scope value_types signatures candidate param_count 1 rhs_suffix_index item_count trailing_block rhs_head:
                        Result::Ok state:
                            let checked_arena2 %SelfhostTypeArena field::get state "arena"
                            let checked_arguments2 %Vec SelfhostCheckedArgument field::get state "checked_arguments"
                            let checked_tree2 %SelfhostCheckedExprTree field::get state "checked_tree"
                            let call_span %SelfhostSourceSpan selfhost_call_reduce_prefix_cover_span prefix item_count rhs_head.span
                            match selfhost_call_reduce_expected_result &checked_arena2 candidate expected:
                                Result::Ok result_type:
                                    match selfhost_checked_expr_tree_add_direct_call_borrowed checked_tree2 candidate result_type call_span &checked_arguments2:
                                        Result::Ok root_alloc:
                                            let root_expr %SelfhostCheckedExprId selfhost_checked_expr_node_alloc_expr_id &root_alloc
                                            let root_tree %SelfhostCheckedExprTree selfhost_checked_expr_node_alloc_into_tree root_alloc
                                            let result %SelfhostCallReduceResult SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type call_span
                                            v::free pipe_candidates
                                            Result::Ok selfhost_call_reduce_owned_result_new checked_arena2 result checked_arguments2 root_tree root_expr
                                        Result::Err tree_error:
                                            v::free pipe_candidates
                                            selfhost_type_arena_free checked_arena2
                                            v::free checked_arguments2
                                            Result::Err selfhost_call_reduce_error_from_checked_tree_std_error tree_error call_span
                                Result::Err e:
                                    v::free pipe_candidates
                                    selfhost_type_arena_free checked_arena2
                                    v::free checked_arguments2
                                    selfhost_checked_expr_tree_free checked_tree2
                                    Result::Err e
                        Result::Err e:
                            v::free pipe_candidates
                            Result::Err e
                Result::Err e:
                    v::free pipe_candidates
                    Result::Err e
        Result::Err _alloc_error:
            selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::OutOfMemory rhs_head.span

//: selfhost_call_reduce_pipe_checked_left_candidate_with_source: chain 中間結果を pipe 左辺として[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - pipe chain の 2 段目以降で、前段の checked expression root を次段 target の第1引数として渡します。
//: - `CheckedExpr` argument の型だけを照合し、前段 expression を prefix token へ戻したり、HIR lowering で再解釈したりしません。
//:
//: [契約/けいやく]:
//: - target が 0 引数関数なら `PipeTargetRequiresInput` です。
//: - `left_argument.value_type` と target 第1 parameter type が一致しない場合は通常の argument type mismatch として拒否します。
//: - `pipe_candidates`、`checked_tree`、`arena` の owner は成功・失敗のどちらでも閉じるか返り値へ移します。
//:
//: [計算量/けいさんりょう]:
//: - 第1 parameter type の取得と照合は O(type equality) です。残り suffix は `selfhost_call_reduce_pipe_finish_candidate_with_checked_left` の計算量に従います。
fn selfhost_call_reduce_pipe_checked_left_candidate_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Vec SelfhostCallableCandidate impure fn SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn SelfhostCheckedArgument Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\pipe_candidates\candidate\expected\trailing_block\rhs_head\item_count\rhs_suffix_index\left_argument:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _unit:
            match selfhost_type_arena_function_arg_count &arena candidate.callable_type:
                Option::Some param_count:
                    if:
                        eq param_count 0
                        then:
                            selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::PipeTargetRequiresInput rhs_head.span
                        else:
                            match selfhost_type_arena_function_arg &arena candidate.callable_type 0:
                                Option::Some first_arg_type:
                                    if:
                                        selfhost_type_arena_types_equal &arena left_argument.value_type first_arg_type
                                        then:
                                            selfhost_call_reduce_pipe_finish_candidate_with_checked_left tokens source arena checked_tree prefix scope value_types signatures pipe_candidates candidate expected trailing_block rhs_head item_count rhs_suffix_index param_count left_argument
                                        else:
                                            selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::ArgumentTypeMismatch left_argument.span
                                Option::None:
                                    selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::InternalInvariant rhs_head.span
                Option::None:
                    selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            v::free pipe_candidates
            selfhost_checked_expr_tree_free checked_tree
            selfhost_call_reduce_free_existing_error arena e

//: selfhost_call_reduce_pipe_single_candidate_with_source: 1 pipe target candidate を direct call として[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `left |> target right_args...` を、source-backed checked tree 上では `target left right_args...` と同じ `DirectCall` payload へ正規化します。
//: - 左辺は target の第1 parameter expected type で 1 つの実引数式として検査し、右辺 suffix は `rhs_suffix_index` から既存の source-backed argument loop に第2 parameter として渡します。
//:
//: [契約/けいやく]:
//: - source-less reducer は pipe を扱いません。この helper は source text、tokens、scope、value evidence、signature table を持つ入口からだけ呼ばれます。
//: - pipe chain の2段目以降ではこの helper ではなく、前段 checked expression を持つ `selfhost_call_reduce_pipe_checked_left_candidate_with_source` を使います。
//: - `pipe_candidates` は成功・失敗のどちらでもこの helper が閉じます。
//: - `rhs_suffix_index` は実際の target item の直後です。plain target では `pipe_index + 2`、ascribed target では `%T` の型式 token 群を飛ばした `target_index + 1` になります。
//: - target が 0 引数関数の場合、左辺を差し込む場所がないため `PipeTargetRequiresInput` を返します。
//: - 左辺 prefix segment が expected type の 1 式としてちょうど pipe 位置まで消費されない場合、suffix を勝手に右辺側へ流さず `PipeLeftSegmentNotSingleValue` を返します。
//:
//: [計算量/けいさんりょう]:
//: - pipe detection は入口で O(n) 済みです。この helper は target parameter 数 p に対して O(p) 回 argument checker を呼びます。左辺 segment の検査は既存 nested/direct argument reducer の計算量に従います。
fn selfhost_call_reduce_pipe_single_candidate_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Vec SelfhostCallableCandidate impure fn SelfhostCallableCandidate impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\arena\checked_tree\prefix\scope\value_types\signatures\pipe_candidates\candidate\expected\trailing_block\rhs_head\item_count\pipe_index\rhs_suffix_index:
    match selfhost_call_reduce_generic_state_error candidate:
        Result::Ok _unit:
            match selfhost_type_arena_function_arg_count &arena candidate.callable_type:
                Option::Some param_count:
                    if:
                        eq param_count 0
                        then:
                            selfhost_call_reduce_pipe_free_candidates_tree_error_new arena checked_tree pipe_candidates SelfhostCallReduceErrorKind::PipeTargetRequiresInput rhs_head.span
                        else:
                            match selfhost_type_arena_function_arg &arena candidate.callable_type 0:
                                Option::Some first_arg_type:
                                    match selfhost_call_reduce_argument_match_at_with_source_or_nested tokens source arena checked_tree prefix scope value_types signatures 0 pipe_index first_arg_type rhs_head:
                                        Result::Ok left_state:
                                            let left_match %SelfhostExprArgumentMatch field::get left_state "match_value"
                                            let checked_argument %SelfhostCheckedArgument field::get left_state "checked_argument"
                                            let checked_arena %SelfhostTypeArena field::get left_state "arena"
                                            let left_tree %SelfhostCheckedExprTree field::get left_state "checked_tree"
                                            if:
                                                eq left_match.next_index pipe_index
                                                then:
