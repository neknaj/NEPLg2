                                    selfhost_checked_expr_tree_free body_tree
                                    selfhost_body_segment_list_free segments
                                    v::free v::vec_push_error_vec push_error
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OutOfMemory line_span
                        Result::Err e:
                            selfhost_body_segment_list_free segments
                            v::free body_exprs
                            Result::Err e
                Option::None:
                    selfhost_type_arena_free arena
                    selfhost_checked_expr_tree_free checked_tree
                    selfhost_body_segment_list_free segments
                    v::free body_exprs
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::InternalInvariant block_span

