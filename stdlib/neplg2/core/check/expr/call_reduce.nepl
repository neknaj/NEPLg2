fn selfhost_call_reduce_pipe_chain_finish_or_continue %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostCallReduceOwnedResult impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn Option SelfhostTypeExpectation impure fn Option SelfhostTrailingBlockArgument impure fn i32 impure fn Option i32 Result SelfhostCallReduceOwnedResult SelfhostCallReduceError \tokens\source\owned\prefix\scope\value_types\signatures\expected\trailing_block\item_count\next_pipe:
