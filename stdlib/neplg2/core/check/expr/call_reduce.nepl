//:
//: [戻/もど]り[値/ち]:
//: - `Ok(state)`: block sequence node を指す `CheckedExpr` argument が作られました。
//: - `Err(error)`: segment 取得、行の入力構築、再帰 reduction、root id list 追加、checked tree 追加のいずれかに失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - top-level expression 数を n とすると、n 回の行 input 構築と n 回の source-backed reducer 呼び出しに比例します。`unit` type の探索は loop 外で 1 回だけ行います。各行の候補収集コストは `candidate_collection.nepl` の契約に従います。
fn selfhost_call_reduce_trailing_block_sequence_loop %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn SelfhostCheckedExprTree impure fn Vec SelfhostCheckedExprId impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostTypeId impure fn SelfhostTypeId impure fn SelfhostBodySegmentList impure fn i32 impure fn i32 impure fn i32 impure fn SelfhostSourceSpan Result SelfhostCallReduceArgumentMatchState SelfhostCallReduceError \tokens\source\arena\checked_tree\body_exprs\scope\value_types\signatures\expected_type\unit_type\segments\idx\count\item_index\block_span:
    if:
        ge idx count
        then:
            selfhost_body_segment_list_free segments
            match selfhost_checked_expr_tree_add_block_sequence checked_tree expected_type block_span body_exprs:
                Result::Ok alloc:
                    let expr_id %SelfhostCheckedExprId selfhost_checked_expr_node_alloc_expr_id &alloc
                    let next_tree %SelfhostCheckedExprTree selfhost_checked_expr_node_alloc_into_tree alloc
                    let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new item_index
                    let checked_argument %SelfhostCheckedArgument selfhost_checked_argument_checked_expr item_index item_index expected_type block_span expr_id
                    Result::Ok selfhost_call_reduce_argument_match_state_new arena next_tree match_value checked_argument
                Result::Err tree_error:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_call_reduce_error_from_checked_tree_std_error tree_error block_span
        else:
            match selfhost_body_segment_list_get &segments idx:
                Option::Some segment:
                    let line_span %SelfhostSourceSpan selfhost_block_body_result_segment_span segment
                    let line_expected %Option SelfhostTypeExpectation selfhost_call_reduce_trailing_block_sequence_line_expected expected_type unit_type idx count line_span
                    match selfhost_call_reduce_trailing_block_segment_result tokens source arena checked_tree scope value_types signatures line_expected segment:
                        Result::Ok owned:
                            let parts %SelfhostCallReduceOwnedResultParts selfhost_call_reduce_owned_result_into_parts owned
                            let checked_arena %SelfhostTypeArena field::get parts "arena"
                            let body_tree %SelfhostCheckedExprTree field::get parts "checked_tree"
                            let body_expr %SelfhostCheckedExprId field::get parts "root_expr"
                            let body_args %Vec SelfhostCheckedArgument field::get parts "checked_arguments"
                            v::free body_args
                            match v::push body_exprs body_expr:
                                Result::Ok next_body_exprs:
                                    selfhost_call_reduce_trailing_block_sequence_loop tokens source checked_arena body_tree next_body_exprs scope value_types signatures expected_type unit_type segments add idx 1 count item_index block_span
                                Result::Err push_error:
                                    selfhost_type_arena_free checked_arena
                                    selfhost_checked_expr_tree_free body_tree
                                    selfhost_body_segment_list_free segments
                                    v::free v::vec_push_error_vec push_error
                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::OutOfMemory line_span
                        Result::Err e:
