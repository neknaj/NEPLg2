                            let next_tree %SelfhostCheckedExprTree selfhost_checked_expr_node_alloc_into_tree alloc
                            let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new item_index
                            let checked_argument %SelfhostCheckedArgument selfhost_checked_argument_checked_expr item_index item_index expected_type block_span expr_id
                            Result::Ok selfhost_call_reduce_argument_match_state_new checked_arena next_tree match_value checked_argument
                        Result::Err tree_error:
                            selfhost_type_arena_free checked_arena
                            Result::Err selfhost_call_reduce_error_from_checked_tree_std_error tree_error block_span
                Result::Err e:
                    Result::Err e
