                                Result::Ok result_type:
                                    Result::Ok SelfhostCallReduceResult::DirectCall selfhost_reduced_call_new 0 param_count result_type head.span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::NotCallable candidate.span
        Result::Err e:
            Result::Err e

