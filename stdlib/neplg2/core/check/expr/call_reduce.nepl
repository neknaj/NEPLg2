                                                    selfhost_type_arena_free checked_arena
                                                    selfhost_checked_expr_tree_free left_tree
                                                    Result::Err selfhost_call_reduce_error_new SelfhostCallReduceErrorKind::PipeLeftSegmentNotSingleValue rhs_head.span
                                        Result::Err e:
