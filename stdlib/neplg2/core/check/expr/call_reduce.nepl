        SelfhostCallReduceResult::DirectCall call:
            let arena %SelfhostTypeArena field::get parts "arena"
            let checked_arguments %Vec SelfhostCheckedArgument field::get parts "checked_arguments"
            let checked_tree %SelfhostCheckedExprTree field::get parts "checked_tree"
            let root_expr %SelfhostCheckedExprId field::get parts "root_expr"
            let checked_left %SelfhostCheckedArgument selfhost_checked_argument_checked_expr 0 next_pipe_index call.result_type call.span root_expr
            v::free checked_arguments
            selfhost_call_reduce_pipe_chain_continue_with_left tokens source arena checked_tree prefix scope value_types signatures expected trailing_block item_count next_pipe_index checked_left

//: selfhost_call_reduce_pipe_chain_finish_or_continue: 1 pipe 段の結果を final result か次段へ[分配/ぶんぱい]する
//:
