#indent 4

//: # check/expr/argument
//: prefix expression item から、call argument として使える最小の型証拠を取り出す module です。
//:
//: [目的/もくてき]:
//: - call reducer が function parameter type と実引数 item を照合できるよう、literal item の型を `SelfhostTypeKind` として返します。
//: - parser や prefix expression module に checker の型知識を持ち込まず、型証拠の責務を `check/expr` 配下に閉じ込めます。
//: - 未対応の式を「たぶん合っている」として通さず、証拠が取れない場合は error enum を返して caller が fail-closed にします。
//: - prefix list 上で 1 つの実引数式がどこまでを消費したかを typed result として返し、call reducer が raw token 数を arity と誤認しないようにします。
//:
//: [契約/けいやく]:
//: - `IntLiteral` は現 checkpoint の stage0 fixture と同じく `i32` として扱います。整数 suffix と expected type による numeric literal defaulting は後続 slice の責務です。
//: - `FloatLiteral` は Rust 実装の現 checkpoint と同じく `f32` として扱います。`f64` defaulting や suffix 解決は後続の numeric literal 設計で扱います。
//: - source-less borrowed API では `NamedValue`、block、control form、lambda、borrow、pipe などは、full expression checker が型を返せるようになるまで fail-closed にします。
//: - source-less borrowed API は `%T expr` 形式の ascribed argument を成功扱いしません。`%` を見つけた場合、可変幅式を生の item 数へ潰さず `UnsupportedAscribedArgument` として返します。
//: - source / token backed owner API は、literal、`%T literal`、型証拠が登録済みの `NamedValue`、`%T NamedValue`、明示 function value の `@ident` を成功させます。型式投影に失敗した場合は `AscriptionProjectionFailed` として返し、位置情報を空 span へ潰しません。
//: - `NamedValue` は scope binding と DefId-linked value type evidence が両方そろう場合だけ成功させます。名前の spelling だけから型を推測しません。
//: - `@ident` は callable signature table から monomorphic named function candidate を取り出し、expected parameter type が function type と一致する場合だけ成功します。bare `ident` から暗黙に function value を作ることはありません。
//:
//: [計算量/けいさんりょう]:
//: - item kind の分類と expected kind の比較はいずれも O(1) です。
//: - source-backed `NamedValue` は scope lookup と value evidence lookup を行います。現行 `SelfhostValueTypeEvidenceTable` は DefId に対して O(n) の線形探索ですが、API が table 表現を隠しているため、後続で index 化しても caller の契約は変わりません。
//: - source-backed `@ident` は scope lookup と signature table lookup を行います。現行 table では O(b + s) ですが、candidate collection API の外へ表現を出さないため、後続で interface artifact / DefId index に置き換えられます。

#import "alloc/collections/vec" as v
#import "core/option" as *
#import "core/result" as *
#import "core/math" as *
#import "core/field" as field
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/syntax/ast/prefix_expr" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/token" as *
#import "neplg2/core/ty/ty" as *
#import "./expectation" as *
#import "./ascription" as *
#import "./value_evidence" as *
#import "./call_candidate" as *
#import "./candidate_collection" as *
#import "./argument_payload" as *
#import "./literal_payload" as *

//: SelfhostExprArgumentMatch: prefix list 上で 1 つの実引数式を消費した結果
//:
//: [目的/もくてき]:
//: - `next_index` は、次の実引数式を読み始める prefix item index です。
//: - literal item だけの実引数では `next_index = current_index + 1` になります。
//: - 後続 slice で `%T literal` や nested call が実装されると、同じ result 型で 2 個以上の item を消費できます。
//:
//: [契約/けいやく]:
//: - この値は call reducer の走査 cursor です。HIR node や型付き expression payload ではありません。
//: - 成功した場合だけ返し、証拠が足りない式は error enum で fail-closed にします。
pub struct SelfhostExprArgumentMatch:
    next_index %i32

impl Clone for SelfhostExprArgumentMatch:
    fn clone %fn &SelfhostExprArgumentMatch SelfhostExprArgumentMatch \self:
        *self

impl Copy for SelfhostExprArgumentMatch:
    fn copy_mark %fn SelfhostExprArgumentMatch SelfhostExprArgumentMatch \self:
        self

//: SelfhostExprArgumentMatchErrorKind: 実引数式走査が失敗した理由
//:
//: [目的/もくてき]:
//: - `TypeMismatch` は、literal item の型証拠が expected parameter type と合わなかった場合です。
//: - `UnsupportedAscribedArgument` は、`%T expr` のような可変幅 argument expression を見つけたが、この API では source / token 付き checker へ渡せない場合です。
//: - `AscriptionProjectionFailed` は、source / token backed API が `%T` head を型式として投影できなかった場合です。
//: - `AscriptionExpectedTypeConflict` は、明示 ascription type と parameter expected type が衝突した場合です。
//: - `NamedValue*` は、argument position の名前に対する binding / DefId / value type evidence が不足した場合を分けます。
//: - `FunctionValue*` は、明示 `@ident` argument を function value として扱うための callable identity / signature evidence が不足した場合を分けます。`FunctionValueMissingName` は `@` の直後が存在しない場合と、直後の item が identifier ではない場合の両方を表します。
//: - `Literal*` は、source-backed literal payload 生成で token 範囲や意味値解析に失敗した場合を分けます。raw lexeme を HIR へ流す fallback は行いません。
//: - `NegativeLiteral*` は、`MinusMarker` から始まる負数 numeric argument の構文的・型的な失敗を分けます。operand 欠落、非数値 operand、span 結合失敗、expected type mismatch を同じ unsupported error へ潰しません。
//: - `UnsupportedArgumentExpression` は、name resolution や nested call reduction が必要で、単一 literal item からは型証拠を得られない場合です。
//: - `MissingArgument` と `InternalInvariant` は caller 側の cursor と prefix list の不整合を区別します。
//:
//: [契約/けいやく]:
//: - この enum は実引数検査の失敗理由の authority です。表示文字列や一時的な diagnostic 文言をここへ混ぜません。
//: - 呼び出し境界の推論で探索を広げられない場合は、unsupported / ambiguous / missing evidence を別 variant として返し、型不一致へ潰しません。
//: - source-backed API が token/span を持つ場合は、token 範囲外、literal 解析失敗、candidate 収集失敗をそれぞれ静的に区別できる variant へ写像します。
pub enum SelfhostExprArgumentMatchErrorKind:
    MissingArgument
    TypeMismatch
    UnsupportedAscribedArgument
    AscriptionProjectionFailed
    AscriptionExpectedTypeConflict
    NamedValueUnresolved
    NamedValuePendingBinding
    NamedValueUnsupportedBinding
    NamedValueEvidenceMissing
    FunctionValueExpectedFunctionType
    FunctionValueMissingName
    FunctionValueUnresolved
    FunctionValueAmbiguous
    FunctionValuePendingBinding
    FunctionValueMissingSignature
    FunctionValueHeadTokenOutOfBounds
    FunctionValueOutOfMemory
    FunctionValueGenericUnsupported
    FunctionValueTypeMismatch
    LiteralTokenOutOfBounds
    LiteralBoolInvalid
    LiteralI32Invalid
    LiteralI32RadixUnsupported
    LiteralF32Invalid
    LiteralStringMalformed
    LiteralStringEscapeUnsupported
    LiteralStringEscapeMalformed
    LiteralStringSliceFailed
    LiteralStringBuildFailed
    LiteralCharMalformed
    LiteralCharEscapeUnsupported
    LiteralCharInvalidScalar
    LiteralCharMultipleScalars
    NegativeLiteralMissingOperand
    NegativeLiteralOperandNotNumeric
    NegativeLiteralSpanJoinFailed
    NegativeLiteralTypeMismatch
    UnsupportedArgumentExpression
    InternalInvariant

impl Clone for SelfhostExprArgumentMatchErrorKind:
    fn clone %fn &SelfhostExprArgumentMatchErrorKind SelfhostExprArgumentMatchErrorKind \self:
        *self

impl Copy for SelfhostExprArgumentMatchErrorKind:
    fn copy_mark %fn SelfhostExprArgumentMatchErrorKind SelfhostExprArgumentMatchErrorKind \self:
        self

//: SelfhostExprArgumentMatchError: 実引数式走査の typed error payload
//:
//: [目的/もくてき]:
//: - reducer が unsupported expression と type mismatch を同じ string 診断へ潰さず、後続の diagnostic projection で別々に表示できるようにします。
//: - `span` は、失敗した argument expression の先頭 item を指します。missing / invariant の場合は caller が渡した fallback span を使います。
//:
//: [契約/けいやく]:
//: - `kind` は必ず `SelfhostExprArgumentMatchErrorKind` の variant で保持し、表示層へ渡す前に文字列化しません。
//: - `span` は error の観測位置を表します。source-backed helper では可能な限り実際の token/span を使い、fallback span は missing/invariant のような caller 不整合だけに使います。
pub struct SelfhostExprArgumentMatchError:
    kind %SelfhostExprArgumentMatchErrorKind
    span %SelfhostSourceSpan

impl Clone for SelfhostExprArgumentMatchError:
    fn clone %fn &SelfhostExprArgumentMatchError SelfhostExprArgumentMatchError \self:
        *self

impl Copy for SelfhostExprArgumentMatchError:
    fn copy_mark %fn SelfhostExprArgumentMatchError SelfhostExprArgumentMatchError \self:
        self

//: selfhost_expr_argument_match_new: 実引数式走査の成功 payload を[作/つく]る
pub fn selfhost_expr_argument_match_new %fn i32 SelfhostExprArgumentMatch \next_index:
    SelfhostExprArgumentMatch next_index

//: selfhost_expr_argument_match_error_new: 実引数式走査の error payload を[作/つく]る
pub fn selfhost_expr_argument_match_error_new %fn SelfhostExprArgumentMatchErrorKind fn SelfhostSourceSpan SelfhostExprArgumentMatchError \kind\span:
    SelfhostExprArgumentMatchError kind span

//: SelfhostExprArgumentOwnedMatch: arena owner を更新し得る実引数式走査の成功 payload
//:
//: [目的/もくてき]:
//: - `%T literal` は `T` を `SelfhostTypeArena` へ投影するため、argument checker は arena owner を受け取り、成功時に更新済み owner を返します。
//: - literal-only argument でも同じ payload を使い、source-backed call reducer が argument loop のたびに arena owner を明示的に受け渡せるようにします。
//:
//: [契約/けいやく]:
//: - `match_value.next_index` は次の prefix argument item index です。
//: - `checked_argument` は、この実引数式から得た typed evidence です。特に明示 `@ident` は、候補の DefId を後続 lowering へ渡すため `FunctionValue` payload を持ちます。
//: - 失敗時、この module は受け取った arena owner を解放してから error を返します。caller は失敗後に同じ arena を使いません。
//:
//: [計算量/けいさんりょう]:
//: - record の生成と field 読み出しは O(1) です。arena owner の解放コストは arena の内容に依存します。
pub struct SelfhostExprArgumentOwnedMatch:
    arena %SelfhostTypeArena
    match_value %SelfhostExprArgumentMatch
    checked_argument %SelfhostCheckedArgument

//: selfhost_expr_argument_owned_match_new: owner 付き argument match を[作/つく]る
//:
//: [目的/もくてき]:
//: - checked argument evidence、consume-width、更新済み type arena owner を 1 つの成功 payload にまとめます。
//:
//: [契約/けいやく]:
//: - `arena` の所有権は返り値へ移ります。caller は返り値から `into_arena` するか、上位の owner cleanup 経路へ渡します。
//: - `checked_argument` は同じ実引数式に対する evidence であり、`match_value.next_index` と矛盾しないことを caller が保証します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostExprArgumentOwnedMatch`: arena owner と checked payload を保持する成功 record です。
//:
//: [計算量/けいさんりょう]:
//: - record 構築だけなので O(1) です。
pub fn selfhost_expr_argument_owned_match_new %impure fn SelfhostTypeArena impure fn SelfhostExprArgumentMatch impure fn SelfhostCheckedArgument SelfhostExprArgumentOwnedMatch \arena\match_value\checked_argument:
    SelfhostExprArgumentOwnedMatch arena match_value checked_argument

//: selfhost_expr_argument_owned_match_match: consume-width payload を[返/かえ]す
//:
//: [目的/もくてき]:
//: - owner 付き match から、次に読む prefix item index を含む Copy payload を取り出します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostExprArgumentMatch`: 実引数式の consume-width を表す値です。
//:
//: [計算量/けいさんりょう]:
//: - field 読み出しだけなので O(1) です。
pub fn selfhost_expr_argument_owned_match_match %fn &SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatch \matched:
    *field::get_ref matched "match_value"

//: selfhost_expr_argument_owned_match_checked_argument: checked argument evidence を[返/かえ]す
//:
//: [目的/もくてき]:
//: - owner 付き match から、HIR lowering へ渡す checked argument evidence を読み出します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostCheckedArgument`: literal、named value、function value、nested call などの検査済み payload です。
//:
//: [計算量/けいさんりょう]:
//: - field 読み出しだけなので O(1) です。
pub fn selfhost_expr_argument_owned_match_checked_argument %fn &SelfhostExprArgumentOwnedMatch SelfhostCheckedArgument \matched:
    *field::get_ref matched "checked_argument"

//: selfhost_expr_argument_owned_match_into_arena: updated arena owner を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - owner 付き match を消費し、次の argument check や上位 reducer に渡す updated type arena owner を取り出します。
//:
//: [契約/けいやく]:
//: - `matched` は消費されます。この関数を呼んだ後に `checked_argument` や `match_value` を読むことはできません。
//: - caller は必要な Copy payload を先に読み出してから、この関数で arena owner を取り出します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostTypeArena`: argument checker が更新した arena owner です。
//:
//: [計算量/けいさんりょう]:
//: - owner field の取り出しだけなので O(1) です。
pub fn selfhost_expr_argument_owned_match_into_arena %impure fn SelfhostExprArgumentOwnedMatch SelfhostTypeArena \matched:
    field::get matched "arena"

//: SelfhostExprArgumentNamedValueEvidence: `NamedValue` argument の検査済み中間証拠
//:
//: [目的/もくてき]:
//: - source-backed argument checker 内で、name resolver 由来の value identity と value type evidence を一緒に運びます。
//: - public checked payload へ変換する前に、型比較で使う `value_type` と lowering で使う `identity` が同じ DefId 由来であることを保ちます。
//:
//: [契約/けいやく]:
//: - この型は check/expr 内部の一時 record であり、HIR record ではありません。
//: - `identity.def_id` と `value_type` は、同じ `SelfhostNameBinding` と `SelfhostValueTypeEvidence` から作られます。
//:
//: [計算量/けいさんりょう]:
//: - record の構築と copy は O(1) です。
struct SelfhostExprArgumentNamedValueEvidence:
    identity %SelfhostCheckedValueIdentity
    value_type %SelfhostTypeId

impl Clone for SelfhostExprArgumentNamedValueEvidence:
    fn clone %fn &SelfhostExprArgumentNamedValueEvidence SelfhostExprArgumentNamedValueEvidence \self:
        *self

impl Copy for SelfhostExprArgumentNamedValueEvidence:
    fn copy_mark %fn SelfhostExprArgumentNamedValueEvidence SelfhostExprArgumentNamedValueEvidence \self:
        self

//: selfhost_expr_argument_named_value_evidence_new: named value の内部証拠を[作/つく]る
//:
//: [目的/もくてき]:
//: - binding / evidence lookup の成功結果を、型比較と checked payload 生成の両方で使える record にまとめます。
//:
//: [契約/けいやく]:
//: - caller は `identity` と `value_type` が同じ DefId に対する証拠から作られていることを保証します。
fn selfhost_expr_argument_named_value_evidence_new %fn SelfhostCheckedValueIdentity fn SelfhostTypeId SelfhostExprArgumentNamedValueEvidence \identity\value_type:
    SelfhostExprArgumentNamedValueEvidence identity value_type

//: selfhost_expr_argument_item_literal_type_kind: literal item の直接型証拠を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `SelfhostExprPrefixItemKind` のうち、型検査なしで primitive type が一意に決まるものだけを `Some` にします。
//: - これにより、call reducer は `add 1 true` のような明白な引数型不一致を HIR 生成前に拒否できます。
//:
//: [戻/もど]り[値/ち]:
//: - `Some(kind)`: item 自体から primitive type kind が一意に得られます。
//: - `None`: full expression checker、numeric defaulting、name resolution、block typing などが必要です。
pub fn selfhost_expr_argument_item_literal_type_kind %fn SelfhostExprPrefixItem Option SelfhostTypeKind \item:
    match item.kind:
        SelfhostExprPrefixItemKind::UnitValue:
            some SelfhostTypeKind::Unit
        SelfhostExprPrefixItemKind::IntLiteral:
            some SelfhostTypeKind::I32
        SelfhostExprPrefixItemKind::FloatLiteral:
            some SelfhostTypeKind::F32
        SelfhostExprPrefixItemKind::BoolLiteral:
            some SelfhostTypeKind::Bool
        SelfhostExprPrefixItemKind::CharLiteral:
            some SelfhostTypeKind::Char
        SelfhostExprPrefixItemKind::StringLiteral:
            some SelfhostTypeKind::Str
        _:
            none

//: selfhost_expr_argument_item_matches_type: 実引数 item が expected type と一致するか[返/かえ]す
//:
//: [目的/もくてき]:
//: - literal item から得た型証拠と、function type に保存された parameter type kind を照合します。
//: - どちらかの証拠が不足している場合は `false` を返し、未対応式を安全側で拒否します。
//:
//: [注意/ちゅうい]:
//: - この関数は構造的な式全体の型検査ではありません。現段階では prefix item 1 個で表せる literal argument のみを扱います。
//: - `NamedValue` は source / token backed API が scope と DefId-linked value evidence を使って扱います。この borrowed helper では source spelling を読めないため成功扱いしません。
//: - nested call の result type や block / lambda / borrow / pipe は、後続の expression checker slice で別の evidence source として追加します。
pub fn selfhost_expr_argument_item_matches_type %fn &SelfhostTypeArena fn SelfhostExprPrefixItem fn SelfhostTypeId bool \arena\item\expected_type:
    match selfhost_expr_argument_item_literal_type_kind item:
        Option::Some actual_kind:
            match selfhost_type_arena_get_kind arena expected_type:
                Option::Some expected_kind:
                    selfhost_type_kind_eq actual_kind expected_kind
                Option::None:
                    false
        Option::None:
            false

//: selfhost_expr_argument_checked_simple_item: 1 item argument の checked payload を[作/つく]る
//:
//: [目的/もくてき]:
//: - checker が `unit` literal であることを確定した場合は `UnitValue` payload として保存します。
//: - HIR lowering はこの payload を使い、source token や lexeme を再読せずに unit expression を構築できます。
//:
//: [現状/げんじょう]:
//: - 数値、bool、char、string literal の意味値 payload は source-backed `literal_payload.nepl` が作ります。この helper は source-less なので `unit` 以外を値 payload 化しません。
//: - `TypedExpression` は source-less fallback です。source-backed 経路では char literal は `CharLiteral` payload に分解済みなので、この helper の fallback 説明を source-backed 契約へ広げてはいけません。
//: - named value は source-backed branch が scope と value evidence から `NamedValue` payload を作ります。この helper は source spelling を読めないため扱いません。
fn selfhost_expr_argument_checked_simple_item %fn SelfhostExprPrefixItem fn i32 fn i32 fn SelfhostTypeId SelfhostCheckedArgument \item\start_index\next_index\value_type:
    match item.kind:
        SelfhostExprPrefixItemKind::UnitValue:
            selfhost_checked_argument_unit_value start_index next_index value_type item.span
        _:
            selfhost_checked_argument_typed_expression start_index next_index value_type item.span

//: selfhost_expr_argument_match_error_from_literal: literal payload error を argument match error へ[写像/しゃぞう]する
//:
//: [目的/もくてき]:
//: - source-backed literal decode の失敗を、argument checker の error domain へ移します。
//: - call reducer は argument match error だけを受け取るため、ここで literal 固有の原因を失わない enum variant に変換します。
//:
//: [契約/けいやく]:
//: - すべての `SelfhostLiteralArgumentErrorKind` は対応する `SelfhostExprArgumentMatchErrorKind::Literal*` に 1 対 1 で写像します。
//: - この関数は表示文を生成しません。診断表示は call reduction error 以降の report 層が担当します。
//:
//: [戻/もど]り[値/ち]:
//: - 返り値の `span` は元の literal error の span と同一です。呼び出し側の head span へ丸めません。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_expr_argument_match_error_from_literal %fn SelfhostLiteralArgumentError SelfhostExprArgumentMatchError \error:
    match error.kind:
        SelfhostLiteralArgumentErrorKind::TokenOutOfBounds:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralTokenOutOfBounds error.span
        SelfhostLiteralArgumentErrorKind::BoolInvalid:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralBoolInvalid error.span
        SelfhostLiteralArgumentErrorKind::I32Invalid:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralI32Invalid error.span
        SelfhostLiteralArgumentErrorKind::I32RadixUnsupported:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralI32RadixUnsupported error.span
        SelfhostLiteralArgumentErrorKind::F32Invalid:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralF32Invalid error.span
        SelfhostLiteralArgumentErrorKind::StringMalformed:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralStringMalformed error.span
        SelfhostLiteralArgumentErrorKind::StringEscapeUnsupported:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralStringEscapeUnsupported error.span
        SelfhostLiteralArgumentErrorKind::StringEscapeMalformed:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralStringEscapeMalformed error.span
        SelfhostLiteralArgumentErrorKind::StringSliceFailed:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralStringSliceFailed error.span
        SelfhostLiteralArgumentErrorKind::StringBuildFailed:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralStringBuildFailed error.span
        SelfhostLiteralArgumentErrorKind::CharMalformed:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralCharMalformed error.span
        SelfhostLiteralArgumentErrorKind::CharEscapeUnsupported:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralCharEscapeUnsupported error.span
        SelfhostLiteralArgumentErrorKind::CharInvalidScalar:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralCharInvalidScalar error.span
        SelfhostLiteralArgumentErrorKind::CharMultipleScalars:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::LiteralCharMultipleScalars error.span

//: selfhost_expr_argument_match_literal_with_source: source-backed literal payload を持つ argument match を[作/つく]る
//:
//: [目的/もくてき]:
//: - 型一致が確認済みの literal item から checked payload を構築し、consume-width と arena owner を一緒に返します。
//: - literal の意味値解析は `literal_payload.nepl` に閉じ、HIR lowering が source/token を再読しない形を保ちます。
//:
//: [契約/けいやく]:
//: - 失敗時には `arena` を解放してから `SelfhostExprArgumentMatchError` を返します。
//: - `FloatLiteral` は `literal_payload.nepl` で semantic `f32` payload に変換され、direct-call HIR lowering 側では `F32Literal` HIR payload へ変換されます。
//: - `CharLiteral` は `literal_payload.nepl` で semantic `char` payload に変換され、direct-call HIR lowering 側では Rust 実装と同じ i32-backed char literal へ変換されます。
//: - この関数は HIR 型や HIR record を扱いません。source-backed literal decode の結果は `SelfhostCheckedArgument` だけに閉じます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: expected type と一致した literal payload、consume-width、更新済み arena owner を返します。
//: - `Err(error)`: literal token 参照または意味値解析に失敗しました。arena owner はこの関数内で解放済みです。
//:
//: [計算量/けいさんりょう]:
//: - token 取得と payload record 構築は O(1)、literal lexeme 解析は token spelling 長 n に対して O(n) です。
fn selfhost_expr_argument_match_literal_with_source %impure fn SelfhostTypeArena impure fn &Vec SelfhostToken impure fn str impure fn SelfhostExprPrefixItem impure fn i32 impure fn i32 impure fn SelfhostTypeId Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \arena\tokens\source\item\item_index\next_index\expected_type:
    let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new next_index
    match selfhost_literal_argument_checked_with_source tokens source item item_index next_index expected_type:
        Result::Ok checked_argument:
            Result::Ok selfhost_expr_argument_owned_match_new arena match_value checked_argument
        Result::Err literal_error:
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_from_literal literal_error

//: selfhost_expr_argument_negative_numeric_kind: 負号の operand として受理できる数値 item kind を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `MinusMarker` の直後にある prefix item が、Rust parser と同じく負数 literal として結合できる numeric literal かどうかを判定します。
//: - `IntLiteral` と `FloatLiteral` だけを受理し、`true`、`unit`、名前、別の `MinusMarker` などは typed error にします。
//:
//: [戻/もど]り[値/ち]:
//: - `Some(kind)`: operand は負号付き literal の本体として扱える numeric item です。
//: - `None`: operand は負号付き numeric literal ではありません。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_expr_argument_negative_numeric_kind %fn SelfhostExprPrefixItem Option SelfhostExprPrefixItemKind \item:
    match item.kind:
        SelfhostExprPrefixItemKind::IntLiteral:
            some SelfhostExprPrefixItemKind::IntLiteral
        SelfhostExprPrefixItemKind::FloatLiteral:
            some SelfhostExprPrefixItemKind::FloatLiteral
        _:
            none

//: selfhost_expr_argument_match_negative_literal_with_source: `-` と数値 literal を 1 argument として[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - prefix list 上では `MinusMarker` と数値 literal item を分けたまま保持し、この source-backed 境界でだけ 2 item を 1 個の負数 numeric argument として消費します。
//: - expected type と照合してから semantic payload を作ることで、`-1` / `- 1` を `i32`、`-1.5` / `- 1.5` を `f32` として扱い、HIR lowering が source を再読しない設計を保ちます。
//:
//: [契約/けいやく]:
//: - `minus_item.kind` は `MinusMarker` でなければなりません。caller は item kind の分岐でこの関数を呼びます。
//: - 直後 item が存在しない場合は `NegativeLiteralMissingOperand`、numeric literal でない場合は `NegativeLiteralOperandNotNumeric` を返します。
//: - span 結合に失敗した場合は source 範囲の不整合として `NegativeLiteralSpanJoinFailed` を返します。
//: - operand の numeric kind と expected type が一致しない場合は `NegativeLiteralTypeMismatch` を返し、通常 literal の decode 失敗とは区別します。
//: - 成功時は合成 literal item の `span` を診断範囲に使い、semantic lexeme は `-` と operand token spelling だけを連結して作ります。token 間 whitespace は数値 parser へ渡しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: `item_index` と `item_index + 1` の 2 item を消費した checked argument です。
//: - `Err(error)`: operand 欠落、非 numeric operand、span 結合失敗、型不一致、literal decode 失敗のいずれかです。
//:
//: [計算量/けいさんりょう]:
//: - follower lookup と type-kind check は O(1)、literal decode は spelling 長 n に対して O(n) です。
fn selfhost_expr_argument_match_negative_literal_with_source %impure fn SelfhostTypeArena impure fn &Vec SelfhostToken impure fn str impure fn &SelfhostExprPrefixList impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \arena\tokens\source\prefix\item_index\item_count\expected_type\minus_item:
    let operand_index %i32 add item_index 1
    if:
        ge operand_index item_count
        then:
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NegativeLiteralMissingOperand minus_item.span
        else:
            match selfhost_expr_prefix_list_get prefix operand_index:
                Option::Some operand_item:
                    match selfhost_expr_argument_negative_numeric_kind operand_item:
                        Option::Some literal_kind:
                            match source_span_join_result minus_item.span operand_item.span:
                                Result::Ok joined_span:
                                    let signed_item %SelfhostExprPrefixItem selfhost_expr_prefix_item_new literal_kind minus_item.token_index joined_span
                                    if:
                                        selfhost_expr_argument_item_matches_type &arena signed_item expected_type
                                        then:
                                            let next_index %i32 add operand_index 1
                                            let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new next_index
                                            match selfhost_literal_argument_negative_checked_with_source tokens source minus_item operand_item signed_item item_index next_index expected_type:
                                                Result::Ok checked_argument:
                                                    Result::Ok selfhost_expr_argument_owned_match_new arena match_value checked_argument
                                                Result::Err literal_error:
                                                    selfhost_type_arena_free arena
                                                    Result::Err selfhost_expr_argument_match_error_from_literal literal_error
                                        else:
                                            selfhost_type_arena_free arena
                                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NegativeLiteralTypeMismatch joined_span
                                Result::Err _e:
                                    selfhost_type_arena_free arena
                                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NegativeLiteralSpanJoinFailed minus_item.span
                        Option::None:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NegativeLiteralOperandNotNumeric operand_item.span
                Option::None:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant minus_item.span

//: selfhost_expr_argument_named_value_kind_supported: argument value として扱える binding kind かを[返/かえ]す
//:
//: [目的/もくてき]:
//: - name scope には型名、trait、impl など「名前として解決できるが値ではない」binding も入ります。
//: - argument position の `NamedValue` は値を要求するため、値として扱える分類だけを source-backed argument checker に渡します。
//:
//: [契約/けいやく]:
//: - 最新 binding が unsupported kind の場合、古い同名値へ戻りません。shadowing の結果として現在見えている名前が値ではないなら、`NamedValueUnsupportedBinding` として fail-closed にします。
fn selfhost_expr_argument_named_value_kind_supported %fn SelfhostDefKind bool \kind:
    match kind:
        SelfhostDefKind::Function:
            true
        SelfhostDefKind::Local:
            true
        SelfhostDefKind::Param:
            true
        SelfhostDefKind::Builtin:
            true
        _:
            false

//: selfhost_expr_argument_named_value_evidence_from_binding: binding の DefId から値参照証拠を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `NamedValue` の型を名前の spelling から推測せず、name resolver が割り当てた `SelfhostDefId` と value evidence table の対応で取得します。
//: - binding はあるが DefId 生成や型登録が未完了の段階を、通常の型不一致とは別 error として保持します。
//: - 成功時には後続 lowering 用に `SelfhostCheckedValueIdentity` も同時に構築します。これにより HIR lowering は source token と scope を再読しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(evidence)`: checked value identity と、caller が同じ `SelfhostTypeArena` 内で parameter type と構造比較できる型証拠です。
//: - `Err(NamedValueUnsupportedBinding)`: 現在見えている binding が値として使えません。
//: - `Err(NamedValuePendingBinding)`: binding にはまだ DefId が割り当てられていません。
//: - `Err(NamedValueEvidenceMissing)`: DefId はありますが、式検査用の value type evidence が未登録です。
fn selfhost_expr_argument_named_value_evidence_from_binding %fn &SelfhostValueTypeEvidenceTable fn SelfhostNameBinding Result SelfhostExprArgumentNamedValueEvidence SelfhostExprArgumentMatchError \value_types\binding:
    if:
        not selfhost_expr_argument_named_value_kind_supported binding.kind
        then:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NamedValueUnsupportedBinding binding.span
        else:
            match binding.def_id:
                Option::Some def_id:
                    match selfhost_value_type_evidence_table_find value_types def_id:
                        Option::Some evidence:
                            let identity %SelfhostCheckedValueIdentity selfhost_checked_value_identity_new binding.name def_id binding.kind
                            Result::Ok selfhost_expr_argument_named_value_evidence_new identity evidence.value_type
                        Option::None:
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NamedValueEvidenceMissing binding.span
                Option::None:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NamedValuePendingBinding binding.span

//: selfhost_expr_argument_named_value_evidence: prefix item の名前から value identity と type evidence を[解決/かいけつ]する
//:
//: [目的/もくてき]:
//: - token index と source text から現在の `NamedValue` spelling を復元し、scope の最新 binding を調べます。
//: - 成功条件は `name -> binding -> DefId -> value type evidence` がすべて揃うことです。binding だけ、または spelling だけでは成功させません。
//: - scope lookup の結果から `SelfhostCheckedValueIdentity` を構築し、後続 lowering が同じ DefId-linked 値を参照できるようにします。
//:
//: [契約/けいやく]:
//: - token index が壊れている場合は checker 内部の不変条件破れなので `InternalInvariant` を返します。
//: - unresolved name は `NamedValueUnresolved` とし、型不一致や unsupported expression へ潰しません。
fn selfhost_expr_argument_named_value_evidence %fn &Vec SelfhostToken fn str fn &SelfhostNameScope fn &SelfhostValueTypeEvidenceTable fn SelfhostExprPrefixItem Result SelfhostExprArgumentNamedValueEvidence SelfhostExprArgumentMatchError \tokens\source\scope\value_types\item:
    match v::get tokens item.token_index:
        Option::Some token:
            let name %str selfhost_token_lexeme source token
            match selfhost_name_scope_find scope name:
                Option::Some binding:
                    selfhost_expr_argument_named_value_evidence_from_binding value_types binding
                Option::None:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::NamedValueUnresolved item.span
        Option::None:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant item.span

//: selfhost_expr_argument_match_named_value_with_source: source-backed `NamedValue` argument を parameter type と[照合/しょうごう]する
//:
//: [目的/もくてき]:
//: - `NamedValue` argument の実際の型を DefId-linked evidence から取り出し、function parameter の expected type と同じ arena 内で構造比較します。
//: - 型が一致した場合は `NamedValue` checked payload を返し、後続 HIR lowering が scope lookup を再実行せずに `Var` expression を構築できるようにします。
//: - 型が一致した場合は 1 prefix item を消費した cursor を返します。型が一致しない場合は arena owner を閉じて typed error を返します。
//:
//: [契約/けいやく]:
//: - 失敗時にはこの関数が `arena` を解放します。caller は error 後に同じ owner を再利用しません。
//: - 成功時には arena owner をそのまま `SelfhostExprArgumentOwnedMatch` に入れて返します。
fn selfhost_expr_argument_match_named_value_with_source %impure fn SelfhostTypeArena impure fn &Vec SelfhostToken impure fn str impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn SelfhostExprPrefixItem impure fn i32 impure fn SelfhostTypeId Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \arena\tokens\source\scope\value_types\item\item_index\expected_type:
    match selfhost_expr_argument_named_value_evidence tokens source scope value_types item:
        Result::Ok named:
            if:
                selfhost_type_arena_types_equal &arena named.value_type expected_type
                then:
                    let next_index %i32 add item_index 1
                    let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new next_index
                    let checked_argument %SelfhostCheckedArgument selfhost_checked_argument_named_value item_index next_index named.value_type item.span named.identity
                    Result::Ok selfhost_expr_argument_owned_match_new arena match_value checked_argument
                else:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::TypeMismatch item.span
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_expr_argument_expected_type_is_function: expected type が function value 型かを[返/かえ]す
//:
//: [目的/もくてき]:
//: - 明示 `@ident` argument は、parameter が function type を期待している場合だけ検査対象にします。
//: - expected type が見つからない場合は成功扱いせず、`false` へ倒して caller が typed error を返します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `expected_type` の kind が `Function` です。
//: - `false`: arena lookup に失敗した、または function kind ではありません。
//:
//: [計算量/けいさんりょう]:
//: - arena kind lookup 1 回なので O(1) です。
fn selfhost_expr_argument_expected_type_is_function %fn &SelfhostTypeArena fn SelfhostTypeId bool \arena\expected_type:
    match selfhost_type_arena_get_kind arena expected_type:
        Option::Some kind:
            selfhost_type_kind_eq kind SelfhostTypeKind::Function
        Option::None:
            false

//: selfhost_expr_argument_function_value_error_from_candidate_collect: callable candidate 収集 error を argument error へ[写像/しゃぞう]する
//:
//: [目的/もくてき]:
//: - `@ident` argument の候補収集失敗を、argument checker の error domain へ移します。
//: - pending binding、signature 欠落、head token 範囲外、OOM を 1 つの unsupported error へ潰さず保持します。
//:
//: [戻/もど]り[値/ち]:
//: - 対応する `SelfhostExprArgumentMatchErrorKind::FunctionValue*` を持つ error です。
//: - 未分類の候補収集 error は `InternalInvariant` として扱い、成功扱いしません。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_expr_argument_function_value_error_from_candidate_collect %fn SelfhostCallableCandidateCollectError SelfhostExprArgumentMatchError \error:
    match error.kind:
        SelfhostCallableCandidateCollectErrorKind::PendingBinding:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValuePendingBinding error.span
        SelfhostCallableCandidateCollectErrorKind::MissingSignature:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueMissingSignature error.span
        SelfhostCallableCandidateCollectErrorKind::HeadTokenOutOfBounds:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueHeadTokenOutOfBounds error.span
        SelfhostCallableCandidateCollectErrorKind::OutOfMemory:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueOutOfMemory error.span
        _:
            selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant error.span

//: selfhost_expr_argument_function_value_candidate_is_monomorphic: function value candidate が単相化済みかを[返/かえ]す
//:
//: [目的/もくてき]:
//: - `@ident` は function value そのものを渡す構文であり、この slice では generic function value の型引数推論を成功扱いしません。
//: - generic state を明示的に見て、未解決 generic を `FunctionValueGenericUnsupported` へ落とします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: candidate が追加の generic inference を必要としません。
//: - `false`: generic inference state が残っており、この argument checker では fail-closed です。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
fn selfhost_expr_argument_function_value_candidate_is_monomorphic %fn SelfhostCallableCandidate bool \candidate:
    match candidate.generic_state:
        SelfhostGenericInferenceState::NoneRequired:
            true
        _:
            false

//: selfhost_expr_argument_match_function_value_candidate: 1 つの `@ident` candidate を expected function type と[照合/しょうごう]する
//:
//: [目的/もくてき]:
//: - 候補が単相化済みで、candidate callable type が expected parameter type と一致する場合だけ function value argument として受理します。
//: - 成功時は callable candidate を checked payload に保存し、HIR lowering が scope lookup や overload 解決を再実行しないようにします。
//:
//: [契約/けいやく]:
//: - 失敗時はこの関数が `arena` owner を解放します。
//: - generic candidate、型不一致 candidate はいずれも typed error へ変換し、別候補の推測や部分適用として扱いません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: `@ident` の 2 item を消費した function value checked payload です。
//: - `Err(FunctionValueGenericUnsupported)`: generic state が残っています。
//: - `Err(FunctionValueTypeMismatch)`: candidate callable type と expected type が一致しません。
//:
//: [計算量/けいさんりょう]:
//: - generic state check と arena type equality だけなので、型比較の実コストは対象型 tree の大きさに依存します。
fn selfhost_expr_argument_match_function_value_candidate %impure fn SelfhostTypeArena impure fn SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostSourceSpan Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \arena\candidate\start_index\next_index\expected_type\span:
    if:
        not selfhost_expr_argument_function_value_candidate_is_monomorphic candidate
        then:
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueGenericUnsupported span
        else:
            if:
                selfhost_type_arena_types_equal &arena candidate.callable_type expected_type
                then:
                    let match_value %SelfhostExprArgumentMatch selfhost_expr_argument_match_new next_index
                    let checked_argument %SelfhostCheckedArgument selfhost_checked_argument_function_value start_index next_index candidate.callable_type span candidate
                    Result::Ok selfhost_expr_argument_owned_match_new arena match_value checked_argument
                else:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueTypeMismatch span

//: selfhost_expr_argument_match_function_value_candidates: `@ident` の候補集合を 1 候補へ[絞/しぼ]る
//:
//: [目的/もくてき]:
//: - callable candidate collection の結果を、function value argument として使える 1 候補へ縮約します。
//: - 候補なしや複数候補は、暗黙に推測せず typed error として返します。
//:
//: [契約/けいやく]:
//: - `candidates` owner はこの関数内で必ず解放します。
//: - 成功時でも candidate は Copy payload として取り出し、候補 Vec owner は残しません。
//: - 失敗時は `arena` owner も解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: 1 候補だけがあり、expected type と一致した function value argument です。
//: - `Err(FunctionValueUnresolved)`: 候補が 0 件です。
//: - `Err(FunctionValueAmbiguous)`: 候補が複数件です。
//: - `Err(InternalInvariant)`: count と `get` の結果が矛盾しています。
//:
//: [計算量/けいさんりょう]:
//: - candidate count 取得と先頭取得は O(1) です。型一致の実コストは `selfhost_expr_argument_match_function_value_candidate` に従います。
fn selfhost_expr_argument_match_function_value_candidates %impure fn SelfhostTypeArena impure fn Vec SelfhostCallableCandidate impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostSourceSpan Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \arena\candidates\start_index\next_index\expected_type\span:
    let candidate_count %i32 v::len &candidates
    if:
        eq candidate_count 0
        then:
            v::free candidates
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueUnresolved span
        else:
            if:
                gt candidate_count 1
                then:
                    v::free candidates
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueAmbiguous span
                else:
                    match v::get &candidates 0:
                        Option::Some candidate:
                            v::free candidates
                            selfhost_expr_argument_match_function_value_candidate arena candidate start_index next_index expected_type span
                        Option::None:
                            v::free candidates
                            selfhost_type_arena_free arena
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant span

//: selfhost_expr_argument_match_function_value_with_source: source-backed に `@ident` argument を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `@` item の次にある `NamedValue` を function namespace の candidate として集め、expected function type と照合します。
//: - source/token/scope/signature table を権威にして candidate を作り、文字列名だけの後続再解決を避けます。
//:
//: [契約/けいやく]:
//: - expected type が function でない場合は `FunctionValueExpectedFunctionType` を返し、`@ident` を通常値として扱い直しません。
//: - `@` の後ろに name item がない、または name でない場合は `FunctionValueMissingName` です。
//: - 候補収集や候補照合で失敗した場合、この関数または下位 helper が `arena` owner を解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: `@ident` 2 item を消費し、callable candidate evidence を含む checked payload です。
//: - `Err(error)`: expected type、name token、candidate collection、generic/overload/type mismatch のいずれかの typed error です。
//:
//: [計算量/けいさんりょう]:
//: - name item 取得は O(1) です。candidate collection の実コストは scope/signature table lookup に依存します。
fn selfhost_expr_argument_match_function_value_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn i32 impure fn SelfhostTypeId impure fn SelfhostExprPrefixItem Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \tokens\source\arena\prefix\scope\signatures\item_index\item_count\expected_type\at_item:
    if:
        not selfhost_expr_argument_expected_type_is_function &arena expected_type
        then:
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueExpectedFunctionType at_item.span
        else:
            let name_index %i32 add item_index 1
            if:
                ge name_index item_count
                then:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueMissingName at_item.span
                else:
                    match selfhost_expr_prefix_list_get prefix name_index:
                        Option::Some name_item:
                            match name_item.kind:
                                SelfhostExprPrefixItemKind::NamedValue:
                                    match selfhost_callable_candidates_collect_for_head_item source tokens name_item scope signatures:
                                        Result::Ok candidates:
                                            selfhost_expr_argument_match_function_value_candidates arena candidates item_index add name_index 1 expected_type name_item.span
                                        Result::Err collect_error:
                                            selfhost_type_arena_free arena
                                            Result::Err selfhost_expr_argument_function_value_error_from_candidate_collect collect_error
                                _:
                                    selfhost_type_arena_free arena
                                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::FunctionValueMissingName name_item.span
                        Option::None:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant at_item.span

//: selfhost_expr_argument_match_at: prefix list の cursor 位置から 1 つの実引数式を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - call reducer が `item_count - 1` を raw argument count とみなす旧方式から離れ、実引数式ごとに消費幅を得られるようにします。
//: - この checkpoint では、単一 literal item だけを成功させます。`%T literal` は 1 個の argument expression ですが、source text と token buffer がない状態では `%T` と expected parameter type の一致を検査できないため、必ず typed error にします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: `item_index` から始まる 1 argument expression が expected type と一致し、`match.next_index` から次の実引数を読めます。
//: - `Err(TypeMismatch)`: literal 型証拠は得られましたが、parameter type と一致しませんでした。
//: - `Err(UnsupportedAscribedArgument)`: `%T expr` の argument-scope checker が必要です。この失敗は raw item 数による overload 失敗へ潰してはいけません。
//: - `Err(UnsupportedArgumentExpression)`: name / nested call / control form など、単一 literal item ではない式です。
pub fn selfhost_expr_argument_match_at %fn &SelfhostTypeArena fn &SelfhostExprPrefixList fn i32 fn i32 fn SelfhostTypeId Result SelfhostExprArgumentMatch SelfhostExprArgumentMatchError \arena\prefix\item_index\item_count\expected_type:
    if:
        ge item_index item_count
        then:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::MissingArgument source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix item_index:
                Option::Some item:
                    match item.kind:
                        SelfhostExprPrefixItemKind::TypeAnnotationMarker:
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedAscribedArgument item.span
                        SelfhostExprPrefixItemKind::MinusMarker:
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression item.span
                        _:
                            if:
                                selfhost_expr_argument_item_matches_type arena item expected_type
                                then:
                                    Result::Ok selfhost_expr_argument_match_new add item_index 1
                                else:
                                    match selfhost_expr_argument_item_literal_type_kind item:
                                        Option::Some _actual_kind:
                                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::TypeMismatch item.span
                                        Option::None:
                                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression item.span
                Option::None:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_expr_argument_range_from_prefix: prefix item 範囲を source token range へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - argument-scope `%T expr` の型式境界を解くため、prefix item index の範囲から source token range を作ります。
//: - source token range を ascription projector に渡すことで、type prefix reducer が token spelling と constructor arity を権威として使えます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(range)`: `item_index` から `item_count - 1` までを覆う token range です。
//: - `Err(InternalInvariant)`: prefix item が存在しない、または末尾 item が取れない状態です。
//:
//: [計算量/けいさんりょう]:
//: - 先頭と末尾 item を読むだけなので O(1) です。
fn selfhost_expr_argument_range_from_prefix %fn &SelfhostExprPrefixList fn i32 fn i32 Result SelfhostSyntaxRange SelfhostExprArgumentMatchError \prefix\item_index\item_count:
    match selfhost_expr_prefix_list_get prefix item_index:
        Option::Some first_item:
            match selfhost_expr_prefix_list_get prefix sub item_count 1:
                Option::Some last_item:
                    let token_count %i32 add sub last_item.token_index first_item.token_index 1
                    let span %SelfhostSourceSpan source_span_new_unchecked first_item.span.file_id first_item.span.start last_item.span.end
                    Result::Ok selfhost_syntax_range_new_unchecked first_item.token_index token_count span
                Option::None:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant first_item.span
        Option::None:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant source_span_empty_unchecked 0 0

//: selfhost_expr_argument_find_prefix_item_by_token_loop: token index に対応する prefix item を[探/さが]す
//:
//: [目的/もくてき]:
//: - ascription projector が返す source token index を、argument checker が消費する prefix item index へ戻します。
//: - source token index と prefix item index を混同しないため、この変換境界を明示します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(index)`: `token_index` を持つ prefix item の index です。
//: - `Err(UnsupportedArgumentExpression)`: 対応する prefix item が見つかりません。
//: - `Err(InternalInvariant)`: 走査中に prefix item lookup が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - `idx` から `item_count` まで線形に見るため O(n) です。
fn selfhost_expr_argument_find_prefix_item_by_token_loop %fn &SelfhostExprPrefixList fn i32 fn i32 fn i32 fn SelfhostSourceSpan Result i32 SelfhostExprArgumentMatchError \prefix\idx\item_count\token_index\fallback_span:
    if:
        ge idx item_count
        then:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression fallback_span
        else:
            match selfhost_expr_prefix_list_get prefix idx:
                Option::Some item:
                    if:
                        eq item.token_index token_index
                        then:
                            Result::Ok idx
                        else:
                            selfhost_expr_argument_find_prefix_item_by_token_loop prefix add idx 1 item_count token_index fallback_span
                Option::None:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant fallback_span

//: selfhost_expr_argument_find_prefix_item_by_token: token index に対応する prefix item index を[返/かえ]す
//:
//: [目的/もくてき]:
//: - argument-scope ascription の `expression_first_token` を、実際に検査する prefix item index へ変換します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(index)`: `start_idx` 以降で対応 token を持つ prefix item index です。
//: - `Err(error)`: 対応 item 欠落または prefix list 不整合です。
//:
//: [計算量/けいさんりょう]:
//: - 残り prefix item 数を n として O(n) です。
fn selfhost_expr_argument_find_prefix_item_by_token %fn &SelfhostExprPrefixList fn i32 fn i32 fn i32 fn SelfhostSourceSpan Result i32 SelfhostExprArgumentMatchError \prefix\start_idx\item_count\token_index\fallback_span:
    selfhost_expr_argument_find_prefix_item_by_token_loop prefix start_idx item_count token_index fallback_span

//: selfhost_expr_argument_validate_ascription_expected: `%T` と parameter expected type の一致を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - 明示 ascription が outer parameter type と矛盾していないことを確認します。
//: - 矛盾を overload failure や arity failure へ丸めず、`AscriptionExpectedTypeConflict` として保持します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(unit)`: ascription type と expected type が同じ arena 内で一致します。
//: - `Err(AscriptionExpectedTypeConflict)`: 明示注釈と parameter type が一致しません。
//:
//: [計算量/けいさんりょう]:
//: - 型比較の実コストは比較対象の型 tree の大きさに依存します。
fn selfhost_expr_argument_validate_ascription_expected %fn &SelfhostTypeArena fn SelfhostTypeExpectation fn SelfhostTypeId Result unit SelfhostExprArgumentMatchError \arena\ascription_expectation\expected_type:
    if:
        selfhost_type_arena_types_equal arena ascription_expectation.expected_type expected_type
        then:
            Result::Ok unit
        else:
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::AscriptionExpectedTypeConflict ascription_expectation.span

//: selfhost_expr_argument_span_from_ascription_error: ascription error の代表 span を[返/かえ]す
//:
//: [目的/もくてき]:
//: - ascription projector の typed error を argument match error に包むとき、元原因の span を失わないようにします。
//:
//: [戻/もど]り[値/ち]:
//: - range error や missing tail は保持している `SelfhostSourceSpan` を返します。
//: - build/reduce/project error は、それぞれ sub-error の span を返します。
//:
//: [計算量/けいさんりょう]:
//: - enum match と field 読み出しだけなので O(1) です。
fn selfhost_expr_argument_span_from_ascription_error %fn SelfhostExprAscriptionError SelfhostSourceSpan \error:
    match error:
        SelfhostExprAscriptionError::EmptyExpressionRange span:
            span
        SelfhostExprAscriptionError::InvalidExpressionRange span:
            span
        SelfhostExprAscriptionError::NotTypeAscription span:
            span
        SelfhostExprAscriptionError::TypePrefixBuildFailed e:
            e.span
        SelfhostExprAscriptionError::TypeReduceFailed e:
            e.span
        SelfhostExprAscriptionError::TypeProjectFailed e:
            e.span
        SelfhostExprAscriptionError::MissingExpressionTail span:
            span

//: selfhost_expr_argument_match_ascribed_with_projection: `%T` 投影後の 1 argument expression を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - head projection が示す expected type と expression token index を使い、`%T expr` の `expr` だけを 1 実引数式として検査します。
//: - literal、NamedValue、`@ident` を同じ source-backed evidence 境界へ接続します。
//:
//: [契約/けいやく]:
//: - projection はこの関数が消費し、arena owner を取り出します。
//: - `%T` と outer expected type が不一致なら、inner expression を読まずに arena を解放して typed error を返します。
//: - 失敗時にはこの関数または下位 helper が arena owner を解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: ascription と inner expression の両方が expected type に一致した checked argument です。
//: - `Err(error)`: ascription conflict、対応 prefix item 欠落、literal/name/function value の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - token index から prefix item を探す部分は O(n)、inner expression の検査は扱う payload に依存します。
fn selfhost_expr_argument_match_ascribed_with_projection %impure fn &Vec SelfhostToken impure fn str impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn SelfhostExprAscriptionHeadProjection impure fn &SelfhostExprPrefixList impure fn i32 impure fn i32 impure fn SelfhostTypeId Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \tokens\source\scope\value_types\signatures\projection\prefix\item_index\item_count\expected_type:
    let expectation %SelfhostTypeExpectation selfhost_expr_ascription_head_projection_expectation &projection
    let expression_token %i32 selfhost_expr_ascription_head_projection_expression_first_token &projection
    let arena %SelfhostTypeArena selfhost_expr_ascription_head_projection_into_arena projection
    match selfhost_expr_argument_validate_ascription_expected &arena expectation expected_type:
        Result::Ok _unit:
            match selfhost_expr_argument_find_prefix_item_by_token prefix add item_index 1 item_count expression_token expectation.span:
                Result::Ok expression_item_index:
                    match selfhost_expr_prefix_list_get prefix expression_item_index:
                        Option::Some expression_item:
                            match expression_item.kind:
                                SelfhostExprPrefixItemKind::NamedValue:
                                    selfhost_expr_argument_match_named_value_with_source arena tokens source scope value_types expression_item expression_item_index expectation.expected_type
                                SelfhostExprPrefixItemKind::AtMarker:
                                    selfhost_expr_argument_match_function_value_with_source tokens source arena prefix scope signatures expression_item_index item_count expectation.expected_type expression_item
                                SelfhostExprPrefixItemKind::MinusMarker:
                                    selfhost_expr_argument_match_negative_literal_with_source arena tokens source prefix expression_item_index item_count expectation.expected_type expression_item
                                _:
                                    if:
                                        selfhost_expr_argument_item_matches_type &arena expression_item expectation.expected_type
                                        then:
                                            let next_index %i32 add expression_item_index 1
                                            selfhost_expr_argument_match_literal_with_source arena tokens source expression_item expression_item_index next_index expectation.expected_type
                                        else:
                                            selfhost_type_arena_free arena
                                            match selfhost_expr_argument_item_literal_type_kind expression_item:
                                                Option::Some _actual_kind:
                                                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::TypeMismatch expression_item.span
                                                Option::None:
                                                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression expression_item.span
                        Option::None:
                            selfhost_type_arena_free arena
                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant expectation.span
                Result::Err e:
                    selfhost_type_arena_free arena
                    Result::Err e
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_expr_argument_match_ascribed_at_with_source: `%T expr` argument の source-backed 入口
//:
//: [目的/もくてき]:
//: - prefix list 上の `%` item から source token range を作り、ascription projector で head projection へ変換します。
//: - projection 後は `selfhost_expr_argument_match_ascribed_with_projection` に委譲し、型注釈と inner expression を同じ arena owner で検査します。
//:
//: [契約/けいやく]:
//: - `arena` owner は成功時に返り値へ移り、失敗時はこの関数または下位 helper が解放します。
//: - ascription projection 失敗は `AscriptionProjectionFailed` として包み、元 span を保持します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: `%T expr` 全体を 1 argument expression として消費した checked payload です。
//: - `Err(error)`: prefix range 作成、type projection、inner expression 検査のいずれかの typed error です。
//:
//: [計算量/けいさんりょう]:
//: - range 作成は O(1)、type projection は型式 token 数と型 tree に比例し、inner expression item 探索は O(n) です。
fn selfhost_expr_argument_match_ascribed_at_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn i32 impure fn SelfhostTypeId Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \tokens\source\arena\prefix\scope\value_types\signatures\item_index\item_count\expected_type:
    match selfhost_expr_argument_range_from_prefix prefix item_index item_count:
        Result::Ok syntax_range:
            match selfhost_expr_ascription_project_head_expectation tokens source arena syntax_range:
                Result::Ok projection:
                    selfhost_expr_argument_match_ascribed_with_projection tokens source scope value_types signatures projection prefix item_index item_count expected_type
                Result::Err e:
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::AscriptionProjectionFailed selfhost_expr_argument_span_from_ascription_error e
        Result::Err e:
            selfhost_type_arena_free arena
            Result::Err e

//: selfhost_expr_argument_match_at_with_source: source / token backed に 1 つの実引数式を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `%T literal` のように、prefix item kind だけでは型注釈の spelling を検査できない argument expression を安全に扱います。
//: - `NamedValue` は `SelfhostNameScope` と `SelfhostValueTypeEvidenceTable` を使い、DefId-linked な型証拠がある場合だけ parameter type と照合します。
//: - この入口は arena owner を受け取り、ascription type を projection した場合は更新済み arena owner を成功 payload として返します。
//:
//: [契約/けいやく]:
//: - source-backed に成功させる可変幅式は `%T literal` と `%T NamedValue` です。nested call や block などは `UnsupportedArgumentExpression` として fail-closed にします。
//: - 名前付き値は最新 binding を使います。最新 binding が型名や trait など値として扱えない分類なら、古い同名値へ戻らず `NamedValueUnsupportedBinding` を返します。
//: - 明示 function value は `@ident` の 2 item だけを受理します。対象名は function namespace の候補収集と callable signature table を通し、generic / overload 未解決は成功扱いしません。
//: - `%T` と expected parameter type が同じ arena 内で一致しない場合は `AscriptionExpectedTypeConflict` として返し、arity / overload 失敗へ潰しません。
//: - 失敗時は、この関数が受け取った arena owner を解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(match)`: 1 つの argument expression を消費し、updated arena owner と checked argument evidence を返します。
//: - `Err(error)`: missing argument、type mismatch、unsupported expression、ascription conflict、named value/function value/literal decode の typed error です。
//:
//: [計算量/けいさんりょう]:
//: - 単一 literal/name/function value は lookup と型比較に比例します。`%T expr` は型式 token 数と prefix item 探索範囲に比例します。
pub fn selfhost_expr_argument_match_at_with_source %impure fn &Vec SelfhostToken impure fn str impure fn SelfhostTypeArena impure fn &SelfhostExprPrefixList impure fn &SelfhostNameScope impure fn &SelfhostValueTypeEvidenceTable impure fn &SelfhostCallableSignatureTable impure fn i32 impure fn i32 impure fn SelfhostTypeId Result SelfhostExprArgumentOwnedMatch SelfhostExprArgumentMatchError \tokens\source\arena\prefix\scope\value_types\signatures\item_index\item_count\expected_type:
    if:
        ge item_index item_count
        then:
            selfhost_type_arena_free arena
            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::MissingArgument source_span_empty_unchecked 0 0
        else:
            match selfhost_expr_prefix_list_get prefix item_index:
                Option::Some item:
                    match item.kind:
                        SelfhostExprPrefixItemKind::TypeAnnotationMarker:
                            selfhost_expr_argument_match_ascribed_at_with_source tokens source arena prefix scope value_types signatures item_index item_count expected_type
                        SelfhostExprPrefixItemKind::NamedValue:
                            selfhost_expr_argument_match_named_value_with_source arena tokens source scope value_types item item_index expected_type
                        SelfhostExprPrefixItemKind::AtMarker:
                            selfhost_expr_argument_match_function_value_with_source tokens source arena prefix scope signatures item_index item_count expected_type item
                        SelfhostExprPrefixItemKind::MinusMarker:
                            selfhost_expr_argument_match_negative_literal_with_source arena tokens source prefix item_index item_count expected_type item
                        _:
                            if:
                                selfhost_expr_argument_item_matches_type &arena item expected_type
                                then:
                                    let next_index %i32 add item_index 1
                                    selfhost_expr_argument_match_literal_with_source arena tokens source item item_index next_index expected_type
                                else:
                                    selfhost_type_arena_free arena
                                    match selfhost_expr_argument_item_literal_type_kind item:
                                        Option::Some _actual_kind:
                                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::TypeMismatch item.span
                                        Option::None:
                                            Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::UnsupportedArgumentExpression item.span
                Option::None:
                    selfhost_type_arena_free arena
                    Result::Err selfhost_expr_argument_match_error_new SelfhostExprArgumentMatchErrorKind::InternalInvariant source_span_empty_unchecked 0 0
