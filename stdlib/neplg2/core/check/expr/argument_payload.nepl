#indent 4

//: # check/expr/argument_payload
//: source-backed argument checker が返す checked argument evidence を定義する module です。
//:
//: [目的/もくてき]:
//: - `argument.nepl` は prefix item を検査し、`call_reduce.nepl` はその検査結果を parameter loop に流します。この module は、その間で失ってはいけない typed evidence をまとめます。
//: - consume-width だけでは、明示 `@ident` がどの callable candidate として解決されたかを後続 HIR lowering へ渡せません。そのため、関数値や nested call の候補 identity を payload として残します。
//:
//: [契約/けいやく]:
//: - この module は HIR record を生成しません。HIR への変換は `neplg2/core/lower/hir` が担当します。
//: - `FunctionValue` は、`@ident` argument が expected function type と照合済みで、monomorphic candidate として一意に解決されたことを表します。
//: - `UnitValue` は、値 payload を持たずに HIR `Unit` へ下ろせる `unit` literal argument を表します。
//: - `BoolLiteral` と `I32Literal` は、source-backed checker が token lexeme を一度だけ解析して得た意味値を保持します。lowering は source text を再読しません。
//: - `StrLiteral` は、escape を含まない string literal から得た意味値を保持します。escape decode は別 slice の責務であり、この payload に raw quoted lexeme を入れてはいけません。
//: - `NamedValue` は、scope と value type evidence で照合済みの値参照を、DefId-linked identity として表します。
//: - `TypedExpression` は、char literal、escape 付き string、ascribed expression など、現 checkpoint で HIR child payload をまだ持たない通常の typed expression を表します。
//: - `NestedDirectCall` と `BlockResult` は、引数式が単一 item ではないことを後続 lowering が再計算しないための分類です。詳細な HIR tree は後続 slice でこの payload を使って構築します。
//:
//: [計算量/けいさんりょう]:
//: - payload の構築と分類確認は O(1) です。

#import "core/field" as field
#import "core/option" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/ty/ty" as *
#import "./call_candidate" as *

//: SelfhostCheckedValueIdentity: checked argument として確定した値参照 identity
//:
//: [目的/もくてき]:
//: - `NamedValue` argument を後続 lowering へ渡すため、source spelling だけではなく name resolver が割り当てた DefId と定義分類を保持します。
//: - HIR lowering はこの payload を使い、scope lookup や source token の再読を行わずに variable reference を構築します。
pub struct SelfhostCheckedValueIdentity:
    name %str
    def_id %SelfhostDefId
    kind %SelfhostDefKind

impl Clone for SelfhostCheckedValueIdentity:
    fn clone %fn &SelfhostCheckedValueIdentity SelfhostCheckedValueIdentity \self:
        *self

impl Copy for SelfhostCheckedValueIdentity:
    fn copy_mark %fn SelfhostCheckedValueIdentity SelfhostCheckedValueIdentity \self:
        self

//: selfhost_checked_value_identity_new: checked value identity を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed argument checker が確定した値参照 identity を、checked argument payload へ入れる形で構築します。
//:
//: [契約/けいやく]:
//: - `def_id` は必須です。DefId 未割当の binding は `NamedValuePendingBinding` として、この constructor へ到達する前に拒否します。
//: - `name` は表示用の spelling であり、identity の authority は `def_id` です。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_value_identity_new %fn str fn SelfhostDefId fn SelfhostDefKind SelfhostCheckedValueIdentity \name\def_id\kind:
    SelfhostCheckedValueIdentity name def_id kind

//: SelfhostCheckedArgumentKind: checked argument の lowering 用分類
//:
//: [目的/もくてき]:
//: - expression checker が得た証拠を、後続 lowering が match で網羅的に扱えるようにします。
//: - `NamedValue`、`FunctionValue`、`NestedDirectCall` は identity payload を保持し、名前文字列だけへ戻る退行を防ぎます。
pub enum SelfhostCheckedArgumentKind:
    UnitValue
    BoolLiteral %bool
    I32Literal %i32
    StrLiteral %str
    NamedValue %SelfhostCheckedValueIdentity
    TypedExpression
    FunctionValue %SelfhostCallableCandidate
    NestedDirectCall %SelfhostCallableCandidate
    BlockResult

impl Clone for SelfhostCheckedArgumentKind:
    fn clone %fn &SelfhostCheckedArgumentKind SelfhostCheckedArgumentKind \self:
        *self

impl Copy for SelfhostCheckedArgumentKind:
    fn copy_mark %fn SelfhostCheckedArgumentKind SelfhostCheckedArgumentKind \self:
        self

//: SelfhostCheckedArgument: 1 個の実引数式が検査済みであることを表す evidence
//:
//: [目的/もくてき]:
//: - `start_index` と `next_index` は、prefix list 上でこの実引数式が消費した範囲を表します。
//: - `value_type` は、parameter type との照合後に得られた expression type です。HIR lowering はこの型を expression node の型として使えます。
//: - `span` は、diagnostic と HIR dump が source 上の使用箇所を失わないための位置情報です。
pub struct SelfhostCheckedArgument:
    kind %SelfhostCheckedArgumentKind
    start_index %i32
    next_index %i32
    value_type %SelfhostTypeId
    span %SelfhostSourceSpan

impl Clone for SelfhostCheckedArgument:
    fn clone %fn &SelfhostCheckedArgument SelfhostCheckedArgument \self:
        *self

impl Copy for SelfhostCheckedArgument:
    fn copy_mark %fn SelfhostCheckedArgument SelfhostCheckedArgument \self:
        self

//: selfhost_checked_argument_new: checked argument payload を[作/つく]る
//:
//: [目的/もくてき]:
//: - argument checker が確定した分類、prefix list 上の消費範囲、型、span を 1 つの evidence record にまとめます。
//: - 後続 lowering はこの record だけを authority とし、source token や name scope を再読しない設計にします。
//:
//: [契約/けいやく]:
//: - `start_index` と `next_index` は半開区間 `[start_index, next_index)` です。
//: - `value_type` は parameter type と照合済みの型です。未照合の型推定候補を入れてはいけません。
//: - `kind` が literal payload を持つ場合、その payload は checker 側で確定した semantic value であり、raw lexeme ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_new %fn SelfhostCheckedArgumentKind fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan SelfhostCheckedArgument \kind\start_index\next_index\value_type\span:
    SelfhostCheckedArgument kind start_index next_index value_type span

//: selfhost_checked_argument_typed_expression: 通常の typed expression argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - char literal、escape 付き string、ascription 付き複合式など、関数値 identity や literal 値をまだ payload 化していない argument の共通 constructor です。
//:
//: [契約/けいやく]:
//: - `TypedExpression` は「型だけは一致したが、HIR child を source 再読なしに作る payload が未実装」という分類です。
//: - HIR lowering はこの variant を accepted として扱わず、より詳細な checked tree payload が入るまで fail-closed にします。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_typed_expression %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan SelfhostCheckedArgument \start_index\next_index\value_type\span:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::TypedExpression start_index next_index value_type span

//: selfhost_checked_argument_unit_value: `unit` literal argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - `unit` は値 payload を持たず、型と span だけで HIR `Unit` expression へ変換できます。
//: - `TypedExpression` に丸めず専用 variant にすることで、HIR lowering が source token を再読せずに `unit` child を構築できます。
//:
//: [契約/けいやく]:
//: - caller は `unit` literal が expected type と一致していることを先に検査します。
//: - この constructor は `unit` 型そのものの推論や void marker の解釈を行いません。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_unit_value %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan SelfhostCheckedArgument \start_index\next_index\value_type\span:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::UnitValue start_index next_index value_type span

//: selfhost_checked_argument_bool_literal: bool literal argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed checker が `true` / `false` の lexeme を意味値へ解析した後、その値を checked payload として保存します。
//: - HIR lowering はこの値だけを使い、token buffer や source text を再読しません。
//:
//: [契約/けいやく]:
//: - caller は token kind が `BoolLiteral` で、lexeme が正当な bool literal として解析済みであることを保証します。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_bool_literal %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn bool SelfhostCheckedArgument \start_index\next_index\value_type\span\value:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::BoolLiteral value start_index next_index value_type span

//: selfhost_checked_argument_i32_literal: i32 literal argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed checker が整数 token を i32 の意味値へ解析した後、その値を checked payload として保存します。
//: - numeric defaulting や suffix 解決を lowering へ持ち込まず、型検査済みの `i32` argument として扱います。
//:
//: [契約/けいやく]:
//: - caller は token kind が `IntLiteral` で、現在の checkpoint が扱う 10 進 i32 literal として解析済みであることを保証します。
//: - hex / binary / suffix / defaulting はこの constructor へ入る前に拒否または別 payload に分解します。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_i32_literal %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn i32 SelfhostCheckedArgument \start_index\next_index\value_type\span\value:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::I32Literal value start_index next_index value_type span

//: selfhost_checked_argument_str_literal: string literal argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed checker が string literal の token spelling から意味値を取り出した後、その値を checked payload として保存します。
//: - 現 checkpoint では escape を含まない string literal だけを受理し、raw quoted lexeme を HIR へ渡す退行を防ぎます。
//:
//: [契約/けいやく]:
//: - `value` は引用符を含まない semantic string value です。`"abc"` の payload は `abc` であり、`"abc"` という raw lexeme ではありません。
//: - escape decode が未実装の間、caller は escape を含む literal を `StringEscapeUnsupported` として拒否します。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。string body の検査や slice は caller 側で完了しています。
pub fn selfhost_checked_argument_str_literal %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn str SelfhostCheckedArgument \start_index\next_index\value_type\span\value:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::StrLiteral value start_index next_index value_type span

//: selfhost_checked_argument_named_value: `NamedValue` argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - scope lookup と value type evidence lookup が完了した値参照を、DefId-linked payload として保存します。
//: - 後続 HIR lowering はこの payload と `value_type` を使い、名前解決を再実行しません。
//:
//: [契約/けいやく]:
//: - `identity.def_id` は name resolver が割り当てた stable identity です。`identity.name` だけで値参照を再構築してはいけません。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_named_value %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostCheckedValueIdentity SelfhostCheckedArgument \start_index\next_index\value_type\span\identity:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::NamedValue identity start_index next_index value_type span

//: selfhost_checked_argument_function_value: 明示 `@ident` function value argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - callable candidate の DefId / type / effect evidence を保持し、後続の HIR `FnValue` lowering が同じ関数を参照できるようにします。
//:
//: [契約/けいやく]:
//: - caller は expected function type と candidate signature の照合、monomorphic candidate であること、一意解決を完了してから呼びます。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_function_value %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostCallableCandidate SelfhostCheckedArgument \start_index\next_index\value_type\span\candidate:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::FunctionValue candidate start_index next_index value_type span

//: selfhost_checked_argument_nested_direct_call: nested direct call argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - `add add 1 2 3` の内側 `add 1 2` のように、argument が nested call として縮約されたことを保持します。
//:
//: [現状/げんじょう]:
//: - この variant は nested call の candidate summary だけを持ち、内側 argument tree の full payload はまだ持ちません。
//: - HIR lowering で accepted にするには、後続 slice で checked tree payload を追加する必要があります。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_nested_direct_call %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan fn SelfhostCallableCandidate SelfhostCheckedArgument \start_index\next_index\value_type\span\candidate:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::NestedDirectCall candidate start_index next_index value_type span

//: selfhost_checked_argument_block_result: trailing block argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - `head:` の body が `BlockResult` expectation で 1 個の実引数として検査済みであることを保存します。
//:
//: [現状/げんじょう]:
//: - この variant は block result の範囲と型だけを運び、block body の HIR tree payload はまだ持ちません。
//: - 後続 HIR lowering は、この payload が拡張されるまで fail-closed にします。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_checked_argument_block_result %fn i32 fn i32 fn SelfhostTypeId fn SelfhostSourceSpan SelfhostCheckedArgument \start_index\next_index\value_type\span:
    selfhost_checked_argument_new SelfhostCheckedArgumentKind::BlockResult start_index next_index value_type span

//: selfhost_checked_argument_is_function_value: argument が明示 function value か[返/かえ]す
//:
//: [目的/もくてき]:
//: - focused test と後続 lowering が、表示文字列ではなく typed payload で `@ident` の保持を確認できるようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `argument.kind` は `FunctionValue` です。
//: - `false`: それ以外の checked argument です。
//:
//: [計算量/けいさんりょう]:
//: - enum match だけなので O(1) です。
pub fn selfhost_checked_argument_is_function_value %fn &SelfhostCheckedArgument bool \argument:
    match *field::get_ref argument "kind":
        SelfhostCheckedArgumentKind::FunctionValue _candidate:
            true
        _:
            false

//: selfhost_checked_argument_function_value_candidate: function value candidate を[取/と]り[出/だ]す
//:
//: [戻/もど]り[値/ち]:
//: - `Some(candidate)`: argument は明示 function value で、DefId-linked candidate evidence を持ちます。
//: - `None`: argument は通常式、nested call、または block result です。
pub fn selfhost_checked_argument_function_value_candidate %fn &SelfhostCheckedArgument Option SelfhostCallableCandidate \argument:
    match *field::get_ref argument "kind":
        SelfhostCheckedArgumentKind::FunctionValue candidate:
            some candidate
        _:
            none
