#indent 4

//: # check/expr/literal_payload
//: source-backed argument checker が literal token から checked payload を作る境界 module です。
//:
//: [目的/もくてき]:
//: - `argument.nepl` は argument の型一致と consume-width を管理します。この module は、その成功済み literal item について、source text から意味値を一度だけ取り出して `SelfhostCheckedArgument` に保存します。
//: - HIR lowering が token buffer や source text を再読しないよう、bool / i32 / f32 / char / string の値 payload を check/expr 側で確定します。
//: - literal decode の失敗を `UnsupportedArgumentExpression` や文字列診断に潰さず、enum error として caller へ返します。
//:
//: [契約/けいやく]:
//: - この module は HIR を import しません。出力は `SelfhostCheckedArgument` だけです。
//: - `IntLiteral` は、接頭辞なしの 10 進表記、`0x` / `0X` 16 進表記、`0b` / `0B` 2 進表記、`0o` / `0O` 8 進表記を i32 payload へ正規化します。
//: - `FloatLiteral` は Rust 実装の現 checkpoint と同じく f32 payload へ正規化します。`f64` defaulting や suffix 解決は後続の numeric literal 設計で扱います。
//: - `-1` / `- 1` / `-1.5` は source-backed argument matcher が `MinusMarker` と直後の数値 literal item を 1 個の checked argument として消費し、この module が `-` と operand token spelling だけを連結した semantic lexeme を作ります。
//: - numeric suffix は現行 lexer が integer token に含めないため、この境界では扱いません。suffix 付き表記は token 列の段階で別 item になり、後続の expression checker が fail-closed に処理します。
//: - `StringLiteral` は quote を外し、Rust lexer と同じ simple escape と `\xHH` escape を semantic string value へ decode して accepted payload にします。raw quoted lexeme を payload へ入れてはいけません。
//: - `CharLiteral` は Rust lexer と同じく Unicode scalar value として decode し、checked payload には `char` 値だけを保存します。後続 HIR lowering はこの値を i32-backed char literal へ変換します。
//:
//: [計算量/けいさんりょう]:
//: - bool / i32 の lexeme 解析は lexeme 長 n に対して O(n) です。
//: - char の simple literal / simple escape / `\xHH` は O(1)、`\u{...}` は hex digit 数 d に対して O(d) です。仕様上 d は高々 6 です。
//: - string の検査と escape decode は string token 長 n に対して O(n) です。escape がない場合は builder を作らず `str_slice_result` で quote を外します。

#import "alloc/collections/vec" as v
#import "alloc/string" as string
#import "alloc/string/builder" as *
#import "core/char" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/prefix_expr" as *
#import "neplg2/core/syntax/token" as *
#import "neplg2/core/ty/ty" as *
#import "./argument_payload" as *

//: SelfhostLiteralArgumentErrorKind: literal payload 生成の失敗分類
//:
//: [目的/もくてき]:
//: - source-backed literal decode の失敗を、call reducer の typed error へ写像できるようにします。
//:
//: [分類/ぶんるい]:
//: - `TokenOutOfBounds`: prefix item が指す token index が token buffer の範囲外です。
//: - `BoolInvalid`: bool token の lexeme が `true` / `false` ではありません。
//: - `I32Invalid`: i32 として解析できない integer lexeme です。空の基数付き本体、無効 digit、表現域外の値もここに含めます。
//: - `I32RadixUnsupported`: `0z` のような unknown radix marker が 1 token として渡った場合に、selfhost checker が decimal fallback せず拒否するための分類です。
//: - `F32Invalid`: f32 として解析できない float lexeme です。parser/lexer の不整合を 0.0 などに丸めず fail-closed にします。
//: - `StringMalformed`: quote 境界を確認できない string literal token です。
//: - `StringEscapeUnsupported`: Rust 側 string literal と対応していない escape spelling です。
//: - `StringEscapeMalformed`: `\xHH` の hex digit 不足など、escape spelling の構造が壊れています。
//: - `StringSliceFailed`: escape を含まない fast path で quote を外す slice を作れない string literal です。
//: - `StringBuildFailed`: escape decode path で semantic string owner を構築できませんでした。
//: - `CharMalformed`: quote 境界、empty body、hex / unicode escape 形式など、char literal の構造が不正です。
//: - `CharEscapeUnsupported`: Rust 側 lexer と対応していない escape spelling です。
//: - `CharInvalidScalar`: `\u{...}` が Unicode scalar value ではありません。
//: - `CharMultipleScalars`: char literal body が 1 scalar value ではありません。
pub enum SelfhostLiteralArgumentErrorKind:
    TokenOutOfBounds
    BoolInvalid
    I32Invalid
    I32RadixUnsupported
    F32Invalid
    StringMalformed
    StringEscapeUnsupported
    StringEscapeMalformed
    StringSliceFailed
    StringBuildFailed
    CharMalformed
    CharEscapeUnsupported
    CharInvalidScalar
    CharMultipleScalars

impl Clone for SelfhostLiteralArgumentErrorKind:
    fn clone %fn &SelfhostLiteralArgumentErrorKind SelfhostLiteralArgumentErrorKind \self:
        *self

impl Copy for SelfhostLiteralArgumentErrorKind:
    fn copy_mark %fn SelfhostLiteralArgumentErrorKind SelfhostLiteralArgumentErrorKind \self:
        self

//: SelfhostLiteralArgumentError: literal payload 生成の typed error
//:
//: [目的/もくてき]:
//: - error kind と span を保持し、argument checker が call reduction error へ正確に写像できるようにします。
pub struct SelfhostLiteralArgumentError:
    kind %SelfhostLiteralArgumentErrorKind
    span %SelfhostSourceSpan

impl Clone for SelfhostLiteralArgumentError:
    fn clone %fn &SelfhostLiteralArgumentError SelfhostLiteralArgumentError \self:
        *self

impl Copy for SelfhostLiteralArgumentError:
    fn copy_mark %fn SelfhostLiteralArgumentError SelfhostLiteralArgumentError \self:
        self

//: selfhost_literal_argument_error_new: literal payload error を[作/つく]る
//:
//: [目的/もくてき]:
//: - literal token の範囲確認や意味値解析に失敗した位置を、後続の argument checker / call reducer が失わない形でまとめます。
//:
//: [契約/けいやく]:
//: - `kind` は表示文ではなく enum payload です。診断表示や翻訳は、この error を受け取る別層で行います。
//: - `span` は原因となった literal item の span を渡します。caller が別の fallback span を混ぜると、エラー位置が曖昧になります。
//:
//: [計算量/けいさんりょう]:
//: - 構築は O(1) です。
pub fn selfhost_literal_argument_error_new %fn SelfhostLiteralArgumentErrorKind fn SelfhostSourceSpan SelfhostLiteralArgumentError \kind\span:
    SelfhostLiteralArgumentError kind span

//: SelfhostLiteralCharDecode: char literal body decode の中間結果
//:
//: [目的/もくてき]:
//: - escape body のように、値と「次に読む byte offset」を同時に返すための内部 record です。
//: - `value` は checked argument payload に保存する semantic `char`、`next_index` は closing quote の直前まで正しく消費したかを検査するための byte offset です。
//:
//: [契約/けいやく]:
//: - `next_index` は lexeme 内の byte offset です。source 全体の offset ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 構築と copy は O(1) です。
struct SelfhostLiteralCharDecode:
    value %char
    next_index %i32

impl Clone for SelfhostLiteralCharDecode:
    fn clone %fn &SelfhostLiteralCharDecode SelfhostLiteralCharDecode \self:
        *self

impl Copy for SelfhostLiteralCharDecode:
    fn copy_mark %fn SelfhostLiteralCharDecode SelfhostLiteralCharDecode \self:
        self

//: selfhost_literal_char_decode_new: char decode の中間結果を[作/つく]る
//:
//: [目的/もくてき]:
//: - decode した `char` と消費済み byte offset を 1 つの typed payload にまとめます。
//:
//: [契約/けいやく]:
//: - `next_index` は char literal lexeme 内の byte offset です。source 全体の byte offset や char index を渡してはいけません。
//: - `value` は raw byte や code point i32 ではなく、検証済み `char` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_char_decode_new %fn char fn i32 SelfhostLiteralCharDecode \value\next_index:
    SelfhostLiteralCharDecode value next_index

//: SelfhostLiteralStringDecode: string escape decode の中間結果
//:
//: [目的/もくてき]:
//: - string literal body 内の 1 つの escape spelling を、semantic `char` と次に読む byte offset に変換した結果を表します。
//: - char literal 用の decode record と同じ形ですが、string では許可する escape spelling が異なるため、typed payload も分けます。
//:
//: [契約/けいやく]:
//: - `value` は builder へ UTF-8 として追加する Unicode scalar value です。
//: - `next_index` は lexeme 内 byte offset です。source 全体の offset や scalar index ではありません。
//:
//: [計算量/けいさんりょう]:
//: - 構築と copy は O(1) です。
struct SelfhostLiteralStringDecode:
    value %char
    next_index %i32

impl Clone for SelfhostLiteralStringDecode:
    fn clone %fn &SelfhostLiteralStringDecode SelfhostLiteralStringDecode \self:
        *self

impl Copy for SelfhostLiteralStringDecode:
    fn copy_mark %fn SelfhostLiteralStringDecode SelfhostLiteralStringDecode \self:
        self

//: selfhost_literal_string_decode_new: string escape decode の中間結果を[作/つく]る
//:
//: [目的/もくてき]:
//: - escape から得た `char` と消費済み byte offset を、body loop が扱う record にまとめます。
//:
//: [契約/けいやく]:
//: - `next_index` は、次に body loop が読む lexeme 内 byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_string_decode_new %fn char fn i32 SelfhostLiteralStringDecode \value\next_index:
    SelfhostLiteralStringDecode value next_index

//: selfhost_literal_argument_bool_from_lexeme: bool literal の lexeme を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - lexer が `BoolLiteral` と分類した token spelling を、HIR へ渡せる `bool` payload に正規化します。
//: - raw source text を lowering へ渡さないため、checker 境界で `true` / `false` のどちらかへ確定します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(true)`: lexeme が `true` です。
//: - `Ok(false)`: lexeme が `false` です。
//: - `Err(BoolInvalid)`: token kind と lexeme が矛盾しています。lexer / prefix item 生成の不整合を隠さず fail-closed にします。
//:
//: [計算量/けいさんりょう]:
//: - 固定文字列との比較だけなので、lexeme 長 n に対して O(n) です。
fn selfhost_literal_argument_bool_from_lexeme %fn str fn SelfhostSourceSpan Result bool SelfhostLiteralArgumentError \lexeme\span:
    if:
        string::str_eq lexeme "true"
        then:
            Result::Ok true
        else:
            if:
                string::str_eq lexeme "false"
                then:
                    Result::Ok false
                else:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::BoolInvalid span

//: SelfhostLiteralI32RadixPlan: integer literal の解析基数と digit 範囲を[保持/ほじ]する
//:
//: [目的/もくてき]:
//: - lexer が保持した raw lexeme から、`string::to_i32_radix` に渡す本体範囲と基数を分離します。
//: - prefix 判定と数値変換を 1 つの関数に混ぜると、将来 suffix / numeric defaulting を追加するときに診断境界が曖昧になるため、typed record として切り出します。
//:
//: [契約/けいやく]:
//: - `digits_start` は `lexeme` 内の byte offset です。
//: - `has_minus` が `true` の場合、caller は `digits_start` から末尾までの slice の前に ASCII `-` を付けて radix parser へ渡します。
//: - `radix` は現時点では `2`、`8`、`10`、`16` のいずれかです。unknown radix marker は plan を作らず typed error として返します。
//:
//: [計算量/けいさんりょう]:
//: - 構築と copy は O(1) です。
struct SelfhostLiteralI32RadixPlan:
    radix %i32
    digits_start %i32
    has_minus %bool

impl Clone for SelfhostLiteralI32RadixPlan:
    fn clone %fn &SelfhostLiteralI32RadixPlan SelfhostLiteralI32RadixPlan \self:
        *self

impl Copy for SelfhostLiteralI32RadixPlan:
    fn copy_mark %fn SelfhostLiteralI32RadixPlan SelfhostLiteralI32RadixPlan \self:
        self

//: selfhost_literal_i32_radix_plan_new: i32 literal radix plan を[作/つく]る
//:
//: [目的/もくてき]:
//: - prefix 判定済みの解析情報を 1 record にまとめ、実際の数値 parse 関数へ渡します。
//:
//: [契約/けいやく]:
//: - `digits_start` は byte offset です。char index や source 全体の offset ではありません。
//: - `has_minus` は lexeme 先頭が負号である場合だけ `true` にします。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_i32_radix_plan_new %fn i32 fn i32 fn bool SelfhostLiteralI32RadixPlan \radix\digits_start\has_minus:
    SelfhostLiteralI32RadixPlan radix digits_start has_minus

//: selfhost_literal_argument_i32_unsupported_radix_marker: unknown radix marker か[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - `0x` / `0b` / `0o` 以外の alphabetic radix marker が同一 token として渡されたとき、10 進 parse へ落ちて別の値として扱われないようにします。
//: - numeric suffix は lexer が integer token に含めない契約なので、この関数は suffix 解決を行いません。
//:
//: [契約/けいやく]:
//: - `marker` は prefix の 2 byte 目です。`0x` / `0X`、`0b` / `0B`、`0o` / `0O` は対応済みなので `false` です。
//: - alphabetic ではない marker は unknown radix marker とみなしません。たとえば `01` は 10 進 token として扱います。
//: - `true` の場合、caller は `I32RadixUnsupported` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_i32_unsupported_radix_marker %fn i32 bool \marker:
    let lower_alpha %bool and ge marker 'a' le marker 'z'
    let upper_alpha %bool and ge marker 'A' le marker 'Z'
    let hex_marker %bool or eq marker 'x' eq marker 'X'
    let binary_marker %bool or eq marker 'b' eq marker 'B'
    let octal_marker %bool or eq marker 'o' eq marker 'O'
    let supported_marker %bool or hex_marker or binary_marker octal_marker
    and or lower_alpha upper_alpha not supported_marker

//: selfhost_literal_argument_i32_radix_plan_from_lexeme: integer lexeme の基数 plan を[作/つく]る
//:
//: [目的/もくてき]:
//: - 基数接頭辞付き整数を i32 payload として受理できるよう、token spelling から radix と digit 範囲を決めます。
//: - 10 進、2 進、8 進、16 進のいずれも、最終的な桁検査と overflow 検査は `alloc/string` の integer parser に委譲します。
//:
//: [契約/けいやく]:
//: - `0x` / `0X` は 16 進として扱います。接頭辞そのものは `to_i32_radix` に渡さず、digit 本体だけを渡します。
//: - `0b` / `0B` は 2 進、`0o` / `0O` は 8 進として扱います。これらも接頭辞を取り除いた digit 本体だけを parser に渡します。
//: - 先頭 `-` の直後に基数接頭辞がある場合も plan としては保持します。現行 selfhost lexer は `-` を別 token にしますが、将来 parser が Rust 側と同じ結合を行っても符号を失わないためです。
//: - `0z` のような unknown alphabetic radix marker が同一 token として渡った場合は `I32RadixUnsupported` です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(plan)`: `plan.radix` と `plan.digits_start` に従って数値本体を parse できます。
//: - `Err(I32RadixUnsupported)`: unknown radix marker がありました。
//:
//: [計算量/けいさんりょう]:
//: - 先頭 3 byte だけを調べるため O(1) です。
fn selfhost_literal_argument_i32_radix_plan_from_lexeme %fn str fn SelfhostSourceSpan Result SelfhostLiteralI32RadixPlan SelfhostLiteralArgumentError \lexeme\span:
    let n %i32 string::len lexeme
    if:
        lt n 2
        then:
            Result::Ok selfhost_literal_i32_radix_plan_new 10 0 false
        else:
            match string::byte_at lexeme 0:
                Option::Some first:
                    let has_minus %bool eq first '-'
                    let prefix_index %i32 if has_minus:
                        then 1
                        else 0
                    if:
                        lt n add prefix_index 2
                        then:
                            Result::Ok selfhost_literal_i32_radix_plan_new 10 0 has_minus
                        else:
                            match string::byte_at lexeme prefix_index:
                                Option::Some prefix_first:
                                    match string::byte_at lexeme add prefix_index 1:
                                        Option::Some prefix_second:
                                            if:
                                                eq prefix_first '0'
                                                then:
                                                    if:
                                                        or eq prefix_second 'x' eq prefix_second 'X'
                                                        then:
                                                            Result::Ok selfhost_literal_i32_radix_plan_new 16 add prefix_index 2 has_minus
                                                        else:
                                                            if:
                                                                or eq prefix_second 'b' eq prefix_second 'B'
                                                                then:
                                                                    Result::Ok selfhost_literal_i32_radix_plan_new 2 add prefix_index 2 has_minus
                                                                else:
                                                                    if:
                                                                        or eq prefix_second 'o' eq prefix_second 'O'
                                                                        then:
                                                                            Result::Ok selfhost_literal_i32_radix_plan_new 8 add prefix_index 2 has_minus
                                                                        else:
                                                                            if:
                                                                                selfhost_literal_argument_i32_unsupported_radix_marker prefix_second
                                                                                then:
                                                                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32RadixUnsupported span
                                                                                else:
                                                                                    Result::Ok selfhost_literal_i32_radix_plan_new 10 0 has_minus
                                                else:
                                                    Result::Ok selfhost_literal_i32_radix_plan_new 10 0 has_minus
                                        Option::None:
                                            Result::Ok selfhost_literal_i32_radix_plan_new 10 0 has_minus
                                Option::None:
                                    Result::Ok selfhost_literal_i32_radix_plan_new 10 0 has_minus
                Option::None:
                    Result::Ok selfhost_literal_i32_radix_plan_new 10 0 false

//: selfhost_literal_argument_i32_body_from_plan: radix parser に渡す body 文字列を[作/つく]る
//:
//: [目的/もくてき]:
//: - `0x` / `0X`、`0b` / `0B`、`0o` / `0O` 接頭辞を取り除いた digit body を作ります。
//: - 負号付き基数 literal が将来 parser から渡された場合でも、`-` を保持した body にして `to_i32_radix` へ渡します。
//:
//: [契約/けいやく]:
//: - `Result::Ok` で返す文字列は接頭辞を含みません。
//: - `plan.has_minus` が `true` かつ `plan.digits_start` が 0 でない場合だけ builder を使います。通常の 10 進 literal と正の基数付き literal は `str_slice_result` の fast path です。
//: - body が空の場合でもここでは `Ok("")` になり得ます。空 digit の拒否は `to_i32_radix` に委譲し、数値 parser の contract に集約します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(body)`: `body` は radix parser へ渡せる接頭辞なしの digit 文字列です。負号が必要な場合は先頭に `-` を含みます。
//: - `Err(I32Invalid)`: slice / builder / UTF-8 境界の不整合により body を作れませんでした。
//:
//: [計算量/けいさんりょう]:
//: - slice fast path は O(n) の文字列構築です。負号付き prefix 除去 path も O(n) です。
fn selfhost_literal_argument_i32_body_from_plan %fn str fn SelfhostLiteralI32RadixPlan fn SelfhostSourceSpan Result str SelfhostLiteralArgumentError \lexeme\plan\span:
    let n %i32 string::len lexeme
    if:
        and plan.has_minus gt plan.digits_start 0
        then:
            match string::string_builder_with_capacity_result n:
                Result::Ok sb0:
                    match string::sb_append_result sb0 "-":
                        Result::Ok sb1:
                            match string::sb_append_slice_result sb1 lexeme plan.digits_start n:
                                Result::Ok sb2:
                                    match string::sb_build_result sb2:
                                        Result::Ok body:
                                            Result::Ok body
                                        Result::Err _e:
                                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span
                                Result::Err _e:
                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span
                        Result::Err _e:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span
                Result::Err _e:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span
        else:
            match string::str_slice_result lexeme plan.digits_start n:
                Result::Ok body:
                    Result::Ok body
                Result::Err _e:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span

//: selfhost_literal_argument_i32_from_lexeme: i32 literal を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - type checker が expected type として i32 を確認した literal を、HIR `I32Literal` payload に渡せる値へ変換します。
//: - 10 進 / 16 進 / 2 進 / 8 進の default i32 化をこの境界で行い、numeric suffix や unknown radix の未対応状態を lowering へ持ち込みません。
//: - `0x` / `0X`、`0b` / `0B`、`0o` / `0O` 接頭辞はそれぞれ 16 / 2 / 8 進として扱い、値が i32 に収まる場合だけ accepted payload にします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: lexeme は i32 として解析できました。
//: - `Err(I32RadixUnsupported)`: unknown radix marker です。
//: - `Err(I32Invalid)`: digit 不正、空本体、表現域外などにより i32 として解析できません。
//:
//: [計算量/けいさんりょう]:
//: - radix plan 作成は O(1)、body 構築と parse は lexeme 長 n に対して O(n) です。
fn selfhost_literal_argument_i32_from_lexeme %fn str fn SelfhostSourceSpan Result i32 SelfhostLiteralArgumentError \lexeme\span:
    match selfhost_literal_argument_i32_radix_plan_from_lexeme lexeme span:
        Result::Ok plan:
            match selfhost_literal_argument_i32_body_from_plan lexeme plan span:
                Result::Ok body:
                    match string::to_i32_radix body plan.radix:
                        Result::Ok value:
                            Result::Ok value
                        Result::Err _e:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid span
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_literal_argument_f32_from_lexeme: f32 literal を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - type checker が expected type として f32 を確認した literal を、HIR `F32Literal` payload に渡せる値へ変換します。
//: - Rust 実装では float literal が `ctx.f32()` と `HirExprKind::LiteralF32` へ落ちるため、selfhost でも同じ checkpoint 境界に合わせます。
//:
//: [契約/けいやく]:
//: - `lexeme` は `FloatLiteral` token の spelling です。別 token の spelling を渡した場合は `F32Invalid` として失敗させます。
//: - 失敗時に 0.0 などへ silent fallback してはいけません。Zenn 方針に従い、typed enum error を返して caller が診断へ写像します。
//: - suffix 付き float や f64 defaulting はこの関数では扱いません。現行 lexer が suffix を別 token にする境界を維持し、後続 issue で仕様化します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: lexeme は f32 として解析できました。
//: - `Err(F32Invalid)`: digit 不正、途中で切れた指数部、別 token spelling などにより f32 として解析できません。
//:
//: [計算量/けいさんりょう]:
//: - `alloc/string` の float parser に従い、lexeme 長 n に対して O(n) です。
fn selfhost_literal_argument_f32_from_lexeme %fn str fn SelfhostSourceSpan Result f32 SelfhostLiteralArgumentError \lexeme\span:
    match string::to_f32 lexeme:
        Result::Ok value:
            Result::Ok value
        Result::Err _e:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::F32Invalid span

//: selfhost_literal_argument_lexeme_contains_byte_loop: lexeme 範囲に byte が[含/ふく]まれるか[調/しら]べる
//:
//: [目的/もくてき]:
//: - string literal の body 部分に escape marker `\\` があるかを、引用符を除いた範囲で調べます。
//: - escape がない literal は fast path で quote 除去だけ行い、escape がある literal は builder decode path に進めます。
//:
//: [契約/けいやく]:
//: - `idx` は調査開始位置、`end` は半開区間の終端です。
//: - `string::byte_at` が範囲外を返した場合は、scanner helper として `false` に倒します。quote 境界の不正は別関数が先に検査します。
//:
//: [計算量/けいさんりょう]:
//: - 調査範囲長 n に対して O(n) です。追加の owner allocation は行いません。
fn selfhost_literal_argument_lexeme_contains_byte_loop %fn str fn i32 fn i32 fn i32 bool \lexeme\needle\idx\end:
    if:
        ge idx end
        then:
            false
        else:
            match string::byte_at lexeme idx:
                Option::Some ch:
                    if:
                        eq ch needle
                        then:
                            true
                        else:
                            selfhost_literal_argument_lexeme_contains_byte_loop lexeme needle add idx 1 end
                Option::None:
                    false

//: selfhost_literal_argument_string_quotes_valid: string literal の[引用符/いんようふ]境界を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - string literal token の lexeme が、先頭と末尾に `"` を持つ形かを確認します。
//: - quote 境界が壊れた token を slice すると、payload の意味値と span 診断が壊れるため、値抽出前に検査します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 長さが 2 以上で、先頭と末尾が `"` です。
//: - `false`: 長さ不足、または quote 境界がありません。
//:
//: [計算量/けいさんりょう]:
//: - 先頭と末尾だけを見るため O(1) です。
fn selfhost_literal_argument_string_quotes_valid %fn str fn i32 bool \lexeme\n:
    if:
        lt n 2
        then:
            false
        else:
            match string::byte_at lexeme 0:
                Option::Some first:
                    match string::byte_at lexeme sub n 1:
                        Option::Some last:
                            and eq first '"' eq last '"'
                        Option::None:
                            false
                Option::None:
                    false

//: selfhost_literal_argument_string_builder_error: StringBuilder 失敗を literal error へ[写像/しゃぞう]する
//:
//: [目的/もくてき]:
//: - escape decode path で builder append / build が失敗した場合、builder 層の表示用 error text ではなく selfhost literal checker の typed error domain へ移します。
//:
//: [契約/けいやく]:
//: - `sb_append_*_result` と `sb_build_result` は失敗時に入力 builder owner を閉じます。この helper は失敗済み builder を再利用しません。
//: - builder 層の error text はこの段階では診断 authority にしません。literal checker の失敗分類は `StringBuildFailed` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_string_builder_error %fn str fn SelfhostSourceSpan SelfhostLiteralArgumentError \_builder_error\span:
    selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringBuildFailed span

//: selfhost_literal_argument_string_append_decode: string builder に 1 scalar を[追加/ついか]する
//:
//: [目的/もくてき]:
//: - string literal body の通常文字または escape で得た `char` を、semantic string payload 用 builder へ追加します。
//:
//: [契約/けいやく]:
//: - `sb` はこの関数へ所有権を渡します。成功時は更新済み builder を返し、失敗時は builder API が入力 owner を閉じてから `Err` を返します。
//: - caller は `Err` 後に元の builder を使ってはいけません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(builder)`: `value` を UTF-8 として追加しました。
//: - `Err(StringBuildFailed)`: allocation / builder finalization 境界で失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 追加する scalar は 1 個なので通常 O(1) です。grow が発生した場合は builder の既存 byte 数に依存します。
fn selfhost_literal_argument_string_append_decode %fn StringBuilder fn char fn SelfhostSourceSpan Result StringBuilder SelfhostLiteralArgumentError \sb\value\span:
    match string::sb_append_char_result sb value:
        Result::Ok next:
            Result::Ok next
        Result::Err e:
            Result::Err selfhost_literal_argument_string_builder_error e span

//: selfhost_literal_argument_string_simple_escape: string simple escape を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - Rust 側 lexer が string literal で受け付ける 1 byte escape spelling を selfhost checker でも同じ semantic `char` へ正規化します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: `\n`、`\r`、`\t`、`\\`、`\"`、`\0` のいずれかです。
//: - `Err(StringEscapeUnsupported)`: char literal では使えるが string literal では使えない spelling、または未知の escape です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_string_simple_escape %fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralStringDecode SelfhostLiteralArgumentError \esc\next_index\span:
    match esc:
        'n':
            Result::Ok selfhost_literal_string_decode_new '\n' next_index
        'r':
            Result::Ok selfhost_literal_string_decode_new '\r' next_index
        't':
            Result::Ok selfhost_literal_string_decode_new '\t' next_index
        '\\':
            Result::Ok selfhost_literal_string_decode_new '\\' next_index
        '"':
            Result::Ok selfhost_literal_string_decode_new '"' next_index
        '0':
            Result::Ok selfhost_literal_string_decode_new '\0' next_index
        _:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeUnsupported span

//: selfhost_literal_argument_string_hex_escape: string `\xHH` escape を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - Rust 側 lexer と同じ 2 桁 hex escape を decode し、0..255 の code point を Unicode scalar value として string builder へ渡せる形にします。
//:
//: [契約/けいやく]:
//: - `idx` は 2 桁 hex の先頭 byte offset、`end` は closing quote の byte offset です。
//: - この関数は byte を直接 builder へ書きません。`0x80..0xff` も `char` として append し、UTF-8 string としての意味値を保ちます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: 2 桁 hex escape を string scalar value に変換しました。
//: - `Err(StringEscapeMalformed)`: hex digit が不足している、または hex digit ではありません。
//: - `Err(StringBuildFailed)`: code point 変換が想定外に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_string_hex_escape %fn str fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralStringDecode SelfhostLiteralArgumentError \lexeme\idx\end\span:
    if:
        gt add idx 2 end
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span
        else:
            match string::byte_at lexeme idx:
                Option::Some hi_ch:
                    match string::byte_at lexeme add idx 1:
                        Option::Some lo_ch:
                            match selfhost_literal_argument_hex_digit_value hi_ch:
                                Option::Some hi:
                                    match selfhost_literal_argument_hex_digit_value lo_ch:
                                        Option::Some lo:
                                            match char_from_i32_result (or shl hi 4 lo):
                                                Result::Ok value:
                                                    Result::Ok selfhost_literal_string_decode_new value add idx 2
                                                Result::Err _e:
                                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringBuildFailed span
                                        Option::None:
                                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span
                                Option::None:
                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span
                        Option::None:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span

//: selfhost_literal_argument_string_escape_from_lexeme: string escape body を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - `\` の次から始まる string escape spelling を、semantic `char` と消費済み byte offset に変換します。
//:
//: [契約/けいやく]:
//: - string literal の escape set は char literal と異なります。ここで char 専用の `\b`、`\f`、`\'`、`\u{...}` を受理してはいけません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: 対応済み escape を 1 つ decode しました。
//: - `Err(StringEscapeMalformed)`: escape が途中で切れている、または `\xHH` の構造が不正です。
//: - `Err(StringEscapeUnsupported)`: 対応していない escape spelling です。
//:
//: [計算量/けいさんりょう]:
//: - simple / hex escape は O(1) です。
fn selfhost_literal_argument_string_escape_from_lexeme %fn str fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralStringDecode SelfhostLiteralArgumentError \lexeme\idx\end\span:
    if:
        ge idx end
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span
        else:
            match string::byte_at lexeme idx:
                Option::Some esc:
                    match esc:
                        'x':
                            selfhost_literal_argument_string_hex_escape lexeme add idx 1 end span
                        _:
                            selfhost_literal_argument_string_simple_escape esc add idx 1 span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringEscapeMalformed span

//: selfhost_literal_argument_string_decode_loop: string literal body を builder に[復号/ふくごう]する
//:
//: [目的/もくてき]:
//: - quote を除いた string literal body を左から 1 度だけ走査し、escape を semantic string value へ変換します。
//: - decode 済み value を `SelfhostCheckedArgumentKind::StrLiteral` に保存することで、HIR lowering が source text を再読する必要をなくします。
//:
//: [契約/けいやく]:
//: - `idx` は次に読む lexeme 内 byte offset、`end` は closing quote の byte offset です。
//: - `sb` は owner として受け取り、成功時は `sb_build_result` で消費します。append / build 失敗時には builder API が owner cleanup を行うため、失敗後に同じ builder を再利用しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: quote なし、escape decode 済みの semantic string value です。
//: - `Err(StringMalformed)`: 通常文字の UTF-8 decode が失敗しました。
//: - `Err(StringEscapeMalformed)`: escape の構造が不正です。
//: - `Err(StringEscapeUnsupported)`: string literal では受理しない escape spelling です。
//: - `Err(StringBuildFailed)`: builder append / build が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - string body byte 長 n に対して O(n) です。
fn selfhost_literal_argument_string_decode_loop %fn str fn i32 fn i32 fn StringBuilder fn SelfhostSourceSpan Result str SelfhostLiteralArgumentError \lexeme\idx\end\sb\span:
    if:
        ge idx end
        then:
            match string::sb_build_result sb:
                Result::Ok out:
                    Result::Ok out
                Result::Err e:
                    Result::Err selfhost_literal_argument_string_builder_error e span
        else:
            match string::byte_at lexeme idx:
                Option::Some first:
                    let decoded_result %Result SelfhostLiteralStringDecode SelfhostLiteralArgumentError:
                        if:
                            eq first '\\'
                            then:
                                selfhost_literal_argument_string_escape_from_lexeme lexeme add idx 1 end span
                            else:
                                match string::str_next_char_result lexeme idx:
                                    Result::Ok item:
                                        let value %char field::get item "value"
                                        let next_index %i32 field::get item "next"
                                        Result::Ok selfhost_literal_string_decode_new value next_index
                                    Result::Err _e:
                                        Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringMalformed span
                    match decoded_result:
                        Result::Ok decoded:
                            match selfhost_literal_argument_string_append_decode sb decoded.value span:
                                Result::Ok next:
                                    selfhost_literal_argument_string_decode_loop lexeme decoded.next_index end next span
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            string::string_builder_free sb
                            Result::Err e
                Option::None:
                    string::string_builder_free sb
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringMalformed span

//: selfhost_literal_argument_string_escaped_value_from_lexeme: escape 付き string literal を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - escape を含む string literal body を semantic string value へ decode します。
//: - `StringBuilder` の owner boundary をこの関数に閉じ、失敗 path で builder owner を漏らしません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: quote なし、escape decode 済みの semantic string value です。
//: - `Err(StringEscapeMalformed)` / `Err(StringEscapeUnsupported)` / `Err(StringBuildFailed)`: decode path の失敗分類です。
//:
//: [計算量/けいさんりょう]:
//: - string body byte 長 n に対して O(n) です。
fn selfhost_literal_argument_string_escaped_value_from_lexeme %fn str fn i32 fn SelfhostSourceSpan Result str SelfhostLiteralArgumentError \lexeme\n\span:
    match string::string_builder_with_capacity_result n:
        Result::Ok sb:
            selfhost_literal_argument_string_decode_loop lexeme 1 sub n 1 sb span
        Result::Err e:
            Result::Err selfhost_literal_argument_string_builder_error e span

//: selfhost_literal_argument_string_value_from_lexeme: string literal を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - quote 付き token spelling から、HIR `StrLiteral` payload に入れる quote なし semantic string value を取り出します。
//: - escape がない body は `str_slice_result` の fast path で処理し、escape がある body だけ builder decode path へ進みます。
//: - checker が semantic value を確定するため、HIR lowering は string token や source text を再読しません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: `value` は引用符を含まず、escape decode 済みの文字列です。
//: - `Err(StringMalformed)`: quote 境界が不正です。
//: - `Err(StringEscapeUnsupported)`: string literal では受理しない escape spelling です。
//: - `Err(StringEscapeMalformed)`: escape の構造が不正です。
//: - `Err(StringSliceFailed)`: escape なし fast path で quote を外す slice を作れませんでした。
//: - `Err(StringBuildFailed)`: escape decode path の builder append / build が失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - quote 検査は O(1)、escape scan / slice / decode は token 長 n に対して O(n) です。
fn selfhost_literal_argument_string_value_from_lexeme %fn str fn SelfhostSourceSpan Result str SelfhostLiteralArgumentError \lexeme\span:
    let n %i32 string::len lexeme
    if:
        not selfhost_literal_argument_string_quotes_valid lexeme n
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringMalformed span
        else:
            if:
                selfhost_literal_argument_lexeme_contains_byte_loop lexeme '\\' 1 sub n 1
                then:
                    selfhost_literal_argument_string_escaped_value_from_lexeme lexeme n span
                else:
                    match string::str_slice_result lexeme 1 sub n 1:
                        Result::Ok value:
                            Result::Ok value
                        Result::Err _e:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::StringSliceFailed span

//: selfhost_literal_argument_hex_digit_value: ASCII hex digit を 0..15 の値へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - char literal の `\xHH` と `\u{...}` escape が、hex digit 判定を文字列 parse に委譲せず byte 単位で処理できるようにします。
//:
//: [戻/もど]り[値/ち]:
//: - `Some(value)`: `ch` は ASCII hex digit です。
//: - `None`: `ch` は hex digit ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_hex_digit_value %fn i32 Option i32 \ch:
    if:
        and ge ch '0' le ch '9'
        then:
            some sub ch '0'
        else:
            if:
                and ge ch 'a' le ch 'f'
                then:
                    some add 10 sub ch 'a'
                else:
                    if:
                        and ge ch 'A' le ch 'F'
                        then:
                            some add 10 sub ch 'A'
                        else:
                            none

//: selfhost_literal_argument_char_quotes_valid: char literal の[引用符/いんようふ]境界を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - char literal token の lexeme が、先頭と末尾に `'` を持つ形かを確認します。
//: - lexer が token 化した範囲を信頼しきると、selfhost checker の payload と Rust lexer parity の差異を見逃すため、この境界で再検査します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 長さが 2 以上で、先頭と末尾が `'` です。
//: - `false`: 長さ不足、または quote 境界がありません。
//:
//: [計算量/けいさんりょう]:
//: - 先頭と末尾だけを見るため O(1) です。
fn selfhost_literal_argument_char_quotes_valid %fn str fn i32 bool \lexeme\n:
    if:
        lt n 2
        then:
            false
        else:
            match string::byte_at lexeme 0:
                Option::Some first:
                    match string::byte_at lexeme sub n 1:
                        Option::Some last:
                            and eq first '\'' eq last '\''
                        Option::None:
                            false
                Option::None:
                    false

//: selfhost_literal_argument_char_decode_from_code: i32 code point を char decode 結果へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - `\xHH` と `\u{...}` escape の code point を、Unicode scalar value として検証してから `char` payload へ戻します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: code point は valid scalar value です。
//: - `Err(CharInvalidScalar)`: surrogate range や `0x10FFFF` 超過など、`char` にできない値です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_char_decode_from_code %fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \code\next_index\span:
    match char_from_i32_result code:
        Result::Ok value:
            Result::Ok selfhost_literal_char_decode_new value next_index
        Result::Err _e:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharInvalidScalar span

//: selfhost_literal_argument_char_simple_escape: 1 byte escape を char decode 結果へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - Rust lexer が扱う simple char escape を selfhost checker 側でも同じ semantic `char` へ正規化します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: `\n`、`\r`、`\t`、`\b`、`\f`、`\0`、`\\`、`\'`、`\"` のいずれかです。
//: - `Err(CharEscapeUnsupported)`: 対応していない escape spelling です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_char_simple_escape %fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \esc\next_index\span:
    match esc:
        'n':
            Result::Ok selfhost_literal_char_decode_new '\n' next_index
        'r':
            Result::Ok selfhost_literal_char_decode_new '\r' next_index
        't':
            Result::Ok selfhost_literal_char_decode_new '\t' next_index
        'b':
            selfhost_literal_argument_char_decode_from_code 0x08 next_index span
        'f':
            Result::Ok selfhost_literal_char_decode_new '\f' next_index
        '0':
            Result::Ok selfhost_literal_char_decode_new '\0' next_index
        '\\':
            Result::Ok selfhost_literal_char_decode_new '\\' next_index
        '\'':
            Result::Ok selfhost_literal_char_decode_new '\'' next_index
        '"':
            Result::Ok selfhost_literal_char_decode_new '"' next_index
        _:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharEscapeUnsupported span

//: selfhost_literal_argument_char_hex_escape: `\xHH` escape を char decode 結果へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - Rust lexer と同じ 2 桁 hex char escape を decode します。
//:
//: [契約/けいやく]:
//: - `idx` は 2 桁 hex の先頭 byte offset です。
//: - `end` は closing quote の byte offset です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: 2 桁の hex escape を char value に変換しました。
//: - `Err(CharMalformed)`: hex digit が不足している、または hex digit ではありません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_literal_argument_char_hex_escape %fn str fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \lexeme\idx\end\span:
    if:
        gt add idx 2 end
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
        else:
            match string::byte_at lexeme idx:
                Option::Some hi_ch:
                    match string::byte_at lexeme add idx 1:
                        Option::Some lo_ch:
                            match selfhost_literal_argument_hex_digit_value hi_ch:
                                Option::Some hi:
                                    match selfhost_literal_argument_hex_digit_value lo_ch:
                                        Option::Some lo:
                                            selfhost_literal_argument_char_decode_from_code (or shl hi 4 lo) add idx 2 span
                                        Option::None:
                                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                                Option::None:
                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                        Option::None:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span

//: selfhost_literal_argument_char_unicode_digits_loop: `\u{...}` の hex digits を[読/よ]む
//:
//: [目的/もくてき]:
//: - Unicode escape の digits を 1..6 桁として読み、closing brace と scalar value 検証を一箇所に閉じ込めます。
//:
//: [契約/けいやく]:
//: - `idx` は最初の hex digit または `}` の位置です。
//: - `end` は closing quote の byte offset です。unicode escape の `}` は `end` より前に存在しなければなりません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: `value` は valid Unicode scalar value です。
//: - `Err(CharMalformed)`: digit がない、6 桁を超える、`}` がない、または hex 以外が現れました。
//: - `Err(CharInvalidScalar)`: code point が Unicode scalar value ではありません。
//:
//: [計算量/けいさんりょう]:
//: - digit 数を d として O(d) です。仕様上 d は高々 6 です。
fn selfhost_literal_argument_char_unicode_digits_loop %fn str fn i32 fn i32 fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \lexeme\idx\end\value\digits\span:
    if:
        ge idx end
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
        else:
            match string::byte_at lexeme idx:
                Option::Some ch:
                    if:
                        eq ch '}'
                        then:
                            if:
                                eq digits 0
                                then:
                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                                else:
                                    selfhost_literal_argument_char_decode_from_code value add idx 1 span
                        else:
                            if:
                                ge digits 6
                                then:
                                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                                else:
                                    match selfhost_literal_argument_hex_digit_value ch:
                                        Option::Some hex:
                                            selfhost_literal_argument_char_unicode_digits_loop lexeme add idx 1 end add shl value 4 hex add digits 1 span
                                        Option::None:
                                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span

//: selfhost_literal_argument_char_unicode_escape: `\u{...}` escape を char decode 結果へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - Unicode scalar value escape を Rust lexer と同じ surface spelling から decode します。
//:
//: [契約/けいやく]:
//: - `idx` は `u` の直後、つまり `{` が来るべき byte offset です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: Unicode escape を char value に変換しました。
//: - `Err(CharMalformed)`: `{...}` の形ではありません。
//: - `Err(CharInvalidScalar)`: code point が Unicode scalar value ではありません。
//:
//: [計算量/けいさんりょう]:
//: - digit 数 d に対して O(d) です。仕様上 d は高々 6 です。
fn selfhost_literal_argument_char_unicode_escape %fn str fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \lexeme\idx\end\span:
    match string::byte_at lexeme idx:
        Option::Some open:
            if:
                eq open '{'
                then:
                    selfhost_literal_argument_char_unicode_digits_loop lexeme add idx 1 end 0 0 span
                else:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
        Option::None:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span

//: selfhost_literal_argument_char_escape_from_lexeme: char escape body を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - `\` の次から始まる escape spelling を、semantic `char` と消費済み byte offset に変換します。
//:
//: [契約/けいやく]:
//: - `idx` は escape marker `\` の直後です。
//: - `end` は closing quote の byte offset です。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(decode)`: 対応済み escape を 1 つ decode しました。
//: - `Err(CharMalformed)`: escape が途中で切れている、または hex / unicode escape の構造が不正です。
//: - `Err(CharEscapeUnsupported)`: 対応していない escape spelling です。
//: - `Err(CharInvalidScalar)`: unicode escape が scalar value ではありません。
//:
//: [計算量/けいさんりょう]:
//: - simple / hex escape は O(1)、unicode escape は digit 数 d に対して O(d) です。
fn selfhost_literal_argument_char_escape_from_lexeme %fn str fn i32 fn i32 fn SelfhostSourceSpan Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError \lexeme\idx\end\span:
    if:
        ge idx end
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
        else:
            match string::byte_at lexeme idx:
                Option::Some esc:
                    match esc:
                        'x':
                            selfhost_literal_argument_char_hex_escape lexeme add idx 1 end span
                        'u':
                            selfhost_literal_argument_char_unicode_escape lexeme add idx 1 end span
                        _:
                            selfhost_literal_argument_char_simple_escape esc add idx 1 span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span

//: selfhost_literal_argument_char_value_from_lexeme: char literal を[意味値/いみち]へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - quote 付き token spelling から、checked payload に入れる semantic `char` を取り出します。
//: - 1 scalar value であることを checker 境界で検査し、lowering が source text を再読しない形を保ちます。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(value)`: `value` は char literal の semantic value です。
//: - `Err(CharMalformed)`: quote 境界、empty body、escape の構造、UTF-8 decode が不正です。
//: - `Err(CharEscapeUnsupported)`: 対応していない escape spelling です。
//: - `Err(CharInvalidScalar)`: unicode escape が Unicode scalar value ではありません。
//: - `Err(CharMultipleScalars)`: body に 2 個以上の scalar が含まれています。
//:
//: [計算量/けいさんりょう]:
//: - simple char は O(1)、unicode escape は digit 数 d に対して O(d) です。d は高々 6 です。
fn selfhost_literal_argument_char_value_from_lexeme %fn str fn SelfhostSourceSpan Result char SelfhostLiteralArgumentError \lexeme\span:
    let n %i32 string::len lexeme
    let end %i32 sub n 1
    if:
        not selfhost_literal_argument_char_quotes_valid lexeme n
        then:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
        else:
            if:
                le end 1
                then:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                else:
                    match string::byte_at lexeme 1:
                        Option::Some first:
                            let decoded_result %Result SelfhostLiteralCharDecode SelfhostLiteralArgumentError:
                                if:
                                    eq first '\\'
                                    then:
                                        selfhost_literal_argument_char_escape_from_lexeme lexeme 2 end span
                                    else:
                                        match string::str_next_char_result lexeme 1:
                                            Result::Ok item:
                                                let value %char field::get item "value"
                                                let next_index %i32 field::get item "next"
                                                Result::Ok selfhost_literal_char_decode_new value next_index
                                            Result::Err _e:
                                                Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span
                            match decoded_result:
                                Result::Ok decoded:
                                    if:
                                        eq decoded.next_index end
                                        then:
                                            Result::Ok decoded.value
                                        else:
                                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMultipleScalars span
                                Result::Err e:
                                    Result::Err e
                        Option::None:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::CharMalformed span

//: selfhost_literal_argument_checked_from_lexeme: literal kind と lexeme から checked argument を[作/つく]る
//:
//: [目的/もくてき]:
//: - prefix item の literal kind ごとに、checker が保存すべき payload variant を選びます。
//: - bool / i32 / f32 / char / string は値 payload にし、値 payload がまだ設計されていない literal は `TypedExpression` として fail-closed lowering に残します。
//: - `CharLiteral` は semantic `char` payload として保存します。後続 lowering は Rust 実装と同じ i32-backed HIR literal へ変換します。
//:
//: [契約/けいやく]:
//: - caller は、`item` が expected type と一致することを先に確認しています。この関数は型一致ではなく、値 payload の構築だけを担当します。
//: - `lexeme` は 1 token で完結する literal spelling です。負数 literal は `MinusMarker + numeric operand` の 2 item から作るため、この関数ではなく `selfhost_literal_argument_negative_checked_with_source` が扱います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(argument)`: checked argument payload を構築できました。
//: - `Err(error)`: literal spelling を意味値にできません。caller は owner を解放し、call reduction error へ写像します。
//:
//: [計算量/けいさんりょう]:
//: - Unit / unsupported literal は O(1)、bool / i32 / f32 / string は lexeme 長 n に対して O(n) です。
fn selfhost_literal_argument_checked_from_lexeme %fn str fn SelfhostExprPrefixItem fn i32 fn i32 fn SelfhostTypeId Result SelfhostCheckedArgument SelfhostLiteralArgumentError \lexeme\item\start_index\next_index\value_type:
    match item.kind:
        SelfhostExprPrefixItemKind::UnitValue:
            Result::Ok selfhost_checked_argument_unit_value start_index next_index value_type item.span
        SelfhostExprPrefixItemKind::BoolLiteral:
            match selfhost_literal_argument_bool_from_lexeme lexeme item.span:
                Result::Ok value:
                    Result::Ok selfhost_checked_argument_bool_literal start_index next_index value_type item.span value
                Result::Err e:
                    Result::Err e
        SelfhostExprPrefixItemKind::IntLiteral:
            match selfhost_literal_argument_i32_from_lexeme lexeme item.span:
                Result::Ok value:
                    Result::Ok selfhost_checked_argument_i32_literal start_index next_index value_type item.span value
                Result::Err e:
                    Result::Err e
        SelfhostExprPrefixItemKind::FloatLiteral:
            match selfhost_literal_argument_f32_from_lexeme lexeme item.span:
                Result::Ok value:
                    Result::Ok selfhost_checked_argument_f32_literal start_index next_index value_type item.span value
                Result::Err e:
                    Result::Err e
        SelfhostExprPrefixItemKind::StringLiteral:
            match selfhost_literal_argument_string_value_from_lexeme lexeme item.span:
                Result::Ok value:
                    Result::Ok selfhost_checked_argument_str_literal start_index next_index value_type item.span value
                Result::Err e:
                    Result::Err e
        SelfhostExprPrefixItemKind::CharLiteral:
            match selfhost_literal_argument_char_value_from_lexeme lexeme item.span:
                Result::Ok value:
                    Result::Ok selfhost_checked_argument_char_literal start_index next_index value_type item.span value
                Result::Err e:
                    Result::Err e
        _:
            Result::Ok selfhost_checked_argument_typed_expression start_index next_index value_type item.span

//: selfhost_literal_argument_negative_numeric_lexeme_from_source: 負号と operand token spelling から semantic lexeme を[作/つく]る
//:
//: [目的/もくてき]:
//: - `MinusMarker` と numeric operand の間に空白があっても、Rust parser と同じく `-` と operand token の spelling だけを結合した lexeme を作ります。
//: - joined span は診断範囲として使い、数値 parser へ渡す文字列 authority にはしません。`- 1` をそのまま slice して `"- 1"` として解析する退行を防ぎます。
//:
//: [契約/けいやく]:
//: - `operand_item` は `IntLiteral` または `FloatLiteral` の prefix item です。この関数は kind を再判定せず、caller が `literal_error_kind` を選びます。
//: - `span` は戻り値 payload と error の診断範囲です。実際の lexeme には、span 内の空白を含めません。
//: - `str_slice_result` または `concat_result` が失敗した場合は、caller が渡した literal error kind で fail-closed にします。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(lexeme)`: `-` と operand token spelling を連結した semantic numeric lexeme です。
//: - `Err(error)`: operand span の slice または semantic lexeme 構築に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - operand token spelling 長 n に対して O(n) です。
fn selfhost_literal_argument_negative_numeric_lexeme_from_source %fn str fn SelfhostExprPrefixItem fn SelfhostSourceSpan fn SelfhostLiteralArgumentErrorKind Result str SelfhostLiteralArgumentError \source\operand_item\span\literal_error_kind:
    match string::str_slice_result source operand_item.span.start operand_item.span.end:
        Result::Ok operand_lexeme:
            match string::concat_result "-" operand_lexeme:
                Result::Ok signed_lexeme:
                    Result::Ok signed_lexeme
                Result::Err _e:
                    Result::Err selfhost_literal_argument_error_new literal_error_kind span
        Result::Err _e:
            Result::Err selfhost_literal_argument_error_new literal_error_kind span

//: selfhost_literal_argument_negative_checked_with_source: `MinusMarker` と numeric operand から checked payload を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed argument checker が 2 item consume-width を確定した負数 numeric argument を、semantic `i32` / `f32` payload へ変換します。
//: - prefix list の flat 性を保ちながら、数値 parser へは `-` と operand token spelling だけを渡し、token 間 whitespace を意味値に混ぜません。
//:
//: [契約/けいやく]:
//: - `minus_item.kind` は `MinusMarker`、`operand_item.kind` は `IntLiteral` または `FloatLiteral`、`signed_item.kind` は operand と同じ numeric kind です。
//: - `signed_item.span` は診断と checked argument span に使う joined span です。semantic lexeme authority は `operand_item.span` の slice と `-` の連結です。
//: - token index は minus と operand の両方を範囲確認します。どちらかが範囲外なら `TokenOutOfBounds` を返し、panic や unchecked unwrap へ逃がしません。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(argument)`: HIR lowering に渡せる checked numeric literal payload です。`next_index` は caller が決めた 2 item consume-width の終端です。
//: - `Err(error)`: token 範囲、semantic lexeme 構築、または numeric parse の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - token 取得は O(1)、semantic lexeme 構築と numeric parse は operand spelling 長 n に対して O(n) です。
pub fn selfhost_literal_argument_negative_checked_with_source %fn &Vec SelfhostToken fn str fn SelfhostExprPrefixItem fn SelfhostExprPrefixItem fn SelfhostExprPrefixItem fn i32 fn i32 fn SelfhostTypeId Result SelfhostCheckedArgument SelfhostLiteralArgumentError \tokens\source\minus_item\operand_item\signed_item\start_index\next_index\value_type:
    match v::get tokens minus_item.token_index:
        Option::Some _minus_token:
            match v::get tokens operand_item.token_index:
                Option::Some _operand_token:
                    match signed_item.kind:
                        SelfhostExprPrefixItemKind::IntLiteral:
                            match selfhost_literal_argument_negative_numeric_lexeme_from_source source operand_item signed_item.span SelfhostLiteralArgumentErrorKind::I32Invalid:
                                Result::Ok lexeme:
                                    match selfhost_literal_argument_i32_from_lexeme lexeme signed_item.span:
                                        Result::Ok value:
                                            Result::Ok selfhost_checked_argument_i32_literal start_index next_index value_type signed_item.span value
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        SelfhostExprPrefixItemKind::FloatLiteral:
                            match selfhost_literal_argument_negative_numeric_lexeme_from_source source operand_item signed_item.span SelfhostLiteralArgumentErrorKind::F32Invalid:
                                Result::Ok lexeme:
                                    match selfhost_literal_argument_f32_from_lexeme lexeme signed_item.span:
                                        Result::Ok value:
                                            Result::Ok selfhost_checked_argument_f32_literal start_index next_index value_type signed_item.span value
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        _:
                            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::I32Invalid signed_item.span
                Option::None:
                    Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::TokenOutOfBounds operand_item.span
        Option::None:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::TokenOutOfBounds minus_item.span

//: selfhost_literal_argument_checked_with_source: literal item から checked payload を[作/つく]る
//:
//: [目的/もくてき]:
//: - source-backed argument checker が型一致を確認した後で呼び、実値が必要な literal だけを typed payload へ変換します。
//: - token buffer の範囲確認、item span からの lexeme 復元、literal 値解析をこの境界にまとめ、lower/hir 側へ source 依存を漏らしません。
//: - この関数は 1 token で完結する literal item 用です。`MinusMarker + numeric operand` の負数 argument は、token 間 whitespace を除外する必要があるため `selfhost_literal_argument_negative_checked_with_source` を使います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(argument)`: HIR lowering に渡せる checked argument payload です。
//: - `Err(error)`: token 参照または literal decode が失敗しました。caller は arena owner を解放して typed call-reduction error へ写像します。
//:
//: [計算量/けいさんりょう]:
//: - token 取得は O(1) です。
//: - lexeme 復元と literal 値解析は item spelling 長 n に対して O(n) です。
//: - HIR record や name scope は参照しないため、この境界で追加の探索空間を増やしません。
pub fn selfhost_literal_argument_checked_with_source %fn &Vec SelfhostToken fn str fn SelfhostExprPrefixItem fn i32 fn i32 fn SelfhostTypeId Result SelfhostCheckedArgument SelfhostLiteralArgumentError \tokens\source\item\start_index\next_index\value_type:
    match v::get tokens item.token_index:
        Option::Some _token:
            let lexeme %str string::str_slice source item.span.start item.span.end
            selfhost_literal_argument_checked_from_lexeme lexeme item start_index next_index value_type
        Option::None:
            Result::Err selfhost_literal_argument_error_new SelfhostLiteralArgumentErrorKind::TokenOutOfBounds item.span
