//: selfhost_private_effect_resource_graph_walker_place_operation_count_loop: place table 内の同じ operation ordinal を[数/かぞ]える
fn selfhost_private_effect_resource_graph_walker_place_operation_count_loop %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn i32 fn i32 fn i32 i32 \input\body\ordinal\idx\count:
    if:
        ge idx selfhost_private_effect_resource_graph_walker_place_len input
        then:
            count
        else:
            match selfhost_private_effect_resource_graph_walker_get_place input idx:
                Option::Some place:
                    if:
                        selfhost_private_effect_resource_graph_walker_place_matches_operation place body ordinal
                        then:
                            selfhost_private_effect_resource_graph_walker_place_operation_count_loop input body ordinal add idx 1 add count 1
                        else:
                            selfhost_private_effect_resource_graph_walker_place_operation_count_loop input body ordinal add idx 1 count
                Option::None:
                    add count 1

//: selfhost_private_effect_resource_graph_walker_edge_operation_count_loop: edge table 内の同じ operation ordinal を[数/かぞ]える
fn selfhost_private_effect_resource_graph_walker_edge_operation_count_loop %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn i32 fn i32 fn i32 i32 \input\body\ordinal\idx\count:
