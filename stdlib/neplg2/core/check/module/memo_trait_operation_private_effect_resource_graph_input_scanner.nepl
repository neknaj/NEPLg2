#import "./memo_trait_operation_private_effect_resource_no_escape_materializer" as *

//: SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason: graph walker が closed traversal にできなかった理由
pub enum SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason:
    UnknownResourceOperation
    UnknownPlaceRoot
    UnknownProjection
    UnknownCallBoundary
    PrivateCacheBoundaryUnsupported
    PrivateStateBoundaryUnsupported

//: SelfhostPrivateEffectResourceGraphWalkerBodyRecord: Resource walker が PrivateEffect method body ごとに返す graph header
pub struct SelfhostPrivateEffectResourceGraphWalkerBodyRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    graph_id %SelfhostPrivateEffectResourceGraphId
    completeness %SelfhostPrivateEffectResourceGraphCompleteness
    fresh_region %SelfhostPrivateEffectResourceFreshRegionEvidence

//: SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord: Resource walker が観測した place node
pub struct SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostPrivateEffectResourceGraphId
    operation_ordinal %i32
    place_id %SelfhostPrivateEffectResourcePlaceId
    kind %SelfhostPrivateEffectResourcePlaceKind

//: SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord: Resource walker が観測した graph edge
pub struct SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostPrivateEffectResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostPrivateEffectResourcePlaceId
    to_place %SelfhostPrivateEffectResourcePlaceId
    kind %SelfhostPrivateEffectResourceEdgeKind

//: SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord: no-escape traversal へ進めない Resource operation
pub struct SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostPrivateEffectResourceGraphId
    operation_ordinal %i32
    reason %SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason

//: SelfhostPrivateEffectResourceGraphWalkerInput: Resource walker event の session-local owner table
pub struct SelfhostPrivateEffectResourceGraphWalkerInput:
    bodies %Vec SelfhostPrivateEffectResourceGraphWalkerBodyRecord
    places %Vec SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord
    edges %Vec SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord
    unsupported %Vec SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord

//: SelfhostPrivateEffectResourceGraphInputScannerErrorKind: scanner の構造的な拒否理由
pub enum SelfhostPrivateEffectResourceGraphInputScannerErrorKind:
    WalkerBodyPushFailed %StdErrorKind
    WalkerPlaceEventPushFailed %StdErrorKind
    WalkerEdgeEventPushFailed %StdErrorKind
    WalkerUnsupportedEventPushFailed %StdErrorKind
    WalkerBodyReadFailed %i32
    WalkerPlaceEventReadFailed %i32
    WalkerEdgeEventReadFailed %i32
    WalkerUnsupportedEventReadFailed %i32
    GraphBodyDuplicate
    GraphOperationDuplicate
    GraphBodyMissing %i32
    EventForNonClosedGraph %i32
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    OperationOrdinalInvalid %i32
    PlaceIdInvalid %i32
    EdgeEndpointInvalid %i32
    EffectNotPrivate %SelfhostEffectKind
    EscapeNotApplicable %SelfhostEffectEscapeState
    OutputGraphInputAllocFailed %StdErrorKind
    OutputCollectorInputRejected %SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind

//: SelfhostPrivateEffectResourceGraphInputScannerStage0Summary: scanner smoke の代表結果
pub struct SelfhostPrivateEffectResourceGraphInputScannerStage0Summary:
    scanned_body_len %Result i32 SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    private_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    escape_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    unsupported_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    missing_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    fresh_missing_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    duplicate_ordinal_rejected %Result i32 SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    missing_body_event_rejected %Result i32 SelfhostPrivateEffectResourceGraphInputScannerErrorKind
    placeholder_rejected %Result i32 SelfhostPrivateEffectResourceGraphInputScannerErrorKind

//: Clone for SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason: unsupported reason は enum payload を[持/も]たないため bitwise copy で[複製/ふくせい]する
impl Clone for SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason:
    fn clone %fn &SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason \self:
        *self

