        SelfhostPrivateEffectResourceGraphCompleteness::TraversalUnsupported:
            false

//: selfhost_private_effect_resource_graph_walker_validate_operation_count_result: operation ordinal が一意か[確認/かくにん]する
fn selfhost_private_effect_resource_graph_walker_validate_operation_count_result %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn i32 Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \input\body\ordinal:
    if:
        eq selfhost_private_effect_resource_graph_walker_operation_count_for_body input body ordinal 1
        then:
            Result::Ok unit
        else:
            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphOperationDuplicate

//: selfhost_private_effect_resource_graph_walker_validate_all_bodies_loop: body table 全体を[検査/けんさ]する
fn selfhost_private_effect_resource_graph_walker_validate_all_bodies_loop %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn i32 Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \input\idx:
    if:
        ge idx selfhost_private_effect_resource_graph_walker_body_len input
        then:
            Result::Ok unit
        else:
            match selfhost_private_effect_resource_graph_walker_get_body input idx:
                Option::Some body:
                    match selfhost_private_effect_resource_graph_walker_validate_body_result body:
                        Result::Ok _unit:
                            if:
                                selfhost_private_effect_resource_graph_walker_contains_body_loop input body add idx 1
                                then:
                                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphBodyDuplicate
                                else:
                                    selfhost_private_effect_resource_graph_walker_validate_all_bodies_loop input add idx 1
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::WalkerBodyReadFailed idx

//: selfhost_private_effect_resource_graph_walker_validate_place_event_result: place event と所属 body を[検査/けんさ]する
fn selfhost_private_effect_resource_graph_walker_validate_place_event_result %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \input\place:
    match selfhost_private_effect_resource_graph_walker_validate_place_result place:
        Result::Ok _unit:
            match selfhost_private_effect_resource_graph_walker_find_body_for_place input place:
                Option::Some body:
                    if:
                        selfhost_private_effect_resource_graph_walker_body_accepts_events body
                        then:
                            selfhost_private_effect_resource_graph_walker_validate_operation_count_result input body place.operation_ordinal
                        else:
                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EventForNonClosedGraph body.graph_id.index
                Option::None:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphBodyMissing place.graph_id.index
