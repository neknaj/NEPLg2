//: selfhost_private_effect_resource_graph_walker_body_output_completeness: collector へ渡す completeness を[決/き]める
fn selfhost_private_effect_resource_graph_walker_body_output_completeness %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord SelfhostPrivateEffectResourceGraphCompleteness \input\body:
    match body.completeness:
        SelfhostPrivateEffectResourceGraphCompleteness::ClosedForPrivateEffectBody:
            if:
                selfhost_private_effect_resource_graph_walker_has_unsupported_event input body
                then:
                    SelfhostPrivateEffectResourceGraphCompleteness::TraversalUnsupported
                else:
                    SelfhostPrivateEffectResourceGraphCompleteness::ClosedForPrivateEffectBody
        SelfhostPrivateEffectResourceGraphCompleteness::ResourceGraphMissing:
            SelfhostPrivateEffectResourceGraphCompleteness::ResourceGraphMissing
        SelfhostPrivateEffectResourceGraphCompleteness::TraversalUnsupported:
            SelfhostPrivateEffectResourceGraphCompleteness::TraversalUnsupported

