//: selfhost_private_effect_resource_graph_walker_body_record_new: walker body record を[作/つく]る
pub fn selfhost_private_effect_resource_graph_walker_body_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostPrivateEffectResourceGraphId fn SelfhostPrivateEffectResourceGraphCompleteness fn SelfhostPrivateEffectResourceFreshRegionEvidence SelfhostPrivateEffectResourceGraphWalkerBodyRecord \type_id\operation\body_module_fingerprint\body_root\effect\escape\graph_id\completeness\fresh_region:
    SelfhostPrivateEffectResourceGraphWalkerBodyRecord type_id operation body_module_fingerprint body_root effect escape graph_id completeness fresh_region

//: selfhost_private_effect_resource_graph_walker_place_event_record_new: walker place event record を[作/つく]る
pub fn selfhost_private_effect_resource_graph_walker_place_event_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostPrivateEffectResourceGraphId fn i32 fn SelfhostPrivateEffectResourcePlaceId fn SelfhostPrivateEffectResourcePlaceKind SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord \type_id\operation\body_module_fingerprint\body_root\graph_id\operation_ordinal\place_id\kind:
    SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord type_id operation body_module_fingerprint body_root graph_id operation_ordinal place_id kind

//: selfhost_private_effect_resource_graph_walker_edge_event_record_new: walker edge event record を[作/つく]る
pub fn selfhost_private_effect_resource_graph_walker_edge_event_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostPrivateEffectResourceGraphId fn i32 fn SelfhostPrivateEffectResourcePlaceId fn SelfhostPrivateEffectResourcePlaceId fn SelfhostPrivateEffectResourceEdgeKind SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord \type_id\operation\body_module_fingerprint\body_root\graph_id\operation_ordinal\from_place\to_place\kind:
    SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord type_id operation body_module_fingerprint body_root graph_id operation_ordinal from_place to_place kind

//: selfhost_private_effect_resource_graph_walker_unsupported_event_record_new: walker unsupported event record を[作/つく]る
pub fn selfhost_private_effect_resource_graph_walker_unsupported_event_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostPrivateEffectResourceGraphId fn i32 fn SelfhostPrivateEffectResourceGraphWalkerUnsupportedReason SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord \type_id\operation\body_module_fingerprint\body_root\graph_id\operation_ordinal\reason:
    SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord type_id operation body_module_fingerprint body_root graph_id operation_ordinal reason

//: selfhost_private_effect_resource_graph_walker_input_new: [空/から]の walker input owner を[作/つく]る
pub fn selfhost_private_effect_resource_graph_walker_input_new %impure fn void Result SelfhostPrivateEffectResourceGraphWalkerInput StdErrorKind \void:
    let bodies_result %Result Vec SelfhostPrivateEffectResourceGraphWalkerBodyRecord StdErrorKind v::new
    match bodies_result:
        Result::Ok bodies:
            let places_result %Result Vec SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord StdErrorKind v::new
            match places_result:
                Result::Ok places:
                    let edges_result %Result Vec SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord StdErrorKind v::new
                    match edges_result:
                        Result::Ok edges:
                            let unsupported_result %Result Vec SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord StdErrorKind v::new
                            match unsupported_result:
                                Result::Ok unsupported:
                                    Result::Ok SelfhostPrivateEffectResourceGraphWalkerInput bodies places edges unsupported
                                Result::Err e:
                                    v::free edges
                                    v::free places
                                    v::free bodies
                                    Result::Err e
                        Result::Err e:
                            v::free places
                            v::free bodies
                            Result::Err e
                Result::Err e:
                    v::free bodies
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_private_effect_resource_graph_walker_input_free: walker input owner を[閉/と]じる
pub fn selfhost_private_effect_resource_graph_walker_input_free %impure fn SelfhostPrivateEffectResourceGraphWalkerInput unit \input:
    v::free field::get input "bodies"
    v::free field::get input "places"
    v::free field::get input "edges"
    v::free field::get input "unsupported"

