//: selfhost_private_effect_resource_graph_input_scanner_graph_id_eq: graph id が同じか[返/かえ]す
fn selfhost_private_effect_resource_graph_input_scanner_graph_id_eq %fn SelfhostPrivateEffectResourceGraphId fn SelfhostPrivateEffectResourceGraphId bool \a\b:
    eq a.index b.index

//: selfhost_private_effect_resource_graph_input_scanner_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
fn selfhost_private_effect_resource_graph_input_scanner_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            1
        StdErrorKind::OutOfMemory:
            2
        StdErrorKind::EmptyCollection:
            3
        StdErrorKind::IndexOutOfBounds:
            4
        StdErrorKind::KeyNotFound:
            5
        StdErrorKind::CapacityExceeded:
            6
        StdErrorKind::InvalidOperation:
            7
        StdErrorKind::InvalidUtf8:
            8
        StdErrorKind::ParseError:
            9
        StdErrorKind::IoError:
            10
        StdErrorKind::Other:
            11

//: selfhost_private_effect_resource_graph_input_scanner_effect_kind_code: effect kind を比較用 code へ[写/うつ]す
fn selfhost_private_effect_resource_graph_input_scanner_effect_kind_code %fn SelfhostEffectKind i32 \kind:
    match kind:
        SelfhostEffectKind::Pure:
            1
        SelfhostEffectKind::InternalAlloc:
            2
        SelfhostEffectKind::PrivateState:
            3
        SelfhostEffectKind::PrivateCache:
            4
        SelfhostEffectKind::UnsafeMemory:
            5
        SelfhostEffectKind::ExternalIo:
            6
        SelfhostEffectKind::Nondet:
            7

//: selfhost_private_effect_resource_graph_input_scanner_escape_state_code: escape state を比較用 code へ[写/うつ]す
fn selfhost_private_effect_resource_graph_input_scanner_escape_state_code %fn SelfhostEffectEscapeState i32 \state:
    match state:
        SelfhostEffectEscapeState::NotApplicable:
            1
        SelfhostEffectEscapeState::NoEscapeProven:
            2
        SelfhostEffectEscapeState::MayEscape:
            3

//: selfhost_private_effect_resource_graph_input_scanner_status_code: traversal status を比較用 code へ[写/うつ]す
fn selfhost_private_effect_resource_graph_input_scanner_status_code %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus i32 \status:
    match status:
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus::AllTraversedPlacesPrivate:
            1
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus::EscapingPlaceObserved:
            2
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus::ResourceGraphMissing:
            3
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus::TraversalUnsupported:
            4

//: selfhost_private_effect_resource_graph_input_scanner_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_private_effect_resource_graph_input_scanner_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_private_effect_resource_graph_walker_body_key_eq: body key が同じか[返/かえ]す
fn selfhost_private_effect_resource_graph_walker_body_key_eq %fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation
            and:
                eq a.body_module_fingerprint b.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                    and:
                        selfhost_effect_kind_eq a.effect b.effect
                        and:
                            selfhost_private_effect_resource_graph_input_scanner_escape_state_eq a.escape b.escape
                            selfhost_private_effect_resource_graph_input_scanner_graph_id_eq a.graph_id b.graph_id

//: selfhost_private_effect_resource_graph_walker_place_body_key_eq: body と place event の body key が同じか[返/かえ]す
fn selfhost_private_effect_resource_graph_walker_place_body_key_eq %fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord bool \body\place:
    and:
        selfhost_type_id_eq body.type_id place.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq body.operation place.operation
            and:
                eq body.body_module_fingerprint place.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index body.body_root selfhost_hir_expr_id_index place.body_root
                    selfhost_private_effect_resource_graph_input_scanner_graph_id_eq body.graph_id place.graph_id

//: selfhost_private_effect_resource_graph_walker_edge_body_key_eq: body と edge event の body key が同じか[返/かえ]す
fn selfhost_private_effect_resource_graph_walker_edge_body_key_eq %fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord bool \body\edge:
    and:
        selfhost_type_id_eq body.type_id edge.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq body.operation edge.operation
            and:
                eq body.body_module_fingerprint edge.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index body.body_root selfhost_hir_expr_id_index edge.body_root
                    selfhost_private_effect_resource_graph_input_scanner_graph_id_eq body.graph_id edge.graph_id

//: selfhost_private_effect_resource_graph_walker_unsupported_body_key_eq: body と unsupported event の body key が同じか[返/かえ]す
fn selfhost_private_effect_resource_graph_walker_unsupported_body_key_eq %fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord bool \body\unsupported:
    and:
        selfhost_type_id_eq body.type_id unsupported.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq body.operation unsupported.operation
            and:
                eq body.body_module_fingerprint unsupported.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index body.body_root selfhost_hir_expr_id_index unsupported.body_root
                    selfhost_private_effect_resource_graph_input_scanner_graph_id_eq body.graph_id unsupported.graph_id

//: selfhost_private_effect_resource_graph_input_scanner_effect_is_private: scanner が受理できる private effect か[返/かえ]す
fn selfhost_private_effect_resource_graph_input_scanner_effect_is_private %fn SelfhostEffectKind bool \effect:
    match effect:
        SelfhostEffectKind::Pure:
            false
        SelfhostEffectKind::InternalAlloc:
            false
        SelfhostEffectKind::PrivateState:
            true
        SelfhostEffectKind::PrivateCache:
            true
        SelfhostEffectKind::UnsafeMemory:
            false
        SelfhostEffectKind::ExternalIo:
            false
        SelfhostEffectKind::Nondet:
            false

//: selfhost_private_effect_resource_graph_walker_validate_body_result: body record の受理条件を[確認/かくにん]する
fn selfhost_private_effect_resource_graph_walker_validate_body_result %fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \body:
    if:
        eq body.body_module_fingerprint 0
        then:
            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt body.graph_id.index 0
                then:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphIdInvalid body.graph_id.index
                else:
                    if:
                        selfhost_private_effect_resource_graph_input_scanner_effect_is_private body.effect
                        then:
                            match body.escape:
                                SelfhostEffectEscapeState::NotApplicable:
                                    Result::Ok unit
                                SelfhostEffectEscapeState::NoEscapeProven:
                                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EscapeNotApplicable body.escape
                                SelfhostEffectEscapeState::MayEscape:
                                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EscapeNotApplicable body.escape
                        else:
                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EffectNotPrivate body.effect

//: selfhost_private_effect_resource_graph_walker_validate_place_result: place event の受理条件を[確認/かくにん]する
fn selfhost_private_effect_resource_graph_walker_validate_place_result %fn SelfhostPrivateEffectResourceGraphWalkerPlaceEventRecord Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \place:
    if:
        eq place.body_module_fingerprint 0
        then:
            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt place.graph_id.index 0
                then:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphIdInvalid place.graph_id.index
                else:
                    if:
                        lt place.operation_ordinal 0
                        then:
                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::OperationOrdinalInvalid place.operation_ordinal
                        else:
                            if:
                                lt place.place_id.index 0
                                then:
                                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::PlaceIdInvalid place.place_id.index
                                else:
                                    Result::Ok unit

//: selfhost_private_effect_resource_graph_walker_validate_edge_result: edge event の受理条件を[確認/かくにん]する
fn selfhost_private_effect_resource_graph_walker_validate_edge_result %fn SelfhostPrivateEffectResourceGraphWalkerEdgeEventRecord Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \edge:
    if:
        eq edge.body_module_fingerprint 0
        then:
            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt edge.graph_id.index 0
                then:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphIdInvalid edge.graph_id.index
                else:
                    if:
                        lt edge.operation_ordinal 0
                        then:
                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::OperationOrdinalInvalid edge.operation_ordinal
                        else:
                            if:
                                lt edge.from_place.index 0
                                then:
                                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EdgeEndpointInvalid edge.from_place.index
                                else:
                                    if:
                                        lt edge.to_place.index 0
                                        then:
                                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::EdgeEndpointInvalid edge.to_place.index
                                        else:
                                            Result::Ok unit

//: selfhost_private_effect_resource_graph_walker_validate_unsupported_result: unsupported event の受理条件を[確認/かくにん]する
fn selfhost_private_effect_resource_graph_walker_validate_unsupported_result %fn SelfhostPrivateEffectResourceGraphWalkerUnsupportedEventRecord Result unit SelfhostPrivateEffectResourceGraphInputScannerErrorKind \unsupported:
    if:
        eq unsupported.body_module_fingerprint 0
        then:
            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt unsupported.graph_id.index 0
                then:
                    Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::GraphIdInvalid unsupported.graph_id.index
                else:
                    if:
                        lt unsupported.operation_ordinal 0
                        then:
                            Result::Err SelfhostPrivateEffectResourceGraphInputScannerErrorKind::OperationOrdinalInvalid unsupported.operation_ordinal
                        else:
                            Result::Ok unit

//: selfhost_private_effect_resource_graph_walker_contains_body_loop: duplicate body を[探/さが]す
fn selfhost_private_effect_resource_graph_walker_contains_body_loop %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn i32 bool \input\body\idx:
    if:
        ge idx selfhost_private_effect_resource_graph_walker_body_len input
        then:
            false
        else:
            match selfhost_private_effect_resource_graph_walker_get_body input idx:
                Option::Some existing:
                    if:
                        selfhost_private_effect_resource_graph_walker_body_key_eq existing body
                        then:
                            true
                        else:
                            selfhost_private_effect_resource_graph_walker_contains_body_loop input body add idx 1
                Option::None:
                    true

