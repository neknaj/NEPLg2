//: selfhost_private_effect_resource_graph_walker_operation_count_for_body: body graph 内の operation ordinal 出現数を[数/かぞ]える
fn selfhost_private_effect_resource_graph_walker_operation_count_for_body %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord fn i32 i32 \input\body\ordinal:
    let place_count %i32 selfhost_private_effect_resource_graph_walker_place_operation_count_loop input body ordinal 0 0
    let edge_count %i32 selfhost_private_effect_resource_graph_walker_edge_operation_count_loop input body ordinal 0 place_count
    selfhost_private_effect_resource_graph_walker_unsupported_operation_count_loop input body ordinal 0 edge_count

