fn selfhost_private_effect_resource_graph_walker_body_emits_events %fn &SelfhostPrivateEffectResourceGraphWalkerInput fn SelfhostPrivateEffectResourceGraphWalkerBodyRecord bool \input\body:
    match selfhost_private_effect_resource_graph_walker_body_output_completeness input body:
        SelfhostPrivateEffectResourceGraphCompleteness::ClosedForPrivateEffectBody:
            true
        SelfhostPrivateEffectResourceGraphCompleteness::ResourceGraphMissing:
