//: selfhost_memo_trait_public_impl_surface_operation_proof_orchestrator_stage0_summary_eq: stage0 summary の代表 contract を[確認/かくにん]する
//:
//: [契約/けいやく]:
//: - accepted は Copy と Drop の 2 record を持ち、どちらも Proven です。
//: - zero hash は operation evidence connector の hash 0 rejection として保持されます。
pub fn selfhost_memo_trait_public_impl_surface_operation_proof_orchestrator_stage0_summary_eq %fn SelfhostMemoTraitPublicImplSurfaceOperationProofStage0Summary bool \summary:
    let accepted_ok %bool selfhost_memo_trait_public_impl_surface_operation_proof_result_summary_eq summary.accepted 2 SelfhostMemoTraitAggregateProofStatus::Proven SelfhostMemoTraitAggregateProofStatus::Proven
    let zero_hash_error %SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind:
        SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind::OperationEvidenceRejected SelfhostMemoTraitPublicImplOperationEvidenceConnectorErrorKind::PublicSurfaceHashMissing
    let zero_hash_ok %bool selfhost_memo_trait_public_impl_surface_operation_proof_result_error_eq summary.zero_hash_rejected zero_hash_error
    and accepted_ok zero_hash_ok

