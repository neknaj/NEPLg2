//: - operation evidence connector rejection は lower boundary の equality helper へ委譲します。
pub fn selfhost_memo_trait_public_impl_surface_operation_proof_orchestrator_error_kind_eq %fn SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind fn SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind::OperationEvidenceRejected a_operation:
            match b:
                SelfhostMemoTraitPublicImplSurfaceOperationProofOrchestratorErrorKind::OperationEvidenceRejected b_operation:
                    selfhost_memo_trait_public_impl_operation_evidence_connector_error_kind_eq a_operation b_operation

