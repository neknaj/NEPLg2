//: selfhost_memo_trait_public_impl_surface_operation_proof_stage0_candidate: stage0 用 operation impl candidate を[作/つく]る
//:
//: [契約/けいやく]:
//: - Copy は method / Drop evidence を必要としないため `NotRequired` を渡します。
//: - Drop は stage0 の Drop 増補済み state を表すため `PureDrop` を渡します。production function ではこの値を合成しません。
fn selfhost_memo_trait_public_impl_surface_operation_proof_stage0_candidate %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostMemoTraitOperationSourceIdentity fn i32 fn i32 SelfhostMemoTraitOperationImplCandidate \type_id\operation\source\shape_hash\ordinal:
    let header %SelfhostMemoTraitPublicImplHeaderInput selfhost_memo_trait_public_impl_surface_operation_proof_stage0_impl_header ordinal shape_hash
    let trait_application %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_public_impl_surface_operation_proof_stage0_trait_application source shape_hash
    let drop_evidence %SelfhostMemoTraitOperationDropEvidence:
        match operation:
            SelfhostMemoTraitOperationEvidenceKind::Copy:
                SelfhostMemoTraitOperationDropEvidence::NotRequired
            SelfhostMemoTraitOperationEvidenceKind::Drop:
                SelfhostMemoTraitOperationDropEvidence::PureDrop
            SelfhostMemoTraitOperationEvidenceKind::Eq:
                SelfhostMemoTraitOperationDropEvidence::NotRequired
            SelfhostMemoTraitOperationEvidenceKind::Hash:
                SelfhostMemoTraitOperationDropEvidence::NotRequired
    selfhost_memo_trait_operation_impl_candidate_new type_id operation header trait_application some 9401 SelfhostMemoTraitOperationMethodBodyEvidence::NotRequired drop_evidence

