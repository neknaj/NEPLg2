//: selfhost_memo_trait_operation_private_effect_resource_no_escape_record_new: Resource no-escape observation record を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord \type_id\operation\body_module_fingerprint\body_root\effect\escape\status:
    SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord type_id operation body_module_fingerprint body_root effect escape status

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_new: [空/から]の Resource no-escape observation table を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_new %impure fn void Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_free: Resource no-escape observation table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_free %impure fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_len: Resource no-escape observation record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_len %fn &SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_record_key_eq: 2 record が同じ method body observation key か[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_record_key_eq %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation
            and:
                eq a.body_module_fingerprint b.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                    and:
                        selfhost_effect_kind_eq a.effect b.effect
                        selfhost_memo_trait_operation_private_effect_resource_no_escape_escape_state_eq a.escape b.escape

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_effect: private effect だけを[受/う]け[入/い]れる
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_effect %fn SelfhostEffectKind Result unit SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind \effect:
    match effect:
        SelfhostEffectKind::PrivateState:
            Result::Ok unit
        SelfhostEffectKind::PrivateCache:
            Result::Ok unit
        SelfhostEffectKind::Pure:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEffectNotPrivate effect
        SelfhostEffectKind::InternalAlloc:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEffectNotPrivate effect
        SelfhostEffectKind::UnsafeMemory:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEffectNotPrivate effect
        SelfhostEffectKind::ExternalIo:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEffectNotPrivate effect
        SelfhostEffectKind::Nondet:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEffectNotPrivate effect

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_record_result: Resource observation record の受理条件を[確認/かくにん]する
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_record_result %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord Result unit SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind \record:
    if:
        eq record.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            match selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_effect record.effect:
                Result::Ok _effect_ok:
                    match record.escape:
                        SelfhostEffectEscapeState::NotApplicable:
                            Result::Ok unit
                        SelfhostEffectEscapeState::NoEscapeProven:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEscapeNotApplicable record.escape
                        SelfhostEffectEscapeState::MayEscape:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::RecordEscapeNotApplicable record.escape
                Result::Err e:
                    Result::Err e

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key_loop: input table 内の既存 key を[探/さが]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key_loop %fn &SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord fn i32 bool \table\record\idx:
    if:
        ge idx selfhost_memo_trait_operation_private_effect_resource_no_escape_table_len table
        then:
            false
        else:
            let records %&Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some existing:
                    if:
                        selfhost_memo_trait_operation_private_effect_resource_no_escape_record_key_eq existing record
                        then:
                            true
                        else:
                            selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key_loop table record add idx 1
                Option::None:
                    true

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key: input table に同じ key があるか[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key %fn &SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord bool \table\record:
    selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key_loop table record 0

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_table_push: Resource no-escape observation record を table に[追加/ついか]する
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_table_push %impure fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable impure fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind \table\record:
    match selfhost_memo_trait_operation_private_effect_resource_no_escape_validate_record_result record:
        Result::Ok _unit:
            if:
                selfhost_memo_trait_operation_private_effect_resource_no_escape_table_contains_key &table record
                then:
                    selfhost_memo_trait_operation_private_effect_resource_no_escape_table_free table
                    Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::ResourceRecordDuplicate
                else:
                    let records %Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeRecord field::get table "records"
                    match v::push records record:
                        Result::Ok next_records:
                            Result::Ok SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTable next_records
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind::ResourceRecordPushFailed error
        Result::Err error:
            selfhost_memo_trait_operation_private_effect_resource_no_escape_table_free table
            Result::Err error

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_status_to_proof_status: Resource status を gate proof status へ[写/うつ]す
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_status_to_proof_status %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus SelfhostMemoTraitOperationPrivateEffectNoEscapeProofStatus \status:
    match status:
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus::NoEscapeProven:
            SelfhostMemoTraitOperationPrivateEffectNoEscapeProofStatus::Proven
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus::MayEscape:
            SelfhostMemoTraitOperationPrivateEffectNoEscapeProofStatus::Refuted
        SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus::Missing:
            SelfhostMemoTraitOperationPrivateEffectNoEscapeProofStatus::Missing
