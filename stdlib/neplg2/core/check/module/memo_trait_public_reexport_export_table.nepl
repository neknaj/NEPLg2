//: selfhost_memo_trait_public_reexport_export_table_input_new: typed input を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は field をまとめるだけです。graph、ordinal、hash、count の検査は producer 本体で行います。
pub fn selfhost_memo_trait_public_reexport_export_table_input_new %fn i32 fn Option i32 fn SelfhostMemoTraitPublicReExportProjectionKind fn i32 fn Option i32 fn Option i32 SelfhostMemoTraitPublicReExportExportTableInput \module_index\ordinal\projection_kind\export_count\export_table_hash\dependency_public_surface_hash:
    SelfhostMemoTraitPublicReExportExportTableInput module_index ordinal projection_kind export_count export_table_hash dependency_public_surface_hash

//: selfhost_memo_trait_public_reexport_export_table_schema_version: re-export payload schema version
//:
//: [契約/けいやく]:
//: - projection kind、export count、export table hash の fold 形を変える場合はこの version を更新します。
fn selfhost_memo_trait_public_reexport_export_table_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_reexport_export_table_projection_kind_code: projection kind を stable code へ[写/うつ]す
fn selfhost_memo_trait_public_reexport_export_table_projection_kind_code %fn SelfhostMemoTraitPublicReExportProjectionKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicReExportProjectionKind::Wildcard:
            252701
        SelfhostMemoTraitPublicReExportProjectionKind::Selective:
            252702

//: selfhost_memo_trait_public_reexport_export_table_mix2: re-export payload hash 用の 2 field [混合/こんごう]
fn selfhost_memo_trait_public_reexport_export_table_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_reexport_export_table_mix3: re-export payload hash 用の 3 field [混合/こんごう]
fn selfhost_memo_trait_public_reexport_export_table_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_public_reexport_export_table_mix2 a b c

//: selfhost_memo_trait_public_reexport_export_table_mix4: re-export payload hash 用の 4 field [混合/こんごう]
fn selfhost_memo_trait_public_reexport_export_table_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_reexport_export_table_mix2 selfhost_memo_trait_public_reexport_export_table_mix2 a b selfhost_memo_trait_public_reexport_export_table_mix2 c d

//: selfhost_memo_trait_public_reexport_export_table_ordinal_result: ordinal を[検査/けんさ]する
fn selfhost_memo_trait_public_reexport_export_table_ordinal_result %fn Option i32 Result i32 SelfhostMemoTraitPublicReExportExportTableErrorKind \ordinal:
    match ordinal:
        Option::Some value:
            if:
                lt value 0
                then:
                    Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportOrdinalNegative
                else:
                    if:
                        eq value 0
                        then:
                            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportOrdinalPlaceholder
                        else:
                            Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportOrdinalMissing

//: selfhost_memo_trait_public_reexport_export_table_payload_seed_result: export table hash seed を[検査/けんさ]する
fn selfhost_memo_trait_public_reexport_export_table_payload_seed_result %fn Option i32 Result i32 SelfhostMemoTraitPublicReExportExportTableErrorKind \export_table_hash:
    match export_table_hash:
        Option::Some hash:
            if:
                eq hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportPayloadHashPlaceholder
                else:
                    Result::Ok hash
        Option::None:
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportPayloadHashMissing

//: selfhost_memo_trait_public_reexport_export_table_dependency_hash_result: target public surface hash を[検査/けんさ]する
fn selfhost_memo_trait_public_reexport_export_table_dependency_hash_result %fn Option i32 Result i32 SelfhostMemoTraitPublicReExportExportTableErrorKind \dependency_public_surface_hash:
    match dependency_public_surface_hash:
        Option::Some hash:
            if:
                eq hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::DependencyPublicSurfaceHashPlaceholder
                else:
                    Result::Ok hash
        Option::None:
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::DependencyPublicSurfaceHashMissing

//: selfhost_memo_trait_public_reexport_export_table_count_result: export count を[検査/けんさ]する
fn selfhost_memo_trait_public_reexport_export_table_count_result %fn i32 Result i32 SelfhostMemoTraitPublicReExportExportTableErrorKind \export_count:
    if:
        lt export_count 0
        then:
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::ExportCountNegative
        else:
            Result::Ok export_count

//: selfhost_memo_trait_public_reexport_export_table_payload_hash_result: re-export payload hash を[作/つく]る
//:
//: [目的/もくてき]:
//: - re-export export table projection を normalizer の `payload_hash` field に入れる stable payload hash へ変換します。
//:
//: [契約/けいやく]:
//: - accepted hash material は schema version、projection kind、export count、export table hash だけです。
//: - graph node index、dependency public surface hash、source text、span、path、alias、display name、diagnostic text は payload hash に入りません。
//: - `export_table_hash` が 0 の場合は placeholder として拒否します。public helper 単体でも accepted payload hash boundary を弱めません。
//: - 戻り値が `Ok` の場合、payload hash は nonzero です。
pub fn selfhost_memo_trait_public_reexport_export_table_payload_hash_result %fn SelfhostMemoTraitPublicReExportProjectionKind fn i32 fn i32 Result SelfhostMemoTraitPublicReExportExportTablePayloadHash SelfhostMemoTraitPublicReExportExportTableErrorKind \projection_kind\export_count\export_table_hash:
    match selfhost_memo_trait_public_reexport_export_table_payload_seed_result some export_table_hash:
        Result::Ok checked_export_table_hash:
            match selfhost_memo_trait_public_reexport_export_table_count_result export_count:
                Result::Ok checked_count:
                    let schema %i32 selfhost_memo_trait_public_reexport_export_table_schema_version
                    let kind_hash %i32 selfhost_memo_trait_public_reexport_export_table_projection_kind_code projection_kind
                    let payload_hash %i32 selfhost_memo_trait_public_reexport_export_table_mix4 252700 schema kind_hash selfhost_memo_trait_public_reexport_export_table_mix2 checked_count checked_export_table_hash
                    if:
                        eq payload_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::DerivedReExportPayloadHashPlaceholder
                        else:
                            Result::Ok SelfhostMemoTraitPublicReExportExportTablePayloadHash schema payload_hash
                Result::Err count_error:
                    Result::Err count_error
        Result::Err payload_error:
            Result::Err payload_error

//: selfhost_memo_trait_public_reexport_export_table_graph_node_result: graph node existence を[検査/けんさ]する
fn selfhost_memo_trait_public_reexport_export_table_graph_node_result %fn &SelfhostModuleGraph fn i32 Result unit SelfhostMemoTraitPublicReExportExportTableErrorKind \graph\module_index:
    match selfhost_module_graph_node_at graph module_index:
        Option::Some _node:
            Result::Ok unit
        Option::None:
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::GraphNodeUnavailable

//: selfhost_memo_trait_public_reexport_export_table_evidence_result: re-export evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - typed export table projection を既存 normalizer と互換な `SelfhostMemoTraitPublicSurfaceReExportEvidence` へ変換します。
//:
//: [契約/けいやく]:
//: - graph node、ordinal、export table hash、dependency public surface hash、export count をすべて検査してから evidence を作ります。
//: - `module_index` は evidence に残しますが、payload hash には混ぜません。normalizer 側でも graph existence を再検査します。
//: - 成功時の evidence は source text / span / path / alias / display name / diagnostic text を含みません。
pub fn selfhost_memo_trait_public_reexport_export_table_evidence_result %fn &SelfhostModuleGraph fn SelfhostMemoTraitPublicReExportExportTableInput Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind \graph\input:
    match selfhost_memo_trait_public_reexport_export_table_graph_node_result graph input.module_index:
        Result::Ok _node_ok:
            match selfhost_memo_trait_public_reexport_export_table_ordinal_result input.ordinal:
                Result::Ok ordinal:
                    match selfhost_memo_trait_public_reexport_export_table_payload_seed_result input.export_table_hash:
                        Result::Ok export_hash:
                            match selfhost_memo_trait_public_reexport_export_table_dependency_hash_result input.dependency_public_surface_hash:
                                Result::Ok dependency_hash:
                                    match selfhost_memo_trait_public_reexport_export_table_payload_hash_result input.projection_kind input.export_count export_hash:
                                        Result::Ok payload:
                                            Result::Ok SelfhostMemoTraitPublicSurfaceReExportEvidence input.module_index ordinal payload.root_hash some dependency_hash
                                        Result::Err payload_error:
                                            Result::Err payload_error
                                Result::Err dependency_error:
                                    Result::Err dependency_error
                        Result::Err payload_seed_error:
                            Result::Err payload_seed_error
                Result::Err ordinal_error:
                    Result::Err ordinal_error
        Result::Err graph_error:
            Result::Err graph_error

//: selfhost_memo_trait_public_reexport_export_table_seen_ordinal_loop: 既存入力に ordinal があるか[調/しら]べる
fn selfhost_memo_trait_public_reexport_export_table_seen_ordinal_loop %fn &Vec SelfhostMemoTraitPublicReExportExportTableInput fn i32 fn i32 fn i32 Result unit SelfhostMemoTraitPublicReExportExportTableErrorKind \inputs\idx\end\ordinal:
    if:
        ge idx end
        then:
            Result::Ok unit
        else:
            match v::get inputs idx:
                Option::Some previous:
                    match selfhost_memo_trait_public_reexport_export_table_ordinal_result previous.ordinal:
                        Result::Ok previous_ordinal:
                            if:
                                eq previous_ordinal ordinal
                                then:
                                    Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::DuplicateReExportOrdinal
                                else:
                                    selfhost_memo_trait_public_reexport_export_table_seen_ordinal_loop inputs add idx 1 end ordinal
                        Result::Err previous_error:
                            Result::Err previous_error
                Option::None:
                    Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::InputVectorReadFailed

//: selfhost_memo_trait_public_reexport_export_table_unique_ordinal_result: 現在位置より前の duplicate ordinal を[拒否/きょひ]する
//:
//: [契約/けいやく]:
//: - `current_index` は入力 vector の現在位置です。ordinal 自体は input record の field から読み、index から作りません。
fn selfhost_memo_trait_public_reexport_export_table_unique_ordinal_result %fn &Vec SelfhostMemoTraitPublicReExportExportTableInput fn i32 fn i32 Result unit SelfhostMemoTraitPublicReExportExportTableErrorKind \inputs\current_index\ordinal:
    selfhost_memo_trait_public_reexport_export_table_seen_ordinal_loop inputs 0 current_index ordinal

//: selfhost_memo_trait_public_reexport_export_table_push_evidence_result: evidence を output vector へ[追加/ついか]する
fn selfhost_memo_trait_public_reexport_export_table_push_evidence_result %impure fn Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitPublicSurfaceReExportEvidence Result Vec SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind \items\evidence:
    match v::push items evidence:
        Result::Ok next_items:
            Result::Ok next_items
        Result::Err push_error:
            v::free v::vec_push_error_vec push_error
            Result::Err SelfhostMemoTraitPublicReExportExportTableErrorKind::InputVectorAllocationFailed

//: selfhost_memo_trait_public_reexport_export_table_push_input_result: input 1 件を evidence vector へ[追加/ついか]する
fn selfhost_memo_trait_public_reexport_export_table_push_input_result %impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicReExportExportTableInput impure fn Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitPublicReExportExportTableInput impure fn i32 Result Vec SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind \graph\inputs\items\input\current_index:
    match selfhost_memo_trait_public_reexport_export_table_ordinal_result input.ordinal:
        Result::Ok ordinal:
            match selfhost_memo_trait_public_reexport_export_table_unique_ordinal_result inputs current_index ordinal:
                Result::Ok _unique:
                    match selfhost_memo_trait_public_reexport_export_table_evidence_result graph input:
                        Result::Ok evidence:
                            selfhost_memo_trait_public_reexport_export_table_push_evidence_result items evidence
                        Result::Err evidence_error:
                            v::free items
                            Result::Err evidence_error
                Result::Err duplicate_error:
                    v::free items
                    Result::Err duplicate_error
        Result::Err ordinal_error:
            v::free items
            Result::Err ordinal_error

