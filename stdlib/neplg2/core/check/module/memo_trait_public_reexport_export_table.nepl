#indent 4

//: # check/module/memo_trait_public_reexport_export_table
//: public re-export export table projection を `MemoKey` / `MemoValue` 用 public surface normalizer の re-export evidence へ[変換/へんかん]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface hash が re-export を source directive の文字列ではなく、loader / module graph が解決した export table projection と target module public surface hash から受け取れるようにします。
//: - re-export の accepted payload hash は、projection kind、export count、typed export table hash から作ります。import path、alias、source span、display name、diagnostic text は hash material にしません。
//: - `SelfhostMemoTraitPublicSurfaceReExportEvidence` を作り、既存 `selfhost_memo_trait_public_surface_normalizer_partial_input_items_result` の re-export vector へ合流できる境界にします。
//: - final hash、LocalMemoTrait seed との合成、ordinal 空間全体の missing check は、この module ではなく full public surface composer の責務として残します。
//:
//: [契約/けいやく]:
//: - public API は typed export table projection だけを受け取ります。VFS、loader source text、AST、diagnostic payload、HIR、Resource IR、backend artifact、proof store は accepted input に入りません。
//: - `ordinal` は caller が解決済み public surface ordinal として渡す必要があります。Vec index や source order から暗黙に採用しません。
//: - `module_index` は target module が graph 上に存在することを検査するためだけに使います。payload hash へ混ぜません。
//: - `export_table_hash` は re-export export table projection の stable hash です。source path や alias ではなく、解決済み export entry set から別 stage が作った typed hash でなければなりません。
//: - `dependency_public_surface_hash` は target module の typed public surface hash です。欠落と placeholder は別の enum error として拒否します。
//: - duplicate ordinal はこの producer でも fail-closed にします。full composer も後段で ordinal mismatch / missing を再検査します。
//: - facade にはまだ re-export しません。function signature、type layout header、impl header、re-export をまとめる orchestration boundary ができた時点で公開 API を再評価します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では caller supplied の typed export table hash を検査して evidence を作ります。export name resolution、selective export set の具体展開、target module public surface materialization は別 stage の責務です。
//: - duplicate ordinal check は入力件数 k に対して現在 O(k * k) です。これは契約を変えず、後続で sorted ordinal index や merge cursor に置き換えられます。
//:
//: [計算量/けいさんりょう]:
//: - single evidence 生成は graph node lookup を除いて O1 時間・O1 追加空間です。
//: - vector producer は duplicate ordinal scan のため O(k * k) 時間です。出力 evidence vector は O(k) 空間です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_reexport_export_table" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_reexport_export_table_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.accepted_count
//:     let checks2 checks_push checks1 check is_ok summary.wildcard_reexport
//:     let checks3 checks_push checks2 check is_ok summary.selective_reexport
//:     let checks4 checks_push checks3 check summary.wildcard_and_selective_differ
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_reexport_export_table_error_kind_eq unwrap_err summary.payload_hash_missing_rejected SelfhostMemoTraitPublicReExportExportTableErrorKind::ReExportPayloadHashMissing
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_reexport_export_table_error_kind_eq unwrap_err summary.dependency_hash_placeholder_rejected SelfhostMemoTraitPublicReExportExportTableErrorKind::DependencyPublicSurfaceHashPlaceholder
//:     let checks7 checks_push checks6 check selfhost_memo_trait_public_reexport_export_table_error_kind_eq unwrap_err summary.graph_node_missing_rejected SelfhostMemoTraitPublicReExportExportTableErrorKind::GraphNodeUnavailable
//:     let checks8 checks_push checks7 check selfhost_memo_trait_public_reexport_export_table_error_kind_eq unwrap_err summary.duplicate_ordinal_rejected SelfhostMemoTraitPublicReExportExportTableErrorKind::DuplicateReExportOrdinal
//:     let shown checks_print_report checks8
//:     checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/module/graph" as *
#import "neplg2/core/module/vfs" as *
#import "./memo_trait_public_surface_normalizer" as *

//: SelfhostMemoTraitPublicReExportProjectionKind: re-export export table projection の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - wildcard re-export と selective re-export の payload domain を分け、同じ export table hash と count でも public surface 上の意味を混同しないようにします。
pub enum SelfhostMemoTraitPublicReExportProjectionKind:
    Wildcard
    Selective

//: SelfhostMemoTraitPublicReExportExportTableInput: re-export producer の typed input
//:
//: [目的/もくてき]:
//: - graph target、public surface ordinal、projection kind、export table hash、target public surface hash を 1 record にまとめます。
//:
//: [契約/けいやく]:
//: - `module_index` は target module が graph に存在するかを確認するための index です。payload hash へは入れません。
//: - `ordinal` は public surface input stream 上の 1-origin ordinal です。`none` は欠落、0 は placeholder、負値は不正な ordinal として拒否します。
//: - `export_count` は projection に含まれる export entry 数です。負値は拒否します。
//: - `export_table_hash` は projection kind と export count だけでは区別できない export entry set の stable hash です。欠落と placeholder は別 variant で拒否します。
//: - `dependency_public_surface_hash` は target module の typed public surface hash です。target hash が無い re-export は final public surface hash を安定させられないため拒否します。
pub struct SelfhostMemoTraitPublicReExportExportTableInput:
    module_index %i32
    ordinal %Option i32
    projection_kind %SelfhostMemoTraitPublicReExportProjectionKind
    export_count %i32
    export_table_hash %Option i32
    dependency_public_surface_hash %Option i32

//: SelfhostMemoTraitPublicReExportExportTablePayloadHash: re-export payload の normalized fingerprint
//:
//: [目的/もくてき]:
//: - projection kind、export count、export table hash から作った payload hash を schema version と一緒に保持します。
//:
//: [契約/けいやく]:
//: - `root_hash` は nonzero でなければ accepted payload ではありません。
pub struct SelfhostMemoTraitPublicReExportExportTablePayloadHash:
    schema_version %i32
    root_hash %i32

//: SelfhostMemoTraitPublicReExportExportTableErrorKind: re-export export table producer の拒否理由
//:
//: [目的/もくてき]:
//: - graph existence、ordinal、payload hash seed、dependency public surface hash、vector allocation を bool や diagnostic string に潰さず保持します。
pub enum SelfhostMemoTraitPublicReExportExportTableErrorKind:
    InputVectorAllocationFailed
    InputVectorReadFailed
    GraphNodeUnavailable
    ReExportOrdinalMissing
    ReExportOrdinalPlaceholder
    ReExportOrdinalNegative
    ReExportPayloadHashMissing
    ReExportPayloadHashPlaceholder
    DependencyPublicSurfaceHashMissing
    DependencyPublicSurfaceHashPlaceholder
    ExportCountNegative
    DerivedReExportPayloadHashPlaceholder
    DuplicateReExportOrdinal

//: SelfhostMemoTraitPublicReExportExportTableStage0Summary: producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted wildcard / selective path と、payload hash、dependency hash、graph node、duplicate ordinal の fail-closed path をまとめます。
pub struct SelfhostMemoTraitPublicReExportExportTableStage0Summary:
    accepted_count %Result i32 SelfhostMemoTraitPublicReExportExportTableErrorKind
    wildcard_reexport %Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind
    selective_reexport %Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind
    wildcard_and_selective_differ %bool
    payload_hash_missing_rejected %Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind
    dependency_hash_placeholder_rejected %Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind
    graph_node_missing_rejected %Result SelfhostMemoTraitPublicSurfaceReExportEvidence SelfhostMemoTraitPublicReExportExportTableErrorKind
    duplicate_ordinal_rejected %Result unit SelfhostMemoTraitPublicReExportExportTableErrorKind

