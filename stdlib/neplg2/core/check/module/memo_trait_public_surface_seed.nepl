//: selfhost_memo_trait_public_surface_seed_registry_error_kind_eq: registry path error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_seed_registry_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind fn SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected public_error:
            match b:
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected other_public_error:
                    selfhost_memo_trait_public_surface_seed_error_kind_eq public_error other_public_error
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected candidate_error:
            match b:
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected _public_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected other_candidate_error:
                    selfhost_memo_trait_definition_scan_error_kind_eq candidate_error other_candidate_error
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected seed_error:
            match b:
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected _public_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected other_seed_error:
                    selfhost_memo_trait_stable_source_seed_registry_error_kind_eq seed_error other_seed_error

//: selfhost_memo_trait_public_surface_seed_kind_code: memo trait kind を Phase 1 signature seed code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_seed_kind_code %fn SelfhostMemoTraitSourceKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            701
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            702

//: selfhost_memo_trait_public_surface_seed_normalization_error_result: signature normalization error を public surface seed error へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - public surface seed の外部 contract は、現段階では key/value ごとの「trait body / method signature normalization unsupported」です。
//: - 詳細な header/body reason は `memo_trait_signature_shape` 側の stage0 と source policy で固定し、ここでは既存 seed error surface を保ちます。
fn selfhost_memo_trait_public_surface_seed_normalization_error_result %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitSignatureShapeErrorKind SelfhostMemoTraitPublicSurfaceSeedErrorKind \kind\_normalization_error:
    selfhost_memo_trait_public_surface_marker_trait_unsupported_result kind

//: selfhost_memo_trait_public_surface_seed_signature_from_normalization_result: normalization evidence から signature seed を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - accepted signature seed は normalization module が作った `normalized_signature_hash` だけです。source span、syntax range、source name は混ぜません。
//: - `none` や `some 0` は signature seed として扱わず、kind 別 placeholder error にします。
fn selfhost_memo_trait_public_surface_seed_signature_from_normalization_result %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitSignatureShapeEvidence Result i32 SelfhostMemoTraitPublicSurfaceSeedErrorKind \kind\evidence:
    match evidence.normalized_signature_hash:
        Option::Some signature_seed:
            if:
                eq signature_seed 0
                then:
                    match kind:
                        SelfhostMemoTraitSourceKind::MemoKeyTrait:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder
                        SelfhostMemoTraitSourceKind::MemoValueTrait:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder
                else:
                    Result::Ok signature_seed
        Option::None:
            match kind:
                SelfhostMemoTraitSourceKind::MemoKeyTrait:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder
                SelfhostMemoTraitSourceKind::MemoValueTrait:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder

//: selfhost_memo_trait_public_surface_seed_declaration_ordinal: well-known trait key を ordinal seed へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - source order や byte position は使いません。Phase 1 では compiler-known memo trait kind から固定 ordinal seed を作ります。
fn selfhost_memo_trait_public_surface_seed_declaration_ordinal %fn SelfhostMemoTraitSourceKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            1
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            2

//: selfhost_memo_trait_public_surface_seed_module_seed_value_result: module seed input を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_seed_module_seed_value_result %fn Option i32 fn SelfhostMemoTraitPublicSurfaceSeedErrorKind fn SelfhostMemoTraitPublicSurfaceSeedErrorKind Result i32 SelfhostMemoTraitPublicSurfaceSeedErrorKind \fingerprint\missing_error\placeholder_error:
    match fingerprint:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err placeholder_error
                else:
                    Result::Ok value
        Option::None:
            Result::Err missing_error

//: selfhost_memo_trait_public_surface_seed_module_seed_ready_result: external module seed が使えるか[検査/けんさ]する
fn selfhost_memo_trait_public_surface_seed_module_seed_ready_result %fn SelfhostMemoTraitStableSourceModuleSeed Result unit SelfhostMemoTraitPublicSurfaceSeedErrorKind \module_seed:
    match selfhost_memo_trait_public_surface_seed_module_seed_value_result module_seed.module_identity_hash SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedMissing SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedPlaceholder:
        Result::Ok _module_identity:
            match selfhost_memo_trait_public_surface_seed_module_seed_value_result module_seed.public_surface_hash SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedMissing SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedPlaceholder:
                Result::Ok _public_surface:
                    Result::Ok unit
                Result::Err public_error:
                    Result::Err public_error
        Result::Err module_error:
            Result::Err module_error

//: selfhost_memo_trait_public_surface_marker_trait_unsupported_result: marker trait ではない trait surface を[拒否/きょひ]する
//:
//: [契約/けいやく]:
//: - Phase 1 では marker trait だけを accepted path に通します。type annotation、lambda header、body がある trait は method signature normalization の対象なので、kind 別 error にします。
fn selfhost_memo_trait_public_surface_marker_trait_unsupported_result %fn SelfhostMemoTraitSourceKind SelfhostMemoTraitPublicSurfaceSeedErrorKind \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueTraitBodyNormalizationUnsupported

//: selfhost_memo_trait_public_surface_visibility_result: public marker trait か[検査/けんさ]する
fn selfhost_memo_trait_public_surface_visibility_result %fn SelfhostMemoTraitSourceKind fn SelfhostModuleDeclarationVisibility Result unit SelfhostMemoTraitPublicSurfaceSeedErrorKind \kind\visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Public:
            Result::Ok unit
        SelfhostModuleDeclarationVisibility::Private:
            match kind:
                SelfhostMemoTraitSourceKind::MemoKeyTrait:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility
                SelfhostMemoTraitSourceKind::MemoValueTrait:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility

//: selfhost_memo_trait_public_surface_trait_seed_result: marker trait seed を[作/つく]る
fn selfhost_memo_trait_public_surface_trait_seed_result %fn SelfhostMemoTraitSourceKind fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceTraitSeed SelfhostMemoTraitPublicSurfaceSeedErrorKind \kind\visibility\item:
    match selfhost_memo_trait_public_surface_visibility_result kind visibility:
        Result::Ok _visibility_ok:
            match item.declaration:
                Option::Some header:
                    match selfhost_memo_trait_signature_shape_result kind header item:
                        Result::Ok signature_evidence:
                            match selfhost_memo_trait_public_surface_seed_signature_from_normalization_result kind signature_evidence:
                                Result::Ok signature_seed:
                                    Result::Ok:
                                        selfhost_memo_trait_stable_source_trait_seed_new:
                                            kind
                                            visibility
                                            some selfhost_memo_trait_public_surface_seed_declaration_ordinal kind
                                            some signature_seed
                                Result::Err signature_error:
                                    Result::Err signature_error
                        Result::Err normalization_error:
                            Result::Err selfhost_memo_trait_public_surface_seed_normalization_error_result kind normalization_error
                Option::None:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing
        Result::Err visibility_error:
            Result::Err visibility_error

//: selfhost_memo_trait_public_surface_seed_table_add_name_result: classified trait name を seed table へ[反映/はんえい]する
fn selfhost_memo_trait_public_surface_seed_table_add_name_result %fn SelfhostMemoTraitStableSourceSeedTable fn str fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \table\name\visibility\item:
    if:
        string_search::str_eq name "MemoKey"
        then:
            let key_seed_result %Result SelfhostMemoTraitStableSourceTraitSeed SelfhostMemoTraitPublicSurfaceSeedErrorKind:
                selfhost_memo_trait_public_surface_trait_seed_result:
                    SelfhostMemoTraitSourceKind::MemoKeyTrait
                    visibility
                    item
            match key_seed_result:
                Result::Ok seed:
                    Result::Ok selfhost_memo_trait_stable_source_seed_table_add_record table seed
                Result::Err seed_error:
                    Result::Err seed_error
        else:
            if:
                string_search::str_eq name "MemoValue"
                then:
                    let value_seed_result %Result SelfhostMemoTraitStableSourceTraitSeed SelfhostMemoTraitPublicSurfaceSeedErrorKind:
                        selfhost_memo_trait_public_surface_trait_seed_result:
                            SelfhostMemoTraitSourceKind::MemoValueTrait
                            visibility
                            item
                    match value_seed_result:
                        Result::Ok seed:
                            Result::Ok selfhost_memo_trait_stable_source_seed_table_add_record table seed
                        Result::Err seed_error:
                            Result::Err seed_error
                else:
                    Result::Ok table

//: selfhost_memo_trait_public_surface_seed_table_scan_trait_name_result: trait head 名を分類して seed table へ[追加/ついか]する
fn selfhost_memo_trait_public_surface_seed_table_scan_trait_name_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem fn SelfhostSourceSpan Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\table\visibility\item\span:
    if:
        not source_span_is_valid span
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable
        else:
            match string_slice::str_slice_result source span.start span.end:
                Result::Ok name:
                    selfhost_memo_trait_public_surface_seed_table_add_name_result table name visibility item
                Result::Err _slice_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable

//: selfhost_memo_trait_public_surface_seed_table_scan_trait_header_result: trait header を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_seed_table_scan_trait_header_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem fn SelfhostModuleDeclarationHeader Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\table\item\header:
    match header.head:
        Option::Some head:
            match head.kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    selfhost_memo_trait_public_surface_seed_table_scan_trait_name_result source table header.visibility item head.span
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing

//: selfhost_memo_trait_public_surface_seed_table_scan_trait_item_result: trait item を seed table へ[反映/はんえい]する
fn selfhost_memo_trait_public_surface_seed_table_scan_trait_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\table\item:
    match item.declaration:
        Option::Some header:
            match header.kind:
                SelfhostModuleDeclarationKind::Trait:
                    selfhost_memo_trait_public_surface_seed_table_scan_trait_header_result source table item header
                SelfhostModuleDeclarationKind::Function:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Struct:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Enum:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Impl:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing

//: selfhost_memo_trait_public_surface_seed_public_decl_supported_result: non-trait declaration を seed scan 内で fail-closed に[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - hash materializer が unsupported surface 専用の前置走査を持たず、この seed scan の 1 pass だけで local memo trait pair surface の限界を検査できるようにします。
//:
//: [契約/けいやく]:
//: - private non-trait declaration は public surface に出ないため無視します。
//: - public function / struct / enum / impl は、full public surface materializer が入るまで kind 別の typed error として拒否します。
fn selfhost_memo_trait_public_surface_seed_public_decl_supported_result %fn SelfhostModuleItem fn SelfhostMemoTraitPublicSurfaceSeedErrorKind Result unit SelfhostMemoTraitPublicSurfaceSeedErrorKind \item\public_error:
    match item.declaration:
        Option::Some header:
            match header.visibility:
                SelfhostModuleDeclarationVisibility::Public:
                    Result::Err public_error
                SelfhostModuleDeclarationVisibility::Private:
                    Result::Ok unit
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing

//: selfhost_memo_trait_public_surface_seed_table_scan_non_declaration_item_result: declaration ではない module item を public surface seed scan に[反映/はんえい]する
//:
//: [目的/もくてき]:
//: - AST-only scan と token-aware scan が、directive / raw block / doc comment の扱いを別々に持たないようにします。
//: - declaration item の分類は `selfhost_module_item_kind_declaration` に寄せ、この helper は「declaration ではない item」の policy だけを担当します。
//:
//: [契約/けいやく]:
//: - import / use / prelude / no-prelude は Phase 1 の local memo trait pair surface を越えるため fail-closed にします。
//: - doc comment、test directive、target/profile/capability 条件、raw backend text は public memo trait seed を増減させないため table をそのまま返します。
//: - declaration kind がここへ到達した場合は caller の分類境界が壊れているため、typed error で拒否します。
fn selfhost_memo_trait_public_surface_seed_table_scan_non_declaration_item_result %fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItemKind Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \table\kind:
    match kind:
        SelfhostModuleItemKind::DocComment:
            Result::Ok table
        SelfhostModuleItemKind::MlstrLine:
            Result::Ok table
        SelfhostModuleItemKind::EntryDirective:
            Result::Ok table
        SelfhostModuleItemKind::TargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::ImportDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::ImportSurfaceUnsupported
        SelfhostModuleItemKind::UseDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::UseSurfaceUnsupported
        SelfhostModuleItemKind::TestDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfTargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfProfileDirective:
            Result::Ok table
        SelfhostModuleItemKind::CapabilityDirective:
            Result::Ok table
        SelfhostModuleItemKind::PreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::PreludeSurfaceUnsupported
        SelfhostModuleItemKind::NoPreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::NoPreludeSurfaceUnsupported
        SelfhostModuleItemKind::IntrinsicDirective:
            Result::Ok table
        SelfhostModuleItemKind::WasmBlock:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrBlock:
            Result::Ok table
        SelfhostModuleItemKind::WasmText:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrText:
            Result::Ok table
        SelfhostModuleItemKind::TraitDecl:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
        SelfhostModuleItemKind::FunctionDecl:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported
        SelfhostModuleItemKind::StructDecl:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported
        SelfhostModuleItemKind::EnumDecl:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported
        SelfhostModuleItemKind::ImplDecl:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported

//: selfhost_memo_trait_public_surface_seed_table_scan_declaration_item_result: declaration item 1 件を AST-only seed table へ[反映/はんえい]する
//:
//: [目的/もくてき]:
//: - module item kind から declaration kind への対応は `module_ast` の shared helper に任せます。
//: - public non-trait declaration の fail-closed 判定はここへ集約し、token-aware path と同じ classification 境界を使います。
fn selfhost_memo_trait_public_surface_seed_table_scan_declaration_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem fn SelfhostModuleDeclarationKind Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\table\item\declaration_kind:
    match declaration_kind:
        SelfhostModuleDeclarationKind::Trait:
            selfhost_memo_trait_public_surface_seed_table_scan_trait_item_result source table item
        SelfhostModuleDeclarationKind::Function:
            match selfhost_memo_trait_public_surface_seed_public_decl_supported_result item SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleDeclarationKind::Struct:
            match selfhost_memo_trait_public_surface_seed_public_decl_supported_result item SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleDeclarationKind::Enum:
            match selfhost_memo_trait_public_surface_seed_public_decl_supported_result item SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleDeclarationKind::Impl:
            match selfhost_memo_trait_public_surface_seed_public_decl_supported_result item SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error

//: selfhost_memo_trait_public_surface_seed_table_scan_item_result: item 1 件を seed table へ[反映/はんえい]する
fn selfhost_memo_trait_public_surface_seed_table_scan_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\table\item:
    match selfhost_module_item_kind_declaration item.kind:
        Option::Some declaration_kind:
            selfhost_memo_trait_public_surface_seed_table_scan_declaration_item_result source table item declaration_kind
        Option::None:
            selfhost_memo_trait_public_surface_seed_table_scan_non_declaration_item_result table item.kind

//: selfhost_memo_trait_public_surface_seed_table_scan_module_loop: module item stream を[走査/そうさ]する
fn selfhost_memo_trait_public_surface_seed_table_scan_module_loop %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceSeedTable fn i32 fn i32 Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\ast\table\idx\n:
    if:
        ge idx n
        then:
            Result::Ok table
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    match selfhost_memo_trait_public_surface_seed_table_scan_item_result source table item:
                        Result::Ok next_table:
                            selfhost_memo_trait_public_surface_seed_table_scan_module_loop source ast next_table add idx 1 n
                        Result::Err error:
                            Result::Err error
                Option::None:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_seed_table_complete_result: seed table の必須 slot を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_seed_table_complete_result %fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \table:
    if:
        table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate
        else:
            if:
                table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate
                else:
                    match table.memo_key:
                        Option::Some _key_seed:
                            match table.memo_value:
                                Option::Some _value_seed:
                                    Result::Ok table
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing

//: selfhost_memo_trait_public_surface_seed_scan_module_result: module AST から public marker trait seed table を[作/つく]る
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` の public marker trait declaration を seed table に集めます。
//:
//: [契約/けいやく]:
//: - この API は registry へ進みません。candidate scanner や module seed とは分離した scan payload を返します。
pub fn selfhost_memo_trait_public_surface_seed_scan_module_result %fn str fn &SelfhostModuleAst Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\ast:
    match selfhost_memo_trait_public_surface_seed_table_scan_module_loop source ast selfhost_memo_trait_stable_source_seed_table_empty 0 selfhost_module_ast_len ast:
        Result::Ok table:
            match selfhost_memo_trait_public_surface_seed_table_complete_result table:
                Result::Ok complete_table:
                    Result::Ok selfhost_memo_trait_public_surface_seed_scan_new complete_table
                Result::Err complete_error:
                    Result::Err complete_error
        Result::Err scan_error:
            Result::Err scan_error

//: selfhost_memo_trait_public_surface_seed_error_from_token_seed_scan_error: shared core error を seed error へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - token-aware shared core を seed module の公開 error surface へ接続します。
//:
//: [契約/けいやく]:
//: - method signature error payload は key/value ごとの seed error variant へ保持します。
//: - candidate missing / duplicate と unsupported public surface は、従来の seed scan と同じ variant へ写します。
fn selfhost_memo_trait_public_surface_seed_error_from_token_seed_scan_error %fn SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind SelfhostMemoTraitPublicSurfaceSeedErrorKind \error:
    match error:
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::ItemUnavailable:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::TraitHeaderMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::TraitHeaderKindMismatch:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::TraitHeadMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::TraitHeadKindMismatch:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::TraitNameUnavailable:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeyCandidateMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValueCandidateMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeyCandidateDuplicate:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValueCandidateDuplicate:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeyPrivateVisibility:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValuePrivateVisibility:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeyTraitBodyNormalizationUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValueTraitBodyNormalizationUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueTraitBodyNormalizationUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeyMethodSignatureRejected method_error:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyMethodSignatureRejected method_error
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValueMethodSignatureRejected method_error:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueMethodSignatureRejected method_error
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoKeySignatureSeedPlaceholder:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::MemoValueSignatureSeedPlaceholder:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::ImportSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::ImportSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::UseSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::UseSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PreludeSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PreludeSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::NoPreludeSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::NoPreludeSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PublicFunctionSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PublicStructSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PublicEnumSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PublicImplSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::DeclarationHeaderMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing

//: selfhost_memo_trait_public_surface_seed_scan_module_with_tokens_result: token-aware module AST から public trait seed table を[作/つく]る
//:
//: [目的/もくてき]:
//: - parser が作った token stream と AST を shared core へ渡し、marker trait と method-bearing trait を同じ seed table へ正規化します。
//:
//: [契約/けいやく]:
//: - token stream は `ast` と同じ parser input から来ている必要があります。この関数は source を再 lex せず、caller が保持している lexer/parser authority を使います。
//: - accepted seed は normalizer evidence の `normalized_signature_hash` だけから取り出します。
fn selfhost_memo_trait_public_surface_seed_scan_module_with_tokens_result %impure fn str impure fn &Vec SelfhostToken impure fn &SelfhostModuleAst Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\tokens\ast:
    match selfhost_memo_trait_public_surface_token_seed_scan_module_result source tokens ast:
        Result::Ok complete_table:
            Result::Ok selfhost_memo_trait_public_surface_seed_scan_new complete_table
        Result::Err token_error:
            Result::Err selfhost_memo_trait_public_surface_seed_error_from_token_seed_scan_error token_error

//: selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_result: public surface seed 経由で registry を[作/つく]る
//:
//: [目的/もくてき]:
//: - scanner candidate、public surface seed、stable evidence producer、fingerprint gate、registry validator を順に接続します。
//:
//: [契約/けいやく]:
//: - accepted registry はこの関数では構築しません。既存 seed evidence API と registry validator の結果を返します。
pub fn selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_result %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceModuleSeed Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \source\ast\module_seed:
    match selfhost_memo_trait_public_surface_seed_module_seed_ready_result module_seed:
        Result::Ok _module_seed_ok:
            match selfhost_memo_trait_definition_source_table_scan_module_result source ast:
                Result::Ok candidates:
                    match selfhost_memo_trait_public_surface_seed_scan_module_result source ast:
                        Result::Ok scan:
                            match selfhost_memo_trait_trusted_source_registry_from_seed_evidence_result candidates module_seed scan.seed_table:
                                Result::Ok registry:
                                    Result::Ok registry
                                Result::Err seed_error:
                                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected seed_error
                        Result::Err public_error:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected public_error
                Result::Err candidate_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected candidate_error
        Result::Err module_error:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected module_error

//: selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_with_tokens_result: token-aware public surface seed 経由で registry を[作/つく]る
//:
//: [目的/もくてき]:
//: - 実 stdlib の method-bearing `MemoKey` / `MemoValue` trait definition を、candidate scanner、token-aware public surface seed、stable evidence producer、registry validator の順に通します。
//:
//: [契約/けいやく]:
//: - AST-only wrapper と異なり、この関数は method body signature の正規化に必要な token stream を受け取ります。
//: - candidate scanner は AST の公開名分類だけを行い、signature availability は token-aware seed evidence producer で与えます。
fn selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_with_tokens_result %impure fn str impure fn &Vec SelfhostToken impure fn &SelfhostModuleAst impure fn SelfhostMemoTraitStableSourceModuleSeed Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \source\tokens\ast\module_seed:
    match selfhost_memo_trait_public_surface_seed_module_seed_ready_result module_seed:
        Result::Ok _module_seed_ok:
            match selfhost_memo_trait_definition_source_table_scan_module_result source ast:
                Result::Ok candidates:
                    match selfhost_memo_trait_public_surface_seed_scan_module_with_tokens_result source tokens ast:
                        Result::Ok scan:
                            match selfhost_memo_trait_trusted_source_registry_from_seed_evidence_result candidates module_seed scan.seed_table:
                                Result::Ok registry:
                                    Result::Ok registry
                                Result::Err seed_error:
                                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected seed_error
                        Result::Err public_error:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected public_error
                Result::Err candidate_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected candidate_error
        Result::Err module_error:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected module_error

//: selfhost_memo_trait_public_surface_stage0_module_seed: stage0 用 external module seed を[作/つく]る
fn selfhost_memo_trait_public_surface_stage0_module_seed %fn void SelfhostMemoTraitStableSourceModuleSeed \void:
    selfhost_memo_trait_stable_source_module_seed_new (some 301) (some 401)

//: selfhost_memo_trait_public_surface_stage0_header_named: stage0 用 declaration header を[作/つく]る
