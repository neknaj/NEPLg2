#indent 4

//: # check/module/memo_trait_public_surface_seed
//: `MemoKey` / `MemoValue` trait declaration の public surface seed を `SelfhostModuleAst` から[作/つく]る Phase 1 接続層です。
//:
//: [目的/もくてき]:
//: - parser が作った typed module item stream から、`MemoKey` / `MemoValue` の public marker trait definition だけを stable source seed table へ投影します。
//: - scanner candidate table、public surface seed、stable evidence producer、fingerprint gate、trusted registry validator の順に通し、どの段階でも source spelling や span から trusted source identity を直接作らないようにします。
//: - `core/ty` と proof store が syntax AST を読む逆依存を作らないよう、AST 走査は `core/check/module` 側に閉じます。
//:
//: [契約/けいやく]:
//: - source text slicing は `MemoKey` / `MemoValue` の候補分類にだけ使います。slice 結果、display name、path suffix、diagnostic text、source span、syntax range は accepted fingerprint payload に混ぜません。
//: - module identity seed と public surface seed は caller が `SelfhostMemoTraitStableSourceModuleSeed` として渡します。この module は module path や file path から identity を作りません。
//: - Phase 1 accepted path は public marker trait だけです。trait body / method signature normalization が必要な trait は typed error で拒否し、未正規化 signature を accepted path に流しません。
//: - 成功時も registry を直接組み立てず、既存 `selfhost_memo_trait_trusted_source_registry_from_seed_evidence_result` を経由します。
//:
//: [現状/げんじょう]:
//: - これは full public surface materializer ではありません。re-export、trait body、method signature、bound list、stable nominal key、serialized `.neplmeta` / `.neplproof` 入力は後続 slice の責務です。
//: - 現在の `MemoKey` / `MemoValue` stdlib trait は method を持つため、この Phase 1 materializer は marker trait smoke と責務境界の固定を目的にしています。実 stdlib definition へ接続するには trait body / method signature normalization を先に実装します。
//:
//: [計算量/けいさんりょう]:
//: - module item stream を 1 回走査するため、item 数 n に対して O(n) 時間です。
//: - seed table は `MemoKey` / `MemoValue` の固定 2 slot なので O(1) 追加空間です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_surface_seed" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_surface_seed_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.accepted_registry
//:     let checks2 checks_push checks1 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.private_visibility_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility
//:     let checks3 checks_push checks2 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.trait_body_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.duplicate_key_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.missing_value_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.malformed_header_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing
//:     let checks7 checks_push checks6 check selfhost_memo_trait_public_surface_seed_error_kind_eq (unwrap_err summary.trait_header_rejected) SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported
//:     let shown checks_print_report checks7
//:     checks_exit_code shown
//: ```

#import "alloc/string/slice" as string_slice
#import "alloc/string/search" as string_search
#import "alloc/hash/hash32" as *
#import "core/math" as *
