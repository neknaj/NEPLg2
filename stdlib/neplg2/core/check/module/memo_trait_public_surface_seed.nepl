    selfhost_module_item_new_with_declaration_and_body:
        SelfhostModuleItemKind::TraitDecl
        lexeme
        selfhost_memo_trait_public_surface_stage0_header_named SelfhostModuleDeclarationVisibility::Public start end
        body

//: selfhost_memo_trait_public_surface_stage0_trait_item_with_type_annotation: type annotation 付き trait item を[作/つく]る
fn selfhost_memo_trait_public_surface_stage0_trait_item_with_type_annotation %fn i32 fn i32 fn str SelfhostModuleItem \start\end\lexeme:
    let span %SelfhostSourceSpan source_span_new_unchecked 0 start end
