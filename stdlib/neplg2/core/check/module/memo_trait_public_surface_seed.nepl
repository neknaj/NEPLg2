//: selfhost_memo_trait_public_surface_stage0_two_item_registry_result: 2 item AST で registry result を[返/かえ]す
fn selfhost_memo_trait_public_surface_stage0_two_item_registry_result %impure fn str impure fn SelfhostModuleItem impure fn SelfhostModuleItem Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \source\first\second:
    match selfhost_module_ast_new:
        Result::Ok ast0:
            match selfhost_module_ast_push ast0 first:
                Result::Ok ast1:
                    match selfhost_module_ast_push ast1 second:
                        Result::Ok ast2:
                            let result %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
                                selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_result source &ast2 selfhost_memo_trait_public_surface_stage0_module_seed
                            selfhost_module_ast_free ast2
                            result
