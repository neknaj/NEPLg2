//: [目的/もくてき]:
//: - public seed registry path が method normalizer の typed error を payload として保持することを確認します。
fn selfhost_memo_trait_public_surface_stage0_wrong_method_source %fn void str \void:
    "pub trait MemoKey:\n    fn memo_key_eq %fn Self fn Self bool \\a\\b: false\npub trait MemoValue:\n    fn memo_value_mark %fn Self Self \\value: value\n"

//: selfhost_memo_trait_public_surface_stage0_method_registry_from_source_result: token-aware method-bearing registry path を[実行/じっこう]する
//:
//: [契約/けいやく]:
//: - lexer token owner と AST owner は、この helper の成功・失敗分岐で必ず閉じます。
//: - lex / parse diagnostic は stage0 の焦点ではないため、public surface rejected の typed sentinel に丸めます。parser/lexer 自体の詳細は各 module の stage0 が保持します。
fn selfhost_memo_trait_public_surface_stage0_method_registry_from_source_result %impure fn str Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \source:
    match lex_all source:
        Result::Ok tokens:
            match selfhost_parse_module_tokens source &tokens:
                Result::Ok ast:
                    let result %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
                        selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_with_tokens_result source &tokens &ast selfhost_memo_trait_public_surface_stage0_module_seed
                    selfhost_module_ast_free ast
                    v::free tokens
                    result
                Result::Err _parse_diag:
                    v::free tokens
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable
        Result::Err _lex_diag:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_seed_stage0: public surface seed の代表結果を[返/かえ]す
pub fn selfhost_memo_trait_public_surface_seed_stage0 %impure fn void SelfhostMemoTraitPublicSurfaceSeedStage0Summary \void:
    let source %str "MemoKeyMemoValue"
    let key_item %SelfhostModuleItem selfhost_memo_trait_public_surface_stage0_trait_item_named SelfhostModuleDeclarationVisibility::Public 0 7 "trait MemoKey:"
    let value_item %SelfhostModuleItem selfhost_memo_trait_public_surface_stage0_trait_item_named SelfhostModuleDeclarationVisibility::Public 7 16 "trait MemoValue:"
    let accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
        selfhost_memo_trait_public_surface_stage0_two_item_registry_result source key_item value_item
    let private_key_item %SelfhostModuleItem selfhost_memo_trait_public_surface_stage0_trait_item_named SelfhostModuleDeclarationVisibility::Private 0 7 "trait MemoKey:"
    let private_visibility_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind:
        selfhost_memo_trait_public_surface_stage0_two_item_scan_result source private_key_item value_item
    let body_key_item %SelfhostModuleItem selfhost_memo_trait_public_surface_stage0_trait_item_with_body 0 7 "trait MemoKey:"
