    selfhost_module_declaration_header_new:
        SelfhostModuleDeclarationKind::Trait
        visibility
        source_span_new_unchecked 0 start end
        source_span_new_unchecked 0 start start
        some head
        selfhost_syntax_range_empty
        selfhost_syntax_range_empty

//: selfhost_memo_trait_public_surface_stage0_trait_item_named: stage0 用 marker trait item を[作/つく]る
fn selfhost_memo_trait_public_surface_stage0_trait_item_named %fn SelfhostModuleDeclarationVisibility fn i32 fn i32 fn str SelfhostModuleItem \visibility\start\end\lexeme:
    selfhost_module_item_new_with_declaration:
