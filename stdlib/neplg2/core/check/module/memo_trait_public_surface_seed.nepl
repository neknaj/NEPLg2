#import "neplg2/core/syntax/parser/module_parser" as *
#import "neplg2/core/syntax/token" as *
#import "neplg2/core/ty/ty/memo_trait_policy" as *
#import "neplg2/core/ty/ty/memo_trait_source" as *
#import "./memo_trait_method_signature" as *
#import "./memo_trait_public_surface_token_seed_scan" as *
#import "./memo_trait_signature_shape" as *
#import "./memo_trait_source_scan" as *
#import "./memo_trait_source_evidence_producer" as *

//: SelfhostMemoTraitPublicSurfaceSeedScan: public surface seed scan の成功 payload
//:
//: [目的/もくてき]:
//: - AST 走査から得た `MemoKey` / `MemoValue` seed table を、module seed や registry validator と混ぜずに保持します。
pub struct SelfhostMemoTraitPublicSurfaceSeedScan:
    seed_table %SelfhostMemoTraitStableSourceSeedTable

//: SelfhostMemoTraitPublicSurfaceSeedErrorKind: public surface seed 生成の拒否理由
//:
//: [目的/もくてき]:
//: - AST 不整合、候補欠落、重複、未対応 surface、module seed 欠落を bool や文字列に潰さず enum として保持します。
//:
//: [現状/げんじょう]:
//: - import / use / prelude / public non-trait declaration は、full public surface materializer が入るまでこの scan の 1 pass 内で fail-closed にします。
//: - `StableNominalKeyMissing` と `ReExportUnsupported` は、後続 slice で stable trait definition key と re-export public surface を接続するときの fail-closed variant です。
//: - token-aware accepted path は local public marker trait と正規化済み method-bearing trait を扱います。AST-only accepted path は token authority がないため marker trait に限定します。
//: - stable nominal / re-export の 2 variant は local trait pair だけを扱う現段階ではまだ実装経路から返しません。未使用 variant として残す理由を enum 上に明示し、次 slice で削除ではなく実経路へ接続します。
pub enum SelfhostMemoTraitPublicSurfaceSeedErrorKind:
    ItemUnavailable
    TraitHeaderMissing
    TraitHeaderKindMismatch
    TraitHeadMissing
    TraitHeadKindMismatch
    TraitNameUnavailable
    MemoKeyCandidateMissing
    MemoValueCandidateMissing
    MemoKeyCandidateDuplicate
    MemoValueCandidateDuplicate
    ModuleIdentitySeedMissing
    ModuleIdentitySeedPlaceholder
    PublicSurfaceSeedMissing
    PublicSurfaceSeedPlaceholder
    MemoKeyPrivateVisibility
    MemoValuePrivateVisibility
    MemoKeyTraitBodyNormalizationUnsupported
    MemoValueTraitBodyNormalizationUnsupported
    MemoKeyMethodSignatureRejected %SelfhostMemoTraitMethodSignatureErrorKind
    MemoValueMethodSignatureRejected %SelfhostMemoTraitMethodSignatureErrorKind
    MemoKeySignatureSeedPlaceholder
    MemoValueSignatureSeedPlaceholder
    StableNominalKeyMissing
    ReExportUnsupported
    ImportSurfaceUnsupported
    UseSurfaceUnsupported
    PreludeSurfaceUnsupported
    NoPreludeSurfaceUnsupported
    PublicFunctionSurfaceUnsupported
    PublicStructSurfaceUnsupported
    PublicEnumSurfaceUnsupported
    PublicImplSurfaceUnsupported
    DeclarationHeaderMissing

//: SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind: public surface seed から registry までの拒否理由
//:
//: [目的/もくてき]:
//: - public surface seed の拒否、candidate scanner の拒否、既存 seed / stable source gate の拒否を別 variant として保持します。
pub enum SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
    PublicSurfaceRejected %SelfhostMemoTraitPublicSurfaceSeedErrorKind
    CandidateScanRejected %SelfhostMemoTraitDefinitionScanErrorKind
    SeedRegistryRejected %SelfhostMemoTraitStableSourceSeedRegistryErrorKind

//: SelfhostMemoTraitPublicSurfaceSeedStage0Summary: public surface seed smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted marker trait path と、private visibility、trait body unsupported、trait header unsupported、duplicate、missing、malformed header の fail-closed path をまとめます。
pub struct SelfhostMemoTraitPublicSurfaceSeedStage0Summary:
    accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind
    private_visibility_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    trait_body_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    trait_header_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    duplicate_key_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    missing_value_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    malformed_header_rejected %Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind
    method_surface_accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind
    method_surface_rejected_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind

impl Clone for SelfhostMemoTraitPublicSurfaceSeedScan:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedScan \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceSeedScan:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedScan \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceSeedErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceSeedErrorKind SelfhostMemoTraitPublicSurfaceSeedErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceSeedErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceSeedErrorKind SelfhostMemoTraitPublicSurfaceSeedErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceSeedStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceSeedStage0Summary SelfhostMemoTraitPublicSurfaceSeedStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceSeedStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceSeedStage0Summary SelfhostMemoTraitPublicSurfaceSeedStage0Summary \self:
        self

//: selfhost_memo_trait_public_surface_seed_scan_new: scan payload を[作/つく]る
fn selfhost_memo_trait_public_surface_seed_scan_new %fn SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedScan \seed_table:
    SelfhostMemoTraitPublicSurfaceSeedScan seed_table

//: selfhost_memo_trait_public_surface_seed_error_kind_code: seed error を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。variant 追加時はこの関数が更新対象になります。
fn selfhost_memo_trait_public_surface_seed_error_kind_code %fn SelfhostMemoTraitPublicSurfaceSeedErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable:
            1
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing:
            2
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch:
            3
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing:
            4
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch:
            5
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable:
            6
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing:
            7
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing:
            8
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate:
            9
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate:
            10
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedMissing:
            11
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedPlaceholder:
            12
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedMissing:
            13
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedPlaceholder:
            14
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility:
            15
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility:
            16
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported:
            17
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueTraitBodyNormalizationUnsupported:
            18
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyMethodSignatureRejected _method_error:
            19
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueMethodSignatureRejected _method_error:
            20
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder:
            21
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder:
            22
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::StableNominalKeyMissing:
            23
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ReExportUnsupported:
            24
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ImportSurfaceUnsupported:
            25
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::UseSurfaceUnsupported:
            26
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PreludeSurfaceUnsupported:
            27
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::NoPreludeSurfaceUnsupported:
            28
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported:
            29
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported:
            30
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported:
            31
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported:
            32
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing:
            33

//: selfhost_memo_trait_public_surface_seed_error_kind_eq: public surface seed error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_seed_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceSeedErrorKind fn SelfhostMemoTraitPublicSurfaceSeedErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyMethodSignatureRejected method_error:
            match b:
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyMethodSignatureRejected other_method_error:
                    selfhost_memo_trait_method_signature_error_kind_eq method_error other_method_error
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueTraitBodyNormalizationUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueMethodSignatureRejected _other_method_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::StableNominalKeyMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ReExportUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ImportSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::UseSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::NoPreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing:
                    false
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueMethodSignatureRejected method_error:
            match b:
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueMethodSignatureRejected other_method_error:
                    selfhost_memo_trait_method_signature_error_kind_eq method_error other_method_error
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicSurfaceSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueTraitBodyNormalizationUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyMethodSignatureRejected _other_method_error:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::StableNominalKeyMissing:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ReExportUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::ImportSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::UseSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::NoPreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicFunctionSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicStructSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicEnumSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing:
                    false
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadMissing:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate:
            eq selfhost_memo_trait_public_surface_seed_error_kind_code a selfhost_memo_trait_public_surface_seed_error_kind_code b
        SelfhostMemoTraitPublicSurfaceSeedErrorKind::ModuleIdentitySeedMissing:
