//: selfhost_memo_trait_public_surface_seed_table_scan_module_loop: module item stream を[走査/そうさ]する
fn selfhost_memo_trait_public_surface_seed_table_scan_module_loop %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceSeedTable fn i32 fn i32 Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\ast\table\idx\n:
    if:
        ge idx n
        then:
            Result::Ok table
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    match selfhost_memo_trait_public_surface_seed_table_scan_item_result source table item:
                        Result::Ok next_table:
                            selfhost_memo_trait_public_surface_seed_table_scan_module_loop source ast next_table add idx 1 n
                        Result::Err error:
                            Result::Err error
                Option::None:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_seed_table_complete_result: seed table の必須 slot を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_seed_table_complete_result %fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceSeedErrorKind \table:
    if:
        table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateDuplicate
        else:
            if:
                table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateDuplicate
                else:
                    match table.memo_key:
                        Option::Some _key_seed:
                            match table.memo_value:
                                Option::Some _value_seed:
                                    Result::Ok table
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueCandidateMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyCandidateMissing

//: selfhost_memo_trait_public_surface_seed_scan_module_result: module AST から public marker trait seed table を[作/つく]る
//:
//: [目的/もくてき]:
//: - `MemoKey` / `MemoValue` の public marker trait declaration を seed table に集めます。
//:
//: [契約/けいやく]:
//: - この API は registry へ進みません。candidate scanner や module seed とは分離した scan payload を返します。
pub fn selfhost_memo_trait_public_surface_seed_scan_module_result %fn str fn &SelfhostModuleAst Result SelfhostMemoTraitPublicSurfaceSeedScan SelfhostMemoTraitPublicSurfaceSeedErrorKind \source\ast:
    match selfhost_memo_trait_public_surface_seed_table_scan_module_loop source ast selfhost_memo_trait_stable_source_seed_table_empty 0 selfhost_module_ast_len ast:
        Result::Ok table:
            match selfhost_memo_trait_public_surface_seed_table_complete_result table:
                Result::Ok complete_table:
                    Result::Ok selfhost_memo_trait_public_surface_seed_scan_new complete_table
                Result::Err complete_error:
                    Result::Err complete_error
        Result::Err scan_error:
            Result::Err scan_error

//: selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_result: public surface seed 経由で registry を[作/つく]る
//:
//: [目的/もくてき]:
//: - scanner candidate、public surface seed、stable evidence producer、fingerprint gate、registry validator を順に接続します。
//:
//: [契約/けいやく]:
//: - accepted registry はこの関数では構築しません。既存 seed evidence API と registry validator の結果を返します。
pub fn selfhost_memo_trait_trusted_source_registry_from_public_surface_seed_result %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceModuleSeed Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind \source\ast\module_seed:
    match selfhost_memo_trait_public_surface_seed_module_seed_ready_result module_seed:
        Result::Ok _module_seed_ok:
            match selfhost_memo_trait_definition_source_table_scan_module_result source ast:
                Result::Ok candidates:
                    match selfhost_memo_trait_public_surface_seed_scan_module_result source ast:
                        Result::Ok scan:
                            match selfhost_memo_trait_trusted_source_registry_from_seed_evidence_result candidates module_seed scan.seed_table:
                                Result::Ok registry:
                                    Result::Ok registry
                                Result::Err seed_error:
                                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::SeedRegistryRejected seed_error
                        Result::Err public_error:
                            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected public_error
                Result::Err candidate_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::CandidateScanRejected candidate_error
        Result::Err module_error:
            Result::Err SelfhostMemoTraitPublicSurfaceSeedRegistryErrorKind::PublicSurfaceRejected module_error

