#indent 4

//: # check/module/orchestrate
//: module AST item stream を module checker proof state へ[流/なが]す orchestrator です。
//:
//: [目的/もくてき]:
//: - parser が作った `SelfhostModuleAst` を 1 item ずつ処理し、summary、raw backend proof、directive proof、declaration header proof を同じ順序で更新します。
//: - 個別 proof の失敗は typed diagnostic に変換し、後続 stage が未検査の module を受け取らないようにします。
//:
//: [契約/けいやく]:
//: - source text や directive spelling を再走査せず、`SelfhostModuleItem` の kind / span / header evidence を authority として扱います。
//: - proof state の更新順序は item stream の順序に従います。raw backend text と singleton directive の制約は adapter 経由で proof layer に委譲します。
//:
//: [計算量/けいさんりょう]:
//: - module item 数を n として O(n) です。各 item の proof transition は O(1) です。

#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/proof" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "./declaration_adapter" as *
#import "./diagnostic" as *
#import "./raw_backend_adapter" as *
#import "./summary" as *
#import "./summary_update" as *

//: SelfhostModuleCheckStep: 1 item 検査後の summary と raw/directive state
struct SelfhostModuleCheckStep:
    summary %SelfhostModuleCheckSummary
    raw_state %SelfhostRawBackendState
    directive_state %SelfhostModuleDirectiveState

impl Clone for SelfhostModuleCheckStep:
    fn clone %fn &SelfhostModuleCheckStep SelfhostModuleCheckStep \self:
        *self

impl Copy for SelfhostModuleCheckStep:
    fn copy_mark %fn SelfhostModuleCheckStep SelfhostModuleCheckStep \self:
        self

fn selfhost_module_check_step_new %fn SelfhostModuleCheckSummary fn SelfhostRawBackendState fn SelfhostModuleDirectiveState SelfhostModuleCheckStep \summary\raw_state\directive_state:
    SelfhostModuleCheckStep summary raw_state directive_state

fn selfhost_module_check_item %fn SelfhostModuleCheckSummary fn SelfhostRawBackendState fn SelfhostModuleDirectiveState fn SelfhostModuleItem Result SelfhostModuleCheckStep SelfhostDiagnostic \summary\raw_state\directive_state\item:
    match selfhost_module_check_item_span item:
        Result::Ok _:
            match selfhost_module_check_item_declaration_header item:
                Result::Ok _:
                    match selfhost_module_check_item_raw_state raw_state item:
                        Result::Ok next_state:
                            match selfhost_module_check_item_directive_state directive_state item:
                                Result::Ok next_directive_state:
                                    let next_summary %SelfhostModuleCheckSummary selfhost_module_check_summary_record summary item.kind
                                    Result::Ok selfhost_module_check_step_new next_summary next_state next_directive_state
                                Result::Err refutation:
                                    Result::Err selfhost_module_check_refutation_diag refutation
                        Result::Err refutation:
                            Result::Err selfhost_module_check_refutation_diag refutation
                Result::Err refutation:
                    Result::Err selfhost_module_check_refutation_diag refutation
        Result::Err refutation:
            Result::Err selfhost_module_check_refutation_diag refutation

fn selfhost_check_module_ast_loop %fn &SelfhostModuleAst fn i32 fn i32 fn SelfhostModuleCheckSummary fn SelfhostRawBackendState fn SelfhostModuleDirectiveState Result SelfhostModuleCheckSummary SelfhostDiagnostic \ast\n\idx\summary\raw_state\directive_state:
    if:
        ge idx n
        then:
            match selfhost_module_check_finish_raw_state raw_state:
                Result::Ok _:
                    Result::Ok summary
                Result::Err refutation:
                    Result::Err selfhost_module_check_refutation_diag refutation
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    match selfhost_module_check_item summary raw_state directive_state item:
                        Result::Ok step:
                            selfhost_check_module_ast_loop ast n add idx 1 step.summary step.raw_state step.directive_state
                        Result::Err diag:
                            Result::Err diag
                Option::None:
                    Result::Err selfhost_module_check_index_unavailable_diag

//: selfhost_check_module_ast: module item stream を[検査/けんさ]して summary を[返/かえ]す
//:
//: [目的/もくてき]:
//: - module-level proof boundary の入口として、raw backend、directive singleton、declaration header、span の検査を item stream 全体へ適用します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(summary)`: すべての item が module checker の proof boundary を通過し、分類 count を持つ summary を返します。
//: - `Err(diagnostic)`: raw text without block、empty raw block、duplicate directive、invalid span、declaration header 欠落などを typed diagnostic として返します。
//:
//: [計算量/けいさんりょう]:
//: - module item 数を n として O(n) です。各 item の proof transition と summary 更新は O(1) です。
pub fn selfhost_check_module_ast %fn &SelfhostModuleAst Result SelfhostModuleCheckSummary SelfhostDiagnostic \ast:
    let n %i32 selfhost_module_ast_len ast
    selfhost_check_module_ast_loop ast n 0 selfhost_module_check_summary_new SelfhostRawBackendState::Normal SelfhostModuleDirectiveState::NoneSeen
