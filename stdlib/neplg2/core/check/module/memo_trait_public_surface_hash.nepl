                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected other_hash_error:
                    selfhost_memo_trait_public_surface_hash_error_kind_eq hash_error other_hash_error
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected _seed_error:
