//: SelfhostMemoTraitPublicSurfaceHashMaterialization: public surface hash materializer の成功 payload
//:
//: [目的/もくてき]:
//: - seed table と、それから導出した module seed を一緒に保持し、後続 gate が同じ材料を読むことを保証します。
//:
//: [契約/けいやく]:
//: - `module_seed.public_surface_hash` は、この module が seed table から導出した nonzero fingerprint です。
//: - `seed_table` は同じ AST 走査から得た `MemoKey` / `MemoValue` seed です。別 module の hash と混ぜて使ってはなりません。
pub struct SelfhostMemoTraitPublicSurfaceHashMaterialization:
    module_seed %SelfhostMemoTraitStableSourceModuleSeed
    seed_table %SelfhostMemoTraitStableSourceSeedTable

//: SelfhostMemoTraitPublicSurfaceHashRegistryMaterialization: registry convenience path の combined payload
//:
//: [目的/もくてき]:
//: - candidate source table と hash materialization を同じ module item pass から返します。
//: - registry convenience path が candidate scanner と hash materializer を別々に走査しないよう、後続の stable evidence producer に必要な 2 種類の payload をまとめます。
//:
//: [契約/けいやく]:
//: - `candidates` は source spelling から分類した未trusted candidate table です。signature authority はまだ持たず、registry validator が `SignatureMissing` などを typed error として返します。
//: - `materialization` は同じ pass で作った seed table と、その seed table を ordered input table へ変換して導出した public surface hash を保持します。
//: - この struct 自体は trusted registry ではありません。必ず `selfhost_memo_trait_trusted_source_registry_from_seed_evidence_result` を通します。
pub struct SelfhostMemoTraitPublicSurfaceHashRegistryMaterialization:
    candidates %SelfhostMemoTraitDefinitionSourceTable
    materialization %SelfhostMemoTraitPublicSurfaceHashMaterialization

//: SelfhostMemoTraitPublicSurfaceHashRegistryScanState: single-pass registry scan の内部 state
//:
//: [目的/もくてき]:
//: - module item stream を 1 回走査しながら、candidate source table と public surface seed table を同時に更新します。
//:
//: [契約/けいやく]:
//: - candidate table は source spelling の分類にだけ使います。
//: - seed table は public surface hash の authority になる typed seed field だけを保持します。
//: - state を外へ公開せず、成功時は `SelfhostMemoTraitPublicSurfaceHashRegistryMaterialization` へ畳みます。
struct SelfhostMemoTraitPublicSurfaceHashRegistryScanState:
    candidates %SelfhostMemoTraitDefinitionSourceTable
    seed_table %SelfhostMemoTraitStableSourceSeedTable

//: SelfhostMemoTraitPublicSurfaceHashInputKind: full public surface hash の ordered input item 種別
//:
//: [目的/もくてき]:
//: - public surface hash の hash material を、source spelling ではなく typed item kind として分類します。
//:
//: [契約/けいやく]:
//: - `LocalMemoTrait(kind)` は、この module が現在受理する local `MemoKey` / `MemoValue` trait declaration を表します。
//: - `DependencyModule`、`ReExport`、`PublicFunction`、`PublicStruct`、`PublicEnum`、`PublicImpl` は full public surface normalizer が後続 slice で渡す typed input の予約済み種別です。この module で source path や lexeme から解決してはいけません。
//: - どの variant も proof store、HIR、Resource IR、backend の acceptance authority ではありません。hash input を分類するだけです。
pub enum SelfhostMemoTraitPublicSurfaceHashInputKind:
    LocalMemoTrait %SelfhostMemoTraitSourceKind
    DependencyModule
    ReExport
    PublicFunction
    PublicStruct
    PublicEnum
    PublicImpl

//: SelfhostMemoTraitPublicSurfaceHashInputItem: public surface hash に fold する 1 item
//:
//: [目的/もくてき]:
//: - full public surface hash の材料を、順序、種別、visibility、stable payload hash、dependency public surface hash に分けて保持します。
//:
//: [契約/けいやく]:
//: - `ordinal` は caller が正規化した ordered input table 上の 1-origin ordinal です。source byte position ではありません。
//: - `payload_hash` は trait signature、function signature、struct layout header など、各 normalizer が作る stable nonzero hash です。source text や display name を直接入れてはいけません。
//: - `dependency_public_surface_hash` は import graph / re-export normalizer が caller supplied typed dependency hash を渡す場所です。local memo trait item では `none` です。
pub struct SelfhostMemoTraitPublicSurfaceHashInputItem:
    kind %SelfhostMemoTraitPublicSurfaceHashInputKind
    ordinal %i32
    visibility %SelfhostModuleDeclarationVisibility
    payload_hash %i32
    dependency_public_surface_hash %Option i32

//: SelfhostMemoTraitPublicSurfaceHashInputTable: Phase 1 public surface hash input table
//:
//: [目的/もくてき]:
//: - 現在の local `MemoKey` / `MemoValue` pair を、full public surface hash と同じ ordered input boundary へ載せます。
//:
//: [契約/けいやく]:
//: - `first` と `second` は ordered input item です。Phase 1 では `MemoKey`、`MemoValue` の順だけを受理します。
//: - この fixed 2 slot table は full public surface の最終データ構造ではありません。後続 slice で可変長 table へ置換しても、item schema と folding contract は維持します。
pub struct SelfhostMemoTraitPublicSurfaceHashInputTable:
    first %SelfhostMemoTraitPublicSurfaceHashInputItem
    second %SelfhostMemoTraitPublicSurfaceHashInputItem

//: SelfhostMemoTraitPublicSurfaceHashInputAccumulator: full public surface input stream の fold state
//:
//: [目的/もくてき]:
//: - full public surface normalizer が後続で作る任意長の ordered input item を、source order ではなく normalizer が確定した ordinal 順に fold します。
//:
//: [契約/けいやく]:
//: - `count` はすでに fold 済みの item 数です。次に受け取る item の ordinal は `count + 1` でなければなりません。
//: - `folded_hash` は validated item hash だけから作ります。source text、span、path、display name、diagnostic text はこの accumulator に入りません。
pub struct SelfhostMemoTraitPublicSurfaceHashInputAccumulator:
    count %i32
    folded_hash %i32

//: SelfhostMemoTraitPublicSurfaceHashErrorKind: public surface hash materialization の拒否理由
//:
//: [目的/もくてき]:
//: - module identity、未正規化 public surface、seed scan、input adapter、derived hash のどこで拒否したかを enum で保持します。
pub enum SelfhostMemoTraitPublicSurfaceHashErrorKind:
    ModuleIdentityFingerprintMissing
    ModuleIdentityFingerprintPlaceholder
    ImportSurfaceUnsupported
    UseSurfaceUnsupported
    PreludeSurfaceUnsupported
    NoPreludeSurfaceUnsupported
    PublicFunctionSurfaceUnsupported
    PublicStructSurfaceUnsupported
    PublicEnumSurfaceUnsupported
    PublicImplSurfaceUnsupported
    DeclarationHeaderMissing
    PublicSurfaceSeedRejected %SelfhostMemoTraitPublicSurfaceSeedErrorKind
    MemoKeySeedMissing
    MemoValueSeedMissing
    MemoKeySeedDuplicate
    MemoValueSeedDuplicate
    MemoKeySeedKindMismatch
    MemoValueSeedKindMismatch
    MemoKeyPrivateVisibility
    MemoValuePrivateVisibility
    MemoKeyDeclarationOrdinalMissing
    MemoValueDeclarationOrdinalMissing
    MemoKeyDeclarationOrdinalPlaceholder
    MemoValueDeclarationOrdinalPlaceholder
    MemoKeyNormalizedSignatureMissing
    MemoValueNormalizedSignatureMissing
    MemoKeyNormalizedSignaturePlaceholder
    MemoValueNormalizedSignaturePlaceholder
    PublicSurfaceHashPlaceholder
    PublicSurfaceInputEmpty
    PublicSurfaceInputOrdinalMismatch
    DependencyPublicSurfaceHashMissing
    DependencyPublicSurfaceHashPlaceholder
    UnexpectedDependencyPublicSurfaceHash

//: SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind: hash materializer から registry までの拒否理由
//:
//: [目的/もくてき]:
//: - candidate scan、public surface hash materializer、stable seed producer / registry gate の失敗を分けて保持します。
pub enum SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind:
    CandidateScanRejected %SelfhostMemoTraitDefinitionScanErrorKind
    PublicSurfaceHashRejected %SelfhostMemoTraitPublicSurfaceHashErrorKind
    SeedRegistryRejected %SelfhostMemoTraitStableSourceSeedRegistryErrorKind

//: SelfhostMemoTraitPublicSurfaceHashStage0Summary: public surface hash smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted registry path と、module identity 欠落、import surface、public non-trait declaration、trait body unsupported の fail-closed path をまとめます。
pub struct SelfhostMemoTraitPublicSurfaceHashStage0Summary:
    accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind
    module_identity_missing_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    import_surface_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    public_declaration_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    body_surface_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    method_surface_accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind
    full_surface_input_hash %Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind
    dependency_hash_missing_rejected %Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind
    dependency_hash_placeholder_rejected %Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind
    unexpected_dependency_hash_rejected %Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind
    ordinal_mismatch_rejected %Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind

