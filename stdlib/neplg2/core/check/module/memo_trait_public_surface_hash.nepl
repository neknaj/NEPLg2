//: selfhost_memo_trait_public_surface_hash_scan_public_decl_result: public non-trait declaration を hash materializer の同一 scan で[拒否/きょひ]する
//:
//: [契約/けいやく]:
//: - private non-trait declaration は public surface に出ないため無視します。
//: - public function / struct / enum / impl は full public surface materializer が入るまで kind 別 typed error として拒否します。
fn selfhost_memo_trait_public_surface_hash_scan_public_decl_result %fn SelfhostModuleItem fn SelfhostMemoTraitPublicSurfaceHashErrorKind Result unit SelfhostMemoTraitPublicSurfaceHashErrorKind \item\public_error:
    match item.declaration:
        Option::Some header:
            match header.visibility:
                SelfhostModuleDeclarationVisibility::Public:
                    Result::Err public_error
                SelfhostModuleDeclarationVisibility::Private:
                    Result::Ok unit
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::DeclarationHeaderMissing

//: selfhost_memo_trait_public_surface_hash_scan_item_result: item 1 件を hash materializer の seed table へ[反映/はんえい]する
//:
//: [目的/もくてき]:
//: - unsupported public surface validation と marker trait seed accumulation を同じ item loop に置き、hash materializer 内で module item stream を二重に走査しないようにします。
fn selfhost_memo_trait_public_surface_hash_scan_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\table\item:
    match item.kind:
        SelfhostModuleItemKind::TraitDecl:
            selfhost_memo_trait_public_surface_hash_scan_trait_item_result source table item
        SelfhostModuleItemKind::DocComment:
            Result::Ok table
        SelfhostModuleItemKind::MlstrLine:
            Result::Ok table
        SelfhostModuleItemKind::EntryDirective:
            Result::Ok table
        SelfhostModuleItemKind::TargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::ImportDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported
        SelfhostModuleItemKind::UseDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::UseSurfaceUnsupported
        SelfhostModuleItemKind::TestDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfTargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfProfileDirective:
            Result::Ok table
        SelfhostModuleItemKind::CapabilityDirective:
            Result::Ok table
        SelfhostModuleItemKind::PreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::PreludeSurfaceUnsupported
        SelfhostModuleItemKind::NoPreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::NoPreludeSurfaceUnsupported
        SelfhostModuleItemKind::IntrinsicDirective:
            Result::Ok table
        SelfhostModuleItemKind::WasmBlock:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrBlock:
            Result::Ok table
        SelfhostModuleItemKind::WasmText:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrText:
            Result::Ok table
        SelfhostModuleItemKind::FunctionDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::StructDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicStructSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::EnumDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicEnumSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::ImplDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicImplSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error

//: selfhost_memo_trait_public_surface_hash_scan_module_loop: hash materializer 内部で module item stream を 1 pass [走査/そうさ]する
fn selfhost_memo_trait_public_surface_hash_scan_module_loop %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceSeedTable fn i32 fn i32 Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\ast\table\idx\n:
    if:
        ge idx n
        then:
            Result::Ok table
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    match selfhost_memo_trait_public_surface_hash_scan_item_result source table item:
                        Result::Ok next_table:
                            selfhost_memo_trait_public_surface_hash_scan_module_loop source ast next_table add idx 1 n
                        Result::Err error:
                            Result::Err error
                Option::None:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_hash_seed_table_complete_result: hash materializer 内部 scan の seed table を[完了/かんりょう][検査/けんさ]する
fn selfhost_memo_trait_public_surface_hash_seed_table_complete_result %fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \table:
    if:
        table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate
        else:
            if:
                table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate
                else:
                    match table.memo_key:
                        Option::Some _key_seed:
                            match table.memo_value:
                                Option::Some _value_seed:
                                    Result::Ok table
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing

//: selfhost_memo_trait_public_surface_hash_scan_module_result: AST-only materializer 用 seed table を 1 pass で[作/つく]る
fn selfhost_memo_trait_public_surface_hash_scan_module_result %fn str fn &SelfhostModuleAst Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\ast:
    match selfhost_memo_trait_public_surface_hash_scan_module_loop source ast selfhost_memo_trait_stable_source_seed_table_empty 0 selfhost_module_ast_len ast:
        Result::Ok table:
            selfhost_memo_trait_public_surface_hash_seed_table_complete_result table
        Result::Err scan_error:
            Result::Err scan_error

//: selfhost_memo_trait_public_surface_hash_scan_module_with_tokens_loop: token-aware materializer 用に module item stream を 1 pass [走査/そうさ]する
fn selfhost_memo_trait_public_surface_hash_scan_module_with_tokens_loop %impure fn str impure fn &Vec SelfhostToken impure fn &SelfhostModuleAst impure fn SelfhostMemoTraitStableSourceSeedTable impure fn i32 impure fn i32 Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\tokens\ast\table\idx\n:
    if:
