//: selfhost_memo_trait_public_surface_hash_scan_trait_item_result: trait item 1 件を hash materializer の seed table へ[反映/はんえい]する
fn selfhost_memo_trait_public_surface_hash_scan_trait_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\table\item:
    match item.declaration:
        Option::Some header:
            match header.kind:
                SelfhostModuleDeclarationKind::Trait:
                    selfhost_memo_trait_public_surface_hash_scan_trait_header_result source table item header
                SelfhostModuleDeclarationKind::Function:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Struct:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Enum:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
                SelfhostModuleDeclarationKind::Impl:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderKindMismatch
