        Result::Ok seed_table:
            match selfhost_memo_trait_public_surface_hash_from_seed_table_result seed_table:
                Result::Ok public_surface_hash:
                    let module_identity_option %Option i32 some accepted_module_identity
                    let public_surface_option %Option i32 some public_surface_hash
                    let module_seed %SelfhostMemoTraitStableSourceModuleSeed selfhost_memo_trait_stable_source_module_seed_new module_identity_option public_surface_option
                    let materialization %SelfhostMemoTraitPublicSurfaceHashMaterialization selfhost_memo_trait_public_surface_hash_materialization_new module_seed seed_table
                    Result::Ok selfhost_memo_trait_public_surface_hash_registry_materialization_new state.candidates materialization
                Result::Err hash_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected hash_error
        Result::Err seed_error:
            Result::Err SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected seed_error

