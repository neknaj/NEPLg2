//:
//: [契約/けいやく]:
//: - AST-only hash materializer は method-bearing trait を受理しません。body/header の詳細な失敗は signature normalizer 側で保持し、hash materializer の public surface では key/value ごとの unsupported error に畳みます。
fn selfhost_memo_trait_public_surface_hash_normalization_error_result %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitSignatureShapeErrorKind SelfhostMemoTraitPublicSurfaceHashErrorKind \kind\_normalization_error:
    selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error selfhost_memo_trait_public_surface_hash_marker_unsupported_seed_error kind

//: selfhost_memo_trait_public_surface_hash_signature_from_shape_result: marker evidence から hash materializer 用 signature seed を[取/と]り[出/だ]す
//:
//: [契約/けいやく]:
//: - accepted signature seed は `memo_trait_signature_shape` が作った `normalized_signature_hash` だけです。source span、range、lexeme、path suffix はこの関数の authority ではありません。
fn selfhost_memo_trait_public_surface_hash_signature_from_shape_result %fn SelfhostMemoTraitSourceKind fn SelfhostMemoTraitSignatureShapeEvidence Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \kind\evidence:
    match evidence.normalized_signature_hash:
        Option::Some signature_seed:
            if:
                eq signature_seed 0
                then:
                    match kind:
                        SelfhostMemoTraitSourceKind::MemoKeyTrait:
                            Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder
                        SelfhostMemoTraitSourceKind::MemoValueTrait:
                            Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder
                else:
                    Result::Ok signature_seed
        Option::None:
            match kind:
                SelfhostMemoTraitSourceKind::MemoKeyTrait:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeySignatureSeedPlaceholder
                SelfhostMemoTraitSourceKind::MemoValueTrait:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValueSignatureSeedPlaceholder

//: selfhost_memo_trait_public_surface_hash_seed_declaration_ordinal: well-known memo trait kind を stable ordinal seed へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - Phase 1 の hash materializer は source order や byte position を authority にしません。compiler-known trait kind から固定 ordinal seed を作ります。
fn selfhost_memo_trait_public_surface_hash_seed_declaration_ordinal %fn SelfhostMemoTraitSourceKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            1
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            2

//: selfhost_memo_trait_public_surface_hash_trait_seed_result: hash module 内部 scan で trait item を stable seed へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - public surface hash materializer が seed module の module-level scanner を再呼び出しせず、同じ loop 内で marker trait seed を作れるようにします。
//:
//: [契約/けいやく]:
//: - AST-only path は marker trait だけを受理します。method-bearing trait は token-aware materializer の責務です。
fn selfhost_memo_trait_public_surface_hash_trait_seed_result %fn SelfhostMemoTraitSourceKind fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceTraitSeed SelfhostMemoTraitPublicSurfaceHashErrorKind \kind\visibility\item:
    match visibility:
        SelfhostModuleDeclarationVisibility::Public:
            match item.declaration:
                Option::Some header:
                    match selfhost_memo_trait_signature_shape_result kind header item:
                        Result::Ok signature_evidence:
                            match selfhost_memo_trait_public_surface_hash_signature_from_shape_result kind signature_evidence:
                                Result::Ok signature_seed:
                                    let declaration_ordinal %i32 selfhost_memo_trait_public_surface_hash_seed_declaration_ordinal kind
                                    let declaration_ordinal_option %Option i32 some declaration_ordinal
                                    let signature_option %Option i32 some signature_seed
                                    Result::Ok selfhost_memo_trait_stable_source_trait_seed_new kind visibility declaration_ordinal_option signature_option
                                Result::Err signature_error:
                                    Result::Err signature_error
                        Result::Err normalization_error:
                            Result::Err selfhost_memo_trait_public_surface_hash_normalization_error_result kind normalization_error
                Option::None:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeaderMissing
        SelfhostModuleDeclarationVisibility::Private:
            match kind:
                SelfhostMemoTraitSourceKind::MemoKeyTrait:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyPrivateVisibility
                SelfhostMemoTraitSourceKind::MemoValueTrait:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoValuePrivateVisibility

//: selfhost_memo_trait_public_surface_hash_table_add_name_result: classified trait name を hash materializer の seed table へ[反映/はんえい]する
//:
//: [契約/けいやく]:
//: - source slicing の結果は `MemoKey` / `MemoValue` の分類にだけ使います。hash material はこのあと作られる typed seed field に閉じます。
fn selfhost_memo_trait_public_surface_hash_table_add_name_result %fn SelfhostMemoTraitStableSourceSeedTable fn str fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \table\name\visibility\item:
    if:
        string_search::str_eq name "MemoKey"
        then:
            match selfhost_memo_trait_public_surface_hash_trait_seed_result SelfhostMemoTraitSourceKind::MemoKeyTrait visibility item:
                Result::Ok seed:
                    Result::Ok selfhost_memo_trait_stable_source_seed_table_add_record table seed
                Result::Err seed_error:
                    Result::Err seed_error
        else:
            if:
                string_search::str_eq name "MemoValue"
                then:
                    match selfhost_memo_trait_public_surface_hash_trait_seed_result SelfhostMemoTraitSourceKind::MemoValueTrait visibility item:
                        Result::Ok seed:
                            Result::Ok selfhost_memo_trait_stable_source_seed_table_add_record table seed
                        Result::Err seed_error:
                            Result::Err seed_error
                else:
                    Result::Ok table

//: selfhost_memo_trait_public_surface_hash_scan_trait_name_result: trait head 名を分類して seed table へ[追加/ついか]する
fn selfhost_memo_trait_public_surface_hash_scan_trait_name_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleDeclarationVisibility fn SelfhostModuleItem fn SelfhostSourceSpan Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\table\visibility\item\span:
    if:
        not source_span_is_valid span
        then:
            Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable
        else:
            match string_slice::str_slice_result source span.start span.end:
                Result::Ok name:
                    selfhost_memo_trait_public_surface_hash_table_add_name_result table name visibility item
                Result::Err _slice_error:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitNameUnavailable

//: selfhost_memo_trait_public_surface_hash_scan_trait_header_result: trait header を hash materializer の scan loop で[検査/けんさ]する
fn selfhost_memo_trait_public_surface_hash_scan_trait_header_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem fn SelfhostModuleDeclarationHeader Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\table\item\header:
    match header.head:
