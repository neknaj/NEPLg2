#indent 4

//: # check/module/memo_trait_public_surface_hash
//: `MemoKey` / `MemoValue` の stable source evidence に渡す module public surface hash を、typed seed から[作/つく]る接続層です。
//:
//: [目的/もくてき]:
//: - `SelfhostModuleAst` の local public marker trait declaration から seed table を作り、その seed table の typed field だけを public surface hash へ fold します。
//: - source text、span、display name、path suffix、diagnostic text を accepted fingerprint authority にせず、kind、visibility、declaration ordinal、normalized signature seed を使います。
//: - scanner candidate、public surface hash materializer、stable evidence producer、fingerprint gate、trusted registry validator を順に通し、途中の未正規化 surface を成功扱いしないようにします。
//:
//: [契約/けいやく]:
//: - `module_identity_hash` は caller が作った typed fingerprint です。`none` と `some 0` は typed error で拒否します。
//: - この module が計算する public surface hash は、Phase 1 の local `MemoKey` / `MemoValue` marker trait pair に限定されます。import / use / prelude / public non-trait declaration は、full module public surface の正規化が未接続なので拒否します。
//: - public surface hash は seed table の field を deterministic に fold した nonzero fingerprint です。source spelling や byte range は hash material に入りません。
//: - 成功時も registry を直接構築しません。既存 seed evidence producer と stable source registry gate へ委譲します。
//:
//: [現状/げんじょう]:
//: - これは full public surface materializer ではありません。re-export、import graph、public function / struct / enum / impl signature、trait body、method signature normalization、stable nominal key、serialized `.neplmeta` / `.neplproof` 入力は後続 slice の責務です。
//: - 現在の accepted path は marker trait smoke と source identity pipeline の境界固定を目的にしています。実 stdlib の method 付き `MemoKey` / `MemoValue` に接続するには、trait body / method signature normalization evidence を先に実装します。
//:
//: [計算量/けいさんりょう]:
//: - unsupported public surface の確認と seed scan で module item stream を 2 回走査するため、item 数 n に対して O(n) 時間です。
//: - seed table と hash materialization payload は固定 2 slot なので O(1) 追加空間です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_surface_hash" as *
//:| #import "neplg2/core/check/module/memo_trait_public_surface_seed" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_surface_hash_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.accepted_registry
//:     let checks2 checks_push checks1 check selfhost_memo_trait_public_surface_hash_error_kind_eq (unwrap_err summary.module_identity_missing_rejected) SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintMissing
//:     let checks3 checks_push checks2 check selfhost_memo_trait_public_surface_hash_error_kind_eq (unwrap_err summary.import_surface_rejected) SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_surface_hash_error_kind_eq (unwrap_err summary.public_declaration_rejected) SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_surface_hash_error_kind_eq (unwrap_err summary.body_surface_rejected) SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceSeedRejected SelfhostMemoTraitPublicSurfaceSeedErrorKind::MemoKeyTraitBodyNormalizationUnsupported
//:     let shown checks_print_report checks5
//:     checks_exit_code shown
//: ```

#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty/memo_trait_policy" as *
#import "neplg2/core/ty/ty/memo_trait_source" as *
#import "./memo_trait_public_surface_seed" as *
#import "./memo_trait_source_evidence_producer" as *
#import "./memo_trait_source_scan" as *

//: SelfhostMemoTraitPublicSurfaceHashMaterialization: public surface hash materializer の成功 payload
//:
//: [目的/もくてき]:
//: - seed table と、それから導出した module seed を一緒に保持し、後続 gate が同じ材料を読むことを保証します。
//:
//: [契約/けいやく]:
//: - `module_seed.public_surface_hash` は、この module が seed table から導出した nonzero fingerprint です。
//: - `seed_table` は同じ AST 走査から得た `MemoKey` / `MemoValue` seed です。別 module の hash と混ぜて使ってはなりません。
pub struct SelfhostMemoTraitPublicSurfaceHashMaterialization:
    module_seed %SelfhostMemoTraitStableSourceModuleSeed
    seed_table %SelfhostMemoTraitStableSourceSeedTable

//: SelfhostMemoTraitPublicSurfaceHashErrorKind: public surface hash materialization の拒否理由
//:
//: [目的/もくてき]:
//: - module identity、未正規化 public surface、seed scan、seed table field、derived hash のどこで拒否したかを enum で保持します。
pub enum SelfhostMemoTraitPublicSurfaceHashErrorKind:
    ModuleIdentityFingerprintMissing
    ModuleIdentityFingerprintPlaceholder
    ImportSurfaceUnsupported
    UseSurfaceUnsupported
    PreludeSurfaceUnsupported
    NoPreludeSurfaceUnsupported
    PublicFunctionSurfaceUnsupported
    PublicStructSurfaceUnsupported
    PublicEnumSurfaceUnsupported
    PublicImplSurfaceUnsupported
    DeclarationHeaderMissing
    PublicSurfaceSeedRejected %SelfhostMemoTraitPublicSurfaceSeedErrorKind
    MemoKeySeedMissing
    MemoValueSeedMissing
    MemoKeySeedDuplicate
    MemoValueSeedDuplicate
    MemoKeySeedKindMismatch
    MemoValueSeedKindMismatch
    MemoKeyPrivateVisibility
    MemoValuePrivateVisibility
    MemoKeyDeclarationOrdinalMissing
    MemoValueDeclarationOrdinalMissing
    MemoKeyDeclarationOrdinalPlaceholder
    MemoValueDeclarationOrdinalPlaceholder
    MemoKeyNormalizedSignatureMissing
    MemoValueNormalizedSignatureMissing
    MemoKeyNormalizedSignaturePlaceholder
    MemoValueNormalizedSignaturePlaceholder
    MemoKeyDerivedSurfaceHashPlaceholder
    MemoValueDerivedSurfaceHashPlaceholder
    PublicSurfaceHashPlaceholder

//: SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind: hash materializer から registry までの拒否理由
//:
//: [目的/もくてき]:
//: - candidate scan、public surface hash materializer、stable seed producer / registry gate の失敗を分けて保持します。
pub enum SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind:
    CandidateScanRejected %SelfhostMemoTraitDefinitionScanErrorKind
    PublicSurfaceHashRejected %SelfhostMemoTraitPublicSurfaceHashErrorKind
    SeedRegistryRejected %SelfhostMemoTraitStableSourceSeedRegistryErrorKind

//: SelfhostMemoTraitPublicSurfaceHashStage0Summary: public surface hash smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted registry path と、module identity 欠落、import surface、public non-trait declaration、trait body unsupported の fail-closed path をまとめます。
pub struct SelfhostMemoTraitPublicSurfaceHashStage0Summary:
    accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind
    module_identity_missing_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    import_surface_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    public_declaration_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind
    body_surface_rejected %Result SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashErrorKind

impl Clone for SelfhostMemoTraitPublicSurfaceHashMaterialization:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashMaterialization \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceHashMaterialization:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashMaterialization \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceHashErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceHashErrorKind SelfhostMemoTraitPublicSurfaceHashErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceHashErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceHashErrorKind SelfhostMemoTraitPublicSurfaceHashErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfaceHashStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicSurfaceHashStage0Summary SelfhostMemoTraitPublicSurfaceHashStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitPublicSurfaceHashStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicSurfaceHashStage0Summary SelfhostMemoTraitPublicSurfaceHashStage0Summary \self:
        self

//: selfhost_memo_trait_public_surface_hash_materialization_new: materialization payload を[作/つく]る
fn selfhost_memo_trait_public_surface_hash_materialization_new %fn SelfhostMemoTraitStableSourceModuleSeed fn SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashMaterialization \module_seed\seed_table:
    SelfhostMemoTraitPublicSurfaceHashMaterialization module_seed seed_table

//: selfhost_memo_trait_public_surface_hash_error_kind_code: payload を持たない hash error を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `PublicSurfaceSeedRejected` の payload はこの code だけでは比較しません。`selfhost_memo_trait_public_surface_hash_error_kind_eq` で seed error eq を併用します。
fn selfhost_memo_trait_public_surface_hash_error_kind_code %fn SelfhostMemoTraitPublicSurfaceHashErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintMissing:
            1
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintPlaceholder:
            2
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported:
            3
        SelfhostMemoTraitPublicSurfaceHashErrorKind::UseSurfaceUnsupported:
            4
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PreludeSurfaceUnsupported:
            5
        SelfhostMemoTraitPublicSurfaceHashErrorKind::NoPreludeSurfaceUnsupported:
            6
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported:
            7
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicStructSurfaceUnsupported:
            8
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicEnumSurfaceUnsupported:
            9
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicImplSurfaceUnsupported:
            10
        SelfhostMemoTraitPublicSurfaceHashErrorKind::DeclarationHeaderMissing:
            11
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceSeedRejected _seed_error:
            12
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing:
            13
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing:
            14
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate:
            15
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate:
            16
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedKindMismatch:
            17
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedKindMismatch:
            18
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyPrivateVisibility:
            19
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValuePrivateVisibility:
            20
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalMissing:
            21
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalMissing:
            22
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalPlaceholder:
            23
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalPlaceholder:
            24
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignatureMissing:
            25
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignatureMissing:
            26
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignaturePlaceholder:
            27
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignaturePlaceholder:
            28
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDerivedSurfaceHashPlaceholder:
            29
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDerivedSurfaceHashPlaceholder:
            30
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder:
            31

//: selfhost_memo_trait_public_surface_hash_error_kind_eq: public surface hash error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_hash_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceHashErrorKind fn SelfhostMemoTraitPublicSurfaceHashErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceSeedRejected seed_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceSeedRejected other_seed_error:
                    selfhost_memo_trait_public_surface_seed_error_kind_eq seed_error other_seed_error
                SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::UseSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::NoPreludeSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicStructSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicEnumSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicImplSurfaceUnsupported:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::DeclarationHeaderMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedKindMismatch:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyPrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValuePrivateVisibility:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignatureMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignatureMissing:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignaturePlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignaturePlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDerivedSurfaceHashPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDerivedSurfaceHashPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder:
                    false
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ModuleIdentityFingerprintPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::UseSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PreludeSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::NoPreludeSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicStructSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicEnumSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicImplSurfaceUnsupported:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::DeclarationHeaderMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedKindMismatch:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedKindMismatch:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyPrivateVisibility:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValuePrivateVisibility:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignatureMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignatureMissing:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignaturePlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignaturePlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDerivedSurfaceHashPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDerivedSurfaceHashPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b
        SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder:
            eq:
                selfhost_memo_trait_public_surface_hash_error_kind_code a
                selfhost_memo_trait_public_surface_hash_error_kind_code b

//: selfhost_memo_trait_public_surface_hash_registry_error_kind_eq: registry path error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_hash_registry_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected candidate_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected other_candidate_error:
                    selfhost_memo_trait_definition_scan_error_kind_eq candidate_error other_candidate_error
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected _hash_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected hash_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected other_hash_error:
                    selfhost_memo_trait_public_surface_hash_error_kind_eq hash_error other_hash_error
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected seed_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected _hash_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected other_seed_error:
                    selfhost_memo_trait_stable_source_seed_registry_error_kind_eq seed_error other_seed_error

