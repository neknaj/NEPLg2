//: selfhost_memo_trait_public_surface_hash_materialization_new: materialization payload を[作/つく]る
fn selfhost_memo_trait_public_surface_hash_materialization_new %fn SelfhostMemoTraitStableSourceModuleSeed fn SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashMaterialization \module_seed\seed_table:
    SelfhostMemoTraitPublicSurfaceHashMaterialization module_seed seed_table

//: selfhost_memo_trait_public_surface_hash_registry_materialization_new: combined registry payload を[作/つく]る
fn selfhost_memo_trait_public_surface_hash_registry_materialization_new %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitPublicSurfaceHashMaterialization SelfhostMemoTraitPublicSurfaceHashRegistryMaterialization \candidates\materialization:
    SelfhostMemoTraitPublicSurfaceHashRegistryMaterialization candidates materialization

//: selfhost_memo_trait_public_surface_hash_registry_scan_state_new: combined scan state を[作/つく]る
fn selfhost_memo_trait_public_surface_hash_registry_scan_state_new %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashRegistryScanState \candidates\seed_table:
