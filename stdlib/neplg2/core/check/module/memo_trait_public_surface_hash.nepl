                        Result::Err token_error:
                            Result::Err selfhost_memo_trait_public_surface_hash_error_from_token_seed_scan_error token_error
                Option::None:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_token_seed_scan_error SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_hash_scan_module_with_tokens_result: token-aware materializer 用 seed table を 1 pass で[作/つく]る
fn selfhost_memo_trait_public_surface_hash_scan_module_with_tokens_result %impure fn str impure fn &Vec SelfhostToken impure fn &SelfhostModuleAst Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\tokens\ast:
    match selfhost_memo_trait_public_surface_hash_scan_module_with_tokens_loop source tokens ast selfhost_memo_trait_stable_source_seed_table_empty 0 selfhost_module_ast_len ast:
