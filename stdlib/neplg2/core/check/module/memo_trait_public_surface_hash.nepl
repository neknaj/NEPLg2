        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::PublicImplSurfaceUnsupported:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::PublicImplSurfaceUnsupported
        SelfhostMemoTraitPublicSurfaceTokenSeedScanErrorKind::DeclarationHeaderMissing:
            SelfhostMemoTraitPublicSurfaceSeedErrorKind::DeclarationHeaderMissing

