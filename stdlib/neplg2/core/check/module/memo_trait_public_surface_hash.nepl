                                    let visibility_hash %i32 selfhost_memo_trait_public_surface_hash_visibility_code seed.visibility
                                    let header_hash %i32 selfhost_memo_trait_public_surface_hash_mix3 kind_hash visibility_hash declaration_ordinal
