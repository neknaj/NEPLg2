//: selfhost_memo_trait_public_surface_hash_registry_scan_state_empty: combined scan state の初期値を[作/つく]る
fn selfhost_memo_trait_public_surface_hash_registry_scan_state_empty %fn void SelfhostMemoTraitPublicSurfaceHashRegistryScanState \void:
    selfhost_memo_trait_public_surface_hash_registry_scan_state_new selfhost_memo_trait_definition_source_table_empty selfhost_memo_trait_stable_source_seed_table_empty

//: selfhost_memo_trait_public_surface_hash_input_item_new: public surface hash input item を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は typed field をまとめるだけです。ordinal、payload hash、dependency hash の nonzero 検査は、それぞれの normalizer または hash folding 境界で行います。
fn selfhost_memo_trait_public_surface_hash_input_item_new %fn SelfhostMemoTraitPublicSurfaceHashInputKind fn i32 fn SelfhostModuleDeclarationVisibility fn i32 fn Option i32 SelfhostMemoTraitPublicSurfaceHashInputItem \kind\ordinal\visibility\payload_hash\dependency_public_surface_hash:
    SelfhostMemoTraitPublicSurfaceHashInputItem kind ordinal visibility payload_hash dependency_public_surface_hash

//: selfhost_memo_trait_public_surface_hash_dependency_module_input_item: dependency module item を[作/つく]る
//:
//: [目的/もくてき]:
//: - import graph / loader が検査済み dependency public surface hash を full surface hash input へ渡すための typed constructor です。
//:
//: [契約/けいやく]:
//: - `dependency_public_surface_hash` はこの constructor では raw path から作りません。caller が module graph authority から得た typed hash を渡します。
//: - hash folding 時に `none` や `some 0` は typed error になります。
fn selfhost_memo_trait_public_surface_hash_dependency_module_input_item %fn i32 fn i32 fn Option i32 SelfhostMemoTraitPublicSurfaceHashInputItem \ordinal\payload_hash\dependency_public_surface_hash:
    selfhost_memo_trait_public_surface_hash_input_item_new SelfhostMemoTraitPublicSurfaceHashInputKind::DependencyModule ordinal SelfhostModuleDeclarationVisibility::Public payload_hash dependency_public_surface_hash

//: selfhost_memo_trait_public_surface_hash_reexport_input_item: re-export item を[作/つく]る
//:
//: [契約/けいやく]:
//: - re-export 先の public surface hash は caller supplied typed hash です。re-export path や表示名はこの item に入りません。
