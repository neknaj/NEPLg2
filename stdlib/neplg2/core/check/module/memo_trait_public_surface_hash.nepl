                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::TraitHeadKindMismatch
        Option::None:
