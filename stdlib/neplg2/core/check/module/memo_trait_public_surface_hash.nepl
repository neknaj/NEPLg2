//: selfhost_memo_trait_public_surface_hash_registry_error_kind_eq: registry path error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_hash_registry_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected candidate_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected other_candidate_error:
