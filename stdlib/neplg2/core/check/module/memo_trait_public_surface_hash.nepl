//: selfhost_memo_trait_public_surface_hash_registry_error_kind_eq: registry path error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_hash_registry_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind fn SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected candidate_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected other_candidate_error:
                    selfhost_memo_trait_definition_scan_error_kind_eq candidate_error other_candidate_error
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected _hash_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected hash_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected other_hash_error:
                    selfhost_memo_trait_public_surface_hash_error_kind_eq hash_error other_hash_error
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected _seed_error:
                    false
        SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected seed_error:
            match b:
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::CandidateScanRejected _candidate_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected _hash_error:
                    false
                SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::SeedRegistryRejected other_seed_error:
                    selfhost_memo_trait_stable_source_seed_registry_error_kind_eq seed_error other_seed_error

//: selfhost_memo_trait_public_surface_hash_option_result: Option fingerprint を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_hash_option_result %fn Option i32 fn SelfhostMemoTraitPublicSurfaceHashErrorKind fn SelfhostMemoTraitPublicSurfaceHashErrorKind Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \fingerprint\missing_error\placeholder_error:
    match fingerprint:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err placeholder_error
                else:
                    Result::Ok value
        Option::None:
            Result::Err missing_error

//: selfhost_memo_trait_public_surface_hash_nonzero_result: derived hash が nonzero か[検査/けんさ]する
fn selfhost_memo_trait_public_surface_hash_nonzero_result %fn i32 fn SelfhostMemoTraitPublicSurfaceHashErrorKind Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \fingerprint\placeholder_error:
    if:
        eq fingerprint 0
        then:
            Result::Err placeholder_error
        else:
            Result::Ok fingerprint

//: selfhost_memo_trait_public_surface_hash_mix2: 2 つの typed seed を[混/ま]ぜる
fn selfhost_memo_trait_public_surface_hash_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_surface_hash_mix3: 3 つの typed seed を[混/ま]ぜる
fn selfhost_memo_trait_public_surface_hash_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_public_surface_hash_mix2 a b c

//: selfhost_memo_trait_public_surface_hash_kind_code: source kind を hash domain code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_hash_kind_code %fn SelfhostMemoTraitSourceKind i32 \kind:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            1301
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            1302

//: selfhost_memo_trait_public_surface_hash_visibility_code: visibility を hash domain code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_hash_visibility_code %fn SelfhostModuleDeclarationVisibility i32 \visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Public:
            1401
        SelfhostModuleDeclarationVisibility::Private:
            1402

//: selfhost_memo_trait_public_surface_hash_input_schema_code: full public surface input schema の domain code を[返/かえ]す
//:
//: [契約/けいやく]:
//: - ordered input item table を fold する schema です。hash material の構造が変わる場合はこの schema code を更新し、別 schema の payload と衝突しないようにします。
fn selfhost_memo_trait_public_surface_hash_input_schema_code %fn void i32 \void:
    212203

//: selfhost_memo_trait_public_surface_hash_input_kind_code: input item kind を hash domain code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_hash_input_kind_code %fn SelfhostMemoTraitPublicSurfaceHashInputKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfaceHashInputKind::LocalMemoTrait source_kind:
            selfhost_memo_trait_public_surface_hash_mix2 232001 selfhost_memo_trait_public_surface_hash_kind_code source_kind
        SelfhostMemoTraitPublicSurfaceHashInputKind::DependencyModule:
            232002
        SelfhostMemoTraitPublicSurfaceHashInputKind::ReExport:
            232003
        SelfhostMemoTraitPublicSurfaceHashInputKind::PublicFunction:
            232004
        SelfhostMemoTraitPublicSurfaceHashInputKind::PublicStruct:
            232005
        SelfhostMemoTraitPublicSurfaceHashInputKind::PublicEnum:
            232006
        SelfhostMemoTraitPublicSurfaceHashInputKind::PublicImpl:
            232007

//: selfhost_memo_trait_public_surface_hash_dependency_part_result: dependency public surface hash を fold 用 seed へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - `DependencyModule` と `ReExport` は dependency public surface hash を必須にします。`none` は missing、`some 0` は placeholder として拒否します。
//: - local declaration item に dependency hash が付いている場合は、別 module の surface を local item に混ぜる不整合なので拒否します。
fn selfhost_memo_trait_public_surface_hash_dependency_part_result %fn SelfhostMemoTraitPublicSurfaceHashInputKind fn Option i32 Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \kind\dependency_public_surface_hash:
    match kind:
        SelfhostMemoTraitPublicSurfaceHashInputKind::DependencyModule:
            match dependency_public_surface_hash:
                Option::Some dependency_hash:
                    selfhost_memo_trait_public_surface_hash_nonzero_result dependency_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::DependencyPublicSurfaceHashPlaceholder
                Option::None:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::DependencyPublicSurfaceHashMissing
        SelfhostMemoTraitPublicSurfaceHashInputKind::ReExport:
