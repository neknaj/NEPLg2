//: selfhost_memo_trait_public_surface_hash_registry_scan_item_result: registry path 用に candidate と seed を同時に[更新/こうしん]する
//:
//: [目的/もくてき]:
//: - candidate scanner と hash materializer を別 pass にせず、同じ item から candidate table と seed table の両方を更新します。
//:
//: [契約/けいやく]:
//: - candidate 更新の AST 不整合は `CandidateScanRejected` として返します。
//: - public surface seed scan の拒否は `PublicSurfaceHashRejected` として返します。
//: - 同じ trait item で candidate 分類と seed 分類の両方が失敗し得る場合は、candidate 分類を先に評価します。これにより malformed trait header は hash error ではなく `CandidateScanRejected` になります。
fn selfhost_memo_trait_public_surface_hash_registry_scan_item_result %fn str fn SelfhostMemoTraitPublicSurfaceHashRegistryScanState fn SelfhostModuleItem Result SelfhostMemoTraitPublicSurfaceHashRegistryScanState SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind \source\state\item:
    match selfhost_memo_trait_public_surface_hash_registry_scan_candidate_item_result source state item:
        Result::Ok candidate_state:
            match selfhost_memo_trait_public_surface_hash_scan_item_result source candidate_state.seed_table item:
                Result::Ok next_seed_table:
                    Result::Ok selfhost_memo_trait_public_surface_hash_registry_scan_state_with_seed_table candidate_state next_seed_table
                Result::Err hash_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected hash_error
        Result::Err candidate_error:
            Result::Err candidate_error

//: selfhost_memo_trait_public_surface_hash_registry_scan_item_with_tokens_result: token-aware registry path 用に candidate と seed を同時に[更新/こうしん]する
//:
//: [契約/けいやく]:
//: - AST-only path と同じく candidate 分類を先に評価し、その後で shared token-aware seed scan core を呼びます。
//: - candidate 分類の error と shared core 由来の public surface hash error を同一 variant に潰しません。
fn selfhost_memo_trait_public_surface_hash_registry_scan_item_with_tokens_result %impure fn str impure fn &Vec SelfhostToken impure fn SelfhostMemoTraitPublicSurfaceHashRegistryScanState impure fn SelfhostModuleItem Result SelfhostMemoTraitPublicSurfaceHashRegistryScanState SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind \source\tokens\state\item:
    match selfhost_memo_trait_public_surface_hash_registry_scan_candidate_item_result source state item:
        Result::Ok candidate_state:
            match selfhost_memo_trait_public_surface_token_seed_scan_item_result source tokens candidate_state.seed_table item:
                Result::Ok next_seed_table:
                    Result::Ok selfhost_memo_trait_public_surface_hash_registry_scan_state_with_seed_table candidate_state next_seed_table
                Result::Err token_error:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashRegistryErrorKind::PublicSurfaceHashRejected selfhost_memo_trait_public_surface_hash_error_from_token_seed_scan_error token_error
        Result::Err candidate_error:
            Result::Err candidate_error

//: selfhost_memo_trait_public_surface_hash_scan_module_loop: hash materializer 内部で module item stream を 1 pass [走査/そうさ]する
fn selfhost_memo_trait_public_surface_hash_scan_module_loop %fn str fn &SelfhostModuleAst fn SelfhostMemoTraitStableSourceSeedTable fn i32 fn i32 Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\ast\table\idx\n:
    if:
        ge idx n
        then:
            Result::Ok table
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    match selfhost_memo_trait_public_surface_hash_scan_item_result source table item:
                        Result::Ok next_table:
                            selfhost_memo_trait_public_surface_hash_scan_module_loop source ast next_table add idx 1 n
                        Result::Err error:
                            Result::Err error
                Option::None:
                    Result::Err selfhost_memo_trait_public_surface_hash_error_from_seed_scan_error SelfhostMemoTraitPublicSurfaceSeedErrorKind::ItemUnavailable

//: selfhost_memo_trait_public_surface_hash_seed_table_complete_result: hash materializer 内部 scan の seed table を[完了/かんりょう][検査/けんさ]する
fn selfhost_memo_trait_public_surface_hash_seed_table_complete_result %fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \table:
    if:
        table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate
        else:
            if:
                table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate
                else:
                    match table.memo_key:
                        Option::Some _key_seed:
                            match table.memo_value:
                                Option::Some _value_seed:
                                    Result::Ok table
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing

