//: selfhost_memo_trait_public_surface_hash_input_table_from_seed_table_result: seed table を ordered input table へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - seed table の欠落・重複・kind mismatch は、旧 API と同じ typed error で返します。
//: - 変換後の accepted payload は seed table ではなく ordered input table です。full public surface normalizer の後続 item もこの境界に接続します。
fn selfhost_memo_trait_public_surface_hash_input_table_from_seed_table_result %fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitPublicSurfaceHashInputTable SelfhostMemoTraitPublicSurfaceHashErrorKind \seed_table:
    if:
        seed_table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate
        else:
            if:
                seed_table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate
                else:
                    match seed_table.memo_key:
                        Option::Some key_seed:
                            match seed_table.memo_value:
                                Option::Some value_seed:
                                    match selfhost_memo_trait_public_surface_hash_key_input_item_result key_seed:
                                        Result::Ok key_item:
                                            match selfhost_memo_trait_public_surface_hash_value_input_item_result value_seed:
                                                Result::Ok value_item:
                                                    Result::Ok selfhost_memo_trait_public_surface_hash_input_table_new key_item value_item
                                                Result::Err value_error:
                                                    Result::Err value_error
                                        Result::Err key_error:
                                            Result::Err key_error
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing

