//: selfhost_memo_trait_public_surface_hash_from_seed_table_result: seed table から public surface hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - source text と span は引数に取りません。この関数の hash authority は seed table の typed field だけです。
fn selfhost_memo_trait_public_surface_hash_from_seed_table_result %fn SelfhostMemoTraitStableSourceSeedTable Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \seed_table:
    if:
        seed_table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedDuplicate
        else:
            if:
                seed_table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedDuplicate
                else:
                    match seed_table.memo_key:
                        Option::Some key_seed:
                            match seed_table.memo_value:
                                Option::Some value_seed:
                                    match selfhost_memo_trait_public_surface_hash_key_seed_result key_seed:
                                        Result::Ok key_hash:
                                            match selfhost_memo_trait_public_surface_hash_value_seed_result value_seed:
                                                Result::Ok value_hash:
                                                    let public_hash %i32 selfhost_memo_trait_public_surface_hash_mix3 selfhost_memo_trait_public_surface_hash_schema_code key_hash value_hash
                                                    selfhost_memo_trait_public_surface_hash_nonzero_result public_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder
                                                Result::Err value_error:
                                                    Result::Err value_error
                                        Result::Err key_error:
                                            Result::Err key_error
                                Option::None:
                                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueSeedMissing
                        Option::None:
                            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedMissing

