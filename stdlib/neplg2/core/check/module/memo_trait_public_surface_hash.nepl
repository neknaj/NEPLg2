            match header.visibility:
                SelfhostModuleDeclarationVisibility::Public:
                    Result::Err public_error
                SelfhostModuleDeclarationVisibility::Private:
                    Result::Ok unit
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::DeclarationHeaderMissing

//: selfhost_memo_trait_public_surface_hash_scan_item_result: item 1 件を hash materializer の seed table へ[反映/はんえい]する
//:
//: [目的/もくてき]:
//: - unsupported public surface validation と marker trait seed accumulation を同じ item loop に置き、hash materializer 内で module item stream を二重に走査しないようにします。
fn selfhost_memo_trait_public_surface_hash_scan_item_result %fn str fn SelfhostMemoTraitStableSourceSeedTable fn SelfhostModuleItem Result SelfhostMemoTraitStableSourceSeedTable SelfhostMemoTraitPublicSurfaceHashErrorKind \source\table\item:
    match item.kind:
        SelfhostModuleItemKind::TraitDecl:
            selfhost_memo_trait_public_surface_hash_scan_trait_item_result source table item
        SelfhostModuleItemKind::DocComment:
            Result::Ok table
        SelfhostModuleItemKind::MlstrLine:
            Result::Ok table
        SelfhostModuleItemKind::EntryDirective:
            Result::Ok table
        SelfhostModuleItemKind::TargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::ImportDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::ImportSurfaceUnsupported
        SelfhostModuleItemKind::UseDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::UseSurfaceUnsupported
        SelfhostModuleItemKind::TestDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfTargetDirective:
            Result::Ok table
        SelfhostModuleItemKind::IfProfileDirective:
            Result::Ok table
        SelfhostModuleItemKind::CapabilityDirective:
            Result::Ok table
        SelfhostModuleItemKind::PreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::PreludeSurfaceUnsupported
        SelfhostModuleItemKind::NoPreludeDirective:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::NoPreludeSurfaceUnsupported
        SelfhostModuleItemKind::IntrinsicDirective:
            Result::Ok table
        SelfhostModuleItemKind::WasmBlock:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrBlock:
            Result::Ok table
        SelfhostModuleItemKind::WasmText:
            Result::Ok table
        SelfhostModuleItemKind::LlvmIrText:
            Result::Ok table
        SelfhostModuleItemKind::FunctionDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicFunctionSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::StructDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicStructSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::EnumDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicEnumSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error
        SelfhostModuleItemKind::ImplDecl:
            match selfhost_memo_trait_public_surface_hash_scan_public_decl_result item SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicImplSurfaceUnsupported:
                Result::Ok _private:
                    Result::Ok table
                Result::Err error:
                    Result::Err error

//: selfhost_memo_trait_public_surface_hash_registry_scan_state_add_candidate_name: candidate table へ trait name を[反映/はんえい]する
//:
//: [契約/けいやく]:
//: - `name` は source spelling から切り出した候補分類用の文字列です。
//: - 作る record は `signature_available=false` なので、この関数だけで trusted source identity は成立しません。
fn selfhost_memo_trait_public_surface_hash_registry_scan_state_add_candidate_name %fn SelfhostMemoTraitPublicSurfaceHashRegistryScanState fn str SelfhostMemoTraitPublicSurfaceHashRegistryScanState \state\name:
    if:
        string_search::str_eq name "MemoKey"
        then:
            selfhost_memo_trait_public_surface_hash_registry_scan_state_new:
                selfhost_memo_trait_definition_source_table_add_record:
                    state.candidates
                    selfhost_memo_trait_public_surface_hash_registry_scan_candidate_record SelfhostMemoTraitSourceKind::MemoKeyTrait
                state.seed_table
        else:
            if:
                string_search::str_eq name "MemoValue"
                then:
                    selfhost_memo_trait_public_surface_hash_registry_scan_state_new:
                        selfhost_memo_trait_definition_source_table_add_record:
                            state.candidates
                            selfhost_memo_trait_public_surface_hash_registry_scan_candidate_record SelfhostMemoTraitSourceKind::MemoValueTrait
                        state.seed_table
                else:
                    state

