//: selfhost_memo_trait_public_surface_hash_input_item_result: input item 1 件を hash part へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - ordinal と payload hash は nonzero である必要があります。
//: - source text、span、name、path、display、diagnostic は引数に取らず、typed input item の field だけを fold します。
fn selfhost_memo_trait_public_surface_hash_input_item_result %fn SelfhostMemoTraitPublicSurfaceHashInputItem Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \item:
    match selfhost_memo_trait_public_surface_hash_nonzero_result item.ordinal SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder:
        Result::Ok ordinal:
            match selfhost_memo_trait_public_surface_hash_nonzero_result item.payload_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder:
                Result::Ok payload_hash:
                    match selfhost_memo_trait_public_surface_hash_dependency_part_result item.kind item.dependency_public_surface_hash:
                        Result::Ok dependency_hash:
                            let kind_hash %i32 selfhost_memo_trait_public_surface_hash_input_kind_code item.kind
                            let visibility_hash %i32 selfhost_memo_trait_public_surface_hash_visibility_code item.visibility
                            let header_hash %i32 selfhost_memo_trait_public_surface_hash_mix3 kind_hash visibility_hash ordinal
                            let body_hash %i32 selfhost_memo_trait_public_surface_hash_mix2 payload_hash dependency_hash
                            let item_hash %i32 selfhost_memo_trait_public_surface_hash_mix3 232101 header_hash body_hash
                            selfhost_memo_trait_public_surface_hash_nonzero_result item_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder
                        Result::Err dependency_error:
                            Result::Err dependency_error
                Result::Err payload_error:
                    Result::Err payload_error
        Result::Err ordinal_error:
            Result::Err ordinal_error

//: selfhost_memo_trait_public_surface_hash_accumulator_next_hash: accumulator の[次/つぎ]の fold hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - 1 件目は item hash をそのまま採用します。2 件目以降は直前の folded hash と item hash を domain mix します。
//: - item 自体の検査は呼び出し側で済ませます。この helper は順序検査や dependency hash 検査を行いません。
fn selfhost_memo_trait_public_surface_hash_accumulator_next_hash %fn i32 fn i32 fn i32 i32 \count\folded_hash\item_hash:
    if:
        eq count 0
        then:
            item_hash
        else:
            selfhost_memo_trait_public_surface_hash_mix2 folded_hash item_hash

//: selfhost_memo_trait_public_surface_hash_input_accumulator_push_result: input item を fold state へ[追加/ついか]する
//:
//: [目的/もくてき]:
//: - full public surface normalizer が作った ordered item を 1 件ずつ fold します。
//:
//: [契約/けいやく]:
//: - item ordinal は `state.count + 1` と一致しなければなりません。これにより duplicate ordinal、欠番、順序入れ替えを fail-closed にします。
//: - item 自体の hash は `selfhost_memo_trait_public_surface_hash_input_item_result` で検査し、dependency hash 欠落や local item への余分な dependency hash をここで潰しません。
fn selfhost_memo_trait_public_surface_hash_input_accumulator_push_result %fn SelfhostMemoTraitPublicSurfaceHashInputAccumulator fn SelfhostMemoTraitPublicSurfaceHashInputItem Result SelfhostMemoTraitPublicSurfaceHashInputAccumulator SelfhostMemoTraitPublicSurfaceHashErrorKind \state\item:
    let expected_ordinal %i32 add state.count 1
    if:
        not eq item.ordinal expected_ordinal
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceInputOrdinalMismatch
        else:
            match selfhost_memo_trait_public_surface_hash_input_item_result item:
                Result::Ok item_hash:
                    let next_count %i32 expected_ordinal
                    let next_hash %i32 selfhost_memo_trait_public_surface_hash_accumulator_next_hash state.count state.folded_hash item_hash
                    Result::Ok selfhost_memo_trait_public_surface_hash_input_accumulator_new next_count next_hash
                Result::Err item_error:
                    Result::Err item_error

//: selfhost_memo_trait_public_surface_hash_input_accumulator_finish_result: fold state から public surface hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - item が 1 件も無い input は full public surface ではないため拒否します。
//: - finish hash は schema code、item count、folded item hash だけから作ります。
fn selfhost_memo_trait_public_surface_hash_input_accumulator_finish_result %fn SelfhostMemoTraitPublicSurfaceHashInputAccumulator Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \state:
    if:
        eq state.count 0
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceInputEmpty
        else:
            let public_hash %i32 selfhost_memo_trait_public_surface_hash_mix3 selfhost_memo_trait_public_surface_hash_input_schema_code state.count state.folded_hash
            selfhost_memo_trait_public_surface_hash_nonzero_result public_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::PublicSurfaceHashPlaceholder

//: selfhost_memo_trait_public_surface_hash_input_table_result: ordered input table から public surface hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - item 順序は public surface hash の一部です。同じ item でも順序が違えば別の hash になります。
//: - この関数は full public surface input schema だけを使い、seed table を別 schema で直接 fold しません。
fn selfhost_memo_trait_public_surface_hash_input_table_result %fn SelfhostMemoTraitPublicSurfaceHashInputTable Result i32 SelfhostMemoTraitPublicSurfaceHashErrorKind \table:
    let start %SelfhostMemoTraitPublicSurfaceHashInputAccumulator selfhost_memo_trait_public_surface_hash_input_accumulator_empty
    match selfhost_memo_trait_public_surface_hash_input_accumulator_push_result start table.first:
        Result::Ok after_first:
            match selfhost_memo_trait_public_surface_hash_input_accumulator_push_result after_first table.second:
                Result::Ok after_second:
                    selfhost_memo_trait_public_surface_hash_input_accumulator_finish_result after_second
                Result::Err second_error:
                    Result::Err second_error
        Result::Err first_error:
            Result::Err first_error

//: selfhost_memo_trait_public_surface_hash_key_input_item_result: MemoKey seed を input item へ[変換/へんかん]する
fn selfhost_memo_trait_public_surface_hash_key_input_item_result %fn SelfhostMemoTraitStableSourceTraitSeed Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashErrorKind \seed:
    if:
        selfhost_memo_trait_source_kind_eq seed.kind SelfhostMemoTraitSourceKind::MemoKeyTrait
        then:
            match seed.visibility:
                SelfhostModuleDeclarationVisibility::Public:
                    match selfhost_memo_trait_public_surface_hash_option_result seed.declaration_ordinal SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalMissing SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyDeclarationOrdinalPlaceholder:
                        Result::Ok declaration_ordinal:
                            match selfhost_memo_trait_public_surface_hash_option_result seed.normalized_signature_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignatureMissing SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyNormalizedSignaturePlaceholder:
                                Result::Ok normalized_signature_hash:
                                    Result::Ok selfhost_memo_trait_public_surface_hash_input_item_new:
                                        SelfhostMemoTraitPublicSurfaceHashInputKind::LocalMemoTrait seed.kind
                                        declaration_ordinal
                                        seed.visibility
                                        normalized_signature_hash
                                        Option::None
                                Result::Err signature_error:
                                    Result::Err signature_error
                        Result::Err ordinal_error:
                            Result::Err ordinal_error
                SelfhostModuleDeclarationVisibility::Private:
                    Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeyPrivateVisibility
        else:
            Result::Err SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoKeySeedKindMismatch

//: selfhost_memo_trait_public_surface_hash_value_input_item_result: MemoValue seed を input item へ[変換/へんかん]する
fn selfhost_memo_trait_public_surface_hash_value_input_item_result %fn SelfhostMemoTraitStableSourceTraitSeed Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashErrorKind \seed:
    if:
        selfhost_memo_trait_source_kind_eq seed.kind SelfhostMemoTraitSourceKind::MemoValueTrait
        then:
            match seed.visibility:
                SelfhostModuleDeclarationVisibility::Public:
                    match selfhost_memo_trait_public_surface_hash_option_result seed.declaration_ordinal SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalMissing SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueDeclarationOrdinalPlaceholder:
                        Result::Ok declaration_ordinal:
                            match selfhost_memo_trait_public_surface_hash_option_result seed.normalized_signature_hash SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignatureMissing SelfhostMemoTraitPublicSurfaceHashErrorKind::MemoValueNormalizedSignaturePlaceholder:
                                Result::Ok normalized_signature_hash:
                                    Result::Ok selfhost_memo_trait_public_surface_hash_input_item_new:
                                        SelfhostMemoTraitPublicSurfaceHashInputKind::LocalMemoTrait seed.kind
                                        declaration_ordinal
                                        seed.visibility
                                        normalized_signature_hash
                                        Option::None
                                Result::Err signature_error:
