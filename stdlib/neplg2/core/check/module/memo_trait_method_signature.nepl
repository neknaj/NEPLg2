            match selfhost_memo_trait_method_signature_check_value_mark_header source tokens segment.header:
                Result::Ok _header_ok:
                    if selfhost_memo_trait_method_signature_value_mark_body_ok source tokens segment.header segment.default_body Result::Ok unit Result::Err SelfhostMemoTraitMethodSignatureErrorKind::DefaultBodyMismatch role
                Result::Err e:
