//: selfhost_memo_trait_method_signature_result_with_segments: segment list を method signature evidence へ[正規化/せいきか]する
//:
//: [契約/けいやく]:
//: - この helper は `selfhost_memo_trait_method_signature_result` の内部だけで使います。
//: - 公開 API にしないことで、caller が segmenter を通していない fake segment aggregate を渡し、trusted signature pipeline を迂回する経路を作らないようにします。
fn selfhost_memo_trait_method_signature_result_with_segments %fn str fn &Vec SelfhostToken fn SelfhostMemoTraitSourceKind fn &SelfhostTraitBodyMethodSegmentList Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind \source\tokens\kind\list:
    match kind:
        SelfhostMemoTraitSourceKind::MemoKeyTrait:
            selfhost_memo_trait_method_signature_key_result source tokens list
        SelfhostMemoTraitSourceKind::MemoValueTrait:
            selfhost_memo_trait_method_signature_value_result source tokens list

//: selfhost_memo_trait_method_signature_result: trait body envelope から method signature evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - parser-level method segmentation と checker-level method role normalization を接続します。
//:
//: [契約/けいやく]:
//: - caller は、この envelope が public `MemoKey` / `MemoValue` trait declaration の body range であることを前段の module/public-surface gate で確認してから呼びます。
//: - segmentation list owner はこの関数内で必ず閉じます。
//: - source text は canonical spelling 分類にだけ使い、accepted evidence の hash は `selfhost_memo_trait_method_signature_hash` の固定 code から作ります。
pub fn selfhost_memo_trait_method_signature_result %impure fn str impure fn &Vec SelfhostToken impure fn SelfhostMemoTraitSourceKind impure fn SelfhostSyntaxRange Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind \source\tokens\kind\envelope:
    match selfhost_trait_body_method_segment_list_from_envelope tokens envelope:
        Result::Ok list:
            let result %Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind selfhost_memo_trait_method_signature_result_with_segments source tokens kind &list
            selfhost_trait_body_method_segment_list_free list
            result
        Result::Err segment_error:
            Result::Err SelfhostMemoTraitMethodSignatureErrorKind::BodySegmentRejected segment_error.kind

//: selfhost_memo_trait_method_signature_stage0_envelope: stage0 source 全体を trait body envelope として[扱/あつか]う
fn selfhost_memo_trait_method_signature_stage0_envelope %fn str fn &Vec SelfhostToken SelfhostSyntaxRange \source\tokens:
    let token_count %i32 sub v::len tokens 1
    selfhost_syntax_range_new_unchecked 0 token_count source_span_new_unchecked 0 0 string_access::len source

//: selfhost_memo_trait_method_signature_stage0_result: source fixture を lex して normalizer に[通/とお]す
fn selfhost_memo_trait_method_signature_stage0_result %impure fn str impure fn SelfhostMemoTraitSourceKind Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind \source\kind:
    match lex_all source:
        Result::Ok tokens:
            let envelope %SelfhostSyntaxRange selfhost_memo_trait_method_signature_stage0_envelope source &tokens
            let result %Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind selfhost_memo_trait_method_signature_result source &tokens kind envelope
            v::free tokens
            result
        Result::Err _lex_error:
            Result::Err SelfhostMemoTraitMethodSignatureErrorKind::LexerRejected

//: selfhost_memo_trait_method_signature_stage0_summary_new: stage0 summary を[作/つく]る
fn selfhost_memo_trait_method_signature_stage0_summary_new %fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind fn Result SelfhostMemoTraitMethodSignatureEvidence SelfhostMemoTraitMethodSignatureErrorKind SelfhostMemoTraitMethodSignatureStage0Summary \accepted_key\accepted_value\wrong_name_rejected\wrong_body_rejected\wrong_count_rejected\wrong_type_rejected\wrong_lambda_rejected\segment_rejected:
    SelfhostMemoTraitMethodSignatureStage0Summary accepted_key accepted_value wrong_name_rejected wrong_body_rejected wrong_count_rejected wrong_type_rejected wrong_lambda_rejected segment_rejected

//: selfhost_memo_trait_method_signature_stage0: method-bearing memo trait の代表結果を[返/かえ]す
pub fn selfhost_memo_trait_method_signature_stage0 %impure fn void SelfhostMemoTraitMethodSignatureStage0Summary \void:
    let key_source %str "fn memo_key_eq %fn Self fn Self bool \\a\\b: false\nfn memo_key_hash32 %fn Self i32 \\self: 0\n"
    let value_source %str "fn memo_value_mark %fn Self Self \\value: value\n"
    let wrong_name_source %str "fn memo_key_bad %fn Self fn Self bool \\a\\b: false\nfn memo_key_hash32 %fn Self i32 \\self: 0\n"
    let wrong_body_source %str "fn memo_value_mark %fn Self Self \\x: value\n"
    let wrong_count_source %str "fn memo_key_eq %fn Self fn Self bool \\a\\b: false\n"
    let wrong_type_source %str "fn memo_value_mark %fn Self bool \\value: value\n"
    let wrong_lambda_source %str "fn memo_value_mark %fn Self Self value value: value\n"
    let segment_rejected_source %str "let x 1\n"
    selfhost_memo_trait_method_signature_stage0_summary_new:
        selfhost_memo_trait_method_signature_stage0_result key_source SelfhostMemoTraitSourceKind::MemoKeyTrait
        selfhost_memo_trait_method_signature_stage0_result value_source SelfhostMemoTraitSourceKind::MemoValueTrait
        selfhost_memo_trait_method_signature_stage0_result wrong_name_source SelfhostMemoTraitSourceKind::MemoKeyTrait
        selfhost_memo_trait_method_signature_stage0_result wrong_body_source SelfhostMemoTraitSourceKind::MemoValueTrait
        selfhost_memo_trait_method_signature_stage0_result wrong_count_source SelfhostMemoTraitSourceKind::MemoKeyTrait
        selfhost_memo_trait_method_signature_stage0_result wrong_type_source SelfhostMemoTraitSourceKind::MemoValueTrait
        selfhost_memo_trait_method_signature_stage0_result wrong_lambda_source SelfhostMemoTraitSourceKind::MemoValueTrait
        selfhost_memo_trait_method_signature_stage0_result segment_rejected_source SelfhostMemoTraitSourceKind::MemoKeyTrait
