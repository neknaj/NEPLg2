//: selfhost_memo_trait_public_type_layout_header_input_new: typed input を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は field をまとめるだけです。visibility、ordinal、stable nominal key、count の検査は producer 本体で行います。
pub fn selfhost_memo_trait_public_type_layout_header_input_new %fn SelfhostModuleDeclarationVisibility fn Option i32 fn Option SelfhostMemoTraitStableNominalKey fn SelfhostMemoTraitPublicTypeLayoutHeaderKind fn i32 fn i32 fn i32 SelfhostMemoTraitPublicTypeLayoutHeaderInput \visibility\declaration_ordinal\stable_nominal_key\kind\type_arity\field_count\variant_count:
    SelfhostMemoTraitPublicTypeLayoutHeaderInput visibility declaration_ordinal stable_nominal_key kind type_arity field_count variant_count

//: selfhost_memo_trait_public_type_layout_header_schema_version: layout header shape hash schema version
//:
//: [契約/けいやく]:
//: - layout kind、arity、field count、variant count、stable nominal key fold のどれかを変える場合はこの version を更新します。
fn selfhost_memo_trait_public_type_layout_header_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_type_layout_header_mix2: layout header hash 用の 2 field [混合/こんごう]
fn selfhost_memo_trait_public_type_layout_header_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_type_layout_header_mix3: layout header hash 用の 3 field [混合/こんごう]
fn selfhost_memo_trait_public_type_layout_header_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_public_type_layout_header_mix2 a b c

//: selfhost_memo_trait_public_type_layout_header_mix4: layout header hash 用の 4 field [混合/こんごう]
fn selfhost_memo_trait_public_type_layout_header_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_type_layout_header_mix2 selfhost_memo_trait_public_type_layout_header_mix2 a b selfhost_memo_trait_public_type_layout_header_mix2 c d

//: selfhost_memo_trait_public_type_layout_header_payload_schema_code: public declaration payload schema の domain code
//:
//: [契約/けいやく]:
//: - normalizer の `SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput` と同じ field 構成を hash へ畳みます。
//: - この helper は facade 公開されません。normalizer の内部 adapter を公開 API に漏らさず、layout producer が同じ typed payload contract に従うための局所境界です。
fn selfhost_memo_trait_public_type_layout_header_payload_schema_code %fn void i32 \void:
    252301

//: selfhost_memo_trait_public_type_layout_header_payload_kind_code: public declaration kind を payload domain code へ[写/うつ]す
fn selfhost_memo_trait_public_type_layout_header_payload_kind_code %fn SelfhostMemoTraitPublicSurfacePublicDeclarationKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Function:
            252311
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Struct:
            252312
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Enum:
            252313
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Impl:
            252314

//: selfhost_memo_trait_public_type_layout_header_kind_code: layout header kind を shape domain code へ[写/うつ]す
fn selfhost_memo_trait_public_type_layout_header_kind_code %fn SelfhostMemoTraitPublicTypeLayoutHeaderKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicTypeLayoutHeaderKind::Struct:
            252501
        SelfhostMemoTraitPublicTypeLayoutHeaderKind::Enum:
            252502

//: selfhost_memo_trait_public_type_layout_header_public_kind: layout header kind を normalizer declaration kind へ[写/うつ]す
fn selfhost_memo_trait_public_type_layout_header_public_kind %fn SelfhostMemoTraitPublicTypeLayoutHeaderKind SelfhostMemoTraitPublicSurfacePublicDeclarationKind \kind:
    match kind:
        SelfhostMemoTraitPublicTypeLayoutHeaderKind::Struct:
            SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Struct
        SelfhostMemoTraitPublicTypeLayoutHeaderKind::Enum:
            SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Enum

//: selfhost_memo_trait_public_type_layout_header_payload_hash_result: payload input から stable hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - stable declaration key と normalized declaration shape は nonzero でなければなりません。
//: - source text、span、display name、diagnostic text は読まず、payload input の typed field だけを authority にします。
//: - normalizer の内部 adapter と同じ placeholder error kind を返し、呼び出し側が layout producer の error enum へ包めるようにします。
fn selfhost_memo_trait_public_type_layout_header_payload_hash_result %fn SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \input:
    if:
        eq input.stable_declaration_key_hash 0
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StableDeclarationKeyHashPlaceholder
        else:
            if:
                eq input.normalized_declaration_shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::NormalizedDeclarationShapeHashPlaceholder
                else:
                    let kind_hash %i32 selfhost_memo_trait_public_type_layout_header_payload_kind_code input.kind
                    let header_hash %i32 selfhost_memo_trait_public_type_layout_header_mix3 selfhost_memo_trait_public_type_layout_header_payload_schema_code kind_hash input.stable_declaration_key_hash
                    let payload_hash %i32 selfhost_memo_trait_public_type_layout_header_mix2 header_hash input.normalized_declaration_shape_hash
                    if:
                        eq payload_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DerivedDeclarationPayloadHashPlaceholder
                        else:
                            Result::Ok payload_hash

//: selfhost_memo_trait_public_type_layout_header_visibility_result: public visibility を[検査/けんさ]する
fn selfhost_memo_trait_public_type_layout_header_visibility_result %fn SelfhostModuleDeclarationVisibility Result unit SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Public:
            Result::Ok unit
        SelfhostModuleDeclarationVisibility::Private:
            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::PrivateVisibilityRejected

//: selfhost_memo_trait_public_type_layout_header_ordinal_result: declaration ordinal を[検査/けんさ]する
fn selfhost_memo_trait_public_type_layout_header_ordinal_result %fn Option i32 Result i32 SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \declaration_ordinal:
    match declaration_ordinal:
        Option::Some ordinal:
            if:
                eq ordinal 0
                then:
                    Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::DeclarationOrdinalPlaceholder
                else:
                    Result::Ok ordinal
        Option::None:
            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::DeclarationOrdinalMissing

//: selfhost_memo_trait_public_type_layout_header_stable_key_result: stable nominal key を[検査/けんさ]する
fn selfhost_memo_trait_public_type_layout_header_stable_key_result %fn Option SelfhostMemoTraitStableNominalKey fn i32 Result SelfhostMemoTraitStableNominalKey SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \stable_nominal_key\type_arity:
    match stable_nominal_key:
        Option::Some key:
            if:
                eq key.nominal_key_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StableNominalKeyPlaceholder
                else:
                    if:
                        eq key.type_arity type_arity
                        then:
                            Result::Ok key
                        else:
                            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StableNominalKeyArityMismatch
        Option::None:
            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StableNominalKeyMissing

//: selfhost_memo_trait_public_type_layout_header_counts_result: layout header count を[検査/けんさ]する
fn selfhost_memo_trait_public_type_layout_header_counts_result %fn SelfhostMemoTraitPublicTypeLayoutHeaderKind fn i32 fn i32 fn i32 Result unit SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \kind\type_arity\field_count\variant_count:
    if:
        lt type_arity 0
        then:
            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::TypeArityNegative
        else:
            if:
                lt field_count 0
                then:
                    Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::FieldCountNegative
                else:
                    if:
                        lt variant_count 0
                        then:
                            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::VariantCountNegative
                        else:
                            match kind:
                                SelfhostMemoTraitPublicTypeLayoutHeaderKind::Struct:
                                    if:
                                        eq variant_count 0
                                        then:
                                            Result::Ok unit
                                        else:
                                            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StructVariantCountNonzero
                                SelfhostMemoTraitPublicTypeLayoutHeaderKind::Enum:
                                    Result::Ok unit

//: selfhost_memo_trait_public_type_layout_header_shape_hash_result: type layout header shape hash を[作/つく]る
//:
//: [目的/もくてき]:
//: - public type constructor の依存側に見える layout header を stable hash へ畳みます。
//:
//: [契約/けいやく]:
//: - stable nominal key hash、layout kind、arity、field count、variant count だけを accepted hash material にします。
//: - field type closure と variant payload の詳細は別 solver の evidence であり、この header hash に直接入れません。
pub fn selfhost_memo_trait_public_type_layout_header_shape_hash_result %fn SelfhostMemoTraitStableNominalKey fn SelfhostMemoTraitPublicTypeLayoutHeaderKind fn i32 fn i32 fn i32 Result SelfhostMemoTraitPublicTypeLayoutHeaderShapeHash SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \stable_key\kind\type_arity\field_count\variant_count:
    match selfhost_memo_trait_public_type_layout_header_counts_result kind type_arity field_count variant_count:
        Result::Ok _unit:
            let schema %i32 selfhost_memo_trait_public_type_layout_header_schema_version
            let kind_hash %i32 selfhost_memo_trait_public_type_layout_header_kind_code kind
            let left %i32 selfhost_memo_trait_public_type_layout_header_mix4 schema kind_hash stable_key.nominal_key_hash type_arity
            let right %i32 selfhost_memo_trait_public_type_layout_header_mix2 field_count variant_count
            let root_hash %i32 selfhost_memo_trait_public_type_layout_header_mix2 left right
            if:
                eq root_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::DerivedLayoutHeaderShapeHashPlaceholder
                else:
                    Result::Ok SelfhostMemoTraitPublicTypeLayoutHeaderShapeHash schema root_hash
        Result::Err counts_error:
            Result::Err counts_error

//: selfhost_memo_trait_public_type_layout_header_payload_input_result: public declaration payload input を[作/つく]る
//:
//: [目的/もくてき]:
//: - layout header producer の typed input を、normalizer 共通の public declaration payload input へ変換します。
//:
//: [契約/けいやく]:
//: - visibility、stable nominal key、count を先に検査します。
//: - `stable_declaration_key_hash` には stable nominal key の `nominal_key_hash` を使います。
//: - `normalized_declaration_shape_hash` には schema version 付き layout header shape hash の root hash を使います。
pub fn selfhost_memo_trait_public_type_layout_header_payload_input_result %fn SelfhostMemoTraitPublicTypeLayoutHeaderInput Result SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \input:
    match selfhost_memo_trait_public_type_layout_header_visibility_result input.visibility:
        Result::Ok _unit:
            match selfhost_memo_trait_public_type_layout_header_stable_key_result input.stable_nominal_key input.type_arity:
                Result::Ok stable_key:
                    match selfhost_memo_trait_public_type_layout_header_shape_hash_result stable_key input.kind input.type_arity input.field_count input.variant_count:
                        Result::Ok shape:
                            Result::Ok SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput selfhost_memo_trait_public_type_layout_header_public_kind input.kind stable_key.nominal_key_hash shape.root_hash
                        Result::Err shape_error:
                            Result::Err shape_error
                Result::Err key_error:
                    Result::Err key_error
        Result::Err visibility_error:
            Result::Err visibility_error

//: selfhost_memo_trait_public_type_layout_header_evidence_result: public struct / enum declaration evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - stable public type layout header producer の主 API です。
//:
//: [契約/けいやく]:
//: - ordinal を検査してから payload input を作り、module-local private payload hash helper で normalizer-compatible evidence を作ります。
//: - source text、span、display name、diagnostic text は accepted path で参照しません。
pub fn selfhost_memo_trait_public_type_layout_header_evidence_result %fn SelfhostMemoTraitPublicTypeLayoutHeaderInput Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind \input:
    match selfhost_memo_trait_public_type_layout_header_ordinal_result input.declaration_ordinal:
        Result::Ok ordinal:
            match selfhost_memo_trait_public_type_layout_header_payload_input_result input:
                Result::Ok payload_input:
                    match selfhost_memo_trait_public_type_layout_header_payload_hash_result payload_input:
                        Result::Ok payload_hash:
                            Result::Ok SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence payload_input.kind ordinal payload_hash
                        Result::Err payload_error:
                            Result::Err SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::PublicDeclarationPayloadRejected payload_error
                Result::Err input_error:
                    Result::Err input_error
        Result::Err ordinal_error:
            Result::Err ordinal_error

//: selfhost_memo_trait_public_type_layout_header_kind_eq: layout header kind が同じか[返/かえ]す
