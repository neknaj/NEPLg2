impl Clone for SelfhostMemoTraitPublicTypeLayoutHeaderInput:
    fn clone %fn &SelfhostMemoTraitPublicTypeLayoutHeaderInput SelfhostMemoTraitPublicTypeLayoutHeaderInput \self:
        *self

impl Copy for SelfhostMemoTraitPublicTypeLayoutHeaderInput:
    fn copy_mark %fn SelfhostMemoTraitPublicTypeLayoutHeaderInput SelfhostMemoTraitPublicTypeLayoutHeaderInput \self:
        self

