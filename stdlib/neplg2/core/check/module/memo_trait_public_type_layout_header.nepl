#indent 4

//: # check/module/memo_trait_public_type_layout_header
//: public struct / enum declaration の typed layout header evidence を public surface normalizer の payload input へ[変換/へんかん]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface hash が public struct / enum を source header の文字列ではなく、stable nominal key、type parameter arity、field / variant count から受け取れるようにします。
//: - `SelfhostMemoTraitStableNominalKey` を public declaration key として使い、session-local `SelfhostNamedTypeId`、source span、display name を accepted hash material にしない境界を固定します。
//: - struct と enum は同じ type constructor 形状を持っていても public surface 上の宣言種別が違うため、layout header kind と normalizer declaration kind の両方を hash material に反映します。
//: - normalizer が受け取る public declaration payload input と同じ schema で payload hash を作り、function signature producer と同じ public declaration evidence stream へ合流できるようにします。
//:
//: [契約/けいやく]:
//: - accepted layout header evidence は `SelfhostMemoTraitPublicTypeLayoutHeaderInput` の typed field と `SelfhostMemoTraitStableNominalKey` だけから作ります。
//: - source text、span、lexeme、display name、diagnostic text、path suffix、HIR、Resource IR、backend artifact、proof store record は accepted hash material に入りません。
//: - `visibility` は `Public` だけを受理します。private struct / enum は public surface input ではないため typed error にします。
//: - `declaration_ordinal` と `stable_nominal_key` は `some` でなければなりません。欠落と placeholder は別の enum error として返します。
//: - `type_arity` は stable nominal key の `type_arity` と一致しなければなりません。public surface の型引数 arity と canonical key 側の arity がずれると、後続の generic instantiation proof が別 constructor を同一視するためです。
//: - struct は `variant_count = 0` の product header として扱います。enum は `variant_count >= 0` の sum header として扱い、variant layout の詳細 proof は後続 stage が別 evidence として接続します。
//:
//: [現状/げんじょう]:
//: - この module は struct / enum layout header producer の最初の接続点です。field type closure、enum variant payload layout、trait impl table、method body purity、Drop なし proof はまだ計算しません。
//: - stable nominal key 自体は caller が作ります。後続の `.neplmeta` producer が type constructor table から stable nominal key table を作る段階でも、この module は同じ typed key payload を受け取ります。
//: - facade にはまだ re-export しません。full public surface orchestration が function / layout / impl producer をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - layout header shape hash は fixed-size payload だけを fold するため O(1) 時間・O(1) 追加空間です。
//: - field / variant の詳細 table を走査しないため、構造体や列挙型の内部要素数に比例する処理はこの module では行いません。詳細 layout proof は後続 solver の責務です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_type_layout_header" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_type_layout_header_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.struct_header
//:     let checks2 checks_push checks1 check is_ok summary.enum_header
//:     let checks3 checks_push checks2 check summary.struct_and_enum_differ
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_type_layout_header_error_kind_eq unwrap_err summary.private_rejected SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::PrivateVisibilityRejected
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_type_layout_header_error_kind_eq unwrap_err summary.key_missing_rejected SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StableNominalKeyMissing
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_type_layout_header_error_kind_eq unwrap_err summary.arity_mismatch_rejected SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind::StableNominalKeyArityMismatch
//:     let shown checks_print_report checks6
//:     checks_exit_code shown
//: ```

#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty" as *
#import "./memo_trait_public_surface_normalizer" as *
#import "./memo_trait_stable_nominal_key_producer" as *

//: SelfhostMemoTraitPublicTypeLayoutHeaderKind: public type constructor layout header の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - struct と enum の shape hash domain を分け、同じ stable nominal key と count payload を持つ場合でも public surface 上の宣言種別を混同しないようにします。
pub enum SelfhostMemoTraitPublicTypeLayoutHeaderKind:
    Struct
    Enum

//: SelfhostMemoTraitPublicTypeLayoutHeaderShapeHash: public type layout header の normalized fingerprint
//:
//: [目的/もくてき]:
//: - stable nominal key と public layout header count から作った shape hash を schema version と一緒に保持します。
//:
//: [契約/けいやく]:
//: - `schema_version` は hash material の構造を表します。
//: - `root_hash` は nonzero でなければ accepted shape ではありません。
pub struct SelfhostMemoTraitPublicTypeLayoutHeaderShapeHash:
    schema_version %i32
    root_hash %i32

//: SelfhostMemoTraitPublicTypeLayoutHeaderInput: public struct / enum layout header producer の typed input
//:
//: [目的/もくてき]:
//: - visibility、public declaration ordinal、stable nominal key、layout header kind、arity / field / variant count を 1 record にまとめます。
//:
//: [契約/けいやく]:
//: - `stable_nominal_key` は stable nominal key producer が作った nonzero key です。`none` は欠落として拒否します。
//: - `type_arity` は public type constructor の type parameter 数です。stable nominal key の `type_arity` と一致しなければなりません。
//: - `field_count` は struct なら product field count、enum なら variant payload field の合計や後続 solver が共有する header count seed です。詳細 field type proof はここでは持ちません。
//: - `variant_count` は struct では 0 でなければなりません。enum では 0 以上を許可し、empty enum を言語仕様がどう扱うかは後続の enum semantic checker が決めます。
pub struct SelfhostMemoTraitPublicTypeLayoutHeaderInput:
    visibility %SelfhostModuleDeclarationVisibility
    declaration_ordinal %Option i32
    stable_nominal_key %Option SelfhostMemoTraitStableNominalKey
    kind %SelfhostMemoTraitPublicTypeLayoutHeaderKind
    type_arity %i32
    field_count %i32
    variant_count %i32

//: SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind: public type layout header producer の拒否理由
//:
//: [目的/もくてき]:
//: - visibility、ordinal、stable nominal key、shape header、normalizer payload hash の失敗を同じ enum に潰さず保持します。
pub enum SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind:
    PrivateVisibilityRejected
    DeclarationOrdinalMissing
    DeclarationOrdinalPlaceholder
    StableNominalKeyMissing
    StableNominalKeyPlaceholder
    StableNominalKeyArityMismatch
    TypeArityNegative
    FieldCountNegative
    VariantCountNegative
    StructVariantCountNonzero
    DerivedLayoutHeaderShapeHashPlaceholder
    PublicDeclarationPayloadRejected %SelfhostMemoTraitPublicSurfaceNormalizerErrorKind

//: SelfhostMemoTraitPublicTypeLayoutHeaderStage0Summary: layout header producer の代表 smoke
//:
//: [目的/もくてき]:
//: - struct / enum accepted path、種別差分、private / missing key / arity mismatch rejection をまとめます。
pub struct SelfhostMemoTraitPublicTypeLayoutHeaderStage0Summary:
    struct_header %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind
    enum_header %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind
    struct_and_enum_differ %bool
    private_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind
    key_missing_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind
    arity_mismatch_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicTypeLayoutHeaderErrorKind

