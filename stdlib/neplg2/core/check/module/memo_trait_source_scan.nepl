    let stable_signature_table0 %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitDefinitionScanErrorKind:
        selfhost_memo_trait_definition_source_table_scan_item_result source empty_table key_item
    let stable_signature_table1 %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitDefinitionScanErrorKind:
        selfhost_memo_trait_definition_source_table_scan_item_after_result source stable_signature_table0 value_item
    let malformed_header_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitDefinitionScanErrorKind:
