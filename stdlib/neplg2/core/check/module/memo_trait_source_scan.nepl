        selfhost_memo_trait_trusted_source_registry_from_scan_table_result value_only_table
        selfhost_memo_trait_trusted_source_registry_from_scan_table_result duplicate_key_table2
        selfhost_memo_trait_trusted_source_registry_from_scan_table_result duplicate_value_table2
        selfhost_memo_trait_trusted_source_registry_from_scan_table_result wrong_kind_table
        selfhost_memo_trait_trusted_source_registry_from_scan_table_result stable_signature_table1
