//: selfhost_memo_trait_definition_scan_stage0_module_registry_result: 公開 module scan API を通した representative result を[返/かえ]す
//:
//: [目的/もくてき]:
//: - stage0 が private item helper だけでなく、`SelfhostModuleAst` owner を作り、公開 scanner API で走査する経路も実行します。
//: - allocation 失敗は scanner そのものの意味論ではないため、この smoke では `ScanRejected(ItemUnavailable)` に丸めます。実運用の loader / parser boundary では allocation diagnostic を別に保持します。
//:
//: [契約/けいやく]:
//: - 成功時は `selfhost_memo_trait_trusted_source_registry_scan_module_result` を呼び、scan 後に `selfhost_module_ast_free` で AST buffer を解放します。
//: - `MemoKey` / `MemoValue` が両方存在しても scanner record は `signature_available=false` なので、結果は trusted registry 成功ではなく `SignatureMissing` です。
fn selfhost_memo_trait_definition_scan_stage0_module_registry_result %impure fn str impure fn SelfhostModuleItem impure fn SelfhostModuleItem Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitDefinitionScanRegistryErrorKind \source\key_item\value_item:
    match selfhost_module_ast_new:
        Result::Ok ast0:
            match selfhost_module_ast_push ast0 key_item:
                Result::Ok ast1:
                    match selfhost_module_ast_push ast1 value_item:
                        Result::Ok ast2:
                            let result %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitDefinitionScanRegistryErrorKind selfhost_memo_trait_trusted_source_registry_scan_module_result source &ast2
                            selfhost_module_ast_free ast2
                            result
                        Result::Err _push_value_error:
                            Result::Err SelfhostMemoTraitDefinitionScanRegistryErrorKind::ScanRejected SelfhostMemoTraitDefinitionScanErrorKind::ItemUnavailable
                Result::Err _push_key_error:
                    Result::Err SelfhostMemoTraitDefinitionScanRegistryErrorKind::ScanRejected SelfhostMemoTraitDefinitionScanErrorKind::ItemUnavailable
        Result::Err _alloc_error:
            Result::Err SelfhostMemoTraitDefinitionScanRegistryErrorKind::ScanRejected SelfhostMemoTraitDefinitionScanErrorKind::ItemUnavailable

//: selfhost_memo_trait_definition_scan_stage0: scanner の代表 fail-closed 結果を[返/かえ]す
//:
//: [目的/もくてき]:
//: - AST item から table 候補を作る経路と、既存 registry validator へつなぐ経路の代表 case を返します。
//: - stable source identity が未接続である間、両方の trait が見つかっても accepted registry にならないことを確認できます。
pub fn selfhost_memo_trait_definition_scan_stage0 %impure fn void SelfhostMemoTraitDefinitionScanStage0Summary \void:
    let source %str "trait MemoKey:\ntrait MemoValue:\nfn MemoKey %fn void unit \\void:\ntrait MemoKey:\n"
