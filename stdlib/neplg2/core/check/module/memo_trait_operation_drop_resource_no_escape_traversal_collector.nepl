//: SelfhostDropResourceGraphId: Drop body 用 Resource graph の session-local id
pub struct SelfhostDropResourceGraphId:
    index %i32

//: SelfhostResourcePlaceId: Resource graph 内の place id
pub struct SelfhostResourcePlaceId:
    index %i32

//: SelfhostDropResourceGraphCompleteness: Drop body graph の閉包状態
//:
//: [目的/もくてき]:
//: - graph が Drop body について閉じている場合だけ no-escape 判定へ進めます。
pub enum SelfhostDropResourceGraphCompleteness:
    ClosedForDropBody
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostResourcePlaceKind: Resource graph place の分類
pub enum SelfhostResourcePlaceKind:
    PrivateLocal
    PrivateTemporary
    ReturnPlace
    PublicStore
    ExternalHandle
    UnsupportedPlace

//: SelfhostResourceEdgeKind: Resource graph edge の分類
pub enum SelfhostResourceEdgeKind:
    Owns
    Field
    BorrowView
    MoveTo
    StoreToPublic
    Return
    CallBoundaryUnsupported

//: SelfhostDropResourceGraphBodyRecord: 1 Drop body の Resource graph header
pub struct SelfhostDropResourceGraphBodyRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    graph_id %SelfhostDropResourceGraphId
    completeness %SelfhostDropResourceGraphCompleteness

//: SelfhostDropResourceGraphPlaceRecord: Resource graph の place record
pub struct SelfhostDropResourceGraphPlaceRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostDropResourceGraphId
    place_id %SelfhostResourcePlaceId
    kind %SelfhostResourcePlaceKind

//: SelfhostDropResourceGraphEdgeRecord: Resource graph の edge record
pub struct SelfhostDropResourceGraphEdgeRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostDropResourceGraphId
    from_place %SelfhostResourcePlaceId
    to_place %SelfhostResourcePlaceId
    kind %SelfhostResourceEdgeKind

//: SelfhostDropResourceGraphInput: Drop body Resource graph input の owner table
pub struct SelfhostDropResourceGraphInput:
    bodies %Vec SelfhostDropResourceGraphBodyRecord
    places %Vec SelfhostDropResourceGraphPlaceRecord
    edges %Vec SelfhostDropResourceGraphEdgeRecord

//: SelfhostDropResourceTraversalFoldSummary: graph fold の summary
pub struct SelfhostDropResourceTraversalFoldSummary:
    status %SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus
    reason %SelfhostMemoTraitOperationDropResourceNoEscapeTraversalReason

//: SelfhostDropResourceGraphTraversalCollectorErrorKind: graph collector の構造的な拒否理由
pub enum SelfhostDropResourceGraphTraversalCollectorErrorKind:
    GraphBodyPushFailed %StdErrorKind
    GraphPlacePushFailed %StdErrorKind
    GraphEdgePushFailed %StdErrorKind
    GraphBodyReadFailed %i32
    GraphPlaceReadFailed %i32
    GraphEdgeReadFailed %i32
    GraphBodyDuplicate
    GraphBodyMissing %i32
    GraphPlaceDuplicate
    GraphEdgeDuplicate
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    PlaceIdInvalid %i32
    EdgeEndpointInvalid %i32
    EdgeEndpointMissing %i32
    EffectNotInternalAlloc %SelfhostEffectKind
    EscapeNotApplicable %SelfhostEffectEscapeState
    OutputTraversalTableAllocFailed %StdErrorKind
    OutputTraversalTableRejected %SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind

//: SelfhostDropResourceGraphDuplicateDecision: duplicate / seen 判定
pub enum SelfhostDropResourceGraphDuplicateDecision:
    UniqueSoFar
    DuplicateFound

//: SelfhostDropResourceGraphTraversalCollectorStage0Summary: collector smoke の代表結果
pub struct SelfhostDropResourceGraphTraversalCollectorStage0Summary:
    collected_len %Result i32 SelfhostDropResourceGraphTraversalCollectorErrorKind
    private_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphTraversalCollectorErrorKind
    escape_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphTraversalCollectorErrorKind
    missing_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphTraversalCollectorErrorKind
    unsupported_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphTraversalCollectorErrorKind
    duplicate_rejected %Result i32 SelfhostDropResourceGraphTraversalCollectorErrorKind
    placeholder_rejected %Result i32 SelfhostDropResourceGraphTraversalCollectorErrorKind
    endpoint_missing_rejected %Result i32 SelfhostDropResourceGraphTraversalCollectorErrorKind

