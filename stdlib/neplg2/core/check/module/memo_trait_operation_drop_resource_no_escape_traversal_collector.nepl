//: selfhost_drop_resource_graph_validate_body_result: body record の受理条件を[確認/かくにん]する
fn selfhost_drop_resource_graph_validate_body_result %fn SelfhostDropResourceGraphBodyRecord Result unit SelfhostDropResourceGraphTraversalCollectorErrorKind \body:
    if:
        eq body.body_module_fingerprint 0
        then:
            Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt body.graph_id.index 0
                then:
                    Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::GraphIdInvalid body.graph_id.index
                else:
                    if:
                        selfhost_effect_kind_eq body.effect SelfhostEffectKind::InternalAlloc
                        then:
                            match body.escape:
                                SelfhostEffectEscapeState::NotApplicable:
                                    Result::Ok unit
                                SelfhostEffectEscapeState::NoEscapeProven:
                                    Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::EscapeNotApplicable body.escape
                                SelfhostEffectEscapeState::MayEscape:
                                    Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::EscapeNotApplicable body.escape
                        else:
                            Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::EffectNotInternalAlloc body.effect

//: selfhost_drop_resource_graph_validate_place_result: place record の受理条件を[確認/かくにん]する
fn selfhost_drop_resource_graph_validate_place_result %fn SelfhostDropResourceGraphPlaceRecord Result unit SelfhostDropResourceGraphTraversalCollectorErrorKind \place:
    if:
