//: selfhost_drop_resource_graph_body_record_new: graph body record を[作/つく]る
pub fn selfhost_drop_resource_graph_body_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostDropResourceGraphId fn SelfhostDropResourceGraphCompleteness SelfhostDropResourceGraphBodyRecord \type_id\body_module_fingerprint\body_root\effect\escape\graph_id\completeness:
    SelfhostDropResourceGraphBodyRecord type_id body_module_fingerprint body_root effect escape graph_id completeness

//: selfhost_drop_resource_graph_place_record_new: graph place record を[作/つく]る
pub fn selfhost_drop_resource_graph_place_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostDropResourceGraphId fn SelfhostResourcePlaceId fn SelfhostResourcePlaceKind SelfhostDropResourceGraphPlaceRecord \type_id\body_module_fingerprint\body_root\graph_id\place_id\kind:
    SelfhostDropResourceGraphPlaceRecord type_id body_module_fingerprint body_root graph_id place_id kind

//: selfhost_drop_resource_graph_edge_record_new: graph edge record を[作/つく]る
pub fn selfhost_drop_resource_graph_edge_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostDropResourceGraphId fn SelfhostResourcePlaceId fn SelfhostResourcePlaceId fn SelfhostResourceEdgeKind SelfhostDropResourceGraphEdgeRecord \type_id\body_module_fingerprint\body_root\graph_id\from_place\to_place\kind:
    SelfhostDropResourceGraphEdgeRecord type_id body_module_fingerprint body_root graph_id from_place to_place kind

//: selfhost_drop_resource_graph_input_new: [空/から]の graph input owner を[作/つく]る
pub fn selfhost_drop_resource_graph_input_new %impure fn void Result SelfhostDropResourceGraphInput StdErrorKind \void:
    let bodies_result %Result Vec SelfhostDropResourceGraphBodyRecord StdErrorKind v::new
    match bodies_result:
        Result::Ok bodies:
            let places_result %Result Vec SelfhostDropResourceGraphPlaceRecord StdErrorKind v::new
            match places_result:
                Result::Ok places:
                    let edges_result %Result Vec SelfhostDropResourceGraphEdgeRecord StdErrorKind v::new
                    match edges_result:
                        Result::Ok edges:
                            Result::Ok SelfhostDropResourceGraphInput bodies places edges
                        Result::Err e:
                            v::free places
                            v::free bodies
                            Result::Err e
                Result::Err e:
                    v::free bodies
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_drop_resource_graph_input_free: graph input owner を[閉/と]じる
pub fn selfhost_drop_resource_graph_input_free %impure fn SelfhostDropResourceGraphInput unit \input:
    v::free field::get input "bodies"
    v::free field::get input "places"
    v::free field::get input "edges"

//: selfhost_drop_resource_graph_body_len: body record 数を[返/かえ]す
pub fn selfhost_drop_resource_graph_body_len %fn &SelfhostDropResourceGraphInput i32 \input:
    let bodies %&Vec SelfhostDropResourceGraphBodyRecord field::get_ref input "bodies"
    v::len bodies

//: selfhost_drop_resource_graph_place_len: place record 数を[返/かえ]す
pub fn selfhost_drop_resource_graph_place_len %fn &SelfhostDropResourceGraphInput i32 \input:
    let places %&Vec SelfhostDropResourceGraphPlaceRecord field::get_ref input "places"
    v::len places

//: selfhost_drop_resource_graph_edge_len: edge record 数を[返/かえ]す
pub fn selfhost_drop_resource_graph_edge_len %fn &SelfhostDropResourceGraphInput i32 \input:
    let edges %&Vec SelfhostDropResourceGraphEdgeRecord field::get_ref input "edges"
    v::len edges

//: selfhost_drop_resource_graph_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_drop_resource_graph_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_drop_resource_graph_id_eq: graph id が同じか[返/かえ]す
fn selfhost_drop_resource_graph_id_eq %fn SelfhostDropResourceGraphId fn SelfhostDropResourceGraphId bool \a\b:
    eq a.index b.index

//: selfhost_resource_place_id_eq: place id が同じか[返/かえ]す
fn selfhost_resource_place_id_eq %fn SelfhostResourcePlaceId fn SelfhostResourcePlaceId bool \a\b:
    eq a.index b.index

//: selfhost_drop_resource_graph_body_key_eq: body record と body record の key が同じか[返/かえ]す
fn selfhost_drop_resource_graph_body_key_eq %fn SelfhostDropResourceGraphBodyRecord fn SelfhostDropResourceGraphBodyRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            eq a.body_module_fingerprint b.body_module_fingerprint
            and:
                eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                and:
                    selfhost_effect_kind_eq a.effect b.effect
                    and:
                        selfhost_drop_resource_graph_escape_state_eq a.escape b.escape
                        selfhost_drop_resource_graph_id_eq a.graph_id b.graph_id

//: selfhost_drop_resource_graph_place_body_key_eq: body record と place record の key が同じか[返/かえ]す
fn selfhost_drop_resource_graph_place_body_key_eq %fn SelfhostDropResourceGraphBodyRecord fn SelfhostDropResourceGraphPlaceRecord bool \body\place:
    and:
        selfhost_type_id_eq body.type_id place.type_id
        and:
            eq body.body_module_fingerprint place.body_module_fingerprint
            and:
                eq selfhost_hir_expr_id_index body.body_root selfhost_hir_expr_id_index place.body_root
                selfhost_drop_resource_graph_id_eq body.graph_id place.graph_id

//: selfhost_drop_resource_graph_edge_body_key_eq: body record と edge record の key が同じか[返/かえ]す
fn selfhost_drop_resource_graph_edge_body_key_eq %fn SelfhostDropResourceGraphBodyRecord fn SelfhostDropResourceGraphEdgeRecord bool \body\edge:
    and:
        selfhost_type_id_eq body.type_id edge.type_id
        and:
            eq body.body_module_fingerprint edge.body_module_fingerprint
            and:
                eq selfhost_hir_expr_id_index body.body_root selfhost_hir_expr_id_index edge.body_root
                selfhost_drop_resource_graph_id_eq body.graph_id edge.graph_id

