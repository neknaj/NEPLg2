                            v::free v::vec_push_error_vec e
                            v::free places
                            v::free edges
                            Result::Err SelfhostDropResourceGraphTraversalCollectorErrorKind::GraphBodyPushFailed error
        Result::Err error:
            selfhost_drop_resource_graph_input_free input
