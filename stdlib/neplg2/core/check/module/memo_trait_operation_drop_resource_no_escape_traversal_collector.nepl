pub fn selfhost_drop_resource_graph_input_push_body %impure fn SelfhostDropResourceGraphInput impure fn SelfhostDropResourceGraphBodyRecord Result SelfhostDropResourceGraphInput SelfhostDropResourceGraphTraversalCollectorErrorKind \input\body:
    match selfhost_drop_resource_graph_validate_body_result body:
