#indent 4

//: # check/module/memo_trait_operation_drop_impl_resolver
//: `Drop` operation の impl が存在するかどうかを、complete な typed impl fact table から `SelfhostMemoTraitOperationDropCheck` へ[写/うつ]す checker-layer module です。
//:
//: [目的/もくてき]:
//: - `Drop` impl が存在しないことを `DropImplAbsent` として扱うためには、探索対象の public impl surface が complete である必要があります。
//: - この module は surface state を `Complete` / `Missing` / `Unknown` に分け、complete でない入力から `DropImplAbsent` を作る fallback を防ぎます。
//: - `Drop` impl が存在する場合は、上流の method body effect checker が作った `SelfhostEffectKind` と `SelfhostEffectEscapeState` を `DropImplPresent` check として返します。
//: - Drop impl fact は module fingerprint と `SelfhostHirExprId` を保持します。resolver は HIR arena を読まず、後続の Resource IR no-escape proof gate が「どの module arena のどの Drop body に対する証明か」を照合できる identity payload としてだけ運びます。
//:
//: [契約/けいやく]:
//: - `Complete` surface で候補が 0 件のときだけ、`DropImplAbsent` を返します。
//: - `Missing` surface は `Missing` check、`Unknown` surface は `Unknown` check に畳み、成功済みの no-drop proof にはしません。
//: - 同じ `SelfhostTypeId` の Drop impl fact が 2 件以上ある場合は `RecordDuplicate` として fail-closed に拒否します。record order による first-wins は使いません。
//: - accepted fact は session-local `SelfhostTypeId`、module-local HIR arena を識別する body module fingerprint、Drop body root id、typed effect kind、typed escape state だけから作ります。source text、span、lexeme、display name、diagnostic text、module path、Resource IR、backend artifact、proof store record を authority にしません。
//: - `body_module_fingerprint` と `SelfhostHirExprId` は body identity として保存するだけです。この module は HIR payload を走査せず、root id から effect や no-escape を推測しません。
//: - `body_module_fingerprint == 0` は placeholder origin として拒否します。placeholder を受け入れると、module-local root id が別 module に属する proof と衝突し得るためです。
//: - actual Drop body checker、Resource IR no-escape proof、generic impl binder、trait coherence、full public surface orchestration、private cache effect masking は後続 stage の責務です。
//:
//: [現状/げんじょう]:
//: - Phase 1 では complete surface であることを caller が typed state として渡します。後続の full public surface orchestration では、trait impl materializer が complete table を作った場合だけ `Complete` を渡します。
//: - facade にはまだ re-export しません。operation impl orchestration が Drop resolver と method body checker をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - table push は `Vec` push の償却 O(1) 時間です。
//: - lookup は Drop impl fact 数 n に対して O(n) 時間、O(1) 追加空間です。これは現状の実装詳細であり、typed error contract と first-wins 禁止を保ったまま sorted index や type bucket へ後から置き換えられます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_impl_resolver" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_purity_gate" as *
//:| #import "neplg2/core/ty/effect" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_drop_impl_resolver_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_drop_impl_resolver_check_kind_eq summary.complete_absent SelfhostMemoTraitOperationDropCheckKind::DropImplAbsent
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_drop_impl_resolver_check_kind_eq summary.complete_present_pure SelfhostMemoTraitOperationDropCheckKind::DropImplPresent
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_drop_impl_resolver_check_effect_eq summary.complete_present_alloc_escape SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::MayEscape
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_drop_impl_resolver_check_kind_eq summary.surface_missing SelfhostMemoTraitOperationDropCheckKind::Missing
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_drop_impl_resolver_check_kind_eq summary.surface_unknown SelfhostMemoTraitOperationDropCheckKind::Unknown
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_drop_impl_resolver_error_result_eq summary.duplicate_rejected SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordDuplicate
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "drop impl resolver stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty/id" as *
#import "./memo_trait_operation_purity_gate" as *

//: SelfhostMemoTraitOperationDropImplSurfaceState: Drop impl fact table の[完全性/かんぜんせい]
//:
//: [目的/もくてき]:
//: - complete でない table の lookup miss を Drop impl absent proof にしないため、surface 状態を typed enum として持ちます。
pub enum SelfhostMemoTraitOperationDropImplSurfaceState:
    Complete
    Missing
    Unknown

//: SelfhostMemoTraitOperationDropImplFact: 1 つの Drop impl body effect fact
//:
//: [契約/けいやく]:
//: - この fact は Drop impl が存在することを表します。impl が無い場合の fact は作りません。
//: - `body_root` は effect summary が由来する Drop body root の HIR expression id です。Resource IR no-escape proof はこの identity と一致した場合だけ `escape` を更新できます。
//: - `effect` と `escape` は actual Drop body checker / Resource proof が後続 stage で作る typed summary です。
pub struct SelfhostMemoTraitOperationDropImplFact:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState

//: SelfhostMemoTraitOperationDropImplTable: Drop impl fact の session-local owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。不要になったら `selfhost_memo_trait_operation_drop_impl_table_free` で閉じます。
//: - table 自体は永続 artifact ではありません。complete 性は `SelfhostMemoTraitOperationDropImplSurfaceState` で別に渡します。
pub struct SelfhostMemoTraitOperationDropImplTable:
    records %Vec SelfhostMemoTraitOperationDropImplFact

//: SelfhostMemoTraitOperationDropImplResolverErrorKind: Drop resolver の構造的な拒否理由
//:
//: [目的/もくてき]:
//: - table allocation / push / read / duplicate を typed enum として分けます。
pub enum SelfhostMemoTraitOperationDropImplResolverErrorKind:
    TableAllocFailed %StdErrorKind
    RecordPushFailed %StdErrorKind
    BodyModuleFingerprintPlaceholder
    RecordReadFailed %i32
    RecordDuplicate

//: SelfhostMemoTraitOperationDropImplResolverStage0Summary: Drop resolver smoke の代表結果
pub struct SelfhostMemoTraitOperationDropImplResolverStage0Summary:
    complete_absent %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind
    complete_present_pure %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind
    complete_present_alloc_escape %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind
    surface_missing %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind
    surface_unknown %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind
    duplicate_rejected %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind

impl Clone for SelfhostMemoTraitOperationDropImplSurfaceState:
    fn clone %fn &SelfhostMemoTraitOperationDropImplSurfaceState SelfhostMemoTraitOperationDropImplSurfaceState \self:
        *self

impl Copy for SelfhostMemoTraitOperationDropImplSurfaceState:
    fn copy_mark %fn SelfhostMemoTraitOperationDropImplSurfaceState SelfhostMemoTraitOperationDropImplSurfaceState \self:
        self

impl Clone for SelfhostMemoTraitOperationDropImplFact:
    fn clone %fn &SelfhostMemoTraitOperationDropImplFact SelfhostMemoTraitOperationDropImplFact \self:
        *self

impl Copy for SelfhostMemoTraitOperationDropImplFact:
    fn copy_mark %fn SelfhostMemoTraitOperationDropImplFact SelfhostMemoTraitOperationDropImplFact \self:
        self

impl Clone for SelfhostMemoTraitOperationDropImplResolverErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationDropImplResolverErrorKind SelfhostMemoTraitOperationDropImplResolverErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationDropImplResolverErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationDropImplResolverErrorKind SelfhostMemoTraitOperationDropImplResolverErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationDropImplResolverStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationDropImplResolverStage0Summary SelfhostMemoTraitOperationDropImplResolverStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationDropImplResolverStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationDropImplResolverStage0Summary SelfhostMemoTraitOperationDropImplResolverStage0Summary \self:
        self

//: selfhost_memo_trait_operation_drop_impl_fact_new: Drop impl fact を[作/つく]る
//:
//: [契約/けいやく]:
//: - `body_module_fingerprint` は caller が public impl materializer / resolver record から受け渡す HIR module arena の typed origin token です。
//: - この pure constructor は validation を行いません。fact table に入れる boundary が `0` placeholder を fail-closed に拒否します。
//: - `body_root` は `effect` / `escape` summary が由来する Drop body root です。
//: - caller は別 module や別 body の proof をこの fact に流用してはいけません。Resource IR no-escape proof gate は `type_id`、`body_module_fingerprint`、`body_root` を合わせて照合します。
pub fn selfhost_memo_trait_operation_drop_impl_fact_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState SelfhostMemoTraitOperationDropImplFact \type_id\body_module_fingerprint\body_root\effect\escape:
    SelfhostMemoTraitOperationDropImplFact type_id body_module_fingerprint body_root effect escape

//: selfhost_memo_trait_operation_drop_impl_table_new: [空/から]の Drop impl fact table を[作/つく]る
//:
//: [契約/けいやく]:
//: - 返した table は `records` buffer を[所有/しょゆう]します。caller は resolver で[使/つか]い[終/お]えたあと `selfhost_memo_trait_operation_drop_impl_table_free` で[閉/と]じます。
//: - allocation に[失敗/しっぱい]した場合は `StdErrorKind` をそのまま[返/かえ]し、resolver error への変換は caller 側の stage setup 境界に[任/まか]せます。
pub fn selfhost_memo_trait_operation_drop_impl_table_new %impure fn void Result SelfhostMemoTraitOperationDropImplTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationDropImplFact StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationDropImplTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_drop_impl_table_free: Drop impl fact table の owner buffer を[閉/と]じる
//:
//: [契約/けいやく]:
//: - この関数は table を[消費/しょうひ]し、内部 `Vec` を[解放/かいほう]します。
//: - `selfhost_memo_trait_operation_drop_impl_table_push` が `Result::Ok` で[返/かえ]した table も、resolver が[不要/ふよう]になった時点で同じように[閉/と]じます。
pub fn selfhost_memo_trait_operation_drop_impl_table_free %impure fn SelfhostMemoTraitOperationDropImplTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_drop_impl_table_len: Drop impl fact 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_drop_impl_table_len %fn &SelfhostMemoTraitOperationDropImplTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationDropImplFact field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_drop_impl_table_push: Drop impl fact を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `fact.body_module_fingerprint == 0` は placeholder origin として拒否し、消費した table owner を閉じます。
//: - push 失敗時は `Vec` が返した owner を閉じ、`RecordPushFailed(error)` として `StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_drop_impl_table_push %impure fn SelfhostMemoTraitOperationDropImplTable impure fn SelfhostMemoTraitOperationDropImplFact Result SelfhostMemoTraitOperationDropImplTable SelfhostMemoTraitOperationDropImplResolverErrorKind \table\fact:
    if:
        eq fact.body_module_fingerprint 0
        then:
            selfhost_memo_trait_operation_drop_impl_table_free table
            Result::Err SelfhostMemoTraitOperationDropImplResolverErrorKind::BodyModuleFingerprintPlaceholder
        else:
            let records %Vec SelfhostMemoTraitOperationDropImplFact field::get table "records"
            match v::push records fact:
                Result::Ok next_records:
                    Result::Ok SelfhostMemoTraitOperationDropImplTable next_records
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    Result::Err SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordPushFailed error

//: selfhost_memo_trait_operation_drop_impl_fact_matches: fact が TypeId に[一致/いっち]するか[返/かえ]す
fn selfhost_memo_trait_operation_drop_impl_fact_matches %fn SelfhostMemoTraitOperationDropImplFact fn SelfhostTypeId bool \fact\type_id:
    selfhost_type_id_eq fact.type_id type_id

//: selfhost_memo_trait_operation_drop_impl_fact_check: present fact を Drop check へ[写/うつ]す
fn selfhost_memo_trait_operation_drop_impl_fact_check %fn SelfhostMemoTraitOperationDropImplFact SelfhostMemoTraitOperationDropCheck \fact:
    selfhost_memo_trait_operation_drop_check_new SelfhostMemoTraitOperationDropCheckKind::DropImplPresent fact.effect fact.escape

//: selfhost_memo_trait_operation_drop_impl_absent_check: complete surface の no-drop check を[作/つく]る
fn selfhost_memo_trait_operation_drop_impl_absent_check %fn void SelfhostMemoTraitOperationDropCheck \void:
    selfhost_memo_trait_operation_drop_check_new SelfhostMemoTraitOperationDropCheckKind::DropImplAbsent SelfhostEffectKind::Pure SelfhostEffectEscapeState::NotApplicable

//: selfhost_memo_trait_operation_drop_impl_missing_check: incomplete surface の missing check を[作/つく]る
fn selfhost_memo_trait_operation_drop_impl_missing_check %fn void SelfhostMemoTraitOperationDropCheck \void:
    selfhost_memo_trait_operation_drop_check_new SelfhostMemoTraitOperationDropCheckKind::Missing SelfhostEffectKind::Pure SelfhostEffectEscapeState::NotApplicable

//: selfhost_memo_trait_operation_drop_impl_unknown_check: incomplete surface の unknown check を[作/つく]る
fn selfhost_memo_trait_operation_drop_impl_unknown_check %fn void SelfhostMemoTraitOperationDropCheck \void:
    selfhost_memo_trait_operation_drop_check_new SelfhostMemoTraitOperationDropCheckKind::Unknown SelfhostEffectKind::Pure SelfhostEffectEscapeState::NotApplicable

//: selfhost_memo_trait_operation_drop_impl_find_finish: complete surface lookup を typed check へ[畳/たた]む
fn selfhost_memo_trait_operation_drop_impl_find_finish %fn Option SelfhostMemoTraitOperationDropCheck Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind \found:
    match found:
        Option::Some check:
            Result::Ok check
        Option::None:
            Result::Ok selfhost_memo_trait_operation_drop_impl_absent_check

//: selfhost_memo_trait_operation_drop_impl_find_loop: complete table から Drop impl fact を[探/さが]す
//:
//: [契約/けいやく]:
//: - 同じ `SelfhostTypeId` の fact が 2 件以上ある場合は `RecordDuplicate` として拒否します。
fn selfhost_memo_trait_operation_drop_impl_find_loop %fn &SelfhostMemoTraitOperationDropImplTable fn SelfhostTypeId fn i32 fn Option SelfhostMemoTraitOperationDropCheck Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind \table\type_id\idx\found:
    if:
        ge idx selfhost_memo_trait_operation_drop_impl_table_len table
        then:
            selfhost_memo_trait_operation_drop_impl_find_finish found
        else:
            let records %&Vec SelfhostMemoTraitOperationDropImplFact field::get_ref table "records"
            match v::get records idx:
                Option::Some fact:
                    if:
                        selfhost_memo_trait_operation_drop_impl_fact_matches fact type_id
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordDuplicate
                                Option::None:
                                    let check %SelfhostMemoTraitOperationDropCheck selfhost_memo_trait_operation_drop_impl_fact_check fact
                                    selfhost_memo_trait_operation_drop_impl_find_loop table type_id add idx 1 some check
                        else:
                            selfhost_memo_trait_operation_drop_impl_find_loop table type_id add idx 1 found
                Option::None:
                    Result::Err SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordReadFailed idx

//: selfhost_memo_trait_operation_drop_impl_resolve_result: surface state と fact table から Drop check を[作/つく]る
//:
//: [契約/けいやく]:
//: - `Complete` のときだけ table を探索し、候補 0 件を `DropImplAbsent` として返します。
//: - `Missing` / `Unknown` のときは table を信用せず、それぞれの status check を返します。
//: - caller が `Complete` を渡してよいのは、public impl surface の Drop impl 探索範囲が typed stage で[完全/かんぜん]に materialize され、対象 module / dependency / re-export の impl header が欠落していない場合だけです。
//: - `Missing` / `Unknown` は構造的な resolver error ではなく、後続 solver が fail-closed に扱う status です。これらを `DropImplAbsent` に畳むことはありません。
pub fn selfhost_memo_trait_operation_drop_impl_resolve_result %fn SelfhostMemoTraitOperationDropImplSurfaceState fn &SelfhostMemoTraitOperationDropImplTable fn SelfhostTypeId Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind \surface\table\type_id:
    match surface:
        SelfhostMemoTraitOperationDropImplSurfaceState::Complete:
            selfhost_memo_trait_operation_drop_impl_find_loop table type_id 0 none
        SelfhostMemoTraitOperationDropImplSurfaceState::Missing:
            Result::Ok selfhost_memo_trait_operation_drop_impl_missing_check
        SelfhostMemoTraitOperationDropImplSurfaceState::Unknown:
            Result::Ok selfhost_memo_trait_operation_drop_impl_unknown_check

//: selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
fn selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            0
        StdErrorKind::OutOfMemory:
            1
        StdErrorKind::EmptyCollection:
            2
        StdErrorKind::IndexOutOfBounds:
            3
        StdErrorKind::KeyNotFound:
            4
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            6
        StdErrorKind::InvalidUtf8:
            7
        StdErrorKind::ParseError:
            8
        StdErrorKind::IoError:
            9
        StdErrorKind::Other:
            10

//: selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    eq selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code a selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code b

//: selfhost_memo_trait_operation_drop_impl_resolver_error_kind_code: resolver error の variant を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - この code は doctest / source policy 用の比較補助であり、diagnostic code や永続 artifact key ではありません。
//: - variant ごとに固定値を返し、payload は `selfhost_memo_trait_operation_drop_impl_resolver_error_payload_code` で別に比較します。
pub fn selfhost_memo_trait_operation_drop_impl_resolver_error_kind_code %fn SelfhostMemoTraitOperationDropImplResolverErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitOperationDropImplResolverErrorKind::TableAllocFailed _error:
            1
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordPushFailed _error:
            2
        SelfhostMemoTraitOperationDropImplResolverErrorKind::BodyModuleFingerprintPlaceholder:
            3
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordReadFailed _idx:
            4
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordDuplicate:
            5

//: selfhost_memo_trait_operation_drop_impl_resolver_error_payload_code: resolver error payload を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - payload を持つ variant は payload 由来の code を返します。
//: - payload を持たない variant は 0 を返します。
pub fn selfhost_memo_trait_operation_drop_impl_resolver_error_payload_code %fn SelfhostMemoTraitOperationDropImplResolverErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitOperationDropImplResolverErrorKind::TableAllocFailed error:
            selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code error
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordPushFailed error:
            selfhost_memo_trait_operation_drop_impl_resolver_std_error_kind_code error
        SelfhostMemoTraitOperationDropImplResolverErrorKind::BodyModuleFingerprintPlaceholder:
            0
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordReadFailed idx:
            idx
        SelfhostMemoTraitOperationDropImplResolverErrorKind::RecordDuplicate:
            0

//: selfhost_memo_trait_operation_drop_impl_resolver_error_kind_eq: resolver error が同じ分類と payload か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ error は payload code まで比較します。
//: - variant 数の二乗になる nested match を避け、selfhost compile の探索範囲を増やさないようにします。
pub fn selfhost_memo_trait_operation_drop_impl_resolver_error_kind_eq %fn SelfhostMemoTraitOperationDropImplResolverErrorKind fn SelfhostMemoTraitOperationDropImplResolverErrorKind bool \a\b:
    and:
        eq selfhost_memo_trait_operation_drop_impl_resolver_error_kind_code a selfhost_memo_trait_operation_drop_impl_resolver_error_kind_code b
        eq selfhost_memo_trait_operation_drop_impl_resolver_error_payload_code a selfhost_memo_trait_operation_drop_impl_resolver_error_payload_code b

//: selfhost_memo_trait_operation_drop_impl_resolver_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_drop_impl_resolver_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
