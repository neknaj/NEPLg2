//: selfhost_memo_trait_operation_impl_candidate_builder_drop_preflight_result: method fact scan 前に Drop input を[拒否/きょひ]する
//:
//: [目的/もくてき]:
//: - Phase 1 では Drop proof が Resource IR no-escape proof へ接続されていません。そのため Drop input は method body root の有無にかかわらず、method fact scan や purity gate へ進める前に同じ typed error で拒否します。
//:
//: [契約/けいやく]:
//: - `source` は borrow で読み、閉じません。
//: - Drop record を見つけた場合は、input table 内 index と operation kind を payload に持つ `DropOperationUnsupportedUntilResourceProof` を返します。
//: - source table read の不整合は `SourceReadFailed(index)` として返し、string diagnostic や span には依存しません。
fn selfhost_memo_trait_operation_impl_candidate_builder_drop_preflight_result %fn &SelfhostMemoTraitOperationImplCandidateBuilderInputTable fn i32 Result unit SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \source\index:
    if:
        ge index selfhost_memo_trait_operation_impl_candidate_builder_input_table_len source
        then:
            Result::Ok unit
        else:
            let records %&Vec SelfhostMemoTraitOperationImplCandidateBuilderInput field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match record.operation:
                        SelfhostMemoTraitOperationEvidenceKind::Drop:
                            let indexed %SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation index record.operation
                            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::DropOperationUnsupportedUntilResourceProof indexed
                        SelfhostMemoTraitOperationEvidenceKind::Copy:
                            selfhost_memo_trait_operation_impl_candidate_builder_drop_preflight_result source add index 1
                        SelfhostMemoTraitOperationEvidenceKind::Eq:
                            selfhost_memo_trait_operation_impl_candidate_builder_drop_preflight_result source add index 1
                        SelfhostMemoTraitOperationEvidenceKind::Hash:
                            selfhost_memo_trait_operation_impl_candidate_builder_drop_preflight_result source add index 1
                Option::None:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_impl_candidate_builder_duplicate_probe_result: output table 内の同一 key を事前に[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - `CandidateMissing` はこれから挿入できる正常状態です。
//: - 既に候補がある場合は first-wins にせず `CandidateDuplicate` を返します。
//: - lookup 自体が duplicate/read/producer/classifier error を返した場合は nested error として保持します。
fn selfhost_memo_trait_operation_impl_candidate_builder_duplicate_probe_result %fn &SelfhostMemoTraitOperationImplTable fn SelfhostMemoTraitOperationImplCandidateBuilderInput Result unit SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \output\record:
    match selfhost_memo_trait_operation_impl_candidate_for_type_operation_result output record.type_id record.operation:
        Result::Ok _existing:
            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateDuplicate
        Result::Err lookup_error:
            match lookup_error:
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
                    Result::Ok unit
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateLookupRejected lookup_error
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed _idx:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateLookupRejected lookup_error
                SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed _push:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateLookupRejected lookup_error
                SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected _classifier:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateLookupRejected lookup_error
                SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected _producer:
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateLookupRejected lookup_error

//: selfhost_memo_trait_operation_impl_candidate_builder_append_candidate_result: 1 input を output candidate table へ[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `output` はこの関数が消費します。success では更新後の owner を返します。
//: - duplicate / body check / purity gate rejection ではこの関数が output owner を閉じます。
//: - push rejection では `selfhost_memo_trait_operation_impl_table_push` が owner cleanup を担当します。
fn selfhost_memo_trait_operation_impl_candidate_builder_append_candidate_result %impure fn SelfhostMemoTraitOperationImplTable impure fn &SelfhostMemoTraitOperationMethodBodyTable impure fn &SelfhostMemoTraitOperationDropImplTable impure fn SelfhostMemoTraitOperationImplCandidateBuilderInput Result SelfhostMemoTraitOperationImplTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \output\method_table\drop_table\record:
    match selfhost_memo_trait_operation_impl_candidate_builder_duplicate_probe_result &output record:
        Result::Ok _missing:
            match selfhost_memo_trait_operation_body_check_resolve_result SelfhostMemoTraitOperationMethodBodySurfaceState::Complete method_table SelfhostMemoTraitOperationDropImplSurfaceState::Unknown drop_table record.type_id record.operation:
                Result::Ok checks:
                    match selfhost_memo_trait_operation_impl_candidate_from_checks_result record.type_id record.operation record.impl_header record.trait_application record.resolved_type_shape_hash checks.method_body checks.drop_impl:
                        Result::Ok candidate:
                            match selfhost_memo_trait_operation_impl_table_push output candidate:
                                Result::Ok next_output:
                                    Result::Ok next_output
                                Result::Err push_error:
                                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidatePushRejected push_error
                        Result::Err candidate_error:
                            selfhost_memo_trait_operation_impl_table_free output
                            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::CandidateRejected candidate_error
                Result::Err body_error:
                    selfhost_memo_trait_operation_impl_table_free output
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::BodyCheckRejected body_error
        Result::Err duplicate_error:
            selfhost_memo_trait_operation_impl_table_free output
            Result::Err duplicate_error

//: selfhost_memo_trait_operation_impl_candidate_builder_output_loop: builder input を順に output table へ[投入/とうにゅう]する
fn selfhost_memo_trait_operation_impl_candidate_builder_output_loop %impure fn SelfhostMemoTraitOperationImplTable impure fn &SelfhostMemoTraitOperationMethodBodyTable impure fn &SelfhostMemoTraitOperationDropImplTable impure fn &SelfhostMemoTraitOperationImplCandidateBuilderInputTable impure fn i32 Result SelfhostMemoTraitOperationImplTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \output\method_table\drop_table\source\index:
    if:
        ge index selfhost_memo_trait_operation_impl_candidate_builder_input_table_len source
        then:
            Result::Ok output
        else:
            let records %&Vec SelfhostMemoTraitOperationImplCandidateBuilderInput field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match record.operation:
                        SelfhostMemoTraitOperationEvidenceKind::Drop:
                            selfhost_memo_trait_operation_impl_table_free output
                            let indexed %SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation index record.operation
                            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::DropOperationUnsupportedUntilResourceProof indexed
                        SelfhostMemoTraitOperationEvidenceKind::Copy:
                            match selfhost_memo_trait_operation_impl_candidate_builder_append_candidate_result output method_table drop_table record:
                                Result::Ok next_output:
                                    selfhost_memo_trait_operation_impl_candidate_builder_output_loop next_output method_table drop_table source add index 1
                                Result::Err e:
                                    Result::Err e
                        SelfhostMemoTraitOperationEvidenceKind::Eq:
                            match selfhost_memo_trait_operation_impl_candidate_builder_append_candidate_result output method_table drop_table record:
                                Result::Ok next_output:
                                    selfhost_memo_trait_operation_impl_candidate_builder_output_loop next_output method_table drop_table source add index 1
                                Result::Err e:
                                    Result::Err e
                        SelfhostMemoTraitOperationEvidenceKind::Hash:
                            match selfhost_memo_trait_operation_impl_candidate_builder_append_candidate_result output method_table drop_table record:
                                Result::Ok next_output:
                                    selfhost_memo_trait_operation_impl_candidate_builder_output_loop next_output method_table drop_table source add index 1
                                Result::Err e:
                                    Result::Err e
                Option::None:
                    selfhost_memo_trait_operation_impl_table_free output
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::SourceReadFailed index

