//: SelfhostMemoTraitOperationImplCandidateBuilderInput: candidate builder が読む typed public impl candidate
//:
//: [目的/もくてき]:
//: - actual public impl materializer が確定した operation impl 候補を、candidate builder が source に戻らず処理できる field 群として保持します。
//:
//: [契約/けいやく]:
//: - `type_id` と `operation` は output candidate lookup key です。
//: - `impl_header` と `trait_application` は producer / classifier が再検査する typed input です。
//: - `resolved_type_shape_hash` は現在の `SelfhostTypeId` に対応する target type shape evidence です。
//: - `method_body_root` は Eq / Hash の場合だけ `some(root)` でなければなりません。Copy / Drop では `none` でなければなりません。Drop 自体は Phase 1 builder では後段 Resource proof が未接続なので、別途 typed error として拒否されます。
//: - `fuel` は HIR traversal の上限であり、builder は値を解釈せず method body fact builder へ渡します。
pub struct SelfhostMemoTraitOperationImplCandidateBuilderInput:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    impl_header %SelfhostMemoTraitPublicImplHeaderInput
    trait_application %SelfhostMemoTraitOperationTraitApplicationInput
    resolved_type_shape_hash %Option i32
    method_body_root %Option SelfhostHirExprId
    fuel %i32

//: SelfhostMemoTraitOperationImplCandidateBuilderInputTable: builder input の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。builder 本体は borrow で読み、閉じません。
//: - この table は session-local typed input であり、永続 artifact や public surface hash の authority ではありません。
pub struct SelfhostMemoTraitOperationImplCandidateBuilderInputTable:
    records %Vec SelfhostMemoTraitOperationImplCandidateBuilderInput

//: SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation: input index 付き operation payload
//:
//: [目的/もくてき]:
//: - Drop proof 未接続による拒否など、source table のどの typed input が問題だったかを bool や文字列ではなく typed payload として保持します。
//:
//: [契約/けいやく]:
//: - `index` は builder input table 内の 0-based position です。source byte offset や diagnostic span ではありません。
//: - `operation` は拒否対象の operation kind です。現在の Phase 1 では Drop unsupported rejection の payload として使います。
pub struct SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation:
    index %i32
    operation %SelfhostMemoTraitOperationEvidenceKind

//: SelfhostMemoTraitOperationImplCandidateBuilderAcceptedSummary: accepted path の代表結果
//:
//: [目的/もくてき]:
//: - stage0 doctest が output table owner を閉じた後でも、len と operation 別 candidate を確認できるように結果だけを保持します。
pub struct SelfhostMemoTraitOperationImplCandidateBuilderAcceptedSummary:
    len %i32
    copy_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind
    eq_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind
    hash_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind

//: SelfhostMemoTraitOperationImplCandidateBuilderErrorKind: candidate builder 境界の拒否理由
//:
//: [目的/もくてき]:
//: - setup、scan、method fact build、private-effect proof gate、Drop table setup、Drop unsupported、body check、purity gate、candidate duplicate、candidate push の失敗箇所を typed enum として保持します。
pub enum SelfhostMemoTraitOperationImplCandidateBuilderErrorKind:
    HirSetupFailed %StdErrorKind
    InputTableAllocFailed %StdErrorKind
    SourcePushFailed %StdErrorKind
    MethodScanTableAllocFailed %StdErrorKind
    SourceReadFailed %i32
    MethodScanRecordPushFailed %SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind
    MethodFactBuildRejected %SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind
    PrivateEffectNoEscapeGateRejected %SelfhostMemoTraitOperationPrivateEffectNoEscapeGateErrorKind
    DropTableAllocFailed %StdErrorKind
    DropOperationUnsupportedUntilResourceProof %SelfhostMemoTraitOperationImplCandidateBuilderIndexedOperation
    OutputTableAllocFailed %StdErrorKind
    BodyCheckRejected %SelfhostMemoTraitOperationBodyCheckResolverErrorKind
    CandidateRejected %SelfhostMemoTraitOperationPurityGateErrorKind
    CandidateDuplicate
    CandidateLookupRejected %SelfhostMemoTraitOperationImplTableErrorKind
    CandidatePushRejected %SelfhostMemoTraitOperationImplTableErrorKind

//: SelfhostMemoTraitOperationImplCandidateBuilderStage0Summary: impl candidate builder smoke の代表結果
pub struct SelfhostMemoTraitOperationImplCandidateBuilderStage0Summary:
    accepted %Result SelfhostMemoTraitOperationImplCandidateBuilderAcceptedSummary SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    scan_missing %Result i32 SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    duplicate_rejected %Result i32 SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    drop_unsupported %Result i32 SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    private_effect_proven %Result SelfhostMemoTraitOperationImplCandidateBuilderAcceptedSummary SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    private_effect_missing %Result SelfhostMemoTraitOperationImplCandidateBuilderAcceptedSummary SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    private_effect_duplicate_rejected %Result i32 SelfhostMemoTraitOperationImplCandidateBuilderErrorKind

