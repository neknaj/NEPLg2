            match operation:
                SelfhostMemoTraitOperationEvidenceKind::Copy:
                    selfhost_memo_trait_operation_impl_candidate_builder_candidate_result_method_evidence_eq summary.copy_candidate expected
                SelfhostMemoTraitOperationEvidenceKind::Drop:
                    false
                SelfhostMemoTraitOperationEvidenceKind::Eq:
                    selfhost_memo_trait_operation_impl_candidate_builder_candidate_result_method_evidence_eq summary.eq_candidate expected
                SelfhostMemoTraitOperationEvidenceKind::Hash:
                    selfhost_memo_trait_operation_impl_candidate_builder_candidate_result_method_evidence_eq summary.hash_candidate expected
        Result::Err _error:
            false

