//: selfhost_memo_trait_operation_impl_candidate_builder_input_new: builder input を[作/つく]る
//:
//: [契約/けいやく]:
//: - constructor は typed field を束ねるだけです。operation と method root の整合性は scan / body check / purity gate が確認し、header / classifier / producer 側の構造検査は下流の impl table / producer API が確認します。
pub fn selfhost_memo_trait_operation_impl_candidate_builder_input_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostMemoTraitPublicImplHeaderInput fn SelfhostMemoTraitOperationTraitApplicationInput fn Option i32 fn Option SelfhostHirExprId fn i32 SelfhostMemoTraitOperationImplCandidateBuilderInput \type_id\operation\impl_header\trait_application\resolved_type_shape_hash\method_body_root\fuel:
    SelfhostMemoTraitOperationImplCandidateBuilderInput type_id operation impl_header trait_application resolved_type_shape_hash method_body_root fuel

//: selfhost_memo_trait_operation_impl_candidate_builder_input_table_new: [空/から]の builder input table を[作/つく]る
pub fn selfhost_memo_trait_operation_impl_candidate_builder_input_table_new %impure fn void Result SelfhostMemoTraitOperationImplCandidateBuilderInputTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationImplCandidateBuilderInput StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationImplCandidateBuilderInputTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_impl_candidate_builder_input_table_free: builder input table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_impl_candidate_builder_input_table_free %impure fn SelfhostMemoTraitOperationImplCandidateBuilderInputTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_impl_candidate_builder_input_table_len: builder input 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_impl_candidate_builder_input_table_len %fn &SelfhostMemoTraitOperationImplCandidateBuilderInputTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationImplCandidateBuilderInput field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_impl_candidate_builder_input_table_push: builder input を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の owner を返します。
//: - push 失敗時は `Vec` が返した owner を閉じ、`SourcePushFailed(error)` として `StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_impl_candidate_builder_input_table_push %impure fn SelfhostMemoTraitOperationImplCandidateBuilderInputTable impure fn SelfhostMemoTraitOperationImplCandidateBuilderInput Result SelfhostMemoTraitOperationImplCandidateBuilderInputTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \table\record:
    let records %Vec SelfhostMemoTraitOperationImplCandidateBuilderInput field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationImplCandidateBuilderInputTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::SourcePushFailed error

//: selfhost_memo_trait_operation_impl_candidate_builder_input_to_scan_record: builder input を method fact scan record へ[写/うつ]す
fn selfhost_memo_trait_operation_impl_candidate_builder_input_to_scan_record %fn SelfhostMemoTraitOperationImplCandidateBuilderInput SelfhostMemoTraitOperationMethodBodyFactInputScanRecord \record:
    selfhost_memo_trait_operation_method_body_fact_input_scan_record_new record.type_id record.operation record.method_body_root record.fuel

//: selfhost_memo_trait_operation_impl_candidate_builder_scan_loop: builder input から method body scan table を[組/く]む
//:
//: [契約/けいやく]:
//: - `scan` はこの関数が消費します。success では更新後の owner を返します。
//: - source read の不整合ではこの関数が scan owner を閉じます。scan push failure では既存 scan table push boundary が owner cleanup を担当します。
fn selfhost_memo_trait_operation_impl_candidate_builder_scan_loop %impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable impure fn &SelfhostMemoTraitOperationImplCandidateBuilderInputTable impure fn i32 Result SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \scan\source\index:
    if:
        ge index selfhost_memo_trait_operation_impl_candidate_builder_input_table_len source
        then:
            Result::Ok scan
        else:
            let records %&Vec SelfhostMemoTraitOperationImplCandidateBuilderInput field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    let scan_record %SelfhostMemoTraitOperationMethodBodyFactInputScanRecord selfhost_memo_trait_operation_impl_candidate_builder_input_to_scan_record record
                    match selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_push scan scan_record:
                        Result::Ok next_scan:
                            selfhost_memo_trait_operation_impl_candidate_builder_scan_loop next_scan source add index 1
                        Result::Err push_error:
                            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::MethodScanRecordPushFailed push_error
                Option::None:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free scan
                    Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_impl_candidate_builder_method_facts_from_scan: scan table owner から method fact table を[作/つく]る
//:
//: [契約/けいやく]:
//: - `scan` はこの関数が消費します。success / failure のどちらでも scan owner を閉じます。
fn selfhost_memo_trait_operation_impl_candidate_builder_method_facts_from_scan %impure fn &SelfhostHirModule impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \module\scan:
    match selfhost_memo_trait_operation_method_body_fact_table_from_scan_records_result module &scan:
        Result::Ok method_table:
            selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free scan
            Result::Ok method_table
        Result::Err build_error:
            selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free scan
            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::MethodFactBuildRejected build_error

//: selfhost_memo_trait_operation_impl_candidate_builder_method_facts_from_scan_with_private_effect_proofs: scan table owner から private-effect proof gate 済み method fact table を[作/つく]る
//:
//: [契約/けいやく]:
//: - `scan` はこの関数が消費します。success / failure のどちらでも scan owner を閉じます。
//: - `proofs` は borrow です。この関数は閉じません。
//: - `body_module_fingerprint` は `module` と `scan` 内の method body root が同じ module origin から来ていることを表します。複数 module の root を混ぜる caller は、この関数へ来る前に module ごとに分割します。
fn selfhost_memo_trait_operation_impl_candidate_builder_method_facts_from_scan_with_private_effect_proofs %impure fn &SelfhostHirModule impure fn i32 impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable impure fn &SelfhostMemoTraitOperationPrivateEffectNoEscapeProofTable Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationImplCandidateBuilderErrorKind \module\body_module_fingerprint\scan\proofs:
    match selfhost_memo_trait_operation_private_effect_no_escape_table_from_scan_records_result module body_module_fingerprint &scan proofs:
        Result::Ok method_table:
            selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free scan
            Result::Ok method_table
        Result::Err build_error:
            selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free scan
            Result::Err SelfhostMemoTraitOperationImplCandidateBuilderErrorKind::PrivateEffectNoEscapeGateRejected build_error

