#indent 4

//: # check/module/memo_trait_operation_classifier
//: Copy / Drop / Eq / Hash の trait application shape から、operation evidence producer が読む shape-bound classifier evidence を[作/つく]る checker-layer module です。
//:
//: [目的/もくてき]:
//: - public impl header が持つ `trait_application_shape_hash` を、caller supplied の operation kind だけで信用しないための境界です。
//: - trait application の stable trait source identity と type argument count から operation trait application shape hash を再導出し、入力の shape hash と一致した場合だけ `SelfhostMemoTraitOperationClassifierEvidence` を返します。
//: - Copy / Drop / Eq / Hash の trusted source identity は `MemoKey` / `MemoValue` の source identity とは別の型で表し、memoization trait source と operation trait source を混同しないようにします。
//:
//: [契約/けいやく]:
//: - accepted classifier evidence は、trusted operation source registry、operation trait source identity、type argument count、trait application shape hash だけから作ります。
//: - `trait_application_shape_hash` は `some nonzero` でなければなりません。さらに operation trait source identity から再導出した shape hash と一致しなければなりません。
//: - `trait_source` は current trusted registry に含まれる Copy / Drop / Eq / Hash source identity のどれかと完全一致する必要があります。operation kind だけ、trait name string だけ、method name string だけでは accepted classifier evidence を作りません。
//: - Phase 1 の operation trait application は type argument count 0 だけを受理します。generic operation trait application は binder / argument identity の詳細 evidence が入るまで fail-closed にします。
//: - source text、span、lexeme、display name、diagnostic text、module path、HIR、Resource IR、backend artifact、proof store record は accepted classifier authority に入りません。
//:
//: [現状/げんじょう]:
//: - current trusted registry は compiler-known prepared fingerprint を返す Phase 1 境界です。actual public surface materializer から Copy / Drop / Eq / Hash trait source identity を作る実装は後続 stage で接続します。
//: - trait impl table の探索、method body purity checker、Drop なし proof generator、generic impl binder / bound 詳細 evidence はこの module の外側で実装します。
//: - facade にはまだ re-export しません。operation evidence orchestration が public impl header producer と method / drop evidence producer をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - current registry は固定 4 operation source identity だけを持つため O(1) 時間・O(1) 追加空間です。
//: - classifier evidence 生成は 1 source identity と 1 shape hash の検査だけなので O(1) 時間・O(1) 追加空間です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_classifier" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_classifier_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_classifier_result_eq summary.copy_classifier SelfhostMemoTraitOperationEvidenceKind::Copy summary.copy_shape_hash
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_classifier_result_eq summary.hash_classifier SelfhostMemoTraitOperationEvidenceKind::Hash summary.hash_shape_hash
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_classifier_error_kind_eq (unwrap_err summary.shape_mismatch_rejected) SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_classifier_error_kind_eq (unwrap_err summary.untrusted_source_rejected) SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted SelfhostMemoTraitOperationEvidenceKind::Copy
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_classifier_error_kind_eq (unwrap_err summary.missing_shape_rejected) SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_classifier_error_kind_eq (unwrap_err summary.type_argument_rejected) SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "operation classifier stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *

//: SelfhostMemoTraitOperationSourceIdentity: Copy / Drop / Eq / Hash trait source の stable identity
//:
//: [目的/もくてき]:
//: - operation trait source を、表示名や source path string ではなく、operation kind と stable fingerprint payload の組として保持します。
//:
//: [契約/けいやく]:
//: - `operation` は Copy / Drop / Eq / Hash のどの trusted trait source かを表します。
//: - `module_hash`、`symbol_hash`、`signature_hash` はそれぞれ module identity、stable trait symbol identity、public trait signature identity の fingerprint です。
//: - fingerprint `0` は placeholder として扱い、accepted classifier evidence へ進めません。
pub struct SelfhostMemoTraitOperationSourceIdentity:
    operation %SelfhostMemoTraitOperationEvidenceKind
    module_hash %i32
    symbol_hash %i32
    signature_hash %i32

//: SelfhostMemoTraitOperationClassifierEvidence: trait application shape に[結/むす]び[付/つ]いた operation classifier evidence
//:
//: [目的/もくてき]:
//: - stable trait identity classifier が、どの trait application shape を Copy / Drop / Eq / Hash と判定したのかを typed evidence として保持します。
//:
//: [契約/けいやく]:
//: - `classified_trait_application_shape_hash` は classifier が実際に読んだ trait application shape です。
//: - operation evidence producer はこの shape と public impl header の `trait_application_shape_hash` を照合します。caller supplied operation kind だけで trait identity を認可してはいけません。
pub struct SelfhostMemoTraitOperationClassifierEvidence:
    operation %SelfhostMemoTraitOperationEvidenceKind
    classified_trait_application_shape_hash %Option i32

//: SelfhostMemoTraitOperationTrustedSourceRegistry: current compiler が信頼する operation trait source set
//:
//: [目的/もくてき]:
//: - Copy / Drop / Eq / Hash の trusted source identity を 1 つの typed registry にまとめ、classifier が個別の raw fingerprint を直接信用しないようにします。
//:
//: [契約/けいやく]:
//: - registry constructor は module private helper に留めます。外部 caller は current registry を `Result` API から取得します。
pub struct SelfhostMemoTraitOperationTrustedSourceRegistry:
    copy_source %SelfhostMemoTraitOperationSourceIdentity
    drop_source %SelfhostMemoTraitOperationSourceIdentity
    eq_source %SelfhostMemoTraitOperationSourceIdentity
    hash_source %SelfhostMemoTraitOperationSourceIdentity

//: SelfhostMemoTraitOperationTraitApplicationInput: classifier が読む trait application shape evidence
//:
//: [目的/もくてき]:
//: - trait application term の stable trait source、type argument count、normalized shape hash を 1 record にまとめます。
//:
//: [契約/けいやく]:
//: - `trait_source` は trait application の head trait identity です。
//: - `type_argument_count` は Phase 1 では 0 だけが accepted path です。
//: - `trait_application_shape_hash` は別 stage が作った trait application shape hash であり、この module は同じ rule で再導出した hash と照合します。
pub struct SelfhostMemoTraitOperationTraitApplicationInput:
    trait_source %SelfhostMemoTraitOperationSourceIdentity
    type_argument_count %i32
    trait_application_shape_hash %Option i32

//: SelfhostMemoTraitOperationClassifierErrorKind: operation classifier の拒否理由
//:
//: [目的/もくてき]:
//: - source fingerprint、registry membership、type argument、shape hash のどこで拒否したかを typed enum として保持します。
pub enum SelfhostMemoTraitOperationClassifierErrorKind:
    SourceModuleFingerprintPlaceholder %SelfhostMemoTraitOperationEvidenceKind
    SourceSymbolFingerprintPlaceholder %SelfhostMemoTraitOperationEvidenceKind
    SourceSignatureFingerprintPlaceholder %SelfhostMemoTraitOperationEvidenceKind
    TraitSourceNotTrusted %SelfhostMemoTraitOperationEvidenceKind
    TraitTypeArgumentCountNegative
    TraitTypeArgumentUnsupported
    TraitApplicationShapeHashMissing
    TraitApplicationShapeHashPlaceholder
    TraitApplicationShapeHashMismatch
    DerivedTraitApplicationShapeHashPlaceholder

//: SelfhostMemoTraitOperationClassifierStage0Summary: operation classifier smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted Copy / Hash classifier と、shape mismatch、untrusted source、missing shape、unsupported type argument の fail-closed path をまとめます。
pub struct SelfhostMemoTraitOperationClassifierStage0Summary:
    copy_classifier %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    hash_classifier %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    shape_mismatch_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    untrusted_source_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    missing_shape_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    type_argument_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind
    copy_shape_hash %i32
    hash_shape_hash %i32

