        SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
            9
        SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
            10

//: selfhost_memo_trait_operation_classifier_payload_error_eq: operation payload 付き error を[比/くら]べる
fn selfhost_memo_trait_operation_classifier_payload_error_eq %fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostMemoTraitOperationEvidenceKind bool \a\b:
