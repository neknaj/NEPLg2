//: - 固定個数の input だけを作るため O(1) です。
pub fn selfhost_memo_trait_operation_classifier_stage0 %impure fn void Result SelfhostMemoTraitOperationClassifierStage0Summary StdErrorKind \void:
    match selfhost_memo_trait_operation_trusted_source_registry_current_result:
        Result::Ok registry:
            let copy_source %SelfhostMemoTraitOperationSourceIdentity registry.copy_source
            let hash_source %SelfhostMemoTraitOperationSourceIdentity registry.hash_source
            let untrusted_source %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_source_identity_new SelfhostMemoTraitOperationEvidenceKind::Copy 620101 620102 620103
            match selfhost_memo_trait_operation_trait_application_shape_hash_result copy_source 0:
                Result::Ok copy_shape_hash:
                    match selfhost_memo_trait_operation_trait_application_shape_hash_result hash_source 0:
                        Result::Ok hash_shape_hash:
                            let copy_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new copy_source 0 some copy_shape_hash
                            let hash_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new hash_source 0 some hash_shape_hash
                            let shape_mismatch_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new copy_source 0 some hash_shape_hash
                            let untrusted_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new untrusted_source 0 some copy_shape_hash
                            let missing_shape_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new copy_source 0 none
                            let type_argument_input %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_trait_application_input_new copy_source 1 some copy_shape_hash
                            let copy_classifier %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry copy_input
                            let hash_classifier %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry hash_input
                            let shape_mismatch_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry shape_mismatch_input
                            let untrusted_source_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry untrusted_input
                            let missing_shape_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry missing_shape_input
                            let type_argument_rejected %Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry type_argument_input
                            Result::Ok selfhost_memo_trait_operation_classifier_stage0_summary_new copy_classifier hash_classifier shape_mismatch_rejected untrusted_source_rejected missing_shape_rejected type_argument_rejected copy_shape_hash hash_shape_hash
                        Result::Err _hash_shape_error:
                            Result::Err StdErrorKind::InvalidOperation
                Result::Err _copy_shape_error:
                    Result::Err StdErrorKind::InvalidOperation
        Result::Err _registry_error:
            Result::Err StdErrorKind::InvalidOperation
