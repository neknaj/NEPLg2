//: selfhost_memo_trait_operation_classifier_error_kind_eq: classifier error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - source fingerprint error と untrusted source error は operation payload まで比較します。
pub fn selfhost_memo_trait_operation_classifier_error_kind_eq %fn SelfhostMemoTraitOperationClassifierErrorKind fn SelfhostMemoTraitOperationClassifierErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder operation:
            match b:
                SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder other_operation:
                    selfhost_memo_trait_operation_classifier_payload_error_eq operation other_operation
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
                    false
        SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder operation:
            match b:
                SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder other_operation:
                    selfhost_memo_trait_operation_classifier_payload_error_eq operation other_operation
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
                    false
        SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder operation:
            match b:
                SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder other_operation:
                    selfhost_memo_trait_operation_classifier_payload_error_eq operation other_operation
                SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
                    false
        SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted operation:
            match b:
                SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder _other_operation:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted other_operation:
                    selfhost_memo_trait_operation_classifier_payload_error_eq operation other_operation
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
                    false
                SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
                    false
        SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b
        SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b
        SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b
        SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b
        SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMismatch:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b
        SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder:
            eq selfhost_memo_trait_operation_classifier_error_kind_code a selfhost_memo_trait_operation_classifier_error_kind_code b

//: selfhost_memo_trait_operation_classifier_result_eq: classifier result の operation と shape hash を[確認/かくにん]する
pub fn selfhost_memo_trait_operation_classifier_result_eq %fn Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind fn SelfhostMemoTraitOperationEvidenceKind fn i32 bool \result\operation\shape_hash:
    match result:
        Result::Ok evidence:
            and:
                selfhost_memo_trait_operation_evidence_kind_eq evidence.operation operation
                match evidence.classified_trait_application_shape_hash:
                    Option::Some actual_shape_hash:
                        eq actual_shape_hash shape_hash
                    Option::None:
                        false
        Result::Err _e:
            false

