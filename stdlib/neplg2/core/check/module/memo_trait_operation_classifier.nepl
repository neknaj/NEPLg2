                        Result::Err input_error:
                            Result::Err input_error
                Result::Err shape_error:
                    Result::Err shape_error
        Result::Err trusted_error:
            Result::Err trusted_error

//: selfhost_memo_trait_operation_classifier_evidence_result: trait application shape を operation classifier evidence に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - trusted operation trait source と normalized shape hash が一致する場合だけ、operation evidence producer が読む shape-bound classifier evidence を作ります。
//:
//: [契約/けいやく]:
//: - public API は current trusted registry を内部で取得します。caller supplied registry を受け取らないため、任意 registry による trust bypass を作りません。
//: - input shape hash は source identity から再導出した shape hash と一致する必要があります。
//: - 成功時の evidence は `SelfhostMemoTraitOperationClassifierEvidence` であり、operation evidence producer が impl header の trait application shape と再照合します。
pub fn selfhost_memo_trait_operation_classifier_evidence_result %fn SelfhostMemoTraitOperationTraitApplicationInput Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind \input:
    match selfhost_memo_trait_operation_trusted_source_registry_current_result:
        Result::Ok registry:
            selfhost_memo_trait_operation_classifier_evidence_with_registry_result registry input
        Result::Err registry_error:
            Result::Err registry_error

