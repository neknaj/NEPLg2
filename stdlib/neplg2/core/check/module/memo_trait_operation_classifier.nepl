//: selfhost_memo_trait_operation_source_identity_new: operation source identity を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は field を束ねるだけです。trusted registry membership と fingerprint placeholder は classifier が検査します。
pub fn selfhost_memo_trait_operation_source_identity_new %fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn i32 fn i32 SelfhostMemoTraitOperationSourceIdentity \operation\module_hash\symbol_hash\signature_hash:
    SelfhostMemoTraitOperationSourceIdentity operation module_hash symbol_hash signature_hash

//: selfhost_memo_trait_operation_classifier_evidence_new: shape-bound classifier evidence を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は typed field をまとめるだけです。shape missing / placeholder / derived shape との一致は classifier result API が検査します。
fn selfhost_memo_trait_operation_classifier_evidence_new %fn SelfhostMemoTraitOperationEvidenceKind fn Option i32 SelfhostMemoTraitOperationClassifierEvidence \operation\classified_trait_application_shape_hash:
    SelfhostMemoTraitOperationClassifierEvidence operation classified_trait_application_shape_hash

//: selfhost_memo_trait_operation_trait_application_input_new: classifier input を[作/つく]る
//:
//: [契約/けいやく]:
//: - `trait_application_shape_hash` の missing / placeholder / mismatch は classifier result API が `Result` で返します。
pub fn selfhost_memo_trait_operation_trait_application_input_new %fn SelfhostMemoTraitOperationSourceIdentity fn i32 fn Option i32 SelfhostMemoTraitOperationTraitApplicationInput \trait_source\type_argument_count\trait_application_shape_hash:
    SelfhostMemoTraitOperationTraitApplicationInput trait_source type_argument_count trait_application_shape_hash

//: selfhost_memo_trait_operation_trusted_source_registry_new: trusted registry を[作/つく]る
fn selfhost_memo_trait_operation_trusted_source_registry_new %fn SelfhostMemoTraitOperationSourceIdentity fn SelfhostMemoTraitOperationSourceIdentity fn SelfhostMemoTraitOperationSourceIdentity fn SelfhostMemoTraitOperationSourceIdentity SelfhostMemoTraitOperationTrustedSourceRegistry \copy_source\drop_source\eq_source\hash_source:
    SelfhostMemoTraitOperationTrustedSourceRegistry copy_source drop_source eq_source hash_source

//: selfhost_memo_trait_operation_current_copy_source: Phase 1 current Copy trait source
fn selfhost_memo_trait_operation_current_copy_source %fn void SelfhostMemoTraitOperationSourceIdentity \void:
    selfhost_memo_trait_operation_source_identity_new SelfhostMemoTraitOperationEvidenceKind::Copy 520101 520102 520103

//: selfhost_memo_trait_operation_current_drop_source: Phase 1 current Drop trait source
fn selfhost_memo_trait_operation_current_drop_source %fn void SelfhostMemoTraitOperationSourceIdentity \void:
    selfhost_memo_trait_operation_source_identity_new SelfhostMemoTraitOperationEvidenceKind::Drop 520201 520202 520203

//: selfhost_memo_trait_operation_current_eq_source: Phase 1 current Eq trait source
fn selfhost_memo_trait_operation_current_eq_source %fn void SelfhostMemoTraitOperationSourceIdentity \void:
    selfhost_memo_trait_operation_source_identity_new SelfhostMemoTraitOperationEvidenceKind::Eq 520301 520302 520303

//: selfhost_memo_trait_operation_current_hash_source: Phase 1 current Hash trait source
fn selfhost_memo_trait_operation_current_hash_source %fn void SelfhostMemoTraitOperationSourceIdentity \void:
    selfhost_memo_trait_operation_source_identity_new SelfhostMemoTraitOperationEvidenceKind::Hash 520401 520402 520403

//: selfhost_memo_trait_operation_source_fingerprint_result: source identity の placeholder を[検査/けんさ]する
fn selfhost_memo_trait_operation_source_fingerprint_result %fn SelfhostMemoTraitOperationSourceIdentity Result unit SelfhostMemoTraitOperationClassifierErrorKind \source:
    if:
        eq source.module_hash 0
        then:
            Result::Err SelfhostMemoTraitOperationClassifierErrorKind::SourceModuleFingerprintPlaceholder source.operation
        else:
            if:
                eq source.symbol_hash 0
                then:
                    Result::Err SelfhostMemoTraitOperationClassifierErrorKind::SourceSymbolFingerprintPlaceholder source.operation
                else:
                    if:
                        eq source.signature_hash 0
                        then:
                            Result::Err SelfhostMemoTraitOperationClassifierErrorKind::SourceSignatureFingerprintPlaceholder source.operation
                        else:
                            Result::Ok unit

//: selfhost_memo_trait_operation_trusted_source_registry_current_result: current compiler の trusted operation source registry を[返/かえ]す
//:
//: [目的/もくてき]:
//: - Phase 1 の prepared fingerprint を typed registry に閉じ込め、classifier が operation kind だけを信用しないようにします。
//:
//: [現状/げんじょう]:
//: - prepared fingerprint は後続の public surface materializer で actual trait definition source identity に置き換えます。
pub fn selfhost_memo_trait_operation_trusted_source_registry_current_result %fn void Result SelfhostMemoTraitOperationTrustedSourceRegistry SelfhostMemoTraitOperationClassifierErrorKind \void:
    let copy_source %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_current_copy_source
    match selfhost_memo_trait_operation_source_fingerprint_result copy_source:
        Result::Ok _copy_ok:
            let drop_source %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_current_drop_source
            match selfhost_memo_trait_operation_source_fingerprint_result drop_source:
                Result::Ok _drop_ok:
                    let eq_source %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_current_eq_source
                    match selfhost_memo_trait_operation_source_fingerprint_result eq_source:
                        Result::Ok _eq_ok:
                            let hash_source %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_current_hash_source
                            match selfhost_memo_trait_operation_source_fingerprint_result hash_source:
                                Result::Ok _hash_ok:
                                    Result::Ok selfhost_memo_trait_operation_trusted_source_registry_new copy_source drop_source eq_source hash_source
                                Result::Err hash_error:
                                    Result::Err hash_error
                        Result::Err eq_error:
                            Result::Err eq_error
                Result::Err drop_error:
                    Result::Err drop_error
        Result::Err copy_error:
            Result::Err copy_error

//: selfhost_memo_trait_operation_source_identity_eq: operation source identity が同じか[返/かえ]す
pub fn selfhost_memo_trait_operation_source_identity_eq %fn SelfhostMemoTraitOperationSourceIdentity fn SelfhostMemoTraitOperationSourceIdentity bool \a\b:
    and:
        selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation
        and:
            eq a.module_hash b.module_hash
            and:
                eq a.symbol_hash b.symbol_hash
                eq a.signature_hash b.signature_hash

//: selfhost_memo_trait_operation_trusted_source_for_operation: registry から operation kind に対応する trusted source を[取/と]る
fn selfhost_memo_trait_operation_trusted_source_for_operation %fn SelfhostMemoTraitOperationTrustedSourceRegistry fn SelfhostMemoTraitOperationEvidenceKind SelfhostMemoTraitOperationSourceIdentity \registry\operation:
    match operation:
        SelfhostMemoTraitOperationEvidenceKind::Copy:
            registry.copy_source
        SelfhostMemoTraitOperationEvidenceKind::Drop:
            registry.drop_source
        SelfhostMemoTraitOperationEvidenceKind::Eq:
            registry.eq_source
        SelfhostMemoTraitOperationEvidenceKind::Hash:
            registry.hash_source

//: selfhost_memo_trait_operation_source_trusted_result: source identity が registry にあるか[検査/けんさ]する
fn selfhost_memo_trait_operation_source_trusted_result %fn SelfhostMemoTraitOperationTrustedSourceRegistry fn SelfhostMemoTraitOperationSourceIdentity Result unit SelfhostMemoTraitOperationClassifierErrorKind \registry\source:
    match selfhost_memo_trait_operation_source_fingerprint_result source:
        Result::Ok _fingerprint_ok:
            let expected %SelfhostMemoTraitOperationSourceIdentity selfhost_memo_trait_operation_trusted_source_for_operation registry source.operation
            if:
                selfhost_memo_trait_operation_source_identity_eq source expected
                then:
                    Result::Ok unit
                else:
                    Result::Err SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted source.operation
        Result::Err fingerprint_error:
            Result::Err fingerprint_error

//: selfhost_memo_trait_operation_trait_application_shape_schema_version: operation trait application shape schema
fn selfhost_memo_trait_operation_trait_application_shape_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_operation_kind_shape_code: operation kind を shape fold 用 code へ[写/うつ]す
fn selfhost_memo_trait_operation_kind_shape_code %fn SelfhostMemoTraitOperationEvidenceKind i32 \operation:
    match operation:
        SelfhostMemoTraitOperationEvidenceKind::Copy:
            93011
        SelfhostMemoTraitOperationEvidenceKind::Drop:
            93012
        SelfhostMemoTraitOperationEvidenceKind::Eq:
            93013
        SelfhostMemoTraitOperationEvidenceKind::Hash:
            93014

//: selfhost_memo_trait_operation_classifier_mix2: classifier hash 用 2 field [混合/こんごう]
fn selfhost_memo_trait_operation_classifier_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_operation_classifier_mix3: classifier hash 用 3 field [混合/こんごう]
fn selfhost_memo_trait_operation_classifier_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_operation_classifier_mix2 a b c

//: selfhost_memo_trait_operation_trait_application_shape_hash_result: operation trait source から shape hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - type argument count 0 だけを accepted path とします。
//: - fingerprint が placeholder の source identity は shape hash 生成へ進めません。
//: - derived hash が 0 の場合は accepted evidence にせず typed error へ戻します。
pub fn selfhost_memo_trait_operation_trait_application_shape_hash_result %fn SelfhostMemoTraitOperationSourceIdentity fn i32 Result i32 SelfhostMemoTraitOperationClassifierErrorKind \source\type_argument_count:
    if:
        lt type_argument_count 0
        then:
            Result::Err SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentCountNegative
        else:
            if:
                gt type_argument_count 0
                then:
                    Result::Err SelfhostMemoTraitOperationClassifierErrorKind::TraitTypeArgumentUnsupported
                else:
                    match selfhost_memo_trait_operation_source_fingerprint_result source:
                        Result::Ok _source_ok:
                            let schema_version %i32 selfhost_memo_trait_operation_trait_application_shape_schema_version
                            let operation_code %i32 selfhost_memo_trait_operation_kind_shape_code source.operation
                            let source_hash %i32 selfhost_memo_trait_operation_classifier_mix3 source.module_hash source.symbol_hash source.signature_hash
                            let header_hash %i32 selfhost_memo_trait_operation_classifier_mix3 schema_version operation_code type_argument_count
                            let shape_hash %i32 selfhost_memo_trait_operation_classifier_mix2 header_hash source_hash
                            if:
                                eq shape_hash 0
                                then:
                                    Result::Err SelfhostMemoTraitOperationClassifierErrorKind::DerivedTraitApplicationShapeHashPlaceholder
                                else:
                                    Result::Ok shape_hash
                        Result::Err source_error:
                            Result::Err source_error

//: selfhost_memo_trait_operation_classifier_input_shape_result: input shape hash を[取/と]り[出/だ]す
fn selfhost_memo_trait_operation_classifier_input_shape_result %fn SelfhostMemoTraitOperationTraitApplicationInput Result i32 SelfhostMemoTraitOperationClassifierErrorKind \input:
    match input.trait_application_shape_hash:
        Option::Some shape_hash:
            if:
                eq shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashPlaceholder
                else:
                    Result::Ok shape_hash
        Option::None:
            Result::Err SelfhostMemoTraitOperationClassifierErrorKind::TraitApplicationShapeHashMissing

//: selfhost_memo_trait_operation_classifier_evidence_with_registry_result: 検査済み registry で classifier evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - current registry または将来の validated public-surface registry を使い、trait source と shape hash の一致を検査します。
//:
//: [契約/けいやく]:
//: - この helper は module private です。public caller が任意 registry を trusted registry として注入する経路を作りません。
fn selfhost_memo_trait_operation_classifier_evidence_with_registry_result %fn SelfhostMemoTraitOperationTrustedSourceRegistry fn SelfhostMemoTraitOperationTraitApplicationInput Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationClassifierErrorKind \registry\input:
    match selfhost_memo_trait_operation_source_trusted_result registry input.trait_source:
        Result::Ok _trusted_ok:
            match selfhost_memo_trait_operation_trait_application_shape_hash_result input.trait_source input.type_argument_count:
                Result::Ok expected_shape_hash:
                    match selfhost_memo_trait_operation_classifier_input_shape_result input:
                        Result::Ok input_shape_hash:
                            if:
                                eq expected_shape_hash input_shape_hash
                                then:
