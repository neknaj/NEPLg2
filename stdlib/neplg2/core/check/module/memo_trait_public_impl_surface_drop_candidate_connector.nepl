//: SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary: state owner を閉じた後に[保持/ほじ]する代表結果
//:
//: [目的/もくてき]:
//: - public surface state owner を保持せず、hash、candidate 数、Eq lookup、Drop lookup 結果だけで accepted path を確認します。
pub struct SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary:
    public_surface_hash %i32
    operation_impl_len %i32
    eq_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind
    drop_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind

//: SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind: scanner-bound surface Drop 増補境界の拒否理由
//:
//: [目的/もくてき]:
//: - scanner、public surface normalizer、public surface hash、operation record filter、base operation materializer、Drop candidate connector のどこが拒否したかを typed enum として保持します。
pub enum SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind:
    ScannerRejected %SelfhostMemoTraitPublicImplScannerErrorKind
    PublicSurfaceNormalizerRejected %SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    PublicSurfaceHashRejected %SelfhostMemoTraitPublicSurfaceHashErrorKind
    PublicSurfaceHashMissing
    OperationRecordFilterAllocFailed %StdErrorKind
    OperationRecordFilterPushRejected %SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    OperationRecordFilterSourceReadFailed %i32
    OperationRecordClassifierRejected %SelfhostMemoTraitOperationClassifierErrorKind
    BaseOperationMaterializerRejected %SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    DropCandidateConnectorRejected %SelfhostMemoTraitOperationDropCandidateConnectorErrorKind

//: SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary: scanner-bound state 増補 smoke の代表結果
pub struct SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary:
    proven %Result SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind
    missing %Result SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind

//: Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary: owner を含まない代表結果を[複製/ふくせい]する
impl Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary: summary payload をそのまま[返/かえ]す
impl Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary \self:
        self

//: Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind: typed error payload を[複製/ふくせい]する
impl Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind: owner を含まない error payload をそのまま[返/かえ]す
impl Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \self:
        self

//: Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary: stage0 summary を[複製/ふくせい]する
impl Clone for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary: stage0 summary payload をそのまま[返/かえ]す
impl Copy for SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorStage0Summary \self:
        self

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_record_operation_result: materializer record の operation kind を trusted classifier から[得/え]る
//:
//: [契約/けいやく]:
//: - record の `trait_source` と shape hash だけを classifier input に写し、method name string や source text へ戻りません。
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_record_operation_result %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result SelfhostMemoTraitOperationEvidenceKind SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \record:
    let trait_application %SelfhostMemoTraitOperationTraitApplicationInput:
        selfhost_memo_trait_operation_trait_application_input_new record.trait_source record.trait_type_argument_count record.trait_application_shape_hash
    match selfhost_memo_trait_operation_classifier_evidence_result trait_application:
        Result::Ok classifier:
            Result::Ok classifier.operation
        Result::Err classifier_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::OperationRecordClassifierRejected classifier_error

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_operation_is_drop: operation kind が Drop か[返/かえ]す
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_operation_is_drop %fn SelfhostMemoTraitOperationEvidenceKind bool \operation:
    match operation:
        SelfhostMemoTraitOperationEvidenceKind::Copy:
            false
        SelfhostMemoTraitOperationEvidenceKind::Drop:
            true
        SelfhostMemoTraitOperationEvidenceKind::Eq:
            false
        SelfhostMemoTraitOperationEvidenceKind::Hash:
            false

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_filter_loop: non-Drop record だけを一時 table へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `output` はこの関数が消費します。classifier failure / source read failure ではこの関数が閉じます。
//: - push failure では lower record table push boundary が owner cleanup を担当するため、この関数は二重解放しません。
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_filter_loop %impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn i32 Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \output\source\index:
    if:
        ge index selfhost_memo_trait_operation_public_impl_materializer_record_table_len source
        then:
            Result::Ok output
        else:
            let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match selfhost_memo_trait_public_impl_surface_drop_candidate_connector_record_operation_result record:
                        Result::Ok operation:
                            if:
                                selfhost_memo_trait_public_impl_surface_drop_candidate_connector_operation_is_drop operation
                                then:
                                    selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_filter_loop output source add index 1
                                else:
                                    match selfhost_memo_trait_operation_public_impl_materializer_record_table_push output record:
                                        Result::Ok next_output:
                                            selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_filter_loop next_output source add index 1
                                        Result::Err push_error:
                                            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::OperationRecordFilterPushRejected push_error
                        Result::Err e:
                            selfhost_memo_trait_operation_public_impl_materializer_record_table_free output
                            Result::Err e
                Option::None:
                    selfhost_memo_trait_operation_public_impl_materializer_record_table_free output
                    Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::OperationRecordFilterSourceReadFailed index

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_records_result: non-Drop base materializer 用 table owner を[作/つく]る
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_records_result %impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \source:
    match selfhost_memo_trait_operation_public_impl_materializer_record_table_new:
        Result::Ok output0:
            selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_filter_loop output0 source 0
        Result::Err alloc_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::OperationRecordFilterAllocFailed alloc_error

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_hash_from_scanner_output_result: scanner output の declaration stream から public surface hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - scanner output の `public_declarations` borrow だけを読み、operation records や Drop proof は hash material に混ぜません。
//: - partial input item owner は hash success / failure の両方でこの関数が閉じます。
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_hash_from_scanner_output_result %impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostMemoTraitPublicImplScannerOutput Result i32 SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \graph\dependencies\reexports\seed_table\scanner_output:
    let public_declarations %&Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get_ref scanner_output "public_declarations"
    match selfhost_memo_trait_public_surface_normalizer_partial_input_items_result graph dependencies reexports public_declarations:
        Result::Ok partial_items:
            let hash_result %Result i32 SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind:
                match selfhost_memo_trait_public_surface_hash_from_seed_table_and_partial_items_result seed_table &partial_items:
                    Result::Ok public_surface_hash:
                        if:
                            eq public_surface_hash 0
                            then:
                                Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::PublicSurfaceHashMissing
                            else:
                                Result::Ok public_surface_hash
                    Result::Err hash_error:
                        Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::PublicSurfaceHashRejected hash_error
            v::free partial_items
            hash_result
        Result::Err normalizer_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::PublicSurfaceNormalizerRejected normalizer_error

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_from_scanner_output_result: scanner output から Drop 増補済み surface state owner を[作/つく]る
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(state)`: scanner output 由来の public surface hash と、non-Drop base candidates + Drop proof candidates を持つ state owner を返します。
//: - `Err(...)`: 拒否境界を typed enum で返します。途中で作った owner はこの関数または下位 owner boundary が閉じます。
pub fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_from_scanner_output_result %impure fn &SelfhostHirModule impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostMemoTraitPublicImplScannerOutput impure fn &SelfhostMemoTraitOperationDropNoEscapeProofTable Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \module\graph\dependencies\reexports\seed_table\scanner_output\proofs:
    match selfhost_memo_trait_public_impl_surface_drop_candidate_connector_hash_from_scanner_output_result graph dependencies reexports seed_table scanner_output:
        Result::Ok public_surface_hash:
            let operation_records %&SelfhostMemoTraitOperationPublicImplMaterializerRecordTable field::get_ref scanner_output "operation_records"
            match selfhost_memo_trait_public_impl_surface_drop_candidate_connector_non_drop_records_result operation_records:
                Result::Ok base_records:
                    match selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_result module &base_records:
                        Result::Ok base_impls:
                            selfhost_memo_trait_operation_public_impl_materializer_record_table_free base_records
                            match selfhost_memo_trait_operation_drop_candidate_connector_append_from_records_result base_impls module operation_records proofs:
                                Result::Ok next_impls:
                                    Result::Ok SelfhostMemoTraitPublicImplSurfaceState public_surface_hash next_impls
                                Result::Err connector_error:
                                    Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::DropCandidateConnectorRejected connector_error
                        Result::Err materializer_error:
                            selfhost_memo_trait_operation_public_impl_materializer_record_table_free base_records
                            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::BaseOperationMaterializerRejected materializer_error
                Result::Err filter_error:
                    Result::Err filter_error
        Result::Err surface_error:
            Result::Err surface_error

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_from_ast_records_result: AST と resolver records から scanner-bound Drop 増補 state を[作/つく]る
//:
//: [契約/けいやく]:
//: - `ast`、`records`、`module`、`graph`、`dependencies`、`reexports`、`proofs` はすべて borrow です。この関数は閉じません。
//: - scanner output owner は、この関数が success / downstream rejection の両方で閉じます。
//: - scanner が拒否した場合は downstream stage へ進まず、`ScannerRejected` として返します。
pub fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_from_ast_records_result %impure fn &SelfhostHirModule impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostModuleAst impure fn &SelfhostMemoTraitPublicImplScannerResolverRecordTable impure fn &SelfhostMemoTraitOperationDropNoEscapeProofTable Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind \module\graph\dependencies\reexports\seed_table\ast\records\proofs:
    match selfhost_memo_trait_public_impl_scanner_result ast records:
        Result::Ok scanner_output:
            let result %Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind:
                selfhost_memo_trait_public_impl_surface_drop_candidate_connector_from_scanner_output_result module graph dependencies reexports seed_table &scanner_output proofs
            selfhost_memo_trait_public_impl_scanner_output_free scanner_output
            result
        Result::Err scanner_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind::ScannerRejected scanner_error

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_summary_from_state: state owner を summary へ[写/うつ]して[閉/と]じる
fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_summary_from_state %impure fn SelfhostMemoTraitPublicImplSurfaceState impure fn SelfhostTypeId SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary \state\type_id:
    let public_hash %i32 selfhost_memo_trait_public_impl_surface_state_public_surface_hash &state
    let operation_len %i32 selfhost_memo_trait_public_impl_surface_state_operation_len &state
    let operation_impls %&SelfhostMemoTraitOperationImplTable field::get_ref &state "operation_impls"
    let eq_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind:
        selfhost_memo_trait_operation_impl_candidate_for_type_operation_result operation_impls type_id SelfhostMemoTraitOperationEvidenceKind::Eq
    let drop_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind:
        selfhost_memo_trait_operation_impl_candidate_for_type_operation_result operation_impls type_id SelfhostMemoTraitOperationEvidenceKind::Drop
    selfhost_memo_trait_public_impl_surface_state_free state
    SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary public_hash operation_len eq_candidate drop_candidate

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_len_eq: accepted summary の candidate 数を[確認/かくにん]する
pub fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_len_eq %fn Result SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind fn i32 bool \result\expected:
    match result:
        Result::Ok summary:
            and:
                not eq summary.public_surface_hash 0
                eq summary.operation_impl_len expected
        Result::Err _error:
            false

//: selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_drop_evidence_eq: accepted Drop candidate の evidence を[確認/かくにん]する
pub fn selfhost_memo_trait_public_impl_surface_drop_candidate_connector_accepted_drop_evidence_eq %fn Result SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorAcceptedSummary SelfhostMemoTraitPublicImplSurfaceDropCandidateConnectorErrorKind fn SelfhostMemoTraitOperationDropEvidence bool \result\expected:
    match result:
        Result::Ok summary:
            match summary.drop_candidate:
                Result::Ok candidate:
                    selfhost_memo_trait_operation_drop_evidence_eq candidate.drop_evidence expected
                Result::Err _lookup_error:
                    false
        Result::Err _error:
