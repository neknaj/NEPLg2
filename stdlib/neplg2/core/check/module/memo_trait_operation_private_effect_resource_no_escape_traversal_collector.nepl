//: SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind: graph collector の構造的な拒否理由
pub enum SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind:
    GraphBodyPushFailed %StdErrorKind
    GraphPlacePushFailed %StdErrorKind
    GraphEdgePushFailed %StdErrorKind
    GraphBodyReadFailed %i32
    GraphPlaceReadFailed %i32
    GraphEdgeReadFailed %i32
    GraphBodyDuplicate
    GraphMaterializerKeyDuplicate
    GraphBodyMissing %i32
    GraphPlaceDuplicate
    GraphEdgeDuplicate
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    PlaceIdInvalid %i32
    EdgeEndpointInvalid %i32
    EdgeEndpointMissing %i32
    EffectNotPrivate %SelfhostEffectKind
    EscapeNotApplicable %SelfhostEffectEscapeState
    OutputTraversalTableAllocFailed %StdErrorKind
    OutputTraversalTableRejected %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind

