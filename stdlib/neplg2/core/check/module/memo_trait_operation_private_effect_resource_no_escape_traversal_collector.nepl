//: SelfhostPrivateEffectResourceGraphId: PrivateEffect method body 用 Resource graph の session-local id
pub struct SelfhostPrivateEffectResourceGraphId:
    index %i32

//: SelfhostPrivateEffectResourcePlaceId: Resource graph 内の place id
pub struct SelfhostPrivateEffectResourcePlaceId:
    index %i32

//: SelfhostPrivateEffectResourceGraphCompleteness: PrivateEffect method body graph の閉包状態
//:
//: [目的/もくてき]:
//: - graph が PrivateEffect method body について閉じている場合だけ no-escape 判定へ進めます。
pub enum SelfhostPrivateEffectResourceGraphCompleteness:
    ClosedForPrivateEffectBody
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostPrivateEffectResourceFreshRegionEvidence: private-only graph が fresh private region 由来かを示す typed evidence
//:
//: [目的/もくてき]:
//: - PrivateState / PrivateCache body は、private place だけを通ったことに加えて、その region が呼び出しごとに fresh であることを確認できる場合だけ no-escape として扱います。
//: - missing / unsupported を bool に潰すと pure mask が安全側に倒れないため、typed enum のまま summary へ畳みます。
pub enum SelfhostPrivateEffectResourceFreshRegionEvidence:
    FreshPrivateRegionWitnessed
    FreshRegionMissing
    FreshRegionUnsupported

//: SelfhostPrivateEffectResourcePlaceKind: Resource graph place の分類
pub enum SelfhostPrivateEffectResourcePlaceKind:
    PrivateLocal
    PrivateTemporary
    ReturnPlace
    PublicStore
    ExternalHandle
    UnsupportedPlace

//: SelfhostPrivateEffectResourceEdgeKind: Resource graph edge の分類
pub enum SelfhostPrivateEffectResourceEdgeKind:
    Owns
    Field
    BorrowView
    MoveTo
    StoreToPublic
    Return
    CallBoundaryUnsupported

//: SelfhostPrivateEffectResourceGraphBodyRecord: 1 PrivateEffect method body の Resource graph header
pub struct SelfhostPrivateEffectResourceGraphBodyRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    graph_id %SelfhostPrivateEffectResourceGraphId
    completeness %SelfhostPrivateEffectResourceGraphCompleteness
    fresh_region %SelfhostPrivateEffectResourceFreshRegionEvidence

//: SelfhostPrivateEffectResourceGraphPlaceRecord: Resource graph の place record
pub struct SelfhostPrivateEffectResourceGraphPlaceRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostPrivateEffectResourceGraphId
    place_id %SelfhostPrivateEffectResourcePlaceId
    kind %SelfhostPrivateEffectResourcePlaceKind

//: SelfhostPrivateEffectResourceGraphEdgeRecord: Resource graph の edge record
pub struct SelfhostPrivateEffectResourceGraphEdgeRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostPrivateEffectResourceGraphId
    from_place %SelfhostPrivateEffectResourcePlaceId
    to_place %SelfhostPrivateEffectResourcePlaceId
    kind %SelfhostPrivateEffectResourceEdgeKind

//: SelfhostPrivateEffectResourceGraphInput: PrivateEffect method body Resource graph input の owner table
pub struct SelfhostPrivateEffectResourceGraphInput:
    bodies %Vec SelfhostPrivateEffectResourceGraphBodyRecord
    places %Vec SelfhostPrivateEffectResourceGraphPlaceRecord
    edges %Vec SelfhostPrivateEffectResourceGraphEdgeRecord

//: SelfhostPrivateEffectResourceTraversalFoldSummary: graph fold の summary
pub struct SelfhostPrivateEffectResourceTraversalFoldSummary:
