    unsupported_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind
    fresh_missing_status %Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind
    duplicate_rejected %Result i32 SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind
