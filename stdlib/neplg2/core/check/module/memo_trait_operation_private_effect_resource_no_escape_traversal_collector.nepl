//: selfhost_private_effect_resource_graph_effect_is_private: private-effect traversal が受理できる effect か[返/かえ]す
fn selfhost_private_effect_resource_graph_effect_is_private %fn SelfhostEffectKind bool \effect:
    match effect:
        SelfhostEffectKind::Pure:
            false
        SelfhostEffectKind::InternalAlloc:
            false
        SelfhostEffectKind::PrivateState:
            true
        SelfhostEffectKind::PrivateCache:
            true
        SelfhostEffectKind::UnsafeMemory:
            false
        SelfhostEffectKind::ExternalIo:
            false
        SelfhostEffectKind::Nondet:
            false

//: selfhost_private_effect_resource_graph_validate_body_result: body record の受理条件を[確認/かくにん]する
fn selfhost_private_effect_resource_graph_validate_body_result %fn SelfhostPrivateEffectResourceGraphBodyRecord Result unit SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind \body:
    if:
        eq body.body_module_fingerprint 0
        then:
            Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                lt body.graph_id.index 0
                then:
                    Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::GraphIdInvalid body.graph_id.index
                else:
                    if:
                        selfhost_private_effect_resource_graph_effect_is_private body.effect
                        then:
                            match body.escape:
                                SelfhostEffectEscapeState::NotApplicable:
                                    Result::Ok unit
                                SelfhostEffectEscapeState::NoEscapeProven:
                                    Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::EscapeNotApplicable body.escape
                                SelfhostEffectEscapeState::MayEscape:
                                    Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::EscapeNotApplicable body.escape
                        else:
                            Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::EffectNotPrivate body.effect

