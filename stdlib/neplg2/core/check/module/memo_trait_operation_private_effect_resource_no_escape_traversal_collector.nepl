//: selfhost_private_effect_resource_graph_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_private_effect_resource_graph_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

