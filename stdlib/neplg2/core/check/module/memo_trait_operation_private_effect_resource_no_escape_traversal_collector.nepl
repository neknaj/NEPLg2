//: selfhost_private_effect_resource_graph_input_new: [空/から]の graph input owner を[作/つく]る
pub fn selfhost_private_effect_resource_graph_input_new %impure fn void Result SelfhostPrivateEffectResourceGraphInput StdErrorKind \void:
    let bodies_result %Result Vec SelfhostPrivateEffectResourceGraphBodyRecord StdErrorKind v::new
    match bodies_result:
        Result::Ok bodies:
            let places_result %Result Vec SelfhostPrivateEffectResourceGraphPlaceRecord StdErrorKind v::new
            match places_result:
                Result::Ok places:
                    let edges_result %Result Vec SelfhostPrivateEffectResourceGraphEdgeRecord StdErrorKind v::new
                    match edges_result:
                        Result::Ok edges:
                            Result::Ok SelfhostPrivateEffectResourceGraphInput bodies places edges
                        Result::Err e:
                            v::free places
                            v::free bodies
                            Result::Err e
                Result::Err e:
                    v::free bodies
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_private_effect_resource_graph_input_free: graph input owner を[閉/と]じる
pub fn selfhost_private_effect_resource_graph_input_free %impure fn SelfhostPrivateEffectResourceGraphInput unit \input:
    v::free field::get input "bodies"
    v::free field::get input "places"
    v::free field::get input "edges"

//: selfhost_private_effect_resource_graph_body_len: body record 数を[返/かえ]す
pub fn selfhost_private_effect_resource_graph_body_len %fn &SelfhostPrivateEffectResourceGraphInput i32 \input:
    let bodies %&Vec SelfhostPrivateEffectResourceGraphBodyRecord field::get_ref input "bodies"
    v::len bodies

//: selfhost_private_effect_resource_graph_place_len: place record 数を[返/かえ]す
pub fn selfhost_private_effect_resource_graph_place_len %fn &SelfhostPrivateEffectResourceGraphInput i32 \input:
    let places %&Vec SelfhostPrivateEffectResourceGraphPlaceRecord field::get_ref input "places"
    v::len places

//: selfhost_private_effect_resource_graph_edge_len: edge record 数を[返/かえ]す
