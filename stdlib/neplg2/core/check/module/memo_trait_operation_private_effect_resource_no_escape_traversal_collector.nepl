pub fn selfhost_private_effect_resource_graph_body_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostPrivateEffectResourceGraphId fn SelfhostPrivateEffectResourceGraphCompleteness fn SelfhostPrivateEffectResourceFreshRegionEvidence SelfhostPrivateEffectResourceGraphBodyRecord \type_id\operation\body_module_fingerprint\body_root\effect\escape\graph_id\completeness\fresh_region:
    SelfhostPrivateEffectResourceGraphBodyRecord type_id operation body_module_fingerprint body_root effect escape graph_id completeness fresh_region

