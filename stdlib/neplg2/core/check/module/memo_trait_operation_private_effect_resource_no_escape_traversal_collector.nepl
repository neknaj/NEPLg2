    match selfhost_private_effect_resource_graph_validate_body_result body:
        Result::Ok _unit:
            if:
                selfhost_private_effect_resource_graph_contains_body &input body
                then:
                    selfhost_private_effect_resource_graph_input_free input
                    Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::GraphBodyDuplicate
                else:
                    let bodies %Vec SelfhostPrivateEffectResourceGraphBodyRecord field::get input "bodies"
                    let places %Vec SelfhostPrivateEffectResourceGraphPlaceRecord field::get input "places"
                    let edges %Vec SelfhostPrivateEffectResourceGraphEdgeRecord field::get input "edges"
                    match v::push bodies body:
                        Result::Ok next_bodies:
                            Result::Ok SelfhostPrivateEffectResourceGraphInput next_bodies places edges
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            v::free places
                            v::free edges
                            Result::Err SelfhostPrivateEffectResourceGraphTraversalCollectorErrorKind::GraphBodyPushFailed error
        Result::Err error:
            selfhost_private_effect_resource_graph_input_free input
            Result::Err error

