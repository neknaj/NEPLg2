//: selfhost_private_effect_resource_graph_edge_record_new: graph edge record を[作/つく]る
pub fn selfhost_private_effect_resource_graph_edge_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostPrivateEffectResourceGraphId fn SelfhostPrivateEffectResourcePlaceId fn SelfhostPrivateEffectResourcePlaceId fn SelfhostPrivateEffectResourceEdgeKind SelfhostPrivateEffectResourceGraphEdgeRecord \type_id\operation\body_module_fingerprint\body_root\graph_id\from_place\to_place\kind:
