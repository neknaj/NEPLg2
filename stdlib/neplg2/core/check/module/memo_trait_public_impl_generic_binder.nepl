#indent 4

//: # check/module/memo_trait_public_impl_generic_binder
//: public trait impl header に[含/ふく]まれる generic binder と bound の[詳細/しょうさい] evidence を[検査/けんさ]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - `memo_trait_public_impl_header` が現在 `type_parameter_count` と `type_parameter_bound_count` だけでは generic impl identity を作れないため fail-closed にしている境界を、詳細 evidence table へ進める準備をします。
//: - type parameter binder の ordinal、`SelfhostTypeParameterBinding`、stable symbol hash、bound range と、bound 側の trait application shape を分けて保持し、count だけで generic impl を受理する退行を防ぎます。
//: - public impl header producer、operation classifier、candidate builder、Resource IR proof、PrivateCache / PrivateState masking を混ぜず、generic binder / bound shape の型付き検査だけを担当します。
//:
//: [契約/けいやく]:
//: - accepted authority は caller が渡した `SelfhostMemoTraitPublicImplGenericParameterTable` と `SelfhostMemoTraitPublicImplGenericBoundTable` の typed field だけです。
//: - source text、span、lexeme、display name、diagnostic text、module path、public surface hash、HIR、Resource IR、backend artifact、proof store record は accepted shape material に入りません。
//: - parameter table length は expected type parameter count と一致しなければなりません。bound table length は expected bound count と一致しなければなりません。
//: - parameter ordinal は 1-origin で table order と一致しなければなりません。`SelfhostTypeParameterBinding` は valid かつ現行 Phase 1 では `binder_depth = 0`、`parameter_index = table index` でなければなりません。stable symbol hash 0 は placeholder として拒否します。
//: - parameter の bound range は 0-origin の contiguous range です。range は table order に沿って重複も穴もなく bound table 全体を覆わなければなりません。
//: - bound record は対応する parameter ordinal、1-origin bound ordinal、nonzero trait application shape hash、非負の trait type argument count を持たなければなりません。
//: - この module は generic impl が `MemoKey` / `MemoValue` として有効であることや、bound solving が成功することを証明しません。後続 solver が読むための detailed shape evidence だけを作ります。
//:
//: [現状/げんじょう]:
//: - Phase 1 では stage0 smoke が monomorphic table、2 parameter / 2 bound の generic table、count mismatch、symbol placeholder、range mismatch、missing bound shape を確認します。
//: - `memo_trait_public_impl_header` へこの evidence hash を接続し generic impl を accepted path に流す作業、trait bound solving、coherence、operation impl candidate 生成、PrivateCache / PrivateState effect masking、prechecked artifact 接続は後続 slice の責務です。
//: - facade にはまだ re-export しません。public impl header と full operation evidence orchestration が generic binder evidence を受け取る段階で公開範囲を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - parameter 数を p、bound 数を b とすると、evidence 生成は O(p + b) 時間です。
//: - 追加空間は hash accumulator と loop index だけなので O(1) です。table は caller が所有する input owner を borrow で読みます。
//: - 将来 sorted index や bound lookup cache を足す場合でも、この module の accepted authority、error enum、shape hash contract は変えずに置き換えられます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_generic_binder" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_public_impl_generic_binder_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check is_ok summary.monomorphic
//:             let checks2 checks_push checks1 check selfhost_memo_trait_public_impl_generic_binder_evidence_counts_eq summary.generic 2 2
//:             let checks3 checks_push checks2 check selfhost_memo_trait_public_impl_generic_binder_evidence_hash_diff summary.monomorphic summary.generic
//:             let checks4 checks_push checks3 check selfhost_memo_trait_public_impl_generic_binder_error_result_eq summary.count_mismatch SelfhostMemoTraitPublicImplGenericBinderErrorKind::ParameterCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new 1 0
//:             let checks5 checks_push checks4 check selfhost_memo_trait_public_impl_generic_binder_error_result_eq summary.symbol_placeholder SelfhostMemoTraitPublicImplGenericBinderErrorKind::ParameterSymbolHashPlaceholder 0
//:             let checks6 checks_push checks5 check selfhost_memo_trait_public_impl_generic_binder_error_result_eq summary.missing_bound_shape SelfhostMemoTraitPublicImplGenericBinderErrorKind::BoundTraitApplicationShapeHashMissing 0
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "generic binder stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/ty/ty/id" as *

//: SelfhostMemoTraitPublicImplGenericParameter: public impl generic parameter binder の typed record
//:
//: [契約/けいやく]:
//: - `parameter_ordinal` は 1-origin で、parameter table の順序と一致する必要があります。
//: - `binding` は resolver / checker が generic binder environment から得た binder-indexed identity です。source name ではありません。
//: - `stable_symbol_hash` は type parameter symbol の stable identity hash です。source spelling そのものではありません。
//: - `first_bound_index` は bound table 内の 0-origin 開始位置です。
//: - `bound_count` はこの parameter に属する contiguous bound record 数です。
pub struct SelfhostMemoTraitPublicImplGenericParameter:
    parameter_ordinal %i32
    binding %SelfhostTypeParameterBinding
    stable_symbol_hash %i32
    first_bound_index %i32
    bound_count %i32

//: SelfhostMemoTraitPublicImplGenericBound: public impl generic bound の typed record
//:
//: [契約/けいやく]:
//: - `parameter_ordinal` は bound が属する parameter の 1-origin ordinal です。
//: - `bound_ordinal` は bound table 全体での 1-origin ordinal です。
//: - `trait_application_shape_hash` は stable trait identity と type argument identity を含む normalized shape hash です。
//: - `trait_type_argument_count` は shape hash の producer が読んだ trait type argument 数です。この module は count を hash material に含めますが、trait solving は行いません。
pub struct SelfhostMemoTraitPublicImplGenericBound:
    parameter_ordinal %i32
    bound_ordinal %i32
    trait_application_shape_hash %Option i32
    trait_type_argument_count %i32

//: SelfhostMemoTraitPublicImplGenericParameterTable: generic parameter binder record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。この module の evidence API は borrow で読み、閉じません。
//: - 不要になった table は caller が `selfhost_memo_trait_public_impl_generic_parameter_table_free` で閉じます。
pub struct SelfhostMemoTraitPublicImplGenericParameterTable:
    records %Vec SelfhostMemoTraitPublicImplGenericParameter

//: SelfhostMemoTraitPublicImplGenericBoundTable: generic bound record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。この module の evidence API は borrow で読み、閉じません。
//: - 不要になった table は caller が `selfhost_memo_trait_public_impl_generic_bound_table_free` で閉じます。
pub struct SelfhostMemoTraitPublicImplGenericBoundTable:
    records %Vec SelfhostMemoTraitPublicImplGenericBound

//: SelfhostMemoTraitPublicImplGenericBinderCountMismatch: expected / actual count mismatch payload
//:
//: [目的/もくてき]:
//: - enum variant が単一 payload の現在の NEPLg2.1 構文でも、expected と actual を失わずに保持します。
pub struct SelfhostMemoTraitPublicImplGenericBinderCountMismatch:
    expected %i32
    actual %i32

//: SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch: ordinal mismatch payload
pub struct SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch:
    index %i32
    expected %i32
    actual %i32

//: SelfhostMemoTraitPublicImplGenericBinderRangeMismatch: bound range start mismatch payload
pub struct SelfhostMemoTraitPublicImplGenericBinderRangeMismatch:
    parameter_ordinal %i32
    expected_start %i32
    actual_start %i32

//: SelfhostMemoTraitPublicImplGenericBinderRangeOutOfBounds: bound range out-of-bounds payload
pub struct SelfhostMemoTraitPublicImplGenericBinderRangeOutOfBounds:
    parameter_ordinal %i32
    range_end %i32
    bound_table_len %i32

//: SelfhostMemoTraitPublicImplGenericBinderBoundParameterMismatch: bound が range owner parameter と一致しない場合の payload
pub struct SelfhostMemoTraitPublicImplGenericBinderBoundParameterMismatch:
    bound_index %i32
    expected_parameter %i32
    actual_parameter %i32

//: SelfhostMemoTraitPublicImplGenericBinderEvidence: validated generic binder / bound shape evidence
//:
//: [目的/もくてき]:
//: - public impl header が count だけではなく detailed binder / bound shape を受け取れるよう、schema version と root hash を保持します。
//:
//: [契約/けいやく]:
//: - `shape_hash` は nonzero でなければなりません。
//: - この evidence は generic impl の semantic success ではありません。trait solver や MemoKey / MemoValue structural proof は後続 stage が別 evidence として接続します。
pub struct SelfhostMemoTraitPublicImplGenericBinderEvidence:
    schema_version %i32
    type_parameter_count %i32
    type_parameter_bound_count %i32
    shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericBinderErrorKind: generic binder evidence 境界の拒否理由
//:
//: [目的/もくてき]:
//: - table owner setup、count、ordinal、range、shape hash、derived hash のどこで拒否したかを typed enum として保持します。
pub enum SelfhostMemoTraitPublicImplGenericBinderErrorKind:
    ParameterTableAllocFailed %StdErrorKind
    ParameterPushFailed %StdErrorKind
    BoundTableAllocFailed %StdErrorKind
    BoundPushFailed %StdErrorKind
    TypeParameterCountNegative
    TypeParameterBoundCountNegative
    ParameterCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    BoundCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    ParameterReadFailed %i32
    BoundReadFailed %i32
    ParameterOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    ParameterOrdinalPlaceholder %i32
    ParameterBindingInvalid %i32
    ParameterBindingDepthUnsupported %i32
    ParameterBindingIndexMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    ParameterSymbolHashPlaceholder %i32
    BoundRangeStartNegative %i32
    BoundRangeStartMismatch %SelfhostMemoTraitPublicImplGenericBinderRangeMismatch
    BoundRangeCountNegative %i32
    BoundRangeOutOfBounds %SelfhostMemoTraitPublicImplGenericBinderRangeOutOfBounds
    BoundParameterOrdinalOutOfRange %i32
    BoundParameterOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderBoundParameterMismatch
    BoundOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    BoundTraitApplicationShapeHashMissing %i32
    BoundTraitApplicationShapeHashPlaceholder %i32
    BoundTraitTypeArgumentCountNegative %i32
    DerivedBinderShapeHashPlaceholder

//: SelfhostMemoTraitPublicImplGenericBinderStage0Summary: generic binder smoke の代表結果
