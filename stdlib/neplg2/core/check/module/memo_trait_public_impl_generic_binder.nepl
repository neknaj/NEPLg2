//: selfhost_memo_trait_public_impl_generic_binder_validate_bound_result: 1 bound record を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_binder_validate_bound_result %fn SelfhostMemoTraitPublicImplGenericBound fn i32 fn i32 fn i32 Result i32 SelfhostMemoTraitPublicImplGenericBinderErrorKind \bound\index\expected_parameter\type_parameter_count:
    if:
        lt bound.parameter_ordinal 1
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericBinderErrorKind::BoundParameterOrdinalOutOfRange index
        else:
            if:
                gt bound.parameter_ordinal type_parameter_count
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericBinderErrorKind::BoundParameterOrdinalOutOfRange index
                else:
                    if:
