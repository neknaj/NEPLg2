//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_header_result: materializer record の impl header を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - record に入っている typed header field と generic binder evidence mode をそのまま使います。
//: - count-only generic や detailed generic instantiation unsupported を Drop fact table へ進ませません。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_header_result %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result unit SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind \record:
    let header_input %SelfhostMemoTraitPublicImplHeaderInput selfhost_memo_trait_public_impl_header_input_new record.visibility record.module_fingerprint record.declaration_ordinal record.impl_kind record.target_type_shape_hash record.trait_application_shape_hash record.type_parameter_count record.type_parameter_bound_count record.generic_binder_evidence
    match selfhost_memo_trait_public_impl_header_evidence_result header_input:
        Result::Ok _evidence:
            match record.generic_binder_evidence:
                SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Monomorphic:
                    Result::Ok unit
                SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Detailed _evidence:
                    Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::GenericImplInstantiationUnsupported
        Result::Err header_error:
            Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::HeaderRejected header_error

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_trait_application_input: materializer record から classifier input を[作/つく]る
//:
//: [契約/けいやく]:
//: - record の trait source / type argument count / shape hash だけを写します。operation kind は classifier result から読むため、ここでは判定しません。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_trait_application_input %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitOperationTraitApplicationInput \record:
    selfhost_memo_trait_operation_trait_application_input_new record.trait_source record.trait_type_argument_count record.trait_application_shape_hash

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_classifier_result: record の operation classifier evidence を[得/え]る
//:
//: [契約/けいやく]:
//: - classifier rejection は public API の typed error に包んで返します。record にある operation field を直接信用する bypass を作りません。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_classifier_result %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result SelfhostMemoTraitOperationClassifierEvidence SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind \record:
    let trait_application %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_trait_application_input record
    match selfhost_memo_trait_operation_classifier_evidence_result trait_application:
        Result::Ok classifier:
            Result::Ok classifier
        Result::Err classifier_error:
            Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::ClassifierRejected classifier_error

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_operation_is_drop: classifier evidence が Drop か[返/かえ]す
//:
//: [契約/けいやく]:
//: - wildcard arm は使いません。operation kind が増えた場合、この matrix を明示的に更新します。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_operation_is_drop %fn SelfhostMemoTraitOperationEvidenceKind bool \operation:
    match operation:
        SelfhostMemoTraitOperationEvidenceKind::Copy:
            false
        SelfhostMemoTraitOperationEvidenceKind::Drop:
            true
        SelfhostMemoTraitOperationEvidenceKind::Eq:
            false
        SelfhostMemoTraitOperationEvidenceKind::Hash:
            false

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_push_drop_record_result: Drop record 1 件を fact table へ[投入/とうにゅう]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。success では builder が返した next owner を返します。
//: - Drop root 欠落では builder へ進まないため、この関数が table owner を閉じます。
//: - builder rejection では builder / resolver push boundary が owner cleanup を完了するため、この関数は二重解放しません。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_push_drop_record_result %impure fn SelfhostMemoTraitOperationDropImplTable impure fn &SelfhostHirModule impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecord impure fn i32 Result SelfhostMemoTraitOperationDropImplTable SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind \table\module\record\index:
    match record.method_body_root:
        Option::Some root:
            match selfhost_memo_trait_operation_drop_impl_fact_table_builder_push_hir_root_result table module record.type_id record.module_fingerprint root record.fuel:
                Result::Ok next_table:
                    Result::Ok next_table
                Result::Err builder_error:
                    Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::BuilderRejected builder_error
        Option::None:
            selfhost_memo_trait_operation_drop_impl_table_free table
            Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::RequiredDropBodyRootMissing index

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_loop: materializer record table を Drop fact table へ[走査/そうさ]する
//:
//: [契約/けいやく]:
//: - classifier が Drop を返した record だけ builder に渡します。
//: - non-Drop record は同じ table に混在する正常入力なので、その method root の有無に関係なく skip します。
//: - source read failure と classifier rejection では、この loop が未消費 Drop table owner を閉じます。
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_loop %impure fn SelfhostMemoTraitOperationDropImplTable impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn i32 Result SelfhostMemoTraitOperationDropImplTable SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind \table\module\source\index:
    if:
        ge index selfhost_memo_trait_operation_public_impl_materializer_record_table_len source
        then:
            Result::Ok table
        else:
            let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_header_result record:
                        Result::Ok _header_ok:
                            match selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_classifier_result record:
                                Result::Ok classifier:
                                    if:
                                        selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_operation_is_drop classifier.operation
                                        then:
                                            match selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_push_drop_record_result table module record index:
                                                Result::Ok next_table:
                                                    selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_loop next_table module source add index 1
                                                Result::Err e:
                                                    Result::Err e
                                        else:
                                            selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_loop table module source add index 1
                                Result::Err e:
                                    selfhost_memo_trait_operation_drop_impl_table_free table
                                    Result::Err e
                        Result::Err e:
                            selfhost_memo_trait_operation_drop_impl_table_free table
                            Result::Err e
                Option::None:
                    selfhost_memo_trait_operation_drop_impl_table_free table
                    Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_public_impl_drop_fact_table_from_records_result: public impl materializer records から Drop impl fact table owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `module` と `source` は borrow です。この関数は閉じません。
//: - success の場合だけ caller は output Drop impl fact table owner を受け取ります。
//: - failure の場合、内部で作った output table owner はこの module または builder / resolver push boundary が閉じています。
pub fn selfhost_memo_trait_operation_public_impl_drop_fact_table_from_records_result %impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable Result SelfhostMemoTraitOperationDropImplTable SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind \module\source:
    match selfhost_memo_trait_operation_drop_impl_table_new:
        Result::Ok table0:
            selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_loop table0 module source 0
        Result::Err alloc_error:
            Result::Err SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::OutputTableAllocFailed alloc_error

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            0
        StdErrorKind::OutOfMemory:
            1
        StdErrorKind::EmptyCollection:
            2
        StdErrorKind::IndexOutOfBounds:
            3
        StdErrorKind::KeyNotFound:
            4
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            6
        StdErrorKind::InvalidUtf8:
            7
        StdErrorKind::ParseError:
            8
        StdErrorKind::IoError:
            9
        StdErrorKind::Other:
            10

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    eq selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_code a selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_code b

//: selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_error_kind_eq: orchestrator error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - nested classifier / builder error は payload まで比較します。
//: - wildcard arm は使いません。error variant が増えた場合はこの equality を明示的に更新します。
pub fn selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_error_kind_eq %fn SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind fn SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::OutputTableAllocFailed a_alloc:
            match b:
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::OutputTableAllocFailed b_alloc:
                    selfhost_memo_trait_operation_public_impl_drop_fact_orchestrator_std_error_kind_eq a_alloc b_alloc
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::SourceReadFailed _b_read:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::HeaderRejected _b_header:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::ClassifierRejected _b_classifier:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::GenericImplInstantiationUnsupported:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::RequiredDropBodyRootMissing _b_index:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::BuilderRejected _b_builder:
                    false
        SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::SourceReadFailed a_read:
            match b:
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::OutputTableAllocFailed _b_alloc:
                    false
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::SourceReadFailed b_read:
                    eq a_read b_read
                SelfhostMemoTraitOperationPublicImplDropFactOrchestratorErrorKind::HeaderRejected _b_header:
