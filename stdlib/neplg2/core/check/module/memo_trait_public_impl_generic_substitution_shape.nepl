//: [契約/けいやく]:
//: - この constructor は field をまとめるだけです。binder、type argument、shape hash の検査は producer 本体で行います。
pub fn selfhost_memo_trait_public_impl_generic_substitution_shape_input_new %fn SelfhostMemoTraitPublicImplGenericBinderEvidence fn i32 fn SelfhostMemoTraitStableTypeArgumentIdentityHash fn Option i32 fn Option i32 fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence fn Option i32 fn Option i32 SelfhostMemoTraitPublicImplGenericSubstitutionShapeInput \generic_binder_evidence\type_argument_count\type_argument_identity_hash\pre_substitution_target_type_shape_hash\pre_substitution_trait_application_shape_hash\substitution_trace_evidence\substituted_target_type_shape_hash\substituted_trait_application_shape_hash:
