//: selfhost_memo_trait_public_impl_generic_substitution_shape_schema_version: substitution shape evidence schema
pub fn selfhost_memo_trait_public_impl_generic_substitution_shape_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_impl_generic_substitution_shape_mix2: substitution shape hash 用に 2 値を[混/ま]ぜる
fn selfhost_memo_trait_public_impl_generic_substitution_shape_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_impl_generic_substitution_shape_mix4: substitution shape hash 用に 4 値を[混/ま]ぜる
fn selfhost_memo_trait_public_impl_generic_substitution_shape_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_impl_generic_substitution_shape_mix2 (selfhost_memo_trait_public_impl_generic_substitution_shape_mix2 a b) (selfhost_memo_trait_public_impl_generic_substitution_shape_mix2 c d)

//: selfhost_memo_trait_public_impl_generic_substitution_shape_binder_hash_result: binder evidence を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_binder_hash_result %fn SelfhostMemoTraitPublicImplGenericBinderEvidence Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \evidence:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::BinderEvidenceSchemaPlaceholder
        else:
            if:
                eq evidence.shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::BinderEvidenceHashPlaceholder
                else:
                    if:
                        lt evidence.type_parameter_count 1
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::GenericParameterCountMissing
                        else:
                            if:
                                lt evidence.type_parameter_bound_count 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeParameterBoundCountNegative
                                else:
                                    Result::Ok evidence.shape_hash

//: selfhost_memo_trait_public_impl_generic_substitution_shape_type_argument_identity_result: type argument identity hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_type_argument_identity_result %fn SelfhostMemoTraitStableTypeArgumentIdentityHash Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \hash:
    if:
        eq hash.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentIdentitySchemaPlaceholder
        else:
            if:
                eq hash.identity_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentIdentityHashPlaceholder
                else:
                    Result::Ok hash

//: selfhost_memo_trait_public_impl_generic_substitution_shape_pre_target_result: pre-substitution target shape hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_pre_target_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \hash:
    match hash:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::PreSubstitutionTargetTypeShapeHashPlaceholder
                else:
                    Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::PreSubstitutionTargetTypeShapeHashMissing

//: selfhost_memo_trait_public_impl_generic_substitution_shape_pre_trait_result: pre-substitution trait application shape hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_pre_trait_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \hash:
    match hash:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::PreSubstitutionTraitApplicationShapeHashPlaceholder
                else:
                    Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::PreSubstitutionTraitApplicationShapeHashMissing

//: selfhost_memo_trait_public_impl_generic_substitution_shape_trace_result: substitution trace evidence を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_trace_result %fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence fn SelfhostMemoTraitPublicImplGenericBinderEvidence fn i32 fn SelfhostMemoTraitStableTypeArgumentIdentityHash fn i32 Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \evidence\binder\type_argument_count\type_argument_hash\binder_hash:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceSchemaPlaceholder
        else:
            if:
                eq evidence.trace_shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceShapeHashPlaceholder
                else:
                    if:
                        not eq evidence.type_parameter_count binder.type_parameter_count
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeParameterCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new binder.type_parameter_count evidence.type_parameter_count
                        else:
                            if:
                                not eq evidence.type_argument_count type_argument_count
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeArgumentCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new type_argument_count evidence.type_argument_count
                                else:
                                    if:
                                        not eq evidence.type_parameter_bound_count binder.type_parameter_bound_count
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeParameterBoundCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new binder.type_parameter_bound_count evidence.type_parameter_bound_count
                                        else:
                                            if:
                                                not eq evidence.generic_binder_shape_hash binder_hash
                                                then:
                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceBinderHashMismatch
                                                else:
                                                    if:
                                                        not eq evidence.generic_parameter_table_shape_hash binder.parameter_table_shape_hash
                                                        then:
                                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceParameterTableShapeHashMismatch
                                                        else:
                                                            if:
                                                                not eq evidence.generic_bound_table_shape_hash binder.bound_table_shape_hash
                                                                then:
                                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceBoundTableShapeHashMismatch
                                                                else:
                                                                    if:
                                                                        eq evidence.type_argument_identity_hash.schema_version 0
                                                                        then:
                                                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeArgumentIdentitySchemaPlaceholder
                                                                        else:
                                                                            if:
                                                                                eq evidence.type_argument_identity_hash.identity_hash 0
                                                                                then:
                                                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeArgumentIdentityHashPlaceholder
                                                                                else:
                                                                                    if:
                                                                                        not eq evidence.type_argument_identity_hash.schema_version type_argument_hash.schema_version
                                                                                        then:
                                                                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeArgumentIdentitySchemaMismatch
                                                                                        else:
                                                                                            if:
                                                                                                not eq evidence.type_argument_identity_hash.identity_hash type_argument_hash.identity_hash
                                                                                                then:
                                                                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceTypeArgumentIdentityHashMismatch
                                                                                                else:
                                                                                                    if:
                                                                                                        not eq evidence.trace_record_count type_argument_count
                                                                                                        then:
                                                                                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceRecordCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new type_argument_count evidence.trace_record_count
                                                                                                        else:
                                                                                                            Result::Ok evidence

//: selfhost_memo_trait_public_impl_generic_substitution_shape_substituted_target_result: substituted target shape hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_shape_substituted_target_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \hash:
