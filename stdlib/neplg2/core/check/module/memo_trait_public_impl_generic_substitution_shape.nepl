#indent 4

//: # check/module/memo_trait_public_impl_generic_substitution_shape
//: public generic trait impl の target type / trait application を、具体 type argument で substitution した結果の shape evidence として[検査/けんさ]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - `memo_trait_public_impl_generic_instantiation` は substituted target type shape と substituted trait application shape を要求しますが、その値を任意の nonzero hash として渡せる状態を長く残すと、generic impl の accepted path が弱くなります。
//: - この module は actual substitution engine の前に、substitution 前の typed shape、stable type argument identity、typed substitution trace evidence、substitution 後の typed shape を 1 record にまとめて検査します。
//: - generic binder evidence、type argument identity、pre-substitution shape、substitution trace evidence、substituted shape を分けて保持し、source text や display string から作った一時 hash が generic impl instantiation の authority になる退行を防ぎます。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostMemoTraitPublicImplGenericSubstitutionShapeInput` の typed field だけです。
//: - source text、span、lexeme、display name、diagnostic text、module path、public surface hash、HIR、Resource IR、backend artifact、proof store record は accepted substitution shape material に入りません。
//: - `generic_binder_evidence.schema_version` と `generic_binder_evidence.shape_hash` は nonzero でなければなりません。
//: - この producer は generic substitution 専用です。`generic_binder_evidence.type_parameter_count` が 0 以下の input は monomorphic impl として別経路で扱うべきなので拒否します。
//: - `type_argument_count` は非負で、`generic_binder_evidence.type_parameter_count` と一致しなければなりません。
//: - `type_argument_identity_hash` は schema version と identity hash の両方が nonzero でなければなりません。hash value だけを authority として扱いません。
//: - pre-substitution target / trait application shape、substituted target / trait application shape は、すべて `some(nonzero)` でなければなりません。
//: - substitution trace は `memo_trait_public_impl_generic_substitution_trace` が作る schema 付き evidence として渡し、schema、root hash、binder count、binder hash、type argument identity をこの producer でも再検査します。
//: - 成功した evidence は generic impl instantiation gate の input を強める材料です。actual type substitution engine、trait bound solver、generic coherence、operation candidate materializer、PrivateCache / PrivateState effect masking は後続 stage が別 evidence として検査します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では resolver / type checker が作るべき substitution trace evidence の contract を先に固定します。
//: - actual type substitution engine はまだ実装しません。そのため、この module の成功は「渡された substitution trace と output shape が typed material として揃っている」ことだけを意味します。
//: - 既存 materializer の `GenericImplInstantiationUnsupported` はこの slice では維持します。operation candidate acceptance を広げるには、この evidence に加えて bound solving と coherence の evidence が必要です。
//:
//: [計算量/けいさんりょう]:
//: - この module 自体は fixed-size evidence を検査して hash に畳み込むだけなので O(1) 時間・O(1) 追加空間です。
//: - actual substitution engine の計算量は、型式木の大きさと generic parameter 数に依存しますが、この module の public contract からは分離します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_generic_binder" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_generic_substitution_shape" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_impl_generic_substitution_shape_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.accepted
//:     let checks2 checks_push checks1 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.monomorphic_rejected SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::GenericParameterCountMissing
//:     let checks3 checks_push checks2 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.type_argument_mismatch SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new 2 1
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.identity_placeholder SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentIdentityHashPlaceholder
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.pre_target_missing SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::PreSubstitutionTargetTypeShapeHashMissing
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.trace_placeholder SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutionTraceShapeHashPlaceholder
//:     let checks7 checks_push checks6 check selfhost_memo_trait_public_impl_generic_substitution_shape_error_result_eq summary.substituted_trait_placeholder SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::SubstitutedTraitApplicationShapeHashPlaceholder
//:     let shown checks_print_report checks7
//:     checks_exit_code shown
//: ```

#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/ty/ty/memo_trait_type_argument_identity" as *
#import "./memo_trait_public_impl_generic_binder" as *
#import "./memo_trait_public_impl_generic_substitution_trace" as *

//: SelfhostMemoTraitPublicImplGenericSubstitutionShapeInput: generic substitution shape producer の typed input
//:
//: [契約/けいやく]:
//: - `generic_binder_evidence` は substitution environment の binder side authority です。count と shape hash を再検査します。
//: - `type_argument_identity_hash` は concrete type argument side authority です。schema と hash を一緒に保持します。
//: - pre-substitution shape は impl header 側の normalized shape で、substituted shape は concrete type argument を適用した後の normalized shape です。
//: - `substitution_trace_evidence` は resolver / substitution engine が「どの binder にどの type argument を対応させたか」を表す typed trace evidence です。
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionShapeInput:
    generic_binder_evidence %SelfhostMemoTraitPublicImplGenericBinderEvidence
    type_argument_count %i32
    type_argument_identity_hash %SelfhostMemoTraitStableTypeArgumentIdentityHash
    pre_substitution_target_type_shape_hash %Option i32
    pre_substitution_trait_application_shape_hash %Option i32
    substitution_trace_evidence %SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence
    substituted_target_type_shape_hash %Option i32
    substituted_trait_application_shape_hash %Option i32

//: SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence: accepted generic substitution shape evidence
//:
//: [契約/けいやく]:
//: - `substitution_shape_hash` は schema、binder evidence、type argument identity、pre-substitution shape、trace shape、substituted shape を全て畳み込んだ nonzero hash です。
//: - 各入力 hash は個別 field として残します。後続 stage は root hash だけでなく、どの producer がどの shape を作ったかを検査できます。
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence:
    schema_version %i32
    type_parameter_count %i32
    type_argument_count %i32
    type_parameter_bound_count %i32
    generic_binder_shape_hash %i32
    generic_parameter_table_shape_hash %i32
    generic_bound_table_shape_hash %i32
    type_argument_identity_hash %SelfhostMemoTraitStableTypeArgumentIdentityHash
    pre_substitution_target_type_shape_hash %i32
    pre_substitution_trait_application_shape_hash %i32
    substitution_trace_shape_hash %i32
    substituted_target_type_shape_hash %i32
    substituted_trait_application_shape_hash %i32
    substitution_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind: substitution shape producer の拒否理由
//:
//: [目的/もくてき]:
//: - binder evidence、type argument identity、pre-substitution shape、trace shape、substituted shape、derived hash のどこで拒否したかを typed enum として保持します。
pub enum SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind:
    BinderEvidenceSchemaPlaceholder
    BinderEvidenceHashPlaceholder
    GenericParameterCountMissing
    TypeParameterBoundCountNegative
    TypeArgumentCountNegative
    TypeArgumentCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    TypeArgumentIdentitySchemaPlaceholder
    TypeArgumentIdentityHashPlaceholder
    PreSubstitutionTargetTypeShapeHashMissing
    PreSubstitutionTargetTypeShapeHashPlaceholder
    PreSubstitutionTraitApplicationShapeHashMissing
    PreSubstitutionTraitApplicationShapeHashPlaceholder
    SubstitutionTraceSchemaPlaceholder
    SubstitutionTraceShapeHashPlaceholder
    SubstitutionTraceTypeParameterCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    SubstitutionTraceTypeArgumentCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    SubstitutionTraceTypeParameterBoundCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    SubstitutionTraceBinderHashMismatch
    SubstitutionTraceParameterTableShapeHashMismatch
    SubstitutionTraceBoundTableShapeHashMismatch
    SubstitutionTraceTypeArgumentIdentitySchemaPlaceholder
    SubstitutionTraceTypeArgumentIdentityHashPlaceholder
    SubstitutionTraceTypeArgumentIdentitySchemaMismatch
    SubstitutionTraceTypeArgumentIdentityHashMismatch
    SubstitutionTraceRecordCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    SubstitutedTargetTypeShapeHashMissing
    SubstitutedTargetTypeShapeHashPlaceholder
    SubstitutedTraitApplicationShapeHashMissing
    SubstitutedTraitApplicationShapeHashPlaceholder
    DerivedSubstitutionShapeHashPlaceholder

//: SelfhostMemoTraitPublicImplGenericSubstitutionShapeStage0Summary: substitution shape smoke の代表結果
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionShapeStage0Summary:
    accepted %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    monomorphic_rejected %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    type_argument_mismatch %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    identity_placeholder %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    pre_target_missing %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    trace_placeholder %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind
    substituted_trait_placeholder %Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind

