//: selfhost_memo_trait_public_impl_generic_substitution_shape_evidence_result: generic substitution shape evidence を[作/つく]る
//:
//: [契約/けいやく]:
//: - binder evidence と type argument count を照合してから、input / trace / output shape を検査します。
//: - success は actual substitution の完全証明や operation candidate 生成ではありません。後続の actual engine はこの evidence の trace shape と output shape が、実際の typed substitution result から来たことをより強く証明します。
pub fn selfhost_memo_trait_public_impl_generic_substitution_shape_evidence_result %fn SelfhostMemoTraitPublicImplGenericSubstitutionShapeInput Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind \input:
    if:
        lt input.type_argument_count 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentCountNegative
        else:
            if:
                not eq input.generic_binder_evidence.type_parameter_count input.type_argument_count
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionShapeErrorKind::TypeArgumentCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new input.generic_binder_evidence.type_parameter_count input.type_argument_count
                else:
                    match selfhost_memo_trait_public_impl_generic_substitution_shape_binder_hash_result input.generic_binder_evidence:
                        Result::Ok binder_hash:
                            match selfhost_memo_trait_public_impl_generic_substitution_shape_type_argument_identity_result input.type_argument_identity_hash:
                                Result::Ok type_argument_hash:
