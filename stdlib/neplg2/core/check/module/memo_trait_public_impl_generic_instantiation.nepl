//: selfhost_memo_trait_public_impl_generic_instantiation_binder_hash_result: binder evidence hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_binder_hash_result %fn SelfhostMemoTraitPublicImplGenericBinderEvidence Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \evidence:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceSchemaPlaceholder
        else:
            if:
                eq evidence.shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceHashPlaceholder
                else:
                    Result::Ok evidence.shape_hash

