//: selfhost_memo_trait_public_impl_generic_instantiation_no_bounds_hash_result: bound なし case の solution hash を[作/つく]る
fn selfhost_memo_trait_public_impl_generic_instantiation_no_bounds_hash_result %fn void Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \void:
    let hash %i32 selfhost_memo_trait_public_impl_generic_instantiation_mix4 491101 selfhost_memo_trait_public_impl_generic_instantiation_schema_version 0 0
    if:
        eq hash 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::DerivedBoundSolutionShapeHashPlaceholder
