//: selfhost_memo_trait_public_impl_generic_instantiation_solved_bound_hash_result: all-solved bound evidence を[検査/けんさ]して hash にする
fn selfhost_memo_trait_public_impl_generic_instantiation_solved_bound_hash_result %fn i32 fn SelfhostMemoTraitPublicImplGenericBoundSolvingEvidence Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \expected_bound_count\evidence:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingSchemaPlaceholder
        else:
            if:
                not eq evidence.solved_bound_count expected_bound_count
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new expected_bound_count evidence.solved_bound_count
                else:
                    if:
                        eq evidence.solver_policy_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingPolicyHashPlaceholder
                        else:
                            if:
                                eq evidence.proof_shape_hash 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingProofShapeHashPlaceholder
                                else:
                                    let hash %i32 selfhost_memo_trait_public_impl_generic_instantiation_mix4 491201 evidence.schema_version evidence.solved_bound_count selfhost_memo_trait_public_impl_generic_instantiation_mix2 evidence.solver_policy_hash evidence.proof_shape_hash
                                    if:
                                        eq hash 0
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::DerivedBoundSolutionShapeHashPlaceholder
                                        else:
                                            Result::Ok hash

//: selfhost_memo_trait_public_impl_generic_instantiation_bound_solution_hash_result: bound solving status を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_bound_solution_hash_result %fn i32 fn SelfhostMemoTraitPublicImplGenericBoundSolvingStatus Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \expected_bound_count\status:
    if:
        lt expected_bound_count 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundCountNegative
        else:
            match status:
                SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::NoBounds:
                    if:
                        eq expected_bound_count 0
                        then:
                            selfhost_memo_trait_public_impl_generic_instantiation_no_bounds_hash_result
                        else:
                            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingRequired
                SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::AllSolved evidence:
                    if:
                        eq expected_bound_count 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingUnexpected
                        else:
                            selfhost_memo_trait_public_impl_generic_instantiation_solved_bound_hash_result expected_bound_count evidence
                SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::Unsolved first_unsolved:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BoundSolvingUnsolved first_unsolved

//: selfhost_memo_trait_public_impl_generic_instantiation_evidence_result: generic instantiation evidence を[作/つく]る
//:
//: [契約/けいやく]:
//: - binder evidence、type argument identity、substituted target / trait shape、bound solution hash を全て検査してから success を返します。
//: - success は operation candidate 生成ではありません。materializer accepted path への接続は、後続 slice がこの evidence を record に含める形で行います。
pub fn selfhost_memo_trait_public_impl_generic_instantiation_evidence_result %fn SelfhostMemoTraitPublicImplGenericInstantiationInput Result SelfhostMemoTraitPublicImplGenericInstantiationEvidence SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \input:
    if:
        lt input.type_argument_count 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentCountNegative
        else:
            if:
                not eq input.generic_binder_evidence.type_parameter_count input.type_argument_count
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new input.generic_binder_evidence.type_parameter_count input.type_argument_count
                else:
                    match selfhost_memo_trait_public_impl_generic_instantiation_binder_hash_result input.generic_binder_evidence:
                        Result::Ok binder_hash:
                            match selfhost_memo_trait_public_impl_generic_instantiation_type_argument_identity_result input.type_argument_identity_hash:
                                Result::Ok type_argument_hash:
                                    match selfhost_memo_trait_public_impl_generic_instantiation_target_shape_result input.substituted_target_type_shape_hash:
                                        Result::Ok target_hash:
                                            match selfhost_memo_trait_public_impl_generic_instantiation_trait_shape_result input.substituted_trait_application_shape_hash:
                                                Result::Ok trait_hash:
                                                    match selfhost_memo_trait_public_impl_generic_instantiation_bound_solution_hash_result input.generic_binder_evidence.type_parameter_bound_count input.bound_solving_status:
                                                        Result::Ok bound_hash:
                                                            let schema %i32 selfhost_memo_trait_public_impl_generic_instantiation_schema_version
                                                            let type_argument_material %i32 selfhost_memo_trait_public_impl_generic_instantiation_mix2 type_argument_hash.schema_version type_argument_hash.identity_hash
