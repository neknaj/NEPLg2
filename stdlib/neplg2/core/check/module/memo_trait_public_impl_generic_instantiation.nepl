//: selfhost_memo_trait_public_impl_generic_bound_solving_evidence_schema_version: bound solving evidence schema
//:
//: [契約/けいやく]:
//: - `AllSolved` status に含まれる public constructible evidence は、この schema と一致しなければ accepted authority になりません。
//: - bound solver と materializer connector はこの helper を共有し、nonzero だけを根拠にしません。
pub fn selfhost_memo_trait_public_impl_generic_bound_solving_evidence_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_impl_generic_bound_solving_evidence_new: bound solving evidence を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_bound_solving_evidence_new %fn i32 fn i32 fn i32 fn i32 SelfhostMemoTraitPublicImplGenericBoundSolvingEvidence \schema_version\solved_bound_count\solver_policy_hash\proof_shape_hash:
    SelfhostMemoTraitPublicImplGenericBoundSolvingEvidence schema_version solved_bound_count solver_policy_hash proof_shape_hash

//: selfhost_memo_trait_public_impl_generic_bound_solving_no_bounds: bound なし status を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_bound_solving_no_bounds %fn void SelfhostMemoTraitPublicImplGenericBoundSolvingStatus \void:
    SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::NoBounds

//: selfhost_memo_trait_public_impl_generic_bound_solving_all_solved: all-solved status を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_bound_solving_all_solved %fn SelfhostMemoTraitPublicImplGenericBoundSolvingEvidence SelfhostMemoTraitPublicImplGenericBoundSolvingStatus \evidence:
    SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::AllSolved evidence

//: selfhost_memo_trait_public_impl_generic_bound_solving_unsolved: 未解決 bound status を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_bound_solving_unsolved %fn i32 SelfhostMemoTraitPublicImplGenericBoundSolvingStatus \first_unsolved_bound_ordinal:
    SelfhostMemoTraitPublicImplGenericBoundSolvingStatus::Unsolved first_unsolved_bound_ordinal

//: selfhost_memo_trait_public_impl_generic_instantiation_input_new: instantiation gate input を[作/つく]る
//:
//: [契約/けいやく]:
//: - substitution 後の target / trait application shape は、raw hash ではなく substitution shape evidence として渡します。
//: - constructor は field をまとめるだけです。binder、type argument identity、substitution evidence、bound solving status の整合性は `selfhost_memo_trait_public_impl_generic_instantiation_evidence_result` が検査します。
pub fn selfhost_memo_trait_public_impl_generic_instantiation_input_new %fn SelfhostMemoTraitPublicImplGenericBinderEvidence fn i32 fn SelfhostMemoTraitStableTypeArgumentIdentityHash fn SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence fn SelfhostMemoTraitPublicImplGenericBoundSolvingStatus SelfhostMemoTraitPublicImplGenericInstantiationInput \generic_binder_evidence\type_argument_count\type_argument_identity_hash\substitution_shape_evidence\bound_solving_status:
    SelfhostMemoTraitPublicImplGenericInstantiationInput generic_binder_evidence type_argument_count type_argument_identity_hash substitution_shape_evidence bound_solving_status

//: selfhost_memo_trait_public_impl_generic_instantiation_schema_version: instantiation evidence schema
pub fn selfhost_memo_trait_public_impl_generic_instantiation_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_impl_generic_instantiation_mix2: generic instantiation hash 用に 2 値を[混/ま]ぜる
fn selfhost_memo_trait_public_impl_generic_instantiation_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_impl_generic_instantiation_mix4: generic instantiation hash 用に 4 値を[混/ま]ぜる
fn selfhost_memo_trait_public_impl_generic_instantiation_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_impl_generic_instantiation_mix2 (selfhost_memo_trait_public_impl_generic_instantiation_mix2 a b) (selfhost_memo_trait_public_impl_generic_instantiation_mix2 c d)

//: selfhost_memo_trait_public_impl_generic_instantiation_binder_hash_result: binder evidence hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_binder_hash_result %fn SelfhostMemoTraitPublicImplGenericBinderEvidence Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \evidence:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceSchemaPlaceholder
        else:
            if:
                eq evidence.parameter_table_shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceParameterTableHashPlaceholder
                else:
                    if:
                        eq evidence.bound_table_shape_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceBoundTableHashPlaceholder
                        else:
                            if:
                                eq evidence.shape_hash 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::BinderEvidenceHashPlaceholder
                                else:
                                    Result::Ok evidence.shape_hash

//: selfhost_memo_trait_public_impl_generic_instantiation_type_argument_identity_result: type argument identity hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_type_argument_identity_result %fn SelfhostMemoTraitStableTypeArgumentIdentityHash Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \hash:
    if:
        eq hash.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentIdentitySchemaPlaceholder
        else:
            if:
                eq hash.identity_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentIdentityHashPlaceholder
                else:
                    Result::Ok hash

//: selfhost_memo_trait_public_impl_generic_instantiation_substitution_shape_final_result: substitution shape evidence の最終 hash を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - caller が個別 component を検査したあと、substituted trait application shape と root hash の再計算を最後に行います。
//: - public constructible evidence の `substitution_shape_hash` は、それ単体では authority になりません。producer module の deterministic helper で field から再計算し、一致した場合だけ受理します。
fn selfhost_memo_trait_public_impl_generic_instantiation_substitution_shape_final_result %fn SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence Result SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \evidence:
    if:
        eq evidence.substituted_trait_application_shape_hash 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::SubstitutionShapeTraitApplicationShapeHashPlaceholder
        else:
            let recomputed_shape_hash %i32 selfhost_memo_trait_public_impl_generic_substitution_shape_evidence_hash evidence
            if:
                not eq recomputed_shape_hash evidence.substitution_shape_hash
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::SubstitutionShapeHashMismatch
                else:
                    Result::Ok evidence

//: selfhost_memo_trait_public_impl_generic_instantiation_substitution_shape_result: substitution shape evidence を[検査/けんさ]する
//:
