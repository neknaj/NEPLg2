fn selfhost_memo_trait_public_impl_generic_instantiation_type_argument_identity_result %fn SelfhostMemoTraitStableTypeArgumentIdentityHash Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \hash:
    if:
        eq hash.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentIdentitySchemaPlaceholder
        else:
            if:
                eq hash.identity_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::TypeArgumentIdentityHashPlaceholder
                else:
                    Result::Ok hash

//: selfhost_memo_trait_public_impl_generic_instantiation_target_shape_result: substituted target type shape hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_target_shape_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \hash:
    match hash:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::SubstitutedTargetTypeShapeHashPlaceholder
                else:
                    Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitPublicImplGenericInstantiationErrorKind::SubstitutedTargetTypeShapeHashMissing

//: selfhost_memo_trait_public_impl_generic_instantiation_trait_shape_result: substituted trait application shape hash を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_instantiation_trait_shape_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplGenericInstantiationErrorKind \hash:
    match hash:
