    let missing_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectBackendReadinessOrchestratorErrorKind selfhost_memo_trait_operation_private_effect_backend_readiness_count_from_mask_evidence_result request_root fingerprint accepted_gate_result selfhost_memo_trait_operation_private_effect_backend_readiness_stage0_mask_result request_root fingerprint SelfhostMemoTraitOperationPrivateEffectMaskStatus::Missing 1
    let unknown_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectBackendReadinessOrchestratorErrorKind selfhost_memo_trait_operation_private_effect_backend_readiness_count_from_mask_evidence_result request_root fingerprint accepted_gate_result selfhost_memo_trait_operation_private_effect_backend_readiness_stage0_mask_result request_root fingerprint SelfhostMemoTraitOperationPrivateEffectMaskStatus::Unknown 1
    let identity_mismatch_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectBackendReadinessOrchestratorErrorKind selfhost_memo_trait_operation_private_effect_backend_readiness_count_from_mask_evidence_result mismatched_request_root fingerprint accepted_gate_result selfhost_memo_trait_operation_private_effect_backend_readiness_stage0_mask_result request_root fingerprint SelfhostMemoTraitOperationPrivateEffectMaskStatus::Proven 2
    let placeholder_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectBackendReadinessOrchestratorErrorKind selfhost_memo_trait_operation_private_effect_backend_readiness_count_from_mask_evidence_result request_root fingerprint accepted_gate_result selfhost_memo_trait_operation_private_effect_backend_readiness_stage0_mask_result request_root 0 SelfhostMemoTraitOperationPrivateEffectMaskStatus::Proven 2
    let mask_error_result %Result SelfhostMemoTraitOperationPrivateEffectMaskEvidence SelfhostMemoTraitOperationPrivateEffectMaskEvidenceErrorKind Result::Err SelfhostMemoTraitOperationPrivateEffectMaskEvidenceErrorKind::BodyModuleFingerprintPlaceholder
