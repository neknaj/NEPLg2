    Result::Ok SelfhostMemoTraitOperationPrivateEffectBackendReadinessOrchestratorStage0Summary accepted_count refuted_rejected missing_rejected unknown_rejected identity_mismatch_rejected placeholder_rejected mask_error_rejected
