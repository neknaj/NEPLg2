        Result::Ok _unit:
            selfhost_memo_trait_public_impl_scanner_unmatched_loop ast records 0 selfhost_memo_trait_public_impl_scanner_resolver_record_table_len records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_public_impl_scanner_result: AST と resolver record table を[照合/しょうごう]し output owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `ast` と `records` は borrow です。この関数は閉じません。
//: - success の場合だけ caller が output owner を受け取ります。
//: - failure の場合、内部で作った partial output owner はこの module が閉じます。
//: - output owner を作る前に module 全体の ordinal alignment を検査し、余剰 resolver record と invalid header が混在する場合も alignment error を先に返します。
pub fn selfhost_memo_trait_public_impl_scanner_result %impure fn &SelfhostModuleAst impure fn &SelfhostMemoTraitPublicImplScannerResolverRecordTable Result SelfhostMemoTraitPublicImplScannerOutput SelfhostMemoTraitPublicImplScannerErrorKind \ast\records:
    match selfhost_memo_trait_public_impl_scanner_alignment_result ast records:
        Result::Ok _unit:
            match selfhost_memo_trait_public_impl_scanner_output_new_result:
                Result::Ok state0:
                    selfhost_memo_trait_public_impl_scanner_scan_loop ast records state0 0 selfhost_module_ast_len ast 0
                Result::Err setup_error:
                    Result::Err setup_error
        Result::Err alignment_error:
            Result::Err alignment_error

