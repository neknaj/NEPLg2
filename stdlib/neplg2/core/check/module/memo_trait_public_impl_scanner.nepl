#indent 4

//: # check/module/memo_trait_public_impl_scanner
//: public `impl` item と resolver-owned typed impl record を public declaration ordinal で[対応/たいおう]させる checker-layer module です。
//:
//: [目的/もくてき]:
//: - parser が作った `SelfhostModuleAst` には `ImplDecl` と declaration header / body range だけがあり、target type、trait application、method body root、operation trait source は含まれません。
//: - この module は AST から意味を復元せず、別の resolver / lowering stage が作った typed impl record と public `ImplDecl` の存在だけを照合します。
//: - 照合済み record から、operation materializer が読む `SelfhostMemoTraitOperationPublicImplMaterializerRecordTable` と、public surface normalizer が読む `SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence` vector を同時に作ります。
//:
//: [契約/けいやく]:
//: - pairing key は 1-origin の public declaration ordinal です。AST index は error payload の位置情報にだけ使い、hash / proof / operation authority には使いません。
//: - public declaration ordinal は public declaration item だけを source order で数えます。private declaration は ordinal を消費しません。
//: - public `ImplDecl` 1 件につき typed resolver record がちょうど 1 件必要です。0 件は `TypedRecordMissing`、2 件以上は `TypedRecordDuplicate` として拒否します。
//: - typed resolver record がどの public `ImplDecl` にも対応しない場合は `TypedRecordUnmatched` として拒否します。first-wins や余剰 record の黙殺はしません。
//: - ordinal alignment は header validation より先に module 全体で検査します。余剰 record と不正 header が同時にある場合は、対応関係が壊れていることを先に報告します。
//: - `SelfhostMemoTraitPublicImplHeaderInput` の妥当性、inherent impl / generic impl / bound count / placeholder hash の拒否は `memo_trait_public_impl_header` に委譲します。
//: - operation kind はこの module では確定しません。typed record の trait source は operation materializer へ渡し、既存 classifier が shape-bound evidence として operation を決めます。
//: - source text、span、lexeme、display name、diagnostic text、module path、method name string、trait name string から target / trait / operation / HIR root を推測しません。
//: - HIR lowering、method body purity check、Drop Resource proof、operation impl candidate builder、operation evidence producer、aggregate proof status、proof store、backend artifact はこの module の責務ではありません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では resolver-owned record table を caller supplied typed table として受け取ります。actual parser / type resolver からこの table を作る stage は後続 slice です。
//: - full public surface composer はまだ未接続です。この module は composer が必要とする public impl declaration evidence vector と operation materializer input table を返す境界を固定します。
//:
//: [計算量/けいさんりょう]:
//: - AST item 数を n、typed record 数を m とすると、現在の照合は public impl ごとに record table を線形走査し、さらに余剰 record 検査でも AST を線形走査するため O(n * m) 時間です。
//: - この探索は semantic boundary を固定するための Phase 1 実装です。public API、error enum、owner contract を保ったまま、後続で ordinal sorted index または ordinal bucket へ置換できます。
//: - output push は Vec の償却 O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_header" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_scanner" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_public_impl_scanner_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_public_impl_scanner_accepted_len_eq summary.accepted 1 1
//:             let checks2 checks_push checks1 check selfhost_memo_trait_public_impl_scanner_accepted_public_ordinal_eq summary.accepted 2
//:             let checks3 checks_push checks2 check selfhost_memo_trait_public_impl_scanner_accepted_method_root_present summary.accepted
//:             let checks4 checks_push checks3 check selfhost_memo_trait_public_impl_scanner_error_ordinal_eq summary.missing_typed_record SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing 1
//:             let checks5 checks_push checks4 check selfhost_memo_trait_public_impl_scanner_error_ordinal_eq summary.duplicate_typed_record SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate 1
//:             let checks6 checks_push checks5 check selfhost_memo_trait_public_impl_scanner_error_ordinal_eq summary.unmatched_typed_record SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched 1
//:             let checks7 checks_push checks6 check selfhost_memo_trait_public_impl_scanner_error_header_eq summary.inherent_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::InherentImplUnsupported
//:             let checks8 checks_push checks7 check selfhost_memo_trait_public_impl_scanner_error_ordinal_eq summary.mixed_alignment_first SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched 2
//:             let shown checks_print_report checks8
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "public impl scanner stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "./memo_trait_operation_classifier" as *
#import "./memo_trait_operation_public_impl_materializer" as *
#import "./memo_trait_public_impl_header" as *
#import "./memo_trait_public_surface_normalizer" as *

//: SelfhostMemoTraitPublicImplScannerResolverRecord: resolver / lowering stage が作る typed public impl association record
//:
//: [契約/けいやく]:
//: - `declaration_ordinal` は AST の public declaration ordinal と照合する key です。
//: - `type_id`、target type shape、trait application shape、trait source、method body root は上流 resolver が typed evidence として決めた値です。この module は source から再計算しません。
pub struct SelfhostMemoTraitPublicImplScannerResolverRecord:
    type_id %SelfhostTypeId
    module_fingerprint %i32
    declaration_ordinal %Option i32
    visibility %SelfhostModuleDeclarationVisibility
    impl_kind %SelfhostMemoTraitPublicImplHeaderKind
    target_type_shape_hash %Option i32
    trait_source %SelfhostMemoTraitOperationSourceIdentity
    trait_type_argument_count %i32
    trait_application_shape_hash %Option i32
    type_parameter_count %i32
    type_parameter_bound_count %i32
    method_body_root %Option SelfhostHirExprId
    fuel %i32

//: SelfhostMemoTraitPublicImplScannerResolverRecordTable: typed resolver record の owner table
pub struct SelfhostMemoTraitPublicImplScannerResolverRecordTable:
    records %Vec SelfhostMemoTraitPublicImplScannerResolverRecord

//: SelfhostMemoTraitPublicImplScannerOutput: scanner が返す 2 系統の typed output owner
//:
//: [契約/けいやく]:
//: - `operation_records` は operation materializer へ渡す owner table です。
//: - `public_declarations` は public surface normalizer へ渡す declaration evidence vector です。
//: - caller は不要になったら `selfhost_memo_trait_public_impl_scanner_output_free` で両方の owner を閉じます。
pub struct SelfhostMemoTraitPublicImplScannerOutput:
    operation_records %SelfhostMemoTraitOperationPublicImplMaterializerRecordTable
    public_declarations %Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence

//: SelfhostMemoTraitPublicImplScannerAcceptedSummary: stage0 accepted path の owner-free summary
pub struct SelfhostMemoTraitPublicImplScannerAcceptedSummary:
    operation_record_len %i32
    public_declaration_len %i32
    public_impl_ordinal %i32
    method_root_present %bool

//: SelfhostMemoTraitPublicImplScannerErrorKindCode: doctest 用の stable error 分類 code
pub enum SelfhostMemoTraitPublicImplScannerErrorKindCode:
    TypedRecordMissing
    TypedRecordDuplicate
    TypedRecordUnmatched
    HeaderRejected
    Other

//: SelfhostMemoTraitPublicImplScannerErrorKind: public impl scanner の拒否理由
//:
//: [目的/もくてき]:
//: - AST / resolver alignment、owner allocation / push、header producer rejection を typed enum として分けます。
pub enum SelfhostMemoTraitPublicImplScannerErrorKind:
    ResolverRecordTableAllocFailed %StdErrorKind
    ResolverRecordPushFailed %StdErrorKind
    OperationRecordTableAllocFailed %StdErrorKind
    PublicDeclarationVectorAllocFailed %StdErrorKind
    OperationRecordPushRejected %SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    PublicDeclarationPushFailed %StdErrorKind
    AstItemUnavailable %i32
    DeclarationHeaderMissing %i32
    DeclarationKindMismatch %i32
    TypedRecordMissing %i32
    TypedRecordDuplicate %i32
    TypedRecordUnmatched %i32
    HeaderRejected %SelfhostMemoTraitPublicImplHeaderErrorKind

//: SelfhostMemoTraitPublicImplScannerStage0Summary: scanner smoke の代表結果
pub struct SelfhostMemoTraitPublicImplScannerStage0Summary:
    accepted %Result SelfhostMemoTraitPublicImplScannerAcceptedSummary SelfhostMemoTraitPublicImplScannerErrorKind
    missing_typed_record %Result i32 SelfhostMemoTraitPublicImplScannerErrorKind
    duplicate_typed_record %Result i32 SelfhostMemoTraitPublicImplScannerErrorKind
    unmatched_typed_record %Result i32 SelfhostMemoTraitPublicImplScannerErrorKind
    inherent_rejected %Result i32 SelfhostMemoTraitPublicImplScannerErrorKind
    mixed_alignment_first %Result i32 SelfhostMemoTraitPublicImplScannerErrorKind

impl Clone for SelfhostMemoTraitPublicImplScannerResolverRecord:
    fn clone %fn &SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitPublicImplScannerResolverRecord \self:
        *self

impl Copy for SelfhostMemoTraitPublicImplScannerResolverRecord:
    fn copy_mark %fn SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitPublicImplScannerResolverRecord \self:
        self

impl Clone for SelfhostMemoTraitPublicImplScannerAcceptedSummary:
    fn clone %fn &SelfhostMemoTraitPublicImplScannerAcceptedSummary SelfhostMemoTraitPublicImplScannerAcceptedSummary \self:
        *self

impl Copy for SelfhostMemoTraitPublicImplScannerAcceptedSummary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplScannerAcceptedSummary SelfhostMemoTraitPublicImplScannerAcceptedSummary \self:
        self

impl Clone for SelfhostMemoTraitPublicImplScannerErrorKindCode:
    fn clone %fn &SelfhostMemoTraitPublicImplScannerErrorKindCode SelfhostMemoTraitPublicImplScannerErrorKindCode \self:
        *self

impl Copy for SelfhostMemoTraitPublicImplScannerErrorKindCode:
    fn copy_mark %fn SelfhostMemoTraitPublicImplScannerErrorKindCode SelfhostMemoTraitPublicImplScannerErrorKindCode \self:
        self

impl Clone for SelfhostMemoTraitPublicImplScannerErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicImplScannerErrorKind SelfhostMemoTraitPublicImplScannerErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicImplScannerErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicImplScannerErrorKind SelfhostMemoTraitPublicImplScannerErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicImplScannerStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicImplScannerStage0Summary SelfhostMemoTraitPublicImplScannerStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitPublicImplScannerStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplScannerStage0Summary SelfhostMemoTraitPublicImplScannerStage0Summary \self:
        self

//: selfhost_memo_trait_public_impl_scanner_resolver_record_new: typed resolver record を[作/つく]る
pub fn selfhost_memo_trait_public_impl_scanner_resolver_record_new %fn SelfhostTypeId fn i32 fn Option i32 fn SelfhostModuleDeclarationVisibility fn SelfhostMemoTraitPublicImplHeaderKind fn Option i32 fn SelfhostMemoTraitOperationSourceIdentity fn i32 fn Option i32 fn i32 fn i32 fn Option SelfhostHirExprId fn i32 SelfhostMemoTraitPublicImplScannerResolverRecord \type_id\module_fingerprint\declaration_ordinal\visibility\impl_kind\target_type_shape_hash\trait_source\trait_type_argument_count\trait_application_shape_hash\type_parameter_count\type_parameter_bound_count\method_body_root\fuel:
    SelfhostMemoTraitPublicImplScannerResolverRecord type_id module_fingerprint declaration_ordinal visibility impl_kind target_type_shape_hash trait_source trait_type_argument_count trait_application_shape_hash type_parameter_count type_parameter_bound_count method_body_root fuel

//: selfhost_memo_trait_public_impl_scanner_resolver_record_table_new: [空/から]の resolver record table を[作/つく]る
pub fn selfhost_memo_trait_public_impl_scanner_resolver_record_table_new %impure fn void Result SelfhostMemoTraitPublicImplScannerResolverRecordTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitPublicImplScannerResolverRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitPublicImplScannerResolverRecordTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_public_impl_scanner_resolver_record_table_free: resolver record table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_public_impl_scanner_resolver_record_table_free %impure fn SelfhostMemoTraitPublicImplScannerResolverRecordTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_public_impl_scanner_resolver_record_table_len: resolver record 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_scanner_resolver_record_table_len %fn &SelfhostMemoTraitPublicImplScannerResolverRecordTable i32 \table:
    let records %&Vec SelfhostMemoTraitPublicImplScannerResolverRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_public_impl_scanner_resolver_record_table_push: resolver record を table へ[追加/ついか]する
pub fn selfhost_memo_trait_public_impl_scanner_resolver_record_table_push %impure fn SelfhostMemoTraitPublicImplScannerResolverRecordTable impure fn SelfhostMemoTraitPublicImplScannerResolverRecord Result SelfhostMemoTraitPublicImplScannerResolverRecordTable SelfhostMemoTraitPublicImplScannerErrorKind \table\record:
    let records %Vec SelfhostMemoTraitPublicImplScannerResolverRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitPublicImplScannerResolverRecordTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::ResolverRecordPushFailed error

//: selfhost_memo_trait_public_impl_scanner_output_free: scanner output の owner を[閉/と]じる
pub fn selfhost_memo_trait_public_impl_scanner_output_free %impure fn SelfhostMemoTraitPublicImplScannerOutput unit \output:
    selfhost_memo_trait_operation_public_impl_materializer_record_table_free field::get output "operation_records"
    v::free field::get output "public_declarations"

//: selfhost_memo_trait_public_impl_scanner_output_operation_len: operation materializer record 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_scanner_output_operation_len %fn &SelfhostMemoTraitPublicImplScannerOutput i32 \output:
    selfhost_memo_trait_operation_public_impl_materializer_record_table_len field::get_ref output "operation_records"

//: selfhost_memo_trait_public_impl_scanner_output_declaration_len: public declaration evidence 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_scanner_output_declaration_len %fn &SelfhostMemoTraitPublicImplScannerOutput i32 \output:
    let declarations %&Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get_ref output "public_declarations"
    v::len declarations

//: selfhost_memo_trait_public_impl_scanner_state_free: build state を error path で[閉/と]じる
fn selfhost_memo_trait_public_impl_scanner_state_free %impure fn SelfhostMemoTraitPublicImplScannerOutput unit \state:
    selfhost_memo_trait_public_impl_scanner_output_free state

//: selfhost_memo_trait_public_impl_scanner_output_new_result: empty output owner を[作/つく]る
fn selfhost_memo_trait_public_impl_scanner_output_new_result %impure fn void Result SelfhostMemoTraitPublicImplScannerOutput SelfhostMemoTraitPublicImplScannerErrorKind \void:
    match selfhost_memo_trait_operation_public_impl_materializer_record_table_new:
        Result::Ok operation_records:
            let declarations_result %Result Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence StdErrorKind v::new
            match declarations_result:
                Result::Ok declarations:
                    Result::Ok SelfhostMemoTraitPublicImplScannerOutput operation_records declarations
                Result::Err e:
                    selfhost_memo_trait_operation_public_impl_materializer_record_table_free operation_records
                    Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::PublicDeclarationVectorAllocFailed e
        Result::Err e:
            Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::OperationRecordTableAllocFailed e

//: selfhost_memo_trait_public_impl_scanner_header_input: resolver record から public impl header input を[作/つく]る
fn selfhost_memo_trait_public_impl_scanner_header_input %fn SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitPublicImplHeaderInput \record:
    selfhost_memo_trait_public_impl_header_input_new record.visibility record.module_fingerprint record.declaration_ordinal record.impl_kind record.target_type_shape_hash record.trait_application_shape_hash record.type_parameter_count record.type_parameter_bound_count selfhost_memo_trait_public_impl_header_monomorphic_binder_evidence

//: selfhost_memo_trait_public_impl_scanner_operation_record: resolver record から operation materializer record を[作/つく]る
fn selfhost_memo_trait_public_impl_scanner_operation_record %fn SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitOperationPublicImplMaterializerRecord \record:
    selfhost_memo_trait_operation_public_impl_materializer_record_new record.type_id record.module_fingerprint record.declaration_ordinal record.visibility record.impl_kind record.target_type_shape_hash record.trait_source record.trait_type_argument_count record.trait_application_shape_hash record.type_parameter_count record.type_parameter_bound_count selfhost_memo_trait_public_impl_header_monomorphic_binder_evidence record.method_body_root record.fuel

//: selfhost_memo_trait_public_impl_scanner_declaration_kind_eq: declaration kind が同じか[返/かえ]す
//:
//: [目的/もくてき]:
//: - declaration header と item kind の対応を bool や整数 code に潰さず、enum の網羅的 match で確認します。
fn selfhost_memo_trait_public_impl_scanner_declaration_kind_eq %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationKind bool \a\b:
    match a:
        SelfhostModuleDeclarationKind::Function:
            match b:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match b:
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match b:
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match b:
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match b:
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    true

//: selfhost_memo_trait_public_impl_scanner_record_ordinal_matches: resolver record が ordinal に対応するか[返/かえ]す
fn selfhost_memo_trait_public_impl_scanner_record_ordinal_matches %fn SelfhostMemoTraitPublicImplScannerResolverRecord fn i32 bool \record\ordinal:
    match record.declaration_ordinal:
        Option::Some value:
            eq value ordinal
        Option::None:
            false

//: selfhost_memo_trait_public_impl_scanner_find_record_loop: ordinal に対応する resolver record を[探/さが]す
fn selfhost_memo_trait_public_impl_scanner_find_record_loop %fn &SelfhostMemoTraitPublicImplScannerResolverRecordTable fn i32 fn i32 fn i32 fn Option SelfhostMemoTraitPublicImplScannerResolverRecord Result Option SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitPublicImplScannerErrorKind \records\ordinal\idx\n\found:
    if:
        ge idx n
        then:
            Result::Ok found
        else:
            let source_records %&Vec SelfhostMemoTraitPublicImplScannerResolverRecord field::get_ref records "records"
            match v::get source_records idx:
                Option::Some record:
                    if:
                        selfhost_memo_trait_public_impl_scanner_record_ordinal_matches record ordinal
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::TypedRecordDuplicate ordinal
                                Option::None:
                                    selfhost_memo_trait_public_impl_scanner_find_record_loop records ordinal add idx 1 n some record
                        else:
                            selfhost_memo_trait_public_impl_scanner_find_record_loop records ordinal add idx 1 n found
                Option::None:
                    Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::TypedRecordUnmatched ordinal

//: selfhost_memo_trait_public_impl_scanner_find_record_result: ordinal に対応する resolver record を 1 件だけ[返/かえ]す
fn selfhost_memo_trait_public_impl_scanner_find_record_result %fn &SelfhostMemoTraitPublicImplScannerResolverRecordTable fn i32 Result SelfhostMemoTraitPublicImplScannerResolverRecord SelfhostMemoTraitPublicImplScannerErrorKind \records\ordinal:
    match selfhost_memo_trait_public_impl_scanner_find_record_loop records ordinal 0 selfhost_memo_trait_public_impl_scanner_resolver_record_table_len records none:
        Result::Ok found:
            match found:
                Option::Some record:
                    Result::Ok record
                Option::None:
                    Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::TypedRecordMissing ordinal
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_public_impl_scanner_push_output_result: accepted record を 2 系統の output owner へ[追加/ついか]する
fn selfhost_memo_trait_public_impl_scanner_push_output_result %impure fn SelfhostMemoTraitPublicImplScannerOutput impure fn SelfhostMemoTraitPublicImplScannerResolverRecord impure fn SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence Result SelfhostMemoTraitPublicImplScannerOutput SelfhostMemoTraitPublicImplScannerErrorKind \state\record\evidence:
    let operation_records %SelfhostMemoTraitOperationPublicImplMaterializerRecordTable field::get state "operation_records"
    let declarations %Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get state "public_declarations"
    let operation_record %SelfhostMemoTraitOperationPublicImplMaterializerRecord selfhost_memo_trait_public_impl_scanner_operation_record record
    match selfhost_memo_trait_operation_public_impl_materializer_record_table_push operation_records operation_record:
        Result::Ok next_operation_records:
            match v::push declarations evidence:
                Result::Ok next_declarations:
                    Result::Ok SelfhostMemoTraitPublicImplScannerOutput next_operation_records next_declarations
                Result::Err e:
                    let error %StdErrorKind field::get e "error"
                    v::free v::vec_push_error_vec e
                    selfhost_memo_trait_operation_public_impl_materializer_record_table_free next_operation_records
                    Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::PublicDeclarationPushFailed error
        Result::Err operation_error:
            v::free declarations
            Result::Err SelfhostMemoTraitPublicImplScannerErrorKind::OperationRecordPushRejected operation_error

