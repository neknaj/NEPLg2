//: selfhost_memo_trait_public_impl_scanner_error_kind_code_eq: error code が同じか[返/かえ]す
fn selfhost_memo_trait_public_impl_scanner_error_kind_code_eq %fn SelfhostMemoTraitPublicImplScannerErrorKindCode fn SelfhostMemoTraitPublicImplScannerErrorKindCode bool \a\b:
    match a:
        SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
            match b:
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
                    true
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
                    false
        SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
            match b:
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
                    true
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
                    false
        SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
            match b:
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
                    true
                SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
                    false
        SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
            match b:
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
                    true
                SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
                    false
        SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
            match b:
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordMissing:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordDuplicate:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::TypedRecordUnmatched:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::HeaderRejected:
                    false
                SelfhostMemoTraitPublicImplScannerErrorKindCode::Other:
                    true

//: selfhost_memo_trait_public_impl_scanner_error_ordinal_eq: result error が期待 code / ordinal か[返/かえ]す
pub fn selfhost_memo_trait_public_impl_scanner_error_ordinal_eq %fn Result i32 SelfhostMemoTraitPublicImplScannerErrorKind fn SelfhostMemoTraitPublicImplScannerErrorKindCode fn i32 bool \result\expected_code\expected_ordinal:
    match result:
        Result::Ok _value:
            false
