#indent 4

//: # check/module/memo_trait_operation_method_body_fact_table_inputs
//: public surface から得られた method body HIR root の typed input 列を、complete surface 用の method body fact table へ[一括/いっかつ]で[投入/とうにゅう]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface orchestration が作る予定の `SelfhostTypeId`、operation kind、HIR root、fuel の列を、既存の `memo_trait_operation_method_body_fact_table_builder` へ順番に渡します。
//: - 1 件単位の destructive builder と、複数候補を扱う full orchestration の間に owner boundary を置き、input read failure、builder rejection、owner cleanup の位置を typed enum と契約で固定します。
//: - public surface scanner、trait operation classifier、purity gate、operation impl candidate table をこの module に混ぜず、DAG 上の責務を「typed input 列の反復投入」に限定します。
//:
//: [契約/けいやく]:
//: - `SelfhostMemoTraitOperationMethodBodyFactBuildInput` は、すでに上流が型付きで決定した build input です。この module は source text、span、lexeme、display name、diagnostic text、module path から operation や root を推測しません。
//: - `selfhost_memo_trait_operation_method_body_fact_table_build_from_inputs_result` は output の `SelfhostMemoTraitOperationMethodBodyTable` owner を消費します。成功時だけ、全 input を投入した table owner を返します。
//: - input table は borrow として読みます。この module は input table owner を閉じないため、caller は success / failure のあとに `selfhost_memo_trait_operation_method_body_fact_build_input_table_free` で閉じます。
//: - input read failure が起きた場合、まだ builder に渡していない output table owner はこの module が `selfhost_memo_trait_operation_method_body_table_free` で閉じ、`InputReadFailed(index)` を返します。
//: - builder rejection が起きた場合、既存 builder が output table owner の cleanup を完結させます。この module は二重解放せず、`BuilderRejected(index, nested_error)` として失敗した input index と nested typed error を保持します。
//: - error は bool や表示文字列ではなく typed enum で返します。nested builder error も失わず、effect checker / fact constructor / table push の拒否理由を後続診断へ運べます。
//: - この module は fact constructor、direct table push、duplicate lookup、surface completeness decision、method body evidence 作成、Drop evidence 作成、operation evidence record 作成、Resource IR proof、backend artifact、proof store、public surface scanning を行いません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では、上流 scanner の代わりに stage0 smoke が typed input table を組み立て、empty input、2 件投入、2 件目 builder rejection、missing root rejection を確認します。
//: - complete public surface impl candidate 群からこの input table を生成する scanner / full orchestration、Drop body effect checker、Resource IR no-escape proof、Copy / Drop / Eq / Hash pure evidence の実計算、generic impl binder、PrivateCache / PrivateState masking、prechecked artifact 接続は後続 stage の責務です。
//: - facade にはまだ re-export しません。full orchestration が public surface scanner、method body input table、Drop resolver、purity gate、operation impl table をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - input 数を m、各 HIR root から到達する expression 数を n_i、child edge 数を e_i とすると、全体は O(m + Σ(n_i + e_i)) 時間です。
//: - input table push は `Vec` push の償却 O(1) 時間です。
//: - この module は table lookup や duplicate check を行わないため、method body fact table lookup の sorted index 化、input table の sorted index 化、HIR traversal の subtree memoization は public API 契約を保ったまま後続 stage で置換できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_method_body_effect_checker" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_method_body_fact_table_inputs" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_method_body_resolver" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_method_body_fact_table_inputs_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_method_body_fact_table_inputs_len_result_eq summary.empty_input_len 0
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_method_body_fact_table_inputs_len_result_eq summary.two_input_len 2
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_method_body_fact_table_inputs_fact_error_result_eq summary.second_copy_rejected 1 SelfhostMemoTraitOperationMethodBodyResolverErrorKind::UnexpectedMethodOperation
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_method_body_fact_table_inputs_effect_error_result_eq summary.missing_root_rejected 0 SelfhostMemoTraitOperationMethodBodyEffectCheckerErrorKind::ExpressionMissing 9999
//:             let shown checks_print_report checks4
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "method body fact table inputs stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/resolve/name_resolver" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "./memo_trait_operation_method_body_effect_checker" as *
#import "./memo_trait_operation_method_body_fact_table_builder" as *
#import "./memo_trait_operation_method_body_resolver" as *

//: SelfhostMemoTraitOperationMethodBodyFactBuildInput: method body fact table に[投入/とうにゅう]する 1 件の typed root input
//:
//: [契約/けいやく]:
//: - `type_id` と `operation` は、上流の public surface scanner / classifier が typed evidence として決定済みの値です。
//: - `root` は method body の HIR root expression id です。この module は root の意味を source string から再解釈しません。
//: - `fuel` は HIR traversal の上限です。fuel exhaustion は builder 経由で typed effect checker error として返ります。
pub struct SelfhostMemoTraitOperationMethodBodyFactBuildInput:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    root %SelfhostHirExprId
    fuel %i32

//: SelfhostMemoTraitOperationMethodBodyFactBuildInputTable: method body fact build input の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。不要になったら `selfhost_memo_trait_operation_method_body_fact_build_input_table_free` で閉じます。
//: - table は checker-layer の session-local input 列であり、永続 artifact や public surface hash の authority ではありません。
pub struct SelfhostMemoTraitOperationMethodBodyFactBuildInputTable:
    records %Vec SelfhostMemoTraitOperationMethodBodyFactBuildInput

//: SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected: builder rejection の input index 付き payload
//:
//: [目的/もくてき]:
//: - enum variant が単一 payload を持つ現在の NEPLg2.1 構文でも、失敗した input index と nested builder error を失わずに運びます。
pub struct SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected:
    index %i32
    error %SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind

//: SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind: input 列から fact table を[組/く]む境界の拒否理由
//:
//: [目的/もくてき]:
//: - input table push / read の失敗と、既存 builder の nested rejection を分けます。
pub enum SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind:
    InputPushFailed %StdErrorKind
    InputReadFailed %i32
    BuilderRejected %SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected

//: SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary: input batch builder smoke の代表結果
pub struct SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary:
    empty_input_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind
    two_input_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind
    second_copy_rejected %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind
    missing_root_rejected %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind

impl Clone for SelfhostMemoTraitOperationMethodBodyFactBuildInput:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactBuildInput SelfhostMemoTraitOperationMethodBodyFactBuildInput \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactBuildInput:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactBuildInput SelfhostMemoTraitOperationMethodBodyFactBuildInput \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary SelfhostMemoTraitOperationMethodBodyFactTableInputsStage0Summary \self:
        self

//: selfhost_memo_trait_operation_method_body_fact_build_input_new: build input を[作/つく]る
//:
//: [契約/けいやく]:
//: - constructor は typed field を束ねるだけです。operation requirement matrix と HIR root 妥当性は builder / producer / effect checker が検査します。
pub fn selfhost_memo_trait_operation_method_body_fact_build_input_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostHirExprId fn i32 SelfhostMemoTraitOperationMethodBodyFactBuildInput \type_id\operation\root\fuel:
    SelfhostMemoTraitOperationMethodBodyFactBuildInput type_id operation root fuel

//: selfhost_memo_trait_operation_method_body_fact_build_input_table_new: [空/から]の build input table を[作/つく]る
pub fn selfhost_memo_trait_operation_method_body_fact_build_input_table_new %impure fn void Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationMethodBodyFactBuildInput StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationMethodBodyFactBuildInputTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_method_body_fact_build_input_table_free: build input table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_method_body_fact_build_input_table_free %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_method_body_fact_build_input_table_len: build input 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_method_body_fact_build_input_table_len %fn &SelfhostMemoTraitOperationMethodBodyFactBuildInputTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationMethodBodyFactBuildInput field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_method_body_fact_build_input_table_push: build input を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の table owner を返します。
//: - push 失敗時は `Vec` が返した owner を閉じ、`InputPushFailed(error)` として `StdErrorKind` を保持します。caller は失敗後に元の table を再利用してはいけません。
pub fn selfhost_memo_trait_operation_method_body_fact_build_input_table_push %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInput Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \table\input:
    let records %Vec SelfhostMemoTraitOperationMethodBodyFactBuildInput field::get table "records"
    match v::push records input:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationMethodBodyFactBuildInputTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed error

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_rejected_new: builder rejection payload を[作/つく]る
fn selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_rejected_new %fn i32 fn SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected \index\error:
    SelfhostMemoTraitOperationMethodBodyFactTableInputsBuilderRejected index error

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_error: builder error を input index とともに[包/つつ]む
fn selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_error %fn i32 fn SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \index\error:
    SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_rejected_new index error

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_loop: input table を順番に[読/よ]み builder へ[投入/とうにゅう]する
//:
//: [契約/けいやく]:
//: - `table` はこの loop が消費します。最後まで成功した場合だけ completed table owner を返します。
//: - input read failure では、まだ builder に渡していない `table` owner をこの loop が閉じます。
//: - builder rejection では builder が `table` owner の cleanup を完結済みなので、この loop は二重解放しません。
fn selfhost_memo_trait_operation_method_body_fact_table_inputs_loop %impure fn SelfhostMemoTraitOperationMethodBodyTable impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn i32 Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \table\module\inputs\index:
    if:
        ge index selfhost_memo_trait_operation_method_body_fact_build_input_table_len inputs
        then:
            Result::Ok table
        else:
            let records %&Vec SelfhostMemoTraitOperationMethodBodyFactBuildInput field::get_ref inputs "records"
            match v::get records index:
                Option::Some input:
                    match selfhost_memo_trait_operation_method_body_fact_table_builder_push_hir_root_result table module input.type_id input.operation input.root input.fuel:
                        Result::Ok next_table:
                            selfhost_memo_trait_operation_method_body_fact_table_inputs_loop next_table module inputs add index 1
                        Result::Err builder_error:
                            Result::Err selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_error index builder_error
                Option::None:
                    selfhost_memo_trait_operation_method_body_table_free table
                    Result::Err SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed index

//: selfhost_memo_trait_operation_method_body_fact_table_build_from_inputs_result: typed input 列から method body fact table を[組/く]む
//:
//: [契約/けいやく]:
//: - output `table` は消費されます。`Result::Err` の後に caller が渡した table owner を free / reuse してはいけません。
//: - `inputs` は borrow であり、この関数は閉じません。caller は success / failure のあとに input table owner を閉じます。
//: - input の作成責務は上流 public surface scanner にあります。この関数は input payload の source-level 由来を検査せず、既存 builder に typed field を渡します。
pub fn selfhost_memo_trait_operation_method_body_fact_table_build_from_inputs_result %impure fn SelfhostMemoTraitOperationMethodBodyTable impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationMethodBodyFactBuildInputTable Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind \table\module\inputs:
    selfhost_memo_trait_operation_method_body_fact_table_inputs_loop table module inputs 0

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `StdErrorKind` は payload を持たない enum なので、網羅 match で variant を code 化します。
//: - wildcard arm は使いません。`StdErrorKind` variant が増えた場合は、この境界を明示的に更新します。
fn selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            0
        StdErrorKind::OutOfMemory:
            1
        StdErrorKind::EmptyCollection:
            2
        StdErrorKind::IndexOutOfBounds:
            3
        StdErrorKind::KeyNotFound:
            4
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            6
        StdErrorKind::InvalidUtf8:
            7
        StdErrorKind::ParseError:
            8
        StdErrorKind::IoError:
            9
        StdErrorKind::Other:
            10

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    eq selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_code a selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_code b

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_error_kind_eq: input batch error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - nested builder error payload まで比較します。
//: - wildcard arm は使いません。error variant が増えた場合はこの equality 境界を明示的に更新します。
pub fn selfhost_memo_trait_operation_method_body_fact_table_inputs_error_kind_eq %fn SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind fn SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed a_push:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed b_push:
                    selfhost_memo_trait_operation_method_body_fact_table_inputs_std_error_kind_eq a_push b_push
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed _b_read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected _b_rejected:
                    false
        SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed a_index:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed _b_push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed b_index:
                    eq a_index b_index
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected _b_rejected:
                    false
        SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected a_rejected:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed _b_push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed _b_read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected b_rejected:
                    and:
                        eq a_rejected.index b_rejected.index
                        selfhost_memo_trait_operation_method_body_fact_table_builder_error_kind_eq a_rejected.error b_rejected.error

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_len_result_eq: batch build 後 len result が期待値か[返/かえ]す
pub fn selfhost_memo_trait_operation_method_body_fact_table_inputs_len_result_eq %fn Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind fn i32 bool \result\expected:
    match result:
        Result::Ok actual_len:
            eq actual_len expected
        Result::Err _error:
            false

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_error_result_eq: batch build result が期待 error か[返/かえ]す
pub fn selfhost_memo_trait_operation_method_body_fact_table_inputs_error_result_eq %fn Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind fn SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind bool \result\expected:
    match result:
        Result::Ok _len:
            false
        Result::Err error:
            selfhost_memo_trait_operation_method_body_fact_table_inputs_error_kind_eq error expected

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_error_result_eq: builder rejection の index と nested error が期待通りか[返/かえ]す
pub fn selfhost_memo_trait_operation_method_body_fact_table_inputs_builder_error_result_eq %fn Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind fn i32 fn SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind bool \result\expected_index\expected:
    match result:
        Result::Ok _len:
            false
        Result::Err error:
            match error:
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed _push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed _read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected rejected:
                    and:
                        eq rejected.index expected_index
                        selfhost_memo_trait_operation_method_body_fact_table_builder_error_kind_eq rejected.error expected

//: selfhost_memo_trait_operation_method_body_fact_table_inputs_fact_error_result_eq: builder 内の fact constructor error payload が期待通りか[確認/かくにん]する
pub fn selfhost_memo_trait_operation_method_body_fact_table_inputs_fact_error_result_eq %fn Result i32 SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind fn i32 fn SelfhostMemoTraitOperationMethodBodyResolverErrorKind bool \result\expected_index\expected:
    match result:
        Result::Ok _len:
            false
        Result::Err error:
            match error:
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputPushFailed _push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::InputReadFailed _read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind::BuilderRejected rejected:
                    if:
                        eq rejected.index expected_index
                        then:
                            let nested %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind Result::Err rejected.error
                            selfhost_memo_trait_operation_method_body_fact_table_builder_fact_error_result_eq nested expected
                        else:
