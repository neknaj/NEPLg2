impl Copy for SelfhostDropResourceGraphWalkerPlaceEventRecord:
    fn copy_mark %fn SelfhostDropResourceGraphWalkerPlaceEventRecord SelfhostDropResourceGraphWalkerPlaceEventRecord \self:
        self

//: Clone for SelfhostDropResourceGraphWalkerEdgeEventRecord: edge event は typed key と endpoint id だけを[持/も]つため bitwise copy で[複製/ふくせい]する
impl Clone for SelfhostDropResourceGraphWalkerEdgeEventRecord:
    fn clone %fn &SelfhostDropResourceGraphWalkerEdgeEventRecord SelfhostDropResourceGraphWalkerEdgeEventRecord \self:
        *self

