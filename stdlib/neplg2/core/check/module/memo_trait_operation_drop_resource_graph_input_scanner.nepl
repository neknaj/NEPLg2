//: Clone for SelfhostDropResourceGraphWalkerUnsupportedEventRecord: unsupported event は typed key と reason だけを[持/も]つため bitwise copy で[複製/ふくせい]する
impl Clone for SelfhostDropResourceGraphWalkerUnsupportedEventRecord:
    fn clone %fn &SelfhostDropResourceGraphWalkerUnsupportedEventRecord SelfhostDropResourceGraphWalkerUnsupportedEventRecord \self:
        *self

//: Copy for SelfhostDropResourceGraphWalkerUnsupportedEventRecord: unsupported event は walker input の immutable payload として Copy にする
impl Copy for SelfhostDropResourceGraphWalkerUnsupportedEventRecord:
    fn copy_mark %fn SelfhostDropResourceGraphWalkerUnsupportedEventRecord SelfhostDropResourceGraphWalkerUnsupportedEventRecord \self:
