pub fn selfhost_drop_resource_graph_walker_body_len %fn &SelfhostDropResourceGraphWalkerInput i32 \input:
    let bodies %&Vec SelfhostDropResourceGraphWalkerBodyRecord field::get_ref input "bodies"
    v::len bodies

