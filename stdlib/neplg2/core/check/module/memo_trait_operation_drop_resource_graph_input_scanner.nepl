#indent 4

//: # check/module/memo_trait_operation_drop_resource_graph_input_scanner
//: Drop impl body の typed Resource walker event table から traversal collector input を[作/つく]る checker-layer scanner です。
//:
//: [目的/もくてき]:
//: - `memo_trait_operation_drop_resource_no_escape_traversal_collector` は body / place / edge の typed graph input を traversal summary table へ畳みます。
//: - この module は、その 1 つ前の境界として、actual Resource IR graph walker が将来返す typed walker event table を collector input へ正規化します。
//: - Rust 実装の `ResourceOp` と同じく、local / temporary / return / storage / edge / unsupported operation を enum と struct で分け、source text や表示名を proof authority にしません。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostDropResourceGraphWalkerBodyRecord`、`SelfhostDropResourceGraphWalkerPlaceEventRecord`、`SelfhostDropResourceGraphWalkerEdgeEventRecord`、`SelfhostDropResourceGraphWalkerUnsupportedEventRecord` の typed payload だけです。
//: - source text、span、lexeme、display name、module path、public surface hash、payload hash、diagnostic text から graph completeness や no-escape を推測しません。
//: - body key は `SelfhostTypeId`、body module fingerprint、Drop body root、effect、escape、graph id をすべて含みます。operation ordinal は同じ body graph 内で一意でなければなりません。
//: - `body_module_fingerprint == 0`、`graph_id < 0`、`operation_ordinal < 0`、place / endpoint id の負数、`effect != InternalAlloc`、`escape != NotApplicable` は fail-closed に拒否します。
//: - place / edge / unsupported event は、同じ input に存在する `ClosedForDropBody` body record にだけ属せます。missing / upstream unsupported graph に event が混入した場合は fail-closed に拒否します。
//: - unsupported event がある closed body は collector input では `TraversalUnsupported` body として渡し、partial place / edge graph を no-escape proof へ使いません。
//: - この module は traversal summary、no-escape observation、proof table、Drop evidence、aggregate proof、generic binder、PrivateCache / PrivateState masking、backend artifact、prechecked artifact を作りません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では selfhost 側に Rust と同等の full Resource IR graph owner はまだありません。この module は graph walker 本体ではなく、walker output の typed event stream contract と collector input projection を固定します。
//: - `SelfhostDropResourceGraphWalkerUnsupportedReason` は unsupported operation を public diagnostic string へ変換するための値ではありません。後段は typed enum を見て fail-closed に扱います。
//: - facade には re-export しません。Drop fact builder、Resource walker、scanner、collector、materializer、producer、no-escape gate、purity gate を上位 orchestration で束ねる段階で公開 API を再評価します。
//: - 行数や doc comment の長さによる制限は置きません。契約、現状、計算量、owner cleanup を doc comment で明示することを優先します。
//:
//: [計算量/けいさんりょう]:
//: - body 数を b、place event 数を p、edge event 数を e、unsupported event 数を u とすると、現状の duplicate / membership 検査は O((b+p+e+u)^2) 時間、output collector input に O(b+p+e) 空間を使います。
//: - body bucket、operation ordinal sorted index、event kind bucket、graph lookup index は、key equality、duplicate rejection、unsupported override、owner cleanup、fail-closed error contract を保ったまま後続 stage で置換できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_resource_graph_input_scanner" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_resource_no_escape_traversal_collector" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_resource_no_escape_materializer" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_drop_resource_graph_input_scanner_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_drop_resource_graph_input_scanner_len_result_eq summary.scanned_body_len 4
//:             let checks2 checks_push checks1 check selfhost_drop_resource_graph_input_scanner_status_result_eq summary.private_status SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::AllTraversedPlacesPrivate
//:             let checks3 checks_push checks2 check selfhost_drop_resource_graph_input_scanner_status_result_eq summary.escape_status SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::EscapingPlaceObserved
//:             let checks4 checks_push checks3 check selfhost_drop_resource_graph_input_scanner_status_result_eq summary.unsupported_status SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::TraversalUnsupported
//:             let checks5 checks_push checks4 check selfhost_drop_resource_graph_input_scanner_status_result_eq summary.missing_status SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::ResourceGraphMissing
//:             let checks6 checks_push checks5 check selfhost_drop_resource_graph_input_scanner_error_result_eq summary.duplicate_ordinal_rejected SelfhostDropResourceGraphInputScannerErrorKind::GraphOperationDuplicate
//:             let checks7 checks_push checks6 check selfhost_drop_resource_graph_input_scanner_error_result_eq summary.missing_body_event_rejected SelfhostDropResourceGraphInputScannerErrorKind::GraphBodyMissing 7
//:             let checks8 checks_push checks7 check selfhost_drop_resource_graph_input_scanner_error_result_eq summary.placeholder_rejected SelfhostDropResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
//:             let shown checks_print_report checks8
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "drop Resource graph input scanner stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty/id" as *
#import "./memo_trait_operation_drop_resource_no_escape_traversal_collector" as *
#import "./memo_trait_operation_drop_resource_no_escape_materializer" as *

//: SelfhostDropResourceGraphWalkerUnsupportedReason: graph walker が closed traversal にできなかった理由
pub enum SelfhostDropResourceGraphWalkerUnsupportedReason:
    UnknownResourceOperation
    UnknownPlaceRoot
    UnknownProjection
    UnknownCallBoundary
    PrivateCacheBoundaryUnsupported
    PrivateStateBoundaryUnsupported

//: SelfhostDropResourceGraphWalkerBodyRecord: Resource walker が Drop body ごとに返す graph header
pub struct SelfhostDropResourceGraphWalkerBodyRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    graph_id %SelfhostDropResourceGraphId
    completeness %SelfhostDropResourceGraphCompleteness

//: SelfhostDropResourceGraphWalkerPlaceEventRecord: Resource walker が観測した place node
pub struct SelfhostDropResourceGraphWalkerPlaceEventRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostDropResourceGraphId
    operation_ordinal %i32
    place_id %SelfhostResourcePlaceId
    kind %SelfhostResourcePlaceKind

//: SelfhostDropResourceGraphWalkerEdgeEventRecord: Resource walker が観測した graph edge
pub struct SelfhostDropResourceGraphWalkerEdgeEventRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostDropResourceGraphId
    operation_ordinal %i32
    from_place %SelfhostResourcePlaceId
    to_place %SelfhostResourcePlaceId
    kind %SelfhostResourceEdgeKind

//: SelfhostDropResourceGraphWalkerUnsupportedEventRecord: no-escape traversal へ進めない Resource operation
pub struct SelfhostDropResourceGraphWalkerUnsupportedEventRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    graph_id %SelfhostDropResourceGraphId
    operation_ordinal %i32
    reason %SelfhostDropResourceGraphWalkerUnsupportedReason

//: SelfhostDropResourceGraphWalkerInput: Resource walker event の session-local owner table
pub struct SelfhostDropResourceGraphWalkerInput:
    bodies %Vec SelfhostDropResourceGraphWalkerBodyRecord
    places %Vec SelfhostDropResourceGraphWalkerPlaceEventRecord
    edges %Vec SelfhostDropResourceGraphWalkerEdgeEventRecord
    unsupported %Vec SelfhostDropResourceGraphWalkerUnsupportedEventRecord

//: SelfhostDropResourceGraphInputScannerErrorKind: scanner の構造的な拒否理由
pub enum SelfhostDropResourceGraphInputScannerErrorKind:
    WalkerBodyPushFailed %StdErrorKind
    WalkerPlaceEventPushFailed %StdErrorKind
    WalkerEdgeEventPushFailed %StdErrorKind
    WalkerUnsupportedEventPushFailed %StdErrorKind
    WalkerBodyReadFailed %i32
    WalkerPlaceEventReadFailed %i32
    WalkerEdgeEventReadFailed %i32
    WalkerUnsupportedEventReadFailed %i32
    GraphBodyDuplicate
    GraphOperationDuplicate
    GraphBodyMissing %i32
    EventForNonClosedGraph %i32
    BodyModuleFingerprintPlaceholder
    GraphIdInvalid %i32
    OperationOrdinalInvalid %i32
    PlaceIdInvalid %i32
    EdgeEndpointInvalid %i32
    EffectNotInternalAlloc %SelfhostEffectKind
    EscapeNotApplicable %SelfhostEffectEscapeState
    OutputGraphInputAllocFailed %StdErrorKind
    OutputCollectorInputRejected %SelfhostDropResourceGraphTraversalCollectorErrorKind

//: SelfhostDropResourceGraphInputScannerStage0Summary: scanner smoke の代表結果
pub struct SelfhostDropResourceGraphInputScannerStage0Summary:
    scanned_body_len %Result i32 SelfhostDropResourceGraphInputScannerErrorKind
    private_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphInputScannerErrorKind
    escape_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphInputScannerErrorKind
    unsupported_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphInputScannerErrorKind
    missing_status %Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus SelfhostDropResourceGraphInputScannerErrorKind
    duplicate_ordinal_rejected %Result i32 SelfhostDropResourceGraphInputScannerErrorKind
    missing_body_event_rejected %Result i32 SelfhostDropResourceGraphInputScannerErrorKind
    placeholder_rejected %Result i32 SelfhostDropResourceGraphInputScannerErrorKind

//: Clone for SelfhostDropResourceGraphWalkerUnsupportedReason: unsupported reason は enum payload を[持/も]たないため bitwise copy で[複製/ふくせい]する
impl Clone for SelfhostDropResourceGraphWalkerUnsupportedReason:
    fn clone %fn &SelfhostDropResourceGraphWalkerUnsupportedReason SelfhostDropResourceGraphWalkerUnsupportedReason \self:
        *self

//: Copy for SelfhostDropResourceGraphWalkerUnsupportedReason: unsupported reason は owner を[持/も]たない typed reason として Copy にする
impl Copy for SelfhostDropResourceGraphWalkerUnsupportedReason:
    fn copy_mark %fn SelfhostDropResourceGraphWalkerUnsupportedReason SelfhostDropResourceGraphWalkerUnsupportedReason \self:
        self

