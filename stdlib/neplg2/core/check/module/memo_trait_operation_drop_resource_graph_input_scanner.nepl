//: selfhost_drop_resource_graph_walker_body_record_new: walker body record を[作/つく]る
pub fn selfhost_drop_resource_graph_walker_body_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostDropResourceGraphId fn SelfhostDropResourceGraphCompleteness SelfhostDropResourceGraphWalkerBodyRecord \type_id\body_module_fingerprint\body_root\effect\escape\graph_id\completeness:
    SelfhostDropResourceGraphWalkerBodyRecord type_id body_module_fingerprint body_root effect escape graph_id completeness

//: selfhost_drop_resource_graph_walker_place_event_record_new: walker place event record を[作/つく]る
pub fn selfhost_drop_resource_graph_walker_place_event_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostDropResourceGraphId fn i32 fn SelfhostResourcePlaceId fn SelfhostResourcePlaceKind SelfhostDropResourceGraphWalkerPlaceEventRecord \type_id\body_module_fingerprint\body_root\graph_id\operation_ordinal\place_id\kind:
    SelfhostDropResourceGraphWalkerPlaceEventRecord type_id body_module_fingerprint body_root graph_id operation_ordinal place_id kind

//: selfhost_drop_resource_graph_walker_edge_event_record_new: walker edge event record を[作/つく]る
pub fn selfhost_drop_resource_graph_walker_edge_event_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostDropResourceGraphId fn i32 fn SelfhostResourcePlaceId fn SelfhostResourcePlaceId fn SelfhostResourceEdgeKind SelfhostDropResourceGraphWalkerEdgeEventRecord \type_id\body_module_fingerprint\body_root\graph_id\operation_ordinal\from_place\to_place\kind:
    SelfhostDropResourceGraphWalkerEdgeEventRecord type_id body_module_fingerprint body_root graph_id operation_ordinal from_place to_place kind

//: selfhost_drop_resource_graph_walker_unsupported_event_record_new: walker unsupported event record を[作/つく]る
pub fn selfhost_drop_resource_graph_walker_unsupported_event_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostDropResourceGraphId fn i32 fn SelfhostDropResourceGraphWalkerUnsupportedReason SelfhostDropResourceGraphWalkerUnsupportedEventRecord \type_id\body_module_fingerprint\body_root\graph_id\operation_ordinal\reason:
    SelfhostDropResourceGraphWalkerUnsupportedEventRecord type_id body_module_fingerprint body_root graph_id operation_ordinal reason

//: selfhost_drop_resource_graph_walker_input_new: [空/から]の walker input owner を[作/つく]る
pub fn selfhost_drop_resource_graph_walker_input_new %impure fn void Result SelfhostDropResourceGraphWalkerInput StdErrorKind \void:
    let bodies_result %Result Vec SelfhostDropResourceGraphWalkerBodyRecord StdErrorKind v::new
    match bodies_result:
        Result::Ok bodies:
            let places_result %Result Vec SelfhostDropResourceGraphWalkerPlaceEventRecord StdErrorKind v::new
            match places_result:
                Result::Ok places:
                    let edges_result %Result Vec SelfhostDropResourceGraphWalkerEdgeEventRecord StdErrorKind v::new
                    match edges_result:
                        Result::Ok edges:
                            let unsupported_result %Result Vec SelfhostDropResourceGraphWalkerUnsupportedEventRecord StdErrorKind v::new
                            match unsupported_result:
                                Result::Ok unsupported:
                                    Result::Ok SelfhostDropResourceGraphWalkerInput bodies places edges unsupported
                                Result::Err e:
                                    v::free edges
                                    v::free places
                                    v::free bodies
                                    Result::Err e
                        Result::Err e:
                            v::free places
                            v::free bodies
                            Result::Err e
                Result::Err e:
                    v::free bodies
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_drop_resource_graph_walker_input_free: walker input owner を[閉/と]じる
pub fn selfhost_drop_resource_graph_walker_input_free %impure fn SelfhostDropResourceGraphWalkerInput unit \input:
    v::free field::get input "bodies"
    v::free field::get input "places"
    v::free field::get input "edges"
    v::free field::get input "unsupported"

