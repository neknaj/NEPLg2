                                    Result::Ok unit
                                SelfhostEffectEscapeState::NoEscapeProven:
                                    Result::Err SelfhostDropResourceGraphInputScannerErrorKind::EscapeNotApplicable body.escape
                                SelfhostEffectEscapeState::MayEscape:
