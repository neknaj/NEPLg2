impl Copy for SelfhostDropResourceGraphWalkerEdgeEventRecord:
    fn copy_mark %fn SelfhostDropResourceGraphWalkerEdgeEventRecord SelfhostDropResourceGraphWalkerEdgeEventRecord \self:
