//: selfhost_drop_resource_graph_input_scanner_graph_id_eq: graph id が同じか[返/かえ]す
fn selfhost_drop_resource_graph_input_scanner_graph_id_eq %fn SelfhostDropResourceGraphId fn SelfhostDropResourceGraphId bool \a\b:
    eq a.index b.index

//: selfhost_drop_resource_graph_input_scanner_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
fn selfhost_drop_resource_graph_input_scanner_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            1
        StdErrorKind::OutOfMemory:
            2
        StdErrorKind::EmptyCollection:
            3
        StdErrorKind::IndexOutOfBounds:
            4
        StdErrorKind::KeyNotFound:
            5
        StdErrorKind::CapacityExceeded:
            6
        StdErrorKind::InvalidOperation:
            7
        StdErrorKind::InvalidUtf8:
            8
        StdErrorKind::ParseError:
            9
        StdErrorKind::IoError:
            10
        StdErrorKind::Other:
            11

//: selfhost_drop_resource_graph_input_scanner_effect_kind_code: effect kind を比較用 code へ[写/うつ]す
fn selfhost_drop_resource_graph_input_scanner_effect_kind_code %fn SelfhostEffectKind i32 \kind:
    match kind:
        SelfhostEffectKind::Pure:
            1
        SelfhostEffectKind::InternalAlloc:
            2
        SelfhostEffectKind::UnsafeMemory:
            3
        SelfhostEffectKind::ExternalIo:
            4
        SelfhostEffectKind::Nondet:
            5

//: selfhost_drop_resource_graph_input_scanner_escape_state_code: escape state を比較用 code へ[写/うつ]す
fn selfhost_drop_resource_graph_input_scanner_escape_state_code %fn SelfhostEffectEscapeState i32 \state:
    match state:
        SelfhostEffectEscapeState::NotApplicable:
            1
        SelfhostEffectEscapeState::NoEscapeProven:
            2
        SelfhostEffectEscapeState::MayEscape:
            3

//: selfhost_drop_resource_graph_input_scanner_status_code: traversal status を比較用 code へ[写/うつ]す
fn selfhost_drop_resource_graph_input_scanner_status_code %fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus i32 \status:
    match status:
        SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::AllTraversedPlacesPrivate:
            1
        SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::EscapingPlaceObserved:
            2
        SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::ResourceGraphMissing:
            3
        SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus::TraversalUnsupported:
            4

//: selfhost_drop_resource_graph_input_scanner_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_drop_resource_graph_input_scanner_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_drop_resource_graph_walker_body_key_eq: body key が同じか[返/かえ]す
fn selfhost_drop_resource_graph_walker_body_key_eq %fn SelfhostDropResourceGraphWalkerBodyRecord fn SelfhostDropResourceGraphWalkerBodyRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
