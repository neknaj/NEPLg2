fn selfhost_drop_resource_graph_walker_validate_body_result %fn SelfhostDropResourceGraphWalkerBodyRecord Result unit SelfhostDropResourceGraphInputScannerErrorKind \body:
    if:
        eq body.body_module_fingerprint 0
        then:
            Result::Err SelfhostDropResourceGraphInputScannerErrorKind::BodyModuleFingerprintPlaceholder
        else:
