#import "./memo_trait_operation_private_effect_no_escape_gate" as *
#import "./memo_trait_operation_private_effect_resource_no_escape_producer" as *

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus: Resource traversal summary の[状態/じょうたい]
//:
//: [目的/もくてき]:
//: - Resource graph traversal の成功、escape 発見、graph 欠落、未対応 traversal を typed enum として運びます。
//: - bool だけでは `MayEscape` と `Missing` と `Unknown` が区別できず、pure mask の安全側失敗が崩れるため、この enum を使います。
pub enum SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus:
    AllTraversedPlacesPrivate
    EscapingPlaceObserved
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalReason: traversal status の typed reason
//:
//: [目的/もくてき]:
//: - actual traversal 実装が、なぜその status を選んだかを source text ではなく enum payload として渡すための reason です。
//: - Phase 1 の materializer は status のみを observation status へ写し、reason から結果を再計算しません。
pub enum SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalReason:
    PrivateRegionOnly
    ReturnPlaceEscapes
    PublicStoreEscapes
    ResourceGraphUnavailable
    UnsupportedResourceOperation
    ObservationDetected

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord: private effect method body 1 件に対する traversal summary
//:
//: [契約/けいやく]:
//: - `type_id`、`operation`、`body_module_fingerprint`、`body_root` は private-effect gate が読む method body identity と同じです。
//: - `effect` / `escape` は traversal が対象にした元の effect summary です。Phase 1 では `PrivateState + NotApplicable` または `PrivateCache + NotApplicable` だけを受理します。
//: - `status` は Resource graph traversal の判定結果です。この module は HIR や source に戻って status を作り直しません。
//: - `reason` は説明用の typed payload であり、diagnostic string ではありません。
pub struct SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    status %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus
    reason %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalReason

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable: traversal summary record の session-local owner table
//:
//: [契約/けいやく]:
//: - table は `records` buffer を所有します。caller は materializer で使い終えたあと `selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_free` で閉じます。
//: - table は永続 artifact ではありません。`.neplproof` や prechecked metadata からの復元は別 boundary が担当します。
pub struct SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable:
    records %Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind: Resource traversal materializer の構造的な拒否理由
//:
//: [目的/もくてき]:
//: - traversal summary table の構築、validation、duplicate detection、observation table 生成、producer 経由の proof table 生成の失敗を enum として分けます。
pub enum SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind:
    TraversalRecordPushFailed %StdErrorKind
    TraversalRecordReadFailed %i32
    TraversalRecordDuplicate
    BodyModuleFingerprintPlaceholder
    TraversalEffectNotPrivate %SelfhostEffectKind
    TraversalEscapeNotApplicable %SelfhostEffectEscapeState
    ObservationTableAllocFailed %StdErrorKind
    ObservationTableRejected %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind
    ProofTableRejected %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalDuplicateDecision: direct table scan での duplicate 判定
//:
//: [目的/もくてき]:
//: - malformed direct table の earlier duplicate 検査結果を bool に潰さず、materializer loop が exhaustive match で分岐できるようにします。
pub enum SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalDuplicateDecision:
    UniqueSoFar
    DuplicateFound

//: SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerStage0Summary: materializer smoke の代表結果
//:
//: [目的/もくてき]:
//: - 4 種の traversal status mapping、producer 経由の proof table generation、duplicate rejection、placeholder rejection、effect mismatch rejection、escape mismatch rejection を確認します。
pub struct SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerStage0Summary:
    materialized_len %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind
    proof_len %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind
    private_status %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus
    escape_status %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus
    missing_status %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus
    unknown_status %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus
    duplicate_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind
    placeholder_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind
    effect_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind
    escape_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind

