//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_record_new: traversal summary record を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalStatus fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalReason SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord \type_id\operation\body_module_fingerprint\body_root\effect\escape\status\reason:
    SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord type_id operation body_module_fingerprint body_root effect escape status reason

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_new: [空/から]の traversal summary table を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_new %impure fn void Result SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_free: traversal summary table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_free %impure fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_len: traversal summary record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_len %fn &SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_record_key_eq: 2 traversal record が同じ private-effect body summary key か[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_record_key_eq %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation
            and:
                eq a.body_module_fingerprint b.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                    and:
                        selfhost_effect_kind_eq a.effect b.effect
                        selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_escape_state_eq a.escape b.escape

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_validate_effect: private effect だけを[受/う]け[入/い]れる
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_validate_effect %fn SelfhostEffectKind Result unit SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind \effect:
    match effect:
        SelfhostEffectKind::Pure:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEffectNotPrivate effect
        SelfhostEffectKind::InternalAlloc:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEffectNotPrivate effect
        SelfhostEffectKind::PrivateState:
            Result::Ok unit
        SelfhostEffectKind::PrivateCache:
            Result::Ok unit
        SelfhostEffectKind::UnsafeMemory:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEffectNotPrivate effect
        SelfhostEffectKind::ExternalIo:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEffectNotPrivate effect
        SelfhostEffectKind::Nondet:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEffectNotPrivate effect

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_validate_record_result: traversal summary record の受理条件を[確認/かくにん]する
//:
//: [契約/けいやく]:
//: - validation は table push と materializer loop の両方で呼びます。外部から直接組み立てられた malformed table でも materializer が fail-closed に止まるためです。
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_validate_record_result %fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord Result unit SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind \record:
    if:
        eq record.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            match selfhost_memo_trait_operation_private_effect_resource_no_escape_materializer_validate_effect record.effect:
                Result::Ok _unit:
                    match record.escape:
                        SelfhostEffectEscapeState::NotApplicable:
                            Result::Ok unit
                        SelfhostEffectEscapeState::NoEscapeProven:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEscapeNotApplicable record.escape
                        SelfhostEffectEscapeState::MayEscape:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeMaterializerErrorKind::TraversalEscapeNotApplicable record.escape
                Result::Err e:
                    Result::Err e

//: selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_contains_key_loop: input table 内の既存 key を[探/さが]す
fn selfhost_memo_trait_operation_private_effect_resource_no_escape_traversal_table_contains_key_loop %fn &SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalTable fn SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeTraversalRecord fn i32 bool \table\record\idx:
