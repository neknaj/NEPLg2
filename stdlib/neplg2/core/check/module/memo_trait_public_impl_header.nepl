//: selfhost_memo_trait_public_impl_header_input_new: typed input を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は field をまとめるだけです。visibility、ordinal、hash seed、count の検査は producer 本体で行います。
pub fn selfhost_memo_trait_public_impl_header_input_new %fn SelfhostModuleDeclarationVisibility fn i32 fn Option i32 fn SelfhostMemoTraitPublicImplHeaderKind fn Option i32 fn Option i32 fn i32 fn i32 fn SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence SelfhostMemoTraitPublicImplHeaderInput \visibility\module_fingerprint\declaration_ordinal\kind\target_type_shape_hash\trait_application_shape_hash\type_parameter_count\type_parameter_bound_count\generic_binder_evidence:
    SelfhostMemoTraitPublicImplHeaderInput visibility module_fingerprint declaration_ordinal kind target_type_shape_hash trait_application_shape_hash type_parameter_count type_parameter_bound_count generic_binder_evidence

//: selfhost_memo_trait_public_impl_header_monomorphic_binder_evidence: monomorphic header 用の binder mode
//:
//: [契約/けいやく]:
//: - 既存の monomorphic call site はこの value を渡します。count 非 0 をこの mode で受理することはありません。
pub fn selfhost_memo_trait_public_impl_header_monomorphic_binder_evidence %fn void SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence \void:
    SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Monomorphic

//: selfhost_memo_trait_public_impl_header_detailed_binder_evidence: detailed generic binder mode を[作/つく]る
//:
//: [契約/けいやく]:
//: - evidence value を包むだけです。count と hash の検査は shape hash producer が行います。
pub fn selfhost_memo_trait_public_impl_header_detailed_binder_evidence %fn SelfhostMemoTraitPublicImplGenericBinderEvidence SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence \evidence:
    SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Detailed evidence

//: selfhost_memo_trait_public_impl_header_schema_version: impl header shape hash schema version
//:
//: [契約/けいやく]:
//: - impl kind、target type shape、trait application shape、generic count、bound count の fold rule を変える場合はこの version を更新します。
fn selfhost_memo_trait_public_impl_header_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_impl_header_mix2: impl header hash 用の 2 field [混合/こんごう]
fn selfhost_memo_trait_public_impl_header_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_impl_header_mix3: impl header hash 用の 3 field [混合/こんごう]
fn selfhost_memo_trait_public_impl_header_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_public_impl_header_mix2 a b c

//: selfhost_memo_trait_public_impl_header_mix4: impl header hash 用の 4 field [混合/こんごう]
fn selfhost_memo_trait_public_impl_header_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_impl_header_mix2 (selfhost_memo_trait_public_impl_header_mix2 a b) (selfhost_memo_trait_public_impl_header_mix2 c d)

//: selfhost_memo_trait_public_impl_header_payload_schema_code: public declaration payload schema の domain code
//:
//: [契約/けいやく]:
//: - normalizer の `SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput` と同じ field 構成を hash へ畳みます。
//: - この helper は facade 公開されません。normalizer の内部 adapter を公開 API に漏らさず、impl producer が同じ typed payload contract に従うための局所境界です。
fn selfhost_memo_trait_public_impl_header_payload_schema_code %fn void i32 \void:
    252301

//: selfhost_memo_trait_public_impl_header_kind_code: impl header kind を stable domain code へ[写/うつ]す
fn selfhost_memo_trait_public_impl_header_kind_code %fn SelfhostMemoTraitPublicImplHeaderKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicImplHeaderKind::TraitImpl:
            252901
        SelfhostMemoTraitPublicImplHeaderKind::InherentImpl:
            252902

//: selfhost_memo_trait_public_impl_header_payload_kind_code: public declaration kind を payload domain code へ[写/うつ]す
fn selfhost_memo_trait_public_impl_header_payload_kind_code %fn SelfhostMemoTraitPublicSurfacePublicDeclarationKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Function:
            252311
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Struct:
            252312
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Enum:
            252313
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Impl:
            252314

//: selfhost_memo_trait_public_impl_header_payload_hash_result: payload input から stable hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - stable declaration key と normalized declaration shape は nonzero でなければなりません。
//: - source text、span、display name、diagnostic text は読まず、payload input の typed field だけを authority にします。
//: - normalizer の内部 adapter と同じ placeholder error kind を返し、呼び出し側が impl header producer の error enum へ包めるようにします。
fn selfhost_memo_trait_public_impl_header_payload_hash_result %fn SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \input:
    if:
        eq input.stable_declaration_key_hash 0
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StableDeclarationKeyHashPlaceholder
        else:
            if:
                eq input.normalized_declaration_shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::NormalizedDeclarationShapeHashPlaceholder
                else:
                    let kind_hash %i32 selfhost_memo_trait_public_impl_header_payload_kind_code input.kind
                    let header_hash %i32 selfhost_memo_trait_public_impl_header_mix3 selfhost_memo_trait_public_impl_header_payload_schema_code kind_hash input.stable_declaration_key_hash
                    let payload_hash %i32 selfhost_memo_trait_public_impl_header_mix2 header_hash input.normalized_declaration_shape_hash
                    if:
                        eq payload_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DerivedDeclarationPayloadHashPlaceholder
                        else:
                            Result::Ok payload_hash

//: selfhost_memo_trait_public_impl_header_visibility_result: public visibility を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_header_visibility_result %fn SelfhostModuleDeclarationVisibility Result unit SelfhostMemoTraitPublicImplHeaderErrorKind \visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Public:
            Result::Ok unit
        SelfhostModuleDeclarationVisibility::Private:
            Result::Err SelfhostMemoTraitPublicImplHeaderErrorKind::PrivateVisibilityRejected

//: selfhost_memo_trait_public_impl_header_ordinal_result: public surface ordinal を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_header_ordinal_result %fn Option i32 Result i32 SelfhostMemoTraitPublicImplHeaderErrorKind \ordinal:
    match ordinal:
        Option::Some value:
            if:
                lt value 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalNegative
                else:
                    if:
                        eq value 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalPlaceholder
                        else:
                            Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalMissing

//: selfhost_memo_trait_public_impl_header_zero_count_result: generic count が現在の accepted 範囲か[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - 現 slice は generic impl の binder / bound 詳細 table を持たないため、0 だけを accepted にします。
//: - count だけを hash material にすると、同じ個数で異なる generic binder や bound environment を同一視する危険があります。
fn selfhost_memo_trait_public_impl_header_zero_count_result %fn i32 fn SelfhostMemoTraitPublicImplHeaderErrorKind fn SelfhostMemoTraitPublicImplHeaderErrorKind Result i32 SelfhostMemoTraitPublicImplHeaderErrorKind \count\negative_error\unsupported_error:
    if:
        lt count 0
        then:
            Result::Err negative_error
        else:
            if:
                eq count 0
                then:
                    Result::Ok count
                else:
                    Result::Err unsupported_error

//: selfhost_memo_trait_public_impl_header_shape_seed_result: shape hash seed を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_header_shape_seed_result %fn Option i32 fn SelfhostMemoTraitPublicImplHeaderErrorKind fn SelfhostMemoTraitPublicImplHeaderErrorKind Result i32 SelfhostMemoTraitPublicImplHeaderErrorKind \seed\missing_error\placeholder_error:
    match seed:
        Option::Some hash:
            if:
                eq hash 0
                then:
                    Result::Err placeholder_error
                else:
                    Result::Ok hash
        Option::None:
            Result::Err missing_error

//: selfhost_memo_trait_public_impl_header_no_generic_binder_shape_hash: monomorphic binder の stable seed
//:
//: [契約/けいやく]:
//: - monomorphic impl でも header shape の fold material が generic impl と同じ field 構成になるよう、0 ではない domain seed を返します。
fn selfhost_memo_trait_public_impl_header_no_generic_binder_shape_hash %fn void i32 \void:
    252931

//: selfhost_memo_trait_public_impl_header_generic_binder_hash_result: generic binder evidence の shape seed を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - count-only generic impl acceptance を防ぎ、詳細 binder evidence の shape hash だけを header shape material として使います。
//:
//: [契約/けいやく]:
//: - `Monomorphic` は type parameter count と bound count がどちらも 0 の場合だけ accepted seed になります。
//: - `Detailed` は evidence count と header count が一致し、evidence shape hash が nonzero の場合だけ accepted seed になります。
//: - trait solving、operation candidate、Resource IR proof、PrivateCache / PrivateState masking には進みません。
