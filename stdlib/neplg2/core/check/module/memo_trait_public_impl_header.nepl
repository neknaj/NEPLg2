#indent 4

//: # check/module/memo_trait_public_impl_header
//: public trait impl declaration の typed header evidence を public surface normalizer の payload input へ[変換/へんかん]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface hash が trait impl を source header の文字列ではなく、module fingerprint、public declaration ordinal、target type shape、trait application shape、generic binder count から受け取れるようにします。
//: - stable impl key と normalized impl header shape を分け、declaration identity と依存側の trait lookup に影響する shape を同じ hash に潰さない境界を固定します。
//: - inherent impl は現行 Rust 実装の public surface materializer でも unsupported であり、この producer でも accepted public surface payload へ流さず typed error として拒否します。
//: - normalizer が受け取る public declaration payload input と同じ schema で payload hash を作り、function signature producer と type layout header producer と同じ evidence stream へ合流できるようにします。
//:
//: [契約/けいやく]:
//: - accepted impl header evidence は `SelfhostMemoTraitPublicImplHeaderInput` の typed field だけから作ります。
//: - source text、span、lexeme、display name、diagnostic text、path suffix、HIR、Resource IR、backend artifact、proof store record は accepted hash material に入りません。
//: - `visibility` は `Public` だけを受理します。private impl は public surface input ではないため typed error にします。
//: - `module_fingerprint` と `declaration_ordinal` は stable impl key の材料です。0 や欠落を accepted identity として扱いません。
//: - `target_type_shape_hash` と `trait_application_shape_hash` は、別 stage が typed type / trait application term から作った nonzero hash でなければなりません。source spelling や trait name string をこの module で直接 hash しません。
//: - `type_parameter_count` と `type_parameter_bound_count` が 0 でない場合は、count だけでは受理せず、詳細 generic binder evidence の count と nonzero shape hash を必ず照合します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では caller supplied の typed target type shape hash と trait application shape hash を検査して impl header shape を作ります。
//: - trait application term の完全正規化、generic binder table の source scanner、generic bound solving、method body purity、Drop なし proof、trait impl coherence table は後続 stage の責務です。
//: - facade にはまだ re-export しません。full public surface orchestration が function / layout / impl / re-export producer をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - single evidence 生成は fixed-size typed payload だけを検査して fold するため O(1) 時間・O(1) 追加空間です。
//: - target type shape と trait application shape の作成計算量は、この module ではなくそれぞれの typed producer の契約に従います。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: ##: [9] ok
//: ##: [10] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_header" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_impl_header_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.trait_impl
//:     let checks2 checks_push checks1 check is_ok summary.other_trait_impl
//:     let checks3 checks_push checks2 check summary.trait_impls_differ
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.inherent_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::InherentImplUnsupported
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.private_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::PrivateVisibilityRejected
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.trait_hash_missing_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::TraitApplicationShapeHashMissing
//:     let checks7 checks_push checks6 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.target_hash_placeholder_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::TargetTypeShapeHashPlaceholder
//:     let checks8 checks_push checks7 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.generic_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::GenericBinderEvidenceMissing
//:     let checks9 checks_push checks8 check is_ok summary.generic_with_binder
//:     let checks10 checks_push checks9 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.stable_key_inherent_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::InherentImplUnsupported
//:     let checks11 checks_push checks10 check selfhost_memo_trait_public_impl_header_error_kind_eq unwrap_err summary.stable_key_ordinal_rejected SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalPlaceholder
//:     let shown checks_print_report checks11
//:     checks_exit_code shown
//: ```

#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "./memo_trait_public_impl_generic_binder" as *
#import "./memo_trait_public_surface_normalizer" as *

//: SelfhostMemoTraitPublicImplHeaderKind: public impl header の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - trait impl と inherent impl を bool ではなく enum で保持し、unsupported な inherent impl を accepted hash material へ混ぜないようにします。
pub enum SelfhostMemoTraitPublicImplHeaderKind:
    TraitImpl
    InherentImpl

//: SelfhostMemoTraitPublicImplHeaderStableKeyHash: stable impl declaration identity の hash
//:
//: [契約/けいやく]:
//: - `schema_version` は stable impl key の fold material を表します。
//: - `key_hash` は nonzero でなければ normalizer payload input の stable declaration key には使えません。
pub struct SelfhostMemoTraitPublicImplHeaderStableKeyHash:
    schema_version %i32
    key_hash %i32

//: SelfhostMemoTraitPublicImplHeaderShapeHash: public impl header shape の normalized fingerprint
//:
//: [目的/もくてき]:
//: - target type、trait application、generic binder count、bound count から作った public impl header shape を schema version と一緒に保持します。
//:
//: [契約/けいやく]:
//: - `root_hash` は nonzero でなければ accepted shape ではありません。
pub struct SelfhostMemoTraitPublicImplHeaderShapeHash:
    schema_version %i32
    root_hash %i32

//: SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence: public impl header が[使/つか]う generic binder evidence の mode
//:
//: [目的/もくてき]:
//: - monomorphic impl と detailed generic binder evidence を `Option` の有無だけにせず、enum として明示します。
//:
//: [契約/けいやく]:
//: - `Monomorphic` は `type_parameter_count = 0` かつ `type_parameter_bound_count = 0` の header だけで受理されます。
//: - `Detailed(evidence)` は `SelfhostMemoTraitPublicImplGenericBinderEvidence` の count、nonzero table hash、nonzero shape hash を再検査してから header shape に混ぜます。
//: - この enum は generic impl の semantic success、trait bound solving、operation candidate、proof record を表しません。
pub enum SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence:
    Monomorphic
    Detailed %SelfhostMemoTraitPublicImplGenericBinderEvidence

//: SelfhostMemoTraitPublicImplHeaderInput: public trait impl header producer の typed input
//:
//: [目的/もくてき]:
//: - visibility、module fingerprint、public declaration ordinal、impl kind、target type shape、trait application shape、generic binder / bound count、generic binder evidence mode を 1 record にまとめます。
//:
//: [契約/けいやく]:
//: - `module_fingerprint` は module identity / public surface seed が既に安定化された fingerprint です。source path 文字列そのものではありません。
//: - `declaration_ordinal` は full public surface input stream 上の 1-origin ordinal です。source byte offset や Vec index からこの module で推測しません。
//: - `target_type_shape_hash` は impl target type term の typed normalized hash です。
//: - `trait_application_shape_hash` は stable trait key と trait type argument identity を含む typed normalized hash です。`InherentImpl` ではこの field を読まず、kind を先に拒否します。
//: - `generic_binder_evidence` は count-only generic acceptance を防ぐための mode です。generic count が 1 以上なら detailed evidence が必須です。
pub struct SelfhostMemoTraitPublicImplHeaderInput:
    visibility %SelfhostModuleDeclarationVisibility
    module_fingerprint %i32
    declaration_ordinal %Option i32
    kind %SelfhostMemoTraitPublicImplHeaderKind
    target_type_shape_hash %Option i32
    trait_application_shape_hash %Option i32
    type_parameter_count %i32
    type_parameter_bound_count %i32
    generic_binder_evidence %SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence

//: SelfhostMemoTraitPublicImplHeaderErrorKind: public impl header producer の拒否理由
//:
//: [目的/もくてき]:
//: - visibility、stable key seed、typed impl shape、normalizer payload hash の失敗を同じ enum に潰さず保持します。
pub enum SelfhostMemoTraitPublicImplHeaderErrorKind:
    PrivateVisibilityRejected
    ModuleFingerprintPlaceholder
    DeclarationOrdinalMissing
    DeclarationOrdinalPlaceholder
    DeclarationOrdinalNegative
    InherentImplUnsupported
    TargetTypeShapeHashMissing
    TargetTypeShapeHashPlaceholder
    TraitApplicationShapeHashMissing
    TraitApplicationShapeHashPlaceholder
    TypeParameterCountNegative
    TypeParameterBoundCountNegative
    GenericImplUnsupported
    TypeParameterBoundUnsupported
    GenericBinderEvidenceMissing
    GenericBinderEvidenceUnexpected
    GenericBinderEvidenceParameterCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    GenericBinderEvidenceBoundCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    GenericBinderEvidenceParameterTableHashPlaceholder
    GenericBinderEvidenceBoundTableHashPlaceholder
    GenericBinderEvidenceHashPlaceholder
    StableImplKeyHashPlaceholder
    DerivedImplHeaderShapeHashPlaceholder
    PublicDeclarationPayloadRejected %SelfhostMemoTraitPublicSurfaceNormalizerErrorKind

//: SelfhostMemoTraitPublicImplHeaderStage0Summary: impl header producer の代表 smoke
//:
//: [目的/もくてき]:
//: - accepted trait impl path、trait application 差分、inherent / private / missing trait hash / placeholder target hash rejection をまとめます。
//: - public helper 単体が caller 側の検査済み前提に依存しないことも固定します。
pub struct SelfhostMemoTraitPublicImplHeaderStage0Summary:
    trait_impl %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    other_trait_impl %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    trait_impls_differ %bool
    inherent_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    private_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    trait_hash_missing_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    target_hash_placeholder_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    generic_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    generic_with_binder %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicImplHeaderErrorKind
    stable_key_inherent_rejected %Result SelfhostMemoTraitPublicImplHeaderStableKeyHash SelfhostMemoTraitPublicImplHeaderErrorKind
    stable_key_ordinal_rejected %Result SelfhostMemoTraitPublicImplHeaderStableKeyHash SelfhostMemoTraitPublicImplHeaderErrorKind

