//: selfhost_memo_trait_operation_method_body_fact_table_builder_push_hir_root_result: HIR root 由来 fact を table owner へ[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の table owner を返します。
//: - fact producer が失敗した場合は、`table` はまだ push に渡されていないため、この関数が必ず閉じます。
//: - table push が失敗した場合は、resolver table push が owner buffer を回収して閉じるため、この関数は二重解放しません。
//: - `Result::Err` の後に caller が元の `table` を再利用したり free したりしてはいけません。
//: - surface completeness、duplicate lookup、method body evidence 化はこの関数の責務ではありません。
pub fn selfhost_memo_trait_operation_method_body_fact_table_builder_push_hir_root_result %impure fn SelfhostMemoTraitOperationMethodBodyTable impure fn &SelfhostHirModule impure fn SelfhostTypeId impure fn SelfhostMemoTraitOperationEvidenceKind impure fn SelfhostHirExprId impure fn i32 Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind \table\module\type_id\operation\root\fuel:
    match selfhost_memo_trait_operation_method_body_fact_from_hir_root_result module type_id operation root fuel:
        Result::Ok fact:
            match selfhost_memo_trait_operation_method_body_table_push table fact:
                Result::Ok next_table:
                    Result::Ok next_table
                Result::Err table_error:
                    Result::Err selfhost_memo_trait_operation_method_body_fact_table_builder_table_error table_error
        Result::Err producer_error:
            selfhost_memo_trait_operation_method_body_table_free table
            Result::Err selfhost_memo_trait_operation_method_body_fact_table_builder_producer_error producer_error

