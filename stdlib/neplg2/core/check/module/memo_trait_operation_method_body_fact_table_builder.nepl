//:
//: [目的/もくてき]:
//: - 1 件 push、2 件連続 push、fact producer rejection の代表形を確認します。
pub struct SelfhostMemoTraitOperationMethodBodyFactTableBuilderStage0Summary:
    pure_push_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind
    external_after_pure_push_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind
    copy_rejected %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind
    error_expr_rejected %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind
    missing_root_rejected %Result i32 SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind

impl Clone for SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind SelfhostMemoTraitOperationMethodBodyFactTableBuilderErrorKind \self:
        *self

