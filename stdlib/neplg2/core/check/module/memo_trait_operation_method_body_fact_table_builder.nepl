impl Copy for SelfhostMemoTraitOperationMethodBodyFactTableBuilderStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactTableBuilderStage0Summary SelfhostMemoTraitOperationMethodBodyFactTableBuilderStage0Summary \self:
