#indent 4

//: # check/module/memo_trait_public_function_signature
//: public function declaration の typed signature evidence を public surface normalizer の payload input へ[変換/へんかん]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface hash が public function を source header の文字列ではなく、type arena 上の function type、function effect、stable declaration key から受け取れるようにします。
//: - `fn void T` の 0 引数 function type と `fn unit T` の unit 引数 function type を、`SelfhostFunctionTypeArgRange::Empty` と function argument table の違いとして hash material に反映します。
//: - named / applied type は `SelfhostNamedTypeId` を直接 fingerprint にせず、caller が用意した stable nominal key table を必ず通してから hash に入れます。
//: - normalizer が受け取る public declaration payload input と同じ schema で function payload hash を作り、function producer 側の evidence が normalizer の部分 stream API と同じ値域に入るようにします。
//:
//: [契約/けいやく]:
//: - accepted function declaration evidence は `SelfhostMemoTraitPublicFunctionSignatureInput` の typed field と `SelfhostTypeArena` / `SelfhostMemoTraitStableNominalKeyTable` だけから作ります。
//: - source text、span、lexeme、display name、diagnostic text、path suffix、HIR、Resource IR、backend artifact、proof store record は accepted hash material に入りません。
//: - `visibility` は `Public` だけを受理します。private function は public surface input ではないため typed error にします。
//: - `declaration_ordinal` と `stable_function_key_hash` は `some(nonzero)` でなければなりません。欠落と placeholder は別の enum error として返します。
//: - `function_type` は type arena 内の function record でなければなりません。unit 型そのものを function signature として渡した場合は `FunctionSignatureTypeNotFunction` で拒否します。
//: - generic parameter は binder depth と binder 内 index を hash material に入れます。この hash は caller が `stable_function_key_hash` で binder identity を固定していることを前提にします。
//:
//: [現状/げんじょう]:
//: - この module は public function signature producer の最初の接続点です。struct / enum layout header、impl header、re-export export table は別 producer で接続します。
//: - effect は現行 selfhost model の `SelfhostEffectKind` を fold します。将来 surface pure / impure と internal effect row を分離した場合は schema version を更新します。
//: - facade にはまだ re-export しません。full public surface orchestration が function / layout / impl producer をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - type shape hash は root function type から到達する型 record と argument edge の数を n、stable nominal key table の record 数を m とすると、現実装では O(n * m) です。
//: - primitive / parameter / function edge だけの signature は O(n) です。nominal lookup は後続で stable map 化できますが、hash material と error contract は変えません。
//: - declaration payload evidence 生成は shape hash 後に O(1) で normalizer payload hash へ委譲します。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_function_signature" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_public_function_signature_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check is_ok summary.zero_arg_function
//:             let checks2 checks_push checks1 check is_ok summary.unit_arg_function
//:             let checks3 checks_push checks2 check summary.zero_and_unit_arg_differ
//:             let private_error %SelfhostMemoTraitPublicFunctionSignatureErrorKind unwrap_err summary.private_rejected
//:             let checks4 checks_push checks3 check selfhost_memo_trait_public_function_signature_error_kind_eq private_error SelfhostMemoTraitPublicFunctionSignatureErrorKind::PrivateVisibilityRejected
//:             let missing_key_error %SelfhostMemoTraitPublicFunctionSignatureErrorKind unwrap_err summary.key_missing_rejected
//:             let checks5 checks_push checks4 check selfhost_memo_trait_public_function_signature_error_kind_eq missing_key_error SelfhostMemoTraitPublicFunctionSignatureErrorKind::StableFunctionKeyMissing
//:             let expected_type %SelfhostMemoTraitPublicFunctionSignatureErrorKind SelfhostMemoTraitPublicFunctionSignatureErrorKind::TypeHashRejected SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::FunctionSignatureTypeNotFunction
//:             let non_function_error %SelfhostMemoTraitPublicFunctionSignatureErrorKind unwrap_err summary.non_function_rejected
//:             let checks6 checks_push checks5 check selfhost_memo_trait_public_function_signature_error_kind_eq non_function_error expected_type
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _e:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *
#import "./memo_trait_public_surface_normalizer" as *

//: SelfhostMemoTraitPublicFunctionSignatureShapeHash: public function signature shape の normalized fingerprint
//:
//: [目的/もくてき]:
//: - type arena root と effect から作った function signature の shape hash を、schema version と一緒に保持します。
//:
//: [契約/けいやく]:
//: - `schema_version` は hash material の構造を表します。
//: - `root_hash` は nonzero でなければ accepted shape ではありません。
pub struct SelfhostMemoTraitPublicFunctionSignatureShapeHash:
    schema_version %i32
    root_hash %i32

//: SelfhostMemoTraitPublicFunctionSignatureInput: public function declaration producer の typed input
//:
//: [目的/もくてき]:
//: - public function declaration の stable key、ordinal、effect、typed function type を同じ record にまとめます。
//:
//: [契約/けいやく]:
//: - `stable_function_key_hash` は stable declaration key producer が作った nonzero hash です。
//: - `function_type` は `SelfhostTypeArena` 内の function record を指す必要があります。
//: - `effect` は public signature の effect field であり、function type shape hash と別に fold します。
pub struct SelfhostMemoTraitPublicFunctionSignatureInput:
    visibility %SelfhostModuleDeclarationVisibility
    declaration_ordinal %Option i32
    stable_function_key_hash %Option i32
    function_type %SelfhostTypeId
    effect %SelfhostEffectKind

//: SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind: type shape hash の拒否理由
//:
//: [目的/もくてき]:
//: - arena lookup、function root 検査、argument lookup、nominal key lookup、placeholder hash を typed error として区別します。
pub enum SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind:
    MissingTypeRecord
    FunctionSignatureTypeNotFunction
    MissingFunctionArgument
    MissingFunctionResult
    MissingAppliedArgument
    InvalidTypeParameterBinding
    NominalKeyRejected %SelfhostMemoTraitCanonicalFingerprintErrorKind
    TraversalFuelExhausted
    DerivedTypeHashPlaceholder
    DerivedSignatureShapeHashPlaceholder

//: SelfhostMemoTraitPublicFunctionSignatureErrorKind: public function signature producer の拒否理由
//:
//: [目的/もくてき]:
//: - visibility、ordinal、stable key、type hash、normalizer payload hash の失敗を同じ enum に潰さず保持します。
pub enum SelfhostMemoTraitPublicFunctionSignatureErrorKind:
    PrivateVisibilityRejected
    DeclarationOrdinalMissing
    DeclarationOrdinalPlaceholder
    StableFunctionKeyMissing
    StableFunctionKeyPlaceholder
    TypeHashRejected %SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind
    PublicDeclarationPayloadRejected %SelfhostMemoTraitPublicSurfaceNormalizerErrorKind

//: SelfhostMemoTraitPublicFunctionSignatureStage0Summary: function signature producer の代表 smoke
//:
//: [目的/もくてき]:
//: - `fn void unit` と `fn unit unit` の区別、private / missing key / non-function rejection をまとめます。
pub struct SelfhostMemoTraitPublicFunctionSignatureStage0Summary:
    zero_arg_function %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicFunctionSignatureErrorKind
    unit_arg_function %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicFunctionSignatureErrorKind
    zero_and_unit_arg_differ %bool
    private_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicFunctionSignatureErrorKind
    key_missing_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicFunctionSignatureErrorKind
    non_function_rejected %Result SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicFunctionSignatureErrorKind

impl Clone for SelfhostMemoTraitPublicFunctionSignatureShapeHash:
    fn clone %fn &SelfhostMemoTraitPublicFunctionSignatureShapeHash SelfhostMemoTraitPublicFunctionSignatureShapeHash \self:
        *self

impl Copy for SelfhostMemoTraitPublicFunctionSignatureShapeHash:
    fn copy_mark %fn SelfhostMemoTraitPublicFunctionSignatureShapeHash SelfhostMemoTraitPublicFunctionSignatureShapeHash \self:
        self

impl Clone for SelfhostMemoTraitPublicFunctionSignatureInput:
    fn clone %fn &SelfhostMemoTraitPublicFunctionSignatureInput SelfhostMemoTraitPublicFunctionSignatureInput \self:
        *self

impl Copy for SelfhostMemoTraitPublicFunctionSignatureInput:
    fn copy_mark %fn SelfhostMemoTraitPublicFunctionSignatureInput SelfhostMemoTraitPublicFunctionSignatureInput \self:
        self

impl Clone for SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicFunctionSignatureErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicFunctionSignatureErrorKind SelfhostMemoTraitPublicFunctionSignatureErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitPublicFunctionSignatureErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicFunctionSignatureErrorKind SelfhostMemoTraitPublicFunctionSignatureErrorKind \self:
        self

impl Clone for SelfhostMemoTraitPublicFunctionSignatureStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicFunctionSignatureStage0Summary SelfhostMemoTraitPublicFunctionSignatureStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitPublicFunctionSignatureStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicFunctionSignatureStage0Summary SelfhostMemoTraitPublicFunctionSignatureStage0Summary \self:
        self

//: selfhost_memo_trait_public_function_signature_input_new: typed input を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は field をまとめるだけです。visibility、ordinal、stable key、function type の検査は producer 本体で行います。
pub fn selfhost_memo_trait_public_function_signature_input_new %fn SelfhostModuleDeclarationVisibility fn Option i32 fn Option i32 fn SelfhostTypeId fn SelfhostEffectKind SelfhostMemoTraitPublicFunctionSignatureInput \visibility\declaration_ordinal\stable_function_key_hash\function_type\effect:
    SelfhostMemoTraitPublicFunctionSignatureInput visibility declaration_ordinal stable_function_key_hash function_type effect

//: selfhost_memo_trait_public_function_signature_schema_version: signature shape hash schema version
//:
//: [契約/けいやく]:
//: - effect folding、type node code、function argument fold、parameter binding fold、nominal key fold のどれかを変える場合はこの version を更新します。
//: - 既存 effect の stable code は schema version を変えずに移動してはなりません。新しい effect は append-only の code を使います。
fn selfhost_memo_trait_public_function_signature_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_function_signature_mix2: signature hash 用の 2 field [混合/こんごう]
fn selfhost_memo_trait_public_function_signature_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_function_signature_mix3: signature hash 用の 3 field [混合/こんごう]
fn selfhost_memo_trait_public_function_signature_mix3 %fn i32 fn i32 fn i32 i32 \a\b\c:
    mix xor selfhost_memo_trait_public_function_signature_mix2 a b c

//: selfhost_memo_trait_public_function_signature_mix4: signature hash 用の 4 field [混合/こんごう]
fn selfhost_memo_trait_public_function_signature_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_function_signature_mix2 (selfhost_memo_trait_public_function_signature_mix2 a b) (selfhost_memo_trait_public_function_signature_mix2 c d)

//: selfhost_memo_trait_public_function_signature_payload_schema_code: public declaration payload schema の domain code
//:
//: [契約/けいやく]:
//: - normalizer の `SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput` と同じ field 構成を hash へ畳みます。
//: - この helper は facade 公開されません。normalizer の内部 adapter を公開 API に漏らさず、function producer が同じ typed payload contract に従うための局所境界です。
fn selfhost_memo_trait_public_function_signature_payload_schema_code %fn void i32 \void:
    252301

//: selfhost_memo_trait_public_function_signature_payload_kind_code: public declaration kind を payload domain code へ[写/うつ]す
fn selfhost_memo_trait_public_function_signature_payload_kind_code %fn SelfhostMemoTraitPublicSurfacePublicDeclarationKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Function:
            252311
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Struct:
            252312
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Enum:
            252313
        SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Impl:
            252314

//: selfhost_memo_trait_public_function_signature_payload_hash_result: payload input から stable hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - stable declaration key と normalized declaration shape は nonzero でなければなりません。
//: - source text、span、display name、diagnostic text は読まず、payload input の typed field だけを authority にします。
//: - normalizer の内部 adapter と同じ placeholder error kind を返し、呼び出し側が public function producer の error enum へ包めるようにします。
fn selfhost_memo_trait_public_function_signature_payload_hash_result %fn SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \input:
    if:
        eq input.stable_declaration_key_hash 0
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StableDeclarationKeyHashPlaceholder
        else:
            if:
                eq input.normalized_declaration_shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::NormalizedDeclarationShapeHashPlaceholder
                else:
                    let kind_hash %i32 selfhost_memo_trait_public_function_signature_payload_kind_code input.kind
                    let header_hash %i32 selfhost_memo_trait_public_function_signature_mix3 selfhost_memo_trait_public_function_signature_payload_schema_code kind_hash input.stable_declaration_key_hash
                    let payload_hash %i32 selfhost_memo_trait_public_function_signature_mix2 header_hash input.normalized_declaration_shape_hash
                    if:
                        eq payload_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DerivedDeclarationPayloadHashPlaceholder
                        else:
                            Result::Ok payload_hash

//: selfhost_memo_trait_public_function_signature_nonzero_type_hash_result: derived hash の placeholder を[拒否/きょひ]する
fn selfhost_memo_trait_public_function_signature_nonzero_type_hash_result %fn i32 Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \hash:
    if:
        eq hash 0
        then:
            Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::DerivedTypeHashPlaceholder
        else:
            Result::Ok hash

//: selfhost_memo_trait_public_function_signature_primitive_code: primitive type を stable node code へ[写/うつ]す
fn selfhost_memo_trait_public_function_signature_primitive_code %fn SelfhostPrimitiveTypeKind i32 \kind:
    match kind:
        SelfhostPrimitiveTypeKind::Error:
            331001
        SelfhostPrimitiveTypeKind::Unit:
            331002
        SelfhostPrimitiveTypeKind::Bool:
            331003
        SelfhostPrimitiveTypeKind::I32:
            331004
        SelfhostPrimitiveTypeKind::I64:
            331005
        SelfhostPrimitiveTypeKind::U8:
            331006
        SelfhostPrimitiveTypeKind::Char:
            331007
        SelfhostPrimitiveTypeKind::Str:
            331008
        SelfhostPrimitiveTypeKind::F32:
            331009
        SelfhostPrimitiveTypeKind::F64:
            331010
        SelfhostPrimitiveTypeKind::Never:
            331011

//: selfhost_memo_trait_public_function_signature_effect_code: function effect を stable node code へ[写/うつ]す
fn selfhost_memo_trait_public_function_signature_effect_code %fn SelfhostEffectKind i32 \effect:
    match effect:
        SelfhostEffectKind::Pure:
            332001
        SelfhostEffectKind::InternalAlloc:
            332002
        SelfhostEffectKind::PrivateState:
            332006
        SelfhostEffectKind::PrivateCache:
            332007
        SelfhostEffectKind::UnsafeMemory:
            332003
        SelfhostEffectKind::ExternalIo:
            332004
        SelfhostEffectKind::Nondet:
            332005

//: selfhost_memo_trait_public_function_signature_nominal_error: canonical nominal error を local type hash error へ[写/うつ]す
fn selfhost_memo_trait_public_function_signature_nominal_error %fn SelfhostMemoTraitCanonicalFingerprintErrorKind SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \error:
    SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::NominalKeyRejected error

//: selfhost_memo_trait_public_function_signature_primitive_type_hash_result: primitive type hash を[作/つく]る
fn selfhost_memo_trait_public_function_signature_primitive_type_hash_result %fn SelfhostPrimitiveTypeKind Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \kind:
    selfhost_memo_trait_public_function_signature_nonzero_type_hash_result:
        selfhost_memo_trait_public_function_signature_mix3 333001 selfhost_memo_trait_public_function_signature_schema_version selfhost_memo_trait_public_function_signature_primitive_code kind

//: selfhost_memo_trait_public_function_signature_parameter_type_hash_result: generic parameter type hash を[作/つく]る
//:
//: [契約/けいやく]:
//: - binding が invalid な場合は hash に進めません。
//: - source name は読まず、binder depth と binder 内 index だけを使います。
fn selfhost_memo_trait_public_function_signature_parameter_type_hash_result %fn SelfhostTypeParameterBinding Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \binding:
    if:
        not selfhost_type_parameter_binding_is_valid binding
        then:
            Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::InvalidTypeParameterBinding
        else:
            selfhost_memo_trait_public_function_signature_nonzero_type_hash_result:
                selfhost_memo_trait_public_function_signature_mix4 333002 selfhost_memo_trait_public_function_signature_schema_version binding.binder_depth binding.parameter_index

//: selfhost_memo_trait_public_function_signature_named_type_hash_result: named type hash を stable nominal key から[作/つく]る
fn selfhost_memo_trait_public_function_signature_named_type_hash_result %fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostNamedTypeId Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \nominal_table\nominal_id:
    match selfhost_memo_trait_stable_nominal_key_table_find_result nominal_table nominal_id:
        Result::Ok key:
            selfhost_memo_trait_public_function_signature_nonzero_type_hash_result:
                selfhost_memo_trait_public_function_signature_mix3 333003 selfhost_memo_trait_public_function_signature_schema_version key.nominal_key_hash
        Result::Err e:
            Result::Err selfhost_memo_trait_public_function_signature_nominal_error e

//: selfhost_memo_trait_public_function_signature_type_hash_with_fuel_result: type arena record を stable type shape hash へ[投影/とうえい]する
//:
//: [契約/けいやく]:
//: - `fuel` は malformed cyclic graph への防御境界です。正常な `SelfhostTypeArena` は木またはDAGとして終端します。
//: - source text、span、display name は読まず、arena record と stable nominal key table だけを authority とします。
fn selfhost_memo_trait_public_function_signature_type_hash_with_fuel_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostTypeId fn i32 Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \arena\nominal_table\type_id\fuel:
    if:
        le fuel 0
        then:
            Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::TraversalFuelExhausted
        else:
            match selfhost_type_arena_get_record arena type_id:
                Option::Some record:
                    match record:
                        SelfhostTypeRecord::Primitive kind:
                            selfhost_memo_trait_public_function_signature_primitive_type_hash_result kind
                        SelfhostTypeRecord::Named named:
                            selfhost_memo_trait_public_function_signature_named_type_hash_result nominal_table named.nominal_id
                        SelfhostTypeRecord::Parameter parameter:
                            selfhost_memo_trait_public_function_signature_parameter_type_hash_result parameter.binding
                        SelfhostTypeRecord::Applied applied:
                            selfhost_memo_trait_public_function_signature_applied_type_hash_result arena nominal_table applied sub fuel 1
                        SelfhostTypeRecord::Function _function:
                            selfhost_memo_trait_public_function_signature_function_type_hash_result arena nominal_table type_id sub fuel 1
                Option::None:
                    Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::MissingTypeRecord

//: selfhost_memo_trait_public_function_signature_function_args_hash_result: function 引数列の shape hash を[作/つく]る
fn selfhost_memo_trait_public_function_signature_function_args_hash_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostTypeId fn i32 fn i32 fn i32 fn i32 Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \arena\nominal_table\function_type\arg_count\idx\acc\fuel:
    if:
        ge idx arg_count
        then:
            Result::Ok acc
        else:
            match selfhost_type_arena_function_arg arena function_type idx:
                Option::Some arg_type:
                    match selfhost_memo_trait_public_function_signature_type_hash_with_fuel_result arena nominal_table arg_type sub fuel 1:
                        Result::Ok arg_hash:
                            let next_acc %i32 selfhost_memo_trait_public_function_signature_mix3 acc add idx 1 arg_hash
                            if:
                                eq next_acc 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::DerivedTypeHashPlaceholder
                                else:
                                    selfhost_memo_trait_public_function_signature_function_args_hash_result arena nominal_table function_type arg_count add idx 1 next_acc sub fuel 1
                        Result::Err e:
                            Result::Err e
                Option::None:
                    Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::MissingFunctionArgument

//: selfhost_memo_trait_public_function_signature_function_type_hash_result: function type hash を[作/つく]る
fn selfhost_memo_trait_public_function_signature_function_type_hash_result %fn &SelfhostTypeArena fn &SelfhostMemoTraitStableNominalKeyTable fn SelfhostTypeId fn i32 Result i32 SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind \arena\nominal_table\function_type\fuel:
    match selfhost_type_arena_function_arg_count arena function_type:
        Option::Some arg_count:
            match selfhost_type_arena_function_result arena function_type:
                Option::Some result_type:
                    match selfhost_memo_trait_public_function_signature_function_args_hash_result arena nominal_table function_type arg_count 0 (selfhost_memo_trait_public_function_signature_mix3 333004 selfhost_memo_trait_public_function_signature_schema_version arg_count) fuel:
                        Result::Ok args_hash:
                            match selfhost_memo_trait_public_function_signature_type_hash_with_fuel_result arena nominal_table result_type sub fuel 1:
                                Result::Ok result_hash:
                                    selfhost_memo_trait_public_function_signature_nonzero_type_hash_result:
                                        selfhost_memo_trait_public_function_signature_mix4 333005 selfhost_memo_trait_public_function_signature_schema_version args_hash result_hash
                                Result::Err result_error:
                                    Result::Err result_error
                        Result::Err args_error:
                            Result::Err args_error
                Option::None:
                    Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::MissingFunctionResult
        Option::None:
            Result::Err SelfhostMemoTraitPublicFunctionSignatureTypeHashErrorKind::FunctionSignatureTypeNotFunction

