//: - `Err(error)`: Vec / arena / nominal table の確保に失敗しました。
//:
//: [計算量/けいさんりょう]:
//: - 固定個数の型だけを構築するため O(1) です。
pub fn selfhost_memo_trait_public_function_signature_stage0 %impure fn void Result SelfhostMemoTraitPublicFunctionSignatureStage0Summary StdErrorKind \void:
    match selfhost_type_arena_new:
        Result::Ok arena0:
            match selfhost_type_arena_add_primitive arena0 SelfhostPrimitiveTypeKind::Unit:
                Result::Ok allocated_unit:
                    let unit_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_unit
                    let arena1 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_unit
                    match selfhost_memo_trait_public_function_signature_stage0_add_zero_function arena1 unit_id:
                        Result::Ok allocated_zero:
                            let zero_function_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_zero
                            let arena2 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_zero
                            match selfhost_memo_trait_public_function_signature_stage0_add_unary_function arena2 unit_id unit_id:
                                Result::Ok allocated_unit_function:
                                    let unit_function_id %SelfhostTypeId selfhost_type_arena_alloc_type_id &allocated_unit_function
                                    let arena3 %SelfhostTypeArena selfhost_type_arena_alloc_into_arena allocated_unit_function
                                    match selfhost_memo_trait_stable_nominal_key_table_new:
                                        Result::Ok nominal_table:
                                            selfhost_memo_trait_public_function_signature_stage0_from_arena arena3 nominal_table unit_id zero_function_id unit_function_id
                                        Result::Err e:
                                            selfhost_type_arena_free arena3
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e
