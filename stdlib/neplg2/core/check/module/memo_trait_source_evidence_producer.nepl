//: selfhost_memo_trait_stable_source_evidence_table_from_seed_table_result: typed seed table から stable evidence table を[作/つく]る
//:
//: [目的/もくてき]:
//: - public surface materializer の typed seed を、既存 stable source fingerprint gate が読む evidence table へ変換します。
//:
//: [契約/けいやく]:
//: - この関数は `SelfhostMemoTraitDefinitionSourceRecord` を作りません。signature_available の昇格は既存 fingerprint gate の責務です。
//: - seed table 側の欠落・重複・kind mismatch・private visibility・placeholder は `Result::Err` で拒否します。
pub fn selfhost_memo_trait_stable_source_evidence_table_from_seed_table_result %fn SelfhostMemoTraitStableSourceModuleSeed fn SelfhostMemoTraitStableSourceSeedTable Result SelfhostMemoTraitStableSourceEvidenceTable SelfhostMemoTraitStableSourceSeedErrorKind \module_seed\seed_table:
    if:
        seed_table.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitStableSourceSeedErrorKind::MemoKeySeedDuplicate
        else:
            if:
                seed_table.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitStableSourceSeedErrorKind::MemoValueSeedDuplicate
                else:
                    match selfhost_memo_trait_stable_source_seed_module_hash_result module_seed:
                        Result::Ok module_hash:
                            match seed_table.memo_key:
                                Option::Some key_seed:
                                    match seed_table.memo_value:
                                        Option::Some value_seed:
                                            selfhost_memo_trait_stable_source_seed_table_records_to_evidence_result module_hash module_seed key_seed value_seed
                                        Option::None:
                                            Result::Err SelfhostMemoTraitStableSourceSeedErrorKind::MemoValueSeedMissing
                                Option::None:
                                    Result::Err SelfhostMemoTraitStableSourceSeedErrorKind::MemoKeySeedMissing
                        Result::Err module_error:
                            Result::Err module_error

