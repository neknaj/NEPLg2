//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_record_new: traversal summary record を[作/つく]る
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalStatus fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalReason SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord \type_id\body_module_fingerprint\body_root\effect\escape\status\reason:
    SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord type_id body_module_fingerprint body_root effect escape status reason

//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_new: [空/から]の traversal summary table を[作/つく]る
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_new %impure fn void Result SelfhostMemoTraitOperationDropResourceNoEscapeTraversalTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationDropResourceNoEscapeTraversalTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_free: traversal summary table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_free %impure fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_len: traversal summary record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_len %fn &SelfhostMemoTraitOperationDropResourceNoEscapeTraversalTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_drop_resource_no_escape_materializer_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_materializer_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_record_key_eq: 2 traversal record が同じ Drop body summary key か[返/かえ]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_record_key_eq %fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            eq a.body_module_fingerprint b.body_module_fingerprint
            and:
                eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                and:
                    selfhost_effect_kind_eq a.effect b.effect
                    selfhost_memo_trait_operation_drop_resource_no_escape_materializer_escape_state_eq a.escape b.escape

//: selfhost_memo_trait_operation_drop_resource_no_escape_materializer_validate_record_result: traversal summary record の受理条件を[確認/かくにん]する
//:
//: [契約/けいやく]:
//: - validation は table push と materializer loop の両方で呼びます。外部から直接組み立てられた malformed table でも materializer が fail-closed に止まるためです。
fn selfhost_memo_trait_operation_drop_resource_no_escape_materializer_validate_record_result %fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord Result unit SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind \record:
    if:
        eq record.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                selfhost_effect_kind_eq record.effect SelfhostEffectKind::InternalAlloc
                then:
                    match record.escape:
                        SelfhostEffectEscapeState::NotApplicable:
                            Result::Ok unit
                        SelfhostEffectEscapeState::NoEscapeProven:
                            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind::TraversalEscapeNotApplicable record.escape
                        SelfhostEffectEscapeState::MayEscape:
                            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind::TraversalEscapeNotApplicable record.escape
                else:
                    Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeMaterializerErrorKind::TraversalEffectNotInternalAlloc record.effect

//: selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_contains_key_loop: input table 内の既存 key を[探/さが]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_contains_key_loop %fn &SelfhostMemoTraitOperationDropResourceNoEscapeTraversalTable fn SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord fn i32 bool \table\record\idx:
    if:
        ge idx selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_len table
        then:
            false
        else:
            let records %&Vec SelfhostMemoTraitOperationDropResourceNoEscapeTraversalRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some existing:
                    if:
                        selfhost_memo_trait_operation_drop_resource_no_escape_traversal_record_key_eq existing record
                        then:
                            true
                        else:
                            selfhost_memo_trait_operation_drop_resource_no_escape_traversal_table_contains_key_loop table record add idx 1
                Option::None:
                    true

