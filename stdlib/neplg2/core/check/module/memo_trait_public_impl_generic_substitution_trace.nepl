//: selfhost_memo_trait_public_impl_generic_substitution_trace_record_new: trace record を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_record_new %fn i32 fn SelfhostTypeParameterBinding fn i32 fn i32 fn SelfhostMemoTraitStableTypeArgumentIdentityEntry SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord \parameter_ordinal\binding\stable_symbol_hash\argument_ordinal\argument_identity_entry:
    SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord parameter_ordinal binding stable_symbol_hash argument_ordinal argument_identity_entry

//: selfhost_memo_trait_public_impl_generic_substitution_trace_table_new: [空/から]の trace table を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_table_new %impure fn void Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable records
        Result::Err e:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceTableAllocFailed e

//: selfhost_memo_trait_public_impl_generic_substitution_trace_table_free: trace table owner を[閉/と]じる
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_table_free %impure fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_public_impl_generic_substitution_trace_table_len: trace record 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_table_len %fn &SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable i32 \table:
    let records %&Vec SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_public_impl_generic_substitution_trace_table_push: trace record を[追加/ついか]する
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_table_push %impure fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable impure fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \table\record:
    let records %Vec SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TracePushFailed error

//: selfhost_memo_trait_public_impl_generic_substitution_trace_schema_version: trace evidence schema version
pub fn selfhost_memo_trait_public_impl_generic_substitution_trace_schema_version %fn void i32 \void:
    1

//: selfhost_memo_trait_public_impl_generic_substitution_trace_mix2: trace hash 用の 2 field [混合/こんごう]
fn selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 %fn i32 fn i32 i32 \a\b:
    mix xor mix a b

//: selfhost_memo_trait_public_impl_generic_substitution_trace_mix4: trace hash 用の 4 field [混合/こんごう]
fn selfhost_memo_trait_public_impl_generic_substitution_trace_mix4 %fn i32 fn i32 fn i32 fn i32 i32 \a\b\c\d:
    selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 (selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 a b) (selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 c d)

//: selfhost_memo_trait_public_impl_generic_substitution_trace_binder_hash_result: binder evidence を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_trace_binder_hash_result %fn SelfhostMemoTraitPublicImplGenericBinderEvidence Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \evidence:
    if:
        eq evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::BinderEvidenceSchemaPlaceholder
        else:
            if:
                eq evidence.shape_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::BinderEvidenceHashPlaceholder
                else:
                    if:
                        lt evidence.type_parameter_count 1
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::GenericParameterCountMissing
                        else:
                            if:
                                lt evidence.type_parameter_bound_count 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeParameterBoundCountNegative
                                else:
                                    Result::Ok evidence.shape_hash

//: selfhost_memo_trait_public_impl_generic_substitution_trace_identity_result: type argument identity owner を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - trace producer が raw aggregate hash だけを受け入れず、ordered entry vector と schema 付き hash が同じ authority から来ていることを確認します。
//: - `SelfhostMemoTraitStableTypeArgumentIdentity` の entry vector から同じ fold schema で hash を再計算し、保存されている aggregate hash と一致した場合だけ trace evidence へ進めます。
fn selfhost_memo_trait_public_impl_generic_substitution_trace_identity_result %fn &SelfhostMemoTraitStableTypeArgumentIdentity fn i32 Result SelfhostMemoTraitStableTypeArgumentIdentityHash SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \identity\argument_count:
    let entries %&Vec SelfhostMemoTraitStableTypeArgumentIdentityEntry field::get_ref identity "entries"
    let hash %SelfhostMemoTraitStableTypeArgumentIdentityHash *field::get_ref identity "identity_hash"
    if:
        eq hash.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentitySchemaPlaceholder
        else:
            if:
                eq hash.identity_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentityHashPlaceholder
                else:
                    match selfhost_memo_trait_stable_type_argument_identity_hash_from_entries_result entries argument_count:
                        Result::Ok computed_hash:
                            if:
                                not eq computed_hash.schema_version hash.schema_version
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentityAggregateMismatch
                                else:
                                    if:
                                        not eq computed_hash.identity_hash hash.identity_hash
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentityAggregateMismatch
                                        else:
                                            Result::Ok hash
                        Result::Err e:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentityAggregateRejected e

//: selfhost_memo_trait_public_impl_generic_substitution_trace_entry_material_result: type argument entry を trace hash material へ[写/うつ]す
fn selfhost_memo_trait_public_impl_generic_substitution_trace_entry_material_result %fn SelfhostMemoTraitStableTypeArgumentIdentityEntry fn i32 Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \entry\index:
    if:
        eq entry.canonical_fingerprint.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::ArgumentFingerprintSchemaPlaceholder index
        else:
            if:
                eq entry.canonical_fingerprint.root_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::ArgumentFingerprintHashPlaceholder index
                else:
                    if:
                        eq entry.canonical_payload_hash.schema_version 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::ArgumentPayloadSchemaPlaceholder index
                        else:
                            if:
                                eq entry.canonical_payload_hash.payload_hash 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::ArgumentPayloadHashPlaceholder index
                                else:
                                    let fingerprint_material %i32 selfhost_memo_trait_public_impl_generic_substitution_trace_mix4 991101 entry.canonical_fingerprint.schema_version entry.canonical_fingerprint.root_hash entry.ordinal
                                    let payload_material %i32 selfhost_memo_trait_public_impl_generic_substitution_trace_mix4 991102 entry.canonical_payload_hash.schema_version entry.canonical_payload_hash.payload_hash entry.ordinal
                                    Result::Ok selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 fingerprint_material payload_material

//: selfhost_memo_trait_public_impl_generic_substitution_trace_record_hash: trace record hash を[作/つく]る
fn selfhost_memo_trait_public_impl_generic_substitution_trace_record_hash %fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord fn i32 i32 \record\entry_material:
    let binding_material %i32 selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 record.binding.binder_depth record.binding.parameter_index
    let parameter_material %i32 selfhost_memo_trait_public_impl_generic_substitution_trace_mix4 991201 record.parameter_ordinal binding_material record.stable_symbol_hash
    let argument_material %i32 selfhost_memo_trait_public_impl_generic_substitution_trace_mix4 991202 record.argument_ordinal record.argument_identity_entry.ordinal entry_material
    selfhost_memo_trait_public_impl_generic_substitution_trace_mix2 parameter_material argument_material

//: selfhost_memo_trait_public_impl_generic_substitution_trace_identity_entry_eq: trace record entry と identity owner entry が同じか[返/かえ]す
//:
//: [目的/もくてき]:
//: - trace table が持つ copied entry と stable type argument identity の owner entry を、ordinal、fingerprint、payload hash まで照合します。
//: - aggregate hash の一致だけでは collision や壊れた保存形式を説明できないため、trace evidence では ordered entry material も直接確認します。
fn selfhost_memo_trait_public_impl_generic_substitution_trace_identity_entry_eq %fn SelfhostMemoTraitStableTypeArgumentIdentityEntry fn SelfhostMemoTraitStableTypeArgumentIdentityEntry bool \record_entry\identity_entry:
    let ordinal_eq %bool eq record_entry.ordinal identity_entry.ordinal
    let fingerprint_schema_eq %bool eq record_entry.canonical_fingerprint.schema_version identity_entry.canonical_fingerprint.schema_version
    let fingerprint_hash_eq %bool eq record_entry.canonical_fingerprint.root_hash identity_entry.canonical_fingerprint.root_hash
    let payload_schema_eq %bool eq record_entry.canonical_payload_hash.schema_version identity_entry.canonical_payload_hash.schema_version
    let payload_hash_eq %bool eq record_entry.canonical_payload_hash.payload_hash identity_entry.canonical_payload_hash.payload_hash
    let fingerprint_eq %bool and fingerprint_schema_eq fingerprint_hash_eq
    let payload_eq %bool and payload_schema_eq payload_hash_eq
    let body_eq %bool and fingerprint_eq payload_eq
    and ordinal_eq body_eq

//: selfhost_memo_trait_public_impl_generic_substitution_trace_validate_record_result: parameter record と trace record の 1 対応を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_substitution_trace_validate_record_result %fn SelfhostMemoTraitPublicImplGenericParameter fn SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord fn SelfhostMemoTraitStableTypeArgumentIdentityEntry fn i32 Result i32 SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind \parameter\record\identity_entry\index:
    let expected_parameter_ordinal %i32 add index 1
    if:
        lt record.parameter_ordinal 1
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterOrdinalPlaceholder index
        else:
            if:
                not eq record.parameter_ordinal expected_parameter_ordinal
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterOrdinalMismatch SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch index expected_parameter_ordinal record.parameter_ordinal
                else:
                    if:
                        not eq record.parameter_ordinal parameter.parameter_ordinal
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterOrdinalMismatch SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch index parameter.parameter_ordinal record.parameter_ordinal
                        else:
                            if:
                                not selfhost_type_parameter_binding_is_valid record.binding
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterBindingInvalid index
                                else:
                                    if:
                                        not eq record.binding.binder_depth parameter.binding.binder_depth
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterBindingDepthUnsupported index
                                        else:
