#indent 4

//: # check/module/memo_trait_public_impl_generic_substitution_trace
//: public generic trait impl の type parameter binder と concrete type argument identity を、substitution engine が読む trace evidence として[結/むす]びつける checker-layer module です。
//:
//: [目的/もくてき]:
//: - generic substitution shape producer が `substitution_trace_shape_hash` を raw hash として受け取る状態を残すと、actual substitution engine を通らない値でも generic instantiation の root hash に混ざります。
//: - この module は、type parameter binder の ordinal / binding / stable symbol hash と、stable type argument identity entry の ordinal / fingerprint / payload hash を対応付ける typed trace table を検査します。
//: - actual type substitution engine が型式木を書き換える前段として、どの binder slot がどの concrete type argument slot に対応したかを、source text や display string ではなく typed record で保存します。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostMemoTraitPublicImplGenericParameterTable`、`SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable`、`SelfhostMemoTraitPublicImplGenericBinderEvidence`、`SelfhostMemoTraitStableTypeArgumentIdentity` の typed field だけです。
//: - source text、span、lexeme、display name、diagnostic text、module path、public surface hash、HIR、Resource IR、backend artifact、proof store record は accepted trace material に入りません。
//: - binder evidence の schema / shape hash は nonzero で、type parameter count は 1 以上でなければなりません。monomorphic impl は trace を持たない別経路です。
//: - type argument identity は entry vector と aggregate hash を再照合します。hash value だけを authority として扱いません。
//: - parameter table length、trace table length、type argument count は binder evidence の type parameter count と一致しなければなりません。
//: - trace record は table order と同じ parameter ordinal、`SelfhostTypeParameterBinding`、stable symbol hash、argument ordinal、stable type argument identity entry を持たなければなりません。
//: - fingerprint schema / root hash、payload schema / payload hash はすべて nonzero でなければなりません。
//: - この module は actual type substitution engine ではありません。substituted target / trait application shape の正しさ、trait bound solving、generic coherence、operation candidate materializer、PrivateCache / PrivateState effect masking は後続 stage が別 evidence として検査します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では substitution trace table の authority boundary を固定します。型式木の traversal、型引数置換、output shape producer との完全照合は次段階に残します。
//: - `memo_trait_operation_public_impl_materializer` の `GenericImplInstantiationUnsupported` は維持します。この evidence だけで generic impl を operation candidate へ進めてはいけません。
//: - stage0 smoke は resource static check の既知ボトルネックにより、通常 doctest timeout では skip します。focused 検証では `NEPL_TEST_CASE_TIMEOUT_MS=120000` を指定して実行し、source policy で契約構造を常時確認します。
//:
//: [計算量/けいさんりょう]:
//: - type parameter 数を n とすると、trace evidence 生成は O(n) 時間です。
//: - 追加空間は accumulator と loop index だけなので O(1) です。table owner は caller が持ち、この module は borrow で読みます。
//:
//: neplg2:test[skip, stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_generic_binder" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_generic_substitution_trace" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_public_impl_generic_substitution_trace_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check is_ok summary.accepted
//:             let checks2 checks_push checks1 check selfhost_memo_trait_public_impl_generic_substitution_trace_error_result_eq summary.argument_mismatch SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new 2 1
//:             let checks3 checks_push checks2 check selfhost_memo_trait_public_impl_generic_substitution_trace_error_result_eq summary.identity_placeholder SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TypeArgumentIdentityHashPlaceholder
//:             let checks4 checks_push checks3 check selfhost_memo_trait_public_impl_generic_substitution_trace_error_result_eq summary.trace_count_mismatch SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceRecordCountMismatch selfhost_memo_trait_public_impl_generic_binder_count_mismatch_new 2 1
//:             let checks5 checks_push checks4 check selfhost_memo_trait_public_impl_generic_substitution_trace_error_result_eq summary.binding_mismatch SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::TraceParameterBindingIndexMismatch SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch 1 1 0
//:             let checks6 checks_push checks5 check selfhost_memo_trait_public_impl_generic_substitution_trace_error_result_eq summary.fingerprint_placeholder SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind::ArgumentFingerprintHashPlaceholder 0
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "generic substitution trace stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/field" as field
#import "core/math" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_canonical_key" as *
#import "neplg2/core/ty/ty/memo_trait_canonical_key_payload" as *
#import "neplg2/core/ty/ty/memo_trait_type_argument_identity" as *
#import "./memo_trait_public_impl_generic_binder" as *

//: SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord: 1 binder slot と 1 type argument entry の対応 record
//:
//: [契約/けいやく]:
//: - `parameter_ordinal` は 1-origin で、parameter table order と一致します。
//: - `binding` と `stable_symbol_hash` は binder detail table の対応 record と一致しなければなりません。
//: - `argument_ordinal` は 0-origin で、`argument_identity_entry.ordinal` と一致しなければなりません。
//: - `argument_identity_entry` は stable type argument identity producer が作る entry shape と同じ payload を運びます。
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord:
    parameter_ordinal %i32
    binding %SelfhostTypeParameterBinding
    stable_symbol_hash %i32
    argument_ordinal %i32
    argument_identity_entry %SelfhostMemoTraitStableTypeArgumentIdentityEntry

//: SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable: substitution trace record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。evidence API は borrow で読み、table を閉じません。
//: - caller は不要になった table を `selfhost_memo_trait_public_impl_generic_substitution_trace_table_free` で閉じます。
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionTraceTable:
    records %Vec SelfhostMemoTraitPublicImplGenericSubstitutionTraceRecord

//: SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence: accepted substitution trace evidence
//:
//: [契約/けいやく]:
//: - `trace_shape_hash` は schema、binder evidence、type argument identity、parameter-to-argument record 全体を畳み込んだ nonzero hash です。
//: - `type_argument_identity_hash` は aggregate hash だけでなく schema と一緒に保持します。
//: - この evidence は output shape の正しさを証明しません。後続の substitution shape producer が pre-shape / trace / output-shape の整合を別途検査します。
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence:
    schema_version %i32
    type_parameter_count %i32
    type_argument_count %i32
    type_parameter_bound_count %i32
    generic_binder_shape_hash %i32
    type_argument_identity_hash %SelfhostMemoTraitStableTypeArgumentIdentityHash
    trace_record_count %i32
    trace_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind: substitution trace producer の拒否理由
pub enum SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind:
    TraceTableAllocFailed %StdErrorKind
    TracePushFailed %StdErrorKind
    ParameterTableSetupRejected %SelfhostMemoTraitPublicImplGenericBinderErrorKind
    BinderEvidenceSchemaPlaceholder
    BinderEvidenceHashPlaceholder
    GenericParameterCountMissing
    TypeParameterBoundCountNegative
    TypeArgumentCountNegative
    TypeArgumentCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    TypeArgumentIdentitySchemaPlaceholder
    TypeArgumentIdentityHashPlaceholder
    TypeArgumentIdentityAggregateRejected %SelfhostMemoTraitStableTypeArgumentIdentityErrorKind
    TypeArgumentIdentityAggregateMismatch
    ParameterRecordCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    TraceRecordCountMismatch %SelfhostMemoTraitPublicImplGenericBinderCountMismatch
    ParameterRecordReadFailed %i32
    TraceRecordReadFailed %i32
    TypeArgumentIdentityEntryReadFailed %i32
    TraceParameterOrdinalPlaceholder %i32
    TraceParameterOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    TraceParameterBindingInvalid %i32
    TraceParameterBindingDepthUnsupported %i32
    TraceParameterBindingIndexMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    TraceParameterSymbolHashPlaceholder %i32
    TraceParameterSymbolHashMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    TraceArgumentOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    TraceArgumentEntryOrdinalMismatch %SelfhostMemoTraitPublicImplGenericBinderOrdinalMismatch
    TraceArgumentIdentityEntryMismatch %i32
    ArgumentFingerprintSchemaPlaceholder %i32
    ArgumentFingerprintHashPlaceholder %i32
    ArgumentPayloadSchemaPlaceholder %i32
    ArgumentPayloadHashPlaceholder %i32
    DerivedTraceShapeHashPlaceholder

//: SelfhostMemoTraitPublicImplGenericSubstitutionTraceStage0Summary: trace producer smoke の代表結果
pub struct SelfhostMemoTraitPublicImplGenericSubstitutionTraceStage0Summary:
    accepted %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind
    argument_mismatch %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind
    identity_placeholder %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind
    trace_count_mismatch %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind
    binding_mismatch %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind
    fingerprint_placeholder %Result SelfhostMemoTraitPublicImplGenericSubstitutionTraceEvidence SelfhostMemoTraitPublicImplGenericSubstitutionTraceErrorKind

