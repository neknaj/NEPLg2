//: SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord: coherence table に[保持/ほじ]する accepted generic impl key
//:
//: [契約/けいやく]:
//: - `declaration_ordinal` は source scanner / materializer が割り当てる public impl declaration ordinal です。0 以下は placeholder として扱います。
//: - canonical fingerprint と payload hash は schema 付きで保持します。root hash だけ、final shape だけ、connector hash だけで coherence key を作ることを避けるためです。
pub struct SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord:
    declaration_ordinal %i32
    instantiation_shape_hash %i32
    connector_shape_hash %i32
    target_canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    target_canonical_payload_hash %SelfhostMemoTraitCanonicalKeyPayloadHash
    target_final_shape_hash %i32
    trait_application_canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    trait_application_canonical_payload_hash %SelfhostMemoTraitCanonicalKeyPayloadHash
    trait_application_final_shape_hash %i32
    coherence_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable: coherence record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。caller は不要になった時点で `selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_free` で閉じます。
//: - table は shallow Clone / Copy を提供しません。record だけが Copy 可能です。
pub struct SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable:
    records %Vec SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord

//: SelfhostMemoTraitPublicImplGenericConcreteCoherenceEvidence: accepted coherence evidence
//:
//: [契約/けいやく]:
//: - `coherence_shape_hash` は declaration ordinal、connector shape、instantiation shape、canonical target / trait application key を畳み込んだ nonzero hash です。
//: - この evidence 単独では materializer accepted path を開きません。後続 stage は solver / connector / materializer の全 evidence を合わせて検査します。
pub struct SelfhostMemoTraitPublicImplGenericConcreteCoherenceEvidence:
    schema_version %i32
    declaration_ordinal %i32
    instantiation_shape_hash %i32
    connector_shape_hash %i32
    target_canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    target_canonical_payload_hash %SelfhostMemoTraitCanonicalKeyPayloadHash
    target_final_shape_hash %i32
    trait_application_canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    trait_application_canonical_payload_hash %SelfhostMemoTraitCanonicalKeyPayloadHash
    trait_application_final_shape_hash %i32
    coherence_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericConcreteCoherenceCollision: duplicate / overlap の診断 payload
pub struct SelfhostMemoTraitPublicImplGenericConcreteCoherenceCollision:
    existing_declaration_ordinal %i32
    new_declaration_ordinal %i32
    target_key_hash %i32
    trait_application_key_hash %i32
    existing_connector_shape_hash %i32
    new_connector_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind: coherence boundary の拒否理由
//:
//: [目的/もくてき]:
//: - table owner setup、connector evidence schema、canonical material、duplicate、overlap unsupported を typed enum として分けます。
pub enum SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind:
    RecordTableAllocFailed %StdErrorKind
    RecordPushFailed %StdErrorKind
    ExistingRecordReadFailed %i32
    DeclarationOrdinalPlaceholder
    ConnectorSchemaPlaceholder
    ConnectorSchemaMismatch %SelfhostMemoTraitPublicImplGenericConcreteCoherenceCollision
    InstantiationShapeHashPlaceholder
    ConnectorShapeHashPlaceholder
    SubstitutionShapeHashPlaceholder
    ProjectionShapeHashPlaceholder
    TargetFinalShapeHashPlaceholder
    TraitApplicationFinalShapeHashPlaceholder
    TargetCanonicalFingerprintSchemaPlaceholder
    TargetCanonicalFingerprintSchemaMismatch
    TargetCanonicalFingerprintHashPlaceholder
    TargetCanonicalPayloadSchemaPlaceholder
    TargetCanonicalPayloadSchemaMismatch
    TargetCanonicalPayloadHashPlaceholder
    TraitApplicationCanonicalFingerprintSchemaPlaceholder
    TraitApplicationCanonicalFingerprintSchemaMismatch
    TraitApplicationCanonicalFingerprintHashPlaceholder
    TraitApplicationCanonicalPayloadSchemaPlaceholder
    TraitApplicationCanonicalPayloadSchemaMismatch
    TraitApplicationCanonicalPayloadHashPlaceholder
    DuplicateExactMatch %SelfhostMemoTraitPublicImplGenericConcreteCoherenceCollision
    OverlapUnsupported %SelfhostMemoTraitPublicImplGenericConcreteCoherenceCollision
    DerivedCoherenceShapeHashPlaceholder

