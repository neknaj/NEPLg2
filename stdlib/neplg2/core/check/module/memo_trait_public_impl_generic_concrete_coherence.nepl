fn selfhost_memo_trait_public_impl_generic_concrete_coherence_connector_key_hash %fn i32 fn SelfhostMemoTraitPublicImplGenericInstantiationProjectionConnectorEvidence i32 \declaration_ordinal\connector:
    let target_key %i32 selfhost_memo_trait_public_impl_generic_concrete_coherence_target_key_hash connector.target_canonical_fingerprint connector.target_canonical_payload_hash connector.target_final_shape_hash
    let trait_key %i32 selfhost_memo_trait_public_impl_generic_concrete_coherence_trait_key_hash connector.trait_application_canonical_fingerprint connector.trait_application_canonical_payload_hash connector.trait_application_final_shape_hash
    let identity_material %i32 selfhost_memo_trait_public_impl_generic_concrete_coherence_mix4 declaration_ordinal connector.instantiation_shape_hash connector.connector_shape_hash connector.projection_shape_hash
    selfhost_memo_trait_public_impl_generic_concrete_coherence_mix4 812201 selfhost_memo_trait_public_impl_generic_concrete_coherence_schema_version identity_material selfhost_memo_trait_public_impl_generic_concrete_coherence_mix2 target_key trait_key

//: selfhost_memo_trait_public_impl_generic_concrete_coherence_canonical_material_valid_result: connector の canonical material を[検査/けんさ]する
fn selfhost_memo_trait_public_impl_generic_concrete_coherence_canonical_material_valid_result %fn SelfhostMemoTraitPublicImplGenericInstantiationProjectionConnectorEvidence Result SelfhostMemoTraitPublicImplGenericInstantiationProjectionConnectorEvidence SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind \connector:
    if:
        eq connector.target_canonical_fingerprint.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalFingerprintSchemaPlaceholder
        else:
            if:
                not eq connector.target_canonical_fingerprint.schema_version selfhost_memo_trait_canonical_type_fingerprint_schema_version
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalFingerprintSchemaMismatch
                else:
                    if:
                        eq connector.target_canonical_fingerprint.root_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalFingerprintHashPlaceholder
                        else:
                            if:
                                eq connector.target_canonical_payload_hash.schema_version 0
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalPayloadSchemaPlaceholder
                                else:
                                    if:
                                        not eq connector.target_canonical_payload_hash.schema_version selfhost_memo_trait_canonical_key_payload_schema_version
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalPayloadSchemaMismatch
                                        else:
                                            if:
                                                eq connector.target_canonical_payload_hash.payload_hash 0
                                                then:
                                                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TargetCanonicalPayloadHashPlaceholder
                                                else:
                                                    if:
                                                        eq connector.trait_application_canonical_fingerprint.schema_version 0
                                                        then:
                                                            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalFingerprintSchemaPlaceholder
                                                        else:
                                                            if:
                                                                not eq connector.trait_application_canonical_fingerprint.schema_version selfhost_memo_trait_canonical_type_fingerprint_schema_version
                                                                then:
                                                                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalFingerprintSchemaMismatch
                                                                else:
                                                                    if:
                                                                        eq connector.trait_application_canonical_fingerprint.root_hash 0
                                                                        then:
                                                                            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalFingerprintHashPlaceholder
                                                                        else:
                                                                            if:
                                                                                eq connector.trait_application_canonical_payload_hash.schema_version 0
                                                                                then:
                                                                                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalPayloadSchemaPlaceholder
                                                                                else:
                                                                                    if:
                                                                                        not eq connector.trait_application_canonical_payload_hash.schema_version selfhost_memo_trait_canonical_key_payload_schema_version
                                                                                        then:
                                                                                            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalPayloadSchemaMismatch
                                                                                        else:
                                                                                            if:
                                                                                                eq connector.trait_application_canonical_payload_hash.payload_hash 0
                                                                                                then:
                                                                                                    Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::TraitApplicationCanonicalPayloadHashPlaceholder
