pub fn selfhost_memo_trait_public_impl_generic_concrete_coherence_record_new %fn i32 fn i32 fn i32 fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitCanonicalKeyPayloadHash fn i32 fn SelfhostMemoTraitCanonicalTypeFingerprint fn SelfhostMemoTraitCanonicalKeyPayloadHash fn i32 fn i32 SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord \declaration_ordinal\instantiation_shape_hash\connector_shape_hash\target_fingerprint\target_payload\target_final_shape_hash\trait_fingerprint\trait_payload\trait_final_shape_hash\coherence_shape_hash:
