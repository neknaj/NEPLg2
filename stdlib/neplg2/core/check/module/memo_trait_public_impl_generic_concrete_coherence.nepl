//: selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_new: [空/から]の coherence table を[作/つく]る
pub fn selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_new %impure fn void Result SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable records
        Result::Err e:
            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::RecordTableAllocFailed e

//: selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_free: coherence table owner を[閉/と]じる
pub fn selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_free %impure fn SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_len: coherence record 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_len %fn &SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable i32 \table:
    let records %&Vec SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_push: coherence record を[追加/ついか]する
pub fn selfhost_memo_trait_public_impl_generic_concrete_coherence_record_table_push %impure fn SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable impure fn SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord Result SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind \table\record:
    let records %Vec SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitPublicImplGenericConcreteCoherenceRecordTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitPublicImplGenericConcreteCoherenceErrorKind::RecordPushFailed error

