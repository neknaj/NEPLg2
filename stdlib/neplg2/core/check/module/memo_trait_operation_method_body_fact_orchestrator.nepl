//: selfhost_memo_trait_operation_method_body_fact_orchestrator_error_kind_eq: orchestrator error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - nested scan error と batch build error は payload まで比較します。
//: - wildcard arm は使いません。error variant 追加時はこの equality も明示的に更新します。
pub fn selfhost_memo_trait_operation_method_body_fact_orchestrator_error_kind_eq %fn SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind fn SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::InputScanRejected a_scan:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::InputScanRejected b_scan:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_error_kind_eq a_scan b_scan
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::OutputTableAllocFailed _b_alloc:
                    false
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::BatchBuildRejected _b_batch:
                    false
        SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::OutputTableAllocFailed a_alloc:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::InputScanRejected _b_scan:
                    false
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::OutputTableAllocFailed b_alloc:
                    selfhost_memo_trait_operation_method_body_fact_orchestrator_std_error_kind_eq a_alloc b_alloc
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::BatchBuildRejected _b_batch:
                    false
        SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::BatchBuildRejected a_batch:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::InputScanRejected _b_scan:
                    false
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::OutputTableAllocFailed _b_alloc:
                    false
                SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::BatchBuildRejected b_batch:
                    selfhost_memo_trait_operation_method_body_fact_table_inputs_error_kind_eq a_batch b_batch

