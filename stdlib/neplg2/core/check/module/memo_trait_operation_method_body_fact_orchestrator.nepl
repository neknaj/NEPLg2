//: SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind: scan から fact table build までの拒否理由
//:
//: [目的/もくてき]:
//: - scan rejection、output table allocation failure、batch build rejection を同じ文字列 error に潰さず、後続診断が必要な nested typed payload を保持します。
pub enum SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind:
    InputScanRejected %SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind
    OutputTableAllocFailed %StdErrorKind
    BatchBuildRejected %SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind

//: SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary: orchestrator smoke の代表結果
pub struct SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary:
    accepted_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind
    scan_missing %Result i32 SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind
    batch_missing_root %Result i32 SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind

impl Clone for SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary SelfhostMemoTraitOperationMethodBodyFactOrchestratorStage0Summary \self:
        self

//: selfhost_memo_trait_operation_method_body_fact_orchestrator_build_scanned_inputs_result: build input table から fact table を[構築/こうちく]する
//:
//: [契約/けいやく]:
//: - `inputs` はこの関数が消費します。success / failure のどちらでも build input table owner はこの関数が閉じます。
//: - output table allocation が失敗した場合は、batch build に進まず `inputs` を閉じて `OutputTableAllocFailed` を返します。
//: - batch build が失敗した場合、output fact table owner は既存 batch build boundary が cleanup 済みです。この関数は `inputs` だけを閉じます。
fn selfhost_memo_trait_operation_method_body_fact_orchestrator_build_scanned_inputs_result %impure fn &SelfhostHirModule impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind \module\inputs:
    match selfhost_memo_trait_operation_method_body_table_new:
        Result::Ok table:
            match selfhost_memo_trait_operation_method_body_fact_table_build_from_inputs_result table module &inputs:
                Result::Ok built:
                    selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
                    Result::Ok built
                Result::Err batch_error:
                    selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
                    Result::Err SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::BatchBuildRejected batch_error
        Result::Err alloc_error:
            selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
            Result::Err SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::OutputTableAllocFailed alloc_error

//: selfhost_memo_trait_operation_method_body_fact_table_from_scan_records_result: scan record table から fact table を[作/つく]る
//:
//: [契約/けいやく]:
//: - `module` と `source` は borrow です。この関数はどちらも閉じません。
//: - success の場合だけ caller は output fact table owner を受け取ります。
//: - scan rejection の場合、partial build input table owner の cleanup は scan boundary が完結済みです。
pub fn selfhost_memo_trait_operation_method_body_fact_table_from_scan_records_result %impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable Result SelfhostMemoTraitOperationMethodBodyTable SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind \module\source:
    match selfhost_memo_trait_operation_method_body_fact_inputs_from_scan_records_result source:
        Result::Ok inputs:
            selfhost_memo_trait_operation_method_body_fact_orchestrator_build_scanned_inputs_result module inputs
        Result::Err scan_error:
            Result::Err SelfhostMemoTraitOperationMethodBodyFactOrchestratorErrorKind::InputScanRejected scan_error

