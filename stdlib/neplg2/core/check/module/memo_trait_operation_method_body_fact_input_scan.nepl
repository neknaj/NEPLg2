#indent 4

//: # check/module/memo_trait_operation_method_body_fact_input_scan
//: complete public impl surface から得た operation impl 候補の method body root 有無を、method body fact build input table へ[変換/へんかん]する checker-layer module です。
//:
//: [目的/もくてき]:
//: - full public surface orchestration は、Copy / Drop / Eq / Hash の impl 候補を同じ列として扱います。一方で method body purity が必要なのは Eq / Hash だけです。
//: - この module は、上流が typed candidate として決めた `SelfhostTypeId`、operation kind、optional HIR root、fuel を走査し、Eq / Hash だけを `SelfhostMemoTraitOperationMethodBodyFactBuildInputTable` へ投入します。
//: - Copy / Drop に method body root が付いている場合や、Eq / Hash に method body root が欠けている場合を bool や表示文字列にせず typed error として返します。
//:
//: [契約/けいやく]:
//: - caller は complete public impl surface から作った typed candidate table だけを渡します。この module は source text、span、lexeme、display name、diagnostic text、module path、method name string から operation や root を推測しません。
//: - `SelfhostMemoTraitOperationMethodBodyFactInputScanRecord` は、public impl header / trait application classifier / method body lowering がすでに決定した session-local input です。この module は public impl header hash や trait application shape を再検査しません。
//: - `Eq` / `Hash` は `method_body_root = some(root)` を要求し、対応する build input を output table へ追加します。
//: - `Copy` / `Drop` は method body fact を必要としないため、`method_body_root = none` の場合は output table に何も追加しません。`some(root)` が渡された場合は `UnexpectedMethodBodyRoot` として拒否します。
//: - scan API は output `SelfhostMemoTraitOperationMethodBodyFactBuildInputTable` owner を内部で作ります。成功時だけ caller がその owner を受け取り、不要になったら既存の `selfhost_memo_trait_operation_method_body_fact_build_input_table_free` で閉じます。
//: - output table allocation、output push、source read、operation matrix rejection はすべて typed enum で返します。失敗時に部分構築された output table owner はこの module が閉じるか、既存 push boundary が閉じます。
//: - この module は HIR effect checker、fact producer、fact table builder、method body resolver lookup、Drop resolver、purity gate、operation impl candidate table、Resource IR proof、backend artifact、proof store、public surface hash を実行しません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では、上流 scanner の代わりに stage0 smoke が typed record table を組み立て、Eq / Hash accepted、Copy / Drop skipped、Eq missing body rejection、Copy unexpected body rejection を確認します。
//: - actual public impl AST scanning、impl header / trait application からの candidate materialization、Drop body effect checker、Resource IR no-escape proof、generic impl binder、PrivateCache / PrivateState masking は後続 stage の責務です。
//: - facade にはまだ re-export しません。full orchestration が public surface scanner、method body fact input scan、Drop resolver、purity gate、operation impl table をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - source record 数を n とすると、scan は O(n) 時間・O(1) 追加制御空間です。Eq / Hash の output push は `Vec` push の償却 O(1) 時間です。
//: - operation 別に sorted index や bucket を持つ最適化は、typed error contract と input/output schema を保ったまま後続 stage で置換できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_method_body_fact_input_scan" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_method_body_fact_input_scan_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_method_body_fact_input_scan_len_result_eq summary.accepted_len 2
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_method_body_fact_input_scan_required_error_result_eq summary.eq_missing_body 0 SelfhostMemoTraitOperationEvidenceKind::Eq
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_method_body_fact_input_scan_unexpected_error_result_eq summary.copy_unexpected_body 0 SelfhostMemoTraitOperationEvidenceKind::Copy
//:             let shown checks_print_report checks3
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "method body fact input scan stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "./memo_trait_operation_method_body_fact_table_inputs" as *

//: SelfhostMemoTraitOperationMethodBodyFactInputScanRecord: public impl candidate 由来の method body root scan input
//:
//: [契約/けいやく]:
//: - `type_id` と `operation` は、public impl classifier が typed evidence として決定済みの lookup key です。
//: - `method_body_root` は、Eq / Hash method body が HIR lowering 済みの場合だけ `some(root)` になります。Copy / Drop では `none` でなければなりません。
//: - `fuel` は HIR traversal の上限として後続 builder へ渡す値です。この module は HIR を読まないため fuel exhaustion の判定は effect checker に委ねます。
pub struct SelfhostMemoTraitOperationMethodBodyFactInputScanRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    method_body_root %Option SelfhostHirExprId
    fuel %i32

//: SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable: scan record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。scan API は borrow で読むだけなので、caller は success / failure 後にこの table を閉じます。
//: - table は checker-layer の session-local input 列であり、永続 artifact や public surface hash の authority ではありません。
pub struct SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable:
    records %Vec SelfhostMemoTraitOperationMethodBodyFactInputScanRecord

//: SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation: scan 拒否の index / operation payload
//:
//: [目的/もくてき]:
//: - 現在の enum payload が単一であるため、失敗した source record index と operation kind を 1 struct に束ねます。
pub struct SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation:
    index %i32
    operation %SelfhostMemoTraitOperationEvidenceKind

//: SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind: method body fact input scan の拒否理由
//:
//: [目的/もくてき]:
//: - source table の構築 / 読み取り、output table の構築 / push、operation matrix rejection を分けて保持します。
pub enum SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind:
    SourcePushFailed %StdErrorKind
    OutputInputAllocFailed %StdErrorKind
    SourceReadFailed %i32
    OutputInputPushFailed %SelfhostMemoTraitOperationMethodBodyFactTableInputsErrorKind
    RequiredMethodBodyMissing %SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation
    UnexpectedMethodBodyRoot %SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation

//: SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary: input scan smoke の代表結果
pub struct SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary:
    accepted_len %Result i32 SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind
    eq_missing_body %Result i32 SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind
    copy_unexpected_body %Result i32 SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind

