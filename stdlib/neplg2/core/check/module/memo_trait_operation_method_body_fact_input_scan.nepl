    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactInputScanRecord SelfhostMemoTraitOperationMethodBodyFactInputScanRecord \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactInputScanRecord:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecord SelfhostMemoTraitOperationMethodBodyFactInputScanRecord \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary SelfhostMemoTraitOperationMethodBodyFactInputScanStage0Summary \self:
        self

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_new: scan record を[作/つく]る
//:
//: [契約/けいやく]:
//: - constructor は typed field を束ねるだけです。operation と method body root の整合性は scan API が検査します。
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn Option SelfhostHirExprId fn i32 SelfhostMemoTraitOperationMethodBodyFactInputScanRecord \type_id\operation\method_body_root\fuel:
    SelfhostMemoTraitOperationMethodBodyFactInputScanRecord type_id operation method_body_root fuel

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_new: [空/から]の source record table を[作/つく]る
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_new %impure fn void Result SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationMethodBodyFactInputScanRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free: source record table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_free %impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_len: source record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_len %fn &SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationMethodBodyFactInputScanRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_push: source record を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の table owner を返します。
//: - push 失敗時は `Vec` が返した owner を閉じ、`SourcePushFailed(error)` として `StdErrorKind` を保持します。caller は失敗後に元の table を再利用してはいけません。
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_push %impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecord Result SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \table\record:
    let records %Vec SelfhostMemoTraitOperationMethodBodyFactInputScanRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourcePushFailed error

//: selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_new: index / operation payload を[作/つく]る
fn selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_new %fn i32 fn SelfhostMemoTraitOperationEvidenceKind SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation \index\operation:
    SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation index operation

//: selfhost_memo_trait_operation_method_body_fact_input_scan_operation_requires_body: operation が method body root を[必要/ひつよう]とするか[返/かえ]す
fn selfhost_memo_trait_operation_method_body_fact_input_scan_operation_requires_body %fn SelfhostMemoTraitOperationEvidenceKind bool \operation:
    match operation:
        SelfhostMemoTraitOperationEvidenceKind::Copy:
            false
        SelfhostMemoTraitOperationEvidenceKind::Drop:
            false
        SelfhostMemoTraitOperationEvidenceKind::Eq:
            true
        SelfhostMemoTraitOperationEvidenceKind::Hash:
            true

//: selfhost_memo_trait_operation_method_body_fact_input_scan_required_missing_error: 必須 root 欠落で output table を閉じて[失敗/しっぱい]する
fn selfhost_memo_trait_operation_method_body_fact_input_scan_required_missing_error %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn i32 impure fn SelfhostMemoTraitOperationEvidenceKind Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \inputs\index\operation:
    selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
    Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::RequiredMethodBodyMissing selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_new index operation

//: selfhost_memo_trait_operation_method_body_fact_input_scan_unexpected_root_error: 不要 root 混入で output table を閉じて[失敗/しっぱい]する
fn selfhost_memo_trait_operation_method_body_fact_input_scan_unexpected_root_error %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn i32 impure fn SelfhostMemoTraitOperationEvidenceKind Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \inputs\index\operation:
    selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
    Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::UnexpectedMethodBodyRoot selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_new index operation

//: selfhost_memo_trait_operation_method_body_fact_input_scan_push_output: Eq / Hash root を output build input table へ[投入/とうにゅう]する
fn selfhost_memo_trait_operation_method_body_fact_input_scan_push_output %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecord impure fn SelfhostHirExprId Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \inputs\record\root:
    let build_input %SelfhostMemoTraitOperationMethodBodyFactBuildInput selfhost_memo_trait_operation_method_body_fact_build_input_new record.type_id record.operation root record.fuel
    match selfhost_memo_trait_operation_method_body_fact_build_input_table_push inputs build_input:
        Result::Ok next_inputs:
            Result::Ok next_inputs
        Result::Err push_error:
            Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputPushFailed push_error

//: selfhost_memo_trait_operation_method_body_fact_input_scan_record_into_inputs: 1 record を operation matrix に従って output table へ[反映/はんえい]する
//:
//: [契約/けいやく]:
//: - `inputs` はこの関数が消費します。success では更新後の owner を返します。
//: - matrix rejection ではこの関数が `inputs` を閉じます。output push rejection では既存 push boundary が owner cleanup を担当します。
fn selfhost_memo_trait_operation_method_body_fact_input_scan_record_into_inputs %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn SelfhostMemoTraitOperationMethodBodyFactInputScanRecord impure fn i32 Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \inputs\record\index:
    if:
        selfhost_memo_trait_operation_method_body_fact_input_scan_operation_requires_body record.operation
        then:
            match record.method_body_root:
                Option::Some root:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_push_output inputs record root
                Option::None:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_required_missing_error inputs index record.operation
        else:
            match record.method_body_root:
                Option::Some _unexpected:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_unexpected_root_error inputs index record.operation
                Option::None:
                    Result::Ok inputs

//: selfhost_memo_trait_operation_method_body_fact_input_scan_loop: source record table を順番に[読/よ]み output input table を[組/く]む
fn selfhost_memo_trait_operation_method_body_fact_input_scan_loop %impure fn SelfhostMemoTraitOperationMethodBodyFactBuildInputTable impure fn &SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable impure fn i32 Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \inputs\source\index:
    if:
        ge index selfhost_memo_trait_operation_method_body_fact_input_scan_record_table_len source
        then:
            Result::Ok inputs
        else:
            let records %&Vec SelfhostMemoTraitOperationMethodBodyFactInputScanRecord field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match selfhost_memo_trait_operation_method_body_fact_input_scan_record_into_inputs inputs record index:
                        Result::Ok next_inputs:
                            selfhost_memo_trait_operation_method_body_fact_input_scan_loop next_inputs source add index 1
                        Result::Err error:
                            Result::Err error
                Option::None:
                    selfhost_memo_trait_operation_method_body_fact_build_input_table_free inputs
                    Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_method_body_fact_inputs_from_scan_records_result: typed public impl operation record 列から method body fact build inputs を[作/つく]る
//:
//: [契約/けいやく]:
//: - `source` は borrow であり、この関数は閉じません。caller は success / failure のあとに source record table owner を閉じます。
//: - success の場合だけ output build input table owner を返します。failure では部分構築済み output はこの module または既存 output push boundary が閉じます。
//: - complete public impl surface であることは caller が保証します。incomplete surface の status は method body resolver の `SelfhostMemoTraitOperationMethodBodySurfaceState` で扱います。
pub fn selfhost_memo_trait_operation_method_body_fact_inputs_from_scan_records_result %impure fn &SelfhostMemoTraitOperationMethodBodyFactInputScanRecordTable Result SelfhostMemoTraitOperationMethodBodyFactBuildInputTable SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind \source:
    match selfhost_memo_trait_operation_method_body_fact_build_input_table_new:
        Result::Ok inputs:
            selfhost_memo_trait_operation_method_body_fact_input_scan_loop inputs source 0
        Result::Err e:
            Result::Err SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputAllocFailed e

//: selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_code: StdErrorKind を比較用 code へ[写/うつ]す
fn selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_code %fn StdErrorKind i32 \kind:
    match kind:
        StdErrorKind::Failure:
            0
        StdErrorKind::OutOfMemory:
            1
        StdErrorKind::EmptyCollection:
            2
        StdErrorKind::IndexOutOfBounds:
            3
        StdErrorKind::KeyNotFound:
            4
        StdErrorKind::CapacityExceeded:
            5
        StdErrorKind::InvalidOperation:
            6
        StdErrorKind::InvalidUtf8:
            7
        StdErrorKind::ParseError:
            8
        StdErrorKind::IoError:
            9
        StdErrorKind::Other:
            10

//: selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_eq: StdErrorKind が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_eq %fn StdErrorKind fn StdErrorKind bool \a\b:
    eq selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_code a selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_code b

//: selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_eq: index / operation payload が同じか[返/かえ]す
fn selfhost_memo_trait_operation_method_body_fact_input_scan_indexed_operation_eq %fn SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation fn SelfhostMemoTraitOperationMethodBodyFactInputScanIndexedOperation bool \a\b:
    and:
        eq a.index b.index
        selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation

//: selfhost_memo_trait_operation_method_body_fact_input_scan_error_kind_eq: scan error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ error は payload まで比較します。
//: - wildcard arm は使いません。error variant が増えた場合はこの境界を明示的に更新します。
pub fn selfhost_memo_trait_operation_method_body_fact_input_scan_error_kind_eq %fn SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind fn SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourcePushFailed a_push:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourcePushFailed b_push:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_eq a_push b_push
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputAllocFailed _b_alloc:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourceReadFailed _b_read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputPushFailed _b_output:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::RequiredMethodBodyMissing _b_required:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::UnexpectedMethodBodyRoot _b_unexpected:
                    false
        SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputAllocFailed a_alloc:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourcePushFailed _b_push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputAllocFailed b_alloc:
                    selfhost_memo_trait_operation_method_body_fact_input_scan_std_error_kind_eq a_alloc b_alloc
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourceReadFailed _b_read:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputPushFailed _b_output:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::RequiredMethodBodyMissing _b_required:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::UnexpectedMethodBodyRoot _b_unexpected:
                    false
        SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourceReadFailed a_idx:
            match b:
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::SourcePushFailed _b_push:
                    false
                SelfhostMemoTraitOperationMethodBodyFactInputScanErrorKind::OutputInputAllocFailed _b_alloc:
                    false
