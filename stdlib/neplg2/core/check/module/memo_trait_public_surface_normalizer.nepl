#indent 4

//: # check/module/memo_trait_public_surface_normalizer
//: loader / module graph authority から `MemoKey` / `MemoValue` 用 public surface hash の部分 typed input stream を[作/つく]る module です。
//:
//: [目的/もくてき]:
//: - import graph、re-export、public non-trait declaration の正規化済み evidence を、後続の full public surface hash builder が fold できる ordered input item stream へ変換します。
//: - hash module に loader / graph / VFS を逆流させず、この module が lookup authority と hash authority の境界になります。
//: - `SelfhostModuleGraph` の node は dependency が loader graph に存在することの検査にだけ使い、accepted hash material には ordinal、kind、visibility、stable payload hash、typed dependency public surface hash だけを渡します。
//: - public declaration は、生の source header ではなく stable declaration key hash と normalized declaration shape hash から declaration payload hash を作ります。
//:
//: [契約/けいやく]:
//: - graph path、import alias、source span、source text、diagnostic text、display name は hash input に入りません。
//: - dependency module と re-export は、caller が別 stage で計算した typed dependency public surface hash を必須にします。欠落と placeholder は normalizer の typed error で拒否します。
//: - public function / struct / enum / impl は、この slice では caller supplied stable declaration key hash と normalized declaration shape hash を typed input として受け取り、normalizer が stable payload hash へ畳みます。signature normalizer、trait impl table、method body purity、Drop なし proof は後続 stage の責務です。
//: - この module が公開する stream は dependency / re-export / public declaration の部分入力です。`LocalMemoTrait` item を含む full public surface hash の確定は、すべての input producer が揃う後続 boundary で行います。
//: - normalizer は proof store、HIR、Resource IR、backend、serialized artifact を読みません。`.neplmeta` / `.neplproof` からの再投影は別境界で typed evidence を作ってから、この module へ渡します。
//:
//: [現状/げんじょう]:
//: - Phase 1 producer は graph node 存在、dependency public surface hash、public declaration payload input、owned stream 生成を接続します。
//: - re-export projection の完全な export table、public declaration signature hash / layout header hash / impl header hash の本体、stable nominal key はまだ caller supplied typed hash として扱います。
//:
//: [計算量/けいさんりょう]:
//: - graph node lookup は現行 `SelfhostModuleGraph` の線形探索 / index read に従います。
//: - normalizer 自体は input evidence 件数 k に対して O(k) 時間で ordered stream を作ります。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_public_surface_hash" as *
//:| #import "neplg2/core/check/module/memo_trait_public_surface_normalizer" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let summary selfhost_memo_trait_public_surface_normalizer_stage0
//:     let checks0 checks_new
//:     let checks1 checks_push checks0 check is_ok summary.accepted_item_count
//:     let checks2 checks_push checks1 check selfhost_memo_trait_public_surface_normalizer_error_kind_eq unwrap_err summary.dependency_hash_missing_rejected SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing
//:     let checks3 checks_push checks2 check selfhost_memo_trait_public_surface_normalizer_error_kind_eq unwrap_err summary.dependency_hash_placeholder_rejected SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder
//:     let checks4 checks_push checks3 check selfhost_memo_trait_public_surface_normalizer_error_kind_eq unwrap_err summary.graph_node_missing_rejected SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable
//:     let checks5 checks_push checks4 check selfhost_memo_trait_public_surface_normalizer_error_kind_eq unwrap_err summary.stable_declaration_key_placeholder_rejected SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StableDeclarationKeyHashPlaceholder
//:     let checks6 checks_push checks5 check selfhost_memo_trait_public_surface_normalizer_error_kind_eq unwrap_err summary.normalized_declaration_shape_placeholder_rejected SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::NormalizedDeclarationShapeHashPlaceholder
//:     let shown checks_print_report checks6
//:     checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/graph" as *
#import "neplg2/core/module/vfs" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "./memo_trait_public_surface_hash" as *

//: SelfhostMemoTraitPublicSurfaceDependencyEvidence: dependency module input の typed evidence
//:
//: [目的/もくてき]:
//: - loader / module graph が解決済みの dependency node と、別 stage が計算済みの public surface hash を同じ record にまとめます。
//:
//: [契約/けいやく]:
//: - `module_index` は graph node の存在確認にだけ使います。node path は hash material ではありません。
//: - `payload_hash` は dependency edge 自体の stable payload hash です。import path 文字列や alias を直接 hash に入れません。
pub struct SelfhostMemoTraitPublicSurfaceDependencyEvidence:
    module_index %i32
    ordinal %i32
    payload_hash %i32
    dependency_public_surface_hash %Option i32

//: SelfhostMemoTraitPublicSurfaceReExportEvidence: re-export input の typed evidence
//:
//: [目的/もくてき]:
//: - re-export target が graph 上に存在することと、target public surface hash が caller から渡されたことを同時に検査するための record です。
pub struct SelfhostMemoTraitPublicSurfaceReExportEvidence:
    module_index %i32
    ordinal %i32
    payload_hash %i32
    dependency_public_surface_hash %Option i32

//: SelfhostMemoTraitPublicSurfacePublicDeclarationKind: public non-trait declaration input の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - function / struct / enum / impl を hash input kind へ写す前に、normalizer 側の public declaration domain として保持します。
pub enum SelfhostMemoTraitPublicSurfacePublicDeclarationKind:
    Function
    Struct
    Enum
    Impl

//: SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput: public declaration payload hash を[作/つく]る typed input
//:
//: [目的/もくてき]:
//: - public function / struct / enum / impl の stable payload hash を、source text ではなく検査済みの stable key と normalized shape から作ります。
//: - 後続の function signature normalizer、struct / enum layout header normalizer、impl header normalizer が作る hash を、同じ public surface input schema へ渡すための入口です。
//:
//: [契約/けいやく]:
//: - `kind` は payload domain を分けるために必ず fold へ入れます。同じ key / shape でも function と struct は同じ payload になってはいけません。
//: - `stable_declaration_key_hash` は stable definition key、stable nominal key、stable impl header key など、宣言 identity を source span や表示名から切り離した typed hash です。
//: - `normalized_declaration_shape_hash` は function signature、struct / enum layout header、impl header など、依存側の型検査や layout 判定に影響する公開 shape の typed hash です。
//: - どちらかが 0 の場合は placeholder として拒否します。0 を意味のある hash として特別扱いしません。
//: - source lexeme、span、path、alias、display name、diagnostic text、HIR、Resource IR、backend artifact はこの payload input に入りません。
pub struct SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput:
    kind %SelfhostMemoTraitPublicSurfacePublicDeclarationKind
    stable_declaration_key_hash %i32
    normalized_declaration_shape_hash %i32

//: SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence: public non-trait declaration input の typed evidence
//:
//: [契約/けいやく]:
//: - `payload_hash` は source text ではなく、normalized signature / layout header / impl header などから作られた stable hash でなければなりません。
//: - この module 内の stage0 と内部 adapter では `SelfhostMemoTraitPublicSurfacePublicDeclarationPayloadInput` から payload hash を作り、function / struct / enum / impl の種類、stable declaration key、normalized shape を payload に反映します。
//: - 現在の public partial stream API は互換境界として `Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence` を受け取るため、型だけで payload provenance を完全には証明しません。caller は同等の typed producer を通した stable payload だけを渡す必要があります。
//: - source lexeme、span、display name、diagnostic text はこの record に入れません。
pub struct SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence:
    kind %SelfhostMemoTraitPublicSurfacePublicDeclarationKind
    ordinal %i32
    payload_hash %i32

//: SelfhostMemoTraitPublicSurfaceGraphRejectionKind: graph diagnostic を normalizer error 境界へ[写/うつ]した[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - `SelfhostDiagnostic` の message / label / note を normalizer の public error payload に持ち込まず、graph が失敗した理由だけを typed enum として保持します。
pub enum SelfhostMemoTraitPublicSurfaceGraphRejectionKind:
    OutOfMemory
    MissingModule
    Cycle
    Internal
    UnexpectedDiagnostic

//: SelfhostMemoTraitPublicSurfaceNormalizerErrorKind: public surface normalizer の拒否理由
//:
//: [目的/もくてき]:
//: - graph lookup、dependency hash、payload hash、hash fold のどこで拒否したかを enum で保持します。
pub enum SelfhostMemoTraitPublicSurfaceNormalizerErrorKind:
    GraphRejected %SelfhostMemoTraitPublicSurfaceGraphRejectionKind
    GraphNodeUnavailable
    InputVectorAllocationFailed
    InputVectorReadFailed
    DependencyPublicSurfaceHashMissing
    DependencyPublicSurfaceHashPlaceholder
    StablePayloadHashPlaceholder
    StableDeclarationKeyHashPlaceholder
    NormalizedDeclarationShapeHashPlaceholder
    DerivedDeclarationPayloadHashPlaceholder
    HashRejected %SelfhostMemoTraitPublicSurfaceHashErrorKind

//: SelfhostMemoTraitPublicSurfaceNormalizerStage0Summary: normalizer smoke の代表結果
//:
//: [目的/もくてき]:
//: - graph authority 付き accepted path と、dependency hash / graph node / public declaration payload component placeholder の fail-closed path をまとめます。
pub struct SelfhostMemoTraitPublicSurfaceNormalizerStage0Summary:
    accepted_item_count %Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    dependency_hash_missing_rejected %Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    dependency_hash_placeholder_rejected %Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    graph_node_missing_rejected %Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    stable_declaration_key_placeholder_rejected %Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    normalized_declaration_shape_placeholder_rejected %Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind

