    let items_result %Result Vec SelfhostMemoTraitPublicSurfaceHashInputItem StdErrorKind v::new
    match items_result:
        Result::Ok items0:
            let dependency_count %i32 v::len dependencies
            match selfhost_memo_trait_public_surface_normalizer_push_dependency_vec_result graph items0 dependencies 0 dependency_count:
                Result::Ok items1:
                    let reexport_count %i32 v::len reexports
                    match selfhost_memo_trait_public_surface_normalizer_push_reexport_vec_result graph items1 reexports 0 reexport_count:
                        Result::Ok items2:
                            let declaration_count %i32 v::len declarations
                            selfhost_memo_trait_public_surface_normalizer_push_declaration_vec_result items2 declarations 0 declaration_count
                        Result::Err reexport_error:
                            Result::Err reexport_error
                Result::Err dependency_error:
                    Result::Err dependency_error
        Result::Err _alloc_error:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorAllocationFailed

