    fn copy_mark %fn SelfhostMemoTraitPublicSurfacePublicDeclarationKind SelfhostMemoTraitPublicSurfacePublicDeclarationKind \self:
        self

impl Clone for SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence:
    fn clone %fn &SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence \self:
