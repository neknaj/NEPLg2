//: selfhost_memo_trait_public_surface_dependency_evidence_new: dependency evidence を[作/つく]る
fn selfhost_memo_trait_public_surface_dependency_evidence_new %fn i32 fn i32 fn i32 fn Option i32 SelfhostMemoTraitPublicSurfaceDependencyEvidence \module_index\ordinal\payload_hash\dependency_public_surface_hash:
    SelfhostMemoTraitPublicSurfaceDependencyEvidence module_index ordinal payload_hash dependency_public_surface_hash

//: selfhost_memo_trait_public_surface_reexport_evidence_new: re-export evidence を[作/つく]る
fn selfhost_memo_trait_public_surface_reexport_evidence_new %fn i32 fn i32 fn i32 fn Option i32 SelfhostMemoTraitPublicSurfaceReExportEvidence \module_index\ordinal\payload_hash\dependency_public_surface_hash:
    SelfhostMemoTraitPublicSurfaceReExportEvidence module_index ordinal payload_hash dependency_public_surface_hash

//: selfhost_memo_trait_public_surface_public_declaration_evidence_new: public declaration evidence を[作/つく]る
fn selfhost_memo_trait_public_surface_public_declaration_evidence_new %fn SelfhostMemoTraitPublicSurfacePublicDeclarationKind fn i32 fn i32 SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence \kind\ordinal\payload_hash:
    SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence kind ordinal payload_hash

//: selfhost_memo_trait_public_surface_normalizer_stage0_summary_new: stage0 summary を[作/つく]る
fn selfhost_memo_trait_public_surface_normalizer_stage0_summary_new %fn Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind fn Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind fn Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind fn Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind fn Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind SelfhostMemoTraitPublicSurfaceNormalizerStage0Summary \accepted_item_count\dependency_hash_missing_rejected\dependency_hash_placeholder_rejected\graph_node_missing_rejected\stable_payload_placeholder_rejected:
    SelfhostMemoTraitPublicSurfaceNormalizerStage0Summary accepted_item_count dependency_hash_missing_rejected dependency_hash_placeholder_rejected graph_node_missing_rejected stable_payload_placeholder_rejected

//: selfhost_memo_trait_public_surface_graph_rejection_kind_code: graph rejection kind を比較用 code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_graph_rejection_kind_code %fn SelfhostMemoTraitPublicSurfaceGraphRejectionKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfaceGraphRejectionKind::OutOfMemory:
            1
        SelfhostMemoTraitPublicSurfaceGraphRejectionKind::MissingModule:
            2
        SelfhostMemoTraitPublicSurfaceGraphRejectionKind::Cycle:
            3
        SelfhostMemoTraitPublicSurfaceGraphRejectionKind::Internal:
            4
        SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic:
            5

//: selfhost_memo_trait_public_surface_graph_rejection_kind_eq: graph rejection kind が同じか[返/かえ]す
fn selfhost_memo_trait_public_surface_graph_rejection_kind_eq %fn SelfhostMemoTraitPublicSurfaceGraphRejectionKind fn SelfhostMemoTraitPublicSurfaceGraphRejectionKind bool \a\b:
    eq selfhost_memo_trait_public_surface_graph_rejection_kind_code a selfhost_memo_trait_public_surface_graph_rejection_kind_code b

//: selfhost_memo_trait_public_surface_graph_rejection_kind_from_diag: graph diagnostic code を typed kind へ[写/うつ]す
fn selfhost_memo_trait_public_surface_graph_rejection_kind_from_diag %fn SelfhostDiagnostic SelfhostMemoTraitPublicSurfaceGraphRejectionKind \diag:
    match diag.code:
        SelfhostDiagnosticCode::Resolve code:
            match code:
                SelfhostResolveDiagnosticCode::ModuleGraphOutOfMemory:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::OutOfMemory
                SelfhostResolveDiagnosticCode::ModuleGraphMissingModule:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::MissingModule
                SelfhostResolveDiagnosticCode::ModuleGraphCycle:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::Cycle
                SelfhostResolveDiagnosticCode::ModuleGraphInternal:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::Internal
                SelfhostResolveDiagnosticCode::ModulePathOutOfMemory:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
                SelfhostResolveDiagnosticCode::ModulePathInvalidImport:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
                SelfhostResolveDiagnosticCode::ModulePathEscapeRoot:
                    SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
        SelfhostDiagnosticCode::Loader _code:
            SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
        SelfhostDiagnosticCode::Lexer _code:
            SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
        SelfhostDiagnosticCode::Parser _code:
            SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
        SelfhostDiagnosticCode::Checker _code:
            SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic
        SelfhostDiagnosticCode::Cli _code:
            SelfhostMemoTraitPublicSurfaceGraphRejectionKind::UnexpectedDiagnostic

//: selfhost_memo_trait_public_surface_normalizer_error_kind_code: normalizer error を比較用 code へ[写/うつ]す
fn selfhost_memo_trait_public_surface_normalizer_error_kind_code %fn SelfhostMemoTraitPublicSurfaceNormalizerErrorKind i32 \kind:
    match kind:
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphRejected _graph_kind:
            1
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable:
            2
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorAllocationFailed:
            3
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorReadFailed:
            4
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing:
            5
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder:
            6
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StablePayloadHashPlaceholder:
            7
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::HashRejected _hash_error:
            8

//: selfhost_memo_trait_public_surface_normalizer_error_kind_eq: normalizer error kind が同じか[返/かえ]す
pub fn selfhost_memo_trait_public_surface_normalizer_error_kind_eq %fn SelfhostMemoTraitPublicSurfaceNormalizerErrorKind fn SelfhostMemoTraitPublicSurfaceNormalizerErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::HashRejected hash_error:
            match b:
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::HashRejected other_hash_error:
                    selfhost_memo_trait_public_surface_hash_error_kind_eq hash_error other_hash_error
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphRejected _graph_kind:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorAllocationFailed:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorReadFailed:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StablePayloadHashPlaceholder:
                    false
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphRejected graph_kind:
            match b:
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphRejected other_graph_kind:
                    selfhost_memo_trait_public_surface_graph_rejection_kind_eq graph_kind other_graph_kind
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::HashRejected _hash_error:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorAllocationFailed:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorReadFailed:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder:
                    false
                SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StablePayloadHashPlaceholder:
                    false
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorAllocationFailed:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::InputVectorReadFailed:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b
        SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StablePayloadHashPlaceholder:
            eq selfhost_memo_trait_public_surface_normalizer_error_kind_code a selfhost_memo_trait_public_surface_normalizer_error_kind_code b

//: selfhost_memo_trait_public_surface_normalizer_nonzero_payload_result: stable payload hash の placeholder を[拒否/きょひ]する
fn selfhost_memo_trait_public_surface_normalizer_nonzero_payload_result %fn i32 Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \payload_hash:
    if:
        eq payload_hash 0
        then:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::StablePayloadHashPlaceholder
        else:
            Result::Ok payload_hash

//: selfhost_memo_trait_public_surface_normalizer_dependency_hash_result: dependency public surface hash を[検査/けんさ]する
fn selfhost_memo_trait_public_surface_normalizer_dependency_hash_result %fn Option i32 Result i32 SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \dependency_public_surface_hash:
    match dependency_public_surface_hash:
        Option::Some dependency_hash:
            if:
                eq dependency_hash 0
                then:
                    Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashPlaceholder
                else:
                    Result::Ok dependency_hash
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::DependencyPublicSurfaceHashMissing

//: selfhost_memo_trait_public_surface_normalizer_dependency_input_item_result: dependency evidence を hash input item へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - graph node は存在確認にだけ使います。node payload を hash item に写しません。
fn selfhost_memo_trait_public_surface_normalizer_dependency_input_item_result %fn &SelfhostModuleGraph fn SelfhostMemoTraitPublicSurfaceDependencyEvidence Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \graph\evidence:
    match selfhost_module_graph_node_at graph evidence.module_index:
        Option::Some _node:
            match selfhost_memo_trait_public_surface_normalizer_nonzero_payload_result evidence.payload_hash:
                Result::Ok payload_hash:
                    match selfhost_memo_trait_public_surface_normalizer_dependency_hash_result evidence.dependency_public_surface_hash:
                        Result::Ok dependency_hash:
                            let dependency_hash_option %Option i32 some dependency_hash
                            Result::Ok SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashInputKind::DependencyModule evidence.ordinal SelfhostModuleDeclarationVisibility::Public payload_hash dependency_hash_option
                        Result::Err dependency_error:
                            Result::Err dependency_error
                Result::Err payload_error:
                    Result::Err payload_error
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable

//: selfhost_memo_trait_public_surface_normalizer_reexport_input_item_result: re-export evidence を hash input item へ[変換/へんかん]する
fn selfhost_memo_trait_public_surface_normalizer_reexport_input_item_result %fn &SelfhostModuleGraph fn SelfhostMemoTraitPublicSurfaceReExportEvidence Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \graph\evidence:
    match selfhost_module_graph_node_at graph evidence.module_index:
        Option::Some _node:
            match selfhost_memo_trait_public_surface_normalizer_nonzero_payload_result evidence.payload_hash:
                Result::Ok payload_hash:
                    match selfhost_memo_trait_public_surface_normalizer_dependency_hash_result evidence.dependency_public_surface_hash:
                        Result::Ok dependency_hash:
                            let dependency_hash_option %Option i32 some dependency_hash
                            Result::Ok SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashInputKind::ReExport evidence.ordinal SelfhostModuleDeclarationVisibility::Public payload_hash dependency_hash_option
                        Result::Err dependency_error:
                            Result::Err dependency_error
                Result::Err payload_error:
                    Result::Err payload_error
        Option::None:
            Result::Err SelfhostMemoTraitPublicSurfaceNormalizerErrorKind::GraphNodeUnavailable

//: selfhost_memo_trait_public_surface_normalizer_declaration_input_item_result: public declaration evidence を hash input item へ[変換/へんかん]する
fn selfhost_memo_trait_public_surface_normalizer_declaration_input_item_result %fn SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence Result SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceNormalizerErrorKind \evidence:
    match selfhost_memo_trait_public_surface_normalizer_nonzero_payload_result evidence.payload_hash:
        Result::Ok payload_hash:
            match evidence.kind:
                SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Function:
                    Result::Ok SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashInputKind::PublicFunction evidence.ordinal SelfhostModuleDeclarationVisibility::Public payload_hash Option::None
                SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Struct:
                    Result::Ok SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashInputKind::PublicStruct evidence.ordinal SelfhostModuleDeclarationVisibility::Public payload_hash Option::None
                SelfhostMemoTraitPublicSurfacePublicDeclarationKind::Enum:
                    Result::Ok SelfhostMemoTraitPublicSurfaceHashInputItem SelfhostMemoTraitPublicSurfaceHashInputKind::PublicEnum evidence.ordinal SelfhostModuleDeclarationVisibility::Public payload_hash Option::None
