//: selfhost_memo_trait_operation_drop_no_escape_stage0_resolve_and_free: output table を resolver で[読/よ]み[取/と]って owner を[閉/と]じる
fn selfhost_memo_trait_operation_drop_no_escape_stage0_resolve_and_free %impure fn SelfhostMemoTraitOperationDropImplTable impure fn SelfhostTypeId Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropNoEscapeGateErrorKind \output\type_id:
    let check_result %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropImplResolverErrorKind selfhost_memo_trait_operation_drop_impl_resolve_result SelfhostMemoTraitOperationDropImplSurfaceState::Complete &output type_id
    selfhost_memo_trait_operation_drop_impl_table_free output
    match check_result:
        Result::Ok check:
