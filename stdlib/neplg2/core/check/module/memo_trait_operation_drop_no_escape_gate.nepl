//: selfhost_memo_trait_operation_drop_no_escape_stage0_finish: proof / fact の代表 case を[実行/じっこう]する
fn selfhost_memo_trait_operation_drop_no_escape_stage0_finish %impure fn SelfhostTypeId impure fn SelfhostHirExprId impure fn SelfhostHirExprId Result SelfhostMemoTraitOperationDropNoEscapeGateStage0Summary StdErrorKind \type_id\root\other_root:
    let body_module_fingerprint %i32 71001
    let other_body_module_fingerprint %i32 71002
    let internal_fact %SelfhostMemoTraitOperationDropImplFact selfhost_memo_trait_operation_drop_impl_fact_new type_id body_module_fingerprint root SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::NotApplicable
    let pure_fact %SelfhostMemoTraitOperationDropImplFact selfhost_memo_trait_operation_drop_impl_fact_new type_id body_module_fingerprint root SelfhostEffectKind::Pure SelfhostEffectEscapeState::NotApplicable
    let preproven_fact %SelfhostMemoTraitOperationDropImplFact selfhost_memo_trait_operation_drop_impl_fact_new type_id body_module_fingerprint root SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::NoEscapeProven
    let key %SelfhostMemoTraitOperationDropNoEscapeProofKey selfhost_memo_trait_operation_drop_no_escape_proof_key_new type_id body_module_fingerprint root SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::NotApplicable
    let other_key %SelfhostMemoTraitOperationDropNoEscapeProofKey selfhost_memo_trait_operation_drop_no_escape_proof_key_new type_id body_module_fingerprint other_root SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::NotApplicable
    let other_module_key %SelfhostMemoTraitOperationDropNoEscapeProofKey selfhost_memo_trait_operation_drop_no_escape_proof_key_new type_id other_body_module_fingerprint root SelfhostEffectKind::InternalAlloc SelfhostEffectEscapeState::NotApplicable
    let proven_record %SelfhostMemoTraitOperationDropNoEscapeProofRecord selfhost_memo_trait_operation_drop_no_escape_proof_record_new key SelfhostMemoTraitOperationDropNoEscapeProofStatus::Proven
    let refuted_record %SelfhostMemoTraitOperationDropNoEscapeProofRecord selfhost_memo_trait_operation_drop_no_escape_proof_record_new key SelfhostMemoTraitOperationDropNoEscapeProofStatus::Refuted
    let mismatched_root_record %SelfhostMemoTraitOperationDropNoEscapeProofRecord selfhost_memo_trait_operation_drop_no_escape_proof_record_new other_key SelfhostMemoTraitOperationDropNoEscapeProofStatus::Proven
    let mismatched_module_record %SelfhostMemoTraitOperationDropNoEscapeProofRecord selfhost_memo_trait_operation_drop_no_escape_proof_record_new other_module_key SelfhostMemoTraitOperationDropNoEscapeProofStatus::Proven
    match selfhost_memo_trait_operation_drop_no_escape_stage0_one_proof internal_fact proven_record:
        Result::Ok proven_check:
            match selfhost_memo_trait_operation_drop_no_escape_stage0_empty_proofs internal_fact:
                Result::Ok missing_check:
                    match selfhost_memo_trait_operation_drop_no_escape_stage0_one_proof internal_fact mismatched_root_record:
                        Result::Ok mismatched_root_check:
                            match selfhost_memo_trait_operation_drop_no_escape_stage0_one_proof internal_fact mismatched_module_record:
                                Result::Ok mismatched_module_check:
                                    match selfhost_memo_trait_operation_drop_no_escape_stage0_one_proof internal_fact refuted_record:
                                        Result::Ok refuted_check:
                                            match selfhost_memo_trait_operation_drop_no_escape_stage0_empty_proofs pure_fact:
                                                Result::Ok pure_check:
                                                    match selfhost_memo_trait_operation_drop_no_escape_stage0_duplicate_proofs internal_fact proven_record:
                                                        Result::Ok duplicate_rejected:
                                                            match selfhost_memo_trait_operation_drop_no_escape_stage0_empty_proofs preproven_fact:
                                                                Result::Ok preproven_rejected:
                                                                    Result::Ok selfhost_memo_trait_operation_drop_no_escape_stage0_summary_new proven_check missing_check mismatched_root_check mismatched_module_check refuted_check pure_check duplicate_rejected preproven_rejected
                                                                Result::Err e:
                                                                    Result::Err e
                                                        Result::Err e:
                                                            Result::Err e
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err e:
                                            Result::Err e
                                Result::Err e:
                                    Result::Err e
                        Result::Err e:
                            Result::Err e
                Result::Err e:
                    Result::Err e
