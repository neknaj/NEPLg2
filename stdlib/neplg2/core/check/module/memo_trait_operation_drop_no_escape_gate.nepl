            Result::Err SelfhostMemoTraitOperationDropNoEscapeGateErrorKind::OutputTableRejected table_error

//: selfhost_memo_trait_operation_drop_no_escape_stage0_run_single: 1 fact / 1 proof table の smoke result を[作/つく]る
fn selfhost_memo_trait_operation_drop_no_escape_stage0_run_single %impure fn SelfhostMemoTraitOperationDropImplFact impure fn SelfhostMemoTraitOperationDropNoEscapeProofTable Result Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropNoEscapeGateErrorKind StdErrorKind \fact\proofs:
    match selfhost_memo_trait_operation_drop_impl_table_new:
        Result::Ok source0:
            match selfhost_memo_trait_operation_drop_impl_table_push source0 fact:
                Result::Ok source1:
                    match selfhost_memo_trait_operation_drop_no_escape_gate_table_result &source1 &proofs:
                        Result::Ok output:
                            let check_result %Result SelfhostMemoTraitOperationDropCheck SelfhostMemoTraitOperationDropNoEscapeGateErrorKind selfhost_memo_trait_operation_drop_no_escape_stage0_resolve_and_free output fact.type_id
                            selfhost_memo_trait_operation_drop_impl_table_free source1
                            selfhost_memo_trait_operation_drop_no_escape_proof_table_free proofs
                            Result::Ok check_result
                        Result::Err gate_error:
                            selfhost_memo_trait_operation_drop_impl_table_free source1
                            selfhost_memo_trait_operation_drop_no_escape_proof_table_free proofs
                            Result::Ok Result::Err gate_error
                Result::Err table_error:
                    selfhost_memo_trait_operation_drop_no_escape_proof_table_free proofs
                    Result::Ok Result::Err SelfhostMemoTraitOperationDropNoEscapeGateErrorKind::OutputTableRejected table_error
        Result::Err e:
            selfhost_memo_trait_operation_drop_no_escape_proof_table_free proofs
            Result::Err e

