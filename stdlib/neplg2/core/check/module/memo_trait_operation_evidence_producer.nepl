                SelfhostMemoTraitOperationEvidenceProducerErrorKind::TraitOperationMismatch:
                    false
                SelfhostMemoTraitOperationEvidenceProducerErrorKind::MethodBodyEvidenceRequired:
                    false
                SelfhostMemoTraitOperationEvidenceProducerErrorKind::UnexpectedMethodBodyEvidence:
                    false
                SelfhostMemoTraitOperationEvidenceProducerErrorKind::DropEvidenceRequired:
