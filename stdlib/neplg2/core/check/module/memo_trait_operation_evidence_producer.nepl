//: selfhost_memo_trait_operation_evidence_producer_record_result_status_eq: record result の status を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - doctest が record 内の status だけを確認し、record の type id や operation kind を直接分解しなくてよいようにします。
pub fn selfhost_memo_trait_operation_evidence_producer_record_result_status_eq %fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn SelfhostMemoTraitAggregateProofStatus bool \result\expected:
    match result:
        Result::Ok record:
            selfhost_memo_trait_operation_evidence_status_eq record.status expected
        Result::Err _e:
            false

//: selfhost_memo_trait_operation_evidence_producer_proof_record_has_missing_eq_and_impure_hash: table projection の代表 status を[確認/かくにん]する
//:
//: [目的/もくてき]:
//: - producer が作った record を operation evidence table に入れた後、solver 入力の proof record へ正しく投影できることを確認します。
pub fn selfhost_memo_trait_operation_evidence_producer_proof_record_has_missing_eq_and_impure_hash %fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationEvidenceErrorKind bool \result:
    match result:
        Result::Ok record:
            and:
                selfhost_memo_trait_operation_evidence_status_eq record.eq_proof SelfhostMemoTraitAggregateProofStatus::Missing
                selfhost_memo_trait_operation_evidence_status_eq record.hash_proof SelfhostMemoTraitAggregateProofStatus::Impure
        Result::Err _e:
            false

//: selfhost_memo_trait_operation_evidence_producer_stage0_summary_new: stage0 summary を[作/つく]る
fn selfhost_memo_trait_operation_evidence_producer_stage0_summary_new %fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationEvidenceProducerErrorKind fn Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationEvidenceErrorKind SelfhostMemoTraitOperationEvidenceProducerStage0Summary \accepted_record\missing_status_record\impure_status_record\unknown_drop_status_record\target_mismatch_rejected\classifier_shape_mismatch_rejected\trait_operation_mismatch_rejected\eq_method_not_required_rejected\drop_evidence_not_required_rejected\generic_header_rejected\proof_record:
    SelfhostMemoTraitOperationEvidenceProducerStage0Summary accepted_record missing_status_record impure_status_record unknown_drop_status_record target_mismatch_rejected classifier_shape_mismatch_rejected trait_operation_mismatch_rejected eq_method_not_required_rejected drop_evidence_not_required_rejected generic_header_rejected proof_record

//: selfhost_memo_trait_operation_evidence_producer_stage0_push_hash: Hash record を push して table projection を[返/かえ]す
fn selfhost_memo_trait_operation_evidence_producer_stage0_push_hash %impure fn SelfhostMemoTraitOperationEvidenceTable impure fn SelfhostTypeId impure fn SelfhostMemoTraitOperationEvidenceRecord Result Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationEvidenceErrorKind StdErrorKind \table\type_id\hash_record:
    match selfhost_memo_trait_operation_evidence_table_push table hash_record:
        Result::Ok next_table:
            let proof %Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationEvidenceErrorKind selfhost_memo_trait_operation_evidence_record_for_type_or_missing_result &next_table type_id
            selfhost_memo_trait_operation_evidence_table_free next_table
            Result::Ok proof
        Result::Err _e:
            Result::Err StdErrorKind::InvalidOperation

//: selfhost_memo_trait_operation_evidence_producer_stage0_push_eq: Eq record を push する
fn selfhost_memo_trait_operation_evidence_producer_stage0_push_eq %impure fn SelfhostMemoTraitOperationEvidenceTable impure fn SelfhostTypeId impure fn SelfhostMemoTraitOperationEvidenceRecord impure fn SelfhostMemoTraitOperationEvidenceRecord Result Result SelfhostMemoTraitOperationProofRecord SelfhostMemoTraitOperationEvidenceErrorKind StdErrorKind \table\type_id\eq_record\hash_record:
    match selfhost_memo_trait_operation_evidence_table_push table eq_record:
        Result::Ok next_table:
            selfhost_memo_trait_operation_evidence_producer_stage0_push_hash next_table type_id hash_record
        Result::Err _e:
