#indent 4

//: # check/module/memo_trait_operation_private_effect_slot_coverage_producer
//: actual traversal が返す PrivateCache / PrivateState slot coverage を、既存 Resource no-escape observation / proof / mask evidence へ[接続/せつぞく]する checker-layer producer です。
//:
//: [目的/もくてき]:
//: - `memo_trait_operation_private_effect_mask_evidence` は、同じ method body identity について `PrivateCache + NotApplicable` と `PrivateState + NotApplicable` の 2 slot proof record を必ず要求します。
//: - `memo_trait_operation_private_effect_resource_no_escape_producer` は typed Resource no-escape observation を proof table へ写すだけで、effect 不在を推測しません。
//: - この module はその間に置き、actual traversal 側が明示した slot coverage だけから fixed 2 slot observation / proof table を作ります。片方の slot が無い場合は effect 不在ではなく coverage 欠落として拒否します。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord` の typed payload だけです。source text、span、lexeme、display name、diagnostic text、module path、public surface hash、payload hash から absence や no-escape を推測しません。
//: - record key は `SelfhostTypeId`、operation、body module fingerprint、method body root、effect、escape をすべて含みます。`SelfhostTypeId` だけ、operation だけ、body root だけの coverage reuse は認めません。
//: - `effect` は `PrivateState` または `PrivateCache`、`escape` は `NotApplicable` だけを受理します。`body_module_fingerprint == 0` は placeholder origin として拒否します。
//: - `EffectAbsentAfterCompleteTraversal` だけが effect 不在を `NoEscapeProven` observation へ写せます。これは actual traversal が同じ body slot を完全に走査したという typed record であり、この module が absence を探して作るものではありません。
//: - `ResourceGraphMissing` は `Missing`、`TraversalUnsupported` は `Unknown` へ写し、Missing / Unknown を Proven に丸めません。
//: - producer は target body identity の `PrivateCache` と `PrivateState` を両方 lookup します。slot 欠落、duplicate、placeholder、wrong effect / escape は typed error として fail-closed にします。
//: - production API は coverage から Resource observation table または proof table を作るところで止めます。mask evidence 接続は stage0 smoke だけで行い、上位 orchestration が別 boundary として扱います。
//: - この module は GraphInput、Resource graph walker、operation evidence record、aggregate proof、memo_call backend request evidence、backend readiness private type、proof store、effect mask 実体、backend bytes、prechecked artifact、`.neplobj` / `.neplproof` artifact key を作りません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では coverage table は caller が渡します。actual Resource IR / HIR traversal 本体は、後続 stage でこの coverage record を producer-owned path から発行します。
//: - facade には re-export しません。full Resource proof orchestration が actual traversal、slot coverage、proof producer、mask evidence、backend readiness handoff をまとめる段階で公開 API を再評価します。
//: - 行数や doc comment の長さによる制限は置きません。Zenn 方針に従い、目的、契約、失敗条件、現状、計算量を明示します。
//:
//: [計算量/けいさんりょう]:
//: - coverage record 数を n とすると、push の重複検査は O(n)、2 slot lookup は O(n) 時間です。
//: - output observation / proof table は fixed 2 slot なので追加空間は O(1) です。lookup index 化や body bucket 化は exact key / duplicate rejection / fail-closed status contract を保ったまま後続 stage で置換できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: ##: [8] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_private_effect_slot_coverage_producer" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_private_effect_mask_evidence" as *
//:| #import "neplg2/core/ty/effect" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_private_effect_slot_coverage_producer_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_private_effect_slot_coverage_mask_result_eq summary.observed_absent_mask SelfhostMemoTraitOperationPrivateEffectMaskStatus::Proven 2
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_private_effect_slot_coverage_mask_status_result_eq summary.may_escape_mask_status SelfhostMemoTraitOperationPrivateEffectMaskStatus::Refuted
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_private_effect_slot_coverage_mask_status_result_eq summary.missing_mask_status SelfhostMemoTraitOperationPrivateEffectMaskStatus::Missing
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_private_effect_slot_coverage_mask_status_result_eq summary.unknown_mask_status SelfhostMemoTraitOperationPrivateEffectMaskStatus::Unknown
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_private_effect_slot_coverage_len_result_eq summary.proof_len 2
//:             let expected_slot_missing %SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageSlotMissing SelfhostEffectKind::PrivateState
//:             let expected_duplicate %SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageRecordDuplicate
//:             let expected_placeholder %SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::BodyModuleFingerprintPlaceholder
//:             let expected_effect %SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate SelfhostEffectKind::InternalAlloc
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_private_effect_slot_coverage_error_result_eq summary.slot_missing_rejected expected_slot_missing
//:             let checks7 checks_push checks6 check selfhost_memo_trait_operation_private_effect_slot_coverage_error_result_eq summary.duplicate_rejected expected_duplicate
//:             let checks8 checks_push checks7 check selfhost_memo_trait_operation_private_effect_slot_coverage_error_result_eq summary.placeholder_rejected expected_placeholder
//:             let checks9 checks_push checks8 check selfhost_memo_trait_operation_private_effect_slot_coverage_error_result_eq summary.effect_rejected expected_effect
//:             let shown checks_print_report checks9
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "private effect slot coverage producer stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "./memo_trait_operation_private_effect_mask_evidence" as *
#import "./memo_trait_operation_private_effect_no_escape_gate" as *
#import "./memo_trait_operation_private_effect_resource_no_escape_producer" as *

//: SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus: actual traversal が private-effect slot ごとに返す coverage 状態
//:
//: [目的/もくてき]:
//: - observed no-escape と complete traversal 後の明示不在を区別したまま、後段 Resource observation status へ写すための enum です。
pub enum SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus:
    EffectObservedNoEscape
    EffectObservedMayEscape
    EffectAbsentAfterCompleteTraversal
    ResourceGraphMissing
    TraversalUnsupported

//: SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord: method body の private-effect 1 slot に対する coverage record
//:
//: [契約/けいやく]:
//: - `type_id`、operation、body module fingerprint、body root、effect、escape は no-escape proof key と同じ identity です。
//: - `status` は actual traversal 側が発行した coverage 状態であり、この module は HIR や source に戻って status を作り直しません。
pub struct SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    status %SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus

//: SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable: slot coverage record の session-local owner table
//:
//: [契約/けいやく]:
//: - table は `records` buffer を所有します。caller は producer で使い終えたあと `selfhost_memo_trait_operation_private_effect_slot_coverage_table_free` で閉じます。
//: - table は永続 proof artifact ではありません。preseed / `.neplproof` からの復元は別 boundary が担当します。
pub struct SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable:
    records %Vec SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord

//: SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind: slot coverage producer の typed error
//:
//: [目的/もくてき]:
//: - coverage input の構造的失敗、2 slot completeness 失敗、lower producer / mask evidence rejection を enum として分けます。
pub enum SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind:
    CoverageRecordPushFailed %StdErrorKind
    CoverageRecordReadFailed %i32
    CoverageRecordDuplicate
    CoverageSlotMissing %SelfhostEffectKind
    BodyModuleFingerprintPlaceholder
    CoverageEffectNotPrivate %SelfhostEffectKind
    CoverageEscapeNotApplicable %SelfhostEffectEscapeState
    ObservationTableAllocFailed %StdErrorKind
    ObservationTableRejected %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind
    ProofTableRejected %SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeProducerErrorKind
    MaskEvidenceRejected %SelfhostMemoTraitOperationPrivateEffectMaskEvidenceErrorKind

//: SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary: slot coverage producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - observed + absent success、MayEscape / Missing / Unknown fold、proof table 生成、slot missing、duplicate、placeholder、wrong effect rejection を確認します。
pub struct SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary:
    observed_absent_mask %Result SelfhostMemoTraitOperationPrivateEffectMaskEvidence SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    may_escape_mask_status %Result SelfhostMemoTraitOperationPrivateEffectMaskStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    missing_mask_status %Result SelfhostMemoTraitOperationPrivateEffectMaskStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    unknown_mask_status %Result SelfhostMemoTraitOperationPrivateEffectMaskStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    proof_len %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    slot_missing_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    duplicate_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    placeholder_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    effect_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind
    escape_rejected %Result i32 SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind

//: Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus: slot coverage status を値として[複製/ふくせい]する
impl Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus:
    fn clone %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus \self:
        *self

//: Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus: slot coverage status の Copy marker
impl Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus:
    fn copy_mark %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus \self:
        self

//: Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord: slot coverage record を値として[複製/ふくせい]する
impl Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord:
    fn clone %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord \self:
        *self

//: Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord: slot coverage record の Copy marker
impl Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord:
    fn copy_mark %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord \self:
        self

//: Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind: producer error を値として[複製/ふくせい]する
impl Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind \self:
        *self

//: Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind: producer error の Copy marker
impl Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind \self:
        self

//: Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary: stage0 summary を値として[複製/ふくせい]する
impl Clone for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary \self:
        *self

//: Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary: stage0 summary の Copy marker
impl Copy for SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary SelfhostMemoTraitOperationPrivateEffectSlotCoverageStage0Summary \self:
        self

//: selfhost_memo_trait_operation_private_effect_slot_coverage_record_new: slot coverage record を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_record_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord \type_id\operation\body_module_fingerprint\body_root\effect\escape\status:
    SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord type_id operation body_module_fingerprint body_root effect escape status

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_new: [空/から]の slot coverage table を[作/つく]る
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_new %impure fn void Result SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_free: slot coverage table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_free %impure fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_len: slot coverage record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_len %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_private_effect_slot_coverage_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_slot_coverage_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_memo_trait_operation_private_effect_slot_coverage_record_key_eq: 2 coverage record が同じ body slot を指すか[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_slot_coverage_record_key_eq %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq a.operation b.operation
            and:
                eq a.body_module_fingerprint b.body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                    and:
                        selfhost_effect_kind_eq a.effect b.effect
                        selfhost_memo_trait_operation_private_effect_slot_coverage_escape_state_eq a.escape b.escape

//: selfhost_memo_trait_operation_private_effect_slot_coverage_key_matches: coverage record が target body slot に一致するか[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_slot_coverage_key_matches %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn SelfhostHirExprId fn SelfhostEffectKind bool \record\type_id\operation\body_module_fingerprint\body_root\effect:
    and:
        selfhost_type_id_eq record.type_id type_id
        and:
            selfhost_memo_trait_operation_evidence_kind_eq record.operation operation
            and:
                eq record.body_module_fingerprint body_module_fingerprint
                and:
                    eq selfhost_hir_expr_id_index record.body_root selfhost_hir_expr_id_index body_root
                    and:
                        selfhost_effect_kind_eq record.effect effect
                        selfhost_memo_trait_operation_private_effect_slot_coverage_escape_state_eq record.escape SelfhostEffectEscapeState::NotApplicable

//: selfhost_memo_trait_operation_private_effect_slot_coverage_validate_effect: private effect だけを[受/う]け[入/い]れる
fn selfhost_memo_trait_operation_private_effect_slot_coverage_validate_effect %fn SelfhostEffectKind Result unit SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind \effect:
    match effect:
        SelfhostEffectKind::PrivateState:
            Result::Ok unit
        SelfhostEffectKind::PrivateCache:
            Result::Ok unit
        SelfhostEffectKind::Pure:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate effect
        SelfhostEffectKind::InternalAlloc:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate effect
        SelfhostEffectKind::UnsafeMemory:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate effect
        SelfhostEffectKind::ExternalIo:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate effect
        SelfhostEffectKind::Nondet:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEffectNotPrivate effect

//: selfhost_memo_trait_operation_private_effect_slot_coverage_validate_record_result: coverage record の受理条件を[確認/かくにん]する
fn selfhost_memo_trait_operation_private_effect_slot_coverage_validate_record_result %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord Result unit SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind \record:
    if:
        eq record.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            match selfhost_memo_trait_operation_private_effect_slot_coverage_validate_effect record.effect:
                Result::Ok _effect_ok:
                    match record.escape:
                        SelfhostEffectEscapeState::NotApplicable:
                            Result::Ok unit
                        SelfhostEffectEscapeState::NoEscapeProven:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEscapeNotApplicable record.escape
                        SelfhostEffectEscapeState::MayEscape:
                            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageEscapeNotApplicable record.escape
                Result::Err e:
                    Result::Err e

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key_loop: input table 内の既存 key を[探/さが]す
fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key_loop %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord fn i32 bool \table\record\idx:
    if:
        ge idx selfhost_memo_trait_operation_private_effect_slot_coverage_table_len table
        then:
            false
        else:
            let records %&Vec SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some existing:
                    if:
                        selfhost_memo_trait_operation_private_effect_slot_coverage_record_key_eq existing record
                        then:
                            true
                        else:
                            selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key_loop table record add idx 1
                Option::None:
                    true

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key: input table に同じ key があるか[返/かえ]す
fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key %fn &SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord bool \table\record:
    selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key_loop table record 0

//: selfhost_memo_trait_operation_private_effect_slot_coverage_table_push: coverage record を table に[追加/ついか]する
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_table_push %impure fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable impure fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord Result SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind \table\record:
    match selfhost_memo_trait_operation_private_effect_slot_coverage_validate_record_result record:
        Result::Ok _unit:
            if:
                selfhost_memo_trait_operation_private_effect_slot_coverage_table_contains_key &table record
                then:
                    selfhost_memo_trait_operation_private_effect_slot_coverage_table_free table
                    Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageRecordDuplicate
                else:
                    let records %Vec SelfhostMemoTraitOperationPrivateEffectSlotCoverageRecord field::get table "records"
                    match v::push records record:
                        Result::Ok next_records:
                            Result::Ok SelfhostMemoTraitOperationPrivateEffectSlotCoverageTable next_records
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err SelfhostMemoTraitOperationPrivateEffectSlotCoverageProducerErrorKind::CoverageRecordPushFailed error
        Result::Err error:
            selfhost_memo_trait_operation_private_effect_slot_coverage_table_free table
            Result::Err error

//: selfhost_memo_trait_operation_private_effect_slot_coverage_status_to_observation_status: coverage status を Resource no-escape observation status へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - observed no-escape と complete traversal 後の明示不在だけが `NoEscapeProven` です。
//: - Missing / Unknown はそのまま fail-closed status として残します。
pub fn selfhost_memo_trait_operation_private_effect_slot_coverage_status_to_observation_status %fn SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus \status:
    match status:
        SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus::EffectObservedNoEscape:
            SelfhostMemoTraitOperationPrivateEffectResourceNoEscapeStatus::NoEscapeProven
        SelfhostMemoTraitOperationPrivateEffectSlotCoverageStatus::EffectObservedMayEscape:
