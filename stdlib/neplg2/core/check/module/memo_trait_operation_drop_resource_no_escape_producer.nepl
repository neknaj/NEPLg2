impl Copy for SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary \self:
        self

//: selfhost_memo_trait_operation_drop_resource_no_escape_record_new: Resource no-escape observation record を[作/つく]る
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_record_new %fn SelfhostTypeId fn i32 fn SelfhostHirExprId fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostMemoTraitOperationDropResourceNoEscapeStatus SelfhostMemoTraitOperationDropResourceNoEscapeRecord \type_id\body_module_fingerprint\body_root\effect\escape\status:
    SelfhostMemoTraitOperationDropResourceNoEscapeRecord type_id body_module_fingerprint body_root effect escape status

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_new: [空/から]の Resource no-escape observation table を[作/つく]る
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_table_new %impure fn void Result SelfhostMemoTraitOperationDropResourceNoEscapeTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationDropResourceNoEscapeRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationDropResourceNoEscapeTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_free: Resource no-escape observation table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_table_free %impure fn SelfhostMemoTraitOperationDropResourceNoEscapeTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_len: Resource no-escape observation record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_table_len %fn &SelfhostMemoTraitOperationDropResourceNoEscapeTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationDropResourceNoEscapeRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_drop_resource_no_escape_escape_state_eq: escape state が同じ variant か[返/かえ]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_escape_state_eq %fn SelfhostEffectEscapeState fn SelfhostEffectEscapeState bool \a\b:
    match a:
        SelfhostEffectEscapeState::NotApplicable:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    true
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::NoEscapeProven:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    true
                SelfhostEffectEscapeState::MayEscape:
                    false
        SelfhostEffectEscapeState::MayEscape:
            match b:
                SelfhostEffectEscapeState::NotApplicable:
                    false
                SelfhostEffectEscapeState::NoEscapeProven:
                    false
                SelfhostEffectEscapeState::MayEscape:
                    true

//: selfhost_memo_trait_operation_drop_resource_no_escape_record_key_eq: 2 record が同じ Drop body observation key か[返/かえ]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_record_key_eq %fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord bool \a\b:
    and:
        selfhost_type_id_eq a.type_id b.type_id
        and:
            eq a.body_module_fingerprint b.body_module_fingerprint
            and:
                eq selfhost_hir_expr_id_index a.body_root selfhost_hir_expr_id_index b.body_root
                and:
                    selfhost_effect_kind_eq a.effect b.effect
                    selfhost_memo_trait_operation_drop_resource_no_escape_escape_state_eq a.escape b.escape

//: selfhost_memo_trait_operation_drop_resource_no_escape_validate_record_result: Resource observation record の受理条件を[確認/かくにん]する
//:
//: [契約/けいやく]:
//: - validation は table push と producer loop の両方で呼びます。外部から直接組み立てられた malformed table でも producer が fail-closed に止まるためです。
fn selfhost_memo_trait_operation_drop_resource_no_escape_validate_record_result %fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord Result unit SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind \record:
    if:
        eq record.body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            if:
                selfhost_effect_kind_eq record.effect SelfhostEffectKind::InternalAlloc
                then:
                    match record.escape:
                        SelfhostEffectEscapeState::NotApplicable:
                            Result::Ok unit
                        SelfhostEffectEscapeState::NoEscapeProven:
                            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::RecordEscapeNotApplicable record.escape
                        SelfhostEffectEscapeState::MayEscape:
                            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::RecordEscapeNotApplicable record.escape
                else:
                    Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::RecordEffectNotInternalAlloc record.effect

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key_loop: input table 内の既存 key を[探/さが]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key_loop %fn &SelfhostMemoTraitOperationDropResourceNoEscapeTable fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord fn i32 bool \table\record\idx:
    if:
        ge idx selfhost_memo_trait_operation_drop_resource_no_escape_table_len table
        then:
            false
        else:
            let records %&Vec SelfhostMemoTraitOperationDropResourceNoEscapeRecord field::get_ref table "records"
            match v::get records idx:
                Option::Some existing:
                    if:
                        selfhost_memo_trait_operation_drop_resource_no_escape_record_key_eq existing record
                        then:
                            true
                        else:
                            selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key_loop table record add idx 1
                Option::None:
                    true

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key: input table に同じ key があるか[返/かえ]す
fn selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key %fn &SelfhostMemoTraitOperationDropResourceNoEscapeTable fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord bool \table\record:
    selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key_loop table record 0

//: selfhost_memo_trait_operation_drop_resource_no_escape_table_push: Resource no-escape observation record を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - record validation と duplicate rejection を push 境界で行います。
//: - validation / duplicate 失敗時は、消費した table owner を閉じて typed error を返します。
//: - Vec push 失敗時は `Vec` が返した owner を閉じ、`StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_table_push %impure fn SelfhostMemoTraitOperationDropResourceNoEscapeTable impure fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord Result SelfhostMemoTraitOperationDropResourceNoEscapeTable SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind \table\record:
    match selfhost_memo_trait_operation_drop_resource_no_escape_validate_record_result record:
        Result::Ok _unit:
            if:
                selfhost_memo_trait_operation_drop_resource_no_escape_table_contains_key &table record
                then:
                    selfhost_memo_trait_operation_drop_resource_no_escape_table_free table
                    Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::ResourceRecordDuplicate
                else:
                    let records %Vec SelfhostMemoTraitOperationDropResourceNoEscapeRecord field::get table "records"
                    match v::push records record:
                        Result::Ok next_records:
                            Result::Ok SelfhostMemoTraitOperationDropResourceNoEscapeTable next_records
                        Result::Err e:
                            let error %StdErrorKind field::get e "error"
                            v::free v::vec_push_error_vec e
                            Result::Err SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::ResourceRecordPushFailed error
        Result::Err error:
            selfhost_memo_trait_operation_drop_resource_no_escape_table_free table
            Result::Err error

//: selfhost_memo_trait_operation_drop_resource_no_escape_status_to_proof_status: Resource status を gate proof status へ[写/うつ]す
//:
//: [契約/けいやく]:
//: - `NoEscapeProven` だけが `Proven` になります。
//: - `MayEscape` は `Refuted` として保存し、後続 gate が `MayEscape` escape state へ戻します。
//: - `Missing` / `Unknown` はそのまま未証明 status として保存し、pure mask に使いません。
pub fn selfhost_memo_trait_operation_drop_resource_no_escape_status_to_proof_status %fn SelfhostMemoTraitOperationDropResourceNoEscapeStatus SelfhostMemoTraitOperationDropNoEscapeProofStatus \status:
    match status:
        SelfhostMemoTraitOperationDropResourceNoEscapeStatus::NoEscapeProven:
            SelfhostMemoTraitOperationDropNoEscapeProofStatus::Proven
        SelfhostMemoTraitOperationDropResourceNoEscapeStatus::MayEscape:
            SelfhostMemoTraitOperationDropNoEscapeProofStatus::Refuted
