#indent 4

//: # check/module/memo_trait_operation_drop_resource_no_escape_producer
//: Drop impl body に対する Resource IR no-escape observation を、既存の Drop no-escape proof table へ[変換/へんかん]する checker-layer producer です。
//:
//: [目的/もくてき]:
//: - `memo_trait_operation_drop_no_escape_gate` は、Drop impl fact と no-escape proof table を照合して `InternalAlloc + NotApplicable` を `NoEscapeProven` または `MayEscape` へ更新します。
//: - この module は、その前段として Resource IR 側の escape analysis が作った typed observation table を受け取り、gate が読める `SelfhostMemoTraitOperationDropNoEscapeProofTable` を作ります。
//: - HIR effect summary だけから proof を作らず、Resource IR 側が明示的に渡した `NoEscapeProven` / `MayEscape` / `Missing` / `Unknown` の status だけを proof status へ写します。
//:
//: [契約/けいやく]:
//: - accepted authority は `SelfhostMemoTraitOperationDropResourceNoEscapeRecord` の typed payload だけです。source text、span、lexeme、display name、diagnostic text、module path、public surface hash、payload hash から no-escape を推測しません。
//: - record key は `SelfhostTypeId`、body module fingerprint、Drop body root、effect、escape をすべて含みます。`SelfhostTypeId` だけの proof reuse は認めません。
//: - `body_module_fingerprint == 0` は placeholder origin なので、input table への push と producer loop の両方で fail-closed に拒否します。
//: - `effect` は `InternalAlloc`、`escape` は `NotApplicable` だけを受理します。`Pure`、`UnsafeMemory`、`ExternalIo`、`Nondet`、`NoEscapeProven`、`MayEscape` の observation から proof record を作りません。
//: - 同じ key の Resource observation が複数ある場合は `ResourceRecordDuplicate` として拒否します。record order による first-wins は使いません。
//: - `NoEscapeProven` は gate 側の `Proven`、`MayEscape` は `Refuted`、`Missing` は `Missing`、`Unknown` は `Unknown` に写します。`Missing` / `Unknown` を pure に mask しません。
//: - この module は `PureDrop`、`NoDropRequired`、operation evidence record、aggregate proof、proof store、generic binder、PrivateCache / PrivateState masking、prechecked artifact を作りません。最終的な Drop evidence は既存の purity gate と operation proof connector が担当します。
//:
//: [現状/げんじょう]:
//: - Phase 1 では Resource IR graph traversal 本体はまだ別 stage に残します。この module は、その traversal が後で出力する typed observation table の session-local 境界です。
//: - facade には re-export しません。full Resource proof orchestration が Drop fact builder、Resource proof producer、no-escape gate、purity gate をまとめる段階で公開 API を再評価します。
//: - 行数や doc comment の長さによる制限は置きません。契約、現状、計算量、owner cleanup を doc comment で明示することを優先します。
//:
//: [計算量/けいさんりょう]:
//: - Resource observation 数を n とすると、input table push の重複検査は現状 O(n) です。producer loop の malformed direct table 検査は合計 O(n^2) 時間、output proof table に O(n) 空間です。
//: - sorted index 化、module/body bucket 化、stable proof artifact からの preseed は、key equality、duplicate rejection、owner cleanup、fail-closed status contract を保ったまま後続 stage で置換できます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: ##: [7] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_resource_no_escape_producer" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_drop_no_escape_gate" as *
//:| #import "neplg2/core/ty/effect" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_memo_trait_operation_drop_resource_no_escape_producer_stage0:
//:         Result::Ok summary:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_len_result_eq summary.produced_len 4
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_proof_status_eq summary.proven_status SelfhostMemoTraitOperationDropNoEscapeProofStatus::Proven
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_proof_status_eq summary.refuted_status SelfhostMemoTraitOperationDropNoEscapeProofStatus::Refuted
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_proof_status_eq summary.missing_status SelfhostMemoTraitOperationDropNoEscapeProofStatus::Missing
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_proof_status_eq summary.unknown_status SelfhostMemoTraitOperationDropNoEscapeProofStatus::Unknown
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_error_result_eq summary.duplicate_rejected SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::ResourceRecordDuplicate
//:             let checks7 checks_push checks6 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_error_result_eq summary.placeholder_rejected SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::BodyModuleFingerprintPlaceholder
//:             let checks8 checks_push checks7 check selfhost_memo_trait_operation_drop_resource_no_escape_producer_error_result_eq summary.effect_rejected SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind::RecordEffectNotInternalAlloc SelfhostEffectKind::ExternalIo
//:             let shown checks_print_report checks8
//:             checks_exit_code shown
//:         Result::Err _setup:
//:             let checks0 checks_new
//:             let checks1 checks_push checks0 Result::Err "drop Resource no-escape producer stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/hir/hir" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty/id" as *
#import "./memo_trait_operation_drop_no_escape_gate" as *

//: SelfhostMemoTraitOperationDropResourceNoEscapeStatus: Resource IR no-escape observation の[状態/じょうたい]
//:
//: [目的/もくてき]:
//: - Resource IR 側の escape analysis が「証明済み」「反証済み」「入力不足」「未判定」を bool に潰さず producer へ渡すための typed status です。
pub enum SelfhostMemoTraitOperationDropResourceNoEscapeStatus:
    NoEscapeProven
    MayEscape
    Missing
    Unknown

//: SelfhostMemoTraitOperationDropResourceNoEscapeRecord: Drop body 1 件に対する Resource no-escape observation
//:
//: [契約/けいやく]:
//: - `type_id`、`body_module_fingerprint`、`body_root` は、Drop impl fact と同じ body identity を表します。
//: - `effect` / `escape` は observation が対象にした元の effect summary です。Phase 1 では `InternalAlloc + NotApplicable` だけを受理します。
//: - `status` は Resource IR 側の判定結果であり、この module は HIR や source に戻って status を作り直しません。
pub struct SelfhostMemoTraitOperationDropResourceNoEscapeRecord:
    type_id %SelfhostTypeId
    body_module_fingerprint %i32
    body_root %SelfhostHirExprId
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    status %SelfhostMemoTraitOperationDropResourceNoEscapeStatus

//: SelfhostMemoTraitOperationDropResourceNoEscapeTable: Resource no-escape observation record の session-local owner table
//:
//: [契約/けいやく]:
//: - table は `records` buffer を所有します。caller は producer で使い終えたあと `selfhost_memo_trait_operation_drop_resource_no_escape_table_free` で閉じます。
//: - table は永続 artifact ではありません。`.neplproof` からの復元や preseed は別 boundary が担当します。
pub struct SelfhostMemoTraitOperationDropResourceNoEscapeTable:
    records %Vec SelfhostMemoTraitOperationDropResourceNoEscapeRecord

//: SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind: Resource no-escape producer の構造的な拒否理由
//:
//: [目的/もくてき]:
//: - input table の構築、typed observation validation、duplicate detection、output proof table 生成の失敗を enum として分けます。
pub enum SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind:
    ResourceRecordPushFailed %StdErrorKind
    ResourceRecordReadFailed %i32
    ResourceRecordDuplicate
    BodyModuleFingerprintPlaceholder
    RecordEffectNotInternalAlloc %SelfhostEffectKind
    RecordEscapeNotApplicable %SelfhostEffectEscapeState
    OutputProofTableAllocFailed %StdErrorKind
    OutputProofTableRejected %SelfhostMemoTraitOperationDropNoEscapeGateErrorKind

//: SelfhostMemoTraitOperationDropResourceNoEscapeDuplicateDecision: direct table scan での duplicate 判定
//:
//: [目的/もくてき]:
//: - malformed direct table の earlier duplicate 検査結果を bool に潰さず、producer loop が exhaustive match で分岐できるようにします。
pub enum SelfhostMemoTraitOperationDropResourceNoEscapeDuplicateDecision:
    UniqueSoFar
    DuplicateFound

//: SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary: producer smoke の代表結果
//:
//: [目的/もくてき]:
//: - 4 種の status mapping、duplicate rejection、placeholder rejection、effect mismatch rejection を確認します。
pub struct SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary:
    produced_len %Result i32 SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind
    proven_status %SelfhostMemoTraitOperationDropNoEscapeProofStatus
    refuted_status %SelfhostMemoTraitOperationDropNoEscapeProofStatus
    missing_status %SelfhostMemoTraitOperationDropNoEscapeProofStatus
    unknown_status %SelfhostMemoTraitOperationDropNoEscapeProofStatus
    duplicate_rejected %Result i32 SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind
    placeholder_rejected %Result i32 SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind
    effect_rejected %Result i32 SelfhostMemoTraitOperationDropResourceNoEscapeProducerErrorKind

