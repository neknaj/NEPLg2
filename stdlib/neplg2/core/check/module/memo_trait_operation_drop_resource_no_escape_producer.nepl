impl Copy for SelfhostMemoTraitOperationDropResourceNoEscapeDuplicateDecision:
    fn copy_mark %fn SelfhostMemoTraitOperationDropResourceNoEscapeDuplicateDecision SelfhostMemoTraitOperationDropResourceNoEscapeDuplicateDecision \self:
