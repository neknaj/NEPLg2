impl Clone for SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary SelfhostMemoTraitOperationDropResourceNoEscapeProducerStage0Summary \self:
