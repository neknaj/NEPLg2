impl Copy for SelfhostMemoTraitOperationDropResourceNoEscapeStatus:
    fn copy_mark %fn SelfhostMemoTraitOperationDropResourceNoEscapeStatus SelfhostMemoTraitOperationDropResourceNoEscapeStatus \self:
        self

