impl Copy for SelfhostMemoTraitOperationDropResourceNoEscapeRecord:
    fn copy_mark %fn SelfhostMemoTraitOperationDropResourceNoEscapeRecord SelfhostMemoTraitOperationDropResourceNoEscapeRecord \self:
