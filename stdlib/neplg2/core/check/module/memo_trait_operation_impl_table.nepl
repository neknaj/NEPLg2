#indent 4

//: # check/module/memo_trait_operation_impl_table
//: Copy / Drop / Eq / Hash の public trait impl 候補 table から、`MemoKey` / `MemoValue` aggregate solver へ渡す operation evidence producer input を[選/えら]ぶ checker-layer module です。
//:
//: [目的/もくてき]:
//: - public surface normalizer が作る trait impl 候補列と、operation classifier / operation evidence producer の間に置く探索境界です。
//: - 候補 table は `SelfhostTypeId` と `SelfhostMemoTraitOperationEvidenceKind` を key として一意の impl 候補を探します。同じ key の候補が複数ある場合は、record order による first-wins にせず `CandidateDuplicate` として拒否します。
//: - 見つかった候補は、trait application input から `SelfhostMemoTraitOperationClassifierEvidence` を作り、さらに `SelfhostMemoTraitOperationEvidenceProducerInput` として producer の構造検査に通します。
//: - この module は「どの public impl が operation 証拠として使われるか」を決める境界であり、method body purity、Drop なし proof、generic impl binder、trait coherence、full public surface orchestration を推測しません。
//:
//: [契約/けいやく]:
//: - accepted candidate は、session-local `SelfhostTypeId`、operation enum、typed public impl header input、typed trait application input、resolved target type shape evidence、method / drop evidence だけから作ります。
//: - `SelfhostMemoTraitPublicImplHeaderInput` は operation evidence producer が再検査します。table は public declaration payload hash、source text、span、lexeme、display name、diagnostic text、module path を authority にしません。
//: - trait operation classifier は `selfhost_memo_trait_operation_classifier_evidence_result` から作ります。operation kind、trait name string、method name string、source spelling だけでは candidate を受理しません。
//: - `resolved_type_shape_hash` と impl header target shape、classifier が読んだ trait application shape と impl header trait application shape、requested operation と classified operation は producer 側でも再照合します。
//: - method body evidence と Drop evidence は上流 checker から渡された typed enum を消費するだけです。`Missing` / `Unknown` / `Impure` をこの module で `Proven` に変換しません。
//: - full orchestration が typed effect fact から candidate を作る場合は、`memo_trait_operation_purity_gate` を通して method body evidence と Drop evidence を作り、それから candidate へ束ねます。
//: - HIR、Resource IR、backend artifact、proof store、`.neplproof` reader / serializer、canonical key codec には依存しません。
//:
//: [現状/げんじょう]:
//: - Phase 1 では候補 table は session-local `Vec` owner table です。永続 artifact や `.neplmeta` の authority にはしません。
//: - method body / Drop effect fact から producer evidence を作る purity gate は接続済みです。
//: - actual method body checker、Drop impl resolver、Copy / Drop / Eq / Hash pure evidence の実計算、generic impl binder / bound detailed evidence の scanner 接続、full public surface orchestration は後続 slice で接続します。
//: - facade にはまだ re-export しません。full operation evidence orchestration が public surface / method / Drop proof をまとめる段階で公開 API を再評価します。
//:
//: [計算量/けいさんりょう]:
//: - table push は `Vec` push の償却 O(1) 時間です。
//: - lookup は候補数 n に対して O(n) 時間、O(1) 追加空間です。これは現状の実装詳細であり、public API を変えずに sorted index や operation 別 bucket へ後から置き換えられます。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_impl_table" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_classifier" as *
//:| #import "neplg2/core/check/module/memo_trait_operation_evidence_producer" as *
//:| #import "neplg2/core/check/module/memo_trait_public_impl_header" as *
//:| #import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
//:| #import "neplg2/core/ty/ty/memo_trait_producer" as *
//:| #import "std/test" as *
//: fn main %impure fn void i32 \void:
//:     let checks0 checks_new
//:     match selfhost_memo_trait_operation_impl_table_stage0:
//:         Result::Ok summary:
//:             let checks1 checks_push checks0 check selfhost_memo_trait_operation_impl_table_record_result_status_eq summary.accepted_record SelfhostMemoTraitAggregateProofStatus::Proven
//:             let checks2 checks_push checks1 check selfhost_memo_trait_operation_impl_table_error_kind_eq unwrap_err summary.missing_rejected SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing
//:             let checks3 checks_push checks2 check selfhost_memo_trait_operation_impl_table_error_kind_eq unwrap_err summary.duplicate_rejected SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate
//:             let checks4 checks_push checks3 check selfhost_memo_trait_operation_impl_table_record_result_classifier_rejected_eq summary.classifier_rejected SelfhostMemoTraitOperationClassifierErrorKind::TraitSourceNotTrusted SelfhostMemoTraitOperationEvidenceKind::Copy
//:             let checks5 checks_push checks4 check selfhost_memo_trait_operation_impl_table_record_result_producer_rejected_eq summary.producer_rejected SelfhostMemoTraitOperationEvidenceProducerErrorKind::HeaderRejected SelfhostMemoTraitPublicImplHeaderErrorKind::GenericBinderEvidenceMissing
//:             let checks6 checks_push checks5 check selfhost_memo_trait_operation_impl_table_record_result_producer_rejected_eq summary.target_mismatch_rejected SelfhostMemoTraitOperationEvidenceProducerErrorKind::TargetTypeShapeMismatch
//:             let shown checks_print_report checks6
//:             checks_exit_code shown
//:         Result::Err _e:
//:             let checks1 checks_push checks0 Result::Err "memo trait operation impl table stage0 setup failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "neplg2/core/ty/ty/memo_trait_producer" as *
#import "./memo_trait_operation_classifier" as *
#import "./memo_trait_operation_evidence_producer" as *
#import "./memo_trait_public_impl_header" as *
#import "./memo_trait_operation_purity_gate" as *

//: SelfhostMemoTraitOperationImplCandidate: operation impl table の 1 候補
//:
//: [目的/もくてき]:
//: - public impl header、trait application、resolved target shape、method / drop evidence を、1 つの探索候補として束ねます。
//:
//: [契約/けいやく]:
//: - `type_id` と `operation` は lookup key です。
//: - `trait_application` は classifier が読む stable trait application input です。候補 constructor は classifier evidence を作りません。
//: - `method_body` と `drop_evidence` は上流 checker が作った typed evidence であり、この table はその正しさを推測しません。
pub struct SelfhostMemoTraitOperationImplCandidate:
    type_id %SelfhostTypeId
    operation %SelfhostMemoTraitOperationEvidenceKind
    impl_header %SelfhostMemoTraitPublicImplHeaderInput
    trait_application %SelfhostMemoTraitOperationTraitApplicationInput
    resolved_type_shape_hash %Option i32
    method_body %SelfhostMemoTraitOperationMethodBodyEvidence
    drop_evidence %SelfhostMemoTraitOperationDropEvidence

//: SelfhostMemoTraitOperationImplTable: operation impl 候補の session-local owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。不要になったら `selfhost_memo_trait_operation_impl_table_free` で閉じます。
//: - table は checker-layer の探索用であり、永続 artifact key や public surface hash の authority ではありません。
pub struct SelfhostMemoTraitOperationImplTable:
    records %Vec SelfhostMemoTraitOperationImplCandidate

//: SelfhostMemoTraitOperationImplTableErrorKind: impl table 境界の拒否理由
//:
//: [目的/もくてき]:
//: - lookup 欠落、重複、table read 不整合、push 失敗、classifier rejection、producer rejection を bool ではなく typed enum として保持します。
pub enum SelfhostMemoTraitOperationImplTableErrorKind:
    CandidateMissing
    CandidateDuplicate
    CandidateReadFailed %i32
    CandidatePushFailed %StdErrorKind
    ClassifierRejected %SelfhostMemoTraitOperationClassifierErrorKind
    ProducerRejected %SelfhostMemoTraitOperationEvidenceProducerErrorKind

//: SelfhostMemoTraitOperationImplTableStage0Summary: impl table smoke の代表結果
//:
//: [目的/もくてき]:
//: - accepted record、missing、duplicate、classifier rejection、producer rejection を public API 経由で確認します。
pub struct SelfhostMemoTraitOperationImplTableStage0Summary:
    accepted_record %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind
    missing_rejected %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind
    duplicate_rejected %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind
    classifier_rejected %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind
    producer_rejected %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind
    target_mismatch_rejected %Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind

impl Clone for SelfhostMemoTraitOperationImplCandidate:
    fn clone %fn &SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplCandidate \self:
        *self

impl Copy for SelfhostMemoTraitOperationImplCandidate:
    fn copy_mark %fn SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplCandidate \self:
        self

impl Clone for SelfhostMemoTraitOperationImplTableErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationImplTableErrorKind SelfhostMemoTraitOperationImplTableErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationImplTableErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationImplTableErrorKind SelfhostMemoTraitOperationImplTableErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationImplTableStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationImplTableStage0Summary SelfhostMemoTraitOperationImplTableStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationImplTableStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationImplTableStage0Summary SelfhostMemoTraitOperationImplTableStage0Summary \self:
        self

//: selfhost_memo_trait_operation_impl_candidate_new: operation impl 候補を[作/つく]る
//:
//: [契約/けいやく]:
//: - この constructor は typed field を束ねるだけです。classifier / producer validation は result API が実行します。
pub fn selfhost_memo_trait_operation_impl_candidate_new %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostMemoTraitPublicImplHeaderInput fn SelfhostMemoTraitOperationTraitApplicationInput fn Option i32 fn SelfhostMemoTraitOperationMethodBodyEvidence fn SelfhostMemoTraitOperationDropEvidence SelfhostMemoTraitOperationImplCandidate \type_id\operation\impl_header\trait_application\resolved_type_shape_hash\method_body\drop_evidence:
    SelfhostMemoTraitOperationImplCandidate type_id operation impl_header trait_application resolved_type_shape_hash method_body drop_evidence

//: selfhost_memo_trait_operation_impl_candidate_from_checks_result: method / Drop check fact から operation impl 候補を[作/つく]る
//:
//: [目的/もくてき]:
//: - full orchestration が、method body effect summary と Drop proof summary を直接 `SelfhostMemoTraitOperationMethodBodyEvidence` / `SelfhostMemoTraitOperationDropEvidence` へ手で写さず、purity gate を通して candidate を作れるようにします。
//:
//: [契約/けいやく]:
//: - method body check と Drop check は operation kind に応じた必要性 matrix を `memo_trait_operation_purity_gate` 側で検査します。
//: - purity gate が返した `Missing` / `Unknown` / `Impure` はそのまま candidate に保存し、impl table では `Proven` へ変換しません。
pub fn selfhost_memo_trait_operation_impl_candidate_from_checks_result %fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn SelfhostMemoTraitPublicImplHeaderInput fn SelfhostMemoTraitOperationTraitApplicationInput fn Option i32 fn SelfhostMemoTraitOperationMethodBodyCheck fn SelfhostMemoTraitOperationDropCheck Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationPurityGateErrorKind \type_id\operation\impl_header\trait_application\resolved_type_shape_hash\method_check\drop_check:
    match selfhost_memo_trait_operation_purity_gate_method_body_evidence_result operation method_check:
        Result::Ok method_body:
            match selfhost_memo_trait_operation_purity_gate_drop_evidence_result operation drop_check:
                Result::Ok drop_evidence:
                    Result::Ok selfhost_memo_trait_operation_impl_candidate_new type_id operation impl_header trait_application resolved_type_shape_hash method_body drop_evidence
                Result::Err drop_error:
                    Result::Err drop_error
        Result::Err method_error:
            Result::Err method_error

//: selfhost_memo_trait_operation_impl_table_new: [空/から]の impl candidate table を[作/つく]る
pub fn selfhost_memo_trait_operation_impl_table_new %impure fn void Result SelfhostMemoTraitOperationImplTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationImplCandidate StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationImplTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_impl_table_free: impl candidate table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_impl_table_free %impure fn SelfhostMemoTraitOperationImplTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_impl_table_len: impl candidate 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_impl_table_len %fn &SelfhostMemoTraitOperationImplTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationImplCandidate field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_impl_table_push: impl candidate を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - push 失敗時は `Vec` が返した owner を閉じ、`CandidatePushFailed(error)` として `StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_impl_table_push %impure fn SelfhostMemoTraitOperationImplTable impure fn SelfhostMemoTraitOperationImplCandidate Result SelfhostMemoTraitOperationImplTable SelfhostMemoTraitOperationImplTableErrorKind \table\candidate:
    let records %Vec SelfhostMemoTraitOperationImplCandidate field::get table "records"
    match v::push records candidate:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationImplTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed error

//: selfhost_memo_trait_operation_impl_candidate_key_matches: candidate が lookup key に[一致/いっち]するか[返/かえ]す
fn selfhost_memo_trait_operation_impl_candidate_key_matches %fn SelfhostMemoTraitOperationImplCandidate fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind bool \candidate\type_id\operation:
    and:
        selfhost_type_id_eq candidate.type_id type_id
        selfhost_memo_trait_operation_evidence_kind_eq candidate.operation operation

//: selfhost_memo_trait_operation_impl_find_finish: lookup 結果を typed result へ[畳/たた]む
fn selfhost_memo_trait_operation_impl_find_finish %fn Option SelfhostMemoTraitOperationImplCandidate Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind \found:
    match found:
        Option::Some candidate:
            Result::Ok candidate
        Option::None:
            Result::Err SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing

//: selfhost_memo_trait_operation_impl_find_loop: TypeId / operation に対応する impl candidate を[探/さが]す
//:
//: [目的/もくてき]:
//: - lookup key は `SelfhostTypeId` と operation enum です。source spelling や method name string では探索しません。
//: - 同じ key の候補が 2 件以上ある場合は `CandidateDuplicate` として拒否し、record order による first-wins を避けます。
fn selfhost_memo_trait_operation_impl_find_loop %fn &SelfhostMemoTraitOperationImplTable fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind fn i32 fn Option SelfhostMemoTraitOperationImplCandidate Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind \table\type_id\operation\idx\found:
    if:
        ge idx selfhost_memo_trait_operation_impl_table_len table
        then:
            selfhost_memo_trait_operation_impl_find_finish found
        else:
            let records %&Vec SelfhostMemoTraitOperationImplCandidate field::get_ref table "records"
            match v::get records idx:
                Option::Some candidate:
                    if:
                        selfhost_memo_trait_operation_impl_candidate_key_matches candidate type_id operation
                        then:
                            match found:
                                Option::Some _existing:
                                    Result::Err SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate
                                Option::None:
                                    selfhost_memo_trait_operation_impl_find_loop table type_id operation add idx 1 some candidate
                        else:
                            selfhost_memo_trait_operation_impl_find_loop table type_id operation add idx 1 found
                Option::None:
                    Result::Err SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed idx

//: selfhost_memo_trait_operation_impl_candidate_for_type_operation_result: TypeId / operation に対応する raw candidate を[返/かえ]す
pub fn selfhost_memo_trait_operation_impl_candidate_for_type_operation_result %fn &SelfhostMemoTraitOperationImplTable fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind \table\type_id\operation:
    selfhost_memo_trait_operation_impl_find_loop table type_id operation 0 none

//: selfhost_memo_trait_operation_impl_candidate_producer_input_result: raw candidate を producer input へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - trait application input は classifier public API を通して shape-bound classifier evidence にします。
//: - producer input を返す前に `selfhost_memo_trait_operation_evidence_producer_status_result` を通し、public impl header、target shape、classifier shape、operation kind、method / drop evidence applicability が構造的に妥当か確認します。
pub fn selfhost_memo_trait_operation_impl_candidate_producer_input_result %fn SelfhostMemoTraitOperationImplCandidate Result SelfhostMemoTraitOperationEvidenceProducerInput SelfhostMemoTraitOperationImplTableErrorKind \candidate:
    match selfhost_memo_trait_operation_classifier_evidence_result candidate.trait_application:
        Result::Ok trait_operation:
            let input %SelfhostMemoTraitOperationEvidenceProducerInput selfhost_memo_trait_operation_evidence_producer_input_new candidate.type_id candidate.operation trait_operation candidate.impl_header candidate.resolved_type_shape_hash candidate.method_body candidate.drop_evidence
            match selfhost_memo_trait_operation_evidence_producer_status_result input:
                Result::Ok _status:
                    Result::Ok input
                Result::Err producer_error:
                    Result::Err SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected producer_error
        Result::Err classifier_error:
            Result::Err SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected classifier_error

//: selfhost_memo_trait_operation_impl_producer_input_for_type_operation_result: table から producer input を[取/と]り[出/だ]す
pub fn selfhost_memo_trait_operation_impl_producer_input_for_type_operation_result %fn &SelfhostMemoTraitOperationImplTable fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind Result SelfhostMemoTraitOperationEvidenceProducerInput SelfhostMemoTraitOperationImplTableErrorKind \table\type_id\operation:
    match selfhost_memo_trait_operation_impl_candidate_for_type_operation_result table type_id operation:
        Result::Ok candidate:
            selfhost_memo_trait_operation_impl_candidate_producer_input_result candidate
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_impl_record_for_type_operation_result: table から operation evidence record を[作/つく]る
//:
//: [目的/もくてき]:
//: - impl candidate table の探索結果を、ty 層の operation evidence transport が読める record へ接続します。
//:
//: [契約/けいやく]:
//: - producer input はこの module で一度構造検査済みですが、record 作成時にも producer を通します。下流 producer の contract を迂回しません。
pub fn selfhost_memo_trait_operation_impl_record_for_type_operation_result %fn &SelfhostMemoTraitOperationImplTable fn SelfhostTypeId fn SelfhostMemoTraitOperationEvidenceKind Result SelfhostMemoTraitOperationEvidenceRecord SelfhostMemoTraitOperationImplTableErrorKind \table\type_id\operation:
    match selfhost_memo_trait_operation_impl_producer_input_for_type_operation_result table type_id operation:
        Result::Ok input:
            match selfhost_memo_trait_operation_evidence_producer_record_result input:
                Result::Ok record:
                    Result::Ok record
                Result::Err producer_error:
                    Result::Err SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected producer_error
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_impl_table_error_kind_eq: impl table error が同じ分類か[返/かえ]す
//:
//: [契約/けいやく]:
//: - payload を持つ error は payload まで比較します。
//: - wildcard arm は使いません。error variant が増えた場合はこの equality 境界を明示的に更新します。
pub fn selfhost_memo_trait_operation_impl_table_error_kind_eq %fn SelfhostMemoTraitOperationImplTableErrorKind fn SelfhostMemoTraitOperationImplTableErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
            match b:
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
                    true
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed _b_idx:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed _b_push:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected _b_classifier:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected _b_producer:
                    false
        SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
            match b:
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
                    true
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed _b_idx:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed _b_push:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected _b_classifier:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected _b_producer:
                    false
        SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed a_idx:
            match b:
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed b_idx:
                    eq a_idx b_idx
                SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed _b_push:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected _b_classifier:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected _b_producer:
                    false
        SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed a_push:
            match b:
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateMissing:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateDuplicate:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidateReadFailed _b_idx:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::CandidatePushFailed b_push:
                    selfhost_memo_trait_operation_impl_table_std_error_kind_eq a_push b_push
                SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected _b_classifier:
                    false
                SelfhostMemoTraitOperationImplTableErrorKind::ProducerRejected _b_producer:
                    false
        SelfhostMemoTraitOperationImplTableErrorKind::ClassifierRejected a_classifier:
            match b:
