//: SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary: stage0 が owner を閉じた後に保持する代表 status
//:
//: [目的/もくてき]:
//: - accepted path の table length と Copy / Drop / Eq / Hash status を、owner を持たない Copy payload として保持します。
pub struct SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary:
    table_len %i32
    copy_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind
    drop_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind
    eq_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind
    hash_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind

//: SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind: no-drop absence evidence connector の typed error
//:
//: [目的/もくてき]:
//: - absence producer、evidence table 事前 lookup / push、既存 Drop record、lower gate の退行を enum として分けます。
//:
//: [契約/けいやく]:
//: - `AbsenceProducerRejected` は lower producer の typed error を保持します。
//: - `EvidenceTableRejected` は duplicate / push failure など table consistency の失敗を保持します。
//: - `DropEvidenceAlreadyPresent` は既に Drop status が存在するため absence connector が上書きしないことを表します。
//: - `UnexpectedDropEvidence` は lower producer が `NoDropRequired` 以外を返した場合の fail-closed guard です。
pub enum SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind:
    AbsenceProducerRejected %SelfhostMemoTraitOperationDropAbsenceProducerErrorKind
    EvidenceTableRejected %SelfhostMemoTraitOperationEvidenceErrorKind
    DropEvidenceAlreadyPresent %SelfhostMemoTraitAggregateProofStatus
    UnexpectedDropEvidence %SelfhostMemoTraitOperationDropEvidence

//: SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorStage0Summary: connector smoke の代表結果
//:
//: [目的/もくてき]:
//: - empty table 増補、既存 Copy / Eq / Hash 保持、present / missing surface rejection、duplicate / existing Drop rejection をまとめます。
pub struct SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorStage0Summary:
    accepted_empty %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind
    accepted_existing %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind
    present_rejected %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind
    missing_rejected %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind
    duplicate_rejected %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind
    existing_drop_rejected %Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind

