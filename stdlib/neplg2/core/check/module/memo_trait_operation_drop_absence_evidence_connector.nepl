//: selfhost_memo_trait_operation_drop_absence_evidence_connector_preflight_result: Drop record の既存有無を[検査/けんさ]する
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(table)`: 対象 TypeId / Drop record が存在しません。caller は no-drop absence を追加できます。
//: - `Err(DropEvidenceAlreadyPresent(_))`: 既存 Drop status があるため、absence connector は上書きしません。この関数は返る前に table owner を閉じます。
//: - `Err(EvidenceTableRejected(_))`: duplicate など table consistency failure です。この関数は返る前に table owner を閉じます。
fn selfhost_memo_trait_operation_drop_absence_evidence_connector_preflight_result %impure fn SelfhostMemoTraitOperationEvidenceTable impure fn SelfhostTypeId Result SelfhostMemoTraitOperationEvidenceTable SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind \table\type_id:
    match selfhost_memo_trait_operation_evidence_status_for_type_operation_result &table type_id SelfhostMemoTraitOperationEvidenceKind::Drop:
        Result::Ok status:
            selfhost_memo_trait_operation_evidence_table_free table
            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent status
        Result::Err evidence_error:
            match evidence_error:
                SelfhostMemoTraitOperationEvidenceErrorKind::RecordMissing:
                    Result::Ok table
                SelfhostMemoTraitOperationEvidenceErrorKind::DuplicateRecord:
                    selfhost_memo_trait_operation_evidence_table_free table
                    Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected SelfhostMemoTraitOperationEvidenceErrorKind::DuplicateRecord
                SelfhostMemoTraitOperationEvidenceErrorKind::RecordPushFailed push_error:
                    selfhost_memo_trait_operation_evidence_table_free table
                    Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected SelfhostMemoTraitOperationEvidenceErrorKind::RecordPushFailed push_error

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_push_no_drop_result: no-drop absence evidence を operation evidence table へ[追加/ついか]する
//:
//: [目的/もくてき]:
//: - producer が返した `NoDropRequired` を、solver が理解できる `Drop: Proven` operation evidence record へ写します。
//:
//: [契約/けいやく]:
//: - 追加前に `selfhost_memo_trait_operation_drop_absence_evidence_connector_preflight_result` を通し、既存 Drop record と duplicate を拒否します。
//: - producer が失敗した場合は、preflight 後の table owner をこの関数が閉じます。
//: - push 失敗時は `selfhost_memo_trait_operation_evidence_table_push` が owner を消費しているため、この関数では追加の free を行いません。
pub fn selfhost_memo_trait_operation_drop_absence_evidence_connector_push_no_drop_result %impure fn SelfhostMemoTraitOperationEvidenceTable impure fn SelfhostMemoTraitOperationDropImplSurfaceState impure fn &SelfhostMemoTraitOperationDropImplTable impure fn SelfhostTypeId Result SelfhostMemoTraitOperationEvidenceTable SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind \table\surface\drop_table\type_id:
    match selfhost_memo_trait_operation_drop_absence_evidence_connector_preflight_result table type_id:
        Result::Ok checked_table:
            match selfhost_memo_trait_operation_drop_absence_evidence_result surface drop_table type_id:
                Result::Ok evidence:
                    match evidence:
                        SelfhostMemoTraitOperationDropEvidence::NoDropRequired:
                            let record %SelfhostMemoTraitOperationEvidenceRecord selfhost_memo_trait_operation_evidence_record_new type_id SelfhostMemoTraitOperationEvidenceKind::Drop SelfhostMemoTraitAggregateProofStatus::Proven
                            match selfhost_memo_trait_operation_evidence_table_push checked_table record:
                                Result::Ok next_table:
                                    Result::Ok next_table
                                Result::Err push_error:
                                    Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected push_error
                        SelfhostMemoTraitOperationDropEvidence::PureDrop:
                            selfhost_memo_trait_operation_evidence_table_free checked_table
                            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence evidence
                        SelfhostMemoTraitOperationDropEvidence::Missing:
                            selfhost_memo_trait_operation_evidence_table_free checked_table
                            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence evidence
                        SelfhostMemoTraitOperationDropEvidence::ImpureDrop:
                            selfhost_memo_trait_operation_evidence_table_free checked_table
                            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence evidence
                        SelfhostMemoTraitOperationDropEvidence::Unknown:
                            selfhost_memo_trait_operation_evidence_table_free checked_table
                            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence evidence
                        SelfhostMemoTraitOperationDropEvidence::NotRequired:
                            selfhost_memo_trait_operation_evidence_table_free checked_table
                            Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence evidence
                Result::Err producer_error:
                    selfhost_memo_trait_operation_evidence_table_free checked_table
                    Result::Err SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected producer_error
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_summary_from_table: evidence table owner を summary へ[変換/へんかん]して[閉/と]じる
//:
//: [契約/けいやく]:
//: - caller から受け取った owner はこの関数内で必ず閉じます。
fn selfhost_memo_trait_operation_drop_absence_evidence_connector_summary_from_table %impure fn SelfhostMemoTraitOperationEvidenceTable impure fn SelfhostTypeId SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary \table\type_id:
    let table_len %i32 selfhost_memo_trait_operation_evidence_table_len &table
    let copy_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind selfhost_memo_trait_operation_evidence_status_for_type_operation_or_missing_result &table type_id SelfhostMemoTraitOperationEvidenceKind::Copy
    let drop_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind selfhost_memo_trait_operation_evidence_status_for_type_operation_or_missing_result &table type_id SelfhostMemoTraitOperationEvidenceKind::Drop
    let eq_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind selfhost_memo_trait_operation_evidence_status_for_type_operation_or_missing_result &table type_id SelfhostMemoTraitOperationEvidenceKind::Eq
    let hash_status %Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind selfhost_memo_trait_operation_evidence_status_for_type_operation_or_missing_result &table type_id SelfhostMemoTraitOperationEvidenceKind::Hash
    selfhost_memo_trait_operation_evidence_table_free table
    SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary table_len copy_status drop_status eq_status hash_status

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_error_kind_eq: connector error が同じ分類と payload か[返/かえ]す
//:
//: [契約/けいやく]:
//: - nested producer / evidence table error は lower boundary の equality helper で比較します。
//: - wildcard arm は使いません。variant が増えた場合はこの equality 境界を明示的に更新します。
pub fn selfhost_memo_trait_operation_drop_absence_evidence_connector_error_kind_eq %fn SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind fn SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected a_producer:
            match b:
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected b_producer:
                    selfhost_memo_trait_operation_drop_absence_error_kind_eq a_producer b_producer
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected _b_table:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent _b_status:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence _b_evidence:
                    false
        SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected a_table:
            match b:
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected _b_producer:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected b_table:
                    selfhost_memo_trait_operation_evidence_error_kind_eq a_table b_table
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent _b_status:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence _b_evidence:
                    false
        SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent a_status:
            match b:
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected _b_producer:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected _b_table:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent b_status:
                    selfhost_memo_trait_operation_evidence_status_eq a_status b_status
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence _b_evidence:
                    false
        SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence a_evidence:
            match b:
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::AbsenceProducerRejected _b_producer:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::EvidenceTableRejected _b_table:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::DropEvidenceAlreadyPresent _b_status:
                    false
                SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind::UnexpectedDropEvidence b_evidence:
                    selfhost_memo_trait_operation_drop_absence_producer_evidence_result_eq Result::Ok a_evidence b_evidence

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq: status Result が期待 status か[返/かえ]す
fn selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq %fn Result SelfhostMemoTraitAggregateProofStatus SelfhostMemoTraitOperationEvidenceErrorKind fn SelfhostMemoTraitAggregateProofStatus bool \result\expected:
    match result:
        Result::Ok status:
            selfhost_memo_trait_operation_evidence_status_eq status expected
        Result::Err _e:
            false

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_accepted_summary_eq: accepted summary が期待 status か[返/かえ]す
fn selfhost_memo_trait_operation_drop_absence_evidence_connector_accepted_summary_eq %fn SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary fn i32 fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus bool \summary\expected_len\expected_copy\expected_drop\expected_eq\expected_hash:
    and:
        eq summary.table_len expected_len
        and:
            selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq summary.copy_status expected_copy
            and:
                selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq summary.drop_status expected_drop
                and:
                    selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq summary.eq_status expected_eq
                    selfhost_memo_trait_operation_drop_absence_evidence_connector_status_result_eq summary.hash_status expected_hash

//: selfhost_memo_trait_operation_drop_absence_evidence_connector_accepted_result_eq: Result payload が期待 summary か[返/かえ]す
pub fn selfhost_memo_trait_operation_drop_absence_evidence_connector_accepted_result_eq %fn Result SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorAcceptedSummary SelfhostMemoTraitOperationDropAbsenceEvidenceConnectorErrorKind fn i32 fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus fn SelfhostMemoTraitAggregateProofStatus bool \result\expected_len\expected_copy\expected_drop\expected_eq\expected_hash:
