//: SelfhostMemoTraitOperationPublicImplMaterializerRecordTable: typed materializer record の owner table
//:
//: [契約/けいやく]:
//: - `records` は owner buffer です。materializer public API は borrow で読み、閉じません。
//: - この table は session-local public impl materialization 結果です。永続 artifact key や public surface hash の authority ではありません。
pub struct SelfhostMemoTraitOperationPublicImplMaterializerRecordTable:
    records %Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord

//: SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary: accepted path の代表結果
//:
//: [目的/もくてき]:
//: - stage0 doctest が output candidate table owner を閉じた後でも、candidate 数と operation 別 lookup 結果を確認できるようにします。
pub struct SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary:
    len %i32
    copy_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind
    eq_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind
    hash_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind

//: SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch: proof-aware call と record の module identity 不一致
//:
//: [目的/もくてき]:
//: - private-effect proof key は body module fingerprint を含むため、caller が指定した fingerprint と record authority の不一致を typed payload として保持します。
pub struct SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch:
    record_module_fingerprint %i32
    body_module_fingerprint %i32

//: SelfhostMemoTraitOperationPublicImplMaterializerErrorKind: public impl materializer 境界の拒否理由
//:
//: [目的/もくてき]:
//: - source record table setup、builder input table setup、source read、classifier rejection、builder input push、candidate builder rejection を typed enum として保持します。
pub enum SelfhostMemoTraitOperationPublicImplMaterializerErrorKind:
    RecordTableAllocFailed %StdErrorKind
    RecordPushFailed %StdErrorKind
    BuilderInputTableAllocFailed %StdErrorKind
    SourceReadFailed %i32
    GenericConnectorReadFailed %i32
    GenericConnectorMissing %i32
    GenericConnectorDuplicate %i32
    HeaderRejected %SelfhostMemoTraitPublicImplHeaderErrorKind
    GenericImplInstantiationUnsupported
    GenericConnectorRejected %SelfhostMemoTraitPublicImplGenericMaterializerConnectorErrorKind
    ClassifierRejected %SelfhostMemoTraitOperationClassifierErrorKind
    BodyModuleFingerprintPlaceholder
    BodyModuleFingerprintMismatch %SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch
    BuilderInputPushRejected %SelfhostMemoTraitOperationImplCandidateBuilderErrorKind
    CandidateBuilderRejected %SelfhostMemoTraitOperationImplCandidateBuilderErrorKind

//: SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary: materializer smoke の代表結果
pub struct SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary:
    accepted %Result SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    untrusted_rejected %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    duplicate_rejected %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    drop_unsupported %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    generic_unsupported %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    private_effect_proven %Result SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    private_effect_missing %Result SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    private_effect_duplicate_rejected %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind
    fingerprint_mismatch %Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary \self:
        self

//: Clone for SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch: mismatch payload を値として[複製/ふくせい]する
impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch \self:
        *self

//: Copy for SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch: owner を含まない mismatch payload の copy marker
impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch \self:
        self

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerErrorKind SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerErrorKind SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary \self:
        self

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_new: [空/から]の materializer record table を[作/つく]る
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_new %impure fn void Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationPublicImplMaterializerRecordTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_free: materializer record table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_free %impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecordTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_len: materializer record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_len %fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_public_impl_materializer_body_module_fingerprint_mismatch_new: fingerprint 不一致 payload を[作/つく]る
fn selfhost_memo_trait_operation_public_impl_materializer_body_module_fingerprint_mismatch_new %fn i32 fn i32 SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch \record_module_fingerprint\body_module_fingerprint:
    SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch record_module_fingerprint body_module_fingerprint

//: selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_loop: source record が単一 body module fingerprint に属するか[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - proof-aware candidate builder は 1 回の call-level `body_module_fingerprint` で scan record 全体を処理します。
//: - materializer record の `module_fingerprint` と一致しない record が混ざる場合、proof table を読む前に fail-closed に拒否します。
fn selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_loop %fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable fn i32 fn i32 Result unit SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \source\body_module_fingerprint\index:
    if:
        ge index selfhost_memo_trait_operation_public_impl_materializer_record_table_len source
        then:
            Result::Ok ()
        else:
            let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    if:
                        eq record.module_fingerprint body_module_fingerprint
                        then:
                            selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_loop source body_module_fingerprint add index 1
                        else:
                            let mismatch %SelfhostMemoTraitOperationPublicImplMaterializerBodyModuleFingerprintMismatch:
                                selfhost_memo_trait_operation_public_impl_materializer_body_module_fingerprint_mismatch_new record.module_fingerprint body_module_fingerprint
                            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::BodyModuleFingerprintMismatch mismatch
                Option::None:
                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_result: proof-aware call-level fingerprint を[検査/けんさ]する
//:
//: [契約/けいやく]:
//: - `0` は placeholder module identity なので、record が空であっても proof-aware path では拒否します。
pub fn selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_result %fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable fn i32 Result unit SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \source\body_module_fingerprint:
    if:
        eq body_module_fingerprint 0
        then:
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::BodyModuleFingerprintPlaceholder
        else:
            selfhost_memo_trait_operation_public_impl_materializer_validate_body_module_fingerprint_loop source body_module_fingerprint 0

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_push: materializer record を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の owner を返します。
//: - push 失敗時は `Vec` が返した owner を閉じ、`RecordPushFailed(error)` として `StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_push %impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \table\record:
    let records %Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationPublicImplMaterializerRecordTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::RecordPushFailed error

//: selfhost_memo_trait_operation_public_impl_materializer_header_input: materializer record から public impl header input を[作/つく]る
//:
//: [契約/けいやく]:
//: - header field は record の typed payload だけから写します。source declaration text や module path へ戻りません。
fn selfhost_memo_trait_operation_public_impl_materializer_header_input %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitPublicImplHeaderInput \record:
    selfhost_memo_trait_public_impl_header_input_new record.visibility record.module_fingerprint record.declaration_ordinal record.impl_kind record.target_type_shape_hash record.trait_application_shape_hash record.type_parameter_count record.type_parameter_bound_count record.generic_binder_evidence

//: selfhost_memo_trait_operation_public_impl_materializer_trait_application_input: materializer record から classifier input を[作/つく]る
fn selfhost_memo_trait_operation_public_impl_materializer_trait_application_input %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitOperationTraitApplicationInput \record:
    selfhost_memo_trait_operation_trait_application_input_new record.trait_source record.trait_type_argument_count record.trait_application_shape_hash

//: selfhost_memo_trait_operation_public_impl_materializer_record_declaration_ordinal_result: record の public declaration ordinal を[取/と]り[出/だ]す
fn selfhost_memo_trait_operation_public_impl_materializer_record_declaration_ordinal_result %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \record:
    match record.declaration_ordinal:
        Option::Some ordinal:
            if:
                eq ordinal 0
                then:
                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalPlaceholder
                else:
                    if:
                        lt ordinal 0
                        then:
                            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalNegative
                        else:
                            Result::Ok ordinal
        Option::None:
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected SelfhostMemoTraitPublicImplHeaderErrorKind::DeclarationOrdinalMissing

//: selfhost_memo_trait_operation_public_impl_materializer_shape_option_result: shape hash option を[検査/けんさ]して[取/と]り[出/だ]す
fn selfhost_memo_trait_operation_public_impl_materializer_shape_option_result %fn Option i32 fn SelfhostMemoTraitPublicImplHeaderErrorKind fn SelfhostMemoTraitPublicImplHeaderErrorKind Result i32 SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \shape\missing_error\placeholder_error:
    match shape:
        Option::Some value:
            if:
                eq value 0
                then:
                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected placeholder_error
                else:
                    Result::Ok value
        Option::None:
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected missing_error

//: selfhost_memo_trait_operation_public_impl_materializer_generic_connector_lookup_loop: declaration ordinal に対応する generic connector input を[探/さが]す
//:
//: [契約/けいやく]:
//: - 複数の input が同じ declaration ordinal を持つ場合は first-wins にせず `GenericConnectorDuplicate` で拒否します。
//: - 読み取り失敗は `GenericConnectorReadFailed(index)` として typed payload に残します。
fn selfhost_memo_trait_operation_public_impl_materializer_generic_connector_lookup_loop %fn &SelfhostMemoTraitPublicImplGenericMaterializerConnectorInputTable fn i32 fn i32 fn Option SelfhostMemoTraitPublicImplGenericMaterializerConnectorInput Result SelfhostMemoTraitPublicImplGenericMaterializerConnectorInput SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \source\declaration_ordinal\index\found:
    if:
        ge index selfhost_memo_trait_public_impl_generic_materializer_connector_input_table_len source
        then:
            match found:
                Option::Some input:
