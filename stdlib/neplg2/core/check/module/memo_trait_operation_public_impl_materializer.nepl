    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitOperationPublicImplMaterializerRecord \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerRecord:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitOperationPublicImplMaterializerRecord \self:
        self

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary SelfhostMemoTraitOperationPublicImplMaterializerAcceptedSummary \self:
        self

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerErrorKind:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerErrorKind SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerErrorKind:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerErrorKind SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \self:
        self

impl Clone for SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary:
    fn clone %fn &SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary \self:
        *self

impl Copy for SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary SelfhostMemoTraitOperationPublicImplMaterializerStage0Summary \self:
        self

//: selfhost_memo_trait_operation_public_impl_materializer_record_new: typed public impl materializer record を[作/つく]る
//:
//: [契約/けいやく]:
//: - constructor は typed field を束ねるだけです。public impl header の妥当性、trait source の trust、method root の operation matrix はそれぞれ既存の header / classifier / builder 境界が検査します。
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_new %fn SelfhostTypeId fn i32 fn Option i32 fn SelfhostModuleDeclarationVisibility fn SelfhostMemoTraitPublicImplHeaderKind fn Option i32 fn SelfhostMemoTraitOperationSourceIdentity fn i32 fn Option i32 fn i32 fn i32 fn SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence fn Option SelfhostHirExprId fn i32 SelfhostMemoTraitOperationPublicImplMaterializerRecord \type_id\module_fingerprint\declaration_ordinal\visibility\impl_kind\target_type_shape_hash\trait_source\trait_type_argument_count\trait_application_shape_hash\type_parameter_count\type_parameter_bound_count\generic_binder_evidence\method_body_root\fuel:
    SelfhostMemoTraitOperationPublicImplMaterializerRecord type_id module_fingerprint declaration_ordinal visibility impl_kind target_type_shape_hash trait_source trait_type_argument_count trait_application_shape_hash type_parameter_count type_parameter_bound_count generic_binder_evidence method_body_root fuel

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_new: [空/から]の materializer record table を[作/つく]る
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_new %impure fn void Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable StdErrorKind \void:
    let records_result %Result Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord StdErrorKind v::new
    match records_result:
        Result::Ok records:
            Result::Ok SelfhostMemoTraitOperationPublicImplMaterializerRecordTable records
        Result::Err e:
            Result::Err e

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_free: materializer record table の owner buffer を[閉/と]じる
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_free %impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecordTable unit \table:
    v::free field::get table "records"

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_len: materializer record 数を[返/かえ]す
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_len %fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable i32 \table:
    let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref table "records"
    v::len records

//: selfhost_memo_trait_operation_public_impl_materializer_record_table_push: materializer record を table に[追加/ついか]する
//:
//: [契約/けいやく]:
//: - `table` はこの関数が消費します。成功時は追加後の owner を返します。
//: - push 失敗時は `Vec` が返した owner を閉じ、`RecordPushFailed(error)` として `StdErrorKind` を保持します。
pub fn selfhost_memo_trait_operation_public_impl_materializer_record_table_push %impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result SelfhostMemoTraitOperationPublicImplMaterializerRecordTable SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \table\record:
    let records %Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get table "records"
    match v::push records record:
        Result::Ok next_records:
            Result::Ok SelfhostMemoTraitOperationPublicImplMaterializerRecordTable next_records
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::RecordPushFailed error

//: selfhost_memo_trait_operation_public_impl_materializer_header_input: materializer record から public impl header input を[作/つく]る
//:
//: [契約/けいやく]:
//: - header field は record の typed payload だけから写します。source declaration text や module path へ戻りません。
fn selfhost_memo_trait_operation_public_impl_materializer_header_input %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitPublicImplHeaderInput \record:
    selfhost_memo_trait_public_impl_header_input_new record.visibility record.module_fingerprint record.declaration_ordinal record.impl_kind record.target_type_shape_hash record.trait_application_shape_hash record.type_parameter_count record.type_parameter_bound_count record.generic_binder_evidence

//: selfhost_memo_trait_operation_public_impl_materializer_trait_application_input: materializer record から classifier input を[作/つく]る
fn selfhost_memo_trait_operation_public_impl_materializer_trait_application_input %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord SelfhostMemoTraitOperationTraitApplicationInput \record:
    selfhost_memo_trait_operation_trait_application_input_new record.trait_source record.trait_type_argument_count record.trait_application_shape_hash

//: selfhost_memo_trait_operation_public_impl_materializer_record_to_builder_input_result: 1 record を builder input へ[変換/へんかん]する
//:
//: [契約/けいやく]:
//: - header producer を先に通し、visibility、ordinal、target shape、trait shape、generic binder evidence の検査を迂回しません。
//: - detailed generic binder evidence 付き record は header shape としては有効でも、operation instantiation が未接続なので candidate builder へは渡しません。
//: - operation kind は `record.trait_source.operation` を直接信用せず、classifier evidence の `operation` を使います。
//: - classifier rejection では builder input を作りません。method body root や fuel の検査へ進める前に fail-closed にします。
fn selfhost_memo_trait_operation_public_impl_materializer_record_to_builder_input_result %fn SelfhostMemoTraitOperationPublicImplMaterializerRecord Result SelfhostMemoTraitOperationImplCandidateBuilderInput SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \record:
    let impl_header %SelfhostMemoTraitPublicImplHeaderInput selfhost_memo_trait_operation_public_impl_materializer_header_input record
    let trait_application %SelfhostMemoTraitOperationTraitApplicationInput selfhost_memo_trait_operation_public_impl_materializer_trait_application_input record
    match selfhost_memo_trait_public_impl_header_evidence_result impl_header:
        Result::Ok _header_evidence:
            match record.generic_binder_evidence:
                SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Monomorphic:
                    match selfhost_memo_trait_operation_classifier_evidence_result trait_application:
                        Result::Ok classifier:
                            Result::Ok selfhost_memo_trait_operation_impl_candidate_builder_input_new record.type_id classifier.operation impl_header trait_application record.target_type_shape_hash record.method_body_root record.fuel
                        Result::Err classifier_error:
                            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::ClassifierRejected classifier_error
                SelfhostMemoTraitPublicImplHeaderGenericBinderEvidence::Detailed _binder_evidence:
                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::GenericImplInstantiationUnsupported
        Result::Err header_error:
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::HeaderRejected header_error

//: selfhost_memo_trait_operation_public_impl_materializer_builder_input_loop: record table から builder input table を[組/く]む
//:
//: [契約/けいやく]:
//: - `builder` はこの関数が消費します。success では更新後の owner を返します。
//: - source read failure と classifier rejection では未消費 builder input table owner をこの関数が閉じます。
//: - builder input push rejection では既存 builder input table push boundary が owner cleanup を完了するため、この関数は二重解放しません。
fn selfhost_memo_trait_operation_public_impl_materializer_builder_input_loop %impure fn SelfhostMemoTraitOperationImplCandidateBuilderInputTable impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable impure fn i32 Result SelfhostMemoTraitOperationImplCandidateBuilderInputTable SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \builder\source\index:
    if:
        ge index selfhost_memo_trait_operation_public_impl_materializer_record_table_len source
        then:
            Result::Ok builder
        else:
            let records %&Vec SelfhostMemoTraitOperationPublicImplMaterializerRecord field::get_ref source "records"
            match v::get records index:
                Option::Some record:
                    match selfhost_memo_trait_operation_public_impl_materializer_record_to_builder_input_result record:
                        Result::Ok builder_input:
                            match selfhost_memo_trait_operation_impl_candidate_builder_input_table_push builder builder_input:
                                Result::Ok next_builder:
                                    selfhost_memo_trait_operation_public_impl_materializer_builder_input_loop next_builder source add index 1
                                Result::Err push_error:
                                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::BuilderInputPushRejected push_error
                        Result::Err e:
                            selfhost_memo_trait_operation_impl_candidate_builder_input_table_free builder
                            Result::Err e
                Option::None:
                    selfhost_memo_trait_operation_impl_candidate_builder_input_table_free builder
                    Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::SourceReadFailed index

//: selfhost_memo_trait_operation_public_impl_materializer_builder_inputs_from_records_result: public impl records から builder input table owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `source` は borrow です。この関数は閉じません。
//: - success の場合だけ caller が builder input table owner を受け取ります。failure の場合、内部で作った partial builder input table owner はこの module または push boundary が閉じます。
pub fn selfhost_memo_trait_operation_public_impl_materializer_builder_inputs_from_records_result %impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable Result SelfhostMemoTraitOperationImplCandidateBuilderInputTable SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \source:
    match selfhost_memo_trait_operation_impl_candidate_builder_input_table_new:
        Result::Ok builder0:
            selfhost_memo_trait_operation_public_impl_materializer_builder_input_loop builder0 source 0
        Result::Err alloc_error:
            Result::Err SelfhostMemoTraitOperationPublicImplMaterializerErrorKind::BuilderInputTableAllocFailed alloc_error

//: selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_result: public impl records から candidate table owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `module` と `source` は borrow です。この関数は閉じません。
//: - builder input table owner は内部一時 owner です。candidate builder success / failure のどちらでも閉じます。
//: - success の場合だけ output candidate table owner を caller へ返します。
pub fn selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_result %impure fn &SelfhostHirModule impure fn &SelfhostMemoTraitOperationPublicImplMaterializerRecordTable Result SelfhostMemoTraitOperationImplTable SelfhostMemoTraitOperationPublicImplMaterializerErrorKind \module\source:
    match selfhost_memo_trait_operation_public_impl_materializer_builder_inputs_from_records_result source:
        Result::Ok builder_inputs:
            match selfhost_memo_trait_operation_impl_candidate_table_from_builder_inputs_result module &builder_inputs:
