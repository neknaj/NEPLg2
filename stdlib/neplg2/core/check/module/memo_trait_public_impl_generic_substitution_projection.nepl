//: selfhost_memo_trait_public_impl_generic_substitution_projection_result: substitution shape evidence から canonical projection evidence を[作/つく]る
//:
//: [契約/けいやく]:
//: - `substitution_evidence` の root hash を field から再計算し、public struct を手で組み立てた値をそのまま信用しません。
//: - target と trait application の projection は別々の typed error に包み、どちらの output TypeId が失敗したかを後続診断へ渡します。
pub fn selfhost_memo_trait_public_impl_generic_substitution_projection_result %impure fn &SelfhostTypeArena impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostMemoTraitPublicImplGenericSubstitutionShapeEvidence Result SelfhostMemoTraitPublicImplGenericSubstitutionProjectionEvidence SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind \types\nominal_table\substitution_evidence:
    if:
        eq substitution_evidence.schema_version 0
        then:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::SubstitutionShapeSchemaPlaceholder
        else:
            if:
                not eq substitution_evidence.schema_version selfhost_memo_trait_public_impl_generic_substitution_shape_schema_version
                then:
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::SubstitutionShapeSchemaMismatch
                else:
                    if:
                        eq substitution_evidence.substitution_shape_hash 0
                        then:
                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::SubstitutionShapeHashPlaceholder
                        else:
                            if:
                                not eq substitution_evidence.substitution_shape_hash selfhost_memo_trait_public_impl_generic_substitution_shape_evidence_hash substitution_evidence
                                then:
                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::SubstitutionShapeHashMismatch
                                else:
                                    if:
                                        lt selfhost_type_id_index substitution_evidence.target_substitution_output_type_id 0
                                        then:
                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::TargetOutputTypeIdInvalid
                                        else:
                                            if:
                                                lt selfhost_type_id_index substitution_evidence.trait_application_substitution_output_type_id 0
                                                then:
                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::TraitApplicationOutputTypeIdInvalid
                                                else:
                                                    match selfhost_memo_trait_public_impl_generic_substitution_projection_type_result types nominal_table substitution_evidence.target_substitution_output_type_id:
                                                        Result::Ok target:
                                                            match selfhost_memo_trait_public_impl_generic_substitution_projection_type_result types nominal_table substitution_evidence.trait_application_substitution_output_type_id:
                                                                Result::Ok trait_application:
                                                                    let schema %i32 selfhost_memo_trait_public_impl_generic_substitution_projection_schema_version
                                                                    let draft %SelfhostMemoTraitPublicImplGenericSubstitutionProjectionEvidence SelfhostMemoTraitPublicImplGenericSubstitutionProjectionEvidence schema substitution_evidence.substitution_shape_hash target trait_application 0
                                                                    match selfhost_memo_trait_public_impl_generic_substitution_projection_shape_hash_result draft:
                                                                        Result::Ok projection_hash:
                                                                            Result::Ok SelfhostMemoTraitPublicImplGenericSubstitutionProjectionEvidence schema substitution_evidence.substitution_shape_hash target trait_application projection_hash
                                                                        Result::Err e:
                                                                            Result::Err e
                                                                Result::Err e:
                                                                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::TraitApplicationTypeRejected e
                                                        Result::Err e:
                                                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionErrorKind::TargetTypeRejected e

