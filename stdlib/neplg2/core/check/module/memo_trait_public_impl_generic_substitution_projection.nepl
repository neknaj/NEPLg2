    source_type_id %SelfhostTypeId
    canonical_fingerprint %SelfhostMemoTraitCanonicalTypeFingerprint
    canonical_payload_hash %SelfhostMemoTraitCanonicalKeyPayloadHash
    final_shape_hash %i32

//: SelfhostMemoTraitPublicImplGenericSubstitutionProjectionEvidence: substituted target / trait application の canonical projection evidence
