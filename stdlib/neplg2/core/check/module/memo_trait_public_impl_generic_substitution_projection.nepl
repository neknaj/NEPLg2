fn selfhost_memo_trait_public_impl_generic_substitution_projection_type_result %impure fn &SelfhostTypeArena impure fn &SelfhostMemoTraitStableNominalKeyTable impure fn SelfhostTypeId Result SelfhostMemoTraitPublicImplGenericSubstitutionProjectedType SelfhostMemoTraitPublicImplGenericSubstitutionProjectionTypeErrorKind \types\nominal_table\type_id:
