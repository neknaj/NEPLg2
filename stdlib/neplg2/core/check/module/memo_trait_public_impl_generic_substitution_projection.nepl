                            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionTypeErrorKind::PayloadRejected e
                Result::Err e:
                    selfhost_canonical_type_key_arena_free key_arena
                    Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionTypeErrorKind::FingerprintRejected e
        Result::Err e:
            Result::Err SelfhostMemoTraitPublicImplGenericSubstitutionProjectionTypeErrorKind::ProjectionRejected e

