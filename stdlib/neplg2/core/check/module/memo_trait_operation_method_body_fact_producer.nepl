//: selfhost_memo_trait_operation_method_body_fact_producer_stage0: method body fact producer の smoke API
//:
//: [目的/もくてき]:
//: - pure `Eq` fact、ExternalIo `Hash` fact、`Copy` operation rejection、error expression rejection、missing root rejection を小さな HIR module で確認します。
pub fn selfhost_memo_trait_operation_method_body_fact_producer_stage0 %impure fn void Result SelfhostMemoTraitOperationMethodBodyFactProducerStage0Summary StdErrorKind \void:
    let type_id %SelfhostTypeId selfhost_type_id_new 9501
    let span %SelfhostSourceSpan source_span_new_unchecked 0 0 1
    match selfhost_hir_module_new:
        Result::Ok module0:
            match selfhost_hir_module_add_expr module0 selfhost_hir_expr_unit type_id span:
                Result::Ok pure_alloc:
                    let pure_id %SelfhostHirExprId selfhost_hir_module_expr_alloc_expr_id &pure_alloc
                    let module1 %SelfhostHirModule selfhost_hir_module_expr_alloc_into_module pure_alloc
                    selfhost_memo_trait_operation_method_body_fact_producer_stage0_external module1 pure_id type_id span
                Result::Err e:
                    Result::Err e
        Result::Err e:
            Result::Err e
