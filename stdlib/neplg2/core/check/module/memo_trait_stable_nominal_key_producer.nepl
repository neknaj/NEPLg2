                SelfhostMemoTraitStableNominalKeyProducerErrorKind::ModuleFingerprintPlaceholder:
                    false
                SelfhostMemoTraitStableNominalKeyProducerErrorKind::DeclarationOrdinalMissing:
                    false
                SelfhostMemoTraitStableNominalKeyProducerErrorKind::DeclarationOrdinalPlaceholder:
