pub fn selfhost_memo_trait_stable_nominal_key_producer_error_kind_eq %fn SelfhostMemoTraitStableNominalKeyProducerErrorKind fn SelfhostMemoTraitStableNominalKeyProducerErrorKind bool \a\b:
    match a:
        SelfhostMemoTraitStableNominalKeyProducerErrorKind::PrivateVisibilityRejected:
