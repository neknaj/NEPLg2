#import "neplg2/core/module/graph" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/ty/id" as *
#import "neplg2/core/ty/ty/memo_trait_operation_evidence" as *
#import "neplg2/core/ty/ty/memo_trait_policy" as *
#import "./memo_trait_operation_classifier" as *
#import "./memo_trait_operation_impl_table" as *
#import "./memo_trait_operation_private_effect_no_escape_gate" as *
#import "./memo_trait_operation_public_impl_materializer" as *
#import "./memo_trait_public_impl_generic_materializer_connector" as *
#import "./memo_trait_public_impl_header" as *
#import "./memo_trait_public_impl_scanner" as *
#import "./memo_trait_public_surface_hash" as *
#import "./memo_trait_public_surface_normalizer" as *
#import "./memo_trait_source_evidence_producer" as *

//: SelfhostMemoTraitPublicImplSurfaceState: public surface hash と operation impl table を同じ scanner output から作った owner state
//:
//: [契約/けいやく]:
//: - `public_surface_hash` は LocalMemoTrait seed、dependency / re-export / public declaration evidence から作った full public surface hash です。
//: - `operation_impls` は scanner output の operation record table から作った owner table です。caller が state free で閉じます。
//: - この state は transport owner state であり、complete proof ではありません。Drop Resource proof、aggregate proof、backend representation は後続境界で別に接続します。
//: - 後続 stage は、この struct literal を proof authority として直接構築してはいけません。orchestrator が scanner output から作った owner を受け取り、必要な証明は別 boundary で追加します。
pub struct SelfhostMemoTraitPublicImplSurfaceState:
    public_surface_hash %i32
    operation_impls %SelfhostMemoTraitOperationImplTable

//: SelfhostMemoTraitPublicImplSurfaceAcceptedSummary: stage0 が owner state を閉じた後に保持する代表結果
pub struct SelfhostMemoTraitPublicImplSurfaceAcceptedSummary:
    public_surface_hash %i32
    operation_impl_len %i32
    eq_candidate %Result SelfhostMemoTraitOperationImplCandidate SelfhostMemoTraitOperationImplTableErrorKind

//: SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind: scanner / public surface / operation materializer の拒否理由
//:
//: [目的/もくてき]:
//: - public impl surface orchestration の失敗を、表示文字列や bool ではなく、どの境界が拒否したかを表す typed enum として保持します。
pub enum SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind:
    ScannerRejected %SelfhostMemoTraitPublicImplScannerErrorKind
    PublicSurfaceNormalizerRejected %SelfhostMemoTraitPublicSurfaceNormalizerErrorKind
    PublicSurfaceHashRejected %SelfhostMemoTraitPublicSurfaceHashErrorKind
    OperationMaterializerRejected %SelfhostMemoTraitOperationPublicImplMaterializerErrorKind

//: SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary: orchestration smoke の代表結果
pub struct SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary:
    accepted %Result SelfhostMemoTraitPublicImplSurfaceAcceptedSummary SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind
    scanner_rejected %Result i32 SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind
    normalizer_rejected %Result i32 SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind
    materializer_rejected %Result i32 SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind

//: Clone for SelfhostMemoTraitPublicImplSurfaceAcceptedSummary: stage0 summary の軽量 copy を borrow から作る
//:
//: [目的/もくてき]:
//: - accepted summary は owner を含まず、hash、件数、lookup result だけを保持します。
//: - doctest helper が summary を値として比較しやすいように、borrow から同じ値を返します。
impl Clone for SelfhostMemoTraitPublicImplSurfaceAcceptedSummary:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceAcceptedSummary SelfhostMemoTraitPublicImplSurfaceAcceptedSummary \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceAcceptedSummary: owner を含まない summary を copyable として扱う
//:
//: [契約/けいやく]:
//: - `eq_candidate` は table owner ではなく lookup result payload です。
//: - state owner の解放責務は accepted summary 作成前に完了しているため、この Copy impl は resource owner を複製しません。
impl Copy for SelfhostMemoTraitPublicImplSurfaceAcceptedSummary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceAcceptedSummary SelfhostMemoTraitPublicImplSurfaceAcceptedSummary \self:
        self

//: Clone for SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind: typed wrapper error を borrow から値へ戻す
//:
//: [目的/もくてき]:
//: - scanner / normalizer / hash / materializer の nested error payload を表示文字列へ潰さず保持します。
//: - stage0 helper が Result payload を再構成するとき、同じ typed error を値として扱えるようにします。
impl Clone for SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind: owner を含まない error payload を copyable として扱う
//:
//: [契約/けいやく]:
//: - error enum は lower boundary の typed rejection reason だけを保持します。
//: - resource owner や scanner output owner は error payload に含めないため、copy による二重解放は発生しません。
impl Copy for SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind \self:
        self

//: Clone for SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary: stage0 result summary を borrow から値へ戻す
//:
//: [目的/もくてき]:
//: - stage0 summary は accepted path と synthetic rejection payload の代表値だけを保持します。
//: - owner cleanup は accepted summary 作成時に完了しているため、Clone は owner lifecycle に関与しません。
impl Clone for SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary:
    fn clone %fn &SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary \self:
        *self

//: Copy for SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary: owner を含まない stage0 summary を copyable として扱う
//:
//: [契約/けいやく]:
//: - summary は public smoke の観測値だけを保持し、module、graph、AST、record table、operation impl table owner を持ちません。
//: - synthetic rejection payload も typed enum 値だけなので、copy しても cleanup responsibility は増えません。
impl Copy for SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary:
    fn copy_mark %fn SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary SelfhostMemoTraitPublicImplSurfaceOrchestratorStage0Summary \self:
        self

//: selfhost_memo_trait_public_impl_surface_state_free: surface state が所有する operation impl table を[閉/と]じる
pub fn selfhost_memo_trait_public_impl_surface_state_free %impure fn SelfhostMemoTraitPublicImplSurfaceState unit \state:
    let operation_impls %SelfhostMemoTraitOperationImplTable field::get state "operation_impls"
    selfhost_memo_trait_operation_impl_table_free operation_impls

//: selfhost_memo_trait_public_impl_surface_state_public_surface_hash: state の public surface hash を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_surface_state_public_surface_hash %fn &SelfhostMemoTraitPublicImplSurfaceState i32 \state:
    *field::get_ref state "public_surface_hash"

//: selfhost_memo_trait_public_impl_surface_state_operation_len: state の operation impl candidate 数を[返/かえ]す
pub fn selfhost_memo_trait_public_impl_surface_state_operation_len %fn &SelfhostMemoTraitPublicImplSurfaceState i32 \state:
    let operation_impls %&SelfhostMemoTraitOperationImplTable field::get_ref state "operation_impls"
    selfhost_memo_trait_operation_impl_table_len operation_impls

//: selfhost_memo_trait_public_impl_surface_from_scanner_output_result: scanner output から surface state owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `scanner_output` は borrow です。この関数は scanner output owner を閉じません。
//: - `partial_items` owner は hash composer の成功・失敗、operation materializer の成功・失敗のすべてでこの関数が閉じます。
//: - public surface normalizer / hash composer が拒否した場合、operation materializer へ進みません。
pub fn selfhost_memo_trait_public_impl_surface_from_scanner_output_result %impure fn &SelfhostHirModule impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostMemoTraitPublicImplScannerOutput Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind \module\graph\dependencies\reexports\seed_table\scanner_output:
    let public_declarations %&Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get_ref scanner_output "public_declarations"
    match selfhost_memo_trait_public_surface_normalizer_partial_input_items_result graph dependencies reexports public_declarations:
        Result::Ok partial_items:
            match selfhost_memo_trait_public_surface_hash_from_seed_table_and_partial_items_result seed_table &partial_items:
                Result::Ok public_surface_hash:
                    let operation_records %&SelfhostMemoTraitOperationPublicImplMaterializerRecordTable field::get_ref scanner_output "operation_records"
                    match selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_result module operation_records:
                        Result::Ok operation_impls:
                            v::free partial_items
                            Result::Ok SelfhostMemoTraitPublicImplSurfaceState public_surface_hash operation_impls
                        Result::Err materializer_error:
                            v::free partial_items
                            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::OperationMaterializerRejected materializer_error
                Result::Err hash_error:
                    v::free partial_items
                    Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceHashRejected hash_error
        Result::Err normalizer_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceNormalizerRejected normalizer_error

//: selfhost_memo_trait_public_impl_surface_from_scanner_output_with_private_effect_proofs_result: scanner output と private-effect proof table から surface state owner を[作/つく]る
//:
//: [契約/けいやく]:
//: - `scanner_output`、`proofs`、`module`、`graph`、`dependencies`、`reexports` は borrow です。この関数は閉じません。
//: - public surface hash は proof table を材料にしません。proof table は operation materializer へだけ渡します。
//: - partial input items owner は success、hash rejection、materializer rejection のすべてでこの関数が閉じます。
pub fn selfhost_memo_trait_public_impl_surface_from_scanner_output_with_private_effect_proofs_result %impure fn &SelfhostHirModule impure fn i32 impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostMemoTraitPublicImplScannerOutput impure fn &SelfhostMemoTraitOperationPrivateEffectNoEscapeProofTable Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind \module\body_module_fingerprint\graph\dependencies\reexports\seed_table\scanner_output\proofs:
    let public_declarations %&Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get_ref scanner_output "public_declarations"
    match selfhost_memo_trait_public_surface_normalizer_partial_input_items_result graph dependencies reexports public_declarations:
        Result::Ok partial_items:
            match selfhost_memo_trait_public_surface_hash_from_seed_table_and_partial_items_result seed_table &partial_items:
                Result::Ok public_surface_hash:
                    let operation_records %&SelfhostMemoTraitOperationPublicImplMaterializerRecordTable field::get_ref scanner_output "operation_records"
                    match selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_with_private_effect_proofs_result module body_module_fingerprint operation_records proofs:
                        Result::Ok operation_impls:
                            v::free partial_items
                            Result::Ok SelfhostMemoTraitPublicImplSurfaceState public_surface_hash operation_impls
                        Result::Err materializer_error:
                            v::free partial_items
                            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::OperationMaterializerRejected materializer_error
                Result::Err hash_error:
                    v::free partial_items
                    Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceHashRejected hash_error
        Result::Err normalizer_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceNormalizerRejected normalizer_error

//: selfhost_memo_trait_public_impl_surface_from_scanner_output_with_generic_connectors_result: scanner output と generic connector input から surface state owner を[作/つく]る
//:
//: [目的/もくてき]:
//: - monomorphic path と同じ public surface normalizer / hash composer を通した上で、operation materializer だけを generic-aware path へ切り替えます。
//: - generic impl accepted path が operation evidence pipeline へ進むには、public surface hash と concrete operation impl candidate table が同じ scanner output に由来する必要があります。この関数はその transport owner boundary を固定します。
//:
//: [契約/けいやく]:
//: - `scanner_output`、`connectors`、`module`、`graph`、`dependencies`、`reexports` は borrow です。この関数は閉じません。
//: - public surface hash は connector input を材料にしません。connector input は operation materializer 内の detailed generic record 解決にだけ渡します。
//: - materializer が `connector_result` と recheck を通して作った concrete builder input だけが operation impl table へ進みます。この関数は raw connector evidence table を受け取りません。
//: - public surface normalizer / hash composer が拒否した場合は generic connector input を読まず、operation materializer へ進みません。
//: - partial input items owner は success、hash rejection、materializer rejection のすべてでこの関数が閉じます。
pub fn selfhost_memo_trait_public_impl_surface_from_scanner_output_with_generic_connectors_result %impure fn &SelfhostHirModule impure fn &SelfhostModuleGraph impure fn &Vec SelfhostMemoTraitPublicSurfaceDependencyEvidence impure fn &Vec SelfhostMemoTraitPublicSurfaceReExportEvidence impure fn SelfhostMemoTraitStableSourceSeedTable impure fn &SelfhostMemoTraitPublicImplScannerOutput impure fn &SelfhostMemoTraitPublicImplGenericMaterializerConnectorInputTable Result SelfhostMemoTraitPublicImplSurfaceState SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind \module\graph\dependencies\reexports\seed_table\scanner_output\connectors:
    let public_declarations %&Vec SelfhostMemoTraitPublicSurfacePublicDeclarationEvidence field::get_ref scanner_output "public_declarations"
    match selfhost_memo_trait_public_surface_normalizer_partial_input_items_result graph dependencies reexports public_declarations:
        Result::Ok partial_items:
            match selfhost_memo_trait_public_surface_hash_from_seed_table_and_partial_items_result seed_table &partial_items:
                Result::Ok public_surface_hash:
                    let operation_records %&SelfhostMemoTraitOperationPublicImplMaterializerRecordTable field::get_ref scanner_output "operation_records"
                    match selfhost_memo_trait_operation_public_impl_materializer_candidate_table_from_records_with_generics_result module operation_records connectors:
                        Result::Ok operation_impls:
                            v::free partial_items
                            Result::Ok SelfhostMemoTraitPublicImplSurfaceState public_surface_hash operation_impls
                        Result::Err materializer_error:
                            v::free partial_items
                            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::OperationMaterializerRejected materializer_error
                Result::Err hash_error:
                    v::free partial_items
                    Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceHashRejected hash_error
        Result::Err normalizer_error:
            Result::Err SelfhostMemoTraitPublicImplSurfaceOrchestratorErrorKind::PublicSurfaceNormalizerRejected normalizer_error

