//: selfhost_memo_trait_definition_source_table_from_stable_records: verified record 2 件から definition table を[作/つく]る
fn selfhost_memo_trait_definition_source_table_from_stable_records %fn SelfhostMemoTraitDefinitionSourceRecord fn SelfhostMemoTraitDefinitionSourceRecord SelfhostMemoTraitDefinitionSourceTable \key_record\value_record:
    let table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record table0 key_record
    selfhost_memo_trait_definition_source_table_add_record table1 value_record

//: selfhost_memo_trait_definition_source_table_from_stable_evidence_records_result: stable evidence record を[検査/けんさ]して definition table へ[変換/へんかん]する
fn selfhost_memo_trait_definition_source_table_from_stable_evidence_records_result %fn SelfhostMemoTraitStableSourceEvidenceRecord fn SelfhostMemoTraitStableSourceEvidenceRecord Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind \key_evidence\value_evidence:
    match selfhost_memo_trait_stable_source_key_evidence_to_record key_evidence:
        Result::Ok key_record:
            match selfhost_memo_trait_stable_source_value_evidence_to_record value_evidence:
                Result::Ok value_record:
                    Result::Ok selfhost_memo_trait_definition_source_table_from_stable_records key_record value_record
                Result::Err value_error:
                    Result::Err value_error
        Result::Err key_error:
            Result::Err key_error

//: selfhost_memo_trait_definition_source_table_from_stable_evidence_result: scanner candidate と stable evidence から trusted source table を[作/つく]る
//:
//: [目的/もくてき]:
//: - scanner が見つけた `MemoKey` / `MemoValue` 候補と、public surface materializer 由来の stable fingerprint evidence が両方揃った場合だけ、`signature_available = true` の definition source table を作ります。
//:
//: [契約/けいやく]:
//: - candidate table の fingerprint は使いません。candidate table は presence / duplicate evidence としてだけ扱います。
//: - stable evidence の fingerprint が揃っていても、candidate が欠ける場合は trusted source record を作りません。
//: - 返された table も accepted registry ではありません。既存の `selfhost_memo_trait_trusted_source_registry_from_definition_table` を通して最終 materialization を行います。
pub fn selfhost_memo_trait_definition_source_table_from_stable_evidence_result %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitStableSourceEvidenceTable Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind \candidates\evidence:
    if:
        candidates.duplicate_memo_key
        then:
            Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoKeyCandidateDuplicate
        else:
            if:
                candidates.duplicate_memo_value
                then:
                    Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoValueCandidateDuplicate
                else:
                    if:
                        evidence.duplicate_memo_key
                        then:
                            Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoKeyEvidenceDuplicate
                        else:
                            if:
                                evidence.duplicate_memo_value
                                then:
                                    Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoValueEvidenceDuplicate
                                else:
                                    match candidates.memo_key:
                                        Option::Some _key_candidate:
                                            match candidates.memo_value:
                                                Option::Some _value_candidate:
                                                    match evidence.memo_key:
                                                        Option::Some key_evidence:
                                                            match evidence.memo_value:
                                                                Option::Some value_evidence:
                                                                    selfhost_memo_trait_definition_source_table_from_stable_evidence_records_result key_evidence value_evidence
                                                                Option::None:
                                                                    Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoValueEvidenceMissing
                                                        Option::None:
                                                            Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoKeyEvidenceMissing
                                                Option::None:
                                                    Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoValueCandidateMissing
                                        Option::None:
                                            Result::Err SelfhostMemoTraitStableSourceProduceErrorKind::MemoKeyCandidateMissing

//: selfhost_memo_trait_trusted_source_registry_from_stable_evidence_result: stable source table を trusted registry へ[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - stable evidence producer の `Result` と既存 registry validator の `Result` を、caller が区別できる 1 つの API として公開します。
pub fn selfhost_memo_trait_trusted_source_registry_from_stable_evidence_result %fn SelfhostMemoTraitDefinitionSourceTable fn SelfhostMemoTraitStableSourceEvidenceTable Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitStableSourceRegistryErrorKind \candidates\evidence:
    match selfhost_memo_trait_definition_source_table_from_stable_evidence_result candidates evidence:
        Result::Ok table:
            match selfhost_memo_trait_trusted_source_registry_from_definition_table table:
                Result::Ok registry:
                    Result::Ok registry
                Result::Err registry_error:
                    Result::Err SelfhostMemoTraitStableSourceRegistryErrorKind::RegistryRejected registry_error
        Result::Err produce_error:
            Result::Err SelfhostMemoTraitStableSourceRegistryErrorKind::StableSourceRejected produce_error

//: selfhost_memo_trait_stable_source_stage0_candidate_table: stage0 用 scanner candidate table を[作/つく]る
fn selfhost_memo_trait_stable_source_stage0_candidate_table %fn void SelfhostMemoTraitDefinitionSourceTable \void:
    let table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let key_candidate %SelfhostMemoTraitDefinitionSourceRecord:
        selfhost_memo_trait_definition_source_record_new:
            SelfhostMemoTraitSourceKind::MemoKeyTrait
            selfhost_memo_trait_definition_fingerprint_new 0 0 0
            false
    let value_candidate %SelfhostMemoTraitDefinitionSourceRecord:
        selfhost_memo_trait_definition_source_record_new:
            SelfhostMemoTraitSourceKind::MemoValueTrait
            selfhost_memo_trait_definition_fingerprint_new 0 0 0
            false
    let table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record table0 key_candidate
    selfhost_memo_trait_definition_source_table_add_record table1 value_candidate

//: selfhost_memo_trait_stable_source_stage0_complete_evidence_table: stage0 用 stable evidence table を[作/つく]る
fn selfhost_memo_trait_stable_source_stage0_complete_evidence_table %fn void SelfhostMemoTraitStableSourceEvidenceTable \void:
    let table0 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_empty
    let key_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new (some 100) (some 101) (some 102)
    let key_evidence %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoKeyTrait key_fingerprint
    let value_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new (some 200) (some 201) (some 202)
    let value_evidence %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoValueTrait value_fingerprint
    let table1 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record table0 key_evidence
    selfhost_memo_trait_stable_source_evidence_table_add_record table1 value_evidence

//: selfhost_memo_trait_stable_source_stage0_summary_new: stable source producer smoke summary を[作/つく]る
fn selfhost_memo_trait_stable_source_stage0_summary_new %fn Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitStableSourceRegistryErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind fn Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind SelfhostMemoTraitStableSourceStage0Summary \accepted_registry\missing_candidate_rejected\duplicate_candidate_rejected\missing_evidence_rejected\duplicate_evidence_rejected\missing_fingerprint_rejected\placeholder_fingerprint_rejected:
    SelfhostMemoTraitStableSourceStage0Summary accepted_registry missing_candidate_rejected duplicate_candidate_rejected missing_evidence_rejected duplicate_evidence_rejected missing_fingerprint_rejected placeholder_fingerprint_rejected

//: selfhost_memo_trait_stable_source_stage0: stable source producer の代表結果を[返/かえ]す
//:
//: [目的/もくてき]:
//: - complete candidate + complete evidence の accepted path と、候補欠落、候補重複、evidence 欠落、evidence 重複、fingerprint 未確定の代表拒否を同時に確認します。
pub fn selfhost_memo_trait_stable_source_stage0 %fn void SelfhostMemoTraitStableSourceStage0Summary \void:
    let candidates %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_stable_source_stage0_candidate_table
    let evidence %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_stage0_complete_evidence_table
    let accepted_registry %Result SelfhostMemoTraitTrustedSourceRegistry SelfhostMemoTraitStableSourceRegistryErrorKind:
        selfhost_memo_trait_trusted_source_registry_from_stable_evidence_result candidates evidence
    let missing_candidate_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result selfhost_memo_trait_definition_source_table_empty evidence
    let key_candidate %SelfhostMemoTraitDefinitionSourceRecord:
        selfhost_memo_trait_definition_source_record_new:
            SelfhostMemoTraitSourceKind::MemoKeyTrait
            selfhost_memo_trait_definition_fingerprint_new 0 0 0
            false
    let duplicate_candidate_table0 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_empty
    let duplicate_candidate_table1 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_candidate_table0 key_candidate
    let duplicate_candidate_table2 %SelfhostMemoTraitDefinitionSourceTable selfhost_memo_trait_definition_source_table_add_record duplicate_candidate_table1 key_candidate
    let duplicate_candidate_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result duplicate_candidate_table2 evidence
    let key_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new (some 100) (some 101) (some 102)
    let key_evidence %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoKeyTrait key_fingerprint
    let missing_evidence_table0 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_empty
    let missing_evidence_table1 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record missing_evidence_table0 key_evidence
    let missing_evidence_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result candidates missing_evidence_table1
    let duplicate_evidence_table0 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_empty
    let duplicate_evidence_table1 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record duplicate_evidence_table0 key_evidence
    let duplicate_evidence_table2 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record duplicate_evidence_table1 key_evidence
    let duplicate_evidence_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result candidates duplicate_evidence_table2
    let missing_fingerprint_evidence0 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_empty
    let missing_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new none (some 101) (some 102)
    let missing_fingerprint_key %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoKeyTrait missing_fingerprint
    let value_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new (some 200) (some 201) (some 202)
    let value_evidence %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoValueTrait value_fingerprint
    let missing_fingerprint_evidence1 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record missing_fingerprint_evidence0 missing_fingerprint_key
    let missing_fingerprint_evidence2 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record missing_fingerprint_evidence1 value_evidence
    let missing_fingerprint_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result candidates missing_fingerprint_evidence2
    let placeholder_fingerprint_evidence0 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_empty
    let placeholder_fingerprint %SelfhostMemoTraitStableSourceFingerprintEvidence:
        selfhost_memo_trait_stable_source_fingerprint_evidence_new (some 0) (some 101) (some 102)
    let placeholder_fingerprint_key %SelfhostMemoTraitStableSourceEvidenceRecord:
        selfhost_memo_trait_stable_source_evidence_record_new SelfhostMemoTraitSourceKind::MemoKeyTrait placeholder_fingerprint
    let placeholder_fingerprint_evidence1 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record placeholder_fingerprint_evidence0 placeholder_fingerprint_key
    let placeholder_fingerprint_evidence2 %SelfhostMemoTraitStableSourceEvidenceTable selfhost_memo_trait_stable_source_evidence_table_add_record placeholder_fingerprint_evidence1 value_evidence
    let placeholder_fingerprint_rejected %Result SelfhostMemoTraitDefinitionSourceTable SelfhostMemoTraitStableSourceProduceErrorKind:
        selfhost_memo_trait_definition_source_table_from_stable_evidence_result candidates placeholder_fingerprint_evidence2
    selfhost_memo_trait_stable_source_stage0_summary_new:
        accepted_registry
        missing_candidate_rejected
        duplicate_candidate_rejected
        missing_evidence_rejected
        duplicate_evidence_rejected
        missing_fingerprint_rejected
        placeholder_fingerprint_rejected
