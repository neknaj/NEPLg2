#indent 4

//: # checker
//: NEPLg2.0 self-host compiler の checker orchestration を置くモジュールです。
//:
//: [目的/もくてき]:
//: - module item validation、declaration check、expression reduction、overload、trait、effect、pattern check の依存方向を束ねます。
//: - 実装本体は stage / domain ごとの module に置き、この file は public boundary と orchestration に限定します。
//:
//: [注意/ちゅうい]:
//: - `check/module.nepl` は parse 済み module item stream の検査だけを担当します。type / lifetime / effect / Resource IR の証明は後続 stage で追加します。
//: - `checker.nepl` に巨大な pass 実装を積み増さず、各 pass は final hierarchy に分割して追加します。
//:
//: [計算量/けいさんりょう]:
//: - `selfhost_checker_stage0` は parser に依存しない小さな module AST を作って `selfhost_check_module_ast` を呼ぶため O(n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/core/check/checker" as *
//: fn main %impure fn unit i32 \unit:
//:     selfhost_checker_stage0
//: ```

pub #import "./module" as @merge

#import "core/result" as *
#import "core/math" as *
#import "core/option" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *

//: selfhost_checker_stage0: checker orchestration の smoke API
pub fn selfhost_checker_stage0 %impure fn unit i32 \unit:
    match selfhost_module_ast_new:
        Result::Ok ast0:
            let entry %SelfhostModuleItem selfhost_module_item_new SelfhostModuleItemKind::EntryDirective source_span_new 0 0 11 "#entry main"
            match selfhost_module_ast_push ast0 entry:
                Result::Ok ast1:
                    let head %SelfhostModuleDeclarationHead selfhost_module_declaration_head_new SelfhostModuleDeclarationHeadKind::Name source_span_new 0 15 19
                    let header %SelfhostModuleDeclarationHeader selfhost_module_declaration_header_new SelfhostModuleDeclarationKind::Function SelfhostModuleDeclarationVisibility::Private source_span_new 0 12 19 source_span_new 0 12 14 some<SelfhostModuleDeclarationHead> head
                    let decl %SelfhostModuleItem selfhost_module_item_new_with_declaration SelfhostModuleItemKind::FunctionDecl "fn main" header
                    match selfhost_module_ast_push ast1 decl:
                        Result::Ok ast2:
                            match selfhost_check_module_ast &ast2:
                                Result::Ok summary:
                                    let n %i32 selfhost_module_check_summary_item_count summary
                                    selfhost_module_ast_free ast2
                                    if eq n 2 0 1
                                Result::Err _diag:
                                    selfhost_module_ast_free ast2
                                    1
                        Result::Err _e:
                            1
                Result::Err _e:
                    1
        Result::Err _e:
            1
