#indent 4

//: # vfs
//: NEPLg2.0 self-host compiler core が[扱/あつか]う in-memory source set です。
//:
//: [目的/もくてき]:
//: - CLI [層/そう]が filesystem から[読/よ]んだ source を、core [層/そう]へ logical path と source text の[組/く]みとして[渡/わた]します。
//: - import graph や module loader が、parser へ依存せずに source lookup だけを[使/つか]えるようにします。
//:
//: [実装/じっそう]:
//: - `SelfhostVirtualFileSystem` は `Vec<SelfhostVirtualFile>` を所有します。
//: - `file_id` は追加順の連番です。lexer / parser diagnostic の span に同じ ID を[渡/わた]します。
//: - path lookup は現段階では線形探索です。module graph の要求が固まったら HashMap へ移行できます。
//:
//: [注意/ちゅうい]:
//: - 同じ path を複数回追加した場合は、現段階では先に見つかった entry を使います。
//: - `SelfhostVirtualFileSystem` の buffer は caller が `selfhost_vfs_free` で[解放/かいほう]してください。
//:
//: [計算量/けいさんりょう]:
//: - `selfhost_vfs_add` は `Vec` push の償却 O(1) です。
//: - `selfhost_vfs_find` は登録 file 数 n に対して O(n) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"selfhost_vfs_basic\" count=2 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"len\" expected=\"1\" actual=\"1\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"find path\" expected=\"main.nepl\" actual=\"main.nepl\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/module/vfs" as *
//:| #import "std/test" as *
//: fn main %impure fn unit i32 \unit:
//:     match selfhost_vfs_new:
//:         Result::Ok vfs0:
//:             match selfhost_vfs_add vfs0 "main.nepl" "fn main %fn unit i32 \\unit:\n    0\n":
//:                 Result::Ok vfs1:
//:                     let report0 %TestReport test_report_new "selfhost_vfs_basic"
//:                     let report1 %TestReport test_report_push report0 assert_eq_i32 "len" 1 selfhost_vfs_len &vfs1
//:                     let report2 %TestReport:
//:                         match selfhost_vfs_find &vfs1 "main.nepl":
//:                             Option::Some file:
//:                                 test_report_push report1 assert_str_eq "find path" "main.nepl" file.path
//:                             Option::None:
//:                                 test_report_push report1 assert false
//:                     selfhost_vfs_free vfs1
//:                     test_report_exit_code test_report_print_stdout report2
//:                 Result::Err _e:
//:                     1
//:         Result::Err _e:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/search" as string_search
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "core/field" as *

//: SelfhostVirtualFile: core loader が[扱/あつか]う 1 source
//:
//: [目的/もくてき]:
//: - filesystem path ではなく、core [層/そう]に[渡/わた]された logical path と source [本文/ほんぶん]を[組/く]みにします。
//: - import resolver はこの path を key として module source を[探/さが]します。
pub struct SelfhostVirtualFile:
    file_id %i32
    path %str
    source %str

impl Clone for SelfhostVirtualFile:
    fn clone %fn &SelfhostVirtualFile SelfhostVirtualFile \self:
        *self

impl Copy for SelfhostVirtualFile:
    fn copy_mark %fn SelfhostVirtualFile SelfhostVirtualFile \self:
        self

//: SelfhostVirtualFileSystem: core [層/そう]の in-memory source set
//:
//: [注意/ちゅうい]:
//: - `files` の Vec buffer を所有します。使用後は `selfhost_vfs_free` で[解放/かいほう]します。
pub struct SelfhostVirtualFileSystem:
    files %Vec SelfhostVirtualFile

//: selfhost_vfs_file_new: VFS entry を[作/つく]る
pub fn selfhost_vfs_file_new %fn i32 fn str fn str SelfhostVirtualFile \file_id\path\source:
    SelfhostVirtualFile file_id path source

//: selfhost_vfs_new: [空/から]の VFS を[作/つく]る
pub fn selfhost_vfs_new %impure fn unit Result SelfhostVirtualFileSystem StdErrorKind \unit:
    match v::new<SelfhostVirtualFile>:
        Result::Ok files:
            Result::Ok SelfhostVirtualFileSystem files
        Result::Err e:
            Result::Err e

//: selfhost_vfs_add: source file を VFS に[追加/ついか]する
//:
//: [注意/ちゅうい]:
//: - 同じ path の重複検査は import resolver の仕様確定後に追加します。現段階では先に見つかった entry を使います。
pub fn selfhost_vfs_add %impure fn SelfhostVirtualFileSystem impure fn str impure fn str Result SelfhostVirtualFileSystem StdErrorKind \vfs\path\source:
    let file_id %i32 selfhost_vfs_len &vfs
    let file %SelfhostVirtualFile selfhost_vfs_file_new file_id path source
    match v::push<SelfhostVirtualFile> field::get vfs "files" file:
        Result::Ok files:
            Result::Ok SelfhostVirtualFileSystem files
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free field::get e "vec"
            Result::Err error

//: selfhost_vfs_len: VFS に[登録/とうろく]された file 数を[返/かえ]す
pub fn selfhost_vfs_len %fn &SelfhostVirtualFileSystem i32 \vfs:
    let files %&Vec SelfhostVirtualFile field::get_ref vfs "files"
    v::len files

//: selfhost_vfs_get: index の VFS entry を[返/かえ]す
pub fn selfhost_vfs_get %fn &SelfhostVirtualFileSystem fn i32 Option SelfhostVirtualFile \vfs\idx:
    let files %&Vec SelfhostVirtualFile field::get_ref vfs "files"
    v::get files idx

//: selfhost_vfs_find_loop: path が[一致/いっち]する entry を線形探索する
pub fn selfhost_vfs_find_loop %fn &SelfhostVirtualFileSystem fn str fn i32 fn i32 Option SelfhostVirtualFile \vfs\path\n\idx:
    if:
        ge idx n
        then:
            none
        else:
            match selfhost_vfs_get vfs idx:
                Option::Some file:
                    if:
                        string_search::str_eq file.path path
                        then:
                            some file
                        else:
                            selfhost_vfs_find_loop vfs path n add idx 1
                Option::None:
                    none

//: selfhost_vfs_find: path が[一致/いっち]する entry を[返/かえ]す
pub fn selfhost_vfs_find %fn &SelfhostVirtualFileSystem fn str Option SelfhostVirtualFile \vfs\path:
    selfhost_vfs_find_loop vfs path selfhost_vfs_len vfs 0

//: selfhost_vfs_free: VFS の file entry buffer を[解放/かいほう]する
pub fn selfhost_vfs_free %impure fn SelfhostVirtualFileSystem unit \vfs:
    v::free field::get vfs "files"
