#indent 4

//: # stdlib_map
//: NEPLg2.0 self-host compiler の module path mapping を扱うモジュールです。
//:
//: [目的/もくてき]:
//: - `#import "core/result"` のような stdlib import と、`#import "./util"` のような user relative import を、VFS logical path へ変換します。
//: - filesystem path ではなく、CLI [層/そう]が VFS に登録する logical root を入力にすることで、core [層/そう]を filesystem 非依存に保ちます。
//:
//: [実装/じっそう]:
//: - `SelfhostModulePathMap` は user root と stdlib root の logical prefix を保持します。
//: - 非 relative import は stdlib root 基準、`.` / `..` / `/` で始まる import は user または現在 module の root 基準で解決します。
//: - 拡張子が無い import には `.nepl` を付与します。
//:
//: [注意/ちゅうい]:
//: - ここでは実 filesystem の canonicalize は行いません。`..` は lexical に処理し、user root / stdlib root を越える場合は diagnostic を返します。
//: - VFS 側の path もこの mapper が返す logical path と同じ規約で登録してください。
//:
//: [計算量/けいさんりょう]:
//: - path の解決は import spec 長 n と current path 長 m に対して O(n + m) です。
//: - 文字列結合は返す logical path の長さに比例して確保します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/search" as string_search
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/module/stdlib_map" as *
//: fn main %impure fn void i32 \void:
//:     let map %SelfhostModulePathMap selfhost_module_path_map_new "user" "stdlib";
//:     match selfhost_module_path_resolve_import &map "user/app/main.nepl" source_span_empty 0 0 "core/result":
//:         Result::Ok resolved:
//:             if:
//:                 and selfhost_resolved_module_path_is_stdlib resolved string_search::str_eq resolved.path "stdlib/core/result.nepl"
//:                 then:
//:                     0
//:                 else:
//:                     1
//:         Result::Err _diag:
//:             1
//: ```

#import "alloc/string/access" as string_access
#import "alloc/string/byte_index" as string_byte_index
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "alloc/string/concat" as string_concat
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/import_spec" as *
#import "core/field" as *

fn selfhost_stdlib_map_byte_or_end %fn str fn i32 i32 \path\idx:
    match string_byte_index::checked_string_byte_at path idx:
        Option::Some b:
            b
        Option::None:
            -1

//: SelfhostModulePathKind: 解決後 module path が属する logical root
//:
//: [目的/もくてき]:
//: - resolver が user module と stdlib module を区別できるように、path 文字列だけでなく分類を保持します。
pub enum SelfhostModulePathKind:
    User
    Stdlib

//: SelfhostModuleImportPathKind: import spec の path 形式
//:
//: [目的/もくてき]:
//: - `.` / `/` / stdlib path の分類を enum として保持し、resolver の分岐に match 網羅性検査を効かせます。
//: - 分類の追加時に resolver 側の対応漏れを静的に検出できるようにします。
pub enum SelfhostModuleImportPathKind:
    Absolute
    Relative
    Stdlib

impl Clone for SelfhostModulePathKind:
    fn clone %fn &SelfhostModulePathKind SelfhostModulePathKind \self:
        *self

impl Copy for SelfhostModulePathKind:
    fn copy_mark %fn SelfhostModulePathKind SelfhostModulePathKind \self:
        self

impl Clone for SelfhostModuleImportPathKind:
    fn clone %fn &SelfhostModuleImportPathKind SelfhostModuleImportPathKind \self:
        *self

impl Copy for SelfhostModuleImportPathKind:
    fn copy_mark %fn SelfhostModuleImportPathKind SelfhostModuleImportPathKind \self:
        self

//: SelfhostResolvedModulePath: import spec から得られた VFS logical path
pub struct SelfhostResolvedModulePath:
    kind %SelfhostModulePathKind
    path %str

impl Clone for SelfhostResolvedModulePath:
    fn clone %fn &SelfhostResolvedModulePath SelfhostResolvedModulePath \self:
        *self

impl Copy for SelfhostResolvedModulePath:
    fn copy_mark %fn SelfhostResolvedModulePath SelfhostResolvedModulePath \self:
        self

//: SelfhostModulePathMap: self-host core に渡す logical root mapping
//:
//: [注意/ちゅうい]:
//: - `user_root` と `stdlib_root` は末尾 `/` なしを推奨します。末尾 `/` があっても join helper が二重 slash を避けます。
pub struct SelfhostModulePathMap:
    user_root %str
    stdlib_root %str

impl Clone for SelfhostModulePathMap:
    fn clone %fn &SelfhostModulePathMap SelfhostModulePathMap \self:
        *self

impl Copy for SelfhostModulePathMap:
    fn copy_mark %fn SelfhostModulePathMap SelfhostModulePathMap \self:
        self

//: selfhost_module_path_map_new: logical root mapping を[作/つく]る
pub fn selfhost_module_path_map_new %fn str fn str SelfhostModulePathMap \user_root\stdlib_root:
    SelfhostModulePathMap user_root stdlib_root

//: selfhost_module_path_map_user_root: user root を[返/かえ]す
pub fn selfhost_module_path_map_user_root %fn &SelfhostModulePathMap str \map:
    *field::get_ref map "user_root"

//: selfhost_module_path_map_stdlib_root: stdlib root を[返/かえ]す
pub fn selfhost_module_path_map_stdlib_root %fn &SelfhostModulePathMap str \map:
    *field::get_ref map "stdlib_root"

//: selfhost_resolved_module_path_new: resolved path を[作/つく]る
pub fn selfhost_resolved_module_path_new %fn SelfhostModulePathKind fn str SelfhostResolvedModulePath \kind\path:
    SelfhostResolvedModulePath kind path

//: selfhost_resolved_module_path_is_stdlib: stdlib module か[返/かえ]す
pub fn selfhost_resolved_module_path_is_stdlib %fn SelfhostResolvedModulePath bool \resolved:
    match resolved.kind:
        SelfhostModulePathKind::User:
            false
        SelfhostModulePathKind::Stdlib:
            true

//: selfhost_module_path_diag: path mapping diagnostic を[作/つく]る
pub fn selfhost_module_path_diag %fn SelfhostSourceSpan fn SelfhostResolveDiagnosticCode fn str fn str fn str SelfhostDiagnostic \span\code\message\label\note:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Resolve code message
    let labeled %SelfhostDiagnostic selfhost_diag_with_primary_label diag selfhost_diag_label_new span label
    selfhost_diag_with_note labeled note

//: selfhost_module_path_oom_diag: path 文字列確保失敗 diagnostic を[作/つく]る
pub fn selfhost_module_path_oom_diag %fn SelfhostSourceSpan SelfhostDiagnostic \span:
    selfhost_module_path_diag span SelfhostResolveDiagnosticCode::ModulePathOutOfMemory "module path allocation failed" "allocation failed while resolving import path" ""

//: selfhost_module_path_invalid_diag: import path の形式不正 diagnostic を[作/つく]る
pub fn selfhost_module_path_invalid_diag %fn SelfhostSourceSpan fn str SelfhostDiagnostic \span\spec:
    selfhost_module_path_diag span SelfhostResolveDiagnosticCode::ModulePathInvalidImport "import path is not a valid module path" "invalid import path" spec

//: selfhost_module_path_escape_diag: `..` が logical root を越えた diagnostic を[作/つく]る
pub fn selfhost_module_path_escape_diag %fn SelfhostSourceSpan fn str SelfhostDiagnostic \span\spec:
    selfhost_module_path_diag span SelfhostResolveDiagnosticCode::ModulePathEscapeRoot "relative import escapes its logical module root" "relative import escapes module root" spec

//: selfhost_module_path_join: root と path segment を `/` で[結合/けつごう]する
pub fn selfhost_module_path_join %impure fn SelfhostSourceSpan impure fn str impure fn str Result str SelfhostDiagnostic \span\left\right:
    if:
        eq string_access::len left 0
        then:
            Result::Ok right
        else:
            if:
                string_search::str_ends_with left "/"
                then:
                    match string_concat::concat_result left right:
                        Result::Ok out:
                            Result::Ok out
                        Result::Err _e:
                            Result::Err selfhost_module_path_oom_diag span
                else:
                    match string_concat::concat_result left "/":
                        Result::Ok prefix:
                            match string_concat::concat_result prefix right:
                                Result::Ok out:
                                    Result::Ok out
                                Result::Err _e:
                                    Result::Err selfhost_module_path_oom_diag span
                        Result::Err _e:
                            Result::Err selfhost_module_path_oom_diag span

//: selfhost_module_path_ensure_extension: `.nepl` 拡張子を[補/おぎな]う
pub fn selfhost_module_path_ensure_extension %impure fn SelfhostSourceSpan impure fn str Result str SelfhostDiagnostic \span\path:
    if:
        string_search::str_ends_with path ".nepl"
        then:
            Result::Ok path
        else:
            match string_concat::concat_result path ".nepl":
                Result::Ok out:
                    Result::Ok out
                Result::Err _e:
                    Result::Err selfhost_module_path_oom_diag span

//: selfhost_module_path_last_slash_loop: 最後の `/` byte index を[探/さが]す
pub fn selfhost_module_path_last_slash_loop %fn str fn i32 fn i32 fn i32 i32 \path\n\idx\last:
    let mut i %i32 idx
    let mut found %i32 last
    while lt i n:
        do:
            let ch %i32 selfhost_stdlib_map_byte_or_end path i
            if:
                eq ch '/'
                then:
                    set found i
                else:
                    unit
            set i add i 1
    found

//: selfhost_module_path_parent_dir: logical path の親 directory を[返/かえ]す
pub fn selfhost_module_path_parent_dir %fn str str \path:
    let n %i32 string_access::len path
    let last %i32 selfhost_module_path_last_slash_loop path n 0 -1
    if:
        lt last 0
        then:
            ""
        else:
            string_slice::str_slice path 0 last

//: selfhost_module_path_in_root: path が root prefix 配下か[返/かえ]す
pub fn selfhost_module_path_in_root %fn str fn str bool \path\root:
    if:
        eq string_access::len root 0
        then:
            false
        else:
            if:
                string_search::str_eq path root
                then:
                    true
                else:
                    string_search::str_starts_with path string_concat::concat root "/"

//: selfhost_module_path_kind_for_current: current module path から root 分類を[決/き]める
pub fn selfhost_module_path_kind_for_current %fn &SelfhostModulePathMap fn str SelfhostModulePathKind \map\current_path:
    if:
        selfhost_module_path_in_root current_path selfhost_module_path_map_stdlib_root map
        then:
            SelfhostModulePathKind::Stdlib
        else:
            SelfhostModulePathKind::User

//: selfhost_module_path_root_for_kind: root 分類から logical root を[返/かえ]す
pub fn selfhost_module_path_root_for_kind %fn &SelfhostModulePathMap fn SelfhostModulePathKind str \map\kind:
    match kind:
        SelfhostModulePathKind::User:
            selfhost_module_path_map_user_root map
        SelfhostModulePathKind::Stdlib:
            selfhost_module_path_map_stdlib_root map

//: selfhost_module_path_cannot_pop: `..` で root を越えるか[判定/はんてい]する
pub fn selfhost_module_path_cannot_pop %fn str fn str bool \root\base_dir:
    if:
        eq string_access::len base_dir 0
        then:
            true
        else:
            if:
                eq string_access::len root 0
                then:
                    false
                else:
                    string_search::str_eq base_dir root

//: selfhost_module_path_finish: path に拡張子を付け、resolved value にする
pub fn selfhost_module_path_finish %impure fn SelfhostSourceSpan impure fn SelfhostModulePathKind impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \span\kind\path:
    if:
        eq string_access::len path 0
        then:
            Result::Err selfhost_module_path_invalid_diag span path
        else:
            match selfhost_module_path_ensure_extension span path:
                Result::Ok with_ext:
                    Result::Ok selfhost_resolved_module_path_new kind with_ext
                Result::Err diag:
                    Result::Err diag

//: selfhost_module_path_resolve_relative_loop: `.` / `..` を lexical に[処理/しょり]する
pub fn selfhost_module_path_resolve_relative_loop %impure fn SelfhostSourceSpan impure fn SelfhostModulePathKind impure fn str impure fn str impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \span\kind\root\base_dir\rel:
    if:
        eq string_access::len rel 0
        then:
            Result::Err selfhost_module_path_invalid_diag span rel
        else:
            if:
                string_search::str_starts_with rel "./"
                then:
                    selfhost_module_path_resolve_relative_loop span kind root base_dir string_slice::str_slice rel 2 string_access::len rel
                else:
                    if:
                        string_search::str_starts_with rel "../"
                        then:
                            if:
                                selfhost_module_path_cannot_pop root base_dir
                                then:
                                    Result::Err selfhost_module_path_escape_diag span rel
                                else:
                                    selfhost_module_path_resolve_relative_loop span kind root selfhost_module_path_parent_dir base_dir string_slice::str_slice rel 3 string_access::len rel
                        else:
                            match selfhost_module_path_join span base_dir rel:
                                Result::Ok joined:
                                    selfhost_module_path_finish span kind joined
                                Result::Err diag:
                                    Result::Err diag

//: selfhost_module_path_kind_for_absolute: root-relative path の分類を[決/き]める
pub fn selfhost_module_path_kind_for_absolute %fn &SelfhostModulePathMap fn str SelfhostModulePathKind \map\path:
    if:
        selfhost_module_path_in_root path selfhost_module_path_map_stdlib_root map
        then:
            SelfhostModulePathKind::Stdlib
        else:
            SelfhostModulePathKind::User

//: selfhost_module_path_resolve_absolute: `/...` を root-relative logical path として[解決/かいけつ]する
pub fn selfhost_module_path_resolve_absolute %impure fn &SelfhostModulePathMap impure fn SelfhostSourceSpan impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \map\span\spec:
    let n %i32 string_access::len spec
    if:
        le n 1
        then:
            Result::Err selfhost_module_path_invalid_diag span spec
        else:
            let stripped %str string_slice::str_slice spec 1 n
            let kind %SelfhostModulePathKind selfhost_module_path_kind_for_absolute map stripped
            selfhost_module_path_finish span kind stripped

//: selfhost_module_path_resolve_stdlib: stdlib root 基準で import path を[解決/かいけつ]する
pub fn selfhost_module_path_resolve_stdlib %impure fn &SelfhostModulePathMap impure fn SelfhostSourceSpan impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \map\span\spec:
    if:
        eq string_access::len spec 0
        then:
            Result::Err selfhost_module_path_invalid_diag span spec
        else:
            match selfhost_module_path_join span selfhost_module_path_map_stdlib_root map spec:
                Result::Ok joined:
                    selfhost_module_path_finish span SelfhostModulePathKind::Stdlib joined
                Result::Err diag:
                    Result::Err diag

//: selfhost_module_path_resolve_relative: current module 基準で relative import を[解決/かいけつ]する
pub fn selfhost_module_path_resolve_relative %impure fn &SelfhostModulePathMap impure fn str impure fn SelfhostSourceSpan impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \map\current_path\span\spec:
    let kind %SelfhostModulePathKind selfhost_module_path_kind_for_current map current_path
    let root %str selfhost_module_path_root_for_kind map kind
    let base_dir %str selfhost_module_path_parent_dir current_path
    selfhost_module_path_resolve_relative_loop span kind root base_dir spec

//: selfhost_module_path_import_kind: import path の形式を[分類/ぶんるい]する
//:
//: [目的/もくてき]:
//: - resolver の入口で string prefix 判定を閉じ込め、以降の分岐を enum の match として扱います。
//: - `SelfhostModuleImportPathKind` を増やした場合、resolver 側の match arm 追加漏れを検出できる形にします。
pub fn selfhost_module_path_import_kind %fn str SelfhostModuleImportPathKind \spec:
    if:
        string_search::str_starts_with spec "/"
        then:
            SelfhostModuleImportPathKind::Absolute
        else:
            if:
                string_search::str_starts_with spec "."
                then:
                    SelfhostModuleImportPathKind::Relative
                else:
                    SelfhostModuleImportPathKind::Stdlib

//: selfhost_module_path_resolve_import: import path 文字列を VFS logical path へ[解決/かいけつ]する
//:
//: [仕様/しよう]:
//: - `/` で始まる path は root-relative logical path として扱います。
//: - `.` で始まる path は current module の directory から lexical に解決します。
//: - それ以外は stdlib root 基準で解決します。
pub fn selfhost_module_path_resolve_import %impure fn &SelfhostModulePathMap impure fn str impure fn SelfhostSourceSpan impure fn str Result SelfhostResolvedModulePath SelfhostDiagnostic \map\current_path\span\spec:
    match selfhost_module_path_import_kind spec:
        SelfhostModuleImportPathKind::Absolute:
            selfhost_module_path_resolve_absolute map span spec
        SelfhostModuleImportPathKind::Relative:
            selfhost_module_path_resolve_relative map current_path span spec
        SelfhostModuleImportPathKind::Stdlib:
            selfhost_module_path_resolve_stdlib map span spec

//: selfhost_module_path_resolve_import_spec: typed import spec を VFS logical path へ[解決/かいけつ]する
//:
//: [目的/もくてき]:
//: - `SelfhostImportSpec` は `str` owner を持たないため、元 lexeme から import path を切り出して resolver に渡します。
pub fn selfhost_module_path_resolve_import_spec %impure fn &SelfhostModulePathMap impure fn str impure fn str impure fn SelfhostImportSpec Result SelfhostResolvedModulePath SelfhostDiagnostic \map\current_path\lexeme\spec:
    let path %str selfhost_import_spec_path lexeme spec
    let import_span %SelfhostSourceSpan selfhost_import_spec_span spec
    selfhost_module_path_resolve_import map current_path import_span path
