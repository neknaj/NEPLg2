#indent 4

//: # graph
//: NEPLg2.0 self-host compiler の import graph を[構築/こうちく]するモジュールです。
//:
//: [目的/もくてき]:
//: - VFS 上の root module から `#import` を[辿/たど]り、module path と import edge の closure を[作/つく]ります。
//: - missing module と import cycle を `SelfhostDiagnostic` として[返/かえ]し、resolver が loader/parser の内部表現へ直接依存しないようにします。
//:
//: [実装/じっそう]:
//: - `SelfhostModuleGraph` は `Vec SelfhostModuleGraphNode` と `Vec SelfhostModuleGraphEdge` を所有します。
//: - node は `Visiting` / `Done` の状態を持ち、DFS 中の再訪問を cycle として検出します。
//: - module source から top-level import directive だけを scan し、graph には path、file_id、edge span だけを残します。
//:
//: [注意/ちゅうい]:
//: - graph 内の path は VFS source または caller が渡した path に由来する `str` です。graph 利用中は VFS と root path の lifetime を保ってください。
//: - `selfhost_build_module_graph` は VFS path の完全一致 API です。stdlib root / user root を解決する場合は `selfhost_build_module_graph_with_path_map` を使います。
//:
//: [計算量/けいさんりょう]:
//: - path lookup と visited lookup は現段階では線形探索です。module 数 n、import edge 数 e に対して O(n^2 + e n) です。
//: - S2 の stdlib map / resolver 要求が固まった段階で HashMap へ移行できます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/module/graph" as *
//: fn main %impure fn unit i32 \unit:
//:     selfhost_module_graph_stage0
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/search" as string_search
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/import_scan" as *
#import "neplg2/core/module/stdlib_map" as *
#import "neplg2/core/module/vfs" as *
#import "core/field" as *

//: SelfhostModuleGraphNodeStatus: DFS 中の module node 状態
pub enum SelfhostModuleGraphNodeStatus:
    Visiting
    Done

impl Clone for SelfhostModuleGraphNodeStatus:
    fn clone %fn &SelfhostModuleGraphNodeStatus SelfhostModuleGraphNodeStatus \self:
        *self

impl Copy for SelfhostModuleGraphNodeStatus:
    fn copy_mark %fn SelfhostModuleGraphNodeStatus SelfhostModuleGraphNodeStatus \self:
        self

//: SelfhostModuleGraphNode: import graph の module node
//:
//: [目的/もくてき]:
//: - logical path、VFS file_id、DFS 状態、直接 import 数を 1 node として[保持/ほじ]します。
pub struct SelfhostModuleGraphNode:
    path %str
    file_id %i32
    status %SelfhostModuleGraphNodeStatus
    import_count %i32

impl Clone for SelfhostModuleGraphNode:
    fn clone %fn &SelfhostModuleGraphNode SelfhostModuleGraphNode \self:
        *self

impl Copy for SelfhostModuleGraphNode:
    fn copy_mark %fn SelfhostModuleGraphNode SelfhostModuleGraphNode \self:
        self

//: SelfhostModuleGraphEdge: `from -> to` の import edge
//:
//: [目的/もくてき]:
//: - import 元 path、import 先 path、元 directive の span を[保持/ほじ]します。
//: - resolver / diagnostic は edge span から import directive の位置を[参照/さんしょう]できます。
pub struct SelfhostModuleGraphEdge:
    from %str
    to %str
    span %SelfhostSourceSpan

impl Clone for SelfhostModuleGraphEdge:
    fn clone %fn &SelfhostModuleGraphEdge SelfhostModuleGraphEdge \self:
        *self

impl Copy for SelfhostModuleGraphEdge:
    fn copy_mark %fn SelfhostModuleGraphEdge SelfhostModuleGraphEdge \self:
        self

//: SelfhostModuleGraph: import closure の所有 graph
pub struct SelfhostModuleGraph:
    nodes %Vec SelfhostModuleGraphNode
    edges %Vec SelfhostModuleGraphEdge

//: selfhost_module_graph_node_new: module graph node を[作/つく]る
pub fn selfhost_module_graph_node_new %fn str fn i32 fn SelfhostModuleGraphNodeStatus fn i32 SelfhostModuleGraphNode \path\file_id\status\import_count:
    SelfhostModuleGraphNode path file_id status import_count

//: selfhost_module_graph_edge_new: import edge を[作/つく]る
pub fn selfhost_module_graph_edge_new %fn str fn str fn SelfhostSourceSpan SelfhostModuleGraphEdge \from\to\span:
    SelfhostModuleGraphEdge from to span

//: selfhost_module_graph_new: [空/から]の module graph を[作/つく]る
pub fn selfhost_module_graph_new %impure fn unit Result SelfhostModuleGraph StdErrorKind \unit:
    let nodes_result %Result Vec SelfhostModuleGraphNode StdErrorKind v::new
    match nodes_result:
        Result::Ok nodes:
            let edges_result %Result Vec SelfhostModuleGraphEdge StdErrorKind v::new
            match edges_result:
                Result::Ok edges:
                    Result::Ok SelfhostModuleGraph nodes edges
                Result::Err e:
                    v::free nodes
                    Result::Err e
        Result::Err e:
            Result::Err e

//: selfhost_module_graph_free: graph が所有する buffer を[解放/かいほう]する
pub fn selfhost_module_graph_free %impure fn SelfhostModuleGraph unit \graph:
    let nodes %Vec SelfhostModuleGraphNode field::get graph "nodes"
    let edges %Vec SelfhostModuleGraphEdge field::get graph "edges"
    v::free nodes
    v::free edges

//: selfhost_module_graph_node_len: module node 数を[返/かえ]す
pub fn selfhost_module_graph_node_len %fn &SelfhostModuleGraph i32 \graph:
    let nodes %&Vec SelfhostModuleGraphNode field::get_ref graph "nodes"
    v::len nodes

//: selfhost_module_graph_edge_len: import edge 数を[返/かえ]す
pub fn selfhost_module_graph_edge_len %fn &SelfhostModuleGraph i32 \graph:
    let edges %&Vec SelfhostModuleGraphEdge field::get_ref graph "edges"
    v::len edges

//: selfhost_module_graph_node_at: index の module node を[返/かえ]す
pub fn selfhost_module_graph_node_at %fn &SelfhostModuleGraph fn i32 Option SelfhostModuleGraphNode \graph\idx:
    let nodes %&Vec SelfhostModuleGraphNode field::get_ref graph "nodes"
    v::get nodes idx

//: selfhost_module_graph_edge_at: index の import edge を[返/かえ]す
pub fn selfhost_module_graph_edge_at %fn &SelfhostModuleGraph fn i32 Option SelfhostModuleGraphEdge \graph\idx:
    let edges %&Vec SelfhostModuleGraphEdge field::get_ref graph "edges"
    v::get edges idx

//: selfhost_module_graph_find_node_loop: path に一致する node index を[探/さが]す
pub fn selfhost_module_graph_find_node_loop %fn &SelfhostModuleGraph fn str fn i32 fn i32 Option i32 \graph\path\n\idx:
    if:
        ge idx n
        then:
            none
        else:
            match selfhost_module_graph_node_at graph idx:
                Option::Some node:
                    if:
                        string_search::str_eq node.path path
                        then:
                            some idx
                        else:
                            selfhost_module_graph_find_node_loop graph path n add idx 1
                Option::None:
                    none

//: selfhost_module_graph_find_node: path に一致する node index を[返/かえ]す
pub fn selfhost_module_graph_find_node %fn &SelfhostModuleGraph fn str Option i32 \graph\path:
    selfhost_module_graph_find_node_loop graph path selfhost_module_graph_node_len graph 0

//: selfhost_module_graph_has_path: graph が path を[含/ふく]むか[返/かえ]す
pub fn selfhost_module_graph_has_path %fn &SelfhostModuleGraph fn str bool \graph\path:
    match selfhost_module_graph_find_node graph path:
        Option::Some _idx:
            true
        Option::None:
            false

//: selfhost_module_graph_diag: graph diagnostic を[作/つく]る
pub fn selfhost_module_graph_diag %fn SelfhostSourceSpan fn SelfhostResolveDiagnosticCode fn str fn str fn str SelfhostDiagnostic \span\code\message\label\note:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Resolve code message
    let labeled %SelfhostDiagnostic selfhost_diag_with_primary_label diag selfhost_diag_label_new span label
    selfhost_diag_with_note labeled note

//: selfhost_module_graph_oom_diag: graph allocation failure diagnostic を[作/つく]る
pub fn selfhost_module_graph_oom_diag %fn SelfhostSourceSpan SelfhostDiagnostic \span:
    selfhost_module_graph_diag span SelfhostResolveDiagnosticCode::ModuleGraphOutOfMemory "module graph allocation failed" "allocation failed while building import graph" ""

//: selfhost_module_graph_missing_diag: import 先が VFS に無いことを[報告/ほうこく]する
pub fn selfhost_module_graph_missing_diag %fn SelfhostSourceSpan fn str SelfhostDiagnostic \span\path:
    selfhost_module_graph_diag span SelfhostResolveDiagnosticCode::ModuleGraphMissingModule "imported module is not registered in self-host VFS" "missing module imported here" path

//: selfhost_module_graph_cycle_diag: import cycle を[報告/ほうこく]する
pub fn selfhost_module_graph_cycle_diag %fn SelfhostSourceSpan fn str SelfhostDiagnostic \span\path:
    selfhost_module_graph_diag span SelfhostResolveDiagnosticCode::ModuleGraphCycle "import cycle detected while building self-host module graph" "cycle reaches an active module here" path

//: selfhost_module_graph_internal_diag: graph 内部不整合 diagnostic を[作/つく]る
pub fn selfhost_module_graph_internal_diag %fn SelfhostSourceSpan fn str SelfhostDiagnostic \span\note:
    selfhost_module_graph_diag span SelfhostResolveDiagnosticCode::ModuleGraphInternal "module graph internal invariant failed" "module graph invariant failed here" note

//: selfhost_module_graph_push_node: node を graph に[追加/ついか]する
pub fn selfhost_module_graph_push_node %impure fn SelfhostModuleGraph impure fn SelfhostModuleGraphNode impure fn SelfhostSourceSpan Result SelfhostModuleGraph SelfhostDiagnostic \graph\node\span:
    let nodes %Vec SelfhostModuleGraphNode field::get graph "nodes"
    let edges %Vec SelfhostModuleGraphEdge field::get graph "edges"
    match v::push nodes node:
        Result::Ok next_nodes:
            Result::Ok SelfhostModuleGraph next_nodes edges
        Result::Err e:
            v::free v::vec_push_error_vec e
            v::free edges
            Result::Err selfhost_module_graph_oom_diag span

//: selfhost_module_graph_push_edge: edge を graph に[追加/ついか]する
pub fn selfhost_module_graph_push_edge %impure fn SelfhostModuleGraph impure fn SelfhostModuleGraphEdge impure fn SelfhostSourceSpan Result SelfhostModuleGraph SelfhostDiagnostic \graph\edge\span:
    let nodes %Vec SelfhostModuleGraphNode field::get graph "nodes"
    let edges %Vec SelfhostModuleGraphEdge field::get graph "edges"
    match v::push edges edge:
        Result::Ok next_edges:
            Result::Ok SelfhostModuleGraph nodes next_edges
        Result::Err e:
            v::free v::vec_push_error_vec e
            v::free nodes
            Result::Err selfhost_module_graph_oom_diag span

//: selfhost_module_graph_set_node: node を in-place に[置/お]き[換/か]える
pub fn selfhost_module_graph_set_node %impure fn SelfhostModuleGraph impure fn i32 impure fn SelfhostModuleGraphNode SelfhostModuleGraph \graph\idx\node:
    let nodes %&Vec SelfhostModuleGraphNode field::get_ref &graph "nodes"
    v::replace nodes idx node
    graph

//: selfhost_module_graph_set_state: node の状態と import 数を[更新/こうしん]する
pub fn selfhost_module_graph_set_state %impure fn SelfhostModuleGraph impure fn i32 impure fn SelfhostModuleGraphNodeStatus impure fn i32 SelfhostModuleGraph \graph\idx\status\import_count:
    match selfhost_module_graph_node_at &graph idx:
        Option::Some node:
            selfhost_module_graph_set_node graph idx selfhost_module_graph_node_new node.path node.file_id status import_count
        Option::None:
            graph

//: selfhost_module_graph_visit_import_records: scanned import record を DFS 展開する
//:
//: [目的/もくてき]:
//: - import graph の通常経路では full module AST を作らず、source scan から得た import record だけで edge と visit を処理します。
//: - parser の全関数を graph doctest へ引き込まないための lightweight path です。
pub fn selfhost_module_graph_visit_import_records %impure fn &SelfhostVirtualFileSystem impure fn str impure fn &Vec SelfhostImportRecord impure fn i32 impure fn i32 impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\from_path\imports\n\idx\graph:
    if:
        ge idx n
        then:
            Result::Ok graph
        else:
            match v::get imports idx:
                Option::Some record:
                    let edge %SelfhostModuleGraphEdge selfhost_module_graph_edge_new from_path record.path record.span
                    match selfhost_module_graph_push_edge graph edge record.span:
                        Result::Ok edge_graph:
                            match selfhost_module_graph_visit vfs record.path record.span edge_graph:
                                Result::Ok next_graph:
                                    selfhost_module_graph_visit_import_records vfs from_path imports n add idx 1 next_graph
                                Result::Err diag:
                                    Result::Err diag
                        Result::Err diag:
                            Result::Err diag
                Option::None:
                    selfhost_module_graph_free graph
                    Result::Err selfhost_module_graph_internal_diag source_span_empty 0 0 "import record index was unavailable"

//: selfhost_module_graph_visit_import_records_with_path_map: path map で import record を DFS 展開する
pub fn selfhost_module_graph_visit_import_records_with_path_map %impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModulePathMap impure fn str impure fn &Vec SelfhostImportRecord impure fn i32 impure fn i32 impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path_map\from_path\imports\n\idx\graph:
    if:
        ge idx n
        then:
            Result::Ok graph
        else:
            match v::get imports idx:
                Option::Some record:
                    match selfhost_module_path_resolve_import path_map from_path record.span record.path:
                        Result::Ok resolved:
                            let edge %SelfhostModuleGraphEdge selfhost_module_graph_edge_new from_path resolved.path record.span
                            match selfhost_module_graph_push_edge graph edge record.span:
                                Result::Ok edge_graph:
                                    match selfhost_module_graph_visit_with_path_map vfs path_map resolved.path record.span edge_graph:
                                        Result::Ok next_graph:
                                            selfhost_module_graph_visit_import_records_with_path_map vfs path_map from_path imports n add idx 1 next_graph
                                        Result::Err diag:
                                            Result::Err diag
                                Result::Err diag:
                                    Result::Err diag
                        Result::Err diag:
                            selfhost_module_graph_free graph
                            Result::Err diag
                Option::None:
                    selfhost_module_graph_free graph
                    Result::Err selfhost_module_graph_internal_diag source_span_empty 0 0 "import record index was unavailable"

//: selfhost_module_graph_extract_scanned_imports: lightweight import scan 結果から graph edge を展開する
pub fn selfhost_module_graph_extract_scanned_imports %impure fn &SelfhostVirtualFileSystem impure fn str impure fn i32 impure fn SelfhostModuleGraph impure fn Vec SelfhostImportRecord Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path\node_idx\graph\imports:
    let import_count %i32 v::len &imports
    let graph_with_count %SelfhostModuleGraph selfhost_module_graph_set_state graph node_idx SelfhostModuleGraphNodeStatus::Visiting import_count
    match selfhost_module_graph_visit_import_records vfs path &imports import_count 0 graph_with_count:
        Result::Ok graph_after_imports:
            v::free imports
            Result::Ok selfhost_module_graph_set_state graph_after_imports node_idx SelfhostModuleGraphNodeStatus::Done import_count
        Result::Err diag:
            v::free imports
            Result::Err diag

//: selfhost_module_graph_extract_scanned_imports_with_path_map: path map 付き lightweight import scan 結果を graph edge にする
pub fn selfhost_module_graph_extract_scanned_imports_with_path_map %impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModulePathMap impure fn str impure fn i32 impure fn SelfhostModuleGraph impure fn Vec SelfhostImportRecord Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path_map\path\node_idx\graph\imports:
    let import_count %i32 v::len &imports
    let graph_with_count %SelfhostModuleGraph selfhost_module_graph_set_state graph node_idx SelfhostModuleGraphNodeStatus::Visiting import_count
    match selfhost_module_graph_visit_import_records_with_path_map vfs path_map path &imports import_count 0 graph_with_count:
        Result::Ok graph_after_imports:
            v::free imports
            Result::Ok selfhost_module_graph_set_state graph_after_imports node_idx SelfhostModuleGraphNodeStatus::Done import_count
        Result::Err diag:
            v::free imports
            Result::Err diag

//: selfhost_module_graph_visit_new: 未訪問 module を parse して import を[辿/たど]る
pub fn selfhost_module_graph_visit_new %impure fn &SelfhostVirtualFileSystem impure fn str impure fn SelfhostSourceSpan impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path\span\graph:
    match selfhost_vfs_find vfs path:
        Option::Some file:
            match selfhost_scan_module_imports_with_file_id file.source file.file_id:
                Result::Ok imports:
                    let node_idx %i32 selfhost_module_graph_node_len &graph
                    let node %SelfhostModuleGraphNode selfhost_module_graph_node_new file.path file.file_id SelfhostModuleGraphNodeStatus::Visiting 0
                    match selfhost_module_graph_push_node graph node span:
                        Result::Ok graph_with_node:
                            selfhost_module_graph_extract_scanned_imports vfs file.path node_idx graph_with_node imports
                        Result::Err diag:
                            v::free imports
                            Result::Err diag
                Result::Err diag:
                    selfhost_module_graph_free graph
                    Result::Err diag
        Option::None:
            selfhost_module_graph_free graph
            Result::Err selfhost_module_graph_missing_diag span path

//: selfhost_module_graph_visit_new_with_path_map: path map 付きで未訪問 module を DFS に[取/と]り[込/こ]む
pub fn selfhost_module_graph_visit_new_with_path_map %impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModulePathMap impure fn str impure fn SelfhostSourceSpan impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path_map\path\span\graph:
    match selfhost_vfs_find vfs path:
        Option::Some file:
            match selfhost_scan_module_imports_with_file_id file.source file.file_id:
                Result::Ok imports:
                    let node_idx %i32 selfhost_module_graph_node_len &graph
                    let node %SelfhostModuleGraphNode selfhost_module_graph_node_new file.path file.file_id SelfhostModuleGraphNodeStatus::Visiting 0
                    match selfhost_module_graph_push_node graph node span:
                        Result::Ok graph_with_node:
                            selfhost_module_graph_extract_scanned_imports_with_path_map vfs path_map file.path node_idx graph_with_node imports
                        Result::Err diag:
                            v::free imports
                            Result::Err diag
                Result::Err diag:
                    selfhost_module_graph_free graph
                    Result::Err diag
        Option::None:
            selfhost_module_graph_free graph
            Result::Err selfhost_module_graph_missing_diag span path

//: selfhost_module_graph_visit_existing: 既存 node の状態に応じて再訪問を[処理/しょり]する
pub fn selfhost_module_graph_visit_existing %impure fn str impure fn SelfhostSourceSpan impure fn SelfhostModuleGraph impure fn i32 Result SelfhostModuleGraph SelfhostDiagnostic \path\span\graph\idx:
    match selfhost_module_graph_node_at &graph idx:
        Option::Some node:
            match node.status:
                SelfhostModuleGraphNodeStatus::Visiting:
                    selfhost_module_graph_free graph
                    Result::Err selfhost_module_graph_cycle_diag span path
                SelfhostModuleGraphNodeStatus::Done:
                    Result::Ok graph
        Option::None:
            selfhost_module_graph_free graph
            Result::Err selfhost_module_graph_internal_diag span "module node index was unavailable"

//: selfhost_module_graph_visit: 1 module path を import graph に[取/と]り[込/こ]む
pub fn selfhost_module_graph_visit %impure fn &SelfhostVirtualFileSystem impure fn str impure fn SelfhostSourceSpan impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path\span\graph:
    match selfhost_module_graph_find_node &graph path:
        Option::Some idx:
            selfhost_module_graph_visit_existing path span graph idx
        Option::None:
            selfhost_module_graph_visit_new vfs path span graph

//: selfhost_module_graph_visit_with_path_map: path map 付きで 1 module path を graph に[取/と]り[込/こ]む
pub fn selfhost_module_graph_visit_with_path_map %impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModulePathMap impure fn str impure fn SelfhostSourceSpan impure fn SelfhostModuleGraph Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path_map\path\span\graph:
    match selfhost_module_graph_find_node &graph path:
        Option::Some idx:
            selfhost_module_graph_visit_existing path span graph idx
        Option::None:
            selfhost_module_graph_visit_new_with_path_map vfs path_map path span graph

//: selfhost_build_module_graph: root path から import graph を[構築/こうちく]する
//:
//: [注意/ちゅうい]:
//: - 成功時の `SelfhostModuleGraph` は caller が `selfhost_module_graph_free` してください。
pub fn selfhost_build_module_graph %impure fn &SelfhostVirtualFileSystem impure fn str Result SelfhostModuleGraph SelfhostDiagnostic \vfs\root_path:
    match selfhost_module_graph_new:
        Result::Ok graph:
            selfhost_module_graph_visit vfs root_path source_span_empty 0 0 graph
        Result::Err _e:
            Result::Err selfhost_module_graph_oom_diag source_span_empty 0 0

//: selfhost_build_module_graph_with_path_map: stdlib/user root を解決しながら import graph を[構築/こうちく]する
//:
//: [注意/ちゅうい]:
//: - `root_path` は既に VFS logical path へ変換済みである必要があります。
//: - import directive の path は `path_map` により VFS logical path へ解決されます。
pub fn selfhost_build_module_graph_with_path_map %impure fn &SelfhostVirtualFileSystem impure fn &SelfhostModulePathMap impure fn str Result SelfhostModuleGraph SelfhostDiagnostic \vfs\path_map\root_path:
    match selfhost_module_graph_new:
        Result::Ok graph:
            selfhost_module_graph_visit_with_path_map vfs path_map root_path source_span_empty 0 0 graph
        Result::Err _e:
            Result::Err selfhost_module_graph_oom_diag source_span_empty 0 0

//: selfhost_module_graph_stage0: VFS から import graph を[作/つく]る smoke API
pub fn selfhost_module_graph_stage0 %impure fn unit i32 \unit:
    match selfhost_vfs_new:
        Result::Ok vfs0:
            match selfhost_vfs_add vfs0 "main.nepl" "#import \"util.nepl\" as util\nfn main <()->i32> ():\n    0\n":
                Result::Ok vfs1:
                    match selfhost_vfs_add vfs1 "util.nepl" "fn util <()->i32> ():\n    1\n":
                        Result::Ok vfs2:
                            match selfhost_build_module_graph &vfs2 "main.nepl":
                                Result::Ok graph:
                                    let n %i32 selfhost_module_graph_node_len &graph
                                    let e %i32 selfhost_module_graph_edge_len &graph
                                    selfhost_module_graph_free graph
                                    selfhost_vfs_free vfs2
                                    if and eq n 2 eq e 1 0 1
                                Result::Err _diag:
                                    selfhost_vfs_free vfs2
                                    1
                        Result::Err _e:
                            1
                Result::Err _e:
                    1
        Result::Err _e:
            1
