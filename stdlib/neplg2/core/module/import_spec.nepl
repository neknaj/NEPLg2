#indent 4

//: # import_spec
//: NEPLg2.0 self-host compiler の import directive を typed data へ変換するモジュールです。
//:
//: [目的/もくてき]:
//: - `#import "path" as alias` / `#import "path" as *` を `SelfhostImportSpec` として[構造化/こうぞうか]します。
//: - module loader、import graph、resolver が raw lexeme を個別に再解析しないようにします。
//:
//: [実装/じっそう]:
//: - parser が保持した `SelfhostModuleItemKind::ImportDirective` の lexeme を byte scan で読みます。
//: - path は最初の `"` と次の `"` の間、alias は `as` の後ろの空白を除いた単語として扱います。
//: - malformed directive は `SelfhostDiagnostic` で返します。
//:
//: [注意/ちゅうい]:
//: - path literal 内の escape はまだ扱いません。Rust parser parity の import 仕様へ合わせる段階で拡張します。
//: - alias は現段階では文字列として保持し、`*` の場合だけ `is_wildcard = true` にします。
//:
//: [計算量/けいさんりょう]:
//: - 1 directive の解析は lexeme 長 n に対して O(n) です。
//: - `selfhost_module_import_specs` は module item 数 m と import lexeme 合計長 n に対して O(m + n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/module/import_spec" as *
//: fn main <()*>i32> ():
//:     match selfhost_import_spec_parse_lexeme source_span_new 0 0 28 "#import \"core/result\" as *":
//:         Result::Ok spec:
//:             if selfhost_import_spec_is_wildcard spec 0 1
//:         Result::Err _diag:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string" as string
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *

//: SelfhostImportSpec: `#import` directive の typed representation
//:
//: [目的/もくてき]:
//: - import path、alias、wildcard import かどうか、元 directive の span を 1 [値/あたい]として[扱/あつか]います。
//: - 後続の import graph / resolver は raw string ではなくこの値を入力にします。
struct SelfhostImportSpec:
    span <SelfhostSourceSpan>
    path <str>
    alias <str>
    is_wildcard <bool>

impl Clone for SelfhostImportSpec:
    fn clone <(&SelfhostImportSpec)->SelfhostImportSpec> (self):
        *self

impl Copy for SelfhostImportSpec:
    fn copy_mark <(SelfhostImportSpec)->SelfhostImportSpec> (self):
        self

//: selfhost_import_spec_new: import spec を[作/つく]る
fn selfhost_import_spec_new <(SelfhostSourceSpan,str,str,bool)->SelfhostImportSpec> (span, path, alias, is_wildcard):
    SelfhostImportSpec span path alias is_wildcard

//: selfhost_import_spec_is_wildcard: wildcard import か[返/かえ]す
fn selfhost_import_spec_is_wildcard <(SelfhostImportSpec)->bool> (spec):
    spec.is_wildcard

//: selfhost_module_item_kind_is_import_directive: module item kind が import directive か[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - `SelfhostModuleItemKind` の全 variant を明示的に[扱/あつか]い、item kind 追加時にこの分類表も見直せるようにします。
//: - import directive だけを集める判定を module 層の共有 helper として固定します。
fn selfhost_module_item_kind_is_import_directive <(SelfhostModuleItemKind)->bool> (kind):
    match kind:
        SelfhostModuleItemKind::DocComment:
            false
        SelfhostModuleItemKind::MlstrLine:
            false
        SelfhostModuleItemKind::EntryDirective:
            false
        SelfhostModuleItemKind::TargetDirective:
            false
        SelfhostModuleItemKind::ImportDirective:
            true
        SelfhostModuleItemKind::UseDirective:
            false
        SelfhostModuleItemKind::IfTargetDirective:
            false
        SelfhostModuleItemKind::IfProfileDirective:
            false
        SelfhostModuleItemKind::CapabilityDirective:
            false
        SelfhostModuleItemKind::PreludeDirective:
            false
        SelfhostModuleItemKind::NoPreludeDirective:
            false
        SelfhostModuleItemKind::IntrinsicDirective:
            false
        SelfhostModuleItemKind::WasmBlock:
            false
        SelfhostModuleItemKind::LlvmIrBlock:
            false
        SelfhostModuleItemKind::WasmText:
            false
        SelfhostModuleItemKind::LlvmIrText:
            false
        SelfhostModuleItemKind::FunctionDecl:
            false
        SelfhostModuleItemKind::StructDecl:
            false
        SelfhostModuleItemKind::EnumDecl:
            false
        SelfhostModuleItemKind::TraitDecl:
            false
        SelfhostModuleItemKind::ImplDecl:
            false

//: selfhost_import_diag: import directive diagnostic を[作/つく]る
fn selfhost_import_diag <(SelfhostSourceSpan,str,str,str)->SelfhostDiagnostic> (span, code, message, label):
    let diag <SelfhostDiagnostic> selfhost_diag_error code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span label

//: selfhost_import_find_byte: 指定 byte を[探/さが]し、なければ -1 を[返/かえ]す
fn selfhost_import_find_byte <(str,i32,i32,i32)->i32> (s, n, idx, needle):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string::string_byte_at_unchecked s idx
            if:
                eq ch needle
                then:
                    idx
                else:
                    selfhost_import_find_byte s n add idx 1 needle

//: selfhost_import_is_space: directive 内の ASCII whitespace か[返/かえ]す
fn selfhost_import_is_space <(i32)->bool> (ch):
    match ch:
        ' ':
            true
        '\t':
            true
        '\r':
            true
        _:
            false

//: selfhost_import_skip_space: whitespace を[読/よ]み[飛/と]ばす
fn selfhost_import_skip_space <(str,i32,i32)->i32> (s, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked s idx
            if:
                selfhost_import_is_space ch
                then:
                    selfhost_import_skip_space s n add idx 1
                else:
                    idx

//: selfhost_import_word_end: whitespace までの alias 終端を[返/かえ]す
fn selfhost_import_word_end <(str,i32,i32)->i32> (s, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked s idx
            if:
                selfhost_import_is_space ch
                then:
                    idx
                else:
                    selfhost_import_word_end s n add idx 1

//: selfhost_import_has_as_keyword: 指定位置に `as` keyword があるか[返/かえ]す
fn selfhost_import_has_as_keyword <(str,i32,i32)->bool> (s, n, idx):
    if:
        lt n add idx 2
        then:
            false
        else:
            let a <i32> string::string_byte_at_unchecked s idx
            let s_ch <i32> string::string_byte_at_unchecked s add idx 1
            let after <i32> add idx 2
            let after_ok <bool> if:
                ge after n
                then:
                    true
                else:
                    selfhost_import_is_space string::string_byte_at_unchecked s after
            and eq a 'a' and eq s_ch 's' after_ok

//: selfhost_import_parse_alias: `as` 後の alias を[読/よ]む
fn selfhost_import_parse_alias <(SelfhostSourceSpan,str,str,i32,i32)*>Result<SelfhostImportSpec, SelfhostDiagnostic>> (span, lexeme, path, n, alias_start):
    let start <i32> selfhost_import_skip_space lexeme n alias_start
    if:
        ge start n
        then:
            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.alias.expected" "import directive requires an alias after as" "expected import alias here"
        else:
            let alias_end <i32> selfhost_import_word_end lexeme n start
            let trailing <i32> selfhost_import_skip_space lexeme n alias_end
            if:
                lt trailing n
                then:
                    Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.trailing_text" "import directive has trailing text after alias" "remove trailing text"
                else:
                    let alias <str> string::str_slice lexeme start alias_end
                    if:
                        eq string::len alias 0
                        then:
                            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.alias.expected" "import directive requires an alias after as" "expected import alias here"
                        else:
                            let is_wildcard <bool> string::str_eq alias "*"
                            Result<SelfhostImportSpec, SelfhostDiagnostic>::Ok selfhost_import_spec_new span path alias is_wildcard

//: selfhost_import_parse_after_path: path literal の後ろから `as alias` を[読/よ]む
fn selfhost_import_parse_after_path <(SelfhostSourceSpan,str,i32,i32)*>Result<SelfhostImportSpec, SelfhostDiagnostic>> (span, lexeme, n, path_end):
    let as_idx <i32> selfhost_import_skip_space lexeme n add path_end 1
    if:
        not selfhost_import_has_as_keyword lexeme n as_idx
        then:
            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.as.expected" "import directive requires `as` after path" "expected `as` here"
        else:
            let path_start <i32> selfhost_import_find_byte lexeme n 0 '"'
            let path <str> string::str_slice lexeme add path_start 1 path_end
            selfhost_import_parse_alias span lexeme path n add as_idx 2

//: selfhost_import_spec_parse_lexeme: import directive lexeme を typed spec へ[変換/へんかん]する
fn selfhost_import_spec_parse_lexeme <(SelfhostSourceSpan,str)*>Result<SelfhostImportSpec, SelfhostDiagnostic>> (span, lexeme):
    let n <i32> string::len lexeme
    let path_start <i32> selfhost_import_find_byte lexeme n 0 '"'
    if:
        lt path_start 0
        then:
            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.path_quote.expected" "import directive requires a quoted path" "expected opening quote"
        else:
            let path_end <i32> selfhost_import_find_byte lexeme n add path_start 1 '"'
            if:
                lt path_end 0
                then:
                    Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.path_quote.unclosed" "import path quote is not closed" "expected closing quote"
                else:
                    if:
                        eq path_end add path_start 1
                        then:
                            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag span "selfhost.import.path.empty" "import path must not be empty" "empty import path"
                        else:
                            selfhost_import_parse_after_path span lexeme n path_end

//: selfhost_import_spec_parse_item: ImportDirective item を typed spec へ[変換/へんかん]する
fn selfhost_import_spec_parse_item <(SelfhostModuleItem)*>Result<SelfhostImportSpec, SelfhostDiagnostic>> (item):
    if:
        selfhost_module_item_kind_is_import_directive item.kind
        then:
            selfhost_import_spec_parse_lexeme item.span item.lexeme
        else:
            Result<SelfhostImportSpec, SelfhostDiagnostic>::Err selfhost_import_diag item.span "selfhost.import.item_kind" "module item is not an import directive" "expected import directive"

//: selfhost_import_specs_loop: ModuleAst から import spec を[集/あつ]める
fn selfhost_import_specs_loop <(&SelfhostModuleAst,i32,i32,Vec<SelfhostImportSpec>)*>Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>> (ast, n, idx, out):
    if:
        ge idx n
        then:
            Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>::Ok out
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    if:
                        selfhost_module_item_kind_is_import_directive item.kind
                        then:
                            match selfhost_import_spec_parse_item item:
                                Result::Ok spec:
                                    match v::push<SelfhostImportSpec> out spec:
                                        Result::Ok next_out:
                                            selfhost_import_specs_loop ast n add idx 1 next_out
                                        Result::Err _e:
                                            Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>::Err selfhost_import_diag item.span "selfhost.import.oom" "import spec buffer allocation failed" "allocation failed"
                                Result::Err diag:
                                    v::free<SelfhostImportSpec> out
                                    Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>::Err diag
                        else:
                            selfhost_import_specs_loop ast n add idx 1 out
                Option::None:
                    v::free<SelfhostImportSpec> out
                    Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>::Err selfhost_import_diag source_span_empty 0 0 "selfhost.import.ast_index" "module AST item index was unavailable" "missing module item"

//: selfhost_module_import_specs: ModuleAst の import directive を typed spec として[集/あつ]める
//:
//: [注意/ちゅうい]:
//: - 成功時の `Vec<SelfhostImportSpec>` は caller が `v::free<SelfhostImportSpec>` してください。
fn selfhost_module_import_specs <(&SelfhostModuleAst)*>Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>> (ast):
    match v::new<SelfhostImportSpec>:
        Result::Ok out:
            selfhost_import_specs_loop ast selfhost_module_ast_len ast 0 out
        Result::Err _e:
            Result<Vec<SelfhostImportSpec>, SelfhostDiagnostic>::Err selfhost_import_diag source_span_empty 0 0 "selfhost.import.oom" "import spec buffer allocation failed" "allocation failed"
