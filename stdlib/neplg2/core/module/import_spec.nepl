#indent 4

//: # import_spec
//: NEPLg2.0 self-host compiler の import directive を typed data へ変換するモジュールです。
//:
//: [目的/もくてき]:
//: - `#import "path" as alias` / `#import "path" as *` を `SelfhostImportSpec` として[構造化/こうぞうか]します。
//: - module loader、import graph、resolver が raw lexeme を個別に再解析しないようにします。
//:
//: [実装/じっそう]:
//: - parser が保持した `SelfhostModuleItemKind::ImportDirective` の lexeme を byte scan で読みます。
//: - path は最初の `"` と次の `"` の間、alias は `as` の後ろの空白を除いた単語として扱います。
//: - import list に保存する spec は lexeme 内の範囲だけを持ち、`str` owner を `Vec` 要素へ入れません。
//: - malformed directive は `SelfhostDiagnostic` で返します。
//:
//: [注意/ちゅうい]:
//: - path literal 内の escape はまだ扱いません。Rust parser parity の import 仕様へ合わせる段階で拡張します。
//: - alias は現段階では範囲として保持し、`*` の場合だけ `is_wildcard = true` にします。
//:
//: [計算量/けいさんりょう]:
//: - 1 directive の解析は lexeme 長 n に対して O(n) です。
//: - `selfhost_module_import_specs` は module item 数 m と import lexeme 合計長 n に対して O(m + n) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/string/search" as string_search
//:| #import "core/result" as *
//:| #import "core/math" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/module/import_spec" as *
//: fn main %impure fn unit i32 \unit:
//:     match selfhost_import_spec_parse_lexeme source_span_new 0 0 28 "#import \"core/result\" as *":
//:         Result::Ok spec:
//:             let wildcard %bool selfhost_import_spec_is_wildcard spec
//:             let path %str selfhost_import_spec_path "#import \"core/result\" as *" spec
//:             let alias %str selfhost_import_spec_alias "#import \"core/result\" as *" spec
//:             if and wildcard and string_search::str_eq path "core/result" string_search::str_eq alias "*" 0 1
//:         Result::Err _diag:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/access" as string_access
#import "alloc/string/byte_index" as string_byte_index
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "alloc/string/scanner" as scanner
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *

fn selfhost_import_spec_byte_or_end %fn str fn i32 i32 \s\idx:
    match string_byte_index::checked_string_byte_at s idx:
        Option::Some b:
            b
        Option::None:
            -1

//: SelfhostImportSpec: `#import` directive の typed representation
//:
//: [目的/もくてき]:
//: - import path / alias の lexeme 内範囲、wildcard import かどうか、元 directive の span を 1 [値/あたい]として[扱/あつか]います。
//: - `str` owner は保持せず、`Vec<SelfhostImportSpec>` に入れても collection 側の element Drop に依存しない Copy-only data にします。
pub struct SelfhostImportSpec:
    span %SelfhostSourceSpan
    item_index %i32
    path_start %i32
    path_end %i32
    alias_start %i32
    alias_end %i32
    is_wildcard %bool

impl Clone for SelfhostImportSpec:
    fn clone %fn &SelfhostImportSpec SelfhostImportSpec \self:
        *self

impl Copy for SelfhostImportSpec:
    fn copy_mark %fn SelfhostImportSpec SelfhostImportSpec \self:
        self

//: selfhost_import_spec_new: import spec を[作/つく]る
pub fn selfhost_import_spec_new %fn SelfhostSourceSpan fn i32 fn i32 fn i32 fn i32 fn i32 fn bool SelfhostImportSpec \span\item_index\path_start\path_end\alias_start\alias_end\is_wildcard:
    SelfhostImportSpec span item_index path_start path_end alias_start alias_end is_wildcard

//: selfhost_import_spec_is_wildcard: wildcard import か[返/かえ]す
pub fn selfhost_import_spec_is_wildcard %fn SelfhostImportSpec bool \spec:
    spec.is_wildcard

//: selfhost_import_spec_span: import directive の span を[返/かえ]す
pub fn selfhost_import_spec_span %fn SelfhostImportSpec SelfhostSourceSpan \spec:
    spec.span

//: selfhost_import_spec_item_index: spec の元 module item index を[返/かえ]す
pub fn selfhost_import_spec_item_index %fn SelfhostImportSpec i32 \spec:
    spec.item_index

//: selfhost_import_spec_path: 元 lexeme から path 文字列を[切/き]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `SelfhostImportSpec` 自体は owner を持たないため、path が必要な境界でだけ `str_slice` により owner を作ります。
//: - caller は返された `str` を assertion、resolver、graph edge などの消費先へ渡してください。
pub fn selfhost_import_spec_path %fn str fn SelfhostImportSpec str \lexeme\spec:
    string_slice::str_slice lexeme spec.path_start spec.path_end

//: selfhost_import_spec_alias: 元 lexeme から alias 文字列を[切/き]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `SelfhostImportSpec` 自体は owner を持たないため、alias が必要な境界でだけ `str_slice` により owner を作ります。
pub fn selfhost_import_spec_alias %fn str fn SelfhostImportSpec str \lexeme\spec:
    string_slice::str_slice lexeme spec.alias_start spec.alias_end

//: selfhost_module_item_kind_is_import_directive: module item kind が import directive か[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - import directive だけを true にし、それ以外の item kind を false にします。
//: - non-import variant は `_` arm にまとめ、item kind が増えても import ではないものを default false として扱う意図を明確にします。
pub fn selfhost_module_item_kind_is_import_directive %fn SelfhostModuleItemKind bool \kind:
    match kind:
        SelfhostModuleItemKind::ImportDirective:
            true
        _:
            false

//: selfhost_import_diag: import directive diagnostic を[作/つく]る
pub fn selfhost_import_diag %fn SelfhostSourceSpan fn SelfhostParserDiagnosticCode fn str fn str SelfhostDiagnostic \span\code\message\label:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Parser code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span label

//: selfhost_import_has_as_keyword: 指定位置に `as` keyword があるか[返/かえ]す
pub fn selfhost_import_has_as_keyword %fn str fn i32 fn i32 bool \s\n\idx:
    if:
        not string_search::str_starts_with_at s idx "as"
        then:
            false
        else:
            let after %i32 add idx 2
            if:
                ge after n
                then:
                    true
                else:
                    scanner::str_byte_is_ascii_inline_space selfhost_import_spec_byte_or_end s after

//: selfhost_import_alias_is_wildcard: alias 範囲が `*` だけか[返/かえ]す
pub fn selfhost_import_alias_is_wildcard %fn str fn i32 fn i32 bool \lexeme\start\alias_end:
    and eq sub alias_end start 1 eq selfhost_import_spec_byte_or_end lexeme start '*'

//: selfhost_import_parse_alias: `as` 後の alias を[読/よ]む
pub fn selfhost_import_parse_alias %impure fn SelfhostSourceSpan impure fn str impure fn i32 impure fn i32 impure fn i32 impure fn i32 impure fn i32 Result SelfhostImportSpec SelfhostDiagnostic \span\lexeme\item_index\path_start\path_end\n\alias_start:
    let start %i32 scanner::str_skip_inline_space_range lexeme alias_start n
    if:
        ge start n
        then:
            Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportAliasExpected "import directive requires an alias after as" "expected import alias here"
        else:
            let alias_end %i32 scanner::str_word_end_inline_space_range lexeme start n
            let trailing %i32 scanner::str_skip_inline_space_range lexeme alias_end n
            if:
                lt trailing n
                then:
                    Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportTrailingText "import directive has trailing text after alias" "remove trailing text"
                else:
                    if:
                        eq alias_end start
                        then:
                            Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportAliasExpected "import directive requires an alias after as" "expected import alias here"
                        else:
                            let is_wildcard %bool selfhost_import_alias_is_wildcard lexeme start alias_end
                            Result::Ok selfhost_import_spec_new span item_index path_start path_end start alias_end is_wildcard

//: selfhost_import_parse_after_path: path literal の後ろから `as alias` を[読/よ]む
pub fn selfhost_import_parse_after_path %impure fn SelfhostSourceSpan impure fn str impure fn i32 impure fn i32 impure fn i32 Result SelfhostImportSpec SelfhostDiagnostic \span\lexeme\item_index\n\path_end:
    let as_idx %i32 scanner::str_skip_inline_space_range lexeme add path_end 1 n
    if:
        not selfhost_import_has_as_keyword lexeme n as_idx
        then:
            Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportAsExpected "import directive requires `as` after path" "expected `as` here"
        else:
            let path_start %i32 scanner::str_find_byte_range lexeme 0 n '"'
            selfhost_import_parse_alias span lexeme item_index add path_start 1 path_end n add as_idx 2

//: selfhost_import_spec_parse_lexeme: import directive lexeme を typed spec へ[変換/へんかん]する
pub fn selfhost_import_spec_parse_lexeme %impure fn SelfhostSourceSpan impure fn str Result SelfhostImportSpec SelfhostDiagnostic \span\lexeme:
    selfhost_import_spec_parse_lexeme_with_item_index span lexeme -1

//: selfhost_import_spec_parse_lexeme_with_item_index: item index を[持/も]つ import directive lexeme を typed spec へ[変換/へんかん]する
pub fn selfhost_import_spec_parse_lexeme_with_item_index %impure fn SelfhostSourceSpan impure fn str impure fn i32 Result SelfhostImportSpec SelfhostDiagnostic \span\lexeme\item_index:
    let n %i32 string_access::len lexeme
    let path_start %i32 scanner::str_find_byte_range lexeme 0 n '"'
    if:
        lt path_start 0
        then:
            Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportPathQuoteExpected "import directive requires a quoted path" "expected opening quote"
        else:
            let path_end %i32 scanner::str_find_byte_range lexeme add path_start 1 n '"'
            if:
                lt path_end 0
                then:
                    Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportPathQuoteUnclosed "import path quote is not closed" "expected closing quote"
                else:
                    if:
                        eq path_end add path_start 1
                        then:
                            Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportPathEmpty "import path must not be empty" "empty import path"
                        else:
                            selfhost_import_parse_after_path span lexeme item_index n path_end

//: selfhost_import_spec_parse_item: ImportDirective item を typed spec へ[変換/へんかん]する
pub fn selfhost_import_spec_parse_item %impure fn SelfhostModuleItem impure fn i32 Result SelfhostImportSpec SelfhostDiagnostic \item\item_index:
    if:
        selfhost_module_item_kind_is_import_directive item.kind
        then:
            selfhost_import_spec_parse_lexeme_with_item_index item.span item.lexeme item_index
        else:
            Result::Err selfhost_import_diag item.span SelfhostParserDiagnosticCode::ImportItemKind "module item is not an import directive" "expected import directive"

//: selfhost_import_specs_loop: ModuleAst から import spec を[集/あつ]める
pub fn selfhost_import_specs_loop %impure fn &SelfhostModuleAst impure fn i32 impure fn i32 impure fn Vec SelfhostImportSpec Result Vec SelfhostImportSpec SelfhostDiagnostic \ast\n\idx\out:
    if:
        ge idx n
        then:
            Result::Ok out
        else:
            match selfhost_module_ast_get ast idx:
                Option::Some item:
                    if:
                        selfhost_module_item_kind_is_import_directive item.kind
                        then:
                            match selfhost_import_spec_parse_item item idx:
                                Result::Ok spec:
                                    match v::push<SelfhostImportSpec> out spec:
                                        Result::Ok next_out:
                                            selfhost_import_specs_loop ast n add idx 1 next_out
                                        Result::Err e:
                                            v::free<SelfhostImportSpec> v::vec_push_error_vec<SelfhostImportSpec> e
                                            Result::Err selfhost_import_diag item.span SelfhostParserDiagnosticCode::OutOfMemory "import spec buffer allocation failed" "allocation failed"
                                Result::Err diag:
                                    v::free<SelfhostImportSpec> out
                                    Result::Err diag
                        else:
                            selfhost_import_specs_loop ast n add idx 1 out
                Option::None:
                    v::free<SelfhostImportSpec> out
                    Result::Err selfhost_import_diag source_span_empty 0 0 SelfhostParserDiagnosticCode::ImportAstIndex "module AST item index was unavailable" "missing module item"

//: selfhost_module_import_specs: ModuleAst の import directive を typed spec として[集/あつ]める
//:
//: [注意/ちゅうい]:
//: - 成功時の `Vec<SelfhostImportSpec>` は caller が `v::free<SelfhostImportSpec>` してください。
pub fn selfhost_module_import_specs %impure fn &SelfhostModuleAst Result Vec SelfhostImportSpec SelfhostDiagnostic \ast:
    match v::new<SelfhostImportSpec>:
        Result::Ok out:
            selfhost_import_specs_loop ast selfhost_module_ast_len ast 0 out
        Result::Err _e:
            Result::Err selfhost_import_diag source_span_empty 0 0 SelfhostParserDiagnosticCode::OutOfMemory "import spec buffer allocation failed" "allocation failed"
