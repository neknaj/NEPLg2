#import "alloc/collections/vec" as v
#import "alloc/string/access" as string_access
#import "alloc/string/byte_index" as string_byte_index
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/import_spec" as *
#import "core/field" as *
#import "core/math" as *

fn selfhost_import_scan_byte_or_end %fn str fn i32 i32 \source\idx:
    match string_byte_index::checked_string_byte_at source idx:
        Option::Some b:
            b
        Option::None:
            -1

//: SelfhostImportVisibility: import directiveのsource-backed visibility
pub enum SelfhostImportVisibility:
    Private
    Public

impl Clone for SelfhostImportVisibility:
    fn clone %fn &SelfhostImportVisibility SelfhostImportVisibility \self: *self

impl Copy for SelfhostImportVisibility:
    fn copy_mark %fn SelfhostImportVisibility SelfhostImportVisibility \self: self

//: SelfhostImportClauseKind: export/import scopeが扱うclosed import clause分類
//: [制約/せいやく]: selective clauseは現parserで未対応のためscan errorとなり、このenumへ偽装しません。
pub enum SelfhostImportClauseKind:
    Alias
    Open
    Merge

impl Clone for SelfhostImportClauseKind:
    fn clone %fn &SelfhostImportClauseKind SelfhostImportClauseKind \self: *self

impl Copy for SelfhostImportClauseKind:
    fn copy_mark %fn SelfhostImportClauseKind SelfhostImportClauseKind \self: self

//: SelfhostImportRecord: graph 構築に必要な import directive 情報
//:
//: [目的/もくてき]:
//: - import directive の span、解決対象 path、alias とその絶対 source span、wildcard かどうかを[保持/ほじ]します。
//: - graph stage は AST item index ではなくこの record を使うため、module parser へ依存しません。
pub struct SelfhostImportRecord:
    span %SelfhostSourceSpan
    import_span %SelfhostSourceSpan
    visibility %SelfhostImportVisibility
    visibility_span %Option SelfhostSourceSpan
    clause %SelfhostImportClauseKind
    path %str
    alias %str
    alias_span %SelfhostSourceSpan
    is_wildcard %bool

impl Clone for SelfhostImportRecord:
    fn clone %fn &SelfhostImportRecord SelfhostImportRecord \self:
        *self

impl Copy for SelfhostImportRecord:
    fn copy_mark %fn SelfhostImportRecord SelfhostImportRecord \self:
        self

//: selfhost_import_record_new: import record を[作/つく]る
pub fn selfhost_import_record_new_with_visibility %fn SelfhostSourceSpan fn SelfhostSourceSpan fn SelfhostImportVisibility fn Option SelfhostSourceSpan fn SelfhostImportClauseKind fn str fn str fn SelfhostSourceSpan fn bool SelfhostImportRecord \span\import_span\visibility\visibility_span\clause\path\alias\alias_span\is_wildcard:
    SelfhostImportRecord span import_span visibility visibility_span clause path alias alias_span is_wildcard

//: selfhost_import_record_new: private import record互換constructor
//: [制約/せいやく]: spanをfull/import spanの両方に使い、visibilityはPrivate、clauseはwildcardならOpen、それ以外はAliasです。
pub fn selfhost_import_record_new %fn SelfhostSourceSpan fn str fn str fn SelfhostSourceSpan fn bool SelfhostImportRecord \span\path\alias\alias_span\is_wildcard:
    selfhost_import_record_new_with_visibility span span SelfhostImportVisibility::Private none if is_wildcard SelfhostImportClauseKind::Open SelfhostImportClauseKind::Alias path alias alias_span is_wildcard

//: selfhost_import_record_span: borrowed recordからdirective spanを[返/かえ]す
//: [契約/けいやく]: Copy payloadだけを返し、record単体をresolver authorityへ昇格させません。
pub fn selfhost_import_record_span %fn &SelfhostImportRecord SelfhostSourceSpan \record:
    *field::get_ref record "span"

//: selfhost_import_record_import_span: import keywordから行末までの絶対spanを返す
pub fn selfhost_import_record_import_span %fn &SelfhostImportRecord SelfhostSourceSpan \record:
    *field::get_ref record "import_span"

//: selfhost_import_record_is_public: importがpublic re-export宣言か返す
//: [契約/けいやく]: scannerが行頭のpublic importを構造検査した結果だけを返し、callerの推測を受け取りません。
pub fn selfhost_import_record_is_public %fn &SelfhostImportRecord bool \record:
    match *field::get_ref record "visibility":
        SelfhostImportVisibility::Public: true
        SelfhostImportVisibility::Private: false

//: selfhost_import_record_visibility_span: public modifierの絶対spanを返す
pub fn selfhost_import_record_visibility_span %fn &SelfhostImportRecord Option SelfhostSourceSpan \record:
    *field::get_ref record "visibility_span"

//: selfhost_import_record_clause: source-backed closed clause分類を返す
pub fn selfhost_import_record_clause %fn &SelfhostImportRecord SelfhostImportClauseKind \record:
    *field::get_ref record "clause"

//: selfhost_import_scan_oom_diag: import scan 中の allocation failure を diagnostic にする
pub fn selfhost_import_scan_oom_diag %fn SelfhostSourceSpan SelfhostDiagnostic \span:
    selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::OutOfMemory "import scanner ran out of memory"

//: selfhost_import_scan_line_end: 行末 byte offset を[返/かえ]す
pub fn selfhost_import_scan_line_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 selfhost_import_scan_byte_or_end source idx
            if:
                or eq ch '\n' eq ch '\r'
                then:
                    idx
                else:
                    selfhost_import_scan_line_end source n add idx 1

//: selfhost_import_scan_next_line: 次の行頭 byte offset を[返/かえ]す
pub fn selfhost_import_scan_next_line %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 selfhost_import_scan_byte_or_end source idx
            if:
                eq ch '\r'
                then:
                    let next %i32 add idx 1
                    if:
                        and lt next n eq selfhost_import_scan_byte_or_end source next '\n'
                        then:
                            add next 1
                        else:
                            next
                else:
                    if:
                        eq ch '\n'
                        then:
                            add idx 1
                        else:
                            selfhost_import_scan_next_line source n add idx 1

//: selfhost_import_scan_is_import_line: 行頭から `#import` directive が始まるか[返/かえ]す
fn selfhost_import_scan_skip_inline_space %fn str fn i32 fn i32 i32 \source\idx\line_end:
    if:
        ge idx line_end
        then: idx
        else:
            let ch %i32 selfhost_import_scan_byte_or_end source idx
            if or eq ch ' ' eq ch '\t' selfhost_import_scan_skip_inline_space source add idx 1 line_end idx

fn selfhost_import_scan_public_directive_start %fn str fn i32 fn i32 Option i32 \source\line_start\line_end:
    if:
        not string_search::str_starts_with_at source line_start "pub"
        then: none
        else:
            let after_pub %i32 add line_start 3
            let directive_start %i32 selfhost_import_scan_skip_inline_space source after_pub line_end
            if and gt directive_start after_pub string_search::str_starts_with_at source directive_start "#import" some directive_start none

pub fn selfhost_import_scan_is_import_line %fn str fn i32 fn i32 bool \source\line_start\line_end:
    let directive_start %i32 match selfhost_import_scan_public_directive_start source line_start line_end:
        Option::Some start: start
        Option::None: line_start
    if:
        not string_search::str_starts_with_at source directive_start "#import"
        then:
            false
        else:
            let after %i32 add directive_start 7
            if:
                ge after line_end
                then:
                    false
                else:
                    let ch %i32 selfhost_import_scan_byte_or_end source after
                    or eq ch ' ' eq ch '\t'

//: selfhost_import_record_from_line: top-level import directive 行から record を[作/つく]る
pub fn selfhost_import_record_from_line %impure fn str impure fn i32 impure fn i32 impure fn i32 Result SelfhostImportRecord SelfhostDiagnostic \source\file_id\line_start\line_end:
    let public_start %Option i32 selfhost_import_scan_public_directive_start source line_start line_end
    let is_public %bool match public_start:
        Option::Some _start: true
        Option::None: false
    let directive_start %i32 match public_start:
        Option::Some start: start
        Option::None: line_start
    let span %SelfhostSourceSpan source_span_new_unchecked file_id line_start line_end
    let import_span %SelfhostSourceSpan source_span_new_unchecked file_id directive_start line_end
    let visibility %SelfhostImportVisibility if is_public SelfhostImportVisibility::Public SelfhostImportVisibility::Private
    let visibility_span %Option SelfhostSourceSpan if is_public some source_span_new_unchecked file_id line_start add line_start 3 none
    let lexeme %str string_slice::str_slice source directive_start line_end
    match selfhost_import_spec_parse_lexeme_with_item_index import_span lexeme 0:
        Result::Ok spec:
            let path %str selfhost_import_spec_path lexeme spec
            let alias %str selfhost_import_spec_alias lexeme spec
            let clause %SelfhostImportClauseKind if selfhost_import_spec_is_wildcard spec SelfhostImportClauseKind::Open if string_search::str_eq alias "@merge" SelfhostImportClauseKind::Merge SelfhostImportClauseKind::Alias
            match selfhost_import_spec_alias_span spec:
                Option::Some alias_span:
                    Result::Ok selfhost_import_record_new_with_visibility span selfhost_import_spec_span spec visibility visibility_span clause path alias alias_span selfhost_import_spec_is_wildcard spec
                Option::None:
                    Result::Err selfhost_import_diag span SelfhostParserDiagnosticCode::ImportAstIndex "import alias span was outside its directive" "scanner/parser alias origin mismatch"
        Result::Err diag:
            Result::Err diag

//: selfhost_scan_module_imports_loop: source text から import record を[集/あつ]める
pub fn selfhost_scan_module_imports_loop %impure fn str impure fn i32 impure fn i32 impure fn i32 impure fn Vec SelfhostImportRecord Result Vec SelfhostImportRecord SelfhostDiagnostic \source\file_id\n\line_start\out:
    if:
        ge line_start n
        then:
            Result::Ok out
        else:
            let line_end %i32 selfhost_import_scan_line_end source n line_start
            let next_line %i32 selfhost_import_scan_next_line source n line_start
            if:
                selfhost_import_scan_is_import_line source line_start line_end
                then:
                    match selfhost_import_record_from_line source file_id line_start line_end:
                        Result::Ok record:
                            match v::push out record:
                                Result::Ok next_out:
                                    selfhost_scan_module_imports_loop source file_id n next_line next_out
                                Result::Err e:
                                    v::free v::vec_push_error_vec e
                                    Result::Err selfhost_import_scan_oom_diag source_span_new_unchecked file_id line_start line_end
                        Result::Err diag:
                            v::free out
                            Result::Err diag
                else:
                    selfhost_scan_module_imports_loop source file_id n next_line out

//: selfhost_scan_module_imports_with_file_id: source text から import record を[集/あつ]める
pub fn selfhost_scan_module_imports_with_file_id %impure fn str impure fn i32 Result Vec SelfhostImportRecord SelfhostDiagnostic \source\file_id:
    let out_result %Result Vec SelfhostImportRecord StdErrorKind v::new
    match out_result:
        Result::Ok out:
            selfhost_scan_module_imports_loop source file_id string_access::len source 0 out
        Result::Err _e:
            Result::Err selfhost_import_scan_oom_diag source_span_empty_unchecked 0 0

//: selfhost_scan_module_imports: single-file 互換の import scanner
pub fn selfhost_scan_module_imports %impure fn str Result Vec SelfhostImportRecord SelfhostDiagnostic \source:
    selfhost_scan_module_imports_with_file_id source 0
