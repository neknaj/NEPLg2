#indent 4

//: # import_scan
//: NEPLg2.0 self-host compiler の import graph 用 import scanner です。
//:
//: [目的/もくてき]:
//: - import graph 構築に必要な top-level `#import` directive だけを source から[取/と]り[出/だ]します。
//: - graph stage が full module parser / lexer token stream へ依存せず、module closure の解決だけを軽量に[行/おこな]えるようにします。
//:
//: [実装/じっそう]:
//: - source を行単位で走査し、行頭 0 column から始まる `#import` directive だけを対象にします。
//: - directive の構文検査、path / alias の範囲計算は `import_spec` の parser を再利用します。
//: - `#import` の後ろが空白でない場合は、別 directive / 通常 token として扱い scan 対象にしません。
//:
//: [注意/ちゅうい]:
//: - この scanner は full parser ではありません。import graph の root closure に必要な top-level import directive だけを読む専用経路です。
//: - indented block 内や raw backend block 内の `#import` 文字列は top-level directive ではないため無視します。
//: - 返された `SelfhostImportRecord.path` / `alias` は source slice に由来します。caller は VFS source の lifetime を graph 構築中に保ってください。
//: - 成功時の `Vec<SelfhostImportRecord>` は caller が `v::free<SelfhostImportRecord>` で[解放/かいほう]します。
//:
//: [計算量/けいさんりょう]:
//: - source byte 数 n、import directive 文字数合計 k に対して O(n + k) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"selfhost_import_scan_basic\" count=3 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"count\" expected=\"2\" actual=\"2\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"first\" expected=\"./util\" actual=\"./util\" message=\"\"\nassertion index=2 status=ok kind=str_eq label=\"second\" expected=\"core/result\" actual=\"core/result\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/module/import_scan" as *
//:| #import "std/test" as *
//: fn record_at <(&Vec<SelfhostImportRecord>,i32)->SelfhostImportRecord> (records, idx):
//:     unwrap<SelfhostImportRecord> v::get<SelfhostImportRecord> records idx
//:
//: fn main <()*>i32> ():
//:     match selfhost_scan_module_imports_with_file_id "#import \"./util\" as util\n#import \"core/result\" as *\n    #import \"ignored\" as inner\nfn main <()->i32> ():\n    0\n" 0:
//:         Result::Ok records:
//:             let r0 <SelfhostImportRecord> record_at &records 0
//:             let r1 <SelfhostImportRecord> record_at &records 1
//:             let report0 <TestReport> test_report_new "selfhost_import_scan_basic"
//:             let report1 <TestReport> test_report_push report0 assert_eq_i32 "count" 2 v::len<SelfhostImportRecord> &records
//:             let report2 <TestReport> test_report_push report1 assert_str_eq "first" "./util" r0.path
//:             let report3 <TestReport> test_report_push report2 assert_str_eq "second" "core/result" r1.path
//:             v::free<SelfhostImportRecord> records
//:             test_report_exit_code test_report_print_stdout report3
//:         Result::Err _diag:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/string/access" as string_access
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/module/import_spec" as *
#import "core/field" as *
#import "core/math" as *

//: SelfhostImportRecord: graph 構築に必要な import directive 情報
//:
//: [目的/もくてき]:
//: - import directive の span、解決対象 path、alias、wildcard かどうかを[保持/ほじ]します。
//: - graph stage は AST item index ではなくこの record を使うため、module parser へ依存しません。
pub struct SelfhostImportRecord:
    span <SelfhostSourceSpan>
    path <str>
    alias <str>
    is_wildcard <bool>

impl Clone for SelfhostImportRecord:
    fn clone <(&SelfhostImportRecord)->SelfhostImportRecord> (self):
        *self

impl Copy for SelfhostImportRecord:
    fn copy_mark <(SelfhostImportRecord)->SelfhostImportRecord> (self):
        self

//: selfhost_import_record_new: import record を[作/つく]る
pub fn selfhost_import_record_new <(SelfhostSourceSpan,str,str,bool)->SelfhostImportRecord> (span, path, alias, is_wildcard):
    SelfhostImportRecord span path alias is_wildcard

//: selfhost_import_scan_oom_diag: import scan 中の allocation failure を diagnostic にする
pub fn selfhost_import_scan_oom_diag <(SelfhostSourceSpan)->SelfhostDiagnostic> (span):
    selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::OutOfMemory "import scanner ran out of memory"

//: selfhost_import_scan_line_end: 行末 byte offset を[返/かえ]す
pub fn selfhost_import_scan_line_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                or eq ch '\n' eq ch '\r'
                then:
                    idx
                else:
                    selfhost_import_scan_line_end source n add idx 1

//: selfhost_import_scan_next_line: 次の行頭 byte offset を[返/かえ]す
pub fn selfhost_import_scan_next_line <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                eq ch '\r'
                then:
                    let next <i32> add idx 1
                    if:
                        and lt next n eq string_access::string_byte_at_unchecked source next '\n'
                        then:
                            add next 1
                        else:
                            next
                else:
                    if:
                        eq ch '\n'
                        then:
                            add idx 1
                        else:
                            selfhost_import_scan_next_line source n add idx 1

//: selfhost_import_scan_is_import_line: 行頭から `#import` directive が始まるか[返/かえ]す
pub fn selfhost_import_scan_is_import_line <(str,i32,i32)->bool> (source, line_start, line_end):
    if:
        not string_search::str_starts_with_at source line_start "#import"
        then:
            false
        else:
            let after <i32> add line_start 7
            if:
                ge after line_end
                then:
                    false
                else:
                    let ch <i32> string_access::string_byte_at_unchecked source after
                    or eq ch ' ' eq ch '\t'

//: selfhost_import_record_from_line: top-level import directive 行から record を[作/つく]る
pub fn selfhost_import_record_from_line <(str,i32,i32,i32)*>Result<SelfhostImportRecord, SelfhostDiagnostic>> (source, file_id, line_start, line_end):
    let span <SelfhostSourceSpan> source_span_new file_id line_start line_end
    let lexeme <str> string_slice::str_slice source line_start line_end
    match selfhost_import_spec_parse_lexeme_with_item_index span lexeme 0:
        Result::Ok spec:
            let path <str> selfhost_import_spec_path lexeme spec
            let alias <str> selfhost_import_spec_alias lexeme spec
            Result<SelfhostImportRecord, SelfhostDiagnostic>::Ok selfhost_import_record_new selfhost_import_spec_span spec path alias selfhost_import_spec_is_wildcard spec
        Result::Err diag:
            Result<SelfhostImportRecord, SelfhostDiagnostic>::Err diag

//: selfhost_scan_module_imports_loop: source text から import record を[集/あつ]める
pub fn selfhost_scan_module_imports_loop <(str,i32,i32,i32,Vec<SelfhostImportRecord>)*>Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>> (source, file_id, n, line_start, out):
    if:
        ge line_start n
        then:
            Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>::Ok out
        else:
            let line_end <i32> selfhost_import_scan_line_end source n line_start
            let next_line <i32> selfhost_import_scan_next_line source n line_start
            if:
                selfhost_import_scan_is_import_line source line_start line_end
                then:
                    match selfhost_import_record_from_line source file_id line_start line_end:
                        Result::Ok record:
                            match v::push<SelfhostImportRecord> out record:
                                Result::Ok next_out:
                                    selfhost_scan_module_imports_loop source file_id n next_line next_out
                                Result::Err e:
                                    v::free<SelfhostImportRecord> v::vec_push_error_vec<SelfhostImportRecord> e
                                    Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>::Err selfhost_import_scan_oom_diag source_span_new file_id line_start line_end
                        Result::Err diag:
                            v::free<SelfhostImportRecord> out
                            Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>::Err diag
                else:
                    selfhost_scan_module_imports_loop source file_id n next_line out

//: selfhost_scan_module_imports_with_file_id: source text から import record を[集/あつ]める
pub fn selfhost_scan_module_imports_with_file_id <(str,i32)*>Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>> (source, file_id):
    match v::new<SelfhostImportRecord>:
        Result::Ok out:
            selfhost_scan_module_imports_loop source file_id string_access::len source 0 out
        Result::Err _e:
            Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>::Err selfhost_import_scan_oom_diag source_span_empty 0 0

//: selfhost_scan_module_imports: single-file 互換の import scanner
pub fn selfhost_scan_module_imports <(str)*>Result<Vec<SelfhostImportRecord>, SelfhostDiagnostic>> (source):
    selfhost_scan_module_imports_with_file_id source 0
