#indent 4

//: # import_scan
//: NEPLg2.0 self-host compiler の import graph 用 import scanner です。
//:
//: [目的/もくてき]:
//: - import graph 構築に必要な top-level `#import` directive だけを source から[取/と]り[出/だ]します。
//: - graph stage が full module parser / lexer token stream へ依存せず、module closure の解決だけを軽量に[行/おこな]えるようにします。
//:
//: [実装/じっそう]:
//: - source を行単位で走査し、行頭 0 column から始まる `#import` directive だけを対象にします。
//: - directive の構文検査、path / alias の範囲計算は `import_spec` の parser を再利用します。
//: - `#import` の後ろが空白でない場合は、別 directive / 通常 token として扱い scan 対象にしません。
//:
//: [注意/ちゅうい]:
//: - この scanner は full parser ではありません。import graph の root closure に必要な top-level import directive だけを読む専用経路です。
//: - indented block 内や raw backend block 内の `#import` 文字列は top-level directive ではないため無視します。
//: - 返された `SelfhostImportRecord.path` / `alias` は source slice に由来します。caller は VFS source の lifetime を graph 構築中に保ってください。
//: - recordはpublic Copy payloadであり単体をresolver capabilityにしません。scan成功経路で使うか、source/spec/graphへ再validationしてください。
//: - 成功時の `Vec SelfhostImportRecord` は caller が `v::free` で[解放/かいほう]します。
//:
//: [計算量/けいさんりょう]:
//: - source byte 数 n、import directive 文字数合計 k に対して O(n + k) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: exit_code: 0
//: stdout: "test_report name=\"selfhost_import_scan_basic\" count=7 failed=0\nassertion index=0 status=ok kind=eq_i32 label=\"count\" expected=\"2\" actual=\"2\" message=\"\"\nassertion index=1 status=ok kind=str_eq label=\"first\" expected=\"./util\" actual=\"./util\" message=\"\"\nassertion index=2 status=ok kind=str_eq label=\"second\" expected=\"core/result\" actual=\"core/result\" message=\"\"\nassertion index=3 status=ok kind=eq_i32 label=\"first alias file\" expected=\"7\" actual=\"7\" message=\"\"\nassertion index=4 status=ok kind=eq_i32 label=\"first alias start\" expected=\"20\" actual=\"20\" message=\"\"\nassertion index=5 status=ok kind=eq_i32 label=\"first alias end\" expected=\"24\" actual=\"24\" message=\"\"\nassertion index=6 status=ok kind=eq_i32 label=\"wildcard alias start\" expected=\"50\" actual=\"50\" message=\"\"\n"
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/module/import_scan" as *
//:| #import "std/test" as *
//: fn record_at %fn &Vec SelfhostImportRecord fn i32 SelfhostImportRecord \records\idx:
//:     unwrap v::get records idx
//:
//: fn main %impure fn void i32 \void:
//:     match selfhost_scan_module_imports_with_file_id "#import \"./util\" as util\n#import \"core/result\" as *\n    #import \"ignored\" as inner\nfn main %fn void i32 \\void:\n    0\n" 7:
//:         Result::Ok records:
//:             let r0 %SelfhostImportRecord record_at &records 0
//:             let r1 %SelfhostImportRecord record_at &records 1
//:             let report0 %TestReport test_report_new "selfhost_import_scan_basic"
//:             let report1 %TestReport test_report_push report0 assert_eq_i32 "count" 2 v::len &records
//:             let report2 %TestReport test_report_push report1 assert_str_eq "first" "./util" r0.path
//:             let report3 %TestReport test_report_push report2 assert_str_eq "second" "core/result" r1.path
//:             let report4 %TestReport test_report_push report3 assert_eq_i32 "first alias file" 7 r0.alias_span.file_id
//:             let report5 %TestReport test_report_push report4 assert_eq_i32 "first alias start" 20 r0.alias_span.start
//:             let report6 %TestReport test_report_push report5 assert_eq_i32 "first alias end" 24 r0.alias_span.end
//:             let report7 %TestReport test_report_push report6 assert_eq_i32 "wildcard alias start" 50 r1.alias_span.start
//:             v::free records
//:             test_report_exit_code test_report_print_stdout report7
//:         Result::Err _diag:
//:             1
//: ```

//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/math" as *
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/module/import_scan" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_scan_module_imports_with_file_id "pub  #import \"lib\" as *\n" 9:
//:         Result::Ok records:
//:             let visibility_ok %bool match v::get &records 0:
//:                 Option::Some record:
//:                     let full_span %SelfhostSourceSpan selfhost_import_record_span &record
//:                     let import_span %SelfhostSourceSpan selfhost_import_record_import_span &record
//:                     let clause_ok %bool match selfhost_import_record_clause &record:
//:                         SelfhostImportClauseKind::Open: true
//:                         _: false
//:                     let vis_span_ok %bool match selfhost_import_record_visibility_span &record:
//:                         Option::Some span: and and eq span.file_id 9 eq span.start 0 eq span.end 3
//:                         Option::None: false
//:                     and and and and and selfhost_import_record_is_public &record eq full_span.start 0 eq full_span.end 23 eq import_span.start 5 vis_span_ok clause_ok
//:                 Option::None: false
//:             v::free records
//:             if visibility_ok 0 1
//:         Result::Err _e: 1
//: ```

