#indent 4

//: # loader
//: NEPLg2.0 self-host compiler の module loading 境界を置くモジュールです。
//:
//: [目的/もくてき]:
//: - CLI [層/そう]が[読/よ]んだ source を filesystem 非依存の VFS として core [層/そう]へ[渡/わた]します。
//: - `path -> source -> SelfhostModuleAst` の入口を固定し、import graph が parser 全体へ直接依存しないよう VFS は `module/vfs` に分離します。
//:
//: [実装/じっそう]:
//: - VFS の所有と lookup は `module/vfs` が担当します。
//: - loader は見つかった source を `selfhost_parse_module_source` へ渡し、成功時は AST を所有する `SelfhostLoadedModule` を返します。
//:
//: [注意/ちゅうい]:
//: - core は `std/fs` や `std/stdio` に依存しません。実 filesystem との接続は CLI 側の責務です。
//: - 返された `SelfhostLoadedModule` は AST buffer を所有するため、使用後に `selfhost_loaded_module_free` を呼びます。
//: - VFS に追加した順番を `file_id` とし、lexer/parser の span へ渡します。
//:
//: [計算量/けいさんりょう]:
//: - path lookup は `module/vfs` の仕様に従います。
//: - parse は source byte 数 m に対して O(m) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/module/loader" as *
//: fn main %impure fn void i32 \void:
//:     selfhost_loader_stage0
//: ```

pub #import "neplg2/core/module/vfs" as *
#import "core/field" as field
#import "core/result" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/parser/module_parser" as *
#import "core/field" as *
#import "core/math" as *
#import "alloc/collections/vec" as v
#import "neplg2/core/syntax/lexer" as *
#import "neplg2/core/syntax/token" as *

//: SelfhostLoadedModule: parse 済み module と logical path
//:
//: [注意/ちゅうい]:
//: - `ast` の item buffer を所有するため、使用後は `selfhost_loaded_module_free` を[呼/よ]びます。
pub struct SelfhostLoadedModule:
    path %str
    ast %SelfhostModuleAst

//: SelfhostLoadedModuleTokens: current VFS source の token stream と AST を同時に所有する
//:
//: [注意/ちゅうい]:
//: - source/path は VFS から借用し、tokens と ast の buffer はこの値が所有します。
//: - VFSとsource backingはこの値の解放後まで生存させます。この値単独はsource bytesを所有しません。
pub struct SelfhostLoadedModuleTokens:
    path %str
    source %str
    file_id %i32
    tokens %(Vec SelfhostToken)
    ast %SelfhostModuleAst

//: SelfhostLoadedModuleTokensErrorKind: exact lookup、lex、parse の失敗分類
pub enum SelfhostLoadedModuleTokensErrorKind:
    MissingPath
    DuplicatePath
    FileIdOrdinalMismatch
    LexFailed
    ParseFailed
    OutOfMemory

impl Clone for SelfhostLoadedModuleTokensErrorKind:
    fn clone %fn &SelfhostLoadedModuleTokensErrorKind SelfhostLoadedModuleTokensErrorKind \self:
        *self

impl Copy for SelfhostLoadedModuleTokensErrorKind:
    fn copy_mark %fn SelfhostLoadedModuleTokensErrorKind SelfhostLoadedModuleTokensErrorKind \self:
        self

//: selfhost_loaded_module_tokens_lex_error: lexer OOMを通常の構文失敗へ潰さず写像する
fn selfhost_loaded_module_tokens_lex_error %fn LexDiagnostic SelfhostLoadedModuleTokensErrorKind \diag:
    match diag.code:
        SelfhostLexerDiagnosticCode::OutOfMemory: SelfhostLoadedModuleTokensErrorKind::OutOfMemory
        _: SelfhostLoadedModuleTokensErrorKind::LexFailed

//: selfhost_loaded_module_tokens_parse_error: parser OOMを通常の構文失敗へ潰さず写像する
fn selfhost_loaded_module_tokens_parse_error %fn SelfhostDiagnostic SelfhostLoadedModuleTokensErrorKind \diag:
    match diag.code:
        SelfhostDiagnosticCode::Parser code:
            match code:
                SelfhostParserDiagnosticCode::OutOfMemory: SelfhostLoadedModuleTokensErrorKind::OutOfMemory
                _: SelfhostLoadedModuleTokensErrorKind::ParseFailed
        _: SelfhostLoadedModuleTokensErrorKind::ParseFailed

//: selfhost_load_module_tokens: exact-path current VFS source を lex し、tokens と AST を同時所有する
pub fn selfhost_load_module_tokens %impure fn &SelfhostVirtualFileSystem impure fn str Result SelfhostLoadedModuleTokens SelfhostLoadedModuleTokensErrorKind \vfs\path:
    match selfhost_vfs_find_exact vfs path:
        Result::Err e:
            match e:
                SelfhostVfsExactLookupErrorKind::Missing: Result::Err SelfhostLoadedModuleTokensErrorKind::MissingPath
                SelfhostVfsExactLookupErrorKind::Duplicate: Result::Err SelfhostLoadedModuleTokensErrorKind::DuplicatePath
                SelfhostVfsExactLookupErrorKind::FileIdOrdinalMismatch: Result::Err SelfhostLoadedModuleTokensErrorKind::FileIdOrdinalMismatch
        Result::Ok file:
            match lex_all_with_file_id file.source file.file_id:
                Result::Err diag: Result::Err selfhost_loaded_module_tokens_lex_error diag
                Result::Ok tokens:
                    match selfhost_parse_module_tokens file.source &tokens:
                        Result::Err diag:
                            v::free tokens
                            Result::Err selfhost_loaded_module_tokens_parse_error diag
                        Result::Ok ast:
                            Result::Ok SelfhostLoadedModuleTokens file.path file.source file.file_id tokens ast

//: selfhost_loaded_module_tokens_free: token stream と AST buffer を両方解放する
pub fn selfhost_loaded_module_tokens_free %impure fn SelfhostLoadedModuleTokens unit \module:
    v::free field::get module "tokens"
    selfhost_module_ast_free field::get module "ast"

//: selfhost_loaded_module_tokens_tokens: ownerの寿命内でtoken streamを借用する
pub fn selfhost_loaded_module_tokens_tokens %fn &SelfhostLoadedModuleTokens &Vec SelfhostToken \module:
    field::get_ref module "tokens"

//: selfhost_loader_file_not_found_diag: VFS lookup 失敗 diagnostic を[作/つく]る
pub fn selfhost_loader_file_not_found_diag %fn str SelfhostDiagnostic \path:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Loader SelfhostLoaderDiagnosticCode::FileNotFound "source file is not registered in self-host VFS"
    selfhost_diag_with_note diag path

//: selfhost_load_module: VFS の path を parse 済み module として[読/よ]む
//:
//: [目的/もくてき]:
//: - module loading stage の基本単位として、logical path を AST に変換します。
//: - filesystem error、missing source、parser error をすべて diagnostic として扱えるようにします。
pub fn selfhost_load_module %impure fn &SelfhostVirtualFileSystem impure fn str Result SelfhostLoadedModule SelfhostDiagnostic \vfs\path:
    match selfhost_vfs_find vfs path:
        Option::Some file:
            match selfhost_parse_module_source_with_file_id file.source file.file_id:
                Result::Ok ast:
                    Result::Ok SelfhostLoadedModule file.path ast
                Result::Err diag:
                    Result::Err diag
        Option::None:
            Result::Err selfhost_loader_file_not_found_diag path

//: selfhost_loaded_module_ast: loaded module の AST を[参照/さんしょう]する
pub fn selfhost_loaded_module_ast %fn &SelfhostLoadedModule &SelfhostModuleAst \module:
    field::get_ref module "ast"

//: selfhost_loaded_module_path: loaded module の logical path を[返/かえ]す
pub fn selfhost_loaded_module_path %fn &SelfhostLoadedModule str \module:
    *field::get_ref module "path"

//: selfhost_loaded_module_free: loaded module が所有する AST buffer を[解放/かいほう]する
pub fn selfhost_loaded_module_free %impure fn SelfhostLoadedModule unit \module:
    selfhost_module_ast_free field::get module "ast"

//: selfhost_loader_stage0: VFS から parser までの smoke API
pub fn selfhost_loader_stage0 %impure fn void i32 \void:
    match selfhost_vfs_new:
        Result::Ok vfs0:
            match selfhost_vfs_add vfs0 "main.nepl" "fn main %fn void i32 \\void:\n    0\n":
                Result::Ok vfs1:
                    match selfhost_load_module &vfs1 "main.nepl":
                        Result::Ok loaded:
                            let ast_ref %&SelfhostModuleAst selfhost_loaded_module_ast &loaded
                            let n %i32 selfhost_module_ast_len ast_ref
                            selfhost_loaded_module_free loaded
                            selfhost_vfs_free vfs1
                            if eq n 1 0 1
                        Result::Err _diag:
                            selfhost_vfs_free vfs1
                            1
                Result::Err _e:
                    1
        Result::Err _e:
            1
