    selfhost_proof_query_new proof_fact obligation

//: selfhost_proof_borrow_access: borrow request が state で許可されるか typed result として[返/かえ]す
pub fn selfhost_proof_borrow_access %fn SelfhostBorrowState fn SelfhostBorrowAccessFact Result SelfhostBorrowState SelfhostProofRefutation \state\fact:
    let query %SelfhostProofQuery selfhost_proof_query_borrow_access state fact
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::ResourceBorrowAccess next_state:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::LifetimeOutlives _lifetime:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceCellTransition _state:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::OwnerTransition _state:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<SelfhostBorrowState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostBorrowState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_lifetime_outlives: lifetime outlives query を[作/つく]る
fn selfhost_proof_query_lifetime_outlives %fn SelfhostLifetimeId fn SelfhostLifetimeOutlivesFact SelfhostProofQuery \required\fact:
    let proof_fact %SelfhostProofFact SelfhostProofFact::LifetimeOutlivesObserved fact
    let obligation %SelfhostProofObligation SelfhostProofObligation::LifetimeOutlives required
    selfhost_proof_query_new proof_fact obligation

//: selfhost_proof_lifetime_outlives: subject lifetime が required lifetime を outlive するか typed result として[返/かえ]す
pub fn selfhost_proof_lifetime_outlives %fn SelfhostLifetimeId fn SelfhostLifetimeOutlivesFact Result SelfhostLifetimeRelation SelfhostProofRefutation \required\fact:
    let query %SelfhostProofQuery selfhost_proof_query_lifetime_outlives required fact
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::LifetimeOutlives relation:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Ok relation
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceCellTransition _state:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::OwnerTransition _state:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceBorrowAccess _state:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostLifetimeRelation,SelfhostProofRefutation>::Err refutation
