#indent 4

//: # proof/api/resource
//: resource / owner / borrow / lifetime proof API wrapper を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - メモリ安全に関わる proof result を typed evidence / refutation として projection します。

#import "core/result" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/proof/query" as *
#import "neplg2/core/proof/solver" as *
#import "neplg2/core/resource/borrow_state" as *
#import "neplg2/core/resource/lifetime" as *
#import "neplg2/core/resource/init/cell" as *
#import "neplg2/core/resource/owner" as *

//: selfhost_proof_query_resource_cell_transition: Resource cell transition query を[作/つく]る
fn selfhost_proof_query_resource_cell_transition %fn SelfhostResourceCellState fn SelfhostResourceCellEventFact SelfhostProofQuery \state\event_fact:
    let proof_fact %SelfhostProofFact SelfhostProofFact::ResourceCellEventObserved event_fact
    let obligation %SelfhostProofObligation SelfhostProofObligation::ResourceCellTransition state
    selfhost_proof_query_new proof_fact obligation

//: selfhost_proof_resource_cell_transition: Resource cell transition の evidence を next state として[返/かえ]す
//:
//: [目的/もくてき]:
//: - initialized / moved / dropped の state machine を Resource domain の proof obligation として通します。
//: - caller は typed refutation を match し、diagnostic は proof solver 外で生成します。
pub fn selfhost_proof_resource_cell_transition %fn SelfhostResourceCellState fn SelfhostResourceCellEventFact Result SelfhostResourceCellState SelfhostProofRefutation \state\event_fact:
    let query %SelfhostProofQuery selfhost_proof_query_resource_cell_transition state event_fact
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::ResourceCellTransition next_state:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::LifetimeOutlives _lifetime:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::OwnerTransition _state:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceBorrowAccess _state:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostResourceCellState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_owner_transition: free obligation owner transition query を[作/つく]る
fn selfhost_proof_query_owner_transition %fn SelfhostOwnerState fn SelfhostOwnerEventFact SelfhostProofQuery \state\fact:
    let proof_fact %SelfhostProofFact SelfhostProofFact::OwnerEventObserved fact
    let obligation %SelfhostProofObligation SelfhostProofObligation::OwnerTransition state
    selfhost_proof_query_new proof_fact obligation

//: selfhost_proof_owner_transition: owner event が state で許可されるか typed result として[返/かえ]す
pub fn selfhost_proof_owner_transition %fn SelfhostOwnerState fn SelfhostOwnerEventFact Result SelfhostOwnerState SelfhostProofRefutation \state\fact:
    let query %SelfhostProofQuery selfhost_proof_query_owner_transition state fact
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::OwnerTransition next_state:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::LifetimeOutlives _lifetime:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceCellTransition _state:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::ResourceBorrowAccess _state:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<SelfhostOwnerState,SelfhostProofRefutation>::Err selfhost_proof_query_unexpected_evidence_refutation query evidence
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostOwnerState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_borrow_access: Resource borrow access query を[作/つく]る
fn selfhost_proof_query_borrow_access %fn SelfhostBorrowState fn SelfhostBorrowAccessFact SelfhostProofQuery \state\fact:
    let proof_fact %SelfhostProofFact SelfhostProofFact::BorrowAccessObserved fact
