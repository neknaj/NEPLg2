#indent 4

//: # proof/api
//: self-host proof solver の public typed API です。
//:
//: [目的/もくてき]:
//: - caller が直接 fact / obligation を組み立てなくても、domain ごとの型付き wrapper から汎用 proof solver を呼び出せるようにします。
//: - 証明規則そのものは `proof/solver` に閉じ込め、この module は query builder と result projection だけを担当します。
//:
//: [設計/せっけい]:
//: - すべての wrapper は `selfhost_proof_solve` を経由し、checker-local な証明器や stdlib allowlist を作りません。
//: - evidence の取り出しは enum の exhaustive match で行い、違う evidence が返った場合は typed mismatch refutation に戻します。

#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/proof/query" as *
#import "neplg2/core/proof/solver" as *
#import "neplg2/core/resource/borrow_state" as *
#import "neplg2/core/resource/lifetime" as *
#import "neplg2/core/resource/move_state" as *
#import "neplg2/core/resource/owner" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/trait_ref" as *
#import "neplg2/core/ty/ty" as *

//: selfhost_proof_query_source_span_valid: source span validity query を[作/つく]る
fn selfhost_proof_query_source_span_valid <(SelfhostSourceSpan)->SelfhostProofQuery> (span):
    let fact <SelfhostProofFact> SelfhostProofFact::SourceSpanObserved selfhost_source_span_fact_new span
    let obligation <SelfhostProofObligation> SelfhostProofObligation::SourceSpanValid span
    selfhost_proof_query_new fact obligation

//: selfhost_proof_source_span_valid: source span validity の typed result を[返/かえ]す
pub fn selfhost_proof_source_span_valid <(SelfhostSourceSpan)->Result<(),SelfhostProofRefutation>> (span):
    let query <SelfhostProofQuery> selfhost_proof_query_source_span_valid span
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::SourceSpanValid:
                    Result<(),SelfhostProofRefutation>::Ok ()
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::LifetimeOutlives _lifetime:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ResourceCellTransition _state:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::OwnerTransition _state:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ResourceBorrowAccess _state:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<(),SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
        SelfhostProofResult::Refuted refutation:
            Result<(),SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_raw_backend_transition: raw backend transition query を[作/つく]る
fn selfhost_proof_query_raw_backend_transition <(SelfhostRawBackendState,SelfhostRawBackendItemFact)->SelfhostProofQuery> (state, item):
    let fact <SelfhostProofFact> SelfhostProofFact::RawBackendItemObserved item
    let obligation <SelfhostProofObligation> SelfhostProofObligation::RawBackendTransition state
    selfhost_proof_query_new fact obligation

//: selfhost_proof_raw_backend_transition: raw backend transition の evidence を next state として[取/と]り[出/だ]す
pub fn selfhost_proof_raw_backend_transition <(SelfhostRawBackendState,SelfhostRawBackendItemFact)->Result<SelfhostRawBackendState,SelfhostProofRefutation>> (state, item):
    let query <SelfhostProofQuery> selfhost_proof_query_raw_backend_transition state item
    match selfhost_proof_solve query:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::RawBackendTransition next_state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::TypeKindCompatible _kind:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::TraitImplNonOverlapping _relation:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::LifetimeOutlives _lifetime:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ResourceCellTransition _state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::OwnerTransition _state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::ResourceBorrowAccess _state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
                SelfhostProofEvidence::EffectAllowed _context:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err selfhost_proof_query_mismatch_refutation query
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_module_directive_transition: module directive transition query を[作/つく]る
fn selfhost_proof_query_module_directive_transition <(SelfhostModuleDirectiveState,SelfhostModuleDirectiveFact)->SelfhostProofQuery> (state, item):
