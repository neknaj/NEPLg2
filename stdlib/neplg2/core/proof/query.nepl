    AcquireAfterRelease
    MoveWithoutOwner
    MoveAfterMove
    MoveAfterRelease
    ReleaseWithoutOwner
    ReleaseAfterMove
    ReleaseAfterRelease
    ViewWithoutOwner
    ViewAfterMove
    ViewAfterRelease

impl Clone for SelfhostOwnerTransitionError:
    fn clone <(&SelfhostOwnerTransitionError)->SelfhostOwnerTransitionError> (self):
        *self

impl Copy for SelfhostOwnerTransitionError:
    fn copy_mark <(SelfhostOwnerTransitionError)->SelfhostOwnerTransitionError> (self):
        self

