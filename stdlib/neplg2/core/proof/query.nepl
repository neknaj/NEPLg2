#indent 4

//: # proof/query
//: fact と obligation を solver に渡す query と、その[結果/けっか]を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - proof engine の public boundary を `SelfhostProofQuery -> SelfhostProofResult` に[揃/そろ]えます。
//: - result は自由文字列ではなく、成功 evidence または失敗 refutation の enum payload として[保持/ほじ]します。

#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/resource/move_state" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostProofEvidence: proof が[成立/せいりつ]したときに返す typed evidence
//:
//: [目的/もくてき]:
//: - 成功した proof が何を証明したかを enum payload として残し、caller が証明の種類を match で確認できるようにします。
pub enum SelfhostProofEvidence:
    SourceSpanValid
    RawBackendTransition <SelfhostRawBackendState>
    ModuleDirectiveTransition <SelfhostModuleDirectiveState>
    ModuleDeclarationHeaderAvailable <SelfhostModuleDeclarationHeader>
    TypeKindCompatible <SelfhostTypeKind>
    ResourceCellTransition <SelfhostResourceCellState>
    EffectAllowed <SelfhostEffectContext>

impl Clone for SelfhostProofEvidence:
    fn clone <(&SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        *self

impl Copy for SelfhostProofEvidence:
    fn copy_mark <(SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        self

//: SelfhostModuleDirectiveDuplicate: singleton directive が[重複/ちょうふく]した refutation payload
//:
//: [目的/もくてき]:
//: - 重複した directive の kind、最初の span、重複した span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で作り、proof solver は文字列 code に依存しません。
pub struct SelfhostModuleDirectiveDuplicate:
    kind <SelfhostModuleDirectiveKind>
    first_span <SelfhostSourceSpan>
    duplicate_span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDirectiveDuplicate:
    fn clone <(&SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        *self

impl Copy for SelfhostModuleDirectiveDuplicate:
    fn copy_mark <(SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        self

//: selfhost_module_directive_duplicate_new: duplicate directive refutation payload を[作/つく]る
pub fn selfhost_module_directive_duplicate_new <(SelfhostModuleDirectiveKind,SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostModuleDirectiveDuplicate> (kind, first_span, duplicate_span):
    SelfhostModuleDirectiveDuplicate kind first_span duplicate_span

//: SelfhostModuleDeclarationHeaderIssue: declaration header proof の refutation payload
//:
//: [目的/もくてき]:
//: - 欠落または不正な declaration header を、自由文字列ではなく declaration kind と span の組として保持します。
pub struct SelfhostModuleDeclarationHeaderIssue:
    kind <SelfhostModuleDeclarationKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDeclarationHeaderIssue:
    fn clone <(&SelfhostModuleDeclarationHeaderIssue)->SelfhostModuleDeclarationHeaderIssue> (self):
        *self

impl Copy for SelfhostModuleDeclarationHeaderIssue:
    fn copy_mark <(SelfhostModuleDeclarationHeaderIssue)->SelfhostModuleDeclarationHeaderIssue> (self):
        self

//: selfhost_module_declaration_header_issue_new: declaration header issue payload を[作/つく]る
pub fn selfhost_module_declaration_header_issue_new <(SelfhostModuleDeclarationKind,SelfhostSourceSpan)->SelfhostModuleDeclarationHeaderIssue> (kind, span):
    SelfhostModuleDeclarationHeaderIssue kind span

//: SelfhostResourceCellTransitionError: Resource cell state transition の失敗分類
//:
//: [目的/もくてき]:
//: - uninitialized move、move 後の再 move、double drop などを自由文字列ではなく enum として表します。
pub enum SelfhostResourceCellTransitionError:
    InitializeAlreadyInitialized
    InitializeAfterDrop
    MoveUninitialized
    MoveAfterMove
    MoveAfterDrop
    DropUninitialized
    DropAfterMove
    DoubleDrop

impl Clone for SelfhostResourceCellTransitionError:
    fn clone <(&SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionError> (self):
        *self

impl Copy for SelfhostResourceCellTransitionError:
    fn copy_mark <(SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionError> (self):
        self

//: SelfhostResourceCellTransitionIssue: 不正な Resource cell transition の refutation payload
//:
//: [目的/もくてき]:
//: - 失敗時の元 state、event、span、理由を typed value として保持し、diagnostic は caller 境界で生成できるようにします。
pub struct SelfhostResourceCellTransitionIssue:
    state <SelfhostResourceCellState>
    event <SelfhostResourceCellEventKind>
    span <SelfhostSourceSpan>
    reason <SelfhostResourceCellTransitionError>

impl Clone for SelfhostResourceCellTransitionIssue:
    fn clone <(&SelfhostResourceCellTransitionIssue)->SelfhostResourceCellTransitionIssue> (self):
        *self

impl Copy for SelfhostResourceCellTransitionIssue:
    fn copy_mark <(SelfhostResourceCellTransitionIssue)->SelfhostResourceCellTransitionIssue> (self):
        self

//: selfhost_resource_cell_transition_issue_new: Resource cell transition issue payload を[作/つく]る
pub fn selfhost_resource_cell_transition_issue_new <(SelfhostResourceCellState,SelfhostResourceCellEventKind,SelfhostSourceSpan,SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionIssue> (state, event, span, reason):
    SelfhostResourceCellTransitionIssue state event span reason

//: SelfhostEffectBoundaryError: effect boundary proof の失敗分類
//:
//: [目的/もくてき]:
//: - pure context の impure effect、unsafe boundary 外の unsafe memory、no-escape 未証明の internal allocation を typed reason として表します。
pub enum SelfhostEffectBoundaryError:
    ImpureEffectInPureContext
    UnsafeMemoryOutsideBoundary
    InternalAllocEscapeNotProven

impl Clone for SelfhostEffectBoundaryError:
    fn clone <(&SelfhostEffectBoundaryError)->SelfhostEffectBoundaryError> (self):
        *self

impl Copy for SelfhostEffectBoundaryError:
    fn copy_mark <(SelfhostEffectBoundaryError)->SelfhostEffectBoundaryError> (self):
        self

//: SelfhostEffectBoundaryIssue: 不正な effect boundary の refutation payload
pub struct SelfhostEffectBoundaryIssue:
    effect <SelfhostEffectKind>
    escape <SelfhostEffectEscapeState>
    context <SelfhostEffectContext>
    span <SelfhostSourceSpan>
    reason <SelfhostEffectBoundaryError>

impl Clone for SelfhostEffectBoundaryIssue:
    fn clone <(&SelfhostEffectBoundaryIssue)->SelfhostEffectBoundaryIssue> (self):
        *self

impl Copy for SelfhostEffectBoundaryIssue:
    fn copy_mark <(SelfhostEffectBoundaryIssue)->SelfhostEffectBoundaryIssue> (self):
        self

//: selfhost_effect_boundary_issue_new: effect boundary issue payload を[作/つく]る
pub fn selfhost_effect_boundary_issue_new <(SelfhostEffectKind,SelfhostEffectEscapeState,SelfhostEffectContext,SelfhostSourceSpan,SelfhostEffectBoundaryError)->SelfhostEffectBoundaryIssue> (effect, escape, context, span, reason):
    SelfhostEffectBoundaryIssue effect escape context span reason

//: SelfhostTypeKindMismatch: type kind compatibility proof の refutation payload
//:
//: [目的/もくてき]:
//: - 期待 type kind、実際に観測した type kind、source span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で生成し、proof solver は型分類の enum だけを扱います。
pub struct SelfhostTypeKindMismatch:
    expected <SelfhostTypeKind>
    actual <SelfhostTypeKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostTypeKindMismatch:
    fn clone <(&SelfhostTypeKindMismatch)->SelfhostTypeKindMismatch> (self):
        *self

impl Copy for SelfhostTypeKindMismatch:
    fn copy_mark <(SelfhostTypeKindMismatch)->SelfhostTypeKindMismatch> (self):
        self

//: selfhost_type_kind_mismatch_new: type kind mismatch refutation payload を[作/つく]る
pub fn selfhost_type_kind_mismatch_new <(SelfhostTypeKind,SelfhostTypeKind,SelfhostSourceSpan)->SelfhostTypeKindMismatch> (expected, actual, span):
    SelfhostTypeKindMismatch expected actual span

//: SelfhostProofMismatch: fact と obligation の domain が[噛/か]み[合/あ]わない refutation payload
//:
//: [目的/もくてき]:
//: - proof caller や solver の[誤/あやま]った[配線/はいせん]を、単なる失敗ではなく fact domain / obligation domain の組として残します。
//: - type / trait / effect / resource の obligation が増えたときも、どの domain 境界で不整合が起きたかを match で追えるようにします。
pub struct SelfhostProofMismatch:
    fact_domain <SelfhostProofDomain>
    obligation_domain <SelfhostProofDomain>

impl Clone for SelfhostProofMismatch:
    fn clone <(&SelfhostProofMismatch)->SelfhostProofMismatch> (self):
        *self

impl Copy for SelfhostProofMismatch:
    fn copy_mark <(SelfhostProofMismatch)->SelfhostProofMismatch> (self):
        self

//: selfhost_proof_mismatch_new: proof mismatch refutation payload を[作/つく]る
pub fn selfhost_proof_mismatch_new <(SelfhostProofDomain,SelfhostProofDomain)->SelfhostProofMismatch> (fact_domain, obligation_domain):
    SelfhostProofMismatch fact_domain obligation_domain

//: SelfhostProofRefutation: proof が[不成立/ふせいりつ]だった[理由/りゆう]
//:
//: [目的/もくてき]:
//: - proof 失敗を diagnostic 文字列へ直行させず、caller が typed reason を match して domain ごとの diagnostic へ[変換/へんかん]できるようにします。
pub enum SelfhostProofRefutation:
    FactObligationMismatch <SelfhostProofMismatch>
    SourceSpanInvalid <SelfhostSourceSpan>
    RawBackendTextWithoutBlock <SelfhostRawBackendItemFact>
    RawBackendBlockEmpty <SelfhostRawBackendOpenBlock>
    ModuleDirectiveDuplicate <SelfhostModuleDirectiveDuplicate>
    ModuleDeclarationHeaderMissing <SelfhostModuleDeclarationHeaderIssue>
    ModuleDeclarationHeaderInvalid <SelfhostModuleDeclarationHeaderIssue>
    TypeKindMismatch <SelfhostTypeKindMismatch>
    ResourceCellTransitionInvalid <SelfhostResourceCellTransitionIssue>
    EffectBoundaryInvalid <SelfhostEffectBoundaryIssue>

impl Clone for SelfhostProofRefutation:
    fn clone <(&SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        *self

impl Copy for SelfhostProofRefutation:
    fn copy_mark <(SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        self

//: SelfhostProofQuery: 1 つの fact と obligation の[照合/しょうごう] query
//:
//: [注意/ちゅうい]:
//: - 初期実装は single fact query です。複数 fact が必要な type / resource proof では、この型を保持したまま worklist / fact set を追加します。
pub struct SelfhostProofQuery:
    fact <SelfhostProofFact>
    obligation <SelfhostProofObligation>

impl Clone for SelfhostProofQuery:
    fn clone <(&SelfhostProofQuery)->SelfhostProofQuery> (self):
        *self

impl Copy for SelfhostProofQuery:
    fn copy_mark <(SelfhostProofQuery)->SelfhostProofQuery> (self):
        self

//: SelfhostProofResult: proof query の typed result
pub enum SelfhostProofResult:
    Proven <SelfhostProofEvidence>
    Refuted <SelfhostProofRefutation>

impl Clone for SelfhostProofResult:
    fn clone <(&SelfhostProofResult)->SelfhostProofResult> (self):
        *self

impl Copy for SelfhostProofResult:
    fn copy_mark <(SelfhostProofResult)->SelfhostProofResult> (self):
        self

//: selfhost_proof_query_new: proof query を[作/つく]る
pub fn selfhost_proof_query_new <(SelfhostProofFact,SelfhostProofObligation)->SelfhostProofQuery> (fact, obligation):
    SelfhostProofQuery fact obligation

//: selfhost_proof_result_proven: proven result を[作/つく]る
pub fn selfhost_proof_result_proven <(SelfhostProofEvidence)->SelfhostProofResult> (evidence):
    SelfhostProofResult::Proven evidence

//: selfhost_proof_result_refuted: refuted result を[作/つく]る
pub fn selfhost_proof_result_refuted <(SelfhostProofRefutation)->SelfhostProofResult> (refutation):
    SelfhostProofResult::Refuted refutation
