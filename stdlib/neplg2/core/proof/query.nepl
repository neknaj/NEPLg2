#indent 4

//: # proof/query
//: fact と obligation を solver に渡す query と、その[結果/けっか]を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - proof engine の public boundary を `SelfhostProofQuery -> SelfhostProofResult` に[揃/そろ]えます。
//: - result は自由文字列ではなく、成功 evidence または失敗 refutation の enum payload として[保持/ほじ]します。

#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/resource/borrow_state" as *
#import "neplg2/core/resource/lifetime" as *
#import "neplg2/core/resource/move_state" as *
#import "neplg2/core/resource/owner" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/trait_ref" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostProofEvidenceKind: proof success evidence の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - public API wrapper が期待した evidence と実際の evidence の不一致を、fact/obligation mismatch と混同せず typed refutation として返せるようにします。
//: - evidence payload を diagnostic 文字列に潰さず、kind だけを enum として比較・記録します。
pub enum SelfhostProofEvidenceKind:
    SourceSpanValid
    RawBackendTransition
    ModuleDirectiveTransition
    ModuleDeclarationHeaderAvailable
    TypeKindCompatible
    TraitImplNonOverlapping
    LifetimeOutlives
    ResourceCellTransition
    OwnerTransition
    ResourceBorrowAccess
    EffectAllowed

impl Clone for SelfhostProofEvidenceKind:
    fn clone <(&SelfhostProofEvidenceKind)->SelfhostProofEvidenceKind> (self):
        *self

impl Copy for SelfhostProofEvidenceKind:
    fn copy_mark <(SelfhostProofEvidenceKind)->SelfhostProofEvidenceKind> (self):
        self

//: SelfhostProofEvidence: proof が[成立/せいりつ]したときに返す typed evidence
//:
//: [目的/もくてき]:
//: - 成功した proof が何を証明したかを enum payload として残し、caller が証明の種類を match で確認できるようにします。
pub enum SelfhostProofEvidence:
    SourceSpanValid
    RawBackendTransition <SelfhostRawBackendState>
    ModuleDirectiveTransition <SelfhostModuleDirectiveState>
    ModuleDeclarationHeaderAvailable <SelfhostModuleDeclarationHeader>
    TypeKindCompatible <SelfhostTypeKind>
    TraitImplNonOverlapping <SelfhostTraitImplRelation>
    LifetimeOutlives <SelfhostLifetimeRelation>
    ResourceCellTransition <SelfhostResourceCellState>
    OwnerTransition <SelfhostOwnerState>
    ResourceBorrowAccess <SelfhostBorrowState>
    EffectAllowed <SelfhostEffectContext>

impl Clone for SelfhostProofEvidence:
    fn clone <(&SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        *self

impl Copy for SelfhostProofEvidence:
    fn copy_mark <(SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        self

//: selfhost_proof_evidence_kind: evidence から kind を[取/と]り[出/だ]す
//:
//: [目的/もくてき]:
//: - payload を捨てて証明の種類だけを比較するときも、文字列 code ではなく enum の exhaustive match を使います。
pub fn selfhost_proof_evidence_kind <(SelfhostProofEvidence)->SelfhostProofEvidenceKind> (evidence):
    match evidence:
        SelfhostProofEvidence::SourceSpanValid:
            SelfhostProofEvidenceKind::SourceSpanValid
        SelfhostProofEvidence::RawBackendTransition _state:
            SelfhostProofEvidenceKind::RawBackendTransition
        SelfhostProofEvidence::ModuleDirectiveTransition _state:
            SelfhostProofEvidenceKind::ModuleDirectiveTransition
        SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
            SelfhostProofEvidenceKind::ModuleDeclarationHeaderAvailable
        SelfhostProofEvidence::TypeKindCompatible _kind:
            SelfhostProofEvidenceKind::TypeKindCompatible
        SelfhostProofEvidence::TraitImplNonOverlapping _relation:
            SelfhostProofEvidenceKind::TraitImplNonOverlapping
        SelfhostProofEvidence::LifetimeOutlives _relation:
            SelfhostProofEvidenceKind::LifetimeOutlives
        SelfhostProofEvidence::ResourceCellTransition _state:
            SelfhostProofEvidenceKind::ResourceCellTransition
        SelfhostProofEvidence::OwnerTransition _state:
            SelfhostProofEvidenceKind::OwnerTransition
        SelfhostProofEvidence::ResourceBorrowAccess _state:
            SelfhostProofEvidenceKind::ResourceBorrowAccess
        SelfhostProofEvidence::EffectAllowed _context:
            SelfhostProofEvidenceKind::EffectAllowed

//: SelfhostModuleDirectiveDuplicate: singleton directive が[重複/ちょうふく]した refutation payload
//:
//: [目的/もくてき]:
//: - 重複した directive の kind、最初の span、重複した span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で作り、proof solver は文字列 code に依存しません。
pub struct SelfhostModuleDirectiveDuplicate:
    kind <SelfhostModuleDirectiveKind>
    first_span <SelfhostSourceSpan>
    duplicate_span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDirectiveDuplicate:
    fn clone <(&SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        *self

impl Copy for SelfhostModuleDirectiveDuplicate:
    fn copy_mark <(SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        self

//: selfhost_module_directive_duplicate_new: duplicate directive refutation payload を[作/つく]る
pub fn selfhost_module_directive_duplicate_new <(SelfhostModuleDirectiveKind,SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostModuleDirectiveDuplicate> (kind, first_span, duplicate_span):
    SelfhostModuleDirectiveDuplicate kind first_span duplicate_span

//: SelfhostModuleDeclarationHeaderIssue: declaration header proof の refutation payload
//:
//: [目的/もくてき]:
//: - 欠落または不正な declaration header を、自由文字列ではなく declaration kind と span の組として保持します。
pub struct SelfhostModuleDeclarationHeaderIssue:
    kind <SelfhostModuleDeclarationKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDeclarationHeaderIssue:
    fn clone <(&SelfhostModuleDeclarationHeaderIssue)->SelfhostModuleDeclarationHeaderIssue> (self):
        *self

impl Copy for SelfhostModuleDeclarationHeaderIssue:
    fn copy_mark <(SelfhostModuleDeclarationHeaderIssue)->SelfhostModuleDeclarationHeaderIssue> (self):
        self

//: selfhost_module_declaration_header_issue_new: declaration header issue payload を[作/つく]る
pub fn selfhost_module_declaration_header_issue_new <(SelfhostModuleDeclarationKind,SelfhostSourceSpan)->SelfhostModuleDeclarationHeaderIssue> (kind, span):
    SelfhostModuleDeclarationHeaderIssue kind span

//: SelfhostResourceCellTransitionError: Resource cell state transition の失敗分類
//:
//: [目的/もくてき]:
//: - uninitialized move、move 後の再 move、double drop などを自由文字列ではなく enum として表します。
pub enum SelfhostResourceCellTransitionError:
    InitializeAlreadyInitialized
    InitializeAfterDrop
    MoveUninitialized
    MoveAfterMove
    MoveAfterDrop
    DropUninitialized
    DropAfterMove
    DoubleDrop

impl Clone for SelfhostResourceCellTransitionError:
    fn clone <(&SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionError> (self):
        *self

impl Copy for SelfhostResourceCellTransitionError:
    fn copy_mark <(SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionError> (self):
        self

//: SelfhostResourceCellTransitionIssue: 不正な Resource cell transition の refutation payload
//:
//: [目的/もくてき]:
//: - 失敗時の元 state、event、span、理由を typed value として保持し、diagnostic は caller 境界で生成できるようにします。
pub struct SelfhostResourceCellTransitionIssue:
    state <SelfhostResourceCellState>
    event <SelfhostResourceCellEventKind>
    span <SelfhostSourceSpan>
    reason <SelfhostResourceCellTransitionError>

impl Clone for SelfhostResourceCellTransitionIssue:
    fn clone <(&SelfhostResourceCellTransitionIssue)->SelfhostResourceCellTransitionIssue> (self):
