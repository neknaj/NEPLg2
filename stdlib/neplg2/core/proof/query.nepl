#indent 4

//: # proof/query
//: fact と obligation を solver に渡す query と、その[結果/けっか]を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - proof engine の public boundary を `SelfhostProofQuery -> SelfhostProofResult` に[揃/そろ]えます。
//: - result は自由文字列ではなく、成功 evidence または失敗 refutation の enum payload として[保持/ほじ]します。

#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *

//: SelfhostProofEvidence: proof が[成立/せいりつ]したときに返す typed evidence
//:
//: [目的/もくてき]:
//: - 成功した proof が何を証明したかを enum payload として残し、caller が証明の種類を match で確認できるようにします。
pub enum SelfhostProofEvidence:
    SourceSpanValid
    RawBackendTransition <SelfhostRawBackendState>
    ModuleDirectiveTransition <SelfhostModuleDirectiveState>

impl Clone for SelfhostProofEvidence:
    fn clone <(&SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        *self

impl Copy for SelfhostProofEvidence:
    fn copy_mark <(SelfhostProofEvidence)->SelfhostProofEvidence> (self):
        self

//: SelfhostModuleDirectiveDuplicate: singleton directive が[重複/ちょうふく]した refutation payload
//:
//: [目的/もくてき]:
//: - 重複した directive の kind、最初の span、重複した span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で作り、proof solver は文字列 code に依存しません。
pub struct SelfhostModuleDirectiveDuplicate:
    kind <SelfhostModuleDirectiveKind>
    first_span <SelfhostSourceSpan>
    duplicate_span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDirectiveDuplicate:
    fn clone <(&SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        *self

impl Copy for SelfhostModuleDirectiveDuplicate:
    fn copy_mark <(SelfhostModuleDirectiveDuplicate)->SelfhostModuleDirectiveDuplicate> (self):
        self

//: selfhost_module_directive_duplicate_new: duplicate directive refutation payload を[作/つく]る
pub fn selfhost_module_directive_duplicate_new <(SelfhostModuleDirectiveKind,SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostModuleDirectiveDuplicate> (kind, first_span, duplicate_span):
    SelfhostModuleDirectiveDuplicate kind first_span duplicate_span

//: SelfhostProofRefutation: proof が[不成立/ふせいりつ]だった[理由/りゆう]
//:
//: [目的/もくてき]:
//: - proof 失敗を diagnostic 文字列へ直行させず、caller が typed reason を match して domain ごとの diagnostic へ[変換/へんかん]できるようにします。
pub enum SelfhostProofRefutation:
    FactObligationMismatch
    SourceSpanInvalid <SelfhostSourceSpan>
    RawBackendTextWithoutBlock <SelfhostRawBackendItemFact>
    RawBackendBlockEmpty <SelfhostRawBackendOpenBlock>
    ModuleDirectiveDuplicate <SelfhostModuleDirectiveDuplicate>

impl Clone for SelfhostProofRefutation:
    fn clone <(&SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        *self

impl Copy for SelfhostProofRefutation:
    fn copy_mark <(SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        self

//: SelfhostProofQuery: 1 つの fact と obligation の[照合/しょうごう] query
//:
//: [注意/ちゅうい]:
//: - 初期実装は single fact query です。複数 fact が必要な type / resource proof では、この型を保持したまま worklist / fact set を追加します。
pub struct SelfhostProofQuery:
    fact <SelfhostProofFact>
    obligation <SelfhostProofObligation>

impl Clone for SelfhostProofQuery:
    fn clone <(&SelfhostProofQuery)->SelfhostProofQuery> (self):
        *self

impl Copy for SelfhostProofQuery:
    fn copy_mark <(SelfhostProofQuery)->SelfhostProofQuery> (self):
        self

//: SelfhostProofResult: proof query の typed result
pub enum SelfhostProofResult:
    Proven <SelfhostProofEvidence>
    Refuted <SelfhostProofRefutation>

impl Clone for SelfhostProofResult:
    fn clone <(&SelfhostProofResult)->SelfhostProofResult> (self):
        *self

impl Copy for SelfhostProofResult:
    fn copy_mark <(SelfhostProofResult)->SelfhostProofResult> (self):
        self

//: selfhost_proof_query_new: proof query を[作/つく]る
pub fn selfhost_proof_query_new <(SelfhostProofFact,SelfhostProofObligation)->SelfhostProofQuery> (fact, obligation):
    SelfhostProofQuery fact obligation

//: selfhost_proof_result_proven: proven result を[作/つく]る
pub fn selfhost_proof_result_proven <(SelfhostProofEvidence)->SelfhostProofResult> (evidence):
    SelfhostProofResult::Proven evidence

//: selfhost_proof_result_refuted: refuted result を[作/つく]る
pub fn selfhost_proof_result_refuted <(SelfhostProofRefutation)->SelfhostProofResult> (refutation):
    SelfhostProofResult::Refuted refutation

//: selfhost_proof_result_is_proven: proof result が[証明/しょうめい][成功/せいこう]か[返/かえ]す
pub fn selfhost_proof_result_is_proven <(SelfhostProofResult)->bool> (result):
    match result:
        SelfhostProofResult::Proven _evidence:
            true
        SelfhostProofResult::Refuted _refutation:
            false
