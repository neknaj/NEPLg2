pub fn selfhost_effect_boundary_issue_new <(SelfhostEffectKind,SelfhostEffectEscapeState,SelfhostEffectContext,SelfhostSourceSpan,SelfhostEffectBoundaryError)->SelfhostEffectBoundaryIssue> (effect, escape, context, span, reason):
