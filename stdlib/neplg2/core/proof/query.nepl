//: - pure context の impure effect、unsafe boundary 外の unsafe memory、no-escape 未証明の internal allocation を typed reason として表します。
pub enum SelfhostEffectBoundaryError:
    ImpureEffectInPureContext
    UnsafeMemoryOutsideBoundary
    InternalAllocEscapeNotProven

impl Clone for SelfhostEffectBoundaryError:
    fn clone <(&SelfhostEffectBoundaryError)->SelfhostEffectBoundaryError> (self):
        *self

impl Copy for SelfhostEffectBoundaryError:
    fn copy_mark <(SelfhostEffectBoundaryError)->SelfhostEffectBoundaryError> (self):
        self

