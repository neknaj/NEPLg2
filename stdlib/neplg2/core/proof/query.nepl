impl Copy for SelfhostResourceCellTransitionIssue:
    fn copy_mark <(SelfhostResourceCellTransitionIssue)->SelfhostResourceCellTransitionIssue> (self):
        self

//: selfhost_resource_cell_transition_issue_new: Resource cell transition issue payload を[作/つく]る
pub fn selfhost_resource_cell_transition_issue_new <(SelfhostResourceCellState,SelfhostResourceCellEventKind,SelfhostSourceSpan,SelfhostResourceCellTransitionError)->SelfhostResourceCellTransitionIssue> (state, event, span, reason):
    SelfhostResourceCellTransitionIssue state event span reason

