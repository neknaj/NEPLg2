pub struct SelfhostEffectBoundaryIssue:
    effect <SelfhostEffectKind>
    escape <SelfhostEffectEscapeState>
    context <SelfhostEffectContext>
    span <SelfhostSourceSpan>
    reason <SelfhostEffectBoundaryError>

impl Clone for SelfhostEffectBoundaryIssue:
    fn clone <(&SelfhostEffectBoundaryIssue)->SelfhostEffectBoundaryIssue> (self):
        *self

impl Copy for SelfhostEffectBoundaryIssue:
    fn copy_mark <(SelfhostEffectBoundaryIssue)->SelfhostEffectBoundaryIssue> (self):
        self

