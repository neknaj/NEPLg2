//: selfhost_owner_transition_issue_new: owner transition issue payload を[作/つく]る
pub fn selfhost_owner_transition_issue_new <(SelfhostOwnerState,SelfhostOwnerEventKind,SelfhostOwnerStorageId,SelfhostSourceSpan,SelfhostOwnerTransitionError)->SelfhostOwnerTransitionIssue> (state, event, storage, span, reason):
