//: SelfhostTypeKindMismatch: type kind compatibility proof の refutation payload
//:
//: [目的/もくてき]:
//: - 期待 type kind、実際に観測した type kind、source span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で生成し、proof solver は型分類の enum だけを扱います。
pub struct SelfhostTypeKindMismatch:
    expected <SelfhostTypeKind>
    actual <SelfhostTypeKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostTypeKindMismatch:
    fn clone <(&SelfhostTypeKindMismatch)->SelfhostTypeKindMismatch> (self):
        *self

impl Copy for SelfhostTypeKindMismatch:
    fn copy_mark <(SelfhostTypeKindMismatch)->SelfhostTypeKindMismatch> (self):
        self

//: selfhost_type_kind_mismatch_new: type kind mismatch refutation payload を[作/つく]る
pub fn selfhost_type_kind_mismatch_new <(SelfhostTypeKind,SelfhostTypeKind,SelfhostSourceSpan)->SelfhostTypeKindMismatch> (expected, actual, span):
    SelfhostTypeKindMismatch expected actual span

//: SelfhostTraitImplCoherenceError: trait impl coherence proof の失敗分類
//:
//: [目的/もくてき]:
//: - duplicate impl と invalid key を typed reason として分け、diagnostic 生成を proof solver 外へ分離します。
pub enum SelfhostTraitImplCoherenceError:
    DuplicateImpl
    InvalidCandidateKey
    InvalidExistingKey

impl Clone for SelfhostTraitImplCoherenceError:
    fn clone <(&SelfhostTraitImplCoherenceError)->SelfhostTraitImplCoherenceError> (self):
        *self

impl Copy for SelfhostTraitImplCoherenceError:
    fn copy_mark <(SelfhostTraitImplCoherenceError)->SelfhostTraitImplCoherenceError> (self):
        self

//: SelfhostTraitImplCoherenceIssue: 不正な trait impl coherence の refutation payload
pub struct SelfhostTraitImplCoherenceIssue:
    candidate <SelfhostTraitImplKey>
    existing <SelfhostTraitImplKey>
    relation <SelfhostTraitImplRelation>
    span <SelfhostSourceSpan>
    reason <SelfhostTraitImplCoherenceError>

impl Clone for SelfhostTraitImplCoherenceIssue:
    fn clone <(&SelfhostTraitImplCoherenceIssue)->SelfhostTraitImplCoherenceIssue> (self):
        *self

impl Copy for SelfhostTraitImplCoherenceIssue:
    fn copy_mark <(SelfhostTraitImplCoherenceIssue)->SelfhostTraitImplCoherenceIssue> (self):
        self

//: selfhost_trait_impl_coherence_issue_new: trait impl coherence issue payload を[作/つく]る
pub fn selfhost_trait_impl_coherence_issue_new <(SelfhostTraitImplKey,SelfhostTraitImplKey,SelfhostTraitImplRelation,SelfhostSourceSpan,SelfhostTraitImplCoherenceError)->SelfhostTraitImplCoherenceIssue> (candidate, existing, relation, span, reason):
    SelfhostTraitImplCoherenceIssue candidate existing relation span reason

//: SelfhostProofMismatch: fact と obligation の domain が[噛/か]み[合/あ]わない refutation payload
//:
//: [目的/もくてき]:
//: - proof caller や solver の[誤/あやま]った[配線/はいせん]を、単なる失敗ではなく fact domain / obligation domain の組として残します。
//: - type / trait / effect / resource の obligation が増えたときも、どの domain 境界で不整合が起きたかを match で追えるようにします。
pub struct SelfhostProofMismatch:
    fact_domain <SelfhostProofDomain>
    obligation_domain <SelfhostProofDomain>

impl Clone for SelfhostProofMismatch:
    fn clone <(&SelfhostProofMismatch)->SelfhostProofMismatch> (self):
        *self

impl Copy for SelfhostProofMismatch:
    fn copy_mark <(SelfhostProofMismatch)->SelfhostProofMismatch> (self):
        self

//: selfhost_proof_mismatch_new: proof mismatch refutation payload を[作/つく]る
pub fn selfhost_proof_mismatch_new <(SelfhostProofDomain,SelfhostProofDomain)->SelfhostProofMismatch> (fact_domain, obligation_domain):
    SelfhostProofMismatch fact_domain obligation_domain

//: SelfhostProofUnexpectedEvidence: API wrapper が期待しない evidence を受け取った refutation payload
//:
//: [目的/もくてき]:
//: - fact と obligation の domain は合っているのに solver が違う success evidence を返した場合を、domain mismatch とは別に記録します。
//: - これは solver implementation の誤配線を検出するための payload であり、expected / actual を enum kind として保持します。
pub struct SelfhostProofUnexpectedEvidence:
    expected <SelfhostProofEvidenceKind>
    actual <SelfhostProofEvidenceKind>

impl Clone for SelfhostProofUnexpectedEvidence:
    fn clone <(&SelfhostProofUnexpectedEvidence)->SelfhostProofUnexpectedEvidence> (self):
        *self

impl Copy for SelfhostProofUnexpectedEvidence:
    fn copy_mark <(SelfhostProofUnexpectedEvidence)->SelfhostProofUnexpectedEvidence> (self):
        self

//: selfhost_proof_unexpected_evidence_new: unexpected evidence payload を[作/つく]る
pub fn selfhost_proof_unexpected_evidence_new <(SelfhostProofEvidenceKind,SelfhostProofEvidenceKind)->SelfhostProofUnexpectedEvidence> (expected, actual):
    SelfhostProofUnexpectedEvidence expected actual

//: SelfhostProofRefutation: proof が[不成立/ふせいりつ]だった[理由/りゆう]
//:
//: [目的/もくてき]:
//: - proof 失敗を diagnostic 文字列へ直行させず、caller が typed reason を match して domain ごとの diagnostic へ[変換/へんかん]できるようにします。
pub enum SelfhostProofRefutation:
    FactObligationMismatch <SelfhostProofMismatch>
    UnexpectedEvidence <SelfhostProofUnexpectedEvidence>
    SourceSpanInvalid <SelfhostSourceSpan>
    RawBackendTextWithoutBlock <SelfhostRawBackendItemFact>
    RawBackendBlockEmpty <SelfhostRawBackendOpenBlock>
    ModuleDirectiveDuplicate <SelfhostModuleDirectiveDuplicate>
    ModuleDeclarationHeaderMissing <SelfhostModuleDeclarationHeaderIssue>
    ModuleDeclarationHeaderInvalid <SelfhostModuleDeclarationHeaderIssue>
    TypeKindMismatch <SelfhostTypeKindMismatch>
    TraitImplCoherenceInvalid <SelfhostTraitImplCoherenceIssue>
    LifetimeOutlivesInvalid <SelfhostLifetimeOutlivesIssue>
    ResourceCellTransitionInvalid <SelfhostResourceCellTransitionIssue>
    OwnerTransitionInvalid <SelfhostOwnerTransitionIssue>
    BorrowAccessInvalid <SelfhostBorrowAccessIssue>
    EffectBoundaryInvalid <SelfhostEffectBoundaryIssue>

impl Clone for SelfhostProofRefutation:
    fn clone <(&SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        *self

impl Copy for SelfhostProofRefutation:
    fn copy_mark <(SelfhostProofRefutation)->SelfhostProofRefutation> (self):
        self

//: SelfhostProofQuery: 1 つの fact と obligation の[照合/しょうごう] query
//:
//: [注意/ちゅうい]:
//: - 初期実装は single fact query です。複数 fact が必要な type / resource proof では、この型を保持したまま worklist / fact set を追加します。
pub struct SelfhostProofQuery:
    fact <SelfhostProofFact>
    obligation <SelfhostProofObligation>

impl Clone for SelfhostProofQuery:
    fn clone <(&SelfhostProofQuery)->SelfhostProofQuery> (self):
        *self

impl Copy for SelfhostProofQuery:
    fn copy_mark <(SelfhostProofQuery)->SelfhostProofQuery> (self):
        self

//: SelfhostProofResult: proof query の typed result
pub enum SelfhostProofResult:
    Proven <SelfhostProofEvidence>
    Refuted <SelfhostProofRefutation>

impl Clone for SelfhostProofResult:
    fn clone <(&SelfhostProofResult)->SelfhostProofResult> (self):
        *self

impl Copy for SelfhostProofResult:
    fn copy_mark <(SelfhostProofResult)->SelfhostProofResult> (self):
        self

//: selfhost_proof_query_new: proof query を[作/つく]る
pub fn selfhost_proof_query_new <(SelfhostProofFact,SelfhostProofObligation)->SelfhostProofQuery> (fact, obligation):
    SelfhostProofQuery fact obligation

//: selfhost_proof_obligation_evidence_kind: obligation が期待する evidence kind を[返/かえ]す
//:
//: [目的/もくてき]:
//: - API wrapper が evidence projection に失敗したとき、期待した kind を obligation enum から導出します。
//: - wrapper ごとの手書き文字列や数値 code を置かず、obligation 追加時に match の網羅性で更新漏れを検出しやすくします。
pub fn selfhost_proof_obligation_evidence_kind <(SelfhostProofObligation)->SelfhostProofEvidenceKind> (obligation):
    match obligation:
        SelfhostProofObligation::SourceSpanValid _span:
            SelfhostProofEvidenceKind::SourceSpanValid
        SelfhostProofObligation::RawBackendTransition _state:
            SelfhostProofEvidenceKind::RawBackendTransition
        SelfhostProofObligation::ModuleDirectiveTransition _state:
            SelfhostProofEvidenceKind::ModuleDirectiveTransition
        SelfhostProofObligation::ModuleDeclarationHeaderAvailable _kind:
            SelfhostProofEvidenceKind::ModuleDeclarationHeaderAvailable
        SelfhostProofObligation::TypeKindCompatible _kind:
            SelfhostProofEvidenceKind::TypeKindCompatible
        SelfhostProofObligation::TraitImplNonOverlapping:
            SelfhostProofEvidenceKind::TraitImplNonOverlapping
        SelfhostProofObligation::LifetimeOutlives _required:
            SelfhostProofEvidenceKind::LifetimeOutlives
        SelfhostProofObligation::ResourceCellTransition _state:
            SelfhostProofEvidenceKind::ResourceCellTransition
        SelfhostProofObligation::OwnerTransition _state:
            SelfhostProofEvidenceKind::OwnerTransition
        SelfhostProofObligation::ResourceBorrowAccess _state:
            SelfhostProofEvidenceKind::ResourceBorrowAccess
        SelfhostProofObligation::EffectAllowedInContext _context:
            SelfhostProofEvidenceKind::EffectAllowed

//: selfhost_proof_result_proven: proven result を[作/つく]る
pub fn selfhost_proof_result_proven <(SelfhostProofEvidence)->SelfhostProofResult> (evidence):
    SelfhostProofResult::Proven evidence

//: selfhost_proof_result_refuted: refuted result を[作/つく]る
pub fn selfhost_proof_result_refuted <(SelfhostProofRefutation)->SelfhostProofResult> (refutation):
    SelfhostProofResult::Refuted refutation

//: selfhost_proof_mismatch_refutation: fact / obligation domain の不整合を typed refutation にする
//:
//: [目的/もくてき]:
//: - solver と public API wrapper のどちらでも同じ mismatch payload を使い、証明境界の配線誤りを domain enum の組として残します。
//: - 文字列 code ではなく `SelfhostProofDomain` を導出するため、fact / obligation variant の追加時にも match の網羅性で追跡できます。
pub fn selfhost_proof_mismatch_refutation <(SelfhostProofFact,SelfhostProofObligation)->SelfhostProofRefutation> (fact, obligation):
    SelfhostProofRefutation::FactObligationMismatch selfhost_proof_mismatch_new selfhost_proof_fact_domain fact selfhost_proof_obligation_domain obligation

//: selfhost_proof_query_mismatch_refutation: query の fact / obligation domain 不整合を typed refutation にする
pub fn selfhost_proof_query_mismatch_refutation <(SelfhostProofQuery)->SelfhostProofRefutation> (query):
    selfhost_proof_mismatch_refutation query.fact query.obligation

//: selfhost_proof_query_mismatch_result: query の不整合を proof result として返す
pub fn selfhost_proof_query_mismatch_result <(SelfhostProofQuery)->SelfhostProofResult> (query):
    selfhost_proof_result_refuted selfhost_proof_query_mismatch_refutation query

//: selfhost_proof_unexpected_evidence_refutation: obligation と evidence の kind 不一致を typed refutation にする
//:
//: [目的/もくてき]:
//: - solver が domain の合う query に対して別種の success evidence を返したとき、domain mismatch ではなく proof-program error として分類します。
pub fn selfhost_proof_unexpected_evidence_refutation <(SelfhostProofObligation,SelfhostProofEvidence)->SelfhostProofRefutation> (obligation, evidence):
    let expected <SelfhostProofEvidenceKind> selfhost_proof_obligation_evidence_kind obligation
    let actual <SelfhostProofEvidenceKind> selfhost_proof_evidence_kind evidence
    SelfhostProofRefutation::UnexpectedEvidence selfhost_proof_unexpected_evidence_new expected actual

//: selfhost_proof_query_unexpected_evidence_refutation: query と evidence の kind 不一致を typed refutation にする
pub fn selfhost_proof_query_unexpected_evidence_refutation <(SelfhostProofQuery,SelfhostProofEvidence)->SelfhostProofRefutation> (query, evidence):
    selfhost_proof_unexpected_evidence_refutation query.obligation evidence
