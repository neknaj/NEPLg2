#indent 4

//: # proof/solver/module
//: module raw/directive/declaration の proof rule を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - module stream の raw backend、singleton directive、declaration header を同じ query/result 境界で証明します。
//: - module checker へ個別 state machine を戻さず、typed obligation を solver rule へ渡します。

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/proof/query" as *
#import "neplg2/core/syntax/ast/module_ast" as *

//: selfhost_raw_backend_text_matches: raw text item が open backend と[一致/いっち]するか[返/かえ]す
fn selfhost_raw_backend_text_matches %fn SelfhostRawBackendKind fn SelfhostRawBackendItemFact bool \open_kind\item:
    match open_kind:
        SelfhostRawBackendKind::Wasm:
            match item.kind:
                SelfhostRawBackendItemKind::WasmText:
                    true
                SelfhostRawBackendItemKind::LlvmIrText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false
        SelfhostRawBackendKind::LlvmIr:
            match item.kind:
                SelfhostRawBackendItemKind::LlvmIrText:
                    true
                SelfhostRawBackendItemKind::WasmText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false

//: selfhost_proof_raw_backend_proven: raw backend next state evidence を[返/かえ]す
fn selfhost_proof_raw_backend_proven %fn SelfhostRawBackendState SelfhostProofResult \state:
    selfhost_proof_result_proven SelfhostProofEvidence::RawBackendTransition state

//: selfhost_proof_raw_backend_start: raw backend block の開始を[証明/しょうめい]する
fn selfhost_proof_raw_backend_start %fn SelfhostRawBackendKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_raw_backend_proven selfhost_raw_backend_state_start kind span

//: selfhost_proof_raw_backend_text_without_block: raw text が block の[外/そと]にある refutation を[返/かえ]す
fn selfhost_proof_raw_backend_text_without_block %fn SelfhostRawBackendItemFact SelfhostProofResult \item:
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendTextWithoutBlock item

//: selfhost_proof_raw_backend_empty_block: empty raw block refutation を[返/かえ]す
fn selfhost_proof_raw_backend_empty_block %fn SelfhostRawBackendOpenBlock SelfhostProofResult \open_block:
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendBlockEmpty open_block

//: selfhost_proof_solve_raw_backend_normal: Normal state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_normal %fn SelfhostRawBackendItemFact SelfhostProofResult \item:
    match item.kind:
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span
        SelfhostRawBackendItemKind::WasmText:
            selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            selfhost_proof_raw_backend_text_without_block item

//: selfhost_proof_solve_raw_backend_empty: empty block state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_empty %fn SelfhostRawBackendOpenBlock fn SelfhostRawBackendItemFact SelfhostProofResult \open_block\item:
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_empty_block open_block

//: selfhost_proof_solve_raw_backend_ready: text を持つ block state の transition を[解/と]く
fn selfhost_proof_solve_raw_backend_ready %fn SelfhostRawBackendKind fn SelfhostRawBackendItemFact SelfhostProofResult \open_kind\item:
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span

//: selfhost_proof_solve_raw_backend_transition: raw backend transition obligation を[解/と]く
//:
//: [目的/もくてき]:
//: - `SelfhostProofObligation::RawBackendTransition state` に対して、module item stream 上の raw backend item observation から次の typed raw backend state を返します。
//: - module checker はこの solver を通じて、`#wasm:` / `#llvmir:` block と raw text item の対応を checker-local な bool や文字列判定ではなく `SelfhostRawBackendState` の遷移として扱います。
//:
//: [契約/けいやく]:
//: - `SelfhostRawBackendState::Normal` では `SelfhostRawBackendItemKind::WasmBlock` / `LlvmIrBlock` だけが raw block を開始し、`SelfhostRawBackendState::OpenEmpty` を返します。
//: - `SelfhostRawBackendState::Normal` で `SelfhostRawBackendItemKind::WasmText` / `LlvmIrText` を観測した場合、対応する block がないため `SelfhostProofRefutation::RawBackendTextWithoutBlock` を返します。
//: - `SelfhostRawBackendState::OpenEmpty open_block` では、最初の text が `open_block.kind` と一致した場合だけ `SelfhostRawBackendState::OpenReady open_block.kind` へ進みます。非 raw item、stream end、新しい block item、または backend kind が一致しない text は refutation です。
//: - `SelfhostRawBackendKind::Wasm` は `SelfhostRawBackendItemKind::WasmText` だけを同じ block の text として受け入れ、`SelfhostRawBackendKind::LlvmIr` は `SelfhostRawBackendItemKind::LlvmIrText` だけを同じ block の text として受け入れます。
//: - `SelfhostRawBackendState::OpenReady kind` では、同じ backend kind の raw text をいくつでも受け付けます。非 raw item または stream end は raw block を閉じて `SelfhostRawBackendState::Normal` に戻り、新しい raw block item は直前 block を閉じたうえで次の `OpenEmpty` を開始します。
//:
//: [現状/げんじょう]:
//: - typed authority は `SelfhostRawBackendItemFact.kind` / `span` と `SelfhostRawBackendState` です。source text を再読せず、`#wasm:` / `#llvmir:` の spelling 判定は adapter 側で `SelfhostRawBackendItemKind` へ正規化済みであることを前提にします。
//: - raw block の text が空のまま閉じた場合は `SelfhostProofRefutation::RawBackendBlockEmpty` です。現段階では raw text の backend 内部構文、WAT / LLVM IR の妥当性、backend 固有の symbol 解決はこの proof rule の外側で扱います。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostProofResult::Proven`: evidence は `SelfhostProofEvidence::RawBackendTransition` で、payload は次の `SelfhostRawBackendState` です。
//: - `SelfhostProofResult::Refuted`: raw text が block 外にある場合は `SelfhostProofRefutation::RawBackendTextWithoutBlock`、empty block が閉じられる場合は `SelfhostProofRefutation::RawBackendBlockEmpty` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。1 item と 1 state を固定回数の enum match で検査します。探索範囲は module 全体ではなく、現在の item と raw backend state だけです。
//:
//: [使用例/しようれい]:
//: - 典型例では `SelfhostRawBackendState::Normal` に `SelfhostRawBackendItemKind::WasmBlock` を渡して block を開始し、block 外の `LlvmIrText` が refutation になることを同じ doctest で確認します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/proof" as *
//:| #import "neplg2/core/proof/solver/module" as *
//:
//: fn proof_result_is_proven %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             true
//:         SelfhostProofResult::Refuted _refutation:
//:             false
//:
//: fn proof_result_is_refuted %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             false
//:         SelfhostProofResult::Refuted _refutation:
//:             true
//:
//: fn main %fn void i32 \void:
//:     let span %SelfhostSourceSpan source_span_new_unchecked 0 0 7
//:     let wasm_block %SelfhostRawBackendItemFact selfhost_raw_backend_item_fact_new SelfhostRawBackendItemKind::WasmBlock span
//:     let text_without_block %SelfhostRawBackendItemFact selfhost_raw_backend_item_fact_new SelfhostRawBackendItemKind::LlvmIrText span
//:     let opens %bool proof_result_is_proven selfhost_proof_solve_raw_backend_transition wasm_block SelfhostRawBackendState::Normal
//:     let rejects %bool proof_result_is_refuted selfhost_proof_solve_raw_backend_transition text_without_block SelfhostRawBackendState::Normal
//:     if:
//:         opens
//:         then:
//:             if rejects 0 1
//:         else:
//:             1
//: ```
pub fn selfhost_proof_solve_raw_backend_transition %fn SelfhostRawBackendItemFact fn SelfhostRawBackendState SelfhostProofResult \item\state:
    match state:
        SelfhostRawBackendState::Normal:
            selfhost_proof_solve_raw_backend_normal item
        SelfhostRawBackendState::OpenEmpty open_block:
            selfhost_proof_solve_raw_backend_empty open_block item
        SelfhostRawBackendState::OpenReady kind:
            selfhost_proof_solve_raw_backend_ready kind item

//: selfhost_proof_module_directive_proven: module directive next state evidence を[返/かえ]す
fn selfhost_proof_module_directive_proven %fn SelfhostModuleDirectiveState SelfhostProofResult \state:
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDirectiveTransition state

//: selfhost_proof_module_directive_duplicate: singleton directive [重複/ちょうふく] refutation を[返/かえ]す
fn selfhost_proof_module_directive_duplicate %fn SelfhostModuleDirectiveKind fn SelfhostSourceSpan fn SelfhostSourceSpan SelfhostProofResult \kind\first_span\duplicate_span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDirectiveDuplicate selfhost_module_directive_duplicate_new kind first_span duplicate_span

//: selfhost_module_directive_seen_both_state: entry / target の両方を観測済みにする
fn selfhost_module_directive_seen_both_state %fn SelfhostSourceSpan fn SelfhostSourceSpan SelfhostModuleDirectiveState \entry_span\target_span:
    SelfhostModuleDirectiveState::EntryAndTargetSeen selfhost_module_directive_seen_both_new entry_span target_span

//: selfhost_proof_solve_module_directive_none: singleton directive 未観測 state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_none %fn SelfhostModuleDirectiveFact SelfhostProofResult \item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::NoneSeen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen item.span

//: selfhost_proof_solve_module_directive_entry_seen: entry 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_entry_seen %fn SelfhostSourceSpan fn SelfhostModuleDirectiveFact SelfhostProofResult \entry_span\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen entry_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state entry_span item.span

//: selfhost_proof_solve_module_directive_target_seen: target 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_target_seen %fn SelfhostSourceSpan fn SelfhostModuleDirectiveFact SelfhostProofResult \target_span\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen target_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state item.span target_span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target target_span item.span

//: selfhost_proof_solve_module_directive_both_seen: entry / target 両方観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_both_seen %fn SelfhostModuleDirectiveSeenBoth fn SelfhostModuleDirectiveFact SelfhostProofResult \seen\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntryAndTargetSeen seen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry seen.entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target seen.target_span item.span

//: selfhost_proof_solve_module_directive_transition: module directive transition obligation を[解/と]く
//:
//: [目的/もくてき]:
//: - `SelfhostProofObligation::ModuleDirectiveTransition state` に対して、module item stream 上の singleton directive observation から次の typed directive state を返します。
//: - module checker は `#entry` と `#target` の重複検出を count 後処理にせず、`SelfhostModuleDirectiveState` と typed refutation に閉じ込めます。
//:
//: [契約/けいやく]:
//: - `SelfhostModuleDirectiveState::NoneSeen` で `SelfhostModuleDirectiveKind::Entry` を観測すると `EntrySeen item.span`、`Target` を観測すると `TargetSeen item.span`、`Other` は `NoneSeen` のままです。
//: - `EntrySeen entry_span` で再び `Entry` を観測すると `SelfhostProofRefutation::ModuleDirectiveDuplicate` を返し、payload は `SelfhostModuleDirectiveDuplicate Entry entry_span item.span` です。`Target` は `EntryAndTargetSeen` へ進みます。
//: - `TargetSeen target_span` で再び `Target` を観測すると `SelfhostProofRefutation::ModuleDirectiveDuplicate` を返します。`Entry` は `EntryAndTargetSeen` へ進みます。
//: - `EntryAndTargetSeen seen` では `Other` だけを受け付け、`Entry` / `Target` はそれぞれ保存済み span と現在 span を持つ duplicate refutation になります。
//:
//: [現状/げんじょう]:
//: - typed authority は `SelfhostModuleDirectiveFact.kind` / `span` と `SelfhostModuleDirectiveState` です。directive の spelling や module item kind の網羅変換は adapter 側で完了しているため、この solver は source text を再読しません。
//: - 現在の singleton 対象は `SelfhostModuleDirectiveKind::Entry` と `SelfhostModuleDirectiveKind::Target` です。singleton directive が増える場合は enum variant、state、duplicate diagnostic を同時に拡張し、match 網羅性検査で更新漏れを表面化させます。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostProofResult::Proven`: evidence は `SelfhostProofEvidence::ModuleDirectiveTransition` で、payload は次の `SelfhostModuleDirectiveState` です。
//: - `SelfhostProofResult::Refuted`: singleton directive が重複した場合だけ `SelfhostProofRefutation::ModuleDirectiveDuplicate` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。1 item と 1 state を固定回数の enum match で検査します。探索範囲は module 全体ではなく、現在の item と singleton directive state だけです。
//:
//: [使用例/しようれい]:
//: - 典型例では最初の `Entry` が `Proven` になり、`EntrySeen` の状態でもう一度 `Entry` を渡すと duplicate refutation になることを確認します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/proof" as *
//:| #import "neplg2/core/proof/solver/module" as *
//:
//: fn proof_result_is_proven %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             true
//:         SelfhostProofResult::Refuted _refutation:
//:             false
//:
//: fn proof_result_is_refuted %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             false
//:         SelfhostProofResult::Refuted _refutation:
//:             true
//:
//: fn main %fn void i32 \void:
//:     let span %SelfhostSourceSpan source_span_new_unchecked 0 0 11
//:     let entry %SelfhostModuleDirectiveFact selfhost_module_directive_fact_new SelfhostModuleDirectiveKind::Entry span
//:     let first %bool proof_result_is_proven selfhost_proof_solve_module_directive_transition entry SelfhostModuleDirectiveState::NoneSeen
//:     let duplicate %bool proof_result_is_refuted selfhost_proof_solve_module_directive_transition entry SelfhostModuleDirectiveState::EntrySeen span
//:     if:
//:         first
//:         then:
//:             if duplicate 0 1
//:         else:
//:             1
//: ```
pub fn selfhost_proof_solve_module_directive_transition %fn SelfhostModuleDirectiveFact fn SelfhostModuleDirectiveState SelfhostProofResult \item\state:
    match state:
        SelfhostModuleDirectiveState::NoneSeen:
            selfhost_proof_solve_module_directive_none item
        SelfhostModuleDirectiveState::EntrySeen entry_span:
            selfhost_proof_solve_module_directive_entry_seen entry_span item
        SelfhostModuleDirectiveState::TargetSeen target_span:
            selfhost_proof_solve_module_directive_target_seen target_span item
        SelfhostModuleDirectiveState::EntryAndTargetSeen seen:
            selfhost_proof_solve_module_directive_both_seen seen item

//: selfhost_proof_module_declaration_kind_eq: declaration kind が[等/ひと]しいか[返/かえ]す
fn selfhost_proof_module_declaration_kind_eq %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationKind bool \left\right:
    match left:
        SelfhostModuleDeclarationKind::Function:
            match right:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match right:
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match right:
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match right:
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match right:
                SelfhostModuleDeclarationKind::Impl:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false

//: selfhost_proof_span_contains_span: source span の[包含/ほうがん][関係/かんけい]を[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - parser-provided evidence に含まれる `SelfhostSourceSpan` が、同じ file の header span 内に収まっているかを確認します。
//: - declaration header proof では、keyword span、head span、type annotation range、lambda header range の authority を source text の再読ではなく typed span payload から検査します。
//:
//: [契約/けいやく]:
//: - `outer.file_id` と `inner.file_id` が一致し、`outer.start <= inner.start` かつ `inner.end <= outer.end` のときだけ true を返します。
//: - この helper は `source_span_is_valid` を呼びません。span 自体の有効性は caller が先に検査し、この関数は包含関係だけを O(1) で確認します。
//:
//: [戻/もど]り[値/ち]:
//: - true: inner は outer の header authority の内側にあります。
//: - false: file_id 不一致、開始位置の逆転、終了位置のはみ出しのいずれかがあります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。source text、token stream、collection を走査しません。
fn selfhost_proof_span_contains_span %fn SelfhostSourceSpan fn SelfhostSourceSpan bool \outer\inner:
    and and eq outer.file_id inner.file_id le outer.start inner.start le inner.end outer.end

//: selfhost_proof_module_declaration_head_allowed: declaration kind ごとの head kind [許可/きょか][条件/じょうけん]を[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - `SelfhostModuleDeclarationKind::Function` / `Struct` / `Enum` / `Trait` / `Impl` が、parser-provided evidence の `SelfhostModuleDeclarationHeadKind` と整合するかを確認します。
//: - typed enum の match 網羅性検査により、宣言 kind と head kind の追加時に proof rule の更新漏れを検出できる形にします。
//:
//: [契約/けいやく]:
//: - `SelfhostModuleDeclarationKind::Function`、`SelfhostModuleDeclarationKind::Struct`、`SelfhostModuleDeclarationKind::Enum`、`SelfhostModuleDeclarationKind::Trait` は `SelfhostModuleDeclarationHeadKind::Name` だけを許可します。
//: - `SelfhostModuleDeclarationKind::Impl` は、現状の parser header authority として `SelfhostModuleDeclarationHeadKind::Name` と `SelfhostModuleDeclarationHeadKind::TypeLabel` の両方を許可します。
//:
//: [現状/げんじょう]:
//: - `Impl` の `TypeLabel` が指す型の resolve、trait impl の well-formedness、generic overlap はこの helper では検査しません。ここでは module header 上の形だけを判定します。
//:
//: [戻/もど]り[値/ち]:
//: - true: declaration kind が受け取れる head kind です。
//: - false: function / struct / enum / trait に `TypeLabel` が来た場合など、header shape として不正です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。固定個数の enum 分岐だけを評価します。
fn selfhost_proof_module_declaration_head_allowed %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationHeadKind bool \decl_kind\head_kind:
    match decl_kind:
        SelfhostModuleDeclarationKind::Function:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    true

//: selfhost_proof_module_declaration_visibility_allowed: declaration kind ごとの visibility 規則を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `impl` は AST と export model が visibility を持たないため、`pub impl` を header proof で拒否します。
//: - `fn` / `struct` / `enum` / `trait` は visibility を typed evidence として後続 resolve/export 検査へ渡せるため、ここでは両方を受け入れます。
fn selfhost_proof_module_declaration_visibility_allowed %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationVisibility bool \decl_kind\visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Private:
            true
        SelfhostModuleDeclarationVisibility::Public:
            match decl_kind:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Impl:
                    false

//: selfhost_proof_module_declaration_header_spans_valid: declaration header の[基本/きほん] span authority を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `SelfhostModuleDeclarationHeader.header_span` と `SelfhostModuleDeclarationHeader.keyword_span` が有効で、keyword が header の内側にあることを確認します。
//: - module checker の diagnostic span は parser-provided evidence の `header.header_span` / `header.keyword_span` を authority にするため、ここで source span の最小不変条件を固定します。
//:
//: [契約/けいやく]:
//: - `source_span_is_valid header.header_span` と `source_span_is_valid header.keyword_span` が true でなければなりません。
//: - `selfhost_proof_span_contains_span header.header_span header.keyword_span` が true でなければなりません。
//:
//: [戻/もど]り[値/ち]:
//: - true: header span と keyword span は valid で、keyword span は header span 内に閉じています。
//: - false: span が不正、または keyword が header 外にあります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。`source_span_is_valid` と `selfhost_proof_span_contains_span` の固定回数呼び出しだけです。
fn selfhost_proof_module_declaration_header_spans_valid %fn SelfhostModuleDeclarationHeader bool \header:
    and and source_span_is_valid header.header_span source_span_is_valid header.keyword_span selfhost_proof_span_contains_span header.header_span header.keyword_span

//: selfhost_proof_module_declaration_header_head_valid: declaration header の head payload を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - parser が `SelfhostModuleDeclarationHeader.head` として渡した `Option::Some head` を、span と kind の両方から検査します。
//: - header proof は source spelling を再読せず、`head.span`、`head.kind`、`header.kind` の typed payload を authority にします。
//:
//: [契約/けいやく]:
//: - `Option::Some head` の場合、`source_span_is_valid head.span`、`selfhost_proof_span_contains_span header.header_span head.span`、`selfhost_proof_module_declaration_head_allowed header.kind head.kind` のすべてが true でなければなりません。
//: - `Option::None` は declaration header としての name / type-label authority が不足するため false です。
//:
//: [現状/げんじょう]:
//: - `SelfhostModuleDeclarationHeadKind::Name` の name resolve や `SelfhostModuleDeclarationHeadKind::TypeLabel` の type resolve は後続 stage の責務です。この helper は header 内に head が存在し、declaration kind が受け取れる形かだけを扱います。
//:
//: [戻/もど]り[値/ち]:
//: - true: head payload が存在し、有効な span を持ち、header span 内にあり、kind 規則に合います。
//: - false: `Option::None`、span 不正、header 外 span、または kind 不一致です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。`Option` と enum の固定分岐だけを評価します。
fn selfhost_proof_module_declaration_header_head_valid %fn SelfhostModuleDeclarationHeader bool \header:
    match header.head:
        Option::Some head:
            and and source_span_is_valid head.span selfhost_proof_span_contains_span header.header_span head.span selfhost_proof_module_declaration_head_allowed header.kind head.kind
        Option::None:
            false

//: selfhost_proof_module_declaration_header_ranges_valid: parser-provided syntax range の基本不変条件を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `%` type annotation range と lambda header range が、内部 payload として有効で header span 内に閉じていることを確認します。
//: - range が存在すべきかどうかは declaration kind に依存するため、この関数では `Empty` を許容します。
fn selfhost_proof_module_declaration_header_ranges_valid %fn SelfhostModuleDeclarationHeader bool \header:
    and:
        selfhost_syntax_range_is_valid header.type_annotation
        and:
            selfhost_syntax_range_span_is_inside header.type_annotation header.header_span
            and:
                selfhost_syntax_range_is_valid header.lambda_header
                selfhost_syntax_range_span_is_inside header.lambda_header header.header_span

//: selfhost_proof_module_declaration_header_ranges_allowed: declaration kind ごとの range 必須条件を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - function 宣言は NEPLg2.1 の `%fn ...` annotation と lambda header を必ず持つため、両 range を nonempty として要求します。
//: - struct / enum / trait / impl はこの段階の module declaration header では function lambda を持たないため、range 混入を拒否します。
fn selfhost_proof_module_declaration_header_ranges_allowed %fn SelfhostModuleDeclarationHeader bool \header:
    match header.kind:
        SelfhostModuleDeclarationKind::Function:
            and selfhost_syntax_range_is_nonempty header.type_annotation selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Struct:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Enum:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Trait:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Impl:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header

//: selfhost_proof_module_declaration_item_kind_supports: module item kind が requested declaration kind を[支/ささ]えるか[判定/はんてい]する
//:
//: [目的/もくてき]:
//: - `SelfhostModuleDeclarationFact.item_kind` が、`SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind` の kind と同じ declaration item かを確認します。
//: - parser/proof 境界では `SelfhostModuleItemKind` から declaration kind への変換を `selfhost_module_item_kind_declaration` だけに集約し、source text の再読や token spelling に依存しません。
//:
//: [契約/けいやく]:
//: - `selfhost_module_item_kind_declaration fact.item_kind` が `Option::Some item_kind` を返し、`selfhost_proof_module_declaration_kind_eq item_kind kind` が true のときだけ true です。
//: - `Option::None` は doc comment、directive、raw backend text など declaration ではない item を表すため false です。
//:
//: [戻/もど]り[値/ち]:
//: - true: fact の item kind は requested `SelfhostModuleDeclarationKind` の header proof 対象です。
//: - false: item が declaration ではない、または requested kind と異なります。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。`SelfhostModuleItemKind` と `SelfhostModuleDeclarationKind` の固定 enum 変換だけです。
fn selfhost_proof_module_declaration_item_kind_supports %fn SelfhostModuleDeclarationFact fn SelfhostModuleDeclarationKind bool \fact\kind:
    match selfhost_module_item_kind_declaration fact.item_kind:
        Option::Some item_kind:
            selfhost_proof_module_declaration_kind_eq item_kind kind
        Option::None:
            false

//: selfhost_proof_module_declaration_header_supports: declaration header evidence が obligation kind を[満/み]たすか[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `SelfhostModuleDeclarationHeader` が `SelfhostModuleDeclarationKind::Function` / `Struct` / `Enum` / `Trait` / `Impl` の requested kind に対して、typed proof evidence として使えるかを一箇所で確認します。
//: - module check は parser-provided evidence を受け取り、この proof layer で kind、span、head、range、visibility の authority を固定します。
//:
//: [契約/けいやく]:
//: - `selfhost_proof_module_declaration_kind_eq header.kind kind` が true でなければなりません。
//: - `selfhost_proof_module_declaration_header_spans_valid`、`selfhost_proof_module_declaration_header_head_valid`、`selfhost_proof_module_declaration_header_ranges_valid`、`selfhost_proof_module_declaration_header_ranges_allowed`、`selfhost_proof_module_declaration_visibility_allowed` のすべてを満たす必要があります。
//:
//: [現状/げんじょう]:
//: - `SelfhostModuleDeclarationKind::Function` は NEPLg2.1 の `%fn ...` type annotation range と lambda header range を required とします。
//: - `SelfhostModuleDeclarationKind::Struct` / `Enum` / `Trait` / `Impl` は、この header proof stage では type annotation range と lambda header range を受け取りません。
//: - `SelfhostModuleDeclarationVisibility::Public` は function / struct / enum / trait では許可し、`Impl` では export visibility model が未定義なので拒否します。
//: - 失敗理由は現状 bool に畳まれ、詳細 reason enum は `SelfhostProofRefutation::ModuleDeclarationHeaderInvalid` の payload には保持しません。
//:
//: [戻/もど]り[値/ち]:
//: - true: header は `SelfhostProofEvidence::ModuleDeclarationHeaderAvailable` として返せる形です。
//: - false: kind、span、head、range、visibility のいずれかが proof contract を満たしません。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。固定個数の helper と enum / option / range payload の検査だけで、token stream や module item list を走査しません。
fn selfhost_proof_module_declaration_header_supports %fn SelfhostModuleDeclarationHeader fn SelfhostModuleDeclarationKind bool \header\kind:
    and:
        selfhost_proof_module_declaration_kind_eq header.kind kind
        and:
            selfhost_proof_module_declaration_header_spans_valid header
            and:
                selfhost_proof_module_declaration_header_head_valid header
                and:
                    selfhost_proof_module_declaration_header_ranges_valid header
                    and selfhost_proof_module_declaration_header_ranges_allowed header selfhost_proof_module_declaration_visibility_allowed header.kind header.visibility

//: selfhost_proof_module_declaration_header_missing: declaration header [欠落/けつらく]を typed refutation に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - declaration item として扱うべき fact に `SelfhostModuleDeclarationHeader` がない場合、`SelfhostProofRefutation::ModuleDeclarationHeaderMissing` を返します。
//: - missing diagnostic の span authority は fact 側の item span であり、source text を再読して推測しません。
//:
//: [契約/けいやく]:
//: - payload は `SelfhostModuleDeclarationHeaderIssue` で、requested `SelfhostModuleDeclarationKind` と caller が渡した `SelfhostSourceSpan` を保持します。
//: - この関数は header の妥当性を検査しません。`Option::None` を typed refutation へ畳む小さな constructor です。
//:
//: [戻/もど]り[値/ち]:
//: - 常に `SelfhostProofResult::Refuted` で、reason は `SelfhostProofRefutation::ModuleDeclarationHeaderMissing` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。payload を構築して proof result に包むだけです。
fn selfhost_proof_module_declaration_header_missing %fn SelfhostModuleDeclarationKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderMissing selfhost_module_declaration_header_issue_new kind span

//: selfhost_proof_module_declaration_header_invalid: declaration header [不正/ふせい]を typed refutation に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - `Option::Some header` は存在するが、kind、span、head、range、visibility の proof contract を満たさない場合に `SelfhostProofRefutation::ModuleDeclarationHeaderInvalid` を返します。
//: - invalid diagnostic の span authority は不正な `header.header_span` であり、caller がその span を渡します。
//:
//: [契約/けいやく]:
//: - payload は `SelfhostModuleDeclarationHeaderIssue` で、requested `SelfhostModuleDeclarationKind` と invalid header の `SelfhostSourceSpan` を保持します。
//: - この helper は詳細 reason を再分類しません。詳細な bool 判定は `selfhost_proof_module_declaration_header_supports` 側で完了しています。
//:
//: [戻/もど]り[値/ち]:
//: - 常に `SelfhostProofResult::Refuted` で、reason は `SelfhostProofRefutation::ModuleDeclarationHeaderInvalid` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。payload を構築して proof result に包むだけです。
fn selfhost_proof_module_declaration_header_invalid %fn SelfhostModuleDeclarationKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderInvalid selfhost_module_declaration_header_issue_new kind span

//: selfhost_proof_module_declaration_header_proven: declaration header evidence を proven result に[包/つつ]む
//:
//: [目的/もくてき]:
//: - `selfhost_proof_module_declaration_header_supports` で検証済みの `SelfhostModuleDeclarationHeader` を、typed evidence として `SelfhostProofResult::Proven` に変換します。
//: - module checker はこの evidence を使い、後続 stage へ parser-provided declaration header authority を渡します。
//:
//: [契約/けいやく]:
//: - caller は header が requested `SelfhostModuleDeclarationKind` に対して valid であることを事前に検査している必要があります。
//: - evidence payload は `SelfhostProofEvidence::ModuleDeclarationHeaderAvailable header` であり、kind / visibility / span / head / range の具体 payload を保持します。
//:
//: [戻/もど]り[値/ち]:
//: - 常に `SelfhostProofResult::Proven` で、evidence は `SelfhostProofEvidence::ModuleDeclarationHeaderAvailable` です。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。header payload を proof result に包むだけです。
fn selfhost_proof_module_declaration_header_proven %fn SelfhostModuleDeclarationHeader SelfhostProofResult \header:
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDeclarationHeaderAvailable header

//: selfhost_proof_solve_module_declaration_header: declaration header availability obligation を[解/と]く
//:
//: [目的/もくてき]:
//: - `SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind` に対して、observed module item fact から declaration header evidence または typed refutation を返します。
//: - module checker はこの solver を通じて、function / struct / enum / trait / impl の header が parser-provided evidence として後続 stage に渡せるかを判定します。
//:
//: [契約/けいやく]:
//: - `selfhost_proof_module_declaration_item_kind_supports fact kind` が false の場合は、fact と obligation が対応していないため `SelfhostProofRefutation::FactObligationMismatch` に畳みます。
//: - `fact.declaration` が `Option::None` の場合は `SelfhostProofRefutation::ModuleDeclarationHeaderMissing` を返します。
//: - `Option::Some header` で `selfhost_proof_module_declaration_header_supports header kind` が true の場合だけ `SelfhostProofEvidence::ModuleDeclarationHeaderAvailable` を返します。
//: - `Option::Some header` でも kind、span、head、range、visibility の proof contract を満たさなければ `SelfhostProofRefutation::ModuleDeclarationHeaderInvalid` を返します。
//:
//: [現状/げんじょう]:
//: - この solver は source text を再読せず、`SelfhostModuleDeclarationFact` の `fact.item_kind`、`fact.declaration`、`SelfhostModuleDeclarationHeader.kind`、`visibility`、`header_span`、`keyword_span`、`head`、`type_annotation`、`lambda_header` を authority にします。
//: - declaration body の typecheck、name resolve、export table 登録、trait impl coherence はこの proof rule の外側で行います。
//: - match 網羅性検査により、`Option::Some` / `Option::None` と declaration kind の追加が proof rule の更新漏れとして表面化します。
//:
//: [戻/もど]り[値/ち]:
//: - `SelfhostProofResult::Proven`: header は `SelfhostProofEvidence::ModuleDeclarationHeaderAvailable` として利用できます。
//: - `SelfhostProofResult::Refuted`: mismatch、missing、invalid のいずれかで、`SelfhostProofRefutation::FactObligationMismatch`、`ModuleDeclarationHeaderMissing`、`ModuleDeclarationHeaderInvalid` を返します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)。1つの fact と 1つの obligation kind を固定回数の enum / option / span / range helper で検査します。
//:
//: [使用例/しようれい]:
//: - 典型例では parser が保持した `SelfhostModuleDeclarationHeader` を `SelfhostModuleDeclarationFact` に入れ、`SelfhostProofEvidence::ModuleDeclarationHeaderAvailable` が返ることを確認します。
//: - 同じ API で `Option::None` の declaration fact は `SelfhostProofRefutation::ModuleDeclarationHeaderMissing` 側へ進むため、caller は missing / invalid / mismatch を文字列ではなく enum refutation として扱えます。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/option" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/proof" as *
//:| #import "neplg2/core/proof/solver/module" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//:
//: fn proof_result_is_proven %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             true
//:         SelfhostProofResult::Refuted _refutation:
//:             false
//:
//: fn proof_result_is_refuted %fn SelfhostProofResult bool \result:
//:     match result:
//:         SelfhostProofResult::Proven _evidence:
//:             false
//:         SelfhostProofResult::Refuted _refutation:
//:             true
//:
//: fn main %fn void i32 \void:
//:     let span %SelfhostSourceSpan source_span_new_unchecked 0 0 30
//:     let keyword_span %SelfhostSourceSpan source_span_new_unchecked 0 0 2
//:     let head %SelfhostModuleDeclarationHead selfhost_module_declaration_head_new SelfhostModuleDeclarationHeadKind::Name source_span_new_unchecked 0 3 7
//:     let type_range %SelfhostSyntaxRange selfhost_syntax_range_new_unchecked 2 4 source_span_new_unchecked 0 8 20
//:     let lambda_range %SelfhostSyntaxRange selfhost_syntax_range_new_unchecked 6 2 source_span_new_unchecked 0 21 27
//:     let header %SelfhostModuleDeclarationHeader selfhost_module_declaration_header_new SelfhostModuleDeclarationKind::Function SelfhostModuleDeclarationVisibility::Private span keyword_span some head type_range lambda_range
//:     let fact %SelfhostModuleDeclarationFact selfhost_module_declaration_fact_new SelfhostModuleItemKind::FunctionDecl some header span
//:     let missing %SelfhostModuleDeclarationFact selfhost_module_declaration_fact_new SelfhostModuleItemKind::FunctionDecl none span
//:     let available %bool proof_result_is_proven selfhost_proof_solve_module_declaration_header fact SelfhostModuleDeclarationKind::Function
//:     let rejected_missing %bool proof_result_is_refuted selfhost_proof_solve_module_declaration_header missing SelfhostModuleDeclarationKind::Function
//:     if:
//:         available
//:         then:
//:             if rejected_missing 0 1
//:         else:
//:             1
//: ```
pub fn selfhost_proof_solve_module_declaration_header %fn SelfhostModuleDeclarationFact fn SelfhostModuleDeclarationKind SelfhostProofResult \fact\kind:
    if:
        selfhost_proof_module_declaration_item_kind_supports fact kind
        then:
            match fact.declaration:
                Option::Some header:
                    if:
                        selfhost_proof_module_declaration_header_supports header kind
                        then:
                            selfhost_proof_module_declaration_header_proven header
                        else:
                            selfhost_proof_module_declaration_header_invalid kind header.header_span
                Option::None:
                    selfhost_proof_module_declaration_header_missing kind fact.span
        else:
            selfhost_proof_result_refuted selfhost_proof_mismatch_refutation SelfhostProofFact::ModuleDeclarationObserved fact SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind
