#indent 4

//: # proof/solver/module
//: module raw/directive/declaration の proof rule を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - module stream の raw backend、singleton directive、declaration header を同じ query/result 境界で証明します。
//: - module checker へ個別 state machine を戻さず、typed obligation を solver rule へ渡します。

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/proof/query" as *
#import "neplg2/core/syntax/ast/module_ast" as *

//: selfhost_raw_backend_text_matches: raw text item が open backend と[一致/いっち]するか[返/かえ]す
fn selfhost_raw_backend_text_matches %fn SelfhostRawBackendKind fn SelfhostRawBackendItemFact bool \open_kind\item:
    match open_kind:
        SelfhostRawBackendKind::Wasm:
            match item.kind:
                SelfhostRawBackendItemKind::WasmText:
                    true
                SelfhostRawBackendItemKind::LlvmIrText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false
        SelfhostRawBackendKind::LlvmIr:
            match item.kind:
                SelfhostRawBackendItemKind::LlvmIrText:
                    true
                SelfhostRawBackendItemKind::WasmText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false

//: selfhost_proof_raw_backend_proven: raw backend next state evidence を[返/かえ]す
fn selfhost_proof_raw_backend_proven %fn SelfhostRawBackendState SelfhostProofResult \state:
    selfhost_proof_result_proven SelfhostProofEvidence::RawBackendTransition state

//: selfhost_proof_raw_backend_start: raw backend block の開始を[証明/しょうめい]する
fn selfhost_proof_raw_backend_start %fn SelfhostRawBackendKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_raw_backend_proven selfhost_raw_backend_state_start kind span

//: selfhost_proof_raw_backend_text_without_block: raw text が block の[外/そと]にある refutation を[返/かえ]す
fn selfhost_proof_raw_backend_text_without_block %fn SelfhostRawBackendItemFact SelfhostProofResult \item:
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendTextWithoutBlock item

//: selfhost_proof_raw_backend_empty_block: empty raw block refutation を[返/かえ]す
fn selfhost_proof_raw_backend_empty_block %fn SelfhostRawBackendOpenBlock SelfhostProofResult \open_block:
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendBlockEmpty open_block

//: selfhost_proof_solve_raw_backend_normal: Normal state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_normal %fn SelfhostRawBackendItemFact SelfhostProofResult \item:
    match item.kind:
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span
        SelfhostRawBackendItemKind::WasmText:
            selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            selfhost_proof_raw_backend_text_without_block item

//: selfhost_proof_solve_raw_backend_empty: empty block state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_empty %fn SelfhostRawBackendOpenBlock fn SelfhostRawBackendItemFact SelfhostProofResult \open_block\item:
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_empty_block open_block

//: selfhost_proof_solve_raw_backend_ready: text を持つ block state の transition を[解/と]く
fn selfhost_proof_solve_raw_backend_ready %fn SelfhostRawBackendKind fn SelfhostRawBackendItemFact SelfhostProofResult \open_kind\item:
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span

//: selfhost_proof_solve_raw_backend_transition: raw backend transition obligation を[解/と]く
pub fn selfhost_proof_solve_raw_backend_transition %fn SelfhostRawBackendItemFact fn SelfhostRawBackendState SelfhostProofResult \item\state:
    match state:
        SelfhostRawBackendState::Normal:
            selfhost_proof_solve_raw_backend_normal item
        SelfhostRawBackendState::OpenEmpty open_block:
            selfhost_proof_solve_raw_backend_empty open_block item
        SelfhostRawBackendState::OpenReady kind:
            selfhost_proof_solve_raw_backend_ready kind item

//: selfhost_proof_module_directive_proven: module directive next state evidence を[返/かえ]す
fn selfhost_proof_module_directive_proven %fn SelfhostModuleDirectiveState SelfhostProofResult \state:
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDirectiveTransition state

//: selfhost_proof_module_directive_duplicate: singleton directive [重複/ちょうふく] refutation を[返/かえ]す
fn selfhost_proof_module_directive_duplicate %fn SelfhostModuleDirectiveKind fn SelfhostSourceSpan fn SelfhostSourceSpan SelfhostProofResult \kind\first_span\duplicate_span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDirectiveDuplicate selfhost_module_directive_duplicate_new kind first_span duplicate_span

//: selfhost_module_directive_seen_both_state: entry / target の両方を観測済みにする
fn selfhost_module_directive_seen_both_state %fn SelfhostSourceSpan fn SelfhostSourceSpan SelfhostModuleDirectiveState \entry_span\target_span:
    SelfhostModuleDirectiveState::EntryAndTargetSeen selfhost_module_directive_seen_both_new entry_span target_span

//: selfhost_proof_solve_module_directive_none: singleton directive 未観測 state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_none %fn SelfhostModuleDirectiveFact SelfhostProofResult \item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::NoneSeen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen item.span

//: selfhost_proof_solve_module_directive_entry_seen: entry 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_entry_seen %fn SelfhostSourceSpan fn SelfhostModuleDirectiveFact SelfhostProofResult \entry_span\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen entry_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state entry_span item.span

//: selfhost_proof_solve_module_directive_target_seen: target 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_target_seen %fn SelfhostSourceSpan fn SelfhostModuleDirectiveFact SelfhostProofResult \target_span\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen target_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state item.span target_span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target target_span item.span

//: selfhost_proof_solve_module_directive_both_seen: entry / target 両方観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_both_seen %fn SelfhostModuleDirectiveSeenBoth fn SelfhostModuleDirectiveFact SelfhostProofResult \seen\item:
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntryAndTargetSeen seen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry seen.entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target seen.target_span item.span

//: selfhost_proof_solve_module_directive_transition: module directive transition obligation を[解/と]く
pub fn selfhost_proof_solve_module_directive_transition %fn SelfhostModuleDirectiveFact fn SelfhostModuleDirectiveState SelfhostProofResult \item\state:
    match state:
        SelfhostModuleDirectiveState::NoneSeen:
            selfhost_proof_solve_module_directive_none item
        SelfhostModuleDirectiveState::EntrySeen entry_span:
            selfhost_proof_solve_module_directive_entry_seen entry_span item
        SelfhostModuleDirectiveState::TargetSeen target_span:
            selfhost_proof_solve_module_directive_target_seen target_span item
        SelfhostModuleDirectiveState::EntryAndTargetSeen seen:
            selfhost_proof_solve_module_directive_both_seen seen item

//: selfhost_proof_module_declaration_kind_eq: declaration kind が[等/ひと]しいか[返/かえ]す
fn selfhost_proof_module_declaration_kind_eq %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationKind bool \left\right:
    match left:
        SelfhostModuleDeclarationKind::Function:
            match right:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match right:
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match right:
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match right:
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match right:
                SelfhostModuleDeclarationKind::Impl:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false

fn selfhost_proof_span_contains_span %fn SelfhostSourceSpan fn SelfhostSourceSpan bool \outer\inner:
    and and eq outer.file_id inner.file_id le outer.start inner.start le inner.end outer.end

fn selfhost_proof_module_declaration_head_allowed %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationHeadKind bool \decl_kind\head_kind:
    match decl_kind:
        SelfhostModuleDeclarationKind::Function:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    true

//: selfhost_proof_module_declaration_visibility_allowed: declaration kind ごとの visibility 規則を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `impl` は AST と export model が visibility を持たないため、`pub impl` を header proof で拒否します。
//: - `fn` / `struct` / `enum` / `trait` は visibility を typed evidence として後続 resolve/export 検査へ渡せるため、ここでは両方を受け入れます。
fn selfhost_proof_module_declaration_visibility_allowed %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationVisibility bool \decl_kind\visibility:
    match visibility:
        SelfhostModuleDeclarationVisibility::Private:
            true
        SelfhostModuleDeclarationVisibility::Public:
            match decl_kind:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Impl:
                    false

fn selfhost_proof_module_declaration_header_spans_valid %fn SelfhostModuleDeclarationHeader bool \header:
    and and source_span_is_valid header.header_span source_span_is_valid header.keyword_span selfhost_proof_span_contains_span header.header_span header.keyword_span

fn selfhost_proof_module_declaration_header_head_valid %fn SelfhostModuleDeclarationHeader bool \header:
    match header.head:
        Option::Some head:
            and and source_span_is_valid head.span selfhost_proof_span_contains_span header.header_span head.span selfhost_proof_module_declaration_head_allowed header.kind head.kind
        Option::None:
            false

//: selfhost_proof_module_declaration_header_ranges_valid: parser-provided syntax range の基本不変条件を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `%` type annotation range と lambda header range が、内部 payload として有効で header span 内に閉じていることを確認します。
//: - range が存在すべきかどうかは declaration kind に依存するため、この関数では `Empty` を許容します。
fn selfhost_proof_module_declaration_header_ranges_valid %fn SelfhostModuleDeclarationHeader bool \header:
    and:
        selfhost_syntax_range_is_valid header.type_annotation
        and:
            selfhost_syntax_range_span_is_inside header.type_annotation header.header_span
            and:
                selfhost_syntax_range_is_valid header.lambda_header
                selfhost_syntax_range_span_is_inside header.lambda_header header.header_span

//: selfhost_proof_module_declaration_header_ranges_allowed: declaration kind ごとの range 必須条件を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - function 宣言は NEPLg2.1 の `%fn ...` annotation と lambda header を必ず持つため、両 range を nonempty として要求します。
//: - struct / enum / trait / impl はこの段階の module declaration header では function lambda を持たないため、range 混入を拒否します。
fn selfhost_proof_module_declaration_header_ranges_allowed %fn SelfhostModuleDeclarationHeader bool \header:
    match header.kind:
        SelfhostModuleDeclarationKind::Function:
            and selfhost_syntax_range_is_nonempty header.type_annotation selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Struct:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Enum:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Trait:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header
        SelfhostModuleDeclarationKind::Impl:
            and not selfhost_syntax_range_is_nonempty header.type_annotation not selfhost_syntax_range_is_nonempty header.lambda_header

fn selfhost_proof_module_declaration_item_kind_supports %fn SelfhostModuleDeclarationFact fn SelfhostModuleDeclarationKind bool \fact\kind:
    match selfhost_module_item_kind_declaration fact.item_kind:
        Option::Some item_kind:
            selfhost_proof_module_declaration_kind_eq item_kind kind
        Option::None:
            false

fn selfhost_proof_module_declaration_header_supports %fn SelfhostModuleDeclarationHeader fn SelfhostModuleDeclarationKind bool \header\kind:
    and:
        selfhost_proof_module_declaration_kind_eq header.kind kind
        and:
            selfhost_proof_module_declaration_header_spans_valid header
            and:
                selfhost_proof_module_declaration_header_head_valid header
                and:
                    selfhost_proof_module_declaration_header_ranges_valid header
                    and selfhost_proof_module_declaration_header_ranges_allowed header selfhost_proof_module_declaration_visibility_allowed header.kind header.visibility

fn selfhost_proof_module_declaration_header_missing %fn SelfhostModuleDeclarationKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderMissing selfhost_module_declaration_header_issue_new kind span

fn selfhost_proof_module_declaration_header_invalid %fn SelfhostModuleDeclarationKind fn SelfhostSourceSpan SelfhostProofResult \kind\span:
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderInvalid selfhost_module_declaration_header_issue_new kind span

fn selfhost_proof_module_declaration_header_proven %fn SelfhostModuleDeclarationHeader SelfhostProofResult \header:
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDeclarationHeaderAvailable header

//: selfhost_proof_solve_module_declaration_header: declaration header availability obligation を[解/と]く
pub fn selfhost_proof_solve_module_declaration_header %fn SelfhostModuleDeclarationFact fn SelfhostModuleDeclarationKind SelfhostProofResult \fact\kind:
    if:
        selfhost_proof_module_declaration_item_kind_supports fact kind
        then:
            match fact.declaration:
                Option::Some header:
                    if:
                        selfhost_proof_module_declaration_header_supports header kind
                        then:
                            selfhost_proof_module_declaration_header_proven header
                        else:
                            selfhost_proof_module_declaration_header_invalid kind header.header_span
                Option::None:
                    selfhost_proof_module_declaration_header_missing kind fact.span
        else:
            selfhost_proof_result_refuted selfhost_proof_mismatch_refutation SelfhostProofFact::ModuleDeclarationObserved fact SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind
