//: selfhost_borrow_access_issue_new: Resource borrow access issue payload を[作/つく]る
pub fn selfhost_borrow_access_issue_new %fn SelfhostBorrowState fn SelfhostBorrowRequestKind fn SelfhostSourceSpan fn SelfhostBorrowAccessError SelfhostBorrowAccessIssue \state\request\span\reason:
