pub struct SelfhostLifetimeOutlivesIssue:
    subject %SelfhostLifetimeId
    expected_required %SelfhostLifetimeId
    observed_required %SelfhostLifetimeId
    relation %SelfhostLifetimeRelation
    use_kind %SelfhostLifetimeUseKind
    span %SelfhostSourceSpan
    reason %SelfhostLifetimeOutlivesError

impl Clone for SelfhostLifetimeOutlivesIssue:
    fn clone %fn &SelfhostLifetimeOutlivesIssue SelfhostLifetimeOutlivesIssue \self:
        *self

impl Copy for SelfhostLifetimeOutlivesIssue:
    fn copy_mark %fn SelfhostLifetimeOutlivesIssue SelfhostLifetimeOutlivesIssue \self:
        self

//: selfhost_lifetime_outlives_issue_new: lifetime outlives issue payload を[作/つく]る
pub fn selfhost_lifetime_outlives_issue_new %fn SelfhostLifetimeId fn SelfhostLifetimeId fn SelfhostLifetimeId fn SelfhostLifetimeRelation fn SelfhostLifetimeUseKind fn SelfhostSourceSpan fn SelfhostLifetimeOutlivesError SelfhostLifetimeOutlivesIssue \subject\expected_required\observed_required\relation\use_kind\span\reason:
    SelfhostLifetimeOutlivesIssue subject expected_required observed_required relation use_kind span reason

//: SelfhostEffectBoundaryError: effect boundary proof の失敗分類
//:
//: [目的/もくてき]:
//: - pure context の impure effect、unsafe boundary 外の unsafe memory、no-escape 未証明の internal allocation / private effect を typed reason として表します。
pub enum SelfhostEffectBoundaryError:
    ImpureEffectInPureContext
    UnsafeMemoryOutsideBoundary
    InternalAllocEscapeNotProven
    PrivateEffectEscapeNotProven

impl Clone for SelfhostEffectBoundaryError:
    fn clone %fn &SelfhostEffectBoundaryError SelfhostEffectBoundaryError \self:
        *self

impl Copy for SelfhostEffectBoundaryError:
    fn copy_mark %fn SelfhostEffectBoundaryError SelfhostEffectBoundaryError \self:
        self

//: SelfhostEffectBoundaryIssue: 不正な effect boundary の refutation payload
pub struct SelfhostEffectBoundaryIssue:
    effect %SelfhostEffectKind
    escape %SelfhostEffectEscapeState
    context %SelfhostEffectContext
    span %SelfhostSourceSpan
    reason %SelfhostEffectBoundaryError

impl Clone for SelfhostEffectBoundaryIssue:
    fn clone %fn &SelfhostEffectBoundaryIssue SelfhostEffectBoundaryIssue \self:
        *self

impl Copy for SelfhostEffectBoundaryIssue:
    fn copy_mark %fn SelfhostEffectBoundaryIssue SelfhostEffectBoundaryIssue \self:
        self

//: selfhost_effect_boundary_issue_new: effect boundary issue payload を[作/つく]る
pub fn selfhost_effect_boundary_issue_new %fn SelfhostEffectKind fn SelfhostEffectEscapeState fn SelfhostEffectContext fn SelfhostSourceSpan fn SelfhostEffectBoundaryError SelfhostEffectBoundaryIssue \effect\escape\context\span\reason:
    SelfhostEffectBoundaryIssue effect escape context span reason

//: SelfhostTypeKindMismatch: type kind compatibility proof の refutation payload
//:
//: [目的/もくてき]:
//: - 期待 type kind、実際に観測した type kind、source span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で生成し、proof solver は型分類の enum だけを扱います。
pub struct SelfhostTypeKindMismatch:
    expected %SelfhostTypeKind
    actual %SelfhostTypeKind
    span %SelfhostSourceSpan

impl Clone for SelfhostTypeKindMismatch:
    fn clone %fn &SelfhostTypeKindMismatch SelfhostTypeKindMismatch \self:
        *self

impl Copy for SelfhostTypeKindMismatch:
    fn copy_mark %fn SelfhostTypeKindMismatch SelfhostTypeKindMismatch \self:
        self

//: selfhost_type_kind_mismatch_new: type kind mismatch refutation payload を[作/つく]る
pub fn selfhost_type_kind_mismatch_new %fn SelfhostTypeKind fn SelfhostTypeKind fn SelfhostSourceSpan SelfhostTypeKindMismatch \expected\actual\span:
    SelfhostTypeKindMismatch expected actual span

//: SelfhostTraitImplCoherenceError: trait impl coherence proof の失敗分類
//:
//: [目的/もくてき]:
//: - duplicate impl と invalid key を typed reason として分け、diagnostic 生成を proof solver 外へ分離します。
pub enum SelfhostTraitImplCoherenceError:
    DuplicateImpl
    InvalidCandidateKey
    InvalidExistingKey

impl Clone for SelfhostTraitImplCoherenceError:
    fn clone %fn &SelfhostTraitImplCoherenceError SelfhostTraitImplCoherenceError \self:
        *self

impl Copy for SelfhostTraitImplCoherenceError:
    fn copy_mark %fn SelfhostTraitImplCoherenceError SelfhostTraitImplCoherenceError \self:
        self

//: SelfhostTraitImplCoherenceIssue: 不正な trait impl coherence の refutation payload
pub struct SelfhostTraitImplCoherenceIssue:
    candidate %SelfhostTraitImplKey
    existing %SelfhostTraitImplKey
    relation %SelfhostTraitImplRelation
    span %SelfhostSourceSpan
    reason %SelfhostTraitImplCoherenceError

impl Clone for SelfhostTraitImplCoherenceIssue:
    fn clone %fn &SelfhostTraitImplCoherenceIssue SelfhostTraitImplCoherenceIssue \self:
        *self

impl Copy for SelfhostTraitImplCoherenceIssue:
    fn copy_mark %fn SelfhostTraitImplCoherenceIssue SelfhostTraitImplCoherenceIssue \self:
        self

//: selfhost_trait_impl_coherence_issue_new: trait impl coherence issue payload を[作/つく]る
pub fn selfhost_trait_impl_coherence_issue_new %fn SelfhostTraitImplKey fn SelfhostTraitImplKey fn SelfhostTraitImplRelation fn SelfhostSourceSpan fn SelfhostTraitImplCoherenceError SelfhostTraitImplCoherenceIssue \candidate\existing\relation\span\reason:
    SelfhostTraitImplCoherenceIssue candidate existing relation span reason

//: SelfhostProofMismatch: fact と obligation の domain が[噛/か]み[合/あ]わない refutation payload
//:
//: [目的/もくてき]:
//: - proof caller や solver の[誤/あやま]った[配線/はいせん]を、単なる失敗ではなく fact domain / obligation domain の組として残します。
//: - type / trait / effect / resource の obligation が増えたときも、どの domain 境界で不整合が起きたかを match で追えるようにします。
pub struct SelfhostProofMismatch:
    fact_domain %SelfhostProofDomain
    obligation_domain %SelfhostProofDomain

impl Clone for SelfhostProofMismatch:
    fn clone %fn &SelfhostProofMismatch SelfhostProofMismatch \self:
        *self

impl Copy for SelfhostProofMismatch:
    fn copy_mark %fn SelfhostProofMismatch SelfhostProofMismatch \self:
        self

//: selfhost_proof_mismatch_new: proof mismatch refutation payload を[作/つく]る
pub fn selfhost_proof_mismatch_new %fn SelfhostProofDomain fn SelfhostProofDomain SelfhostProofMismatch \fact_domain\obligation_domain:
    SelfhostProofMismatch fact_domain obligation_domain

//: SelfhostProofUnexpectedEvidence: API wrapper が期待しない evidence を受け取った refutation payload
//:
//: [目的/もくてき]:
//: - fact と obligation の domain は合っているのに solver が違う success evidence を返した場合を、domain mismatch とは別に記録します。
//: - これは solver implementation の誤配線を検出するための payload であり、expected / actual を enum kind として保持します。
pub struct SelfhostProofUnexpectedEvidence:
    expected %SelfhostProofEvidenceKind
    actual %SelfhostProofEvidenceKind

impl Clone for SelfhostProofUnexpectedEvidence:
    fn clone %fn &SelfhostProofUnexpectedEvidence SelfhostProofUnexpectedEvidence \self:
        *self

impl Copy for SelfhostProofUnexpectedEvidence:
    fn copy_mark %fn SelfhostProofUnexpectedEvidence SelfhostProofUnexpectedEvidence \self:
        self

//: selfhost_proof_unexpected_evidence_new: unexpected evidence payload を[作/つく]る
pub fn selfhost_proof_unexpected_evidence_new %fn SelfhostProofEvidenceKind fn SelfhostProofEvidenceKind SelfhostProofUnexpectedEvidence \expected\actual:
    SelfhostProofUnexpectedEvidence expected actual

//: SelfhostProofRefutation: proof が[不成立/ふせいりつ]だった[理由/りゆう]
//:
//: [目的/もくてき]:
//: - proof 失敗を diagnostic 文字列へ直行させず、caller が typed reason を match して domain ごとの diagnostic へ[変換/へんかん]できるようにします。
pub enum SelfhostProofRefutation:
    FactObligationMismatch %SelfhostProofMismatch
    UnexpectedEvidence %SelfhostProofUnexpectedEvidence
    SourceSpanInvalid %SelfhostSourceSpan
    RawBackendTextWithoutBlock %SelfhostRawBackendItemFact
    RawBackendBlockEmpty %SelfhostRawBackendOpenBlock
    ModuleDirectiveDuplicate %SelfhostModuleDirectiveDuplicate
    ModuleDeclarationHeaderMissing %SelfhostModuleDeclarationHeaderIssue
    ModuleDeclarationHeaderInvalid %SelfhostModuleDeclarationHeaderIssue
    TypeKindMismatch %SelfhostTypeKindMismatch
    TraitImplCoherenceInvalid %SelfhostTraitImplCoherenceIssue
    LifetimeOutlivesInvalid %SelfhostLifetimeOutlivesIssue
    ResourceCellTransitionInvalid %SelfhostResourceCellTransitionIssue
    OwnerTransitionInvalid %SelfhostOwnerTransitionIssue
    BorrowAccessInvalid %SelfhostBorrowAccessIssue
    EffectBoundaryInvalid %SelfhostEffectBoundaryIssue

impl Clone for SelfhostProofRefutation:
    fn clone %fn &SelfhostProofRefutation SelfhostProofRefutation \self:
        *self

impl Copy for SelfhostProofRefutation:
    fn copy_mark %fn SelfhostProofRefutation SelfhostProofRefutation \self:
        self
