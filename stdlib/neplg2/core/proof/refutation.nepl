#indent 4

//: # proof/refutation
//: proof が不成立だった理由を typed payload として[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - diagnostic 文字列に直行せず、caller が refutation enum を match して安全に報告へ変換できるようにします。

#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/evidence" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/resource/borrow_state" as *
#import "neplg2/core/resource/lifetime" as *
#import "neplg2/core/resource/init/cell" as *
#import "neplg2/core/resource/owner" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/trait_ref" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostModuleDirectiveDuplicate: singleton directive が[重複/ちょうふく]した refutation payload
//:
//: [目的/もくてき]:
//: - 重複した directive の kind、最初の span、重複した span を typed value として保持します。
//: - diagnostic 文字列は checker / reporter 境界で作り、proof solver は文字列 code に依存しません。
pub struct SelfhostModuleDirectiveDuplicate:
    kind %SelfhostModuleDirectiveKind
    first_span %SelfhostSourceSpan
    duplicate_span %SelfhostSourceSpan

impl Clone for SelfhostModuleDirectiveDuplicate:
    fn clone %fn &SelfhostModuleDirectiveDuplicate SelfhostModuleDirectiveDuplicate \self:
        *self

impl Copy for SelfhostModuleDirectiveDuplicate:
    fn copy_mark %fn SelfhostModuleDirectiveDuplicate SelfhostModuleDirectiveDuplicate \self:
        self

//: selfhost_module_directive_duplicate_new: duplicate directive refutation payload を[作/つく]る
pub fn selfhost_module_directive_duplicate_new %fn SelfhostModuleDirectiveKind fn SelfhostSourceSpan fn SelfhostSourceSpan SelfhostModuleDirectiveDuplicate \kind\first_span\duplicate_span:
    SelfhostModuleDirectiveDuplicate kind first_span duplicate_span

//: SelfhostModuleDeclarationHeaderIssue: declaration header proof の refutation payload
//:
//: [目的/もくてき]:
//: - 欠落または不正な declaration header を、自由文字列ではなく declaration kind と span の組として保持します。
pub struct SelfhostModuleDeclarationHeaderIssue:
    kind %SelfhostModuleDeclarationKind
    span %SelfhostSourceSpan

impl Clone for SelfhostModuleDeclarationHeaderIssue:
    fn clone %fn &SelfhostModuleDeclarationHeaderIssue SelfhostModuleDeclarationHeaderIssue \self:
        *self

impl Copy for SelfhostModuleDeclarationHeaderIssue:
    fn copy_mark %fn SelfhostModuleDeclarationHeaderIssue SelfhostModuleDeclarationHeaderIssue \self:
        self

//: selfhost_module_declaration_header_issue_new: declaration header issue payload を[作/つく]る
pub fn selfhost_module_declaration_header_issue_new %fn SelfhostModuleDeclarationKind fn SelfhostSourceSpan SelfhostModuleDeclarationHeaderIssue \kind\span:
    SelfhostModuleDeclarationHeaderIssue kind span

//: SelfhostResourceCellTransitionError: Resource cell state transition の失敗分類
//:
//: [目的/もくてき]:
//: - uninitialized move、move 後の再 move、double drop などを自由文字列ではなく enum として表します。
pub enum SelfhostResourceCellTransitionError:
    InitializeAlreadyInitialized
    InitializeAfterDrop
    MoveUninitialized
    MoveAfterMove
    MoveAfterDrop
    DropUninitialized
    DropAfterMove
    DoubleDrop

impl Clone for SelfhostResourceCellTransitionError:
    fn clone %fn &SelfhostResourceCellTransitionError SelfhostResourceCellTransitionError \self:
        *self

impl Copy for SelfhostResourceCellTransitionError:
    fn copy_mark %fn SelfhostResourceCellTransitionError SelfhostResourceCellTransitionError \self:
        self

//: SelfhostResourceCellTransitionIssue: 不正な Resource cell transition の refutation payload
//:
//: [目的/もくてき]:
//: - 失敗時の元 state、event、span、理由を typed value として保持し、diagnostic は caller 境界で生成できるようにします。
pub struct SelfhostResourceCellTransitionIssue:
    state %SelfhostResourceCellState
    event %SelfhostResourceCellEventKind
    span %SelfhostSourceSpan
    reason %SelfhostResourceCellTransitionError

impl Clone for SelfhostResourceCellTransitionIssue:
    fn clone %fn &SelfhostResourceCellTransitionIssue SelfhostResourceCellTransitionIssue \self:
        *self

impl Copy for SelfhostResourceCellTransitionIssue:
    fn copy_mark %fn SelfhostResourceCellTransitionIssue SelfhostResourceCellTransitionIssue \self:
        self

//: selfhost_resource_cell_transition_issue_new: Resource cell transition issue payload を[作/つく]る
pub fn selfhost_resource_cell_transition_issue_new %fn SelfhostResourceCellState fn SelfhostResourceCellEventKind fn SelfhostSourceSpan fn SelfhostResourceCellTransitionError SelfhostResourceCellTransitionIssue \state\event\span\reason:
    SelfhostResourceCellTransitionIssue state event span reason

//: SelfhostOwnerTransitionError: free obligation owner transition の失敗分類
//:
//: [目的/もくてき]:
//: - double free、move 後の release、owner 不在の view 作成などを自由文字列ではなく enum として表します。
pub enum SelfhostOwnerTransitionError:
    InvalidStorageId
    StorageIdMismatch
    AcquireWhileOwned
    AcquireAfterMove
    AcquireAfterRelease
    MoveWithoutOwner
    MoveAfterMove
    MoveAfterRelease
    ReleaseWithoutOwner
    ReleaseAfterMove
    ReleaseAfterRelease
    ViewWithoutOwner
    ViewAfterMove
    ViewAfterRelease

impl Clone for SelfhostOwnerTransitionError:
    fn clone %fn &SelfhostOwnerTransitionError SelfhostOwnerTransitionError \self:
        *self

impl Copy for SelfhostOwnerTransitionError:
    fn copy_mark %fn SelfhostOwnerTransitionError SelfhostOwnerTransitionError \self:
        self

//: SelfhostOwnerTransitionIssue: 不正な free obligation owner transition の refutation payload
//:
//: [目的/もくてき]:
//: - 失敗時の元 state、event、対象 storage、span、理由を typed value として保持します。
pub struct SelfhostOwnerTransitionIssue:
    state %SelfhostOwnerState
    event %SelfhostOwnerEventKind
    storage %SelfhostOwnerStorageId
    span %SelfhostSourceSpan
    reason %SelfhostOwnerTransitionError

impl Clone for SelfhostOwnerTransitionIssue:
    fn clone %fn &SelfhostOwnerTransitionIssue SelfhostOwnerTransitionIssue \self:
        *self

impl Copy for SelfhostOwnerTransitionIssue:
    fn copy_mark %fn SelfhostOwnerTransitionIssue SelfhostOwnerTransitionIssue \self:
        self

//: selfhost_owner_transition_issue_new: owner transition issue payload を[作/つく]る
pub fn selfhost_owner_transition_issue_new %fn SelfhostOwnerState fn SelfhostOwnerEventKind fn SelfhostOwnerStorageId fn SelfhostSourceSpan fn SelfhostOwnerTransitionError SelfhostOwnerTransitionIssue \state\event\storage\span\reason:
    SelfhostOwnerTransitionIssue state event storage span reason

//: SelfhostBorrowAccessError: Resource borrow access proof の失敗分類
pub enum SelfhostBorrowAccessError:
