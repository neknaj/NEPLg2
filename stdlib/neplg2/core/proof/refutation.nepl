//: SelfhostLifetimeOutlivesError: lifetime outlives proof の失敗分類
pub enum SelfhostLifetimeOutlivesError:
    RequiredLifetimeMismatch
    InvalidSubjectLifetime
    InvalidRequiredLifetime
    SubjectDoesNotOutliveRequired
    UnrelatedLifetimes

impl Clone for SelfhostLifetimeOutlivesError:
    fn clone %fn &SelfhostLifetimeOutlivesError SelfhostLifetimeOutlivesError \self:
        *self

impl Copy for SelfhostLifetimeOutlivesError:
    fn copy_mark %fn SelfhostLifetimeOutlivesError SelfhostLifetimeOutlivesError \self:
        self

