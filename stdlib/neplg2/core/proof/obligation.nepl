#indent 4

//: # proof/obligation
//: self-host proof solver が[証明/しょうめい]すべき typed obligation を[定義/ていぎ]するモジュールです。
//:
//: [目的/もくてき]:
//: - checker / type / trait / effect / resource が「必要な性質」を enum payload として[表/あらわ]せるようにします。
//: - obligation は solver へ渡す[要求/ようきゅう]であり、個別 checker が直接 boolean 判定を積み増すことを避けます。

#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/resource/move_state" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/ty/effect" as *
#import "neplg2/core/ty/ty" as *

//: SelfhostRawBackendOpenBlock: raw backend block が text をまだ[持/も]たない[状態/じょうたい]
pub struct SelfhostRawBackendOpenBlock:
    kind <SelfhostRawBackendKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostRawBackendOpenBlock:
    fn clone <(&SelfhostRawBackendOpenBlock)->SelfhostRawBackendOpenBlock> (self):
        *self

impl Copy for SelfhostRawBackendOpenBlock:
    fn copy_mark <(SelfhostRawBackendOpenBlock)->SelfhostRawBackendOpenBlock> (self):
        self

//: SelfhostRawBackendState: raw backend stream の proof state
//:
//: [目的/もくてき]:
//: - `#wasm:` / `#llvmir:` block と raw text の対応を checker-local state machine ではなく proof obligation の state として[扱/あつか]います。
pub enum SelfhostRawBackendState:
    Normal
    OpenEmpty <SelfhostRawBackendOpenBlock>
    OpenReady <SelfhostRawBackendKind>

impl Clone for SelfhostRawBackendState:
    fn clone <(&SelfhostRawBackendState)->SelfhostRawBackendState> (self):
        *self

impl Copy for SelfhostRawBackendState:
    fn copy_mark <(SelfhostRawBackendState)->SelfhostRawBackendState> (self):
        self

//: selfhost_raw_backend_open_block_new: empty raw backend block state payload を[作/つく]る
pub fn selfhost_raw_backend_open_block_new <(SelfhostRawBackendKind,SelfhostSourceSpan)->SelfhostRawBackendOpenBlock> (kind, span):
    SelfhostRawBackendOpenBlock kind span

//: selfhost_raw_backend_state_start: block item から empty block state を[作/つく]る
pub fn selfhost_raw_backend_state_start <(SelfhostRawBackendKind,SelfhostSourceSpan)->SelfhostRawBackendState> (kind, span):
    SelfhostRawBackendState::OpenEmpty selfhost_raw_backend_open_block_new kind span

//: SelfhostModuleDirectiveSeenBoth: `#entry` と `#target` の両方を観測済みの module directive state
pub struct SelfhostModuleDirectiveSeenBoth:
    entry_span <SelfhostSourceSpan>
    target_span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDirectiveSeenBoth:
    fn clone <(&SelfhostModuleDirectiveSeenBoth)->SelfhostModuleDirectiveSeenBoth> (self):
        *self

impl Copy for SelfhostModuleDirectiveSeenBoth:
    fn copy_mark <(SelfhostModuleDirectiveSeenBoth)->SelfhostModuleDirectiveSeenBoth> (self):
        self

//: SelfhostModuleDirectiveState: singleton directive stream の proof state
//:
//: [目的/もくてき]:
//: - `#entry` / `#target` が module item stream で[高々/たかだか] 1 [回/かい]だけ[現/あらわ]れることを、summary count ではなく enum state として[表/あらわ]します。
//: - state variant が観測済み directive の span を保持するため、重複検出時に以前の directive も typed refutation へ渡せます。
pub enum SelfhostModuleDirectiveState:
    NoneSeen
    EntrySeen <SelfhostSourceSpan>
    TargetSeen <SelfhostSourceSpan>
    EntryAndTargetSeen <SelfhostModuleDirectiveSeenBoth>

impl Clone for SelfhostModuleDirectiveState:
    fn clone <(&SelfhostModuleDirectiveState)->SelfhostModuleDirectiveState> (self):
        *self

impl Copy for SelfhostModuleDirectiveState:
    fn copy_mark <(SelfhostModuleDirectiveState)->SelfhostModuleDirectiveState> (self):
        self

//: selfhost_module_directive_seen_both_new: entry / target の両方を観測済みにする state payload を[作/つく]る
pub fn selfhost_module_directive_seen_both_new <(SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostModuleDirectiveSeenBoth> (entry_span, target_span):
    SelfhostModuleDirectiveSeenBoth entry_span target_span

//: SelfhostProofObligation: solver が[証明/しょうめい]する typed obligation
pub enum SelfhostProofObligation:
    SourceSpanValid <SelfhostSourceSpan>
    RawBackendTransition <SelfhostRawBackendState>
    ModuleDirectiveTransition <SelfhostModuleDirectiveState>
    ModuleDeclarationHeaderAvailable <SelfhostModuleDeclarationKind>
    TypeKindCompatible <SelfhostTypeKind>
    ResourceCellTransition <SelfhostResourceCellState>
    EffectAllowedInContext <SelfhostEffectContext>

impl Clone for SelfhostProofObligation:
    fn clone <(&SelfhostProofObligation)->SelfhostProofObligation> (self):
        *self

impl Copy for SelfhostProofObligation:
    fn copy_mark <(SelfhostProofObligation)->SelfhostProofObligation> (self):
        self

//: selfhost_proof_obligation_domain: obligation の domain を[返/かえ]す
pub fn selfhost_proof_obligation_domain <(SelfhostProofObligation)->SelfhostProofDomain> (obligation):
    match obligation:
        SelfhostProofObligation::SourceSpanValid _span:
            SelfhostProofDomain::Source
        SelfhostProofObligation::RawBackendTransition _state:
            SelfhostProofDomain::Module
        SelfhostProofObligation::ModuleDirectiveTransition _state:
            SelfhostProofDomain::Module
        SelfhostProofObligation::ModuleDeclarationHeaderAvailable _kind:
            SelfhostProofDomain::Module
        SelfhostProofObligation::TypeKindCompatible _kind:
            SelfhostProofDomain::Type
        SelfhostProofObligation::ResourceCellTransition _state:
            SelfhostProofDomain::Resource
        SelfhostProofObligation::EffectAllowedInContext _context:
            SelfhostProofDomain::Effect
