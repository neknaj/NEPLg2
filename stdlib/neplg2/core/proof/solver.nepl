#indent 4

//: # proof/solver
//: typed fact と obligation を[照合/しょうごう]する self-host proof solver です。
//:
//: [目的/もくてき]:
//: - 個別 checker が独自の証明器を持たず、すべての静的検査 domain が同じ query / result 境界を[使/つか]えるようにします。
//: - solver の分岐は enum の exhaustive match で[書/か]き、文字列 category や module allowlist による許可を置きません。
//:
//: [初期/しょき][範囲/はんい]:
//: - source span validity と raw backend block transition の proof を実装します。
//: - type / trait / effect / Resource IR の obligation は同じ enum / match 構造へ追加し、専用 checker-local proof を増やさない方針を固定します。

#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/proof/fact" as *
#import "neplg2/core/proof/obligation" as *
#import "neplg2/core/proof/query" as *
#import "neplg2/core/syntax/ast/module_ast" as *

//: selfhost_proof_source_span_eq: source span が同じ range か[返/かえ]す
fn selfhost_proof_source_span_eq <(SelfhostSourceSpan,SelfhostSourceSpan)->bool> (a, b):
    and and eq field::get a "file_id" field::get b "file_id" eq field::get a "start" field::get b "start" eq field::get a "end" field::get b "end"

//: selfhost_proof_source_span_fact_supports: span fact が span validity obligation を[満/み]たすか[返/かえ]す
fn selfhost_proof_source_span_fact_supports <(SelfhostSourceSpanFact,SelfhostSourceSpan)->bool> (fact, span):
    and selfhost_proof_source_span_eq fact.span span source_span_is_valid span

//: selfhost_proof_solve_source_span_valid: source span validity obligation を[解/と]く
fn selfhost_proof_solve_source_span_valid <(SelfhostSourceSpanFact,SelfhostSourceSpan)->SelfhostProofResult> (fact, span):
    if:
        selfhost_proof_source_span_fact_supports fact span
        then:
            selfhost_proof_result_proven SelfhostProofEvidence::SourceSpanValid
        else:
            selfhost_proof_result_refuted SelfhostProofRefutation::SourceSpanInvalid span

//: selfhost_raw_backend_text_matches: raw text item が open backend と[一致/いっち]するか[返/かえ]す
fn selfhost_raw_backend_text_matches <(SelfhostRawBackendKind,SelfhostRawBackendItemFact)->bool> (open_kind, item):
    match open_kind:
        SelfhostRawBackendKind::Wasm:
            match item.kind:
                SelfhostRawBackendItemKind::WasmText:
                    true
                SelfhostRawBackendItemKind::LlvmIrText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false
        SelfhostRawBackendKind::LlvmIr:
            match item.kind:
                SelfhostRawBackendItemKind::LlvmIrText:
                    true
                SelfhostRawBackendItemKind::WasmText:
                    false
                SelfhostRawBackendItemKind::NonRaw:
                    false
                SelfhostRawBackendItemKind::StreamEnd:
                    false
                SelfhostRawBackendItemKind::WasmBlock:
                    false
                SelfhostRawBackendItemKind::LlvmIrBlock:
                    false

//: selfhost_proof_raw_backend_proven: raw backend next state evidence を[返/かえ]す
fn selfhost_proof_raw_backend_proven <(SelfhostRawBackendState)->SelfhostProofResult> (state):
    selfhost_proof_result_proven SelfhostProofEvidence::RawBackendTransition state

//: selfhost_proof_raw_backend_start: raw backend block の開始を[証明/しょうめい]する
fn selfhost_proof_raw_backend_start <(SelfhostRawBackendKind,SelfhostSourceSpan)->SelfhostProofResult> (kind, span):
    selfhost_proof_raw_backend_proven selfhost_raw_backend_state_start kind span

//: selfhost_proof_raw_backend_text_without_block: raw text が block の[外/そと]にある refutation を[返/かえ]す
fn selfhost_proof_raw_backend_text_without_block <(SelfhostRawBackendItemFact)->SelfhostProofResult> (item):
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendTextWithoutBlock item

//: selfhost_proof_raw_backend_empty_block: empty raw block refutation を[返/かえ]す
fn selfhost_proof_raw_backend_empty_block <(SelfhostRawBackendOpenBlock)->SelfhostProofResult> (open_block):
    selfhost_proof_result_refuted SelfhostProofRefutation::RawBackendBlockEmpty open_block

//: selfhost_proof_solve_raw_backend_normal: Normal state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_normal <(SelfhostRawBackendItemFact)->SelfhostProofResult> (item):
    match item.kind:
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span
        SelfhostRawBackendItemKind::WasmText:
            selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            selfhost_proof_raw_backend_text_without_block item

//: selfhost_proof_solve_raw_backend_empty: empty block state の raw backend transition を[解/と]く
fn selfhost_proof_solve_raw_backend_empty <(SelfhostRawBackendOpenBlock,SelfhostRawBackendItemFact)->SelfhostProofResult> (open_block, item):
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_block.kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_block.kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_empty_block open_block
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_empty_block open_block

//: selfhost_proof_solve_raw_backend_ready: text を持つ block state の transition を[解/と]く
fn selfhost_proof_solve_raw_backend_ready <(SelfhostRawBackendKind,SelfhostRawBackendItemFact)->SelfhostProofResult> (open_kind, item):
    match item.kind:
        SelfhostRawBackendItemKind::WasmText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::LlvmIrText:
            if:
                selfhost_raw_backend_text_matches open_kind item
                then:
                    selfhost_proof_raw_backend_proven SelfhostRawBackendState::OpenReady open_kind
                else:
                    selfhost_proof_raw_backend_text_without_block item
        SelfhostRawBackendItemKind::NonRaw:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::StreamEnd:
            selfhost_proof_raw_backend_proven SelfhostRawBackendState::Normal
        SelfhostRawBackendItemKind::WasmBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::Wasm item.span
        SelfhostRawBackendItemKind::LlvmIrBlock:
            selfhost_proof_raw_backend_start SelfhostRawBackendKind::LlvmIr item.span

//: selfhost_proof_solve_raw_backend_transition: raw backend transition obligation を[解/と]く
fn selfhost_proof_solve_raw_backend_transition <(SelfhostRawBackendItemFact,SelfhostRawBackendState)->SelfhostProofResult> (item, state):
    match state:
        SelfhostRawBackendState::Normal:
            selfhost_proof_solve_raw_backend_normal item
        SelfhostRawBackendState::OpenEmpty open_block:
            selfhost_proof_solve_raw_backend_empty open_block item
        SelfhostRawBackendState::OpenReady kind:
            selfhost_proof_solve_raw_backend_ready kind item

//: selfhost_proof_module_directive_proven: module directive next state evidence を[返/かえ]す
fn selfhost_proof_module_directive_proven <(SelfhostModuleDirectiveState)->SelfhostProofResult> (state):
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDirectiveTransition state

//: selfhost_proof_module_directive_duplicate: singleton directive [重複/ちょうふく] refutation を[返/かえ]す
fn selfhost_proof_module_directive_duplicate <(SelfhostModuleDirectiveKind,SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostProofResult> (kind, first_span, duplicate_span):
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDirectiveDuplicate selfhost_module_directive_duplicate_new kind first_span duplicate_span

//: selfhost_module_directive_seen_both_state: entry / target の両方を観測済みにする
fn selfhost_module_directive_seen_both_state <(SelfhostSourceSpan,SelfhostSourceSpan)->SelfhostModuleDirectiveState> (entry_span, target_span):
    SelfhostModuleDirectiveState::EntryAndTargetSeen selfhost_module_directive_seen_both_new entry_span target_span

//: selfhost_proof_solve_module_directive_none: singleton directive 未観測 state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_none <(SelfhostModuleDirectiveFact)->SelfhostProofResult> (item):
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::NoneSeen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen item.span

//: selfhost_proof_solve_module_directive_entry_seen: entry 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_entry_seen <(SelfhostSourceSpan,SelfhostModuleDirectiveFact)->SelfhostProofResult> (entry_span, item):
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntrySeen entry_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state entry_span item.span

//: selfhost_proof_solve_module_directive_target_seen: target 観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_target_seen <(SelfhostSourceSpan,SelfhostModuleDirectiveFact)->SelfhostProofResult> (target_span, item):
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::TargetSeen target_span
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_proven selfhost_module_directive_seen_both_state item.span target_span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target target_span item.span

//: selfhost_proof_solve_module_directive_both_seen: entry / target 両方観測済み state の transition を[解/と]く
fn selfhost_proof_solve_module_directive_both_seen <(SelfhostModuleDirectiveSeenBoth,SelfhostModuleDirectiveFact)->SelfhostProofResult> (seen, item):
    match item.kind:
        SelfhostModuleDirectiveKind::Other:
            selfhost_proof_module_directive_proven SelfhostModuleDirectiveState::EntryAndTargetSeen seen
        SelfhostModuleDirectiveKind::Entry:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Entry seen.entry_span item.span
        SelfhostModuleDirectiveKind::Target:
            selfhost_proof_module_directive_duplicate SelfhostModuleDirectiveKind::Target seen.target_span item.span

//: selfhost_proof_solve_module_directive_transition: module directive transition obligation を[解/と]く
fn selfhost_proof_solve_module_directive_transition <(SelfhostModuleDirectiveFact,SelfhostModuleDirectiveState)->SelfhostProofResult> (item, state):
    match state:
        SelfhostModuleDirectiveState::NoneSeen:
            selfhost_proof_solve_module_directive_none item
        SelfhostModuleDirectiveState::EntrySeen entry_span:
            selfhost_proof_solve_module_directive_entry_seen entry_span item
        SelfhostModuleDirectiveState::TargetSeen target_span:
            selfhost_proof_solve_module_directive_target_seen target_span item
        SelfhostModuleDirectiveState::EntryAndTargetSeen seen:
            selfhost_proof_solve_module_directive_both_seen seen item

//: selfhost_proof_module_declaration_kind_eq: declaration kind が[等/ひと]しいか[返/かえ]す
fn selfhost_proof_module_declaration_kind_eq <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationKind)->bool> (left, right):
    match left:
        SelfhostModuleDeclarationKind::Function:
            match right:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match right:
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match right:
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match right:
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Impl:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match right:
                SelfhostModuleDeclarationKind::Impl:
                    true
                SelfhostModuleDeclarationKind::Function:
                    false
                SelfhostModuleDeclarationKind::Struct:
                    false
                SelfhostModuleDeclarationKind::Enum:
                    false
                SelfhostModuleDeclarationKind::Trait:
                    false

fn selfhost_proof_span_contains_span <(SelfhostSourceSpan,SelfhostSourceSpan)->bool> (outer, inner):
    and and eq outer.file_id inner.file_id le outer.start inner.start le inner.end outer.end

fn selfhost_proof_module_declaration_head_allowed <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationHeadKind)->bool> (decl_kind, head_kind):
    match decl_kind:
        SelfhostModuleDeclarationKind::Function:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
                SelfhostModuleDeclarationHeadKind::GenericParams:
                    false
        SelfhostModuleDeclarationKind::Struct:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
                SelfhostModuleDeclarationHeadKind::GenericParams:
                    false
        SelfhostModuleDeclarationKind::Enum:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
                SelfhostModuleDeclarationHeadKind::GenericParams:
                    false
        SelfhostModuleDeclarationKind::Trait:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    false
                SelfhostModuleDeclarationHeadKind::GenericParams:
                    false
        SelfhostModuleDeclarationKind::Impl:
            match head_kind:
                SelfhostModuleDeclarationHeadKind::Name:
                    true
                SelfhostModuleDeclarationHeadKind::TypeLabel:
                    true
                SelfhostModuleDeclarationHeadKind::GenericParams:
                    true

//: selfhost_proof_module_declaration_visibility_allowed: declaration kind ごとの visibility 規則を[検査/けんさ]する
//:
//: [目的/もくてき]:
//: - `impl` は AST と export model が visibility を持たないため、`pub impl` を header proof で拒否します。
//: - `fn` / `struct` / `enum` / `trait` は visibility を typed evidence として後続 resolve/export 検査へ渡せるため、ここでは両方を受け入れます。
fn selfhost_proof_module_declaration_visibility_allowed <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationVisibility)->bool> (decl_kind, visibility):
    match visibility:
        SelfhostModuleDeclarationVisibility::Private:
            true
        SelfhostModuleDeclarationVisibility::Public:
            match decl_kind:
                SelfhostModuleDeclarationKind::Function:
                    true
                SelfhostModuleDeclarationKind::Struct:
                    true
                SelfhostModuleDeclarationKind::Enum:
                    true
                SelfhostModuleDeclarationKind::Trait:
                    true
                SelfhostModuleDeclarationKind::Impl:
                    false

fn selfhost_proof_module_declaration_header_spans_valid <(SelfhostModuleDeclarationHeader)->bool> (header):
    and and source_span_is_valid header.header_span source_span_is_valid header.keyword_span selfhost_proof_span_contains_span header.header_span header.keyword_span

fn selfhost_proof_module_declaration_header_head_valid <(SelfhostModuleDeclarationHeader)->bool> (header):
    match header.head:
        Option::Some head:
            and and source_span_is_valid head.span selfhost_proof_span_contains_span header.header_span head.span selfhost_proof_module_declaration_head_allowed header.kind head.kind
        Option::None:
            false

fn selfhost_proof_module_declaration_item_kind_supports <(SelfhostModuleDeclarationFact,SelfhostModuleDeclarationKind)->bool> (fact, kind):
    match selfhost_module_item_kind_declaration fact.item_kind:
        Option::Some item_kind:
            selfhost_proof_module_declaration_kind_eq item_kind kind
        Option::None:
            false

fn selfhost_proof_module_declaration_header_supports <(SelfhostModuleDeclarationHeader,SelfhostModuleDeclarationKind)->bool> (header, kind):
    and and and selfhost_proof_module_declaration_kind_eq header.kind kind selfhost_proof_module_declaration_header_spans_valid header selfhost_proof_module_declaration_header_head_valid header selfhost_proof_module_declaration_visibility_allowed header.kind header.visibility

fn selfhost_proof_module_declaration_header_missing <(SelfhostModuleDeclarationKind,SelfhostSourceSpan)->SelfhostProofResult> (kind, span):
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderMissing selfhost_module_declaration_header_issue_new kind span

fn selfhost_proof_module_declaration_header_invalid <(SelfhostModuleDeclarationKind,SelfhostSourceSpan)->SelfhostProofResult> (kind, span):
    selfhost_proof_result_refuted SelfhostProofRefutation::ModuleDeclarationHeaderInvalid selfhost_module_declaration_header_issue_new kind span

fn selfhost_proof_module_declaration_header_proven <(SelfhostModuleDeclarationHeader)->SelfhostProofResult> (header):
    selfhost_proof_result_proven SelfhostProofEvidence::ModuleDeclarationHeaderAvailable header

//: selfhost_proof_solve_module_declaration_header: declaration header availability obligation を[解/と]く
fn selfhost_proof_solve_module_declaration_header <(SelfhostModuleDeclarationFact,SelfhostModuleDeclarationKind)->SelfhostProofResult> (fact, kind):
    if:
        selfhost_proof_module_declaration_item_kind_supports fact kind
        then:
            match fact.declaration:
                Option::Some header:
                    if:
                        selfhost_proof_module_declaration_header_supports header kind
                        then:
                            selfhost_proof_module_declaration_header_proven header
                        else:
                            selfhost_proof_module_declaration_header_invalid kind header.header_span
                Option::None:
                    selfhost_proof_module_declaration_header_missing kind fact.span
        else:
            selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch

//: selfhost_proof_solve: query を[解/と]いて typed result を[返/かえ]す
pub fn selfhost_proof_solve <(SelfhostProofQuery)->SelfhostProofResult> (query):
    match query.obligation:
        SelfhostProofObligation::SourceSpanValid span:
            match query.fact:
                SelfhostProofFact::SourceSpanObserved span_fact:
                    selfhost_proof_solve_source_span_valid span_fact span
                SelfhostProofFact::RawBackendItemObserved _item:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDirectiveObserved _directive:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDeclarationObserved _declaration:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofObligation::RawBackendTransition state:
            match query.fact:
                SelfhostProofFact::RawBackendItemObserved item:
                    selfhost_proof_solve_raw_backend_transition item state
                SelfhostProofFact::SourceSpanObserved _span_fact:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDirectiveObserved _directive:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDeclarationObserved _declaration:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofObligation::ModuleDirectiveTransition state:
            match query.fact:
                SelfhostProofFact::ModuleDirectiveObserved directive:
                    selfhost_proof_solve_module_directive_transition directive state
                SelfhostProofFact::SourceSpanObserved _span_fact:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::RawBackendItemObserved _item:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDeclarationObserved _declaration:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind:
            match query.fact:
                SelfhostProofFact::ModuleDeclarationObserved declaration:
                    selfhost_proof_solve_module_declaration_header declaration kind
                SelfhostProofFact::SourceSpanObserved _span_fact:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::RawBackendItemObserved _item:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofFact::ModuleDirectiveObserved _directive:
                    selfhost_proof_result_refuted SelfhostProofRefutation::FactObligationMismatch

//: selfhost_proof_query_source_span_valid: source span validity query を[作/つく]る
fn selfhost_proof_query_source_span_valid <(SelfhostSourceSpan)->SelfhostProofQuery> (span):
    let fact <SelfhostProofFact> SelfhostProofFact::SourceSpanObserved selfhost_source_span_fact_new span
    let obligation <SelfhostProofObligation> SelfhostProofObligation::SourceSpanValid span
    selfhost_proof_query_new fact obligation

//: selfhost_proof_source_span_valid: source span validity の typed result を[返/かえ]す
pub fn selfhost_proof_source_span_valid <(SelfhostSourceSpan)->Result<(),SelfhostProofRefutation>> (span):
    match selfhost_proof_solve selfhost_proof_query_source_span_valid span:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::SourceSpanValid:
                    Result<(),SelfhostProofRefutation>::Ok ()
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<(),SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<(),SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<(),SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofResult::Refuted refutation:
            Result<(),SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_raw_backend_transition: raw backend transition query を[作/つく]る
fn selfhost_proof_query_raw_backend_transition <(SelfhostRawBackendState,SelfhostRawBackendItemFact)->SelfhostProofQuery> (state, item):
    let fact <SelfhostProofFact> SelfhostProofFact::RawBackendItemObserved item
    let obligation <SelfhostProofObligation> SelfhostProofObligation::RawBackendTransition state
    selfhost_proof_query_new fact obligation

//: selfhost_proof_raw_backend_transition: raw backend transition の evidence を next state として[取/と]り[出/だ]す
pub fn selfhost_proof_raw_backend_transition <(SelfhostRawBackendState,SelfhostRawBackendItemFact)->Result<SelfhostRawBackendState,SelfhostProofRefutation>> (state, item):
    match selfhost_proof_solve selfhost_proof_query_raw_backend_transition state item:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::RawBackendTransition next_state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostRawBackendState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_module_directive_transition: module directive transition query を[作/つく]る
fn selfhost_proof_query_module_directive_transition <(SelfhostModuleDirectiveState,SelfhostModuleDirectiveFact)->SelfhostProofQuery> (state, item):
    let fact <SelfhostProofFact> SelfhostProofFact::ModuleDirectiveObserved item
    let obligation <SelfhostProofObligation> SelfhostProofObligation::ModuleDirectiveTransition state
    selfhost_proof_query_new fact obligation

//: selfhost_proof_module_directive_transition: module directive transition の evidence を next state として[取/と]り[出/だ]す
pub fn selfhost_proof_module_directive_transition <(SelfhostModuleDirectiveState,SelfhostModuleDirectiveFact)->Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>> (state, item):
    match selfhost_proof_solve selfhost_proof_query_module_directive_transition state item:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::ModuleDirectiveTransition next_state:
                    Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>::Ok next_state
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable _header:
                    Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostModuleDirectiveState,SelfhostProofRefutation>::Err refutation

//: selfhost_proof_query_module_declaration_header: declaration header availability query を[作/つく]る
fn selfhost_proof_query_module_declaration_header <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationFact)->SelfhostProofQuery> (kind, fact):
    let proof_fact <SelfhostProofFact> SelfhostProofFact::ModuleDeclarationObserved fact
    let obligation <SelfhostProofObligation> SelfhostProofObligation::ModuleDeclarationHeaderAvailable kind
    selfhost_proof_query_new proof_fact obligation

//: selfhost_proof_module_declaration_header: declaration header availability の typed result を[返/かえ]す
//:
//: [目的/もくてき]:
//: - parser が観測した declaration header evidence と、checker が要求する declaration kind を照合します。
//: - header が欠けている場合や span/head が不整合な場合は typed refutation を返し、caller は診断変換だけを行います。
pub fn selfhost_proof_module_declaration_header <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationFact)->Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>> (kind, fact):
    match selfhost_proof_solve selfhost_proof_query_module_declaration_header kind fact:
        SelfhostProofResult::Proven evidence:
            match evidence:
                SelfhostProofEvidence::ModuleDeclarationHeaderAvailable header:
                    Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>::Ok header
                SelfhostProofEvidence::SourceSpanValid:
                    Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::RawBackendTransition _state:
                    Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
                SelfhostProofEvidence::ModuleDirectiveTransition _state:
                    Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>::Err SelfhostProofRefutation::FactObligationMismatch
        SelfhostProofResult::Refuted refutation:
            Result<SelfhostModuleDeclarationHeader,SelfhostProofRefutation>::Err refutation
