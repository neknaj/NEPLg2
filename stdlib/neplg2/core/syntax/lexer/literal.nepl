#indent 4

//: # lexer/literal
//: numeric / string / char literal の終端走査を[定義/ていぎ]します。
//:
//: [目的/もくてき]:
//: - selfhost lexer が source text を token stream へ分けるとき、literal ごとの byte range を決めます。
//: - integer literal は prefix の種類ごとに digit 判定を分け、checker が 1 token の spelling を semantic payload へ変換できるようにします。
//: - string / char literal は closing quote の位置だけを決め、escape の意味値検査は後段の literal payload checker に残します。
//:
//: [契約/けいやく]:
//: - ここで返す offset は byte offset です。char index や source 全体と別の単位を混ぜてはいけません。
//: - `0x` / `0X` は hex、`0b` / `0B` は binary、`0o` / `0O` は octal の integer token として同一 token に含めます。
//: - invalid digit に到達した場合はその手前で token を切ります。digit の意味値検査と overflow 検査は `check/expr/literal_payload` が enum error として扱います。
//:
//: [計算量/けいさんりょう]:
//: - 各 scanner は対象 literal spelling の長さ n に対して O(n) です。

#import "core/math" as *
#import "neplg2/core/syntax/lexer/byte" as *

//: lex_is_hex_digit: ASCII hexadecimal digit byte か[返/かえ]す
//:
//: [目的/もくてき]:
//: - hex integer literal と char escape の scanner が共有する byte-level 判定です。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `0..9`、`a..f`、`A..F` の ASCII byte です。
//: - `false`: それ以外の byte または EOF sentinel です。
//:
//: [計算量/けいさんりょう]:
//: - 比較だけなので O(1) です。
pub fn lex_is_hex_digit %fn i32 bool \ch:
    let digit %bool lex_is_digit ch
    let lower %bool and ge ch 'a' le ch 'f'
    let upper %bool and ge ch 'A' le ch 'F'
    or digit or lower upper

//: lex_is_binary_digit: ASCII binary digit byte か[返/かえ]す
//:
//: [目的/もくてき]:
//: - `0b` / `0B` integer literal の scanner が、token に含めてよい digit を判定します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `0` または `1` の ASCII byte です。
//: - `false`: それ以外の byte または EOF sentinel です。
//:
//: [計算量/けいさんりょう]:
//: - 比較だけなので O(1) です。
pub fn lex_is_binary_digit %fn i32 bool \ch:
    or eq ch '0' eq ch '1'

//: lex_is_octal_digit: ASCII octal digit byte か[返/かえ]す
//:
//: [目的/もくてき]:
//: - `0o` / `0O` integer literal の scanner が、token に含めてよい digit を判定します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: `0..7` の ASCII byte です。
//: - `false`: それ以外の byte または EOF sentinel です。
//:
//: [計算量/けいさんりょう]:
//: - 比較だけなので O(1) です。
pub fn lex_is_octal_digit %fn i32 bool \ch:
    and ge ch '0' le ch '7'

//: lex_hex_int_end: hexadecimal integer literal の end offset を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `0x` / `0X` prefix の直後から hex digit が続く範囲を走査します。
//:
//: [契約/けいやく]:
//: - `idx` は digit body の先頭 byte offset です。prefix を含めた start ではありません。
//: - 空 body の場合は `idx` をそのまま返します。空 digit の拒否は checker の `I32Invalid` に委譲します。
//:
//: [戻/もど]り[値/ち]:
//: - 最初の非 hex digit または EOF の byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - digit 数 n に対して O(n) です。
pub fn lex_hex_int_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 lex_byte_or_end source idx
            if:
                lex_is_hex_digit ch
                then:
                    lex_hex_int_end source n add idx 1
                else:
                    idx

//: lex_binary_int_end: binary integer literal の end offset を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `0b` / `0B` prefix の直後から binary digit が続く範囲を走査します。
//:
//: [契約/けいやく]:
//: - `idx` は digit body の先頭 byte offset です。
//: - 空 body はここでは拒否せず、checker の `I32Invalid` に委譲します。
//:
//: [戻/もど]り[値/ち]:
//: - 最初の非 binary digit または EOF の byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - digit 数 n に対して O(n) です。
pub fn lex_binary_int_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 lex_byte_or_end source idx
            if:
                lex_is_binary_digit ch
                then:
                    lex_binary_int_end source n add idx 1
                else:
                    idx

//: lex_octal_int_end: octal integer literal の end offset を[返/かえ]す
//:
//: [目的/もくてき]:
//: - `0o` / `0O` prefix の直後から octal digit が続く範囲を走査します。
//:
//: [契約/けいやく]:
//: - `idx` は digit body の先頭 byte offset です。
//: - 空 body はここでは拒否せず、checker の `I32Invalid` に委譲します。
//:
//: [戻/もど]り[値/ち]:
//: - 最初の非 octal digit または EOF の byte offset です。
//:
//: [計算量/けいさんりょう]:
//: - digit 数 n に対して O(n) です。
pub fn lex_octal_int_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 lex_byte_or_end source idx
            if:
                lex_is_octal_digit ch
                then:
                    lex_octal_int_end source n add idx 1
                else:
                    idx

//: lex_number_end_loop: decimal integer / float literal の end offset を[返/かえ]す
pub fn lex_number_end_loop %fn str fn i32 fn i32 fn bool i32 \source\n\idx\seen_dot:
    if:
        ge idx n
        then:
            idx
        else:
            let ch %i32 lex_byte_or_end source idx
            if:
                lex_is_digit ch
                then:
                    lex_number_end_loop source n add idx 1 seen_dot
                else:
                    match ch:
                        '.':
                            if:
                                seen_dot
                                then:
                                    idx
                                else:
                                    lex_number_end_loop source n add idx 1 true
                        _:
                            idx

//: lex_range_has_dot: byte range に `.` が含まれるか[返/かえ]す
pub fn lex_range_has_dot %fn str fn i32 fn i32 bool \source\idx\end:
    if:
        ge idx end
        then:
            false
        else:
            let ch %i32 lex_byte_or_end source idx
            if:
                eq ch '.'
                then:
                    true
                else:
                    lex_range_has_dot source add idx 1 end

//: lex_string_end: closing quote の offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\"` は string 内の escaped quote として[扱/あつか]います。
pub fn lex_string_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            -1
        else:
            let ch %i32 lex_byte_or_end source idx
            match ch:
                '"':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_string_end source n add idx 2
                _:
                    lex_string_end source n add idx 1

//: lex_char_end: char literal の closing quote offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\'` は char 内の escaped quote として[扱/あつか]います。
//: - 1 scalar かどうかの検査は parser / literal lowering の責務です。
pub fn lex_char_end %fn str fn i32 fn i32 i32 \source\n\idx:
    if:
        ge idx n
        then:
            -1
        else:
            let ch %i32 lex_byte_or_end source idx
            match ch:
                '\'':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_char_end source n add idx 2
                '\n':
                    -1
                _:
                    lex_char_end source n add idx 1
