#indent 4

//: # module_ast
//: NEPLg2.1 のファイル単位 AST を置くモジュールです。
//:
//: [目的/もくてき]:
//: - lexer token stream から parser が最初に作る、module item [列/れつ]の安定した受け皿を提供します。
//: - full AST へ進む前の S1 では、top-level 宣言、directive、doc comment、raw backend block の本文を失わずに保持します。
//:
//: [実装/じっそう]:
//: - `SelfhostModuleAst` は `Vec SelfhostModuleItem` を所有します。
//: - `SelfhostModuleItem` は kind / span / lexeme に加えて、宣言 item だけが typed declaration header evidence を持ちます。
//: - declaration header evidence は keyword/head だけでなく、`%` type annotation と lambda header の token range も保持します。raw block の本文は `WasmText` / `LlvmIrText` item として行ごとに保持します。
//:
//: [注意/ちゅうい]:
//: - ここでは名前解決済みの構造や式木は持ちません。後続の item / expr parser が、同じ item stream をより細かい AST に展開します。
//: - raw block の indent 検証は `module_parser` が行い、この module は構造体と所有 buffer 操作だけを担当します。
//: - prefix range はまだ式木や型木ではありません。parser が観測した token 範囲を保持し、後続の type resolver / checker が同じ範囲を再利用して境界解決を行います。
//:
//: [計算量/けいさんりょう]:
//: - item 追加は Vec の償却 O(1)、再確保時 O(n) です。
//: - len / get は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//: fn main %impure fn void i32 \void:
//:     match selfhost_module_ast_new:
//:         Result::Ok ast0:
//:             let item %SelfhostModuleItem selfhost_module_item_new SelfhostModuleItemKind::FunctionDecl source_span_new_unchecked 0 0 2 "fn"
//:             match selfhost_module_ast_push ast0 item:
//:                 Result::Ok ast1:
//:                     let n %i32 selfhost_module_ast_len &ast1
//:                     selfhost_module_ast_free ast1
//:                     if eq n 1 0 1
//:                 Result::Err _e:
//:                     1
//:         Result::Err _e:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "core/field" as *
#import "core/math" as *

//: SelfhostModuleItemKind: module parser が最初に保持する item [種別/しゅべつ]
//:
//: [目的/もくてき]:
//: - self-host parser の初期段階で、宣言開始 token と compiler directive を安定した enum に写します。
//: - raw backend body は開始 directive と本文行を別 item にし、後続 parser が block として再構成できるようにします。
pub enum SelfhostModuleItemKind:
    DocComment
    MlstrLine
    EntryDirective
    TargetDirective
    ImportDirective
    UseDirective
    TestDirective
    IfTargetDirective
    IfProfileDirective
    CapabilityDirective
    PreludeDirective
    NoPreludeDirective
    IntrinsicDirective
    WasmBlock
    LlvmIrBlock
    WasmText
    LlvmIrText
    FunctionDecl
    StructDecl
    EnumDecl
    TraitDecl
    ImplDecl

impl Clone for SelfhostModuleItemKind:
    fn clone %fn &SelfhostModuleItemKind SelfhostModuleItemKind \self:
        *self

impl Copy for SelfhostModuleItemKind:
    fn copy_mark %fn SelfhostModuleItemKind SelfhostModuleItemKind \self:
        self

//: SelfhostModuleDeclarationKind: top-level 宣言の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - 宣言 header proof が `SelfhostModuleItemKind` 全体ではなく、宣言 domain の enum に対して行えるようにします。
pub enum SelfhostModuleDeclarationKind:
    Function
    Struct
    Enum
    Trait
    Impl

impl Clone for SelfhostModuleDeclarationKind:
    fn clone %fn &SelfhostModuleDeclarationKind SelfhostModuleDeclarationKind \self:
        *self

impl Copy for SelfhostModuleDeclarationKind:
    fn copy_mark %fn SelfhostModuleDeclarationKind SelfhostModuleDeclarationKind \self:
        self

//: SelfhostModuleDeclarationVisibility: declaration header の visibility evidence
//:
//: [目的/もくてき]:
//: - `pub` modifier を keyword token の前で捨てず、後続の resolve / export 検査へ typed value として渡します。
pub enum SelfhostModuleDeclarationVisibility:
    Private
    Public

impl Clone for SelfhostModuleDeclarationVisibility:
    fn clone %fn &SelfhostModuleDeclarationVisibility SelfhostModuleDeclarationVisibility \self:
        *self

impl Copy for SelfhostModuleDeclarationVisibility:
    fn copy_mark %fn SelfhostModuleDeclarationVisibility SelfhostModuleDeclarationVisibility \self:
        self

//: SelfhostModuleDeclarationHeadKind: declaration keyword の直後に来る head token [分類/ぶんるい]
//:
//: [目的/もくてき]:
//: - `fn` / `struct` / `enum` / `trait` は名前 token、`impl` は名前または型変数 token から始まり得ることを enum で表します。
//: - 旧 `<...>` generic parameter list は NEPLg2.1 の正規宣言 head ではないため保持しません。
//: - 不正 token は `Option::None` として保持し、checker が proof solver 経由で拒否します。
pub enum SelfhostModuleDeclarationHeadKind:
    Name
    TypeLabel

impl Clone for SelfhostModuleDeclarationHeadKind:
    fn clone %fn &SelfhostModuleDeclarationHeadKind SelfhostModuleDeclarationHeadKind \self:
        *self

impl Copy for SelfhostModuleDeclarationHeadKind:
    fn copy_mark %fn SelfhostModuleDeclarationHeadKind SelfhostModuleDeclarationHeadKind \self:
        self

//: SelfhostModuleDeclarationHead: declaration header の先頭 payload
//:
//: [目的/もくてき]:
//: - parser が declaration keyword の後に観測した token の種類と span を保持します。
//: - token の意味づけは文字列ではなく `SelfhostModuleDeclarationHeadKind` で表し、proof solver の `match` で網羅的に検査できるようにします。
pub struct SelfhostModuleDeclarationHead:
    kind %SelfhostModuleDeclarationHeadKind
    span %SelfhostSourceSpan

impl Clone for SelfhostModuleDeclarationHead:
    fn clone %fn &SelfhostModuleDeclarationHead SelfhostModuleDeclarationHead \self:
        *self

impl Copy for SelfhostModuleDeclarationHead:
    fn copy_mark %fn SelfhostModuleDeclarationHead SelfhostModuleDeclarationHead \self:
        self

//: SelfhostSyntaxRangeItems: token stream 上の nonempty syntax range payload
//:
//: [目的/もくてき]:
//: - parser が観測した連続 token 範囲を、開始 token index、token 数、source span として保持します。
//: - `-1` sentinel を使わず、空範囲は `SelfhostSyntaxRange::Empty` として表します。
pub struct SelfhostSyntaxRangeItems:
    first_token %i32
    token_count %i32
    span %SelfhostSourceSpan

impl Clone for SelfhostSyntaxRangeItems:
    fn clone %fn &SelfhostSyntaxRangeItems SelfhostSyntaxRangeItems \self:
        *self

impl Copy for SelfhostSyntaxRangeItems:
    fn copy_mark %fn SelfhostSyntaxRangeItems SelfhostSyntaxRangeItems \self:
        self

//: SelfhostSyntaxRange: parser が保持する token stream 範囲
//:
//: [目的/もくてき]:
//: - `%` type annotation、lambda header、prefix expression など、後段で構造化される構文単位の入力範囲を保持します。
//: - 空範囲を enum variant に分けることで、checker が payload の存在を match で確認できます。
pub enum SelfhostSyntaxRange:
    Empty
    Range %SelfhostSyntaxRangeItems

impl Clone for SelfhostSyntaxRange:
    fn clone %fn &SelfhostSyntaxRange SelfhostSyntaxRange \self:
        *self

impl Copy for SelfhostSyntaxRange:
    fn copy_mark %fn SelfhostSyntaxRange SelfhostSyntaxRange \self:
        self

//: SelfhostModuleDeclarationHeader: parser が観測した declaration header evidence
//:
//: [目的/もくてき]:
//: - keyword token だけでなく、visibility、header 全体の span、keyword span、head token、type annotation range、lambda header range を保持します。
//: - 後続 stage は宣言 header を文字列再走査せず、typed fact として proof solver へ渡します。
pub struct SelfhostModuleDeclarationHeader:
    kind %SelfhostModuleDeclarationKind
    visibility %SelfhostModuleDeclarationVisibility
    header_span %SelfhostSourceSpan
    keyword_span %SelfhostSourceSpan
    head %Option SelfhostModuleDeclarationHead
    type_annotation %SelfhostSyntaxRange
    lambda_header %SelfhostSyntaxRange

impl Clone for SelfhostModuleDeclarationHeader:
    fn clone %fn &SelfhostModuleDeclarationHeader SelfhostModuleDeclarationHeader \self:
        *self

impl Copy for SelfhostModuleDeclarationHeader:
    fn copy_mark %fn SelfhostModuleDeclarationHeader SelfhostModuleDeclarationHeader \self:
        self

//: SelfhostModuleItem: module parser の 1 item
//:
//: [目的/もくてき]:
//: - item kind、source span、元 lexeme をまとめて保持します。
//: - raw text 行も通常 item と同じ形にして、AST JSON parity の比較を単純にします。
pub struct SelfhostModuleItem:
    kind %SelfhostModuleItemKind
    span %SelfhostSourceSpan
    lexeme %str
    declaration %Option SelfhostModuleDeclarationHeader

impl Clone for SelfhostModuleItem:
    fn clone %fn &SelfhostModuleItem SelfhostModuleItem \self:
        *self

impl Copy for SelfhostModuleItem:
    fn copy_mark %fn SelfhostModuleItem SelfhostModuleItem \self:
        self

//: SelfhostModuleAst: module item [列/れつ]を所有する AST root
pub struct SelfhostModuleAst:
    items %Vec SelfhostModuleItem

//: selfhost_module_item_new: module item を[構築/こうちく]する
//:
//: [注意/ちゅうい]:
//: - declaration header evidence を持たない item を作ります。
//: - declaration item に対してこの constructor を使うと、module checker は proof solver 経由で header 欠落として拒否します。
pub fn selfhost_module_item_new %fn SelfhostModuleItemKind fn SelfhostSourceSpan fn str SelfhostModuleItem \kind\span\lexeme:
    SelfhostModuleItem kind span lexeme none

//: selfhost_module_declaration_head_new: declaration head evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - parser が観測した head token を typed evidence としてまとめます。
pub fn selfhost_module_declaration_head_new %fn SelfhostModuleDeclarationHeadKind fn SelfhostSourceSpan SelfhostModuleDeclarationHead \kind\span:
    SelfhostModuleDeclarationHead kind span

//: selfhost_syntax_range_empty: syntax range が存在しないことを[返/かえ]す
pub fn selfhost_syntax_range_empty %fn void SelfhostSyntaxRange \void:
    SelfhostSyntaxRange::Empty

//: selfhost_syntax_range_new_unchecked: parser 内で証明済みの nonempty syntax range を[作/つく]る
//:
//: [注意/ちゅうい]:
//: - この関数は `first_token >= 0`、`token_count > 0`、span が有効であることを検査しません。
//: - 同じ token stream 走査内で開始・終了 token を確認済みの parser helper だけが使います。
pub fn selfhost_syntax_range_new_unchecked %fn i32 fn i32 fn SelfhostSourceSpan SelfhostSyntaxRange \first_token\token_count\span:
    SelfhostSyntaxRange::Range SelfhostSyntaxRangeItems first_token token_count span

//: selfhost_syntax_range_is_nonempty: range payload が存在するか[返/かえ]す
pub fn selfhost_syntax_range_is_nonempty %fn SelfhostSyntaxRange bool \syntax_range:
    match syntax_range:
        SelfhostSyntaxRange::Empty:
            false
        SelfhostSyntaxRange::Range _items:
            true

//: selfhost_syntax_range_is_valid: range payload が内部不変条件を満たすか[返/かえ]す
pub fn selfhost_syntax_range_is_valid %fn SelfhostSyntaxRange bool \syntax_range:
    match syntax_range:
        SelfhostSyntaxRange::Empty:
            true
        SelfhostSyntaxRange::Range items:
            and:
                ge items.first_token 0
                and gt items.token_count 0 and le items.token_count sub 2147483647 items.first_token source_span_is_valid items.span

//: selfhost_syntax_range_span_is_inside: nonempty range の span が outer に含まれるか[返/かえ]す
//:
//: [目的/もくてき]:
//: - checker が declaration header の中に parser-provided range evidence が閉じていることを確認するための純粋 helper です。
//: - `Empty` は「存在しない範囲」なので、containment 検査では true として扱います。存在必須かどうかは別の obligation が判断します。
pub fn selfhost_syntax_range_span_is_inside %fn SelfhostSyntaxRange fn SelfhostSourceSpan bool \syntax_range\outer:
    match syntax_range:
        SelfhostSyntaxRange::Empty:
            true
        SelfhostSyntaxRange::Range items:
            and and eq outer.file_id items.span.file_id le outer.start items.span.start le items.span.end outer.end

//: selfhost_module_declaration_header_new: declaration header evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - declaration keyword、visibility、header 全体の span、head token、type/lambda range を 1 つの証拠として保持します。
//: - checker はこの値を直接解釈せず、proof solver の obligation と照合します。
pub fn selfhost_module_declaration_header_new %fn SelfhostModuleDeclarationKind fn SelfhostModuleDeclarationVisibility fn SelfhostSourceSpan fn SelfhostSourceSpan fn Option SelfhostModuleDeclarationHead fn SelfhostSyntaxRange fn SelfhostSyntaxRange SelfhostModuleDeclarationHeader \kind\visibility\header_span\keyword_span\head\type_annotation\lambda_header:
    SelfhostModuleDeclarationHeader kind visibility header_span keyword_span head type_annotation lambda_header

//: selfhost_module_item_new_with_declaration: declaration header を持つ module item を[構築/こうちく]する
//:
//: [目的/もくてき]:
//: - parser が declaration item と header evidence を同時に AST へ載せるための constructor です。
//: - item span は header span と同一にし、source fact の範囲が後続 proof とずれないようにします。
pub fn selfhost_module_item_new_with_declaration %fn SelfhostModuleItemKind fn str fn SelfhostModuleDeclarationHeader SelfhostModuleItem \kind\lexeme\declaration:
    SelfhostModuleItem kind declaration.header_span lexeme some declaration

//: selfhost_module_item_kind_declaration: item kind を declaration kind へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - module item enum と declaration header enum の対応を 1 か所に集約します。
//: - declaration ではない item は `None` として返し、checker が不要な proof obligation を作らないようにします。
pub fn selfhost_module_item_kind_declaration %fn SelfhostModuleItemKind Option SelfhostModuleDeclarationKind \kind:
    match kind:
        SelfhostModuleItemKind::FunctionDecl:
            some SelfhostModuleDeclarationKind::Function
        SelfhostModuleItemKind::StructDecl:
            some SelfhostModuleDeclarationKind::Struct
        SelfhostModuleItemKind::EnumDecl:
            some SelfhostModuleDeclarationKind::Enum
        SelfhostModuleItemKind::TraitDecl:
            some SelfhostModuleDeclarationKind::Trait
        SelfhostModuleItemKind::ImplDecl:
            some SelfhostModuleDeclarationKind::Impl
        SelfhostModuleItemKind::DocComment:
            none
        SelfhostModuleItemKind::MlstrLine:
            none
        SelfhostModuleItemKind::EntryDirective:
            none
        SelfhostModuleItemKind::TargetDirective:
            none
        SelfhostModuleItemKind::ImportDirective:
            none
        SelfhostModuleItemKind::UseDirective:
            none
        SelfhostModuleItemKind::TestDirective:
            none
        SelfhostModuleItemKind::IfTargetDirective:
            none
        SelfhostModuleItemKind::IfProfileDirective:
            none
        SelfhostModuleItemKind::CapabilityDirective:
            none
        SelfhostModuleItemKind::PreludeDirective:
            none
        SelfhostModuleItemKind::NoPreludeDirective:
            none
        SelfhostModuleItemKind::IntrinsicDirective:
            none
        SelfhostModuleItemKind::WasmBlock:
            none
        SelfhostModuleItemKind::LlvmIrBlock:
            none
        SelfhostModuleItemKind::WasmText:
            none
        SelfhostModuleItemKind::LlvmIrText:
            none

//: selfhost_module_item_kind_name: item kind の安定名を[返/かえ]す
pub fn selfhost_module_item_kind_name %fn SelfhostModuleItemKind str \kind:
    match kind:
        SelfhostModuleItemKind::DocComment:
            "DocComment"
        SelfhostModuleItemKind::MlstrLine:
            "MlstrLine"
        SelfhostModuleItemKind::EntryDirective:
            "EntryDirective"
        SelfhostModuleItemKind::TargetDirective:
            "TargetDirective"
        SelfhostModuleItemKind::ImportDirective:
            "ImportDirective"
        SelfhostModuleItemKind::UseDirective:
            "UseDirective"
        SelfhostModuleItemKind::TestDirective:
            "TestDirective"
        SelfhostModuleItemKind::IfTargetDirective:
            "IfTargetDirective"
        SelfhostModuleItemKind::IfProfileDirective:
            "IfProfileDirective"
        SelfhostModuleItemKind::CapabilityDirective:
            "CapabilityDirective"
        SelfhostModuleItemKind::PreludeDirective:
            "PreludeDirective"
        SelfhostModuleItemKind::NoPreludeDirective:
            "NoPreludeDirective"
        SelfhostModuleItemKind::IntrinsicDirective:
            "IntrinsicDirective"
        SelfhostModuleItemKind::WasmBlock:
            "WasmBlock"
        SelfhostModuleItemKind::LlvmIrBlock:
            "LlvmIrBlock"
        SelfhostModuleItemKind::WasmText:
            "WasmText"
        SelfhostModuleItemKind::LlvmIrText:
            "LlvmIrText"
        SelfhostModuleItemKind::FunctionDecl:
            "FunctionDecl"
        SelfhostModuleItemKind::StructDecl:
            "StructDecl"
        SelfhostModuleItemKind::EnumDecl:
            "EnumDecl"
        SelfhostModuleItemKind::TraitDecl:
            "TraitDecl"
        SelfhostModuleItemKind::ImplDecl:
            "ImplDecl"

//: selfhost_module_ast_new: [空/から]の module AST を[作/つく]る
pub fn selfhost_module_ast_new %impure fn void Result SelfhostModuleAst StdErrorKind \void:
    let items_result %Result Vec SelfhostModuleItem StdErrorKind v::new
    match items_result:
        Result::Ok items:
            Result::Ok SelfhostModuleAst items
        Result::Err e:
            Result::Err e

//: selfhost_module_ast_push: module item を 1 件[追加/ついか]する
pub fn selfhost_module_ast_push %impure fn SelfhostModuleAst impure fn SelfhostModuleItem Result SelfhostModuleAst StdErrorKind \ast\item:
    match v::push field::get ast "items" item:
        Result::Ok items:
            Result::Ok SelfhostModuleAst items
        Result::Err e:
            let error %StdErrorKind field::get e "error"
            v::free v::vec_push_error_vec e
            Result::Err error

//: selfhost_module_ast_len: module item [数/すう]を[返/かえ]す
pub fn selfhost_module_ast_len %fn &SelfhostModuleAst i32 \ast:
    let items %&Vec SelfhostModuleItem field::get_ref ast "items"
    v::len items

//: selfhost_module_ast_get: index の module item を[返/かえ]す
pub fn selfhost_module_ast_get %fn &SelfhostModuleAst fn i32 Option SelfhostModuleItem \ast\idx:
    let items %&Vec SelfhostModuleItem field::get_ref ast "items"
    v::get items idx

//: selfhost_module_ast_free: module AST が所有する item buffer を[解放/かいほう]する
pub fn selfhost_module_ast_free %impure fn SelfhostModuleAst unit \ast:
    v::free field::get ast "items"

//: selfhost_module_ast_stage0: AST root の smoke API
pub fn selfhost_module_ast_stage0 %impure fn void i32 \void:
    match selfhost_module_ast_new:
        Result::Ok ast:
            let n %i32 selfhost_module_ast_len &ast
            selfhost_module_ast_free ast
            n
        Result::Err _e:
            1
