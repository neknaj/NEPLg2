#indent 4

//: # module_ast
//: NEPLg2.0 のファイル単位 AST を置くモジュールです。
//:
//: [目的/もくてき]:
//: - lexer token stream から parser が最初に作る、module item [列/れつ]の安定した受け皿を提供します。
//: - full AST へ進む前の S1 では、top-level 宣言、directive、doc comment、raw backend block の本文を失わずに保持します。
//:
//: [実装/じっそう]:
//: - `SelfhostModuleAst` は `Vec<SelfhostModuleItem>` を所有します。
//: - `SelfhostModuleItem` は kind / span / lexeme に加えて、宣言 item だけが typed declaration header evidence を持ちます。raw block の本文は `WasmText` / `LlvmIrText` item として行ごとに保持します。
//:
//: [注意/ちゅうい]:
//: - ここでは名前解決済みの構造や式木は持ちません。後続の item / expr parser が、同じ item stream をより細かい AST に展開します。
//: - raw block の indent 検証は `module_parser` が行い、この module は構造体と所有 buffer 操作だけを担当します。
//:
//: [計算量/けいさんりょう]:
//: - item 追加は Vec の償却 O(1)、再確保時 O(n) です。
//: - len / get は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/math" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//: fn main <()*>i32> ():
//:     match selfhost_module_ast_new:
//:         Result::Ok ast0:
//:             let item <SelfhostModuleItem> selfhost_module_item_new SelfhostModuleItemKind::FunctionDecl source_span_new 0 0 2 "fn"
//:             match selfhost_module_ast_push ast0 item:
//:                 Result::Ok ast1:
//:                     let n <i32> selfhost_module_ast_len &ast1
//:                     selfhost_module_ast_free ast1
//:                     if eq n 1 0 1
//:                 Result::Err _e:
//:                     1
//:         Result::Err _e:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "core/field" as *
#import "core/math" as *

//: SelfhostModuleItemKind: module parser が最初に保持する item [種別/しゅべつ]
//:
//: [目的/もくてき]:
//: - self-host parser の初期段階で、宣言開始 token と compiler directive を安定した enum に写します。
//: - raw backend body は開始 directive と本文行を別 item にし、後続 parser が block として再構成できるようにします。
pub enum SelfhostModuleItemKind:
    DocComment
    MlstrLine
    EntryDirective
    TargetDirective
    ImportDirective
    UseDirective
    IfTargetDirective
    IfProfileDirective
    CapabilityDirective
    PreludeDirective
    NoPreludeDirective
    IntrinsicDirective
    WasmBlock
    LlvmIrBlock
    WasmText
    LlvmIrText
    FunctionDecl
    StructDecl
    EnumDecl
    TraitDecl
    ImplDecl

impl Clone for SelfhostModuleItemKind:
    fn clone <(&SelfhostModuleItemKind)->SelfhostModuleItemKind> (self):
        *self

impl Copy for SelfhostModuleItemKind:
    fn copy_mark <(SelfhostModuleItemKind)->SelfhostModuleItemKind> (self):
        self

//: SelfhostModuleDeclarationKind: top-level 宣言の[種類/しゅるい]
//:
//: [目的/もくてき]:
//: - 宣言 header proof が `SelfhostModuleItemKind` 全体ではなく、宣言 domain の enum に対して行えるようにします。
pub enum SelfhostModuleDeclarationKind:
    Function
    Struct
    Enum
    Trait
    Impl

impl Clone for SelfhostModuleDeclarationKind:
    fn clone <(&SelfhostModuleDeclarationKind)->SelfhostModuleDeclarationKind> (self):
        *self

impl Copy for SelfhostModuleDeclarationKind:
    fn copy_mark <(SelfhostModuleDeclarationKind)->SelfhostModuleDeclarationKind> (self):
        self

//: SelfhostModuleDeclarationVisibility: declaration header の visibility evidence
//:
//: [目的/もくてき]:
//: - `pub` modifier を keyword token の前で捨てず、後続の resolve / export 検査へ typed value として渡します。
pub enum SelfhostModuleDeclarationVisibility:
    Private
    Public

impl Clone for SelfhostModuleDeclarationVisibility:
    fn clone <(&SelfhostModuleDeclarationVisibility)->SelfhostModuleDeclarationVisibility> (self):
        *self

impl Copy for SelfhostModuleDeclarationVisibility:
    fn copy_mark <(SelfhostModuleDeclarationVisibility)->SelfhostModuleDeclarationVisibility> (self):
        self

//: SelfhostModuleDeclarationHeadKind: declaration keyword の直後に来る head token [分類/ぶんるい]
//:
//: [目的/もくてき]:
//: - `fn` / `struct` / `enum` / `trait` は名前 token、`impl` は名前・型変数・generic parameter list から始まり得ることを enum で表します。
//: - 不正 token は `Option::None` として保持し、checker が proof solver 経由で拒否します。
pub enum SelfhostModuleDeclarationHeadKind:
    Name
    TypeLabel
    GenericParams

impl Clone for SelfhostModuleDeclarationHeadKind:
    fn clone <(&SelfhostModuleDeclarationHeadKind)->SelfhostModuleDeclarationHeadKind> (self):
        *self

impl Copy for SelfhostModuleDeclarationHeadKind:
    fn copy_mark <(SelfhostModuleDeclarationHeadKind)->SelfhostModuleDeclarationHeadKind> (self):
        self

//: SelfhostModuleDeclarationHead: declaration header の先頭 payload
//:
//: [目的/もくてき]:
//: - parser が declaration keyword の後に観測した token の種類と span を保持します。
//: - token の意味づけは文字列ではなく `SelfhostModuleDeclarationHeadKind` で表し、proof solver の `match` で網羅的に検査できるようにします。
pub struct SelfhostModuleDeclarationHead:
    kind <SelfhostModuleDeclarationHeadKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostModuleDeclarationHead:
    fn clone <(&SelfhostModuleDeclarationHead)->SelfhostModuleDeclarationHead> (self):
        *self

impl Copy for SelfhostModuleDeclarationHead:
    fn copy_mark <(SelfhostModuleDeclarationHead)->SelfhostModuleDeclarationHead> (self):
        self

//: SelfhostModuleDeclarationHeader: parser が観測した declaration header evidence
//:
//: [目的/もくてき]:
//: - keyword token だけでなく、visibility、header 全体の span、keyword span、head token を保持します。
//: - 後続 stage は宣言 header を文字列再走査せず、typed fact として proof solver へ渡します。
pub struct SelfhostModuleDeclarationHeader:
    kind <SelfhostModuleDeclarationKind>
    visibility <SelfhostModuleDeclarationVisibility>
    header_span <SelfhostSourceSpan>
    keyword_span <SelfhostSourceSpan>
    head <Option<SelfhostModuleDeclarationHead>>

impl Clone for SelfhostModuleDeclarationHeader:
    fn clone <(&SelfhostModuleDeclarationHeader)->SelfhostModuleDeclarationHeader> (self):
        *self

impl Copy for SelfhostModuleDeclarationHeader:
    fn copy_mark <(SelfhostModuleDeclarationHeader)->SelfhostModuleDeclarationHeader> (self):
        self

//: SelfhostModuleItem: module parser の 1 item
//:
//: [目的/もくてき]:
//: - item kind、source span、元 lexeme をまとめて保持します。
//: - raw text 行も通常 item と同じ形にして、AST JSON parity の比較を単純にします。
pub struct SelfhostModuleItem:
    kind <SelfhostModuleItemKind>
    span <SelfhostSourceSpan>
    lexeme <str>
    declaration <Option<SelfhostModuleDeclarationHeader>>

impl Clone for SelfhostModuleItem:
    fn clone <(&SelfhostModuleItem)->SelfhostModuleItem> (self):
        *self

impl Copy for SelfhostModuleItem:
    fn copy_mark <(SelfhostModuleItem)->SelfhostModuleItem> (self):
        self

//: SelfhostModuleAst: module item [列/れつ]を所有する AST root
pub struct SelfhostModuleAst:
    items <Vec<SelfhostModuleItem>>

//: selfhost_module_item_new: module item を[構築/こうちく]する
//:
//: [注意/ちゅうい]:
//: - declaration header evidence を持たない item を作ります。
//: - declaration item に対してこの constructor を使うと、module checker は proof solver 経由で header 欠落として拒否します。
pub fn selfhost_module_item_new <(SelfhostModuleItemKind,SelfhostSourceSpan,str)->SelfhostModuleItem> (kind, span, lexeme):
    SelfhostModuleItem kind span lexeme none<SelfhostModuleDeclarationHeader>

//: selfhost_module_declaration_head_new: declaration head evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - parser が観測した head token を typed evidence としてまとめます。
pub fn selfhost_module_declaration_head_new <(SelfhostModuleDeclarationHeadKind,SelfhostSourceSpan)->SelfhostModuleDeclarationHead> (kind, span):
    SelfhostModuleDeclarationHead kind span

//: selfhost_module_declaration_header_new: declaration header evidence を[作/つく]る
//:
//: [目的/もくてき]:
//: - declaration keyword、visibility、header 全体の span、head token を 1 つの証拠として保持します。
//: - checker はこの値を直接解釈せず、proof solver の obligation と照合します。
pub fn selfhost_module_declaration_header_new <(SelfhostModuleDeclarationKind,SelfhostModuleDeclarationVisibility,SelfhostSourceSpan,SelfhostSourceSpan,Option<SelfhostModuleDeclarationHead>)->SelfhostModuleDeclarationHeader> (kind, visibility, header_span, keyword_span, head):
    SelfhostModuleDeclarationHeader kind visibility header_span keyword_span head

//: selfhost_module_item_new_with_declaration: declaration header を持つ module item を[構築/こうちく]する
//:
//: [目的/もくてき]:
//: - parser が declaration item と header evidence を同時に AST へ載せるための constructor です。
//: - item span は header span と同一にし、source fact の範囲が後続 proof とずれないようにします。
pub fn selfhost_module_item_new_with_declaration <(SelfhostModuleItemKind,str,SelfhostModuleDeclarationHeader)->SelfhostModuleItem> (kind, lexeme, declaration):
    SelfhostModuleItem kind declaration.header_span lexeme some<SelfhostModuleDeclarationHeader> declaration

//: selfhost_module_item_kind_declaration: item kind を declaration kind へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - module item enum と declaration header enum の対応を 1 か所に集約します。
//: - declaration ではない item は `None` として返し、checker が不要な proof obligation を作らないようにします。
pub fn selfhost_module_item_kind_declaration <(SelfhostModuleItemKind)->Option<SelfhostModuleDeclarationKind>> (kind):
    match kind:
        SelfhostModuleItemKind::FunctionDecl:
            some<SelfhostModuleDeclarationKind> SelfhostModuleDeclarationKind::Function
        SelfhostModuleItemKind::StructDecl:
            some<SelfhostModuleDeclarationKind> SelfhostModuleDeclarationKind::Struct
        SelfhostModuleItemKind::EnumDecl:
            some<SelfhostModuleDeclarationKind> SelfhostModuleDeclarationKind::Enum
        SelfhostModuleItemKind::TraitDecl:
            some<SelfhostModuleDeclarationKind> SelfhostModuleDeclarationKind::Trait
        SelfhostModuleItemKind::ImplDecl:
            some<SelfhostModuleDeclarationKind> SelfhostModuleDeclarationKind::Impl
        SelfhostModuleItemKind::DocComment:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::MlstrLine:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::EntryDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::TargetDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::ImportDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::UseDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::IfTargetDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::IfProfileDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::CapabilityDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::PreludeDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::NoPreludeDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::IntrinsicDirective:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::WasmBlock:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::LlvmIrBlock:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::WasmText:
            none<SelfhostModuleDeclarationKind>
        SelfhostModuleItemKind::LlvmIrText:
            none<SelfhostModuleDeclarationKind>

//: selfhost_module_item_kind_name: item kind の安定名を[返/かえ]す
pub fn selfhost_module_item_kind_name <(SelfhostModuleItemKind)->str> (kind):
    match kind:
        SelfhostModuleItemKind::DocComment:
            "DocComment"
        SelfhostModuleItemKind::MlstrLine:
            "MlstrLine"
        SelfhostModuleItemKind::EntryDirective:
            "EntryDirective"
        SelfhostModuleItemKind::TargetDirective:
            "TargetDirective"
        SelfhostModuleItemKind::ImportDirective:
            "ImportDirective"
        SelfhostModuleItemKind::UseDirective:
            "UseDirective"
        SelfhostModuleItemKind::IfTargetDirective:
            "IfTargetDirective"
        SelfhostModuleItemKind::IfProfileDirective:
            "IfProfileDirective"
        SelfhostModuleItemKind::CapabilityDirective:
            "CapabilityDirective"
        SelfhostModuleItemKind::PreludeDirective:
            "PreludeDirective"
        SelfhostModuleItemKind::NoPreludeDirective:
            "NoPreludeDirective"
        SelfhostModuleItemKind::IntrinsicDirective:
            "IntrinsicDirective"
        SelfhostModuleItemKind::WasmBlock:
            "WasmBlock"
        SelfhostModuleItemKind::LlvmIrBlock:
            "LlvmIrBlock"
        SelfhostModuleItemKind::WasmText:
            "WasmText"
        SelfhostModuleItemKind::LlvmIrText:
            "LlvmIrText"
        SelfhostModuleItemKind::FunctionDecl:
            "FunctionDecl"
        SelfhostModuleItemKind::StructDecl:
            "StructDecl"
        SelfhostModuleItemKind::EnumDecl:
            "EnumDecl"
        SelfhostModuleItemKind::TraitDecl:
            "TraitDecl"
        SelfhostModuleItemKind::ImplDecl:
            "ImplDecl"

//: selfhost_module_ast_new: [空/から]の module AST を[作/つく]る
pub fn selfhost_module_ast_new <()*>Result<SelfhostModuleAst, StdErrorKind>> ():
    match v::new<SelfhostModuleItem>:
        Result::Ok items:
            Result<SelfhostModuleAst, StdErrorKind>::Ok SelfhostModuleAst items
        Result::Err e:
            Result<SelfhostModuleAst, StdErrorKind>::Err e

//: selfhost_module_ast_push: module item を 1 件[追加/ついか]する
pub fn selfhost_module_ast_push <(SelfhostModuleAst,SelfhostModuleItem)*>Result<SelfhostModuleAst, StdErrorKind>> (ast, item):
    match v::push<SelfhostModuleItem> field::get ast "items" item:
        Result::Ok items:
            Result<SelfhostModuleAst, StdErrorKind>::Ok SelfhostModuleAst items
        Result::Err e:
            let error <StdErrorKind> field::get e "error"
            v::free<SelfhostModuleItem> field::get e "vec"
            Result<SelfhostModuleAst, StdErrorKind>::Err error

//: selfhost_module_ast_len: module item [数/すう]を[返/かえ]す
pub fn selfhost_module_ast_len <(&SelfhostModuleAst)->i32> (ast):
    let items <&Vec<SelfhostModuleItem>> field::get_ref ast "items"
    v::len<SelfhostModuleItem> items

//: selfhost_module_ast_get: index の module item を[返/かえ]す
pub fn selfhost_module_ast_get <(&SelfhostModuleAst,i32)->Option<SelfhostModuleItem>> (ast, idx):
    let items <&Vec<SelfhostModuleItem>> field::get_ref ast "items"
    v::get<SelfhostModuleItem> items idx

//: selfhost_module_ast_free: module AST が所有する item buffer を[解放/かいほう]する
pub fn selfhost_module_ast_free <(SelfhostModuleAst)*>()> (ast):
    v::free<SelfhostModuleItem> field::get ast "items"

//: selfhost_module_ast_stage0: AST root の smoke API
pub fn selfhost_module_ast_stage0 <()*>i32> ():
    match selfhost_module_ast_new:
        Result::Ok ast:
            let n <i32> selfhost_module_ast_len &ast
            selfhost_module_ast_free ast
            n
        Result::Err _e:
            1
