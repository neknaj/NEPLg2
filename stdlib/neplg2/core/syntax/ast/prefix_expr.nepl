//: selfhost_expr_prefix_build_error_kind_eq: build error kind が同じ分類か[返/かえ]す
pub fn selfhost_expr_prefix_build_error_kind_eq %fn SelfhostExprPrefixBuildErrorKind fn SelfhostExprPrefixBuildErrorKind bool \a\b:
    match a:
        SelfhostExprPrefixBuildErrorKind::EmptySyntaxRange:
            match b:
                SelfhostExprPrefixBuildErrorKind::EmptySyntaxRange:
                    true
                _:
                    false
        SelfhostExprPrefixBuildErrorKind::InvalidSyntaxRange:
            match b:
                SelfhostExprPrefixBuildErrorKind::InvalidSyntaxRange:
                    true
                _:
                    false
        SelfhostExprPrefixBuildErrorKind::TokenOutOfBounds:
            match b:
                SelfhostExprPrefixBuildErrorKind::TokenOutOfBounds:
                    true
                _:
                    false
        SelfhostExprPrefixBuildErrorKind::MissingExpressionStart:
            match b:
                SelfhostExprPrefixBuildErrorKind::MissingExpressionStart:
                    true
                _:
                    false
        SelfhostExprPrefixBuildErrorKind::InvalidToken:
            match b:
                SelfhostExprPrefixBuildErrorKind::InvalidToken:
                    true
                _:
                    false
        SelfhostExprPrefixBuildErrorKind::OutOfMemory:
            match b:
                SelfhostExprPrefixBuildErrorKind::OutOfMemory:
                    true
                _:
                    false

//: selfhost_expr_prefix_item_new: prefix expression item payload を[作/つく]る
pub fn selfhost_expr_prefix_item_new %fn SelfhostExprPrefixItemKind fn i32 fn SelfhostSourceSpan SelfhostExprPrefixItem \kind\token_index\span:
    SelfhostExprPrefixItem kind token_index span

//: selfhost_expr_prefix_build_error_new: build error payload を[作/つく]る
pub fn selfhost_expr_prefix_build_error_new %fn SelfhostExprPrefixBuildErrorKind fn SelfhostSourceSpan SelfhostExprPrefixBuildError \kind\span:
    SelfhostExprPrefixBuildError kind span

//: selfhost_expr_prefix_list_new: prefix item buffer owner を list に[包/つつ]む
pub fn selfhost_expr_prefix_list_new %impure fn Vec SelfhostExprPrefixItem SelfhostExprPrefixList \items:
    SelfhostExprPrefixList items

//: selfhost_expr_prefix_item_kind_from_token: token kind を expression prefix item kind へ[写/うつ]す
//:
//: [目的/もくてき]:
//: - expression reduction が受け付ける token だけを `Some` にします。
//: - `KwFn`、`VoidMarker`、`KwTuple` は expression value ではありませんが、`%` type ascription の内部 token として prefix expression list に現れるため保持します。
//: - `Minus` は `MinusMarker` として保持します。直後が数値 literal の場合でも、この module では結合せず、source-backed argument checker が expected type と一緒に consume-width を決めます。
pub fn selfhost_expr_prefix_item_kind_from_token %fn TokenKind Option SelfhostExprPrefixItemKind \kind:
    match kind:
        TokenKind::Percent:
            some SelfhostExprPrefixItemKind::TypeAnnotationMarker
        TokenKind::Backslash:
            some SelfhostExprPrefixItemKind::LambdaMarker
        TokenKind::KwFn:
            some SelfhostExprPrefixItemKind::FunctionTypeMarker
        TokenKind::VoidMarker:
            some SelfhostExprPrefixItemKind::VoidMarker
        TokenKind::At:
            some SelfhostExprPrefixItemKind::AtMarker
        TokenKind::PathSep:
            some SelfhostExprPrefixItemKind::PathSeparator
        TokenKind::Dot:
            some SelfhostExprPrefixItemKind::MemberMarker
        TokenKind::Ampersand:
            some SelfhostExprPrefixItemKind::BorrowMarker
        TokenKind::Star:
            some SelfhostExprPrefixItemKind::PointerMarker
        TokenKind::Minus:
            some SelfhostExprPrefixItemKind::MinusMarker
        TokenKind::Pipe:
            some SelfhostExprPrefixItemKind::PipeOperator
        TokenKind::Ident:
            some SelfhostExprPrefixItemKind::NamedValue
        TokenKind::UnitLiteral:
            some SelfhostExprPrefixItemKind::UnitValue
        TokenKind::IntLiteral:
            some SelfhostExprPrefixItemKind::IntLiteral
        TokenKind::FloatLiteral:
            some SelfhostExprPrefixItemKind::FloatLiteral
        TokenKind::BoolLiteral:
            some SelfhostExprPrefixItemKind::BoolLiteral
        TokenKind::CharLiteral:
            some SelfhostExprPrefixItemKind::CharLiteral
        TokenKind::StringLiteral:
            some SelfhostExprPrefixItemKind::StringLiteral
        TokenKind::KwLet:
            some SelfhostExprPrefixItemKind::LetMarker
        TokenKind::KwMut:
            some SelfhostExprPrefixItemKind::MutMarker
        TokenKind::KwNoShadow:
            some SelfhostExprPrefixItemKind::NoShadowMarker
        TokenKind::KwSet:
            some SelfhostExprPrefixItemKind::SetMarker
        TokenKind::KwIf:
            some SelfhostExprPrefixItemKind::IfMarker
        TokenKind::KwWhile:
            some SelfhostExprPrefixItemKind::WhileMarker
        TokenKind::KwCond:
            some SelfhostExprPrefixItemKind::CondMarker
        TokenKind::KwThen:
            some SelfhostExprPrefixItemKind::ThenMarker
        TokenKind::KwElse:
            some SelfhostExprPrefixItemKind::ElseMarker
        TokenKind::KwDo:
            some SelfhostExprPrefixItemKind::DoMarker
        TokenKind::KwMatch:
            some SelfhostExprPrefixItemKind::MatchMarker
        TokenKind::KwBlock:
            some SelfhostExprPrefixItemKind::BlockMarker
        TokenKind::KwTuple:
            some SelfhostExprPrefixItemKind::TupleTypeMarker
        _:
            none

//: selfhost_expr_prefix_item_from_token: token から prefix expression item を[作/つく]る
pub fn selfhost_expr_prefix_item_from_token %fn SelfhostToken fn i32 Option SelfhostExprPrefixItem \token\token_index:
    match selfhost_expr_prefix_item_kind_from_token token.kind:
        Option::Some kind:
            some selfhost_expr_prefix_item_new kind token_index token.span
        Option::None:
            none

//: selfhost_expr_prefix_list_push_and_continue: item を[追加/ついか]して range loop を[継続/けいぞく]する
//:
//: [目的/もくてき]:
//: - token range から作った prefix item を一つだけ `out` に追加し、次の token index から構築 loop を続行します。
//: - `v::push` の失敗を `OutOfMemory` に正規化し、失敗時に元の buffer を解放する責務をこの境界に集めます。
//:
//: [契約/けいやく]:
//: - caller は `item` が `idx` 位置の token から作られた正当な prefix item であることを保証します。
//: - この関数は prefix item の意味的な結合を行いません。`MinusMarker` と数値 literal の 2 item consume-width は checker 側で決めます。
//: - 成功時は `out` の所有権を再帰呼び出しへ渡し、失敗時は error に含める span として `item.span` を使います。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(items)`: `end` までの token を flat prefix item list に変換した buffer です。
//: - `Err(error)`: push 失敗または後続 token の構築失敗です。
//:
//: [計算量/けいさんりょう]:
//: - この helper 自体は `v::push` 一回分です。range 全体では token 数 n に対して O(n) です。
fn selfhost_expr_prefix_list_push_and_continue %impure fn &Vec SelfhostToken impure fn i32 impure fn i32 impure fn Vec SelfhostExprPrefixItem impure fn SelfhostExprPrefixItem Result Vec SelfhostExprPrefixItem SelfhostExprPrefixBuildError \tokens\next_idx\end\out\item:
    match v::push out item:
        Result::Ok next_out:
            selfhost_expr_prefix_list_from_range_loop tokens next_idx end next_out
        Result::Err e:
            v::free v::vec_push_error_vec e
            Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::OutOfMemory item.span

//: selfhost_expr_prefix_list_len: prefix expression item 数を[返/かえ]す
pub fn selfhost_expr_prefix_list_len %fn &SelfhostExprPrefixList i32 \list:
    let items %&Vec SelfhostExprPrefixItem field::get_ref list "items"
    v::len items

//: selfhost_expr_prefix_list_get: prefix expression item を index で[返/かえ]す
pub fn selfhost_expr_prefix_list_get %fn &SelfhostExprPrefixList fn i32 Option SelfhostExprPrefixItem \list\idx:
    let items %&Vec SelfhostExprPrefixItem field::get_ref list "items"
    v::get items idx

//: selfhost_expr_prefix_list_free: prefix expression item buffer を[解放/かいほう]する
pub fn selfhost_expr_prefix_list_free %impure fn SelfhostExprPrefixList unit \list:
    v::free field::get list "items"

//: selfhost_expr_prefix_list_from_range_loop: token range を flat prefix item list に[変換/へんかん]する
//:
//: [目的/もくてき]:
//: - parser が保持する token range を、checker が呼び出し境界を縮約するための flat prefix item list へ変換します。
//: - token kind から prefix item kind への変換だけを担当し、型や expected type を必要とする判断は後段へ残します。
//:
//: [契約/けいやく]:
//: - `idx` から `end` までは同じ token table 上の半開区間です。
//: - `Minus` token は `MinusMarker` として一 item だけ追加します。直後の numeric token と結合しないことが、この module の安定した契約です。
//: - token が prefix expression item として扱えない場合は `InvalidToken` を返し、途中まで構築した buffer は解放します。
//:
//: [戻/もど]り[値/ち]:
//: - `Ok(items)`: 入力 token range と同じ順序を保った flat prefix item buffer です。
//: - `Err(error)`: token table 境界、無効 token、または buffer allocation の失敗です。
//:
//: [計算量/けいさんりょう]:
//: - token range の長さ n に対して O(n) です。各 token で定数回の match と push だけを行います。
fn selfhost_expr_prefix_list_from_range_loop %impure fn &Vec SelfhostToken impure fn i32 impure fn i32 impure fn Vec SelfhostExprPrefixItem Result Vec SelfhostExprPrefixItem SelfhostExprPrefixBuildError \tokens\idx\end\out:
    if:
        ge idx end
        then:
            Result::Ok out
        else:
            match v::get tokens idx:
                Option::Some token:
                    match selfhost_expr_prefix_item_from_token token idx:
                        Option::Some item:
                            selfhost_expr_prefix_list_push_and_continue tokens add idx 1 end out item
                        Option::None:
                            v::free out
                            Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::InvalidToken token.span
                Option::None:
                    v::free out
                    Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::TokenOutOfBounds source_span_empty_unchecked 0 0

//: selfhost_expr_prefix_first_token_starts_expr: range 先頭 token が expression 開始 token かを[返/かえ]す
//:
//: [目的/もくてき]:
//: - syntax range の先頭 token を見て、prefix expression として構築を開始できるかを判定します。
//: - 範囲外 index は parser と caller の不整合として扱い、panic せず `false` を返して上位の typed error に進めます。
//:
//: [契約/けいやく]:
//: - 判定は token kind の表層構文上の開始可否だけに限定します。
//: - `Minus` は `MinusMarker` を開始 item として許可しますが、負数 literal として成立するかどうかは source-backed argument checker が検査します。
//:
//: [戻/もど]り[値/ち]:
//: - `true`: 指定 token は expression range の先頭として受理できます。
//: - `false`: token が存在しない、または expression start として扱えません。
//:
//: [計算量/けいさんりょう]:
//: - token table の一回参照と predicate 呼び出しだけなので O(1) です。
fn selfhost_expr_prefix_first_token_starts_expr %fn &Vec SelfhostToken fn i32 bool \tokens\idx:
    match v::get tokens idx:
        Option::Some token:
            selfhost_token_is_expr_start token
        Option::None:
            false

//: selfhost_expr_prefix_list_from_syntax_range: parser の syntax range から expression prefix list を[作/つく]る
//:
//: [目的/もくてき]:
//: - parser が切り出した expression range を、後段 checker が縮約できる flat list へ変換します。
//: - range payload、token table 境界、expression start を先に検査し、不正な入力を HIR へ進めません。
//:
//: [注意/ちゅうい]:
//: - この関数は call boundary を確定しません。`add 1 2` も `%fn i32 i32 add` も、入力順の item list として保持します。
pub fn selfhost_expr_prefix_list_from_syntax_range %impure fn &Vec SelfhostToken impure fn SelfhostSyntaxRange Result SelfhostExprPrefixList SelfhostExprPrefixBuildError \tokens\syntax_range:
    match syntax_range:
        SelfhostSyntaxRange::Empty:
            Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::EmptySyntaxRange source_span_empty_unchecked 0 0
        SelfhostSyntaxRange::Range range:
            if:
                not selfhost_syntax_range_is_valid syntax_range
                then:
                    Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::InvalidSyntaxRange range.span
                else:
                    let token_len %i32 v::len tokens
                    if:
                        or gt range.first_token token_len gt range.token_count sub token_len range.first_token
                        then:
                            Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::TokenOutOfBounds range.span
                        else:
                            if:
                                not selfhost_expr_prefix_first_token_starts_expr tokens range.first_token
                                then:
                                    Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::MissingExpressionStart range.span
                                else:
                                    let items_result %Result Vec SelfhostExprPrefixItem StdErrorKind v::new
                                    match items_result:
                                        Result::Ok items:
                                            match selfhost_expr_prefix_list_from_range_loop tokens range.first_token add range.first_token range.token_count items:
                                                Result::Ok built_items:
                                                    Result::Ok selfhost_expr_prefix_list_new built_items
                                                Result::Err e:
                                                    Result::Err e
                                        Result::Err _e:
                                            Result::Err selfhost_expr_prefix_build_error_new SelfhostExprPrefixBuildErrorKind::OutOfMemory range.span
