#indent 4

//: # prefix_expr
//: NEPLg2.1 の prefix expression を、型検査前の flat token list として保持するモジュールです。
//:
//: [目的/もくてき]:
//: - NEPLg2.1 の関数呼び出しは前置記法で書かれますが、parser だけでは call boundary を決めません。
//: - callable candidate、arity、expected type、generic、trait、no partial application の検査が揃ってから、checker が flat list を縮約します。
//: - この module は、その縮約へ渡す入力境界として token index、source span、式中での役割を保持します。
//:
//: [契約/けいやく]:
//: - `SelfhostExprPrefixList` は HIR ではありません。`SelfhostHirExprPayload::Call` のような解決済み call tree をここでは作りません。
//: - `%T expr` は expression list 内で `TypeAnnotationMarker` から始まる token 列として保持します。`%` marker を捨てるのは type resolver 用の subrange を作る境界であり、この module の責務ではありません。
//: - `void` は expression start ではありません。list 内に現れた場合も、値ではなく marker token として保持され、後続 checker が位置に応じて拒否します。
//:
//: [現状/げんじょう]:
//: - parser body から expression range を切り出す処理は後続 slice で接続します。
//: - この module は `SelfhostSyntaxRange` から prefix expression item list を作る純粋なデータ境界と、focused test 用の builder を提供します。
//:
//: [計算量/けいさんりょう]:
//: - syntax range から list を作る処理は range 内 token 数を k として O(k) です。
//: - list の len / get は Vec の index access なので O(1) です。
//:
//: neplg2:test[stdio, normalize_newlines]
//: stdout: mlstr:
//: ##: Checked [ok,ok,ok,ok,ok,ok,ok]
//: ##: [0] ok
//: ##: [1] ok
//: ##: [2] ok
//: ##: [3] ok
//: ##: [4] ok
//: ##: [5] ok
//: ##: [6] ok
//: exit_code: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "alloc/collections/vec" as v
//:| #import "core/option" as *
//:| #import "core/result" as *
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//:| #import "neplg2/core/syntax/ast/prefix_expr" as *
//:| #import "neplg2/core/syntax/lexer" as *
//:| #import "std/test" as *
//:
//: fn check_item %fn &SelfhostExprPrefixList fn i32 fn SelfhostExprPrefixItemKind Result unit str \list\idx\expected:
//:     match selfhost_expr_prefix_list_get list idx:
//:         Option::Some item:
//:             if selfhost_expr_prefix_item_kind_eq item.kind expected Result::Ok unit Result::Err "expr prefix item kind mismatch"
//:         Option::None:
//:             Result::Err "expr prefix item missing"
//:
//: fn main %impure fn void i32 \void:
//:     let source %str "add -1 -1.5 -"
//:     let checks0 checks_new
//:     match lex_all source:
//:         Result::Ok tokens:
//:             let range %SelfhostSyntaxRange selfhost_syntax_range_new_unchecked 0 6 source_span_new_unchecked 0 0 13
//:             match selfhost_expr_prefix_list_from_syntax_range &tokens range:
//:                 Result::Ok list:
//:                     let checks1 checks_push checks0 check_eq_i32 6 selfhost_expr_prefix_list_len &list
//:                     let checks2 checks_push checks1 check_item &list 0 SelfhostExprPrefixItemKind::NamedValue
//:                     let checks3 checks_push checks2 check_item &list 1 SelfhostExprPrefixItemKind::MinusMarker
//:                     let checks4 checks_push checks3 check_item &list 2 SelfhostExprPrefixItemKind::IntLiteral
//:                     let checks5 checks_push checks4 check_item &list 3 SelfhostExprPrefixItemKind::MinusMarker
//:                     let checks6 checks_push checks5 check_item &list 4 SelfhostExprPrefixItemKind::FloatLiteral
//:                     let checks7 checks_push checks6 check_item &list 5 SelfhostExprPrefixItemKind::MinusMarker
//:                     selfhost_expr_prefix_list_free list
//:                     v::free tokens
//:                     let shown checks_print_report checks7
//:                     checks_exit_code shown
//:                 Result::Err _e:
//:                     v::free tokens
//:                     let checks1 checks_push checks0 Result::Err "expr prefix build failed"
//:                     let shown checks_print_report checks1
//:                     checks_exit_code shown
//:         Result::Err _diag:
//:             let checks1 checks_push checks0 Result::Err "lex failed"
//:             let shown checks_print_report checks1
//:             checks_exit_code shown
//: ```

#import "alloc/collections/vec" as v
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/token" as *

//: SelfhostExprPrefixItemKind: prefix expression list 内の token [役割/やくわり]
//:
//: [目的/もくてき]:
//: - lexer の `TokenKind` をそのまま call reduction の意味として扱わず、式縮約で必要な role を enum として固定します。
//: - literal、名前、型注釈 marker、lambda marker、control form marker を分けることで、checker が string 判定ではなく match で分岐できます。
pub enum SelfhostExprPrefixItemKind:
    TypeAnnotationMarker
    LambdaMarker
    FunctionTypeMarker
    VoidMarker
    AtMarker
    PathSeparator
    MemberMarker
    BorrowMarker
    PointerMarker
    MinusMarker
    PipeOperator
    NamedValue
    UnitValue
    IntLiteral
    FloatLiteral
    BoolLiteral
    CharLiteral
    StringLiteral
    LetMarker
    MutMarker
    NoShadowMarker
    SetMarker
    IfMarker
    WhileMarker
    CondMarker
    ThenMarker
    ElseMarker
    DoMarker
    MatchMarker
    BlockMarker
    TupleTypeMarker

impl Clone for SelfhostExprPrefixItemKind:
    fn clone %fn &SelfhostExprPrefixItemKind SelfhostExprPrefixItemKind \self:
        *self

impl Copy for SelfhostExprPrefixItemKind:
    fn copy_mark %fn SelfhostExprPrefixItemKind SelfhostExprPrefixItemKind \self:
        self

//: SelfhostExprPrefixItem: prefix expression item の token-derived payload
//:
//: [目的/もくてき]:
//: - item kind、token index、source span を保存し、後続 checker が diagnostic で元位置を説明できるようにします。
//: - source text や arena-local id は持たず、式縮約前の軽量で再利用しやすい入力値に留めます。
//: - `-1` や `-1.5` のような負数 literal も、この module では `MinusMarker` と数値 literal item の 2 item として保持します。expected type と source text を持つ checker 境界だけが、2 item を 1 つの負数 argument として消費できます。
pub struct SelfhostExprPrefixItem:
    kind %SelfhostExprPrefixItemKind
    token_index %i32
    span %SelfhostSourceSpan

impl Clone for SelfhostExprPrefixItem:
    fn clone %fn &SelfhostExprPrefixItem SelfhostExprPrefixItem \self:
        *self

impl Copy for SelfhostExprPrefixItem:
    fn copy_mark %fn SelfhostExprPrefixItem SelfhostExprPrefixItem \self:
        self

//: SelfhostExprPrefixList: checker が縮約する flat prefix expression item buffer
//:
//: [目的/もくてき]:
//: - parser / focused test 由来の syntax range を、所有 buffer として checker へ渡します。
//: - caller は使用後に `selfhost_expr_prefix_list_free` で buffer を解放します。
pub struct SelfhostExprPrefixList:
    items %Vec SelfhostExprPrefixItem

//: SelfhostExprPrefixBuildErrorKind: prefix expression list 生成の失敗分類
//:
//: [目的/もくてき]:
//: - 空範囲、範囲不正、token table 範囲外、式開始でない token、式 token として不正な token、allocation failure を enum として分けます。
pub enum SelfhostExprPrefixBuildErrorKind:
    EmptySyntaxRange
    InvalidSyntaxRange
    TokenOutOfBounds
    MissingExpressionStart
    InvalidToken
    OutOfMemory

impl Clone for SelfhostExprPrefixBuildErrorKind:
    fn clone %fn &SelfhostExprPrefixBuildErrorKind SelfhostExprPrefixBuildErrorKind \self:
        *self

impl Copy for SelfhostExprPrefixBuildErrorKind:
    fn copy_mark %fn SelfhostExprPrefixBuildErrorKind SelfhostExprPrefixBuildErrorKind \self:
        self

//: SelfhostExprPrefixBuildError: prefix expression list 生成失敗の typed payload
pub struct SelfhostExprPrefixBuildError:
    kind %SelfhostExprPrefixBuildErrorKind
    span %SelfhostSourceSpan

impl Clone for SelfhostExprPrefixBuildError:
    fn clone %fn &SelfhostExprPrefixBuildError SelfhostExprPrefixBuildError \self:
        *self

impl Copy for SelfhostExprPrefixBuildError:
    fn copy_mark %fn SelfhostExprPrefixBuildError SelfhostExprPrefixBuildError \self:
        self

//: selfhost_expr_prefix_item_kind_eq: item kind が同じ分類か[返/かえ]す
pub fn selfhost_expr_prefix_item_kind_eq %fn SelfhostExprPrefixItemKind fn SelfhostExprPrefixItemKind bool \a\b:
    match a:
        SelfhostExprPrefixItemKind::TypeAnnotationMarker:
            match b:
                SelfhostExprPrefixItemKind::TypeAnnotationMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::LambdaMarker:
            match b:
                SelfhostExprPrefixItemKind::LambdaMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::FunctionTypeMarker:
            match b:
                SelfhostExprPrefixItemKind::FunctionTypeMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::VoidMarker:
            match b:
                SelfhostExprPrefixItemKind::VoidMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::AtMarker:
            match b:
                SelfhostExprPrefixItemKind::AtMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::PathSeparator:
            match b:
                SelfhostExprPrefixItemKind::PathSeparator:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::MemberMarker:
            match b:
                SelfhostExprPrefixItemKind::MemberMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::BorrowMarker:
            match b:
                SelfhostExprPrefixItemKind::BorrowMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::PointerMarker:
            match b:
                SelfhostExprPrefixItemKind::PointerMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::MinusMarker:
            match b:
                SelfhostExprPrefixItemKind::MinusMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::PipeOperator:
            match b:
                SelfhostExprPrefixItemKind::PipeOperator:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::NamedValue:
            match b:
                SelfhostExprPrefixItemKind::NamedValue:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::UnitValue:
            match b:
                SelfhostExprPrefixItemKind::UnitValue:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::IntLiteral:
            match b:
                SelfhostExprPrefixItemKind::IntLiteral:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::FloatLiteral:
            match b:
                SelfhostExprPrefixItemKind::FloatLiteral:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::BoolLiteral:
            match b:
                SelfhostExprPrefixItemKind::BoolLiteral:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::CharLiteral:
            match b:
                SelfhostExprPrefixItemKind::CharLiteral:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::StringLiteral:
            match b:
                SelfhostExprPrefixItemKind::StringLiteral:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::LetMarker:
            match b:
                SelfhostExprPrefixItemKind::LetMarker:
                    true
                _:
                    false
        SelfhostExprPrefixItemKind::MutMarker:
            match b:
                SelfhostExprPrefixItemKind::MutMarker:
