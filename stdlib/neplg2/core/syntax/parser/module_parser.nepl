#indent 4

//: # module_parser
//: NEPLg2.0 のファイル単位 parser を置くモジュールです。
//:
//: [目的/もくてき]:
//: - lexer token stream から `SelfhostModuleAst` を作る parser 群の入口にします。
//: - S1 の初期段階では、宣言開始 token、compiler directive、doc comment、raw backend block を失わない item stream を作ります。
//:
//: [実装/じっそう]:
//: - offside token の `Indent` / `Dedent` で通常 code block depth を追跡します。
//: - `#wasm:` / `#llvmir:` は pending raw mode に入り、直後の raw block indent から対応する text token だけを受け付けます。
//: - raw block の dedent で raw mode を終了し、関数本体など外側の通常 block depth は維持します。
//:
//: [注意/ちゅうい]:
//: - これは full expression parser ではありません。式 token はまだ item 化せず、後続の item / expr parser へ責務を残します。
//: - raw text token が raw mode の外へ現れた場合は parser diagnostic にします。lexer と parser の状態ずれを早期に検出するためです。
//:
//: [計算量/けいさんりょう]:
//: - token 数を n とすると、[時間/じかん] O(n)、[空間/くうかん] O(m) です。m は保持する module item 数です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/result" as *
//:| #import "neplg2/core/syntax/parser/module_parser" as *
//:| #import "neplg2/core/syntax/ast/module_ast" as *
//: fn main <()*>i32> ():
//:     match selfhost_parse_module_source "fn main <()->i32> ():\n    0\n":
//:         Result::Ok ast:
//:             let n <i32> selfhost_module_ast_len &ast
//:             selfhost_module_ast_free ast
//:             if eq n 1 0 1
//:         Result::Err _diag:
//:             1
//: ```

#import "alloc/collections/vec" as v
#import "alloc/hash/hash32" as *
#import "alloc/string" as string
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/lexer" as *
#import "neplg2/core/syntax/token" as *

//: SelfhostParserRawMode: raw backend block の parser 状態
//:
//: [目的/もくてき]:
//: - `DirWasm` / `DirLlvmIr` を読んだ直後の pending 状態と、raw text を読んでいる active 状態を分けます。
//: - pending と active を enum で表すことで、raw text の種類不一致を match で明示的に検出します。
enum SelfhostParserRawMode:
    Normal
    PendingWasm
    PendingLlvmIr
    Wasm
    LlvmIr

impl Clone for SelfhostParserRawMode:
    fn clone <(&SelfhostParserRawMode)->SelfhostParserRawMode> (self):
        *self

impl Copy for SelfhostParserRawMode:
    fn copy_mark <(SelfhostParserRawMode)->SelfhostParserRawMode> (self):
        self

//: selfhost_parser_raw_mode_is_pending: raw block indent 待ちか[返/かえ]す
fn selfhost_parser_raw_mode_is_pending <(SelfhostParserRawMode)->bool> (mode):
    match mode:
        SelfhostParserRawMode::PendingWasm:
            true
        SelfhostParserRawMode::PendingLlvmIr:
            true
        SelfhostParserRawMode::Normal:
            false
        SelfhostParserRawMode::Wasm:
            false
        SelfhostParserRawMode::LlvmIr:
            false

//: selfhost_parser_depth_dec: 通常 block depth を 0 未満にしないで 1 [戻/もど]す
fn selfhost_parser_depth_dec <(i32)->i32> (depth):
    if:
        gt depth 0
        then:
            sub depth 1
        else:
            0

//: selfhost_parser_diag_at: token span に primary label を持つ error diagnostic を[作/つく]る
fn selfhost_parser_diag_at <(&SelfhostToken,SelfhostParserDiagnosticCode,str,str)->SelfhostDiagnostic> (token, code, message, label):
    let span <SelfhostSourceSpan> *field::get_ref token "span"
    let diag <SelfhostDiagnostic> selfhost_diag_error SelfhostDiagnosticCode::Parser code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span label

//: selfhost_parser_oom_diag: parser 内部 allocation failure を diagnostic にする
fn selfhost_parser_oom_diag <()->SelfhostDiagnostic> ():
    selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::OutOfMemory "self-host module parser ran out of memory"

//: selfhost_parser_diag_from_lex: lexer diagnostic を parser の共通 diagnostic に写す
fn selfhost_parser_diag_from_lex <(LexDiagnostic)->SelfhostDiagnostic> (lex_diag):
    let span <SelfhostSourceSpan> lex_diag.span
    let message <str> lex_diag.message
    let code <SelfhostDiagnosticCode> SelfhostDiagnosticCode::Lexer lex_diag.code
    let diag <SelfhostDiagnostic> selfhost_diag_error code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span message

//: selfhost_parser_pending_error: raw directive 後に raw block indent が無いことを報告する
fn selfhost_parser_pending_error <(&SelfhostToken,SelfhostModuleAst)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (token, ast):
    let diag <SelfhostDiagnostic> selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawBlockExpectedIndent "raw backend directive must be followed by an indented raw block" "expected raw block indentation here"
    selfhost_module_ast_free ast
    Result<SelfhostModuleAst, SelfhostDiagnostic>::Err diag

//: selfhost_parser_raw_text_error: raw text token の出現位置が不正なことを報告する
fn selfhost_parser_raw_text_error <(&SelfhostToken,SelfhostModuleAst)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (token, ast):
    let diag <SelfhostDiagnostic> selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawTextOutsideBlock "raw backend text appeared outside its matching raw block" "raw text must be inside #wasm: or #llvmir:"
    selfhost_module_ast_free ast
    Result<SelfhostModuleAst, SelfhostDiagnostic>::Err diag

//: selfhost_parser_string_match_key: 有限の token kind 名集合を match 用 key にする
fn selfhost_parser_string_match_key <(str)->i32> (value):
    and hash32 value 2147483647

//: selfhost_parser_item_kind_if_eq: hash arm の候補を実文字列で検証する
fn selfhost_parser_item_kind_if_eq <(str,str,SelfhostModuleItemKind)->Option<SelfhostModuleItemKind>> (name, expected, item_kind):
    if:
        string::str_eq name expected
        then:
            some<SelfhostModuleItemKind> item_kind
        else:
            none<SelfhostModuleItemKind>

//: selfhost_parser_decl_item_kind_if_eq: top-level 宣言 token を実文字列で検証する
fn selfhost_parser_decl_item_kind_if_eq <(str,str,SelfhostModuleItemKind,i32)->Option<SelfhostModuleItemKind>> (name, expected, item_kind, depth):
    if:
        eq depth 0
        then:
            selfhost_parser_item_kind_if_eq name expected item_kind
        else:
            none<SelfhostModuleItemKind>

//: selfhost_parser_item_kind_from_name: token kind 名を module item kind へ写す
//:
//: [目的/もくてき]:
//: - parser の入口で保持すべき token だけを `SelfhostModuleItemKind` に変換します。
//: - 宣言 keyword は通常 block depth 0 のものだけを module 宣言として扱います。
fn selfhost_parser_item_kind_from_name <(str,i32)->Option<SelfhostModuleItemKind>> (name, depth):
    match selfhost_parser_string_match_key name:
        2045702209:
            selfhost_parser_item_kind_if_eq name "DocComment" SelfhostModuleItemKind::DocComment
        1674402666:
            selfhost_parser_item_kind_if_eq name "MlstrLine" SelfhostModuleItemKind::MlstrLine
        279355747:
            selfhost_parser_item_kind_if_eq name "DirEntry" SelfhostModuleItemKind::EntryDirective
        963569064:
            selfhost_parser_item_kind_if_eq name "DirTarget" SelfhostModuleItemKind::TargetDirective
        1865317015:
            selfhost_parser_item_kind_if_eq name "DirImport" SelfhostModuleItemKind::ImportDirective
        38698144:
            selfhost_parser_item_kind_if_eq name "DirUse" SelfhostModuleItemKind::UseDirective
        665562352:
            selfhost_parser_item_kind_if_eq name "DirIfTarget" SelfhostModuleItemKind::IfTargetDirective
        1515634655:
            selfhost_parser_item_kind_if_eq name "DirIfProfile" SelfhostModuleItemKind::IfProfileDirective
        431733289:
            selfhost_parser_item_kind_if_eq name "DirCapability" SelfhostModuleItemKind::CapabilityDirective
        135595626:
            selfhost_parser_item_kind_if_eq name "DirPrelude" SelfhostModuleItemKind::PreludeDirective
        1618029181:
            selfhost_parser_item_kind_if_eq name "DirNoPrelude" SelfhostModuleItemKind::NoPreludeDirective
        101855325:
            selfhost_parser_item_kind_if_eq name "DirIntrinsic" SelfhostModuleItemKind::IntrinsicDirective
        577144765:
            selfhost_parser_decl_item_kind_if_eq name "KwFn" SelfhostModuleItemKind::FunctionDecl depth
        1828037288:
            selfhost_parser_decl_item_kind_if_eq name "KwStruct" SelfhostModuleItemKind::StructDecl depth
        189544508:
            selfhost_parser_decl_item_kind_if_eq name "KwEnum" SelfhostModuleItemKind::EnumDecl depth
        1578727952:
            selfhost_parser_decl_item_kind_if_eq name "KwTrait" SelfhostModuleItemKind::TraitDecl depth
        23258634:
            selfhost_parser_decl_item_kind_if_eq name "KwImpl" SelfhostModuleItemKind::ImplDecl depth
        205424351:
            selfhost_parser_item_kind_if_eq name "DirWasm" SelfhostModuleItemKind::WasmBlock
        91639139:
            selfhost_parser_item_kind_if_eq name "DirLlvmIr" SelfhostModuleItemKind::LlvmIrBlock
        1829007411:
            selfhost_parser_item_kind_if_eq name "WasmText" SelfhostModuleItemKind::WasmText
        757645299:
            selfhost_parser_item_kind_if_eq name "LlvmIrText" SelfhostModuleItemKind::LlvmIrText
        _:
            none<SelfhostModuleItemKind>

//: selfhost_parser_item_kind_from_token: token kind を module item kind へ写す
fn selfhost_parser_item_kind_from_token <(TokenKind,i32)->Option<SelfhostModuleItemKind>> (kind, depth):
    selfhost_parser_item_kind_from_name token_kind_name kind depth

//: selfhost_parser_push_item: token を module item として AST に[追加/ついか]する
fn selfhost_parser_push_item <(SelfhostModuleAst,SelfhostToken,SelfhostModuleItemKind)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (ast, token, item_kind):
    let item <SelfhostModuleItem> selfhost_module_item_new item_kind token.span token.lexeme
    match selfhost_module_ast_push ast item:
        Result::Ok next_ast:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Ok next_ast
        Result::Err _e:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Err selfhost_parser_oom_diag

//: selfhost_parse_push_and_continue: item 追加後に parse loop へ戻る
fn selfhost_parse_push_and_continue <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken,SelfhostModuleItemKind)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token, item_kind):
    match selfhost_parser_push_item ast token item_kind:
        Result::Ok next_ast:
            selfhost_parse_module_loop tokens n add idx 1 depth mode next_ast
        Result::Err diag:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Err diag

//: selfhost_parse_raw_wasm_text: WasmText token を raw mode に応じて処理する
fn selfhost_parse_raw_wasm_text <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token):
    match mode:
        SelfhostParserRawMode::Wasm:
            selfhost_parse_push_and_continue tokens n idx depth mode ast token SelfhostModuleItemKind::WasmText
        SelfhostParserRawMode::Normal:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::PendingWasm:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::PendingLlvmIr:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::LlvmIr:
            selfhost_parser_raw_text_error &token ast

//: selfhost_parse_raw_llvmir_text: LlvmIrText token を raw mode に応じて処理する
fn selfhost_parse_raw_llvmir_text <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token):
    match mode:
        SelfhostParserRawMode::LlvmIr:
            selfhost_parse_push_and_continue tokens n idx depth mode ast token SelfhostModuleItemKind::LlvmIrText
        SelfhostParserRawMode::Normal:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::PendingWasm:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::PendingLlvmIr:
            selfhost_parser_raw_text_error &token ast
        SelfhostParserRawMode::Wasm:
            selfhost_parser_raw_text_error &token ast

//: selfhost_parse_indent: Indent token による通常 block / raw block 状態遷移を処理する
fn selfhost_parse_indent <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast):
    match mode:
        SelfhostParserRawMode::PendingWasm:
            selfhost_parse_module_loop tokens n add idx 1 depth SelfhostParserRawMode::Wasm ast
        SelfhostParserRawMode::PendingLlvmIr:
            selfhost_parse_module_loop tokens n add idx 1 depth SelfhostParserRawMode::LlvmIr ast
        SelfhostParserRawMode::Normal:
            selfhost_parse_module_loop tokens n add idx 1 add depth 1 mode ast
        SelfhostParserRawMode::Wasm:
            selfhost_parse_module_loop tokens n add idx 1 depth mode ast
        SelfhostParserRawMode::LlvmIr:
            selfhost_parse_module_loop tokens n add idx 1 depth mode ast

//: selfhost_parse_dedent: Dedent token による通常 block / raw block 状態遷移を処理する
fn selfhost_parse_dedent <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token):
    match mode:
        SelfhostParserRawMode::Wasm:
            selfhost_parse_module_loop tokens n add idx 1 depth SelfhostParserRawMode::Normal ast
        SelfhostParserRawMode::LlvmIr:
            selfhost_parse_module_loop tokens n add idx 1 depth SelfhostParserRawMode::Normal ast
        SelfhostParserRawMode::PendingWasm:
            selfhost_parser_pending_error &token ast
        SelfhostParserRawMode::PendingLlvmIr:
            selfhost_parser_pending_error &token ast
        SelfhostParserRawMode::Normal:
            selfhost_parse_module_loop tokens n add idx 1 selfhost_parser_depth_dec depth mode ast

//: selfhost_parse_dir_wasm: `#wasm:` directive を item 化して raw mode へ入る
fn selfhost_parse_dir_wasm <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token):
    if:
        selfhost_parser_raw_mode_is_pending mode
        then:
            selfhost_parser_pending_error &token ast
        else:
            selfhost_parse_push_and_continue tokens n idx depth SelfhostParserRawMode::PendingWasm ast token SelfhostModuleItemKind::WasmBlock

//: selfhost_parse_dir_llvmir: `#llvmir:` directive を item 化して raw mode へ入る
fn selfhost_parse_dir_llvmir <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token):
    if:
        selfhost_parser_raw_mode_is_pending mode
        then:
            selfhost_parser_pending_error &token ast
        else:
            selfhost_parse_push_and_continue tokens n idx depth SelfhostParserRawMode::PendingLlvmIr ast token SelfhostModuleItemKind::LlvmIrBlock

//: selfhost_parse_regular_token: raw text 以外の token を必要なら item 化する
fn selfhost_parse_regular_token <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst,SelfhostToken,TokenKind)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast, token, kind):
    if:
        selfhost_parser_raw_mode_is_pending mode
        then:
            selfhost_parser_pending_error &token ast
        else:
            match selfhost_parser_item_kind_from_token kind depth:
                Option::Some item_kind:
                    selfhost_parse_push_and_continue tokens n idx depth mode ast token item_kind
                Option::None:
                    selfhost_parse_module_loop tokens n add idx 1 depth mode ast

//: selfhost_parse_module_loop: token stream を 1 回だけ走査して module item stream を作る
fn selfhost_parse_module_loop <(&Vec<SelfhostToken>,i32,i32,i32,SelfhostParserRawMode,SelfhostModuleAst)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens, n, idx, depth, mode, ast):
    if:
        ge idx n
        then:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Ok ast
        else:
            match v::get<SelfhostToken> tokens idx:
                Option::Some token:
                    let kind <TokenKind> token.kind
                    let kind_name <str> token_kind_name kind
                    match selfhost_parser_string_match_key kind_name:
                        749955964:
                            if:
                                selfhost_parser_raw_mode_is_pending mode
                                then:
                                    selfhost_parser_pending_error &token ast
                                else:
                                    Result<SelfhostModuleAst, SelfhostDiagnostic>::Ok ast
                        105265799:
                            selfhost_parse_module_loop tokens n add idx 1 depth mode ast
                        566098053:
                            selfhost_parse_indent tokens n idx depth mode ast
                        1825646227:
                            selfhost_parse_dedent tokens n idx depth mode ast token
                        1829007411:
                            selfhost_parse_raw_wasm_text tokens n idx depth mode ast token
                        757645299:
                            selfhost_parse_raw_llvmir_text tokens n idx depth mode ast token
                        205424351:
                            selfhost_parse_dir_wasm tokens n idx depth mode ast token
                        91639139:
                            selfhost_parse_dir_llvmir tokens n idx depth mode ast token
                        _:
                            selfhost_parse_regular_token tokens n idx depth mode ast token kind
                Option::None:
                    let diag <SelfhostDiagnostic> selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::TokenIndex "self-host module parser could not read token"
                    selfhost_module_ast_free ast
                    Result<SelfhostModuleAst, SelfhostDiagnostic>::Err diag

//: selfhost_parse_module_tokens: lexer token stream から module AST を[作/つく]る
fn selfhost_parse_module_tokens <(&Vec<SelfhostToken>)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (tokens):
    match selfhost_module_ast_new:
        Result::Ok ast:
            let n <i32> v::len<SelfhostToken> tokens
            selfhost_parse_module_loop tokens n 0 0 SelfhostParserRawMode::Normal ast
        Result::Err _e:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Err selfhost_parser_oom_diag

//: selfhost_parse_module_source_with_file_id: file_id 付き source text を lex して module AST を[作/つく]る
//:
//: [注意/ちゅうい]:
//: - 返された AST の item lexeme は source text の slice です。呼び出し側は source text の lifetime を AST 利用中に保つ必要があります。
fn selfhost_parse_module_source_with_file_id <(str,i32)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (source, file_id):
    match lex_all_with_file_id source file_id:
        Result::Ok tokens:
            match selfhost_parse_module_tokens &tokens:
                Result::Ok ast:
                    v::free<SelfhostToken> tokens
                    Result<SelfhostModuleAst, SelfhostDiagnostic>::Ok ast
                Result::Err diag:
                    v::free<SelfhostToken> tokens
                    Result<SelfhostModuleAst, SelfhostDiagnostic>::Err diag
        Result::Err lex_diag:
            Result<SelfhostModuleAst, SelfhostDiagnostic>::Err selfhost_parser_diag_from_lex lex_diag

//: selfhost_parse_module_source: source text を lex して module AST を[作/つく]る
//:
//: [注意/ちゅうい]:
//: - single-source 互換の wrapper です。複数 file loader からは `selfhost_parse_module_source_with_file_id` を[使/つか]ってください。
fn selfhost_parse_module_source <(str)*>Result<SelfhostModuleAst, SelfhostDiagnostic>> (source):
    selfhost_parse_module_source_with_file_id source 0

//: selfhost_module_parser_stage0: parser 入口の smoke API
fn selfhost_module_parser_stage0 <()*>i32> ():
    match selfhost_parse_module_source "fn main <()->i32> ():\n    0\n":
        Result::Ok ast:
            let n <i32> selfhost_module_ast_len &ast
            selfhost_module_ast_free ast
            n
        Result::Err _diag:
            1
