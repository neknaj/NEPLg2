#indent 4
#import "core/field" as field
#import "core/result" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/lexer" as *
#import "neplg2/core/syntax/token" as *

//: selfhost_parser_diag_at: token span に primary label を持つ error diagnostic を[作/つく]る
pub fn selfhost_parser_diag_at %fn &SelfhostToken fn SelfhostParserDiagnosticCode fn str fn str SelfhostDiagnostic \token\code\message\label:
    let span %SelfhostSourceSpan *field::get_ref token "span"
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Parser code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span label

//: selfhost_parser_oom_diag: parser 内部 allocation failure を diagnostic にする
pub fn selfhost_parser_oom_diag %fn void SelfhostDiagnostic \void:
    selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::OutOfMemory "self-host module parser ran out of memory"

//: selfhost_parser_diag_from_lex: lexer diagnostic を parser の共通 diagnostic に写す
pub fn selfhost_parser_diag_from_lex %fn LexDiagnostic SelfhostDiagnostic \lex_diag:
    let span %SelfhostSourceSpan lex_diag.span
    let message %str lex_diag.message
    let code %SelfhostDiagnosticCode SelfhostDiagnosticCode::Lexer lex_diag.code
    let diag %SelfhostDiagnostic selfhost_diag_error code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span message

//: selfhost_parser_pending_error: raw directive 後に raw block indent が無いことを報告する
pub fn selfhost_parser_pending_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawBlockExpectedIndent "raw backend directive must be followed by an indented raw block" "expected raw block indentation here"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_pending_end_error: token stream が raw block indent を待ったまま終わったことを報告する
pub fn selfhost_parser_pending_end_error %impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \ast:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::RawBlockExpectedIndent "raw backend directive reached end of token stream before its raw block"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_raw_text_error: raw text token の出現位置が不正なことを報告する
pub fn selfhost_parser_raw_text_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawTextOutsideBlock "raw backend text appeared outside its matching raw block" "raw text must be inside #wasm: or #llvmir:"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_unclosed_raw_block_error: EOF で閉じていない raw backend block を報告する
pub fn selfhost_parser_unclosed_raw_block_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawBlockUnclosed "raw backend block reached EOF before a matching dedent" "dedent must close this raw backend block before EOF"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_unclosed_raw_block_end_error: EOF token なしで閉じていない raw backend block を報告する
pub fn selfhost_parser_unclosed_raw_block_end_error %impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \ast:
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::RawBlockUnclosed "raw backend block reached end of token stream before a matching dedent"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_invalid_dedent_error: top-level の余分な Dedent を報告する
pub fn selfhost_parser_invalid_dedent_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::InvalidDedent "dedent appeared when no parser block was open" "this dedent has no matching indent"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_legacy_syntax_token_error: 現行 NEPLg2.1 source では使わない旧構文 token を報告する
//:
//: [目的/もくてき]:
//: - lexer は移行診断や raw 境界のために括弧・角括弧 token を保持します。
//: - module parser は通常 source の authority なので、旧 grouping / angle type syntax を AST item stream へ渡さず typed diagnostic として停止します。
pub fn selfhost_parser_legacy_syntax_token_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::LegacySyntaxToken "legacy parenthesis or angle-bracket syntax is not part of current NEPLg2.1 source" "use % prefix type syntax and backslash lambda parameters"
    selfhost_module_ast_free ast
    Result::Err diag
