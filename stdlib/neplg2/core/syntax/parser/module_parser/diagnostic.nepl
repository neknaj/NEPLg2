#indent 4
#import "core/field" as field
#import "core/result" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/lexer" as *
#import "neplg2/core/syntax/token" as *

//: selfhost_parser_diag_at: token span に primary label を持つ error diagnostic を[作/つく]る
pub fn selfhost_parser_diag_at %fn &SelfhostToken fn SelfhostParserDiagnosticCode fn str fn str SelfhostDiagnostic \token\code\message\label:
    let span %SelfhostSourceSpan *field::get_ref token "span"
    let diag %SelfhostDiagnostic selfhost_diag_error SelfhostDiagnosticCode::Parser code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span label

//: selfhost_parser_oom_diag: parser 内部 allocation failure を diagnostic にする
pub fn selfhost_parser_oom_diag %fn unit SelfhostDiagnostic \unit:
    selfhost_diag_error SelfhostDiagnosticCode::Parser SelfhostParserDiagnosticCode::OutOfMemory "self-host module parser ran out of memory"

//: selfhost_parser_diag_from_lex: lexer diagnostic を parser の共通 diagnostic に写す
pub fn selfhost_parser_diag_from_lex %fn LexDiagnostic SelfhostDiagnostic \lex_diag:
    let span %SelfhostSourceSpan lex_diag.span
    let message %str lex_diag.message
    let code %SelfhostDiagnosticCode SelfhostDiagnosticCode::Lexer lex_diag.code
    let diag %SelfhostDiagnostic selfhost_diag_error code message
    selfhost_diag_with_primary_label diag selfhost_diag_label_new span message

//: selfhost_parser_pending_error: raw directive 後に raw block indent が無いことを報告する
pub fn selfhost_parser_pending_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawBlockExpectedIndent "raw backend directive must be followed by an indented raw block" "expected raw block indentation here"
    selfhost_module_ast_free ast
    Result::Err diag

//: selfhost_parser_raw_text_error: raw text token の出現位置が不正なことを報告する
pub fn selfhost_parser_raw_text_error %impure fn &SelfhostToken impure fn SelfhostModuleAst Result SelfhostModuleAst SelfhostDiagnostic \token\ast:
    let diag %SelfhostDiagnostic selfhost_parser_diag_at token SelfhostParserDiagnosticCode::RawTextOutsideBlock "raw backend text appeared outside its matching raw block" "raw text must be inside #wasm: or #llvmir:"
    selfhost_module_ast_free ast
    Result::Err diag

