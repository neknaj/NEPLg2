            none
        TokenKind::DirWasm:
            none
        TokenKind::DirLlvmIr:
            none
        TokenKind::DirIndentWidth:
            none
        TokenKind::DirInclude:
            none
        TokenKind::DirExtern:
            none
        TokenKind::DirIntrinsic:
            none
        TokenKind::DirPrelude:
            none
        TokenKind::DirNoPrelude:
            none
        TokenKind::WasmText:
