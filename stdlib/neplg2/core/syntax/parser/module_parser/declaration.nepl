#indent 4
#import "alloc/collections/vec" as v
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/math" as *
#import "core/option" as *
#import "core/result" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/token" as *
#import "./action" as *
#import "./body_range" as *
#import "./diagnostic" as *
#import "./header_boundary" as *
#import "./prefix_range" as *
#import "./token_role" as *

fn selfhost_parser_declaration_head_kind %fn TokenKind Option SelfhostModuleDeclarationHeadKind \kind:
    selfhost_parser_token_role_declaration_head_kind selfhost_parser_token_role kind

fn selfhost_parser_declaration_head %fn &Vec SelfhostToken fn i32 fn i32 Option SelfhostModuleDeclarationHead \tokens\n\idx:
    let head_idx %i32 add idx 1
    if:
        ge head_idx n
        then:
            none
        else:
            match v::get tokens head_idx:
                Option::Some head:
                    match selfhost_parser_declaration_head_kind head.kind:
                        Option::Some kind:
                            some selfhost_module_declaration_head_new kind head.span
                        Option::None:
                            none
                Option::None:
                    none

fn selfhost_parser_header_end_loop %fn &Vec SelfhostToken fn i32 fn i32 fn i32 i32 \tokens\n\idx\last_end:
    if:
        ge idx n
        then:
            last_end
        else:
            match v::get tokens idx:
                Option::Some token:
                    match selfhost_parser_token_action token.kind:
                        SelfhostParserTokenAction::End:
                            last_end
                        SelfhostParserTokenAction::Skip:
                            last_end
                        SelfhostParserTokenAction::Indent:
                            last_end
                        SelfhostParserTokenAction::Dedent:
                            last_end
                        SelfhostParserTokenAction::LegacySyntax:
                            last_end
                        SelfhostParserTokenAction::WasmText:
                            selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
                        SelfhostParserTokenAction::LlvmIrText:
                            selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
                        SelfhostParserTokenAction::DirWasm:
                            selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
                        SelfhostParserTokenAction::DirLlvmIr:
                            selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
                        SelfhostParserTokenAction::Regular:
                            selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
                Option::None:
                    last_end

fn selfhost_parser_declaration_header %fn &Vec SelfhostToken fn i32 fn i32 fn SelfhostToken fn SelfhostModuleDeclarationKind SelfhostModuleDeclarationHeader \tokens\n\idx\token\decl_kind:
    let visibility %SelfhostModuleDeclarationVisibility selfhost_parser_declaration_visibility tokens idx
    let header_start %i32 selfhost_parser_declaration_header_start tokens idx token
    let header_end %i32 selfhost_parser_header_end_loop tokens n add idx 1 selfhost_token_end token
    let token_span %SelfhostSourceSpan token.span
    let file_id %i32 field::get token_span "file_id"
    let header_span %SelfhostSourceSpan source_span_new_unchecked file_id header_start header_end
    let head %Option SelfhostModuleDeclarationHead selfhost_parser_declaration_head tokens n idx
    let type_annotation %SelfhostSyntaxRange selfhost_parser_header_type_annotation_range tokens n idx
    let lambda_header %SelfhostSyntaxRange selfhost_parser_header_lambda_range tokens n idx
    selfhost_module_declaration_header_new decl_kind visibility header_span token_span head type_annotation lambda_header

fn selfhost_parser_declaration_item %impure fn str impure fn &Vec SelfhostToken impure fn i32 impure fn i32 impure fn SelfhostModuleAst impure fn SelfhostToken impure fn SelfhostModuleItemKind impure fn SelfhostModuleDeclarationKind Result SelfhostModuleAst SelfhostDiagnostic \source\tokens\n\idx\ast\token\item_kind\decl_kind:
    let header %SelfhostModuleDeclarationHeader selfhost_parser_declaration_header tokens n idx token decl_kind
    let body %SelfhostModuleDeclarationBody selfhost_parser_declaration_body_range tokens n idx
    let lexeme %str string_slice::str_slice source header.header_span.start header.header_span.end
    let item %SelfhostModuleItem selfhost_module_item_new_with_declaration_and_body item_kind lexeme header body
    match selfhost_module_ast_push ast item:
        Result::Ok next_ast:
            Result::Ok next_ast
        Result::Err _e:
            Result::Err selfhost_parser_oom_diag

//: selfhost_parser_push_item: token を module item として AST に[追加/ついか]する
pub fn selfhost_parser_push_item %impure fn str impure fn &Vec SelfhostToken impure fn i32 impure fn i32 impure fn SelfhostModuleAst impure fn SelfhostToken impure fn SelfhostModuleItemKind Result SelfhostModuleAst SelfhostDiagnostic \source\tokens\n\idx\ast\token\item_kind:
    match selfhost_module_item_kind_declaration item_kind:
        Option::Some decl_kind:
            selfhost_parser_declaration_item source tokens n idx ast token item_kind decl_kind
        Option::None:
            let lexeme %str selfhost_token_lexeme source token
            let item %SelfhostModuleItem selfhost_module_item_new item_kind token.span lexeme
            match selfhost_module_ast_push ast item:
                Result::Ok next_ast:
                    Result::Ok next_ast
                Result::Err _e:
                    Result::Err selfhost_parser_oom_diag
