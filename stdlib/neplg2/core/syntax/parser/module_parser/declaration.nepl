//: selfhost_parser_declaration_visibility: declaration header の visibility を[取/と]り[出/だ]す
fn selfhost_parser_declaration_visibility %fn &Vec SelfhostToken fn i32 SelfhostModuleDeclarationVisibility \tokens\idx:
    if:
        le idx 0
        then:
            SelfhostModuleDeclarationVisibility::Private
        else:
            match v::get<SelfhostToken> tokens sub idx 1:
                Option::Some prev:
                    match prev.kind:
                        TokenKind::KwPub:
                            SelfhostModuleDeclarationVisibility::Public
                        TokenKind::Indent:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Dedent:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Newline:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Eof:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Colon:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Semicolon:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Pipe:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::LParen:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::RParen:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Comma:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::LAngle:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::RAngle:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Percent:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Backslash:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Arrow:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::PathSep:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::At:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Dot:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Ampersand:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Star:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Minus:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Equals:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Ident:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::IntLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::FloatLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::BoolLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::CharLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::StringLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::UnitLiteral:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwFn:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwLet:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwMut:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwNoShadow:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwSet:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwIf:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwWhile:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwCond:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwThen:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwElse:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwDo:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwStruct:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwEnum:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwMatch:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwTrait:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwImpl:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwFor:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwBlock:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwTuple:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::KwMlstr:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirEntry:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirTarget:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirImport:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirUse:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirIfTarget:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirIfProfile:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirCapability:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirWasm:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirLlvmIr:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirIndentWidth:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirInclude:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirExtern:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirIntrinsic:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirPrelude:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DirNoPrelude:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::WasmText:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::LlvmIrText:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::MlstrLine:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::DocComment:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::UnterminatedChar:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::UnterminatedString:
                            SelfhostModuleDeclarationVisibility::Private
                        TokenKind::Unknown:
                            SelfhostModuleDeclarationVisibility::Private
                Option::None:
                    SelfhostModuleDeclarationVisibility::Private

fn selfhost_parser_declaration_header_start %fn &Vec SelfhostToken fn i32 fn SelfhostToken i32 \tokens\idx\token:
    match selfhost_parser_declaration_visibility tokens idx:
        SelfhostModuleDeclarationVisibility::Public:
            match v::get<SelfhostToken> tokens sub idx 1:
                Option::Some prev:
                    prev.span.start
                Option::None:
                    token.span.start
        SelfhostModuleDeclarationVisibility::Private:
            token.span.start

fn selfhost_parser_declaration_head_kind %fn TokenKind Option SelfhostModuleDeclarationHeadKind \kind:
    match kind:
        TokenKind::Ident:
            some SelfhostModuleDeclarationHeadKind::Name
        TokenKind::Dot:
            some SelfhostModuleDeclarationHeadKind::TypeLabel
        TokenKind::LAngle:
            some SelfhostModuleDeclarationHeadKind::GenericParams
        TokenKind::Indent:
            none
        TokenKind::Dedent:
            none
        TokenKind::Newline:
            none
        TokenKind::Eof:
            none
        TokenKind::Colon:
            none
        TokenKind::Semicolon:
            none
        TokenKind::Pipe:
            none
        TokenKind::LParen:
            none
        TokenKind::RParen:
            none
        TokenKind::Comma:
            none
        TokenKind::RAngle:
            none
        TokenKind::Percent:
            none
        TokenKind::Backslash:
            none
        TokenKind::Arrow:
            none
        TokenKind::PathSep:
            none
        TokenKind::At:
            none
        TokenKind::Ampersand:
            none
        TokenKind::Star:
            none
        TokenKind::Minus:
            none
        TokenKind::Equals:
            none
        TokenKind::IntLiteral:
            none
        TokenKind::FloatLiteral:
            none
        TokenKind::BoolLiteral:
            none
        TokenKind::CharLiteral:
            none
        TokenKind::StringLiteral:
            none
        TokenKind::UnitLiteral:
            none
        TokenKind::KwFn:
            none
        TokenKind::KwLet:
            none
        TokenKind::KwMut:
            none
        TokenKind::KwNoShadow:
            none
        TokenKind::KwSet:
            none
        TokenKind::KwIf:
            none
        TokenKind::KwWhile:
            none
        TokenKind::KwCond:
            none
        TokenKind::KwThen:
            none
        TokenKind::KwElse:
            none
        TokenKind::KwDo:
            none
