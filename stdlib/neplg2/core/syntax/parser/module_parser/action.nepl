#indent 4
#import "neplg2/core/syntax/token" as *
#import "./state" as *

//: selfhost_parser_token_action: token kind から parser loop action を[選/えら]ぶ
pub fn selfhost_parser_token_action %fn TokenKind SelfhostParserTokenAction \kind:
    match kind:
        TokenKind::Indent:
            SelfhostParserTokenAction::Indent
        TokenKind::Dedent:
            SelfhostParserTokenAction::Dedent
        TokenKind::Newline:
            SelfhostParserTokenAction::Skip
        TokenKind::Eof:
            SelfhostParserTokenAction::End
        TokenKind::Colon:
            SelfhostParserTokenAction::Regular
        TokenKind::Semicolon:
            SelfhostParserTokenAction::Regular
        TokenKind::Pipe:
            SelfhostParserTokenAction::Regular
        TokenKind::LParen:
            SelfhostParserTokenAction::LegacySyntax
        TokenKind::RParen:
            SelfhostParserTokenAction::LegacySyntax
        TokenKind::Comma:
            SelfhostParserTokenAction::Regular
        TokenKind::LAngle:
            SelfhostParserTokenAction::LegacySyntax
        TokenKind::RAngle:
            SelfhostParserTokenAction::LegacySyntax
        TokenKind::Percent:
            SelfhostParserTokenAction::Regular
        TokenKind::Backslash:
            SelfhostParserTokenAction::Regular
        TokenKind::Arrow:
            SelfhostParserTokenAction::Regular
        TokenKind::PathSep:
            SelfhostParserTokenAction::Regular
        TokenKind::At:
            SelfhostParserTokenAction::Regular
        TokenKind::Dot:
            SelfhostParserTokenAction::Regular
        TokenKind::Ampersand:
            SelfhostParserTokenAction::Regular
        TokenKind::Star:
            SelfhostParserTokenAction::Regular
        TokenKind::Minus:
            SelfhostParserTokenAction::Regular
        TokenKind::Equals:
            SelfhostParserTokenAction::Regular
        TokenKind::Ident:
            SelfhostParserTokenAction::Regular
        TokenKind::IntLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::FloatLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::BoolLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::CharLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::StringLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::UnitLiteral:
            SelfhostParserTokenAction::Regular
        TokenKind::VoidMarker:
            SelfhostParserTokenAction::Regular
        TokenKind::KwFn:
            SelfhostParserTokenAction::Regular
        TokenKind::KwLet:
            SelfhostParserTokenAction::Regular
        TokenKind::KwMut:
            SelfhostParserTokenAction::Regular
        TokenKind::KwNoShadow:
            SelfhostParserTokenAction::Regular
        TokenKind::KwSet:
            SelfhostParserTokenAction::Regular
        TokenKind::KwIf:
            SelfhostParserTokenAction::Regular
        TokenKind::KwWhile:
            SelfhostParserTokenAction::Regular
        TokenKind::KwCond:
            SelfhostParserTokenAction::Regular
        TokenKind::KwThen:
            SelfhostParserTokenAction::Regular
        TokenKind::KwElse:
            SelfhostParserTokenAction::Regular
        TokenKind::KwDo:
            SelfhostParserTokenAction::Regular
        TokenKind::KwStruct:
            SelfhostParserTokenAction::Regular
        TokenKind::KwEnum:
            SelfhostParserTokenAction::Regular
        TokenKind::KwMatch:
            SelfhostParserTokenAction::Regular
        TokenKind::KwTrait:
            SelfhostParserTokenAction::Regular
        TokenKind::KwImpl:
            SelfhostParserTokenAction::Regular
        TokenKind::KwFor:
            SelfhostParserTokenAction::Regular
        TokenKind::KwPub:
            SelfhostParserTokenAction::Regular
        TokenKind::KwBlock:
            SelfhostParserTokenAction::Regular
        TokenKind::KwTuple:
            SelfhostParserTokenAction::Regular
        TokenKind::KwMlstr:
            SelfhostParserTokenAction::Regular
        TokenKind::DirEntry:
            SelfhostParserTokenAction::Regular
        TokenKind::DirTarget:
            SelfhostParserTokenAction::Regular
        TokenKind::DirImport:
            SelfhostParserTokenAction::Regular
        TokenKind::DirUse:
            SelfhostParserTokenAction::Regular
        TokenKind::DirTest:
            SelfhostParserTokenAction::Regular
        TokenKind::DirIfTarget:
            SelfhostParserTokenAction::Regular
        TokenKind::DirIfProfile:
            SelfhostParserTokenAction::Regular
        TokenKind::DirCapability:
            SelfhostParserTokenAction::Regular
        TokenKind::DirWasm:
            SelfhostParserTokenAction::DirWasm
        TokenKind::DirLlvmIr:
            SelfhostParserTokenAction::DirLlvmIr
        TokenKind::DirIndentWidth:
            SelfhostParserTokenAction::Regular
        TokenKind::DirInclude:
            SelfhostParserTokenAction::Regular
        TokenKind::DirExtern:
            SelfhostParserTokenAction::Regular
        TokenKind::DirIntrinsic:
            SelfhostParserTokenAction::Regular
        TokenKind::DirPrelude:
            SelfhostParserTokenAction::Regular
        TokenKind::DirNoPrelude:
            SelfhostParserTokenAction::Regular
        TokenKind::WasmText:
            SelfhostParserTokenAction::WasmText
        TokenKind::LlvmIrText:
            SelfhostParserTokenAction::LlvmIrText
        TokenKind::MlstrLine:
            SelfhostParserTokenAction::Regular
        TokenKind::DocComment:
            SelfhostParserTokenAction::Regular
        TokenKind::UnterminatedChar:
            SelfhostParserTokenAction::Regular
        TokenKind::UnterminatedString:
            SelfhostParserTokenAction::Regular
        TokenKind::Unknown:
            SelfhostParserTokenAction::Regular
