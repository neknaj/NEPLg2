#indent 4
#import "neplg2/core/syntax/token" as *
#import "./state" as *
#import "./token_role" as *

//: selfhost_parser_token_action: token kind から parser loop action を[選/えら]ぶ
//:
//: [目的/もくてき]:
//: - token の意味分類は `selfhost_parser_token_role` に集約し、loop はそこから進行制御だけを受け取ります。
//: - これにより、AST item や declaration header の分類と loop action が別々の TokenKind 表としてずれることを防ぎます。
pub fn selfhost_parser_token_action %fn TokenKind SelfhostParserTokenAction \kind:
    selfhost_parser_token_role_action selfhost_parser_token_role kind
