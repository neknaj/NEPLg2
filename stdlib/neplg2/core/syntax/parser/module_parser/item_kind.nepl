#indent 4
#import "core/math" as *
#import "core/option" as *
#import "neplg2/core/syntax/ast/module_ast" as *
#import "neplg2/core/syntax/token" as *
#import "./token_role" as *

//: selfhost_parser_decl_item_kind: top-level 宣言 token だけを module item にする
//:
//: [目的/もくてき]:
//: - declaration keyword は block depth 0 のときだけ module 宣言として保持します。
//: - prefix type 内の `fn` など、式や型式内部の keyword は module item にしません。
pub fn selfhost_parser_decl_item_kind %fn SelfhostModuleItemKind fn i32 Option SelfhostModuleItemKind \item_kind\depth:
    if:
        eq depth 0
        then:
            some item_kind
        else:
            none

//: selfhost_parser_item_kind_from_token: token kind を module item kind へ写す
//:
//: [目的/もくてき]:
//: - `selfhost_parser_token_role` で共有分類した role から、AST item として保持する token だけを取り出します。
//: - declaration keyword の top-level 制約は token 単体では決められないため、この projection で depth を見て適用します。
pub fn selfhost_parser_item_kind_from_token %fn TokenKind fn i32 Option SelfhostModuleItemKind \kind\depth:
    match selfhost_parser_token_role_item_kind selfhost_parser_token_role kind:
        Option::Some item_kind:
            match selfhost_module_item_kind_declaration item_kind:
                Option::Some _decl_kind:
                    selfhost_parser_decl_item_kind item_kind depth
                Option::None:
                    some item_kind
        Option::None:
            none
