#indent 4

//: # lexer
//: NEPLg2.0 self-host compiler の byte lexer [基盤/きばん]
//:
//: [目的/もくてき]:
//: - UTF-8 検証済み source text を、parser が[扱/あつか]う `SelfhostToken` の[列/れつ]へ[変換/へんかん]します。
//: - S1 の Rust lexer parity に[向/む]け、まず byte offset / token kind / lexical diagnostic の[共通/きょうつう]基盤を[固定/こてい]します。
//:
//: [実装/じっそう]:
//: - horizontal whitespace と `//` comment は[読/よ]み[飛/と]ばします。
//: - newline は token として[保持/ほじ]し、行頭の whitespace から `Indent` / `Dedent` を[生成/せいせい]します。
//: - punctuation は `match`、identifier と integer は byte range loop で[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - `#indent N` は後続行の offside 幅として[読/よ]み、invalid な引数は通常 token stream として[扱/あつか]います。
//: - string literal の escape 解釈は parser / literal lowering の責務とし、lexer は閉じ quote までの raw lexeme を[保持/ほじ]します。
//:
//: [計算量/けいさんりょう]:
//: - 入力 byte 数を n として O(n) 時間、token 数に比例する O(n) 領域です。

#import "alloc/collections/vec" as *
#import "alloc/string" as string
#import "core/field" as field
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/token" as *

//: LexErrorCode: lexer が[返/かえ]す error [分類/ぶんるい]
enum LexErrorCode:
    UnexpectedChar
    UnterminatedChar
    UnterminatedString
    InvalidIndentation
    OutOfMemory

impl Clone for LexErrorCode:
    fn clone <(&LexErrorCode)->LexErrorCode> (self):
        *self

impl Copy for LexErrorCode:
    fn copy_mark <(LexErrorCode)->LexErrorCode> (self):
        self

//: LexDiagnostic: lexer error を[構造化/こうぞうか]して[返/かえ]す値
struct LexDiagnostic:
    code <LexErrorCode>
    span <SelfhostSourceSpan>
    message <str>

impl Clone for LexDiagnostic:
    fn clone <(&LexDiagnostic)->LexDiagnostic> (self):
        *self

impl Copy for LexDiagnostic:
    fn copy_mark <(LexDiagnostic)->LexDiagnostic> (self):
        self

//: lex_diag_new: lexer diagnostic を[構築/こうちく]する
fn lex_diag_new <(LexErrorCode,SelfhostSourceSpan,str)->LexDiagnostic> (code, span, message):
    LexDiagnostic code span message

//: lex_error_code_name: error code の[安定/あんてい]した[名前/なまえ]を[返/かえ]す
fn lex_error_code_name <(LexErrorCode)->str> (code):
    match code:
        LexErrorCode::UnexpectedChar:
            "lex.unexpected_char"
        LexErrorCode::UnterminatedChar:
            "lex.unterminated_char"
        LexErrorCode::UnterminatedString:
            "lex.unterminated_string"
        LexErrorCode::InvalidIndentation:
            "lex.invalid_indentation"
        LexErrorCode::OutOfMemory:
            "lex.out_of_memory"

//: lex_is_digit: ASCII digit か[返/かえ]す
fn lex_is_digit <(i32)->bool> (ch):
    and ge ch '0' le ch '9'

//: lex_is_alpha: ASCII alphabet か[返/かえ]す
fn lex_is_alpha <(i32)->bool> (ch):
    let upper <bool> and ge ch 'A' le ch 'Z'
    let lower <bool> and ge ch 'a' le ch 'z'
    or upper lower

//: lex_is_ident_start: identifier [先頭/せんとう] byte か[返/かえ]す
fn lex_is_ident_start <(i32)->bool> (ch):
    or lex_is_alpha ch eq ch '_'

//: lex_is_ident_continue: identifier [継続/けいぞく] byte か[返/かえ]す
fn lex_is_ident_continue <(i32)->bool> (ch):
    or lex_is_ident_start ch lex_is_digit ch

//: lex_skip_line_comment: comment の[終/お]わり、または EOF offset を[返/かえ]す
fn lex_skip_line_comment <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_skip_line_comment source n add idx 1

//: lex_skip_trivia: horizontal whitespace と line comment を[読/よ]み[飛/と]ばす
//:
//: [注意/ちゅうい]:
//: - newline は token として[残/のこ]すため、ここでは[飛/と]ばしません。
fn lex_skip_trivia <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\t':
                    lex_skip_trivia source n add idx 1
                '\r':
                    lex_skip_trivia source n add idx 1
                ' ':
                    lex_skip_trivia source n add idx 1
                '/':
                    if:
                        lt add idx 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add idx 1
                            if:
                                eq next '/'
                                then:
                                    lex_skip_trivia source n lex_skip_line_comment source n add idx 2
                                else:
                                    idx
                        else:
                            idx
                _:
                    idx

//: lex_ident_end: identifier の end offset を[返/かえ]す
fn lex_ident_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_ident_continue ch
                then:
                    lex_ident_end source n add idx 1
                else:
                    idx

//: lex_int_end: integer literal の end offset を[返/かえ]す
fn lex_int_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    lex_int_end source n add idx 1
                else:
                    idx

//: lex_string_end: closing quote の offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\"` は string 内の escaped quote として[扱/あつか]います。
fn lex_string_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '"':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_string_end source n add idx 2
                _:
                    lex_string_end source n add idx 1

//: lex_char_end: char literal の closing quote offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\'` は char 内の escaped quote として[扱/あつか]います。
//: - 1 scalar かどうかの検査は parser / literal lowering の責務です。
fn lex_char_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\'':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_char_end source n add idx 2
                '\n':
                    -1
                _:
                    lex_char_end source n add idx 1

//: lex_token_slice: source slice を lexeme とする token を[作/つく]る
fn lex_token_slice <(TokenKind,str,i32,i32)->SelfhostToken> (kind, source, start, end):
    selfhost_token_new kind source_span_new 0 start end string::str_slice source start end

//: lex_structural_token: offside rule の 0 byte token を[作/つく]る
fn lex_structural_token <(TokenKind,i32)->SelfhostToken> (kind, offset):
    selfhost_token_new kind source_span_empty 0 offset ""

//: lex_line_indent_width: line start から content までの indent 幅を[返/かえ]す
fn lex_line_indent_width <(str,i32,i32,i32,i32)->i32> (source, n, idx, indent_unit, width):
    if:
        ge idx n
        then:
            width
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_indent_width source n add idx 1 indent_unit add width 1
                '\t':
                    lex_line_indent_width source n add idx 1 indent_unit add width indent_unit
                '\r':
                    lex_line_indent_width source n add idx 1 indent_unit width
                _:
                    width

//: lex_line_content_start: line start から最初の非 horizontal whitespace offset を[返/かえ]す
fn lex_line_content_start <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_content_start source n add idx 1
                '\t':
                    lex_line_content_start source n add idx 1
                '\r':
                    lex_line_content_start source n add idx 1
                _:
                    idx

//: lex_line_end: 現在行の newline 直前、または EOF offset を[返/かえ]す
fn lex_line_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_line_end source n add idx 1

//: lex_line_is_blank_or_comment: offside stack を[変/か]えない行か[返/かえ]す
fn lex_line_is_blank_or_comment <(str,i32,i32)->bool> (source, n, content_start):
    if:
        ge content_start n
        then:
            true
        else:
            let ch <i32> string::string_byte_at_unchecked source content_start
            match ch:
                '\n':
                    true
                '/':
                    if:
                        lt add content_start 1 n
                        then:
                            eq string::string_byte_at_unchecked source add content_start 1 '/'
                        else:
                            false
                _:
                    false

//: lex_directive_boundary: `#indent` の後続 byte が directive 境界か[返/かえ]す
fn lex_directive_boundary <(str,i32,i32)->bool> (source, n, idx):
    if:
        ge idx n
        then:
            true
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    true
                '\t':
                    true
                '\r':
                    true
                '\n':
                    true
                _:
                    false

//: lex_starts_with_indent_directive: line content が `#indent` で[始/はじ]まるか[返/かえ]す
fn lex_starts_with_indent_directive <(str,i32,i32)->bool> (source, n, start):
    if:
        lt n add start 7
        then:
            false
        else:
            let ok_hash <bool> eq string::string_byte_at_unchecked source start '#'
            let ok_i <bool> eq string::string_byte_at_unchecked source add start 1 'i'
            let ok_n <bool> eq string::string_byte_at_unchecked source add start 2 'n'
            let ok_d <bool> eq string::string_byte_at_unchecked source add start 3 'd'
            let ok_e <bool> eq string::string_byte_at_unchecked source add start 4 'e'
            let ok_n2 <bool> eq string::string_byte_at_unchecked source add start 5 'n'
            let ok_t <bool> eq string::string_byte_at_unchecked source add start 6 't'
            and ok_hash and ok_i and ok_n and ok_d and ok_e and ok_n2 and ok_t lex_directive_boundary source n add start 7

//: lex_skip_horizontal: 同じ行の horizontal whitespace を[読/よ]み[飛/と]ばす
fn lex_skip_horizontal <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_skip_horizontal source n add idx 1
                '\t':
                    lex_skip_horizontal source n add idx 1
                '\r':
                    lex_skip_horizontal source n add idx 1
                _:
                    idx

//: lex_parse_indent_digits: `#indent` の数値引数を[読/よ]む
fn lex_parse_indent_digits <(str,i32,i32,i32,bool)->i32> (source, n, idx, acc, seen):
    if:
        ge idx n
        then:
            if seen acc -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    let digit <i32> sub ch '0'
                    lex_parse_indent_digits source n add idx 1 add mul acc 10 digit true
                else:
                    if seen acc -1

//: lex_indent_directive_unit: `#indent N` があれば offside 幅を[更新/こうしん]する
fn lex_indent_directive_unit <(str,i32,i32,i32)->i32> (source, n, content_start, current_unit):
    if:
        lex_starts_with_indent_directive source n content_start
        then:
            let arg_start <i32> lex_skip_horizontal source n add content_start 7
            let parsed <i32> lex_parse_indent_digits source n arg_start 0 false
            if:
                lt parsed 1
                then:
                    current_unit
                else:
                    parsed
        else:
            current_unit

//: lex_stack_top_result: indent stack の末尾を[読/よ]む
fn lex_stack_top_result <(&Vec<i32>,i32)->Result<i32,LexDiagnostic>> (stack, offset):
    let stack_len <i32> len_ref<i32> stack
    if:
        le stack_len 0
        then:
            Result<i32,LexDiagnostic>::Err lex_diag_new LexErrorCode::InvalidIndentation source_span_empty 0 offset "lexer indent stack is empty"
        else:
            match get_ref<i32> stack sub stack_len 1:
                Option::Some top:
                    Result<i32,LexDiagnostic>::Ok top
                Option::None:
                    Result<i32,LexDiagnostic>::Err lex_diag_new LexErrorCode::InvalidIndentation source_span_empty 0 offset "lexer indent stack top is unavailable"

//: lex_stack_drop_top: indent stack の末尾 level を[捨/す]てた Vec を[返/かえ]す
fn lex_stack_drop_top <(Vec<i32>)->Vec<i32>> (stack):
    let stack_len <i32> *field::get_ref &stack "len"
    let stack_cap <i32> *field::get_ref &stack "cap"
    let stack_data <MemPtr<i32>> *field::get_ref &stack "data"
    Vec<i32> sub stack_len 1 stack_cap stack_data

//: lex_indent_aligned: indent 幅が offside unit に[揃/そろ]っているか[返/かえ]す
fn lex_indent_aligned <(i32,i32)->bool> (indent_width, indent_unit):
    if:
        le indent_unit 0
        then:
            true
        else:
            eq rem_s indent_width indent_unit 0

//: lex_next: 指定 offset 以降の 1 token を[返/かえ]す
fn lex_next <(str,i32,i32)->SelfhostToken> (source, n, idx):
    let start <i32> lex_skip_trivia source n idx
    if:
        ge start n
        then:
            selfhost_token_new TokenKind::EndOfFile source_span_empty 0 start ""
        else:
            let ch <i32> string::string_byte_at_unchecked source start
            match ch:
                '\n':
                    lex_token_slice TokenKind::Newline source start add start 1
                '#':
                    if:
                        lex_starts_with_indent_directive source n start
                        then:
                            lex_token_slice TokenKind::DirIndentWidth source start lex_line_end source n start
                        else:
                            lex_token_slice TokenKind::Hash source start add start 1
                '(':
                    lex_token_slice TokenKind::LParen source start add start 1
                ')':
                    lex_token_slice TokenKind::RParen source start add start 1
                ',':
                    lex_token_slice TokenKind::Comma source start add start 1
                '.':
                    lex_token_slice TokenKind::Dot source start add start 1
                ':':
                    lex_token_slice TokenKind::Colon source start add start 1
                ';':
                    lex_token_slice TokenKind::Semicolon source start add start 1
                '<':
                    lex_token_slice TokenKind::LAngle source start add start 1
                '>':
                    lex_token_slice TokenKind::RAngle source start add start 1
                '*':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add start 1
                            if:
                                eq next '>'
                                then:
                                    lex_token_slice TokenKind::EffectArrow source start add start 2
                                else:
                                    lex_token_slice TokenKind::Asterisk source start add start 1
                        else:
                            lex_token_slice TokenKind::Asterisk source start add start 1
                '-':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add start 1
                            if:
                                eq next '>'
                                then:
                                    lex_token_slice TokenKind::Arrow source start add start 2
                                else:
                                    lex_token_slice TokenKind::Unknown source start add start 1
                        else:
                            lex_token_slice TokenKind::Unknown source start add start 1
                '"':
                    let close <i32> lex_string_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedString source start n
                        else:
                            lex_token_slice TokenKind::StringLiteral source start add close 1
                '\'':
                    let close <i32> lex_char_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedChar source start n
                        else:
                            lex_token_slice TokenKind::CharLiteral source start add close 1
                _:
                    if:
                        lex_is_ident_start ch
                        then:
                            let end <i32> lex_ident_end source n add start 1
                            lex_token_slice TokenKind::Identifier source start end
                        else:
                            if:
                                lex_is_digit ch
                                then:
                                    let end <i32> lex_int_end source n add start 1
                                    lex_token_slice TokenKind::IntLiteral source start end
                                else:
                                    lex_token_slice TokenKind::Unknown source start add start 1

//: lex_error_for_token: error token を diagnostic へ[変換/へんかん]する
fn lex_error_for_token <(SelfhostToken)->LexDiagnostic> (token):
    let span <SelfhostSourceSpan> field::get token "span"
    match field::get token "kind":
        TokenKind::Hash:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Identifier:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::IntLiteral:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::CharLiteral:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::StringLiteral:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::LParen:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::RParen:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::LAngle:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::RAngle:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Comma:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Colon:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Semicolon:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Dot:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Asterisk:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Arrow:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::EffectArrow:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Newline:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Indent:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Dedent:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::DirIndentWidth:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::EndOfFile:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::UnterminatedChar:
            lex_diag_new LexErrorCode::UnterminatedChar span "unterminated char literal"
        TokenKind::UnterminatedString:
            lex_diag_new LexErrorCode::UnterminatedString span "unterminated string literal"
        TokenKind::Unknown:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"

//: lex_push: token を token buffer へ[追加/ついか]する
fn lex_push <(Vec<SelfhostToken>,SelfhostToken)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (tokens, token):
    match push<SelfhostToken> tokens token:
        Result::Ok out:
            Result<Vec<SelfhostToken>,LexDiagnostic>::Ok out
        Result::Err _e:
            let span <SelfhostSourceSpan> field::get token "span"
            Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::OutOfMemory span "lexer token buffer allocation failed"

//: lex_push_structural: `Indent` / `Dedent` / EOF などの structural token を[追加/ついか]する
fn lex_push_structural <(Vec<SelfhostToken>,TokenKind,i32)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (tokens, kind, offset):
    lex_push tokens lex_structural_token kind offset

//: lex_fail_indent: indent stack と token buffer を[解放/かいほう]して indent diagnostic を[返/かえ]す
fn lex_fail_indent <(Vec<SelfhostToken>,Vec<i32>,i32,str)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (tokens, stack, offset, message):
    free<SelfhostToken> tokens
    free<i32> stack
    Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::InvalidIndentation source_span_empty 0 offset message

//: lex_finish_eof: EOF 前に残った indent level を Dedent で[閉/と]じる
fn lex_finish_eof <(Vec<SelfhostToken>,Vec<i32>,i32)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (tokens, stack, offset):
    let stack_len <i32> len_ref<i32> &stack
    if:
        gt stack_len 1
        then:
            let next_stack <Vec<i32>> lex_stack_drop_top stack
            match lex_push_structural tokens TokenKind::Dedent offset:
                Result::Ok out:
                    lex_finish_eof out next_stack offset
                Result::Err diag:
                    free<i32> next_stack
                    Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag
        else:
            free<i32> stack
            lex_push_structural tokens TokenKind::EndOfFile offset

//: lex_dedent_to: current line の indent level に合うまで Dedent を[生成/せいせい]する
fn lex_dedent_to <(str,i32,i32,Vec<SelfhostToken>,Vec<i32>,i32,i32,bool)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (source, n, idx, tokens, stack, indent_unit, target_width, at_line_start):
    match lex_stack_top_result &stack idx:
        Result::Err diag:
            free<SelfhostToken> tokens
            free<i32> stack
            Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag
        Result::Ok current:
            if:
                eq current target_width
                then:
                    lex_all_loop source n idx tokens stack indent_unit at_line_start true
                else:
                    if:
                        lt current target_width
                        then:
                            lex_fail_indent tokens stack idx "indentation level does not match any previous indent"
                        else:
                            let next_stack <Vec<i32>> lex_stack_drop_top stack
                            match lex_push_structural tokens TokenKind::Dedent idx:
                                Result::Ok out:
                                    lex_dedent_to source n idx out next_stack indent_unit target_width at_line_start
                                Result::Err diag:
                                    free<i32> next_stack
                                    Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag

//: lex_line_start: 行頭の offside rule を[処理/しょり]する
fn lex_line_start <(str,i32,i32,Vec<SelfhostToken>,Vec<i32>,i32)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (source, n, idx, tokens, stack, indent_unit):
    let content_start <i32> lex_line_content_start source n idx
    if:
        lex_line_is_blank_or_comment source n content_start
        then:
            lex_all_loop source n idx tokens stack indent_unit true true
        else:
            let indent_width <i32> lex_line_indent_width source n idx indent_unit 0
            let next_indent_unit <i32> lex_indent_directive_unit source n content_start indent_unit
            match lex_stack_top_result &stack idx:
                Result::Err diag:
                    free<SelfhostToken> tokens
                    free<i32> stack
                    Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag
                Result::Ok current:
                    if:
                        gt indent_width current
                        then:
                            if:
                                lex_indent_aligned indent_width next_indent_unit
                                then:
                                    match push<i32> stack indent_width:
                                        Result::Ok next_stack:
                                            match lex_push_structural tokens TokenKind::Indent idx:
                                                Result::Ok out:
                                                    lex_all_loop source n idx out next_stack next_indent_unit true true
                                                Result::Err diag:
                                                    free<i32> next_stack
                                                    Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag
                                        Result::Err _e:
                                            free<SelfhostToken> tokens
                                            Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::OutOfMemory source_span_empty 0 idx "lexer indent stack allocation failed"
                                else:
                                    lex_fail_indent tokens stack idx "indentation is not aligned to #indent width"
                        else:
                            if:
                                lt indent_width current
                                then:
                                    lex_dedent_to source n idx tokens stack next_indent_unit indent_width true
                                else:
                                    lex_all_loop source n idx tokens stack next_indent_unit true true

//: lex_all_loop: EOF まで token を[集/あつ]め、offside structural token を[挿入/そうにゅう]する
fn lex_all_loop <(str,i32,i32,Vec<SelfhostToken>,Vec<i32>,i32,bool,bool)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (source, n, idx, tokens, stack, indent_unit, at_line_start, line_checked):
    if:
        ge idx n
        then:
            lex_finish_eof tokens stack idx
        else:
            if:
                and at_line_start not line_checked
                then:
                    lex_line_start source n idx tokens stack indent_unit
                else:
                    let token <SelfhostToken> lex_next source n idx
                    if:
                        selfhost_token_is_error token
                        then:
                            free<SelfhostToken> tokens
                            free<i32> stack
                            Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_error_for_token token
                        else:
                            if:
                                selfhost_token_is_eof token
                                then:
                                    lex_finish_eof tokens stack idx
                                else:
                                    match lex_push tokens token:
                                        Result::Ok out:
                                            if:
                                                selfhost_token_is_newline token
                                                then:
                                                    lex_all_loop source n selfhost_token_end token out stack indent_unit true false
                                                else:
                                                    lex_all_loop source n selfhost_token_end token out stack indent_unit false false
                                        Result::Err diag:
                                            free<i32> stack
                                            Result<Vec<SelfhostToken>,LexDiagnostic>::Err diag

//: lex_all: source text 全体を token stream へ[変換/へんかん]する
//:
//: [注意/ちゅうい]:
//: - 成功時の `Vec<SelfhostToken>` は caller が `free<SelfhostToken>` してください。
fn lex_all <(str)*>Result<Vec<SelfhostToken>,LexDiagnostic>> (source):
    match new<SelfhostToken>:
        Result::Ok tokens:
            match new<i32>:
                Result::Ok stack0:
                    match push<i32> stack0 0:
                        Result::Ok stack:
                            lex_all_loop source string::len source 0 tokens stack 4 true false
                        Result::Err _e:
                            free<SelfhostToken> tokens
                            let span <SelfhostSourceSpan> source_span_empty 0 0
                            Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::OutOfMemory span "lexer indent stack allocation failed"
                Result::Err _e:
                    free<SelfhostToken> tokens
                    let span <SelfhostSourceSpan> source_span_empty 0 0
                    Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::OutOfMemory span "lexer indent stack allocation failed"
        Result::Err _e:
            let span <SelfhostSourceSpan> source_span_empty 0 0
            Result<Vec<SelfhostToken>,LexDiagnostic>::Err lex_diag_new LexErrorCode::OutOfMemory span "lexer token buffer allocation failed"
