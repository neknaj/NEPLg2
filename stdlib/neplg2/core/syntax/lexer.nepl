#indent 4

//: # lexer
//: NEPLg2.0 self-host compiler の byte lexer [基盤/きばん]
//:
//: [目的/もくてき]:
//: - UTF-8 検証済み source text を、parser が[扱/あつか]う `SelfhostToken` の[列/れつ]へ[変換/へんかん]します。
//: - S1 の Rust lexer parity に[向/む]け、まず byte offset / token kind / lexical diagnostic の[共通/きょうつう]基盤を[固定/こてい]します。
//:
//: [実装/じっそう]:
//: - horizontal whitespace と `//` comment は[読/よ]み[飛/と]ばします。
//: - newline は token として[保持/ほじ]し、行頭の whitespace から `Indent` / `Dedent` を[生成/せいせい]します。
//: - punctuation は `match`、identifier と integer は byte range loop で[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - `#indent N` は後続行の offside 幅として[読/よ]み、invalid な引数は通常 token stream として[扱/あつか]います。
//: - string literal の escape 解釈は parser / literal lowering の責務とし、lexer は閉じ quote までの raw span を[保持/ほじ]します。
//: - 複数 file を[扱/あつか]う loader からは `lex_all_with_file_id` を[呼/よ]び、token と diagnostic の span に同じ file_id を[通/とお]します。
//:
//: [計算量/けいさんりょう]:
//: - 入力 byte 数を n として O(n) 時間、token 数に比例する O(n) 領域です。

#import "alloc/collections/vec" as *
#import "alloc/string/access" as string_access
#import "alloc/string/search" as string_search
#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/diag" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/token" as *
#import "core/field" as *

//: LexDiagnostic: lexer error を[構造化/こうぞうか]して[返/かえ]す値
pub struct LexDiagnostic:
    code <SelfhostLexerDiagnosticCode>
    span <SelfhostSourceSpan>
    message <str>

impl Clone for LexDiagnostic:
    fn clone <(&LexDiagnostic)->LexDiagnostic> (self):
        *self

impl Copy for LexDiagnostic:
    fn copy_mark <(LexDiagnostic)->LexDiagnostic> (self):
        self

//: lex_diag_new: lexer diagnostic を[構築/こうちく]する
pub fn lex_diag_new <(SelfhostLexerDiagnosticCode,SelfhostSourceSpan,str)->LexDiagnostic> (code, span, message):
    LexDiagnostic code span message

//: SelfhostLexerRawMode: raw backend text block の lexer state
//:
//: [目的/もくてき]:
//: - raw block state を i32 sentinel ではなく enum で表し、mode 追加時に match arm の更新漏れを検査できるようにします。
pub enum SelfhostLexerRawMode:
    None
    Wasm
    LlvmIr

impl Clone for SelfhostLexerRawMode:
    fn clone <(&SelfhostLexerRawMode)->SelfhostLexerRawMode> (self):
        *self

impl Copy for SelfhostLexerRawMode:
    fn copy_mark <(SelfhostLexerRawMode)->SelfhostLexerRawMode> (self):
        self

//: SelfhostLexerDirectiveKind: `#` directive の分類
//:
//: [目的/もくてき]:
//: - directive classification を enum に固定し、token 化時に match で網羅させます。
pub enum SelfhostLexerDirectiveKind:
    Entry
    IndentWidth
    Target
    Import
    Use
    IfTarget
    IfProfile
    Capability
    Wasm
    LlvmIr
    Include
    Extern
    Intrinsic
    Prelude
    NoPrelude
    Unknown

impl Clone for SelfhostLexerDirectiveKind:
    fn clone <(&SelfhostLexerDirectiveKind)->SelfhostLexerDirectiveKind> (self):
        *self

impl Copy for SelfhostLexerDirectiveKind:
    fn copy_mark <(SelfhostLexerDirectiveKind)->SelfhostLexerDirectiveKind> (self):
        self

//: lex_is_digit: ASCII digit か[返/かえ]す
pub fn lex_is_digit <(i32)->bool> (ch):
    and ge ch '0' le ch '9'

//: lex_is_alpha: ASCII alphabet か[返/かえ]す
pub fn lex_is_alpha <(i32)->bool> (ch):
    let upper <bool> and ge ch 'A' le ch 'Z'
    let lower <bool> and ge ch 'a' le ch 'z'
    or upper lower

//: lex_is_ident_start: identifier [先頭/せんとう] byte か[返/かえ]す
pub fn lex_is_ident_start <(i32)->bool> (ch):
    or lex_is_alpha ch eq ch '_'

//: lex_is_ident_continue: identifier [継続/けいぞく] byte か[返/かえ]す
pub fn lex_is_ident_continue <(i32)->bool> (ch):
    or lex_is_ident_start ch lex_is_digit ch

//: lex_skip_line_comment: comment の[終/お]わり、または EOF offset を[返/かえ]す
pub fn lex_skip_line_comment <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_skip_line_comment source n add idx 1

//: lex_is_doc_comment_at: doc comment prefix が指定 offset にあるか[返/かえ]す
pub fn lex_is_doc_comment_at <(str,i32,i32)->bool> (source, n, idx):
    if:
        lt n add idx 3
        then:
            false
        else:
            let c0 <i32> string_access::string_byte_at_unchecked source idx
            let c1 <i32> string_access::string_byte_at_unchecked source add idx 1
            let c2 <i32> string_access::string_byte_at_unchecked source add idx 2
            if:
                and eq c0 '/' and eq c1 '/' eq c2 ':'
                then:
                    true
                else:
                    if:
                        and eq c0 '/' and eq c1 '/' eq c2 '/'
                        then:
                            if:
                                lt add idx 3 n
                                then:
                                    not eq string_access::string_byte_at_unchecked source add idx 3 '/'
                                else:
                                    true
                        else:
                            false

//: lex_skip_trivia: horizontal whitespace と line comment を[読/よ]み[飛/と]ばす
//:
//: [注意/ちゅうい]:
//: - newline は token として[残/のこ]すため、ここでは[飛/と]ばしません。
//: - doc comment は token として[残/のこ]すため、通常 comment とは分けます。
pub fn lex_skip_trivia <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                '\t':
                    lex_skip_trivia source n add idx 1
                '\r':
                    lex_skip_trivia source n add idx 1
                ' ':
                    lex_skip_trivia source n add idx 1
                '/':
                    if:
                        lt add idx 1 n
                        then:
                            let next <i32> string_access::string_byte_at_unchecked source add idx 1
                            if:
                                eq next '/'
                                then:
                                    if:
                                        lex_is_doc_comment_at source n idx
                                        then:
                                            idx
                                        else:
                                            lex_skip_trivia source n lex_skip_line_comment source n add idx 2
                                else:
                                    idx
                        else:
                            idx
                _:
                    idx

//: lex_ident_end: identifier の end offset を[返/かえ]す
pub fn lex_ident_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                lex_is_ident_continue ch
                then:
                    lex_ident_end source n add idx 1
                else:
                    idx

//: lex_is_hex_digit: ASCII hexadecimal digit か[返/かえ]す
pub fn lex_is_hex_digit <(i32)->bool> (ch):
    let digit <bool> lex_is_digit ch
    let lower <bool> and ge ch 'a' le ch 'f'
    let upper <bool> and ge ch 'A' le ch 'F'
    or digit or lower upper

//: lex_hex_int_end: hexadecimal integer literal の end offset を[返/かえ]す
pub fn lex_hex_int_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                lex_is_hex_digit ch
                then:
                    lex_hex_int_end source n add idx 1
                else:
                    idx

//: lex_number_end_loop: decimal integer / float literal の end offset を[返/かえ]す
pub fn lex_number_end_loop <(str,i32,i32,bool)->i32> (source, n, idx, seen_dot):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    lex_number_end_loop source n add idx 1 seen_dot
                else:
                    match ch:
                        '.':
                            if:
                                seen_dot
                                then:
                                    idx
                                else:
                                    lex_number_end_loop source n add idx 1 true
                        _:
                            idx

//: lex_range_has_dot: byte range に `.` が含まれるか[返/かえ]す
pub fn lex_range_has_dot <(str,i32,i32)->bool> (source, idx, end):
    if:
        ge idx end
        then:
            false
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                eq ch '.'
                then:
                    true
                else:
                    lex_range_has_dot source add idx 1 end

//: lex_string_end: closing quote の offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\"` は string 内の escaped quote として[扱/あつか]います。
pub fn lex_string_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                '"':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_string_end source n add idx 2
                _:
                    lex_string_end source n add idx 1

//: lex_char_end: char literal の closing quote offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\'` は char 内の escaped quote として[扱/あつか]います。
//: - 1 scalar かどうかの検査は parser / literal lowering の責務です。
pub fn lex_char_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                '\'':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_char_end source n add idx 2
                '\n':
                    -1
                _:
                    lex_char_end source n add idx 1

//: lex_token_slice: source range を span とする token を[作/つく]る
pub fn lex_token_slice <(TokenKind,str,i32,i32,i32)->SelfhostToken> (kind, source, file_id, start, end):
    selfhost_token_new kind source_span_new file_id start end

//: lex_structural_token: offside rule の 0 byte token を[作/つく]る
pub fn lex_structural_token <(TokenKind,i32,i32)->SelfhostToken> (kind, file_id, offset):
    selfhost_token_new kind source_span_empty file_id offset

//: lex_line_indent_width: line start から content までの indent 幅を[返/かえ]す
pub fn lex_line_indent_width <(str,i32,i32,i32,i32)->i32> (source, n, idx, indent_unit, width):
    if:
        ge idx n
        then:
            width
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_indent_width source n add idx 1 indent_unit add width 1
                '\t':
                    lex_line_indent_width source n add idx 1 indent_unit add width indent_unit
                '\r':
                    lex_line_indent_width source n add idx 1 indent_unit width
                _:
                    width

//: lex_line_content_start: line start から最初の非 horizontal whitespace offset を[返/かえ]す
pub fn lex_line_content_start <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_content_start source n add idx 1
                '\t':
                    lex_line_content_start source n add idx 1
                '\r':
                    lex_line_content_start source n add idx 1
                _:
                    idx

//: lex_line_end: 現在行の newline 直前、または EOF offset を[返/かえ]す
pub fn lex_line_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_line_end source n add idx 1

//: lex_line_is_blank_or_comment: offside stack を[変/か]えない行か[返/かえ]す
pub fn lex_line_is_blank_or_comment <(str,i32,i32)->bool> (source, n, content_start):
    if:
        ge content_start n
        then:
            true
        else:
            let ch <i32> string_access::string_byte_at_unchecked source content_start
            match ch:
                '\n':
                    true
                '/':
                    if:
                        lt add content_start 1 n
                        then:
                            eq string_access::string_byte_at_unchecked source add content_start 1 '/'
                        else:
                            false
                _:
                    false

//: lex_directive_boundary: `#indent` の後続 byte が directive 境界か[返/かえ]す
pub fn lex_directive_boundary <(str,i32,i32)->bool> (source, n, idx):
    if:
        ge idx n
        then:
            true
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    true
                '\t':
                    true
                '\r':
                    true
                '\n':
                    true
                ':':
                    true
                _:
                    false

//: lex_starts_with_indent_directive: line content が `#indent` で[始/はじ]まるか[返/かえ]す
pub fn lex_starts_with_indent_directive <(str,i32,i32)->bool> (source, n, start):
    let directive <str> "#indent"
    let directive_len <i32> string_access::len directive
    and string_search::str_starts_with_at source start directive lex_directive_boundary source n add start directive_len

//: lex_skip_horizontal: 同じ行の horizontal whitespace を[読/よ]み[飛/と]ばす
pub fn lex_skip_horizontal <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_skip_horizontal source n add idx 1
                '\t':
                    lex_skip_horizontal source n add idx 1
                '\r':
                    lex_skip_horizontal source n add idx 1
                _:
                    idx

//: lex_parse_indent_digits: `#indent` の数値引数を[読/よ]む
pub fn lex_parse_indent_digits <(str,i32,i32,i32,bool)->i32> (source, n, idx, acc, seen):
    if:
        ge idx n
        then:
            if seen acc -1
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    let digit <i32> sub ch '0'
                    lex_parse_indent_digits source n add idx 1 add mul acc 10 digit true
                else:
                    if seen acc -1

//: lex_indent_directive_unit: `#indent N` があれば offside 幅を[更新/こうしん]する
pub fn lex_indent_directive_unit <(str,i32,i32,i32)->i32> (source, n, content_start, current_unit):
    if:
        lex_starts_with_indent_directive source n content_start
        then:
            let arg_start <i32> lex_skip_horizontal source n add content_start 7
            let parsed <i32> lex_parse_indent_digits source n arg_start 0 false
            if:
                lt parsed 1
                then:
                    current_unit
                else:
                    parsed
        else:
            current_unit

//: lex_stack_top_result: indent stack の末尾を[読/よ]む
pub fn lex_stack_top_result <(&Vec<i32>,i32,i32)->Result<i32,LexDiagnostic>> (stack, file_id, offset):
    let stack_len <i32> len<i32> stack
    if:
        le stack_len 0
        then:
            Result<i32,LexDiagnostic>::Err lex_diag_new SelfhostLexerDiagnosticCode::IndentLevelMismatch source_span_empty file_id offset "lexer indent stack is empty"
        else:
            match get<i32> stack sub stack_len 1:
                Option::Some top:
                    Result<i32,LexDiagnostic>::Ok top
                Option::None:
                    Result<i32,LexDiagnostic>::Err lex_diag_new SelfhostLexerDiagnosticCode::IndentLevelMismatch source_span_empty file_id offset "lexer indent stack top is unavailable"

//: lex_stack_drop_top: indent stack の末尾 level を[捨/す]てた Vec を[返/かえ]す
pub fn lex_stack_drop_top <(Vec<i32>)->Vec<i32>> (stack):
    drop_last<i32> stack

//: lex_indent_aligned: indent 幅が offside unit に[揃/そろ]っているか[返/かえ]す
pub fn lex_indent_aligned <(i32,i32)->bool> (indent_width, indent_unit):
    if:
        le indent_unit 0
        then:
            true
        else:
            eq rem_s indent_width indent_unit 0

//: lex_directive_word_at: 指定位置から directive word が始まり、後続が directive 境界か[返/かえ]す
pub fn lex_directive_word_at <(str,i32,i32,str)->bool> (source, n, start, word):
    let word_len <i32> string_access::len word
    and string_search::str_starts_with_at source start word lex_directive_boundary source n add start word_len

//: lex_directive_arg_start: directive 名の後ろの argument 開始 offset を[返/かえ]す
pub fn lex_directive_arg_start <(str,i32,i32,i32)->i32> (source, n, start, name_len):
    lex_skip_horizontal source n add start name_len

//: lex_hash_bracket_end: `#if[...]` directive の `]` 直後 offset を[返/かえ]す
pub fn lex_hash_bracket_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string_access::string_byte_at_unchecked source idx
            match ch:
                ']':
                    add idx 1
                '\n':
                    idx
                _:
                    lex_hash_bracket_end source n add idx 1

//: lex_directive_match_key_at: directive 候補の先頭 2 byte を match key にする
pub fn lex_directive_match_key_at <(str,i32,i32)->i32> (source, n, start):
    if:
        lt add start 2 n
        then:
            let first <i32> string_access::string_byte_at_unchecked source add start 1
            let second <i32> string_access::string_byte_at_unchecked source add start 2
            add mul first 256 second
        else:
            0

//: lex_directive_kind_if_word: directive 候補を実文字列で検証する
pub fn lex_directive_kind_if_word <(str,i32,i32,str,SelfhostLexerDirectiveKind,SelfhostLexerDirectiveKind)->SelfhostLexerDirectiveKind> (source, n, start, word, kind, fallback):
    if:
        lex_directive_word_at source n start word
        then:
            kind
        else:
            fallback

//: lex_directive_kind_if_prefix: bracket directive 候補を prefix で検証する
pub fn lex_directive_kind_if_prefix <(str,i32,str,SelfhostLexerDirectiveKind,SelfhostLexerDirectiveKind)->SelfhostLexerDirectiveKind> (source, start, word, kind, fallback):
    if:
        string_search::str_starts_with_at source start word
        then:
            kind
        else:
            fallback

//: lex_directive_kind_i_bucket: `#i...` directive を分類する
pub fn lex_directive_kind_i_bucket <(str,i32,i32)->SelfhostLexerDirectiveKind> (source, n, start):
    let unknown <SelfhostLexerDirectiveKind> SelfhostLexerDirectiveKind::Unknown
    let intrinsic <SelfhostLexerDirectiveKind> lex_directive_kind_if_word source n start "#intrinsic" SelfhostLexerDirectiveKind::Intrinsic unknown
    let include <SelfhostLexerDirectiveKind> lex_directive_kind_if_word source n start "#include" SelfhostLexerDirectiveKind::Include intrinsic
    lex_directive_kind_if_word source n start "#indent" SelfhostLexerDirectiveKind::IndentWidth include

//: lex_directive_kind_if_bucket: `#if[...]` directive を分類する
pub fn lex_directive_kind_if_bucket <(str,i32)->SelfhostLexerDirectiveKind> (source, start):
    let unknown <SelfhostLexerDirectiveKind> SelfhostLexerDirectiveKind::Unknown
    let profile <SelfhostLexerDirectiveKind> lex_directive_kind_if_prefix source start "#if[profile=" SelfhostLexerDirectiveKind::IfProfile unknown
    lex_directive_kind_if_prefix source start "#if[target=" SelfhostLexerDirectiveKind::IfTarget profile

//: lex_directive_kind_at: `#` directive を enum として分類する
pub fn lex_directive_kind_at <(str,i32,i32)->SelfhostLexerDirectiveKind> (source, n, start):
    match lex_directive_match_key_at source n start:
        25966:
            lex_directive_kind_if_word source n start "#entry" SelfhostLexerDirectiveKind::Entry SelfhostLexerDirectiveKind::Unknown
        25976:
            lex_directive_kind_if_word source n start "#extern" SelfhostLexerDirectiveKind::Extern SelfhostLexerDirectiveKind::Unknown
        26989:
            lex_directive_kind_if_word source n start "#import" SelfhostLexerDirectiveKind::Import SelfhostLexerDirectiveKind::Unknown
        26990:
            lex_directive_kind_i_bucket source n start
        26982:
            lex_directive_kind_if_bucket source start
        27756:
            lex_directive_kind_if_word source n start "#llvmir" SelfhostLexerDirectiveKind::LlvmIr SelfhostLexerDirectiveKind::Unknown
        28271:
            lex_directive_kind_if_word source n start "#no_prelude" SelfhostLexerDirectiveKind::NoPrelude SelfhostLexerDirectiveKind::Unknown
        28786:
            lex_directive_kind_if_word source n start "#prelude" SelfhostLexerDirectiveKind::Prelude SelfhostLexerDirectiveKind::Unknown
        29793:
            lex_directive_kind_if_word source n start "#target" SelfhostLexerDirectiveKind::Target SelfhostLexerDirectiveKind::Unknown
        30067:
            lex_directive_kind_if_word source n start "#use" SelfhostLexerDirectiveKind::Use SelfhostLexerDirectiveKind::Unknown
        30561:
            lex_directive_kind_if_word source n start "#wasm" SelfhostLexerDirectiveKind::Wasm SelfhostLexerDirectiveKind::Unknown
        25441:
            lex_directive_kind_if_word source n start "#capability" SelfhostLexerDirectiveKind::Capability SelfhostLexerDirectiveKind::Unknown
        _:
            SelfhostLexerDirectiveKind::Unknown

//: lex_directive_token: `#` から始まる directive token を[読/よ]む
pub fn lex_directive_token <(str,i32,i32,i32)->SelfhostToken> (source, n, file_id, start):
    let line_end <i32> lex_line_end source n start
    match lex_directive_kind_at source n start:
        SelfhostLexerDirectiveKind::Entry:
            let value_start <i32> lex_directive_arg_start source n start 6
            lex_token_slice TokenKind::DirEntry source file_id value_start line_end
        SelfhostLexerDirectiveKind::IndentWidth:
            lex_token_slice TokenKind::DirIndentWidth source file_id start line_end
        SelfhostLexerDirectiveKind::Target:
            lex_token_slice TokenKind::DirTarget source file_id start line_end
        SelfhostLexerDirectiveKind::Import:
            lex_token_slice TokenKind::DirImport source file_id start line_end
        SelfhostLexerDirectiveKind::Use:
            lex_token_slice TokenKind::DirUse source file_id start line_end
        SelfhostLexerDirectiveKind::IfTarget:
            lex_token_slice TokenKind::DirIfTarget source file_id start lex_hash_bracket_end source n start
        SelfhostLexerDirectiveKind::IfProfile:
            lex_token_slice TokenKind::DirIfProfile source file_id start lex_hash_bracket_end source n start
        SelfhostLexerDirectiveKind::Capability:
            lex_token_slice TokenKind::DirCapability source file_id start line_end
        SelfhostLexerDirectiveKind::Wasm:
            lex_token_slice TokenKind::DirWasm source file_id start line_end
        SelfhostLexerDirectiveKind::LlvmIr:
            lex_token_slice TokenKind::DirLlvmIr source file_id start line_end
        SelfhostLexerDirectiveKind::Include:
            lex_token_slice TokenKind::DirInclude source file_id start line_end
        SelfhostLexerDirectiveKind::Extern:
            lex_token_slice TokenKind::DirExtern source file_id start line_end
        SelfhostLexerDirectiveKind::Intrinsic:
            lex_token_slice TokenKind::DirIntrinsic source file_id start add start 10
        SelfhostLexerDirectiveKind::Prelude:
            lex_token_slice TokenKind::DirPrelude source file_id start line_end
        SelfhostLexerDirectiveKind::NoPrelude:
            lex_token_slice TokenKind::DirNoPrelude source file_id start line_end
        SelfhostLexerDirectiveKind::Unknown:
            lex_token_slice TokenKind::Unknown source file_id start add start 1

//: lex_mlstr_token: `##:` line を token 化する
pub fn lex_mlstr_token <(str,i32,i32,i32)->SelfhostToken> (source, n, file_id, start):
    lex_token_slice TokenKind::MlstrLine source file_id start lex_line_end source n start

//: lex_doc_comment_token: doc comment line を token 化する
pub fn lex_doc_comment_token <(str,i32,i32,i32)->SelfhostToken> (source, n, file_id, start):
    lex_token_slice TokenKind::DocComment source file_id start lex_line_end source n start

//: lex_keyword_match_key: keyword 候補の先頭 2 byte を scalar `match` 用の key にする
//:
//: [目的/もくてき]:
//: - NEPLg2 の `match` は現時点で `str` pattern を直接扱わないため、identifier lexeme を i32 key に正規化します。
//: - 呼び出し側は key の arm で候補を選んだあと、必ず `str_eq` で実文字列を検証してから分類します。
//:
//: [注意/ちゅうい]:
//: - 先に byte length bucket で 2 byte 以上の候補に絞ってから呼びます。
//: - key 値は lexer の内部実装です。同じ prefix の非 keyword は equality check で `None` に戻します。
pub fn lex_keyword_match_key <(str)->i32> (lexeme):
    let first <i32> string_access::string_byte_at_unchecked lexeme 0
    let second <i32> string_access::string_byte_at_unchecked lexeme 1
    add mul first 256 second

//: lex_keyword_kind_if_eq: key arm の keyword 候補を実文字列で検証する
//:
//: [目的/もくてき]:
//: - key の衝突で別 identifier が同じ arm に入っても、`str_eq` が一致した場合だけ keyword として扱います。
pub fn lex_keyword_kind_if_eq <(str,str,TokenKind)->Option<TokenKind>> (lexeme, expected, kind):
    match string_search::str_eq lexeme expected:
        true:
            Option<TokenKind>::Some kind
        false:
            Option<TokenKind>::None

//: lex_keyword_kind_len2: 2 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 2 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - arm body では必ず実文字列を検証し、prefix だけが同じ identifier は `None` にします。
pub fn lex_keyword_kind_len2 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        26222:
            lex_keyword_kind_if_eq lexeme "fn" TokenKind::KwFn
        26982:
            lex_keyword_kind_if_eq lexeme "if" TokenKind::KwIf
        25711:
            lex_keyword_kind_if_eq lexeme "do" TokenKind::KwDo
        _:
            Option<TokenKind>::None

//: lex_keyword_kind_len3: 3 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 3 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - arm body では必ず実文字列を検証し、prefix だけが同じ identifier は `None` にします。
pub fn lex_keyword_kind_len3 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        27749:
            lex_keyword_kind_if_eq lexeme "let" TokenKind::KwLet
        28021:
            lex_keyword_kind_if_eq lexeme "mut" TokenKind::KwMut
        29541:
            lex_keyword_kind_if_eq lexeme "set" TokenKind::KwSet
        26223:
            lex_keyword_kind_if_eq lexeme "for" TokenKind::KwFor
        28789:
            lex_keyword_kind_if_eq lexeme "pub" TokenKind::KwPub
        _:
            Option<TokenKind>::None

//: lex_keyword_kind_len4: 4 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 4 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - `else` と `enum`、`then` と `true` のような同じ長さの prefix 近接候補も、実文字列検証で最終判定します。
pub fn lex_keyword_kind_len4 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        25455:
            lex_keyword_kind_if_eq lexeme "cond" TokenKind::KwCond
        29800:
            lex_keyword_kind_if_eq lexeme "then" TokenKind::KwThen
        25964:
            lex_keyword_kind_if_eq lexeme "else" TokenKind::KwElse
        25966:
            lex_keyword_kind_if_eq lexeme "enum" TokenKind::KwEnum
        26989:
            lex_keyword_kind_if_eq lexeme "impl" TokenKind::KwImpl
        29810:
            lex_keyword_kind_if_eq lexeme "true" TokenKind::BoolLiteral
        _:
            Option<TokenKind>::None

//: lex_keyword_kind_len5: 5 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 5 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - arm body では必ず実文字列を検証し、prefix だけが同じ identifier は `None` にします。
pub fn lex_keyword_kind_len5 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        30568:
            lex_keyword_kind_if_eq lexeme "while" TokenKind::KwWhile
        28001:
            lex_keyword_kind_if_eq lexeme "match" TokenKind::KwMatch
        25196:
            lex_keyword_kind_if_eq lexeme "block" TokenKind::KwBlock
        21621:
            lex_keyword_kind_if_eq lexeme "Tuple" TokenKind::KwTuple
        28012:
            lex_keyword_kind_if_eq lexeme "mlstr" TokenKind::KwMlstr
        26209:
            lex_keyword_kind_if_eq lexeme "false" TokenKind::BoolLiteral
        _:
            Option<TokenKind>::None

//: lex_keyword_kind_len6: 6 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 6 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - `struct` / `trait` は token kind が異なるため、key arm 単位で実文字列を検証します。
pub fn lex_keyword_kind_len6 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        29556:
            lex_keyword_kind_if_eq lexeme "struct" TokenKind::KwStruct
        29810:
            lex_keyword_kind_if_eq lexeme "trait" TokenKind::KwTrait
        _:
            Option<TokenKind>::None

//: lex_keyword_kind_len8: 8 byte keyword の分類
//:
//: [実装/じっそう]:
//: - `lex_keyword_kind` で長さ 8 に絞った lexeme を、先頭 2 byte key の `match` で候補選択します。
//: - 現在は `noshadow` のみですが、他の 8 byte keyword を追加する場合も arm 単位で増やします。
pub fn lex_keyword_kind_len8 <(str)->Option<TokenKind>> (lexeme):
    match lex_keyword_match_key lexeme:
        28271:
            lex_keyword_kind_if_eq lexeme "noshadow" TokenKind::KwNoShadow
        _:
            Option<TokenKind>::None

//: lex_keyword_kind: identifier lexeme が keyword なら token kind を[返/かえ]す
//:
//: [目的/もくてき]:
//: - 固定 keyword table を `match` の arm として表し、追加や削除を table 単位でレビューしやすくします。
//:
//: [実装/じっそう]:
//: - まず byte length で候補を絞り、各 bucket で `lex_keyword_match_key` による scalar `match` を行います。
//: - 各 arm で `lex_keyword_kind_if_eq` により key 衝突を除外します。
//:
//: [計算量/けいさんりょう]:
//: - lexeme 長を n として O(n) 時間、追加領域は O(1) です。
pub fn lex_keyword_kind <(str)->Option<TokenKind>> (lexeme):
    match string_access::len lexeme:
        2:
            lex_keyword_kind_len2 lexeme
        3:
            lex_keyword_kind_len3 lexeme
        4:
            lex_keyword_kind_len4 lexeme
        5:
            lex_keyword_kind_len5 lexeme
        6:
            lex_keyword_kind_len6 lexeme
        8:
            lex_keyword_kind_len8 lexeme
        _:
            Option<TokenKind>::None

//: lex_consume_temp_str: lexer 内部の一時 str owner を終端する
//:
//: [目的/もくてき]:
//: - keyword 判定用に切り出した一時文字列を `SelfhostToken` へ保存しないため、判定後に所有境界を閉じます。
pub fn lex_consume_temp_str <(str)->()> (s):
    string_access::len s
    ()

//: lex_ident_or_keyword_token: identifier 範囲を keyword なら keyword token へ分類する
//:
//: [目的/もくてき]:
//: - keyword 判定には一時 `str` を使いますが、token buffer には owner を持たない range-only token だけを保存します。
pub fn lex_ident_or_keyword_token <(str,i32,i32,i32)->SelfhostToken> (source, file_id, start, end):
    let lexeme <str> string_slice::str_slice source start end
    let kind <TokenKind> match lex_keyword_kind lexeme:
        Option::Some keyword:
            keyword
        Option::None:
            TokenKind::Ident
    lex_consume_temp_str lexeme;
    lex_token_slice kind source file_id start end

//: lex_next: 指定 offset 以降の 1 token を[返/かえ]す
pub fn lex_next <(str,i32,i32,i32)->SelfhostToken> (source, n, file_id, idx):
    let start <i32> lex_skip_trivia source n idx
    if:
        ge start n
        then:
            selfhost_token_new TokenKind::Eof source_span_empty file_id start
        else:
            let ch <i32> string_access::string_byte_at_unchecked source start
            match ch:
                '\n':
                    lex_structural_token TokenKind::Newline file_id start
                '#':
                    if:
                        lt add start 2 n
                        then:
                            let next <i32> string_access::string_byte_at_unchecked source add start 1
                            if:
                                and eq next '#' eq string_access::string_byte_at_unchecked source add start 2 ':'
                                then:
                                    lex_mlstr_token source n file_id start
                                else:
                                    lex_directive_token source n file_id start
                        else:
                            lex_directive_token source n file_id start
                '(':
                    lex_token_slice TokenKind::LParen source file_id start add start 1
                ')':
                    lex_token_slice TokenKind::RParen source file_id start add start 1
                ',':
                    lex_token_slice TokenKind::Comma source file_id start add start 1
                '.':
                    lex_token_slice TokenKind::Dot source file_id start add start 1
                ':':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string_access::string_byte_at_unchecked source add start 1
                            if:
                                eq next ':'
                                then:
                                    lex_token_slice TokenKind::PathSep source file_id start add start 2
                                else:
                                    lex_token_slice TokenKind::Colon source file_id start add start 1
                        else:
                            lex_token_slice TokenKind::Colon source file_id start add start 1
                ';':
                    lex_token_slice TokenKind::Semicolon source file_id start add start 1
                '|':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string_access::string_byte_at_unchecked source add start 1
                            if:
                                eq next '>'
                                then:
                                    lex_token_slice TokenKind::Pipe source file_id start add start 2
                                else:
                                    lex_token_slice TokenKind::Unknown source file_id start add start 1
                        else:
                            lex_token_slice TokenKind::Unknown source file_id start add start 1
                '@':
                    lex_token_slice TokenKind::At source file_id start add start 1
                '&':
                    lex_token_slice TokenKind::Ampersand source file_id start add start 1
                '=':
                    lex_token_slice TokenKind::Equals source file_id start add start 1
                '<':
                    lex_token_slice TokenKind::LAngle source file_id start add start 1
                '>':
                    lex_token_slice TokenKind::RAngle source file_id start add start 1
                '*':
                    let arrow_end <i32> lex_skip_horizontal source n add start 1
                    if:
                        lt arrow_end n
                        then:
                            if:
                                eq string_access::string_byte_at_unchecked source arrow_end '>'
                                then:
                                    lex_token_slice TokenKind::Arrow source file_id start add arrow_end 1
                                else:
                                    lex_token_slice TokenKind::Star source file_id start add start 1
                        else:
                            lex_token_slice TokenKind::Star source file_id start add start 1
                '-':
                    let arrow_end <i32> lex_skip_horizontal source n add start 1
                    if:
                        lt arrow_end n
                        then:
                            if:
                                eq string_access::string_byte_at_unchecked source arrow_end '>'
                                then:
                                    lex_token_slice TokenKind::Arrow source file_id start add arrow_end 1
                                else:
                                    lex_token_slice TokenKind::Minus source file_id start add start 1
                        else:
                            lex_token_slice TokenKind::Minus source file_id start add start 1
                '/':
                    if:
                        lex_is_doc_comment_at source n start
                        then:
                            lex_doc_comment_token source n file_id start
                        else:
                            lex_token_slice TokenKind::Unknown source file_id start add start 1
                '"':
                    let close <i32> lex_string_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedString source file_id start n
                        else:
                            lex_token_slice TokenKind::StringLiteral source file_id start add close 1
                '\'':
                    let close <i32> lex_char_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedChar source file_id start n
                        else:
                            lex_token_slice TokenKind::CharLiteral source file_id start add close 1
                _:
                    if:
                        lex_is_ident_start ch
                        then:
                            let end <i32> lex_ident_end source n add start 1
                            lex_ident_or_keyword_token source file_id start end
                        else:
                            if:
                                lex_is_digit ch
                                then:
                                    if:
                                        and eq ch '0' lt add start 1 n
                                        then:
                                            let next <i32> string_access::string_byte_at_unchecked source add start 1
                                            if:
                                                or eq next 'x' eq next 'X'
                                                then:
                                                    let end <i32> lex_hex_int_end source n add start 2
                                                    lex_token_slice TokenKind::IntLiteral source file_id start end
                                                else:
                                                    let end <i32> lex_number_end_loop source n add start 1 false
                                                    if:
                                                        lex_range_has_dot source start end
                                                        then:
                                                            lex_token_slice TokenKind::FloatLiteral source file_id start end
                                                        else:
                                                            lex_token_slice TokenKind::IntLiteral source file_id start end
                                        else:
                                            let end <i32> lex_number_end_loop source n add start 1 false
                                            if:
                                                lex_range_has_dot source start end
                                                then:
                                                    lex_token_slice TokenKind::FloatLiteral source file_id start end
                                                else:
                                                    lex_token_slice TokenKind::IntLiteral source file_id start end
                                else:
                                    lex_token_slice TokenKind::Unknown source file_id start add start 1

//: lex_error_for_token: error token を diagnostic へ[変換/へんかん]する
pub fn lex_error_for_token <(SelfhostToken)->LexDiagnostic> (token):
    let span <SelfhostSourceSpan> field::get token "span"
    match field::get token "kind":
        TokenKind::Indent:
            lex_diag_new SelfhostLexerDiagnosticCode::TokenUnknown span "unexpected character"
        TokenKind::Dedent:
            lex_diag_new SelfhostLexerDiagnosticCode::TokenUnknown span "unexpected character"
        TokenKind::Newline:
            lex_diag_new SelfhostLexerDiagnosticCode::TokenUnknown span "unexpected character"
        TokenKind::Eof:
            lex_diag_new SelfhostLexerDiagnosticCode::TokenUnknown span "unexpected character"
        TokenKind::Colon:
