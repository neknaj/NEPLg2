#indent 4

//: # lexer
//: NEPLg2.0 self-host compiler の byte lexer [基盤/きばん]
//:
//: [目的/もくてき]:
//: - UTF-8 検証済み source text を、parser が[扱/あつか]う `SelfhostToken` の[列/れつ]へ[変換/へんかん]します。
//: - S1 の Rust lexer parity に[向/む]け、まず byte offset / token kind / lexical diagnostic の[共通/きょうつう]基盤を[固定/こてい]します。
//:
//: [実装/じっそう]:
//: - horizontal whitespace と `//` comment は[読/よ]み[飛/と]ばします。
//: - newline は token として[保持/ほじ]し、行頭の whitespace から `Indent` / `Dedent` を[生成/せいせい]します。
//: - punctuation は `match`、identifier と integer は byte range loop で[伸/の]ばします。
//:
//: [注意/ちゅうい]:
//: - `#indent N` は後続行の offside 幅として[読/よ]み、invalid な引数は通常 token stream として[扱/あつか]います。
//: - string literal の escape 解釈は parser / literal lowering の責務とし、lexer は閉じ quote までの raw lexeme を[保持/ほじ]します。
//:
//: [計算量/けいさんりょう]:
//: - 入力 byte 数を n として O(n) 時間、token 数に比例する O(n) 領域です。

#import "alloc/collections/vec" as *
#import "alloc/string" as string
#import "core/field" as field
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *
#import "neplg2/core/syntax/token" as *

//: LexErrorCode: lexer が[返/かえ]す error [分類/ぶんるい]
enum LexErrorCode:
    UnexpectedChar
    UnterminatedChar
    UnterminatedString
    InvalidIndentation
    OutOfMemory

impl Clone for LexErrorCode:
    fn clone <(&LexErrorCode)->LexErrorCode> (self):
        *self

impl Copy for LexErrorCode:
    fn copy_mark <(LexErrorCode)->LexErrorCode> (self):
        self

//: LexDiagnostic: lexer error を[構造化/こうぞうか]して[返/かえ]す値
struct LexDiagnostic:
    code <LexErrorCode>
    span <SelfhostSourceSpan>
    message <str>

impl Clone for LexDiagnostic:
    fn clone <(&LexDiagnostic)->LexDiagnostic> (self):
        *self

impl Copy for LexDiagnostic:
    fn copy_mark <(LexDiagnostic)->LexDiagnostic> (self):
        self

//: lex_diag_new: lexer diagnostic を[構築/こうちく]する
fn lex_diag_new <(LexErrorCode,SelfhostSourceSpan,str)->LexDiagnostic> (code, span, message):
    LexDiagnostic code span message

//: lex_error_code_name: error code の[安定/あんてい]した[名前/なまえ]を[返/かえ]す
fn lex_error_code_name <(LexErrorCode)->str> (code):
    match code:
        LexErrorCode::UnexpectedChar:
            "lex.unexpected_char"
        LexErrorCode::UnterminatedChar:
            "lex.unterminated_char"
        LexErrorCode::UnterminatedString:
            "lex.unterminated_string"
        LexErrorCode::InvalidIndentation:
            "lex.invalid_indentation"
        LexErrorCode::OutOfMemory:
            "lex.out_of_memory"

//: lex_is_digit: ASCII digit か[返/かえ]す
fn lex_is_digit <(i32)->bool> (ch):
    and ge ch '0' le ch '9'

//: lex_is_alpha: ASCII alphabet か[返/かえ]す
fn lex_is_alpha <(i32)->bool> (ch):
    let upper <bool> and ge ch 'A' le ch 'Z'
    let lower <bool> and ge ch 'a' le ch 'z'
    or upper lower

//: lex_is_ident_start: identifier [先頭/せんとう] byte か[返/かえ]す
fn lex_is_ident_start <(i32)->bool> (ch):
    or lex_is_alpha ch eq ch '_'

//: lex_is_ident_continue: identifier [継続/けいぞく] byte か[返/かえ]す
fn lex_is_ident_continue <(i32)->bool> (ch):
    or lex_is_ident_start ch lex_is_digit ch

//: lex_skip_line_comment: comment の[終/お]わり、または EOF offset を[返/かえ]す
fn lex_skip_line_comment <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_skip_line_comment source n add idx 1

//: lex_is_doc_comment_at: doc comment prefix が指定 offset にあるか[返/かえ]す
fn lex_is_doc_comment_at <(str,i32,i32)->bool> (source, n, idx):
    if:
        lt n add idx 3
        then:
            false
        else:
            let c0 <i32> string::string_byte_at_unchecked source idx
            let c1 <i32> string::string_byte_at_unchecked source add idx 1
            let c2 <i32> string::string_byte_at_unchecked source add idx 2
            if:
                and eq c0 '/' and eq c1 '/' eq c2 ':'
                then:
                    true
                else:
                    if:
                        and eq c0 '/' and eq c1 '/' eq c2 '/'
                        then:
                            if:
                                lt add idx 3 n
                                then:
                                    not eq string::string_byte_at_unchecked source add idx 3 '/'
                                else:
                                    true
                        else:
                            false

//: lex_skip_trivia: horizontal whitespace と line comment を[読/よ]み[飛/と]ばす
//:
//: [注意/ちゅうい]:
//: - newline は token として[残/のこ]すため、ここでは[飛/と]ばしません。
//: - doc comment は token として[残/のこ]すため、通常 comment とは分けます。
fn lex_skip_trivia <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\t':
                    lex_skip_trivia source n add idx 1
                '\r':
                    lex_skip_trivia source n add idx 1
                ' ':
                    lex_skip_trivia source n add idx 1
                '/':
                    if:
                        lt add idx 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add idx 1
                            if:
                                eq next '/'
                                then:
                                    if:
                                        lex_is_doc_comment_at source n idx
                                        then:
                                            idx
                                        else:
                                            lex_skip_trivia source n lex_skip_line_comment source n add idx 2
                                else:
                                    idx
                        else:
                            idx
                _:
                    idx

//: lex_ident_end: identifier の end offset を[返/かえ]す
fn lex_ident_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_ident_continue ch
                then:
                    lex_ident_end source n add idx 1
                else:
                    idx

//: lex_is_hex_digit: ASCII hexadecimal digit か[返/かえ]す
fn lex_is_hex_digit <(i32)->bool> (ch):
    let digit <bool> lex_is_digit ch
    let lower <bool> and ge ch 'a' le ch 'f'
    let upper <bool> and ge ch 'A' le ch 'F'
    or digit or lower upper

//: lex_hex_int_end: hexadecimal integer literal の end offset を[返/かえ]す
fn lex_hex_int_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_hex_digit ch
                then:
                    lex_hex_int_end source n add idx 1
                else:
                    idx

//: lex_number_end_loop: decimal integer / float literal の end offset を[返/かえ]す
fn lex_number_end_loop <(str,i32,i32,bool)->i32> (source, n, idx, seen_dot):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    lex_number_end_loop source n add idx 1 seen_dot
                else:
                    match ch:
                        '.':
                            if:
                                seen_dot
                                then:
                                    idx
                                else:
                                    lex_number_end_loop source n add idx 1 true
                        _:
                            idx

//: lex_range_has_dot: byte range に `.` が含まれるか[返/かえ]す
fn lex_range_has_dot <(str,i32,i32)->bool> (source, idx, end):
    if:
        ge idx end
        then:
            false
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                eq ch '.'
                then:
                    true
                else:
                    lex_range_has_dot source add idx 1 end

//: lex_string_end: closing quote の offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\"` は string 内の escaped quote として[扱/あつか]います。
fn lex_string_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '"':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_string_end source n add idx 2
                _:
                    lex_string_end source n add idx 1

//: lex_char_end: char literal の closing quote offset を[返/かえ]す
//:
//: [注意/ちゅうい]:
//: - 見つからない場合は -1 を[返/かえ]します。
//: - `\'` は char 内の escaped quote として[扱/あつか]います。
//: - 1 scalar かどうかの検査は parser / literal lowering の責務です。
fn lex_char_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\'':
                    idx
                '\\':
                    if:
                        ge add idx 1 n
                        then:
                            -1
                        else:
                            lex_char_end source n add idx 2
                '\n':
                    -1
                _:
                    lex_char_end source n add idx 1

//: lex_token_slice: source slice を lexeme とする token を[作/つく]る
fn lex_token_slice <(TokenKind,str,i32,i32)->SelfhostToken> (kind, source, start, end):
    selfhost_token_new kind source_span_new 0 start end string::str_slice source start end

//: lex_structural_token: offside rule の 0 byte token を[作/つく]る
fn lex_structural_token <(TokenKind,i32)->SelfhostToken> (kind, offset):
    selfhost_token_new kind source_span_empty 0 offset ""

//: lex_line_indent_width: line start から content までの indent 幅を[返/かえ]す
fn lex_line_indent_width <(str,i32,i32,i32,i32)->i32> (source, n, idx, indent_unit, width):
    if:
        ge idx n
        then:
            width
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_indent_width source n add idx 1 indent_unit add width 1
                '\t':
                    lex_line_indent_width source n add idx 1 indent_unit add width indent_unit
                '\r':
                    lex_line_indent_width source n add idx 1 indent_unit width
                _:
                    width

//: lex_line_content_start: line start から最初の非 horizontal whitespace offset を[返/かえ]す
fn lex_line_content_start <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_line_content_start source n add idx 1
                '\t':
                    lex_line_content_start source n add idx 1
                '\r':
                    lex_line_content_start source n add idx 1
                _:
                    idx

//: lex_line_end: 現在行の newline 直前、または EOF offset を[返/かえ]す
fn lex_line_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                '\n':
                    idx
                _:
                    lex_line_end source n add idx 1

//: lex_line_is_blank_or_comment: offside stack を[変/か]えない行か[返/かえ]す
fn lex_line_is_blank_or_comment <(str,i32,i32)->bool> (source, n, content_start):
    if:
        ge content_start n
        then:
            true
        else:
            let ch <i32> string::string_byte_at_unchecked source content_start
            match ch:
                '\n':
                    true
                '/':
                    if:
                        lt add content_start 1 n
                        then:
                            eq string::string_byte_at_unchecked source add content_start 1 '/'
                        else:
                            false
                _:
                    false

//: lex_directive_boundary: `#indent` の後続 byte が directive 境界か[返/かえ]す
fn lex_directive_boundary <(str,i32,i32)->bool> (source, n, idx):
    if:
        ge idx n
        then:
            true
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    true
                '\t':
                    true
                '\r':
                    true
                '\n':
                    true
                ':':
                    true
                _:
                    false

//: lex_starts_with_indent_directive: line content が `#indent` で[始/はじ]まるか[返/かえ]す
fn lex_starts_with_indent_directive <(str,i32,i32)->bool> (source, n, start):
    if:
        lt n add start 7
        then:
            false
        else:
            let ok_hash <bool> eq string::string_byte_at_unchecked source start '#'
            let ok_i <bool> eq string::string_byte_at_unchecked source add start 1 'i'
            let ok_n <bool> eq string::string_byte_at_unchecked source add start 2 'n'
            let ok_d <bool> eq string::string_byte_at_unchecked source add start 3 'd'
            let ok_e <bool> eq string::string_byte_at_unchecked source add start 4 'e'
            let ok_n2 <bool> eq string::string_byte_at_unchecked source add start 5 'n'
            let ok_t <bool> eq string::string_byte_at_unchecked source add start 6 't'
            and ok_hash and ok_i and ok_n and ok_d and ok_e and ok_n2 and ok_t lex_directive_boundary source n add start 7

//: lex_skip_horizontal: 同じ行の horizontal whitespace を[読/よ]み[飛/と]ばす
fn lex_skip_horizontal <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ' ':
                    lex_skip_horizontal source n add idx 1
                '\t':
                    lex_skip_horizontal source n add idx 1
                '\r':
                    lex_skip_horizontal source n add idx 1
                _:
                    idx

//: lex_parse_indent_digits: `#indent` の数値引数を[読/よ]む
fn lex_parse_indent_digits <(str,i32,i32,i32,bool)->i32> (source, n, idx, acc, seen):
    if:
        ge idx n
        then:
            if seen acc -1
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            if:
                lex_is_digit ch
                then:
                    let digit <i32> sub ch '0'
                    lex_parse_indent_digits source n add idx 1 add mul acc 10 digit true
                else:
                    if seen acc -1

//: lex_indent_directive_unit: `#indent N` があれば offside 幅を[更新/こうしん]する
fn lex_indent_directive_unit <(str,i32,i32,i32)->i32> (source, n, content_start, current_unit):
    if:
        lex_starts_with_indent_directive source n content_start
        then:
            let arg_start <i32> lex_skip_horizontal source n add content_start 7
            let parsed <i32> lex_parse_indent_digits source n arg_start 0 false
            if:
                lt parsed 1
                then:
                    current_unit
                else:
                    parsed
        else:
            current_unit

//: lex_stack_top_result: indent stack の末尾を[読/よ]む
fn lex_stack_top_result <(&Vec<i32>,i32)->Result<i32,LexDiagnostic>> (stack, offset):
    let stack_len <i32> len_ref<i32> stack
    if:
        le stack_len 0
        then:
            Result<i32,LexDiagnostic>::Err lex_diag_new LexErrorCode::InvalidIndentation source_span_empty 0 offset "lexer indent stack is empty"
        else:
            match get_ref<i32> stack sub stack_len 1:
                Option::Some top:
                    Result<i32,LexDiagnostic>::Ok top
                Option::None:
                    Result<i32,LexDiagnostic>::Err lex_diag_new LexErrorCode::InvalidIndentation source_span_empty 0 offset "lexer indent stack top is unavailable"

//: lex_stack_drop_top: indent stack の末尾 level を[捨/す]てた Vec を[返/かえ]す
fn lex_stack_drop_top <(Vec<i32>)->Vec<i32>> (stack):
    let stack_len <i32> *field::get_ref &stack "len"
    let stack_cap <i32> *field::get_ref &stack "cap"
    let stack_data <MemPtr<i32>> *field::get_ref &stack "data"
    Vec<i32> sub stack_len 1 stack_cap stack_data

//: lex_indent_aligned: indent 幅が offside unit に[揃/そろ]っているか[返/かえ]す
fn lex_indent_aligned <(i32,i32)->bool> (indent_width, indent_unit):
    if:
        le indent_unit 0
        then:
            true
        else:
            eq rem_s indent_width indent_unit 0

//: lex_directive_word_at: 指定位置から directive word が始まり、後続が directive 境界か[返/かえ]す
fn lex_directive_word_at <(str,i32,i32,str)->bool> (source, n, start, word):
    let word_len <i32> string::len word
    if:
        lt n add start word_len
        then:
            false
        else:
            and string::str_eq_at source word start word_len 0 lex_directive_boundary source n add start word_len

//: lex_directive_arg_start: directive 名の後ろの argument 開始 offset を[返/かえ]す
fn lex_directive_arg_start <(str,i32,i32,i32)->i32> (source, n, start, name_len):
    lex_skip_horizontal source n add start name_len

//: lex_hash_bracket_end: `#if[...]` directive の `]` 直後 offset を[返/かえ]す
fn lex_hash_bracket_end <(str,i32,i32)->i32> (source, n, idx):
    if:
        ge idx n
        then:
            idx
        else:
            let ch <i32> string::string_byte_at_unchecked source idx
            match ch:
                ']':
                    add idx 1
                '\n':
                    idx
                _:
                    lex_hash_bracket_end source n add idx 1

//: lex_directive_token: `#` から始まる directive token を[読/よ]む
fn lex_directive_token <(str,i32,i32)->SelfhostToken> (source, n, start):
    let line_end <i32> lex_line_end source n start
    if:
        lex_directive_word_at source n start "#entry"
        then:
            let value_start <i32> lex_directive_arg_start source n start 6
            lex_token_slice TokenKind::DirEntry source value_start line_end
        else:
            if:
                lex_directive_word_at source n start "#indent"
                then:
                    lex_token_slice TokenKind::DirIndentWidth source start line_end
                else:
                    if:
                        lex_directive_word_at source n start "#target"
                        then:
                            lex_token_slice TokenKind::DirTarget source start line_end
                        else:
                            if:
                                lex_directive_word_at source n start "#import"
                                then:
                                    lex_token_slice TokenKind::DirImport source start line_end
                                else:
                                    if:
                                        lex_directive_word_at source n start "#use"
                                        then:
                                            lex_token_slice TokenKind::DirUse source start line_end
                                        else:
                                            if:
                                                lex_directive_word_at source n start "#capability"
                                                then:
                                                    lex_token_slice TokenKind::DirCapability source start line_end
                                                else:
                                                    if:
                                                        lex_directive_word_at source n start "#wasm"
                                                        then:
                                                            lex_token_slice TokenKind::DirWasm source start line_end
                                                        else:
                                                            if:
                                                                lex_directive_word_at source n start "#llvmir"
                                                                then:
                                                                    lex_token_slice TokenKind::DirLlvmIr source start line_end
                                                                else:
                                                                    if:
                                                                        lex_directive_word_at source n start "#include"
                                                                        then:
                                                                            lex_token_slice TokenKind::DirInclude source start line_end
                                                                        else:
                                                                            if:
                                                                                lex_directive_word_at source n start "#extern"
                                                                                then:
                                                                                    lex_token_slice TokenKind::DirExtern source start line_end
                                                                                else:
                                                                                    if:
                                                                                        lex_directive_word_at source n start "#intrinsic"
                                                                                        then:
                                                                                            lex_token_slice TokenKind::DirIntrinsic source start add start 10
                                                                                        else:
                                                                                            if:
                                                                                                lex_directive_word_at source n start "#prelude"
                                                                                                then:
                                                                                                    lex_token_slice TokenKind::DirPrelude source start line_end
                                                                                                else:
                                                                                                    if:
                                                                                                        lex_directive_word_at source n start "#no_prelude"
                                                                                                        then:
                                                                                                            lex_token_slice TokenKind::DirNoPrelude source start line_end
                                                                                                        else:
                                                                                                            if:
                                                                                                                ge n add start 11
                                                                                                                then:
                                                                                                                    if:
                                                                                                                        string::str_eq_at source "#if[target=" start 11 0
                                                                                                                        then:
                                                                                                                            lex_token_slice TokenKind::DirIfTarget source start lex_hash_bracket_end source n start
                                                                                                                        else:
                                                                                                                            if:
                                                                                                                                ge n add start 12
                                                                                                                                then:
                                                                                                                                    if:
                                                                                                                                        string::str_eq_at source "#if[profile=" start 12 0
                                                                                                                                        then:
                                                                                                                                            lex_token_slice TokenKind::DirIfProfile source start lex_hash_bracket_end source n start
                                                                                                                                        else:
                                                                                                                                            lex_token_slice TokenKind::Unknown source start add start 1
                                                                                                                                else:
                                                                                                                                    lex_token_slice TokenKind::Unknown source start add start 1
                                                                                                                else:
                                                                                                                    if:
                                                                                                                        ge n add start 12
                                                                                                                        then:
                                                                                                                            if:
                                                                                                                                string::str_eq_at source "#if[profile=" start 12 0
                                                                                                                                then:
                                                                                                                                    lex_token_slice TokenKind::DirIfProfile source start lex_hash_bracket_end source n start
                                                                                                                                else:
                                                                                                                                    lex_token_slice TokenKind::Unknown source start add start 1
                                                                                                                        else:
                                                                                                                            lex_token_slice TokenKind::Unknown source start add start 1

//: lex_mlstr_token: `##:` line を token 化する
fn lex_mlstr_token <(str,i32,i32)->SelfhostToken> (source, n, start):
    lex_token_slice TokenKind::MlstrLine source start lex_line_end source n start

//: lex_doc_comment_token: doc comment line を token 化する
fn lex_doc_comment_token <(str,i32,i32)->SelfhostToken> (source, n, start):
    lex_token_slice TokenKind::DocComment source start lex_line_end source n start

//: lex_keyword_kind: identifier lexeme が keyword なら token kind を[返/かえ]す
fn lex_keyword_kind <(str)->Option<TokenKind>> (lexeme):
    if:
        string::str_eq lexeme "fn"
        then:
            Option<TokenKind>::Some TokenKind::KwFn
        else:
            if:
                string::str_eq lexeme "let"
                then:
                    Option<TokenKind>::Some TokenKind::KwLet
                else:
                    if:
                        string::str_eq lexeme "mut"
                        then:
                            Option<TokenKind>::Some TokenKind::KwMut
                        else:
                            if:
                                string::str_eq lexeme "noshadow"
                                then:
                                    Option<TokenKind>::Some TokenKind::KwNoShadow
                                else:
                                    if:
                                        string::str_eq lexeme "set"
                                        then:
                                            Option<TokenKind>::Some TokenKind::KwSet
                                        else:
                                            if:
                                                string::str_eq lexeme "if"
                                                then:
                                                    Option<TokenKind>::Some TokenKind::KwIf
                                                else:
                                                    if:
                                                        string::str_eq lexeme "while"
                                                        then:
                                                            Option<TokenKind>::Some TokenKind::KwWhile
                                                        else:
                                                            if:
                                                                string::str_eq lexeme "cond"
                                                                then:
                                                                    Option<TokenKind>::Some TokenKind::KwCond
                                                                else:
                                                                    if:
                                                                        string::str_eq lexeme "then"
                                                                        then:
                                                                            Option<TokenKind>::Some TokenKind::KwThen
                                                                        else:
                                                                            if:
                                                                                string::str_eq lexeme "else"
                                                                                then:
                                                                                    Option<TokenKind>::Some TokenKind::KwElse
                                                                                else:
                                                                                    if:
                                                                                        string::str_eq lexeme "do"
                                                                                        then:
                                                                                            Option<TokenKind>::Some TokenKind::KwDo
                                                                                        else:
                                                                                            if:
                                                                                                string::str_eq lexeme "struct"
                                                                                                then:
                                                                                                    Option<TokenKind>::Some TokenKind::KwStruct
                                                                                                else:
                                                                                                    if:
                                                                                                        string::str_eq lexeme "enum"
                                                                                                        then:
                                                                                                            Option<TokenKind>::Some TokenKind::KwEnum
                                                                                                        else:
                                                                                                            if:
                                                                                                                string::str_eq lexeme "match"
                                                                                                                then:
                                                                                                                    Option<TokenKind>::Some TokenKind::KwMatch
                                                                                                                else:
                                                                                                                    if:
                                                                                                                        string::str_eq lexeme "trait"
                                                                                                                        then:
                                                                                                                            Option<TokenKind>::Some TokenKind::KwTrait
                                                                                                                        else:
                                                                                                                            if:
                                                                                                                                string::str_eq lexeme "impl"
                                                                                                                                then:
                                                                                                                                    Option<TokenKind>::Some TokenKind::KwImpl
                                                                                                                                else:
                                                                                                                                    if:
                                                                                                                                        string::str_eq lexeme "for"
                                                                                                                                        then:
                                                                                                                                            Option<TokenKind>::Some TokenKind::KwFor
                                                                                                                                        else:
                                                                                                                                            if:
                                                                                                                                                string::str_eq lexeme "pub"
                                                                                                                                                then:
                                                                                                                                                    Option<TokenKind>::Some TokenKind::KwPub
                                                                                                                                                else:
                                                                                                                                                    if:
                                                                                                                                                        string::str_eq lexeme "block"
                                                                                                                                                        then:
                                                                                                                                                            Option<TokenKind>::Some TokenKind::KwBlock
                                                                                                                                                        else:
                                                                                                                                                            if:
                                                                                                                                                                string::str_eq lexeme "Tuple"
                                                                                                                                                                then:
                                                                                                                                                                    Option<TokenKind>::Some TokenKind::KwTuple
                                                                                                                                                                else:
                                                                                                                                                                    if:
                                                                                                                                                                        string::str_eq lexeme "mlstr"
                                                                                                                                                                        then:
                                                                                                                                                                            Option<TokenKind>::Some TokenKind::KwMlstr
                                                                                                                                                                        else:
                                                                                                                                                                            if:
                                                                                                                                                                                string::str_eq lexeme "true"
                                                                                                                                                                                then:
                                                                                                                                                                                    Option<TokenKind>::Some TokenKind::BoolLiteral
                                                                                                                                                                                else:
                                                                                                                                                                                    if:
                                                                                                                                                                                        string::str_eq lexeme "false"
                                                                                                                                                                                        then:
                                                                                                                                                                                            Option<TokenKind>::Some TokenKind::BoolLiteral
                                                                                                                                                                                        else:
                                                                                                                                                                                            Option<TokenKind>::None

//: lex_next: 指定 offset 以降の 1 token を[返/かえ]す
fn lex_next <(str,i32,i32)->SelfhostToken> (source, n, idx):
    let start <i32> lex_skip_trivia source n idx
    if:
        ge start n
        then:
            selfhost_token_new TokenKind::Eof source_span_empty 0 start ""
        else:
            let ch <i32> string::string_byte_at_unchecked source start
            match ch:
                '\n':
                    lex_structural_token TokenKind::Newline start
                '#':
                    if:
                        lt add start 2 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add start 1
                            if:
                                and eq next '#' eq string::string_byte_at_unchecked source add start 2 ':'
                                then:
                                    lex_mlstr_token source n start
                                else:
                                    lex_directive_token source n start
                        else:
                            lex_directive_token source n start
                '(':
                    lex_token_slice TokenKind::LParen source start add start 1
                ')':
                    lex_token_slice TokenKind::RParen source start add start 1
                ',':
                    lex_token_slice TokenKind::Comma source start add start 1
                '.':
                    lex_token_slice TokenKind::Dot source start add start 1
                ':':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add start 1
                            if:
                                eq next ':'
                                then:
                                    lex_token_slice TokenKind::PathSep source start add start 2
                                else:
                                    lex_token_slice TokenKind::Colon source start add start 1
                        else:
                            lex_token_slice TokenKind::Colon source start add start 1
                ';':
                    lex_token_slice TokenKind::Semicolon source start add start 1
                '|':
                    if:
                        lt add start 1 n
                        then:
                            let next <i32> string::string_byte_at_unchecked source add start 1
                            if:
                                eq next '>'
                                then:
                                    lex_token_slice TokenKind::Pipe source start add start 2
                                else:
                                    lex_token_slice TokenKind::Unknown source start add start 1
                        else:
                            lex_token_slice TokenKind::Unknown source start add start 1
                '@':
                    lex_token_slice TokenKind::At source start add start 1
                '&':
                    lex_token_slice TokenKind::Ampersand source start add start 1
                '=':
                    lex_token_slice TokenKind::Equals source start add start 1
                '<':
                    lex_token_slice TokenKind::LAngle source start add start 1
                '>':
                    lex_token_slice TokenKind::RAngle source start add start 1
                '*':
                    let arrow_end <i32> lex_skip_horizontal source n add start 1
                    if:
                        lt arrow_end n
                        then:
                            if:
                                eq string::string_byte_at_unchecked source arrow_end '>'
                                then:
                                    lex_token_slice TokenKind::Arrow source start add arrow_end 1
                                else:
                                    lex_token_slice TokenKind::Star source start add start 1
                        else:
                            lex_token_slice TokenKind::Star source start add start 1
                '-':
                    let arrow_end <i32> lex_skip_horizontal source n add start 1
                    if:
                        lt arrow_end n
                        then:
                            if:
                                eq string::string_byte_at_unchecked source arrow_end '>'
                                then:
                                    lex_token_slice TokenKind::Arrow source start add arrow_end 1
                                else:
                                    lex_token_slice TokenKind::Minus source start add start 1
                        else:
                            lex_token_slice TokenKind::Minus source start add start 1
                '/':
                    if:
                        lex_is_doc_comment_at source n start
                        then:
                            lex_doc_comment_token source n start
                        else:
                            lex_token_slice TokenKind::Unknown source start add start 1
                '"':
                    let close <i32> lex_string_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedString source start n
                        else:
                            lex_token_slice TokenKind::StringLiteral source start add close 1
                '\'':
                    let close <i32> lex_char_end source n add start 1
                    if:
                        lt close 0
                        then:
                            lex_token_slice TokenKind::UnterminatedChar source start n
                        else:
                            lex_token_slice TokenKind::CharLiteral source start add close 1
                _:
                    if:
                        lex_is_ident_start ch
                        then:
                            let end <i32> lex_ident_end source n add start 1
                            let lexeme <str> string::str_slice source start end
                            match lex_keyword_kind lexeme:
                                Option::Some kind:
                                    lex_token_slice kind source start end
                                Option::None:
                                    lex_token_slice TokenKind::Ident source start end
                        else:
                            if:
                                lex_is_digit ch
                                then:
                                    if:
                                        and eq ch '0' lt add start 1 n
                                        then:
                                            let next <i32> string::string_byte_at_unchecked source add start 1
                                            if:
                                                or eq next 'x' eq next 'X'
                                                then:
                                                    let end <i32> lex_hex_int_end source n add start 2
                                                    lex_token_slice TokenKind::IntLiteral source start end
                                                else:
                                                    let end <i32> lex_number_end_loop source n add start 1 false
                                                    if:
                                                        lex_range_has_dot source start end
                                                        then:
                                                            lex_token_slice TokenKind::FloatLiteral source start end
                                                        else:
                                                            lex_token_slice TokenKind::IntLiteral source start end
                                        else:
                                            let end <i32> lex_number_end_loop source n add start 1 false
                                            if:
                                                lex_range_has_dot source start end
                                                then:
                                                    lex_token_slice TokenKind::FloatLiteral source start end
                                                else:
                                                    lex_token_slice TokenKind::IntLiteral source start end
                                else:
                                    lex_token_slice TokenKind::Unknown source start add start 1

//: lex_error_for_token: error token を diagnostic へ[変換/へんかん]する
fn lex_error_for_token <(SelfhostToken)->LexDiagnostic> (token):
    let span <SelfhostSourceSpan> field::get token "span"
    match field::get token "kind":
        TokenKind::Indent:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Dedent:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Newline:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Eof:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Colon:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Semicolon:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Pipe:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::LParen:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::RParen:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::Comma:
            lex_diag_new LexErrorCode::UnexpectedChar span "unexpected character"
        TokenKind::LAngle:
