//: selfhost_token_end: token span の end offset を[返/かえ]す
fn selfhost_token_end <(SelfhostToken)->i32> (token):
    let span <SelfhostSourceSpan> field::get token "span"
    field::get span "end"

//: selfhost_token_stage0: Stage 0 marker 互換の smoke API
fn selfhost_token_stage0 <()->i32> ():
    let token <SelfhostToken> selfhost_token_new TokenKind::Ident source_span_new 0 1 3
    if selfhost_token_is_expr_start token 0 1
