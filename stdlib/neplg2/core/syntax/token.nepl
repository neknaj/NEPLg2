#indent 4

//: # token
//: NEPLg2.0 lexer / parser が[共有/きょうゆう]する token [表現/ひょうげん]
//:
//: [目的/もくてき]:
//: - lexer output を `TokenKind` / `SelfhostToken` として[固定/こてい]し、parser が byte offset を[失/うしな]わずに[扱/あつか]えるようにします。
//: - `token_kind_name` は Rust `analyze_lex` JSON の `kind` と同じ名前を[返/かえ]し、self-host lexer と Rust lexer の比較を単純にします。
//:
//: [注意/ちゅうい]:
//: - `Indent` / `Dedent` / `Eof` は byte slice を[持/も]たない structural token です。
//: - payload を持つ Rust token は、self-host 側では source text と span から必要な lexeme を復元します。
//:
//: [計算量/けいさんりょう]:
//: - token の[構築/こうちく]と kind [判定/はんてい]は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/field" as field
//:| #import "core/math" as *
//:| #import "alloc/string" as string
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/token" as *
//: fn main %fn unit i32 \unit:
//:     let token %SelfhostToken selfhost_token_new TokenKind::Ident source_span_new 0 0 2
//:     if and selfhost_token_is_expr_start token string::str_eq "fn" selfhost_token_lexeme "fn" token 0 1
//: ```

pub #import "./token/kind" as *
pub #import "./token/value" as *
pub #import "./token/name" as *
pub #import "./token/predicate/eof" as *
pub #import "./token/predicate/error" as *
pub #import "./token/predicate/newline" as *
pub #import "./token/predicate/expr_start" as *
pub #import "./token/stage0" as *
