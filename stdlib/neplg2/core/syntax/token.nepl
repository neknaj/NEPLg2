#indent 4

//: # token
//: NEPLg2.0 lexer / parser が[共有/きょうゆう]する token [表現/ひょうげん]
//:
//: [目的/もくてき]:
//: - lexer output を `TokenKind` / `SelfhostToken` として[固定/こてい]し、parser が byte offset を[失/うしな]わずに[扱/あつか]えるようにします。
//: - `token_kind_name` は Rust `analyze_lex` JSON の `kind` と同じ名前を[返/かえ]し、self-host lexer と Rust lexer の比較を単純にします。
//:
//: [注意/ちゅうい]:
//: - `Indent` / `Dedent` / `Eof` は byte slice を[持/も]たない structural token です。
//: - payload を持つ Rust token は、self-host 側では source text と span から必要な lexeme を復元します。
//:
//: [計算量/けいさんりょう]:
//: - token の[構築/こうちく]と kind [判定/はんてい]は O(1) です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target core
//:| #import "core/field" as field
//:| #import "alloc/string" as string
//:| #import "neplg2/core/infra/span" as *
//:| #import "neplg2/core/syntax/token" as *
//: fn main <()->i32> ():
//:     let token <SelfhostToken> selfhost_token_new TokenKind::Ident source_span_new 0 0 2
//:     if and selfhost_token_is_expr_start token string::str_eq "fn" selfhost_token_lexeme "fn" token 0 1
//: ```

#import "alloc/string/slice" as string_slice
#import "core/field" as field
#import "core/traits/copy" as *
#import "neplg2/core/infra/span" as *

//: TokenKind: NEPLg2.0 lexer が[生成/せいせい]する token [種類/しゅるい]
//:
//: [目的/もくてき]:
//: - Rust `nepl-core::lexer::TokenKind` の公開 JSON kind と同じ分類を self-host 側へ持ちます。
//: - `Unterminated*` / `Unknown` は self-host lexer 内部の diagnostic 化用 token です。
enum TokenKind:
    Indent
    Dedent
    Newline
    Eof
    Colon
    Semicolon
    Pipe
    LParen
    RParen
    Comma
    LAngle
    RAngle
    Arrow
    PathSep
    At
    Dot
    Ampersand
    Star
    Minus
    Equals
    Ident
    IntLiteral
    FloatLiteral
    BoolLiteral
    CharLiteral
    StringLiteral
    UnitLiteral
    KwFn
    KwLet
    KwMut
    KwNoShadow
    KwSet
    KwIf
    KwWhile
    KwCond
    KwThen
    KwElse
    KwDo
    KwStruct
    KwEnum
    KwMatch
    KwTrait
    KwImpl
    KwFor
    KwPub
    KwBlock
    KwTuple
    KwMlstr
    DirEntry
    DirTarget
    DirImport
    DirUse
    DirIfTarget
    DirIfProfile
    DirCapability
    DirWasm
    DirLlvmIr
    DirIndentWidth
    DirInclude
    DirExtern
    DirIntrinsic
    DirPrelude
    DirNoPrelude
    WasmText
    LlvmIrText
    MlstrLine
    DocComment
    UnterminatedChar
    UnterminatedString
    Unknown

impl Clone for TokenKind:
    fn clone <(&TokenKind)->TokenKind> (self):
        *self

impl Copy for TokenKind:
    fn copy_mark <(TokenKind)->TokenKind> (self):
        self

//: SelfhostToken: kind / span を[持/も]つ token
//:
//: [注意/ちゅうい]:
//: - token は `Vec<SelfhostToken>` に[格納/かくのう]される Copy 値です。owned `str` を field に[持/も]たせず、lexeme は source text と span から必要な境界でだけ[切/き]り[出/だ]します。
struct SelfhostToken:
    kind <TokenKind>
    span <SelfhostSourceSpan>

impl Clone for SelfhostToken:
    fn clone <(&SelfhostToken)->SelfhostToken> (self):
        *self

impl Copy for SelfhostToken:
    fn copy_mark <(SelfhostToken)->SelfhostToken> (self):
        self

//: selfhost_token_new: token を[構築/こうちく]する
fn selfhost_token_new <(TokenKind,SelfhostSourceSpan)->SelfhostToken> (kind, span):
    SelfhostToken kind span

//: selfhost_token_lexeme: source text と token span から lexeme を[切/き]り[出/だ]す
//:
//: [目的/もくてき]:
//: - `SelfhostToken` 自体を Copy-only に保ち、owned `str` を token buffer に[保存/ほぞん]しないための境界 helper です。
//:
//: [注意/ちゅうい]:
//: - 返された `str` は呼び出し側の assertion / parser / resolver などの消費境界へ渡してください。
fn selfhost_token_lexeme <(str,SelfhostToken)->str> (source, token):
    let span <SelfhostSourceSpan> field::get token "span"
    string_slice::str_slice source field::get span "start" field::get span "end"

//: token_kind_name: Rust `analyze_lex` JSON と同じ token kind [名/めい]を[返/かえ]す
fn token_kind_name <(TokenKind)->str> (kind):
    match kind:
        TokenKind::Indent:
            "Indent"
        TokenKind::Dedent:
            "Dedent"
        TokenKind::Newline:
            "Newline"
        TokenKind::Eof:
            "Eof"
