#indent 4
#import "core/traits/copy" as *

//: TokenKind: NEPLg2.0 lexer が[生成/せいせい]する token [種類/しゅるい]
//:
//: [目的/もくてき]:
//: - Rust `nepl-core::lexer::TokenKind` の公開 JSON kind と同じ分類を self-host 側へ持ちます。
//: - `Unterminated*` / `Unknown` は self-host lexer 内部の diagnostic 化用 token です。
pub enum TokenKind:
    Indent
    Dedent
    Newline
    Eof
    Colon
    Semicolon
    Pipe
    LParen
    RParen
    Comma
    LAngle
    RAngle
    Arrow
    PathSep
    At
    Dot
    Ampersand
    Star
    Minus
    Equals
    Ident
    IntLiteral
    FloatLiteral
    BoolLiteral
    CharLiteral
    StringLiteral
    UnitLiteral
    KwFn
    KwLet
    KwMut
    KwNoShadow
    KwSet
    KwIf
    KwWhile
    KwCond
    KwThen
    KwElse
    KwDo
    KwStruct
    KwEnum
    KwMatch
    KwTrait
    KwImpl
    KwFor
    KwPub
    KwBlock
    KwTuple
    KwMlstr
    DirEntry
    DirTarget
    DirImport
    DirUse
    DirIfTarget
    DirIfProfile
    DirCapability
    DirWasm
    DirLlvmIr
    DirIndentWidth
    DirInclude
    DirExtern
    DirIntrinsic
    DirPrelude
    DirNoPrelude
    WasmText
    LlvmIrText
    MlstrLine
    DocComment
    UnterminatedChar
    UnterminatedString
    Unknown

impl Clone for TokenKind:
    fn clone <(&TokenKind)->TokenKind> (self):
        *self

impl Copy for TokenKind:
    fn copy_mark <(TokenKind)->TokenKind> (self):
        self
