#indent 4
#import "core/field" as field
#import "../kind" as *
#import "../value" as *

//: selfhost_token_is_expr_start: prefix expression の[先頭/せんとう]候補か[返/かえ]す
pub fn selfhost_token_is_expr_start %fn SelfhostToken bool \token:
    match field::get token "kind":
        TokenKind::Indent:
            false
        TokenKind::Dedent:
            false
        TokenKind::Newline:
            false
        TokenKind::Eof:
            false
        TokenKind::Colon:
            false
        TokenKind::Semicolon:
            false
        TokenKind::Pipe:
            false
        TokenKind::LParen:
            true
        TokenKind::RParen:
            false
        TokenKind::Comma:
            false
        TokenKind::LAngle:
            false
        TokenKind::RAngle:
            false
        TokenKind::Percent:
            true
        TokenKind::Backslash:
            true
        TokenKind::Arrow:
            false
        TokenKind::PathSep:
            false
        TokenKind::At:
            true
        TokenKind::Dot:
            false
        TokenKind::Ampersand:
            true
        TokenKind::Star:
            true
        TokenKind::Minus:
            false
        TokenKind::Equals:
            false
        TokenKind::Ident:
            true
        TokenKind::IntLiteral:
            true
        TokenKind::FloatLiteral:
            true
        TokenKind::BoolLiteral:
            true
        TokenKind::CharLiteral:
            true
        TokenKind::StringLiteral:
            true
        TokenKind::UnitLiteral:
            true
        TokenKind::KwFn:
            false
        TokenKind::KwLet:
            true
        TokenKind::KwMut:
            false
        TokenKind::KwNoShadow:
            false
        TokenKind::KwSet:
            true
        TokenKind::KwIf:
            true
        TokenKind::KwWhile:
            true
        TokenKind::KwCond:
            true
        TokenKind::KwThen:
            true
        TokenKind::KwElse:
            true
        TokenKind::KwDo:
            true
        TokenKind::KwStruct:
            false
        TokenKind::KwEnum:
            false
        TokenKind::KwBlock:
            true
        TokenKind::KwMatch:
            true
        TokenKind::KwTrait:
            false
        TokenKind::KwImpl:
            false
        TokenKind::KwFor:
            false
        TokenKind::KwPub:
            false
        TokenKind::KwTuple:
            false
        TokenKind::KwMlstr:
            false
        TokenKind::DirEntry:
            false
        TokenKind::DirTarget:
            false
        TokenKind::DirImport:
            false
        TokenKind::DirUse:
            false
        TokenKind::DirIfTarget:
            false
        TokenKind::DirIfProfile:
            false
        TokenKind::DirCapability:
            false
        TokenKind::DirWasm:
            false
        TokenKind::DirLlvmIr:
            false
        TokenKind::DirIndentWidth:
            false
        TokenKind::DirInclude:
            false
        TokenKind::DirExtern:
            false
        TokenKind::DirIntrinsic:
            false
        TokenKind::DirPrelude:
            false
        TokenKind::DirNoPrelude:
            false
        TokenKind::WasmText:
            false
        TokenKind::LlvmIrText:
            false
        TokenKind::MlstrLine:
            false
        TokenKind::DocComment:
            false
        TokenKind::UnterminatedChar:
            false
        TokenKind::UnterminatedString:
            false
        TokenKind::Unknown:
            false
