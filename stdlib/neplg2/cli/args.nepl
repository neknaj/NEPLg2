#indent 4

#import "alloc/collections/vec" as v
#import "alloc/string" as *
#import "core/field" as *
#import "core/math" as *
#import "core/mem" as *
#import "core/option" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "alloc/hash/hash32" as *

//: # args
//: NEPLg2.0 self-host CLI の argv parser 境界を置くモジュールです。
//:
//: [目的/もくてき]:
//: - raw argv provider と pure option parser を分離し、self-host CLI parity test の入口にします。
//: - `--target` / `--emit` / `--stdlib-root` / `-o` / `-i` / input path を、filesystem や stdio に依存せず解釈します。
//: - `std/env/cliarg` は argv の取得だけを担い、このモジュールは渡された `Vec<str>` を読むだけにします。
//:
//: [注意/ちゅうい]:
//: - `selfhost_cli_parse_args` は argv[0] を含まない引数列を、`selfhost_cli_parse_argv` は argv[0] を含む raw argv を受け取ります。
//: - `--` 以降の実行時引数はこの段階では内容をコピーせず、開始 index だけを `run_args_start` に保存します。
//: - 返る `str` は入力 argv の文字列値を参照する軽量値です。文字列本体は呼び出し側の argv と同じ寿命を前提にします。
//:
//: [計算量/けいさんりょう]:
//: - [時間/じかん]: O(n)
//: - [空間/くうかん]: O(1)
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/cli/args" as *
//: fn main <()->i32> ():
//:     selfhost_args_stage0
//: ```
fn selfhost_args_stage0 <()->i32> ():
    0

//: ## SelfhostCliTarget
//: self-host compiler が受け付ける compile target です。
//:
//: [目的/もくてき]:
//: - Rust CLI の `--target` 表面と同じ語彙を enum に閉じ込めます。
//: - `core` / `std` は互換 alias として parser で正規化します。
//:
//: [注意/ちゅうい]:
//: - `Core` と `Std` は enum variant にはせず、それぞれ `Wasm` / `Wasi` に正規化します。
pub enum SelfhostCliTarget:
    Wasm
    Wasi
    Wasix
    Llvm

impl Clone for SelfhostCliTarget:
    fn clone <(&SelfhostCliTarget)->SelfhostCliTarget> (self):
        *self

impl Copy for SelfhostCliTarget:
    fn copy_mark <(SelfhostCliTarget)->SelfhostCliTarget> (self):
        self

//: ## SelfhostCliEmit
//: self-host compiler の出力形式です。
//:
//: [目的/もくてき]:
//: - `--emit` の 1 要素を enum として扱い、comma 区切り parser と後続 driver が文字列比較を繰り返さずに分岐できるようにします。
//: - `All` は parser 内で `SelfhostCliEmitSet` の全 artifact に展開します。
pub enum SelfhostCliEmit:
    Wasm
    Wat
    WatMin
    Llvm
    LlvmMin
    All

impl Clone for SelfhostCliEmit:
    fn clone <(&SelfhostCliEmit)->SelfhostCliEmit> (self):
        *self

impl Copy for SelfhostCliEmit:
    fn copy_mark <(SelfhostCliEmit)->SelfhostCliEmit> (self):
        self

//: ## SelfhostCliEmitSet
//: self-host compiler が 1 回の実行で出力する artifact set です。
//:
//: [目的/もくてき]:
//: - `--emit wasm,wat,llvm-min` のような複数指定を、所有権付き collection ではなく固定 bool field で表します。
//: - 重複指定は同じ field を `true` にするだけなので、parser state は O(1) のまま保てます。
//:
//: [注意/ちゅうい]:
//: - output path と複数 artifact の具体的な file naming は artifact writer 側で決めます。
pub struct SelfhostCliEmitSet:
    wasm <bool>
    wat <bool>
    wat_min <bool>
    llvm <bool>
    llvm_min <bool>

impl Clone for SelfhostCliEmitSet:
    fn clone <(&SelfhostCliEmitSet)->SelfhostCliEmitSet> (self):
        *self

impl Copy for SelfhostCliEmitSet:
    fn copy_mark <(SelfhostCliEmitSet)->SelfhostCliEmitSet> (self):
        self

fn selfhost_cli_emit_set_new <(bool,bool,bool,bool,bool)->SelfhostCliEmitSet> (wasm, wat, wat_min, llvm, llvm_min):
    SelfhostCliEmitSet wasm wat wat_min llvm llvm_min

fn selfhost_cli_emit_set_default <()->SelfhostCliEmitSet> ():
    selfhost_cli_emit_set_new true false false false false

fn selfhost_cli_emit_set_empty <()->SelfhostCliEmitSet> ():
    selfhost_cli_emit_set_new false false false false false

fn selfhost_cli_emit_set_all <()->SelfhostCliEmitSet> ():
    selfhost_cli_emit_set_new true true true true true

fn selfhost_cli_emit_set_add <(SelfhostCliEmitSet,SelfhostCliEmit)->SelfhostCliEmitSet> (emit_set, emit):
    match emit:
        SelfhostCliEmit::Wasm:
            selfhost_cli_emit_set_new true get emit_set "wat" get emit_set "wat_min" get emit_set "llvm" get emit_set "llvm_min"
        SelfhostCliEmit::Wat:
            selfhost_cli_emit_set_new get emit_set "wasm" true get emit_set "wat_min" get emit_set "llvm" get emit_set "llvm_min"
        SelfhostCliEmit::WatMin:
            selfhost_cli_emit_set_new get emit_set "wasm" get emit_set "wat" true get emit_set "llvm" get emit_set "llvm_min"
        SelfhostCliEmit::Llvm:
            selfhost_cli_emit_set_new get emit_set "wasm" get emit_set "wat" get emit_set "wat_min" true get emit_set "llvm_min"
        SelfhostCliEmit::LlvmMin:
            selfhost_cli_emit_set_new get emit_set "wasm" get emit_set "wat" get emit_set "wat_min" get emit_set "llvm" true
        SelfhostCliEmit::All:
            selfhost_cli_emit_set_all

//: ## SelfhostCliProfile
//: compile profile の指定です。
pub enum SelfhostCliProfile:
    Debug
    Release

impl Clone for SelfhostCliProfile:
    fn clone <(&SelfhostCliProfile)->SelfhostCliProfile> (self):
        *self

impl Copy for SelfhostCliProfile:
    fn copy_mark <(SelfhostCliProfile)->SelfhostCliProfile> (self):
        self

//: ## SelfhostCliErrorKind
//: CLI parser が返す usage error の分類です。
//:
//: [目的/もくてき]:
//: - compiler diagnostic と CLI usage error を混ぜず、exit code と message を driver 側で決められるようにします。
//:
//: [注意/ちゅうい]:
//: - どの option が原因かを含む詳細 diagnostic は `cli/reporter.nepl` の段階で追加します。
pub enum SelfhostCliErrorKind:
    UnknownOption
    MissingValue
    MultipleInput
    InvalidTarget
    InvalidEmit
    InvalidProfile

//: ## SelfhostCliArgKind
//: argv token の分類です。
//:
//: [目的/もくてき]:
//: - string token を一度 enum に分類し、parser 本体を `match` で読める形にします。
enum SelfhostCliArgKind:
    Check
    Run
    AttachSource
    Lib
    Verbose
    Target
    Emit
    StdlibRoot
    Output
    Input
    Profile
    Separator
    Positional
    UnknownOption

//: ## SelfhostCliOptions
//: pure parser が返す CLI option set です。
//:
//: [目的/もくてき]:
//: - self-host CLI driver が必要とする compile/run option をまとめます。
//: - raw argv 取得、filesystem 読み込み、artifact 書き出しとは独立した純粋値にします。
//:
//: [注意/ちゅうい]:
//: - `run_args_start` は parser に渡した引数列の index です。`selfhost_cli_parse_argv` の場合は argv[0] を含む index になります。
//: - `input` は `-i/--input` と positional input のどちらから来ても同じ field に格納します。
pub struct SelfhostCliOptions:
    check <bool>
    run <bool>
    attach_source <bool>
    lib <bool>
    verbose <bool>
    emit <SelfhostCliEmitSet>
    target <Option<SelfhostCliTarget>>
    profile <Option<SelfhostCliProfile>>
    stdlib_root <Option<str>>
    output <Option<str>>
    input <Option<str>>
    run_args_start <Option<i32>>

//: selfhost_cli_options_new: parser state から options を組み立てる
//:
//: [目的/もくてき]:
//: - 走査中の値を `SelfhostCliOptions` へ変換します。
//:
//: [実装/じっそう]:
//: - struct constructor にそのまま渡します。
//:
//: [計算量/けいさんりょう]:
//: - O(1)
fn selfhost_cli_options_new <(bool,bool,bool,bool,bool,SelfhostCliEmitSet,Option<SelfhostCliTarget>,Option<SelfhostCliProfile>,Option<str>,Option<str>,Option<str>,Option<i32>)->SelfhostCliOptions> (check, run, attach_source, lib, verbose, emit, target, profile, stdlib_root, output, input, run_args_start):
    SelfhostCliOptions check run attach_source lib verbose emit target profile stdlib_root output input run_args_start

//: selfhost_cli_default_options: 既定の option set を返す
//:
//: [目的/もくてき]:
//: - 引数なしの状態を明示し、parser と doctest が同じ初期値を共有できるようにします。
//:
//: [注意/ちゅうい]:
//: - Rust CLI と同じく、`emit` の既定値は `wasm` です。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/cli/args" as *
//:| #import "core/field" as *
//: fn main <()*>i32> ():
//:     let opts <SelfhostCliOptions> selfhost_cli_default_options;
//:     if selfhost_cli_emit_is_wasm get opts "emit" 0 1
//: ```
pub fn selfhost_cli_default_options <()->SelfhostCliOptions> ():
    selfhost_cli_options_new false false false false false selfhost_cli_emit_set_default none<SelfhostCliTarget> none<SelfhostCliProfile> none<str> none<str> none<str> none<i32>

//: selfhost_cli_arg_at: argv data/len から index 指定で文字列を読む
//:
//: [目的/もくてき]:
//: - `Vec<str>` を消費せず、parser 内部で index access します。
//:
//: [実装/じっそう]:
//: - `VecDataLen<str>` から取り出した data address と len を使って境界検査後に `load<str>` します。
//:
//: [注意/ちゅうい]:
//: - `data` は呼び出し元の Vec の内部 pointer なので、parser 中に Vec を変更してはいけません。
fn selfhost_cli_arg_at <(i32,i32,i32)->Option<str>> (data, count, idx):
    if:
        lt idx 0
        then:
            none<str>
        else:
            if:
                le count idx
                then:
                    none<str>
                else:
                    some<str> load<str> add data mul idx size_of<str>

//: selfhost_cli_string_match_key: 有限の CLI 文字列集合を match 用の key にする
//:
//: [目的/もくてき]:
//: - NEPLg2 の `match` は現時点で `str` pattern を直接扱わないため、option/value 文字列を i32 key に正規化します。
//: - 呼び出し側は key の arm で候補を選んだあと、必ず `str_eq` で実文字列を検証してから分類します。
//:
//: [注意/ちゅうい]:
//: - hash 値は CLI の外部仕様ではありません。衝突した場合は equality check で fallback します。
//: - `and 2147483647` により match arm に書ける非負の scalar key へ落とします。
fn selfhost_cli_string_match_key <(str)->i32> (value):
    and hash32 value 2147483647

//: selfhost_cli_arg_kind_fallback: 既知 option 以外の argv token を分類する
//:
//: [目的/もくてき]:
//: - hash dispatch で既知 option に当たらなかった場合、`-` prefix の有無だけで unknown option と positional input を分けます。
fn selfhost_cli_arg_kind_fallback <(str)->SelfhostCliArgKind> (arg):
    match str_starts_with arg "-":
        true:
            SelfhostCliArgKind::UnknownOption
        false:
            SelfhostCliArgKind::Positional

//: selfhost_cli_arg_kind_if_eq: hash arm の候補を実文字列で検証する
//:
//: [目的/もくてき]:
//: - hash key の衝突で別文字列が同じ arm に入っても、`str_eq` が一致した場合だけ既知 option として扱います。
fn selfhost_cli_arg_kind_if_eq <(str,str,SelfhostCliArgKind)->SelfhostCliArgKind> (arg, expected, kind):
    match str_eq arg expected:
        true:
            kind
        false:
            selfhost_cli_arg_kind_fallback arg

//: selfhost_cli_arg_kind: argv token を分類する
//:
//: [目的/もくてき]:
//: - option token の文字列比較をこの関数へ閉じ込め、parser 本体は enum `match` で分岐します。
//:
//: [実装/じっそう]:
//: - 既知 option 文字列を hash key へ正規化し、scalar `match` で option kind に変換します。
//: - 各 arm は `str_eq` で実文字列を検証し、hash 衝突時は fallback に戻します。
//: - `-` で始まる未定義 token は `UnknownOption`、それ以外は positional input として扱います。
fn selfhost_cli_arg_kind <(str)->SelfhostCliArgKind> (arg):
    match selfhost_cli_string_match_key arg:
        1105069866:
            selfhost_cli_arg_kind_if_eq arg "--check" SelfhostCliArgKind::Check
        236190827:
            selfhost_cli_arg_kind_if_eq arg "--run" SelfhostCliArgKind::Run
        1825648204:
            selfhost_cli_arg_kind_if_eq arg "--attach-source" SelfhostCliArgKind::AttachSource
        1059669684:
            selfhost_cli_arg_kind_if_eq arg "--lib" SelfhostCliArgKind::Lib
        829133248:
            selfhost_cli_arg_kind_if_eq arg "--verbose" SelfhostCliArgKind::Verbose
        1018434800:
            selfhost_cli_arg_kind_if_eq arg "-v" SelfhostCliArgKind::Verbose
        1600605192:
            selfhost_cli_arg_kind_if_eq arg "--target" SelfhostCliArgKind::Target
        559754234:
            selfhost_cli_arg_kind_if_eq arg "--emit" SelfhostCliArgKind::Emit
        1262805978:
            selfhost_cli_arg_kind_if_eq arg "--stdlib-root" SelfhostCliArgKind::StdlibRoot
        1216879227:
            selfhost_cli_arg_kind_if_eq arg "--output" SelfhostCliArgKind::Output
        1726806915:
            selfhost_cli_arg_kind_if_eq arg "-o" SelfhostCliArgKind::Output
        296239959:
            selfhost_cli_arg_kind_if_eq arg "--input" SelfhostCliArgKind::Input
        390736299:
            selfhost_cli_arg_kind_if_eq arg "-i" SelfhostCliArgKind::Input
        163286432:
            selfhost_cli_arg_kind_if_eq arg "--profile" SelfhostCliArgKind::Profile
        1353831004:
            selfhost_cli_arg_kind_if_eq arg "--" SelfhostCliArgKind::Separator
        _:
            selfhost_cli_arg_kind_fallback arg

//: selfhost_cli_parse_target_if_eq: target hash arm の候補を実文字列で検証する
fn selfhost_cli_parse_target_if_eq <(str,str,SelfhostCliTarget)->Result<SelfhostCliTarget,SelfhostCliErrorKind>> (value, expected, target):
    match str_eq value expected:
        true:
            ok<SelfhostCliTarget,SelfhostCliErrorKind> target
        false:
            err<SelfhostCliTarget,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidTarget

//: selfhost_cli_parse_target_value: `--target` の値を enum へ変換する
//:
//: [目的/もくてき]:
//: - CLI 表面の alias を内部 target enum へ正規化します。
//: - 有限の value 集合を scalar `match` で表し、alias の追加/削除を arm 単位でレビューできるようにします。
//:
//: [注意/ちゅうい]:
//: - `core` は `wasm`、`std` は `wasi` として扱います。
pub fn selfhost_cli_parse_target_value <(str)->Result<SelfhostCliTarget,SelfhostCliErrorKind>> (value):
    match selfhost_cli_string_match_key value:
        1210069335:
            selfhost_cli_parse_target_if_eq value "wasm" SelfhostCliTarget::Wasm
        495192238:
            selfhost_cli_parse_target_if_eq value "core" SelfhostCliTarget::Wasm
        53171433:
            selfhost_cli_parse_target_if_eq value "wasi" SelfhostCliTarget::Wasi
        1580422520:
            selfhost_cli_parse_target_if_eq value "std" SelfhostCliTarget::Wasi
        37322532:
            selfhost_cli_parse_target_if_eq value "wasix" SelfhostCliTarget::Wasix
        343592226:
            selfhost_cli_parse_target_if_eq value "llvm" SelfhostCliTarget::Llvm
        _:
            err<SelfhostCliTarget,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidTarget

//: selfhost_cli_parse_emit_if_eq: emit hash arm の候補を実文字列で検証する
fn selfhost_cli_parse_emit_if_eq <(str,str,SelfhostCliEmit)->Result<SelfhostCliEmit,SelfhostCliErrorKind>> (value, expected, emit):
    match str_eq value expected:
        true:
            ok<SelfhostCliEmit,SelfhostCliErrorKind> emit
        false:
            err<SelfhostCliEmit,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit

//: selfhost_cli_parse_emit_value: `--emit` の値を enum へ変換する
//:
//: [目的/もくてき]:
//: - artifact writer が扱う出力種別を enum へ閉じ込めます。
//: - 出力種別の有限集合を `match` arm として固定し、nested `if` の順序依存を避けます。
pub fn selfhost_cli_parse_emit_value <(str)->Result<SelfhostCliEmit,SelfhostCliErrorKind>> (value):
    match selfhost_cli_string_match_key value:
        1210069335:
            selfhost_cli_parse_emit_if_eq value "wasm" SelfhostCliEmit::Wasm
        139754043:
            selfhost_cli_parse_emit_if_eq value "wat" SelfhostCliEmit::Wat
        149843404:
            selfhost_cli_parse_emit_if_eq value "wat-min" SelfhostCliEmit::WatMin
        343592226:
            selfhost_cli_parse_emit_if_eq value "llvm" SelfhostCliEmit::Llvm
        1495051790:
            selfhost_cli_parse_emit_if_eq value "llvm-min" SelfhostCliEmit::LlvmMin
        688645933:
            selfhost_cli_parse_emit_if_eq value "all" SelfhostCliEmit::All
        _:
            err<SelfhostCliEmit,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit

//: selfhost_cli_parse_emit_part: 1 要素の emit を set に追加する
//:
//: [目的/もくてき]:
//: - comma 区切り parser から呼び、`all` は全 artifact set へ展開します。
fn selfhost_cli_parse_emit_part <(SelfhostCliEmitSet,str)->Result<SelfhostCliEmitSet,SelfhostCliErrorKind>> (emit_set, part):
    match selfhost_cli_parse_emit_value part:
        Result::Err e:
            err<SelfhostCliEmitSet,SelfhostCliErrorKind> e
        Result::Ok emit:
            ok<SelfhostCliEmitSet,SelfhostCliErrorKind> selfhost_cli_emit_set_add emit_set emit

//: selfhost_cli_parse_emit_set_value: `--emit` の comma 区切り値を artifact set へ変換する
//:
//: [目的/もくてき]:
//: - `wasm,wat` のような複数 artifact 指定を `SelfhostCliEmitSet` に畳み込みます。
//: - 重複指定は同じ field を true にするだけで無害に処理します。
//:
//: [注意/ちゅうい]:
//: - 空文字列、空要素、未知要素は `InvalidEmit` です。
pub fn selfhost_cli_parse_emit_set_value <(str)->Result<SelfhostCliEmitSet,SelfhostCliErrorKind>> (value):
    let n <i32> len value
    if:
        eq n 0
        then:
            err<SelfhostCliEmitSet,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit
        else:
            let mut start <i32> 0
            let mut i <i32> 0
            let mut emit_set <SelfhostCliEmitSet> selfhost_cli_emit_set_empty
            let mut failed <bool> false
            while and le i n not failed:
                do:
                    let at_end <bool> eq i n
                    let split <bool>:
                        if:
                            at_end
                            then:
                                true
                            else:
                                eq string_byte_at_unchecked value i ','
                    if:
                        split
                        then:
                            if:
                                eq start i
                                then:
                                    set failed true
                                else:
                                    match str_slice_result value start i:
                                        Result::Err _e:
                                            set failed true
                                        Result::Ok part:
                                            match selfhost_cli_parse_emit_part emit_set part:
                                                Result::Err _e:
                                                    set failed true
                                                Result::Ok next_emit_set:
                                                    set emit_set next_emit_set
                            set start add i 1
                        else:
                            ()
                    set i add i 1
            if:
                failed
                then:
                    err<SelfhostCliEmitSet,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit
                else:
                    ok<SelfhostCliEmitSet,SelfhostCliErrorKind> emit_set

//: selfhost_cli_parse_profile_if_eq: profile hash arm の候補を実文字列で検証する
fn selfhost_cli_parse_profile_if_eq <(str,str,SelfhostCliProfile)->Result<SelfhostCliProfile,SelfhostCliErrorKind>> (value, expected, profile):
    match str_eq value expected:
        true:
            ok<SelfhostCliProfile,SelfhostCliErrorKind> profile
        false:
            err<SelfhostCliProfile,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidProfile

//: selfhost_cli_parse_profile_value: `--profile` の値を enum へ変換する
pub fn selfhost_cli_parse_profile_value <(str)->Result<SelfhostCliProfile,SelfhostCliErrorKind>> (value):
    match selfhost_cli_string_match_key value:
        97528863:
            selfhost_cli_parse_profile_if_eq value "debug" SelfhostCliProfile::Debug
        322158401:
            selfhost_cli_parse_profile_if_eq value "release" SelfhostCliProfile::Release
        _:
            err<SelfhostCliProfile,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidProfile

//: selfhost_cli_next_value: 値を必要とする option の次 token を読む
//:
//: [目的/もくてき]:
//: - `--target` や `-o` の値欠落を `MissingValue` として返します。
//:
//: [注意/ちゅうい]:
//: - 値が `-` で始まるかどうかはここでは判定しません。path や値として許可する余地を残します。
fn selfhost_cli_next_value <(i32,i32,i32)->Result<str,SelfhostCliErrorKind>> (data, count, i):
    match selfhost_cli_arg_at data count add i 1:
        Option::Some value:
            ok<str,SelfhostCliErrorKind> value
        Option::None:
            err<str,SelfhostCliErrorKind> SelfhostCliErrorKind::MissingValue

//: selfhost_cli_set_input: input path を重複検査つきで設定する
//:
//: [目的/もくてき]:
//: - positional input と `-i/--input` を同じ重複規則で処理します。
fn selfhost_cli_set_input <(Option<str>,str)->Result<Option<str>,SelfhostCliErrorKind>> (current, value):
    match current:
        Option::Some _old:
            err<Option<str>,SelfhostCliErrorKind> SelfhostCliErrorKind::MultipleInput
        Option::None:
            ok<Option<str>,SelfhostCliErrorKind> some<str> value

//: selfhost_cli_finish: 走査済み state を success result にする
fn selfhost_cli_finish <(Option<str>,Option<str>,Option<str>,Option<SelfhostCliTarget>,SelfhostCliEmitSet,Option<SelfhostCliProfile>,bool,bool,bool,bool,bool,Option<i32>)->Result<SelfhostCliOptions,SelfhostCliErrorKind>> (input, output, stdlib_root, target, emit, profile, check, run, attach_source, lib, verbose, run_args_start):
    ok<SelfhostCliOptions,SelfhostCliErrorKind> selfhost_cli_options_new check run attach_source lib verbose emit target profile stdlib_root output input run_args_start

//: selfhost_cli_parse_loop: argv parser の本体
//:
//: [目的/もくてき]:
//: - index を進めながら option state を更新し、usage error を `Result::Err` にします。
//:
//: [実装/じっそう]:
//: - 各 token を `SelfhostCliArgKind` に分類し、enum `match` で処理を選びます。
//: - 値付き option は `selfhost_cli_next_value` で次 token を取り、成功時だけ index を 2 進めます。
//:
//: [計算量/けいさんりょう]:
//: - O(n)
fn selfhost_cli_parse_loop <(i32,i32,i32,Option<str>,Option<str>,Option<str>,Option<SelfhostCliTarget>,SelfhostCliEmitSet,Option<SelfhostCliProfile>,bool,bool,bool,bool,bool)->Result<SelfhostCliOptions,SelfhostCliErrorKind>> (data, count, i, input, output, stdlib_root, target, emit, profile, check, run, attach_source, lib, verbose):
    if:
        le count i
        then:
            selfhost_cli_finish input output stdlib_root target emit profile check run attach_source lib verbose none<i32>
        else:
            match selfhost_cli_arg_at data count i:
                Option::None:
                    selfhost_cli_finish input output stdlib_root target emit profile check run attach_source lib verbose none<i32>
                Option::Some arg:
                    match selfhost_cli_arg_kind arg:
                        SelfhostCliArgKind::Check:
                            selfhost_cli_parse_loop data count add i 1 input output stdlib_root target emit profile true run attach_source lib verbose
                        SelfhostCliArgKind::Run:
                            selfhost_cli_parse_loop data count add i 1 input output stdlib_root target emit profile check true attach_source lib verbose
                        SelfhostCliArgKind::AttachSource:
                            selfhost_cli_parse_loop data count add i 1 input output stdlib_root target emit profile check run true lib verbose
                        SelfhostCliArgKind::Lib:
                            selfhost_cli_parse_loop data count add i 1 input output stdlib_root target emit profile check run attach_source true verbose
                        SelfhostCliArgKind::Verbose:
                            selfhost_cli_parse_loop data count add i 1 input output stdlib_root target emit profile check run attach_source lib true
                        SelfhostCliArgKind::Target:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    match selfhost_cli_parse_target_value value:
                                        Result::Err e:
                                            err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                        Result::Ok parsed:
                                            selfhost_cli_parse_loop data count add i 2 input output stdlib_root some<SelfhostCliTarget> parsed emit profile check run attach_source lib verbose
                        SelfhostCliArgKind::Emit:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    match selfhost_cli_parse_emit_set_value value:
                                        Result::Err e:
                                            err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                        Result::Ok parsed:
                                            selfhost_cli_parse_loop data count add i 2 input output stdlib_root target parsed profile check run attach_source lib verbose
                        SelfhostCliArgKind::StdlibRoot:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    selfhost_cli_parse_loop data count add i 2 input output some<str> value target emit profile check run attach_source lib verbose
                        SelfhostCliArgKind::Output:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    selfhost_cli_parse_loop data count add i 2 input some<str> value stdlib_root target emit profile check run attach_source lib verbose
                        SelfhostCliArgKind::Input:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    match selfhost_cli_set_input input value:
                                        Result::Err e:
                                            err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                        Result::Ok next_input:
                                            selfhost_cli_parse_loop data count add i 2 next_input output stdlib_root target emit profile check run attach_source lib verbose
                        SelfhostCliArgKind::Profile:
                            match selfhost_cli_next_value data count i:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok value:
                                    match selfhost_cli_parse_profile_value value:
                                        Result::Err e:
                                            err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                        Result::Ok parsed:
                                            selfhost_cli_parse_loop data count add i 2 input output stdlib_root target emit some<SelfhostCliProfile> parsed check run attach_source lib verbose
                        SelfhostCliArgKind::Separator:
                            selfhost_cli_finish input output stdlib_root target emit profile check run attach_source lib verbose some<i32> add i 1
                        SelfhostCliArgKind::Positional:
                            match selfhost_cli_set_input input arg:
                                Result::Err e:
                                    err<SelfhostCliOptions,SelfhostCliErrorKind> e
                                Result::Ok next_input:
                                    selfhost_cli_parse_loop data count add i 1 next_input output stdlib_root target emit profile check run attach_source lib verbose
                        SelfhostCliArgKind::UnknownOption:
                            err<SelfhostCliOptions,SelfhostCliErrorKind> SelfhostCliErrorKind::UnknownOption

//: selfhost_cli_parse_args: argv[0] を含まない引数列を解析する
//:
//: [目的/もくてき]:
//: - test fixture や driver 内部から、program name を除いた CLI args を pure に解析します。
//:
//: [実装/じっそう]:
//: - `Vec<str>` を borrow して `VecDataLen` にし、index 0 から `selfhost_cli_parse_loop` へ渡します。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/cli/args" as *
//:| #import "alloc/collections/vec" as v
//:| #import "core/result" as *
//:| #import "core/field" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let args <Vec<str>>:
//:         unwrap_ok v::new<str>
//:         |> v::push<str> "--check" |> uwok
//:         |> v::push<str> "--emit" |> uwok
//:         |> v::push<str> "wasm" |> uwok
//:         |> v::push<str> "-o" |> uwok
//:         |> v::push<str> "out.wasm" |> uwok
//:         |> v::push<str> "main.nepl" |> uwok
//:     match selfhost_cli_parse_args &args:
//:         Result::Err _e:
//:             1
//:         Result::Ok opts:
//:             let output_ref <&Option<str>> get_ref &opts "output"
//:             let input_ref <&Option<str>> get_ref &opts "input"
//:             let check_ref <&bool> get_ref &opts "check"
//:             let emit_ref <&SelfhostCliEmitSet> get_ref &opts "emit"
//:             let output_ok <bool> match *output_ref:
//:                 Option::Some out:
//:                     str_eq out "out.wasm"
//:                 Option::None:
//:                     false
//:             let input_ok <bool> match *input_ref:
//:                 Option::Some input:
//:                     str_eq input "main.nepl"
//:                 Option::None:
//:                     false
//:             let check_ok <bool> *check_ref
//:             let emit_ok <bool> selfhost_cli_emit_is_wasm *emit_ref
//:             if and check_ok and emit_ok and output_ok input_ok 0 1
//: ```
pub fn selfhost_cli_parse_args <(&Vec<str>)->Result<SelfhostCliOptions,SelfhostCliErrorKind>> (args):
    let span <VecDataLen<str>> v::data_len_ref<str> args;
    let data <i32> mem_ptr_addr get span "data";
    let count <i32> get span "len";
    selfhost_cli_parse_loop data count 0 none<str> none<str> none<str> none<SelfhostCliTarget> selfhost_cli_emit_set_default none<SelfhostCliProfile> false false false false false

//: selfhost_cli_parse_argv: argv[0] を含む raw argv を解析する
//:
//: [目的/もくてき]:
//: - `std/env/cliarg` から集めた raw argv をそのまま渡せる入口です。
//:
//: [実装/じっそう]:
//: - argv[0] は program name として扱い、index 1 から option parsing を始めます。
//:
//: neplg2:test
//: ret: 0
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/cli/args" as *
//:| #import "alloc/collections/vec" as v
//:| #import "core/result" as *
//:| #import "core/field" as *
//:| #import "core/option" as *
//: fn main <()*>i32> ():
//:     let argv <Vec<str>>:
//:         unwrap_ok v::new<str>
//:         |> v::push<str> "neplg2" |> uwok
//:         |> v::push<str> "--target" |> uwok
//:         |> v::push<str> "std" |> uwok
//:         |> v::push<str> "-i" |> uwok
//:         |> v::push<str> "main.nepl" |> uwok
//:     match selfhost_cli_parse_argv &argv:
//:         Result::Err _e:
//:             1
//:         Result::Ok opts:
//:             let target_ref <&Option<SelfhostCliTarget>> get_ref &opts "target"
//:             let input_ref <&Option<str>> get_ref &opts "input"
//:             let target_ok <bool> match *target_ref:
//:                 Option::Some target:
//:                     selfhost_cli_target_is_wasi target
//:                 Option::None:
//:                     false
//:             let input_ok <bool> match *input_ref:
//:                 Option::Some input:
//:                     str_eq input "main.nepl"
//:                 Option::None:
//:                     false
//:             if and target_ok input_ok 0 1
//: ```
pub fn selfhost_cli_parse_argv <(&Vec<str>)->Result<SelfhostCliOptions,SelfhostCliErrorKind>> (argv):
    let span <VecDataLen<str>> v::data_len_ref<str> argv;
    let data <i32> mem_ptr_addr get span "data";
    let count <i32> get span "len";
    selfhost_cli_parse_loop data count 1 none<str> none<str> none<str> none<SelfhostCliTarget> selfhost_cli_emit_set_default none<SelfhostCliProfile> false false false false false

//: selfhost_cli_target_is_wasm: target が Wasm か判定する
pub fn selfhost_cli_target_is_wasm <(SelfhostCliTarget)->bool> (target):
    match target:
        SelfhostCliTarget::Wasm:
            true
        SelfhostCliTarget::Wasi:
            false
        SelfhostCliTarget::Wasix:
            false
        SelfhostCliTarget::Llvm:
            false

//: selfhost_cli_target_is_wasi: target が Wasi か判定する
pub fn selfhost_cli_target_is_wasi <(SelfhostCliTarget)->bool> (target):
    match target:
        SelfhostCliTarget::Wasm:
            false
        SelfhostCliTarget::Wasi:
            true
        SelfhostCliTarget::Wasix:
            false
        SelfhostCliTarget::Llvm:
            false

//: selfhost_cli_emit_is_wasm: emit が Wasm か判定する
pub fn selfhost_cli_emit_is_wasm <(SelfhostCliEmit)->bool> (emit):
    match emit:
        SelfhostCliEmit::Wasm:
            true
        SelfhostCliEmit::Wat:
            false
        SelfhostCliEmit::WatMin:
            false
        SelfhostCliEmit::Llvm:
            false
        SelfhostCliEmit::LlvmMin:
            false
        SelfhostCliEmit::All:
            false

//: selfhost_cli_emit_is_wasm: emit set が Wasm を含むか判定する
pub fn selfhost_cli_emit_is_wasm <(SelfhostCliEmitSet)->bool> (emit):
    get emit "wasm"

//: selfhost_cli_emit_set_has_wat: emit set が Wat を含むか判定する
pub fn selfhost_cli_emit_set_has_wat <(SelfhostCliEmitSet)->bool> (emit):
    get emit "wat"

//: selfhost_cli_emit_set_has_wat_min: emit set が WatMin を含むか判定する
pub fn selfhost_cli_emit_set_has_wat_min <(SelfhostCliEmitSet)->bool> (emit):
    get emit "wat_min"

//: selfhost_cli_emit_set_has_llvm: emit set が Llvm を含むか判定する
pub fn selfhost_cli_emit_set_has_llvm <(SelfhostCliEmitSet)->bool> (emit):
    get emit "llvm"

//: selfhost_cli_emit_set_has_llvm_min: emit set が LlvmMin を含むか判定する
pub fn selfhost_cli_emit_set_has_llvm_min <(SelfhostCliEmitSet)->bool> (emit):
    get emit "llvm_min"

//: selfhost_cli_error_is_unknown_option: error kind が unknown option か判定する
pub fn selfhost_cli_error_is_unknown_option <(SelfhostCliErrorKind)->bool> (kind):
    match kind:
        SelfhostCliErrorKind::UnknownOption:
            true
        SelfhostCliErrorKind::MissingValue:
            false
        SelfhostCliErrorKind::MultipleInput:
            false
        SelfhostCliErrorKind::InvalidTarget:
            false
        SelfhostCliErrorKind::InvalidEmit:
            false
        SelfhostCliErrorKind::InvalidProfile:
            false

//: selfhost_cli_error_is_missing_value: error kind が missing value か判定する
pub fn selfhost_cli_error_is_missing_value <(SelfhostCliErrorKind)->bool> (kind):
    match kind:
        SelfhostCliErrorKind::UnknownOption:
            false
        SelfhostCliErrorKind::MissingValue:
            true
        SelfhostCliErrorKind::MultipleInput:
            false
        SelfhostCliErrorKind::InvalidTarget:
            false
        SelfhostCliErrorKind::InvalidEmit:
            false
        SelfhostCliErrorKind::InvalidProfile:
            false

//: selfhost_cli_error_is_multiple_input: error kind が multiple input か判定する
pub fn selfhost_cli_error_is_multiple_input <(SelfhostCliErrorKind)->bool> (kind):
    match kind:
        SelfhostCliErrorKind::UnknownOption:
            false
        SelfhostCliErrorKind::MissingValue:
            false
        SelfhostCliErrorKind::MultipleInput:
            true
        SelfhostCliErrorKind::InvalidTarget:
            false
        SelfhostCliErrorKind::InvalidEmit:
            false
        SelfhostCliErrorKind::InvalidProfile:
            false

//: selfhost_cli_error_is_invalid_emit: error kind が invalid emit か判定する
pub fn selfhost_cli_error_is_invalid_emit <(SelfhostCliErrorKind)->bool> (kind):
    match kind:
        SelfhostCliErrorKind::UnknownOption:
            false
        SelfhostCliErrorKind::MissingValue:
            false
        SelfhostCliErrorKind::MultipleInput:
            false
        SelfhostCliErrorKind::InvalidTarget:
            false
        SelfhostCliErrorKind::InvalidEmit:
            true
        SelfhostCliErrorKind::InvalidProfile:
            false
