#indent 4

pub #import "./args/emit" as *
pub #import "./args/options" as *
pub #import "./args/parse" as *
pub #import "./args/predicates" as *
pub #import "./args/types" as *

//: # args
//: NEPLg2.0 self-host CLI の argv parser public facade です。
//:
//: [目的/もくてき]:
//: - `neplg2/cli/args` という安定 import path から、CLI option 型、argv parser、emit set helper、core option 変換、predicate helper をまとめて公開します。
//: - 実装責務は `args/types`、`args/classify`、`args/emit`、`args/options`、`args/parse`、`args/predicates` に分け、facade 自体には state machine や文字列 dispatch を置きません。
//:
//: [注意/ちゅうい]:
//: - argv token / option value の分類は `args/classify` が所有します。
//: - parser state machine は `args/parse` が所有します。
//: - target/error 判定 helper は `args/predicates` が所有します。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "core/field" as *
//:| #import "neplg2/cli/args" as *
//: fn main %impure fn void i32 \void:
//:     let opts %SelfhostCliOptions selfhost_cli_default_options;
//:     let check_ref %&bool get_ref &opts "check";
//:     if *check_ref 1 0
//: ```
