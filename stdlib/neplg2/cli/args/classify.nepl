#indent 4

#import "alloc/hash/hash32" as *
#import "alloc/string" as *
#import "core/result" as *
#import "core/traits/copy" as *
#import "./types" as *
#import "core/math" as *

//: # args/classify
//: NEPLg2.0 self-host CLI の argv token / option value 分類を[集/あつ]める module です。
//:
//: [目的/もくてき]:
//: - parser state machine から、文字列比較と hash dispatch の責務を分離します。
//: - option token / target / emit / profile の有限集合を enum と `match` で管理し、静的検査が効く形にします。
//:
//: [注意/ちゅうい]:
//: - hash 値は内部 dispatch 用であり、CLI の外部仕様ではありません。
//: - 各 hash arm は必ず `str_eq` で実文字列を再検証し、hash 衝突を option 認識にしません。
//:
//: neplg2:test
//: ```neplg2
//:| #entry main
//:| #target std
//:| #import "neplg2/cli/args/classify" as *
//:| #import "neplg2/cli/args/types" as *
//:| #import "core/result" as *
//: fn main %fn unit i32 \unit:
//:     match selfhost_cli_parse_target_value "std":
//:         Result::Ok target:
//:             match target:
//:                 SelfhostCliTarget::Wasi:
//:                     0
//:                 _:
//:                     1
//:         Result::Err _e:
//:             2
//: ```

//: SelfhostCliArgKind: argv token の分類
//:
//: [目的/もくてき]:
//: - string token を一度 enum に分類し、parser 本体を `match` で読める形にします。
pub enum SelfhostCliArgKind:
    Check
    Run
    AttachSource
    Lib
    Verbose
    Target
    Emit
    StdlibRoot
    Output
    Input
    Profile
    Separator
    Positional
    UnknownOption

impl Clone for SelfhostCliArgKind:
    fn clone %fn &SelfhostCliArgKind SelfhostCliArgKind \self:
        *self

impl Copy for SelfhostCliArgKind:
    fn copy_mark %fn SelfhostCliArgKind SelfhostCliArgKind \self:
        self

//: selfhost_cli_string_match_key: 有限の CLI 文字列集合を match 用の key にする
//:
//: [目的/もくてき]:
//: - NEPLg2 の `match` は現時点で `str` pattern を直接扱わないため、option/value 文字列を i32 key に正規化します。
//: - 呼び出し側は key の arm で候補を選んだあと、必ず `str_eq` で実文字列を検証してから分類します。
//:
//: [注意/ちゅうい]:
//: - hash 値は CLI の外部仕様ではありません。衝突した場合は equality check で fallback します。
//: - `and 2147483647` により match arm に書ける非負の scalar key へ落とします。
pub fn selfhost_cli_string_match_key %fn str i32 \value:
    and hash32 value 2147483647

//: selfhost_cli_arg_kind_fallback: 既知 option 以外の argv token を分類する
//:
//: [目的/もくてき]:
//: - hash dispatch で既知 option に当たらなかった場合、`-` prefix の有無だけで unknown option と positional input を分けます。
pub fn selfhost_cli_arg_kind_fallback %fn str SelfhostCliArgKind \arg:
    match str_starts_with arg "-":
        true:
            SelfhostCliArgKind::UnknownOption
        false:
            SelfhostCliArgKind::Positional

//: selfhost_cli_arg_kind_if_eq: hash arm の候補を実文字列で検証する
//:
//: [目的/もくてき]:
//: - hash key の衝突で別文字列が同じ arm に入っても、`str_eq` が一致した場合だけ既知 option として扱います。
pub fn selfhost_cli_arg_kind_if_eq %fn str fn str fn SelfhostCliArgKind SelfhostCliArgKind \arg\expected\kind:
    match str_eq arg expected:
        true:
            kind
        false:
            selfhost_cli_arg_kind_fallback arg

//: selfhost_cli_arg_kind: argv token を分類する
//:
//: [目的/もくてき]:
//: - option token の文字列比較をこの関数へ閉じ込め、parser 本体は enum `match` で分岐します。
//:
//: [実装/じっそう]:
//: - 既知 option 文字列を hash key へ正規化し、scalar `match` で option kind に変換します。
//: - 各 arm は `str_eq` で実文字列を検証し、hash 衝突時は fallback に戻します。
//: - `-` で始まる未定義 token は `UnknownOption`、それ以外は positional input として扱います。
pub fn selfhost_cli_arg_kind %fn str SelfhostCliArgKind \arg:
    match selfhost_cli_string_match_key arg:
        1105069866:
            selfhost_cli_arg_kind_if_eq arg "--check" SelfhostCliArgKind::Check
        236190827:
            selfhost_cli_arg_kind_if_eq arg "--run" SelfhostCliArgKind::Run
        1825648204:
            selfhost_cli_arg_kind_if_eq arg "--attach-source" SelfhostCliArgKind::AttachSource
        1059669684:
            selfhost_cli_arg_kind_if_eq arg "--lib" SelfhostCliArgKind::Lib
        829133248:
            selfhost_cli_arg_kind_if_eq arg "--verbose" SelfhostCliArgKind::Verbose
        1018434800:
            selfhost_cli_arg_kind_if_eq arg "-v" SelfhostCliArgKind::Verbose
        1600605192:
            selfhost_cli_arg_kind_if_eq arg "--target" SelfhostCliArgKind::Target
        559754234:
            selfhost_cli_arg_kind_if_eq arg "--emit" SelfhostCliArgKind::Emit
        1262805978:
            selfhost_cli_arg_kind_if_eq arg "--stdlib-root" SelfhostCliArgKind::StdlibRoot
        1216879227:
            selfhost_cli_arg_kind_if_eq arg "--output" SelfhostCliArgKind::Output
        1726806915:
            selfhost_cli_arg_kind_if_eq arg "-o" SelfhostCliArgKind::Output
        296239959:
            selfhost_cli_arg_kind_if_eq arg "--input" SelfhostCliArgKind::Input
        390736299:
            selfhost_cli_arg_kind_if_eq arg "-i" SelfhostCliArgKind::Input
        163286432:
            selfhost_cli_arg_kind_if_eq arg "--profile" SelfhostCliArgKind::Profile
        1353831004:
            selfhost_cli_arg_kind_if_eq arg "--" SelfhostCliArgKind::Separator
        _:
            selfhost_cli_arg_kind_fallback arg

//: selfhost_cli_parse_target_if_eq: target hash arm の候補を実文字列で検証する
pub fn selfhost_cli_parse_target_if_eq %fn str fn str fn SelfhostCliTarget Result SelfhostCliTarget SelfhostCliErrorKind \value\expected\target:
    match str_eq value expected:
        true:
            ok<SelfhostCliTarget,SelfhostCliErrorKind> target
        false:
            err<SelfhostCliTarget,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidTarget

//: selfhost_cli_parse_target_value: `--target` の値を enum へ変換する
//:
//: [目的/もくてき]:
//: - CLI 表面の alias を内部 target enum へ正規化します。
//: - 有限の value 集合を scalar `match` で表し、alias の追加/削除を arm 単位でレビューできるようにします。
//:
//: [注意/ちゅうい]:
//: - `core` は `wasm`、`std` は `wasi` として扱います。
pub fn selfhost_cli_parse_target_value %fn str Result SelfhostCliTarget SelfhostCliErrorKind \value:
    match selfhost_cli_string_match_key value:
        1210069335:
            selfhost_cli_parse_target_if_eq value "wasm" SelfhostCliTarget::Wasm
        495192238:
            selfhost_cli_parse_target_if_eq value "core" SelfhostCliTarget::Wasm
        53171433:
            selfhost_cli_parse_target_if_eq value "wasi" SelfhostCliTarget::Wasi
        1580422520:
            selfhost_cli_parse_target_if_eq value "std" SelfhostCliTarget::Wasi
        37322532:
            selfhost_cli_parse_target_if_eq value "wasix" SelfhostCliTarget::Wasix
        343592226:
            selfhost_cli_parse_target_if_eq value "llvm" SelfhostCliTarget::Llvm
        _:
            err<SelfhostCliTarget,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidTarget

//: selfhost_cli_parse_emit_if_eq: emit hash arm の候補を実文字列で検証する
pub fn selfhost_cli_parse_emit_if_eq %fn str fn str fn SelfhostCliEmit Result SelfhostCliEmit SelfhostCliErrorKind \value\expected\emit:
    match str_eq value expected:
        true:
            ok<SelfhostCliEmit,SelfhostCliErrorKind> emit
        false:
            err<SelfhostCliEmit,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit

//: selfhost_cli_parse_emit_value: `--emit` の値を enum へ変換する
//:
//: [目的/もくてき]:
//: - artifact writer が扱う出力種別を enum へ閉じ込めます。
//: - 出力種別の有限集合を `match` arm として固定し、nested `if` の順序依存を避けます。
pub fn selfhost_cli_parse_emit_value %fn str Result SelfhostCliEmit SelfhostCliErrorKind \value:
    match selfhost_cli_string_match_key value:
        1210069335:
            selfhost_cli_parse_emit_if_eq value "wasm" SelfhostCliEmit::Wasm
        139754043:
            selfhost_cli_parse_emit_if_eq value "wat" SelfhostCliEmit::Wat
        149843404:
            selfhost_cli_parse_emit_if_eq value "wat-min" SelfhostCliEmit::WatMin
        343592226:
            selfhost_cli_parse_emit_if_eq value "llvm" SelfhostCliEmit::Llvm
        1495051790:
            selfhost_cli_parse_emit_if_eq value "llvm-min" SelfhostCliEmit::LlvmMin
        688645933:
            selfhost_cli_parse_emit_if_eq value "all" SelfhostCliEmit::All
        _:
            err<SelfhostCliEmit,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidEmit

//: selfhost_cli_parse_profile_if_eq: profile hash arm の候補を実文字列で検証する
pub fn selfhost_cli_parse_profile_if_eq %fn str fn str fn SelfhostCliProfile Result SelfhostCliProfile SelfhostCliErrorKind \value\expected\profile:
    match str_eq value expected:
        true:
            ok<SelfhostCliProfile,SelfhostCliErrorKind> profile
        false:
            err<SelfhostCliProfile,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidProfile

//: selfhost_cli_parse_profile_value: `--profile` の値を enum へ変換する
pub fn selfhost_cli_parse_profile_value %fn str Result SelfhostCliProfile SelfhostCliErrorKind \value:
    match selfhost_cli_string_match_key value:
        97528863:
            selfhost_cli_parse_profile_if_eq value "debug" SelfhostCliProfile::Debug
        322158401:
            selfhost_cli_parse_profile_if_eq value "release" SelfhostCliProfile::Release
        _:
            err<SelfhostCliProfile,SelfhostCliErrorKind> SelfhostCliErrorKind::InvalidProfile
