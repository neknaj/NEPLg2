#entry main
#indent 4
#target wasi

#import "std/streamio" as *
#import "std/iotarget" as *
#import "std/stdio" as *

fn main %impure fn void unit \void:
    let sc %StreamScanner unwrap_ok open ReadStream::Stdio;
    let a %i32 read &sc;
    let b %i32 read &sc;
    close sc;
    println_i32 a;
    println_i32 b;
